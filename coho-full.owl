        <oboInOwl:hasRelatedSynonym>haemoglobin disorder</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hemoglobinopathy</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MONDO_0044348"/>
