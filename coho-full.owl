        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>GESBC Genetic Epidemiology Study of Breast Cancer by Age 50 21 Germany All incident cases diagnosed &lt;50 years of age in 1992-5 in two regions: Rhein-Neckar-Odenwald and Freiburg, by surveying the 38 clinics serving these regions Selected from random lists of residents of the study regions supplied by population registries; two controls were selected for each case, matched by age and study region. Recruitment was carried out 1992-1998.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001797"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000344</owl:annotatedTarget>
        <dcterms:title>European polygenic risk score for prediction of breast cancer shows similar performance in Asian women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32737321</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001797"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32424353</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies 32 novel breast cancer susceptibility loci from overall and subtype-specific analyses.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32424353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7808397/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>BCAC DACC approval is required to access data from the ABCFS, ABCS, ABCTB, BBCC, BBCS, BCEES, BCFR-NY, BCFR-PA, BCFR-UT, BCINIS, BSUCH, CBCS, CECILE, CGPS, CTS, DIETCOMPLYF, ESTHER, GC-HBOC, GENICA, GEPARSIXTO, GESBC, HABCS, HCSC, HEBCS, HMBCS, HUBCS, KARBAC, KBCP, LMBC, MABCS, MARIE, MBCSG, MCBCS, MISS, MMHS, MTLGEBCS, NC-BCFR, OFBCR, ORIGO, pKARMA, POSH, PREFACE, RBCS, SKKDKFZS, SUCCESSB, SUCCESSC, SZBCS, TNBCC, UCIBCS, UKBGS and UKOPS studies (Supplementary Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001797"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control family study of breast cancer in women diagnosed before age 50 in Germany, whose cases were all incident breast cancers diagnosed in 1992–1995 in two regions, Rhein-Neckar-Odenwald and Freiburg, identified by surveying the clinics serving those regions, and whose controls were residents of the study regions selected at random from population registries and matched to cases by age and region.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11065005</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001797"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">706</owl:annotatedTarget>
        <obo:IAO_0000116>GESBC questionnaire-completing cases and participating population controls, 1992-1998 recruitment</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://link.springer.com/content/pdf/10.1023/A%3A1008907901087.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Of these living case subjects, 706 (70.2%) completed the study questionnaire.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001797"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1381</owl:annotatedTarget>
        <obo:IAO_0000116>GESBC questionnaire-completing cases and participating population controls, 1992-1998 recruitment</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://link.springer.com/content/pdf/10.1023/A%3A1008907901087.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 2257 eligible population controls, 218 (9.7%) did not respond, 658 (29.1%) refused to take part, and 1381 (61.2%) participated.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001797"/>
