        <rdfs:comment>The PREVEND cohort study (www.prevend.org) is a community-based cohort study including 8592 inhabitants of the city of Groningen, The Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001800"/>
