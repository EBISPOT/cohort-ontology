        <owl:annotatedTarget>GCST90838701</owl:annotatedTarget>
        <dcterms:title>Interindividual variation in ovarian reserve after gonadotoxic treatment in female childhood cancer survivors - a genome-wide association study: results from PanCareLIFE.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38729340</oboInOwl:hasDbXref>
