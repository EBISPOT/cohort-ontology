    <!-- http://www.ebi.ac.uk/coho/COHO_0000802 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000802">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid7276"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000880"/>
        <obo:IAO_0000112>GCST90244175</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of patients with head and neck cancer treated with primary or postoperative radiotherapy, with or without chemotherapy, from 2007 to 2020 at the Department of Radiation Oncology of the University Medical Center Groningen, all enrolled in the UMCG head and neck cancer prospective data registration programme (NCT02435576), with prospective assessment of radiation-induced toxicity and patient-rated outcome measures.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1429</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>UMCG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UMCG-HANS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">University Medical Center Groningen Head and Neck cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid7276">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005627"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000802"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7276"/>
        <obo:IAO_0000116>head and neck cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ars.els-cdn.com/content/image/1-s2.0-S0167814022044863-mmc1.docx</oboInOwl:hasDbXref>
        <rdfs:comment>University Medical Center Groningen Head and Neck cancer Study (UMCG-HANS) cohort consisted of 1,429 HNC patients treated with primary or postoperative RT either or not combined with chemotherapy (CH-RT) from 2007 to 2020 at the department of Radiation Oncology of the UMCG.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000802"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://clinicaltrials.gov/api/v2/studies/NCT02435576</oboInOwl:hasDbXref>
        <rdfs:comment>&quot;&quot;&quot;facility&quot;&quot;:&quot;&quot;University Medical Center Groningen&quot;&quot;,&quot;&quot;status&quot;&quot;:&quot;&quot;RECRUITING&quot;&quot;,&quot;&quot;city&quot;&quot;:&quot;&quot;Groningen&quot;&quot;,&quot;&quot;zip&quot;&quot;:&quot;&quot;9700RB&quot;&quot;,&quot;&quot;country&quot;&quot;:&quot;&quot;Netherlands&quot;&quot;&quot;</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000802"/>
