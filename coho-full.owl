    <!-- http://www.ebi.ac.uk/coho/COHO_0001948 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001948">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17144"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS004896</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:39435665</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal observational study, led from the Research Division of the Joslin Diabetes Center in Boston, of adults with type 1 or type 2 diabetes attending the Joslin Clinic, enrolled in several cohorts from 1991 onwards with the aim of taking all eligible patients with albuminuria and a similar number drawn at random from those with normoalbuminuria, and followed for the development and progression of diabetic kidney disease, including kidney function decline and end-stage kidney disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>JKS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Joslin Kidney Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17144">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005016"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001948"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17144"/>
        <obo:IAO_0000116>diabetic nephropathy</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2682673/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>the Joslin Kidney Study on the Genetics of Diabetic Nephropathy, a clinic-based cohort study in which case subjects with diabetic nephropathy and a random sampling of eligible control subjects were identified and recruited</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001948"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8060327/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Study subjects were recruited from approximately 3,500 adult patients (95% Caucasian) with T1D who received care at the Joslin Clinic (Boston, MA) between 1991 and 2009</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001948"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS004896</owl:annotatedTarget>
        <dcterms:title>Albuminuria-Related Genetic Biomarkers: Replication and Predictive Evaluation in Individuals with and without Diabetes from the UK Biobank.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37446387</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001948"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39435665</owl:annotatedTarget>
        <dcterms:title>Circulating proteins linked to apoptosis processes and fast development of end-stage kidney disease in diabetes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39435665</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11529980/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were selected from among individuals who were enrolled into the Joslin Kidney Study (JKS) and were followed for 7–15 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001948"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal observational study, led from the Research Division of the Joslin Diabetes Center in Boston, of adults with type 1 or type 2 diabetes attending the Joslin Clinic, enrolled in several cohorts from 1991 onwards with the aim of taking all eligible patients with albuminuria and a similar number drawn at random from those with normoalbuminuria, and followed for the development and progression of diabetic kidney disease, including kidney function decline and end-stage kidney disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33883567</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39435665</obo:IAO_0000119>
        <obo:IAO_0000119>https://cdn-links.lww.com/permalink/jsn/c/jsn_30_10_2022_12_07_salem_2019030218_sdc1.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001948"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>JKS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


