        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v2.p1</oboInOwl:hasDbXref>
        <rdfs:comment>Total number of consented subjects: 6488</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002595"/>
