    <!-- http://www.ebi.ac.uk/coho/COHO_0002019 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002019">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17691"/>
        <rdf:type rdf:nodeID="genid17693"/>
        <rdf:type rdf:nodeID="genid17695"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:22139380</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based volunteer cohort of current and former smokers aged 40 to 75 from the greater Albuquerque area of New Mexico, established in 2001 at the Lovelace Respiratory Research Institute to study sputum and blood biomarkers for lung cancer risk and the development of chronic obstructive pulmonary disease, with repeated spirometry and questionnaires and follow-up for lung cancer incidence and death.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2511</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>LSC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Lovelace Smokers cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Lovelace Smokers&apos; Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Lovelace smokers cohort</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Lovelace Smokers Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17691">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005002"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid17693">
