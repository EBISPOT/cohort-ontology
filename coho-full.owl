        <oboInOwl:hasRelatedSynonym>FINGESTURE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FinGesture</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fingesture</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Finnish Genetic Study for Arrhythmic Events</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Finnish Genetic Study of Arrhythmic Events</rdfs:label>
