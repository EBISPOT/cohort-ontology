    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002267"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case–control study of lung and head and neck cancers conducted from 2008 in the Greater Toronto Area, Canada, at Mount Sinai Hospital (Sinai Health System) and Princess Margaret Cancer Centre, in which histologically confirmed cases seen at the hospitals&apos; clinics and controls selected at random from family medicine clinic databases, frequency-matched on age and sex, were interviewed with a standard questionnaire on lifestyle, occupational, medical and family history.</owl:annotatedTarget>
