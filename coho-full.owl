    <!-- http://www.ebi.ac.uk/coho/COHO_0002588 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002588">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21794"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001678"/>
        <obo:IAO_0000112>PMID:21037568</obo:IAO_0000112>
        <obo:IAO_0000115>A UK population-based case-control study of Hodgkin&apos;s disease in young adults aged 16 to 24 years, whose cases were those newly diagnosed between October 1991 and May 1995 in the Yorkshire, Wessex and South West Family Health Service Authority areas and parts of Cumbria and Lancashire, ascertained by the methods of the Leukaemia Research Fund Data Collection Study, and whose controls, two per case, were randomly selected from people registered with general practitioners in the study area and matched on sex, year of birth and area of residence. It was set up to test the late host response model of young adult Hodgkin&apos;s disease and whether it differs between Epstein-Barr virus-positive and -negative disease, and its cases were later genotyped for genome-wide association studies of classical Hodgkin lymphoma, among them the European Collaborative Study.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">118</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">237</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>YAHD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>YHCCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Adult Hodgkin Case-Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Adult Hodgkin Disease Case-Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Adult Hodgkins Disease Case_Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young adult Hodgkin Case-Control Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Young Adult Hodgkin&apos;s Disease Case-Control Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21794">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004952"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002588"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21794"/>
        <obo:IAO_0000116>Hodgkin&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2374437/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A UK population-based case–control study of Hodgkin&apos;s disease (HD) in young adults (16–24 years) included 118 cases and 237 controls matched on year of birth, gender and county of residence.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002588"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3274508/</oboInOwl:hasDbXref>
        <rdfs:comment>The Young Adult Hodgkin’s Disease Case–Control Study is a case–control study of HL in adolescents and young adults (aged 16–24 years) conducted in the United Kingdom in the regions of Yorkshire, Wessex, Southwest Family Health Service Authority areas, and parts of Cumbria and Lancashire between October 1991 and May 1995 (13).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002588"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21037568</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study of Hodgkin&apos;s lymphoma identifies new susceptibility loci at 2p16.1 (REL), 8q24.21 and 10p14 (GATA3).</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21037568</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4268499/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The UK-replication series comprised 524 cHL cases (ICD10 C81.0-3; 290 male, mean AOD=38, SD=16) ascertained from the Scotland and Newcastle Epidemiological Study of Hodgkin Disease (SNEHD), the Young adult Hodgkin Case-Control Study (YHCCS) and the Epidemiology &amp; Genetics Lymphoma Case-Control Study (ELCCS; www.elccs.info).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002588"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A UK population-based case-control study of Hodgkin&apos;s disease in young adults aged 16 to 24 years, whose cases were those newly diagnosed between October 1991 and May 1995 in the Yorkshire, Wessex and South West Family Health Service Authority areas and parts of Cumbria and Lancashire, ascertained by the methods of the Leukaemia Research Fund Data Collection Study, and whose controls, two per case, were randomly selected from people registered with general practitioners in the study area and matched on sex, year of birth and area of residence. It was set up to test the late host response model of young adult Hodgkin&apos;s disease and whether it differs between Epstein-Barr virus-positive and -negative disease, and its cases were later genotyped for genome-wide association studies of classical Hodgkin lymphoma, among them the European Collaborative Study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10737396</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20308568</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22286212</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24920014</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
