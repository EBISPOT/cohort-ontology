    <!-- http://www.ebi.ac.uk/coho/COHO_0002672 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002672">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:34650201</obo:IAO_0000112>
        <obo:IAO_0000115>A register-based cohort of everyone in Norway who took part in the national censuses from 1960 to 2001, in which family members are linked through personal identity numbers and household and family information from the 1960 census and further linked to health registers and surveys, for multigenerational life-course research in public health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6272827</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NFLC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Norwegian Family Based Life Course (NFLC) study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Norwegian family based life course study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Norwegian Family Based Life Course Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002672"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Norway"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:22735991%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>All Norwegians participating in censuses from 1960 to 2001 were included.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002672"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34650201</owl:annotatedTarget>
        <dcterms:title>The role of family factors in the association between early adulthood BMI and risk of cardiovascular disease. An intergenerational study of BMI in early adulthood and cardiovascular mortality in parents, aunts and uncles.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34650201</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7612210/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Data from the Armed Forces Personnel Data Base (1985-2012) were linked with data from the Norwegian Population Registry, generational data from the Norwegian Family Based Life Course Study (NFLC), National Educational Registry and the Cause of Death Registry using the unique national personal identification numbers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002672"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A register-based cohort of everyone in Norway who took part in the national censuses from 1960 to 2001, in which family members are linked through personal identity numbers and household and family information from the 1960 census and further linked to health registers and surveys, for multigenerational life-course research in public health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22735991</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002672"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6272827</owl:annotatedTarget>
        <obo:IAO_0000116>individuals in the 1960-2001 censuses with a personal identity number</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://doi.org/10.1007/s00038-012-0379-4</oboInOwl:hasDbXref>
        <rdfs:comment>This comprises in all 6,272,827 individuals.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002672"/>
