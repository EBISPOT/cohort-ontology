        <oboInOwl:hasRelatedSynonym>HPV vaccination cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HPV-Rokotiitus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCT00534638</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Finnish HPV vaccination cohort</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://projects.tuni.fi/hpv-rokotiitus/"/>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21921">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005161"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002604"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21921"/>
        <obo:IAO_0000116>HPV infection</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/HPV</oboInOwl:hasDbXref>
        <rdfs:comment>Community-randomized HPV vaccination trial cohort: gender-neutral HPV16/18 vaccination arm, girls-only HPV16/18 vaccination and hepatitis B-virus (HBV) vaccination of boys arm, and arm gender-neutral HBV vaccination arm.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002604"/>
