    <!-- http://www.ebi.ac.uk/coho/COHO_0002159 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002159">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>PGS004582</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:38064665</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of pregnant women recruited in 2020 and 2021 through the pregnancy screening programme of Shenzhen Baoan Women&apos;s and Children&apos;s Hospital in Shenzhen, China, whose non-invasive prenatal testing (NIPT) was sequenced at greater depth than conventional NIPT, and whose genotypes and hospital records are used to replicate and validate genetic studies of pregnancy traits such as platelet counts, gestational thrombocytopenia and gestational diabetes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5897</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NIPT PLUS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIPT PLUS pregnancy cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Shenzhen Maternal and Neonatal NIPT PLUS cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">NIPT PLUS cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002159"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1007%2Fs00125-023-06065-5/MediaObjects/125_2023_6065_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>In addition to the previously mentioned participants, we collected data from 4,688 individuals who sought maternity check-ups at Shenzhen Baoan Women’s and Children’s Hospital (Shenzhen, China) throughout the entire 40-week gestational period.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS004582</owl:annotatedTarget>
        <dcterms:title>Genetic basis of pregnancy-associated decreased platelet counts and gestational thrombocytopenia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38064665</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38064665</owl:annotatedTarget>
        <dcterms:title>Genetic basis of pregnancy-associated decreased platelet counts and gestational thrombocytopenia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38064665</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11033587/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We derived polygenic risk score (PRS) models in an independent NIPT PLUS cohort with 4642 pregnant women (these participants are characterized by a deeper sequencing depth in comparison to conventional NIPT).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of pregnant women recruited in 2020 and 2021 through the pregnancy screening programme of Shenzhen Baoan Women&apos;s and Children&apos;s Hospital in Shenzhen, China, whose non-invasive prenatal testing (NIPT) was sequenced at greater depth than conventional NIPT, and whose genotypes and hospital records are used to replicate and validate genetic studies of pregnancy traits such as platelet counts, gestational thrombocytopenia and gestational diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38064665</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38372780</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40325049</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11033587/supplementaryFiles</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002159"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5897</owl:annotatedTarget>
        <obo:IAO_0000116>pregnant women with deeper-sequenced NIPT in 2020-2021</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12053562/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GWAS results were replicated in two independent cohorts: the Baoan 20K cohort (n = 20,439) and the NIPT PLUS cohort (n = 5897) (Supplementary Notes).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002159"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NIPT PLUS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002160 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002160">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18655"/>
        <rdf:type rdf:nodeID="genid18657"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
