    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000226"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A birth cohort of 13,858 babies and their families recruited during 2007–2011 in the city of Bradford in the north of England, about half of Pakistani heritage, followed prospectively to investigate the determinants of childhood health and used for autozygosity and exome sequencing studies.</owl:annotatedTarget>
        <obo:IAO_0000119>https://ega-archive.org/studies/EGAS00001005273</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000226"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
