    <!-- http://www.ebi.ac.uk/coho/COHO_0002193 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002193">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18862"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/New_Zealand"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:21378990</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control sample of patients with angiographically proven coronary artery disease (stenosis of at least 50% of the vessel diameter in at least one coronary artery) from the Otago-Southland region of New Zealand, with age-matched controls from the same region who had no history of ischaemic heart disease, assembled alongside abdominal aortic aneurysm and peripheral arterial disease series from the same region; it served as a replication sample in genetic studies of coronary artery disease.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">495</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">460</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>NZ-CAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The New Zealand CAD Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">New Zealand CAD Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18862">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005010"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002193"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18862"/>
        <obo:IAO_0000116>coronary artery disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.323/MediaObjects/41588_2009_BFng323_MOESM13_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>New Zealand CAD patients all had angiographically proven coronary artery stenosis ≥50% of the vessel internal diameter in at least 1 vessel.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002193"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/New_Zealand"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2775049/</oboInOwl:hasDbXref>
        <rdfs:comment>Additional cohorts with coronary artery disease (CAD) and peripheral arterial disease (PAD)15 from the same geographical region of the New Zealand as the AAA controls groups were examined to determine the specificity of any associations with vascular disease phenotype.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002193"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21378990</owl:annotatedTarget>
        <dcterms:title>Large-scale association analysis identifies 13 new susceptibility loci for coronary artery disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21378990</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.784/MediaObjects/41588_2011_BFng784_MOESM10_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The New Zealand CAD Study 495/460 83.0 28.0/42.0 61.1 (10.4)/ 68.0 (6.6) n. a. 24</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002193"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control sample of patients with angiographically proven coronary artery disease (stenosis of at least 50% of the vessel diameter in at least one coronary artery) from the Otago-Southland region of New Zealand, with age-matched controls from the same region who had no history of ischaemic heart disease, assembled alongside abdominal aortic aneurysm and peripheral arterial disease series from the same region; it served as a replication sample in genetic studies of coronary artery disease.</owl:annotatedTarget>
