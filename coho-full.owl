    <!-- http://www.ebi.ac.uk/coho/COHO_0000137 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000137">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid1550"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000988"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>GCST90838701</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of European childhood and adolescent cancer-survivor cohorts that combines cohort, case-control, genetic and intervention research to investigate treatment-related fertility impairment, hearing loss and health-related quality of life.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PCL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">PanCareLIFE</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid1550">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006517"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000137"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid1550"/>
        <obo:IAO_0000116>childhood cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30273888+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Survival after cancer diagnosed during childhood or adolescence continues to improve with new treatments and supportive therapies. Optimal long-term care requires that risks to vulnerable organs are clearly defined and translated into guidelines that are implemented into practice. PanCareLIFE is a pan-European consortium that addresses survivorship issues comprising fertility, hearing impairment and quality of life.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000137"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000988"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6444213/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Data providers participating in WP4b and WP5 of PanCareLIFE: University of Bern, Instituto Giannina Gaslini, University Hospital Brno, Motol Teaching Hospital Prague, Kraeftens Bekaempelse, University Graz, Osteosarcoma clinical trial, University Hospital Muenster, Euramos clinical trial, University Lübeck, Academical Medical Center Amsterdam, Erasmus Medical Center Rotterdam, University Medical Center Groningen and Princess Máxima Center for Pediatric Oncology Utrecht.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000137"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Europe"/>
        <oboInOwl:hasDbXref>https://europepmc.org/abstract/MED/30273888</oboInOwl:hasDbXref>
        <rdfs:comment>PanCareLIFE is a pan-European consortium that addresses survivorship issues</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000137"/>
