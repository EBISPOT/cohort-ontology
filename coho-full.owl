        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:21131975</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control study of renal cell carcinoma in the region of Nijmegen, the Netherlands, run by Radboud University Nijmegen Medical Centre with the Comprehensive Cancer Centre East, whose cases of European descent form a hospital-based series (patients of the hospital&apos;s outpatient urology clinic who had given blood and lifestyle data from 1999 onwards for studies of gene–environment interactions in urological disease and were found through the cancer registry to have renal cell carcinoma) and a population-based series recruited in 2009 through the regional cancer registry (patients diagnosed in 1995–2008 before the age of 75). Its controls are participants of the population-based Nijmegen Biomedical Study.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">748</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1832</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>Dutch</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Dutch RCC Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Dutch Renal Cell Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15011">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
