        <obo:IAO_0000116>cases and controls in the GAPC Immunochip dataset of the 2012 meta-analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2467/MediaObjects/41588_2012_BFng2467_MOESM43_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Study Cases (N) Controls (N) Total λGC Kiel1 474 1,146 1,620 1.09 CASP2 1,359 1,400 2,759 1.06 WTCCC23 2,178 5,175 7,353 1.04 PAGE 3,580 5,902 9,482 0.992 GAPC 2,997 9,183 12,180 0.963</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
