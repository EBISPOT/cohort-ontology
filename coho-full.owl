    <!-- http://www.ebi.ac.uk/coho/COHO_0001349 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001349">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid12195"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001049"/>
        <obo:IAO_0000112>GCST002454</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of colorectal cancer in Guangzhou, China. Its cases are patients with histopathologically confirmed colorectal cancer recruited at Sun Yat-sen University Cancer Center between 2002 and 2012, and its controls are cancer-free men and women recruited in the same period from the physical examination centres of several large hospitals in Guangdong. Its four case-control collections (Guangzhou-1 to Guangzhou-4) were genotyped for genome-wide association studies of colorectal cancer in East Asians.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym Guangzhou also denotes Guangzhou cohort (COHO:0001348); this term is Guangzhou Colorectal Cancer Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3197</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3424</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>Asian Consortium, Colorectal Cancer Guangzhou</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Guangzhou</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Guangzhou CRC Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Guangzhou Colorectal Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12195">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005575"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001349"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12195"/>
        <obo:IAO_0000116>colorectal cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Cases were histopathologically confirmed patients with CRC recruited from Sun Yat-Sen University Cancer Center between January 2002 and January 2012 and controls were cancer-free men and women recruited from the physical examination centers of several large hospitals in Guangdong during the same time period.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001349"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Cases were histopathologically confirmed patients with CRC recruited from Sun Yat-Sen University Cancer Center between January 2002 and January 2012 and controls were cancer-free men and women recruited from the physical examination centers of several large hospitals in Guangdong during the same time period.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001349"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST002454</owl:annotatedTarget>
        <dcterms:title>Large-scale genetic study in East Asians identifies six new loci associated with colorectal cancer risk.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24836286</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4068797/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Specifically, stage 1 (GWAS discovery) consisted of five studies: Shanghai CRC Study 1 (Shanghai-1, n = 3,102), Shanghai CRC Study 2 (Shanghai-2, n = 908), Guangzhou CRC Study 1 (Guangzhou-1, n = 1,603), Aichi CRC Study 1 (Aichi-1, n =1,346), and Korean Cancer Prevention Study-II CRC (KCPS-II, n = 1,301).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001349"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of colorectal cancer in Guangzhou, China. Its cases are patients with histopathologically confirmed colorectal cancer recruited at Sun Yat-sen University Cancer Center between 2002 and 2012, and its controls are cancer-free men and women recruited in the same period from the physical examination centres of several large hospitals in Guangdong. Its four case-control collections (Guangzhou-1 to Guangzhou-4) were genotyped for genome-wide association studies of colorectal cancer in East Asians.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23263487</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24836286</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001349"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3197</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls from the four Guangzhou collections contributed to the 2014 Asia CRC Consortium GWAS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The four Guangzhou studies contributed a total of 3,197 cases and 3,424 controls to this project.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001349"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3424</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls from the four Guangzhou collections contributed to the 2014 Asia CRC Consortium GWAS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The four Guangzhou studies contributed a total of 3,197 cases and 3,424 controls to this project.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001349"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Guangzhou</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001350 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001350">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid12203"/>
        <rdf:type rdf:nodeID="genid12205"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001089"/>
        <obo:IAO_0000112>GCST90269914</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre longitudinal study, established in 1988 at 14 hemophilia treatment centres in the United States, of boys and young men aged 6 to 19 years with moderate to severe hemophilia, HIV-infected through clotting factor concentrates or HIV-uninfected, with their non-hemophiliac, HIV-uninfected male siblings as a comparison group, followed until 1996/97 to study the impact of HIV on physical growth and sexual maturation, immune function, and neurological and neuropsychological functioning.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">333</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HGDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hemophilia Growth and Development Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12203">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005109"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid12205">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0018660"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001350"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12203"/>
        <obo:IAO_0000116>HIV infection</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8498644+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Sixty-nine percent (n = 333) of a population of males between the ages of 6 and 19 years with moderate to severe hemophilia participated in a comprehensive baseline examination.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001350"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12205"/>
        <obo:IAO_0000116>hemophilia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8498644+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Sixty-nine percent (n = 333) of a population of males between the ages of 6 and 19 years with moderate to severe hemophilia participated in a comprehensive baseline examination.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001350"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10848312/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Data were prospectively collected in 14 U.S. hemophilia treatment centers through 1996/97.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001350"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90269914</owl:annotatedTarget>
        <dcterms:title>Africa-specific human genetic variation near CHD1L associates with HIV-1 load.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37532928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10848312/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The HGDS is a multicenter study of hemophilia and its complications that was established in 1988.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001350"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre longitudinal study, established in 1988 at 14 hemophilia treatment centres in the United States, of boys and young men aged 6 to 19 years with moderate to severe hemophilia, HIV-infected through clotting factor concentrates or HIV-uninfected, with their non-hemophiliac, HIV-uninfected male siblings as a comparison group, followed until 1996/97 to study the impact of HIV on physical growth and sexual maturation, immune function, and neurological and neuropsychological functioning.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11075607</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37532928</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:8498644</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001350"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">333</owl:annotatedTarget>
        <obo:IAO_0000116>boys and young men with hemophilia enrolled (siblings not counted)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-023-06370-4/MediaObjects/41586_2023_6370_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 333 children and adolescents were enrolled.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001350"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HGDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001351 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001351">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001620"/>
        <obo:IAO_0000112>GCST90832977</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based health study of residents of Hordaland County in Western Norway, begun in 1992-93 as the Hordaland Homocysteine Study by the Norwegian Health Screening Service, the University of Bergen and the Municipal Health Service in Hordaland, which invited residents by year of birth and place of residence, re-examined part of them together with further birth cohorts in 1997-99, and since 2018 has re-examined those born in 1950-51 who took part in both surveys, to study chronic diseases such as cardiovascular disease, cancer, osteoporosis, anxiety and depression and their prevention.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HUSK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Helseundersøkelsen i Hordaland</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Helseundersøkelsene i Hordaland</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Hordaland Health Studies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hordaland Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001351"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Norway"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11053069/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Hordaland Health Study (HUSK) is a community-based study in Western Norway conducted as a collaboration between the University of Bergen, the Norwegian Health Screening Service and the Municipal Health Service in Hordaland (https://husk-en.w.uib.no/)53.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001351"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90832977</owl:annotatedTarget>
        <dcterms:title>GWAS meta-analysis reveals key risk loci in essential tremor pathogenesis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38671141</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11053069/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Hordaland Health Study (HUSK) is a community-based study in Western Norway conducted as a collaboration between the University of Bergen, the Norwegian Health Screening Service and the Municipal Health Service in Hordaland (https://husk-en.w.uib.no/)53.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001351"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based health study of residents of Hordaland County in Western Norway, begun in 1992-93 as the Hordaland Homocysteine Study by the Norwegian Health Screening Service, the University of Bergen and the Municipal Health Service in Hordaland, which invited residents by year of birth and place of residence, re-examined part of them together with further birth cohorts in 1997-99, and since 2018 has re-examined those born in 1950-51 who took part in both surveys, to study chronic diseases such as cardiovascular disease, cancer, osteoporosis, anxiety and depression and their prevention.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38671141</obo:IAO_0000119>
        <obo:IAO_0000119>http://husk.w.uib.no</obo:IAO_0000119>
        <obo:IAO_0000119>https://husk-en.w.uib.no/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
