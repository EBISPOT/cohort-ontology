        <oboInOwl:hasRelatedSynonym>Human Biological Data Interchange</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>U.S.A. Human Biological Data Interchange</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Human Biological Data Interchange Repository</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16393">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
