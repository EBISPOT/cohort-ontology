    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000811"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90566696</owl:annotatedTarget>
        <dcterms:title>Deciphering the influence of socioeconomic status on brain structure: insights from Mendelian randomization.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40360725</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12436186/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Data provided by the Social Science Genetic Association Consortium (SSGAC) was used to add power to the gSES as well acting as a replication sample for educational attainment and household income and for use in Multivariable Mendelian Randomisation (MVMR).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000811"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium founded in 2011 of medical researchers and social scientists that coordinates genome-wide association studies of social-science outcomes such as educational attainment across more than 100 contributing cohorts and promotes harmonised phenotype measurement.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.thessgac.org/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000811"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3037499</owl:annotatedTarget>
        <obo:IAO_0000116>individuals in the 2022 educational attainment (EA4) GWAS meta-analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC9005349/</oboInOwl:hasDbXref>
        <rdfs:comment>Here we report and analyze results from an updated meta-analysis of EA in a combined sample nearly three times larger ( N = 3,037,499).</rdfs:comment>
    </owl:Axiom>
