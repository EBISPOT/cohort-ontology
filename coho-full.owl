    <!-- http://www.ebi.ac.uk/coho/COHO_0002238 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002238">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19181"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000752"/>
        <obo:IAO_0000112>PGS000733</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:24037755</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based, case-only study of African American and European American men aged 40 to 79 with newly diagnosed prostate cancer in North Carolina and Louisiana, United States, who were interviewed at home and gave blood, adipose tissue, urine and toenail samples, with medical records and tumour tissue reviewed, to investigate the social, individual and tumour-level causes of racial differences in prostate cancer aggressiveness.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2258</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NC-LA PCaP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>North Carolina - Louisiana Prostate Cancer Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>North Carolina-Louisiana Prostate Cancer Project Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>North Carolina-Louisiana Prostate Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PCaP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">North Carolina-Louisiana Prostate Cancer Project</rdfs:label>
    </owl:NamedIndividual>
