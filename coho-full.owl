        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8118723/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Amsterdam UMC COVID-19 biobank is a prospective cohort study containing clinical data and archive material from adult patients admitted with COVID-19 in two academic hospitals of Amsterdam UMC.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001485"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
