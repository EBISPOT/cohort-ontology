    <!-- http://www.ebi.ac.uk/coho/COHO_0000962 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000962">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid8760"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90244577</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre randomised controlled trial in primary care in Bristol, Birmingham and Newcastle, United Kingdom, in which adults aged 18–74 with a new episode of depression (an ICD-10 depressive episode and a Beck Depression Inventory score of at least 15), recruited from September 2005, were randomly allocated to citalopram or reboxetine to identify genetic and clinical predictors of response to antidepressant treatment.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">601</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GENPOD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GenPOD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GenPod</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">GENetic and clinical Predictors Of treatment response in Depression</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid8760">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002050"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000962"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8760"/>
        <obo:IAO_0000116>depression</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18498636+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The GenPod trial is a multi-centre randomised controlled trial. GPs referred patients aged between 18-74 years presenting with a new episode of depression, who did not have any medical contraindications to antidepressant medication and who had no history of psychosis or alcohol/substance abuse.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000962"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2426669/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study is being conducted in three centres within the UK; Bristol, Birmingham and Newcastle.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000962"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244577</owl:annotatedTarget>
        <dcterms:title>Identifying the Common Genetic Basis of Antidepressant Response.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35712048</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9117153/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GENPOD (GENetic and clinical Predictors Of treatment response in Depression) trial was funded by the UK Medical Research Council and supported by the UK Mental Health Research Network.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000962"/>
