        <obo:IAO_0000115>Any abnormality of the eye, including location, spacing, and intraocular abnormalities.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Eye disease</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Abnormality of the eye</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000478"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Eye disease</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000504 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000504">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012373"/>
        <obo:IAO_0000115>Abnormality of eyesight (visual perception).</obo:IAO_0000115>
        <rdfs:label>Abnormality of vision</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000505 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000505">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000504"/>
        <obo:IAO_0000115>Visual impairment (or vision impairment) is vision loss (of a person) to such a degree as to qualify as an additional support need through a significant limitation of visual capability resulting from either disease, trauma, or congenital or degenerative conditions that cannot be corrected by conventional means, such as refractive correction, medication, or surgery.</obo:IAO_0000115>
        <rdfs:label>Visual impairment</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000539 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000539">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012373"/>
        <obo:IAO_0000115>An abnormality in the process of focusing of light by the eye in order to produce a sharp image on the retina.</obo:IAO_0000115>
        <rdfs:label>Abnormality of refraction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000539"/>
        <obo:IAO_0000115>An abnormality of refraction characterized by the ability to see objects nearby clearly, while objects in the distance appear blurry.</obo:IAO_0000115>
        <rdfs:label>Myopia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000707 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000707">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <obo:IAO_0000115>An abnormality of the nervous system.</obo:IAO_0000115>
        <rdfs:label>Abnormality of the nervous system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000708 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000708">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011446"/>
        <obo:IAO_0000115>Atypical behavior is an abnormality in a person&apos;s actions that can be controlled or modulated by the will of the individual. While abnormal behaviors can be difficult to control, they are distinct from other abnormal actions that cannot be affected by the individual&apos;s will.</obo:IAO_0000115>
        <rdfs:label>Atypical behavior</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000716 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000716">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000745"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100851"/>
        <obo:IAO_0000115>Frequently experiencing feelings of being down, miserable, and/or hopeless; struggling to recover from these moods; having a pessimistic outlook on the future; feeling a pervasive sense of shame; having a low self-worth; experiencing thoughts of suicide and engaging in suicidal behavior.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Depressive disorder</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Depression</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000745 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000745">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025780"/>
        <obo:IAO_0000115>A reduction in willful and motivated goal-directed behavior that is considered the determinant of behavior and adaptation that allows individuals to get started, be energized to perform a sustained and directed action.</obo:IAO_0000115>
        <rdfs:label>Abnormal diminished volition</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000855 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000855">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0011014"/>
        <obo:IAO_0000115>Increased resistance towards insulin, that is, diminished effectiveness of insulin in reducing blood glucose levels.</obo:IAO_0000115>
        <rdfs:label>Insulin resistance</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000924 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000924">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0033127"/>
        <obo:IAO_0000115>An abnormality of the skeletal system.</obo:IAO_0000115>
        <rdfs:label>Abnormality of the skeletal system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000925 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000925">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0009121"/>
        <obo:IAO_0000115>Any abnormality of the vertebral column.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Abnormality of the backbone</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Abnormality of the vertebral column</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0000925"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Abnormality of the backbone</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000929 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0000929">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000234"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0009121"/>
        <obo:IAO_0000115>An abnormality of the skull, the bony framework of the head which is comprised of the neurocranium (with eight cranial bones) and the viscerocranium (facial skeleton) that comprises fourteen facial bones with the mandible as its largest bone.</obo:IAO_0000115>
        <rdfs:label>Abnormal skull morphology</rdfs:label>
    </owl:Class>
    


