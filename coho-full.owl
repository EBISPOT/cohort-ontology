    <!-- http://www.ebi.ac.uk/coho/COHO_0002710 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002710">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22927"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <obo:IAO_0000112>PGS000741</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:21295399</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of men aged 80 or younger who underwent prostate biopsy in Stockholm, Sweden, between 2005 and 2007, identified through pathology-department registries and excluding men with known prostate cancer before 2005. Participants provided blood samples and questionnaire information, with historical prostate-specific antigen measurements and cancer diagnoses, stage and grade obtained through laboratory and cancer-registry linkage, to investigate inherited susceptibility and improve prostate cancer risk prediction.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym STHM also denotes Stockholm 2 (COHO:0002413); this term is Stockholm-1.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The name The Stockholm Study also denotes Stockholm 2 (COHO:0002413); this term is Stockholm-1.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2135</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3106</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5241</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>STHLM1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STHM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STHM1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stockholm-1 cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stockholm-1 study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Stockholm Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Stockholm-1</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22927">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002710"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22927"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2560/MediaObjects/41588_2013_BFng2560_MOESM4_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>For the present study DNA was available from a total of 2126 prostate cancer cases and 2403 unaffected men.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002710"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4417350/</oboInOwl:hasDbXref>
        <rdfs:comment>From patient registries in two out of three pathology departments in Stockholm, Sweden, we identified 8088 men who had undergone at least one prostate biopsy between 1 January 2005 and 31 December 2007, representing 75% of all prostate biopsies conducted during this time period in Stockholm.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002710"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000741</owl:annotatedTarget>
        <dcterms:title>Polygenic hazard score is associated with prostate cancer in multi-ethnic populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33623038</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002710"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21295399</owl:annotatedTarget>
        <dcterms:title>Polygenic risk score improves prostate cancer risk prediction: results from the Stockholm-1 cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21295399</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4417350/</oboInOwl:hasDbXref>
        <rdfs:comment>The Stockholm-1 cohort (n = 5241) consisted of men who underwent a prostate biopsy during 2005 to 2007.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002710"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of men aged 80 or younger who underwent prostate biopsy in Stockholm, Sweden, between 2005 and 2007, identified through pathology-department registries and excluding men with known prostate cancer before 2005. Participants provided blood samples and questionnaire information, with historical prostate-specific antigen measurements and cancer diagnoses, stage and grade obtained through laboratory and cancer-registry linkage, to investigate inherited susceptibility and improve prostate cancer risk prediction.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21295399</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23535732</obo:IAO_0000119>
        <dcterms:contributor>GPT-6 (OpenAI), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002710"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2135</owl:annotatedTarget>
        <obo:IAO_0000116>Original consenting Stockholm-1 cohort: 5241 men with questionnaire, consent and blood sample; 2135 prostate-cancer-positive and 3106 noncancer first-known biopsies. The biopsy-negative group is a clinical comparison group, not unselected population controls. (2005–2007 qualifying biopsies; invitation date not independently stated)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4417350/</oboInOwl:hasDbXref>
        <rdfs:comment>All men diagnosed with PCa during 2005 and 2007 at the first known biopsy were classified as biopsy positive (n = 2135), and those with a noncancer diagnosis at the first known biopsy were defined as biopsy negative (n = 3106).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002710"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3106</owl:annotatedTarget>
        <obo:IAO_0000116>Original consenting Stockholm-1 cohort: 5241 men with questionnaire, consent and blood sample; 2135 prostate-cancer-positive and 3106 noncancer first-known biopsies. The biopsy-negative group is a clinical comparison group, not unselected population controls. (2005–2007 qualifying biopsies; invitation date not independently stated)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4417350/</oboInOwl:hasDbXref>
        <rdfs:comment>All men diagnosed with PCa during 2005 and 2007 at the first known biopsy were classified as biopsy positive (n = 2135), and those with a noncancer diagnosis at the first known biopsy were defined as biopsy negative (n = 3106).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002710"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5241</owl:annotatedTarget>
        <obo:IAO_0000116>Original consenting Stockholm-1 cohort: 5241 men with questionnaire, consent and blood sample; 2135 prostate-cancer-positive and 3106 noncancer first-known biopsies. The biopsy-negative group is a clinical comparison group, not unselected population controls. (2005–2007 qualifying biopsies; invitation date not independently stated)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4417350/</oboInOwl:hasDbXref>
        <rdfs:comment>We received complete questionnaire data, written consent, and a blood sample from 5241 men (response rate: 75%) (Fig. 1).</rdfs:comment>
    </owl:Axiom>
