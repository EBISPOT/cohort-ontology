    <!-- http://www.ebi.ac.uk/coho/COHO_0002040 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002040">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17802"/>
