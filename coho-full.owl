    <!-- http://www.ebi.ac.uk/coho/COHO_0002538 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002538">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21417"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>PMID:20522523</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study of the oldest old in Finland that includes all people aged 85 years or over who were living in the city of Vantaa, in southern Finland, on 1 April 1991, whose dementia status was assessed at baseline and at three follow-ups in 1994–99 and who underwent general and neuropathological autopsy whenever possible; its genotyped participants have been used in genetic studies of Alzheimer disease and other neuropathology of very old age and as Finnish controls in genome-wide association studies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">601</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Vantaa 85+</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Vantaa 85+ study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Vantaa85+</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Vantaa85+ study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Vantaa 85+ Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21417">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001627"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002538"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21417"/>
        <obo:IAO_0000116>dementia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5338150/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We have addressed this question by performing a population‐based and prospective neuropathological study on very elderly subjects (Vantaa 85+ study), to analyze the frequency and co‐occurrence of common old‐age‐associated neuropathologies and their impact on the development of clinical dementia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002538"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11706281/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The population-based Vantaa 85+ study cohort includes all 601 individuals aged ≥85 years who were living in Vantaa, Finland in 1991.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002538"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20522523</owl:annotatedTarget>
        <dcterms:title>Common genetic variation and susceptibility to partial epilepsies: a genome-wide association study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20522523</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2892941/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Finnish control data from the Vantaa85+ study were received in Beadstudio files and processed using the same protocol.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002538"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study of the oldest old in Finland that includes all people aged 85 years or over who were living in the city of Vantaa, in southern Finland, on 1 April 1991, whose dementia status was assessed at baseline and at three follow-ups in 1994–99 and who underwent general and neuropathological autopsy whenever possible; its genotyped participants have been used in genetic studies of Alzheimer disease and other neuropathology of very old age and as Finnish controls in genome-wide association studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20522523</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22911860</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26401513</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29379882</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36510334</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38938199</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002538"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
