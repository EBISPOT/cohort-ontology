        <owl:annotatedTarget>GCST90026612</owl:annotatedTarget>
        <dcterms:title>Genetic investigation of fibromuscular dysplasia identifies risk loci and shared genetics with common cardiovascular diseases.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34654805</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8521585/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Three-City Study (3C Study) is a population-based longitudinal study of the relation between vascular diseases and dementia in persons aged 65 years and older51.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000812"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based longitudinal study of adults aged 65 and over recruited in three French cities, Bordeaux, Dijon and Montpellier, and followed from 1999 to 2012 with repeated examinations of vascular risk factors, cognition and subclinical vascular disease to study the relation between vascular diseases and dementia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34654805</obo:IAO_0000119>
