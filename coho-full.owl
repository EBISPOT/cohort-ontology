    <!-- http://www.ebi.ac.uk/coho/COHO_0000209 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000209">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid2202"/>
        <obo:IAO_0000112>EGAS00001006707</obo:IAO_0000112>
        <obo:IAO_0000115>An international registry of the American Association for Cancer Research that aggregates clinical-grade tumour sequencing data and clinical outcomes from patients at participating cancer centres to support precision oncology research.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym GENIE also denotes Gene-Environmental Interaction and phenotype study (COHO:0000186) and GEnetics of Nephropathy: an International Effort (COHO:0002753); this term is AACR Project GENIE. The EGA study EGAS00001006707 tagged GENIE used this registry.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">242000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GENIE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genomics Evidence Neoplasia Information Exchange</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <rdfs:label xml:lang="en">AACR Project GENIE</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid2202">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004992"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000209"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2202"/>
        <obo:IAO_0000116>cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001006707</oboInOwl:hasDbXref>
        <rdfs:comment>Methods: This retrospective cohort study analysed genomics data for 121,771 patients who had undergone targeted sequencing compiled by the Genomics Evidence Neoplasia Information Exchange (GENIE) or Foundation Medicine (FM). A statistical approach was developed to identify patients with GCV-associated mutational signature (GCVsig) from targeted sequenced data of tumour samples.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000209"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS00001006707</owl:annotatedTarget>
        <dcterms:title>The University of Hong Kong Colon Cancer GCV Study</dcterms:title>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000209"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international registry of the American Association for Cancer Research that aggregates clinical-grade tumour sequencing data and clinical outcomes from patients at participating cancer centres to support precision oncology research.</owl:annotatedTarget>
        <obo:IAO_0000119>https://ega-archive.org/studies/EGAS00001006707</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
