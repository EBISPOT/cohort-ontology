        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001991"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002698"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:42006753</obo:IAO_0000112>
        <obo:IAO_0000115>A French general-purpose population-based cohort of adults aged 18–69 years at inclusion, randomly sampled from people covered by the national health insurance fund (CNAMTS) and included from the end of 2012 through health examinations at selected Health Screening Centres across France, with yearly questionnaires, periodic examinations, a biobank and linkage to national social and health databases; run by Inserm as a research infrastructure with a focus on occupational and social factors, chronic diseases and ageing.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">220000</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/CONSTANCES</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>CONSTANCES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CONSTANCES cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cohorte des Consultants des Centres d’Examens de Santé</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>French CONSTANCES population-based cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Constances</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.constances.fr/index_EN.php"/>
        <rdfs:seeAlso rdf:resource="https://www.constances.fr/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002624"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4690834/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Thanks to our partnership with CNAMTS, we are including the cohort participants in 22 selected HSCs located in 19 “départements” in different regions of France (Fig.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002624"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42006753</owl:annotatedTarget>
        <dcterms:title>Prevalence and profiles of adverse childhood experiences: a French nationwide study using the CONSTANCES cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42006753</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:42006753%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A cross-sectional observational study was conducted using retrospective data from the CONSTANCES cohort, a large population-based cohort study in France, including adults aged 18 to 69 years at enrolment.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002624"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A French general-purpose population-based cohort of adults aged 18–69 years at inclusion, randomly sampled from people covered by the national health insurance fund (CNAMTS) and included from the end of 2012 through health examinations at selected Health Screening Centres across France, with yearly questionnaires, periodic examinations, a biobank and linkage to national social and health databases; run by Inserm as a research infrastructure with a focus on occupational and social factors, chronic diseases and ageing.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26520638</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002624"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">220000</owl:annotatedTarget>
        <obo:IAO_0000116>adults aged 18-69 enrolled 2012-2020</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13084877/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We used data from Constances, a prospective cohort study of the French population, that includes 220 000 participants aged 18 to 69 at enrolment between 2012 and 2020.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002624"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CONSTANCES</owl:annotatedTarget>
