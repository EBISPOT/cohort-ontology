        <obo:IAO_0000112>GCST90105058</obo:IAO_0000112>
        <obo:IAO_0000115>A nationwide population-based register of more than 175,000 Danish twins from birth cohorts 1870 to 2009, established in the 1950s, that combines repeated surveys, in-person assessments, a biobank and linkage to Danish national registers, for studies of genetic and environmental influences on health, disease and ageing.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">175518</coho:numberOfParticipants>
