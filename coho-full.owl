        <rdfs:comment>ICON7 was conducted in advanced or high-risk early-stage ovarian cancer patients treated with carboplatin and paclitaxel with or without bevacizumab.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001264"/>
