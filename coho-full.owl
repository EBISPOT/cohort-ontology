    <!-- http://www.ebi.ac.uk/coho/COHO_0002145 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002145">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000456"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. NHS-egems is the Catalog&apos;s misspelling of NHS-cgems, the label the age-at-menopause GWAS of PMID:22267201 gives the Nurses&apos; Health Study&apos;s breast cancer GWAS set, genotyped by the CGEMS project; that paper lists the Nurses&apos; Health Study as exactly two sets, NHS-cgems and NHS-Hu. Replaced by COHO:0000456 (Nurses&apos; Health Study), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete NHS-egems</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002146 -->

