        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2970659</owl:annotatedTarget>
        <obo:IAO_0000116>participants of the 24 cohorts in the LC3 harmonized database, among whom 69,275 developed lung cancer (2022)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC9835888/</oboInOwl:hasDbXref>
        <rdfs:comment>Total 2,970,659 69,275 7665 (11) 28,618 (42) 31,462 (47)</rdfs:comment>
    </owl:Axiom>
