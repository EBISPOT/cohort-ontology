        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9436320/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SLI Consortium was funded by Wellcome Trust Grant 076566 and UK Medical Research Council Grant G1000569.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000850"/>
