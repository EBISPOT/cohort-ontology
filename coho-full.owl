        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">495</owl:annotatedTarget>
        <obo:IAO_0000116>coronary artery disease cases and controls of the study in the CARDIoGRAM 2011 replication sample (analysed subset; no size of the whole study is stated, and no total is given)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.784/MediaObjects/41588_2011_BFng784_MOESM10_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The New Zealand CAD Study 495/460 83.0 28.0/42.0 61.1 (10.4)/ 68.0 (6.6) n. a. 24</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002193"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
