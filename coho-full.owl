        <rdfs:comment>from the Finnish HPV vaccination cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002604"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The participants of a community-randomised phase IV trial in which early adolescents born 1992–1995 and resident in 33 Finnish communities were invited in 2007–2009 and assigned by community to gender-neutral HPV16/18 vaccination, HPV16/18 vaccination of girls with hepatitis B vaccination of boys, or gender-neutral hepatitis B vaccination, and followed up with cervicovaginal sampling from 18.5 years of age, to compare the overall and herd effects of gender-neutral and girls-only HPV vaccination.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25593103</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29055031</obo:IAO_0000119>
