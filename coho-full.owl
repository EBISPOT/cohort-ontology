    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000564">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid5014"/>
        <rdf:type rdf:nodeID="genid5016"/>
