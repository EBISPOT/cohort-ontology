    <!-- http://www.ebi.ac.uk/coho/COHO_0002107 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002107">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18338"/>
        <rdf:type rdf:nodeID="genid18340"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
