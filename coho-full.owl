    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002574"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21687"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2654370/</oboInOwl:hasDbXref>
        <rdfs:comment>The current report represents a subanalysis of the Women&apos;s Insights and Shared Experiences Study, a pair of case-control studies examining associations between exogenous hormone use, parity, estrogen-related genes, and endometrial or breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002574"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21689"/>
        <obo:IAO_0000116>endometrial cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2654370/</oboInOwl:hasDbXref>
        <rdfs:comment>The current report represents a subanalysis of the Women&apos;s Insights and Shared Experiences Study, a pair of case-control studies examining associations between exogenous hormone use, parity, estrogen-related genes, and endometrial or breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002574"/>
