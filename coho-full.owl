    <!-- http://www.ebi.ac.uk/coho/COHO_0001251 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001251">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11331"/>
        <rdf:type rdf:nodeID="genid11333"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90270120</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based longitudinal cohort study of the University of Wisconsin-Madison in which Wisconsin state employees aged 30 to 60, sampled from state payroll files, answered a mailed sleep and health survey in 1988, after which all respondents at high risk of sleep-disordered breathing by self-reported snoring, with an age- and sex-matched random sample of the others, were invited to overnight in-laboratory polysomnography repeated at about 4-year intervals, to study the natural history and health consequences of sleep-disordered breathing and other sleep disorders.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1545</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>University of Wisconsin Sleep Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WSC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WSCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Wisconsin Sleep Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Wisconsin Sleep Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11331">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_5200283"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid11333">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005296"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001251"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11331"/>
        <obo:IAO_0000116>sleep-disordered breathing</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2858234/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>As the epidemiological project of the SCOR application from the University of Wisconsin, we proposed the Wisconsin Sleep Cohort Study (WSCS), a longitudinal epidemiology study designed to investigate the natural history of SDB by conducting overnight PSG, repeated at 4-year intervals, on a random sample of the general population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001251"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11333"/>
        <obo:IAO_0000116>sleep apnea</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2858234/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>As the epidemiological project of the SCOR application from the University of Wisconsin, we proposed the Wisconsin Sleep Cohort Study (WSCS), a longitudinal epidemiology study designed to investigate the natural history of SDB by conducting overnight PSG, repeated at 4-year intervals, on a random sample of the general population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001251"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2858234/</oboInOwl:hasDbXref>
        <rdfs:comment>Payroll files of Wisconsin state employees served as the sampling frame.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90270120</owl:annotatedTarget>
        <dcterms:title>The genetic etiology of periodic limb movement in sleep.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35670608</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35670608+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a genome-wide association study (GWAS) of periodic limb movements in sleep (PLMS) using a joint analysis (i.e., discovery, replication, and joint meta-analysis) of four cohorts (MrOS, the Wisconsin Sleep Cohort Study, HypnoLaus, and MESA), comprised of 6843 total subjects.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based longitudinal cohort study of the University of Wisconsin-Madison in which Wisconsin state employees aged 30 to 60, sampled from state payroll files, answered a mailed sleep and health survey in 1988, after which all respondents at high risk of sleep-disordered breathing by self-reported snoring, with an age- and sex-matched random sample of the others, were invited to overnight in-laboratory polysomnography repeated at about 4-year intervals, to study the natural history and health consequences of sleep-disordered breathing and other sleep disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19743755</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35670608</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001251"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1545</owl:annotatedTarget>
        <obo:IAO_0000116>people who took part in the baseline in-laboratory sleep study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC10091093</oboInOwl:hasDbXref>
        <rdfs:comment>There were 1545 individuals (53% of those invited) who agreed to come in for a baseline sleep study (the primary reason for non-participation was the burden of being away from home overnight).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001251"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>WSC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001251"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>WSCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001252 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001252">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11341"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90502757</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based, multi-ethnic, cross-sectional genetic epidemiologic study of early childhood oral health, run by the University of North Carolina at Chapel Hill, that enrolled children aged 3 to 5 attending public preschools (Head Start programmes) across North Carolina, United States, from August 2016 to February 2019, examining their teeth in the preschools and collecting guardian questionnaires, saliva for genotyping and dental plaque, to study the genomics of early childhood caries.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8059</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ZOE 2.0 cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ZOE2.0</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">ZOE 2.0</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11341">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005276"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001252"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11341"/>
        <obo:IAO_0000116>early childhood caries</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7663650/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>ZOE 2.0 is an observational, cross-sectional, community-based epidemiologic investigation of early childhood oral health with focus on ECC.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001252"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7663650/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Specifically, the ZOE 2.0 study population was children attending public preschools (Head Start) in North Carolina, United States, between August 2016 and February 2019.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001252"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90502757</owl:annotatedTarget>
        <dcterms:title>Trans-ancestry genome-wide association study of childhood body mass index identifies novel loci and age-specific effects.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39885687</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39885687+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To identify genetic loci associated with early-childhood body mass index (BMI), we performed GWAS of BMI Z scores in eight ancestrally diverse cohorts: ZOE 2.0 cohort, the Santiago Longitudinal Study (SLS), the Vanderbilt University BioVU biobank, the Geisinger MyCode Health Initiative biobank, Study of Latino (SOL) Youth, Pelotas (Brazil) Birth Cohort, Cameron County Hispanic Cohort (CCHC), and Viva La Familia cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001252"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based, multi-ethnic, cross-sectional genetic epidemiologic study of early childhood oral health, run by the University of North Carolina at Chapel Hill, that enrolled children aged 3 to 5 attending public preschools (Head Start programmes) across North Carolina, United States, from August 2016 to February 2019, examining their teeth in the preschools and collecting guardian questionnaires, saliva for genotyping and dental plaque, to study the genomics of early childhood caries.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33139633</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001252"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8059</owl:annotatedTarget>
        <obo:IAO_0000116>children aged 3-5 enrolled 2016-2019</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7663650/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Between 2016 and 2019, the study enrolled 8059 3–5-year-old children attending public preschools in North Carolina, United States.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001252"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ZOE2.0</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


