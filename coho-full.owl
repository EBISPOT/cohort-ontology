        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">255</owl:annotatedTarget>
        <obo:IAO_0000116>participants enrolled as of 15 May 2012</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:23139856</oboInOwl:hasDbXref>
        <rdfs:comment>255 DIAN participants were enrolled as of May 15, 2012, the largest international cohort of ADAD individuals in the world.</rdfs:comment>
    </owl:Axiom>
