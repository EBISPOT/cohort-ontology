        <owl:annotatedTarget>EGAS00001001960</owl:annotatedTarget>
        <dcterms:title>Contribution of copy number variants to schizophrenia from a genome-wide study of 41,321 subjects.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27869829</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_json/PMC5737772/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we report the largest genome-wide analysis of CNVs for any psychiatric disorder to date, using datasets assembled by the Schizophrenia Working Group of the PGC.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000146"/>
