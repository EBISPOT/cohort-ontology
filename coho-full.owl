    <!-- http://www.ebi.ac.uk/coho/COHO_0002619 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002619">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22033"/>
        <rdf:type rdf:nodeID="genid22035"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <obo:IAO_0000112>PMID:40510537</obo:IAO_0000112>
        <obo:IAO_0000115>The participants of an 8-week double-blind randomised controlled dietary intervention trial run from 2012 to 2014 by the University of Oslo and the Oslo and Akershus University College of Applied Sciences, Norway, in which adults with moderately elevated cholesterol ate commercial food items in which saturated fat had been replaced by polyunsaturated fat, or control items, to study effects on blood lipids, immune-cell gene expression and blood metabolites.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">115</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/NOMA</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>Effect of fat quality on blood lipids and immune response</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fat quality on blood lipids and immune response</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NOMA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NOMA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NoMa</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">NoMa study</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.med.uio.no/imb/english/research/projects/noma/"/>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22033">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0003124"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid22035">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0900053"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002619"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22033"/>
        <obo:IAO_0000116>moderate hypercholesterolemia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6499508/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We recently conducted an 8-wk, double-blind, randomized controlled trial replacing SFAs with PUFAs in healthy subjects with moderate hypercholesterolemia (n = 99).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002619"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22035"/>
        <obo:IAO_0000116>replacing saturated fat with polyunsaturated fat in commercial food items</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/NOMA</oboInOwl:hasDbXref>
        <rdfs:comment>This randomized controlled trial aimed to investigate the health effects of replacing food items with a high content of saturated fatty acids with food items where a large portion of the saturated fat had been replaced with polyunsaturated fat.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002619"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Norway"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6499508/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted an 8-wk, double-blind, randomized controlled dietary intervention study at the Oslo and Akershus University College of Applied Sciences and the University of Oslo, Norway, from July 2012 until April 2014.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002619"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40510537</owl:annotatedTarget>
        <dcterms:title>Exposure to fine particulate matter in adults is associated with immune cell gene expression related to inflammation, the electron transport chain, and cell cycle regulation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40510537</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12159804/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study is a part of the LongITools project and includes cross-sectional data from the Rotterdam Study, a population-based cohort study, and NoMa, a randomized controlled trial.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002619"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The participants of an 8-week double-blind randomised controlled dietary intervention trial run from 2012 to 2014 by the University of Oslo and the Oslo and Akershus University College of Applied Sciences, Norway, in which adults with moderately elevated cholesterol ate commercial food items in which saturated fat had been replaced by polyunsaturated fat, or control items, to study effects on blood lipids, immune-cell gene expression and blood metabolites.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31051508</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.med.uio.no/imb/english/research/projects/noma/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002619"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">115</owl:annotatedTarget>
        <obo:IAO_0000116>subjects randomly assigned (2012-2014)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6499508/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In short, 701 subjects were assessed for eligibility, 115 were randomly assigned, 100 completed the study, and 99 were analyzed independent of the compliance (Supplemental Figure 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002619"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NOMA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002619"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NoMa</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002620 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002620">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22043"/>
        <rdf:type rdf:nodeID="genid22045"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Greece"/>
        <obo:IAO_0000112>PMID:41664457</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional national health examination and nutrition survey of a representative sample of adults aged 18 years and over in Greece, drawn by two-stage stratified random sampling across all prefectures and examined between June 2013 and December 2014 by the Hellenic Health Foundation, following European Health Examination Survey and EFSA methodology, to describe the population&apos;s dietary intake, nutritional status and health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4011</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/HYDRIA</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>Greek HYDRIA survey</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HYDRIA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HYDRIA 2013–2014 National Health and Nutrition study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HYDRIA survey</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Health and Nutrition Survey -HYDRIA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">National Health and Nutrition Survey – HYDRIA</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22043">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0050001"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid22045">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000021"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002620"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22043"/>
        <obo:IAO_0000116>adherence to the Mediterranean diet</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8949101/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study design for the HYDRIA survey followed the recommendations of the European Health Examination Survey (EHES) [18] and the European Food Safety Authority (EFSA) [19] for the collection of health and dietary data at a national level, allowing for intercountry comparisons.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002620"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22045"/>
        <obo:IAO_0000116>dietary intake</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8949101/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study design for the HYDRIA survey followed the recommendations of the European Health Examination Survey (EHES) [18] and the European Food Safety Authority (EFSA) [19] for the collection of health and dietary data at a national level, allowing for intercountry comparisons.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002620"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Greece"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13423517/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As part of the HYDRIA 2013–2014 National Health and Nutrition study, a cross-sectional survey of a nationally representative sample of adults in Greece, serum ferritin levels (SFL) were measured in participants aged ≥ 55 years, and dietary intake was assessed using two non-consecutive 24-h dietary recalls per participant.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002620"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Greece"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8949101/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The HYDRIA survey sampling frame covered all the 51 prefectures of the 13 regions of the country [3].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002620"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:41664457</owl:annotatedTarget>
        <dcterms:title>Serum ferritin levels in a sample of older participants in the Greek HYDRIA survey: associations with sociodemographic and lifestyle parameters including dietary iron intake and Mediterranean diet score.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41664457</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13423517/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As part of the HYDRIA 2013–2014 National Health and Nutrition study, a cross-sectional survey of a nationally representative sample of adults in Greece, serum ferritin levels (SFL) were measured in participants aged ≥ 55 years, and dietary intake was assessed using two non-consecutive 24-h dietary recalls per participant.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002620"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional national health examination and nutrition survey of a representative sample of adults aged 18 years and over in Greece, drawn by two-stage stratified random sampling across all prefectures and examined between June 2013 and December 2014 by the Hellenic Health Foundation, following European Health Examination Survey and EFSA methodology, to describe the population&apos;s dietary intake, nutritional status and health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35334847</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002620"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4011</owl:annotatedTarget>
        <obo:IAO_0000116>adults aged 18+ who took part in the 2013-2014 survey</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13423517/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>HYDRIA is a large nationally representative Greek survey that investigated food, macronutrient and micronutrient intakes in a sample of 4011 adults over 18 years of age, providing observations and conclusions on population health in relation to the nutritional status of the population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002620"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HYDRIA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002621 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002621">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22053"/>
        <rdf:type rdf:nodeID="genid22055"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>PMID:25370913</obo:IAO_0000112>
        <obo:IAO_0000115>The participants of a randomised crossover dietary intervention trial started in 2011 by the University of Eastern Finland with VTT Technical Research Centre of Finland, within the FIBREFECTS project, in which adults with self-reported gastrointestinal symptoms after eating grain products ate white wheat bread during a run-in and then wholegrain rye bread and wheat bread enriched with bioprocessed rye bran, to study the effects of modified cereal fibre on glucose metabolism, gut fermentation and gut-mediated health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/FEF</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>FEF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FIBREFECTS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fibrefects</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fibrefects - Grain fibre modification for gut-mediated health effects</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Grain Fibre Modification for Gut-Mediated Health Effects</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Grain Fibre and Gut Health</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Grain fiber modification for gut mediated health effects</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Grain fibre modification for gut-mediated health effects</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCT03550365</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Grain Fibre Modification for Gut-mediated Health Effects</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22053">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0070112"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid22055">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_2000068"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002621"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22053"/>
        <obo:IAO_0000116>wholegrain rye bread</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4230797/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The aim was to investigate whether the white wheat bread enriched with bioprocessed rye bran (BRB + WW) promotes similar effects to WGR on glucose metabolism and plasma levels of SCFAs in healthy subjects with self-reported gastrointestinal symptoms.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002621"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22055"/>
        <obo:IAO_0000116>wheat bread enriched with bioprocessed rye bran</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4230797/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The aim was to investigate whether the white wheat bread enriched with bioprocessed rye bran (BRB + WW) promotes similar effects to WGR on glucose metabolism and plasma levels of SCFAs in healthy subjects with self-reported gastrointestinal symptoms.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002621"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4230797/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study was approved by the Ethics Committee of the Hospital District of Northern Savo.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002621"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25370913</owl:annotatedTarget>
        <dcterms:title>Postprandial glucose metabolism and SCFA after consuming wholegrain rye bread and wheat bread enriched with bioprocessed rye bran in individuals with mild gastrointestinal symptoms.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25370913</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4230797/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study was carried out as a part of the FIBREFECTS (Grain fiber modification for gut mediated health effects) funded mainly by TEKES – The Finnish Funding Agency for Technology and Innovation – and to a smaller extent by Oy Karl Fazer Ab, Vaasan Oy, and Ravintoraisio Oy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002621"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The participants of a randomised crossover dietary intervention trial started in 2011 by the University of Eastern Finland with VTT Technical Research Centre of Finland, within the FIBREFECTS project, in which adults with self-reported gastrointestinal symptoms after eating grain products ate white wheat bread during a run-in and then wholegrain rye bread and wheat bread enriched with bioprocessed rye bran, to study the effects of modified cereal fibre on glucose metabolism, gut fermentation and gut-mediated health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25370913</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/study/NCT03550365</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002621"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23</owl:annotatedTarget>
        <obo:IAO_0000116>subjects recruited (21 completed)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC4230797</oboInOwl:hasDbXref>
        <rdfs:comment>Twenty-one (12 women) of 23 recruited subjects completed an intervention with a four-week run-in and two four-week test periods in cross-over design.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
