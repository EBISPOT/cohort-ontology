        <obo:IAO_0000112>PMID:37533684</obo:IAO_0000112>
        <obo:IAO_0000115>A multidisciplinary population-based prospective cohort of men and women aged 19 to 74 years drawn at random from the general population and examined between 2014 and 2019 at 18 study centres across Germany, with interviews, questionnaires, biomedical examinations, biosamples and whole-body magnetic resonance imaging in a subsample, followed up by questionnaires, record linkage and re-examination, to investigate the causes, early detection and prevention of common chronic and infectious diseases.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">205415</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GNC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>German National Cohort (NAKO)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>German National Cohort health study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NAKO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NAKO Gesundheitsstudie</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NAKO Health Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">German National Cohort</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://nako.de/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002683"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
