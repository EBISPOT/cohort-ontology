    <!-- http://www.ebi.ac.uk/coho/COHO_0001512 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001512">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13686"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002713"/>
        <obo:IAO_0000112>PMID:29674426</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of non-Hodgkin lymphoma in British Columbia, Canada, which invited residents of Greater Vancouver and Greater Victoria aged 20–79 with non-Hodgkin lymphoma diagnosed from March 2000 to February 2004, identified through the BC Cancer Registry (excluding HIV-positive and post-transplant cases), together with population controls from the Client Registry of the British Columbia Ministry of Health frequency-matched to the cases on sex, age and area of residence, to study environmental and genetic risk factors for the disease.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">828</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">848</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>BC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BCCA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>British Columbia Non-Hodgkin Lymphoma Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">British Columbia Non-Hodgkin Lymphoma study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13686">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0018908"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001512"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13686"/>
        <obo:IAO_0000116>non-Hodgkin lymphoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2788526/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All HIV-negative NHL cases diagnosed in British Columbia from March 2000 to February 2004, residing in the Greater Vancouver Regional District and greater Victoria (Capital Regional District), aged 20 to 79 were invited to participate.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001512"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17722095+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We investigated PCBs and organochlorine pesticides and risk of NHL in a population-based case-control study in British Columbia, Canada.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001512"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29674426</owl:annotatedTarget>
        <dcterms:title>Association of polygenic risk score with the risk of chronic lymphocytic leukemia and monoclonal B-cell lymphocytosis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29674426</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5992865/</oboInOwl:hasDbXref>
        <rdfs:comment>BC, British Columbia Non-Hodgkin Lymphoma study; ENGELA, Environmental and Genetic Risks Factors Study in Adult Lymphoma; EPILYMPH, European multi-center case–control study; MAYO, Mayo Clinic; NSW, New South Wales non-Hodgkin Lymphoma study; SCALE, Scandinavian Lymphoma Etiology study; UCSF2, University of California San Diego Molecular Epidemiology of non-Hodgkin Lymphoma study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001512"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of non-Hodgkin lymphoma in British Columbia, Canada, which invited residents of Greater Vancouver and Greater Victoria aged 20–79 with non-Hodgkin lymphoma diagnosed from March 2000 to February 2004, identified through the BC Cancer Registry (excluding HIV-positive and post-transplant cases), together with population controls from the Client Registry of the British Columbia Ministry of Health frequency-matched to the cases on sex, age and area of residence, to study environmental and genetic risk factors for the disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17722095</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19917125</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26956414</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001512"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">828</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls who completed at least part of the study questionnaire; no total stated</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:19917125</oboInOwl:hasDbXref>
        <rdfs:comment>828 cases and 848 controls completed at least part of a study questionnaire; however, only those subjects with DNA available were used in this study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001512"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">848</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls who completed at least part of the study questionnaire; no total stated</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:19917125</oboInOwl:hasDbXref>
        <rdfs:comment>828 cases and 848 controls completed at least part of a study questionnaire; however, only those subjects with DNA available were used in this study.</rdfs:comment>
    </owl:Axiom>
