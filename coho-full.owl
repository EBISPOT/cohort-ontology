        <rdfs:comment>Patients with early untreated seropositive RA were recruited from 28 UK centres.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002742"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS1497</owl:annotatedTarget>
        <dcterms:title>RA-MAP: mapping the molecular immunological landscape in early rheumatoid arthritis with vaccine controls</dcterms:title>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS1497</oboInOwl:hasDbXref>
        <rdfs:comment>In the Towards A Cure for Early Rheumatoid Arthritis (TACERA) study, 239 out of 267 eligible patients, newly diagnosed with symptom duration less than 12 mth and untreated with DMARDs or corticosteroids, had a 6-mth assessment visit.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002742"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An inception cohort of newly diagnosed, initially treatment-naive patients with seropositive rheumatoid arthritis, recruited from 28 centres in the United Kingdom and assessed every three months for up to 18 months, established by the RA-MAP Consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34707695</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
