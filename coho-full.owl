        <obo:IAO_0000112>PXD057946</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of middle-aged and older residents of Rotterdam, the Netherlands, established in 1990 and followed prospectively to investigate the causes, early development and natural history of chronic diseases and possible targets for intervention.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17931</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>RS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Rotterdam</oboInOwl:hasRelatedSynonym>
