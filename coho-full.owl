        <rdfs:comment>Stage 1 included 5,472 women (2,695 cases and 2,777 controls) of European ancestry from seven studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001077"/>
