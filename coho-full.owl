    <!-- http://www.ebi.ac.uk/coho/COHO_0001633 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001633">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. CRUK-CRI is the PGS Catalog&apos;s label for Cancer Research UK&apos;s Cambridge Research Institute (Li Ka Shing Centre), an author affiliation in PMID:29892050, placed among the GWAS datasets of PGS000751&apos;s variant source. By elimination it most likely stands for the &apos;UK stage 1 and 2&apos; GWAS of that meta-analysis (the only sub-cohort the Catalog&apos;s list lacks), but no text says so; either way it is an institution, not a named study sample. The UK stage 1 and 2 GWAS are genotyping stages of the UK prostate cancer GWAS rather than a cohort. No COHO term or review row uses the name. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Cancer Research UK - Cambridge Research Institute</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001634 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001634">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14720"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS000799</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:29273806</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre family study of the genetics of asthma supported by the US National Heart, Lung, and Blood Institute, in which African American, European American and Hispanic families were ascertained through two siblings with asthma at centres at Johns Hopkins University, the University of Chicago, the University of Minnesota and the University of Maryland, to identify loci contributing to asthma and asthma-associated phenotypes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CSGA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Collaborative Studies on the Genetics of Asthma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NHLBI Collaborative Studies on the Genetics of Asthma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Collaborative Study on the Genetics of Asthma</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14720">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001634"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14720"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC1226130/</oboInOwl:hasDbXref>
        <rdfs:comment>Families were ascertained through two siblings with asthma and then were expanded to include other affected relatives, by extending the family either through relatives with asthma or through one unaffected relative.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001634"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC1226130/</oboInOwl:hasDbXref>
        <rdfs:comment>All 266 families were ascertained through sib pairs with asthma at the CSGA centers in the United States.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001634"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000799</owl:annotatedTarget>
        <dcterms:title>Genetic risk scores do not improve asthma prediction in childhood.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31145937</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001634"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29273806</owl:annotatedTarget>
        <dcterms:title>Multiancestry association study identifies new asthma risk loci that colocalize with immune-cell enhancer marks.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29273806</oboInOwl:hasDbXref>
