    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000990 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000990">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid9033"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000460"/>
        <obo:IAO_0000112>GCST90244653</obo:IAO_0000112>
        <obo:IAO_0000115>A study at Wake Forest School of Medicine that, after the family-based Diabetes Heart Study and in parallel with it, enrolled unrelated African Americans with type 2 diabetes under the same inclusion criteria and analyses them together with that study&apos;s African American participants, to investigate ethnic differences in and inherited contributions to calcified atherosclerotic plaque and related traits such as bone density, vitamin D and, in its MIND extension, brain structure and cognition.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">717</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AA-DHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>African American DHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>African American-DHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>African American-diabetes heart study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">African American-Diabetes Heart Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9033">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000990"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9033"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8136717/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To identify genetic factors contributing to vitamin D and BMD measures, association analysis of &gt;14M variants was conducted in a maximum of 697 African American-Diabetes Heart Study participants with type 2 diabetes (T2D).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000990"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000460"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3061609/</oboInOwl:hasDbXref>
        <rdfs:comment>DHS comprises a series of studies to analyze vascular diabetic complications. Data collection in DHS-Bone and DHS-Fat are completed. DHS-GWAS, DHS-Mind, and African American DHS are currently ongoing.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000990"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244653</owl:annotatedTarget>
        <dcterms:title>Whole genome sequence analysis of blood lipid levels in &gt;66,000 individuals.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36220816</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9553944/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Diabetes Heart Study (DHS, n=365): TOPMed dbGaP accession#: phs001412, Parent dbGaP accession#: phs001012, Sequencing Center: Broad Institute of MIT and Harvard</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000990"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study at Wake Forest School of Medicine that, after the family-based Diabetes Heart Study and in parallel with it, enrolled unrelated African Americans with type 2 diabetes under the same inclusion criteria and analyses them together with that study&apos;s African American participants, to investigate ethnic differences in and inherited contributions to calcified atherosclerotic plaque and related traits such as bone density, vitamin D and, in its MIND extension, brain structure and cognition.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19825824</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21409311</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34014961</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000990"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">717</owl:annotatedTarget>
        <obo:IAO_0000116>participants analysed with CT calcified plaque measures (analysed subset)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:25054777</oboInOwl:hasDbXref>
        <rdfs:comment>To determine this, 717 African American-Diabetes Heart Study participants underwent computed tomography to determine coronary artery-, carotid artery-, and aorta-calcified atherosclerotic plaque mass scores in addition to the urine albumin:creatinine ratio (UACR), eGFR, and C-reactive protein (CRP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000990"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AA-DHS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


