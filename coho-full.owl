        <obo:IAO_0000112>PMID:40879407</obo:IAO_0000112>
        <obo:IAO_0000115>A sub-study of the fourth wave (HUNT4, 2017–2019) of the Trøndelag Health Study in which all inhabitants aged 70 years and older in the northern Trøndelag region of Norway were invited to detailed assessments of cognition and health, used to study the prevalence and incidence of dementia and mild cognitive impairment.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9956</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HUNT 70+</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HUNT 70+ study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HUNT 70+, The HUNT Study</oboInOwl:hasRelatedSynonym>
