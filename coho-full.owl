        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021637"/>
        <obo:IAO_0000115>A grade I or grade II astrocytic tumor. This category includes pilocytic astrocytoma (grade I), subependymal giant cell astrocytoma (grade I), and diffuse astrocytoma (grade II).</obo:IAO_0000115>
        <rdfs:label>low grade astrocytic tumor</rdfs:label>
    </owl:Class>
    


