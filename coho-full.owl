    <!-- http://www.ebi.ac.uk/coho/COHO_0001254 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001254">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11361"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002691"/>
        <obo:IAO_0000112>GCST90841457</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective pre-birth cohort, run from Harvard Medical School and the Harvard Pilgrim Health Care Institute, of women recruited in early pregnancy at eight obstetric offices of Atrius Harvard Vanguard Medical Associates, a multi-specialty group practice in eastern Massachusetts, United States, from April 1999 to November 2002, and their children, followed with in-person visits during pregnancy, at delivery, in infancy, early and mid-childhood and early adolescence and with annual mailed questionnaires, to examine prenatal diet and other early-life factors in relation to maternal and child health.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym VIVA also denotes Viborg Vascular (COHO:0001129); this term is Project Viva.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2341</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>VIVA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Viva</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Project Viva</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11361">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_2000076"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001254"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11361"/>
        <obo:IAO_0000116>prenatal diet</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24639442+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We established Project Viva to examine prenatal diet and other factors in relation to maternal and child health.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001254"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40192100+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We analyzed mother-child pairs in Project Viva, a prospective prebirth cohort in eastern Massachusetts, USA.</rdfs:comment>
    </owl:Axiom>
