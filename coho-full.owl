        <rdfs:comment>A subset of 113 participants with early-onset atrial fibrillation underwent WGS as a part of the TOPMed Program.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002483"/>
