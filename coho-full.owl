    <!-- http://www.ebi.ac.uk/coho/COHO_0001629 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001629">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
