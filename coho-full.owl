        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9851382/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The IBDGC cohort was established in 2003, when 6 genetic research centers (GRCs) in the United States and Canada began recruiting patients with confirmed CD, UC, or IBD-U, for IBD gene discovery.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000718"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid6461"/>
        <obo:IAO_0000116>ulcerative colitis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9851382/fullTextXML</oboInOwl:hasDbXref>
