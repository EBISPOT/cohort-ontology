    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001815"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16204"/>
        <obo:IAO_0000116>overweight</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2928335/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Five hundred pairs of age- and sex-matched subjects (overweight/obesity) and control subjects (normal-weight) were planned to be recruited.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001815"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16206"/>
        <obo:IAO_0000116>obesity</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2928335/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Five hundred pairs of age- and sex-matched subjects (overweight/obesity) and control subjects (normal-weight) were planned to be recruited.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001815"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2928335/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Gut Microbiota and Obesity Study was a population-based case-control study among noninstitutionalized residents aged 35–54 years in Shanghai, China.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001815"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22961080</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study identifies GRK5 and RASGRP1 as type 2 diabetes loci in Chinese Hans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22961080</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526061/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The stage 1 samples for the GWA scan included 1,999 T2D case subjects and 1,976 nondiabetic control subjects drawn from the Nutrition and Health of Aging Population in China (NHAPC) study (312 case and 815 control subjects), the Gut Microbiota and Obesity Study (GMOS) (82 case and 163 control subjects), the Fudan-Huashan Study (807 case and 339 control subjects), and the Beijing Diabetes Survey (798 case and 659 control subjects).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001815"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of overweight or obese adults and age- and sex-matched normal-weight controls aged 35–54 years, noninstitutionalized residents of two urban districts of Shanghai, China (Luwan and Zhabei), recruited from November 2007 to January 2008 to investigate the effects of gut microbiota and environmental factors on obesity and related metabolic disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20530747</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
