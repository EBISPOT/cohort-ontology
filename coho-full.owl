        <rdfs:comment>Essen-Heidelberg, Germany Histologically confirmed cutaneous melanoma cases (N = 1,218) were genotyped using the Illumina HumanCytoSNP-12v1-0_D arrays (San Diego, CA, USA).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001322"/>
