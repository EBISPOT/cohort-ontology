        <obo:IAO_0000112>PMID:31792088</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium that harmonizes risk-factor and prospective follow-up data on women carrying pathogenic BRCA1 or BRCA2 variants from the International BRCA1/2 Carrier Cohort Study, Breast Cancer Family Registry and kConFab. Participants are drawn from clinical genetics and population-based family studies to estimate breast, ovarian and contralateral breast cancer risks and investigate their genetic and non-genetic modifiers.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym BBCC also denotes Bavarian Breast Cancer Cases and Controls Study (COHO:0001058); this term is BRCA1 and BRCA2 Cohort Consortium.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9845</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BBCC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BRCA1 and BRCA2 cohort consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The BRCA1 and BRCA2 Cohort Consortium</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">BRCA1 and BRCA2 Cohort Consortium</rdfs:label>
    </owl:NamedIndividual>
