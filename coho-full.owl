    <!-- http://www.ebi.ac.uk/coho/COHO_0001717 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001717">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15365"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>PMID:28053049</obo:IAO_0000112>
        <obo:IAO_0000115>A family study of five extended French-Canadian pedigrees, identified between 2005 and 2006 at the Thrombosis Clinic of the Ottawa Hospital, Canada, through single probands with objectively diagnosed idiopathic venous thromboembolism who carried the factor V Leiden mutation, whose consenting relatives were genotyped genome-wide and measured for plasma haemostatic factors.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">255</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>F5L</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>F5L Family Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>F5L Thrombophilia French-Canadian Pedigree study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>F5L family</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>F5L family study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>F5L-families study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>F5Leiden</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>F5Leiden Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>French-Canadian FVL family study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>French-Canadian family study on Factor V Leiden</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">French-Canadian Family Study on Factor V Leiden Thrombophilia</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15365">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005399"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001717"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15365"/>
        <obo:IAO_0000116>venous thrombosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4179266/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The family study is composed of five extended French-Canadian pedigrees, totaling 255 relatives, ascertained at the Thrombosis Clinic of the Ottawa Hospital through single probands with idiopathic VT and heterozygote for the Factor V Leiden mutation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001717"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6544906/</oboInOwl:hasDbXref>
        <rdfs:comment>Probands were identified from the Thrombosis Clinic of The Ottawa Hospital, Ottawa, Canada, between 2005 and 2006, and had idiopathic, objectively diagnosed VTE, and carried the FV Leiden (F5L) mutation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001717"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28053049</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study with additional genetic and post-transcriptional analyses reveals novel regulators of plasma factor XI levels.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28053049</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5703348/</oboInOwl:hasDbXref>
        <rdfs:comment>The study consists of a discovery sample of 16,169 individuals of European ancestry from five studies (ARIC, PROCARDIS, GHS-1, GHS-2, and MARTHA) and a replication sample of 2,045 individuals from three studies (F5Leiden Cohort, MEGA, and GAIT2); for details, see Supplementary Material, Table S1.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001717"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family study of five extended French-Canadian pedigrees, identified between 2005 and 2006 at the Thrombosis Clinic of the Ottawa Hospital, Canada, through single probands with objectively diagnosed idiopathic venous thromboembolism who carried the factor V Leiden mutation, whose consenting relatives were genotyped genome-wide and measured for plasma haemostatic factors.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21810271</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25265411</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27490645</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28894120</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001717"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">255</owl:annotatedTarget>
        <obo:IAO_0000116>members of the five families who consented to take part (2005-2006)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5593822/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The French-Canadian Family study on Factor V Leiden (F5L) Thrombophilia (henceforth the F5L family study) included 369 individuals from 5 extended families27 of which 255 invited subjects consented to participate in the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001717"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>F5L</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001717"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>F5Leiden</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001718 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001718">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15373"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <obo:IAO_0000112>PMID:20453838</obo:IAO_0000112>
        <obo:IAO_0000115>A study coordinated from the Institute of Cancer Research, Sutton, that from 1995 recruited people with breast cancer and a family history of the disease, as the index cases of their families, through cancer genetics clinics throughout the United Kingdom, whose clinicians and counsellors formed the Breast Cancer Susceptibility Collaboration (UK), for research into inherited susceptibility to breast cancer.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym FBCS also denotes French Bladder Cancer Study (COHO:0000824); this term is Familial Breast Cancer Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3652</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>FBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Familial Breast Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ICR Familial Breast Cancer Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Familial Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15373">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001718"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15373"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3632835/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Cases were unrelated individuals with breast cancer and a family history of breast cancer that were recruited through cancer genetics clinics in the UK, through the Genetics of Familial Breast Cancer Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001718"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC3632836</oboInOwl:hasDbXref>
        <rdfs:comment>Three thousand nine hundred and sixty breast cancer cases were used in stage 1, of which 3,652 were from cancer genetics clinics in the UK recruited through the Familial Breast Cancer Study (FBCS) and 308 were from oncology clinics in the UK recruited through the Prospective study of Outcomes in Sporadic versus Hereditary breast cancer (POSH) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001718"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20453838</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies five new breast cancer susceptibility loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20453838</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC3632836</oboInOwl:hasDbXref>
        <rdfs:comment>Three thousand nine hundred and sixty breast cancer cases were used in stage 1, of which 3,652 were from cancer genetics clinics in the UK recruited through the Familial Breast Cancer Study (FBCS) and 308 were from oncology clinics in the UK recruited through the Prospective study of Outcomes in Sporadic versus Hereditary breast cancer (POSH) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001718"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study coordinated from the Institute of Cancer Research, Sutton, that from 1995 recruited people with breast cancer and a family history of the disease, as the index cases of their families, through cancer genetics clinics throughout the United Kingdom, whose clinicians and counsellors formed the Breast Cancer Susceptibility Collaboration (UK), for research into inherited susceptibility to breast cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20453838</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20512659</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25855707</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001718"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3652</owl:annotatedTarget>
        <obo:IAO_0000116>FBCS breast cancer cases in stage 1 of the 2010 GWAS (analysed subset)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3632836/</oboInOwl:hasDbXref>
        <rdfs:comment>Three thousand nine hundred and sixty breast cancer cases were used in stage 1, of which 3,652 were from cancer genetics clinics in the UK recruited through the Familial Breast Cancer Study (FBCS) and 308 were from oncology clinics in the UK recruited through the Prospective study of Outcomes in Sporadic versus Hereditary breast cancer (POSH) study.</rdfs:comment>
    </owl:Axiom>
