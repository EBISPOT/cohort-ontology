        <obo:IAO_0000116>type 1 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC7096091</oboInOwl:hasDbXref>
        <rdfs:comment>The objective of the EURODIAB FS is to identify genes and pathways involved in the pathogenesis of nephropathy (DN) and retinopathy (DR) in type 1 DM.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001712"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
