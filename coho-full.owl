        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001688"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1895</owl:annotatedTarget>
        <obo:IAO_0000116>Unaffected predictive-test-negative women in the EMBRACE breast-cancer analysis reported in 2018</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6033314/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1,895 unaffected women were eligible for inclusion in the BC risk analysis and 1,736 in the EOC risk analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001688"/>
