    <!-- http://www.ebi.ac.uk/coho/COHO_0002523 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002523">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000597"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. UNC-Rectal is the North Carolina Rectal Cancer Study. This is phase II of the North Carolina Colon Cancer Study (NCCCS-II), which COHO already has as COHO:0000597. That term&apos;s definition covers phase II: sigmoid, rectosigmoid and rectal cancer cases, May 2001 to September 2006. The two descriptions match point for point. NCCCS-II (https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3111915/unicode): &quot;The North Carolina Colon Cancer Study-Phase II (NCCCS-II) was a population-based case-control study of incident distal large bowel cancer (rectal, recto-sigmoid, or sigmoid cancer) in 33 counties in the central and eastern part of North Carolina.&quot;, with cases &quot;identified through the rapid case ascertainment system of the North Carolina Central Cancer Registry between May 2001 and September 2006&quot;. UNC-Rectal (E1177.17-E1177.18): the same 33-county area, the same three tumour sites, the same registry, the same dates, and controls from motor-vehicle and Medicare records. Add the catalog&apos;s name (typo &apos;Noth&apos; included, as the catalog tags it) and the study&apos;s own names as synonyms, and UNC-Rectal as an acronym. PMID:26683305 also abbreviates this study as &apos;UNC&apos;. That abbreviation is a paper&apos;s shorthand, not the study&apos;s acronym or a catalog tag, and COHO:0001179 already carries it, so it is not proposed. The placeholder COHO:0002523 is then a duplicate of COHO:0000597. Replaced by COHO:0000597 (North Carolina Colon Cancer Study), which now carries this term&apos;s names. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete University of Noth Carolina Rectal Cancer Study</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002524 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002524">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21318"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000651"/>
        <obo:IAO_0000112>PMID:25031287</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort study of patients with non-disabling cerebral ischaemia of arterial origin referred to the University Medical Center Utrecht, the Netherlands, and included between 1994 and 2009 in the SMART study or the Utrecht Stroke Database, whose patients were genotyped with the Illumina Immunochip and followed up for new vascular events in order to test whether genetic information improves prognostic models for new ischaemic and haemorrhagic events. Its genotyped patients were also the Utrecht Immunochip case sample of genetic association studies of ischaemic stroke.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1125</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PROMISe</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PROMISe Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PROMISe study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UNISS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Utrecht ImmunoChip Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Utrecht, The Netherlands ImmunoChip Study Samples</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Prognostic Modelling in Ischaemic Stroke study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21318">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0002637"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002524"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21318"/>
        <obo:IAO_0000116>cerebral ischemia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4408031/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We therefore included only patients with cerebral ischemia of arterial origin.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002524"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4408031/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We collected data of patients with non-disabling cerebral ischemia of arterial origin, who were referred to the University Medical Center Utrecht, The Netherlands and were included in the SMART (Second Manifestations of Arterial disease) study, or the Utrecht Stroke Database (USDB).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002524"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25031287</owl:annotatedTarget>
        <dcterms:title>Meta-analysis in more than 17,900 cases of ischemic stroke reveals a novel association at 12q24.12.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25031287</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4150131/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participating centers were based in Belgium, Germany, the Netherlands (the PROMISe Study), Poland, Sweden, and the UK (2 cohorts, one from London [Imperial College; the BRAINS study] and one from Glasgow).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002524"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort study of patients with non-disabling cerebral ischaemia of arterial origin referred to the University Medical Center Utrecht, the Netherlands, and included between 1994 and 2009 in the SMART study or the Utrecht Stroke Database, whose patients were genotyped with the Illumina Immunochip and followed up for new vascular events in order to test whether genetic information improves prognostic models for new ischaemic and haemorrhagic events. Its genotyped patients were also the Utrecht Immunochip case sample of genetic association studies of ischaemic stroke.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18264013</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25031287</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25906364</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26708676</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002524"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1125</owl:annotatedTarget>
        <obo:IAO_0000116>PROMISe patients available in the 1994-2009 cohort for the 2015 prognostic study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4408031/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For the current study, the data of 1125 patients were available.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002524"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PROMISe</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002524"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>UNISS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002525 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002525">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. UOF is the PGS Catalog&apos;s id for 145 African-ancestry DNA samples (61 with type 1 diabetes, 54 controls, 30 with type 2 diabetes) from the University of Florida Diabetes Institute. PMID:30659077 used them as its independent replication group, and PGS sample set PSS000031 carries only this id. The paper names the source only as the University of Florida (E1179.7, E1179.13) and gives no study name, design or recruitment period. The paper&apos;s named collections (T1DGC, SEARCH, GoKinD, Barbara Davis Center) are separate sources. Not a cohort. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete University of Florida</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002526 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002526">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21326"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>PGS003972</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:37845353</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based case-control study of abdominal aortic aneurysm in Uppsala, Sweden, in which all 65-year-old men identified through the National Population Registry were invited to an ultrasound examination; it aims to find biomarkers for the cause and progression of abdominal aortic aneurysm and to investigate how people with and without an aneurysm experience their health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>UppsalaAAA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Uppsala Abdominal Aortic Aneurysm Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21326">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005350"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002526"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21326"/>
        <obo:IAO_0000116>abdominal aortic aneurysm</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>A prospective population-based case-control study which aims to find biomarkers for the cause and progression of AAA and investigate how persons with or without an AAA experience their health.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002526"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Additional validation cohorts for PRS: Additional AAA case cohorts from Oxford (UK), Uppsala (Sweden) and Utrecht (Netherlands) became available during the conduct of the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002526"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS003972</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis identifies risk loci for abdominal aortic aneurysm and highlights PCSK9 as a therapeutic target.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37845353</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002526"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:37845353</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis identifies risk loci for abdominal aortic aneurysm and highlights PCSK9 as a therapeutic target.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37845353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>UppsalaAAA: Uppsala Abdominal Aortic Aneurysm Cohort Study, part of the collection Swedish Cohort Consortium (Cohorts.se).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002526"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based case-control study of abdominal aortic aneurysm in Uppsala, Sweden, in which all 65-year-old men identified through the National Population Registry were invited to an ultrasound examination; it aims to find biomarkers for the cause and progression of abdominal aortic aneurysm and to investigate how people with and without an aneurysm experience their health.</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002526"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">247</owl:annotatedTarget>
        <obo:IAO_0000116>AAA cases from UppsalaAAA genotyped for PRS validation set 1 of one GWAS (analysed subset, cases only)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>This set includes 808 cases from UKAGS and 4 cases from VIVA that were not used in the meta-analysis, 247 cases from UppsalaAAA, 71 cases from OxAAA, and 31 5810 controls from UKBB.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002526"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>UppsalaAAA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002527 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002527">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21334"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:40029246</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, multicentre observational study of late radiotherapy toxicity that recruited men with prostate cancer without distant metastases who were scheduled for curative-intent radiotherapy (external beam radiotherapy with or without a brachytherapy boost, or brachytherapy alone) between April 2016 and March 2019 at two hospitals in the United States, the University of Rochester Wilmot Cancer Institute and the Medical College of Wisconsin; participants were enrolled before or in the first week of radiotherapy, followed with patient-reported outcomes (the Expanded Prostate Index Composite with added radiation-related questions) at the end of radiotherapy, at 6 months and yearly for up to four years, and genotyped genome-wide, to validate predictive models and biomarkers of toxicity such as hematuria.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">256</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>RGC-URWCI cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>URWCI</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">URWCI study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21334">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002527"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21334"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8986577/</oboInOwl:hasDbXref>
        <rdfs:comment>The URWCI study recruited patients with prostate cancer between April 2016 and March 2019 from two hospitals in the United States (University of Rochester Wilmot Cancer Institute and the Medical College of Wisconsin).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002527"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8986577/</oboInOwl:hasDbXref>
        <rdfs:comment>The URWCI study recruited patients with prostate cancer between April 2016 and March 2019 from two hospitals in the United States (University of Rochester Wilmot Cancer Institute and the Medical College of Wisconsin).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002527"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40029246</owl:annotatedTarget>
        <dcterms:title>A Polygenic Risk Score for Late Bladder Toxicity Following Radiotherapy for Non-Metastatic Prostate Cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40029246</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC12048210/</oboInOwl:hasDbXref>
        <rdfs:comment>We show that it is associated with susceptibility to development of hematuria and other cystitis symptoms in the prospective, multicenter REQUITE and URWCI studies whose primary aim was to validate predictive models and biomarkers of late toxicity in patients treated with curative radiotherapy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002527"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, multicentre observational study of late radiotherapy toxicity that recruited men with prostate cancer without distant metastases who were scheduled for curative-intent radiotherapy (external beam radiotherapy with or without a brachytherapy boost, or brachytherapy alone) between April 2016 and March 2019 at two hospitals in the United States, the University of Rochester Wilmot Cancer Institute and the Medical College of Wisconsin; participants were enrolled before or in the first week of radiotherapy, followed with patient-reported outcomes (the Expanded Prostate Index Composite with added radiation-related questions) at the end of radiotherapy, at 6 months and yearly for up to four years, and genotyped genome-wide, to validate predictive models and biomarkers of toxicity such as hematuria.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35077710</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40029246</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002527"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">256</owl:annotatedTarget>
        <obo:IAO_0000116>men with prostate cancer enrolled in the URWCI study as counted in the 2022 ACE-inhibitor analysis (the only count stated; possibly the analysed subset)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8986577/</oboInOwl:hasDbXref>
        <rdfs:comment>Prostate cancer patients undergoing potentially-curative radiotherapy were enrolled onto two multi-center observational studies, URWCI (N=256) and REQUITE (N=1,437).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002527"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>URWCI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002528 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002528">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21341"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001089"/>
        <obo:IAO_0000112>PMID:40059621</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective observational cohort, enrolling since 1986, of consenting United States military members, retirees and beneficiaries aged 18 years or older with HIV, who are seen about every six months at participating US military treatment facilities, with systematic collection of demographic characteristics, medication use, laboratory data and medically confirmed clinical events.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym NHS also denotes Nurses&apos; Health Study (COHO:0000456); this term is US Military HIV Natural History Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5758</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Department of Defense Human Immunodeficiency Virus Natural History Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>U.S. Military HIV Natural History Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>US military HIV Natural History Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>US-HIV-NHS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">US Military HIV Natural History Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21341">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005109"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002528"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21341"/>
        <obo:IAO_0000116>HIV infection</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6886375/</oboInOwl:hasDbXref>
        <rdfs:comment>Since that time, active-duty members diagnosed with HIV infection and evaluated at participating military treatment facilities (MTFs) are offered enrollment in the NHS, an Institutional Review Board-approved protocol with written informed consent.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002528"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3119192/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Individuals are seen approximately every 6 months at participating United States military treatment facilities.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002528"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40059621</owl:annotatedTarget>
        <dcterms:title>Antiretroviral Therapy Within 2 Years of HIV Acquisition Is Associated With Fewer Viral Blips: A Retrospective Analysis of More Than 20 Years of Data From the US Military HIV Natural History Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40059621</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40059621+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We analyzed participants from the US Military HIV Natural History Study with an estimated human immunodeficiency virus (HIV) seroconversion date, viral suppression ≤400 copies/mL within 1 year after starting ART, and at least 3 HIV RNA measurements after suppression.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002528"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective observational cohort, enrolling since 1986, of consenting United States military members, retirees and beneficiaries aged 18 years or older with HIV, who are seen about every six months at participating US military treatment facilities, with systematic collection of demographic characteristics, medication use, laboratory data and medically confirmed clinical events.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21575228</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002528"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5758</owl:annotatedTarget>
        <obo:IAO_0000116>subjects enrolled in the NHS from 1986 through 2015 (1986-2015)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31778201+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 5,758 subjects were enrolled between 1986 and 2015, of whom 92% were male with a median age of 28 years, and 45% were African-American, 42% Caucasian, and 13% Hispanic/other.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002528"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NHS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002528"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
