        <obo:IAO_0000112>PGS005388</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:42081549</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre case-control study of paroxysmal atrial fibrillation in Japan, whose cases with paroxysmal atrial fibrillation and unrelated controls with no history of atrial fibrillation, all Japanese inpatients and outpatients of the cardiology departments of seven hospitals (among them Tokyo Medical and Dental University Hospital and Jichi Medical University Hospital), were enrolled from March 2020 to December 2021 and genotyped for a genome-wide association study and polygenic risk scores of paroxysmal atrial fibrillation.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1038</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">744</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2604</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PAF_JPN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Multicenter Japanese paroxysmal atrial fibrillation case-control cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19083">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_1030011"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002227"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19083"/>
        <obo:IAO_0000116>paroxysmal atrial fibrillation</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13138623/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Finally, 1,782 participants (1,038 PAF cases and 744 controls) were included in the GWAS and PRS analyses.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002227"/>
