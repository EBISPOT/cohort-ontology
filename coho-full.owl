    <!-- http://www.ebi.ac.uk/coho/COHO_0001589 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001589">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14340"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:32005116</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based cohort of women aged 45–64 registered with a large general practice in Chingford, North-East London, United Kingdom, recruited in 1988–1989 to study osteoarthritis, osteoporosis and other musculoskeletal disease and assessed annually for over 20 years (to 2010) with clinical examinations, nurse-administered questionnaires, hand and knee radiographs and bone density measurements; deaths are traced through the Office for National Statistics.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1003</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Chingford</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford 1,000 Women Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford general population cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford general population survey</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Chingford 1000 Women Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14340">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002081"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001589"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14340"/>
        <obo:IAO_0000116>musculoskeletal disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11029301/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Chingford study was a population-based prospective cohort study that aimed to assess musculoskeletal disease in the female population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001589"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8982643/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Chingford 1,000 women study is a prospective population-based cohort of women 45-64 years old at the study set up (1989), registered in the large general practice in Chingford (North East London, United Kingdom) [12].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001589"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32005116</owl:annotatedTarget>
        <dcterms:title>The incidence and characteristics of accelerated knee osteoarthritis among women: the Chingford cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32005116</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32005116+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Hence, we determined the incidence and characteristics of AKOA among women in the Chingford Study, which is a prospective community-based cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001589"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of women aged 45–64 registered with a large general practice in Chingford, North-East London, United Kingdom, recruited in 1988–1989 to study osteoarthritis, osteoporosis and other musculoskeletal disease and assessed annually for over 20 years (to 2010) with clinical examinations, nurse-administered questionnaires, hand and knee radiographs and bone density measurements; deaths are traced through the Office for National Statistics.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32005116</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34288584</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34537387</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38637130</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001589"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1003</owl:annotatedTarget>
        <obo:IAO_0000116>women included at baseline (1989)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:38637130</oboInOwl:hasDbXref>
        <rdfs:comment>All 1353 women in that age range were invited to participate, of which 1003 were included.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001589"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Chingford</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001590 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001590">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14347"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <obo:IAO_0000112>PMID:26881390</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control study of prostate cancer in Han Chinese men run by the CHIPGECS collaborative group of Chinese hospitals and universities with Barts Cancer Institute, Queen Mary University of London, which recruited hospital patients with a pathological diagnosis of primary prostate cancer and cancer-free men of comparable age from the community or from hospital attendees having routine physical examinations, in several regions of China (south, southeast, southwest, central and northeast), and whose samples were genotyped with the PRACTICAL consortium on the iCOGS and OncoArray arrays.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">495</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">640</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>CHIPGECS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Chinese Prostate Cancer Genetic and Environmental Correlation Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14347">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001590"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14347"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26881390+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Genotyping 211,155 SNPs in 495 cases and 640 controls of Chinese ancestry identified several new suggestive Chinese prostate cancer predisposition loci.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001590"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5008293/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>These male Han Chinese subjects were recruited from several regions of China (south, southeast, southwest, middle and northeast) by members of the Chinese Prostate Cancer Genetic and Environmental Correlation Study (CHIPGECS) collaborative group.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001590"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:26881390</owl:annotatedTarget>
        <dcterms:title>A genetic study and meta-analysis of the genetic predisposition of prostate cancer in a Chinese population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:26881390</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5008293/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>These male Han Chinese subjects were recruited from several regions of China (south, southeast, southwest, middle and northeast) by members of the Chinese Prostate Cancer Genetic and Environmental Correlation Study (CHIPGECS) collaborative group.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001590"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case–control study of prostate cancer in Han Chinese men run by the CHIPGECS collaborative group of Chinese hospitals and universities with Barts Cancer Institute, Queen Mary University of London, which recruited hospital patients with a pathological diagnosis of primary prostate cancer and cancer-free men of comparable age from the community or from hospital attendees having routine physical examinations, in several regions of China (south, southeast, southwest, central and northeast), and whose samples were genotyped with the PRACTICAL consortium on the iCOGS and OncoArray arrays.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26881390</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33623038</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001590"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">495</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls genotyped on the iCOGS array (analysed subset)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:26881390</oboInOwl:hasDbXref>
        <rdfs:comment>We genotyped 495 prostate cancer cases and 640 age matched non-cancer male controls (Supplementary Table S1) using the iCOGS SNP array [8].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001590"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">640</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls genotyped on the iCOGS array (analysed subset)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:26881390</oboInOwl:hasDbXref>
        <rdfs:comment>We genotyped 495 prostate cancer cases and 640 age matched non-cancer male controls (Supplementary Table S1) using the iCOGS SNP array [8].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001590"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CHIPGECS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001591 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001591">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14355"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:37217678</obo:IAO_0000112>
        <obo:IAO_0000115>A randomized clinical trial among employees of Massachusetts General Hospital in Boston, Massachusetts, aged 20 to 75, who regularly paid for food at the hospital&apos;s traffic-light-labelled cafeterias with their employee ID, enrolled between September 2016 and February 2018 and followed for 24 months to test whether a 12-month automated, personalized intervention (feedback on their cafeteria purchases, health and lifestyle tips, social norm comparisons and financial incentives) prevented weight gain and improved diet.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">602</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ChooseWell 365 Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">ChooseWell 365</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14355">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000021"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001591"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14355"/>
        <obo:IAO_0000116>diet</obo:IAO_0000116>
        <obo:IAO_0000116>workplace cafeteria food choices</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30414448+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The ChooseWell 365 study will determine if an automated, personalized worksite intervention to nudge healthier choices improves overall diet and cardiometabolic health.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001591"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8185595/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This randomized clinical trial was conducted on the main campus of Massachusetts General Hospital (MGH), a large academic teaching hospital in Boston, Massachusetts.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001591"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:37217678</owl:annotatedTarget>
        <dcterms:title>Genetic predisposition to macronutrient preference and workplace food choices.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37217678</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37217678+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Here we examined the associations of polygenic scores for carbohydrate, fat, and protein preference with 12 months&apos; workplace food purchases among 397 hospital employees from the ChooseWell 365 study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001591"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomized clinical trial among employees of Massachusetts General Hospital in Boston, Massachusetts, aged 20 to 75, who regularly paid for food at the hospital&apos;s traffic-light-labelled cafeterias with their employee ID, enrolled between September 2016 and February 2018 and followed for 24 months to test whether a 12-month automated, personalized intervention (feedback on their cafeteria purchases, health and lifestyle tips, social norm comparisons and financial incentives) prevented weight gain and improved diet.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30414448</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34097048</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001591"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">602</owl:annotatedTarget>
        <obo:IAO_0000116>employees enrolled and randomised (2016-2018)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:34097048</oboInOwl:hasDbXref>
        <rdfs:comment>Among 602 employees enrolled (mean [SD] age, 43.6 [12.2] years; 478 [79.4%] women), 299 were randomized to the intervention group and 303 were randomized to the control group.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001592 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001592">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14361"/>
        <rdf:type rdf:nodeID="genid14363"/>
        <rdf:type rdf:nodeID="genid14365"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001419"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002691"/>
        <obo:IAO_0000112>PMID:29273806</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective study of schoolchildren in southern California, run by the University of Southern California, that from 1993 recruited successive cohorts from school classrooms in 16 communities chosen to differ in regional air pollution (fourth, seventh and tenth graders in 1993, fourth graders in 1996, and kindergarten and first-grade children in 2002–2003) and followed them through school with yearly questionnaires and lung function tests, to study the chronic effects of air pollution and other environmental and genetic factors on children&apos;s respiratory health, asthma and lung function growth.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CHS also denotes Cardiovascular Health Study (COHO:0000384); this term is Children&apos;s Health Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CHS_b</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Childrens Health Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Southern California Children&apos;s Health Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>USC Children&apos;s Health Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Children&apos;s Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14361">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_8000036"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid14363">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid14365">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005087"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001592"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14361"/>
        <obo:IAO_0000116>regional ambient air pollution</obo:IAO_0000116>
        <obo:IAO_0000116>traffic-related air pollution</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2920902/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Southern California Children’s Health Study (CHS) was designed to investigate the chronic effects of air pollution on respiratory health.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001592"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14363"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25694817+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Children&apos;s Health Study (CHS) is a continuing series of longitudinal studies that first began in 1993 and has focused on demonstrating the chronic impacts of air pollution on respiratory illnesses from early childhood through adolescence.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001592"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14365"/>
        <obo:IAO_0000116>respiratory illness</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25694817+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Children&apos;s Health Study (CHS) is a continuing series of longitudinal studies that first began in 1993 and has focused on demonstrating the chronic impacts of air pollution on respiratory illnesses from early childhood through adolescence.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001592"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1241973/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To assess these hypotheses, we conducted a case-control study of risk factors for early-life asthma that was nested in the Children&apos;s Health Study (CHS), a population-based study of children&apos;s respiratory health in 12 southern California communities.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001592"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29273806</owl:annotatedTarget>
        <dcterms:title>Multiancestry association study identifies new asthma risk loci that colocalize with immune-cell enhancer marks.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29273806</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Children&apos;s Health Study (CHS) is an ongoing cohort study in southern California investigating both genetic and environmental factors related to childhood asthma and lung function growth.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001592"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective study of schoolchildren in southern California, run by the University of Southern California, that from 1993 recruited successive cohorts from school classrooms in 16 communities chosen to differ in regional air pollution (fourth, seventh and tenth graders in 1993, fourth graders in 1996, and kindergarten and first-grade children in 2002–2003) and followed them through school with yearly questionnaires and lung function tests, to study the chronic effects of air pollution and other environmental and genetic factors on children&apos;s respiratory health, asthma and lung function growth.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20371422</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25694817</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29273806</obo:IAO_0000119>
        <obo:IAO_0000119>https://healthstudy.usc.edu/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001592"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12000</owl:annotatedTarget>
        <obo:IAO_0000116>school children enrolled across all recruitment waves since 1993 (lower bound)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://healthstudy.usc.edu/</oboInOwl:hasDbXref>
        <rdfs:comment>More than 12,000 school children living in southern California are involved in this ongoing study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001592"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CHS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001592"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CHS_b</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001593 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001593">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14373"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:28530674</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of ischaemic heart disease in Denmark whose cases are patients from the greater Copenhagen area referred for coronary angiography to Copenhagen University Hospital from 1991 onwards, with ischaemic heart disease documented by coronary stenosis or atherosclerosis on angiography, a positive exercise electrocardiogram or myocardial infarction, and whose controls without ischaemic heart disease are sampled from the Copenhagen General Population Study; with the Copenhagen City Heart Study and the Copenhagen General Population Study it is used in genetic and Mendelian randomization studies of cardiovascular disease.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5270</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5270</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10540</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CIHDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Copenhagen Ischaemic Heart Disease Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Copenhagen ischaemic Heart Disease Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Copenhagen Ischemic Heart Disease Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14373">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0024644"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001593"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14373"/>
        <obo:IAO_0000116>ischemic heart disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4606982/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The CIHDS (Copenhagen Ischemic Heart Disease Study) comprises 5,109 patients from the greater Copenhagen area referred for coronary angiography in 1991 to 2010 and 10,231 controls without IHD ascertained as for the CGPS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001593"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC5555387</oboInOwl:hasDbXref>
        <rdfs:comment>In brief, the European (EUR) studies comprised 16,093 CAD cases and 16,616 controls from EPIC-CVD (a case-cohort study embedded in the pan-European EPIC prospective study), the Copenhagen City Heart Study (CCHS), the Copenhagen Ischemic Heart Disease Study (CIHDS) and the Copenhagen General Population Study (CGPS) all recruited within Copenhagen, Denmark.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001593"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28530674</owl:annotatedTarget>
        <dcterms:title>Fifteen new risk loci for coronary artery disease highlight arterial-wall-specific mechanisms.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28530674</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC5555387</oboInOwl:hasDbXref>
        <rdfs:comment>In brief, the European (EUR) studies comprised 16,093 CAD cases and 16,616 controls from EPIC-CVD (a case-cohort study embedded in the pan-European EPIC prospective study), the Copenhagen City Heart Study (CCHS), the Copenhagen Ischemic Heart Disease Study (CIHDS) and the Copenhagen General Population Study (CGPS) all recruited within Copenhagen, Denmark.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001593"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of ischaemic heart disease in Denmark whose cases are patients from the greater Copenhagen area referred for coronary angiography to Copenhagen University Hospital from 1991 onwards, with ischaemic heart disease documented by coronary stenosis or atherosclerosis on angiography, a positive exercise electrocardiogram or myocardial infarction, and whose controls without ischaemic heart disease are sampled from the Copenhagen General Population Study; with the Copenhagen City Heart Study and the Copenhagen General Population Study it is used in genetic and Mendelian randomization studies of cardiovascular disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22563304</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22698489</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25406188</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001593"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5270</owl:annotatedTarget>
        <obo:IAO_0000116>IHD patients referred 1991-2009 plus controls from the CGPS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:22563304</oboInOwl:hasDbXref>
        <rdfs:comment>The numbers of IHD patients were 3,780 of 54,613 participants in the CGPS (79% prevalent and 21% incident), 2,006 of 10,474 participants in the CCHS (22% prevalent and 78% incident), and 5,270 of 10,540 participants in the CIHDS (100% prevalent).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001593"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5270</owl:annotatedTarget>
        <obo:IAO_0000116>IHD patients referred 1991-2009 plus controls from the CGPS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:22563304</oboInOwl:hasDbXref>
        <rdfs:comment>The numbers of IHD patients were 3,780 of 54,613 participants in the CGPS (79% prevalent and 21% incident), 2,006 of 10,474 participants in the CCHS (22% prevalent and 78% incident), and 5,270 of 10,540 participants in the CIHDS (100% prevalent).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001593"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10540</owl:annotatedTarget>
        <obo:IAO_0000116>IHD patients referred 1991-2009 plus controls from the CGPS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:22563304</oboInOwl:hasDbXref>
        <rdfs:comment>The numbers of IHD patients were 3,780 of 54,613 participants in the CGPS (79% prevalent and 21% incident), 2,006 of 10,474 participants in the CCHS (22% prevalent and 78% incident), and 5,270 of 10,540 participants in the CIHDS (100% prevalent).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001593"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CIHDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001594 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001594">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14382"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>PMID:35195259</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based cohort of Chinese adults aged 18 or over recruited in 2007–2008 by three-stage cluster random sampling at four survey sites, in Shandong, Henan and Jiangsu provinces, chosen for their different levels of economic development; it is one of the sub-cohorts of the Prediction for Atherosclerotic Cardiovascular Disease Risk in China (China-PAR) project, followed up with the other sub-cohorts under a uniform protocol in 2012–2015 and 2018–2020 to study cardiovascular risk factors and incident cardiovascular disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">86428</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CIMIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Community Intervention of Metabolic Syndrome in China &amp; Chinese Family Health Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Community Intervention of Metabolic Syndrome in China and Chinese Family Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14382">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001594"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14382"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7249710/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study was based on the project of Prediction for Atherosclerotic Cardiovascular Disease Risk in China (China-PAR), which was a large collaborative study to investigate the epidemic of CVDs and identify the risk factors in the general Chinese population including the China Multi-Center Collaborative Study of Cardiovascular Epidemiology (China MUCA 1992–1994, and China MUCA 1998), the International Collaborative Study of CVD in Asia (InterASIA), and the Community Intervention of Metabolic Syndrome in China &amp; Chinese Family Health Study (CIMIC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001594"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7249710/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The CIMIC was a large, community-based cohort that was established from 2007 to 2008 and selected four survey sites from three provinces (Shandong, Henan, and Jiangsu) with different economic development levels in China.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001594"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:35195259</owl:annotatedTarget>
        <dcterms:title>A polygenic risk score improves risk stratification of coronary artery disease: a large-scale prospective Chinese cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35195259</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9076396/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The validation cohorts were derived from three cohorts in the China-PAR project, including the International Collaborative Study of Cardiovascular Disease in Asia (InterASIA), the China Multi-Center Collaborative Study of Cardiovascular Epidemiology (ChinaMUCA-1998), and Community Intervention of Metabolic Syndrome in China and Chinese Family Health Study (CIMIC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001594"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based cohort of Chinese adults aged 18 or over recruited in 2007–2008 by three-stage cluster random sampling at four survey sites, in Shandong, Henan and Jiangsu provinces, chosen for their different levels of economic development; it is one of the sub-cohorts of the Prediction for Atherosclerotic Cardiovascular Disease Risk in China (China-PAR) project, followed up with the other sub-cohorts under a uniform protocol in 2012–2015 and 2018–2020 to study cardiovascular risk factors and incident cardiovascular disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31888885</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32433046</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34327424</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35195259</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001594"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">86428</owl:annotatedTarget>
        <obo:IAO_0000116>adults aged 18 or over recruited at baseline (2007-2008)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:34327424</oboInOwl:hasDbXref>
        <rdfs:comment>The CIMIC is a large community-based study, which recruited 86,428 participants aged ≥18 years by a 3-stage cluster random sampling method in 2007–2008.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001594"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CIMIC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001595 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001595">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14389"/>
        <rdf:type rdf:nodeID="genid14391"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:30482948</obo:IAO_0000112>
        <obo:IAO_0000115>A pharmacogenomic study of acamprosate response in alcohol dependence, conducted from 2008 to 2013 by the Mayo Clinic Center for the Individualized Treatment of Alcoholism, which enrolled men and women aged 18–80 with a primary diagnosis of current alcohol dependence (DSM-IV-TR) whose last drink was at least 5 days before enrolment, from community-based residential and outpatient treatment programmes affiliated with Mayo Clinic in Rochester, Minnesota, and Mayo Clinic Health System sites in Austin and Albert Lea, Minnesota, and La Crosse, Wisconsin, treated them with acamprosate for 3 months in an open-label, naturalistic prospective design and collected DNA and plasma to identify biomarkers of treatment response.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">442</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>A Probe Study of Acamprosate: Genes Associated With Response</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ACAM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CITA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo Clinic Center for Individualized Treatment of Addiction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo Clinic Center for Individualized Treatment of Alcohol Dependence</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo Clinic Center for Individualized Treatment of Alcoholism study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo Clinic Center for the Individual Treatment of Alcohol Dependence</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo Clinic Center for the Individualized Treatment of Alcoholism study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Mayo Clinic Center for the Individualized Treatment of Alcoholism Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14389">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_with_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000009"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid14391">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007079"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001595"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14389"/>
        <obo:IAO_0000116>alcohol dependence (heavy alcohol use)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4350512/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Both men and women between the ages of 18 and 80 with a primary diagnosis of current alcohol dependence based on DSM-IV-TR criteria with the last drink 5 or more days before enrollment were included in the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001595"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14391"/>
        <obo:IAO_0000116>alcohol dependence</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4350512/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Both men and women between the ages of 18 and 80 with a primary diagnosis of current alcohol dependence based on DSM-IV-TR criteria with the last drink 5 or more days before enrollment were included in the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001595"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41593-018-0275-1/MediaObjects/41593_2018_275_MOESM4_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were recruited from community-based residential and outpatient treatment programs affiliated with Mayo Clinic in Rochester, Minnesota, and the Mayo Clinic Health System sites in Austin, Minnesota, Albert Lea, Minnesota, and La Crosse, Wisconsin.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001595"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:30482948</owl:annotatedTarget>
        <dcterms:title>Transancestral GWAS of alcohol dependence reveals common genetic underpinnings with psychiatric disorders.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30482948</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41593-018-0275-1/MediaObjects/41593_2018_275_MOESM4_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The alcohol dependent patients in this sample were recruited as part of the Mayo Clinic Center for Individualized Treatment of Addiction (CITA) pharmacogenomics study of acamprosate response.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001595"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pharmacogenomic study of acamprosate response in alcohol dependence, conducted from 2008 to 2013 by the Mayo Clinic Center for the Individualized Treatment of Alcoholism, which enrolled men and women aged 18–80 with a primary diagnosis of current alcohol dependence (DSM-IV-TR) whose last drink was at least 5 days before enrolment, from community-based residential and outpatient treatment programmes affiliated with Mayo Clinic in Rochester, Minnesota, and Mayo Clinic Health System sites in Austin and Albert Lea, Minnesota, and La Crosse, Wisconsin, treated them with acamprosate for 3 months in an open-label, naturalistic prospective design and collected DNA and plasma to identify biomarkers of treatment response.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25290263</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35752286</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT00662571</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001595"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">442</owl:annotatedTarget>
        <obo:IAO_0000116>participants with alcohol use disorder recruited (2008-2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:35752286</oboInOwl:hasDbXref>
        <rdfs:comment>Previously, the Mayo Clinic Center for the Individualized Treatment of Alcoholism Study (ClinicalTrials.gov Identifier: NCT00662571) recruited 442 participants with AUD [11,12].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001595"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ACAM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001595"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CITA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001596 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001596">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14399"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:32887683</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study and biobank of juvenile idiopathic arthritis at the Royal Children&apos;s Hospital in Melbourne, Victoria, Australia, begun in February 2008, whose cases are children aged 18 or under with juvenile idiopathic arthritis diagnosed by age 16, recruited at hospital clinic visits within six months of diagnosis (incident) or later (prevalent, diagnosed since 1997), and whose controls are healthy Victorian-born children undergoing minor elective surgery at the hospital&apos;s Day Surgery Unit; families complete questionnaires on clinical, epidemiological and environmental factors and the children give a blood sample, to identify genomic and environmental risk factors for the disease.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">558</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">704</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>CLARITY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CLARITY JIA Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Childhood Arthritis Risk Factor Identification Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">ChiLdhood Arthritis Risk factor Identification sTudY</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14399">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011429"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001596"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14399"/>
        <obo:IAO_0000116>juvenile idiopathic arthritis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3551677/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We have established a JIA biobank in Melbourne, Australia called CLARITY – ChiLdhood Arthritis Risk factor Identification sTudY, with the broad aim of identifying genomic and environmental disease risk factors.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001596"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23153063+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We have established a JIA biobank in Melbourne, Australia called CLARITY - ChiLdhood Arthritis Risk factor Identification sTudY, with the broad aim of identifying genomic and environmental disease risk factors.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001596"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32887683</owl:annotatedTarget>
        <dcterms:title>Genomic risk scores for juvenile idiopathic arthritis and its subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32887683</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7677485/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Finally, in the Australian cohort, from the ChiLdhood Arthritis Risk factor Identification sTudY (CLARITY),28 29 all the cases were JIA diagnosed by a paediatric rheumatologist.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001596"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study and biobank of juvenile idiopathic arthritis at the Royal Children&apos;s Hospital in Melbourne, Victoria, Australia, begun in February 2008, whose cases are children aged 18 or under with juvenile idiopathic arthritis diagnosed by age 16, recruited at hospital clinic visits within six months of diagnosis (incident) or later (prevalent, diagnosed since 1997), and whose controls are healthy Victorian-born children undergoing minor elective surgery at the hospital&apos;s Day Surgery Unit; families complete questionnaires on clinical, epidemiological and environmental factors and the children give a blood sample, to identify genomic and environmental risk factors for the disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23153063</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001596"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">558</owl:annotatedTarget>
        <obo:IAO_0000116>JIA cases and controls collected (genotyping set of the 2020 GRS study)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:32887683</oboInOwl:hasDbXref>
        <rdfs:comment>Lastly, CLARITY29 consisted of 558 cases and 704 controls collected from the Royal Children’s Hospital and Monash Medical Centre in Melbourne.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001596"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">704</owl:annotatedTarget>
        <obo:IAO_0000116>JIA cases and controls collected (genotyping set of the 2020 GRS study)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:32887683</oboInOwl:hasDbXref>
        <rdfs:comment>Lastly, CLARITY29 consisted of 558 cases and 704 controls collected from the Royal Children’s Hospital and Monash Medical Centre in Melbourne.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001596"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CLARITY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001597 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001597">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14407"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000945"/>
        <obo:IAO_0000112>PMID:26034056</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective multiethnic cohort of men aged 45 to 69 who were members of the northern and southern California regions of the Kaiser Permanente health plan, recruited in 2002–2003 through a two-stage mailed or online questionnaire with mailing strategies to enrich the cohort with non-white men, and followed through linkage with the health plan&apos;s electronic clinical, laboratory, hospitalisation, cancer registry and mortality data, mainly to study the causes of prostate cancer and also of other cancers and non-cancerous conditions in men.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">84170</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CMHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>California Mens Health Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">California Men&apos;s Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14407">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001597"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14407"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16813653+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We established a male, multiethnic cohort primarily to study prostate cancer etiology and secondarily to study the etiologies of other cancer and non-cancer conditions.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001597"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1569841/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In 2002 – 2003, we established the California Men&apos;s Health Study (CMHS), a multiethnic cohort of 84 170 men ages 45 to 69 years who are members of the northern and southern California regions of Kaiser Permanente, the largest managed care organization in California.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001597"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:26034056</owl:annotatedTarget>
        <dcterms:title>A large multiethnic genome-wide association study of prostate cancer identifies novel risk variants and substantial ethnic differences.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:26034056</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4527942/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The CMHS is a prospective cohort study of KP California men.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001597"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective multiethnic cohort of men aged 45 to 69 who were members of the northern and southern California regions of the Kaiser Permanente health plan, recruited in 2002–2003 through a two-stage mailed or online questionnaire with mailing strategies to enrich the cohort with non-white men, and followed through linkage with the health plan&apos;s electronic clinical, laboratory, hospitalisation, cancer registry and mortality data, mainly to study the causes of prostate cancer and also of other cancers and non-cancerous conditions in men.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16813653</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001597"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">84170</owl:annotatedTarget>
        <obo:IAO_0000116>men recruited 2002-2003</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:16813653</oboInOwl:hasDbXref>
        <rdfs:comment>We recruited 84,170 participants, approximately 40% from minority populations and over 5,000 who identified themselves as other than heterosexual.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001597"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CMHS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001598 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001598">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14414"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
        <obo:IAO_0000112>PMID:32424353</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of breast cancer of the Spanish National Cancer Research Centre (CNIO) in Madrid, Spain, whose cases, recruited in 2000–2005, are consecutive breast cancer patients from three public hospitals, two in Madrid and one in Oviedo, and women with at least one affected first-degree relative recruited through the CNIO family cancer clinic in Madrid, and whose controls are women free of breast cancer attending the Menopause Research Centre in Madrid or a free medical check-up for female members of the College of Lawyers in Madrid; it is one of the studies of the Breast Cancer Association Consortium.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">902</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">876</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>CNIO-BCS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Spanish National Cancer Centre Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14414">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001598"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14414"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001598"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32424353</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies 32 novel breast cancer susceptibility loci from overall and subtype-specific analyses.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32424353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0609-2/MediaObjects/41588_2020_609_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The CNIO- BCS was supported by the Instituto de Salud Carlos III, the Red Temática de Investigación Cooperativa en Cáncer and grants from the Asociación Española Contra el Cáncer and the Fondo de Investigación Sanitario (PI11/00923 and PI12/00070).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001598"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of breast cancer of the Spanish National Cancer Research Centre (CNIO) in Madrid, Spain, whose cases, recruited in 2000–2005, are consecutive breast cancer patients from three public hospitals, two in Madrid and one in Oviedo, and women with at least one affected first-degree relative recruited through the CNIO family cancer clinic in Madrid, and whose controls are women free of breast cancer attending the Menopause Research Centre in Madrid or a free medical check-up for female members of the College of Lawyers in Madrid; it is one of the studies of the Breast Cancer Association Consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25390939</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
