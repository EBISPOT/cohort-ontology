    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002611 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002611">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Poland"/>
        <obo:IAO_0000112>PMID:28626626</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective community-based cohort of volunteer men and women aged 45–64 years recruited in 2010–2011 from the city of Kielce and its surrounding rural area in south-eastern Poland, with questionnaires and stored blood and urine samples, set up with support from the Polish-Norwegian Research Fund to study health, health-related behaviours and risk factors for chronic diseases and premature mortality.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13172</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PONS</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>PONS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PONS cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PONS study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Polish Norwegian Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Polish-Norwegian Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002611"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Poland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25948663+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The PONS cohort is a longitudinal observational regional study collecting information on health and health-related behaviours in the south-eastern part of Poland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002611"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28626626</owl:annotatedTarget>
        <dcterms:title>Television viewing time among statin users and non-users. The Polish Norwegian Study (PONS).</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28626626</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5466582/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This analysis is based on the cross-sectional, baseline data of the PONS study, from which we excluded participants with incomplete information on relevant covariates (n = 418, 0.3%).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002611"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective community-based cohort of volunteer men and women aged 45–64 years recruited in 2010–2011 from the city of Kielce and its surrounding rural area in south-eastern Poland, with questionnaires and stored blood and urine samples, set up with support from the Polish-Norwegian Research Fund to study health, health-related behaviours and risk factors for chronic diseases and premature mortality.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25948663</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28626626</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002611"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13172</owl:annotatedTarget>
        <obo:IAO_0000116>individuals aged 45-64 in the 2010-11 baseline (2010-2011)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:25948663</oboInOwl:hasDbXref>
        <rdfs:comment>The baseline data collection contains records for 13 172 individuals (2010-11), between 45 and 64 years of age, from the city of Kielce and surrounding rural area.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002611"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PONS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002612 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002612">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001770"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:22194890</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study of men and women aged 20–65 years drawn as random samples of the populations of Amsterdam, Maastricht and Doetinchem in the Netherlands, whose cardiovascular and other chronic disease risk factors were measured by the Municipal Health Services in 1993–1997 in a project supported by the Dutch Ministry of Health, Welfare and Sport and the National Institute for Public Health and the Environment, and who were followed for disease through linkage with national registers.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22769</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/MORGEN</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>MORGEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MORGEN Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MORGEN-cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MORGEN-project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MORGEN-study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Monitoring Project on Chronic Disease Risk Factors</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Monitoring Project on Risk Factors and Chronic Diseases in the Netherlands</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Monitoring Project on Risk Factors for Chronic Diseases</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002612"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3241680/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The project was carried out in random population samples of Amsterdam (respons rate 33%), Maastricht (43%) and Doetinchem (68%) in the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002612"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22194890</owl:annotatedTarget>
        <dcterms:title>Paternal and maternal history of myocardial infarction and cardiovascular diseases incidence in a Dutch cohort of middle-aged persons.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22194890</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3241680/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the Monitoring Project on Chronic Disease Risk Factors (MORGEN-project), baseline cardiovascular risk factor data were collected in 1993–1997 in 22 769 men and women aged 20–65 years [23], [24].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002612"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study of men and women aged 20–65 years drawn as random samples of the populations of Amsterdam, Maastricht and Doetinchem in the Netherlands, whose cardiovascular and other chronic disease risk factors were measured by the Municipal Health Services in 1993–1997 in a project supported by the Dutch Ministry of Health, Welfare and Sport and the National Institute for Public Health and the Environment, and who were followed for disease through linkage with national registers.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22194890</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002612"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22769</owl:annotatedTarget>
        <obo:IAO_0000116>men and women aged 20-65 examined at baseline 1993-1997</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3241680/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the Monitoring Project on Chronic Disease Risk Factors (MORGEN-project), baseline cardiovascular risk factor data were collected in 1993–1997 in 22 769 men and women aged 20–65 years [23], [24].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002612"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MORGEN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002613 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002613">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:41762673</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort in Rotterdam, the Netherlands, of women enrolled from August 2017 before conception or during pregnancy, with their partners and children, followed from preconception and fetal life onwards by the Generation R group at Erasmus MC to study the growth, development and health of a new generation of children and their parents.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3604</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/GenR%20Next</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>GenR Next</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Generation R Next</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Generation R Next - Optimaal Opgroeien</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Generation R Next Study</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://generationr.nl/next"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002613"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11802838/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were enrolled in a population-based prospective cohort, the Generation R Next Study, from fetal life until adulthood in Rotterdam, the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002613"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:41762673</owl:annotatedTarget>
        <dcterms:title>Pregnancy-specific Reference Intervals for TSH and FT4: Novel Insights From Preconception-gestation Longitudinal Data.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41762673</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13368358/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study was embedded within Generation R Next, a population-based prospective cohort from preconception through postpartum in Rotterdam.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002613"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort in Rotterdam, the Netherlands, of women enrolled from August 2017 before conception or during pregnancy, with their partners and children, followed from preconception and fetal life onwards by the Generation R group at Erasmus MC to study the growth, development and health of a new generation of children and their parents.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:39915565</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41762673</obo:IAO_0000119>
