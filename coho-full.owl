        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC468645/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Four sites enrolled families with multiple or early-onset cases of breast or ovarian cancer identified through community contacts and clinical settings including screening centers, family cancer clinics, surgical and medical oncology offices, and the Australian twin registry.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001516"/>
