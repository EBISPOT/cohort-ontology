    <!-- http://www.ebi.ac.uk/coho/COHO_0001679 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001679">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15051"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:12081984</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre case-control study of myocardial infarction based on the WHO MONICA centres of Belfast (Northern Ireland) and Lille, Strasbourg and Toulouse (France), set up to investigate why coronary heart disease is more than three times as common in middle-aged men in Northern Ireland as in France. Between 1988 and 1991 it recruited men aged 25–64 who had had a myocardial infarction, examined 3 to 9 months after the event, and control men sampled from the general population. Its cases and controls have been used in many candidate-gene studies of myocardial infarction and lipids, and an extension study later recruited men and women in the MONICA areas of Belfast and Glasgow.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">671</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">688</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>ECTIM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ECTIM Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ECTIM study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Enquête Cas-Témoins de l&apos;Infarctus du Myocarde</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Etude Cas-Témoin de l&apos;Infarctus du Myocarde</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Etude Cas-Témoin sur l&apos;Infarctus du Myocarde</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Etude Cas-Témoins sur l&apos;Infarctus du Myocarde</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Etude Cas-Témoins de l&apos;Infarctus du Myocarde</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15051">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005068"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001679"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15051"/>
        <obo:IAO_0000116>myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1534257+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Male patients aged 25-64 years with myocardial infarction (MI) and control subjects sampled from the general population were recruited in the four centers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001679"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1534257+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The ECTIM study, which is based on WHO MONICA centers in Belfast (Northern Ireland), Strasbourg (eastern France), Toulouse (southwestern France), and Lille (northern France), has been established to investigate this striking difference.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001679"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:12081984</owl:annotatedTarget>
        <dcterms:title>Serotonin transporter gene polymorphism and myocardial infarction: Etude Cas-Témoins de l&apos;Infarctus du Myocarde (ECTIM).</dcterms:title>
        <oboInOwl:hasDbXref>PMID:12081984</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12081984+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The SLC6A4 polymorphism has been investigated by polymerase chain reaction in 671 male patients with MI and in 688 controls from the Etude Cas-Témoins de l&apos;Infarctus du Myocarde (ECTIM) multicentric study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001679"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre case-control study of myocardial infarction based on the WHO MONICA centres of Belfast (Northern Ireland) and Lille, Strasbourg and Toulouse (France), set up to investigate why coronary heart disease is more than three times as common in middle-aged men in Northern Ireland as in France. Between 1988 and 1991 it recruited men aged 25–64 who had had a myocardial infarction, examined 3 to 9 months after the event, and control men sampled from the general population. Its cases and controls have been used in many candidate-gene studies of myocardial infarction and lipids, and an extension study later recruited men and women in the MONICA areas of Belfast and Glasgow.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11040019</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:12081984</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:1534257</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:7789377</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:8633596</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001679"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">671</owl:annotatedTarget>
        <obo:IAO_0000116>male MI cases and controls genotyped in the example study (analysed subset)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:12081984</oboInOwl:hasDbXref>
        <rdfs:comment>The SLC6A4 polymorphism has been investigated by polymerase chain reaction in 671 male patients with MI and in 688 controls from the Etude Cas-Témoins de l&apos;Infarctus du Myocarde (ECTIM) multicentric study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001679"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">688</owl:annotatedTarget>
