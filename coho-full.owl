    <!-- http://www.ebi.ac.uk/coho/COHO_0001691 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001691">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15149"/>
        <rdf:type rdf:nodeID="genid15151"/>
        <rdf:type rdf:nodeID="genid15153"/>
        <obo:IAO_0000112>PMID:40602178</obo:IAO_0000112>
        <obo:IAO_0000115>A double-blind, placebo-controlled randomised trial of eplerenone, a selective aldosterone blocker, added to optimal medical therapy in patients enrolled 3 to 14 days after an acute myocardial infarction complicated by left ventricular dysfunction (ejection fraction of 40% or less) and heart failure or diabetes, followed for death and cardiovascular hospitalisation; a biomarker substudy of its patients has serial blood measurements.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6632</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>EPHESUS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPHESUS trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Eplerenone Post-acute myocardial infarction Heart failure Efficacy and SUrvival Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Eplerenone Post-Acute Myocardial Infarction Heart Failure Efficacy and Survival Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Eplerenone Post-Acute Myocardial Infarction Heart Failure Efficacy and Survival Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15149">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004781"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid15151">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005015"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid15153">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005252"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001691"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15149"/>
        <obo:IAO_0000116>acute myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6837025/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>EPHESUS included 6632 patients with an acute MI (3‐14 days after the MI), and a LVEF ≤ 40% plus HF or diabetes to receive either eplerenone (25 mg per day initially, titrated to a maximum of 50 mg per day) or placebo.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001691"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15151"/>
        <obo:IAO_0000116>diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6837025/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>EPHESUS included 6632 patients with an acute MI (3‐14 days after the MI), and a LVEF ≤ 40% plus HF or diabetes to receive either eplerenone (25 mg per day initially, titrated to a maximum of 50 mg per day) or placebo.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001691"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15153"/>
        <obo:IAO_0000116>heart failure</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6837025/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>EPHESUS included 6632 patients with an acute MI (3‐14 days after the MI), and a LVEF ≤ 40% plus HF or diabetes to receive either eplerenone (25 mg per day initially, titrated to a maximum of 50 mg per day) or placebo.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001691"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40602178</owl:annotatedTarget>
        <dcterms:title>Interaction Between Aldosterone and Mineralocorticoid Receptor Antagonist: Findings From the EPHESUS Trial.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40602178</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40602178+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In a subset of the EPHESUS (Eplerenone Post-Acute Myocardial Infarction Heart Failure Efficacy and Survival Study) trial, associations between baseline serum aldosterone concentrations, their changes from baseline to month 1, and outcomes were separately assessed in the eplerenone and placebo groups.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001691"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A double-blind, placebo-controlled randomised trial of eplerenone, a selective aldosterone blocker, added to optimal medical therapy in patients enrolled 3 to 14 days after an acute myocardial infarction complicated by left ventricular dysfunction (ejection fraction of 40% or less) and heart failure or diabetes, followed for death and cardiovascular hospitalisation; a biomarker substudy of its patients has serial blood measurements.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:12668699</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31250134</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31482613</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001691"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6632</owl:annotatedTarget>
        <obo:IAO_0000116>EPHESUS randomized patients with acute MI and left ventricular dysfunction plus heart failure or diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6837025/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>EPHESUS included 6632 patients with an acute MI (3‐14 days after the MI), and a LVEF ≤ 40% plus HF or diabetes to receive either eplerenone (25 mg per day initially, titrated to a maximum of 50 mg per day) or placebo.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001691"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EPHESUS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001692 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001692">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15159"/>
        <rdf:type rdf:nodeID="genid15161"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>PGS000733</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:38174802</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of prostate cancer in the Hérault département in the south of France, whose cases are men under 75 newly diagnosed with prostate cancer in 2012-2013 while living in Hérault, identified in all of its public and private cancer centres, and whose controls are men without prostate cancer randomly selected from Hérault&apos;s general population with quotas on age and socioeconomic status, set up to study environmental and genetic risk factors for prostate cancer.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">819</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">879</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>EPICAP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIdemiology of Prostate CAncer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Epidemiological study of prostate cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Epidemiology of Prostate Cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Epidemiological Study of Prostate Cancer</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15159">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid15161">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0001591"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001692"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15159"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38174802+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 819 incident cases and 879 controls were interviewed face-to-face using a standardized questionnaire gathering information on known or suspected risk factors of prostate cancer and personal history of specific sexually and non-sexually transmitted infections: gonorrhea, syphilis, trichomonas, herpes, mononucleosis, Epstein-Barr virus, varicella-zoster, and dengue.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001692"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15161"/>
        <obo:IAO_0000116>night work</obo:IAO_0000116>
        <obo:IAO_0000116>rotating shift work</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3936778/</oboInOwl:hasDbXref>
        <rdfs:comment>The EPICAP study aims to answer key questions in prostate cancer etiology: (1) role of circadian disruption through the study of working hours, chronotype and duration/quality of sleep, (2) role of chronic inflammation and anti-inflammatory drugs, (3) role of hormonal and metabolic factors through a detailed questionnaire, (4) role of individual genetic susceptibility of genes involved in biological pathways of interest.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001692"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10807638/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>EPICAP (Epidemiological study of prostate cancer) is a population‐based case–control study conducted in the department of Hérault located in the south of France between 2012 and 2014 to investigate the role of environmental and genetic factors in the occurrence of prostate cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001692"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000733</owl:annotatedTarget>
        <dcterms:title>African-specific improvement of a polygenic hazard score for age at diagnosis of prostate cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32930425</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001692"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38174802</owl:annotatedTarget>
        <dcterms:title>Sexually and non-sexually transmitted infections and the risk of prostate cancer: Results from the EPICAP study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38174802</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10807638/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We used data from epidemiological study of prostate cancer (EPICAP), a population‐based case–control study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001692"/>
