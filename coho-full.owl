    <!-- http://www.ebi.ac.uk/coho/COHO_0001250 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001250">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>GCST90841194</obo:IAO_0000112>
        <obo:IAO_0000115>A research cohort of customers of WeGene, a direct-to-consumer genetic testing company based in Shenzhen, China, who were genotyped from saliva on microarrays through the WeGene Personal Genome Services and consented to take part in research online, answering surveys posted on WeGene&apos;s online platform, website and WeChat channels.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5952</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>WeGene</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WeGene Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WeGene Personal Genome Services</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">WeGene cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001250"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11755739/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Our MR design was applied to data on 3,041 individuals (1,826 males and 1,215 females) collected from the customer database of a leading private genetic testing company in China, WeGene.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001250"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90841194</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genome-wide association analyses of refractive error augment genetic discovery and polygenic prediction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42009823</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13175889/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We enrolled 5,952 Han Chinese participants (see Supplementary Note 1 for myopia status distribution), who had given informed consent and undergone genotyping as part of the WeGene Personal Genome Services.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001250"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A research cohort of customers of WeGene, a direct-to-consumer genetic testing company based in Shenzhen, China, who were genotyped from saliva on microarrays through the WeGene Personal Genome Services and consented to take part in research online, answering surveys posted on WeGene&apos;s online platform, website and WeChat channels.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28442769</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34457340</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39359028</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42009823</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001250"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5952</owl:annotatedTarget>
        <obo:IAO_0000116>analysed subset: participants in the myopia GWAS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13175889/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We enrolled 5,952 Han Chinese participants (see Supplementary Note 1 for myopia status distribution), who had given informed consent and undergone genotyping as part of the WeGene Personal Genome Services.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001250"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
