        <oboInOwl:hasRelatedSynonym>National colorectal cancer cohort (China)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
