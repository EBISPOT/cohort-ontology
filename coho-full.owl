        <obo:IAO_0000112>PMID:20159242</obo:IAO_0000112>
        <obo:IAO_0000115>A 3-year multicentre observational cohort study of patients aged 6 years or older with severe or difficult-to-treat asthma, enrolled from January to October 2001 by more than 400 pulmonologists and allergists in the United States and sponsored by Genentech and Novartis, with data on demographics, medical history, comorbidities, asthma control, health care use, medication use, lung function, IgE levels, asthma triggers and quality of life collected semiannually and annually to characterise the natural history of the disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4756</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Epidemiology and Natural History of Asthma: Outcomes and Treatment Regimens</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TENOR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TENOR I</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TENOR I study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TENOR study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Epidemiology and Natural History of Asthma: Outcomes and Treatment Regimens (TENOR) study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">The Epidemiology and Natural History of Asthma: Outcomes and Treatment Regimens</rdfs:label>
    </owl:NamedIndividual>
