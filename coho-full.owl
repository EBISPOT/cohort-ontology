    <!-- http://www.ebi.ac.uk/coho/COHO_0002631 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002631">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <obo:IAO_0000112>PMID:39010980</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of men and women aged 35 years or more living in the Molise region of southern Italy, randomly sampled with their family members from the city registries of Molise towns and recruited between 2005 and 2010, examined at baseline with a biobank of their samples and followed by linkage to regional health and mortality registries and a recall examination, to study genetic and environmental risk factors for cardiovascular, cancer and neurodegenerative diseases.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24325</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/Moli-sani</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>MOLI-SANI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MOLI-SANI Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Moli-sani</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Moli-sani Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Moli-sani cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Progetto Moli-sani</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Moli-sani Study</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.moli-sani.org/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002631"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11247150/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We utilized data from the Moli-sani Study, a population-based cohort established between 2005 and 2010, comprising 24,325 men and women aged ≥35 years residing in the Southern Italian region of Molise.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002631"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39010980</owl:annotatedTarget>
        <dcterms:title>The association between hypoalbuminemia and risk of death due to cancer and vascular disease in individuals aged 65 years and older: findings from the prospective Moli-sani cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39010980</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11247150/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Serum albumin levels were measured in the population-based, prospective cohort of the Moli-sani study, established between 2005 and 2010.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002631"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of men and women aged 35 years or more living in the Molise region of southern Italy, randomly sampled with their family members from the city registries of Molise towns and recruited between 2005 and 2010, examined at baseline with a biobank of their samples and followed by linkage to regional health and mortality registries and a recall examination, to study genetic and environmental risk factors for cardiovascular, cancer and neurodegenerative diseases.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:39010980</obo:IAO_0000119>
