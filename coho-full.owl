        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">LOOP study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17671">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004981"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid17673">
