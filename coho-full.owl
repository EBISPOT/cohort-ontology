        <obo:IAO_0000116>participants of the cross-sectional study, randomly recruited from Berlin, Potsdam and surroundings</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5569105/fullTextXML</oboInOwl:hasDbXref>
