    <!-- http://www.ebi.ac.uk/coho/COHO_0001615 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001615">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14567"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000610"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002200"/>
        <obo:IAO_0000112>PMID:20437058</obo:IAO_0000112>
        <obo:IAO_0000115>A colorectal cancer genomics project in Ontario, Canada (the ARCTIC Genome Project), hosted by Cancer Care Ontario and funded by Genome Canada through the Ontario Genomics Institute and other agencies, whose case-control sample consists of participants of the Ontario Familial Colorectal Cancer Registry: people aged 20–74 with colorectal cancer diagnosed in 1997–2000 and identified through the population-based Ontario Cancer Registry, and population controls randomly selected and frequency-matched to them by sex and five-year age group. They were genotyped genome-wide to find common variants associated with colorectal cancer, and the sample has since been used for risk-prediction and DNA methylation studies.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1257</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1336</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>ARCTIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ARCTIC Genome Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Assessment of Risk in Colorectal Tumors In Canada</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Assessment of Risk in Colorectal Tumors in Canada</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Assessment of Risk of Colorectal Tumors in Canada</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Assessment of Risk of Colorectal Tumours in Canada</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Assessment of Risk for Colorectal Tumors in Canada</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14567">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005575"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001615"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14567"/>
        <obo:IAO_0000116>colorectal cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2885303/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>data from the ARCTIC study in Ontario, which included 1,200 CRC cases and a similar number of cancer-free population-based controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001615"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002200"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2885303/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the ARCTIC study involved 1,257 CRC cases and 1,336 matched community controls from the Ontario Familial Colorectal Cancer Registry.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001615"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20437058</owl:annotatedTarget>
        <dcterms:title>The utility and predictive value of combinations of low penetrance genes for screening and risk prediction of colorectal cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20437058</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2885303/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Multivariate modeling was carried out using available case control data and genotyping from the Assessment of Risk for Colorectal Tumors in Canada (ARCTIC) Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001615"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A colorectal cancer genomics project in Ontario, Canada (the ARCTIC Genome Project), hosted by Cancer Care Ontario and funded by Genome Canada through the Ontario Genomics Institute and other agencies, whose case-control sample consists of participants of the Ontario Familial Colorectal Cancer Registry: people aged 20–74 with colorectal cancer diagnosed in 1997–2000 and identified through the population-based Ontario Cancer Registry, and population controls randomly selected and frequency-matched to them by sex and five-year age group. They were genotyped genome-wide to find common variants associated with colorectal cancer, and the sample has since been used for risk-prediction and DNA methylation studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17618283</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20437058</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27142380</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
