    <!-- http://www.ebi.ac.uk/coho/COHO_0001017 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001017">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid9277"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Poland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000784"/>
        <obo:IAO_0000112>GCST006906</obo:IAO_0000112>
        <obo:IAO_0000115>A group of six genome-wide association case-control studies of spontaneous intracerebral haemorrhage in people of European ancestry, meta-analysed under the auspices of the International Stroke Genetics Consortium to find susceptibility loci for lobar and nonlobar haemorrhage. It comprises the multicentre Genetics of Cerebral Hemorrhage with Anticoagulation study in the United States, the Genetic and Environmental Risk Factors for Hemorrhagic Stroke studies I and II in Cincinnati, and four European studies in Barcelona, Krakow and Lund.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1545</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1481</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>ICH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">International Stroke Genetics Consortium intracerebral hemorrhage GWAS</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9277">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0013792"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9277"/>
        <obo:IAO_0000116>intracerebral hemorrhage</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24656865+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We report a genome-wide association study of this condition that meta-analyzed data from six studies that enrolled individuals of European ancestry. Case subjects were ascertained by neurologists blinded to genotype data and classified as lobar or nonlobar based on brain computed tomography. ICH-free control subjects were sampled from ambulatory clinics or random digit dialing.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Case and control subjects included in the discovery phase were subjects of European ancestry aged &gt;55 years in the Genetics of Cerebral Hemorrhage with Anticoagulation13 (GOCHA) study (multicenter study in the US) and aged &gt;18 years in the Genetic and Environmental Risk Factors for Hemorrhagic Stroke (GERFHS) studies I and II in Cincinnati, OH; Hospital del Mar Intracerebral Hemorrhage study and Vall d’Hebron Hospita lCH study in Barcelona, Spain; Jagiellonian University Hemorrhagic Stroke Study in Krakow, Poland; and the Lund Stroke Register study in Lund, Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001017"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST006906</owl:annotatedTarget>
        <dcterms:title>Multiancestry genome-wide association study of 520,000 subjects identifies 32 loci associated with stroke and stroke subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29531354</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>ICH 1,545 1,481</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001017"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A group of six genome-wide association case-control studies of spontaneous intracerebral haemorrhage in people of European ancestry, meta-analysed under the auspices of the International Stroke Genetics Consortium to find susceptibility loci for lobar and nonlobar haemorrhage. It comprises the multicentre Genetics of Cerebral Hemorrhage with Anticoagulation study in the United States, the Genetic and Environmental Risk Factors for Hemorrhagic Stroke studies I and II in Cincinnati, and four European studies in Barcelona, Krakow and Lund.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24656865</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29531354</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1545</owl:annotatedTarget>
        <obo:IAO_0000116>ICH cases and controls in the discovery meta-analysis of six GWAS (2014)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3980413/</oboInOwl:hasDbXref>
        <rdfs:comment>The discovery phase included a case cohort of 1,545 individuals (664 lobar and 881 nonlobar cases) and a control cohort of 1,481 individuals and identified two susceptibility loci: for lobar ICH, chromosomal region 12q21.1 (rs11179580, odds ratio [OR] = 1.56, p = 7.0 × 10−8); and for nonlobar ICH, chromosomal region 1q22 (rs2984613, OR = 1.44, p = 1.6 × 10−8).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1481</owl:annotatedTarget>
        <obo:IAO_0000116>ICH cases and controls in the discovery meta-analysis of six GWAS (2014)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3980413/</oboInOwl:hasDbXref>
        <rdfs:comment>The discovery phase included a case cohort of 1,545 individuals (664 lobar and 881 nonlobar cases) and a control cohort of 1,481 individuals and identified two susceptibility loci: for lobar ICH, chromosomal region 12q21.1 (rs11179580, odds ratio [OR] = 1.56, p = 7.0 × 10−8); and for nonlobar ICH, chromosomal region 1q22 (rs2984613, OR = 1.44, p = 1.6 × 10−8).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001017"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ICH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001018 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001018">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid9285"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90134661</obo:IAO_0000112>
        <obo:IAO_0000115>A genome-wide association case-control study of lung cancer in the United Kingdom, run at the Institute of Cancer Research, which genotyped lung cancer patients recruited in 1999–2004 through UK oncology centres for the Genetic Lung Cancer Predisposition Study (GELCAPS) and compared them with genotyped controls from the 1958 British Birth Cohort.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym ICR also denotes Icelandic Cancer Registry (COHO:0000096); this term is UK lung cancer GWAS from the Institute for Cancer Research.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1952</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1438</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>ICR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ICR-GWA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ICR-GWAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ICR_b</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK-GWA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">UK lung cancer GWAS from the Institute for Cancer Research</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9285">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001018"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9285"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18978787+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a genome-wide association (GWA) study of lung cancer comparing 511,919 SNP genotypes in 1,952 cases and 1,438 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001018"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3607485/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>the UK lung cancer GWAS from the Institute for Cancer Research including lung cancer cases from the Genetic Lung Cancer Predisposition Study (GELCAPS) and controls from the 1958 Birth Cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90134661</owl:annotatedTarget>
        <dcterms:title>Cross-ancestry genome-wide meta-analysis of 61,047 cases and 947,237 controls identifies new susceptibility loci contributing to lung cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35915169</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9373844/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Axiom Array Study (AFFY), the Female Lung Cancer Consortium in Asia (FLCCA), the Genetic Epidemiology of Lung Cancer Consortium (GELCC), the Environment and Genetics in Lung cancer Etiology study (EAGLE), Helmholtz-Gemeinschaft Deutscher Forschungszentren Lung Cancer GWAS (GERMAN), the International Agency for Research on Cancer (IARC), the Institute of Cancer Research (ICR), MD Anderson Cancer Center Study (MDACC), NCI Lung Cancer and Smoking Phenotypes in African-American Cases and Controls (NCI), OncoArray Consortium Lung Study (OncoArray), the Prostate, Lung, Colorectal and Ovarian Cancer Screening Trial (PLCO), and Samuel Lunenfeld Research Institute Study (SLRI) (Supplementary</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genome-wide association case-control study of lung cancer in the United Kingdom, run at the Institute of Cancer Research, which genotyped lung cancer patients recruited in 1999–2004 through UK oncology centres for the Genetic Lung Cancer Predisposition Study (GELCAPS) and compared them with genotyped controls from the 1958 British Birth Cohort.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18715499</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18978787</obo:IAO_0000119>
