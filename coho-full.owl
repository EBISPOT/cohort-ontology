        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9378791/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The participants for this study included individuals aged 7 years and older recruited through four studies: the Pittsburgh Orofacial Cleft Study (POFC, n = 3,579); the Center for Oral Health Research in Appalachia (COHRA1, n = 1,837;</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000671"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multiethnic family-based collection of people with nonsyndromic orofacial clefts, their unaffected relatives and unaffected controls, recruited by the University of Pittsburgh through cleft centres in the United States and Puerto Rico and in Argentina, the Philippines, Colombia, Guatemala and Hungary to study the genetics of orofacial clefts and related dental traits.</owl:annotatedTarget>
