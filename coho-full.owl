        <rdfs:label xml:lang="en">Estudo Longitudinal de Saúde do Adulto</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.elsa.org.br/oelsabrasil.html"/>
    </owl:NamedIndividual>
