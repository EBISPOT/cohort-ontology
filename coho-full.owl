        <dcterms:title>Dementias Platform UK: Bringing genetics into life.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38506636</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11095482/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For this project we used DPUK cohorts that agreed to participate in sharing the individual‐level genotype data with the main aim of merging and processing the datasets together.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002679"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A platform established by the UK Medical Research Council to accelerate the development of new treatments for dementia, run from the University of Oxford, whose Data Portal, launched in 2017, brings together data from independent population and clinical cohorts, most of them in the United Kingdom, in a shared remote-access environment for collaborative and multi-cohort research on dementia and neurodegeneration.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32328990</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38506636</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002679"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3370929</owl:annotatedTarget>
        <obo:IAO_0000116>individuals across the 42 cohorts of the DPUK Data Portal (2020)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:32328990</oboInOwl:hasDbXref>
        <rdfs:comment>The Dementias Platform UK Data Portal is a data repository facilitating access to data for 3 370 929 individuals in 42 cohorts.</rdfs:comment>
    </owl:Axiom>
