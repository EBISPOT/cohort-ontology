    <!-- http://www.ebi.ac.uk/coho/COHO_0000001 -->

    <owl:Class rdf:about="http://www.ebi.ac.uk/coho/COHO_0000001">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
                <owl:someValuesFrom rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A study, project or consortium that compares multiple cohorts.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">cohort aggregation</rdfs:label>
    </owl:Class>
    


