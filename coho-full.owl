        <owl:annotatedTarget>PMID:35765848</owl:annotatedTarget>
        <dcterms:title>Developing and validating polygenic risk scores for colorectal cancer risk prediction in East Asians.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35765848</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC9509464/</oboInOwl:hasDbXref>
        <rdfs:comment>Data from the Korean-National Cancer Center CRC Study (Korea validation set: a case-control study including 622 cases and 832 controls) and a case-control study nested in cohorts of the Shanghai Men’s Health Study and Shanghai Women’s Health Study (China validation set: 868 cases and 868 age- and sex-frequency matched controls) were used for model validation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001364"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of colorectal cancer at the National Cancer Center in Goyang, South Korea, whose cases are patients newly diagnosed with colorectal cancer at its Center for Colorectal Cancer from 2010 and whose controls are people attending the national health check-up programme at its Center for Cancer Prevention and Detection, with lifestyle and food-frequency questionnaires and genome-wide genotyping, contributing to the Asia Colorectal Cancer Consortium&apos;s studies of genetic susceptibility to colorectal cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30529582</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35765848</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38514198</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
