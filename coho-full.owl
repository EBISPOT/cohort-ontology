        <oboInOwl:hasRelatedSynonym>Genomic Health Initiative of Endeavor Health</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NSGHI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>North Shore University Health systems Genomic Health Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genomic Health Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001025"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12233176/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GHI is a US health care-based biobank at Endeavor Health in Illinois.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001025"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90824080</owl:annotatedTarget>
        <dcterms:title>Cross-definition GWAS of IBS in 2.8 million individuals reveals cardiometabolic and triglyceride-linked mechanisms.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42425734</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://gut.bmj.com/content/gutjnl/early/2026/07/01/gutjnl-2026-338800/DC1/embed/inline-supplementary-material-1.pdf?download=true</oboInOwl:hasDbXref>
        <rdfs:comment>The Genomic Health Initiative (GHI) is a community-based healthcare biobank established at Endeavor Health (Evanston, Illinois, USA), designed to integrate genomic data with comprehensive EHR.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001025"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A healthcare-system-based research biobank of NorthShore University HealthSystem (now Endeavor Health) in Illinois, United States, started in 2014, which enrols patients of the health system who consent to give a blood sample for DNA and to linkage of their electronic health records, for translational and discovery research combining genomic and clinical data.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38090148</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40496845</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41585861</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001025"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">60000</owl:annotatedTarget>
        <obo:IAO_0000116>participants enrolled, stated as &apos;more than 60,000&apos; (lower bound), 2026</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://gut.bmj.com/content/gutjnl/early/2026/07/01/gutjnl-2026-338800/DC1/embed/inline-supplementary-material-1.pdf?download=true</oboInOwl:hasDbXref>
        <rdfs:comment>To date, GHI includes more than 60,000 participants</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001025"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GHI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
