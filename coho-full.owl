    <!-- http://www.ebi.ac.uk/coho/COHO_0000939 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000939">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid8561"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000533"/>
        <obo:IAO_0000112>GCST90624209</obo:IAO_0000112>
        <obo:IAO_0000115>A birth and three-generation cohort in Japan conducted since July 2013 by the Tohoku Medical Megabank Organization of Tohoku University and the Iwate Tohoku Medical Megabank Organization, recruiting pregnant women and their fetuses as probands together with the fathers, grandparents, siblings and extended family members, with genome and omics information, to study disease risk across generations.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym TMM also denotes Tohoku Medical Megabank Project (COHO:0000533) and Tohoku Medical Megabank Community-Based Cohort Study (COHO:0000938); this term is Tohoku Medical Megabank Project Birth and Three-Generation Cohort Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">74116</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BirThree Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BirThree Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TMM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TMM BirThree</oboInOwl:hasRelatedSynonym>
