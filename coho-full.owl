        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16270"/>
        <obo:IAO_0000116>schizophrenia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3002316/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Inclusion criteria were (1) confirmed or suspected diagnosis of schizophrenia or schizoaffective disorder according to DSM-IV and (2) at least some ability to cooperate.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001822"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16272"/>
        <obo:IAO_0000116>schizoaffective disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3002316/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Inclusion criteria were (1) confirmed or suspected diagnosis of schizophrenia or schizoaffective disorder according to DSM-IV and (2) at least some ability to cooperate.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001822"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3002316/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For this purpose, 1085 patients were recruited between 2005 and 2010 by an invariable team of traveling investigators in a cross-sectional field study that comprised 23 German psychiatric hospitals.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001822"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28623238</owl:annotatedTarget>
        <dcterms:title>A normal genetic variation modulates synaptic MMP-9 protein levels and the severity of schizophrenia symptoms.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28623238</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28623238+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In the present study, we performed a phenotype-based genetic association study (PGAS) in &gt; 1,000 schizophrenia patients from the Göttingen Research Association for Schizophrenia (GRAS) data collection and found an association between the MMP-9 rs20544 C/T single-nucleotide polymorphism (SNP) located in the 3&apos;untranslated region (UTR) and the severity of a chronic delusional syndrome.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001822"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional data collection of patients with schizophrenia or schizoaffective disorder in Germany, recruited from 2005 by a single travelling team of investigators at 23 collaborating psychiatric hospitals, among them inpatients, outpatients, residents of sheltered homes and forensic patients, and phenotyped with more than 3,000 data points per patient, with healthy blood-donor controls recruited in Göttingen for genetic analyses, built as the basis for phenotype-based genetic association studies of schizophrenia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20819981</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21067598</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001822"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1085</owl:annotatedTarget>
        <obo:IAO_0000116>patients recruited into the GRAS data collection in 2005-2010; blood-donor controls not counted</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:21067598</oboInOwl:hasDbXref>
        <rdfs:comment>For this purpose, 1085 patients were recruited between 2005 and 2010 by an invariable team of traveling investigators in a cross-sectional field study that comprised 23 German psychiatric hospitals.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001822"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GRAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001823 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001823">
