    <!-- http://www.ebi.ac.uk/coho/COHO_0002213 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002213">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18996"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:20360844</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing prospective community-based study of out-of-hospital sudden cardiac arrest and sudden cardiac death in the Portland, Oregon metropolitan area (including Multnomah County), United States, running since 2002, which ascertains cases through first responders, emergency medical services, area hospitals and the county medical examiner, reviews their medical records, and compares them with geographically matched controls, including people with coronary artery disease, some of them with blood samples for genetic studies.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2938</coho:numberOfCases>
        <oboInOwl:hasRelatedSynonym>Ore-SUDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Oregon-SUDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Oregon-Sudden Unexpected Death Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Oregon Sudden Unexpected Death Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18996">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000745"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002213"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18996"/>
        <obo:IAO_0000116>out-of-hospital cardiac arrest</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4323796/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Oregon Sudden Unexpected Death Study is a prospective study of out‐of‐hospital cardiac arrest in the Portland, Oregon, metropolitan area (population ≈1 million), ongoing since 2002.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002213"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2845611/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Oregon Sudden Unexpected Death Study (Oregon-SUDS) is an ongoing, prospective, community-based evaluation of approximately one million residents of the Portland, Oregon metropolitan area [10].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20360844</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies GPC5 as a novel genetic locus protective against sudden cardiac arrest.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20360844</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2845611/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We used a case-control design within the ongoing Oregon Sudden Unexpected Death Study (Oregon-SUDS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing prospective community-based study of out-of-hospital sudden cardiac arrest and sudden cardiac death in the Portland, Oregon metropolitan area (including Multnomah County), United States, running since 2002, which ascertains cases through first responders, emergency medical services, area hospitals and the county medical examiner, reviews their medical records, and compares them with geographically matched controls, including people with coronary artery disease, some of them with blood samples for genetic studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16545646</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:16731473</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20360844</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25227407</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002213"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2938</owl:annotatedTarget>
        <obo:IAO_0000116>sudden cardiac deaths among adult residents of Multnomah County, Oregon, ascertained February 2004 to January 2016 (the largest count stated; the study&apos;s controls are not counted and no total is stated), 2004-2016</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7122833/</oboInOwl:hasDbXref>
        <rdfs:comment>From February 2004 through January 2016, there were 2,938 SCDs among Multnomah County, Oregon residents age ≥18 y (average adult population, 572 000).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002213"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Ore-SUDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002213"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Oregon-SUDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


