    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002291">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19569"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <obo:IAO_0000112>PGS000044</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33420416</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised phase 3 trial in the United Kingdom in which men aged 50–69 registered at primary care centres in nine UK cities were invited for PSA testing (a pilot from 1999, the main phase from 2001 to 2009), men with a raised PSA were offered prostate biopsy, and those with clinically localised prostate cancer were randomly assigned to active monitoring, radical prostatectomy or radiotherapy, to investigate the effectiveness of treatments for localised prostate cancer.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1643</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Prostate Testing for Cancer and Treatment study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prostate testing for cancer and Treatment trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ProtecT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>prostate testing for cancer and treatment study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Prostate testing for cancer and Treatment study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19569">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002291"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19569"/>
        <obo:IAO_0000116>localised prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25163905+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The ProtecT trial randomly assigned 1643 men with localised prostate cancer to active monitoring, radiotherapy, or surgery.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002291"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25163905+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In this randomised phase 3 trial, men aged 50-69 years registered at 337 primary care centres in nine UK cities were invited to attend a specialist nurse appointment for a serum prostate-specific antigen (PSA) test.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002291"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000044</owl:annotatedTarget>
        <dcterms:title>Reducing overdiagnosis by polygenic risk-stratified screening: findings from the Finnish section of the ERSPC.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:26291059</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002291"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33420416</owl:annotatedTarget>
        <dcterms:title>Additional SNPs improve risk stratification of a polygenic hazard score for prostate cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33420416</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8157993/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>A testing set consisting of 6,411 men (4,828 controls and 1,583 cases) enrolled in the ProtecT clinical trial was set aside for estimating the performance of the final PHS models.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002291"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised phase 3 trial in the United Kingdom in which men aged 50–69 registered at primary care centres in nine UK cities were invited for PSA testing (a pilot from 1999, the main phase from 2001 to 2009), men with a raised PSA were offered prostate biopsy, and those with clinically localised prostate cancer were randomly assigned to active monitoring, radical prostatectomy or radiotherapy, to investigate the effectiveness of treatments for localised prostate cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25163905</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
