        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <obo:IAO_0000112>PMID:26390057</obo:IAO_0000112>
        <obo:IAO_0000115>A Japanese collaborative sample, assembled within the nationally based cooperative Millennium Genome Project for genetic studies of hypertension, that combines seven independent cohorts for studies of cardiovascular diseases and related risk factors: the Ohasama, Shigaraki, Takashima, Suita and Nomura studies, general-population studies of community residents recruited through medical check-ups, and the Yokohama and Matsuyama cohorts of employees of large manufacturing industries.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14105</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>JMGP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Japanese Millenium Genome Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Japanese Millennium Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Millennium GPJ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Japanese Millennium Genome Project</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Japanese Millennium Genome Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17166">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001951"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17166"/>
        <obo:IAO_0000116>cardiovascular diseases</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3405/MediaObjects/41588_2015_BFng3405_MOESM35_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Japanese Millennium Genome Project comprises seven independent study cohorts for studies of cardiovascular diseases and related risk factors.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001951"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002171"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5003412/</oboInOwl:hasDbXref>
        <rdfs:comment>The Ohasama, Shigaraki, Takashima, Suita, and Nomura studies are general population-based genetic epidemiological studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001951"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002418"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5003412/</oboInOwl:hasDbXref>
        <rdfs:comment>The Ohasama, Shigaraki, Takashima, Suita, and Nomura studies are general population-based genetic epidemiological studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001951"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature10405/MediaObjects/41586_2011_BFnature10405_MOESM207_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Yokohama (Yokohama City University) and Matsuyama (Ehime University) cohorts are derived from employees of large manufacturing industries located in Kanagawa and Matsuyama City, Ehime Prefecture (western part of Japan)48 , respectively.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001951"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:26390057</owl:annotatedTarget>
        <dcterms:title>Trans-ancestry genome-wide association study identifies 12 genetic loci influencing blood pressure and implicates a role for DNA methylation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:26390057</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3405/MediaObjects/41588_2015_BFng3405_MOESM35_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Japanese Millennium Genome Project comprises seven independent study cohorts for studies of cardiovascular diseases and related risk factors.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001951"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Japanese collaborative sample, assembled within the nationally based cooperative Millennium Genome Project for genetic studies of hypertension, that combines seven independent cohorts for studies of cardiovascular diseases and related risk factors: the Ohasama, Shigaraki, Takashima, Suita and Nomura studies, general-population studies of community residents recruited through medical check-ups, and the Yokohama and Matsuyama cohorts of employees of large manufacturing industries.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20921432</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21909115</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26390057</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001951"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14105</owl:annotatedTarget>
        <obo:IAO_0000116>individuals of the seven combined cohorts in the project&apos;s population sample (2010)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:20921432</oboInOwl:hasDbXref>
        <rdfs:comment>Seven independent study cohorts for cardiovascular diseases and related risk factors were combined to compose a large-scale Japanese genetic epidemiological population sample of 14 105.</rdfs:comment>
    </owl:Axiom>
