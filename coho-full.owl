    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002722"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23118"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7611162/</oboInOwl:hasDbXref>
        <rdfs:comment>Carriers of pathogenic variants (mutations) in the BRCA1 and BRCA2 genes are at very high risk of developing breast cancer (BC) and ovarian cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002722"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23120"/>
        <obo:IAO_0000116>ovarian cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7611162/</oboInOwl:hasDbXref>
        <rdfs:comment>Carriers of pathogenic variants (mutations) in the BRCA1 and BRCA2 genes are at very high risk of developing breast cancer (BC) and ovarian cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
