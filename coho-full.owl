        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7769</owl:annotatedTarget>
        <obo:IAO_0000116>REPRIEVE randomized people with HIV, 2015-2019</obo:IAO_0000116>
