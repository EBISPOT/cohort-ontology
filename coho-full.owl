    <!-- http://www.ebi.ac.uk/coho/COHO_0001022 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001022">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid9324"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90726618</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre biorepository for genomic studies of human myocardial disease, led by investigators at the Perelman School of Medicine, University of Pennsylvania, which collects left ventricular tissue from failing hearts at cardiac transplantation and from donor hearts not used for transplantation, at sites including the University of Pennsylvania, the Cleveland Clinic and Stanford, together with genotyped patients with prevalent heart failure referred to a heart failure specialty centre for case-control studies of heart failure.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1352</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MAGNet</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MAGnet</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Myocardial Applied Genetics Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Myocardial Applied Genetics Network</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Myocardial Applied Genomics Network study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Myocardial Applied Genomics Network</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9324">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005252"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001022"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9324"/>
        <obo:IAO_0000116>heart failure</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6591478/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Using this consensus protocol, we obtained 1352 human cardiac samples and chose a subset of 313 hearts, including 177 failing hearts collected immediately post transplantation and 136 healthy donor controls that were suitable for transplantation but did not reach a recipient due to logistical reasons (clinical characteristics listed in Supplementary Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001022"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6591478/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The institutional review boards at all collection sites (including Stanford, the University of Pennsylvania and the Cleveland Clinic) reviewed and approved the protocols used in this study for procurement and use of human tissue and information.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90726618</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study meta-analysis provides insights into the etiology of heart failure and its subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40038546</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11985341/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>MAGNet is a collaborative group of investigators based at Perelman School of Medicine, University of Pennsylvania who use genomic approaches to understand human myocardial disease (http://www.med.upenn.edu/magnet/, NHLBI grant number 1R01HL105993-01A1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre biorepository for genomic studies of human myocardial disease, led by investigators at the Perelman School of Medicine, University of Pennsylvania, which collects left ventricular tissue from failing hearts at cardiac transplantation and from donor hearts not used for transplantation, at sites including the University of Pennsylvania, the Cleveland Clinic and Stanford, together with genotyped patients with prevalent heart failure referred to a heart failure specialty centre for case-control studies of heart failure.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31235787</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36376295</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40038546</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001022"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1352</owl:annotatedTarget>
        <obo:IAO_0000116>healthy and failing human hearts harvested (tissue biorepository), 2019</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:31235787</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we harvest 1352 healthy and failing human hearts directly from transplant center operating rooms, and obtain genome-wide genotyping and gene expression measurements for a subset of 313.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001022"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MAGNet</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001022"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MAGnet</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


