        <oboInOwl:hasRelatedSynonym>The Effect of Dietary BIoactives on Gut Microbiome DivErsity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Effect of Dietary Bioactives on Gut Microbiome DivErsity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">The Effect of Dietary Bioactives on Gut Microbiome Diversity</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23320">
