    <!-- http://www.ebi.ac.uk/coho/COHO_0002696 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002696">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid22736"/>
        <rdf:type rdf:nodeID="genid22738"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000426"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000763"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South-Eastern_Asia"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:41469377</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of four longitudinal population health cohorts in Singapore (HELIOS, the Singapore Population Health Studies, the Singapore Epidemiology of Eye Diseases and SingHeart), brought together under an NMRC grant and in partnership with Precision Health Research, Singapore (PRECISE) and the Genome Institute of Singapore in phase II of the National Precision Medicine programme, whose multi-ancestry Asian participants were whole-genome sequenced and linked to electronic health records to study the determinants and prediction of cardiovascular disease and diabetes in Asian populations.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PRECISE-SG100K</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SG100K cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SG100K population study</oboInOwl:hasRelatedSynonym>
