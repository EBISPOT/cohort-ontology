        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">740</owl:annotatedTarget>
        <obo:IAO_0000116>interns of the founding 2007-2008 and 2008-2009 cohorts at 13 US hospitals who agreed to take part (the study enrols a new cohort each year), 2007-2009</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4036806/</oboInOwl:hasDbXref>
        <rdfs:comment>58% (740/1271) of the remaining invited subjects agreed to participate in the study.</rdfs:comment>
    </owl:Axiom>
