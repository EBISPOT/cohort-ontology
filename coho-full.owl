    <!-- http://www.ebi.ac.uk/coho/COHO_0001802 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001802">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid16077"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002714"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002715"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002716"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Austria"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Czech_Republic"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <obo:IAO_0000112>PMID:24149102</obo:IAO_0000112>
        <obo:IAO_0000115>A clinical trials group, whose Trial Coordination Center belongs to Department I of Internal Medicine of the University of Cologne, Germany, that runs controlled, prospective, randomized trials for all stages of Hodgkin lymphoma, recruiting patients from across Europe, to optimise diagnostics, therapy and follow-up care; genetic studies use Hodgkin lymphoma patients ascertained through it.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12202</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GHSG</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">German Hodgkin Study Group</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16077">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004952"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001802"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16077"/>
        <obo:IAO_0000116>Hodgkin lymphoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6746042/</oboInOwl:hasDbXref>
        <rdfs:comment>Among 12,202 European HL patients observed for 94,972 person-years, 19 suicides (17 males and 2 females) were identified resulting in a SMR 1.63 (95% CI: 1.01–2.50, p = 0.046).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001802"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002714"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3553532/</oboInOwl:hasDbXref>
        <rdfs:comment>From 1998 to 2002, the German Hodgkin Study Group (GHSG) conducted the 4th generation of clinical trials for the treatment of HL (HD10–12) involving a total of 4610 patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001802"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002715"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3553532/</oboInOwl:hasDbXref>
        <rdfs:comment>From 1998 to 2002, the German Hodgkin Study Group (GHSG) conducted the 4th generation of clinical trials for the treatment of HL (HD10–12) involving a total of 4610 patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001802"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002716"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3553532/</oboInOwl:hasDbXref>
        <rdfs:comment>From 1998 to 2002, the German Hodgkin Study Group (GHSG) conducted the 4th generation of clinical trials for the treatment of HL (HD10–12) involving a total of 4610 patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001802"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Austria"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6746042/</oboInOwl:hasDbXref>
        <rdfs:comment>The GHSG HD7-HD15 studies accrued patients from Germany, Switzerland, the Netherlands, the Czech Republic, and Austria between 1993 and 2009 and were analyzed to identify those patients with Hodgkin Lymphoma whose cause of death was suicide.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001802"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:24149102</owl:annotatedTarget>
        <dcterms:title>Variation at 3p24.1 and 6q23.3 influences the risk of Hodgkin&apos;s lymphoma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24149102</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5053363/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the primary scan (German-GWAS), 1,001 cHL cases, ascertained by the German Hodgkin Study Group during 1998–2007, were genotyped using the Illumina Human OmniExpress-12 v1.0 arrays.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001802"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A clinical trials group, whose Trial Coordination Center belongs to Department I of Internal Medicine of the University of Cologne, Germany, that runs controlled, prospective, randomized trials for all stages of Hodgkin lymphoma, recruiting patients from across Europe, to optimise diagnostics, therapy and follow-up care; genetic studies use Hodgkin lymphoma patients ascertained through it.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24149102</obo:IAO_0000119>
        <obo:IAO_0000119>https://en.ghsg.org/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001802"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12202</owl:annotatedTarget>
        <obo:IAO_0000116>European patients in the pooled GHSG HD7–HD15 trial follow-up, accrued 1993–2009; not the all-time GHSG total</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6746042/</oboInOwl:hasDbXref>
        <rdfs:comment>Among 12,202 European HL patients observed for 94,972 person-years, 19 suicides (17 males and 2 females) were identified resulting in a SMR 1.63 (95% CI: 1.01–2.50, p = 0.046).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001802"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GHSG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


