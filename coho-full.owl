        <obo:IAO_0000112>GCST90054795</obo:IAO_0000112>
        <obo:IAO_0000115>A research resource of Kaiser Permanente, launched in May 2016 and built on the Research Program on Genes, Environment and Health, that collects biospecimens and surveys linked to electronic health records from consenting adult members across Kaiser Permanente&apos;s eight US regions (about 396,000 consented by July 2021), with general, pregnancy and cancer cohorts.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym KP also denotes Genetic Epidemiology Research on Adult Health and Aging (COHO:0000431); this term is Kaiser Permanente Research Bank.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">396000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>KP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KP Research Bank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KPRB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Kaiser Permanente</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Kaiser Permanente Research Bank (KPRB)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Kaiser Permanente Research Board</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Kaiser Permanente Research Bank</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://researchbank.kaiserpermanente.org/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000541"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The KP Research Bank (KPRB), a research resource within KP, is seeking to collect biospecimens and surveys from at least 400,000 adult members across the U.S. and linking that information to the EHR.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000541"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90054795</owl:annotatedTarget>
        <dcterms:title>Three genes associated with anterior and posterior cruciate ligament injury : a genome-wide association analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34169730</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34169730+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Genome-wide association (GWA) analyses were performed using data from the Kaiser Permanente Research Board (KPRB) and the UK Biobank.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000541"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A research resource of Kaiser Permanente, launched in May 2016 and built on the Research Program on Genes, Environment and Health, that collects biospecimens and surveys linked to electronic health records from consenting adult members across Kaiser Permanente&apos;s eight US regions (about 396,000 consented by July 2021), with general, pregnancy and cancer cohorts.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35216576</obo:IAO_0000119>
