        <obo:IAO_0000112>GCST90707263</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort at Brigham and Women&apos;s Hospital in Boston, United States, begun in 2009, of adults undergoing aortic valve surgery with or without coronary artery bypass grafting, from whom left ventricular myocardium is biopsied at the apical vent site at the start and end of the ischaemic period of cardiopulmonary bypass, together with blood and DNA, to study how genetic variation shapes cardiac gene expression and its response to ischaemia.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">140</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TRANSCRIBE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TRANSCRIBE Program</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TRANSCRibE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TRanscriptomic ANalySis of left ventriCulaR gene Expression</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Whole Genome Expression of Left Ventricular Myocardium During Cardiac Surgery</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Transcriptomic Analysis of Left Ventricular Gene Expression</rdfs:label>
    </owl:NamedIndividual>
