        <rdfs:comment>Han Chinese in Beijing, China (CHB);</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000808"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90011781</owl:annotatedTarget>
        <dcterms:title>Genetically regulated expression underlies cellular sensitivity to chemotherapy in diverse populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33575800</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8248963/</oboInOwl:hasDbXref>
        <rdfs:comment>The LCLs were derived from individuals from the Yoruba population in Ibadan, Nigeria (YRI), individuals with European ancestries from Utah, USA (CEU) and individuals from a combined population of Han Chinese from Beijing, China, and Japanese from Tokyo, Japan (ASN).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
