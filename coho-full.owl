        <obo:IAO_0000112>GCST90129576</obo:IAO_0000112>
        <obo:IAO_0000115>A UK general-population cohort started in 2003 that recruited 112,049 participants aged 16–102 by 2011 through a generational referral method, in which women recruited directly nominated female friends and relatives, collecting detailed questionnaires and blood samples repeatedly over decades to investigate breast cancer aetiology.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">112049</coho:numberOfParticipants>
