        <obo:IAO_0000112>GCST90454455</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium established to study the host genetics of tuberculosis through collaborative, equitable data sharing, combining case-control genome-wide association studies from nine countries across Europe, Africa and Asia in a multi-ancestry meta-analysis of tuberculosis susceptibility.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14153</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19536</coho:numberOfControls>
