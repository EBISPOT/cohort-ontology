        <rdfs:comment>The Gene-Diet Attica Investigation on childhood obesity (GENDAI) evaluates the contributions to and pivotal interactions of genetic, dietary and physical activity variables on children&apos;s weight.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001774"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
