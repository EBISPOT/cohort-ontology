        <rdfs:comment>The Oxford Vascular Study is a prospective incidence study of all vascular events in a population of 92 728 people residing in Oxfordshire, UK.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000955"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
