    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002739 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002739">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23279"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <obo:IAO_0000112>MTBLS8812</obo:IAO_0000112>
        <obo:IAO_0000115>A single-centre, randomised, placebo-controlled, double-blind phase I trial at Haukeland University Hospital, Bergen, Norway, in which people with Parkinson&apos;s disease received 1,500 mg of nicotinamide riboside twice daily or placebo for four weeks, to evaluate the safety of high-dose nicotinamide riboside.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NR-SAFE: a Safety Study Investigating Treatment With High-dose Nicotinamide Riboside (NR) in Parkinson&apos;s Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">NR-SAFE</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23279">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002739"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23279"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://clinicaltrials.gov/api/v2/studies/NCT05344404</oboInOwl:hasDbXref>
        <rdfs:comment>NR-SAFE is a double-blinded randomized safety study aiming to determine the safety and tolerability of nicotinamide riboside (NR) at a daily dose of 3000mg, in individuals with Parkinson&apos;s disease (PD).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002739"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Norway"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10684646/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The trial was conducted at the Department of Neurology, Haukeland University Hospital, Bergen, Norway.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002739"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS8812</owl:annotatedTarget>
        <dcterms:title>NR-SAFE: a randomized, double-blind safety trial of high dose nicotinamide riboside in Parkinson&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38016950</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS8812</oboInOwl:hasDbXref>
        <rdfs:comment>NR-SAFE: a randomized, double-blind safety trial of high dose nicotinamide riboside in Parkinson&apos;s disease</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002739"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A single-centre, randomised, placebo-controlled, double-blind phase I trial at Haukeland University Hospital, Bergen, Norway, in which people with Parkinson&apos;s disease received 1,500 mg of nicotinamide riboside twice daily or placebo for four weeks, to evaluate the safety of high-dose nicotinamide riboside.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38016950</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002739"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20</owl:annotatedTarget>
        <obo:IAO_0000116>individuals with Parkinson&apos;s disease enrolled and randomised (2022)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10684646/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In total, 26 individuals with PD were screened, and 20 eligible participants were enrolled, all of whom completed the study (Fig. 1).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002740 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002740">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23285"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>MTBLS4219</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of all preterm infants born before 29 weeks of gestational age and admitted to the neonatal intensive care unit of Dijon University Hospital, France, between July 2015 and January 2018, whose erythrocyte polyunsaturated fatty acids were measured shortly after birth to evaluate their value in predicting retinopathy of prematurity.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">58</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>OMEGAROP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Omega-ROP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>OmegaROP study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study of the Implication of Omega-3 Polyunsaturated Fatty Acids in Retinopathy of Prematurity in Newborns</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">OmegaROP</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23285">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006952"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002740"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23285"/>
        <obo:IAO_0000116>retinopathy of prematurity</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6538605/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Extremely preterm infants are at high risk for retinopathy of prematurity (ROP), a potentially blinding disease characterized by abnormalities in retinal vascularization.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002740"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6538605/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>From July 31st, 2015, to January 31st, 2018, all preterm infants born before 29 weeks GA and hospitalized in the neonatal intensive care unit of the Dijon University Hospital, Dijon, France, were included in the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002740"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS4219</owl:annotatedTarget>
        <dcterms:title>Modification of erythrocyte membrane phospholipid composition in preterm newborns with retinopathy of prematurity: The omegaROP study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36158214</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS4219</oboInOwl:hasDbXref>
        <rdfs:comment>In the OmegaROP prospective cohort study, we showed that preterm infants who will develop ROP accumulate the n-6 PUFA arachidonic acid (ARA) at the expense of the n-3 PUFA docosahexaenoic acid (DHA) in erythrocytes with advancing gestational age (GA).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002740"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of all preterm infants born before 29 weeks of gestational age and admitted to the neonatal intensive care unit of Dijon University Hospital, France, between July 2015 and January 2018, whose erythrocyte polyunsaturated fatty acids were measured shortly after birth to evaluate their value in predicting retinopathy of prematurity.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31138879</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002740"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">58</owl:annotatedTarget>
        <obo:IAO_0000116>preterm infants born before 29 weeks of gestational age included (2018)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6538605/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Fifty-eight preterm infants born before 29 weeks GA were included. Six infants died and the mortality rate was 11.5%. Blood samples were obtained from 52 infants at a median time of 12 h and a maximum time of 48 h after birth.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002740"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>OMEGAROP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002740"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Omega-ROP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002741 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002741">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid23293"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002742"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>MTBLS1497</obo:IAO_0000112>
        <obo:IAO_0000115>A UK industry-academic precision medicine partnership, funded by the Medical Research Council and the Association of the British Pharmaceutical Industry, that recruited a cohort of patients with early rheumatoid arthritis and a cohort of healthy people receiving the hepatitis B vaccine, followed for up to 18 months with deep clinical and multi-omic phenotyping, to find predictors of disease outcome and treatment response.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>RA MRC/ABPI (RA-MAP) Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RA-MAP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RA-MAP Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RA-MAP consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">RA-MAP Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23293">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008383"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002741"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23293"/>
        <obo:IAO_0000116>rheumatoid arthritis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The “Towards A Cure for Early Rheumatoid Arthritis” (TACERA) study12 was designed to detect distinct disease subtypes and the immunological correlates of disease activity and autoimmunity in patients with early, seropositive RA, with a secondary objective to investigate biomarkers of initial drug response to methotrexate.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002741"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002742"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8544781/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>a cohort of newly diagnosed seropositive RA patients – the ‘Towards A CurE for RA’ (TACERA) cohort – was established and followed frequently and deeply phenotyped.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002741"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects were recruited from 28 participating centres across the UK.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002741"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS1497</owl:annotatedTarget>
        <dcterms:title>RA-MAP: mapping the molecular immunological landscape in early rheumatoid arthritis with vaccine controls</dcterms:title>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS1497</oboInOwl:hasDbXref>
        <rdfs:comment>RA-MAP: mapping the molecular immunological landscape in early rheumatoid arthritis with vaccine controls</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002741"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A UK industry-academic precision medicine partnership, funded by the Medical Research Council and the Association of the British Pharmaceutical Industry, that recruited a cohort of patients with early rheumatoid arthritis and a cohort of healthy people receiving the hepatitis B vaccine, followed for up to 18 months with deep clinical and multi-omic phenotyping, to find predictors of disease outcome and treatment response.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35534493</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
