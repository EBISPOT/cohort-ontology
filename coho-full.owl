        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000417"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. Nashville Biosciences (NashBio), the PGS Catalog cohort id used for scores of Haydarlou et al. 2026 and Kerrebijn et al. 2026, is a company, a data and analytics provider owned by Vanderbilt University Medical Center, and the samples it contributed are BioVU’s (PMC13472937: The NashBio dataset included in this study is a subset of BioVU). Replaced by COHO:0000417, BioVU, which carries the names Nashville Biosciences and NashBio. Found by the review of 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Nashville Biosciences</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


