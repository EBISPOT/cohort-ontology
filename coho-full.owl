    <!-- http://www.ebi.ac.uk/coho/COHO_0000326 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000326">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid2964"/>
        <obo:IAO_0000112>EGAS00001007321</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of 110 children from 70 families whose fathers were exposed to ionizing radiation as radar technicians, whole-genome sequenced to look for transgenerational signatures of paternal radiation exposure.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">Radar also names the Dutch adolescent study Research on Adolescent Development and Relationships (COHO:0000147); this term is the cohort of children of radiation-exposed radar technicians in the EGA study EGAS00001007321.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">110</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Radar</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <rdfs:label xml:lang="en">Radar cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid2964">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_with_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_7000047"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000326"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2964"/>
        <obo:IAO_0000116>paternal exposure to ionizing radiation in radar technicians</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001007321</oboInOwl:hasDbXref>
        <rdfs:comment>The father in this cohort were exposed to 0-353mSv of ionizing radiation and serve as exposed samples.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000326"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS00001007321</owl:annotatedTarget>
        <dcterms:title>Possible DNA damage after paternal exposure to ionizing radiation in radar technicians</dcterms:title>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000326"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of 110 children from 70 families whose fathers were exposed to ionizing radiation as radar technicians, whole-genome sequenced to look for transgenerational signatures of paternal radiation exposure.</owl:annotatedTarget>
        <obo:IAO_0000119>https://ega-archive.org/studies/EGAS00001007321</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000326"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">110</owl:annotatedTarget>
        <obo:IAO_0000116>offspring of former German radar operators (children, not counting parents)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:40550869</oboInOwl:hasDbXref>
        <rdfs:comment>We recruited 110 offspring of former German radar operators, who were likely to have been exposed to IR (Radar cohort, exposure = 0-353 mGy), and reanalyzed sequencing data of 130 offspring of Chernobyl cleanup workers (CRU, exposure = 0-4080 mGy) from Yeager, et al.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000326"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Radar</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


