    <!-- http://www.ebi.ac.uk/coho/COHO_0002563 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002563">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21587"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000989"/>
        <obo:IAO_0000112>PGS005378</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:21852243</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based breast cancer case-control study at Wake Forest University Health Sciences (Winston-Salem, North Carolina, United States) that from November 1998 enrolled women newly diagnosed with breast cancer, before any therapy, at the Wake Forest University Breast Care Center, and as controls, frequency-matched to cases on age and race, women with normal mammograms and no history of cancer from those attending routine mammography at its Breast Screening and Diagnostic Center; its African-American participants, recruited up to December 2008, were contributed to the African American Breast Cancer Consortium.</obo:IAO_0000115>
