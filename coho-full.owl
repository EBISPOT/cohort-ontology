    <!-- http://www.ebi.ac.uk/coho/COHO_0001499 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001499">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000744"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002450"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:23599335</obo:IAO_0000112>
        <obo:IAO_0000115>An Australian twin study of eye traits that combines twins, and some of their siblings, given an eye examination in the Twins Eye Study in Tasmania or in the Brisbane Adolescent Twin Study, with measures such as cycloplegic refraction, intraocular pressure and retinal photographs and with genome-wide genotypes, used in heritability, linkage and genome-wide association studies of ophthalmic traits. Its participants were recruited through the Australian Twin Registry, existing twin studies, schools and publicity.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2235</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ATES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Australian Twin Eye study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Australian Twin Eye Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001499"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000744"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs42003-020-0802-y/MediaObjects/42003_2020_802_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>BATS The Brisbane Adolescent Twins Study (BATS) is a part of the Australian Twin Eye Study, which was described elsewhere 3 .</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001499"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002450"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4141707/</oboInOwl:hasDbXref>
        <rdfs:comment>The Australian Twin Eye Study comprises participants examined as part of the Twins Eye Study in Tasmania (TEST) or the Brisbane Adolescent Twins Study (BATS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001499"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23599335</owl:annotatedTarget>
        <dcterms:title>Copy number variation at chromosome 5q21.2 is associated with intraocular pressure.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23599335</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23599335+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Australian Twin Eye Study and BMES both replicated the 5q21.2 CNV association and direction of effect (P = 0.001 and P = 0.02, respectively).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001499"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An Australian twin study of eye traits that combines twins, and some of their siblings, given an eye examination in the Twins Eye Study in Tasmania or in the Brisbane Adolescent Twin Study, with measures such as cycloplegic refraction, intraocular pressure and retinal photographs and with genome-wide genotypes, used in heritability, linkage and genome-wide association studies of ophthalmic traits. Its participants were recruited through the Australian Twin Registry, existing twin studies, schools and publicity.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19803772</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20835236</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23116649</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23599335</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001499"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2235</owl:annotatedTarget>
        <obo:IAO_0000116>twins and siblings examined in the Twins Eye Study in Tasmania, including the BATS wave (2009)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3855231/</oboInOwl:hasDbXref>
        <rdfs:comment>This study examined 2,235 people at total cost of approximately AUS$1,564,500.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001499"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ATES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001500 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001500">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13587"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:17132649</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective clinical cohort of patients with coronary artery disease (at least one coronary stenosis over 30% on angiography), from stable angina to acute coronary syndromes, enrolled in successive phases from November 1996 to early 2004 when they underwent coronary angiography at the Department of Medicine II of the Johannes Gutenberg University Mainz or the Bundeswehrzentralkrankenhaus Koblenz, Germany, and followed for cardiovascular death and non-fatal myocardial infarction. It studies clinical, genetic and laboratory determinants of the progression and outcome of coronary atherosclerosis, and for genetic case–control analyses also recruited healthy controls from the Rhein-Main area.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3800</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AtheroGene</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AtheroGene Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AtheroGene registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AtheroGene study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Atherogene</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Atherogene Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Large AtheroGene Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">AtheroGene Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13587">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005010"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001500"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13587"/>
        <obo:IAO_0000116>coronary artery disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4496051/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The AtheroGene study is a prospective, multicenter, clinical cohort study including patients with known CAD (at least one stenosis over 30%) as diagnosed by coronary angiography.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001500"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6164542/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Between June 1999 and March 2004, 3800 patients who underwent coronary angiography were recruited in the AtheroGene Study at the Department of Medicine II of the Johannes Gutenberg-University Mainz and the Bundeswehr-Zentralkrankenhaus Koblenz</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001500"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:17132649</owl:annotatedTarget>
        <dcterms:title>Impact of C-reactive protein and fibrinogen on cardiovascular prognosis in patients with stable angina pectoris: the AtheroGene study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:17132649</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17132649+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In a substudy of the prospective AtheroGene registry, we assessed in 1806 patients with documented CAD and stable angina pectoris, the risk of cardiovascular death and non-fatal myocardial infarction (n=183) over a median follow-up of 3.5 (maximum 7.7) years according to baseline levels of C-reactive protein and fibrinogen.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001500"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective clinical cohort of patients with coronary artery disease (at least one coronary stenosis over 30% on angiography), from stable angina to acute coronary syndromes, enrolled in successive phases from November 1996 to early 2004 when they underwent coronary angiography at the Department of Medicine II of the Johannes Gutenberg University Mainz or the Bundeswehrzentralkrankenhaus Koblenz, Germany, and followed for cardiovascular death and non-fatal myocardial infarction. It studies clinical, genetic and laboratory determinants of the progression and outcome of coronary atherosclerosis, and for genetic case–control analyses also recruited healthy controls from the Rhein-Main area.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19495570</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23136988</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26154343</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32321351</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001500"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3800</owl:annotatedTarget>
        <obo:IAO_0000116>patients undergoing coronary angiography recruited June 1999-March 2004</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7428563/</oboInOwl:hasDbXref>
        <rdfs:comment>Three thousand eight hundred patients, who underwent coronary angiography, were recruited in the AtheroGene Study at the Department of Medicine II of the Johannes Gutenberg‐University Mainz or the Bundeswehr‐Zentralkrankenhaus Koblenz, from June 1999 to March 2004.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001500"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AtheroGene</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001500"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Atherogene</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001501 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001501">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13595"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000102"/>
        <obo:IAO_0000112>PMID:23793025</obo:IAO_0000112>
        <obo:IAO_0000115>A genome-wide association case–control sample of unrelated Australians of European descent, one from each family, drawn from the twins and their relatives studied at the Queensland Institute of Medical Research (QIMR) who were genotyped genome-wide: migraine cases, identified in semi-structured telephone interviews based on the International Classification of Headache Disorders (ICHD-II) or by self-report and chosen preferentially for severity, and population controls from families with no known migraine. It is one of the studies of the International Headache Genetics Consortium.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2825</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3525</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6350</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ATM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Australia ATM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Australian Twin Migraine GWA Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Australian Twin Migraine GWA study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Australian Twin Migraine</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13595">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005277"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001501"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13595"/>
        <obo:IAO_0000116>migraine</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3947136/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Australian Twin Migraine GWA study (N = 6350) included 2825 migraine cases and 3525 controls, 805 of whom met the diagnostic criteria for MDD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001501"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23793025</owl:annotatedTarget>
        <dcterms:title>Genome-wide meta-analysis identifies new susceptibility loci for migraine.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23793025</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2676/MediaObjects/41588_2013_BFng2676_MOESM11_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Australian Twin Migraine (ATM) GWA study includes data from Australian twins and their families.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001501"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genome-wide association case–control sample of unrelated Australians of European descent, one from each family, drawn from the twins and their relatives studied at the Queensland Institute of Medical Research (QIMR) who were genotyped genome-wide: migraine cases, identified in semi-structured telephone interviews based on the International Classification of Headache Disorders (ICHD-II) or by self-report and chosen preferentially for severity, and population controls from families with no known migraine. It is one of the studies of the International Headache Genetics Consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24081561</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2676/MediaObjects/41588_2013_BFng2676_MOESM11_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001501"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2825</owl:annotatedTarget>
        <obo:IAO_0000116>migraine cases and controls in the GWA sample (2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24081561+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Australian Twin Migraine GWA study (N = 6,350) included 2,825 migraine cases and 3,525 controls, 805 of whom met the diagnostic criteria for MDD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001501"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3525</owl:annotatedTarget>
        <obo:IAO_0000116>migraine cases and controls in the GWA sample (2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24081561+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Australian Twin Migraine GWA study (N = 6,350) included 2,825 migraine cases and 3,525 controls, 805 of whom met the diagnostic criteria for MDD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001501"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6350</owl:annotatedTarget>
        <obo:IAO_0000116>migraine cases and controls in the GWA sample (2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24081561+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Australian Twin Migraine GWA study (N = 6,350) included 2,825 migraine cases and 3,525 controls, 805 of whom met the diagnostic criteria for MDD.</rdfs:comment>
    </owl:Axiom>
