    <!-- http://www.ebi.ac.uk/coho/COHO_0002108 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002108">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000841"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. NAG/IRPG is the Australian Nicotine Addiction Genetics families with genome-wide genotypes from the Interactive Research Project Grants (PMID:22833196), one of the three coordinated studies of the Australian Alcohol and Nicotine Studies. Replaced by COHO:0000841 (Australian Alcohol and Nicotine Studies), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Nicotine Addiction Genetics study / Interactive Research Project Grants</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002109 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002109">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000781"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. The Nagoya Study of the Asia Breast Cancer Consortium GWAS is the Hospital-based Epidemiologic Research Program at Aichi Cancer Center, HERPACC-II (PMID:25038754). Replaced by COHO:0000781 (Hospital-based Epidemiologic Research Program at Aichi Cancer Center), which now carries this term&apos;s names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Nagoya Study</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002110 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002110">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18349"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <obo:IAO_0000112>PGS004239</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:42619341</obo:IAO_0000112>
        <obo:IAO_0000115>A national registry and biobank of patients with primary adrenal insufficiency (Addison&apos;s disease) in Norway, established in 1996 within the National Registry of Organ-Specific Autoimmune Diseases (ROAS) at Haukeland University Hospital, Bergen, that collects clinical information, demographics and serial biological samples from most Norwegian patients with the disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1040</coho:numberOfParticipants>
