    <!-- http://www.ebi.ac.uk/coho/COHO_0000725 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000725">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid6527"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90435154</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre prospective observational cohort of patients with inflammatory bowel disease recruited at seven academic medical centres in the United States, collecting longitudinal clinical and phenotypic data and biosamples for clinical outcomes and translational research.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym SHARE also denotes WHI SNP Health Association Resource (COHO:0000604), SNP Health Association Asthma Resource Project (COHO:0002374) and Survey of Health, Ageing and Retirement in Europe (COHO:0002644); this term is Sinai-Helmsley Alliance for Research Excellence.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5906</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SHARE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SHARE cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SHARE-IBD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sinai Helmsley Alliance for Research Excellence</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sinai Helmsley Alliance for Research Excellence Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Sinai-Helmsley Alliance for Research Excellence</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid6527">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005265"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000725"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid6527"/>
        <obo:IAO_0000116>inflammatory bowel disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7380550/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SHARE cohort is a national collaboration of 7 academic medical centers that collected longitudinal clinical and phenotypic data on patients with inflammatory bowel disease (IBD).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000725"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7380550/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As described previously, SHARE is a multicenter prospective cohort study.12–14 Patients were recruited from 7 academic centers in the United States (US):</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000725"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90435154</owl:annotatedTarget>
        <dcterms:title>Comprehensive Association Analyses of Extraintestinal Manifestations in Inflammatory Bowel Disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38490347</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38490347+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We assembled the largest multicohort data set to date to investigate the clinical, serologic, and genetic factors associated with EIM complications in IBD.MethodsData were available in 12,083 unrelated European ancestry IBD cases with presence or absence of EIMs (eg, ankylosing spondylitis [ankylosing spondylitis and sacroiliitis], primary sclerosing cholangitis [PSC], peripheral arthritis, and skin and ocular manifestations) across 4 cohorts (Cedars-Sinai Medical Center, National Institute for Diabetes and Digestive and Kidney Diseases IBD Genetics Consortium, Sinai Helmsley Alliance for Research Excellence Consortium, and Risk Stratification and Identification of Immunogenetic and Microbial Markers of Rapid Disease Progression in Children with Crohn&apos;s Disease cohort).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000725"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre prospective observational cohort of patients with inflammatory bowel disease recruited at seven academic medical centres in the United States, collecting longitudinal clinical and phenotypic data and biosamples for clinical outcomes and translational research.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32744536</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000725"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5906</owl:annotatedTarget>
        <obo:IAO_0000116>patients with IBD in the SHARE cohort data, 2012-2018</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7380550/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Among 5,906 total patients with IBD, 468 (7.9%) reported a history of a colectomy with an IPAA as a treatment for UC.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000725"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SHARE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000725"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SHARE-IBD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


