    <!-- http://www.ebi.ac.uk/coho/COHO_0000095 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000095">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>GCST002770</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:27030319</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of men and women aged 55–85 residing in Newcastle, New South Wales, Australia, followed longitudinally with questionnaires, clinical assessments, biological samples and linked health records to investigate health and ageing.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym HCS also denotes Hertfordshire Cohort Study (COHO:0001855); this term is Hunter Community Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3253</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hunter Community Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000095"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4814826/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Over 7,500 people were randomly selected from the compulsory electoral roll of Newcastle, Australia, and invited to participate in the Hunter Community Study (HCS)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000095"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST002770</owl:annotatedTarget>
        <dcterms:title>Genetics of hand grip strength in mid to late life.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25637336</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:25637336%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>GS was measured using handheld dynamometry in community-dwelling men and women aged 55-85 from the Hunter Community Study (HCS, N = 2088) and the Sydney Memory and Ageing Study (Sydney MAS, N = 541).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000095"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27030319</owl:annotatedTarget>
        <dcterms:title>Genome-wide significant results identified for plasma apolipoprotein H levels in middle-aged and older adults.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27030319</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/articles/PMC4814826</oboInOwl:hasDbXref>
        <rdfs:comment>The results were replicated in an independent cohort, the Hunter Community Study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000095"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of men and women aged 55–85 residing in Newcastle, New South Wales, Australia, followed longitudinally with questionnaires, clinical assessments, biological samples and linked health records to investigate health and ageing.</owl:annotatedTarget>
        <obo:IAO_0000119>https://researchdata.edu.au/health-ageing-hunter-nsw-australia/11563</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>GPT-6 (OpenAI Codex), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000095"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3253</owl:annotatedTarget>
        <obo:IAO_0000116>men and women aged 55-85 recruited in the first phase</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://researchdata.edu.au/health-ageing-hunter-nsw-australia/11563</oboInOwl:hasDbXref>
        <rdfs:comment>The first phase of this study sampled 3253 people representing a response rate of 44.5%.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000095"/>
