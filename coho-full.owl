    <!-- http://www.ebi.ac.uk/coho/COHO_0002473 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002473">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21012"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>PGS005096</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:39483246</obo:IAO_0000112>
        <obo:IAO_0000115>A study of atherosclerosis at Tampere University Hospital, Finland, that collected arterial tissue from patients undergoing open vascular surgery (carotid or femoral endarterectomy, or aortic bypass, for occlusive atherosclerosis), with internal thoracic artery samples from coronary bypass patients as controls, and, in a second arm collected in 2008, whole blood and monocyte samples from patients with angiographically verified coronary artery disease and angiographically normal controls drawn from the patients given an exercise test at the hospital, for gene-expression and genetic studies.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>TVS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Tampere Vascular Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21012">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005311"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002473"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21012"/>
        <obo:IAO_0000116>atherosclerosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5270243/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The atherosclerotic vascular samples used in this study were obtained from patients subjected to carotid (N = 29) and femoral (N = 24) endarterectomy or an abdominal aortic bypass (N = 15) procedure (i.e., aortobifemoral bypass) due to occlusive atherosclerosis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002473"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3324479/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The samples were taken from patients subjected to open vascular surgical procedures at the Division of Vascular Surgery, Tampere University Hospital.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002473"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005096</owl:annotatedTarget>
        <dcterms:title>Genetic risk score for coronary artery calcification and its predictive ability for coronary artery disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39483246</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002473"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39483246</owl:annotatedTarget>
        <dcterms:title>Genetic risk score for coronary artery calcification and its predictive ability for coronary artery disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39483246</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11525111/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We investigated the association of CAC GRSs with CAD and coronary calcification among the participants in the Ludwigshafen Risk and Cardiovascular Health study (LURIC) (n = 2742), the Tampere Vascular Study (TVS) (n = 133), and the Tampere Sudden Death Study (TSDS) (n = 660) using summary data from the largest multi-ancestry GWAS meta-analysis of CAC to date.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002473"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study of atherosclerosis at Tampere University Hospital, Finland, that collected arterial tissue from patients undergoing open vascular surgery (carotid or femoral endarterectomy, or aortic bypass, for occlusive atherosclerosis), with internal thoracic artery samples from coronary bypass patients as controls, and, in a second arm collected in 2008, whole blood and monocyte samples from patients with angiographically verified coronary artery disease and angiographically normal controls drawn from the patients given an exercise test at the hospital, for gene-expression and genetic studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22509262</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28128285</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6180013/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
