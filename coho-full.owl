    <!-- http://www.ebi.ac.uk/coho/COHO_0001204 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001204">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10943"/>
        <rdf:type rdf:nodeID="genid10945"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90841377</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based cohort of residents of Olmsted County, Minnesota, United States, randomly sampled with age and sex stratification from the population enumerated by the Rochester Epidemiology Project medical records-linkage system: people aged 70–89 from 2004, extended in 2012 to ages 50–69 and later to younger adults. Participants have in-person clinical, neurological and neuropsychological evaluations with a consensus diagnosis of normal cognition, mild cognitive impairment or dementia, repeated about every 15 months together with neuroimaging and biomarkers, to study the prevalence, incidence, risk factors and biomarkers of mild cognitive impairment and dementia.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6909</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MCSA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Mayo Clinic Study of Aging</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10943">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001627"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid10945">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002039"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001204"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10943"/>
        <obo:IAO_0000116>dementia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18259084+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The objective of this study was to establish a prospective population-based cohort to investigate the prevalence, incidence and risk factors for mild cognitive impairment (MCI) and dementia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001204"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10945"/>
        <obo:IAO_0000116>mild cognitive impairment</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18259084+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The objective of this study was to establish a prospective population-based cohort to investigate the prevalence, incidence and risk factors for mild cognitive impairment (MCI) and dementia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001204"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12362905/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The MCSA cohort is a population-based sample of Olmsted County, Minnesota for studying various aspects of aging.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001204"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90841377</owl:annotatedTarget>
        <dcterms:title>Large multi-ethnic genetic analyses of amyloid imaging identify new genes for Alzheimer disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37101235</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10134547/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>These cohorts included Memento [24], Mayo Clinic Study of Aging (MCSA) [25], Wisconsin Registry for Alzheimer&apos;s Prevention (WRAP) [26], Berkeley Aging Cohort study (BACS) [27], Korean study [28], and MISSION-AD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001204"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of residents of Olmsted County, Minnesota, United States, randomly sampled with age and sex stratification from the population enumerated by the Rochester Epidemiology Project medical records-linkage system: people aged 70–89 from 2004, extended in 2012 to ages 50–69 and later to younger adults. Participants have in-person clinical, neurological and neuropsychological evaluations with a consensus diagnosis of normal cognition, mild cognitive impairment or dementia, repeated about every 15 months together with neuroimaging and biomarkers, to study the prevalence, incidence, risk factors and biomarkers of mild cognitive impairment and dementia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18259084</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40830522</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41001249</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42690834</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001204"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6909</owl:annotatedTarget>
        <obo:IAO_0000116>MCSA participants (all enrolment waves), as given in a 2026 analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42690834+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We analyzed data from 924 participants with incident dementia from the Mayo Clinic Study of Aging (N = 6909), a cohort with clinical follow-up visits every 15 months.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001204"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MCSA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


