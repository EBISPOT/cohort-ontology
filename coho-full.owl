        <oboInOwl:hasRelatedSynonym>LoDo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LoDo Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
