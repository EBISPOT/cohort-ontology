        <rdfs:comment>Three studies(OOS, KCOS and COS) were originally designed to identify potential genes underlying osteoporosis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001627"/>
