    <!-- http://www.ebi.ac.uk/coho/COHO_0000781 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000781">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid7079"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001482"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000782"/>
        <obo:IAO_0000112>GCST90319889</obo:IAO_0000112>
        <obo:IAO_0000112>PGS000004</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based epidemiologic research programme run since 1988 at Aichi Cancer Center in Nagoya, Japan, whose participants are first-visit outpatients of Aichi Cancer Center Hospital (including the HERPACC-2, 2001–2005, and HERPACC-3, 2005–2013, phases), used for case-control studies of cancer such as oesophageal cancer and for genome-wide studies within the Japanese Consortium of Genetic Epidemiology Studies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22727</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HERPACC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HERPACC Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nagoya</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nagoya Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Hospital-based Epidemiologic Research Program at Aichi Cancer Center</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid7079">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004992"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000781"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7079"/>
        <obo:IAO_0000116>cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10816704/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We therefore performed a meta-analysis of two independent esophageal cancer case-control studies conducted within the HERPACC Study (692 cases and 995 controls) and the BBJ Study (416 cases and 86,515 controls).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000781"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10816704/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 175,672 individuals were included in this GWAS meta-analysis of six Japanese cohorts, namely, the Hospital-based Epidemiologic Research Program at Aichi Cancer Center (HERPACC) Study (n = 4958)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000781"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90319889</owl:annotatedTarget>
        <dcterms:title>Genetic architecture of alcohol consumption identified by a genotype-stratified GWAS and impact on esophageal cancer risk in Japanese people.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38277453</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10816704/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 175,672 individuals were included in this GWAS meta-analysis of six Japanese cohorts, namely, the Hospital-based Epidemiologic Research Program at Aichi Cancer Center (HERPACC) Study (n = 4958)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000781"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000004</owl:annotatedTarget>
        <dcterms:title>Breast Cancer Polygenic Risk Score and Contralateral Breast Cancer Risk.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33022221</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000781"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based epidemiologic research programme run since 1988 at Aichi Cancer Center in Nagoya, Japan, whose participants are first-visit outpatients of Aichi Cancer Center Hospital (including the HERPACC-2, 2001–2005, and HERPACC-3, 2005–2013, phases), used for case-control studies of cancer such as oesophageal cancer and for genome-wide studies within the Japanese Consortium of Genetic Epidemiology Studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15942624</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34897183</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38277453</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000781"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">22727</owl:annotatedTarget>
        <obo:IAO_0000116>first-visit outpatients enrolled in the HERPACC-2 phase (2001-2005) only</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5142363/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Among the participants, 22 727 (97.1%) completed the questionnaire satisfactorily and were enrolled in HERPACC.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000781"/>
