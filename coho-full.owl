        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000104"/>
        <obo:IAO_0000112>PMID:24123842</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of individuals and multiplex families with schizophrenia and/or bipolar disorder, with psychiatrically screened controls, sampled from the founder population of the Azores and Madeira archipelagos of Portugal through all the islands&apos; psychiatric and general hospitals, taking families only if the proband&apos;s parents and four grandparents were native to the islands, with further families from mainland Portugal identified through the University of Coimbra and participants from the first- and second-generation Portuguese immigrant population of the United States; it was used in linkage and association studies of psychosis and became part of the Genomic Psychiatry Cohort.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">347</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">216</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>PIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Portuguese island collection</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Portuguese Island Collection</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19332">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004985"/>
    </owl:Restriction>
