        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>GCST007858</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33742194</obo:IAO_0000112>
        <obo:IAO_0000115>A four-year randomised controlled trial of resistance and aerobic exercise and dietary interventions in a population-based random sample of men and women aged 55-74 years living in Kuopio, Finland, drawn from the national population registry, of whom 1,479 attended baseline examinations in 2005-2006, to study the health effects of regular physical exercise and a healthy diet in middle-aged and older people.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1410</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>DR&apos;s EXTRA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DR&apos;s EXTRA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DRS EXTRA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DRS_EXTRA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Dose-Responses to Exercise Training study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Dose-Responses to Exercise Training</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid4338">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000002"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid4340">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000021"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000493"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4338"/>
        <obo:IAO_0000116>regular physical exercise</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Dose-Responses to Exercise Training (DR&apos;s EXTRA) study is a 4-y RCT on the health effects of regular physical exercise and a healthy diet in a population-based random sample of Finnish men and women aged 55–74 y living in the city of Kuopio in 2002 (see Supplemental Figure 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000493"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4340"/>
        <obo:IAO_0000116>healthy diet</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Dose-Responses to Exercise Training (DR&apos;s EXTRA) study is a 4-y RCT on the health effects of regular physical exercise and a healthy diet in a population-based random sample of Finnish men and women aged 55–74 y living in the city of Kuopio in 2002 (see Supplemental Figure 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000493"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:26104270%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>in a population-based random sample (n 1140 women and men, age 57-78 years) as secondary analyses of the Finnish Dose-Responses to Exercise Training study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000493"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST007858</owl:annotatedTarget>
        <dcterms:title>Identification and functional characterization of G6PC2 coding variants influencing glycemic traits define an effector transcript at the G6PC2-ABCB11 locus.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25625282</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4307976/</oboInOwl:hasDbXref>
        <rdfs:comment>We used a subset of Finnish samples (FIN-D2D 2007, DPS, DR’s EXTRA, FINRISK 2007, and METSIM; n = 10,266) to calculate variance explained by G6PC2.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000493"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33742194</owl:annotatedTarget>
        <dcterms:title>Exercise, diet, and cognition in a 4-year randomized controlled trial: Dose-Responses to Exercise Training (DR&apos;s EXTRA).</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33742194</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:33742194%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>Dose-Responses to Exercise Training (DR&apos;s EXTRA)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000493"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A four-year randomised controlled trial of resistance and aerobic exercise and dietary interventions in a population-based random sample of men and women aged 55-74 years living in Kuopio, Finland, drawn from the national population registry, of whom 1,479 attended baseline examinations in 2005-2006, to study the health effects of regular physical exercise and a healthy diet in middle-aged and older people.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000493"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1410</owl:annotatedTarget>
        <obo:IAO_0000116>individuals randomised to the six study groups (2006)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>After these exclusions, 1410 individuals aged 57–78 y at baseline in 2005–2006 were randomly assigned to the resistance exercise, aerobic exercise, diet, combined resistance exercise and diet, combined aerobic exercise and diet, or control group.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000493"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DR&apos;s EXTRA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
