    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001362"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A breast cancer case-control study in Stockholm, Sweden, whose cases are consecutive breast cancer patients treated at the oncology departments of Huddinge and Söder hospitals from 1998 to 2000 and women with familial breast cancer without BRCA1 or BRCA2 mutations seen at the Department of Clinical Genetics of Karolinska University Hospital from 2000, and whose controls are blood donors from the same region, used to study inherited susceptibility to breast cancer.</owl:annotatedTarget>
