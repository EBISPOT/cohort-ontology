        <obo:IAO_0000112>GCST90245988</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based longitudinal cohort of 3,298 stroke-free, predominantly Hispanic, Black and White adults aged 40 or older living in northern Manhattan, New York City, recruited by random-digit dialling in 1993–2001 and followed for stroke, vascular risk factors, brain MRI markers and cognitive outcomes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3298</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NOMAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Northern Manhattan Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid6056">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005098"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000670"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid6056"/>
        <obo:IAO_0000116>stroke</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11757223/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>NOMAS is a racially/ethnically diverse prospective cohort with 3298 stroke-free participants enrolled between 1993 and 2001.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000670"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11757223/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This hypothesis was explored in a population-based cohort study, the Northern Manhattan Study (NOMAS), a multiethnic urban sample of individuals living in New York City.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000670"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90245988</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of executive function in a multi-ethnic cohort implicates LINC01362: Results from the northern Manhattan study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36658081</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36658081+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a GWAS on a composite measure of executive function that included measures of mental flexibility and reasoning using data from the Northern Manhattan Study, a racially and ethnically diverse cohort (N = 1077, 69% Hispanic, 17% non-Hispanic Black and 14% non-Hispanic White).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000670"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based longitudinal cohort of 3,298 stroke-free, predominantly Hispanic, Black and White adults aged 40 or older living in northern Manhattan, New York City, recruited by random-digit dialling in 1993–2001 and followed for stroke, vascular risk factors, brain MRI markers and cognitive outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13482911/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000670"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3298</owl:annotatedTarget>
        <obo:IAO_0000116>stroke-free adults enrolled 1993-2001</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13482911/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>NOMAS is a community‐based longitudinal cohort study of 3298 urban‐dwelling adults 40 years of age or older with a household telephone at the baseline visit.</rdfs:comment>
    </owl:Axiom>
