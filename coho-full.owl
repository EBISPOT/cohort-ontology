    <!-- http://www.ebi.ac.uk/coho/COHO_0002493 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002493">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21128"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:21294771</obo:IAO_0000112>
        <obo:IAO_0000115>A study of patients with type 2 diabetes in general practices in Birmingham and Coventry, United Kingdom, carried out in 2004-2007, made up of a community-based cluster randomised controlled trial of a culturally sensitive enhanced care package for patients of south Asian origin and a parallel cohort study of cardiovascular risk factors in south Asian and white European patients; its south Asian participants have also contributed to genetic association studies of type 2 diabetes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1978</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>U.K. Asian Diabetes study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK Asian Diabetes Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UKADS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">United Kingdom Asian Diabetes Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21128">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002493"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21128"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4060842/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The EuroQol EQ-5D measure was administered to 1,978 patients with type 2 diabetes in the UK Asian Diabetes Study (UKADS): 1,486 of south Asian origin (Indian, Pakistani, Bangladeshi or other south Asian) and 492 of white European origin.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002493"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4060842/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This research used data collected by the UK Asian Diabetes Study (UKADS), which comprised of a community-based, cluster randomized controlled trial that evaluated the effectiveness of a culturally sensitive enhanced care package in UK general practice in improving cardiovascular risk factors in south Asian patients with type 2 diabetes, plus a parallel cohort study of cardiovascular risk factors in south Asian and white European patients with type 2 diabetes[3].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002493"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21294771</owl:annotatedTarget>
        <dcterms:title>An FTO variant is associated with Type 2 diabetes in South Asian populations after accounting for body mass index and waist circumference.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21294771</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21294771+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We analysed rs9939609 in two studies of Pakistani individuals: 1666 adults aged ≥40 years from the Karachi population-based Control of Blood Pressure and Risk Attenuation (COBRA) study and 2745 individuals of Punjabi ancestry who were part of a Type 2 diabetes case-control study (UK Asian Diabetes Study/Diabetes Genetics in Pakistan; UKADS/DGP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002493"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study of patients with type 2 diabetes in general practices in Birmingham and Coventry, United Kingdom, carried out in 2004-2007, made up of a community-based cluster randomised controlled trial of a culturally sensitive enhanced care package for patients of south Asian origin and a parallel cohort study of cardiovascular risk factors in south Asian and white European patients; its south Asian participants have also contributed to genetic association studies of type 2 diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18502301</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21294771</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24902492</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002493"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1978</owl:annotatedTarget>
        <obo:IAO_0000116>UKADS type 2 diabetes participants in the main 2004-2007 cohort</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4060842/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The EuroQol EQ-5D measure was administered to 1,978 patients with type 2 diabetes in the UK Asian Diabetes Study (UKADS): 1,486 of south Asian origin (Indian, Pakistani, Bangladeshi or other south Asian) and 492 of white European origin.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002493"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>UKADS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


