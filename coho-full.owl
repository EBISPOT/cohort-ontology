    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000096 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000096">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid1171"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Iceland"/>
        <obo:IAO_0000112>GCST004144</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:39886913</obo:IAO_0000112>
        <obo:IAO_0000115>A registry of people diagnosed with cancer in Iceland, established in 1954 to record nationwide cancer diagnoses and support cancer research.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">ICR in study text may mean immune checkpoint receptors, not this registry.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The acronym ICR also denotes UK lung cancer GWAS from the Institute for Cancer Research (COHO:0001018); this term is Icelandic Cancer Registry.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>ICR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Icelandic Cancer Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid1171">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004992"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000096"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid1171"/>
        <obo:IAO_0000116>cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22974093+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Data from the ICR for the period 1955-2009 (41 994 cancer diagnoses) were used, applying established quantitative and semi-quantitative methods.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000096"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Iceland"/>
        <oboInOwl:hasDbXref>https://europepmc.org/abstract/MED/22974093</oboInOwl:hasDbXref>
        <rdfs:comment>The nationwide Icelandic Cancer Registry (ICR) was established in 1954</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000096"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST004144</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study yields five novel thyroid cancer risk loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28195142</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5316879/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Icelanders diagnosed with thyroid cancer were identified based on a nationwide list from the Icelandic Cancer Registry (ICR) (http://www.krabbameinsskra.is/indexen.jsp?icd=C73) that contains all Icelandic thyroid cancer patients diagnosed from 1 January 1955, to 31 December 2015.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000096"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39886913</owl:annotatedTarget>
        <dcterms:title>Lynch syndrome screening in colorectal and endometrial cancers in Iceland.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39886913</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC11811529/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>All patients diagnosed with CRC and EC according to the Icelandic Cancer Registry in 2020–2022 were included.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000096"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A registry of people diagnosed with cancer in Iceland, established in 1954 to record nationwide cancer diagnoses and support cancer research.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22974093</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>GPT-6 (OpenAI Codex), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
