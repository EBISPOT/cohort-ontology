        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001489"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001722"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001806"/>
