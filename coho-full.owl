        <obo:IAO_0000112>PGS005203</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:40691366</obo:IAO_0000112>
        <obo:IAO_0000115>A genotyped case-control sample from the sixth wave of the Tromsø Study, the population-based health study of the municipality of Tromsø in Northern Norway, in which participants who reported headache in the past year meeting modified ICHD criteria for migraine, or who reported previous or current migraine, were taken as migraine cases and the other participants genotyped as controls, first used in the International Headache Genetics Consortium&apos;s genome-wide meta-analysis of migraine.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">660</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2407</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>T-6M</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TromsoMig</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Tromso-6 Migraine</rdfs:label>
    </owl:NamedIndividual>
