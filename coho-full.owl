    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000231"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2324"/>
        <obo:IAO_0000116>conventional (clear cell) renal carcinoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001000083</oboInOwl:hasDbXref>
        <rdfs:comment>The aim of CAGEKID is to carry out comprehensive detection of DNA markers for conventional (clear cell) renal carcinoma.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000231"/>
