        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12517118/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Findings were validated using data from the United Kingdom Biobank (UKB).</rdfs:comment>
    </owl:Axiom>
