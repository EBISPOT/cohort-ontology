        <obo:IAO_0000116>dental caries</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2443132/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>An initial aim of COHRA is to determine the contributions of individual, family, and community factors to oral diseases in Appalachian children.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001440"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13052"/>
        <obo:IAO_0000116>oral diseases</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2443132/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>An initial aim of COHRA is to determine the contributions of individual, family, and community factors to oral diseases in Appalachian children.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001440"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9858612/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The first cohort of the Center for Oral Health Research in Appalachia (COHRA1) is a cross-sectional study comprising members of households living in rural West Virginia and Western Pennsylvania—a region with a high prevalence of poor oral health outcomes [4,15].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001440"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90255389</owl:annotatedTarget>
        <dcterms:title>Association of Early Childhood Caries with Bitter Taste Receptors: A Meta-Analysis of Genome-Wide Association Studies and Transcriptome-Wide Association Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36672800</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9858612/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The first cohort of the Center for Oral Health Research in Appalachia (COHRA1) is a cross-sectional study comprising members of households living in rural West Virginia and Western Pennsylvania—a region with a high prevalence of poor oral health outcomes [4,15].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001440"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional, family-based study, the first cohort of the Center for Oral Health Research in Appalachia, that from 2003 recruited households with at least one biological parent–child pair (the child aged 1–18 years), together with all other household members, mainly in rural counties of central West Virginia and western Pennsylvania, United States, and assessed them by interviews, questionnaires, oral health and microbiological examinations and DNA collection to study how individual, family and community factors contribute to oral disease in Appalachia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18522740</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26106416</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000095.v3.p1</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001440"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>COHRA1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001441 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001441">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
