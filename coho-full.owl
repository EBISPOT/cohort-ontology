        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8813"/>
        <obo:IAO_0000116>major depressive disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ars.els-cdn.com/content/image/1-s2.0-S0006322321015705-mmc1.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The clinical diagnosis of MDD, schizophrenia, schizoaffective disorder, and bipolar disorder in Janssen clinical studies were based on expert clinician interviews conducted using DSM-IV-TR criteria.</rdfs:comment>
    </owl:Axiom>
