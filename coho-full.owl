    <!-- http://www.ebi.ac.uk/coho/COHO_0002448 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002448">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20861"/>
        <rdf:type rdf:nodeID="genid20863"/>
        <rdf:type rdf:nodeID="genid20865"/>
        <rdf:type rdf:nodeID="genid20867"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS000024</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:32770166</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, multinational prospective birth cohort study, run from six clinical centres in the United States, Finland, Germany and Sweden, that screened newborns from the general population and first-degree relatives of people with type 1 diabetes for high-risk HLA genotypes, enrolled eligible children before four months of age and follows them to age 15, to identify infectious, dietary and other environmental exposures associated with islet autoimmunity and type 1 diabetes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8676</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TEDDY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Environmental Determinants of Diabetes in the Young</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Environmental Determinants of Diabetes in the Young (TEDDY) Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Environmental Determinants of Diabetes in the Young (TEDDY) study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">The Environmental Determinants of Diabetes in the Young Study</rdfs:label>
    </owl:NamedIndividual>
