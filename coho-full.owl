        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>GCST90432152</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised controlled screening trial of Viborg Hospital in which the men aged 65-74 living in the Central Denmark Region were randomised, from October 2008, either to an invitation to combined screening for abdominal aortic aneurysm, peripheral arterial disease and hypertension, with preventive treatment for those found to have disease, or to no invitation, to assess the effect of screening on all-cause mortality and its cost-effectiveness.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym VIVA also denotes Project Viva (COHO:0001254); this term is Viborg Vascular.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50156</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>VIVA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>VIVA screening trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Viborg Vascular screening trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Viborg Vascular</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10317">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005044"/>
    </owl:Restriction>
