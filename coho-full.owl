    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000134"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium of ovarian cancer studies established in 2005 that combines participant data to investigate genetic and epidemiological risk factors for ovarian cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>https://sph.umich.edu/mocog/about.html</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>GPT-6 (OpenAI Codex), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000134"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25509</owl:annotatedTarget>
        <obo:IAO_0000116>OCAC cases and controls in the 2017 histotype GWAS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5612337/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Genetic association analyses were performed using genotype data from 25,509 population-based EOC cases and 40,941 controls from OCAC and meta-analysis of these data with 19,036 BRCA1 and 12,412 BRCA2 mutation carriers from CIMBA, of whom 2,933 and 954, respectively, were affected with EOC.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
