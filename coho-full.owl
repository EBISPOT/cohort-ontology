    <!-- http://www.ebi.ac.uk/coho/COHO_0001211 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001211">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11010"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002717"/>
        <obo:IAO_0000112>PMID:19706757</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of bladder cancer in North Carolina, United States, which enrolled patients with transitional cell carcinoma of the bladder and control patients without cancer (mainly presenting with benign prostatic hypertrophy or impotence), frequency-matched on race, sex and age, at the urology clinics of Duke University Medical Center and the University of North Carolina Hospitals, to study inherited variation in carcinogen-metabolism and DNA-repair genes, smoking and bladder cancer risk.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym NCBCS also denotes Carolina Breast Cancer Study (COHO:0001210); this term is North Carolina Bladder Cancer Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">229</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">211</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>NCBCS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">North Carolina Bladder Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11010">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001187"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001211"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11010"/>
        <obo:IAO_0000116>bladder cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8320745+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Using a polymerase chain reaction (PCR)-based method, we examined the frequency of the homozygous deleted genotype (GSTM1 0/0) in 229 patients with transitional cell carcinoma of the bladder and 211 control subjects who were enrolled from the Urology Clinics at Duke University Medical Center and the University of North Carolina Hospitals.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001211"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2782435/</oboInOwl:hasDbXref>
        <rdfs:comment>NCBCS North Carolina Bladder Cancer Study 215 245 77 USA: hospital-based</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001211"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:19706757</owl:annotatedTarget>
        <dcterms:title>Polymorphisms in DNA repair genes, smoking, and bladder cancer risk: findings from the international consortium of bladder cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:19706757</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2782435/</oboInOwl:hasDbXref>
        <rdfs:comment>NCBCS North Carolina Bladder Cancer Study 215 245 77 USA: hospital-based</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001211"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of bladder cancer in North Carolina, United States, which enrolled patients with transitional cell carcinoma of the bladder and control patients without cancer (mainly presenting with benign prostatic hypertrophy or impotence), frequency-matched on race, sex and age, at the urology clinics of Duke University Medical Center and the University of North Carolina Hospitals, to study inherited variation in carcinogen-metabolism and DNA-repair genes, smoking and bladder cancer risk.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11219769</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19706757</obo:IAO_0000119>
