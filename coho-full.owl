        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1923</owl:annotatedTarget>
        <obo:IAO_0000116>severe malaria cases and cord-blood controls contributed to MalariaGEN CP1 (2006-2008)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.malariagen.net/partner_study/human-genetic-determinants-severe-malaria-kumasi-ghana/</oboInOwl:hasDbXref>
        <rdfs:comment>Malaria cases: 1923 Male: 954 (50) Female: 846 (44) Not recorded: 125 (6) &lt;1: 434 (23) 1-2: 476 (25) 2-5: 713 (37) 5-15: 296 (15) Not recorded: 4 (&lt;1) Akans (Ashanti Eastern): 1038 (54) Frafra Nankana Grushie Kusasi: 188 (10) Notherner: 186 (10) Other: 511 (27) Healthy controls: 2326</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
