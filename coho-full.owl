        <oboInOwl:hasRelatedSynonym>SBCGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Shanghai Breast Cancer Genetic Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Shanghai Breast Cancer Genetics Study</rdfs:label>
    </owl:NamedIndividual>
