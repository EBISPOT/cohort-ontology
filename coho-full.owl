        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000617"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002415"/>
        <obo:IAO_0000112>PGS002804</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:40691366</obo:IAO_0000112>
        <obo:IAO_0000115>The parents of the infants enrolled in the Special Turku Coronary Risk Factor Intervention Project (STRIP) in Turku, Finland, between 1989 and 1992, who enrolled in the trial with their children and contributed as a parent sample to genome-wide studies of blood lipids and anthropometric traits.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym STRIP also denotes Special Turku Coronary Risk Factor Intervention Project (COHO:0002415); this term is Special Turku Coronary Risk Factor Intervention Project, Parents.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1029</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>STRIP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STRIP-PARENTS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Special Turku Coronary Risk Factor Intervention Project (STRIP) parents</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Special Turku Coronary Risk Factor Intervention Project - Parents</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Special Turku Coronary Risk Factor Intervention Project – Parents</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
