    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000081"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST001506</owl:annotatedTarget>
        <dcterms:title>Common genetic determinants of intraocular pressure and primary open-angle glaucoma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22570627</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3342933/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For rs11656696 A we found a decreased glaucoma risk in the Amsterdam Glaucoma Study (AGS; OR = 0.71, 95%CI = 0.51–0.99) and the Erlangen and Tübingen study (OR = 0.82, 95%CI = 0.69–0.97), but not in RS-I and the Genetic Research in Isolated Populations (GRIP) program.</rdfs:comment>
    </owl:Axiom>
