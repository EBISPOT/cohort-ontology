        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4427906/</oboInOwl:hasDbXref>
        <rdfs:comment>In the core age group of men aged 55–69 years, excluding France, 162,388 were randomized, of whom 145 died between randomization and screening.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001705"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4427906/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The trial was initiated in 1993 in the Netherlands and in Belgium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001705"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4427906/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Recruitment was completed by the end of 2003, except in France with recruitment up to 2005.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001705"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4427906/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Five other centers (Sweden, Finland, Italy, Spain and Switzerland) joined the study between 1994 and 1998.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001705"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000742</owl:annotatedTarget>
        <dcterms:title>Additional SNPs improve risk stratification of a polygenic hazard score for prostate cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33420416</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001705"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33623038</owl:annotatedTarget>
        <dcterms:title>Polygenic hazard score is associated with prostate cancer in multi-ethnic populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33623038</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-021-21287-0/MediaObjects/41467_2021_21287_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>ERSPC (n=137) Erasmus Medical Centre Rotterdam, The Netherlands Population- based, randomized control trial</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001705"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre randomised trial of prostate-specific antigen (PSA) screening, begun in 1993 in the Netherlands and Belgium and joined by centres in Sweden, Finland, Italy, Spain, Switzerland and France, in which men aged 50 to 74 identified from population registers were randomly assigned to screening, generally every four years, or to no intervention, and followed for prostate cancer incidence and mortality.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25108889</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001705"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">162388</owl:annotatedTarget>
        <obo:IAO_0000116>ERSPC randomized core age group 55-69, excluding France</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4427906/</oboInOwl:hasDbXref>
        <rdfs:comment>In the core age group of men aged 55–69 years, excluding France, 162,388 were randomized, of whom 145 died between randomization and screening.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001705"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ERSPC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


