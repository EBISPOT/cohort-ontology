    <!-- http://www.ebi.ac.uk/coho/COHO_0002189 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002189">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <obo:IAO_0000112>PMID:35820405</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective community-based cohort on disease prevention and health promotion, run by the Community Medicine Research Center of Chang Gung Memorial Hospital in Keelung since 2013, that enrols volunteers aged 20 or over living in Keelung City and New Taipei City in northeastern Taiwan through community health outreach sessions with a health examination, questionnaires and biological sampling, and follows them up.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3387</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>A Cohort Study on Disease Prevention and Health Promotion in Northeastern Region of Taiwan</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NTCMRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Northeastern Taiwan community medicine research cohort</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Northeastern Taiwan Community Medicine Research Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002189"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9677874/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Northeastern Taiwan Community Medicine Research Cohort (NTCMRC; ClinicalTrials.gov identifier NCT04839796) was a community cohort study launched in 2012 by the Community Medicine Research Center of Chang Gung Memorial Hospital in Keelung and enrolled adult participants in Northeastern Taiwan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002189"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:35820405</owl:annotatedTarget>
        <dcterms:title>Normative Data of Mini-Mental State Examination, Montreal Cognitive Assessment, and Alzheimer&apos;s Disease Assessment Scale-Cognitive Subscale of Community-Dwelling Older Adults in Taiwan.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35820405</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9677874/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>MMSE, MoCA, and ADAS-cog were administered to 150 nondemented healthy adults aged 55–85 years during 2018–2020 as part of the Northeastern Taiwan Community Medicine Research Cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002189"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective community-based cohort on disease prevention and health promotion, run by the Community Medicine Research Center of Chang Gung Memorial Hospital in Keelung since 2013, that enrols volunteers aged 20 or over living in Keelung City and New Taipei City in northeastern Taiwan through community health outreach sessions with a health examination, questionnaires and biological sampling, and follows them up.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35460926</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35820405</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT04839796</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002189"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3387</owl:annotatedTarget>
        <obo:IAO_0000116>participants aged over 30 recruited through the cohort and enrolled in a 2022 study of alcohol consumption and metabolic abnormalities (the largest count stated; no size of the whole cohort is stated)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9317740/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In total, 3387 participants (age range: 30–103 years, mean age ± SD: 57 ± 13.5 years, 38.2% males) were enrolled.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002189"/>
