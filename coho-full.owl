        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000030"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3060072/</oboInOwl:hasDbXref>
        <rdfs:comment>University of North Carolina (CHANCE study) North Carolina - US University of North Carolina University of North Carolina Olshan HN Population-based 940 1,087</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001922"/>
