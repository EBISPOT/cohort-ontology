    <!-- http://www.ebi.ac.uk/coho/COHO_0002375 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002375">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20202"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002349"/>
        <obo:IAO_0000112>PMID:24462138</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of risk factors for a first myocardial infarction, whose study base was all Swedish citizens aged 45–70 years without a previous myocardial infarction living in Stockholm County, Sweden, in 1992–1994: cases were identified through the coronary and intensive care units of the catchment-area hospitals, hospital discharge records and death certificates, controls were drawn at random from the study base matched on age, sex and hospital catchment area, and the patients were followed for recurrent cardiovascular events and mortality.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2246</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3206</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>SHEEP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SHEEP study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stockholm Heart epidemiology Program</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Stockholm Heart Epidemiology Program</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20202">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005068"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002375"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20202"/>
        <obo:IAO_0000116>myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2465514/</oboInOwl:hasDbXref>
        <rdfs:comment>The SHEEP study is a population‐based case–control study of risk factors for incident myocardial infarction and has been described in detail elsewhere.27 The study base included all Swedish citizens aged 45–70 years, with no prior clinically diagnosed myocardial infarction event, living in Stockholm County during 1992–4.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002375"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2465514/</oboInOwl:hasDbXref>
        <rdfs:comment>All Swedish citizens born during 1922–49 and living in Stockholm County during 1992–4.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002375"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:24462138</owl:annotatedTarget>
        <dcterms:title>Association of interleukin 8 with myocardial infarction: results from the Stockholm Heart Epidemiology Program.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24462138</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24462138+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To investigate the association of IL8 serum levels with the risk of MI and the association of the IL8 (IL8) and IL8 receptors (CXCR1 and CXCR2) genetic variants with IL8 levels and MI risk in a large case control study, the Stockholm Heart Epidemiology Program.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002375"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of risk factors for a first myocardial infarction, whose study base was all Swedish citizens aged 45–70 years without a previous myocardial infarction living in Stockholm County, Sweden, in 1992–1994: cases were identified through the coronary and intensive care units of the catchment-area hospitals, hospital discharge records and death certificates, controls were drawn at random from the study base matched on age, sex and hospital catchment area, and the patients were followed for recurrent cardiovascular events and mortality.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17108306</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34551078</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
