        <obo:IAO_0000119>PMID:27694991</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29906448</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002083"/>
