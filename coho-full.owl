    <!-- http://www.ebi.ac.uk/coho/COHO_0002266 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002266">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19377"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000610"/>
        <obo:IAO_0000112>PGS000734</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:23880798</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of postmenopausal hormone use and colorectal cancer among women aged 50 to 74 in 13 counties of Washington State, United States, whose cases were newly diagnosed with invasive colorectal adenocarcinoma between October 1998 and February 2002 and identified through the SEER cancer registry, and whose controls were randomly selected from driver&apos;s licence and Medicare rosters; run as a supplementary study to the Colon Cancer Family Registry.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1004</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1062</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>Hormones and Colon Cancer study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PMH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PMH-CCFR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Postmenopausal Hormone Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Postmenopausal Hormone study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Postmenopausal Hormones Supplementary Study to the Colon Cancer Family Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19377">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005008"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002266"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19377"/>
        <obo:IAO_0000116>invasive colorectal adenocarcinoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms8138/MediaObjects/41467_2015_BFncomms8138_MOESM787_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Eligible case patients included all female residents, ages 50 to 74 years, residing in the 13 counties in Washington State reporting to the Cancer Surveillance SEER program, who were newly diagnosed with invasive colorectal adenocarcinoma (ICD-O C18.0, C18.2-.9, C19.9, C20.0-.9) between October 1998 and February 2002.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002266"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms8138/MediaObjects/41467_2015_BFncomms8138_MOESM787_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Eligible case patients included all female residents, ages 50 to 74 years, residing in the 13 counties in Washington State reporting to the Cancer Surveillance SEER program, who were newly diagnosed with invasive colorectal adenocarcinoma (ICD-O C18.0, C18.2-.9, C19.9, C20.0-.9) between October 1998 and February 2002.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002266"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000734</owl:annotatedTarget>
        <dcterms:title>Cumulative Burden of Colorectal Cancer-Associated Genetic Variants Is More Strongly Associated With Early-Onset vs Late-Onset Cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31866242</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002266"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23880798</owl:annotatedTarget>
        <dcterms:title>No association between germline variation in catechol-O-methyltransferase and colorectal cancer survival in postmenopausal women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23880798</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23880798+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We identified 10 single nucleotide polymorphisms that tagged variation across two isoforms of COMT in 2,458 women with CRC from the Nurses&apos; Health Study, Postmenopausal Hormones Supplementary Study to the Colon Cancer Family Registry, VITamins And Lifestyle Study, and Women&apos;s Health Initiative.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002266"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of postmenopausal hormone use and colorectal cancer among women aged 50 to 74 in 13 counties of Washington State, United States, whose cases were newly diagnosed with invasive colorectal adenocarcinoma between October 1998 and February 2002 and identified through the SEER cancer registry, and whose controls were randomly selected from driver&apos;s licence and Medicare rosters; run as a supplementary study to the Colon Cancer Family Registry.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23266556</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms8138/MediaObjects/41467_2015_BFncomms8138_MOESM787_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002266"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1004</owl:annotatedTarget>
        <obo:IAO_0000116>PMH cases and controls in its own 2007 report</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17671225+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Cases (n = 1,004), ages 50 to 74 years, were identified from the Surveillance Epidemiology and End Results registry in Washington from 1998 to 2002; controls (n = 1,062) were randomly selected from population lists.</rdfs:comment>
    </owl:Axiom>
