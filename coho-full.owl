        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6943778/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The NBB was established in 1985 to collect human brain tissues from donors with various neurological and psychiatric disorders and also non-diseased donors.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002115"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18376"/>
        <obo:IAO_0000116>neurological disorders</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6943778/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The NBB was established in 1985 to collect human brain tissues from donors with various neurological and psychiatric disorders and also non-diseased donors.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002115"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
