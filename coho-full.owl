        <owl:annotatedTarget>UCC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002478 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002478">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000170"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. UCC-SMART (Utrecht Cardiovascular Cohort - Second Manifestations of ARTerial disease) is the SMART cohort under its current name (PMID:37845353). Replaced by COHO:0000170 (Second Manifestations of ARTerial disease study), which now carries this term&apos;s names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
