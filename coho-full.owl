    <!-- http://www.ebi.ac.uk/coho/COHO_0001909 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001909">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. The International Hereditary Cancer Centre of the Pomeranian Medical University, Szczecin, is an institution. In every paper the PGS Catalog records the id IHCC in, it labels the centre&apos;s contribution of BRCA1 and BRCA2 carriers or cancer cases to consortium analyses such as CIMBA (PMID:29058716), with no study name of its own. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete International Hereditary Cancer Centre</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001910 -->

