    <!-- http://www.ebi.ac.uk/coho/COHO_0002190 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002190">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18834"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <obo:IAO_0000112>PMID:22158537</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of type 2 diabetes in Han Chinese adults in Taiwan, whose cases were patients with type 2 diabetes diagnosed by American Diabetes Association criteria (onset at age 35 or older) recruited from the metabolism clinics of National Taiwan University Hospital, Taipei, and whose controls were people with normal glucose tolerance on a 75-g oral glucose tolerance test recruited from routine health examinations; it was a replication study of the Asian Genetic Epidemiology Network&apos;s type 2 diabetes genome-wide meta-analysis.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3024</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NTUHDS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">National Taiwan University Hospital Diabetes Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18834">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002190"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18834"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The studied population comprised 1520 normoglycemic control subjects and 1520 type 2 diabetic patients from a Han Chinese population in Taiwan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002190"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The studied population comprised 1520 normoglycemic control subjects and 1520 type 2 diabetic patients from a Han Chinese population in Taiwan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002190"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22158537</owl:annotatedTarget>
        <dcterms:title>Meta-analysis of genome-wide association studies identifies eight new loci for type 2 diabetes in east Asians.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22158537</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3582398/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Stage 3 included up to, 12,284 cases and 13,172 controls from five different studies comprised of the Japan Cardiometabolic Genome Epidemiology Network (CAGE), the Shanghai Diabetes Study I/II (SDS I/II), the Chinese University of Hong Kong Diabetes Study (CUHKDS), the National Taiwan University Hospital Diabetes Study (NTUHDS) and the Seoul National University Hospital Diabetes Study (SNUHDS) for de novo replication analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002190"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of type 2 diabetes in Han Chinese adults in Taiwan, whose cases were patients with type 2 diabetes diagnosed by American Diabetes Association criteria (onset at age 35 or older) recruited from the metabolism clinics of National Taiwan University Hospital, Taipei, and whose controls were people with normal glucose tolerance on a 75-g oral glucose tolerance test recruited from routine health examinations; it was a replication study of the Asian Genetic Epidemiology Network&apos;s type 2 diabetes genome-wide meta-analysis.</owl:annotatedTarget>
