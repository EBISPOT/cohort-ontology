    <!-- http://www.ebi.ac.uk/coho/COHO_0002130 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002130">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
