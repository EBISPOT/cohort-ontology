        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1780</owl:annotatedTarget>
        <obo:IAO_0000116>CRC patients who agreed to take part (Aug 2010 to Sep 2020) and health check-up controls, before exclusions</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11369566/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 1,780 patients who agreed to participate in this study, 290 participants were excluded due to incomplete data from the semiquantitative food frequency questionnaire (SQFFQ) or general questionnaire, and 13 others were excluded due to implausible energy intake (&lt; 500 or &gt; 4,000 kcal/day).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001364"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18471</owl:annotatedTarget>
