        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001005836</oboInOwl:hasDbXref>
        <rdfs:comment>a prospective observational study by the German Cancer Consortium, DKTK MASTER</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001005836</oboInOwl:hasDbXref>
        <rdfs:comment>a prospective observational study by the German Cancer Consortium, DKTK MASTER</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000260"/>
