    <!-- http://www.ebi.ac.uk/coho/COHO_0001617 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001617">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14582"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001894"/>
        <obo:IAO_0000112>PMID:38859703</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of adults of European ancestry with bipolar disorder (bipolar I or II disorder, schizoaffective disorder of bipolar type or bipolar disorder not otherwise specified) recruited from across the United Kingdom by the Bipolar Disorder Research Network, an ongoing research programme run from Cardiff and Worcester, systematically through NHS community mental health teams and lithium clinics and non-systematically through media advertising and patient charities such as Bipolar UK. Participants are interviewed by trained psychologists and psychiatrists with the Schedules for Clinical Assessment in Neuropsychiatry and their case notes reviewed, to study the genetic and environmental causes of bipolar and related mood disorders.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4219</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BDRN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK Bipolar Disorder Research Network</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Bipolar Disorder Research Network</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14582">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004985"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001617"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14582"/>
        <obo:IAO_0000116>bipolar disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11408248/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Cases from the UK were obtained from the Bipolar Disorder Research Network (BDRN) study, an ongoing program of research into the genetic and environmental causes of BD and related mood disorders.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001617"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12092478/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were recruited into the research programme from across the UK using both systematic and non-systematic recruitment methods.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001617"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38859703</owl:annotatedTarget>
        <dcterms:title>Association of Occupational Dysfunction and Hospital Admissions With Different Polygenic Profiles in Bipolar Disorder.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38859703</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38859703+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Replication analyses of hospital admissions were conducted with data from the Bipolar Disorder Research Network cohort (N=4,219).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001617"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of adults of European ancestry with bipolar disorder (bipolar I or II disorder, schizoaffective disorder of bipolar type or bipolar disorder not otherwise specified) recruited from across the United Kingdom by the Bipolar Disorder Research Network, an ongoing research programme run from Cardiff and Worcester, systematically through NHS community mental health teams and lithium clinics and non-systematically through media advertising and patient charities such as Bipolar UK. Participants are interviewed by trained psychologists and psychiatrists with the Schedules for Clinical Assessment in Neuropsychiatry and their case notes reviewed, to study the genetic and environmental causes of bipolar and related mood disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34002096</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38355785</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39537796</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001617"/>
