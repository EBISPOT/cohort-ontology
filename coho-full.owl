    <!-- http://www.ebi.ac.uk/coho/COHO_0001227 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001227">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11146"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000561"/>
        <obo:IAO_0000112>GCST90446233</obo:IAO_0000112>
        <obo:IAO_0000115>A multi-site US study of African Americans, a sub-study of the Alzheimer&apos;s Disease Sequencing Project run by investigators at North Carolina Agricultural and Technical State University, Wake Forest School of Medicine, the University of Miami, Columbia University and Case Western Reserve University, that ascertains African American families affected by Alzheimer&apos;s disease through community outreach and collects blood or saliva samples, medical and family histories and cognitive assessments, to identify rare variants, genes and pathways associated with Alzheimer&apos;s disease in African Americans.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>REAAADI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Research in African American Alzheimer&apos;s Disease Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Research in African American Alzheimer Disease Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Research in African American Alzheimer Disease Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11146">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004975"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001227"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11146"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37952397+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We performed whole-genome sequencing (WGS) and multipoint linkage analyses in 51 multi-generational AA AD families ascertained through the Research in African American Alzheimer Disease Initiative (REAAADI) and the National Institute on Aging Late Onset Alzheimer&apos;s disease (NIA-LOAD) Family Based Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001227"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90446233</owl:annotatedTarget>
        <dcterms:title>Extended genome-wide association study employing the African genome resources panel identifies novel susceptibility loci for Alzheimer&apos;s disease in individuals of African ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38958117</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11350055/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Study participants for the REAAADI were ascertained as part of a family-based study of Alzheimer’s Disease through the John P. Hussman Institute for Human Genomics Outreach and Diversity Core at the University of Miami, Columbia University Alzheimer Disease Research Center, Case Western Reserve University, and Maya Angelou Center for Health Equity at Wake Forest School of Medicine.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001227"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multi-site US study of African Americans, a sub-study of the Alzheimer&apos;s Disease Sequencing Project run by investigators at North Carolina Agricultural and Technical State University, Wake Forest School of Medicine, the University of Miami, Columbia University and Case Western Reserve University, that ascertains African American families affected by Alzheimer&apos;s disease through community outreach and collects blood or saliva samples, medical and family histories and cognitive assessments, to identify rare variants, genes and pathways associated with Alzheimer&apos;s disease in African Americans.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37212603</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37952397</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38958117</obo:IAO_0000119>
