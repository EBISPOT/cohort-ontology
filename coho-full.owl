    <!-- http://www.ebi.ac.uk/coho/COHO_0000346 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000346">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid3099"/>
        <rdf:type rdf:nodeID="genid3101"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>EGAS00001000079</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of families from across the United Kingdom with at least two siblings affected by premature coronary artery disease (myocardial infarction, angina verified by exercise testing or angiography, or coronary revascularisation before the 66th birthday, each verified from hospital or general practice records), recruited from April 1998 to November 2003 with British Heart Foundation funding through the media and general practices, after a pilot phase using the coronary disease databases of the lead centres in Leeds and Leicester, to study the genetic basis of premature coronary artery disease; affected siblings, and unaffected siblings where available, were interviewed by telephone and gave blood for DNA.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6285</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BHF Family Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BHF-FHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK BHF CAD/MI cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <rdfs:label xml:lang="en">British Heart Foundation Family Heart Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid3099">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0005181"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid3101">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005068"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000346"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid3099"/>
        <obo:IAO_0000116>premature coronary artery disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16380912+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We investigated the genetic determinants of premature CAD by performing a genomewide linkage analysis of 4,175 affected subjects from 1,933 families recruited throughout the United Kingdom. Each family had at least two available siblings with CAD, with validated onset before age 66 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000346"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid3101"/>
        <obo:IAO_0000116>myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16380912+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We investigated the genetic determinants of premature CAD by performing a genomewide linkage analysis of 4,175 affected subjects from 1,933 families recruited throughout the United Kingdom. Each family had at least two available siblings with CAD, with validated onset before age 66 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000346"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS00001000079</owl:annotatedTarget>
        <dcterms:title>Cardiogenics_re_sequencing</dcterms:title>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000346"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of families from across the United Kingdom with at least two siblings affected by premature coronary artery disease (myocardial infarction, angina verified by exercise testing or angiography, or coronary revascularisation before the 66th birthday, each verified from hospital or general practice records), recruited from April 1998 to November 2003 with British Heart Foundation funding through the media and general practices, after a pilot phase using the coronary disease databases of the lead centres in Leeds and Leicester, to study the genetic basis of premature coronary artery disease; affected siblings, and unaffected siblings where available, were interviewed by telephone and gave blood for DNA.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16380912</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21966275</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22325189</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000346"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6285</owl:annotatedTarget>
        <obo:IAO_0000116>subjects collected (affected and unaffected siblings), 1998-2003</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC1285159</oboInOwl:hasDbXref>
        <rdfs:comment>In total, we collected 6,285 subjects.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000346"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
