        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000051"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid787"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10189543+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Diabetes Prevention Program is a randomized clinical trial testing strategies to prevent or delay the development of type 2 diabetes in high-risk individuals with elevated fasting plasma glucose concentrations and impaired glucose tolerance.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000051"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.niddk.nih.gov/about-niddk/research-areas/diabetes/diabetes-prevention-program-dpp</oboInOwl:hasDbXref>
        <rdfs:comment>The DPP was a randomized, controlled clinical trial conducted at 27 clinical centers around the United States from 1996 to 2001.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS00001001875</owl:annotatedTarget>
        <dcterms:title>Variation in the glucose transporter gene SLC2A2 is associated with glycemic response to metformin.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27500523</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5007158/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the DPP cohort of pre-diabetes participants, Cox proportional hazards regression was used to evaluate the genetic impact on the time to diabetes incidence</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90132306</owl:annotatedTarget>
        <dcterms:title>Genetic Architecture of Plasma Alpha-Aminoadipic Acid Reveals a Relationship With High-Density Lipoprotein Cholesterol.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35621206</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9238724/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The DPP (Diabetes Prevention Program) was a randomized clinical trial</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000051"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised trial cohort of people with impaired glucose tolerance and elevated fasting glucose recruited at 27 United States centres to compare lifestyle intervention, metformin and placebo for delaying or preventing type 2 diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10189543</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>GPT-6 (OpenAI Codex), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000051"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3234</owl:annotatedTarget>
        <obo:IAO_0000116>participants randomised</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:11832527</oboInOwl:hasDbXref>
        <rdfs:comment>We randomly assigned 3234 nondiabetic persons with elevated fasting and post-load plasma glucose concentrations to placebo, metformin (850 mg twice daily), or a lifestyle-modification program with the goals of at least a 7 percent weight loss and at least 150 minutes of physical activity per week.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000051"/>
