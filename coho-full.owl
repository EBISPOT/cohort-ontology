    <!-- http://www.ebi.ac.uk/coho/COHO_0000475 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000475">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>GCST90319314</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing nationwide prospective cohort of blood donors aged 18-70 at inclusion, recruited at Danish blood donation facilities since 2010 (all facilities in Denmark by 2015), with questionnaires, plasma samples, genotyping and linkage to national health registries for research on donor health and general public health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">138491</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>DBDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DBDS Genomic Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Danish Blood Donor Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000475"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244044/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The cohort was initiated in 2010 and by 2015 it covered all blood donation facilities in Denmark.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000475"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90319314</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study of social trust in 33,882 Danish blood donors.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38228779</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10792163/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this study, we investigate the genetic underpinnings of social trust in n = 33,882 participants of the Danish Blood Donor Study (DBDS) using a validated questionnaire.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000475"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing nationwide prospective cohort of blood donors aged 18-70 at inclusion, recruited at Danish blood donation facilities since 2010 (all facilities in Denmark by 2015), with questionnaires, plasma samples, genotyping and linkage to national health registries for research on donor health and general public health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36194120</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000475"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">138491</owl:annotatedTarget>
        <obo:IAO_0000116>participants included by February 2022</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC10244044</oboInOwl:hasDbXref>
        <rdfs:comment>As of February 2022, DBDS includes 138491 participants (51% women, age span at inclusion 18–70 years) who have completed a total of 371589 questionnaires and with 1091499 person-years of follow-up.</rdfs:comment>
    </owl:Axiom>
