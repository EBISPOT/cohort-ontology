        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001004556</oboInOwl:hasDbXref>
        <rdfs:comment>In four patients from the Polish glioma cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000318"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of Polish patients with gliomas of WHO grades II to IV whose tumours and matched blood were sequenced with a panel of cancer- and epigenetics-related genes to characterise somatic and germline variants.</owl:annotatedTarget>
        <obo:IAO_0000119>https://ega-archive.org/studies/EGAS00001004556</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000318"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">182</owl:annotatedTarget>
        <obo:IAO_0000116>glioma patients/samples analysed (analysed set, not all Polish), 2020</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.biorxiv.org/content/10.1101/2020.06.17.158477v1.full</oboInOwl:hasDbXref>
        <rdfs:comment>Most of the patients from our cohort suffered from glioblastoma (132/182).</rdfs:comment>
    </owl:Axiom>
    


