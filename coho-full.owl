    <!-- http://www.ebi.ac.uk/coho/COHO_0001328 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001328">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>GCST90244057</obo:IAO_0000112>
        <obo:IAO_0000115>A study of the genetic and environmental effects on the disablement process in older women, in which female twin pairs aged 63–76, recruited from the Older Finnish Twin Cohort, took part in laboratory examinations of physical functioning, muscle strength and power, hearing and other health measures, with blood sampling, in Jyväskylä, Finland, in 2000–2001 and again at a 3-year follow-up, and have since been followed for mortality, by researchers of the Gerontology Research Center of the University of Jyväskylä.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">434</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>FITSA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Finnish Twin Study on Aging</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001328"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Altogether 103 MZ and 114 DZ twin pairs (424 individuals, all women of European ancestry) aged 63-76 years living in Finland took part in multiple laboratory examinations in 2000 and 2003, and responded in 13 questionnaires in 2011.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001328"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244057</owl:annotatedTarget>
        <dcterms:title>Rare variant analyses across multiethnic cohorts identify novel genes for refractive error.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36596879</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Finnish Twin Study on Aging (FITSA) is a study of genetic and environmental effects on the disablement process in older female twins.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001328"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study of the genetic and environmental effects on the disablement process in older women, in which female twin pairs aged 63–76, recruited from the Older Finnish Twin Cohort, took part in laboratory examinations of physical functioning, muscle strength and power, hearing and other health measures, with blood sampling, in Jyväskylä, Finland, in 2000–2001 and again at a 3-year follow-up, and have since been followed for mortality, by researchers of the Gerontology Research Center of the University of Jyväskylä.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17452741</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18350156</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34543398</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36682031</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001328"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">434</owl:annotatedTarget>
        <obo:IAO_0000116>women (103 MZ and 114 DZ twin pairs) examined at baseline, 2000-2001</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10395559/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The final sample included 114 DZ and 103 MZ twin pairs (434 individuals) aged 63–76 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001328"/>
