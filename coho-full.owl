        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:35383826</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control cohort of people with sporadic early- or late-onset Alzheimer&apos;s disease and elderly controls screened for dementia, recruited from community and hospital settings in the United Kingdom between the early 2000s and 2020 with funding from the Medical Research Council, the Moondance Foundation and Health and Care Research Wales, and assessed with a standardised clinical and neuropsychological protocol. Its longitudinal clinical and cognitive data and blood samples support genome-wide genotyping, plasma biomarker and induced pluripotent stem cell studies of Alzheimer&apos;s disease.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1439</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">508</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1947</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AD Cardiff Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADCC</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Alzheimer&apos;s Disease Cardiff Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13290">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004975"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001470"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13290"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10362776/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Sporadic AD and control plasma samples [n = 504 control, 912 EOAD (onset &lt; 65 years), 492 LOAD (onset &gt; 65 years)] were a subset of the AD Cardiff Cohort, collected between 2004 and 2020 from individuals recruited from UK community and hospital settings using MRC, Moondance Foundation, and Health and Care Research Wales (HCRW) funding (Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001470"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
