    <!-- http://www.ebi.ac.uk/coho/COHO_0002707 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002707">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22903"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001800"/>
        <obo:IAO_0000112>PMID:29892015</obo:IAO_0000112>
        <obo:IAO_0000115>A single-centre, double-blind, randomized, placebo-controlled trial at the University Medical Center Groningen, the Netherlands, that recruited patients without diabetes undergoing primary percutaneous coronary intervention for ST-segment elevation myocardial infarction in 2011–2013, to test whether four months of metformin treatment preserved left ventricular function.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">380</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GIPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GIPS III</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GIPS study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GIPS-III</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GIPS-III trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Glycometabolic Intervention as adjunct to primary Percutaneous coronary intervention in ST elevation myocardial infarction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>glycometabolic intervention as adjunct to primary percutaneous coronary intervention in ST elevation myocardial infarction III study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Glycometabolic Intervention as adjunct to Primary percutaneous intervention in ST elevation myocardial infarction (GIPS)-III trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22903">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0041656"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002707"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22903"/>
        <obo:IAO_0000116>ST-segment elevation myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24687169+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To evaluate the effect of metformin treatment on preservation of left ventricular function in patients without diabetes presenting with ST-segment elevation myocardial infarction (STEMI).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002707"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24687169+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Double-blind, placebo-controlled study conducted among 380 patients who underwent primary percutaneous coronary intervention (PCI) for STEMI at the University Medical Center Groningen, The Netherlands, between January 1, 2011, and May 26, 2013.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002707"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29892015</owl:annotatedTarget>
        <dcterms:title>Polygenic prediction of body mass index and obesity through the life course and across ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29892015</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The GIPS study is a randomized-controlled trial (n=380; in GGAF 362) to evaluate the effect of metformin treatment on preservation of left ventricular function in patients without diabetes presenting with ST-segment elevation myocardial infarction (STEMI).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002707"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A single-centre, double-blind, randomized, placebo-controlled trial at the University Medical Center Groningen, the Netherlands, that recruited patients without diabetes undergoing primary percutaneous coronary intervention for ST-segment elevation myocardial infarction in 2011–2013, to test whether four months of metformin treatment preserved left ventricular function.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22968678</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24687169</obo:IAO_0000119>
