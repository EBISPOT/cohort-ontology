        <owl:annotatedTarget>EAPEH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001676 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001676">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001677"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. EAS, the PGS Catalog cohort id used for the type 2 diabetes score PGS000020 (Läll et al. 2016), is the DIAGRAM consortium’s EAS, which its 2012 meta-analysis (PMID:22885922) describes as funded by the British Heart Foundation (RG/98002) and genotyped in Edinburgh, the funding of the Edinburgh Artery Study (PMC5841831: EAS (Edinburgh Artery Study). EAS is funded by the British Heart Foundation (Programme Grant RG/98002)); the Catalog also lists the study under its own name as EAS-Edinburgh. Replaced by COHO:0001677, Edinburgh Artery Study, which carries the acronym EAS. Found by the review of 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete EAS</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


