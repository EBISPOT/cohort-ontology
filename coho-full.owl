    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001157"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10529"/>
        <obo:IAO_0000116>cystic fibrosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC11480786/</oboInOwl:hasDbXref>
        <rdfs:comment>The Cystic Fibrosis Genome Project (CFGP) is comprised of individuals with CF recruited by the CF Twin and Sibling Study (TSS)15 and Cystic Fibrosis-Related Diabetes (CFRD) Study16 (Johns Hopkins University)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001157"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10531"/>
        <obo:IAO_0000116>cystic fibrosis-related diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC11480786/</oboInOwl:hasDbXref>
        <rdfs:comment>The Cystic Fibrosis Genome Project (CFGP) is comprised of individuals with CF recruited by the CF Twin and Sibling Study (TSS)15 and Cystic Fibrosis-Related Diabetes (CFRD) Study16 (Johns Hopkins University)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001157"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90558259</owl:annotatedTarget>
        <dcterms:title>Genetic modifiers of body mass index in individuals with cystic fibrosis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39260370</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC11480786/</oboInOwl:hasDbXref>
        <rdfs:comment>The Cystic Fibrosis Genome Project (CFGP) is comprised of individuals with CF recruited by the CF Twin and Sibling Study (TSS)15 and Cystic Fibrosis-Related Diabetes (CFRD) Study16 (Johns Hopkins University), Genetic Modifier Study (GMS)17,18,19 and GMS of Severe CF Liver Disease (GMS CFLD)20,21 (University of North Carolina), and Early Pseudomonas Infection Control Observational (EPIC Obs) Study22 (University of Washington and Seattle Children’s Hospital).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001157"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Johns Hopkins University study that enrolled people with cystic fibrosis both with and without cystic fibrosis-related diabetes; its participants are among those whose genomes were sequenced by the Cystic Fibrosis Genome Project.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35647563</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36206743</obo:IAO_0000119>
