    <!-- http://www.ebi.ac.uk/coho/COHO_0001139 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001139">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90454200</obo:IAO_0000112>
        <obo:IAO_0000115>A normative craniofacial study begun in 2009 as part of the FaceBase Consortium of the US National Institute of Dental and Craniofacial Research, which recruited healthy people aged 3 to 40 of self-reported European ancestry and without craniofacial conditions at four US sites (Pittsburgh, Seattle, Houston and Iowa City), collecting 3D facial surface images, anthropometric measurements, a demographic questionnaire and saliva DNA for genome-wide genotyping, and shares the data through a web-based repository.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2454</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>3D Facial Norms</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3D Facial Norms Database</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3D Facial Norms Dataset</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3D Facial Norms Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3D Facial Norms dataset</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3DFN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PITT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pittsburgh 3D Facial Norms</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pittsburgh 3D Facial Norms study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pittsburgh 3DFN cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">3D Facial Norms cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001139"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4841054/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were recruited at four US sites: Pittsburgh, Seattle, Houston, and Iowa City.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001139"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90454200</owl:annotatedTarget>
        <dcterms:title>Syndrome-informed phenotyping identifies a polygenic background for achondroplasia-like facial variation in the general population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39622794</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11612227/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The US control dataset (n = 4680) was collected previously and included samples from the 3D Facial Norms cohort and studies at the Pennsylvania State University and Indiana University-Purdue University Indianapolis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001139"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A normative craniofacial study begun in 2009 as part of the FaceBase Consortium of the US National Institute of Dental and Craniofacial Research, which recruited healthy people aged 3 to 40 of self-reported European ancestry and without craniofacial conditions at four US sites (Pittsburgh, Seattle, Houston and Iowa City), collecting 3D facial surface images, anthropometric measurements, a demographic questionnaire and saliva DNA for genome-wide genotyping, and shares the data through a web-based repository.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26492185</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27110347</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001139"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2454</owl:annotatedTarget>
        <obo:IAO_0000116>participants in the 3DFN database (952 males, 1502 females), 2016</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4841760/</oboInOwl:hasDbXref>
        <rdfs:comment>The 3DFN database currently consists of 2454 male and female participants ranging in age from 3–40 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001139"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
