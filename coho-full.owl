    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001237"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25313</owl:annotatedTarget>
        <obo:IAO_0000116>twins born 1959-1985 who responded to the 2005-2006 web survey</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10918580/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Namely, we used the Study of Twin Adults: Genes and Environment (STAGE) comprising 25 313 twins (born 1959-1985) surveyed 2005 to 2006</rdfs:comment>
    </owl:Axiom>
