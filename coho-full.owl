    <!-- http://www.ebi.ac.uk/coho/COHO_0002009 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002009">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17620"/>
        <rdf:type rdf:nodeID="genid17622"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000560"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000800"/>
        <obo:IAO_0000112>PGS000740</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:22899653</obo:IAO_0000112>
        <obo:IAO_0000115>A molecular epidemiological study of lung cancer in a defined area of Merseyside, England, with a high incidence of lung cancer, made up of a case-control study of newly diagnosed lung cancer cases matched 2:1 on age and sex, and a prospective cohort followed for ten years, to build a lung cancer risk model from epidemiological and molecular genetic risk factors and to find markers of preclinical carcinogenesis for early detection.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11500</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>LLP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Liverpool Lung Cancer Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Liverpool lung cancer study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Liverpool Lung Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17620">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ExO_0000002"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid17622">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002009"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17620"/>
        <obo:IAO_0000116>environmental exposures</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12212983+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>1) to prepare a molecular genetic and epidemiological risk assessment model based on environmental exposures and genetic predisposition</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002009"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17622"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4356386/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the LLP is a population-based case control and cohort study of the early detection of lung cancer in Liverpool, United Kingdom.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002009"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC4715236</oboInOwl:hasDbXref>
        <rdfs:comment>LLP Hospital-based UK</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000740</owl:annotatedTarget>
        <dcterms:title>Assessing Lung Cancer Absolute Risk Trajectory Based on a Polygenic Risk Model.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33472890</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22899653</owl:annotatedTarget>
        <dcterms:title>Influence of common genetic variation on lung cancer risk: meta-analysis of 14 900 cases and 29 485 controls.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22899653</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3607485/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The meta-analysis was based on summary data from 16 previously reported lung cancer GWASs undertaken by nine analytical centers providing genotype data on 14 900 lung cancer cases and 29 485 controls of European descent: the MD Anderson Cancer Center lung cancer study (5); cases from the Liverpool Lung Project and control individuals from the UK Blood Service collections (UKBS) (4,67); the UK lung cancer GWAS from the Institute for Cancer Research including lung cancer cases from the Genetic Lung Cancer Predisposition Study (GELCAPS) and controls from the 1958 Birth Cohort (7,68,69); the deCODE Genetics lung cancer study (9); the Helmholtz-Gemeinschaft Deutscher Forschungszentren (HGF) lung</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002009"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A molecular epidemiological study of lung cancer in a defined area of Merseyside, England, with a high incidence of lung cancer, made up of a case-control study of newly diagnosed lung cancer cases matched 2:1 on age and sex, and a prospective cohort followed for ten years, to build a lung cancer risk model from epidemiological and molecular genetic risk factors and to find markers of preclinical carcinogenesis for early detection.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:12212983</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:16273220</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002009"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11500</owl:annotatedTarget>
        <obo:IAO_0000116>individuals recruited to the case-control and cohort studies since 1996 (stated as &apos;over 11,500&apos;, a lower bound)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Liverpool Lung Project (LLP) is a case-control and cohort study which has recruited over 11,500 individuals since 1996 from the Liverpool region in the UK.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002009"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LLP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


