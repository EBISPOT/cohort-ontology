        <rdfs:comment>In total, 4,255 control persons with no diabetes and 3,320 patients with diabetes, hereof 2,721 T2D patients and 599 T1D patients, were included from March 1, 2007 to May 1, 2010.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002542"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
