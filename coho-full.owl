    <!-- http://www.ebi.ac.uk/coho/COHO_0002470 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002470">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. Trinity is the PGS Catalog&apos;s id for &apos;Trinity College Dublin&apos;, a university. The Catalog lists the id in its cohort table but attaches it to no score or sample set, so there is no sample for it to denote, and nothing found by name is a study sample. It is an institution name, not a cohort. Samples from Trinity College Dublin that do have names are already covered elsewhere: the Trinity Student Study (COHO:0000627, which has its own PGS id TSS), the TCD/NUIG imaging sample (review row NUIG-TCD, judged not a cohort) and the MRC Genetic Resource for Alzheimer&apos;s disease site at Trinity College Dublin used by GERAD (COHO:0000646). None of these can be tied to the id Trinity, so it should not become a synonym of any of them. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Trinity College Dublin</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002471 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002471">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>PGS005096</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:39483246</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of medico-legal autopsies performed at the Department of Forensic Medicine of the University of Tampere, Finland, on unselected individuals from Tampere and the surrounding regions who died out of hospital from any cause, used to study coronary atherosclerosis, brain pathology such as Lewy-related pathology, and other post-mortem tissue, with risk-factor data gathered by interviewing relatives of the deceased.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">660</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TSDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Tampere Sudden Death Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002471"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11713395/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed immunohistochemical staining with the 5G4 antibody against alpha‐synuclein on brain tissue samples from the Tampere Sudden Death Study – a collection of forensic autopsies on individuals that lived outside hospital institutions in Tampere and the surrounding regions, Finland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002471"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005096</owl:annotatedTarget>
        <dcterms:title>Genetic risk score for coronary artery calcification and its predictive ability for coronary artery disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39483246</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002471"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39483246</owl:annotatedTarget>
        <dcterms:title>Genetic risk score for coronary artery calcification and its predictive ability for coronary artery disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39483246</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11525111/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Tampere Sudden Death Study (TSDS) consists of cross-sectional population autopsy samples of deaths occurring out of hospital for any reason.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002471"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of medico-legal autopsies performed at the Department of Forensic Medicine of the University of Tampere, Finland, on unselected individuals from Tampere and the surrounding regions who died out of hospital from any cause, used to study coronary atherosclerosis, brain pathology such as Lewy-related pathology, and other post-mortem tissue, with risk-factor data gathered by interviewing relatives of the deceased.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31437200</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39483246</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11713395/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002471"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">660</owl:annotatedTarget>
        <obo:IAO_0000116>TSDS autopsy samples with genetic data and coronary measurements in 2024</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11525111/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study involved 660 cases who had both genetic data and coronary measurements available.</rdfs:comment>
    </owl:Axiom>
