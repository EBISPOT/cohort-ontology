        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000551"/>
        <obo:IAO_0000112>PGS003762</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:24993387</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based, multidisciplinary longitudinal study of older adults in Greece, randomly selected at age 65 or over from the municipality registries of Marousi, a suburb of Athens, and of the city of Larissa and its rural surroundings, with baseline evaluations from 2011 to 2015 and follow-up evaluations thereafter, designed to estimate the prevalence and incidence of Alzheimer&apos;s disease, other dementias, mild cognitive impairment and other neuropsychiatric conditions of ageing and to study their associations with nutrition in this Mediterranean population.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1986</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HELIAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Hellenic Longitudinal Investigation of Aging and Diet</rdfs:label>
    </owl:NamedIndividual>
