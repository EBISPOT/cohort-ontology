    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid8833">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0100096"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000970"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8831"/>
        <obo:IAO_0000116>COVID-19</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35746640+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Herein, we provide results from a prospective population-based longitudinal follow-up (FU) SARS-CoV-2 serosurveillance study in Tirschenreuth, the county which was hit hardest in Germany in spring 2020 and early 2021.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000970"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8833"/>
        <obo:IAO_0000116>SARS-CoV-2 infection</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35746640+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Herein, we provide results from a prospective population-based longitudinal follow-up (FU) SARS-CoV-2 serosurveillance study in Tirschenreuth, the county which was hit hardest in Germany in spring 2020 and early 2021.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000970"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9228731/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Herein, we provide results from a prospective population-based longitudinal follow-up (FU) SARS-CoV-2 serosurveillance study in Tirschenreuth, the county which was hit hardest in Germany in spring 2020 and early 2021.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000970"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90454541</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of long COVID.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40399555</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12165857/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>of Long COVID (GOLD), Helix Exome+ and Healthy Nevada Project COVID-19 Phenotypes (Helix), MexGen-COVID Initiative, COVID-19 Ioannina Biobank (Ioannina), Genome-wide assessment of the gene variants associated with severe COVID-19 phenotype in Iran (IrCovid), Japan COVID-19 Task Force (JapanTaskForce), Lifelines, Norwegian Mother, Father and Child Cohort Study (MoBa), Mount Sinai COVID Biobank (MSCIC), Penn Medicine BioBank (PMBB), Follow-UP study of patients with critical COVID-19/COVID-19 Cohort Study of the University Hospital of the Technical University Munich (SweCovid/COMRI), Tirschenreuth Study (TiKoCo), TwinsUK, UK Biobank and Understanding Society—UK Household Longitudinal Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000970"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of inhabitants aged 14 or older of the county of Tirschenreuth in north-eastern Bavaria, Germany, one of the German counties hardest hit by SARS-CoV-2 in spring 2020, randomly selected with stratification by sex and municipality, who gave blood samples and questionnaires at a baseline survey in June-July 2020 and at follow-ups in November 2020 and April 2021, to determine SARS-CoV-2 seroprevalence and its course over time, including undetected infections, the durability of antibody responses and new infections.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34200766</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35746640</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000970"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4203</owl:annotatedTarget>
        <obo:IAO_0000116>individuals aged 14+ enrolled at baseline (2020)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:35746640</oboInOwl:hasDbXref>
        <rdfs:comment>Of 4203 individuals aged 14 years or older enrolled at baseline (BL, June 2020), 3546 participated at FU1 (November 2020) and 3391 at FU2 (April 2021).</rdfs:comment>
    </owl:Axiom>
