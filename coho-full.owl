        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7783</owl:annotatedTarget>
        <obo:IAO_0000116>prostate cancer cases (RPGEH, ProHealth, CMHS) and GERA controls in the 2015 GWAS, after exclusions; no total stated</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4527942/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Our analyses included 7,783 cases and 38,595 controls after exclusions described here.</rdfs:comment>
    </owl:Axiom>
