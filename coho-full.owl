        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24325</owl:annotatedTarget>
        <obo:IAO_0000116>adults aged 35+ enrolled 2005-2010</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.moli-sani.org/?page_id=423</oboInOwl:hasDbXref>
