        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11225376/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The initial sample size was 25,444 participants (aged 45–75 years).</rdfs:comment>
    </owl:Axiom>
