    <!-- http://www.ebi.ac.uk/coho/COHO_0000546 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000546">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid4809"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90269867</obo:IAO_0000112>
        <obo:IAO_0000115>A pharmacogenetic study established in 2007 at Massachusetts General Hospital, which from 2008 enrolled about 1,000 adults of diverse ancestry enriched for risk of type 2 diabetes and challenged them with glipizide and metformin at clinical research centres in Boston, Massachusetts, to identify genetic variants influencing the acute response to glucose-lowering drugs.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SUGAR-MGH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Study to Understand the Genetics of the Acute Response to Metformin and Glipizide in Humans</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Study to Understand the Genetics of the Acute Response to Metformin and Glipizide in Humans</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid4809">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000546"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4809"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37233759+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>One thousand participants at risk for type 2 diabetes from diverse ancestries underwent sequential glipizide and metformin challenges.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000546"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All CRC visits took place at an academic medical center (Massachusetts General Hospital, Brigham and Women’s Hospital, or the Joslin Diabetes Center, all in Boston, MA).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90269867</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analysis identifies ancestry-specific genetic variation associated with acute response to metformin and glipizide in SUGAR-MGH.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37233759</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:37233759%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>The Study to Understand the Genetics of the Acute Response to Metformin and Glipizide in Humans (SUGAR-MGH) examined the acute response to metformin and glipizide in order to identify new pharmacogenetic associations for the response to common glucose-lowering medications in individuals at risk of type 2 diabetes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pharmacogenetic study established in 2007 at Massachusetts General Hospital, which from 2008 enrolled about 1,000 adults of diverse ancestry enriched for risk of type 2 diabetes and challenged them with glipizide and metformin at clinical research centres in Boston, Massachusetts, to identify genetic variants influencing the acute response to glucose-lowering drugs.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37233759</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000546"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000</owl:annotatedTarget>
        <obo:IAO_0000116>individuals naive to diabetes medication who received the glipizide and metformin challenges</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10790310/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>SUGAR-MGH is a pharmacogenetic study in which 1000 individuals who were naive to type 2 diabetes medications received a single-dose glipizide challenge and a short course of metformin.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000546"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SUGAR-MGH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


