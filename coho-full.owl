        <owl:annotatedTarget>PMID:28346443</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of glioma subtypes identifies specific differences in genetic susceptibility to glioblastoma and non-glioblastoma tumors.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28346443</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5558246/</oboInOwl:hasDbXref>
        <rdfs:comment>French controls were taken from the SU.VI.MAX study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002419"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised, double-blind, placebo-controlled primary-prevention trial in the general adult population of France, which in 1994 enrolled women aged 35 to 60 and men aged 45 to 60 and followed them for eight years to test whether daily supplementation with antioxidant vitamins (vitamin C, vitamin E and beta-carotene) and minerals (selenium and zinc) at nutritional doses reduces cancers and cardiovascular diseases.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:9503043</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9683310</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
