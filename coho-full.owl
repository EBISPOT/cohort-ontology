    <!-- http://www.ebi.ac.uk/coho/COHO_0002623 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002623">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22070"/>
        <rdf:type rdf:nodeID="genid22072"/>
        <rdf:type rdf:nodeID="genid22074"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>PMID:38826077</obo:IAO_0000112>
        <obo:IAO_0000115>The participants of a randomised controlled weight-management trial run from 2008 to 2010 by the Institute of Public Health and Clinical Nutrition, University of Kuopio (now University of Eastern Finland), Finland, in which adults aged 30–65 with obesity followed a very-low-energy diet and were then randomised to weight-maintenance diets containing foods of higher or lower predetermined satiety value, to study whether food satiety value affects self-regulation of food intake and weight management.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">99</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ELIPA</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>ELIPA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Elintarvikkeita Painonhallintaan</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Elintarvikkeita painonhallintaan</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Foods for Weight Maintenance</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Foods for weight management (Elintarvikkeita painonhallintaan)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Foods for weight management: a randomized controlled trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ISRCTN67529475</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Foods for weight management</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22070">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011122"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid22072">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_2000065"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid22074">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_2000068"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002623"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22070"/>
        <obo:IAO_0000116>obesity</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3389694/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Originally 99 (28 males, 71 females) obese (inclusion criteria being body mass index (BMI) 30–40 kg/m2, age 30–65 years) subjects were recruited into the intervention study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002623"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22072"/>
        <obo:IAO_0000116>very-low-energy diet</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ELIPA</oboInOwl:hasDbXref>
        <rdfs:comment>This study aimed to investigate factors associated with weight management, especially whether satiety value of food as a part of a weight-maintenance diet would affect self-regulation of food intake and weight management.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002623"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22074"/>
        <obo:IAO_0000116>satiety value of foods in a weight-maintenance diet</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ELIPA</oboInOwl:hasDbXref>
        <rdfs:comment>This study aimed to investigate factors associated with weight management, especially whether satiety value of food as a part of a weight-maintenance diet would affect self-regulation of food intake and weight management.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002623"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3389694/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>They were recruited by an announcement in a local newspaper and among the eligible subjects who had participated previously in the studies performed at the University of Kuopio, Kuopio, Finland (currently University of Eastern Finland).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002623"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38826077</owl:annotatedTarget>
        <dcterms:title>Association between whole-grain consumption, tryptophan metabolism and psychological distress: a secondary analysis of a randomised controlled trial.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38826077</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11473202/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study was registered in isrctn.org with the identifier 67529475.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002623"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The participants of a randomised controlled weight-management trial run from 2008 to 2010 by the Institute of Public Health and Clinical Nutrition, University of Kuopio (now University of Eastern Finland), Finland, in which adults aged 30–65 with obesity followed a very-low-energy diet and were then randomised to weight-maintenance diets containing foods of higher or lower predetermined satiety value, to study whether food satiety value affects self-regulation of food intake and weight management.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22792447</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.isrctn.com/ISRCTN67529475</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002623"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">99</owl:annotatedTarget>
        <obo:IAO_0000116>obese subjects recruited (28 men, 71 women)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3389694/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Originally 99 (28 males, 71 females) obese (inclusion criteria being body mass index (BMI) 30–40 kg/m2, age 30–65 years) subjects were recruited into the intervention study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002623"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ELIPA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
