        <obo:IAO_0000112>GCST000387</obo:IAO_0000112>
        <obo:IAO_0000115>A project combining clinical data and biological materials from psychiatric genetic studies in a shared National Institute of Mental Health repository, organised into disorder-related collections to support research on mental illness.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym HGI also denotes the COVID-19 Host Genetics Initiative (COHO:0000238); this term is the NIMH Human Genetics Initiative repository.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">120000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HGI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Human Genetics Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid1156">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005084"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000094"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid1156"/>
        <obo:IAO_0000116>mental disorders</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.nimh.nih.gov/about/advisory-boards-and-groups/namhc/2016/may/namhc-minutes-of-the-245th-meeting</oboInOwl:hasDbXref>
        <rdfs:comment>The NIMH-RGR is a principal biorepository resource with more than 200,000 well-characterized, high-quality patient and control samples from a wide-range of mental disorders across diverse ethnicities.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000094"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001024"/>
        <oboInOwl:hasDbXref>https://www.nimh.nih.gov/about/advisory-boards-and-groups/namhc/reports/genetics-and-mental-disorders-report-of-the-national-institute-of-mental-healths-genetics-workgroup</oboInOwl:hasDbXref>
        <rdfs:comment>Readers will note that Alzheimer’s disease is not included on this list, even though the NIMH Human Genetics Initiative included this severe disorder.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000094"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001238"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9117153/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>STAR*D genotype and phenotype data are available through the National Institute of Mental Health Human Genetic Initiative (https://www.nimhgenetics.org/).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000094"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7287780/</oboInOwl:hasDbXref>
        <rdfs:comment>in five waves at 11 sites across the United States</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000094"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST000387</owl:annotatedTarget>
        <dcterms:title>Genome-wide association and meta-analysis of bipolar disorder in individuals of European ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:19416921</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pmc&amp;id=2678639</oboInOwl:hasDbXref>
        <rdfs:comment>National Institute of Mental Health Human Genetics Initiative Repository</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000094"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A project combining clinical data and biological materials from psychiatric genetic studies in a shared National Institute of Mental Health repository, organised into disorder-related collections to support research on mental illness.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.nimh.nih.gov/about/advisory-boards-and-groups/namhc/2016/may/namhc-minutes-of-the-245th-meeting</obo:IAO_0000119>
