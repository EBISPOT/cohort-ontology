    <!-- http://www.ebi.ac.uk/coho/COHO_0001911 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001911">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16889"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Iceland"/>
        <obo:IAO_0000112>PMID:20686651</obo:IAO_0000112>
        <obo:IAO_0000115>A registry of patients with kidney stone disease in Iceland, kept at Landspitali – The National University Hospital of Iceland in Reykjavik and established in 2008 in conjunction with a nationwide study of kidney stone disease that searched the computerised records of all major hospitals and medical imaging centres in Iceland for codes indicating kidney stones; its patients with confirmed radiopaque stones who had given blood to the genetic research programmes of deCODE genetics were the Icelandic cases of deCODE&apos;s genetic association studies of kidney stones.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>IKSDR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IKSR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Icelandic Kidney Stone Disease Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Icelandic Kidney Stone Disease Registry at LUH</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Icelandic Kidney Stone Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16889">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008171"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001911"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
