        <oboInOwl:hasRelatedSynonym>SLRCCSG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Swedish Colorectal Cancer Low-risk study</oboInOwl:hasRelatedSynonym>
