        <rdfs:comment>The SALIA study was initiated in the early 1980s by the State Government of North-Rhine Westphalia to investigate the health effects of air pollution exposure in women.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002618"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22026"/>
        <obo:IAO_0000116>air pollution exposure</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4000047/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SALIA study was initiated in the early 1980s by the State Government of North-Rhine Westphalia to investigate the health effects of air pollution exposure in women.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002618"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4000047/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study population consists of women from the industrialized Ruhr Area in Germany (Dortmund, Duisburg, Herne, Gelsenkirchen, Essen) and two non-industrialized rural areas north of the Ruhr area (Borken, Dülmen).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002618"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
