        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000971"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90824165</owl:annotatedTarget>
        <dcterms:title>Multiancestry Genome-Wide Association Study Identifies Variants in a Zinc Finger Gene Cluster as Novel Regulators of HIV Control.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41640362</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000971"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort study of HIV infection and AIDS in Amsterdam, the Netherlands, a collaboration of the Public Health Service of Amsterdam, Amsterdam University Medical Centers, Sanquin Blood Supply and other partners, which since 1984 has followed an open cohort of men who have sex with men and from 1985 until 2016 followed a cohort of people who use drugs, to study the prevalence, incidence and risk factors of HIV infection and AIDS and the natural history of HIV-1 infection, and to carry out intervention studies and evaluate prevention programmes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30312336</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33407562</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9586643</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
