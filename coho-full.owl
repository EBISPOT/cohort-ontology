        <obo:IAO_0000112>PGS002269</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:26691988</obo:IAO_0000112>
        <obo:IAO_0000115>A clinic-based case-control collection for genetic studies of age-related macular degeneration, run by the Department of Ophthalmology of the University of California, San Diego, of white patients with age-related macular degeneration and controls aged 60 or over without drusen, enrolled at the Shiley Eye Center, University of California, San Diego, and the Moran Eye Center, University of Utah, examined by visual acuity, slit-lamp biomicroscopy, fundus photography and optical coherence tomography and graded by the Age-Related Eye Disease Study criteria.</obo:IAO_0000115>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2049</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3482</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>UCSD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">UCSD study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21089">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
