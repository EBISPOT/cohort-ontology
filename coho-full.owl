    <!-- http://www.ebi.ac.uk/coho/COHO_0002537 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002537">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21406"/>
        <rdf:type rdf:nodeID="genid21408"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000238"/>
        <obo:IAO_0000112>PMID:39715278</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based SARS-CoV-2 study in the Gardena valley (Val Gardena/Gröden) of South Tyrol, Italy, one of the areas most afflicted early in the COVID-19 pandemic, that invited a random sample of the inhabitants of its main municipalities (Ortisei, Santa Cristina and Selva), stratified by municipality, sex and age group, to answer a questionnaire and undergo a nasopharyngeal swab test and a serological antibody test between 26 May and 8 June 2020, towards the end of the first wave, and stored their biological samples at the Eurac Research Biobank; funded by the Healthcare System of the Autonomous Province of Bolzano/Bozen, it later contributed genotyped participants to the COVID-19 Host Genetics Initiative and participants with confirmed infection to a whole-genome sequencing study of COVID-19 host genetics built on the German COVID-19 Omics Initiative.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2244</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TOPMed_Gardena</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Val Gardena</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Val Gardena cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Val Gardena/Gröden study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Val_Gardena</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>topmed_gardena</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Val Gardena COVID-19 study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21406">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0100096"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid21408">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0100096"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002537"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21406"/>
        <obo:IAO_0000116>COVID-19</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8387688/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>At the end of May 2020, we surveyed 2244 inhabitants of the Gardena valley representative of the local population, measured antibody test response to SARS-CoV-2 and related that response to symptoms, prior conditions and serum neutralisation capacity.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002537"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21408"/>
        <obo:IAO_0000116>SARS-CoV-2 infection</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8387688/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>At the end of May 2020, we surveyed 2244 inhabitants of the Gardena valley representative of the local population, measured antibody test response to SARS-CoV-2 and related that response to symptoms, prior conditions and serum neutralisation capacity.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002537"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8387688/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>During the initial phase of the SARS-CoV-2 pandemic, the Gardena valley, a well-known winter tourism destination located in South Tyrol (Italy), became one of the European regions most afflicted by the coronavirus disease 2019 (COVID-19).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002537"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39715278</owl:annotatedTarget>
        <dcterms:title>Systematic assessment of COVID-19 host genetics using whole genome sequencing data.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39715278</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11706450/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>the Healthcare System of the Autonomous Province of Bolzano/Bozen (Val Gardena cohort)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002537"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based SARS-CoV-2 study in the Gardena valley (Val Gardena/Gröden) of South Tyrol, Italy, one of the areas most afflicted early in the COVID-19 pandemic, that invited a random sample of the inhabitants of its main municipalities (Ortisei, Santa Cristina and Selva), stratified by municipality, sex and age group, to answer a questionnaire and undergo a nasopharyngeal swab test and a serological antibody test between 26 May and 8 June 2020, towards the end of the first wave, and stored their biological samples at the Eurac Research Biobank; funded by the Healthcare System of the Autonomous Province of Bolzano/Bozen, it later contributed genotyped participants to the COVID-19 Host Genetics Initiative and participants with confirmed infection to a whole-genome sequencing study of COVID-19 host genetics built on the German COVID-19 Omics Initiative.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34237774</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34645534</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39715278</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002537"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2244</owl:annotatedTarget>
        <obo:IAO_0000116>inhabitants of the Gardena valley&apos;s three main municipalities (stratified random sample of 2958 invited) who joined the 2020 serosurvey</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8387688/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of 2958 invited individuals, 2244 (75.9%) joined the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002537"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TOPMed_Gardena</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002537"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Val_Gardena</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002537"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
