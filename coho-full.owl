    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002745"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23320"/>
        <obo:IAO_0000116>diet high in bioactive-rich foods</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.isrctn.com/api/query/format/default?q=ISRCTN14510401</oboInOwl:hasDbXref>
        <rdfs:comment>Consumption of a diet high in bioactive-rich foods for two weeks will increase gut microbial diversity in healthy participants compared to a 2-week diet low in bioactive-rich foods and will additionally affect markers of metabolic health.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002745"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
