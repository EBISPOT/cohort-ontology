        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/GINI%2FLISA%20North</oboInOwl:hasDbXref>
        <rdfs:comment>Number of participants 3390</rdfs:comment>
    </owl:Axiom>
