    <!-- http://www.ebi.ac.uk/coho/COHO_0000375 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000375">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid3319"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90939806</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal cohort of people with Parkinson disease and healthy older controls studied by the Campbell Research Lab in the Section of Movement Disorders at Washington University in St. Louis, United States, assessed every two years with MRI, motor, gait and cognitive testing, optional lumbar puncture and clinical interview to understand the role of brain proteins and neurotransmitters in Parkinson disease symptoms compared with healthy aging.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PAND</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Protein Aggregation and Neurotransmitter Deficits</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Protein Aggregation and Neurotransmitter Deficits in Parkinson Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Protein Aggregation and Neurotransmitter Deficits Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid3319">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000375"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid3319"/>
        <obo:IAO_0000116>Parkinson disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://campbellresearchlab.wustl.edu/items/protein-aggregation-and-neurotransmitter-deficits-pand-study/</oboInOwl:hasDbXref>
        <rdfs:comment>The purpose of this study is to understand the role of brain proteins and neurotransmitters in the symptoms of PD compared to healthy aging.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
