        <rdf:type rdf:nodeID="genid16879"/>
        <rdf:type rdf:nodeID="genid16881"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:38177345</obo:IAO_0000112>
        <obo:IAO_0000115>A multi-institutional prospective cohort study of stress and depression in physicians in the United States, which invites incoming interns each year before they start the first year of residency training (from 2007) and follows them from the end of medical school through internship, recording depressive and anxiety symptoms and their risk factors by repeated questionnaires and a daily mood smartphone app, with DNA collected by mail for genetic studies of depression under stress.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">740</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HIS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IHS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Intern Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16879">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_with_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0001591"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid16881">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002050"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001910"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16879"/>
        <obo:IAO_0000116>internship stress</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4036806/</oboInOwl:hasDbXref>
        <rdfs:comment>The present study seeks to identify the factors important in the development of depression during medical internship and to utilize internship as a stress model to study subjects before and after the onset of a major stressor and assess the moderating effect of 5-HTTLPR on the development of depression.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001910"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16881"/>
        <obo:IAO_0000116>depression</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7190044/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Intern Health Study is a prospective cohort study assessing stress and depression during the first year of residency training in the US.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001910"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7190044/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Intern Health Study is a prospective cohort study assessing stress and depression during the first year of residency training in the US.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001910"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38177345</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genome-wide association study of major depression aids locus discovery, fine mapping, gene prioritization and causal inference.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38177345</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10864182/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We had access to individual-level data for Army STARRS, UKB, Women’s Health Initiative (WHI), Intern Health Study (IHS), GERA, Jackson Heart Study (JHS), Drakenstein Child Health Study and the Detroit Neighborhood Health Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001910"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multi-institutional prospective cohort study of stress and depression in physicians in the United States, which invites incoming interns each year before they start the first year of residency training (from 2007) and follows them from the end of medical school through internship, recording depressive and anxiety symptoms and their risk factors by repeated questionnaires and a daily mood smartphone app, with DNA collected by mail for genetic studies of depression under stress.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31084447</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31659322</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31818913</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001910"/>
