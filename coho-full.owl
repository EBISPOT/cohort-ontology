    <!-- http://www.ebi.ac.uk/coho/COHO_0000826 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000826">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid7499"/>
        <obo:IAO_0000112>GCST90269797</obo:IAO_0000112>
        <obo:IAO_0000115>A large international collaboration of research groups, funded by the European Union Seventh Framework Programme as a successor to GENOMOS, that brings together osteoporosis study populations with DNA and genome-wide association data to identify common genetic variants for osteoporosis and bone traits.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32961</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GEFOS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GEFOS consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Factors for Osteoporosis Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">GEnetic Factors for OSteoporosis Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid7499">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005298"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000826"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7499"/>
        <obo:IAO_0000116>osteoporosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>http://www.gefos.org/</oboInOwl:hasDbXref>
        <rdfs:comment>With the GEFOS project we here propose to capitalize on the success of GENOMOS by using the most advanced gene discovery tools that have become recently available, i.e., Genome Wide Association (GWA) analysis with high density SNP arrays, to identify common risk gene variants for osteoporosis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000826"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90269797</owl:annotatedTarget>
        <dcterms:title>Candidate loci shared among periodontal disease, diabetes and bone density.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36778599</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36778599+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>T2D from the DIAGRAM consortium (Neff=228825), and BMD from the GEFOS consortium (N=426824).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000826"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A large international collaboration of research groups, funded by the European Union Seventh Framework Programme as a successor to GENOMOS, that brings together osteoporosis study populations with DNA and genome-wide association data to identify common genetic variants for osteoporosis and bone traits.</owl:annotatedTarget>
        <obo:IAO_0000119>http://www.gefos.org/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000826"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32961</owl:annotatedTarget>
        <obo:IAO_0000116>individuals in the discovery meta-analysis of 17 GWAS in the 2012 GEFOS BMD study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3338864/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed the largest meta-analysis to date on lumbar spine and femoral neck BMD, including 17 genome-wide association studies and 32,961 individuals of European and East Asian ancestry.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000826"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GEFOS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


