        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000265"/>
        <obo:IAO_0000112>PMID:23113606</obo:IAO_0000112>
        <obo:IAO_0000115>The Czech Republic cohort of the HAPIEE study: a random sample of men and women aged 45-69 years, stratified by sex and age and selected from population registers in six Czech towns (Havířov/Karviná, Hradec Králové, Jihlava, Kroměříž, Liberec and Ústí nad Labem), examined at baseline in 2002-2005 and followed through re-examinations (most recently in 2023-2024) and linkage to national health registers, with geocoded addresses linked to exposome and census data. The aim is to study psychosocial, behavioural and environmental risk factors for cardiovascular and other chronic diseases and for ageing outcomes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8856</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/HAPIEE-CZ</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>Czech HAPIEE cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Czech HAPIEE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HAPIEE-CZ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Health, Alcohol and Psychosocial factors In Eastern Europe</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Czech Health, Alcohol and Psychosocial factors In Eastern Europe study</rdfs:label>
    </owl:NamedIndividual>
