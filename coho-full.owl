        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1418</owl:annotatedTarget>
        <obo:IAO_0000116>bladder cancer patients and population controls interviewed 2001-2004</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2778671/</oboInOwl:hasDbXref>
        <rdfs:comment>We interviewed 1213 bladder cancer patients (65% of 1878 eligible patients).</rdfs:comment>
    </owl:Axiom>
