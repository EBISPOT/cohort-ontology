        <obo:IAO_0000112>PMID:19839053</obo:IAO_0000112>
        <obo:IAO_0000115>A national, population-based multicentre case-control study in Australia that recruited children younger than 15 years with newly diagnosed acute lymphoblastic leukemia and population controls during 2003–2007. Cases were recruited through hospitals and controls through random-digit dialing, with questionnaire information and biospecimens from children and parents used to investigate environmental and genetic causes, including maternal folate supplementation and gene–environment interactions.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">416</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1361</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>AUS-ALL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Aus-ALL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Australian Study of Causes of Acute Lymphoblastic Leukaemia in Children</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Aus–ALL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Aus–ALL Consortium</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Australian Study of Causes of Acute Lymphoblastic Leukemia in Children</rdfs:label>
    </owl:NamedIndividual>
