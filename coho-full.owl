        <obo:IAO_0000112>PGS003415</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:25595936</obo:IAO_0000112>
        <obo:IAO_0000115>A multi-institutional, longitudinal observational study of prostate cancer in the United Kingdom, conducted through the Royal Marsden NHS Foundation Trust, that since 1992 has recruited men with histologically confirmed prostate cancer in a population-based arm and in arms enriched for young age at onset or a family history of the disease, together with cancer-free men from its clinics as controls, collecting baseline and follow-up clinical data to study inherited susceptibility to prostate cancer and its outcomes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16633</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>UKGPCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Uk genetic prostate cancer study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">UK Genetic Prostate Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21214">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002506"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
