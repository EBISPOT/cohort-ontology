        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Breast cancer patients diagnosed before age 50 in 2003-2009 at the NKI-AVL; and (ABCS-F) All non-BRCA1/2 breast cancer cases from the family cancer clinic of the NKI-AVL tested in the period 1995-2009; all ages and diagnosed with breast cancer in 1965-2008.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001459"/>
