        <rdfs:comment>The families were recruited under the aegis of the Center for Education and Drug Abuse Research in Pittsburgh, Pennsylvania.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001618"/>
