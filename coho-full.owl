        <oboInOwl:hasRelatedSynonym>MIND Clinical Imaging Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mind Clinical Imaging Consortium study of schizophrenia</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Mind Clinical Imaging Consortium</rdfs:label>
    </owl:NamedIndividual>
