    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002335"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of healthy male volunteers enrolled in San Antonio and South Texas since 2000 by the San Antonio Center of Biomarkers of Risk for Prostate Cancer of the National Cancer Institute&apos;s Early Detection Research Network, screened annually or biannually by digital rectal examination and serum prostate-specific antigen, with prostate biopsy recommended after an abnormal result, to study prostate cancer risk and its biomarkers.</owl:annotatedTarget>
