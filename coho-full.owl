    <!-- http://www.ebi.ac.uk/coho/COHO_0001492 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001492">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13481"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:28159758</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based osteoporosis screening study and longitudinal cohort of women from the Aberdeen area of north-east Scotland, selected at random from Community Health Index (primary care) records within 25 miles of Aberdeen and invited, when aged 45–54, to a baseline health visit with bone density measurement in 1990–1994, with further visits in 1997–1999, when blood was taken for DNA, and in 2007–2011, to study bone loss, osteoporotic fracture risk and falls and their dietary, medical and genetic determinants.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5119</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>APOSS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Aberdeen Prospective Osteoporosis Screening Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13481">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005298"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001492"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13481"/>
        <obo:IAO_0000116>osteoporosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5506508/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects are women from the Aberdeen Prospective Osteoporosis Screening Study (APOSS) cohort, a population-based screening program for assessing osteoporotic fracture risk, which initially recruited 5119 women aged 45–54 years between 1990 and 1994 using random selection from Community Health Index [15].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001492"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21179049+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This cross-sectional study examined 3236 Scottish women age 50-59 years, who were members of the Aberdeen Prospective Osteoporosis Screening Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001492"/>
