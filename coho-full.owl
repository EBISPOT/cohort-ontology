        <oboInOwl:hasRelatedSynonym>NORDCAP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NORDCAP project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NORDCAP study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nordic Children and Adolescents Born Preterm</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Nordic Children and Adults Born Preterm</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.oulu.fi/en/projects/nordic-children-and-adults-born-preterm-nordcap"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002614"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.oulu.fi/en/projects/nordic-children-and-adults-born-preterm-nordcap</oboInOwl:hasDbXref>
        <rdfs:comment>The Finnish study population includes all births in Finland during 1987–2023, identified from the Finnish Medical Birth Register, THL (approximately 2 100 000 children).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002614"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42241480</owl:annotatedTarget>
        <dcterms:title>Prognostic Factors for Adulthood Psychosis in Adolescent Psychiatry Services: A Longitudinal Total Birth Cohort Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42241480</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13235725/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a longitudinal, register-based total birth cohort study using data from the Nordic Children and Adolescents Born Preterm (NORDCAP) study, governed by the Finnish Institute for Health and Welfare.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002614"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A register-based cohort of all children born in Finland from 1987 onwards, identified from the Finnish Medical Birth Register and linked with other national health, social and population registers and with data on their parents, held by the University of Oulu (earlier by the Finnish Institute for Health and Welfare) to study how preterm birth, pregnancy disorders and other early-life factors predict health, well-being and societal outcomes from childhood to adulthood, and the intergenerational transmission of health.</owl:annotatedTarget>
