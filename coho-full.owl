        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
        <obo:IAO_0000112>GCST90129576</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective breast screening cohort of 19,924 women aged 35 or over, resident in Minnesota, Iowa or Wisconsin and without a history of breast cancer, enrolled when having a screening mammogram at Mayo Clinic, Rochester, from October 2003 to September 2006, to study mammographic density and breast cancer risk.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19924</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MMHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Mayo Mammography Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid8444">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000924"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8444"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3701143/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The MMHS prospectively enrolled patients scheduled for a screening mammogram from October 2003 through September 2006 at the Mayo Clinic in Rochester, MN.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000924"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3701143/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Women were invited to take part if they were at least 35 years old, residents of Minnesota, Iowa, or Wisconsin (tri-state), and had no personal history of breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000924"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90129576</owl:annotatedTarget>
        <dcterms:title>Genome-wide interaction analysis of menopausal hormone therapy use and breast cancer risk among 62,370 women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35418701</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9007944/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We thank the coordinators, the research staff and especially the MMHS participants for their continued collaboration on research studies in breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000924"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective breast screening cohort of 19,924 women aged 35 or over, resident in Minnesota, Iowa or Wisconsin and without a history of breast cancer, enrolled when having a screening mammogram at Mayo Clinic, Rochester, from October 2003 to September 2006, to study mammographic density and breast cancer risk.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23152984</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000924"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19924</owl:annotatedTarget>
        <obo:IAO_0000116>women consenting at screening mammography, 2003-2006</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3701143/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of 38,883 eligible women, 19,924 provided written informed consented (51.2% adjusted response rate) (Figure 1).</rdfs:comment>
    </owl:Axiom>
