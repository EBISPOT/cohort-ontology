    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001420"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The part of the European NAFLD Registry, a prospective observational cohort of adults with non-alcoholic fatty liver disease sponsored by Newcastle University, made up of patients with biopsy-characterised NAFLD who were recruited at liver centres across Europe from 2010 to December 2017 in the FLIP, EPoS and HEPAmet studies of NAFLD pathogenesis, or came from earlier single-centre cohorts, and used by the IMI2 LITMUS project to evaluate non-invasive biomarkers. Patients recruited since 2018 form the Registry&apos;s separate LITMUS Study Cohort.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33045403</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36958367</obo:IAO_0000119>
