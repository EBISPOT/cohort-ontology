    <!-- http://www.ebi.ac.uk/coho/COHO_0001655 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001655">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14887"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:38820342</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective observational cohort of kidney and simultaneous pancreas–kidney transplant recipients enrolled at the time of transplantation between 2005 and 2011 at five US and two Canadian transplant centres, the genetic study of the prospective arm of the Long-term Deterioration of Kidney Allograft Function (DeKAF) study, which with DNA from the recipients and from their living or deceased donors studies genetic influences on acute rejection, graft failure and immunosuppressant concentrations and adverse effects.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3402</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>DeKAF Genomics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Deterioration of Kidney Allograft Function Genomics Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genomics of Deterioration of Kidney Allograft Function</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Deterioration of Kidney Allograft Function Genomics</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14887">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004375"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001655"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14887"/>
        <obo:IAO_0000116>end-stage renal disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6597284/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were included if they had end stage renal dysfunction undergoing kidney or simultaneous kidney-pancreas transplant.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001655"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3787982/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>3,402 kidney or simultaneous kidney-pancreas transplant (SPK) recipients in 5 U.S. and 2 Canadian transplant centers were consented and enrolled at the time of transplantation in the DeKAF Genomics, a prospective observational, study between 2006 and 2011.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001655"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38820342</owl:annotatedTarget>
        <dcterms:title>Polygenic risk score for acute rejection based on donor-recipient non-HLA genotype mismatch.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38820342</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11142483/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>After the weights of the SNPs were estimated in the DeKAF Genomics cohort, the PRS was then validated in another independent cohort, the Genomics of Kidney Transplantation (GEN-03).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001655"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective observational cohort of kidney and simultaneous pancreas–kidney transplant recipients enrolled at the time of transplantation between 2005 and 2011 at five US and two Canadian transplant centres, the genetic study of the prospective arm of the Long-term Deterioration of Kidney Allograft Function (DeKAF) study, which with DNA from the recipients and from their living or deceased donors studies genetic influences on acute rejection, graft failure and immunosuppressant concentrations and adverse effects.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21206424</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23879408</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30801552</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32080893</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
