    <!-- http://www.ebi.ac.uk/coho/COHO_0002295 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002295">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <obo:IAO_0000112>PMID:34246321</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of DNA samples and Epstein-Barr virus-transformed cell lines from healthy Japanese volunteers, recruited through the Pharma SNP Consortium in Tokyo, whose health was checked through the consortium; the samples were used for a database of SNPs and haplotypes in drug-related genes and as controls in genetic association studies of the Japanese population.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1032</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PSC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pharma SNP consortium</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Pharma SNP Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002295"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3228237/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A large number of control subjects (96.7%) was recruited through the Pharma SNP consortium (PSC) in Japan (http://www.jpma.or.jp/psc/frame-e.html).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002295"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34246321</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study reveals an association between the HLA-DPB1∗02:01:02 allele and wheat-dependent exercise-induced anaphylaxis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34246321</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8387458/</oboInOwl:hasDbXref>
        <rdfs:comment>We included a dataset of 924 and 435 healthy subjects from the Pharma SNP Consortium (PSC) as the discovery set and the Japan Biological Informatics Consortium (JBIC) as the replication set, resulting in a total of 1,359 control subjects.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002295"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of DNA samples and Epstein-Barr virus-transformed cell lines from healthy Japanese volunteers, recruited through the Pharma SNP Consortium in Tokyo, whose health was checked through the consortium; the samples were used for a database of SNPs and haplotypes in drug-related genes and as controls in genetic association studies of the Japanese population.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15202072</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18199129</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22291604</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34246321</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002295"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1032</owl:annotatedTarget>
        <obo:IAO_0000116>healthy Japanese volunteers recruited for the consortium-approved SNP and haplotype study of drug-related genes (2004)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC1216054/</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1,032 volunteers were recruited, and DNA samples from 752 subjects randomly selected from among these volunteers were used for the present study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002295"/>
