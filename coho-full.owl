    <!-- http://www.ebi.ac.uk/coho/COHO_0002132 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002132">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid18533"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000456"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000516"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000527"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001793"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002131"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002205"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:27760082</obo:IAO_0000112>
        <obo:IAO_0000115>A genome-wide meta-analysis resource for primary open-angle glaucoma that combines summary data from eight independent case-control and population-based datasets of European ancestry from the United States: the NEIGHBOR study, the Nurses&apos; Health Study, the Health Professionals Follow-up Study, the Women&apos;s Genome Health Study, the Ocular Hypertension Treatment Study, and collections from Iowa, Marshfield and the Massachusetts Eye and Ear Infirmary. Cases in all datasets were defined by a harmonised glaucoma definition.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3853</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">33480</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>NBH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NEIGHBORHOOD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NEIGHBORHOOD consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>national eye institute glaucoma human collaboration heritable overall operational database</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">National Eye Institute Glaucoma Human Genetics Collaboration Heritable Overall Operational Database</rdfs:label>
    </owl:NamedIndividual>
