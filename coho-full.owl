        <oboInOwl:hasRelatedSynonym>FUSION</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Finland-United States Investigation of Non-Insulin-Dependent Diabetes Mellitus Genetics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Finland-United States Investigation of NIDDM Genetics</rdfs:label>
    </owl:NamedIndividual>
