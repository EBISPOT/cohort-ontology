        <oboInOwl:hasRelatedSynonym>South West UK cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Progression to insulin deficiency: South West England cohort</rdfs:label>
    </owl:NamedIndividual>
