        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000793"/>
        <obo:IAO_0000112>PGS019953</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:30482948</obo:IAO_0000112>
        <obo:IAO_0000115>A family study of cocaine dependence at Washington University School of Medicine in St. Louis, Missouri, in which adults with cocaine dependence recruited from chemical dependency treatment centres in the St. Louis area, and community controls matched to them on age, ethnicity, gender and zip code and recruited through driver&apos;s licence records, each took part with a full sibling, to study family, neighbourhood and genetic contributions to substance dependence; recruitment targeted equal numbers of men and women and of European-Americans and African-Americans.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">504</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">493</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>FSCD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Family Study on Cocaine Dependence</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FinnTwin, Family Study of Cocaine Dependence</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Family Study of Cocaine Dependence</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15580">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005186"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001745"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15580"/>
        <obo:IAO_0000116>cocaine dependence</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2384165/</oboInOwl:hasDbXref>
        <rdfs:comment>Cocaine dependent subjects were recruited from publicly and privately funded inpatient and outpatient chemical dependency treatment centers in the St. Louis region.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001745"/>
