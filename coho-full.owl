        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2366</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>WESDR</oboInOwl:hasRelatedSynonym>
