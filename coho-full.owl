        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">405</owl:annotatedTarget>
        <obo:IAO_0000116>Nagano breast cancer cases recruited in 2001-2005</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://doi.org/10.1007/s10549-008-0168-1</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 405 cases (98%) participated in Nagano, and 83 Japanese Brazilians (91%) and 389 non-Japanese Brazilians (99%) in São Paulo.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002107"/>
