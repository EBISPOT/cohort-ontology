    <!-- http://www.ebi.ac.uk/coho/COHO_0001765 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001765">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15755"/>
        <rdf:type rdf:nodeID="genid15757"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000768"/>
        <obo:IAO_0000112>PGS000751</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:21637779</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of prostate cancer run by the Henry Ford Health System in Detroit, Michigan, United States, which enrolled men of Caucasian or African American race younger than 75 years with adenocarcinoma of the prostate living in the metropolitan Detroit tri-county area, and controls randomly selected from the same Henry Ford Health System population base, between January 2001 and December 2004, to study gene-environment interaction in prostate cancer risk.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">637</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">244</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>GECAP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Gene-Environment Interaction in Prostate Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Gene-Environment Interaction in Prostate Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15755">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid15757">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_9000433"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001765"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15755"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC1769317/</oboInOwl:hasDbXref>
        <rdfs:comment>To determine whether the GSTP1 Ile105Val polymorphism modifies prostate cancer risk associated with occupational PAH exposure, we studied 637 prostate cancer cases and 244 controls of White and African-American race from the Henry Ford Health System in Detroit, Michigan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001765"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15757"/>
        <obo:IAO_0000116>occupational exposure to polycyclic aromatic hydrocarbons (PAHs)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC1769317/</oboInOwl:hasDbXref>
        <rdfs:comment>Occupational exposure to PAH from wood, petroleum, coal or other sources through respiratory and cutaneous routes was retrospectively assessed by expert review of job histories.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001765"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3102736/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Henry Ford Health System (HFHS) recruited cases diagnosed with adenocarcinoma of the prostate of Caucasian or African American race, less than 75 years of age, and living in the metropolitan Detroit tri-county area [41].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001765"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000751</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study of prostate cancer in Latinos.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31226226</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001765"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21637779</owl:annotatedTarget>
        <dcterms:title>Characterizing genetic risk at known prostate cancer susceptibility loci in African Americans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21637779</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3102736/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>GECAP was supported by NIH grant ES011126.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001765"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of prostate cancer run by the Henry Ford Health System in Detroit, Michigan, United States, which enrolled men of Caucasian or African American race younger than 75 years with adenocarcinoma of the prostate living in the metropolitan Detroit tri-county area, and controls randomly selected from the same Henry Ford Health System population base, between January 2001 and December 2004, to study gene-environment interaction in prostate cancer risk.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17067754</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21637779</obo:IAO_0000119>
        <dcterms:contributor>GPT-6 (OpenAI), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001765"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">637</owl:annotatedTarget>
        <obo:IAO_0000116>GECAP participants completing the study protocol</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC1769317/</oboInOwl:hasDbXref>
        <rdfs:comment>During the course of enrollment, eight cases and one control were found ineligible and 23 cases and 13 controls did not complete the study protocol, resulting in final study participation percentages of 75% (637/855) for cases and 64% (244/380) for controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001765"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">244</owl:annotatedTarget>
        <obo:IAO_0000116>GECAP participants completing the study protocol</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC1769317/</oboInOwl:hasDbXref>
        <rdfs:comment>During the course of enrollment, eight cases and one control were found ineligible and 23 cases and 13 controls did not complete the study protocol, resulting in final study participation percentages of 75% (637/855) for cases and 64% (244/380) for controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001765"/>
