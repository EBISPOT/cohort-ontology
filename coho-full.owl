        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9423</owl:annotatedTarget>
        <obo:IAO_0000116>men and women aged 25+ recruited 1995-1997 (main cohort)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://camos.org/information/</oboInOwl:hasDbXref>
        <rdfs:comment>Study Population Our study population, recruited between 1995 and 1997, includes 9 423 men and women age 25 and older among which 6539 are women and 2884 are men.</rdfs:comment>
    </owl:Axiom>
