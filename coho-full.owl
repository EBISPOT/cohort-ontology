    <!-- http://www.ebi.ac.uk/coho/COHO_0002595 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002595">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid21841"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000841"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001573"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001896"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001897"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001898"/>
        <obo:IAO_0000112>PMID:27028160</obo:IAO_0000112>
        <obo:IAO_0000115>A collaboration of Australian and American investigators to identify genes associated with liability for heroin dependence, using a case–control design in which cases met lifetime DSM-IV criteria for heroin dependence and controls were assessed individuals without heroin dependence or unassessed general population controls, with cases and controls drawn from several investigations including the Comorbidity and Trauma Study, Heroin Dependence in Western Australia, the OZ-ALC Study, a twin study of mole development in adolescence and genetic studies of substance dependence at Yale; its data, collected from 2004 to 2009, are held in dbGaP as phs000277.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6488</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ICGHD</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">International Consortium on the Genetics of Heroin Dependence</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21841">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005367"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002595"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21841"/>
        <obo:IAO_0000116>heroin dependence</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v2.p1</oboInOwl:hasDbXref>
        <rdfs:comment>The project uses a case-control design in which cases met lifetime DSM-IV criteria for heroin dependence.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002595"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000841"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v2.p1</oboInOwl:hasDbXref>
        <rdfs:comment>This collaboration of Australian and American investigators aims to identify genes associated with liability for heroin dependence. The project uses a case-control design in which cases met lifetime DSM-IV criteria for heroin dependence. Controls included assessed individuals who did not meet DSM-IV heroin dependence criteria and unassessed general population controls. Cases and controls were obtained from the several large investigations including: The Comorbidity and Trauma Study, Heroin Dependence in Western Australia, the OZ-ALC Study, a Twin Study of Mole Development in Adolescence, and ongoing genetic studies of substance dependence conducted by investigators at Yale and collaborating institutions.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002595"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001573"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v2.p1</oboInOwl:hasDbXref>
        <rdfs:comment>This collaboration of Australian and American investigators aims to identify genes associated with liability for heroin dependence. The project uses a case-control design in which cases met lifetime DSM-IV criteria for heroin dependence. Controls included assessed individuals who did not meet DSM-IV heroin dependence criteria and unassessed general population controls. Cases and controls were obtained from the several large investigations including: The Comorbidity and Trauma Study, Heroin Dependence in Western Australia, the OZ-ALC Study, a Twin Study of Mole Development in Adolescence, and ongoing genetic studies of substance dependence conducted by investigators at Yale and collaborating institutions.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002595"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001896"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5656555/</oboInOwl:hasDbXref>
        <rdfs:comment>The ICGHD data set consisted of three subsets (CIDR: Center for Inherited Disease Research; RATRP: Research on Alcohol and Tobacco Related Phenotypes; and ARC: Alcohol Related Conditions) that were genotyped using three different arrays.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002595"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001897"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5656555/</oboInOwl:hasDbXref>
        <rdfs:comment>The ICGHD data set consisted of three subsets (CIDR: Center for Inherited Disease Research; RATRP: Research on Alcohol and Tobacco Related Phenotypes; and ARC: Alcohol Related Conditions) that were genotyped using three different arrays.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002595"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001898"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5656555/</oboInOwl:hasDbXref>
        <rdfs:comment>The ICGHD data set consisted of three subsets (CIDR: Center for Inherited Disease Research; RATRP: Research on Alcohol and Tobacco Related Phenotypes; and ARC: Alcohol Related Conditions) that were genotyped using three different arrays.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002595"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27028160</owl:annotatedTarget>
        <dcterms:title>Genome-wide Association Study of Cannabis Dependence Severity, Novel Risk Variants, and Shared Genetic Risks.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27028160</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27028160+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This genome-wide association study for DSM-IV CAD criterion count was performed in 3 independent substance dependence cohorts (the Yale-Penn Study, Study of Addiction: Genetics and Environment [SAGE], and International Consortium on the Genetics of Heroin Dependence [ICGHD]).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002595"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collaboration of Australian and American investigators to identify genes associated with liability for heroin dependence, using a case–control design in which cases met lifetime DSM-IV criteria for heroin dependence and controls were assessed individuals without heroin dependence or unassessed general population controls, with cases and controls drawn from several investigations including the Comorbidity and Trauma Study, Heroin Dependence in Western Australia, the OZ-ALC Study, a twin study of mole development in adolescence and genetic studies of substance dependence at Yale; its data, collected from 2004 to 2009, are held in dbGaP as phs000277.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27028160</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v2.p1</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
