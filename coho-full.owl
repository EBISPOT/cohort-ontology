        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002002"/>
        <obo:IAO_0000112>PGS003860</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:31152163</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study of a genetic isolate in the Ogliastra region of Sardinia, Italy, in which the inhabitants of ten villages (Baunei, Escalaplano, Loceri, Perdasdefogu, Seui, Seulo, Talana, Triei, Urzulei and Ussassai), invited by public proclamations and letters to every family, took part from 2002 to 2008 in a cross-sectional epidemiological survey with blood sampling and extended pedigrees, to study the genetic and environmental determinants of complex traits.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12517</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>OGP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ogliastra Genetic Park Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Ogliastra Genetic Park</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002201"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3012770/</oboInOwl:hasDbXref>
        <rdfs:comment>We analyzed data from 12,517 inhabitants of the Ogliastra region, in central eastern Sardinia, Italy (Figure 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002201"/>
