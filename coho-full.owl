    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002680">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Uganda"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:40018598</obo:IAO_0000112>
        <obo:IAO_0000115>A health and demographic surveillance system following the largely rural population of villages in the Iganga and Mayuge districts of eastern Uganda, established in the mid-2000s by Makerere University with the two districts and Karolinska Institutet and run by the Makerere University Centre for Health and Population Research, which records pregnancies, births, deaths and other events in census rounds and links household data with health facility records, as a platform for population health research and research training.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>IM-HDSS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IMHDSS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IMHDSS, Uganda</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Iganga Mayuge HDSS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Iganga Mayuge HDSS, Makerere University Centre for Health and Population Research (MUCHAP)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Iganga-Mayuge HDSS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Iganga-Mayuge Health and Demographic Surveillance Sites</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Iganga-Mayuge health and demographic surveillance site</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Iganga-Mayuge Health and Demographic Surveillance Site</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://muchap.org/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002680"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Uganda"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9012358/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>IM-HDSS is in Eastern Uganda and covers the districts of Iganga and Mayuge managed by the Makerere University Centre for health and population research (MUCHAP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002680"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40018598</owl:annotatedTarget>
        <dcterms:title>Understanding the demographic and socioeconomic determinants of morbidity in Eastern Uganda: a retrospective analysis of the Iganga-Mayuge health and demographic surveillance data.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40018598</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11816860/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study was conducted within the population cohort of Iganga-Mayuge Health and Demographic Surveillance Sites (IMHDSS) located in eastern Uganda.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002680"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A health and demographic surveillance system following the largely rural population of villages in the Iganga and Mayuge districts of eastern Uganda, established in the mid-2000s by Makerere University with the two districts and Karolinska Institutet and run by the Makerere University Centre for Health and Population Research, which records pregnancies, births, deaths and other events in census rounds and links household data with health facility records, as a platform for population health research and research training.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28799450</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35427403</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40018598</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
