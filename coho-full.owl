    <!-- http://www.ebi.ac.uk/coho/COHO_0002377 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002377">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. SHMC is the PGS Catalog&apos;s id for the Chaim Sheba Medical Center (Tel Hashomer, Ramat Gan, Israel) as a CIMBA contributing site: the BRCA1 and BRCA2 pathogenic-variant carriers from its oncogenetics unit that entered the OCAC/CIMBA ovarian cancer GWAS (PMID:28346442) and CIMBA&apos;s PRS analyses (PMID:32665703). CIMBA&apos;s own lists name the study only after the hospital (&apos;Sheba Medical Centre&apos;, &apos;SMC-CIMBA&apos;), and no source gives it a name, design or recruitment of its own. This is the same case as LUHR (E651, Landspitali), so it is not a cohort. No COHO term covers it; CIMBA is COHO:0000901. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Sheba Medical Centre</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002378 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002378">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20217"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000764"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South-Eastern_Asia"/>
        <obo:IAO_0000112>PMID:39051044</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based eye study of ethnic Indian and ethnic Chinese adults aged 40 years and older living in south-western Singapore, sampled by age-stratified random sampling from name lists provided by the Ministry of Home Affairs and examined with standardised interviews, eye examinations and laboratory investigations, with blood, tear and urine samples stored for genetic and proteomic studies, to quantify ethnic differences in the prevalence, risk factors and impact of major eye diseases; its Indian component is the Singapore Indian Eye Study, and together with the Singapore Malay Eye Study it covers Singapore&apos;s three main ethnic groups.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6753</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SICC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Indian Chinese Cohort (SICC) Eye Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Indian Chinese Cohort Eye Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Indian Chinese cohort eye study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Singapore Indian Chinese Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20217">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005328"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002378"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20217"/>
        <obo:IAO_0000116>eye diseases</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19995197+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In conjunction with the Singapore Malay Eye Study, the SICC study will permit an in-depth evaluation of the prevalence, risk factors, and impact of major eye diseases in Chinese, Indians and Malays, three distinct Asian ethnic groups, whose combined numbers represent half the world&apos;s population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002378"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19995197+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This report summarizes the rationale and study design of the Singapore Indian Chinese Cohort (SICC) Eye Study, a population-based study of ethnic South Asian (Indians) and East Asian (Chinese) older adults in Singapore.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002378"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39051044</owl:annotatedTarget>
        <dcterms:title>Contributions of Lipid-Related Metabolites and Complement Proteins to Early and Intermediate Age-Related Macular Degeneration.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39051044</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11268342/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The analyses were performed in a subset of the Singapore Indian Chinese Cohort (SICC) Eye Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002378"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based eye study of ethnic Indian and ethnic Chinese adults aged 40 years and older living in south-western Singapore, sampled by age-stratified random sampling from name lists provided by the Ministry of Home Affairs and examined with standardised interviews, eye examinations and laboratory investigations, with blood, tear and urine samples stored for genetic and proteomic studies, to quantify ethnic differences in the prevalence, risk factors and impact of major eye diseases; its Indian component is the Singapore Indian Eye Study, and together with the Singapore Malay Eye Study it covers Singapore&apos;s three main ethnic groups.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19995197</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23964661</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39051044</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002378"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6753</owl:annotatedTarget>
        <obo:IAO_0000116>Indian and Chinese adults aged 40 and over examined in the SICC Eye Study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11268342/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Singapore Indian Chinese Cohort is a prospective population-based study of 6753 subjects aged ≥40 years.</rdfs:comment>
    </owl:Axiom>
