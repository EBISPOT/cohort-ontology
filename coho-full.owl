        <oboInOwl:hasRelatedSynonym>SEARCH-DY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>search</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">SEARCH for Diabetes in Youth</rdfs:label>
    </owl:NamedIndividual>
