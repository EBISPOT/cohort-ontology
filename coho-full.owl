        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10891016+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 545 high-risk infants (at least 1 first-degree relative with asthma or 2 first-degree relatives with other IgE-mediated allergic diseases) identified before birth.</rdfs:comment>
    </owl:Axiom>
