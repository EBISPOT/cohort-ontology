    <!-- http://www.ebi.ac.uk/coho/COHO_0000335 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000335">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid3025"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Ghana"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Nigeria"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Western_Africa"/>
        <obo:IAO_0000112>EGAS00001007331</obo:IAO_0000112>
        <obo:IAO_0000115>An H3Africa case-control study of stroke in sub-Saharan Africa that recruits stroke cases and matched controls at hospital and community sites in Ghana and Nigeria to evaluate genetic and environmental risk factors for stroke in people of African ancestry.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3684</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3684</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7368</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SIREN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stroke Investigative Research and Educational Network</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <rdfs:label xml:lang="en">Stroke Investigative Research and Education Network</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid3025">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005098"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000335"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid3025"/>
        <obo:IAO_0000116>stroke</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10840175/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Herein, we report the findings of the first stroke GWAS performed in an indigenous African population of 3434 subjects (1691 ischemic stroke cases and 1743 stroke-free controls) from the SIREN Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000335"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An H3Africa case-control study of stroke in sub-Saharan Africa that recruits stroke cases and matched controls at hospital and community sites in Ghana and Nigeria to evaluate genetic and environmental risk factors for stroke in people of African ancestry.</owl:annotatedTarget>
        <obo:IAO_0000119>https://ega-archive.org/studies/EGAS00001007331</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000335"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3684</owl:annotatedTarget>
        <obo:IAO_0000116>1:1 matched stroke cases and stroke-free controls analysed in a 2026 SIREN report</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13169920/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To ensure accurate comparisons and minimize confounding, stroke cases were matched with stroke-free controls at a 1:1 ratio on key demographic factors known to confound stroke epidemiology, including age (± 5 years), sex, and ethnicity, for a total of 7368 participants (3684 cases and 3684 controls) in this study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000335"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3684</owl:annotatedTarget>
