    <!-- http://www.ebi.ac.uk/coho/COHO_0000993 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000993">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
