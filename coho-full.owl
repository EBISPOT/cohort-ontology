        <rdf:type rdf:nodeID="genid20380"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>PGS000866</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:29280273</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, controlled intervention study in Sweden in which severely obese adults aged 37 to 60, recruited between 1987 and 2001, either underwent bariatric surgery or received usual obesity care as a matched control group, and were followed long term for the effects of surgically induced weight loss.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4047</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SOS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Swedish Obese Subjects study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Swedish Obese Subjects Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20380">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011122"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002401"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20380"/>
        <obo:IAO_0000116>severe obesity</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5900872/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SOS is a prospective study comparing the effects of bariatric surgery and usual care in severely obese individuals in Sweden 22.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002401"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5900872/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SOS is a prospective study comparing the effects of bariatric surgery and usual care in severely obese individuals in Sweden 22.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002401"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000866</owl:annotatedTarget>
        <dcterms:title>Causal relationship of hepatic fat with liver damage and insulin resistance in nonalcoholic fatty liver.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29280273</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002401"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29280273</owl:annotatedTarget>
        <dcterms:title>Causal relationship of hepatic fat with liver damage and insulin resistance in nonalcoholic fatty liver.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29280273</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29280273+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We evaluated complementary cohorts of at-risk individuals and individuals from the general population: 1515 from the liver biopsy cohort (LBC), 3329 from the Swedish Obese Subjects Study (SOS) and 4570 from the population-based Dallas Heart Study (DHS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002401"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, controlled intervention study in Sweden in which severely obese adults aged 37 to 60, recruited between 1987 and 2001, either underwent bariatric surgery or received usual obesity care as a matched control group, and were followed long term for the effects of surgically induced weight loss.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17715408</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29280273</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42001100</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002401"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4047</owl:annotatedTarget>
        <obo:IAO_0000116>individuals with obesity included 1987-2001 (surgery group and matched usual-care control group)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13093930/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Between September 1, 1987, and January 31, 2001, a total of 4047 individuals with obesity were included in the study, which was conducted at 25 public surgical departments and 480 primary health-care centers across Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002401"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SOS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
