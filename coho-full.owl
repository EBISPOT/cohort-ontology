        <obo:IAO_0000116>fallopian tube cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7619263/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study participants included women clinically diagnosed with ovarian, fallopian, or primary peritoneal cancer, recruited from two cohorts:</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002103"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
