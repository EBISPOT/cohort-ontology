        <obo:IAO_0000112>PMID:30199412</obo:IAO_0000112>
        <obo:IAO_0000115>An occupational cohort of the employees of employers in Belgium that chose IDEWE as their External Service for Prevention and Protection at Work, followed from 1993 through the records of their legally required occupational health surveillance. IDEWE pools the records in a data warehouse for research on work-related diseases and sector-specific health problems.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">773900</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/Precube</oboInOwl:hasDbXref>
