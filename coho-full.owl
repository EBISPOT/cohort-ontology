    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001375"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12445"/>
        <obo:IAO_0000116>multiple myeloma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3639680/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the MRC Myeloma IX trial, adult patients of age 18 years or older who had newly diagnosed and histologically confirmed symptomatic multiple myeloma were enrolled from 120 centres in the UK.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001375"/>
