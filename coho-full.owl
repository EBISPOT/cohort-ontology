    <!-- http://www.ebi.ac.uk/coho/COHO_0002581 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002581">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21753"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:36786861</obo:IAO_0000112>
        <obo:IAO_0000115>A regional hospital-based register of patients admitted with acute stroke to cooperating hospitals in Westphalia, north-west Germany, with departments of neurology, internal medicine and geriatric medicine taking part, which records a standardised data set of sociodemographic and clinical characteristics, diagnostic and treatment procedures, complications and status at discharge; its case ascertainment was part of the German Competence Net Stroke, and consecutive consenting ischaemic stroke patients recruited through it have been used in genetic studies of stroke.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12410</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>WSR</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Westphalian Stroke Register</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21753">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005098"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002581"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21753"/>
        <obo:IAO_0000116>acute stroke</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12721875+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We used data of 12,410 patients from the Westphalian Stroke Register for the years 2000 and 2001.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002581"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
