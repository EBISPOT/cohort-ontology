        <obo:IAO_0000116>SDGS discovery genome-wide scan cases and controls</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>VU/SCI SDGS Chinese 1019 1710 2729 Population-based</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002356"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1710</owl:annotatedTarget>
        <obo:IAO_0000116>SDGS discovery genome-wide scan cases and controls</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
