        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41591-025-03827-z/MediaObjects/41591_2025_3827_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>GRCCDS | Genomic Research Cohorts for CCMB Diabetes Study | SAS | 2219</rdfs:comment>
