    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002178">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18784"/>
        <rdf:type rdf:nodeID="genid18786"/>
        <rdf:type rdf:nodeID="genid18788"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>PGS002291</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:35414057</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of nasopharyngeal carcinoma in southern China, in which incident cases aged 20–74 years were recruited from March 2010 to December 2013, and randomly selected population controls from November 2010 to November 2014, among residents of 13 cities and counties of Guangdong Province and Guangxi Autonomous Region, with questionnaires and biospecimens collected to study the independent and interactive roles of genes, environmental exposures and Epstein–Barr virus infection in the disease; it was conducted by Sun Yat-sen University Cancer Center, Karolinska Institutet, Guangxi Medical University and collaborating institutions.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2554</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2648</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>NPC Genes, Environment, and EBV cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NPC genes, environment, and EBV</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NPCGEE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nasopharyngeal carcinoma Genes, Environment, and EBV study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">NPC Genes, Environment, and EBV study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18784">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0015459"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid18786">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_3000273"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid18788">
