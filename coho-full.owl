    <!-- http://www.ebi.ac.uk/coho/COHO_0000220 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000220">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid2265"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>EGAS00001006276</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of Australian children with acute myeloid leukaemia whose exomes were analysed for rare germline variants in cancer predisposition genes, compared with the Medical Genome Reference Bank and the TARGET cohort.</obo:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <rdfs:label xml:lang="en">Australian childhood AML cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid2265">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0018874"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000220"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2265"/>
        <obo:IAO_0000116>acute myeloid leukaemia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001006276</oboInOwl:hasDbXref>
        <rdfs:comment>The prevalence of extremely rare variants in the combined childhood AML cohort (n=72) was compared to that in the Medical Genome Reference Bank (MGRB; n=2570) comprising individuals aged at least 70 years with no history of cardiovascular disease, dementia or cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000220"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001006276</oboInOwl:hasDbXref>
        <rdfs:comment>Overall, 21% of the Australian cohort and 25% of the TARGET cohort presented germline variants</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
