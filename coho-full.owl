        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002745"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised crossover pilot trial in which healthy adults ate two-week diets high or low in plant bioactives, with matched total fibre and separated by a four-week washout, to assess changes in the gut microbiome and in urinary and faecal metabolites.</owl:annotatedTarget>
        <obo:IAO_0000119>https://doi.org/10.1101/2025.10.16.25338140</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
