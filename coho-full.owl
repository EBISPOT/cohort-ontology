    <!-- http://www.ebi.ac.uk/coho/COHO_0002676 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002676">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Iran"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:42467699</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing nationwide population-based prospective cohort of adults aged 35–70 years living in 18 regions of Iran chosen to cover its ethnic, environmental and socioeconomic diversity, enrolled since 2014 through a network of Iranian medical universities coordinated by the Digestive Diseases Research Institute of Tehran University of Medical Sciences, with a biobank, to study environmental, lifestyle and genetic determinants of non-communicable diseases.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">170564</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PERSIAN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PERSIAN Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PERSIAN Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PERSIAN cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prospective Epidemiological Research Studies in IrAN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Prospective Epidemiological Research Studies in Iran</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://persiancohort.com"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002676"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Iran"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12645788/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The adult cohort includes Iranian residents aged 35–70 from 18 diverse regions, capturing the country’s ethnic, environmental, and socioeconomic diversity.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002676"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42467699</owl:annotatedTarget>
        <dcterms:title>Epidemiology and determinants of dyslipidemia in Iranian population: Results from the PERSIAN cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42467699</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13379098/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The current study used the data of a very large cross-sectional survey, Prospective Epidemiological Research Studies in IrAN (PERSIAN), including 163,770 Iranians aged 35–70 years from 18 distinct areas across Iran, between 2014 and 2020.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002676"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing nationwide population-based prospective cohort of adults aged 35–70 years living in 18 regions of Iran chosen to cover its ethnic, environmental and socioeconomic diversity, enrolled since 2014 through a network of Iranian medical universities coordinated by the Digestive Diseases Research Institute of Tehran University of Medical Sciences, with a biobank, to study environmental, lifestyle and genetic determinants of non-communicable diseases.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:41286709</obo:IAO_0000119>
