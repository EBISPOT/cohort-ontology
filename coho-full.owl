        <owl:annotatedTarget rdf:nodeID="genid21396"/>
        <obo:IAO_0000116>cigarette smoking</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35170738+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Study participants came from the Transdisciplinary Tobacco Use Research Centers (TTURCs) Study (1091 smokers of European descent), and the Genetically Informed Smoking Cessation Trial (GISC) Study (501 smokers of European descent).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002536"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21398"/>
        <obo:IAO_0000116>nicotine dependence</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4930126/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>UW-TTURC participants were recruited for nicotine dependence and smoking cessation treatment clinical trials in Madison and Milwaukee, Wisconsin beginning in 2001</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002536"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4930126/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>UW-TTURC participants were recruited for nicotine dependence and smoking cessation treatment clinical trials in Madison and Milwaukee, Wisconsin beginning in 2001</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002536"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:35170738</owl:annotatedTarget>
        <dcterms:title>The Promise of Polygenic Risk Prediction in Smoking Cessation: Evidence From Two Treatment Trials.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35170738</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC9575976/</oboInOwl:hasDbXref>
        <rdfs:comment>Study participants came from the Transdisciplinary Tobacco Use Research Centers (TTURCs) Study (1091 smokers of European descent), and the Genetically Informed Smoking Cessation Trial (GISC) Study (501 smokers of European descent).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002536"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomized, placebo-controlled smoking cessation trial of the University of Wisconsin Transdisciplinary Tobacco Use Research Center, run at the University of Wisconsin Center for Tobacco Research and Intervention with participants recruited in Madison and Milwaukee, Wisconsin, United States, in which adults who smoked 10 or more cigarettes a day and were motivated to quit were randomly assigned to placebo, nicotine patch, nicotine lozenge, sustained-release bupropion or a combination, and whose genotyped participants are used in genetic studies of nicotine dependence and smoking cessation.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26440539</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35170738</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3433845/unicode</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002536"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1504</owl:annotatedTarget>
        <obo:IAO_0000116>adults randomised in the trial</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:19884613</oboInOwl:hasDbXref>
        <rdfs:comment>One thousand five hundred four adults who smoked at least 10 cigarettes per day during the past 6 months and reported being motivated to quit smoking.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002536"/>
