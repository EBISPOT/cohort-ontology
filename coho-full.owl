    <!-- http://www.ebi.ac.uk/coho/COHO_0001564 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001564">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14131"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000768"/>
        <obo:IAO_0000112>PMID:29117387</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control study of more aggressive prostate cancer in men recruited from 2001 to 2004 at the major medical institutions of Cleveland, Ohio, United States (the Cleveland Clinic, University Hospitals of Cleveland and their affiliates), in which cases were newly diagnosed, histologically confirmed prostate cancers of higher grade, stage or prostate-specific antigen level, and age-matched controls were men without prostate cancer undergoing standard annual medical examinations at the same institutions, to study genetic and environmental risk factors for aggressive prostate cancer.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1012</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CaP Genes</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CaP_Genes</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Prostate Cancer Genetics Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14131">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001564"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14131"/>
        <obo:IAO_0000116>aggressive prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3102736/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We also included an additional 163 African American controls from the MEC that were frequency matched to cases on age.Prostate Cancer Genetics Study (CaP Genes)The African American component of this study population comprised 160 men: 75 cases diagnosed with more aggressive prostate cancer and 85 age-matched controls [38].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001564"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3102736/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All subjects were recruited and frequency-matched on the major medical institutions in Cleveland, Ohio (i.e., the Cleveland Clinic, University Hospitals of Cleveland, and their affiliates) between 2001 and 2004.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001564"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29117387</owl:annotatedTarget>
        <dcterms:title>Two Novel Susceptibility Loci for Prostate Cancer in Men of African Ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29117387</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5448553/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Prostate Cancer Genetics Study CaP Genes AAPC GWAS 75 85 71 85 Case-control, Cleveland, OH, U.S.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001564"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case–control study of more aggressive prostate cancer in men recruited from 2001 to 2004 at the major medical institutions of Cleveland, Ohio, United States (the Cleveland Clinic, University Hospitals of Cleveland and their affiliates), in which cases were newly diagnosed, histologically confirmed prostate cancers of higher grade, stage or prostate-specific antigen level, and age-matched controls were men without prostate cancer undergoing standard annual medical examinations at the same institutions, to study genetic and environmental risk factors for aggressive prostate cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16931544</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21602798</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21637779</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001564"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1012</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls in the 2001-2004 Cleveland case-control study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16931544+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To investigate this, the authors undertook a case-control study (n = 1,012) of the association between NSAIDs and more advanced prostate cancer in Ohio men recruited between 2001 and 2004 and evaluated whether this association was modified by a functional polymorphism in the lymphotoxin alpha (LTA) gene (LTA C+80A, where the CC genotype results in higher LTA production).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001564"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CaP Genes</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
