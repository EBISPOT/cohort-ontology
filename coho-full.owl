    <!-- http://www.ebi.ac.uk/coho/COHO_0001616 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001616">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14575"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001893"/>
        <obo:IAO_0000112>PMID:38672660</obo:IAO_0000112>
        <obo:IAO_0000115>A web-based multicentre breast cancer registry developed at the University of Nebraska Medical Center&apos;s Eppley Cancer Center in Omaha, Nebraska, United States, and maintained by the Fred &amp; Pamela Buffett Cancer Center as part of its integrated Cancer Repository for Cancer Research (iCaRe2), into which participating cancer centres in the US Midwest enrol breast cancer patients, breast cancer survivors and women at increased risk of breast cancer. Under common protocols it collects questionnaire data on demographic, medical, family, lifestyle, dietary and environmental factors, clinical and follow-up data and biospecimens for research on breast cancer diagnosis, prevention, treatment and survivorship.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4945</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BCCR</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Breast Cancer Collaborative Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14575">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001616"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14575"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21918596+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Currently, seven cancer institutions are participating in the BCCR that contains data on almost 900 subjects (BC patients and survivors, as well as individuals at high risk of getting BC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001616"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11048743/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The US-based BC-positive cases (n = 321) were sourced from the integrated Cancer Repository for Cancer Research (iCaRe2) and the Breast Cancer Collaborative Registry (BCCR), situated in the Midwestern United States [19].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001616"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38672660</owl:annotatedTarget>
        <dcterms:title>Breast Cancer Polygenic Risk Score Validation and Effects of Variable Imputation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38672660</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11048743/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The US-based BC-positive cases (n = 321) were sourced from the integrated Cancer Repository for Cancer Research (iCaRe2) and the Breast Cancer Collaborative Registry (BCCR), situated in the Midwestern United States [19].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001616"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A web-based multicentre breast cancer registry developed at the University of Nebraska Medical Center&apos;s Eppley Cancer Center in Omaha, Nebraska, United States, and maintained by the Fred &amp; Pamela Buffett Cancer Center as part of its integrated Cancer Repository for Cancer Research (iCaRe2), into which participating cancer centres in the US Midwest enrol breast cancer patients, breast cancer survivors and women at increased risk of breast cancer. Under common protocols it collects questionnaire data on demographic, medical, family, lifestyle, dietary and environmental factors, clinical and follow-up data and biospecimens for research on breast cancer diagnosis, prevention, treatment and survivorship.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21918596</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31303884</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37454130</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001616"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
