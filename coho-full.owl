    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001376"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genomic database drawn from the second phase of the 2016 Mexican National Survey of Tobacco, Alcohol, and Drug Use (Encodat 2016), a nationwide household survey that excluded regions where most people speak a Native American language, whose participants answered questionnaires on substance use and psychiatric symptoms and gave buccal DNA samples, assembled by Mexico&apos;s National Institute of Psychiatry Ramón de la Fuente Muñiz and National Institute of Genomic Medicine for genetic studies of addiction and related psychiatric and pharmacogenetic traits.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32390825</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
