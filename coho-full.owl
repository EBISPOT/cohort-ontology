    <!-- http://www.ebi.ac.uk/coho/COHO_0002456 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002456">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20896"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000854"/>
        <obo:IAO_0000112>PMID:21908515</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case–control study of breast cancer in Tianjin, China, whose cases were women with histopathologically diagnosed primary breast cancer recruited consecutively from the Department of Breast Surgery of Tianjin Cancer Institute and Hospital, Tianjin Medical University, and whose controls were women without evidence of cancer who attended health screening at the same hospital, frequency-matched to the cases on age; all participants were unrelated ethnic Han Chinese women who were permanent residents of urban Tianjin. Its study period was 2004 to 2008, and it is one of the participating studies of the Asia Breast Cancer Consortium.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1532</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1583</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3115</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Tianjin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tianjin study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Tianjin Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20896">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002456"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20896"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://link.springer.com/article/10.1007/s10549-008-9998-0</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were all histopathologically diagnosed with primary breast cancer and were consecutively recruited from the Department of Breast Surgery of Tianjin Cancer Institute and Hospital, Tianjin Medical University, China, between December 2004 and August 2005.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002456"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3221542/</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the consortium included 20 114 Chinese women from eight studies conducted in the following locations: Shanghai, China [n= 10 097; SBCS Phase I (SBCS-I) (7,28) and Phase II (SBCS-II) (7), Shanghai Breast Cancer Survival Study (SBCSS)/Shanghai Endometrial Cancer Study (SECS, only SECS controls were included in the current study) (7)], Tianjin, China [n= 3095 (29)]</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002456"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21908515</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies breast cancer risk variant at 10q21.2: results from the Asia Breast Cancer Consortium.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21908515</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3221542/</oboInOwl:hasDbXref>
        <rdfs:comment>TaqMan genotyping assay reagents were provided to the investigators of the Tianjin study (Tianjin Cancer Institute and Hospital), Nanjing study (Nanjing Medical University), Guangzhou study (Sun Yat-sen University) and MEC study (University of Southern California), who conducted genotyping assays at their own laboratories.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002456"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case–control study of breast cancer in Tianjin, China, whose cases were women with histopathologically diagnosed primary breast cancer recruited consecutively from the Department of Breast Surgery of Tianjin Cancer Institute and Hospital, Tianjin Medical University, and whose controls were women without evidence of cancer who attended health screening at the same hospital, frequency-matched to the cases on age; all participants were unrelated ethnic Han Chinese women who were permanent residents of urban Tianjin. Its study period was 2004 to 2008, and it is one of the participating studies of the Asia Breast Cancer Consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18629629</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21908515</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002456"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1532</owl:annotatedTarget>
        <obo:IAO_0000116>women of the Tianjin study (breast cancer cases and hospital controls) in the Asia Breast Cancer Consortium&apos;s 2010 GWAS replication</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2891809/</oboInOwl:hasDbXref>
        <rdfs:comment>Tianjin (Chinese) 1,532 51.7±11.4 1,583 51.9±10.5</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002456"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1583</owl:annotatedTarget>
        <obo:IAO_0000116>women of the Tianjin study (breast cancer cases and hospital controls) in the Asia Breast Cancer Consortium&apos;s 2010 GWAS replication</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2891809/</oboInOwl:hasDbXref>
        <rdfs:comment>Tianjin (Chinese) 1,532 51.7±11.4 1,583 51.9±10.5</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002456"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3115</owl:annotatedTarget>
        <obo:IAO_0000116>women of the Tianjin study (breast cancer cases and hospital controls) in the Asia Breast Cancer Consortium&apos;s 2010 GWAS replication</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2891809/</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the consortium included 19,796 Chinese women from seven studies conducted in Shanghai [6], [9] (three studies, n = 10,497), Tianjin [10] (n = 3,115)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002456"/>
