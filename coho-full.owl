    <!-- http://www.ebi.ac.uk/coho/COHO_0001079 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001079">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid9885"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000829"/>
        <obo:IAO_0000112>GCST90244158</obo:IAO_0000112>
        <obo:IAO_0000115>A French case-control study of venous thrombosis whose cases, from medical centres in Grenoble, Marseille, Montpellier and Paris, had a documented idiopathic deep vein thrombosis or pulmonary embolism before the age of 50 without acquired risk factors or major thrombophilia defects, and whose controls were healthy French participants of the SU.VI.MAX study. It was genotyped genome-wide for genetic association studies of venous thrombosis.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">411</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1228</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>EOVT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Early Onset Venous Thrombosis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Early-Onset Venous Thrombosis</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9885">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005399"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001079"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9885"/>
        <obo:IAO_0000116>venous thrombosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10506044/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Early Onset Venous Thrombosis (EOVT) study was a case-control sample of 339 patients with VTE and 1327 healthy French persons from the Suvimax study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001079"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3607886/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This work was based on two French GWAS on VT, the Early-Onset Venous Thrombosis (EOVT) and the Marseille Thrombosis Association (MARTHA) studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001079"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244158</owl:annotatedTarget>
        <dcterms:title>Cross-Ancestry Investigation of Venous Thromboembolism Genomic Predictors.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36154123</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001079"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A French case-control study of venous thrombosis whose cases, from medical centres in Grenoble, Marseille, Montpellier and Paris, had a documented idiopathic deep vein thrombosis or pulmonary embolism before the age of 50 without acquired risk factors or major thrombophilia defects, and whose controls were healthy French participants of the SU.VI.MAX study. It was genotyped genome-wide for genetic association studies of venous thrombosis.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21980494</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23509962</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37399490</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001079"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">411</owl:annotatedTarget>
        <obo:IAO_0000116>VT patients and healthy SU.VI.MAX controls in the EOVT GWAS (2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3607886/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The EOVT case–control study included 411 patients and 1,228 healthy subjects, while MARTHA was composed of 1,542 patients and 1,110 healthy subjects, all the individuals being of European origin, with the majority being of French descent.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001079"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1228</owl:annotatedTarget>
        <obo:IAO_0000116>VT patients and healthy SU.VI.MAX controls in the EOVT GWAS (2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3607886/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The EOVT case–control study included 411 patients and 1,228 healthy subjects, while MARTHA was composed of 1,542 patients and 1,110 healthy subjects, all the individuals being of European origin, with the majority being of French descent.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001079"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EOVT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001080 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001080">
