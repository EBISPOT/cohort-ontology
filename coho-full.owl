        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1101</owl:annotatedTarget>
        <obo:IAO_0000116>invasive breast cancer cases and controls recruited in Ibadan 1998-2009</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:20716701</oboInOwl:hasDbXref>
        <rdfs:comment>Between 1998 and 2009, 1,233 invasive breast cancer cases and 1,101 controls were recruited.</rdfs:comment>
    </owl:Axiom>
