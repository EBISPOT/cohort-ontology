    <!-- http://www.ebi.ac.uk/coho/COHO_0001371 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001371">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid12404"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90315948</obo:IAO_0000112>
        <obo:IAO_0000115>A research tissue bank of the Manchester Cancer Research Centre, established in 2008 and run from The Christie NHS Foundation Trust, that collects tissue, blood and other samples, with consent to use them and data about the donors for research, from patients at four NHS trusts in Greater Manchester, mainly people undergoing surgery where cancer is a possible diagnosis, to supply samples for cancer research.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MCRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MCRC Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MCRCB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Manchester Cancer Research Centre</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Manchester Cancer Research Centre Biobank</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12404">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004992"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001371"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12404"/>
        <obo:IAO_0000116>cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/manchester-cancer-research-centre-biobank-2/</oboInOwl:hasDbXref>
        <rdfs:comment>The Biobank will collect tissue, blood and other samples from patients admitted to hospitals in the Greater Manchester area, who are undergoing an operation to remove tissue where cancer is a possible diagnosis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001371"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/manchester-cancer-research-centre-biobank-2/</oboInOwl:hasDbXref>
        <rdfs:comment>The Biobank will collect tissue, blood and other samples from patients admitted to hospitals in the Greater Manchester area, who are undergoing an operation to remove tissue where cancer is a possible diagnosis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001371"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90315948</owl:annotatedTarget>
        <dcterms:title>Validation of lung cancer polygenic risk scores in a high-risk case-control cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37154150</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001371"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A research tissue bank of the Manchester Cancer Research Centre, established in 2008 and run from The Christie NHS Foundation Trust, that collects tissue, blood and other samples, with consent to use them and data about the donors for research, from patients at four NHS trusts in Greater Manchester, mainly people undergoing surgery where cancer is a possible diagnosis, to supply samples for cancer research.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/manchester-cancer-research-centre-biobank-2/</obo:IAO_0000119>
