    <!-- http://www.ebi.ac.uk/coho/COHO_0002699 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002699">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Austria"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:16234822</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of adult residents of Vorarlberg, the westernmost province of Austria, enrolled from 1985 through a routine risk-factor surveillance and prevention programme run by the Agency for Social and Preventive Medicine, in which local physicians carried out a physical examination, blood test and consultation, and followed by linkage to the Vorarlberg cancer registry and death index to study metabolic and other risk factors for cancer, cardiovascular disease and mortality.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">167371</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>VHM&amp;PP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>VHM&amp;PP Study Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Vorarlberg Health Monitoring and Prevention Program</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Vorarlberg Health Monitoring and Promotion Program</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Vorarlberg Health Monitoring and Prevention Programme</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.i-med.ac.at/msig/vhmpp.html"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002699"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Austria"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361672/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Vorarlberg Health Monitoring and Promotion Program (VHM&amp;PP) is carried out in Vorarlberg, the westernmost province of Austria.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002699"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:16234822</owl:annotatedTarget>
        <dcterms:title>Obesity and incidence of cancer: a large cohort study of over 145,000 adults in Austria.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:16234822</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2361672/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Between 1985 and 2001, 167 371 adult Vorarlberg residents were enrolled in the VHM&amp;PP Study Cohort after signing an informed consent to store and process personal data (height, weight, smoking and other factors).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002699"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of adult residents of Vorarlberg, the westernmost province of Austria, enrolled from 1985 through a routine risk-factor surveillance and prevention programme run by the Agency for Social and Preventive Medicine, in which local physicians carried out a physical examination, blood test and consultation, and followed by linkage to the Vorarlberg cancer registry and death index to study metabolic and other risk factors for cancer, cardiovascular disease and mortality.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16234822</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19380371</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002699"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">167371</owl:annotatedTarget>
        <obo:IAO_0000116>adult residents enrolled 1985-2001</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:16234822</oboInOwl:hasDbXref>
        <rdfs:comment>Between 1985 and 2001, 167 371 adult Vorarlberg residents were enrolled in the VHM&amp;PP Study Cohort after signing an informed consent to store and process personal data (height, weight, smoking and other factors).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002699"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
