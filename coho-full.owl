        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3494732/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, incident prostate cancer cases were identified by cohort linkage to Surveillance, Epidemiology and End Results cancer registries covering Hawaii and California.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001196"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000957"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8148035/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>GWAS of prostate cancer in Latinos (LAPC GWAS) and Japanese (JAPC GWAS) in the Multiethnic Cohort Study (MEC)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001196"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90274716</owl:annotatedTarget>
        <dcterms:title>Characterizing prostate cancer risk through multi-ancestry genome-wide discovery of 187 novel risk variants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37945903</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01534-4/MediaObjects/41588_2023_1534_MOESM4_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>Asian Ancestry Studies JAPC GWAS Asian</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001196"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nested case-control genome-wide association study of prostate cancer in Japanese American men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Japanese component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Japanese men.</owl:annotatedTarget>
