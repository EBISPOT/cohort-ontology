    <!-- http://www.ebi.ac.uk/coho/COHO_0001941 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001941">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17113"/>
        <rdf:type rdf:nodeID="genid17115"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Jamaica"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Latin_America_and_the_Caribbean"/>
        <obo:IAO_0000112>PMID:23554133</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional study of the prevalence of asthma and allergies in Jamaican adolescents whose mothers had been recruited into the Jamaica Perinatal Mortality Survey of 1986, which included all children born in Jamaica in September–October 1986; children from Kingston, St Andrew and St Catherine were contacted at ages 11 and 16 in a child development study and again at 18, and asthma was ascertained with a modified International Study of Asthma and Allergies in Childhood (ISAAC) questionnaire validated in the Jamaican population and, for adults followed in clinic since birth, from medical records. It is one of the asthma genetics studies of the Consortium on Asthma among African-ancestry Populations in the Americas (CAAPA).</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">897</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>JAAS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Jamaican Adolescent Asthma Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17113">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid17115">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005271"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001941"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17113"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Jamaican Adolescent Asthma Study (JAAS) is a cross-sectional study on the prevalence of asthma and allergies in 897 Jamaican adolescents [29].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001941"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17115"/>
        <obo:IAO_0000116>allergies</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Jamaican Adolescent Asthma Study (JAAS) is a cross-sectional study on the prevalence of asthma and allergies in 897 Jamaican adolescents [29].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001941"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Jamaica"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4051322/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>A sample of 706 unrelated individuals (177 asthmatics, 529 nonasthmatic controls) was recruited from Kingston, St. Andrew, and St. Catherine, Jamaica as part of the Jamaican Adolescent Asthma Study as described in supplementary materials and methods and in references.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001941"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23554133</owl:annotatedTarget>
        <dcterms:title>African ancestry is a risk factor for asthma and high total IgE levels in African admixed populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23554133</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4051322/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>A sample of 706 unrelated individuals (177 asthmatics, 529 nonasthmatic controls) was recruited from Kingston, St. Andrew, and St. Catherine, Jamaica as part of the Jamaican Adolescent Asthma Study as described in supplementary materials and methods and in references.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001941"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional study of the prevalence of asthma and allergies in Jamaican adolescents whose mothers had been recruited into the Jamaica Perinatal Mortality Survey of 1986, which included all children born in Jamaica in September–October 1986; children from Kingston, St Andrew and St Catherine were contacted at ages 11 and 16 in a child development study and again at 18, and asthma was ascertained with a modified International Study of Asthma and Allergies in Childhood (ISAAC) questionnaire validated in the Jamaican population and, for adults followed in clinic since birth, from medical records. It is one of the asthma genetics studies of the Consortium on Asthma among African-ancestry Populations in the Americas (CAAPA).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23554133</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms12522/MediaObjects/41467_2016_BFncomms12522_MOESM1276_ESM.pdf</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
