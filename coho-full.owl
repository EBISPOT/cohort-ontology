    <!-- http://www.ebi.ac.uk/coho/COHO_0001952 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001952">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17175"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Tanzania"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000294"/>
        <obo:IAO_0000112>PMID:31844061</obo:IAO_0000112>
        <obo:IAO_0000115>A matched case-control study of severe malaria in children aged 3 months to 10 years in Muheza, Tanga region, north-eastern Tanzania, carried out in 2006–2008 by the Joint Malaria Programme (Kilimanjaro Christian Medical Centre, Moshi) with the London School of Hygiene and Tropical Medicine. Its cases were children admitted to Teule Hospital with severe malaria, recruited within a study of severe febrile illness, and its controls were healthy children from the community individually matched on parental tribal origin, ward of residence and age; its clinical data and DNA samples were contributed to MalariaGEN Consortial Project 1 and used in candidate-gene and genome-wide association studies of severe malaria.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">501</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">504</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>JMPKCMC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Joint Malaria Programme, Kilimanjaro Christian Medical Centre</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Human genetic determinants of severe malaria in North East Tanzania</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17175">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005136"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001952"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17175"/>
        <obo:IAO_0000116>severe malaria</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.malariagen.net/partner_study/human-genetic-determinants-severe-malaria-north-east-tanzania/</oboInOwl:hasDbXref>
        <rdfs:comment>A matched case-control study (children aged 3 months-10 years) was carried out in Muheza, Tanzania between 2006-2008 with the aim of identifying the genes involved in protection against severe malaria, and the sub-phenotypes acidosis, severe malarial anaemia, cerebral malaria, shock, respiratory distress and bacteraemia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001952"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Tanzania"/>
        <oboInOwl:hasDbXref>https://www.malariagen.net/partner_study/human-genetic-determinants-severe-malaria-north-east-tanzania/</oboInOwl:hasDbXref>
        <rdfs:comment>The Joint Malaria Programme together with the London School of Hygiene and Tropical Medicine recruited severe malaria cases and healthy participants from Teule Hospital and community, respectively, in Muheza, North East Tanzania.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001952"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:31844061</owl:annotatedTarget>
        <dcterms:title>Insights into malaria susceptibility using genome-wide data on 17,000 individuals from Africa, Asia and Oceania.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31844061</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6914791/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Tanzania/KCMC/JMP received funding from MRC grant number (G9901439).</rdfs:comment>
