        <obo:IAO_0000112>GCST90568440</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based longitudinal birth cohort of the children born in the Christchurch urban region of New Zealand during a four-month period from April to August 1977, studied by the University of Otago, Christchurch, at birth, 4 months, 1 year, annually to age 16 and at intervals into adulthood (to age 40), on their health, development, social circumstances and wellbeing across the life course.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1265</coho:numberOfParticipants>
