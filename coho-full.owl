        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001077"/>
        <obo:IAO_0000112>PMID:24096698</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based pair of case-control studies, one of endometrial cancer and one of breast cancer, among white and African American women aged 50 to 79 in the Philadelphia area of Pennsylvania and New Jersey, United States, examining exogenous hormone use, parity and estrogen-related genes: cases diagnosed between July 1999 and June 2002 were identified through hospitals and the Pennsylvania Cancer Registry, and controls from the same area by random-digit dialling. Its endometrial cancer study is one of the studies of the Epidemiology of Endometrial Cancer Consortium.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>WISE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Women&apos;s Insights and Shared Experiences</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Women&apos;s Insights and Shared Experiences study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Womens Insights and Shared Experiences study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Women&apos;s Insights and Shared Experiences Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21687">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
