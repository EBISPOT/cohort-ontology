        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2958814/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>additional German DCM cases (mean age 53±13 years; n = 564, n = 440 men, n = 124 women) were recruited from different German study centers: Berlin, n = 64; Lübeck, n = 96 (Angio-Lueb)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001487"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23202125</owl:annotatedTarget>
        <dcterms:title>Large-scale association analysis identifies new risk loci for coronary artery disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23202125</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Angio-Lueb/ KORA F3 Lübeck Registry of Structural Heart Disease /KORA (Kooperative Gesundheitsforschung 21378990 16648850 European Germany CAD/MI Consecutive patients referred for coronary angiography, classified as CAD/MI cases based on the coronary angiogram</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001487"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A registry of patients with heart disease treated at the University of Lübeck hospital (University Hospital Schleswig-Holstein, Campus Lübeck) in Germany, with blood samples and clinical data, whose angiography sample (Angio-Lueb) consists of consecutive patients referred for coronary angiography and classified from the angiogram as having coronary artery disease or myocardial infarction or not. It has provided cases for genetic association studies of coronary artery disease, with population controls from KORA, and of dilated cardiomyopathy.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19348677</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20975947</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23202125</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27150028</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
