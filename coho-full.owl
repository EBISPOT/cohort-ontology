        <obo:IAO_0000112>PGS000791</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:26956414</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of lymphoma in the north of England, run from York, whose cases are patients aged 16 to 69 newly diagnosed with non-Hodgkin or Hodgkin lymphoma between 1998 and 2003 while resident in defined areas, and whose controls were matched to cases on sex, date of birth and area of residence and drawn from general practice registers.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">761</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">761</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>ELCCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Epidemiology &amp; Genetics Unit Lymphoma Case-Control study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Epidemiology and Genetics Lymphoma Case-Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Epidemiology and Genetics Lymphoma Case–Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
