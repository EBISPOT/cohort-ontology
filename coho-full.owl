    <!-- http://www.ebi.ac.uk/coho/COHO_0002591 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002591">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21811"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <obo:IAO_0000112>PMID:21771975</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre study run from Academia Sinica, Taiwan, of Han Chinese patients with young-onset essential hypertension, first diagnosed between the ages of 20 and 51, with secondary hypertension, diabetes and a body mass index of 35 kg/m2 or more excluded. Lymphoblastoid cell lines were established for its patients, who, with normotensive controls from other Taiwanese studies, have been used in genome-wide association, gene-expression and candidate-gene studies of hypertension, blood pressure, adiponectin and ACE activity.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1023</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Academia Sinica Multi-Center YOH Genetic Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Academia Sinica Multi-Center Young-Onset Hypertension Genetic Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Academia Sinica young-onset hypertension multi-center study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>YOHG</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Academia Sinica Multicentered Young-Onset Hypertension Genetic Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21811">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001134"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002591"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21811"/>
        <obo:IAO_0000116>young-onset hypertension</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2674219/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We obtained complete genotypic and phenotypic data from 1,008 YOH individuals and established immortalized cell lines from their lymphocytes for the Academia Sinica Multi-Center YOH Genetic Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002591"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5789005/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Young-onset hypertensive patients were selected from “Academia Sinica Multi-Center Young-Onset Hypertension Genetic Study”, which had recruited 1023 non-aboriginal Taiwanese individuals with essential hypertension aged 20 to 50.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002591"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21771975</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study reveals a quantitative trait locus of adiponectin on CDH13 that predicts cardiometabolic outcomes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21771975</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3161336/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this study, we included 941 hypertensive subjects recruited by the Academia Sinica Multicentered Young-Onset Hypertension Genetic Study: 382 in the first-stage genome-wide scan and 559 in the second-stage confirmatory study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002591"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre study run from Academia Sinica, Taiwan, of Han Chinese patients with young-onset essential hypertension, first diagnosed between the ages of 20 and 51, with secondary hypertension, diabetes and a body mass index of 35 kg/m2 or more excluded. Lymphoblastoid cell lines were established for its patients, who, with normotensive controls from other Taiwanese studies, have been used in genome-wide association, gene-expression and candidate-gene studies of hypertension, blood pressure, adiponectin and ACE activity.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19421330</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21771975</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23469169</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29379041</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002591"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1023</owl:annotatedTarget>
        <obo:IAO_0000116>Academia Sinica multicenter young-onset hypertension patients in the ACE activity replication study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3587614/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To confirm the association between ACE activity and ACE variants, ACE activity was measured for another 1023 young-onset hypertension patients from the Academia Sinica young-onset hypertension multi-center study [20], which adopted the same inclusion criteria as described above except for a different age of onset (&lt;50 years).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002591"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>YOHG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


