        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Mexico"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>PMID:42225914</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective birth cohort of pregnant women receiving prenatal care through the Mexican Social Security Institute (IMSS) in Mexico City, recruited from July 2007 to February 2010, and their children, run by the Icahn School of Medicine at Mount Sinai, Harvard University and Mexico&apos;s National Institute of Public Health, and followed to study how prenatal and early-life exposure to metals, air pollution and phthalates, together with chronic psychosocial stress, affects child neurodevelopment, growth and metabolic health.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym PROGRESS also denotes PROGReSS study (COHO:0002284); this term is Programming Research in Obesity, Growth, Environment and Social Stressors.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">948</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PROGRESS</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>PROGRESS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PROGRESS cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PROGRESS study</oboInOwl:hasRelatedSynonym>
