    <!-- http://www.ebi.ac.uk/coho/COHO_0001950 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001950">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17159"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Israel"/>
        <obo:IAO_0000112>PMID:23001564</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort study in Jerusalem, Israel, begun in 1976–1979 as a cardiovascular prevalence study that followed the protocols of the North American Lipid Research Clinics prevalence studies, examining full age cohorts of 17-year-old Jewish residents of Jerusalem and many of their parents to describe plasma lipids and lipoproteins; samples of both generations were re-examined in later phases, the young participants at about 30 and 43 years of age in its longitudinal study.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>JLRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Jerusalem LRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Jerusalem LRC Longitudinal Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Jerusalem LRC Prevalence Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Jerusalem LRC longitudinal study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Jerusalem Lipid Research Clinic</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Jerusalem Lipid Research Clinic cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Jerusalem Lipid Research Clinic prevalence study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LRC</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Jerusalem Lipid Research Clinic Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17159">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001950"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17159"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3145913/</oboInOwl:hasDbXref>
        <rdfs:comment>the population-based Jerusalem Lipid Research Clinic (LRC) cohort study which was initiated in the 1970s as a cardiovascular prevalence study, using protocols of the North American LRC prevalence studies</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001950"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Israel"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3798089/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Leukocyte telomere length was measured on two occasions, at baseline and follow-up examinations in 1156 adult (44% women) in four studies: in Israel, the Jerusalem Lipid Research Clinic (LRC; Kark et al., 2012); in the USA, the Bogalusa Heart Study (BHS; Aviv et al., 2009);</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001950"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23001564</owl:annotatedTarget>
        <dcterms:title>Genome-wide meta-analysis points to CTC1 and ZNF676 as genes regulating telomere homeostasis in humans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23001564</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3510758/</oboInOwl:hasDbXref>
        <rdfs:comment>Samples from the Jerusalem LRC Longitudinal Study (N = 620) (68), Health ABC study (N = 337) (69), from ADELAHYDE-Nancy study and ERA-France study (N = 316) (70,71) and from a Danish collection (N = 964) (47) were included in the replication stage.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001950"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort study in Jerusalem, Israel, begun in 1976–1979 as a cardiovascular prevalence study that followed the protocols of the North American Lipid Research Clinics prevalence studies, examining full age cohorts of 17-year-old Jewish residents of Jerusalem and many of their parents to describe plasma lipids and lipoproteins; samples of both generations were re-examined in later phases, the young participants at about 30 and 43 years of age in its longitudinal study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21220750</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22237065</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26406330</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:7161042</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001950"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>JLRC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001950"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LRC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001951 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001951">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid17166"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002171"/>
