        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study begun in 2001 as a National Cancer Institute programme project in which nicotine-dependent smokers and non-dependent smoking controls were recruited from communities in Detroit and St. Louis, United States, to identify genetic factors in nicotine dependence.</owl:annotatedTarget>
