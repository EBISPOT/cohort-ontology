        <obo:IAO_0000112>PMID:41408349</obo:IAO_0000112>
        <obo:IAO_0000115>A pooled set of participants with psoriasis from five Novartis clinical trials of secukinumab (CAIN457A2302, CAIN457A2303, CAIN457A2304, CAIN457A2223 and CAIN457A2403), whose anonymized trial data and genotypes, collected by Novartis Pharmaceuticals, are analysed post hoc as a psoriasis-only cohort in genetic studies of psoriasis.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1461</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Novartis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Novartis clinical trials of secukinumab for psoriasis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Novartis secukinumab psoriasis trials</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Novartis secukinumab trials cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Novartis secukinumab clinical trials</rdfs:label>
    </owl:NamedIndividual>
