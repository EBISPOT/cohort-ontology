    <!-- http://www.ebi.ac.uk/coho/COHO_0001638 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001638">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14756"/>
        <rdf:type rdf:nodeID="genid14758"/>
        <rdf:type rdf:nodeID="genid14760"/>
        <rdf:type rdf:nodeID="genid14762"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/India"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Asia"/>
        <obo:IAO_0000112>PMID:15277424</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based epidemiological study of diabetes and its complications in adults aged 20 years or more in Chennai, southern India, run by the Madras Diabetes Research Foundation. A representative sample of the city&apos;s residents, from wards chosen by systematic random sampling, was screened for diabetes in a door-to-door survey in 2001–2003; everyone found to have diabetes and every tenth participant then underwent detailed anthropometric, biochemical and complication studies, and they were followed up in 2012–2014.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CURES also denotes China Pulmonary Thromboembolism Registry Study (COHO:0001639); this term is Chennai Urban Rural Epidemiology Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">26001</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CURES</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Chennai Urban Rural Epidemiology Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14756">
