    <!-- http://www.ebi.ac.uk/coho/COHO_0000482 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000482">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001170"/>
        <obo:IAO_0000112>GCST90627737</obo:IAO_0000112>
        <obo:IAO_0000115>An electronic health record-linked biobank jointly developed by the University of Colorado Anschutz Medical Campus and UCHealth, enrolling adult UCHealth patients since September 2015 (more than 200,000 participants by 2022, mostly from the Rocky Mountain region), as a dual-purpose resource for genomic research and for returning clinical genetic results to participants.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200673</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CCPM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CCPM Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Colorado Center for Personalized Medicine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Colorado Center for Personalized Medicine Biobank</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000482"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>UCHealth serves both a highly urban population in the Denver, Colorado Springs, and Fort Collins metropolitan areas as well as numerous rural populations in the intermountain west and western great plains regions of the United States.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000482"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90627737</owl:annotatedTarget>
        <dcterms:title>Global multi-ancestry genome-wide analyses identify genes and biological pathways associated with thyroid cancer and benign thyroid diseases.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41644669</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12900643/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We explored the ability of PRS to identify people at risk for ThC (PRSThC versus All) in the Colorado Center for Personalized Medicine (CCPM) Biobank population (n = 94,651).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000482"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An electronic health record-linked biobank jointly developed by the University of Colorado Anschutz Medical Campus and UCHealth, enrolling adult UCHealth patients since September 2015 (more than 200,000 participants by 2022, mostly from the Rocky Mountain region), as a dual-purpose resource for genomic research and for returning clinical genetic results to participants.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38181729</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000482"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200673</owl:annotatedTarget>
        <obo:IAO_0000116>participants enrolled by March 2022</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As of March 2022, 200,673 participants have enrolled in the CCPM Biobank and 103,600 have provided a blood (n = 100,542) or saliva (n = 3,058) sample (Figure 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000482"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CCPM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
