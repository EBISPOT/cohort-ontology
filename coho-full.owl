        <rdfs:comment>The GENDAI cohort consists of young children of both sexes attending school in the area of Attica, Greece.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001774"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A school-based cross-sectional study of fifth- and sixth-grade children aged 10 to 14 years, enrolled between November 2005 and June 2006 from primary schools in the Attica region of Greece, which collected anthropometric, dietary, clinical, genetic, sociodemographic and lifestyle data from the children and their families to evaluate the contributions and interactions of genetic, dietary and physical activity factors in childhood obesity.</owl:annotatedTarget>
