    <!-- http://www.ebi.ac.uk/coho/COHO_0002376 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002376">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20210"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001586"/>
        <obo:IAO_0000112>PMID:42664632</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre prospective cohort study of the US National Heart, Lung, and Blood Institute that enrolled adults aged 40 years or older in 1995–1998 from existing epidemiological cohorts (sites of the Atherosclerosis Risk in Communities Study and the Cardiovascular Health Study, the Framingham Offspring Cohort, the Strong Heart Study, the New York Hypertension Cohorts and two Tucson studies) and added an in-home polysomnogram at baseline and again in 2001–2003 to their data, to study obstructive sleep apnoea and other sleep-disordered breathing as risk factors for cardiovascular disease, hypertension and death.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6441</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SHHS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Sleep Heart Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20210">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002376"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20210"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3498243/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>SHHS is a prospective cohort of 6,441 subjects who underwent polysomnography recruited from six established cohorts to study the effects of OSA on cardiovascular disease [29].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002376"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12649793/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>the study population consisted primarily of middle-aged and older adults from community-dwelling populations in the United States</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002376"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42664632</owl:annotatedTarget>
        <dcterms:title>Multidimensional sleep health and all-cause mortality: Counterfactual risk estimation and component-specific contributions in the sleep heart health study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42664632</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42664632+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We included 4382 adults from the Sleep Heart Health Study with baseline polysomnography, questionnaire-based sleep assessments, covariates, and mortality follow-up.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002376"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre prospective cohort study of the US National Heart, Lung, and Blood Institute that enrolled adults aged 40 years or older in 1995–1998 from existing epidemiological cohorts (sites of the Atherosclerosis Risk in Communities Study and the Cardiovascular Health Study, the Framingham Offspring Cohort, the Strong Heart Study, the New York Hypertension Cohorts and two Tucson studies) and added an in-home polysomnogram at baseline and again in 2001–2003 to their data, to study obstructive sleep apnoea and other sleep-disordered breathing as risk factors for cardiovascular disease, hypertension and death.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:9493915</obo:IAO_0000119>
        <obo:IAO_0000119>https://biolincc.nhlbi.nih.gov/studies/shhs/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002376"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6441</owl:annotatedTarget>
        <obo:IAO_0000116>SHHS participants recruited for baseline polysomnography</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3498243/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>SHHS is a prospective cohort of 6,441 subjects who underwent polysomnography recruited from six established cohorts to study the effects of OSA on cardiovascular disease [29].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002376"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
