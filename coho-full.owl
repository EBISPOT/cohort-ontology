    <!-- http://www.ebi.ac.uk/coho/COHO_0002258 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002258">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19343"/>
        <rdf:type rdf:nodeID="genid19345"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000283"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002679"/>
        <obo:IAO_0000112>PGS000777</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33958783</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based cohort of people newly diagnosed with Parkinson&apos;s disease or other parkinsonism in Cambridgeshire, United Kingdom, recruited between 2006 and 2013: incident cases ascertained through general practitioners and hospital specialists between April 2008 and January 2010, in a second incidence study of the same base population as CamPaIGN, supplemented by other newly diagnosed (inception) cases. Participants are followed up every 18 months with motor, cognitive and neuropsychiatric assessments to study the natural history of Parkinson&apos;s disease; the study was sponsored by the University of Cambridge and Cambridge University Hospitals NHS Trust.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">280</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PICNICS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Parkinsonism: Incidence and Cognitive Heterogeneity in Cambridgeshire</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Parkinsonism: Incidence and Cognitive and Non-motor heterogeneity In CambridgeShire</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Parkinsonism–Incidence and Cognitive Heterogeneity in Cambridgeshire</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Parkinsonism: Incidence, Cognition and Non-motor heterogeneity in Cambridgeshire</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19343">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid19345">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021095"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002258"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19343"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://doi.org/10.1136/jnnp-2015-312581</oboInOwl:hasDbXref>
        <rdfs:comment>The PICNICS study recruited newly diagnosed cases of PD and parkinsonism resident in Cambridgeshire between 1 April 2008 and 31 January 2010.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002258"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19345"/>
        <obo:IAO_0000116>parkinsonism</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://doi.org/10.1136/jnnp-2015-312581</oboInOwl:hasDbXref>
        <rdfs:comment>The PICNICS study recruited newly diagnosed cases of PD and parkinsonism resident in Cambridgeshire between 1 April 2008 and 31 January 2010.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002258"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC4119609</oboInOwl:hasDbXref>
        <rdfs:comment>We began by studying patients newly diagnosed with PD who were recruited to a community-based incidence study in Cambridgeshire, England (Parkinsonism–Incidence and Cognitive Heterogeneity in Cambridgeshire [PICNICS]).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000777</owl:annotatedTarget>
        <dcterms:title>Genome-wide survival study identifies a novel synaptic locus and polygenic score for cognitive progression in Parkinson&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33958783</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33958783</owl:annotatedTarget>
        <dcterms:title>Genome-wide survival study identifies a novel synaptic locus and polygenic score for cognitive progression in Parkinson&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33958783</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8459648/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>HBS, Arizona Study of Aging/Brain and Body Donation Program, NET-PD LS1, CamPaIGN, PICNICS, DIGPD, PDBP, PIB, ParkWest, PROPARK and PROPARK-C cohorts comprised the discovery population and DATATOP, PPMI, PreCEPT and Tartu the replication population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based cohort of people newly diagnosed with Parkinson&apos;s disease or other parkinsonism in Cambridgeshire, United Kingdom, recruited between 2006 and 2013: incident cases ascertained through general practitioners and hospital specialists between April 2008 and January 2010, in a second incidence study of the same base population as CamPaIGN, supplemented by other newly diagnosed (inception) cases. Participants are followed up every 18 months with motor, cognitive and neuropsychiatric assessments to study the natural history of Parkinson&apos;s disease; the study was sponsored by the University of Cambridge and Cambridge University Hospitals NHS Trust.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26800710</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27717005</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32303560</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33958783</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41964342</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002258"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">280</owl:annotatedTarget>
        <obo:IAO_0000116>participants in the PICNICS cohort (newly diagnosed patients, incident and inception cases)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11542283/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Out of 280 participants in the PICNICS cohort, 198 were included in the analysis at visit 1 (mean 0.26 years from diagnosis), 133 at visit 2 (mean 2.05 years from diagnosis), and 78 at visit 3 (mean 3.73 years from diagnosis); Figure S1.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002258"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PICNICS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002259 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002259">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000485"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. PICO is the PGS Catalog&apos;s mistyping of PLCO: its two scores from one paper list the same 95 cohorts, with PLCO in one and PICO in the other in the same place (PGS000351, PGS000352). Replaced by COHO:0000485 (Prostate, Lung, Colorectal, and Ovarian Cancer Screening Trial), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete PICO</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002260 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002260">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19353"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PGS005221</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:40759756</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of healthy midlife and older adults from across Australia, recruited using genetic prediction to be enriched for high and low genetic risk of Alzheimer&apos;s disease and followed longitudinally with online surveys and cognitive testing, with at-risk participants and a clinical group of patients with mild cognitive impairment or early Alzheimer&apos;s disease invited for neuroimaging, detailed neurocognitive testing and blood sampling, to find the earliest signs and modifiable risk factors of Alzheimer&apos;s disease; approved by the ethics committee of QIMR Berghofer Medical Research Institute.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3801</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PISA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prospective Imaging Study of Ageing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prospective Imaging Study of Aging</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Prospective Imaging Study of Ageing: Genes, Brain and Behaviour</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19353">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004975"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002260"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19353"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7750170/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This prospective cohort study, “Prospective Imaging Study of Ageing: Genes, Brain and Behaviour” (PISA) seeks to characterise the phenotype and natural history of healthy adult Australians at high future risk of Alzheimer’s disease (AD).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002260"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7750170/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Online surveys and cognitive testing are used to characterise an Australia-wide sample currently totalling over 3800 participants.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002260"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005221</owl:annotatedTarget>
        <dcterms:title>Uncovering the multivariate genetic architecture of frailty with genomic structural equation modeling.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40759756</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002260"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40759756</owl:annotatedTarget>
        <dcterms:title>Uncovering the multivariate genetic architecture of frailty with genomic structural equation modeling.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40759756</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12626885/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To validate latent frailty factors as phenotypes that capture frailty-specific variance, we created polygenic risk scores (PRSs) for each latent frailty factor and used regression models to test how well they predicted frailty and frailty-related outcomes in three external older adult cohorts (the Lothian Birth Cohort 1936 (LBC1936) (n = 1,005; mean age = 69.60), the English Longitudinal Study of Aging (ELSA) (n = 7,181, mean age = 68.45) and the Prospective Imaging Study of Aging (PISA) (n = 3,265, mean age = 60.34)) (Methods and Supplementary Note).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002260"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of healthy midlife and older adults from across Australia, recruited using genetic prediction to be enriched for high and low genetic risk of Alzheimer&apos;s disease and followed longitudinally with online surveys and cognitive testing, with at-risk participants and a clinical group of patients with mild cognitive impairment or early Alzheimer&apos;s disease invited for neuroimaging, detailed neurocognitive testing and blood sampling, to find the earliest signs and modifiable risk factors of Alzheimer&apos;s disease; approved by the ethics committee of QIMR Berghofer Medical Research Institute.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33341723</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40759756</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002260"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3801</owl:annotatedTarget>
        <obo:IAO_0000116>participants who had taken part in the core online survey by 21 August 2020</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7750170/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To date, 3801 participants have taken part in the core survey with 65% of those going on to complete all additional modules (Fig. 3).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002260"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PISA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002261 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002261">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001139"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. PITT is how facial genetics consortia name the 3D Facial Norms sample: &apos;Pittsburgh 3D Facial Norms study (PITT)&apos; is the 3D Facial Norms dataset (PMID:31763980, PMID:30405702). Replaced by COHO:0001139 (3D Facial Norms cohort), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Pittsburgh 3D Facial Norms</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002262 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002262">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19361"/>
        <rdf:type rdf:nodeID="genid19363"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS000740</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:26352532</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, Pittsburgh-based cohort of current and former cigarette smokers aged 50-79 (at least half a pack a day for 25 years and, for former smokers, quit within the last 10 years), enrolled in 2002-2005 for computed-tomography lung cancer screening and long-term follow-up.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3642</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PLuSS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Pittsburgh Lung Screening Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19361">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid19363">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_with_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000038"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002262"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19361"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40694038+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a prospective nested case-control study of incident lung cancer cases and individually matched healthy controls from the Pittsburgh Lung Screening Study cohort of current and former smokers at high risk for developing lung cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002262"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19363"/>
        <obo:IAO_0000116>cigarette smoking</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4636453/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The second group of subjects came from the Pittsburgh Lung Screening Study (PLuSS), a Pittsburgh-based CT lung cancer screening study that enrolled, between 2002 and 2005, 50-79 year-old current or former cigarette smokers (≥half pack/day for ≥25 years, quit ≤10 years).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002262"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4636453/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The second group of subjects came from the Pittsburgh Lung Screening Study (PLuSS), a Pittsburgh-based CT lung cancer screening study that enrolled, between 2002 and 2005, 50-79 year-old current or former cigarette smokers (≥half pack/day for ≥25 years, quit ≤10 years).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002262"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000740</owl:annotatedTarget>
        <dcterms:title>Assessing Lung Cancer Absolute Risk Trajectory Based on a Polygenic Risk Model.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33472890</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002262"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:26352532</owl:annotatedTarget>
        <dcterms:title>Lung Cancer Risk Prediction Using Common SNPs Located in GWAS-Identified Susceptibility Regions.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:26352532</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26352532+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In a subset nested in the Pittsburgh Lung Screening Study, change in area under the receiver operator characteristic curve and net reclassification improvement were used to compare predictions made by risk factor models with and without genetic variables.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002262"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, Pittsburgh-based cohort of current and former cigarette smokers aged 50-79 (at least half a pack a day for 25 years and, for former smokers, quit within the last 10 years), enrolled in 2002-2005 for computed-tomography lung cancer screening and long-term follow-up.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26352532</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Sonnet 5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002262"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3642</owl:annotatedTarget>
        <obo:IAO_0000116>current and former smokers enrolled 2002-2005, all of whom had the initial CT screen</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:18635890</oboInOwl:hasDbXref>
        <rdfs:comment>3,642 and 3,423 subjects had initial and repeat screening.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002262"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PLuSS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


