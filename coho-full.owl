    <!-- http://www.ebi.ac.uk/coho/COHO_0001743 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001743">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15557"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000029"/>
        <obo:IAO_0000112>PGS000012</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:23202125</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective randomised multicentre trial at 58 hospitals in Sweden, Norway and Denmark in which patients with unstable coronary-artery disease were assigned to an early invasive or a non-invasive treatment strategy, together with placebo-controlled long-term treatment with the low-molecular-mass heparin dalteparin (Fragmin), to compare the two strategies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2457</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>FRISC II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FRISC-II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FRISCII</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fragmin and Fast Revascularization during Instability in Coronary Artery Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">FRagmin and Fast Revascularisation during InStability in Coronary artery disease II</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15557">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005542"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001743"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15557"/>
        <obo:IAO_0000116>unstable coronary-artery disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10475181+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We compared an early invasive with a non-invasive treatment strategy in unstable coronary-artery disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001743"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The FRISC II, (Fragmin and Fast Revascularization during Instability in Coronary Artery Disease) study was a prospective, randomised, multicentre trial (58 hospitals in Sweden, Norway and Denmark) with parallel groups to compare invasive and non‐invasive treatments.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001743"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000012</owl:annotatedTarget>
        <dcterms:title>Genomic prediction of coronary heart disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27655226</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001743"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23202125</owl:annotatedTarget>
        <dcterms:title>Large-scale association analysis identifies new risk loci for coronary artery disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23202125</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>FRISCII patients were eligible for inclusion if they had symptoms of ischaemia that were increasing or occurring at rest, or that warranted the suspicion of acute myocardial infarction, with the last episode within 48 h before the start of dalteparin or standard heparin treatment.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001743"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective randomised multicentre trial at 58 hospitals in Sweden, Norway and Denmark in which patients with unstable coronary-artery disease were assigned to an early invasive or a non-invasive treatment strategy, together with placebo-controlled long-term treatment with the low-molecular-mass heparin dalteparin (Fragmin), to compare the two strategies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10475181</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001743"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2457</owl:annotatedTarget>
        <obo:IAO_0000116>FRISC II patients randomized in the invasive versus non-invasive comparison</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10475181+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In a prospective randomised multicentre study, we randomly assigned 2457 patients in 58 Scandinavian hospitals (median age 66 years, 70% men) an early invasive or non-invasive treatment strategy with placebo-controlled long-term low-molecular-mass heparin (dalteparin) for 3 months.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001743"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FRISC II</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001743"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FRISC-II</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001743"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FRISCII</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001744 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001744">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15567"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000134"/>
        <obo:IAO_0000112>PGS000082</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:19127255</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of ovarian cancer run from Stanford, California, and formerly called the Family Registry for Ovarian Cancer, whose cases were women diagnosed from 1997 into the early 2000s identified through the Greater Bay Area Cancer Registry in Northern California and whose controls were identified by random-digit dialling in the same area, frequency matched on age and race/ethnicity; one of the studies of the Ovarian Cancer Association Consortium.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">665</coho:numberOfCases>
