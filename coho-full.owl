    <!-- http://www.ebi.ac.uk/coho/COHO_0000210 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000210">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid2208"/>
        <obo:IAO_0000112>EGAS50000000131</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of patients with metastatic colorectal cancer treated with bevacizumab-containing therapy in the AC-ANGIOPREDICT phase II trial, whose tumour, normal and plasma samples were sequenced to identify biomarkers of response.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">76</coho:numberOfParticipants>
