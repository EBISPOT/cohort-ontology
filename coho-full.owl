        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11329134/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The American Cancer Society Cancer Prevention Study-3 (CPS-3) is a prospective cohort study of over 300,000 US adults with the primary goal of investigating cancer incidence and mortality</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002685"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Puerto_Rico"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:28171707%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The American Cancer Society (ACS) recruited a new prospective cohort study, Cancer Prevention Study 3 (CPS-3), between 2006 and 2013 from 35 states and Puerto Rico.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002685"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11329134/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The American Cancer Society Cancer Prevention Study-3 (CPS-3) is a prospective cohort study of over 300,000 US adults with the primary goal of investigating cancer incidence and mortality</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002685"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39150951</owl:annotatedTarget>
        <dcterms:title>Validity of self-reported sleep duration in the Cancer Prevention Study- 3.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39150951</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11329134/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The CPS-3 Activity Validation Sub Study (AVSS) was conducted in 2015 to further investigate rest/activity cycles among a subset of CPS-3 study participants</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002685"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of adults in the United States and Puerto Rico recruited by the American Cancer Society between 2006 and 2013, mainly at community events, who gave a blood sample and survey information and are followed through repeat surveys and linkage with cancer registries and the National Death Index, to study lifestyle, genetic and other causes of cancer and other outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28171707</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002685"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">303682</owl:annotatedTarget>
        <obo:IAO_0000116>participants enrolled 2006-2013</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:28171707</oboInOwl:hasDbXref>
        <rdfs:comment>In total, 303,682 participants were enrolled.</rdfs:comment>
    </owl:Axiom>
