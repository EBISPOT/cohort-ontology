        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000921"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomized, double-blind, placebo-controlled trial of rosuvastatin 20 mg daily for the primary prevention of cardiovascular disease in 17,802 apparently healthy men aged 50 or over and women aged 60 or over with low LDL cholesterol but elevated high-sensitivity C-reactive protein, funded by AstraZeneca and stopped early for efficacy after a median follow-up of 1.9 years.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32799709</obo:IAO_0000119>
