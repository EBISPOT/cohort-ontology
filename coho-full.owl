        <rdfs:comment>The METASTROKE collaboration brings together GWAS data from more than 12 000 cases of ischaemic stroke and 60 000 controls from 15 cohorts all of European ancestry.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000688"/>
