    <!-- http://www.ebi.ac.uk/coho/COHO_0002339 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002339">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:32469308</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal study of healthy ageing at Stanford University in which cognitively unimpaired older adults, recruited through advertisements in the Bay Area, undergo neuropsychological assessment, brain imaging and fluid biomarker sampling, with a focus on medial temporal lobe function and episodic memory.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">212</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SAMS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stanford Aging &amp; Memory Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stanford Aging Memory Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Stanford Aging and Memory Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002339"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7259949/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We recruited widely in the bay area through ads in newspapers, newsletters, and online (e.g., Facebook), with the following inclusion criteria: native English speaking, right-handed, and MRI compatible.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002339"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32469308</owl:annotatedTarget>
        <dcterms:title>Hippocampal and cortical mechanisms at retrieval explain variability in episodic remembering in older adults.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32469308</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7259949/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>One hundred and five cognitively healthy older adults (aged 60–82 years; 65 female) participated as part of the Stanford Aging and Memory Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002339"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal study of healthy ageing at Stanford University in which cognitively unimpaired older adults, recruited through advertisements in the Bay Area, undergo neuropsychological assessment, brain imaging and fluid biomarker sampling, with a focus on medial temporal lobe function and episodic memory.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32469308</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33408146</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39528825</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002339"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">212</owl:annotatedTarget>
        <obo:IAO_0000116>cognitively unimpaired older adults enrolled, as reported in 2021 (the study is ongoing)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8055319/</oboInOwl:hasDbXref>
        <rdfs:comment>This study includes data from 153 CU (table 1; aged 60–88 years) of an initial 212 enrolled in the Stanford Aging and Memory Study (SAMS; see figure e-1 for participant flowchart, doi:10.5061/dryad.ngf1vhhrp).</rdfs:comment>
    </owl:Axiom>
