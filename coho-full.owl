        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9007944/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>UKBGS thanks Breast Cancer Now and the Institute of Cancer Research for support and funding of the Generations Study, and the study participants, study staff, and the doctors, nurses and other health care providers and health information sources who have contributed to the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000942"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A UK general-population cohort started in 2003 that recruited 112,049 participants aged 16–102 by 2011 through a generational referral method, in which women recruited directly nominated female friends and relatives, collecting detailed questionnaires and blood samples repeatedly over decades to investigate breast cancer aetiology.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21897394</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000942"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">112049</owl:annotatedTarget>
        <obo:IAO_0000116>women who returned the questionnaire and became study members, 2003-2011</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3185950/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of these women, 112 049 (47%) have returned the questionnaire and become study members.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000942"/>
