        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9870026/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GO-CAT cohort is a multinational retrospective cohort of pediatric cancer patients, treated between 1975 and 2020.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001339"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
