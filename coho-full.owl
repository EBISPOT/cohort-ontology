    <!-- http://www.ebi.ac.uk/coho/COHO_0002622 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002622">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <obo:IAO_0000112>PMID:36191030</obo:IAO_0000112>
        <obo:IAO_0000115>An Italian multicentre prospective birth cohort of newborns recruited from October 2011 to March 2015 in six maternity units in Florence, Rome, Trieste, Turin and Viareggio, with maternal blood, cord blood and other samples stored in a biobank at the Istituto Superiore di Sanità and follow-up by questionnaires through childhood, set up to study the effects of environmental exposures, parental conditions and social factors in pre- and early post-natal life on child health and development.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3358</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/Piccolipiù</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>Piccolipiù</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Piccolipiù Italian birth cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Piccolipiù cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Piccolipiù study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Progetto Piccolipiù</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Piccolipiù birth cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002622"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3926689/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Piccolipiù is a prospective cohort of expected 3000 newborns, who will be recruiting in six maternity units of five Italian cities (Florence, Rome, Trieste, Turin and Viareggio) since October 2011.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002622"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:36191030</owl:annotatedTarget>
        <dcterms:title>Unintentional injuries and potential determinants of falls in young children: Results from the Piccolipiù Italian birth cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36191030</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9529104/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Piccolipiù is the name of a birth cohort of 3,358 children enrolled in six maternity wards located in five Italian cities (Florence, Rome, Trieste, Turin, and Viareggio) between October 2011 and March 2015 [26].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002622"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An Italian multicentre prospective birth cohort of newborns recruited from October 2011 to March 2015 in six maternity units in Florence, Rome, Trieste, Turin and Viareggio, with maternal blood, cord blood and other samples stored in a biobank at the Istituto Superiore di Sanità and follow-up by questionnaires through childhood, set up to study the effects of environmental exposures, parental conditions and social factors in pre- and early post-natal life on child health and development.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24506846</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36191030</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002622"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3358</owl:annotatedTarget>
        <obo:IAO_0000116>children enrolled October 2011 - March 2015 (2011-2015)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9529104/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Piccolipiù is the name of a birth cohort of 3,358 children enrolled in six maternity wards located in five Italian cities (Florence, Rome, Trieste, Turin, and Viareggio) between October 2011 and March 2015 [26].</rdfs:comment>
    </owl:Axiom>
