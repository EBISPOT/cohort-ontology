    <!-- http://www.ebi.ac.uk/coho/COHO_0002600 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002600">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21889"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:39349457</obo:IAO_0000112>
        <obo:IAO_0000115>A historical birth cohort of singletons born alive and at term in the Wilhelmina Gasthuis in Amsterdam, the Netherlands, around the time of the 1944–1945 Dutch famine (1943–1947), traced and studied by Amsterdam UMC since 1994 through repeated interviews, examinations, biological samples, imaging and registry linkage, to investigate the effects of acute maternal undernutrition during specific stages of gestation on later health, particularly cardiovascular and metabolic disease, ageing and mental health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2414</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/DFBC</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>DFBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Dutch Famine Birth Cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Dutch famine birth cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Dutch famine birth cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Hongerwinter Onderzoek</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Dutch Famine Birth Cohort</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.hongerwinter.nl/"/>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21889">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_with_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0800003"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002600"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21889"/>
        <obo:IAO_0000116>acute maternal undernutrition during the 1944-1945 Dutch famine</obo:IAO_0000116>
        <obo:IAO_0000116>prenatal famine exposure</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/DFBC</oboInOwl:hasDbXref>
        <rdfs:comment>The cohort was set up to investigate the effects of acute maternal undernutrition during specific stages of gestation on the offspring’s adult health.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002600"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=DOI:%2210.1136/bmjopen-2020-042078%22&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>Cohort profile: the Dutch famine birth cohort (DFBC)- a prospective birth cohort study in the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002600"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39349457</owl:annotatedTarget>
        <dcterms:title>Prenatal exposure to undernutrition is associated with a specific lipid profile predicting future brain aging.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39349457</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11442854/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>801 plasma samples of members of the Dutch famine birth cohort were assessed for lipidomics and leptin at age 58.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002600"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A historical birth cohort of singletons born alive and at term in the Wilhelmina Gasthuis in Amsterdam, the Netherlands, around the time of the 1944–1945 Dutch famine (1943–1947), traced and studied by Amsterdam UMC since 1994 through repeated interviews, examinations, biological samples, imaging and registry linkage, to investigate the effects of acute maternal undernutrition during specific stages of gestation on later health, particularly cardiovascular and metabolic disease, ageing and mental health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33664071</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.hongerwinter.nl/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002600"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2414</owl:annotatedTarget>
        <obo:IAO_0000116>singletons born alive at term in the Wilhelmina Gasthuis 1943-1947 whose birth records were kept</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:33664071</oboInOwl:hasDbXref>
        <rdfs:comment>The Dutch famine birth cohort consists of 2414 singletons born alive and at term in the Wilhelmina Gasthuis in Amsterdam around the time of the Dutch famine (1943–1947) whose birth records have been kept.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
