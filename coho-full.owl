    <!-- http://www.ebi.ac.uk/coho/COHO_0002495 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002495">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21144"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000176"/>
        <obo:IAO_0000112>PMID:28166215</obo:IAO_0000112>
        <obo:IAO_0000115>A sub-cohort of UK Biobank participants of European ancestry chosen from the middle and the extremes of the distribution of forced expiratory volume in 1 second among heavy smokers and among never smokers, sampled equally by sex, for nested case-control studies of the genetics of lung function, smoking behaviour and chronic obstructive pulmonary disease, and genotyped on the custom UK BiLEVE Axiom array.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50008</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>UK BiLEVE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK BiLEVE Cohort Information</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK BiLEVE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UKBiLEVE</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">UK Biobank Lung Exome Variant Evaluation</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21144">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_with_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000029"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002495"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21144"/>
        <obo:IAO_0000116>heavy smoking</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4593935/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We sampled individuals of European ancestry from UK Biobank, from the middle and extremes of the forced expiratory volume in 1 s (FEV1) distribution among heavy smokers (mean 35 pack-years) and never smokers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002495"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4593935/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>UK Biobank is the largest European biobank available at present and represents an extensive resource from which to sample phenotypic extremes in the UK population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002495"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000176"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3752/MediaObjects/41588_2017_BFng3752_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>UK BiLEVE is a subset of UK Biobank and is described in detail elsewhere62.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002495"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28166215</owl:annotatedTarget>
        <dcterms:title>Genetic loci associated with chronic obstructive pulmonary disease overlap with loci for lung function and pulmonary fibrosis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28166215</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5381275/</oboInOwl:hasDbXref>
        <rdfs:comment>An overall meta-analysis across the Stage 1 and Stage 2 (UK BiLEVE) cohorts was performed and variants with P &lt; 5×10−8 were considered genome-wide significant (Figure 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002495"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sub-cohort of UK Biobank participants of European ancestry chosen from the middle and the extremes of the distribution of forced expiratory volume in 1 second among heavy smokers and among never smokers, sampled equally by sex, for nested case-control studies of the genetics of lung function, smoking behaviour and chronic obstructive pulmonary disease, and genotyped on the custom UK BiLEVE Axiom array.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26423011</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28166215</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30305743</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002495"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50008</owl:annotatedTarget>
        <obo:IAO_0000116>UK Biobank participants selected for the study (unique samples), 2012</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4593935/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We selected 50 008 unique samples: 10 002 individuals with low FEV1, 10 000 with average FEV1, and 5002 with high FEV1 from each of the heavy smoker and never smoker groups.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002495"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>UK BiLEVE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002495"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>UKBiLEVE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002496 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002496">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21153"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:24121790</obo:IAO_0000112>
        <obo:IAO_0000115>A United Kingdom study, funded by a Medical Research Council programme grant, of people with Barrett&apos;s oesophagus identified at endoscopy with a histopathologically confirmed diagnosis of intestinal metaplasia and recruited across the UK excluding Northern Ireland, whose cases have been used in genetic association studies of Barrett&apos;s oesophagus and oesophageal adenocarcinoma.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">882</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>UK Barrett&apos;s Esophagus Gene Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK Barrett&apos;s oesophagus gene study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK Barretts Oesophagus Gene Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK Gene Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UKBOGS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">UK Barrett&apos;s Oesophagus Gene Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21153">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0013662"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002496"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21153"/>
        <obo:IAO_0000116>Barrett&apos;s esophagus</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3840115/</oboInOwl:hasDbXref>
        <rdfs:comment>Barrett’s esophagus cases were identified at endoscopy with a confirmed histopathological diagnosis of intestinal metaplasia from the UK Barrett’s Oesophagus Gene Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002496"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2796/MediaObjects/41588_2013_BFng2796_MOESM2_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>UK-wide excluding Northern Ireland (UK Gene Study)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002496"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:24121790</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study identifies new susceptibility loci for esophageal adenocarcinoma and Barrett&apos;s esophagus.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24121790</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3840115/</oboInOwl:hasDbXref>
        <rdfs:comment>Of these, 87 were genotyped in 874 histologically confirmed esophageal adenocarcinoma cases from the Stomach and Oesophageal Cancer Study (SOCS), 759 histologically confirmed Barrett’s esophagus cases from the UK Barrett’s Oesophagus Gene Study (UK Gene Study) and 6,911 controls, of which 1,711 were from the SEARCH Study and 5,200 from the Welcome Trust Case Control Consortium 2 (WTCCC2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002496"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A United Kingdom study, funded by a Medical Research Council programme grant, of people with Barrett&apos;s oesophagus identified at endoscopy with a histopathologically confirmed diagnosis of intestinal metaplasia and recruited across the UK excluding Northern Ireland, whose cases have been used in genetic association studies of Barrett&apos;s oesophagus and oesophageal adenocarcinoma.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24121790</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29551738</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002496"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">882</owl:annotatedTarget>
        <obo:IAO_0000116>Barrett&apos;s oesophagus patients from the study in the pooled BEACON gene-environment dataset of 2018 (analysed subset; no total of the study is stated)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6162842/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The pooled dataset also included an additional 1,003 EA patients and 882 BE patients from the United Kingdom Stomach and Oesophageal Cancer Study and the UK Barrett’s Esophagus Gene Study, respectively.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002496"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>UKBOGS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002497 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002497">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. UKBonn (&apos;Universitäts Klinikum Bonn&apos;) is the PGS Catalog&apos;s id for the Lynch syndrome carriers from the University Hospital of Bonn in the Dueñas 2023 polygenic-score study: 547 people with genetically confirmed Lynch syndrome from 392 families, index patients and relatives found by cascade testing at Bonn&apos;s Institute of Human Genetics. The paper names them only by the hospital (&apos;the UKB LS cohort&apos;). No study name, design paper or registry name is given, and the paper does not say whether they come from the German HNPCC Consortium registry. It is a hospital&apos;s patient series, so, like HZ, it is not a cohort. No COHO term for a Bonn Lynch syndrome series (the Bonn terms in COHO are COVID, OMNI and psychiatric studies). The Spanish half, ICO (E522, placeholder COHO:0001901, &apos;the ICO LS cohort&apos; from the Catalan Institute of Oncology&apos;s Lynch Syndrome Database), is a separate row. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Universitäts Klinikum Bonn</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002498 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002498">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21160"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:18413818</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, randomised, double-blind, placebo-controlled trial in the United Kingdom and Denmark of aspirin (300 mg/day) and folic acid (0.5 mg/day) in a 2 x 2 factorial design for the prevention of colorectal adenoma recurrence, in patients who had had a colorectal adenoma removed in the six months before recruitment and who were followed up with a second colonoscopy after about three years; DNA from its participants has been used in genetic studies of adenoma risk and recurrence.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">945</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>UKCAP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UKCAP trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>United Kingdom Colorectal Adenoma Prevention</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ukCAP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ukCAP trial</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">United Kingdom Colorectal Adenoma Prevention trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21160">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005484"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002498"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21160"/>
        <obo:IAO_0000116>colorectal adenoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18022173+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>All patients had an adenoma (&gt;/=0.5 cm) removed in the 6 months before recruitment and were followed-up at 4-month intervals with a second colonoscopy after approximately 3 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002498"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10641704/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Three studies were conducted in the US (AFPPS, NHS/HPFS and the trial by Jaszewski et al.) and one in the UK and Denmark (UkCAP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002498"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:18413818</owl:annotatedTarget>
        <dcterms:title>Ornithine decarboxylase G316A genotype is prognostic for colorectal adenoma recurrence and predicts efficacy of aspirin chemoprevention.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:18413818</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18413818+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We genotyped ODC G316A in 546 individuals in the United Kingdom Colorectal Adenoma Prevention trial of aspirin for CRA recurrence prevention and pooled our findings with data from two other randomized intervention trials.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002498"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre, randomised, double-blind, placebo-controlled trial in the United Kingdom and Denmark of aspirin (300 mg/day) and folic acid (0.5 mg/day) in a 2 x 2 factorial design for the prevention of colorectal adenoma recurrence, in patients who had had a colorectal adenoma removed in the six months before recruitment and who were followed up with a second colonoscopy after about three years; DNA from its participants has been used in genetic studies of adenoma risk and recurrence.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17971770</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18022173</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10641704/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002498"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">945</owl:annotatedTarget>
        <obo:IAO_0000116>Patients recruited to UKCAP</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18022173+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 945 patients were recruited into the study, of whom 853 (90.3%) underwent a second colonoscopy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002498"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>UKCAP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002498"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ukCAP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002499 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002499">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid21168"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000207"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000347"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002017"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PGS000077</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:24292274</obo:IAO_0000112>
        <obo:IAO_0000115>The two UK case-control genome-wide association studies of chronic lymphocytic leukaemia led by the Institute of Cancer Research: UK-CLL-1, whose cases came from the International CLL Linkage Consortium and the Leukaemia Research Fund CLL4 trial, and UK-CLL-2, whose cases came from a UK national study of CLL genetics coordinated by the Institute of Cancer Research and from the Newcastle CLL Consortium; both used publicly available genotypes of UK controls from the Wellcome Trust Case Control Consortium, the 1958 Birth Cohort and the UK Blood Service.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1739</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5199</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>CLL-UK1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CLL-UK2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK-CLL-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK-CLL-2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK-CLL1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK-CLL2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">UK-CLL</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21168">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004948"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002499"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21168"/>
        <obo:IAO_0000116>chronic lymphocytic leukaemia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24292274+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To identify additional CLL susceptibility loci, we conducted a GWAS and performed a meta-analysis with a published GWAS totaling 1,739 individuals with CLL (cases) and 5,199 controls with validation in an additional 1,144 cases and 3,151 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002499"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000207"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5253627/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For the UK controls, we used publicly accessible data generated by the Wellcome Trust Case Control Consortium (WTCCC), the 1958 Birth Cohort (also known as the National Child Development Study) and UK Blood Service76.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002499"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000347"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5253627/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For the UK controls, we used publicly accessible data generated by the Wellcome Trust Case Control Consortium (WTCCC), the 1958 Birth Cohort (also known as the National Child Development Study) and UK Blood Service76.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002499"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002017"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5253627/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The CLL-UK1 GWAS comprised 517 cases: (i) 155 cases (95 male; mean age at diagnosis: 59 years) from ICLLLC; and (ii) 362 cases (269 male; mean age at diagnosis: 63 years) from the Leukaemia Research CLL-4 trial.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002499"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5253627/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>1,111 cases collected through a UK national study of CLL genetics coordinated by the ICR</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002499"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000077</owl:annotatedTarget>
        <dcterms:title>Cross-cancer evaluation of polygenic risk scores for 16 cancer types in two large cohorts.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33579919</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002499"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:24292274</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study identifies multiple susceptibility loci for chronic lymphocytic leukemia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24292274</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2843/MediaObjects/41588_2014_BFng2843_MOESM31_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Odds ratios and P-values shown are derived from the harmonised UK-CLL-2 and UK-CLL-1 datasets.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002499"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The two UK case-control genome-wide association studies of chronic lymphocytic leukaemia led by the Institute of Cancer Research: UK-CLL-1, whose cases came from the International CLL Linkage Consortium and the Leukaemia Research Fund CLL4 trial, and UK-CLL-2, whose cases came from a UK national study of CLL genetics coordinated by the Institute of Cancer Research and from the Newcastle CLL Consortium; both used publicly available genotypes of UK controls from the Wellcome Trust Case Control Consortium, the 1958 Birth Cohort and the UK Blood Service.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24292274</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28112199</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28165464</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002499"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1739</owl:annotatedTarget>
        <obo:IAO_0000116>UK-CLL discovery meta-analysis in the own 2014 paper</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24292274+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To identify additional CLL susceptibility loci, we conducted a GWAS and performed a meta-analysis with a published GWAS totaling 1,739 individuals with CLL (cases) and 5,199 controls with validation in an additional 1,144 cases and 3,151 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002499"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5199</owl:annotatedTarget>
        <obo:IAO_0000116>UK-CLL discovery meta-analysis in the own 2014 paper</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24292274+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To identify additional CLL susceptibility loci, we conducted a GWAS and performed a meta-analysis with a published GWAS totaling 1,739 individuals with CLL (cases) and 5,199 controls with validation in an additional 1,144 cases and 3,151 controls.</rdfs:comment>
    </owl:Axiom>
    


