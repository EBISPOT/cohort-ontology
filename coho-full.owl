    <!-- http://www.ebi.ac.uk/coho/COHO_0001637 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001637">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14746"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Hong_Kong"/>
        <obo:IAO_0000112>PMID:22158537</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control study of type 2 diabetes in southern Han Chinese residents of Hong Kong, conducted by the Chinese University of Hong Kong. Its cases are patients with type 2 diabetes selected from the Prince of Wales Hospital Diabetes Registry (the Hong Kong Diabetes Register), either with early-onset diabetes and a positive family history or selected at random, excluding classic type 1 diabetes, and its controls, with normal glucose tolerance, were recruited from hospital staff, a community-based cardiovascular risk screening programme and a population-based cardiovascular risk screening programme for adolescents.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1477</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1584</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3061</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CUHKDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CUHKS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Chinese University of Hong Kong Diabetes Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14746">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001637"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14746"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The cases consisted of 1,477 subjects with T2D selected from the Prince of Wales Hospital Diabetes Registry</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001637"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Hong_Kong"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The subjects in the Hong Kong case-control study were of southern Han Chinese ancestry and resided in Hong Kong</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001637"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22158537</owl:annotatedTarget>
        <dcterms:title>Meta-analysis of genome-wide association studies identifies eight new loci for type 2 diabetes in east Asians.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22158537</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3582398/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Stage 3 included up to, 12,284 cases and 13,172 controls from five different studies comprised of the Japan Cardiometabolic Genome Epidemiology Network (CAGE), the Shanghai Diabetes Study I/II (SDS I/II), the Chinese University of Hong Kong Diabetes Study (CUHKDS), the National Taiwan University Hospital Diabetes Study (NTUHDS) and the Seoul National University Hospital Diabetes Study (SNUHDS) for de novo replication analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001637"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case–control study of type 2 diabetes in southern Han Chinese residents of Hong Kong, conducted by the Chinese University of Hong Kong. Its cases are patients with type 2 diabetes selected from the Prince of Wales Hospital Diabetes Registry (the Hong Kong Diabetes Register), either with early-onset diabetes and a positive family history or selected at random, excluding classic type 1 diabetes, and its controls, with normal glucose tolerance, were recruited from hospital staff, a community-based cardiovascular risk screening programme and a population-based cardiovascular risk screening programme for adolescents.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22158537</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25187374</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001637"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1477</owl:annotatedTarget>
        <obo:IAO_0000116>T2D cases and controls in the AGEN-T2D stage 3 replication</obo:IAO_0000116>
