        <oboInOwl:hasRelatedSynonym>ENT disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ENT diseases</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>disease, ENT</oboInOwl:hasRelatedSynonym>
