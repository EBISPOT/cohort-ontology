    <!-- http://www.ebi.ac.uk/coho/COHO_0002647 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002647">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22273"/>
        <rdf:type rdf:nodeID="genid22275"/>
        <rdf:type rdf:nodeID="genid22277"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:24862831</obo:IAO_0000112>
        <obo:IAO_0000115>The children of the German birth cohorts GINIplus (born 1995–1998) and LISAplus (born 1997–1999) recruited in the rural study area of Wesel, near the industrial Ruhr area in western Germany, whose data are pooled because the two cohorts have nearly identical designs and analysed as one study population, as in the ESCAPE and EXPANSE air pollution and exposome consortia, separately from the urban Munich participants (GINI/LISA South).</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3390</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/GINI/LISA%20North</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>GINI/LISA North</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GINIplus (German Infant Nutritional Intervention plus environmental and genetic influences on allergy development)/LISA (Influence of Lifestyle factors on the development of the Immune System and Allergies) North</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">GINIplus/LISA North</rdfs:label>
    </owl:NamedIndividual>
