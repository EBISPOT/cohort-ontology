        <obo:IAO_0000115>A Dutch family dataset of 483 children from 307 nuclear families and 505 adults, including parents, assessed for word and nonword reading fluency, phonological awareness and rapid automatized naming to study genetic influences on reading and language.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>FIOLA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Familial Influences On Literacy Abilities</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fiola</oboInOwl:hasRelatedSynonym>
