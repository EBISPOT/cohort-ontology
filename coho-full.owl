        <obo:IAO_0000112>EGAS00001000853</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of patients with gallbladder carcinoma at Xinhua Hospital affiliated with Shanghai Jiao Tong University whose paired tumour and normal samples undergo sequencing to investigate somatic mutations and their clinical associations.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym Shanghai also denotes Shanghai CRC Study (COHO:0002708); this term is Shanghai Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">57</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Shanghai</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <rdfs:label xml:lang="en">Shanghai Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid1700">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003220"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000153"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid1700"/>
        <obo:IAO_0000116>gallbladder carcinoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://metadata.ega-archive.org/studies/EGAS00001000853</oboInOwl:hasDbXref>
        <rdfs:comment>Patients with gallbladder carcinoma (GBC), the most aggressive malignancy of the biliary tract, have a poor prognosis. Here, we report our identification of somatic mutations of GBCs in 57 tumor-normal pairs by use of a combination of exome sequencing and ultra-deep sequencing of cancer-related genes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000153"/>
