    <!-- http://www.ebi.ac.uk/coho/COHO_0002350 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002350">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000481"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. The Singapore Cardiovascular Cohort Study 2 is published jointly with the Singapore Prospective Study Program as one study, SP2/SCCS2 (PMID:19914996, PMID:23405065). The bare name the Catalog gives, Singapore Cardiovascular Cohort Study, is that of the earlier cohort it re-examined and is not carried over. Replaced by COHO:0000481 (Singapore Prospective Study Program), which now carries this term&apos;s names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Singapore Cardiovascular Cohort Study</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002351 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002351">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20021"/>
        <rdf:type rdf:nodeID="genid20023"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000374"/>
        <obo:IAO_0000112>PGS001775</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:34541285</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort study, with inclusion from June 2014, of consecutive patients with subjective cognitive decline, without major psychiatric or neurological disorders, who presented at the memory clinic of the Alzheimer Center of VU University Medical Center Amsterdam, the Netherlands. After the clinic&apos;s standardised dementia screening they are followed annually, with repeated blood and cerebrospinal fluid collection for biobanking and optional amyloid PET, to study clinical progression and the factors contributing to subjective cognitive decline.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">151</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SCIENCe</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SCIENCe project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Subjective Cognitive Impairment Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20021">
