        <oboInOwl:hasDbXref>PMID:35998220</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9436320/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Familial Influences on Literacy Abilities cohort is supported by the University of Amsterdam, the Max Planck Institue Nijmegen, and NWO Grants Rubicon 446-12-005 and VENI 451-15-017.</rdfs:comment>
    </owl:Axiom>
