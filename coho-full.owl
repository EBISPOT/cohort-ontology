        <obo:IAO_0000116>attenuated FAP</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4217335/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects enrolled in PURIFICAR are US Hispanic individuals with a clinical and/or genetic diagnosis of FAP, attenuated FAP (AFAP), hamartomatous polyposis syndromes, or Lynch syndrome.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002300"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19636"/>
        <obo:IAO_0000116>FAP</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4217335/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects enrolled in PURIFICAR are US Hispanic individuals with a clinical and/or genetic diagnosis of FAP, attenuated FAP (AFAP), hamartomatous polyposis syndromes, or Lynch syndrome.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002300"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Puerto_Rico"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23460355+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>PURIFICAR is the first and only familial cancer registry in Puerto Rico providing these services to families affected with familial cancer syndromes promoting education, testing and surveillance of at-risk family members, and focusing on cancer prevention efforts.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002300"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25389437</owl:annotatedTarget>
        <dcterms:title>Report of a Novel Mutation in MLH1 Gene in a Hispanic Family from Puerto Rico Fulfilling Classic Amsterdam Criteria for Lynch Syndrome.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25389437</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25389437+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In this paper we report a novel mutation in the hMLH1 gene in a Puerto Rican Hispanic family with Lynch syndrome recruited through the Puerto Rico Familial Colorectal Cancer Registry (PURIFICAR).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002300"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A familial cancer registry established in 2006 at the University of Puerto Rico Comprehensive Cancer Center, the first familial cancer registry in Puerto Rico, which enrols Hispanic individuals with a clinical or genetic diagnosis of a hereditary colorectal cancer or polyposis syndrome (familial adenomatous polyposis, attenuated FAP, hamartomatous polyposis syndromes or Lynch syndrome), referred with a personal or family history of possible familial colorectal cancer or polyposis by gastroenterologists, oncologists and colorectal surgeons. Consenting probands complete questionnaires on medical history, environmental exposures and cancer family history, their pedigrees are traced, and the registry offers affected families education, genetic testing and surveillance.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23460355</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25389437</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002300"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">31</owl:annotatedTarget>
        <obo:IAO_0000116>PURIFICAR FAP patients evaluated in the 2013 study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23460355+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 31 FAP (from 19 families) and 13 MAP (from 13 families) Hispanic patients recruited from the PURIFICAR were evaluated.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002300"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PURIFICAR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002301 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002301">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
