    <!-- http://www.ebi.ac.uk/coho/COHO_0001506 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001506">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13637"/>
        <rdf:type rdf:nodeID="genid13639"/>
        <rdf:type rdf:nodeID="genid13641"/>
        <rdf:type rdf:nodeID="genid13643"/>
