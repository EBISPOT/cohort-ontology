        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000418"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4857</owl:annotatedTarget>
        <obo:IAO_0000116>people of European, South Asian and African Caribbean origin aged 40-69 at baseline (1988-91), 1991</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-025-60431-y/MediaObjects/41467_2025_60431_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>SABRE is a population-based cohort initiated in 4,857 people of European, South Asian and African Caribbean origin aged 40 to 69 living in West London, UK9 .</rdfs:comment>
    </owl:Axiom>
