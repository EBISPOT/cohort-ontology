        <obo:IAO_0000112>PMID:20081857</obo:IAO_0000112>
        <obo:IAO_0000115>An observational study of patients with diabetes mellitus and of non-diabetic controls with no personal or first-degree family history of diabetes and with normal fasting glucose, recruited and evaluated by the Diabetes Center of Massachusetts General Hospital and the Division of Endocrinology and Metabolism of Brigham and Women&apos;s Hospital in Boston, United States, and assembled with support from Roche; its participants were genotyped for glycaemic-trait and type 2 diabetes association studies of the MAGIC consortium.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">616</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">895</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>Partners/Roche</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Partners/Roche cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ROCHE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Roche</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Roche Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Partners/Roche Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19848">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002326"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19848"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3927411/</oboInOwl:hasDbXref>
        <rdfs:comment>We obtained fasting blood samples and measured HbA1c, GA, and direct LDL-C, as well as other parameters, in a multi-ethnic population of 616 male and female patients with type 2 diabetes and 895 non-diabetic controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002326"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3927411/</oboInOwl:hasDbXref>
        <rdfs:comment>Patients with diabetes mellitus and non-diabetic control subjects, with no personal history or family history of diabetes in first degree relatives and with normal (&lt; 6.1 mmol/l or 110 mg/dl) fasting glucose levels, were recruited and evaluated by the Diabetes Center, Massachusetts General Hospital and the Division of Endocrinology and Metabolism, Brigham and Women&apos;s Hospital as part of an observational study of diabetic and pre-diabetic subjects.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002326"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20081857</owl:annotatedTarget>
        <dcterms:title>Genetic variation in GIPR influences the glucose and insulin responses to an oral glucose challenge.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20081857</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.521/MediaObjects/41588_2010_BFng521_MOESM16_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Roche Study: Details of the sample have been previously described.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002326"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An observational study of patients with diabetes mellitus and of non-diabetic controls with no personal or first-degree family history of diabetes and with normal fasting glucose, recruited and evaluated by the Diabetes Center of Massachusetts General Hospital and the Division of Endocrinology and Metabolism of Brigham and Women&apos;s Hospital in Boston, United States, and assembled with support from Roche; its participants were genotyped for glycaemic-trait and type 2 diabetes association studies of the MAGIC consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19465013</obo:IAO_0000119>
