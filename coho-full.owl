        <obo:IAO_0000116>all persons aged 85 or over living in Vantaa on 1 April 1991 (the study population)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4574809/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Vantaa 85+ study includes all 601 persons aged 85 years or over who were living in the city of Vantaa (Southern Finland), on 1 April 1991.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002538"/>
