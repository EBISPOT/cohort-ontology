    <!-- http://www.ebi.ac.uk/coho/COHO_0001989 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001989">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17416"/>
        <rdf:type rdf:nodeID="genid17418"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Latvia"/>
        <obo:IAO_0000112>PGS004896</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:37893052</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal study, started in 2013, of adults in Latvia with type 1 diabetes diagnosed before the age of 40, with insulin treatment started within one year of diagnosis and C-peptide below 0.3 nmol/L, excluding those with chronic kidney disease other than diabetic kidney disease, who are examined, give blood and urine samples and answer questionnaires at baseline and at follow-up visits every three years, to study diabetic kidney disease and the other complications of diabetes. It is part of the InterDiane consortium.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>LatDiane</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LatDiane study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Latvian diabetic nephropathy study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Latvian Diabetic Nephropathy Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17416">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005016"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid17418">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005147"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001989"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17416"/>
        <obo:IAO_0000116>diabetic kidney disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10604159/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a cross-sectional study with 100 T1D patients; 27 of them had progressive DKD, defined as an estimated glomerular filtration rate (eGFR) decline ≥3 mL/min/year or increased albuminuria stage, over a mean follow-up time of 5.89 ± 1.73 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001989"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17418"/>
        <obo:IAO_0000116>type 1 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10604159/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a cross-sectional study with 100 T1D patients; 27 of them had progressive DKD, defined as an estimated glomerular filtration rate (eGFR) decline ≥3 mL/min/year or increased albuminuria stage, over a mean follow-up time of 5.89 ± 1.73 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001989"/>
