    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000732"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of colon cancer in Kentucky, United States, that recruited incident cases through the Kentucky Cancer Registry and population controls by random-digit dialling from 2003 to 2010, to study genetic and environmental risk factors for colon cancer.</owl:annotatedTarget>
