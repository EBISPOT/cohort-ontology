    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001762"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33372680</owl:annotatedTarget>
        <dcterms:title>Performance of Breast Cancer Polygenic Risk Scores in 760 Female CHEK2 Germline Mutation Carriers.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33372680</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8246885/</oboInOwl:hasDbXref>
        <rdfs:comment>All individuals were identified through diagnostic germline testing in families recruited between January 1997 and June 2018 by 17 centers of the German Consortium for Hereditary Breast and Ovarian Cancer (GC-HBOC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001762"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The research collection of the German Consortium for Hereditary Breast and Ovarian Cancer, a nationwide consortium of university centres for familial breast and ovarian cancer in Germany, made up of index patients and relatives from families at high risk of hereditary breast and ovarian cancer who met the consortium&apos;s criteria for germline testing and were counselled and tested at its centres from the late 1990s on, with clinical and family-history data held in a central registry at the University of Leipzig; its BRCA1/2-mutation-negative familial breast cancer index cases are studied within the Breast Cancer Association Consortium and its data are also part of the Consortium of Investigators of Modifiers of BRCA1/2.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28542378</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32424353</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33372680</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001762"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">561</owl:annotatedTarget>
        <obo:IAO_0000116>GC-HBOC female CHEK2-carrier clinical analysis reported in 2021</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8246885/</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 760 female CHEK2 mutation carriers were included; 561 women were affected with BC, of whom 74 developed metachronous contralateral BC (mCBC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
