        <obo:IAO_0000112>PMID:22426144</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of endometrial cancer in Hawaii, United States, whose cases were ascertained between 1988 and 1993 and whose controls were matched to them on age and ethnicity, with mainly non-white participants. It is one of the studies of the Epidemiology of Endometrial Cancer Consortium (E2C2), and its samples were genotyped at Vanderbilt University for the final replication stage of a 2012 genome-wide association study of endometrial cancer.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym HAW also denotes Hawaii Ovarian Cancer Study (COHO:0001870); this term is Hawaii Endometrial Cancer Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">168</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">574</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>HAW</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HECS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Hawaii Endometrial Cancer Study</rdfs:label>
    </owl:NamedIndividual>
