        <oboInOwl:hasRelatedSynonym>MAGICS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Multicentre Asthma Genetics in Childhood Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>followMAGICS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Multicenter Asthma Genetics in Childhood Study</rdfs:label>
    </owl:NamedIndividual>
