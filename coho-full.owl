    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000524"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2230</owl:annotatedTarget>
        <obo:IAO_0000116>children in the population cohort at wave 1 (clinical cohort of 543 in addition), 2001</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:25431468</oboInOwl:hasDbXref>
        <rdfs:comment>TRAILS consists of a population cohort (N=2230) and a clinical cohort (N=543), both of which were followed from about age 11 years onwards.</rdfs:comment>
