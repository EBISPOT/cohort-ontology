        <oboInOwl:hasRelatedSynonym>French Association STudy Evaluating RISK for sporadic colorectal cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>French Association Study Evaluating RISK for sporadic colorectal cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>French Case-Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
