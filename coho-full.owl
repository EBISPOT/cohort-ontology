        <rdfs:comment>As a disease-oriented biobank based on high-quality biosamples and clinical data of hospitalized and non-hospitalized SARS-CoV-2 PCR positive and negative individuals.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000997"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
