    <!-- http://www.ebi.ac.uk/coho/COHO_0001177 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001177">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10698"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000927"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002549"/>
        <obo:IAO_0000112>GCST90002227</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based cohort of adults from the county of Västerbotten in northern Sweden, nested within the Northern Sweden Health and Disease Study, whose members had baseline health and lifestyle examinations in the Västerbotten Intervention Programme between 1985 and 2004, in the years of their 40th, 50th or 60th birthdays, with a repeat examination about ten years later. It was established in 2008 to study the genetics of cardiometabolic traits and interactions between genes and lifestyle.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GLACIER</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GLACIER Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gene x Lifestyle interactions And Complex traits Involved in Elevated disease Risk Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gene-Lifestyle interactions And Complex traits Involved in Elevated disease Risk Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Gene-Lifestyle Interactions and Complex Traits Involved in Elevated Disease Risk Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10698">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000015"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001177"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10698"/>
        <obo:IAO_0000116>gene-lifestyle interactions</obo:IAO_0000116>
        <obo:IAO_0000116>lifestyle (diet, physical activity, smoking, alcohol)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4225623/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Established in 2008, the GLACIER Study comprises a cohort suitable for studies on the genetics of complex cardio-metabolic traits and gene-environment interactions, nested within the NSHDS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001177"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3012192/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Sixteen fasting glucose-raising loci were genotyped in middle-aged adults from the Gene x Lifestyle interactions And Complex traits Involved in Elevated disease Risk (GLACIER) Study, a population-based prospective cohort study from northern Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001177"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000927"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3012192/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GLACIER Study is a prospective, population-based cohort study comprising 19,547 adults from the northern Swedish county of Västerbotten, nested within the Northern Sweden Health and Disease Study (20).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001177"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002549"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3679547/</oboInOwl:hasDbXref>
        <rdfs:comment>The GLACIER study is a nested study within the Northern Sweden Health and Disease Study; phenotyping was conducted as part of the Västerbotten Intervention Project.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001177"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90002227</owl:annotatedTarget>
        <dcterms:title>The trans-ancestral genomic architecture of glycemic traits.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34059833</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-021-00852-9/MediaObjects/41588_2021_852_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>GLACIER</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001177"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of adults from the county of Västerbotten in northern Sweden, nested within the Northern Sweden Health and Disease Study, whose members had baseline health and lifestyle examinations in the Västerbotten Intervention Programme between 1985 and 2004, in the years of their 40th, 50th or 60th birthdays, with a repeat examination about ten years later. It was established in 2008 to study the genetics of cardiometabolic traits and interactions between genes and lifestyle.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20870969</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25396097</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26625858</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001177"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20000</owl:annotatedTarget>
        <obo:IAO_0000116>participants with a baseline examination 1985-2004 (approximate)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4225623/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The GLACIER Study includes roughly 20,000 participants who underwent the baseline health examination between 1985 and 2004, of whom around 7,000 have undergone a 10-year follow-up exam (with ongoing data collection).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
