        <obo:IAO_0000112>GCST90002244</obo:IAO_0000112>
        <obo:IAO_0000115>An obesity-enriched cohort of children and adolescents from the Leipzig area, Germany, recruited through the paediatric obesity outpatient clinic of Leipzig University Medical Center and run by its Center for Pediatric Research, with oral glucose tolerance tests, serum and DNA samples collected at clinic visits and regular follow-up, some into adulthood, to identify genetic variants and biomarkers underlying childhood obesity and its metabolic consequences.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1745</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Extended Geno- and Phenotyping of Overweight and Obese Children and Adolescents</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LEIPZIG Kids</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LEIPZIG-kids</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LEIPZIG_CHILDHOOD_IFB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leipzig</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leipzig Childhood Obesity Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leipzig Childhood Obesity Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leipzig Obesity Childhood Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leipzig childhood obesity cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leipzig-childhood_IFB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Leipzig Childhood Obesity cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12355">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011122"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001366"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12355"/>
        <obo:IAO_0000116>obesity</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12575610/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this study, we adopt a comprehensive approach to describe the transition of children and adolescents with overweight or obesity into adulthood from an obesity center in Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001366"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12575610/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this study, we adopt a comprehensive approach to describe the transition of children and adolescents with overweight or obesity into adulthood from an obesity center in Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001366"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90002244</owl:annotatedTarget>
        <dcterms:title>The trans-ancestral genomic architecture of glycemic traits.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34059833</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7610958/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>LEIPZIG-kids LEIPZIG Kids were supported by the Federal Ministry of Education and Research (BMBF), Germany, Integrated Research and Treatment Centre 60 (IFB) Adiposity Diseases FKZ: 01EO1001</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001366"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An obesity-enriched cohort of children and adolescents from the Leipzig area, Germany, recruited through the paediatric obesity outpatient clinic of Leipzig University Medical Center and run by its Center for Pediatric Research, with oral glucose tolerance tests, serum and DNA samples collected at clinic visits and regular follow-up, some into adulthood, to identify genetic variants and biomarkers underlying childhood obesity and its metabolic consequences.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37465325</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41168416</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT04491344</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001366"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1745</owl:annotatedTarget>
        <obo:IAO_0000116>patients in the cohort as rescreened for a genetic study (2022)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:36536132</oboInOwl:hasDbXref>
        <rdfs:comment>As the type of mutation escapes standard genetic screening algorithms, we rescreened the Leipzig Childhood Obesity cohort of 1,745 patients and identified four additional patients with the identical mutation, ectopic ASIP expression and a similar phenotype.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001366"/>
