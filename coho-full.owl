        <obo:IAO_0000112>GCST90026612</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective national registry, sponsored by Assistance Publique–Hôpitaux de Paris and coordinated at the Hôpital Européen Georges Pompidou in Paris, of adults with renal, cervical or intracranial artery fibromuscular dysplasia recruited from 2009 to 2014 at 16 university hospitals in France and Belgium, with standardised clinical and imaging data and leukocyte DNA collected to study multisite disease and to search for susceptibility genes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">499</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ARCADIA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Assessment of Renal and Cervical Artery Dysplasia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Assessment of Renal and Cervical Artery DysplasIA</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11589">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006761"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001281"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11589"/>
        <obo:IAO_0000116>fibromuscular dysplasia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33998257+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The ARCADIA registry includes women or men aged ≥18 years, with a diagnosis of renal, cervical, or intracranial artery FMD, who were prospectively recruited at 16 university hospitals in France and Belgium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001281"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33998257+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The ARCADIA registry includes women or men aged ≥18 years, with a diagnosis of renal, cervical, or intracranial artery FMD, who were prospectively recruited at 16 university hospitals in France and Belgium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001281"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90026612</owl:annotatedTarget>
        <dcterms:title>Genetic investigation of fibromuscular dysplasia identifies risk loci and shared genetics with common cardiovascular diseases.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34654805</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8521585/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>FMD patients were included from the ARCADIA (Assessment of Renal and Cervical Artery DysplasIA) register, a national FMD registry at the Georges Pompidou European Hospital, APHP, Paris8.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001281"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective national registry, sponsored by Assistance Publique–Hôpitaux de Paris and coordinated at the Hôpital Européen Georges Pompidou in Paris, of adults with renal, cervical or intracranial artery fibromuscular dysplasia recruited from 2009 to 2014 at 16 university hospitals in France and Belgium, with standardised clinical and imaging data and leukocyte DNA collected to study multisite disease and to search for susceptibility genes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33998257</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34654805</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT02884141</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001281"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">499</owl:annotatedTarget>
        <obo:IAO_0000116>patients recruited into the registry 2009-2014 (FMD confirmed in 469)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8483547/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As previously reported, among the 499 patients recruited in the ARCADIA study, FMD was confirmed in 469 patients, of whom 75 (16%) were men and 415 (89%) were Caucasian (Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001281"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ARCADIA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001282 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001282">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11596"/>
        <rdf:type rdf:nodeID="genid11598"/>
