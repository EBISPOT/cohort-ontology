        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000576"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid5139"/>
