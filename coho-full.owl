        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2149</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>DKLS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DLS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Danish longevity study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Danish Longevity Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001670"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
