        <obo:IAO_0000112>PMID:39679959</obo:IAO_0000112>
        <obo:IAO_0000115>A national longitudinal cohort of people born in 1989-90 who were in Year 9 of secondary school in England in 2004, sampled through schools with over-sampling of deprived schools and ethnic minorities, begun by the Department for Education and run since 2013 by the Centre for Longitudinal Studies at University College London, following their education, work, economic circumstances, family life, health and wellbeing.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16122</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/Next%20Steps</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>LSYPE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Longitudinal Study of Young People in England</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Longitudinal Study of Young People in England: Next Steps</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Next Steps</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002667"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11561396/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Next Steps (previously known as the Longitudinal Study of Young People in England, LSYPE) is an ongoing, multidisciplinary, longitudinal study following 16 122 people who were in secondary school in England and were born in 1989–90.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002667"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39679959</owl:annotatedTarget>
        <dcterms:title>A Longitudinal Analysis Comparing the Mental Health of Children By Level of Young Carer Status.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39679959</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39679959+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The study utilized the Longitudinal Study of Young People in England: Next Steps (LSYPE), a cohort study of over 12,500 children aged 13 in 2004.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002667"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A national longitudinal cohort of people born in 1989-90 who were in Year 9 of secondary school in England in 2004, sampled through schools with over-sampling of deprived schools and ethnic minorities, begun by the Department for Education and run since 2013 by the Centre for Longitudinal Studies at University College London, following their education, work, economic circumstances, family life, health and wellbeing.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:39540417</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002667"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16122</owl:annotatedTarget>
        <obo:IAO_0000116>cohort members who ever took part (2004-2023), including the Sweep 4 ethnic minority boost</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC11561396/</oboInOwl:hasDbXref>
        <rdfs:comment>The total number of cohort members who have ever participated in the study is 16 122, including 352 Black Caribbean and Black African pupils who joined the study at Sweep 4 as part of an ethnic minority boost.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002667"/>
