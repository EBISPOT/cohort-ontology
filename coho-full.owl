        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7731378/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The MEC was formed by combining two existing cohorts: the Singapore Prospective Study Program (SP2) and the Singapore Cardiovascular Cohort Study (SCCS2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000481"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90093191</owl:annotatedTarget>
        <dcterms:title>Multi-Ancestry Genome-wide Association Study Accounting for Gene-Psychosocial Factor Interactions Identifies Novel Loci for Blood Pressure Traits.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34734193</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>SP2 (Singapore Prospective Study Program): The SP2 is a population-based study of diabetes and cardiovascular disease in Singapore.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000481"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005363</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry polygenic risk scores for the prediction of type 2 diabetes and complications in diverse ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40778152</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000481"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study of diabetes and cardiovascular disease in Singapore that re-visited, between 2003 and 2007, Chinese, Malay and Asian-Indian adults randomly sampled for four earlier cross-sectional studies (the Thyroid and Heart Study, the 1992 and 1998 National Health Surveys and the National University of Singapore Heart Study), with questionnaires and clinical examinations.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29477148</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000481"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7742</owl:annotatedTarget>
        <obo:IAO_0000116>participants who completed the questionnaire (2004-2007); 5157 also examined</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3504343/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 10 633 individuals were invited; 7742 subjects (response rate 74.1%) completed the health questionnaire, of which 5157 (66.6% of those who completed the questionnaire or 49.4% of all eligible subjects) also attended the health examination.</rdfs:comment>
    </owl:Axiom>
