    <!-- http://www.ebi.ac.uk/coho/COHO_0002044 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002044">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17825"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000752"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000768"/>
        <obo:IAO_0000112>PGS000751</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:31226226</obo:IAO_0000112>
        <obo:IAO_0000115>Epidemiological case-control studies of prostate cancer conducted since 1996 by the University of Texas MD Anderson Cancer Center in the Houston metropolitan area, whose cases, not restricted by Gleason score, stage or PSA, were accrued from institutions of the Houston Medical Center and whose controls were identified by random-digit dialling or among hospital visitors and frequency-matched to cases on age and race, with lifestyle, demographic and family-history data collected by a standardised questionnaire.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MDA also denotes MD Anderson Ovarian Cancer Study (COHO:0002047) and MD Anderson Renal Cell Cancer Study (COHO:0002048); this term is Prostate Cancer Case-Control Studies at MD Anderson.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The acronym MDACCS also denotes MD Anderson Cancer Center lung cancer study (COHO:0000874), MD Anderson Cancer Center melanoma study (COHO:0000875), MD Anderson Ovarian Cancer Study (COHO:0002047) and MD Anderson Renal Cell Cancer Study (COHO:0002048); this term is Prostate Cancer Case-Control Studies at MD Anderson.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">543</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">474</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>MDA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MDACCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Prostate Cancer Case-Control Studies at MD Anderson</rdfs:label>
    </owl:NamedIndividual>
