    <!-- http://www.ebi.ac.uk/coho/COHO_0002115 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002115">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18374"/>
        <rdf:type rdf:nodeID="genid18376"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PGS000906</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33216869</obo:IAO_0000112>
        <obo:IAO_0000115>A brain bank established at the end of 1985 at the Netherlands Institute for Brain Research, in collaboration with nursing homes in and around Amsterdam, the Netherlands, which performs rapid autopsies of donors who gave informed consent during life for the research use of their brain tissue and medical files, originally to supply post-mortem brain tissue from Alzheimer&apos;s disease patients and controls.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4003</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NBB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
