    <!-- http://www.ebi.ac.uk/coho/COHO_0001258 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001258">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90449022</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based longitudinal study of the disablement process in older Mexican Americans and European Americans in San Antonio, Texas. Its participants, the oldest members (aged 65 and over) of the San Antonio Heart Study cohort, had been randomly sampled from low-, middle- and high-income (barrio, transitional and suburban) neighbourhoods. They had a baseline examination in 1992–1996, combining a home-based assessment with a performance-based assessment at a clinical research center, and three follow-up examinations 18 months apart in 2000–2005.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">749</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SALSA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The San Antonio Longitudinal Study of Aging</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">San Antonio Longitudinal Study of Aging</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001258"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25597562+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Socioeconomically and ethnically diverse neighborhoods in San Antonio, Texas.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90449022</owl:annotatedTarget>
        <dcterms:title>A genome-wide association meta-analysis of all-cause and vascular dementia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39046104</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11497727/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The San Antonio Longitudinal Study of Aging (SALSA) is a community-based study of the disablement process in older Mexican Americans (MAs) and European Americans (EAs).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based longitudinal study of the disablement process in older Mexican Americans and European Americans in San Antonio, Texas. Its participants, the oldest members (aged 65 and over) of the San Antonio Heart Study cohort, had been randomly sampled from low-, middle- and high-income (barrio, transitional and suburban) neighbourhoods. They had a baseline examination in 1992–1996, combining a home-based assessment with a performance-based assessment at a clinical research center, and three follow-up examinations 18 months apart in 2000–2005.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21054295</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21216857</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25597562</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001258"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">749</owl:annotatedTarget>
        <obo:IAO_0000116>people who completed the 1992-1996 baseline examination</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3058917/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Of the remaining 1,062 individuals, 749 completed the baseline examination for a response rate of 70.5%.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001258"/>
