        <oboInOwl:hasRelatedSynonym>Italian Atherosclerosis Thrombosis and Vascular Biology</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Italian Atherosclerosis, Thrombosis and Vascular Biology Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
