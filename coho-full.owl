    <!-- http://www.ebi.ac.uk/coho/COHO_0001477 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001477">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13347"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:37264683</obo:IAO_0000112>
        <obo:IAO_0000115>An investigator-initiated, multicentre, parallel-group, open, blinded-outcome-assessment randomised trial sponsored by the Atrial Fibrillation Network (AFNET), which from July 2011 to December 2016 randomised patients with atrial fibrillation diagnosed within the previous year and cardiovascular risk factors, at 135 sites in 11 European countries, to early rhythm control therapy or usual care, to test whether early rhythm control prevents cardiovascular complications; its biosample substudy took blood at enrolment from consenting patients.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2789</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AFNET</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET 4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET 4 biosample study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET 4 trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET4 biosample study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET4 trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Early Therapy of Atrial Fibrillation for Stroke Prevention Trial</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Early Treatment of Atrial Fibrillation for Stroke Prevention Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13347">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004981"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001477"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13347"/>
        <obo:IAO_0000116>atrial fibrillation</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37264683+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The randomized Early Treatment of Atrial Fibrillation for Stroke Prevention Trial found that early rhythm control reduces cardiovascular events in patients with recently diagnosed atrial fibrillation (AF) compared with usual care.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001477"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Europe"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12311819/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>EAST-AFNET 4 is an international, investigator-initiated, parallel-group, open, blinded outcome assessment randomized clinical trial conducted in 11 European countries.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001477"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10227663/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Based on data from the German subsample (n = 1 664) of the EAST-AFNET 4 randomised controlled trial, a cost-effectiveness analysis was conducted using time to first occurrence of a primary outcome event (cardiovascular death, stroke, or hospitalization for worsening heart failure or acute coronary syndrome) and time to death as effect measures.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001477"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:37264683</owl:annotatedTarget>
        <dcterms:title>Association of genetic risk and outcomes in patients with atrial fibrillation: interactions with early rhythm control in the EAST-AFNET4 trial.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37264683</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10405565/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we analysed the interaction between genetic AF and stroke risk and cardiovascular events in the EAST-AFNET4 biosample study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001477"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An investigator-initiated, multicentre, parallel-group, open, blinded-outcome-assessment randomised trial sponsored by the Atrial Fibrillation Network (AFNET), which from July 2011 to December 2016 randomised patients with atrial fibrillation diagnosed within the previous year and cardiovascular risk factors, at 135 sites in 11 European countries, to early rhythm control therapy or usual care, to test whether early rhythm control prevents cardiovascular complications; its biosample substudy took blood at enrolment from consenting patients.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34473249</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37264683</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40737012</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT01288352</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001477"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2789</owl:annotatedTarget>
        <obo:IAO_0000116>patients randomised July 2011-December 2016</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8982435/</oboInOwl:hasDbXref>
        <rdfs:comment>Between July 2011 and December 2016, 135 sites in 11 countries randomized 2789 patients to the EAST-AFNET 4 trial.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001477"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AFNET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001477"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EAST</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001477"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EAST-AFNET 4</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
