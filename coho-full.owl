        <obo:IAO_0000112>PGS000665</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:20446946</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised, multicentre phase III secondary-prevention trial in patients with recent, MRI-confirmed symptomatic lacunar (small subcortical) stroke, recruited between 2003 and 2011 at clinical centres in North America, Latin America and Spain, which tested in a two-by-two factorial design aspirin plus clopidogrel against aspirin alone and a lower against a higher systolic blood-pressure target for preventing recurrent stroke.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3020</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SPS3</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Secondary Prevention of Small Subcortical Strokes trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Secondary Prevention of Small Subcortical Strokes</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20405">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
