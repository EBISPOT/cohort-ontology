        <dcterms:title>Chronic air pollution-induced subclinical airway inflammation and polygenic susceptibility.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36151579</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9508765/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We used data from 296 women (69–79 years) enrolled in the population-based SALIA cohort (Study on the influence of Air pollution on Lung function, Inflammation and Aging).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002618"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based longitudinal cohort of women aged 55 years at recruitment from the industrialised Ruhr Area and rural areas north of it (Borken, Dülmen) in North Rhine-Westphalia, Germany, examined at baseline between 1985 and 1994 and followed up from 2006 onwards; initiated by the State Government of North Rhine-Westphalia to study the health effects of air pollution in women, and run by the IUF – Leibniz Research Institute for Environmental Medicine, Düsseldorf.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24645673</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
