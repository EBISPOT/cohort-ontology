    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0024647">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002118"/>
        <obo:IAO_0000115>Stone(s) within the urinary tract.</obo:IAO_0000115>
        <rdfs:label>urolithiasis</rdfs:label>
    </owl:Class>
    


