        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000985"/>
        <obo:IAO_0000112>PGS005200</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:40691366</obo:IAO_0000112>
        <obo:IAO_0000115>A case set of patients with atrial fibrillation, drawn from the roughly 1,000 patients who came to the University of California San Francisco electrophysiology laboratory for electrophysiology procedures and are held within the UCSF Cardiovascular Research Institute Resource in Arteriosclerosis and Metabolic Disease, San Francisco, United States. Participants were densely phenotyped for electrophysiological characteristics, by interview and review of medical records, with biospecimens collected from intra- and extra-cardiac chambers, for genetic studies of atrial fibrillation; its early-onset cases were whole-genome sequenced in the NHLBI TOPMed programme.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">113</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>The University of California San Francisco Atrial Fibrillation Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UCS-AF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UCSF Atrial Fibrillation Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UCSF-AF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">University of California San Francisco Atrial Fibrillation Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21080">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004981"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002483"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
