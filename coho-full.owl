    <!-- http://www.ebi.ac.uk/coho/COHO_0001412 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001412">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid12806"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>GCST90559230</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of adults with symptomatic (stage C) heart failure of different aetiologies, prospectively enrolled from the outpatient clinic of the Heart Institute of the University of São Paulo Medical School in São Paulo, Brazil. Its genotyped participants, with atrial fibrillation ascertained from electrocardiograms and medical records, have contributed to genome-wide association studies of atrial fibrillation.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SPHFC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sao Paolo Heart Failure Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Sao Paulo Heart Failure Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12806">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005252"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001412"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12806"/>
        <obo:IAO_0000116>heart failure</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Only patients older than 18 years and with symptomatic heart failure (stage C) were enrolled.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001412"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>SPHFC: Participants for the Sao Paolo Heart Failure Cohort (SPHFC) were prospectively enrolled from the outpatient clinic at the Heart Institute, the University of Sao Paulo Medical School, Sao Paulo, Brazil.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001412"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90559230</owl:annotatedTarget>
        <dcterms:title>Meta-analysis of genome-wide associations and polygenic risk prediction for atrial fibrillation in more than 180,000 cases.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40050429</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-02072-3/MediaObjects/41588_2024_2072_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The following studies have previously been described: ARIC8 , BBJ9 , deCODE10 , DiscovEHR10 , FHS8 , HUNT10 , KAFN11 , MESA6 , MGI10 , MGH CAMP6 , PHB12 , SiGN13 , SPHFC6 , UKBB14 and WGHS8 .</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001412"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of adults with symptomatic (stage C) heart failure of different aetiologies, prospectively enrolled from the outpatient clinic of the Heart Institute of the University of São Paulo Medical School in São Paulo, Brazil. Its genotyped participants, with atrial fibrillation ascertained from electrocardiograms and medical records, have contributed to genome-wide association studies of atrial fibrillation.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:40050429</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
