        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005311"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid509"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://epicenter.i-med.ac.at/research/studies/proof-athero/bruneck/</oboInOwl:hasDbXref>
        <rdfs:comment>The initial principal aim of the study was to investigate atherosclerosis and cardiovascular disease, but it quickly extended its focus to many age-dependent diseases such as neurological diseases, disorders of the bone, and cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid511"/>
        <obo:IAO_0000116>atherosclerosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://epicenter.i-med.ac.at/research/studies/proof-athero/bruneck/</oboInOwl:hasDbXref>
        <rdfs:comment>The initial principal aim of the study was to investigate atherosclerosis and cardiovascular disease, but it quickly extended its focus to many age-dependent diseases such as neurological diseases, disorders of the bone, and cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000021"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://metadata.ega-archive.org/studies/EGAS00001004453</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we study 304 fecal samples collected from the elderly subjects in Italy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS00001004453</owl:annotatedTarget>
        <dcterms:title>Elderly microbiome from the Bruneck study</dcterms:title>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001004453</oboInOwl:hasDbXref>
        <rdfs:comment>Elderly microbiome from the Bruneck study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST001361</owl:annotatedTarget>
        <dcterms:title>Association between chromosome 9p21 variants and the ankle-brachial index identified by a meta-analysis of 21 genome-wide association studies.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22199011</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3303225/</oboInOwl:hasDbXref>
        <rdfs:comment>The replication studies included 5 population-based studies and 3 clinically-based studies including a total of over 16,000 participants: the Bruneck Study (n=786)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of residents of Bruneck, Italy, sampled by age and sex in 1990 and followed through repeated examinations to investigate atherosclerosis, cardiovascular disease and other age-related disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>https://epicenter.i-med.ac.at/research/studies/proof-athero/bruneck/</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>GPT-6 (OpenAI Codex), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000021"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">933</owl:annotatedTarget>
        <obo:IAO_0000116>women and men examined at the 1990 baseline (of 1,000 invited)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:32172649</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 933 women and men participated in the baseline examination in 1990 (participation rate, 93.3%); 703 of 764 individuals being alive in 2000 participated in the 2000 re‐evaluation (participation rate, 92.0%).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000021"/>
