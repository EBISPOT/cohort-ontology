        <rdfs:comment>The Nottingham Smokers cohort is an ongoing collection in Nottingham using the following criteria; Caucasian, &gt; 40 years of age and smoking history of &gt; 10 pack years (currently n=538).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002176"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
