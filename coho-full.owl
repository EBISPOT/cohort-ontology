        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4589895/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1616 subjects used in this study are part of the Sikh Diabetes Study/Asian Indian Diabetic Heart Study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000029"/>
