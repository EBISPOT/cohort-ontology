        <oboInOwl:hasRelatedSynonym>UKBGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Breakthrough Generations Study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.breakthroughgenerations.org.uk/home"/>
    </owl:NamedIndividual>
