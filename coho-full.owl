        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3677562/</oboInOwl:hasDbXref>
        <rdfs:comment>Hannover-AlmatyEndometrial CancerStudy HAECS Kazakhstan; Hospital-based, case-controlstudy 218 232 Taqman</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001837"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Kazakhstan"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3677562/</oboInOwl:hasDbXref>
        <rdfs:comment>HAECS Kazakhstan; Hospital-based</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001837"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22426144</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies a possible susceptibility locus for endometrial cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22426144</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3372671/</oboInOwl:hasDbXref>
        <rdfs:comment>The final replication stage (Stage 3b) included 5,936 cases and 8,166 controls from the Bavarian Endometrial Cancer Study (BECS), Connecticut Endometrial Cancer Study (CECS), Hannover-Almaty Endometrial Cancer Study (HAECS)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001837"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of endometrial cancer in Kazakhstan, whose own investigators genotyped its samples with TaqMan assays for the final replication stage of a 2012 genome-wide association study of endometrial cancer, and whose data were used again in a 2013 study of inflammation pathway genes and endometrial cancer risk.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22426144</obo:IAO_0000119>
