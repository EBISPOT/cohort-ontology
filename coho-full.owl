        <obo:IAO_0000112>PGS005203</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:40691366</obo:IAO_0000112>
        <obo:IAO_0000115>An unselected population cohort of adult volunteers in South West England, recruited from 2010 to 2018 through general practices, workplaces, community events and local media, whose samples are held in the Peninsula Research Bank, run by the NIHR Exeter Clinical Research Facility as a recall-by-genotype resource for research on type 2 diabetes, cardiovascular disease and healthy ageing.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11074</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>EXTEND</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EXTEND/PRB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Exeter 10,000</oboInOwl:hasRelatedSynonym>
