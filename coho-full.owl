    <!-- http://www.ebi.ac.uk/coho/COHO_0001647 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001647">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14827"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS000777</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33958783</obo:IAO_0000112>
        <obo:IAO_0000115>A double-blind, multicentre, placebo-controlled clinical trial of the Parkinson Study Group that enrolled patients with early, otherwise untreated Parkinson&apos;s disease at sites in the United States and Canada and randomised them, in a 2 x 2 factorial design, to deprenyl, tocopherol (vitamin E), both or placebo, to test whether long-term treatment extends the time until disability requires levodopa therapy.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">800</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>DATATOP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Deprenyl And Tocopherol Antioxidative Therapy Of Parkinsonism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Deprenyl and Tocopherol Antioxidative Therapy of Parkinsonism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Deprenyl and tocopherol antioxidative therapy of parkinsonism</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14827">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001647"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14827"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2508608+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>At 28 US and Canadian sites, 800 eligible patients in the early stages of untreated Parkinson&apos;s disease were enrolled in DATATOP and randomized to (1) active deprenyl, (2) active tocopherol, (3) active deprenyl and tocopherol, or (4) placebo treatments.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001647"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2508608+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>At 28 US and Canadian sites, 800 eligible patients in the early stages of untreated Parkinson&apos;s disease were enrolled in DATATOP and randomized to (1) active deprenyl, (2) active tocopherol, (3) active deprenyl and tocopherol, or (4) placebo treatments.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001647"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000777</owl:annotatedTarget>
        <dcterms:title>Genome-wide survival study identifies a novel synaptic locus and polygenic score for cognitive progression in Parkinson&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33958783</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001647"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33958783</owl:annotatedTarget>
        <dcterms:title>Genome-wide survival study identifies a novel synaptic locus and polygenic score for cognitive progression in Parkinson&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33958783</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8459648/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>In DATATOP, the eligibility criteria required a clinical diagnosis of early, idiopathic PD (HY stages 1 or 2) with patients not on anti-parkinsonian medications.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001647"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A double-blind, multicentre, placebo-controlled clinical trial of the Parkinson Study Group that enrolled patients with early, otherwise untreated Parkinson&apos;s disease at sites in the United States and Canada and randomised them, in a 2 x 2 factorial design, to deprenyl, tocopherol (vitamin E), both or placebo, to test whether long-term treatment extends the time until disability requires levodopa therapy.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:2508608</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:2515723</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001647"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">800</owl:annotatedTarget>
        <obo:IAO_0000116>randomised patients in DATATOP</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2508608+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>At 28 US and Canadian sites, 800 eligible patients in the early stages of untreated Parkinson&apos;s disease were enrolled in DATATOP and randomized to (1) active deprenyl, (2) active tocopherol, (3) active deprenyl and tocopherol, or (4) placebo treatments.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001647"/>
