        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7098103/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Residents from the Netherlands can register themselves as a brain donor at the NBB since 1985.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002115"/>
