    <!-- http://www.ebi.ac.uk/coho/COHO_0002677 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002677">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:42005644</obo:IAO_0000112>
        <obo:IAO_0000115>A whole-population birth and parent cohort open to all children born in the state of Victoria, Australia, between October 2021 and October 2023 and their parents, recruited from December 2020 (an Advance Cohort, then newborns at Victorian maternity services and later remote and ongoing enrolment) and led from the Murdoch Children&apos;s Research Institute, which combines linked administrative and clinical data, biosamples and phenotypic waves as a platform for discovery and intervention research on child and adult health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">123516</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GenV</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Generation Victoria (GenV)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Generation Victoria</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://genv.org.au//"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002677"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13016905/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All children living in Victoria, Australia, born between 4 October 2021 and 3 October 2023 and their parents/guardians are eligible for GenV’s ‘Cohort 2020s’.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002677"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42005644</owl:annotatedTarget>
        <dcterms:title>Measuring Environmental Noise for Babies in Special Care Nurseries and Neonatal Intensive Care Units on a Large Scale: Research Methods.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42005644</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13087638/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For our current study—Generation Victoria (GenV) [18], the ethical approval is in place (Royal Children&apos;s Hospital Human Research Ethics Committee (HREC)‐2019/11), including consent to access clinical data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002677"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A whole-population birth and parent cohort open to all children born in the state of Victoria, Australia, between October 2021 and October 2023 and their parents, recruited from December 2020 (an Advance Cohort, then newborns at Victorian maternity services and later remote and ongoing enrolment) and led from the Murdoch Children&apos;s Research Institute, which combines linked administrative and clinical data, biosamples and phenotypic waves as a platform for discovery and intervention research on child and adult health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:39754130</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41844214</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002677"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">123516</owl:annotatedTarget>
        <obo:IAO_0000116>children and parents/guardians enrolled (Cohort 2020s plus Advance Cohort), 2020-2023</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC13016905/</oboInOwl:hasDbXref>
        <rdfs:comment>A further 5833 children and 9122 parents/guardians were recruited to the Advance Cohort, bringing the total participants enrolled to 123 516 (49 686 children, 73 830 parents/guardians).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002677"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GenV</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
