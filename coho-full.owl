        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">559</owl:annotatedTarget>
        <obo:IAO_0000116>eligible participants recruited November 2007 to January 2008 (overweight/obese cases and normal-weight controls)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2928335/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1,059 eligible participants (559 overweight/obese and 500 normal-weight) were successfully recruited.</rdfs:comment>
