        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:25420145</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of patients with cervical artery dissection at the University of Münster, Germany, one of the centres collaborating with the CADISP consortium that recruited patients of European origin, applying the inclusion criteria of the CADISP study, for the second sample (CADISP-2) of the 2015 genome-wide association study of cervical artery dissection.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MCADC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Muenster cervical artery dissection collection</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Muenster Cervical Artery Dissection Collection</rdfs:label>
    </owl:NamedIndividual>
