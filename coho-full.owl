        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">275</owl:annotatedTarget>
        <obo:IAO_0000116>patients enrolled, of whom 267 met full eligibility and provided baseline data</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8544781/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We enrolled 275 patients of whom 267 met full eligibility and provided baseline data.</rdfs:comment>
    </owl:Axiom>
