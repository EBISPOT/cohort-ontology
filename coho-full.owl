    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002408"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20421"/>
        <obo:IAO_0000116>epithelial ovarian cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15547181+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We compared the combination of docetaxel-carboplatin with the combination of paclitaxel-carboplatin as first-line chemotherapy for stage Ic-IV epithelial ovarian or primary peritoneal cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002408"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20423"/>
        <obo:IAO_0000116>primary peritoneal cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15547181+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We compared the combination of docetaxel-carboplatin with the combination of paclitaxel-carboplatin as first-line chemotherapy for stage Ic-IV epithelial ovarian or primary peritoneal cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002408"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16314640+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>One thousand seventy-seven patients were recruited (UK, n = 689; Europe, United States, and Australasia, n = 388).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002408"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:17925548</owl:annotatedTarget>
        <dcterms:title>Pharmacogenetic assessment of toxicity and outcome after platinum plus taxane chemotherapy in ovarian cancer: the Scottish Randomised Trial in Ovarian Cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:17925548</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17925548+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We assessed 27 selected polymorphisms based on previously described associations or putative functional effects in 16 key genes from pathways that may influence cellular sensitivity to taxanes (ABCB1, ABCC1, ABCC2, ABCG2, CDKN1A, CYP1B1, CYP2C8, CYP3A4, CYP3A5, MAPT, and TP53) and platinum (ABCC2, ABCG2, ERCC1, ERCC2, GSTP1, MPO, and XRCC1) using polymerase chain reaction and Pyrosequencing in 914 ovarian cancer patients from the Scottish Randomised Trial in Ovarian Cancer phase III trial who were treated at presentation with carboplatin and taxane regimens after cytoreductive surgery.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002408"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international multicentre phase III randomised trial (SCOTROC1) of first-line docetaxel-carboplatin versus paclitaxel-carboplatin chemotherapy for stage Ic–IV epithelial ovarian or primary peritoneal cancer, coordinated through a clinical trials unit in Glasgow and recruiting patients in the United Kingdom, elsewhere in Europe, the United States and Australasia, whose patients were followed for progression-free and overall survival and whose DNA has been used in pharmacogenetic studies and in the Ovarian Cancer Association Consortium&apos;s studies of ovarian cancer outcome.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15547181</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:16314640</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:17925548</obo:IAO_0000119>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC3650102/</obo:IAO_0000119>
        <dcterms:contributor>GPT-6 (OpenAI), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002408"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1077</owl:annotatedTarget>
        <obo:IAO_0000116>SCOTROC1 patients randomized to first-line chemotherapy</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15547181+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We randomly assigned 1077 patients to receive docetaxel at 75 mg/m2 of body surface area (1-hour intravenous infusion) or paclitaxel at 175 mg/m2 (3-hour intravenous infusion).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
