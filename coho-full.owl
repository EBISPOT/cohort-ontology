    <!-- http://www.ebi.ac.uk/coho/COHO_0002085 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002085">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18172"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:38564302</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective early-life cohort of children with atopic dermatitis at Cincinnati Children&apos;s Hospital Medical Center, United States, recruited from late 2016 in the greater Cincinnati area (southwest Ohio and northern Kentucky) through public advertising or medical records, which enrols infants and toddlers with atopic dermatitis (at first aged 1–2 years, later from a few months of age) and follows them for five years with annual visits and extensive biospecimen collection from skin, blood and saliva, to define atopic dermatitis phenotypes and endotypes, the mechanisms of its progression to food allergy, asthma and other allergic disorders, and biomarkers of asthma risk.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">557</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MPAACH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mechanisms of Progression from Atopic Dermatitis to Asthma in Children</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mechanisms of Progression of Atopic Dermatitis to Asthma in CHildren</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Mechanisms of Progression of Atopic Dermatitis to Asthma in Children</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18172">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004980"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002085"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18172"/>
        <obo:IAO_0000116>atopic dermatitis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7338239/</oboInOwl:hasDbXref>
        <rdfs:comment>Inclusion criteria were: 1) aged 1–2 years upon enrollment; 2) gestation of ≥36 weeks AND 3) a diagnosis of AD (based on the Hanifin and Rajka Criteria for Atopic Dermatitis(19)), OR the parent(s)/legal authorized representative (LAR) indicates a positive response to each of the 3 questions from the Children’s Eczema Questionnaire (CEQ) (20).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002085"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11141906/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>MPAACH, the first US prospective longitudinal early-life cohort of children with AD who complete annual visits with extensive biospecimen collection, has been previously described (12).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38564302</owl:annotatedTarget>
        <dcterms:title>Filaggrin loss-of-function variants are associated with atopic dermatitis phenotypes in a diverse, early-life prospective cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38564302</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11141906/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed deep sequencing of the FLG gene in 438 individuals from MPAACH, an early-life cohort of children with AD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002085"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective early-life cohort of children with atopic dermatitis at Cincinnati Children&apos;s Hospital Medical Center, United States, recruited from late 2016 in the greater Cincinnati area (southwest Ohio and northern Kentucky) through public advertising or medical records, which enrols infants and toddlers with atopic dermatitis (at first aged 1–2 years, later from a few months of age) and follows them for five years with annual visits and extensive biospecimen collection from skin, blood and saliva, to define atopic dermatitis phenotypes and endotypes, the mechanisms of its progression to food allergy, asthma and other allergic disorders, and biomarkers of asthma risk.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32302785</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38564302</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002085"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">557</owl:annotatedTarget>
        <obo:IAO_0000116>children with atopic dermatitis recruited by the time of the 2020 design paper (recruitment ongoing)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7338239/</oboInOwl:hasDbXref>
        <rdfs:comment>The MPAACH cohort has many strengths including its size (thus far we have recruited 557 participants), rigorous phenotyping of AD, comprehensive biospecimen collection, extensive biomarker determinations, and its longitudinal design.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002085"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MPAACH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002086 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002086">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18179"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000146"/>
        <obo:IAO_0000112>PGS000138</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:32231276</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control sample for major depressive disorder at the Max Planck Institute of Psychiatry in Munich, Germany, whose cases were patients admitted to the institute&apos;s hospital for treatment of major depressive disorder and diagnosed by psychiatrists according to DSM-IV criteria, and whose controls were drawn at random from Munich community registries and screened for the absence of any lifetime axis I disorder; it contributed genotypes to the major depressive disorder analyses of the Psychiatric Genomics Consortium.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">376</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">537</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">913</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MPIP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MPIP/MARS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Munich Morphometry Sample</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Max Planck Institute of Psychiatry Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18179">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002009"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002086"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18179"/>
        <obo:IAO_0000116>major depressive disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3837431/</oboInOwl:hasDbXref>
        <rdfs:comment>Cases and controls used in discovery and replication phases Phase Sample Subjects MDD case Control Discovery GAIN 3461 1696 1765 GenRED 2283 1030 1253 GSK 1751 887 864 MDD2000-QIMR_610 1184 433 751 MDD2000-QIMR_317 1977 1017 960 MPIP 913 376 537</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002086"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3112053/</oboInOwl:hasDbXref>
        <rdfs:comment>353 unipolar depressive inpatients (155 males, 198 females) were recruited for the Munich Antidepressant Response Signature (MARS) project (Hennings et al., 2009; Ising et al., 2009) at the Max Planck Institute of Psychiatry (MPIP) in Munich, Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002086"/>
