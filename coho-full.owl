        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2650282/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>389 subjects from the US National Emphysema Treatment Trial (NETT)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002137"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS001800</owl:annotatedTarget>
        <dcterms:title>Chronic obstructive pulmonary disease and related phenotypes: polygenic risk scores in population-based and case-control cohorts.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32649918</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002137"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32649918</owl:annotatedTarget>
        <dcterms:title>Chronic obstructive pulmonary disease and related phenotypes: polygenic risk scores in population-based and case-control cohorts.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32649918</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7429152/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Case-control studies included COPDGene (non-Hispanic white and African American participants),23 ECLIPSE,24 NETT25 and Normative Aging Study (NAS),26 SPIROMICS,27, 28 and the Lung Health Study (LHS).29, 30</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002137"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre randomised clinical trial in the United States that compared medical therapy, including pulmonary rehabilitation, with medical therapy plus lung-volume-reduction surgery in former smokers with severe bilateral emphysema and severe airflow obstruction, with survival as its primary outcome.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10593802</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:12759479</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19300482</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32649918</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002137"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1218</owl:annotatedTarget>
        <obo:IAO_0000116>patients with severe emphysema randomly assigned to lung-volume-reduction surgery or continued medical treatment</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:12759479</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1218 patients with severe emphysema underwent pulmonary rehabilitation and were randomly assigned to undergo lung-volume-reduction surgery or to receive continued medical treatment.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002137"/>
