    <!-- http://www.ebi.ac.uk/coho/COHO_0001885 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001885">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000428"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. No paper names the id, but every Icelandic genetic sample of advanced atrioventricular block is a deCODE genetics case set, drawn from Icelanders in deCODE&apos;s studies (PMID:20062063, PMID:23583979): the sample is part of the deCODE genetics Icelandic cohort. The Catalog&apos;s name describes only that disease subset and is not carried over. Replaced by COHO:0000428 (deCODE genetics Icelandic cohort), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Icelandic Atrioventricular Block Sample</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001886 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001886">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000428"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. The Icelandic atrial fibrillation sample is a deCODE genetics case set, described under that name in deCODE&apos;s papers (PMID:30271950) and listed under deCODE in PMID:30061737: it is part of the deCODE genetics Icelandic cohort. The Catalog&apos;s name describes only that disease subset and is not carried over. Replaced by COHO:0000428 (deCODE genetics Icelandic cohort), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Icelandic Atrial Fibrillation Sample</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001887 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001887">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16732"/>
        <rdf:type rdf:nodeID="genid16734"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
