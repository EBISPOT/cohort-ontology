    <!-- http://www.ebi.ac.uk/coho/COHO_0001696 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001696">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15196"/>
        <rdf:type rdf:nodeID="genid15198"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:20431428</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control sample of Ashkenazi Jewish people with schizophrenia, including schizoaffective disorder, and screened Ashkenazi Jewish controls, all reporting four grandparents of Ashkenazi Jewish descent, recruited in the United States by the Epidemiology-Genetics Program in Psychiatry of Johns Hopkins University: the cases through advertisements, talks and letters to the Jewish community and a study website, interviewed in person and diagnosed by consensus, and the controls at Jewish community meetings, community centres and synagogues.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">721</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">720</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>Epi_Gen_AJ_SZ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Epidemiology genetic program AJ schizophrenia case-control samples</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Johns Hopkins Epidemiology-Genetics Program Ashkenazi Jewish schizophrenia case-control sample</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15196">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005090"/>
