        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002052"/>
        <obo:IAO_0000112>GCST90054779</obo:IAO_0000112>
        <obo:IAO_0000115>A family study of Hispanic (Mexican American) families recruited at clinical centres in San Antonio, Texas and the San Luis Valley, Colorado and African American families recruited in Los Angeles, California, selected on family size rather than health status and examined with CT scans of visceral fat and frequently sampled glucose tolerance tests, to identify the genetic and environmental determinants of insulin resistance and visceral adiposity.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym IRAS also denotes Insulin Resistance Atherosclerosis Study (COHO:0000872); this term is Insulin Resistance Atherosclerosis Family Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>IRAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IRAS FS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IRAS Family Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IRAS-FS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IRASFS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Insulin Resistance Atherosclerosis Study Family Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Insulin Resistance Atherosclerosis Family Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000504"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8640864/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Specific to this study, Mexican American families were recruited from two clinical centers including San Antonio, TX, and San Luis Valley, CO, and African Americans were recruited from one clinical center in Los Angeles, CA.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000504"/>
