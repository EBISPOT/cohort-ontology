    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15916">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001780"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15916"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2655323/</oboInOwl:hasDbXref>
        <rdfs:comment>The GenePD study is an ongoing study of familial PD which recruits families with at least two cases of PD meeting diagnostic criteria.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001780"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2655323/</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were enrolled through thirty academic centers or clinics (19 in the United States, three in Canada, two in Australia, two in Germany, two in Italy, one in the United Kingdom, and one in Denmark).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001780"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:18986508</owl:annotatedTarget>
        <dcterms:title>The Gly2019Ser mutation in LRRK2 is not fully penetrant in familial Parkinson&apos;s disease: the GenePD study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:18986508</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2596771/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Study participants were recruited by the GenePD study, an international multi-site study of the genetics of PD, using three ascertainment strategies: 1) PD-affected probands with a PD-affected sibling; 2) PD-affected probands with a PD-affected parent or offspring; and 3) PD-affected probands with another PD-affected relative such as a cousin, aunt or uncle.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001780"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international multicentre study of the genetics of familial Parkinson&apos;s disease, designed for genetic linkage analysis of affected relative pairs, that recruits families with at least two members with Parkinson&apos;s disease meeting diagnostic criteria, ascertained through a proband with an affected sibling, parent, offspring or more distant relative, at academic centres and clinics in the United States, Canada, Australia, Germany, Italy, the United Kingdom and Denmark.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17408493</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18649400</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18986508</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
