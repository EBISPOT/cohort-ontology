        <obo:IAO_0000112>GCST90454540</obo:IAO_0000112>
        <obo:IAO_0000115>A province-wide biobank and prospective cohort in Québec, Canada, launched in March 2020 by the Fonds de recherche du Québec–Santé and Génome Québec, which recruits through a network of Québec hospitals adults and children with PCR-confirmed SARS-CoV-2 infection, both hospitalised and non-hospitalised, and PCR-negative controls, with longitudinal biosamples and clinical data, to study the clinical and biological determinants of COVID-19 clinical trajectories.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2300</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BCQ19</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BQC-19</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BQC19</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Banque Québécoise de la COVID-19</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Banque québécoise de la COVID-19</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Biobanque Quebec COVID19</oboInOwl:hasRelatedSynonym>
