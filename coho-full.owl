    <!-- http://www.ebi.ac.uk/coho/COHO_0002121 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002121">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:22479380</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, unselected, population-based birth cohort in West Cumbria, England, set up by the University of Newcastle and the Westlakes Research Institute, which from January 1996 to 2003 collected umbilical cord blood and tissue, with maternal consent and a short maternal lifestyle questionnaire, from babies born at the West Cumberland Hospital maternity unit in Whitehaven, storing DNA, plasma and viable cells as a resource for genetic and epidemiological studies of gene–environment interaction and health, with some children followed up in childhood.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NCCGP</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">North Cumbria Community Genetics Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002121"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3316565/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Samples and data from this prospective, unselected, population-based cohort were collected between 1996 and 2003 at a single maternity unit in West Cumbria, UK.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002121"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22479380</owl:annotatedTarget>
        <dcterms:title>Genetic and non-genetic influences during pregnancy on infant global and site specific DNA methylation: role for folate gene variants and vitamin B12.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22479380</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3316565/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A nested cohort study was undertaken within the North Cumbria Community Genetics Project [44] and included 430 cord blood DNA samples (mean (± SD) gestation = 39.5 (1.4) weeks) for methylation and genotype analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002121"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, unselected, population-based birth cohort in West Cumbria, England, set up by the University of Newcastle and the Westlakes Research Institute, which from January 1996 to 2003 collected umbilical cord blood and tissue, with maternal consent and a short maternal lifestyle questionnaire, from babies born at the West Cumberland Hospital maternity unit in Whitehaven, storing DNA, plasma and viable cells as a resource for genetic and epidemiological studies of gene–environment interaction and health, with some children followed up in childhood.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19681860</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22479380</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24098518</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9610806</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002121"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7000</owl:annotatedTarget>
        <obo:IAO_0000116>offspring born 1996-2003 with DNA and tissue samples (approximate; approximately 3000 mothers also gave samples)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3516066/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The NCCGP is a community-based DNA-banking project, consisting of DNA and tissue samples from approximately 3000 mothers and approximately 7000 offspring born between 1996 and 2003 (46).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
