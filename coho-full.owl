        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004750"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0100545"/>
        <obo:IAO_0000115>A language disorder characterized by difficulty in language acquisition despite otherwise normal development and in the absence of any obvious explanatory factors.</obo:IAO_0000115>
        <rdfs:label>specific language impairment</rdfs:label>
    </owl:Class>
    


