        <obo:IAO_0000112>PMID:25273948</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective study begun in 1999 in Salzburg, Austria, to investigate genetic and environmental factors contributing to atherosclerotic vascular diseases, whose participants, healthy unrelated adults aged 39–67 years, were recruited through health screening programmes in large companies in and around the city of Salzburg and examined with carotid ultrasonography and laboratory measurements.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1770</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SAPHIR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SAPHIR cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SAPHIR study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Salzburg Atherosclerosis Prevention Program in Subjects at High Individual Risk</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Salzburg Atherosclerosis Prevention Program in subjects at High Individual Risk</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19948">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_1060134"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002341"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19948"/>
        <obo:IAO_0000116>atherosclerotic vascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4411770/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Salzburg Atherosclerosis Prevention Program in subjects at High Individual Risk (the SAPHIR study) has been initiated in 1999 as a prospective study that investigates genetic and environmental factors contributing to atherosclerotic vascular diseases [20].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002341"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Austria"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4411770/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Study participants were recruited by health screening programs in large companies in and around the city of Salzburg, Austria.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002341"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25273948</owl:annotatedTarget>
        <dcterms:title>Genetic polymorphisms at SIRT1 and FOXO1 are associated with carotid atherosclerosis in the SAPHIR cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25273948</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4411770/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Eleven SNPs at SIRT1 and FOXO1 gene loci were genotyped in the SAPHIR cohort (n = 1742).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002341"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective study begun in 1999 in Salzburg, Austria, to investigate genetic and environmental factors contributing to atherosclerotic vascular diseases, whose participants, healthy unrelated adults aged 39–67 years, were recruited through health screening programmes in large companies in and around the city of Salzburg and examined with carotid ultrasonography and laboratory measurements.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15715680</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25273948</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002341"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1770</owl:annotatedTarget>
