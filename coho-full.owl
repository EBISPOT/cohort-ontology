        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3373/MediaObjects/41588_2015_BFng3373_MOESM50_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Essen-Heidelberg 1,212 1,219 1.053 6,356,866 Unpublished</rdfs:comment>
