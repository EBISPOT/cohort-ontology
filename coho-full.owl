        <oboInOwl:hasRelatedSynonym>NCI Lung Cancer and Smoking Phenotypes in African-American Cases and Controls</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCI Lung Cancer in African Americans GWAS Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCI study of African Americans</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCI-AA</oboInOwl:hasRelatedSynonym>
