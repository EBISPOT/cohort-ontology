    <!-- http://www.ebi.ac.uk/coho/COHO_0001223 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001223">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11117"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90281037</obo:IAO_0000112>
        <obo:IAO_0000115>A randomized, double-blind, placebo-controlled trial run by the Parkinson Study Group, which enrolled people with early Parkinson&apos;s disease not yet requiring dopaminergic therapy at 65 sites in the United States and Canada between April 2002 and April 2004 to test whether the mixed lineage kinase inhibitor CEP-1347 could slow disease progression; the trial was stopped early for futility in 2005, and its participants were then followed in the observational PostCEPT study.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">806</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PRECEPT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Parkinson Research Examination of CEP-1347 Trial/A Longitudinal Follow-up of the PRECEPT Study Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PreCEPT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PreCEPT/PostCEPT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Parkinson Research Examination of CEP-1347 Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11117">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001223"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11117"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17881719+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Consenting PD patients not yet requiring dopaminergic therapy (n = 806) were randomized equally to CEP-1347 in dosages of 10 mg BID, 25 mg BID, or 50 mg BID, or matching placebo, and were evaluated blindly and prospectively.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001223"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2574855/</oboInOwl:hasDbXref>
        <rdfs:comment>The participants (n=806) were enrolled between April 2002 and April 2004 at 65 sites across the United States and Canada.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001223"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90281037</owl:annotatedTarget>
        <dcterms:title>Dopamine Pathway and Parkinson&apos;s Risk Variants Are Associated with Levodopa-Induced Dyskinesia.</dcterms:title>
