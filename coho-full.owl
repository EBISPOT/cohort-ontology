        <obo:IAO_0000112>PGS000344</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:32737321</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre hospital-based case-control study of breast cancer in Nagano, Japan, enrolling a consecutive series of women aged 20-74 with newly diagnosed, histologically confirmed invasive breast cancer at four hospitals and cancer-free controls from medical check-up examinees matched by age and residential area, designed to study lifestyle and genetic risk factors and, with a parallel study in São Paulo, Brazil, to compare Japanese, Japanese Brazilian and non-Japanese Brazilian women.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">405</coho:numberOfCases>
        <oboInOwl:hasRelatedSynonym>NGOBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NagBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Nagano Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18338">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid18340">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000015"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002107"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18338"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://doi.org/10.1007/s10549-008-0168-1</oboInOwl:hasDbXref>
        <rdfs:comment>Eligible cases were a consecutive series of female patients aged 20–74 years with newly diagnosed and histologically confirmed invasive breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002107"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18340"/>
        <obo:IAO_0000116>lifestyle factors</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://doi.org/10.1007/s10549-008-0168-1</oboInOwl:hasDbXref>
        <rdfs:comment>These multicenter, hospital-based case–control studies of breast cancer were designed to determine lifestyle factors and genetic susceptibility to the risk of breast cancer and to compare potential risk factors among Japanese living in Nagano, Japan, and Japanese Brazilians and non-Japanese Brazilians living in São Paulo, Brazil.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002107"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3050759/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We have conducted a cross-sectional study using a control group of case-control studies in Nagano, Japan, and São Paulo, Brazil.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002107"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000344</owl:annotatedTarget>
        <dcterms:title>European polygenic risk score for prediction of breast cancer shows similar performance in Asian women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32737321</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002107"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32737321</owl:annotatedTarget>
        <dcterms:title>European polygenic risk score for prediction of breast cancer shows similar performance in Asian women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32737321</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-020-17680-w/MediaObjects/41467_2020_17680_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>NGOBCS Nagano Breast CancerStudy11 Hospital-basedcase-control study Japan</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002107"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre hospital-based case-control study of breast cancer in Nagano, Japan, enrolling a consecutive series of women aged 20-74 with newly diagnosed, histologically confirmed invasive breast cancer at four hospitals and cancer-free controls from medical check-up examinees matched by age and residential area, designed to study lifestyle and genetic risk factors and, with a parallel study in São Paulo, Brazil, to compare Japanese, Japanese Brazilian and non-Japanese Brazilian women.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3050759/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002107"/>
