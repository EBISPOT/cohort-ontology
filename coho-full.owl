        <owl:annotatedTarget>DPS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001076 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001076">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid9853"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90559231</obo:IAO_0000112>
        <obo:IAO_0000115>A single-centre, prospective, longitudinal observational natural-history study at the Duke Eye Center in Durham, North Carolina, United States, which from 2013 enrolled people aged 50 or over with early or intermediate (dry) age-related macular degeneration from the centre&apos;s patients, together with controls from Duke optometry and comprehensive eye clinics or the patients&apos; family and friends, and assessed them with retinal imaging and with visual function tests repeated about every six months over 24 months, to find functional end points for clinical trials.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">101</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>DUKE FEATURE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Duke FEATURE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Duke_FEATURE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Duke study of Functional Endpoints for Age-related Macular Degeneration</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9853">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005150"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001076"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9853"/>
        <obo:IAO_0000116>age-related macular degeneration</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36245764+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 101 subjects (33 with eAMD, 47 with iAMD, and 21 normal controls) were recruited.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001076"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9559970/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were enrolled at the Duke Eye Center.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001076"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90559231</owl:annotatedTarget>
        <dcterms:title>HTRA1/lncRNA HTRA1-AS1 dominates in age-related macular degeneration reticular pseudodrusen genetic risk with no complement involvement.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41361163</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12685958/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The DUKE FEATURE study was supported by the National Eye Institute, National Institutes of Health, Bethesda, Maryland (grant no.: K23EY026988, EML) and F. Hoffmann La Roche Ltd., Basel, Switzerland (EML through Duke University).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001076"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A single-centre, prospective, longitudinal observational natural-history study at the Duke Eye Center in Durham, North Carolina, United States, which from 2013 enrolled people aged 50 or over with early or intermediate (dry) age-related macular degeneration from the centre&apos;s patients, together with controls from Duke optometry and comprehensive eye clinics or the patients&apos; family and friends, and assessed them with retinal imaging and with visual function tests repeated about every six months over 24 months, to find functional end points for clinical trials.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36245764</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42560005</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT01822873</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001076"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">101</owl:annotatedTarget>
        <obo:IAO_0000116>subjects enrolled (33 early AMD, 47 intermediate AMD, 21 controls)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:36245764</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 101 subjects (33 with eAMD, 47 with iAMD, and 21 normal controls) were recruited.</rdfs:comment>
    </owl:Axiom>
