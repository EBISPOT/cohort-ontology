        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000646"/>
        <obo:IAO_0000112>PGS000026</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:19734902</obo:IAO_0000112>
        <obo:IAO_0000115>A naturalistic, prospective cohort of people with Alzheimer&apos;s disease and their carers in London and the South East Region of the UK, run from University College London, recruited in 2002-2003 through community mental health teams, memory clinics, care homes, day hospitals and the voluntary sector to be representative of people with Alzheimer&apos;s disease in the community by sex, living setting and severity, and followed for up to 54 months to study the progression, characteristics and costs of the disease and the problems of carers.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">224</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>LASER</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LASER-AD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LASER-AD study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>London and South-East Region Alzheimer&apos;s Disease Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>London and the South East Region AD project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>London and the South East Region Alzheimer&apos;s disease project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UCL-LASER</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">London and the South East Region Alzheimer&apos;s Disease Study</rdfs:label>
    </owl:NamedIndividual>
