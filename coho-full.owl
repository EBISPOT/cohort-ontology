    <!-- http://www.ebi.ac.uk/coho/COHO_0002412 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002412">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20461"/>
        <rdf:type rdf:nodeID="genid20463"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South-Eastern_Asia"/>
        <obo:IAO_0000112>PMID:34103471</obo:IAO_0000112>
        <obo:IAO_0000115>A five-year national flagship research programme on psychosis in Singapore, based at the Institute of Mental Health, made up of three linked studies: a genome-wide association and copy-number study of schizophrenia and its cognitive phenotypes, a prospective study of people at ultra-high risk of psychosis, and a randomized controlled trial to improve neurocognition in schizophrenia. Its schizophrenia study recruited outpatients and inpatients of Chinese ethnicity aged 21 to 55 with DSM-IV schizophrenia at the Institute of Mental Health from 2008 to 2011.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">975</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>STCRP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Translational &amp; Clinical Research in Psychosis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Translational and Clinical Research Psychosis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Singapore Translational and Clinical Research in Psychosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Singapore Translational and Clinical Research in Psychosis</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20461">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005090"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid20463">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005485"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002412"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20461"/>
        <obo:IAO_0000116>schizophrenia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22032547+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The second is a prospective study of a large group of individuals who are assessed to be at ultra-high risk of psychosis, and the third is a randomized controlled trial to improve neurocognition in patients with schizophrenia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002412"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20463"/>
        <obo:IAO_0000116>psychosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22032547+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The second is a prospective study of a large group of individuals who are assessed to be at ultra-high risk of psychosis, and the third is a randomized controlled trial to improve neurocognition in patients with schizophrenia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002412"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9954179/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants consisted of both outpatients and inpatients recruited as part of the Singapore Translational and Clinical Research Psychosis (STCRP) program at the Institute of Mental Health, Singapore.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002412"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34103471</owl:annotatedTarget>
        <dcterms:title>Genome wide study of tardive dyskinesia in schizophrenia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34103471</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8187404/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Linear mixed models conducted via the GEMMA29 package revealed significant genome-wide association of TD at the level of the CATIE cohorts, but not the STCRP cohort (Supplementary Fig. 6).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002412"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A five-year national flagship research programme on psychosis in Singapore, based at the Institute of Mental Health, made up of three linked studies: a genome-wide association and copy-number study of schizophrenia and its cognitive phenotypes, a prospective study of people at ultra-high risk of psychosis, and a randomized controlled trial to improve neurocognition in schizophrenia. Its schizophrenia study recruited outpatients and inpatients of Chinese ethnicity aged 21 to 55 with DSM-IV schizophrenia at the Institute of Mental Health from 2008 to 2011.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22032547</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36831758</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002412"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">975</owl:annotatedTarget>
        <obo:IAO_0000116>people with schizophrenia recruited to the programme&apos;s schizophrenia study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9954179/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 975 individuals diagnosed with schizophrenia were recruited.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002412"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>STCRP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


