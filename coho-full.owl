        <rdfs:comment>In summary, participants were randomly selected from the Swedish national population register and invited by mail.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000835"/>
