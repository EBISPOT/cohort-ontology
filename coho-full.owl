        <obo:IAO_0000112>GCST90274758</obo:IAO_0000112>
        <obo:IAO_0000115>An international randomized, placebo-controlled trial of darapladib, a lipoprotein-associated phospholipase A2 inhibitor, in 15,828 patients with chronic coronary heart disease recruited at 663 centers in 39 countries from December 2008 to April 2010 and sponsored by GlaxoSmithKline, whose baseline plasma biobank has been used for biomarker, proteomic and genetic studies of cardiovascular outcomes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15828</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>STABILITY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STABILITY trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STabilization of Atherosclerotic plaque By Initiation of darapLadIb TherapY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Stabilization of Atherosclerotic Plaque by Initiation of Darapladib Therapy Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid4188">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005010"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000477"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4188"/>
        <obo:IAO_0000116>coronary heart disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24678955+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In a double-blind trial, we randomly assigned 15,828 patients with stable coronary heart disease to receive either once-daily darapladib (at a dose of 160 mg) or placebo.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000477"/>
