    <!-- http://www.ebi.ac.uk/coho/COHO_0001396 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001396">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid12674"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>GCST90310293</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of calcific aortic valve stenosis at the Institut universitaire de cardiologie et de pneumologie de Québec – Université Laval, Canada, in which blood and aortic valve tissue are collected from patients undergoing aortic valve replacement for the disease and compared with controls (in its first phase, patients without valve disease undergoing cardiac surgery, mostly coronary artery bypass, at the same institute; in its second, CARTaGENE participants without valvular heart disease), to identify genetic susceptibility to the disease; its valve tissues, collected in 1998–2019, are also used for gene expression studies.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1009</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1017</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>Calcific Aortic Valve Stenosis in Quebec</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>QUEBEC-CAVS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genome-Wide Association Study on Calcific Aortic Valve Stenosis in Quebec</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12674">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0042981"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001396"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12674"/>
        <obo:IAO_0000116>calcific aortic valve stenosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5840407/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GWAS includes 1009 severe cases of tricuspid CAVS confirmed at surgery and 1017 ethnically matched controls with normal aortic valve that underwent cardiac surgery (QUEBEC-CAVS cohort).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001396"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10944835/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Aortic valve tissues were collected from patients undergoing cardiac surgery at the Institut universitaire de cardiologie et de pneumologie de Québec – Université Laval between 1998 and 2019 (QUEBEC-CAVS-RNA).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001396"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90310293</owl:annotatedTarget>
        <dcterms:title>Integrative genomic analyses identify candidate causal genes for calcific aortic valve stenosis involving tissue-specific regulation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38494474</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10944835/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The QUEBEC-CAVS study was approved by the ethics committee of the Institut universitaire de cardiologie et de pneumologie de Québec-Université Laval.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001396"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of calcific aortic valve stenosis at the Institut universitaire de cardiologie et de pneumologie de Québec – Université Laval, Canada, in which blood and aortic valve tissue are collected from patients undergoing aortic valve replacement for the disease and compared with controls (in its first phase, patients without valve disease undergoing cardiac surgery, mostly coronary artery bypass, at the same institute; in its second, CARTaGENE participants without valvular heart disease), to identify genetic susceptibility to the disease; its valve tissues, collected in 1998–2019, are also used for gene expression studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29511167</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31141105</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38494474</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001396"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1009</owl:annotatedTarget>
        <obo:IAO_0000116>first-phase (QUEBEC-CAVS-1) cases and controls passing QC; no stated total (2018)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:29511167</oboInOwl:hasDbXref>
        <rdfs:comment>A GWAS on 1009 cases and 1017 ethnically matched controls was combined with a large-scale eQTL mapping study of human aortic valve tissues (n = 233) to identify susceptibility genes for CAVS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001396"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1017</owl:annotatedTarget>
        <obo:IAO_0000116>first-phase (QUEBEC-CAVS-1) cases and controls passing QC; no stated total (2018)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:29511167</oboInOwl:hasDbXref>
        <rdfs:comment>A GWAS on 1009 cases and 1017 ethnically matched controls was combined with a large-scale eQTL mapping study of human aortic valve tissues (n = 233) to identify susceptibility genes for CAVS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001396"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>QUEBEC-CAVS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001397 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001397">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid12682"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000472"/>
        <obo:IAO_0000112>GCST90270269</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of children and adults with sickle cell disease, randomly sampled from the active patients of six care sites in the Brazilian states of Minas Gerais (Belo Horizonte, Juiz de Fora and Montes Claros), Rio de Janeiro, Pernambuco (Recife) and São Paulo and enrolled in 2013–2015 as the Brazilian component of the NHLBI REDS-III programme, with clinical data, a blood biorepository and genome-wide genotyping, to characterise the clinical and transfusion outcomes of sickle cell disease in Brazil and support genotype–phenotype studies.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym REDS-III also denotes Recipient Epidemiology and Donor Evaluation Study-III (COHO:0000472); this term is REDS-III Brazil Sickle Cell Disease Cohort.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2795</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Brazil SCD Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Brazil Sickle Cell Disease Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REDS-III</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REDS-III Brazil SCD Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REDS-III Brazil SCD cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Recipient Epidemiology and Donor Evaluation Study III Brazil Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">REDS-III Brazil Sickle Cell Disease Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12682">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011382"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001397"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12682"/>
        <obo:IAO_0000116>sickle cell disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8019534/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Brazil programme is the only programme within REDS-III to establish a SCD cohort in order to characterize health outcomes (including transfusion outcomes) in patients with SCD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001397"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30027669+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 2795 participants at six Brazilian sites were enrolled between 2013 and 2015.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001397"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90270269</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of early ischaemic stroke risk in Brazilian individuals with sickle cell disease implicates ADAMTS2 and CDK18 and uncovers novel loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36602125</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10155195/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>This was conducted within the Brazil Sickle Cell Disease Cohort Study as part of the Recipient Epidemiology Donor Evaluation Study III (REDS-III).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001397"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of children and adults with sickle cell disease, randomly sampled from the active patients of six care sites in the Brazilian states of Minas Gerais (Belo Horizonte, Juiz de Fora and Montes Claros), Rio de Janeiro, Pernambuco (Recife) and São Paulo and enrolled in 2013–2015 as the Brazilian component of the NHLBI REDS-III programme, with clinical data, a blood biorepository and genome-wide genotyping, to characterise the clinical and transfusion outcomes of sickle cell disease in Brazil and support genotype–phenotype studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30027669</obo:IAO_0000119>
