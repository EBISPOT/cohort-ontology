    <!-- http://www.ebi.ac.uk/coho/COHO_0002251 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002251">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19292"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:35356681</obo:IAO_0000112>
        <obo:IAO_0000115>A UK multicentre prospective observational cohort of patients hospitalised with a non-ST elevation acute coronary syndrome (non-ST elevation myocardial infarction or unstable angina), run at 16 hospital sites between 2008 and 2013, whose participants were followed up at one and 12 months, and annually thereafter while the study ran, for further cardiovascular events; its medication, adherence, plasma drug-level and genome-wide genotype data are used in pharmacogenetic studies of secondary-prevention cardiovascular drugs.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1470</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PhACS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pharmacogenetics of Acute Coronary Syndrome study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Pharmacogenetics of Acute Coronary Syndrome</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19292">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005542"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002251"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19292"/>
        <obo:IAO_0000116>non-ST elevation acute coronary syndrome</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7687685/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, PhACS was a UK 16-site prospective observational study between 2008 and 2013 that recruited 1470 patients hospitalised with an NSTE-ACS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002251"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5399750/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This investigation utilizes a prospective CVD observational study that was conducted at 16 different UK hospital sites between 2008 and 2013, entitled the Pharmacogenetics of Acute Coronary Syndrome (PhACS) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:35356681</owl:annotatedTarget>
        <dcterms:title>Chromosomal Region 11p14.1 is Associated with Pharmacokinetics and Pharmacodynamics of Bisoprolol.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35356681</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8958266/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Two separate cohorts of patients were used to achieve these aims: PK were determined in a cohort of patients with NSTE-ACS in the Pharmacogenetics of Acute Coronary Syndrome (PhACS) study,6,7 while the PD parameter was determined in an independent cohort from the Genetics of Drug Responsiveness in Essential Hypertension (GENRES) study.8</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A UK multicentre prospective observational cohort of patients hospitalised with a non-ST elevation acute coronary syndrome (non-ST elevation myocardial infarction or unstable angina), run at 16 hospital sites between 2008 and 2013, whose participants were followed up at one and 12 months, and annually thereafter while the study ran, for further cardiovascular events; its medication, adherence, plasma drug-level and genome-wide genotype data are used in pharmacogenetic studies of secondary-prevention cardiovascular drugs.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28391887</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30005242</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31656041</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33234119</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002251"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1470</owl:annotatedTarget>
        <obo:IAO_0000116>PhACS patients recruited at 16 UK sites, 2008-2013</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7687685/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, PhACS was a UK 16-site prospective observational study between 2008 and 2013 that recruited 1470 patients hospitalised with an NSTE-ACS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002251"/>
