        <rdfs:comment>STUDY Cases Controls Total Platform African American GWAS 1,894 4,703 6,597 Illumina 1M/2.5M Japanese GWAS 2,627 3,797 6,424 Illumina 1M/660k</rdfs:comment>
    </owl:Axiom>
