    <!-- http://www.ebi.ac.uk/coho/COHO_0001138 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001138">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>GCST90841194</obo:IAO_0000112>
        <obo:IAO_0000115>A research cohort of customers of 23Mofang (Chengdu 23Mofang Biotechnology Co., Ltd.), a Chinese direct-to-consumer genetic testing company, who were genotyped through its personal genome service and consented to the research use of their genotypes and of traits they self-reported in the company&apos;s web-based surveys.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>23Mofang Inc. cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>23mofang</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>23mofang Personal Genome Services</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">23Mofang cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001138"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6428856/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The aiming population was exclusively defined so all individuals recruited were Chinese citizens.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001138"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90841194</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genome-wide association analyses of refractive error augment genetic discovery and polygenic prediction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42009823</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13175889/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The cohort comprised 47,305 self-reported myopic people and 8,209 nonmyopic people, all of whom provided informed consent and underwent genotyping as part of the 23Mofang Personal Genome Services.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001138"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A research cohort of customers of 23Mofang (Chengdu 23Mofang Biotechnology Co., Ltd.), a Chinese direct-to-consumer genetic testing company, who were genotyped through its personal genome service and consented to the research use of their genotypes and of traits they self-reported in the company&apos;s web-based surveys.</owl:annotatedTarget>
