    <!-- http://www.ebi.ac.uk/coho/COHO_0002704 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002704">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22876"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001800"/>
        <obo:IAO_0000112>PMID:29892015</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, observational hospital-based cohort of adults with recent-onset paroxysmal or persistent atrial fibrillation for whom a rhythm-control strategy was preferred, conducted at the University Medical Center Groningen and Maastricht University Medical Center in the Netherlands between 2011 and 2016, with detailed cardiovascular phenotyping and serial rhythm monitoring to identify markers of atrial remodelling and atrial fibrillation progression and guide therapy.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">499</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AF RISK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AF Risk</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AF Risk study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AF risk profile study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AF-RISK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AF-RISK study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AF-Risk</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AF-Risk study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>identification of a risk profile to guide atrial fibrillation therapy</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Identification of a risk profile to guide atrial fibrillation therapy</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22876">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004981"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002704"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22876"/>
        <obo:IAO_0000116>atrial fibrillation</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8914333/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In short, AF RISK was a multicenter, prospective, observational study, including patients aged ≥ 18 years, with pAF (total AF history &lt; 2 years, or total AF history &lt; 3 years in case of ≤ 2 AF episodes of ≤ 48 h per month terminating spontaneously) or persistent AF (total AF history &lt; 2 years, and total persistent AF duration &gt; 7 days and &lt; 1 year) in whom a rhythm control strategy was preferred.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002704"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12933449/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The identification of a risk profile to guide atrial fibrillation therapy (AF-RISK) study was a Dutch prospective, observational multicenter cohort study conducted at the University Medical Centre Groningen and the Maastricht University Medical Centre + between May 2011 and March 2016.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002704"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29892015</owl:annotatedTarget>
        <dcterms:title>Polygenic prediction of body mass index and obesity through the life course and across ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29892015</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The AF-Risk study (ClinicalTrials.gov Identifier: NCT01510210) is an observational hospital-based cohort (n=500; in GGAF 339) to seek for markers of severity of atrial remodeling and predict outcome of a rhythm control treatment strategy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002704"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, observational hospital-based cohort of adults with recent-onset paroxysmal or persistent atrial fibrillation for whom a rhythm-control strategy was preferred, conducted at the University Medical Center Groningen and Maastricht University Medical Center in the Netherlands between 2011 and 2016, with detailed cardiovascular phenotyping and serial rhythm monitoring to identify markers of atrial remodelling and atrial fibrillation progression and guide therapy.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35281756</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41756112</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>GPT-6 (OpenAI), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002704"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">499</owl:annotatedTarget>
        <obo:IAO_0000116>AF-RISK included patients who underwent baseline assessment and blood sampling</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8167185/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>After inclusion, all patients underwent baseline assessment including peripheral venous blood sampling for biomarker analyses (n = 499).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002704"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AF RISK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002704"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AF Risk</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002704"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AF-RISK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
