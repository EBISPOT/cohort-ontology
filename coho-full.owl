        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3108163/</oboInOwl:hasDbXref>
        <rdfs:comment>New Jersey Ovarian Cancer Study NJOCS NJO USA</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002160"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000082</owl:annotatedTarget>
        <dcterms:title>Cross-cancer evaluation of polygenic risk scores for 16 cancer types in two large cohorts.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33579919</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002160"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21943063</owl:annotatedTarget>
        <dcterms:title>Phytoestrogen consumption from foods and supplements and epithelial ovarian cancer risk: a population-based case control study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21943063</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3196697/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a population-based case-control study, the NJ Ovarian Cancer Study, specifically designed to evaluate phytoestrogens and ovarian cancer risk in New Jersey, a population characterized by large ethnic diversity.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002160"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of epithelial ovarian cancer in New Jersey, United States, run by the Cancer Institute of New Jersey, whose cases were women with newly diagnosed invasive epithelial ovarian cancer living in six New Jersey counties, identified from January 2004 to May 2008 through the New Jersey State Cancer Registry, and whose controls were those of the EDGE (Estrogen, Diet, Genetics, and Endometrial Cancer) Study. It was designed to study phytoestrogens and ovarian cancer risk and is one of the studies of the Ovarian Cancer Association Consortium (study code NJO).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21943063</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36688720</obo:IAO_0000119>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC3108163/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002160"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">233</owl:annotatedTarget>
        <obo:IAO_0000116>NJO cases completing interviews and controls completing the study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3196697/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 493 remaining cases, 252 consented to participate (51%) and 233 completed the interview (47%).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002160"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">467</owl:annotatedTarget>
        <obo:IAO_0000116>NJO cases completing interviews and controls completing the study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3196697/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Overall, a total of 467 (approximately 40%) controls from the three sources completed the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002160"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NJO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
