        <obo:IAO_0000112>PMID:17925548</obo:IAO_0000112>
        <obo:IAO_0000115>An international multicentre phase III randomised trial (SCOTROC1) of first-line docetaxel-carboplatin versus paclitaxel-carboplatin chemotherapy for stage Ic–IV epithelial ovarian or primary peritoneal cancer, coordinated through a clinical trials unit in Glasgow and recruiting patients in the United Kingdom, elsewhere in Europe, the United States and Australasia, whose patients were followed for progression-free and overall survival and whose DNA has been used in pharmacogenetic studies and in the Ovarian Cancer Association Consortium&apos;s studies of ovarian cancer outcome.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1077</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SCOTROC I</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SCOTROC-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SCOTROC1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SRO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SRTOC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Scottish Randomised Trial in Ovarian Cancer I</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Scottish Randomised Trial in Ovarian Cancer study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Scottish Randomised Trial in Ovarian Cancer</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20421">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005140"/>
    </owl:Restriction>
