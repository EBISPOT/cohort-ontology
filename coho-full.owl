    <!-- http://www.ebi.ac.uk/coho/COHO_0002388 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002388">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20267"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000954"/>
        <obo:IAO_0000112>PMID:28947836</obo:IAO_0000112>
        <obo:IAO_0000115>An observational cohort of healthy, singleton, term-born young children from the greater Copenhagen area, Denmark, run by the Department of Nutrition, Exercise and Sports at the University of Copenhagen, which followed them from 9 to 36 months of age: SKOT I enrolled infants selected at random from the Danish Civil Registry in 2007–2008 and examined them at 9, 18 and 36 months, and SKOT II enrolled, under the same protocol, infants of obese mothers from a trial of obese pregnant women at Hvidovre Hospital, to study diet, growth, body composition, development and early determinants of overweight.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">330</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Diet and Thriving in Young Children</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SKOT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SKOT cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Småbørns Kost Og Trivsel study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Småbørns Kost og Trivsel</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Småbørns Kost Og Trivsel</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20267">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000021"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002388"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20267"/>
        <obo:IAO_0000116>complementary and young child feeding</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5493126/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SKOT study was funded by the Danish Directorate for Food, Fisheries and Agri Business (grant no. 3304-FSE-06-0503-1) as part of the project “Complementary and young child feeding (CYCF) – impact on short and long term development of health”.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002388"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5493126/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>based on random selection from the National Danish Civil Registry of infants born in the greater Copenhagen area, 330 children were enrolled in the study between April 2007 and May 2008</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002388"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28947836</owl:annotatedTarget>
        <dcterms:title>Genetic predisposition to adiposity is associated with increased objectively assessed sedentary time in young children.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28947836</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5765967/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The participants of the study include 287 Danish children 3 years of age from the Småbørns Kost Og Trivsel I and II (SKOT I and II) studies</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002388"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An observational cohort of healthy, singleton, term-born young children from the greater Copenhagen area, Denmark, run by the Department of Nutrition, Exercise and Sports at the University of Copenhagen, which followed them from 9 to 36 months of age: SKOT I enrolled infants selected at random from the Danish Civil Registry in 2007–2008 and examined them at 9, 18 and 36 months, and SKOT II enrolled, under the same protocol, infants of obese mothers from a trial of obese pregnant women at Hvidovre Hospital, to study diet, growth, body composition, development and early determinants of overweight.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28666428</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29961064</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30887376</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002388"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">330</owl:annotatedTarget>
        <obo:IAO_0000116>children enrolled in SKOT I (April 2007 to May 2008), the first of SKOT&apos;s two recruitments; no number for SKOT I and II together is stated</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5493126/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In short, based on random selection from the National Danish Civil Registry of infants born in the greater Copenhagen area, 330 children were enrolled in the study between April 2007 and May 2008 at age 8.5 months and examined at 9, 18, and 36 months.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002388"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SKOT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002389 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002389">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20274"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000864"/>
        <obo:IAO_0000112>PMID:33385923</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of lung cancer in never-smoking ethnic Chinese women in Shenyang, Liaoning Province, northeast China, whose cases had histologically confirmed lung cancer and whose controls were non-smoking women with other lung diseases but free of cancer, frequency-matched to the cases on age; it is one of the studies pooled in the Female Lung Cancer Consortium in Asia.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">574</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1024</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>SLCS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Shenyang Lung Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20274">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002389"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20274"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Cases were never smoking females with histologically confirmed lung cancers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002389"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The SLCS was carried out in the Liaoning Province in Northeast China and has been previously described9 .</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002389"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33385923</owl:annotatedTarget>
        <dcterms:title>Sub-multiplicative interaction between polygenic risk score and household coal use in relation to lung adenocarcinoma among never-smoking women in Asia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33385923</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8378844/</oboInOwl:hasDbXref>
        <rdfs:comment>Our primary analysis included 1,472 lung adenocarcinoma cases and 1,497 controls from the Genetic Epidemiological Study of Lung Adenocarcinoma (GELAC) (Jou et al., 2009), the Shenyang Lung Cancer Study (SLCS) (Yin et al., 2009), and the Shanghai Women’s Health Study (SWHS) (Zhang et al., 2007; Zheng et al., 2005).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002389"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of lung cancer in never-smoking ethnic Chinese women in Shenyang, Liaoning Province, northeast China, whose cases had histologically confirmed lung cancer and whose controls were non-smoking women with other lung diseases but free of cancer, frequency-matched to the cases on age; it is one of the studies pooled in the Female Lung Cancer Consortium in Asia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20003391</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23143601</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002389"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">574</owl:annotatedTarget>
        <obo:IAO_0000116>never-smoking female cases and controls in the 2012 FLCCA GWAS subset</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>SLCS Mainland China 574 378 98 1024 56.7(11.7) 56.2(11.5) 58.4(11.1) 52.3(14.8) 487 226 60 37</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002389"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1024</owl:annotatedTarget>
        <obo:IAO_0000116>never-smoking female cases and controls in the 2012 FLCCA GWAS subset</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>SLCS Mainland China 574 378 98 1024 56.7(11.7) 56.2(11.5) 58.4(11.1) 52.3(14.8) 487 226 60 37</rdfs:comment>
    </owl:Axiom>
