        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002118"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22590574</owl:annotatedTarget>
        <dcterms:title>Late onset myasthenia gravis is associated with HLA DRB1*15:01 in the Norwegian population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22590574</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3348874/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The control samples (n = 651, female: male ratio 1.9) were randomly selected among healthy Norwegian bone marrow donors recruited through the Norwegian Bone Marrow Donor Registry (http:/www.nordonor.org/).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002118"/>
