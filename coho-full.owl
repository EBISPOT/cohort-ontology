        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Nijmegen Lung Cancer Study</rdfs:label>
    </owl:NamedIndividual>
