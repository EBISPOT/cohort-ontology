        <obo:IAO_0000112>PMID:23339562</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case–control study of epithelial ovarian cancer in metropolitan Toronto and nearby areas of southern Ontario, Canada, which from 1989 to 1992 interviewed women aged 35–79 with newly diagnosed, histologically confirmed malignant or borderline epithelial ovarian tumours, identified through the Ontario Cancer Registry, and randomly selected population controls frequency-matched to them on age, about their reproductive history and diet. It is one of the case–control studies of the Ovarian Cancer Association Consortium.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">450</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">564</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>SON</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Southern Ontario Study of Reproduction, Diet and Health</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Southern Ontario Ovarian Cancer Study</rdfs:label>
    </owl:NamedIndividual>
