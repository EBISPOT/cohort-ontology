        <obo:IAO_0000112>PGS004864</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:18440328</obo:IAO_0000112>
        <obo:IAO_0000115>A study of relatively healthy adults, aged 20 or over and from large families, of the Old Order Amish of Lancaster County, Pennsylvania, initiated in 2002 to measure cardiovascular responses to four short-term interventions (a cold pressor stress test, a high-salt diet, a high-fat challenge and aspirin therapy) and to identify the genetic and environmental determinants of these responses.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">868</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Amish HAPI Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Amish Heredity and Phenotype Intervention (HAPI) Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Amish Heredity and Phenotype Intervention Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HAPI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HAPI Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Heredity and Phenotype Intervention (HAPI) Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
