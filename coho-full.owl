        <rdfs:comment>Participants were selected from the ongoing German Metabolic Syndrome Berlin Potsdam (MeSyBePo) study that currently includes ∼2,500 individuals with different states of glucose tolerance.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002055"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17934"/>
        <obo:IAO_0000116>metabolic syndrome</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3816867/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were selected from the ongoing German Metabolic Syndrome Berlin Potsdam (MeSyBePo) study that currently includes ∼2,500 individuals with different states of glucose tolerance.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002055"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
