        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects structures of the skull.</obo:IAO_0000115>
        <rdfs:label>skull disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0024664 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0024664">
        <owl:equivalentClass>
            <owl:Class>
