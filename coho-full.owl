    <!-- http://www.ebi.ac.uk/coho/COHO_0001764 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001764">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15747"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000864"/>
        <obo:IAO_0000112>PMID:23143601</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of lung cancer in the Guangdong area of China, whose cases are ethnic Chinese in-patients with incident, histologically confirmed primary lung cancer of any histological type diagnosed at the Guangdong Lung Cancer Institute and Guangdong General Hospital, and whose controls are healthy, cancer-free patients from the health examination clinics of the same hospitals; one of the studies of the Female Lung Cancer Consortium in Asia genotyped for its genome-wide association study of lung cancer in never-smoking women.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">634</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">123</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>GDS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Guangdong Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15747">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001764"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15747"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>All of the cases were histologically confirmed primary lung cancer (all histological types).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001764"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The GDS enrolled cases and controls from the Guangdong area of China.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001764"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23143601</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analysis identifies new lung cancer susceptibility loci in never-smoking women in Asia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23143601</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4169232/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>External sets were genotyped as follows: a) samples from CAMSCH, FLCS, GDS, SLCS, TLCS, and WLCS were genotyped on contract at Gene-Square Biotech, Inc. in Beijing using the Illumina 660W SNP microarray; b) samples from GELAC were genotyped on contract at GeneTech Biotech Co., Taiwan on the Illumina 370k SNP microarray in a pilot project and remaining samples were genotyped on contract at deCODE Genetics, Iceland using the Illumina 610Q SNP microarray and initially reported elsewhere; c) a subset of samples from Japan were genotyped at Memorial Sloan-Kettering Cancer Center (MSKCC) using the Illumina 610Q SNP microarray; and d) samples from Singapore were genotyped at the Genome Institute of Singapore on the Illumina 660W SNP microarray.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001764"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of lung cancer in the Guangdong area of China, whose cases are ethnic Chinese in-patients with incident, histologically confirmed primary lung cancer of any histological type diagnosed at the Guangdong Lung Cancer Institute and Guangdong General Hospital, and whose controls are healthy, cancer-free patients from the health examination clinics of the same hospitals; one of the studies of the Female Lung Cancer Consortium in Asia genotyped for its genome-wide association study of lung cancer in never-smoking women.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23143601</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</obo:IAO_0000119>
