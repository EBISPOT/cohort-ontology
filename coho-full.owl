        <rdfs:comment>IATVB1 is a prospective, nationwide, case-control study involving 125 coronary care units in Italy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001888"/>
