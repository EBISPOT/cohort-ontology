        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005105"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10961"/>
        <obo:IAO_0000116>UV exposure</obo:IAO_0000116>
        <obo:IAO_0000116>sunbed use</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9128912/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A prospective, population-based study of 40,000 women regarding host factors, UV exposure and sunbed use in relation to risk and anatomic site of cutaneous melanoma.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10963"/>
        <obo:IAO_0000116>sun-exposure habits</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9128912/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A prospective, population-based study of 40,000 women regarding host factors, UV exposure and sunbed use in relation to risk and anatomic site of cutaneous melanoma.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10965"/>
        <obo:IAO_0000116>melanoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10477307/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Melanoma Inquiry in Southern Sweden (MISS) was a prospective cohort study looking at risk factors for melanoma [27].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9128912/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In short, 41,000 Swedish-born women, with no history of malignancy, were selected randomly from each year of age in the category 25-64 years, from the Population Registry in southern Sweden (Fig. 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90129576</owl:annotatedTarget>
        <dcterms:title>Genome-wide interaction analysis of menopausal hormone therapy use and breast cancer risk among 62,370 women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35418701</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9007944/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The MISS study is supported by funding from ERC-2011-294576 Advanced grant, Swedish Cancer Society, Swedish Research Council, Local hospital funds, Berta Kamprad Foundation, Gunnar Nilsson.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of Swedish-born women aged 25–64 without a history of cancer, randomly selected from the population registry of the southern Swedish healthcare region and recruited in 1990–1992, who answered a baseline questionnaire on sun exposure habits, constitutional characteristics and other risk factors for melanoma and follow-up questionnaires every ten years, with cancer incidence and mortality followed through Swedish national registers. It was set up to study risk factors for melanoma and is also used to study the health effects of sun exposure.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31663602</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37675201</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40102189</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30501</owl:annotatedTarget>
        <obo:IAO_0000116>women who returned the baseline questionnaire, 1990-1992 (of 41,000 invited)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9128912/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Information was collected from Swedish National Registers on participants (n = 30,501) and non-participants (n = 10,499) in the “Melanoma In Southern Sweden” (MISS) study and the background population (n = 243,032).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MISS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001207 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001207">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90568440</obo:IAO_0000112>
        <obo:IAO_0000115>A twin registry at Michigan State University, begun as a university-based registry of undergraduate twins and since 2004 recruiting twins identified from birth records by the Michigan Department of Health and Human Services. Its population-based mail-in registry enrols child and adolescent twins aged 3–17 with their families and adult twins aged 18–55 living in lower Michigan, United States, and in-depth in-person twin family studies are drawn from it, to examine developmental differences in genetic, environmental, neural and neurobiological influences on psychopathology and resilience, particularly in childhood and adolescence.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MSUTR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Michigan State University Twin Register</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Michigan State University Twin Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001207"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7083329/</oboInOwl:hasDbXref>
        <rdfs:comment>The Michigan Department of Health and Human Services (MDHHS; formerly known as the Michigan Department of Community Health) identifies twin pairs residing in lower Michigan who meet our study age criteria (see criteria below)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001207"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90568440</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of childhood ADHD symptoms and diagnosis identifies new loci and potential effector genes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40962958</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02295-y/MediaObjects/41588_2025_2295_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Data for this study comes from the Michigan State University Twin Registry (MSUTR)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001207"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A twin registry at Michigan State University, begun as a university-based registry of undergraduate twins and since 2004 recruiting twins identified from birth records by the Michigan Department of Health and Human Services. Its population-based mail-in registry enrols child and adolescent twins aged 3–17 with their families and adult twins aged 18–55 living in lower Michigan, United States, and in-depth in-person twin family studies are drawn from it, to examine developmental differences in genetic, environmental, neural and neurobiological influences on psychopathology and resilience, particularly in childhood and adolescence.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23101567</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31466551</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001207"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30000</owl:annotatedTarget>
        <obo:IAO_0000116>twins and family members in the population-based registry (approximate), 2019</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31466551+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The MSUTR has two broad components: a large-scale, population-based registry of child, adolescent, and adult twins and their families (current N ~30,000) and a series of more focused and in-depth studies drawn from the registry (projected N ~7200).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001207"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MSUTR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001208 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001208">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>GCST90568440</obo:IAO_0000112>
        <obo:IAO_0000115>A birth cohort of women recruited at their first antenatal clinic visit at the Mater Hospital in Brisbane, Australia, in 1981–1983, and of their live singleton children, followed up after the birth, at 6 months and at 5, 14 and 21 years, and in adulthood (mothers at 27 years, children at 30 years) with later record linkage. Begun as a study of pregnancy and its outcomes, it has become a longitudinal study of growth, development and ageing that emphasises the transmission across generations of factors affecting adult health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7223</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MUSP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mater University of Queensland Study of Pregnancy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mater-University of Queensland Study of Pregnancy and its outcomes</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Mater-University of Queensland Study of Pregnancy</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001208"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19774750+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The data were taken from the Mater-University of Queensland Study of Pregnancy (MUSP), a longitudinal study of mothers and children which started in Brisbane, Australia, in 1981.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001208"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90568440</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of childhood ADHD symptoms and diagnosis identifies new loci and potential effector genes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40962958</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02295-y/MediaObjects/41588_2025_2295_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The authors thank the MUSP study participants and study team.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001208"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A birth cohort of women recruited at their first antenatal clinic visit at the Mater Hospital in Brisbane, Australia, in 1981–1983, and of their live singleton children, followed up after the birth, at 6 months and at 5, 14 and 21 years, and in adulthood (mothers at 27 years, children at 30 years) with later record linkage. Begun as a study of pregnancy and its outcomes, it has become a longitudinal study of growth, development and ageing that emphasises the transmission across generations of factors affecting adult health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19774750</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25519422</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40889875</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001208"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7223</owl:annotatedTarget>
        <obo:IAO_0000116>pregnant woman-child pairs at baseline, 1981-1983 (6753 mothers)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25519422+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Mater-University of Queensland Study of Pregnancy (MUSP) and its outcomes began in 1981 with data collected on 7223 pregnant woman-child pairs (6753 mothers, of whom 520 had 2 study children, less 50 who had multiple births).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001208"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MUSP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001209 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001209">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid10982"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Czech_Republic"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Hungary"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90162630</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium of myositis research centres through which DNA samples with clinical and autoantibody data from patients of European ancestry with idiopathic inflammatory myopathies (adult and juvenile polymyositis and dermatomyositis, and inclusion body myositis) were collected at participating centres in Europe, the United States and Australia, including national collections such as the UK Adult Onset Myositis Immunogenetic Collaboration, for genome-wide and Immunochip association studies of myositis and its clinical and serological subgroups, analysed against controls supplied by other disease consortia.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2954</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>International Myositis Genetics Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MYOGEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Myositis Genetics Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10982">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0020122"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001209"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10982"/>
        <obo:IAO_0000116>idiopathic inflammatory myopathies</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36580032+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We analyzed 2,565 Caucasian IIM patient samples collected through the Myositis Genetics Consortium (MYOGEN) and 10,260 ethnically matched control samples.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001209"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
