    <!-- http://www.ebi.ac.uk/coho/COHO_0001721 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001721">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15399"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PGS000021</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:38224531</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based longitudinal observational study of people with known diabetes living in a postcode-defined area around the port city of Fremantle, Western Australia, run in two separately recruited phases, Phase I (1993–1996) and Phase II (2008–2011). Participants were identified from hospital, clinic and primary-care lists and local advertising, assessed in detail at entry and followed for diabetes complications and mortality.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1668</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>FDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fremantle Diabetes Study Phase 2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fremantle Diabetes Study Phase II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fremantle diabetes study phase II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Fremantle Diabetes Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15399">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005015"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001721"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15399"/>
        <obo:IAO_0000116>diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In FDS2, 4639 people with diabetes were identified from a population of approximately 157,000, and 1668 (36%) recruited of whom 1509 (90%) had type 2 diabetes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001721"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>FDS1 and FDS2 were similarly conducted, observational, longitudinal studies of known diabetes conducted in the same zip code-defined geographic area surrounding the port city of Fremantle in Western Australia (WA)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001721"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000021</owl:annotatedTarget>
        <dcterms:title>Use of a type 1 genetic risk score for classification of diabetes type in young Australian adults: the Fremantle Diabetes Study Phase II.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38224531</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001721"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38224531</owl:annotatedTarget>
        <dcterms:title>Use of a type 1 genetic risk score for classification of diabetes type in young Australian adults: the Fremantle Diabetes Study Phase II.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38224531</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38224531+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The applicability of a UK-validated genetic risk score (GRS) was assessed in 158 participants in the Fremantle Diabetes Study Phase II diagnosed between 20 and &lt;40 years of age with type 1 or type 2 diabetes or latent autoimmune diabetes of adults (LADA).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001721"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based longitudinal observational study of people with known diabetes living in a postcode-defined area around the port city of Fremantle, Western Australia, run in two separately recruited phases, Phase I (1993–1996) and Phase II (2008–2011). Participants were identified from hospital, clinic and primary-care lists and local advertising, assessed in detail at entry and followed for diabetes complications and mortality.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11981027/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001721"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1668</owl:annotatedTarget>
        <obo:IAO_0000116>Fremantle Diabetes Study Phase II recruits, 2008-2011</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9820984/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In FDS2, 4639 people with diabetes were identified from a population of approximately 157,000, and 1668 (36%) recruited of whom 1509 (90%) had type 2 diabetes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001721"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


