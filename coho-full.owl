        <rdfs:comment>These were combined with healthy controls (N = 1,223) from Germany genotyped on the Illumina HumanOmniExpress12_v1_C array</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001322"/>
