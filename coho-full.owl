        <obo:IAO_0000112>MTBLS1497</obo:IAO_0000112>
        <obo:IAO_0000115>An inception cohort of newly diagnosed, initially treatment-naive patients with seropositive rheumatoid arthritis, recruited from 28 centres in the United Kingdom and assessed every three months for up to 18 months, established by the RA-MAP Consortium.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">275</coho:numberOfParticipants>
