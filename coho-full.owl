        <rdfs:comment>The dietary antioxidant capacity was estimated based on the oxygen radical absorbance capacity (ORAC) incorporated with a semiquantitative food frequency questionnaire.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001363"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7902036/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This case-control study was conducted at the Center for Gastric Cancer (CGC) and the Center for Cancer Prevention &amp; Detection (CCPD) of the National Cancer Center (NCC) in Korea between March 2011 and December 2014.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001363"/>
