        <rdfs:label>MetaboLight_subset</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.ebi.ac.uk/coho#PGS_subset -->

    <owl:AnnotationProperty rdf:about="http://www.ebi.ac.uk/coho#PGS_subset">
        <obo:IAO_0000115 xml:lang="en">The cohorts that scores in the PGS Catalog draw on.</obo:IAO_0000115>
        <rdfs:label>PGS_subset</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    </owl:AnnotationProperty>
    


