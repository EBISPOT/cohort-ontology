        <oboInOwl:hasRelatedSynonym>SoIA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study of Irish Amyotrophic</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>study of Irish Amyotrophic Lateral Sclerosis</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Study of Irish Amyotrophic Lateral Sclerosis</rdfs:label>
