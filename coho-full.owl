    <!-- http://www.ebi.ac.uk/coho/COHO_0000690 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000690">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid6229"/>
        <rdf:type rdf:nodeID="genid6231"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>GCST90841457</obo:IAO_0000112>
        <obo:IAO_0000115>A Finnish pregnancy cohort of 4,785 women recruited at their first ultrasound scan in ten hospital maternity clinics between 2005 and 2010, comprising a high-risk subsample with and without risk factors for preeclampsia and intrauterine growth restriction and a community-based subsample, followed with their children to study the prediction and prevention of pregnancy complications and prenatal influences on offspring development.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4785</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PREDO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prediction and Prevention of Pre-eclampsia and Intrauterine Growth Restriction study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prediction and Prevention of Preeclampsia Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Prediction and Prevention of Preeclampsia and Intrauterine Growth Restriction study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Prediction and Prevention of Preeclampsia and Intrauterine Growth Restriction Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid6229">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005030"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid6231">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005081"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000690"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid6229"/>
        <obo:IAO_0000116>intrauterine growth restriction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12964119/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The PREDO study recruited between 12 and 14 gestational weeks (GWs) 1079 pregnant women with known risk factor status for preeclampsia and intrauterine growth restriction from 10 hospitals [26].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000690"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid6231"/>
        <obo:IAO_0000116>preeclampsia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12964119/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The PREDO study recruited between 12 and 14 gestational weeks (GWs) 1079 pregnant women with known risk factor status for preeclampsia and intrauterine growth restriction from 10 hospitals [26].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000690"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12964119/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Our study population came from 3 Finnish studies, the Prediction and Prevention of Pre-eclampsia and Intrauterine Growth Restriction (PREDO) study [26], the Finnish Gestational Diabetes Prevention (RADIEL) study [27], and the InTraUterine Sampling in Early Pregnancy Study (ITU) [28].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000690"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90841457</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry, trans-generational GWAS meta-analysis of gestational diabetes and glycaemic traits during pregnancy reveals limited evidence of pregnancy-specific genetic effects.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42225636</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13226718/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>PREDO The Prediction and Prevention of Preeclampsia and Intrauterine Growth Restriction study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000690"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Finnish pregnancy cohort of 4,785 women recruited at their first ultrasound scan in ten hospital maternity clinics between 2005 and 2010, comprising a high-risk subsample with and without risk factors for preeclampsia and intrauterine growth restriction and a community-based subsample, followed with their children to study the prediction and prevention of pregnancy complications and prenatal influences on offspring development.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26919119</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27639277</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000690"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4785</owl:annotatedTarget>
        <obo:IAO_0000116>pregnant women recruited 2005-2010</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4769149/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 4785 recruited mothers, we had data on birth outcomes from the birth register and the two-week interval self-report of positive affect, depressive symptoms, and state anxiety during pregnancy for 3376 mothers (70.6% of those recruited).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000690"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PREDO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


