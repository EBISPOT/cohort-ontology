        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5570675/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of those sites, 7 are European centers (BASICMAR—Spain, BRAINS—United Kingdom, GRAZ—Austria, KRAKOW—Poland, LEUVEN—Belgium, LUND STROKE REGISTER—Sweden, and SAHLSIS—Sweden) and 5 are based in the United States (GASROS, GCNKSS, GEOS, ISGS, and MIAMISR).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001082"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90301368</owl:annotatedTarget>
        <dcterms:title>Evidence of survival bias in the association between APOE-Є4 and age at ischemic stroke onset.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39286457</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11403718/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>GCNKSS: The Greater Cincinnati/Northern Kentucky Stroke Study (GCNKSS) was supported by the NIH (NS030678).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001082"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study of stroke incidence, risk factors, treatment and outcomes in the biracial population of a five-county region of southwestern Ohio and northern Kentucky, United States, around Cincinnati, which ascertains all hospitalized and autopsied strokes and transient ischaemic attacks among residents during one-year study periods held since 1993 (July 1993 to June 1994, 1999, 2005, 2010 and 2015), to measure temporal trends in stroke incidence and outcome.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28645938</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38533959</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38700029</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9472883</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001082"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GCNKSS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


