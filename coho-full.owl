    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001078"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9876"/>
        <obo:IAO_0000116>dementia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7021682/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Epidemiology of Dementia in Singapore (EDIS) study is a subsample of a population-based study focusing on the risk factors and prevalence of dementia and cognitive impairment in the three major Asian ethnicities.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001078"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9878"/>
        <obo:IAO_0000116>cognitive impairment</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7021682/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Epidemiology of Dementia in Singapore (EDIS) study is a subsample of a population-based study focusing on the risk factors and prevalence of dementia and cognitive impairment in the three major Asian ethnicities.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001078"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000763"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4616471/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The ongoing Epidemiology of Dementia in Singapore (EDIS) study draws participants from the Singapore Epidemiology of Eye Disease (SEED) study, a multiethnic population-based study among persons ages 40–85 years among Chinese (Singapore Chinese Eye Study [SCES]), Malay (Singapore Malay Eye Study [SiMES-2]), and Indians (Singapore Indian Eye Study [SINDI-2]).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001078"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90448709</owl:annotatedTarget>
        <dcterms:title>Chromosome 10q24.32 Variants Associate With Brain Arterial Diameters in Diverse Populations: A Genome-Wide Association Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38038215</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10727334/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The authors thank the staff and participants of the ARIC, NOMAS, WHICAP, EDIS, MCS, and FHS studies for their important contributions.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001078"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study of the prevalence and risk factors of cognitive impairment and dementia in Chinese, Malay and Indian adults in Singapore, which drew participants aged 60 and over from the Singapore Epidemiology of Eye Diseases study (the Singapore Chinese Eye Study, 2009–2011, the Singapore Malay Eye Study, 2010–2013, and the Singapore Indian Eye Study, 2013–2015). Participants were screened with the Abbreviated Mental Test and a history of progressive forgetfulness, and those who screened positive were invited for neuropsychological testing and brain MRI.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26061305</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32060376</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39179981</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001078"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
