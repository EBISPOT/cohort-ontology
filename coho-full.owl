        <oboInOwl:hasDbXref>PMID:33472890</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000874"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case–control study of lung cancer at The University of Texas MD Anderson Cancer Center in Houston, Texas, of ever-smoking patients of European ancestry and frequency-matched ever-smoking controls, genotyped genome-wide to find lung cancer susceptibility loci and later pooled in international lung cancer consortia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18385676</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
