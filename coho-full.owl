        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international network of investigators that meta-analyses genome-wide association study data from many cohorts to identify genetic variants and genes affecting reproductive ageing and reproductive timing, such as age at menarche and age at natural menopause.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.reprogen.org/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
