    <!-- http://www.ebi.ac.uk/coho/COHO_0000666 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000666">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid6020"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>GCST90129599</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of Alzheimer&apos;s disease cases and dementia-free controls from Sweden that combines cases diagnosed in memory clinics in different parts of Sweden or identified in two population-based studies in Gothenburg, the Prospective Population Study of Women and the Gothenburg Birth Cohort Studies (H70, H85 and 95+), with controls from those Gothenburg population studies, genotyped for genome-wide association studies of Alzheimer&apos;s disease and its biomarkers.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym TGS also denotes MrOS Gothenburg (COHO:0000892); this term is Gothenburg H70 Birth Cohort Studies and Clinical AD Sweden.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">712</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2523</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>GH70</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gothenburg H70 Birth Cohort Studies and Clinical AD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gothenburg H70 Birth Cohort Studies and Clinical AD from Sweden</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gothenburg H70 Birth Cohort studies and clinical AD samples from Sweden</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Gothenburg H70 Birth Cohort Studies and Clinical AD Sweden</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid6020">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004975"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000666"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid6020"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Gothenburg H70 Birth Cohort Studies and Clinical AD from Sweden (Gothenburg) AD cases originate from Sweden and were either collected in memory clinics (in different parts of Sweden) or as a part of two population-based epidemiological studies in Gothenburg</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000666"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Gothenburg H70 Birth Cohort Studies and Clinical AD from Sweden (Gothenburg) AD cases originate from Sweden and were either collected in memory clinics (in different parts of Sweden) or as a part of two population-based epidemiological studies in Gothenburg; the Prospective Population Study of Women (PPSW) and the Gothenburg Birth Cohort Studies (H70, H85 and 95+), described in detail previously100–103 . Controls originate from the Gothenburg Birth Cohort Studies and PPSW.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000666"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90129599</owl:annotatedTarget>
        <dcterms:title>Genome-wide meta-analysis for Alzheimer&apos;s disease cerebrospinal fluid biomarkers.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36066633</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9547780/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For the Gothenburg H70 Birth Cohort studies and clinical AD samples from Sweden, the QC and imputation procedures were described elsewhere [48].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000666"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of Alzheimer&apos;s disease cases and dementia-free controls from Sweden that combines cases diagnosed in memory clinics in different parts of Sweden or identified in two population-based studies in Gothenburg, the Prospective Population Study of Women and the Gothenburg Birth Cohort Studies (H70, H85 and 95+), with controls from those Gothenburg population studies, genotyped for genome-wide association studies of Alzheimer&apos;s disease and its biomarkers.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36066633</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42237039</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000666"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">712</owl:annotatedTarget>
        <obo:IAO_0000116>AD cases and controls in the genotyped Gothenburg dataset (2021 GWAS); no combined total stated</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-021-00921-z/MediaObjects/41588_2021_921_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Gothenburg H70 Birth Cohort Studies and Clinical AD from Sweden (Gothenburg) dataset (712 cases, 2523 controls) was used as the independent test set because it was the dataset with the largest number of cases of the available genotype-level data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000666"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2523</owl:annotatedTarget>
        <obo:IAO_0000116>AD cases and controls in the genotyped Gothenburg dataset (2021 GWAS); no combined total stated</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-021-00921-z/MediaObjects/41588_2021_921_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Gothenburg H70 Birth Cohort Studies and Clinical AD from Sweden (Gothenburg) dataset (712 cases, 2523 controls) was used as the independent test set because it was the dataset with the largest number of cases of the available genotype-level data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000666"/>
