        <oboInOwl:hasRelatedSynonym>CLUE II cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CLUEII</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Campaign against Cancer and Heart Disease II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Give Us a Clue to Cancer and Heart Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Give Us a Clue to Cancer and Heart Disease Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Give Us a Clue to Cancer and Heart Disease Study II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">CLUE II</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000634"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3241297/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In 1989, a local campaign against cancer and heart disease named CLUE II was conducted in Washington County, Maryland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000634"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90504004</owl:annotatedTarget>
        <dcterms:title>Genome-wide interaction study of dietary intake of fibre, fruits, and vegetables with risk of colorectal cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38749303</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11112268/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We thank the participants of Clue II and appreciate the continued efforts of the staff at the Johns Hopkins George W.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000634"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based prospective cohort of 32,894 mostly White adults in Washington County, Maryland, USA, who gave blood samples, blood pressure readings and brief medical histories during a 1989 campaign against cancer and heart disease run from the Johns Hopkins George W. Comstock Center, followed through cancer-registry linkage to study risk factors for cancer and heart disease.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3241297/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9970317/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000634"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32894</owl:annotatedTarget>
        <obo:IAO_0000116>participants at the 1989 baseline</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9970317/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>At the baseline visit (1989 for CLUE II), brief medical histories, blood pressure readings, and blood samples were collected on 32,894 participants (25,076 of which were residents of Washington County).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000634"/>
