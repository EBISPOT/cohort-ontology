        <obo:IAO_0000116>dyslipidemia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10364164/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>STRRIDE I (1999–2003) and STRRIDE AT/RT (2004–2008) enrolled previously sedentary adults with overweight or obesity and mild-to-moderate dyslipidemia (classified by LDL-cholesterol 130–190 mg/dl or HDL-cholesterol ≤40 mg/dl for men and ≤45 mg/dl for women).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000983"/>
