        <rdfs:comment>Participants from the US were recruited into the Genetic Study of Hypertension in Blacks between 1995–1999 and the Fat Reduction Intervention Trial in African-Americans (FRITAA) between 1995–1998.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001098"/>
