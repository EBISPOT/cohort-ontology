    <!-- http://www.ebi.ac.uk/coho/COHO_0001832 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001832">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid16319"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000207"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000347"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001718"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002271"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PGS000351</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:22266113</obo:IAO_0000112>
        <obo:IAO_0000115>The second UK genome-wide association study of breast cancer, funded by the Wellcome Trust and Cancer Research UK, whose cases are women with breast cancer from UK cancer genetics clinics, recruited through the Familial Breast Cancer Study, and from UK oncology clinics, recruited through the POSH study, and whose controls come from the 1958 Birth Cohort and the UK National Blood Service, genotyped by the Wellcome Trust Case Control Consortium 2.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3960</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5069</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>GWAS_UK2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK2 GWAS of breast cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">UK2 GWAS</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16319">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16319"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC3632836</oboInOwl:hasDbXref>
        <rdfs:comment>We studied 3,960 cases of breast cancer from the UK, selected for a positive family history of breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000207"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>UK2 UK UK cancer genetics clinics + oncology clinicas WTCCC2: 1958 Birth Cohort + UK National Blood Service Illumina 670k (cases) Illumina 1.2M (controls) 3628 5190</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000347"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>UK2 UK UK cancer genetics clinics + oncology clinicas WTCCC2: 1958 Birth Cohort + UK National Blood Service Illumina 670k (cases) Illumina 1.2M (controls) 3628 5190</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001718"/>
        <oboInOwl:hasDbXref>https://www.nature.com/articles/ng.1049</oboInOwl:hasDbXref>
        <rdfs:comment>FBCS organized patient recruitment and data and sample collection for the UK2 GWAS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002271"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3378688/</oboInOwl:hasDbXref>
        <rdfs:comment>The present analysis was based on genotype data from the UK2 GWAS, as previously described in (5). The cases were recruited from 23 clinical genetics centres in the UK through the Familial Breast Cancer Study (FBCS) and from oncology clinics in the UK through the Prospective study of Outcomes in Sporadic versus Hereditary (POSH) breast cancer study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>UK2 UK UK cancer genetics clinics + oncology clinicas WTCCC2: 1958 Birth Cohort + UK National Blood Service Illumina 670k (cases) Illumina 1.2M (controls)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000351</owl:annotatedTarget>
        <dcterms:title>Polygenic risk scores and breast and epithelial ovarian cancer risks for carriers of BRCA1 and BRCA2 pathogenic variants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32665703</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22266113</owl:annotatedTarget>
        <dcterms:title>Mammographic breast density and breast cancer: evidence of a shared genetic basis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22266113</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22266113+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To explore whether PMD and breast cancer have a shared genetic basis, we identified genetic variants most strongly associated with PMD in a published meta-analysis of five genome-wide association studies (GWAS) and used these to construct risk scores for 3,628 breast cancer cases and 5,190 controls from the UK2 GWAS of breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The second UK genome-wide association study of breast cancer, funded by the Wellcome Trust and Cancer Research UK, whose cases are women with breast cancer from UK cancer genetics clinics, recruited through the Familial Breast Cancer Study, and from UK oncology clinics, recruited through the POSH study, and whose controls come from the 1958 Birth Cohort and the UK National Blood Service, genotyped by the Wellcome Trust Case Control Consortium 2.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20453838</obo:IAO_0000119>
        <obo:IAO_0000119>https://europepmc.org/api/getPdf?pmcid=PMC4229095</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3960</owl:annotatedTarget>
        <obo:IAO_0000116>familial breast cancer cases and UK population controls of stage 1 of the GWAS, as its design paper states them (no total stated)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC3632836</oboInOwl:hasDbXref>
        <rdfs:comment>We studied 3,960 cases of breast cancer from the UK, selected for a positive family history of breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5069</owl:annotatedTarget>
        <obo:IAO_0000116>familial breast cancer cases and UK population controls of stage 1 of the GWAS, as its design paper states them (no total stated)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC3632836</oboInOwl:hasDbXref>
        <rdfs:comment>Case genotypes were compared with those from 5,069 controls, drawn from two UK population-based studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001832"/>
