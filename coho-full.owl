        <oboInOwl:hasRelatedSynonym>Prince of Wales Hospital Diabetes Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Hong Kong Diabetes Register</rdfs:label>
    </owl:NamedIndividual>
