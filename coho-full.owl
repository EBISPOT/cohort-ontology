        <owl:annotatedTarget>GCST90841457</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry, trans-generational GWAS meta-analysis of gestational diabetes and glycaemic traits during pregnancy reveals limited evidence of pregnancy-specific genetic effects.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42225636</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-026-73509-y/MediaObjects/41467_2026_73509_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>Project Viva 1999-2002 USA</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001254"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective pre-birth cohort, run from Harvard Medical School and the Harvard Pilgrim Health Care Institute, of women recruited in early pregnancy at eight obstetric offices of Atrius Harvard Vanguard Medical Associates, a multi-specialty group practice in eastern Massachusetts, United States, from April 1999 to November 2002, and their children, followed with in-person visits during pregnancy, at delivery, in infancy, early and mid-childhood and early adolescence and with annual mailed questionnaires, to examine prenatal diet and other early-life factors in relation to maternal and child health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24639442</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37012456</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
