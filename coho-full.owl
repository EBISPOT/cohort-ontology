        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002002"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002719"/>
        <obo:IAO_0000112>GCST90102623</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based family study of about 1,300 adults from Stelvio, Vallelunga and Martello, three small, historically isolated villages of the Val Venosta (Vinschgau) in South Tyrol, Italy, surveyed by the European Academy of Bozen/Bolzano (EURAC) in 2002–2003 and 2007, with reconstructed genealogies, to study the genetic epidemiology of Mendelian and complex diseases.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1314</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MICROS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MICROS study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Micro-isolates in South Tyrol Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>genetic study of three population microisolates in South Tyrol</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Microisolates in South Tyrol Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000834"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1913911/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As a part of a larger, ongoing genetic healthcare research program on the South Tyrolean population (the GenNova project), in 2002–2003, an extensive survey (the MICROS study) was carried out on the populations of Stelvio, Vallelunga and Martello, three villages of the Val Venosta.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000834"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90102623</owl:annotatedTarget>
        <dcterms:title>Genomewide meta-analysis identifies loci associated with IGF-I and IGFBP-3 levels with impact on age-related traits.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27329260</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5013013/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>MICROS 1 1189 - 0 - 47 46 149.0 (84) NA Italy Pattaro el al (2007), BMC Med Gen 5, 8-29</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000834"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based family study of about 1,300 adults from Stelvio, Vallelunga and Martello, three small, historically isolated villages of the Val Venosta (Vinschgau) in South Tyrol, Italy, surveyed by the European Academy of Bozen/Bolzano (EURAC) in 2002–2003 and 2007, with reconstructed genealogies, to study the genetic epidemiology of Mendelian and complex diseases.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17550581</obo:IAO_0000119>
