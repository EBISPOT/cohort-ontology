        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4756509/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The ICICLE study recruited patients from participating centers throughout the UK with the aim of identifying predisposition genes for DCIS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001900"/>
