    <!-- http://www.ebi.ac.uk/coho/COHO_0002689 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002689">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22663"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Kenya"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:41781022</obo:IAO_0000112>
        <obo:IAO_0000115>A population cohort of the residents of a defined area around Kilifi on the Indian Ocean coast of Kenya, established in 2000 by the KEMRI-Wellcome Trust Research Programme with a census and followed by regular household visits recording births, pregnancies, migrations and deaths, with residents&apos; admissions to Kilifi District Hospital linked to the population register, to measure the incidence of local diseases, evaluate community interventions against infectious diseases and provide a sampling frame for epidemiological studies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">261919</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>KEMRI-Wellcome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KHDSS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Kilifi Health and Demographic Surveillance System</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.kemri-wellcome.org/"/>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22663">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005550"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002689"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22663"/>
        <obo:IAO_0000116>infectious disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3396317/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The focus of research work has been on the incidence of infectious diseases in children, defining risk factors including genetic risks, and interventions to prevent infectious diseases—particularly vaccines.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002689"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Kenya"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3396317/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Kilifi Health and Demographic Surveillance System (KHDSS), located on the Indian Ocean coast of Kenya, was established in 2000 as a record of births, pregnancies, migration events and deaths and is maintained by 4-monthly household visits.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002689"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:41781022</owl:annotatedTarget>
        <dcterms:title>Prevalence, spatial and temporal distribution of tungiasis in the Kilifi Health and Demographic Surveillance System (KHDSS) in Kenya.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41781022</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:41781022%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We leveraged the Kilifi Health and Demographic Surveillance System of 90 257 households and asked whether they had a case of tungiasis in the household at interview during three survey rounds of routine surveys, undertaken between May 2021 and May 2022.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002689"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population cohort of the residents of a defined area around Kilifi on the Indian Ocean coast of Kenya, established in 2000 by the KEMRI-Wellcome Trust Research Programme with a census and followed by regular household visits recording births, pregnancies, migrations and deaths, with residents&apos; admissions to Kilifi District Hospital linked to the population register, to measure the incidence of local diseases, evaluate community interventions against infectious diseases and provide a sampling frame for epidemiological studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22544844</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002689"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">261919</owl:annotatedTarget>
        <obo:IAO_0000116>residents under surveillance in March 2011</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:22544844</oboInOwl:hasDbXref>
        <rdfs:comment>In March 2011, there were 29 970 households with 261 919 residents under surveillance; 49% of these were aged &lt;15 years and 18% were aged &lt;5 years (Figure 2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002689"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>KEMRI-Wellcome</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002689"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>KHDSS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


