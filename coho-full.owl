        <rdfs:comment>We studied 131 Greek participants in the Multicenter Hemophilia Cohort Study who had known HIV-1 seroconversion dates.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001373"/>
