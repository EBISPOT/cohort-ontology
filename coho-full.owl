        <oboInOwl:hasRelatedSynonym>UPCH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Danish T2D Case-Control Study</rdfs:label>
    </owl:NamedIndividual>
