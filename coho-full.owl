        <rdfs:comment>The Copenhagen Prostate Cancer Study 1 included 872 unselected patients recruited with prostate cancer between 2008-2011 from Herlev Hospital, Copenhagen University Hospital, Herlev, Denmark.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001628"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
