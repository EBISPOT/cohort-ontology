        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Greece"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Hungary"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>PMID:37608495</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre cross-sectional study of adolescents aged 12.5 to 17.5 years in ten European cities (Stockholm, Athens, Heraklion, Rome, Zaragoza, Ghent, Lille, Dortmund, Vienna and Pecs), carried out from October 2006 to December 2007 within the European Union-funded HELENA project, which selected adolescents through randomly chosen schools by multi-stage random cluster sampling stratified by geographical location, age and socioeconomic status, and measured diet, physical activity, fitness and body composition with harmonised methods, with fasting blood samples from a randomly selected subsample, to describe the nutritional status and lifestyle of European adolescents.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3528</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HELENA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HELENA Cross-Sectional Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HELENA Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HELENA cross-sectional study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HELENA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HELENA-CSS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Healthy Lifestyle in Europe by Nutrition in Adolescence Cross-Sectional Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Healthy Lifestyle in Europe by Nutrition in Adolescence study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Healthy Lifestyle in Europe by Nutrition in Adolescence Study</rdfs:label>
    </owl:NamedIndividual>
