        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">The Stefanie Spielman Breast Bank and the Columbus Area Control Sample Bank</rdfs:label>
    </owl:NamedIndividual>
