        <rdfs:seeAlso rdf:resource="https://Healthynv.org"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001869"/>
