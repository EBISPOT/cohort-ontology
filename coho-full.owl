        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">777</owl:annotatedTarget>
        <obo:IAO_0000116>Patients randomized in the LRF CLL4 trial</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17658394+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>777 patients with chronic lymphocytic leukaemia requiring treatment were randomly assigned to fludarabine (n=194) or fludarabine plus cyclophosphamide (196) for six courses, or chlorambucil (387) for 12 courses.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
