        <owl:annotatedTarget rdf:nodeID="genid5421"/>
        <obo:IAO_0000116>attention deficit/hyperactivity disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21473745+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Behavioural data were collected from 1068 probands with the combined type of attention deficit/hyperactivity disorder (ADHD-CT) and 1446 &apos;unselected&apos; siblings.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000607"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1559631/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The sample consists of European Caucasian subjects recruited from twelve specialist clinics in eight countries: Belgium, Germany, Holland, Ireland, Israel, Spain, Switzerland and United Kingdom.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000607"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20732625</owl:annotatedTarget>
        <dcterms:title>Meta-analysis of genome-wide association studies of attention-deficit/hyperactivity disorder.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20732625</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20732625+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>phase I of the International Multicenter ADHD Genetics project (IMAGE); c) phase II of IMAGE (IMAGE II)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000607"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A European multi-site family sample of children aged 5 to 17 with DSM-IV combined-type ADHD, their siblings and parents, all of white European Caucasian descent, recruited in 2003-2007 at specialist ADHD clinics in eight countries for molecular genetic studies of ADHD, including candidate-gene, linkage and genome-wide association analyses; a second phase (IMAGE II) combined ADHD cases from the original project and from further clinics in Germany, the Netherlands and the UK with population controls for genome-wide association.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16887023</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20732625</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21473745</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000607"/>
