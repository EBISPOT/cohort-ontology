    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000510"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multi-site prospective cohort following up the Dutch families of the International Multicenter ADHD Genetics project together with newly recruited families, comprising 1,069 children from ADHD and control families and 848 parents assessed with diagnostic interviews, questionnaires, cognitive tests, structural and functional MRI and genome-wide genotyping, to study the course of ADHD into adolescence and adulthood and its genetic, environmental and neural underpinnings.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25012461</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
