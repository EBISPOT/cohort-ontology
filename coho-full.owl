        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ExO_0000002"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002178"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18784"/>
        <obo:IAO_0000116>nasopharyngeal carcinoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5675616/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a population-based case-control study of nasopharyngeal carcinoma in Guangdong Province and Guangxi Autonomous Region.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002178"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18786"/>
        <obo:IAO_0000116>infection with the Epstein-Barr virus (EBV)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5675616/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Therefore, we undertook a large, population-based case-control study of NPC in southern China (the NPC Genes, Environment, and EBV (NPCGEE) study) with the specific aims of understanding the independent and interactive roles of genes, environmental exposures, and infection with the Epstein-Barr virus (EBV) in disease etiology.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002178"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18788"/>
        <obo:IAO_0000116>environmental exposures</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5675616/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Therefore, we undertook a large, population-based case-control study of NPC in southern China (the NPC Genes, Environment, and EBV (NPCGEE) study) with the specific aims of understanding the independent and interactive roles of genes, environmental exposures, and infection with the Epstein-Barr virus (EBV) in disease etiology.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002178"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5675616/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Therefore, we undertook a large, population-based case-control study of NPC in southern China (the NPC Genes, Environment, and EBV (NPCGEE) study) with the specific aims of understanding the independent and interactive roles of genes, environmental exposures, and infection with the Epstein-Barr virus (EBV) in disease etiology.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002178"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS002291</owl:annotatedTarget>
        <dcterms:title>The interaction and mediation effects between the host genetic factors and Epstein-Barr virus VCA-IgA in the risk of nasopharyngeal carcinoma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37970759</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002178"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:35414057</owl:annotatedTarget>
        <dcterms:title>A polygenic risk score for nasopharyngeal carcinoma shows potential for risk stratification and personalized screening.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35414057</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9005522/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 12 independent variants were included in the PRS calculation based on the GWAS results (EPIC-NPC-2005, NPCGEE, SYSUNPC, and Hong Kong samples).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002178"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of nasopharyngeal carcinoma in southern China, in which incident cases aged 20–74 years were recruited from March 2010 to December 2013, and randomly selected population controls from November 2010 to November 2014, among residents of 13 cities and counties of Guangdong Province and Guangxi Autonomous Region, with questionnaires and biospecimens collected to study the independent and interactive roles of genes, environmental exposures and Epstein–Barr virus infection in the disease; it was conducted by Sun Yat-sen University Cancer Center, Karolinska Institutet, Guangxi Medical University and collaborating institutions.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29152064</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002178"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2554</owl:annotatedTarget>
        <obo:IAO_0000116>incident nasopharyngeal carcinoma cases and population controls enrolled, 2010-2014</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5675616/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>By the end of the study recruitment phase, which ended in December 2014, we enrolled a total of 2554 NPC cases and 2648 population-based controls (Tables 1 and 2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002178"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2648</owl:annotatedTarget>
        <obo:IAO_0000116>incident nasopharyngeal carcinoma cases and population controls enrolled, 2010-2014</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5675616/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>By the end of the study recruitment phase, which ended in December 2014, we enrolled a total of 2554 NPC cases and 2648 population-based controls (Tables 1 and 2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002178"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NPCGEE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002179 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002179">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000626"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. NPHS, the National Physicians Health Study of PMID:26590902, is the Physicians&apos; Health Study. Replaced by COHO:0000626 (Physicians&apos; Health Study), which now carries this term&apos;s names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete NPHS</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002180 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002180">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001872"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. Novel Risk Factors and Potential Early Detection Markers for Ovarian Cancer is the name several Ovarian Cancer Association Consortium tables give its study HOP (PMID:23535730, PMID:27698005), which the consortium elsewhere names Hormones and Ovarian Cancer Prediction. Replaced by COHO:0001872 (Hormones and Ovarian Cancer Prediction Study), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Novel Risk Factors and Potential Early Detection Markers for Ovarian Cancer</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002181 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002181">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. NRG Oncology is a clinical trials group. In the CIMBA papers the PGS Catalog records the id in (PMID:29058716), it labels the group&apos;s contribution of BRCA1 and BRCA2 carriers, with no study name of its own; the carriers are covered by CIMBA (COHO:0000901). Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete NRG Oncology</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002182 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002182">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
