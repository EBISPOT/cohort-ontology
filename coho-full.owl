    <!-- http://www.ebi.ac.uk/coho/COHO_0002625 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002625">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <obo:IAO_0000112>PMID:34046850</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective birth cohort of children born between June 2003 and October 2004 in two hospitals in Rome, Italy, to mothers resident in the district of the Local Health Unit RME, followed up through childhood as a pilot for a national Italian birth cohort, to study genetic and environmental influences on child health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">719</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/GASPII</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>GASPII</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GASPII birth cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IT-GASPII</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gene and environment prospective study on infancy in Italy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Gene and Environment: Prospective Study on Infancy in Italy</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002625"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3888562/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>GASPII (Gene and Environment: Prospective Study on Infancy in Italy) is a prospective birth cohort of children born during 2003–2004 in Rome, Italy</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002625"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34046850</owl:annotatedTarget>
        <dcterms:title>Prenatal and postnatal exposure to acetaminophen in relation to autism spectrum and attention-deficit and hyperactivity symptoms in childhood: Meta-analysis in six European population-based cohorts.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34046850</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8542535/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We included six European population-based birth cohorts: Avon Longitudinal Study of Parents and Children (ALSPAC), DNBC, Gene and Environment: Prospective Study on Infancy in Italy (GASPII), the Generation R Study, INMA (including four subcohorts), and the Mother–Child Cohort in Crete (RHEA) (Methods S1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002625"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective birth cohort of children born between June 2003 and October 2004 in two hospitals in Rome, Italy, to mothers resident in the district of the Local Health Unit RME, followed up through childhood as a pilot for a national Italian birth cohort, to study genetic and environmental influences on child health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18326421</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24149084</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002625"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">719</owl:annotatedTarget>
        <obo:IAO_0000116>children enrolled at birth 2003-2004 (with 704 mothers)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:18326421</oboInOwl:hasDbXref>
        <rdfs:comment>The cohort consisted of 704 women (54% of the contacted) and 719 children.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002625"/>
