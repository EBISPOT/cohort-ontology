        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS50000000170</oboInOwl:hasDbXref>
        <rdfs:comment>We aim to develop a microbiome-based classification algorithm to identify advanced colorectal lesions in screening participants testing positive for an immunochemical fecal occult blood test (FIT). We will also examine interactions with host factors, diet, lifestyle and prescription drugs.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000239"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2418"/>
        <obo:IAO_0000116>colorectal cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS50000000170</oboInOwl:hasDbXref>
        <rdfs:comment>We aim to develop a microbiome-based classification algorithm to identify advanced colorectal lesions in screening participants testing positive for an immunochemical fecal occult blood test (FIT). We will also examine interactions with host factors, diet, lifestyle and prescription drugs.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000239"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Norway"/>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS50000000170</oboInOwl:hasDbXref>
        <rdfs:comment>a prospective biomarker study (CRCbiome), nested within a large randomized CRC screening trial in Norway</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000239"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective biomarker cohort nested within the Bowel Cancer Screening in Norway trial, recruiting participants with a positive faecal immunochemical test since 2017 for gut metagenome, diet and lifestyle assessment before and after colonoscopy.</owl:annotatedTarget>
        <obo:IAO_0000119>https://ega-archive.org/studies/EGAS50000000170</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000239"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1640</owl:annotatedTarget>
        <obo:IAO_0000116>FIT-positive screening participants who consented</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13507204/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Those with a positive FIT test (&gt;15 microgram Hb/g feces) were invited to participate in the CRCbiome study ( N = 2700), and 1640 consented.</rdfs:comment>
    </owl:Axiom>
    


