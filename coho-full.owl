        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30523039+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>ColoCare is recruiting newly diagnosed patients with colorectal cancer across six sites in the United States and one site in Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001604"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25472670</owl:annotatedTarget>
        <dcterms:title>Suitability of circulating miRNAs as potential prognostic markers in colorectal cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25472670</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25472670+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This pilot study is based on the ColoCare Study, a cohort study of newly diagnosed patients with stage I-IV colorectal cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001604"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international, multicentre prospective cohort of adults newly diagnosed with invasive colorectal cancer of any stage. It began at the Fred Hutchinson Cancer Research Center in Seattle in 2007 and from 2009 added sites in Tampa, Heidelberg (Germany), Salt Lake City, Los Angeles, St. Louis and Memphis. Patients are enrolled before surgery. They complete questionnaires and give blood, urine and stool at enrolment and repeatedly during five years of follow-up, tumour and adipose tissue are collected at surgery, and treatment and outcome data are abstracted from medical records, so that biomarkers and modifiable lifestyle factors that predict recurrence, survival, treatment toxicity and quality of life can be found.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30523039</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001604"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2000</owl:annotatedTarget>
        <obo:IAO_0000116>patients recruited across all sites by April 2018 (lower bound)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:30523039</oboInOwl:hasDbXref>
        <rdfs:comment>As of April 2018, we have recruited &gt;2,000 patients across all sites.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001604"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ColoCare</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


