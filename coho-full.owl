        <obo:IAO_0000112>GCST90011885</obo:IAO_0000112>
        <obo:IAO_0000112>PGS002732</obo:IAO_0000112>
        <obo:IAO_0000115>The part of the European NAFLD Registry, a prospective observational cohort of adults with non-alcoholic fatty liver disease sponsored by Newcastle University, made up of patients with biopsy-characterised NAFLD who were recruited at liver centres across Europe from 2010 to December 2017 in the FLIP, EPoS and HEPAmet studies of NAFLD pathogenesis, or came from earlier single-centre cohorts, and used by the IMI2 LITMUS project to evaluate non-invasive biomarkers. Patients recruited since 2018 form the Registry&apos;s separate LITMUS Study Cohort.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>EPOS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPoS Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LITMUS metacohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The &quot;European NAFLD Registry&quot; Metacohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The European NAFLD Registry-Metacohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">LITMUS Metacohort</rdfs:label>
    </owl:NamedIndividual>
