        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Iran"/>
        <obo:IAO_0000112>PMID:42488319</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based prospective study of a representative sample of residents of district 13 of Tehran, Iran, aged 3 years and over and selected by multistage stratified cluster random sampling, designed in 1997 and begun in 1999 as a cross-sectional survey of non-communicable disease risk factors; from 2002 it became a long-term longitudinal study, including a controlled community lifestyle intervention, with follow-up examinations about every three years.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15005</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TLGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tehran lipid and glucose study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Tehran Lipid and Glucose Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20930">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000013"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid20932">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
