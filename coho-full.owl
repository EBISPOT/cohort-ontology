        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37985413+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We performed GWAS on sporadic Alzheimer&apos;s disease (AD) including 539 patients and 854 controls from Argentina and Chile.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001256"/>
