        <obo:IAO_0000112>PGS004913</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:38727677</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control sample drawn from the Indiana Biobank, the statewide biobank of Indiana University, Purdue University and the University of Notre Dame whose participants are recruited in person from participating clinics and linked to the Indiana Network for Patient Care, comprising participants with chronic liver disease identified from ICD-9/10 codes and confirmed by chart review, among them patients with cirrhosis attributed to alcohol or to metabolic dysfunction-associated steatotic liver disease, and liver disease-free controls without liver-specific codes or abnormal liver tests, assembled for genetic studies of cirrhosis.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1033</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3239</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>IB-Liver</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IB-liver</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Indiana Biobank Liver cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16784">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005154"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001891"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16784"/>
        <obo:IAO_0000116>chronic liver disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11093576/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Chronic liver disease cases were identified using ICD9/10 liver disease–specific codes and subsequently confirmed via electronic medical chart review (N=1033).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001891"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS004913</owl:annotatedTarget>
        <dcterms:title>A polygenic risk score for alcohol-associated cirrhosis among heavy drinkers with European ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38727677</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001891"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38727677</owl:annotatedTarget>
        <dcterms:title>A polygenic risk score for alcohol-associated cirrhosis among heavy drinkers with European ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38727677</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11093576/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>It was validated in 2 additional independent cohorts from the UK Biobank with diagnosed ALC (N=467) and high-risk drinking controls (N=8981) and participants in the Indiana Biobank Liver cohort with alcohol-associated liver disease (N=121) and controls without liver disease (N=3239).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001891"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control sample drawn from the Indiana Biobank, the statewide biobank of Indiana University, Purdue University and the University of Notre Dame whose participants are recruited in person from participating clinics and linked to the Indiana Network for Patient Care, comprising participants with chronic liver disease identified from ICD-9/10 codes and confirmed by chart review, among them patients with cirrhosis attributed to alcohol or to metabolic dysfunction-associated steatotic liver disease, and liver disease-free controls without liver-specific codes or abnormal liver tests, assembled for genetic studies of cirrhosis.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38727677</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001891"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1033</owl:annotatedTarget>
        <obo:IAO_0000116>chronic liver disease cases confirmed by chart review, and liver disease-free controls, of the Indiana Biobank</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11093576/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Chronic liver disease cases were identified using ICD9/10 liver disease–specific codes and subsequently confirmed via electronic medical chart review (N=1033).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001891"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3239</owl:annotatedTarget>
        <obo:IAO_0000116>chronic liver disease cases confirmed by chart review, and liver disease-free controls, of the Indiana Biobank</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11093576/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In total, 3239 IB participants were identified as liver disease–free controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001891"/>
