    <!-- http://www.ebi.ac.uk/coho/COHO_0002341 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002341">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
