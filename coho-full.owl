    <!-- http://www.ebi.ac.uk/coho/COHO_0001926 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001926">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16995"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>PMID:38809556</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of the INTERGENE research programme, set up to study the interplay between genetic and environmental risk factors for chronic disease, in which a random sample of adults aged 24 to 77 drawn from the population registers of an urban-rural area of western Sweden (Västra Götaland County, about half of them living in Gothenburg) was examined in 2001-2004 and re-examined in 2014-2016, with follow-up of health outcomes through linkage to the Swedish national registers.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3614</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>INTERGENE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>INTERGENE cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>INTERGENE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>INTERplay between GENEtic susceptibility and external factors</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Interplay Between Genetic Susceptibility and External Factors</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16995">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ExO_0000002"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001926"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16995"/>
        <obo:IAO_0000116>environmental risk factors for chronic disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11231701/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The INTERGENE research programme was initiated to study the INTERplay between GENEtic and environmental risk factors for chronic disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001926"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11231701/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A population-based cohort of 3614 adult individuals, aged 25 to 77, living in Västra Götaland County, Sweden, was examined in 2001–2004.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001926"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38809556</owl:annotatedTarget>
        <dcterms:title>Domain-Specific Physical Activity and Stroke in Sweden.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38809556</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38809556+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The prospective, population-based Interplay Between Genetic Susceptibility and External Factors (INTERGENE) cohort study was conducted among a random sample of individuals from an urban-rural area covering western Sweden; 3614 individuals aged 24 to 77 years were examined in 2001 to 2004, and 1394 individuals were reexamined in 2014 to 2016.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001926"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort of the INTERGENE research programme, set up to study the interplay between genetic and environmental risk factors for chronic disease, in which a random sample of adults aged 24 to 77 drawn from the population registers of an urban-rural area of western Sweden (Västra Götaland County, about half of them living in Gothenburg) was examined in 2001-2004 and re-examined in 2014-2016, with follow-up of health outcomes through linkage to the Swedish national registers.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38809556</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38983451</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41741164</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001926"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3614</owl:annotatedTarget>
        <obo:IAO_0000116>adults aged 24-77, from a random population-register sample of western Sweden, examined at baseline in 2001-2004</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12959171/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A random sample of 8626 adults aged 24–77 years was drawn from population registers, of whom 3614 (42%) accepted the invitation and underwent baseline clinical examination between 2001 and 2004.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001926"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>INTERGENE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


