        <obo:IAO_0000112>GCST90095033</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based birth cohort of the 5,914 live births in 1982 to families living in the urban area of Pelotas, a city in southern Brazil, followed through repeated interviews and a clinic visit at about age 30 covering mental health, body composition, precursors of chronic disease and human capital.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5914</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>1982 PELOTAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>1982 Pelotas (Brazil) birth cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>1982 Pelotas Birth Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>1982 Pelotas birth cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PELOTAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pelotas (Brazil) Birth Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pelotas 1982 birth cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pelotas Birth Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pelotas birth cohort study</oboInOwl:hasRelatedSynonym>
