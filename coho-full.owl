        <dcterms:title>Genome-wide association studies of survival in 1520 cancer patients treated with bevacizumab-containing regimens.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34528705</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8627468/unicode</oboInOwl:hasDbXref>
