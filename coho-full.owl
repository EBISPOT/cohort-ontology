    <!-- http://www.ebi.ac.uk/coho/COHO_0001261 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001261">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11406"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90013445</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal study of cardiovascular disease risk factors in young people in Northern Ireland, which screened a random sample of 12- and 15-year-olds from post-primary schools in 1989–1990, re-examined the younger group at age 15 in 1992–1993, and invited the whole sample back for examination as young adults in 1997–1999. A second school sample of 12- and 15-year-olds was surveyed in 1999–2001 as Young Hearts 2000.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1015</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Northern Ireland Young Hearts Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>YH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Hearts Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Hearts Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Hearts-NI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>yh3, yh2000</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Northern Ireland Young Hearts Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11406">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001261"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11406"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC524366/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Young Hearts Project (YH) is an ongoing longitudinal study evaluating the prevalence of CVD risk factors in young people living in Northern Ireland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001261"/>
