        <obo:IAO_0000112>PGS004865</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:34101481</obo:IAO_0000112>
        <obo:IAO_0000115>A series of population-based case–control studies of breast cancer run at the University of Wisconsin, whose cases are Wisconsin women with incident breast cancer reported to the statewide cancer registry and whose controls are women without breast cancer randomly selected from lists of licensed drivers and, for women aged 65 or over until 2003, of Medicare beneficiaries, all interviewed by telephone about reproductive history, family cancer history and lifestyle, to study lifestyle and genetic risk factors for breast cancer; it is the Wisconsin part of the Collaborative Breast Cancer Study, which recruited Wisconsin cases from 1988 to 2008.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16076</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16795</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>WWHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Wisconsin Womens Health Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Wisconsin women&apos;s health study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Wisconsin Women&apos;s Health Study</rdfs:label>
    </owl:NamedIndividual>
