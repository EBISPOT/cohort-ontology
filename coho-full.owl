    <!-- http://www.ebi.ac.uk/coho/COHO_0001770 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001770">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15811"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002612"/>
        <obo:IAO_0000112>PMID:18676988</obo:IAO_0000112>
        <obo:IAO_0000115>A Dutch population-based study of migraine embedded in the MORGEN project, in which adults aged 20 to 65 randomly selected from two Dutch county population registries (Maastricht and Doetinchem) to take part in a general health survey were screened for headache history, screen-positives were given a detailed headache questionnaire and a random subset a semistructured telephone clinical interview, and migraine was diagnosed by International Headache Society criteria, to study the prevalence, characteristics, cardiovascular risk profile and genetics of migraine.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym GEM also denotes Ginkgo Evaluation of Memory Study (COHO:0000682) and Genes in Myopia Study (COHO:0001806); this term is Genetic Epidemiology of Migraine Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6491</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GEM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GEM Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GEM study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Epidemiology of Migraine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Epidemiology of Migraine study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Genetic Epidemiology of Migraine Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15811">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005277"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001770"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15811"/>
        <obo:IAO_0000116>migraine</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2566523/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Leiden sample is a well-phenotyped population-based migraine cohort from the Genetic Epidemiology of Migraine (GEM) study from the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001770"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15728281+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Participants (n = 5,755, 48% men, age 20 to 65 years) are from the Genetic Epidemiology of Migraine (GEM) study, a population-based study in the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001770"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002612"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2566523/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The GEM cohort is embedded within the ‘MORGEN’ project—a population-based study designed to monitor risk factors for and the prevalence of chronic diseases of public health importance in Dutch adults 20-65 years of age.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001770"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:18676988</owl:annotatedTarget>
        <dcterms:title>A high-density association screen of 155 ion transport genes for involvement with common migraine.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:18676988</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2566523/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Leiden sample is a well-phenotyped population-based migraine cohort from the Genetic Epidemiology of Migraine (GEM) study from the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001770"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Dutch population-based study of migraine embedded in the MORGEN project, in which adults aged 20 to 65 randomly selected from two Dutch county population registries (Maastricht and Doetinchem) to take part in a general health survey were screened for headache history, screen-positives were given a detailed headache questionnaire and a random subset a semistructured telephone clinical interview, and migraine was diagnosed by International Headache Society criteria, to study the prevalence, characteristics, cardiovascular risk profile and genetics of migraine.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10449117</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18676988</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19025553</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001770"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6491</owl:annotatedTarget>
        <obo:IAO_0000116>adults aged 20 to 65 selected at random from two Dutch county population registries and taking part in the general health survey (1999)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:10449117</oboInOwl:hasDbXref>
        <rdfs:comment>The participants in the Genetic Epidemiology of Migraine Study were comprised of 6,491 adults, age 20 to 65 years, selected randomly from two county population registries in the Netherlands to participate in a general health survey (52.7% response).</rdfs:comment>
    </owl:Axiom>
