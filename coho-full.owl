    <!-- http://www.ebi.ac.uk/coho/COHO_0001175 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001175">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10683"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>GCST90244787</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based genetic study of atopic dermatitis run from Charité Universitätsmedizin Berlin, which recruited complete nuclear families, mostly German and a few Swedish, through at least two children with physician-diagnosed, moderate to severe atopic dermatitis that began before the age of two, and in its extended phase also unrelated children with such early-onset disease, recording asthma and hay fever at recruitment, for genetic studies of atopic dermatitis and allergic disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GENUFAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GENUFAD study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GEnetic studies in NUclear Families with Atopic Dermatitis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Analysis of Nuclear Families with Atopic Dermatitis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Studies in Nuclear Families with Atopic Dermatitis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">GEnetic analysis of NUclear Families with Atopic Dermatitis</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10683">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004980"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001175"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10683"/>
        <obo:IAO_0000116>atopic dermatitis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4355615/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GENUFAD study (Genetic Analysis of Nuclear Families with Atopic Dermatitis) recruited complete nuclear families with at least two children affected with early-onset (&lt;2 years of age) and moderate to severe AD as previously described [20].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001175"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4355615/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GENUFAD study contributed 522 complete German nuclear families to the Central European study and 32 Swedish families to the Northern European data set.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001175"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244787</owl:annotatedTarget>
        <dcterms:title>European and multi-ancestry genome-wide association meta-analysis of atopic dermatitis highlights importance of systemic immune regulation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37794016</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10550990/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Children of the extended GENUFAD study were unrelated individuals recruited based on moderate to severe atopic dermatitis and an age of onset below two years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001175"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family-based genetic study of atopic dermatitis run from Charité Universitätsmedizin Berlin, which recruited complete nuclear families, mostly German and a few Swedish, through at least two children with physician-diagnosed, moderate to severe atopic dermatitis that began before the age of two, and in its extended phase also unrelated children with such early-onset disease, recording asthma and hay fever at recruitment, for genetic studies of atopic dermatitis and allergic disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25757221</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29083406</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37794016</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001175"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GENUFAD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001176 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001176">
