    <!-- http://www.ebi.ac.uk/coho/COHO_0001442 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001442">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13064"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90707263</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing multicentre genetic study led by the University of Leicester, United Kingdom, with support from the NIHR Leicester Biomedical Research Centre, that recruits patients with bicuspid aortic valve disease, identified from clinic and discharge letters and confirmed by cardiac imaging, together with relatives of patients with a family history of the disease, who are offered cascade echocardiographic screening, and collects clinical questionnaire data and blood for DNA to study the genetic causes of bicuspid aortic valve disease.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym BRAVE also denotes Bangladesh Risk of Acute Vascular Events Study (COHO:0001546); this term is Bicuspid aoRtic vAlVe gEnetic research.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>BRAVE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BRAVE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BRAVE_study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of Leicester Bicuspid aoRtic vAlVe gEnetic research</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Bicuspid aoRtic vAlVe gEnetic research</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13064">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0001647"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001442"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13064"/>
        <obo:IAO_0000116>bicuspid aortic valve disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9240330/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The population of our study were participants of the University of Leicester Bicuspid aoRtic vAlVe gEnetic research (BRAVE)—an ongoing, multicentre recruitment of patients with BAV disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001442"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10153415/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The UK cohort comprised 697 BAV patients that were recruited by the University Hospitals of Leicester as well as 7190 controls that were part of the UK Biobank.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001442"/>
