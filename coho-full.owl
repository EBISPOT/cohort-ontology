    <!-- http://www.ebi.ac.uk/coho/COHO_0002041 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002041">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17808"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Mexico"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>PMID:21696813</obo:IAO_0000112>
        <obo:IAO_0000115>A case–parent trio study of childhood asthma in Mexico City, supported by the Intramural Research Program of the US National Institute of Environmental Health Sciences, which recruited children aged 5 to 17 with asthma, diagnosed by a paediatric allergist from clinical symptoms and response to treatment, together with their biological parents, between June 1998 and November 2003 at the paediatric allergy clinic of the Hospital Infantil de México Federico Gómez, a large public hospital in central Mexico City; parents completed questionnaires on the children&apos;s asthma symptoms and risk factors, including environmental tobacco smoke, the children had skin prick tests and lung function tests, and blood was taken from children and parents for DNA, from which the trios were genotyped genome-wide.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1468</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MCAAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MCAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MCCAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mexico Childhood Asthma Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Mexico City Childhood Asthma Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17808">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002041"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17808"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2722731/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Children with asthma (aged 5–17) and their biological parents were recruited between June 1998 and November 2003 from a pediatric allergy specialty clinic at a large public hospital in central Mexico City, Hospital Infantil de Mexico Frederico Gomez.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002041"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
