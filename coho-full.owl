    <!-- http://www.ebi.ac.uk/coho/COHO_0001922 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001922">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid16954"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000030"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001056"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001087"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002212"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS012586</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:27749845</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium of research groups leading epidemiological studies of head and neck cancer, mostly case–control studies in North and South America, Europe and Asia, which pools their individual-level data in a common database to share comparable data, study rare subgroups such as never smokers and coordinate laboratory analyses of the causes of head and neck cancer, including genome-wide association studies of cancers of the upper aerodigestive tract.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25865</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">37248</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">63113</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>INHANCE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>INHANCE Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">International Head and Neck Cancer Epidemiology Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16954">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005627"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001922"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16954"/>
        <obo:IAO_0000116>head and neck cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16023150+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Consortia have been initiated for head and neck cancer (International Head and Neck Cancer Epidemiology Consortium (INHANCE)) and lung cancer (International Lung Cancer Consortium (ILCCO)) with the aim to share comparable data, to focus on rare subgroups such as nonsmokers and to coordinate laboratory analyses.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001922"/>
