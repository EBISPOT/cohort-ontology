    <!-- http://www.ebi.ac.uk/coho/COHO_0001224 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001224">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11126"/>
        <rdf:type rdf:nodeID="genid11128"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>GCST90726344</obo:IAO_0000112>
        <obo:IAO_0000115>A Swedish study that between 2013 and 2017 recruited adults who had received electroconvulsive therapy (ECT) recorded in the Swedish National Quality Register for ECT, inviting registered patients by letter to a telephone interview and blood sampling and recruiting others at Swedish psychiatric hospitals before an ECT series, and that links their DNA, stored at the Karolinska Institutet Biobank, to the register&apos;s data on each treatment series, to study predictors of ECT outcome, including genetic ones, and the genetics of severe depressive episodes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2880</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PREFECT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PREFECT study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Predictors for ECT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Predictors For ECT</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11126">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0000716"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid11128">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002009"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001224"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11126"/>
        <obo:IAO_0000116>major depressive episode</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33483693+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we test the utility of targeting the severe end of the MDD spectrum through genome-wide SNP genotyping of 2725 cases who received electroconvulsive therapy (ECT) for a major depressive episode (MDE) and 4035 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001224"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11128"/>
        <obo:IAO_0000116>major depressive disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33483693+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we test the utility of targeting the severe end of the MDD spectrum through genome-wide SNP genotyping of 2725 cases who received electroconvulsive therapy (ECT) for a major depressive episode (MDE) and 4035 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001224"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12695632/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Cohort and country: iPSYCH2012, iPSYCH2015 - Denmark; MoBa - Norway; PREFECT, STAGE - Sweden; FinnGen - Finland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001224"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90726344</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analyses identify distinct genetic architectures for early-onset and late-onset depression.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41233554</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12695632/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The PREFECT sample constituted N=1,796 cases who had a clinical diagnosis of MDD and were treated for a major depressive episode with electroconvulsive therapy (ECT)6 .</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001224"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Swedish study that between 2013 and 2017 recruited adults who had received electroconvulsive therapy (ECT) recorded in the Swedish National Quality Register for ECT, inviting registered patients by letter to a telephone interview and blood sampling and recruiting others at Swedish psychiatric hospitals before an ECT series, and that links their DNA, stored at the Karolinska Institutet Biobank, to the register&apos;s data on each treatment series, to study predictors of ECT outcome, including genetic ones, and the genetics of severe depressive episodes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33483693</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36069021</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001224"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2880</owl:annotatedTarget>
        <obo:IAO_0000116>participants who provided DNA and had an ECT series for a major depressive episode (subset by indication), 2017</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC10113810/</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 2,880 participants provided DNA and had received at least one acute ECT treatment series for a major depressive episode.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001224"/>
