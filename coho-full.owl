    <!-- http://www.ebi.ac.uk/coho/COHO_0000811 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000811">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>GCST90566696</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium founded in 2011 of medical researchers and social scientists that coordinates genome-wide association studies of social-science outcomes such as educational attainment across more than 100 contributing cohorts and promotes harmonised phenotype measurement.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3037499</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SSGAC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
