        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5972779/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>EPIC-CVD is a multi centre case-cohort study nested within the EPIC cohort designed to investigate the determinants of cardiovascular disease (CVD).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001004"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9156"/>
        <obo:IAO_0000116>alcohol consumption</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5972779/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We harmonised exposure data across participating countries on alcohol consumption, smoking status, and other lifestyle characteristics, and studied validated CVD outcomes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001004"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
