        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Gene-Environment-Development Initiative</rdfs:label>
    </owl:NamedIndividual>
