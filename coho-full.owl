        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7937973/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The United States samples in the EURO dataset originated from the 3D Facial Norms cohort (3DFN) and studies at the Pennsylvania State University (PSU) and Indiana University-Purdue University Indianapolis (IUPUI).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001360"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90454200</owl:annotatedTarget>
        <dcterms:title>Syndrome-informed phenotyping identifies a polygenic background for achondroplasia-like facial variation in the general population.</dcterms:title>
