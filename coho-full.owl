        <obo:IAO_0000115>A French couple-child cohort of pregnant women, their partners and their children, recruited between July 2014 and July 2017 at eight obstetric ultrasonography practices in the Grenoble area, set up by Inserm, CNRS and University Grenoble Alpes as a research platform with repeated personal exposure measurements and biological sampling during pregnancy and early life, to study the effects of air pollutants, non-persistent endocrine disruptors and other exposures on child growth, respiratory health and neurodevelopment and the biological pathways involved.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">484</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/Sepages</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>Assessment of air pollution exposure during pregnancy and effect on health</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SEPAGES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SEPAGES cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SEPAGES couple-child cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SEPAGES mother-child cohort</oboInOwl:hasRelatedSynonym>
