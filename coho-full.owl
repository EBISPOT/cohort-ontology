    <!-- http://www.ebi.ac.uk/coho/COHO_0001456 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001456">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid13180"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001419"/>
        <obo:IAO_0000112>PMID:29273806</obo:IAO_0000112>
        <obo:IAO_0000115>An Australian research consortium, supported by the National Health and Medical Research Council, that pooled genotyped physician-diagnosed asthma cases and controls of European ancestry from several Australian studies, among them studies of the Queensland Institute of Medical Research, the Lung Institute of Western Australia, the Busselton Health Study and the Tasmanian Longitudinal Health Study, into a genome-wide association study of asthma first reported in 2011. Its data have since been used in international meta-analyses of asthma and allergic disease.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2669</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4528</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7197</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AAGC</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Australian Asthma Genetics Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13180">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001456"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13180"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21907864+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We did a genome-wide association study (GWAS) in 2669 physician-diagnosed asthmatics and 4528 controls from Australia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001456"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>Australian Asthma Genetics Consortium (AAGC) Australian Asthma Genetics Consortium AAGC European Australia Population-based and case-control studies</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001456"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29273806</owl:annotatedTarget>
        <dcterms:title>Multiancestry association study identifies new asthma risk loci that colocalize with immune-cell enhancer marks.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29273806</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>Australian Asthma Genetics Consortium (AAGC) Australian Asthma Genetics Consortium AAGC European Australia Population-based and case-control studies</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001456"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An Australian research consortium, supported by the National Health and Medical Research Council, that pooled genotyped physician-diagnosed asthma cases and controls of European ancestry from several Australian studies, among them studies of the Queensland Institute of Medical Research, the Lung Institute of Western Australia, the Busselton Health Study and the Tasmanian Longitudinal Health Study, into a genome-wide association study of asthma first reported in 2011. Its data have since been used in international meta-analyses of asthma and allergic disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21907864</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24388013</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29273806</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001456"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2669</owl:annotatedTarget>
        <obo:IAO_0000116>individuals in the 2011 Australian asthma GWAS (cases and controls)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3517659/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Australian GWAS included data from 7,197 individuals of whom 5,523 (77%) were genotyped with Illumina 610K (Illumina, San Diego, CA, USA) array 1,674 (23%) with Illumina 370K array as part of four genotyping projects that are summarised in the webappendix (pp 11): the AAGC (n=1,810), QIMR_610K (n=2,483), QIMR_370K (n=1,674) and Busselton (n=1,230) projects.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
