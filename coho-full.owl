    <!-- http://www.ebi.ac.uk/coho/COHO_0002405 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002405">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. &apos;SPORE&apos; is the PGS Catalog&apos;s id for prostate cancer cases drawn from the Pathology Core (tissue/biospecimen resource) of Northwestern University&apos;s Prostate Cancer Specialized Program of Research Excellence, an NCI-funded research programme, not a study. The Catalog&apos;s full name is the wording deCODE uses for its US (Chicago) replication sample (PMID:26740556: cases recruited from the Pathology Core May 2002 to May 2010, controls from University of Chicago and Northwestern genetic studies), which has no study name of its own. The Catalog links the id to no score. No COHO term matches (COHO:0000790 NUgene is Northwestern&apos;s biobank, a different resource; the review decided &apos;Chicago&apos; as an institution label). Same reasoning as the review&apos;s decisions for Chicago, UPENN and MSKCC: recommend obsoleting placeholder COHO:0002405. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Northwestern Universitys Prostate Cancer Specialized Program of Research Excellence</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


