    <!-- http://www.ebi.ac.uk/coho/COHO_0002573 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002573">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. WICR is the PGS Catalog&apos;s id for the Westmead Institute for Cancer Research, a research institute of the University of Sydney at Westmead (Sydney, Australia). The Catalog records no score or sample set for it, no GWAS Catalog study uses it, and in the literature &apos;WICR&apos; labels the institute itself: an author affiliation in breast and ovarian cancer genetics papers, and the code of the Sydney/Westmead melanoma-family group in GenoMEL (PMID:18394881). No study or collection is named after it, so it denotes an institution, not a cohort. Samples from Westmead enter named cohorts that COHO already has, such as the Australian Ovarian Cancer Study (COHO:0000014), the Australian Melanoma Family Study (COHO:0001277) and GenoMEL (COHO:0001335), but no source ties the id WICR to any one of them. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Westmead Institute for Cancer Research</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002574 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002574">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21687"/>
        <rdf:type rdf:nodeID="genid21689"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
