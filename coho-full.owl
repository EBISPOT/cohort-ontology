    <!-- http://www.ebi.ac.uk/coho/COHO_0001093 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001093">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10022"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
        <obo:IAO_0000112>GCST90104709</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of women recruited in 2011–2013 when attending mammography screening or clinical mammography at four hospitals in Sweden (in Stockholm, Helsingborg, Lund and Landskrona), with questionnaires, mammograms, blood samples and linkage to Swedish health registers, established to determine how mammographic density, genetic factors and lifestyle influence breast cancer risk and to build risk prediction models for individualised prevention and screening.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">70877</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>KARMA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KARMA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KARolinska MAmmography Project for Risk Prediction of Breast Cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Karolinska Mammography Project for Risk Prediction of Breast Cancer – Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Karolinska Mammography Project for Risk Prediction of Breast Cancer</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10022">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001093"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10022"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837703/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The KARMA study aims to study and determine the roles and interactions of mammographic density, genetic determinants and lifestyle in the risk of breast cancer to build a comprehensive risk prediction model including all known and established risk factors for breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001093"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8909613/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the KARMA Cohort consists of 70,877 women performing a screening or clinical mammogram at 4 hospitals in Sweden during the period October 2010–March 2013 [20].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001093"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90104709</owl:annotatedTarget>
        <dcterms:title>A Swedish Genome-Wide Haplotype Association Analysis Identifies a Novel Breast Cancer Susceptibility Locus in 8p21.2 and Characterizes Three Loci on Chromosomes 10, 11 and 16.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35267517</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8909613/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the KARMA Cohort consists of 70,877 women performing a screening or clinical mammogram at 4 hospitals in Sweden during the period October 2010–March 2013 [20].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001093"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of women recruited in 2011–2013 when attending mammography screening or clinical mammography at four hospitals in Sweden (in Stockholm, Helsingborg, Lund and Landskrona), with questionnaires, mammograms, blood samples and linkage to Swedish health registers, established to determine how mammographic density, genetic factors and lifestyle influence breast cancer risk and to build risk prediction models for individualised prevention and screening.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28180256</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001093"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">70877</owl:annotatedTarget>
        <obo:IAO_0000116>women recruited 2011-2013</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837703/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>During the recruitment period, a total of 210 233 women were invited to participate in the KARMA study and 70 877 women (34%) joined the study (Figure 2).</rdfs:comment>
    </owl:Axiom>
