        <rdfs:comment>The dietary antioxidant capacity was estimated based on the oxygen radical absorbance capacity (ORAC) incorporated with a semiquantitative food frequency questionnaire.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001363"/>
