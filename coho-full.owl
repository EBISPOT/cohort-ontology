        <rdfs:comment>The MHIBB is a cardiology hospital cohort in which there is obvious enrichment of CV diseases.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000615"/>
