        <rdfs:comment>A.J.O. has received research funding from the Netherlands Organisation for Scientific Research and the Biobanking and Biomolecular Resources Research Infrastructure to support the TRAILS cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000524"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Dutch prospective cohort study, run in the North of the Netherlands, consisting of a population cohort of 2,230 children born between October 1989 and September 1991 and a clinical cohort of 543 children referred to child psychiatric outpatient care before age 11, followed from about age 11 into young adulthood with repeated assessments of mental health, social development and physical health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25431468</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
