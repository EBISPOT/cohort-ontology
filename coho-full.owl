        <oboInOwl:hasRelatedSynonym>Data from an Epidemiological Study on the Insulin Resistance syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Data from an Epidemiological Study on the Insulin Resistance syndrome study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Data from the Epidemiological Study on the Insulin Resistance Syndrome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Data of an Epidemiological Study on the Insulin Resistance syndrome study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Epidemiological Study on the Insulin Resistance syndrome study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
