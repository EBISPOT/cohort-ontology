    <!-- http://www.ebi.ac.uk/coho/COHO_0001632 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001632">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14712"/>
        <rdf:type rdf:nodeID="genid14714"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Hong_Kong"/>
        <obo:IAO_0000112>PMID:9406673</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based cohort of Hong Kong Chinese adults aged 25–74, recruited in 1995–1996 through randomly generated telephone numbers from the general population of Hong Kong for a baseline survey of the prevalence of cardiovascular risk factors (CRISPS-1), with a comprehensive assessment including a 75-g oral glucose tolerance test, and re-examined with similar protocols in 2000–2004, 2005–2008, 2010–2012 and 2016–2018 (CRISPS-2 to CRISPS-5) to study the development of cardiovascular risk factors such as diabetes and hypertension.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2895</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CRISPS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Hong Kong Cardiovascular Risk Factor Prevalence Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14712">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005010"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid14714">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005015"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001632"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14712"/>
        <obo:IAO_0000116>coronary heart disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9637304/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>CRISPS is a prospective, population-based longitudinal cohort designed to study the development of cardiovascular risk factors, including diabetes, in Hong Kong from 1995 to 2018.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001632"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14714"/>
        <obo:IAO_0000116>diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9637304/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>CRISPS is a prospective, population-based longitudinal cohort designed to study the development of cardiovascular risk factors, including diabetes, in Hong Kong from 1995 to 2018.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001632"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:9406673</owl:annotatedTarget>
        <dcterms:title>Epidemiology of cardiovascular risk factors in Hong Kong.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:9406673</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9406673+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To facilitate the development of appropriate population-wide coronary heart disease prevention strategies and to monitor their long-term impact, a comprehensive baseline Hong Kong Cardiovascular Risk Factor Prevalence Study was conducted in 1995-96.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001632"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of Hong Kong Chinese adults aged 25–74, recruited in 1995–1996 through randomly generated telephone numbers from the general population of Hong Kong for a baseline survey of the prevalence of cardiovascular risk factors (CRISPS-1), with a comprehensive assessment including a 75-g oral glucose tolerance test, and re-examined with similar protocols in 2000–2004, 2005–2008, 2010–2012 and 2016–2018 (CRISPS-2 to CRISPS-5) to study the development of cardiovascular risk factors such as diabetes and hypertension.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36335348</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38030128</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41662368</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9406673</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001632"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2895</owl:annotatedTarget>
        <obo:IAO_0000116>adults recruited at baseline (CRISPS-1), 1995-1996</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:36335348</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, in 1995–1996 (CRISPS-1), 2895 Hong Kong Chinese, aged 25–74, were randomly recruited from the general population of Hong Kong to undergo a comprehensive assessment.</rdfs:comment>
    </owl:Axiom>
