        <owl:annotatedTarget>PMID:42488319</owl:annotatedTarget>
        <dcterms:title>Application of competing risks models in cardiovascular mortality research: findings from the Tehran lipid and glucose study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42488319</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42488319+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This study aimed to provide more accurate estimates of associations between risk factors and CVD mortality by applying competing risk models within the Tehran Lipid and Glucose Study cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002460"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based prospective study of a representative sample of residents of district 13 of Tehran, Iran, aged 3 years and over and selected by multistage stratified cluster random sampling, designed in 1997 and begun in 1999 as a cross-sectional survey of non-communicable disease risk factors; from 2002 it became a long-term longitudinal study, including a controlled community lifestyle intervention, with follow-up examinations about every three years.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19166627</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30584442</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
