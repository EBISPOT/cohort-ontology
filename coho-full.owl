        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001316"/>
        <obo:IAO_0000112>PMID:40101186</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of endometrial cancer at the Leuven University Hospital in Belgium, whose cases were white women aged 27–80 diagnosed with endometrial cancer, identified by active surveillance of the hospital&apos;s electronic patient files, with clinical data recorded at interview at diagnosis and from pathology reports. In genetic analyses its cases were compared with controls from blood donors of the Leuven Multidisciplinary Breast Centre study, and they were genotyped in the genome-wide association studies of the Endometrial Cancer Association Consortium.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">528</coho:numberOfCases>
        <oboInOwl:hasRelatedSynonym>LES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leuven Endometrial Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leuven Endometrium Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Leuven Endometrial Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17504">
