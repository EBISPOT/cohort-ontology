    <!-- http://www.ebi.ac.uk/coho/COHO_0001124 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001124">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10281"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>GCST90104466</obo:IAO_0000112>
        <obo:IAO_0000115>A two-generation, family-based study in the Saguenay–Lac-Saint-Jean region of Quebec, Canada, a genetic founder population, of adolescent sibships aged 12–18 of French-Canadian origin recruited through high schools in 2003–2012, half of them exposed prenatally to maternal cigarette smoking and matched with non-exposed adolescents for maternal education and school, and of their parents (partly assessed in 2003–2012 and fully in 2012–2015), with extensive phenotyping including brain and abdominal MRI, cardiometabolic assessments and genome-wide genotyping, to investigate the aetiology, early stages and trans-generational trajectories of common cardiometabolic and brain diseases.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SYS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Saguenay Youth Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10281">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_with_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0300003"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001124"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10281"/>
        <obo:IAO_0000116>prenatal exposure to maternal cigarette smoking</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17469173+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The SYS is a retrospective study of long-term consequences of prenatal exposure to maternal cigarette smoking (PEMCS) in which multiple quantitative phenotypes are acquired over five sessions (telephone interview, home, hospital, laboratory, and school).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001124"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:27018016%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The cohort was recruited from the genetic founder population of the Saguenay Lac St Jean region of Quebec, Canada.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001124"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90104466</owl:annotatedTarget>
        <dcterms:title>Genome-wide analyses of individual differences in quantitatively assessed reading- and language-related skills in up to 34,000 people.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35998220</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9436320/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Saguenay Youth Study is supported by the CIHR, the Heart and Stroke Foundation of Quebec, and the Canadian Foundation for Innovation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001124"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A two-generation, family-based study in the Saguenay–Lac-Saint-Jean region of Quebec, Canada, a genetic founder population, of adolescent sibships aged 12–18 of French-Canadian origin recruited through high schools in 2003–2012, half of them exposed prenatally to maternal cigarette smoking and matched with non-exposed adolescents for maternal education and school, and of their parents (partly assessed in 2003–2012 and fully in 2012–2015), with extensive phenotyping including brain and abdominal MRI, cardiometabolic assessments and genome-wide genotyping, to investigate the aetiology, early stages and trans-generational trajectories of common cardiometabolic and brain diseases.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17469173</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27018016</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001124"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SYS</owl:annotatedTarget>
