        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002153"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. The Norfolk Island Cohort is what the Norfolk Island Health Study&apos;s papers call its sample (PMID:26628212, PMID:37886940). Replaced by COHO:0002153 (Norfolk Island Health Study), which now carries this term&apos;s names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Norfolk Island Cohort</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


