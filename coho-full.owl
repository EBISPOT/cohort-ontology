    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001681"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">540</owl:annotatedTarget>
        <obo:IAO_0000116>EEBCS bladder-cancer cases and shared hospital controls in the own ASHRAM design report</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://doi.org/10.1007/s00420-010-0519-1</oboInOwl:hasDbXref>
        <rdfs:comment>The study comprised 1,392 participants of whom 852 were cancer cases (529 basal cell carcinoma of skin, BCC; 214 bladder; 109 kidney) and 540 were controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001681"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EEBCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001682 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001682">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001497"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. The Eastern Europe study population is the heading deCODE genetics&apos; papers give the samples of the ASHRAM case-control study (PMID:18794855, PMID:20348956, PMID:19151717). The heading is a description, not a name, and is not carried over. Replaced by COHO:0001497 (Arsenic Health Risk Assessment and Molecular Epidemiology), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete The Eastern Europe Study Population</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


