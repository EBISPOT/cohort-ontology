        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST009965</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, randomised, placebo-controlled smoking-cessation trial (NCT01314001) run from 2010 to 2014 at four academic medical centres in the United States and Canada, in which 1246 treatment-seeking smokers stratified by nicotine metabolite ratio were assigned to placebo, nicotine patch or varenicline.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1246</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PNAT-2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PNAT2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pharmacogenetics of Nicotine Addiction Treatment (PNAT)-2 clinical trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pharmacogenetics of Nicotine Addiction and Treatment clinical trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Pharmacogenetics of Nicotine Addiction Treatment</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid7698">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_with_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000038"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid7700">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008575"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7698"/>
        <obo:IAO_0000116>cigarette smoking, at least 10 cigarettes per day</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-020-0702-z/MediaObjects/41380_2020_702_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>PNAT2 participants were eligible adult smokers (report smoking at least 10 CPD) from four clinical sites in North America and were randomized to placebo, nicotine patch, or varenicline based on their NMR at intake.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7700"/>
        <obo:IAO_0000116>tobacco dependence</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25588294+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Smokers seeking treatment were randomly assigned by baseline NMR status and study site, in blocks of 12 patients (1:1:1 ratio), to 11 weeks of placebo (placebo pill plus placebo patch), nicotine patch (active patch plus placebo pill), or varenicline (active pill plus placebo patch), plus behavioural counselling.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4480925/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted the clinical trial at four academic medical centers (University of Pennsylvania (UPenn), Centre for Addiction and Mental Health/University of Toronto, State University of New York at Buffalo, and MD Anderson Cancer Center); assessment of the NMR was performed at the University of Toronto.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000844"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST009965</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of nicotine metabolism and cigarette consumption measures in smokers of European descent.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32157176</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7483250/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In support of this, a secondary analysis in PNAT2 showed no apparent impact of the rs56113850 T allele on increasing (COT+3HC)/CPD (Figure S13).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000844"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre, randomised, placebo-controlled smoking-cessation trial (NCT01314001) run from 2010 to 2014 at four academic medical centres in the United States and Canada, in which 1246 treatment-seeking smokers stratified by nicotine metabolite ratio were assigned to placebo, nicotine patch or varenicline.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25588294</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1246</owl:annotatedTarget>
        <obo:IAO_0000116>treatment-seeking smokers enrolled and randomised</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:25588294</oboInOwl:hasDbXref>
        <rdfs:comment>1246 participants (662 slow metabolisers of nicotine, 584 normal metabolisers of nicotine) were enrolled and randomly assigned to the three interventions (408 placebo, 418 nicotine patch, 420 varenicline).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PNAT-2</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000844"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PNAT2</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000845 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000845">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid7708"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <obo:IAO_0000112>GCST90446466</obo:IAO_0000112>
        <obo:IAO_0000115>A Spanish case-control study of venous thromboembolism, based at the Hospital de la Santa Creu i Sant Pau in Barcelona, whose cases had a first venous thromboembolism and were sampled after 6–12 months of anticoagulant treatment, with healthy controls recruited from the general population, used to study genetic and plasma determinants of venous thromboembolism.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">398</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">398</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>RETROVE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RETROVE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Riesgo de Enfermedad Tromboembolica Venosa</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Riesgo de Enfermedad TROmboembólica VEnosa</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid7708">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005399"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000845"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7708"/>
        <obo:IAO_0000116>venous thromboembolism</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10247781/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Riesgo de Enfermedad TROmboembólica VEnosa (RETROVE) study is a prospective case–control study of 400 consecutive patients with VTE (cancer associated thrombosis excluded) and 400 healthy control volunteers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000845"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10247781/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>the Spanish Riesgo de Enfermedad TROmboembólica VEnosa (RETROVE) study (n = 668) of patients sampled post anticoagulant treatment (n = 308), with population based controls (n = 360)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000845"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90446466</owl:annotatedTarget>
        <dcterms:title>Genome-Wide Search for Nonadditive Allele Effects Identifies &lt;i&gt;PSKH2&lt;/i&gt; as Involved in the Variability of Factor V Activity.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39424413</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39424413+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>QUICKTEST was applied to 4 independent genome-wide association studies studies (LURIC [Ludwigshafen RIsk and Cardiovascular Health Study], MARTHA [Marseille Thrombosis Association], MEGA [Multiple Environmental and Genetic Assessment], and RETROVE [Riesgo de Enfermedad Tromboembolica Venosa]) totaling 4505 participants of European ancestry with measured FV plasma levels.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000845"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Spanish case-control study of venous thromboembolism, based at the Hospital de la Santa Creu i Sant Pau in Barcelona, whose cases had a first venous thromboembolism and were sampled after 6–12 months of anticoagulant treatment, with healthy controls recruited from the general population, used to study genetic and plasma determinants of venous thromboembolism.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10247781/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000845"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">398</owl:annotatedTarget>
        <obo:IAO_0000116>patients with VT and controls in the RETROVE study sample</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11935730/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>They include the LURIC (Ludwigshafen Risk and Cardiovascular Health) study, 27 composed of 1833 individuals among whom 100 reported venous thrombosis (VT); a subsample of 1011 participants from the MARTHA (Marseille Thrombosis Association) study, 28 which consists of 1 592 patients with VT; a subsample of 865 participants from the MEGA (Multiple Environmental and Genetic Assessment) study, 29 comprising 1289 patients with VT; and the RETROVE (Riesgo de Enfermedad Tromboembolica Venosa) 30 study, which included a sample of 398 patients with VT and 398 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000845"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">398</owl:annotatedTarget>
        <obo:IAO_0000116>patients with VT and controls in the RETROVE study sample</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11935730/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>They include the LURIC (Ludwigshafen Risk and Cardiovascular Health) study, 27 composed of 1833 individuals among whom 100 reported venous thrombosis (VT); a subsample of 1011 participants from the MARTHA (Marseille Thrombosis Association) study, 28 which consists of 1 592 patients with VT; a subsample of 865 participants from the MEGA (Multiple Environmental and Genetic Assessment) study, 29 comprising 1289 patients with VT; and the RETROVE (Riesgo de Enfermedad Tromboembolica Venosa) 30 study, which included a sample of 398 patients with VT and 398 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000845"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RETROVE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000846 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000846">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid7716"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>GCST90572747</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre prospective cohort of 646 patients with a first unprovoked major venous thromboembolism, enrolled from 12 tertiary care centres in 4 countries while on oral anticoagulation 5–7 months after the event and followed after stopping anticoagulation (to September 2006), to derive a clinical decision rule identifying patients at low risk of recurrent venous thromboembolism.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">665</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>REVERSE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REVERSE I</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REVERSE I study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REVERSE cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REVERSE-I</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Recurrent Venous Thromboembolism Risk Stratification Evaluation</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid7716">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005399"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000846"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7716"/>
        <obo:IAO_0000116>unprovoked venous thromboembolism</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18725614+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In a multicentre prospective cohort study, 646 participants with a first, unprovoked major venous thromboembolism were enrolled over a 4-year period.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000846"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>REVERSE-I is a Canadian multicentric prospective study which enrolled 646 patients between 2001 and 2006 after their first episode of VTE.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000846"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90572747</owl:annotatedTarget>
        <dcterms:title>Molecular determinants of thrombosis recurrence risk across venous thromboembolism subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40811855</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.medrxiv.org/content/early/2024/12/03/2024.12.02.24317788.source.xml</oboInOwl:hasDbXref>
        <rdfs:comment>The recurrent VT GWAS meta-analysis included eight studies with confirmed unrelated VT cases of European ancestry free of cancer history: EDITH, FHS, HVH (HVH1 and HVH23), MARTHA, MEGA, PADIS-PE and REVERSE-I (Supplementary Material).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000846"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre prospective cohort of 646 patients with a first unprovoked major venous thromboembolism, enrolled from 12 tertiary care centres in 4 countries while on oral anticoagulation 5–7 months after the event and followed after stopping anticoagulation (to September 2006), to derive a clinical decision rule identifying patients at low risk of recurrent venous thromboembolism.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18725614</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000846"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">665</owl:annotatedTarget>
        <obo:IAO_0000116>participants enrolled October 2001 to March 2006</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2518177/</oboInOwl:hasDbXref>
        <rdfs:comment>Between October 2001 and March 2006, we enrolled 665 participants.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000846"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>REVERSE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000846"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>REVERSE I</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000846"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>REVERSE-I</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
