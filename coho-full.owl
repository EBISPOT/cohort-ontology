        <rdfs:comment>The Oxford Abdominal Aortic Aneurysm Study (OxAAA) prospectively recruited AAA patients undergoing the routine NHS management pathway.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002223"/>
