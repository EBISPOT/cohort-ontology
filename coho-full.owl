        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000731"/>
        <obo:IAO_0000112>GCST90455659</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium of research groups that collect DNA and clinical data from carriers of BRCA1 and BRCA2 mutations, established to identify genetic modifiers of breast and ovarian cancer risk in mutation carriers; it began with about 30 affiliated groups and later brought together more than 60 studies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32613</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CIMBA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Consortium of Investigators of Modifiers of BRCA1/2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Consortium of Investigators of Modifiers of BRCA1/BRCA2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Consortium of Investigators of Modifiers of BRCA1 and BRCA2</rdfs:label>
    </owl:NamedIndividual>
