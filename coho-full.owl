        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1254</owl:annotatedTarget>
        <obo:IAO_0000116>CAD cases from the registry&apos;s angiography sample (Angio-Lueb) in the CARDIoGRAMplusC4D stage 2 analysis; controls are KORA F3</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Angio-Lueb /KORAF3 CAD 2658 1655/1003 1254/1404</rdfs:comment>
    </owl:Axiom>
