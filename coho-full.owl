    <!-- http://www.ebi.ac.uk/coho/COHO_0002487 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002487">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21107"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS000022</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:29540798</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional collection of serum and genomic DNA from people with type 1 diabetes, their first- and second-degree relatives, islet autoantibody-positive at-risk individuals and unaffected controls, recruited from the general population and from outpatient clinics at the University of Florida in Gainesville, Nemours Children&apos;s Hospital in Orlando and Emory University in Atlanta, United States, and banked by the University of Florida Diabetes Institute for studies of type 1 diabetes genetic risk and biomarkers.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>UFDI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UFDI Study Bank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UFDI cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of Florida Diabetes Institute</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of Florida Diabetes Institute cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">University of Florida Diabetes Institute Study Bank</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21107">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005147"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002487"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21107"/>
        <obo:IAO_0000116>type 1 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5852207/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We determined the capacity for a combined genetic risk score (GRS) to discriminate disease-risk subgroups in a racially and ethnically diverse cohort from the southeastern U.S. including 637 T1D patients, 46 at-risk relatives having two or more T1D-related autoantibodies (≥2AAb+), 790 first-degree relatives (≤1AAb+), 68 second-degree relatives (≤1 AAb+), and 405 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002487"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5852207/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Informed consent was obtained from subjects enrolled from outpatient clinics of the University of Florida, Gainesville, Florida; Nemours Children’s Hospital, Orlando, Florida; and Emory University, Atlanta, Georgia, under Institutional Review Board (IRB)-approval at each facility (IRB #201400709).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002487"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000022</owl:annotatedTarget>
        <dcterms:title>Application of a Genetic Risk Score to Racially Diverse Type 1 Diabetes Populations Demonstrates the Need for Diversity in Risk-Modeling.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29540798</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002487"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29540798</owl:annotatedTarget>
        <dcterms:title>Application of a Genetic Risk Score to Racially Diverse Type 1 Diabetes Populations Demonstrates the Need for Diversity in Risk-Modeling.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29540798</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5852207/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Genomic DNA and serum samples were collected and stored at −20 °C from 1,946 research participants together termed the University of Florida Diabetes Institute (UFDI) cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002487"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional collection of serum and genomic DNA from people with type 1 diabetes, their first- and second-degree relatives, islet autoantibody-positive at-risk individuals and unaffected controls, recruited from the general population and from outpatient clinics at the University of Florida in Gainesville, Nemours Children&apos;s Hospital in Orlando and Emory University in Atlanta, United States, and banked by the University of Florida Diabetes Institute for studies of type 1 diabetes genetic risk and biomarkers.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29540798</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39755561</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
