    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002165"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of lung cancer run by Radboud University Medical Centre in Nijmegen, the Netherlands, to study gene-environment interactions. Its cases are patients diagnosed with lung cancer since 1989 at Radboud university medical center, Canisius Wilhelmina Hospital in Nijmegen or Rijnstate Hospital in Arnhem, identified through the cancer registry of the Netherlands Comprehensive Cancer Organisation, together with lung cancer cases found among participants of POLYGENE, the Nijmegen Biomedical Study and a Radboudumc urology outpatient study; its cancer-free controls are drawn from the Nijmegen Biomedical Study, a random sample of the general population of Nijmegen.</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002165"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">552</owl:annotatedTarget>
        <obo:IAO_0000116>expanded Nijmegen lung cancer case series, before selecting the OncoArray subset</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>This case series was expanded with 94 patients to a total of 552 by linking three other studies to the population-based cancer registry in order to identify new occurrences of lung cancer among the participants of these other studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002165"/>
