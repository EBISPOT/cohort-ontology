        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of breast cancer at Hannover Medical School, Germany, whose cases are women who received radiotherapy for breast cancer there between 1995 and 2003 and whose controls are female blood donors at the same school, collected in 2005.</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature24284/MediaObjects/41586_2017_BFnature24284_MOESM1_ESM.pdf</obo:IAO_0000119>
