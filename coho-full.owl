    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002290"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19561"/>
        <obo:IAO_0000116>idiopathic Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4893359/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were recruited from neurology clinics of university and regional hospitals in the western part of The Netherlands and all fulfilled the United Kingdom Parkinson’s disease Society Brain Bank criteria for idiopathic PD</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002290"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4893359/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were recruited from neurology clinics of university and regional hospitals in the western part of The Netherlands and all fulfilled the United Kingdom Parkinson’s disease Society Brain Bank criteria for idiopathic PD</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002290"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000777</owl:annotatedTarget>
        <dcterms:title>Genome-wide survival study identifies a novel synaptic locus and polygenic score for cognitive progression in Parkinson&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33958783</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002290"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33958783</owl:annotatedTarget>
        <dcterms:title>Genome-wide survival study identifies a novel synaptic locus and polygenic score for cognitive progression in Parkinson&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33958783</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8459648/</oboInOwl:hasDbXref>
        <rdfs:comment>HBS, Arizona Study of Aging/Brain and Body Donation Program, NET-PD LS1, CamPaIGN, PICNICS, DIGPD, PDBP, PIB, ParkWest, PROPARK and PROPARK-C cohorts comprised the discovery population and DATATOP, PPMI, PreCEPT and Tartu the replication population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002290"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based longitudinal cohort of patients with idiopathic Parkinson&apos;s disease, recruited from neurology clinics of university and regional hospitals in the western Netherlands across strata of age at onset and disease duration and examined mainly at Leiden University Medical Center, who were assessed on a broad range of motor and non-motor features at baseline in 2003-2005 and annually for five years, to profile the clinical course of the disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27126456</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27717005</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002290"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">420</owl:annotatedTarget>
        <obo:IAO_0000116>patients with Parkinson&apos;s disease evaluated (PROPARK baseline, design reference)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:17646625</oboInOwl:hasDbXref>
        <rdfs:comment>A cohort of 420 patients with PD was evaluated for the occurrence of AS, motor and nonmotor symptoms, as well as for demographic and disease-related characteristics.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002290"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PROPARK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


