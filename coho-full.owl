    <!-- http://www.ebi.ac.uk/coho/COHO_0002359 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002359">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. SdNM is the PGS Catalog&apos;s id for the Service de Neurologie Mazarin (neuro-oncology department) of the Pitié-Salpêtrière hospital group in Paris, the site through which the 1,495 glioma patients of the French GWAS were ascertained (PMID:28346443). The sources give the case series no name of its own, no recruitment design beyond ascertainment at the department, and no study identity apart from &apos;the French GWAS&apos;, whose controls come from a separate cohort (SU.VI.MAX). The id denotes a hospital department&apos;s unnamed set of patients, so it is not a cohort. No COHO term or review row covers it. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Service de Neurologie Mazarin, Groupe Hospitalier Pitié-Salpêtrière Paris</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002360 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002360">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20092"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002596"/>
        <obo:IAO_0000112>PMID:35435501</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of men and women aged 35–56 without previously diagnosed diabetes from five municipalities of Stockholm County, Sweden, surveyed at baseline in 1992–1994 (men) and 1996–1998 (women) with the sample enriched to about half with a family history of diabetes, and re-examined after 8–10 years and again in 2014–2017 with health examinations, oral glucose tolerance tests and questionnaires, set up at the Karolinska Institute to study the determinants of prediabetes and type 2 diabetes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7948</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SDPP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stockholm Diabetes Prevention Programme</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Stockholm Diabetes Prevention Program</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20092">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002360"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20092"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12406920+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Type 2 diabetes is the most common type of diabetes, with a prevalence of at least 4% in Sweden. Aiming at primary prevention of the disease, the Stockholm Diabetes Prevention Program (SDPP) was developed as a joint program between the Departments of Endocrinology, Social Medicine and Epidemiology at the Karolinska Institute.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002360"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9363331/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To investigate the association between fruit and vegetable intake (FVI) and the risk of developing prediabetes and type 2 diabetes (T2D) in a Swedish prospective cohort study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002360"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:35435501</owl:annotatedTarget>
        <dcterms:title>Fruit and vegetable intake and risk of prediabetes and type 2 diabetes: results from a 20-year long prospective cohort study in Swedish men and women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35435501</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9363331/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The present study is part of the Stockholm Diabetes Prevention Program (SDPP), a prospective cohort study that comprised men and women 35–56 years old at baseline, without previously diagnosed diabetes, from five municipalities in Stockholm County.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002360"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort of men and women aged 35–56 without previously diagnosed diabetes from five municipalities of Stockholm County, Sweden, surveyed at baseline in 1992–1994 (men) and 1996–1998 (women) with the sample enriched to about half with a family history of diabetes, and re-examined after 8–10 years and again in 2014–2017 with health examinations, oral glucose tolerance tests and questionnaires, set up at the Karolinska Institute to study the determinants of prediabetes and type 2 diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:12406920</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35435501</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002360"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7948</owl:annotatedTarget>
        <obo:IAO_0000116>men and women who came to the baseline survey (men 1992-1994, women 1996-1998)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9363331/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The current study included all subjects who came to baseline (n = 7948)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002360"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SDPP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002361 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002361">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20099"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:30821829</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised trial cohort of men and women aged 18–80 years with a history of myocardial infarction, recruited from 1998 through special clinics at 88 UK hospitals and coordinated by the Clinical Trial Service Unit in Oxford, which compared 80 mg with 20 mg simvastatin daily and, in a two-by-two factorial design, folic acid plus vitamin B12 with placebo, and whose participants also served for the identification of an SLCO1B1 variant associated with simvastatin-induced myopathy.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym SEARCH also denotes Study of Epidemiology and Risk Factors in Cancer Heredity (COHO:0000881) and SEARCH for Diabetes in Youth (COHO:0000882); this term is Study of the Effectiveness of Additional Reductions in Cholesterol and Homocysteine.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12064</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SEARCH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SEARCH trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SEARCH_b</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study Evaluating Additional Reduction in Cholesterol and Homocysteine</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study of the effectiveness of additional reductions in cholesterol and homocysteine</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Study of the Effectiveness of Additional Reductions in Cholesterol and Homocysteine</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20099">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005068"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002361"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20099"/>
        <obo:IAO_0000116>myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2988223/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>12 064 individuals (10 012 men and 2052 women) with a history of myocardial infarction and an average age of 64·2 (SD 8·9) years, were randomly assigned to treatment groups.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002361"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2988223/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Medical collaborators from 88 UK hospitals appointed senior nurses to run special clinics for the study (see Acknowledgments).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002361"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:30821829</owl:annotatedTarget>
        <dcterms:title>Assessment of Vascular Event Prevention and Cognitive Function Among Older Adults With Preexisting Vascular Disease or Diabetes: A Secondary Analysis of 3 Randomized Clinical Trials.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30821829</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30821829+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This secondary analysis of 3 randomized clinical trials in participants with preexisting occlusive vascular disease or diabetes included survivors to final in-trial follow-up in the Heart Protection Study (HPS), Study of the Effectiveness of Additional Reductions in Cholesterol and Homocysteine (SEARCH), and Treatment of HDL (High-Density Lipoprotein) to Reduce the Incidence of Vascular Events (HPS2-THRIVE) trials of lipid modification for prevention of cardiovascular events.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002361"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised trial cohort of men and women aged 18–80 years with a history of myocardial infarction, recruited from 1998 through special clinics at 88 UK hospitals and coordinated by the Clinical Trial Service Unit in Oxford, which compared 80 mg with 20 mg simvastatin daily and, in a two-by-two factorial design, folic acid plus vitamin B12 with placebo, and whose participants also served for the identification of an SLCO1B1 variant associated with simvastatin-induced myopathy.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21067805</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002361"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12064</owl:annotatedTarget>
        <obo:IAO_0000116>SEARCH randomized myocardial-infarction survivors</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2988223/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>12 064 individuals (10 012 men and 2052 women) with a history of myocardial infarction and an average age of 64·2 (SD 8·9) years, were randomly assigned to treatment groups.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002361"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SEARCH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
