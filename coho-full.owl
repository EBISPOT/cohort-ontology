    <!-- http://www.ebi.ac.uk/coho/COHO_0002024 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002024">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17709"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:20972438</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case–control study of bladder cancer in Lutherstadt Wittenberg, Germany, whose cases were patients with confirmed bladder cancer enrolled at the Department of Urology of the Paul Gerhardt Foundation from 1995 to 1999 and whose controls were patients of the same department admitted for benign urological diseases and enrolled from 2000 to 2005; occupational history, exposure to occupational bladder carcinogens, smoking and family history of bladder cancer were documented for cases and controls.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">221</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">214</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>LW</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LWBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Lutherstadt Wittenberg bladder cancer study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Lutherstadt Wittenberg study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Lutherstadt Wittenberg Bladder Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17709">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001187"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002024"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17709"/>
        <obo:IAO_0000116>bladder cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3188988/</oboInOwl:hasDbXref>
        <rdfs:comment>In brief, 221 patients with a confirmed bladder cancer from the Department of Urology, Paul Gerhardt Foundation, Lutherstadt Wittenberg, Germany, were included.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002024"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3188988/</oboInOwl:hasDbXref>
        <rdfs:comment>In brief, 221 patients with a confirmed bladder cancer from the Department of Urology, Paul Gerhardt Foundation, Lutherstadt Wittenberg, Germany, were included.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
