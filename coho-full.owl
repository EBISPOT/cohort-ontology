    <!-- http://www.ebi.ac.uk/coho/COHO_0001277 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001277">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11553"/>
        <rdf:type rdf:nodeID="genid11555"/>
