        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18777"/>
        <obo:IAO_0000116>psoriasis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12857016/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Novartis data was collected from five clinical trials of secukinumab in psoriasis (details available on https://clinicaltrials.gov/): CAIN457A2302 (NCT01365455), CAIN457A2303 (NCT01358578), CAIN457A2304 (NCT01406938), CAIN457A2223 (NCT01537432), CAIN457A2403 (NCT03553823).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002177"/>
