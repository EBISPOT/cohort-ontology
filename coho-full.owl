        <oboInOwl:hasDbXref>Fyler:4310</oboInOwl:hasDbXref>
        <rdfs:label>Microcephaly</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000478 -->

