    <!-- http://www.ebi.ac.uk/coho/COHO_0001117 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001117">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10228"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001115"/>
        <obo:IAO_0000112>GCST90984764</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of individuals with sickle cell disease recruited from Baylor College of Medicine and from the Sickle Cell Clinical Research and Intervention Program (SCCRIP) cohort at St. Jude Children&apos;s Research Hospital, whose whole genomes were sequenced to define genotype-phenotype relations in sickle cell disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">722</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SGP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Sickle Cell Genome Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10228">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011382"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001117"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10228"/>
        <obo:IAO_0000116>sickle cell disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34283174+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To investigate this in sickle cell disease (SCD), we performed whole-genome sequencing (WGS) of 722 individuals with hemoglobin HbSS or HbSβ0-thalassemia from Baylor College of Medicine and from the St. Jude Children&apos;s Research Hospital Sickle Cell Clinical Research and Intervention Program (SCCRIP) longitudinal cohort study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001117"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001115"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8102307/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Germline-only data of pediatric sickle cell patients represents 807 patients from the Sickle Cell Genome Project (SGP), an initiative that is part of the Sickle Cell Clinical Research and Intervention Program (SCCRIP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001117"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90984764</owl:annotatedTarget>
        <dcterms:title>A polygenic score for acute vaso-occlusive pain in pediatric sickle cell disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34283174</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8341359/</oboInOwl:hasDbXref>
        <rdfs:comment>To better define genotype–phenotype relations in SCD, we initiated the Sickle Cell Genome Project (SGP) by performing whole-genome sequencing (WGS) on participants from Baylor College of Medicine (BCM) and from the St. Jude Children’ Research Hospital Sickle Cell Clinical Research and Intervention Program (SCCRIP) longitudinal cohort study (clinicaltrials.gov #NCT02098863).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001117"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of individuals with sickle cell disease recruited from Baylor College of Medicine and from the Sickle Cell Clinical Research and Intervention Program (SCCRIP) cohort at St. Jude Children&apos;s Research Hospital, whose whole genomes were sequenced to define genotype-phenotype relations in sickle cell disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34283174</obo:IAO_0000119>
        <dcterms:contributor>Claude Sonnet 5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001117"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">722</owl:annotatedTarget>
        <obo:IAO_0000116>individuals with HbSS or HbSβ0-thalassemia whose genomes were sequenced (2021)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC8341359</oboInOwl:hasDbXref>
        <rdfs:comment>The SGP cohort consists of 722 participants from BCM or the SCCRIP cohort at St. Jude Children’s Research Hospital who were analyzed by WGS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001117"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SGP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


