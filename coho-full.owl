        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000957"/>
        <obo:IAO_0000112>GCST90274716</obo:IAO_0000112>
        <obo:IAO_0000115>A nested case-control genome-wide association study of prostate cancer in Japanese American men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Japanese component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Japanese men.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1033</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1042</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2075</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>JAPC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">JAPC GWAS</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10865">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
