        <oboInOwl:hasRelatedSynonym>3xG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3xG study (Gezondheid, Gemeenten, Geboorten)</oboInOwl:hasRelatedSynonym>
