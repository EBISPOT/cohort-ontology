        <obo:IAO_0000112>PMID:31066241</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of breast cancer in Thai women in Thailand, initially recruiting women with newly diagnosed, histologically confirmed breast cancer at the National Cancer Institute in Bangkok and Khon Kaen Hospital during May 2002–March 2004, with controls randomly selected among healthy women visiting patients at the same hospitals for diseases other than breast or ovarian cancer, to investigate breast cancer susceptibility, including variation in DNA repair genes.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym TBCS also denotes Torino Bladder Cancer Study (COHO:0002440); this term is IARC-Thai Breast Cancer Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">554</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">572</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>IARC-Thai Breast Cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IARC‐Thai Breast Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">IARC-Thai Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
