        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family sample of sibships ascertained through the Australian Twin Registry, with diagnostic interviews and blood or buccal DNA, members of which were genotyped genome-wide to study genetic contributions to alcohol use and dependence and nicotine dependence.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21529783</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
