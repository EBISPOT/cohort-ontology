        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0100545"/>
        <obo:IAO_0000115>A speech disorder characterized by frequent sound or syllable repetitions, sound prolongations, or other dysfluencies that are inappropriate for the individual&apos;s age.</obo:IAO_0000115>
        <rdfs:label>stutter disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000724 -->

