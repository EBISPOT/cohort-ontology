        <obo:IAO_0000115 xml:lang="en">The cohorts listed in the IHCC Cohort Atlas, the International Health Cohorts Consortium&apos;s directory of its member cohorts.</obo:IAO_0000115>
        <rdfs:label>IHCC_subset</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    </owl:AnnotationProperty>
    


