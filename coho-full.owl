        <oboInOwl:hasRelatedSynonym>Ansan/Ansung</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ansan/Ansung cohort</oboInOwl:hasRelatedSynonym>
