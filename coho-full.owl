        <rdfs:comment>The registry of the Dutch Autoimmune Hepatitis Study Group contains data from autoimmune hepatitis patients, the collection of data started in 2008 and is ongoing.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001644"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
