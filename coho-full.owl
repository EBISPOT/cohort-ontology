        <rdfs:comment>from 58 provincial mental health centres and psychiatric departments of general medical hospitals in 45 cities and 23 provinces of China</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:26176920</owl:annotatedTarget>
        <dcterms:title>Sparse whole-genome sequencing identifies two loci for major depressive disorder.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:26176920</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/articles/PMC4522619</oboInOwl:hasDbXref>
        <rdfs:comment>CONVERGE Consortium</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
