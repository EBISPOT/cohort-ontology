    <!-- http://www.ebi.ac.uk/coho/COHO_0002687 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002687">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:37117635</obo:IAO_0000112>
        <obo:IAO_0000115>A general population cohort of adults in Newfoundland and Labrador, Canada, established by the company Sequence Bioinformatics (Sequence Bio) of St. John&apos;s and recruiting from 2019, whose participants, aged 18 and over with a valid provincial health card, were recruited at random from general practice clinics across the province and gave medical history and saliva samples for genotyping, to characterise the genetics of the province&apos;s founder population and find genetic causes of disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2500</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NL Genome Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NLGP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sequence Bio</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Newfoundland and Labrador Genome Project</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.sequencebio.com/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002687"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10147672/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We have performed a systematic analysis of the European ancestry within the Canadian province of NL.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002687"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:37117635</owl:annotatedTarget>
        <dcterms:title>The Newfoundland and Labrador mosaic founder population descends from an Irish and British diaspora from 300 years ago.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37117635</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10147672/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>we aimed to explore the non-Indigenous (European) settlement of the present NL population in unprecedented detail, studying a sample of 1807 individuals with NL ancestry from the Newfoundland and Labrador Genome Project (NLGP), together with ancestry source references from Britain and Ireland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002687"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A general population cohort of adults in Newfoundland and Labrador, Canada, established by the company Sequence Bioinformatics (Sequence Bio) of St. John&apos;s and recruiting from 2019, whose participants, aged 18 and over with a valid provincial health card, were recruited at random from general practice clinics across the province and gave medical history and saliva samples for genotyping, to characterise the genetics of the province&apos;s founder population and find genetic causes of disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37117635</obo:IAO_0000119>
        <obo:IAO_0000119>https://atlas.ihccglobal.org/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002687"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2500</owl:annotatedTarget>
        <obo:IAO_0000116>initial participants with medical history and saliva samples, as analysed in the 2023 paper</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:37117635</oboInOwl:hasDbXref>
        <rdfs:comment>The NLGP cohort consists of the initial 2,500 participants for whom medical history and saliva samples were obtained with informed consent under a study protocol approved by the Newfoundland and Labrador Health Research Ethics Board (Ethics Reference #: 2018.243).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002687"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NLGP</owl:annotatedTarget>
