    <!-- http://www.ebi.ac.uk/coho/COHO_0002346 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002346">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19982"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002462"/>
        <obo:IAO_0000112>PGS001778</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:21632523</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of breast cancer in Sheffield, United Kingdom, that recruited women with histologically confirmed breast cancer from the surgical outpatient clinics of the Royal Hallamshire Hospital, Sheffield, and Rotherham District Hospital from 1998 to 2005, and as controls women aged 50 to 60 attending the Sheffield mammography screening service in 2000–2004 whose mammograms showed no breast lesions, all resident in the Sheffield area and of northern European ancestry, for studies of genetic susceptibility to and survival from breast cancer.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym SBCS also denotes Shanghai Breast Cancer Study (COHO:0000795) and Spanish Bladder Cancer Study (COHO:0000797); this term is Sheffield Breast Cancer Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1011</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1024</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>SBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SBCS_b</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Sheffield Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19982">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002346"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19982"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3700940/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Sheffield Breast Cancer Study (SBCS) recruited histologically confirmed breast cancer patients from surgical outpatient clinics in the Royal Hallamshire Hospital, Sheffield and Rotherham District Hospital from 1998 to 2005.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002346"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2876119/</oboInOwl:hasDbXref>
        <rdfs:comment>SBCS UK Hospital-based Women with pathologically confirmed breast cancer recruited from surgical outpatient clinics at the Royal Hallamshire Hospital, Sheffield, 1998–2002; cases are a mixture of prevalent and incident disease</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002346"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS001778</owl:annotatedTarget>
        <dcterms:title>Combination of a 15-SNP Polygenic Risk Score and Classical Risk Factors for the Prediction of Breast Cancer Risk in Cypriot Women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34572793</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002346"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21632523</owl:annotatedTarget>
        <dcterms:title>A role for XRCC2 gene polymorphisms in breast cancer risk and survival.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21632523</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21632523+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The study genotyped 12 XRCC2 tagging single nucleotide polymorphisms (SNPs) in 1131 breast cancer cases and 1148 controls from the Sheffield Breast Cancer Study (SBCS), and examined their associations with breast cancer risk and survival by estimating ORs and HRs, and their corresponding 95% CIs.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002346"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of breast cancer in Sheffield, United Kingdom, that recruited women with histologically confirmed breast cancer from the surgical outpatient clinics of the Royal Hallamshire Hospital, Sheffield, and Rotherham District Hospital from 1998 to 2005, and as controls women aged 50 to 60 attending the Sheffield mammography screening service in 2000–2004 whose mammograms showed no breast lesions, all resident in the Sheffield area and of northern European ancestry, for studies of genetic susceptibility to and survival from breast cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20520800</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23844225</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002346"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1011</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls whose samples were available for genotyping in the 2013 ATR/CHEK1 study (no total stated)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3700940/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Samples from 1011 cases and 1024 controls were available for genotyping.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002346"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1024</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls whose samples were available for genotyping in the 2013 ATR/CHEK1 study (no total stated)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3700940/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Samples from 1011 cases and 1024 controls were available for genotyping.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002346"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SBCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
