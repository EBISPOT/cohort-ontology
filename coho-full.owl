        <owl:annotatedTarget>100-plus</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001453 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001453">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13148"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000660"/>
        <obo:IAO_0000112>PMID:22773825</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based study of young-onset breast cancer, conducted by the US National Institute of Environmental Health Sciences as an offshoot of the Sister Study, that in 2008–2010 enrolled women diagnosed with breast cancer before age 50 who had a sister in the Sister Study, together with their parents, and used the breast cancer-free Sister Study sisters as matched controls, to study genetic and environmental causes of young-onset breast cancer. The affected women are followed prospectively as breast cancer survivors.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1422</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1669</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>2SISTER</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Two Sister Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Two Sister Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13148">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001453"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13148"/>
        <obo:IAO_0000116>young-onset breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22773825+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted the Two Sister Study, a sister-matched case-control study, by enrolling 1422 women between September 2008 and December 2010, who were younger than age 50 years at diagnosis with breast cancer and were enrolled within 4 years of diagnosis, and 1669 breast cancer-free control sisters from the Sister Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001453"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0609-2/MediaObjects/41588_2020_609_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>2SISTER The Two Sister Study USA Case-only study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001453"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000660"/>
        <oboInOwl:hasDbXref>https://sisterstudy.niehs.nih.gov/English/2sis.htm</oboInOwl:hasDbXref>
        <rdfs:comment>The Two Sister Study is an offshoot of the Sister Study that focuses on young-onset breast cancer and is based on families.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001453"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22773825</owl:annotatedTarget>
        <dcterms:title>Fertility drugs and young-onset breast cancer: results from the Two Sister Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22773825</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22773825+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted the Two Sister Study, a sister-matched case-control study, by enrolling 1422 women between September 2008 and December 2010, who were younger than age 50 years at diagnosis with breast cancer and were enrolled within 4 years of diagnosis, and 1669 breast cancer-free control sisters from the Sister Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001453"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family-based study of young-onset breast cancer, conducted by the US National Institute of Environmental Health Sciences as an offshoot of the Sister Study, that in 2008–2010 enrolled women diagnosed with breast cancer before age 50 who had a sister in the Sister Study, together with their parents, and used the breast cancer-free Sister Study sisters as matched controls, to study genetic and environmental causes of young-onset breast cancer. The affected women are followed prospectively as breast cancer survivors.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22773825</obo:IAO_0000119>
        <obo:IAO_0000119>https://sisterstudy.niehs.nih.gov/English/2sis.htm</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001453"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1422</owl:annotatedTarget>
        <obo:IAO_0000116>young-onset breast cancer cases enrolled 2008-2010 and their breast cancer-free control sisters from the Sister Study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:22773825</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted the Two Sister Study, a sister-matched case-control study, by enrolling 1422 women between September 2008 and December 2010, who were younger than age 50 years at diagnosis with breast cancer and were enrolled within 4 years of diagnosis, and 1669 breast cancer-free control sisters from the Sister Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001453"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1669</owl:annotatedTarget>
        <obo:IAO_0000116>young-onset breast cancer cases enrolled 2008-2010 and their breast cancer-free control sisters from the Sister Study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:22773825</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted the Two Sister Study, a sister-matched case-control study, by enrolling 1422 women between September 2008 and December 2010, who were younger than age 50 years at diagnosis with breast cancer and were enrolled within 4 years of diagnosis, and 1669 breast cancer-free control sisters from the Sister Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001453"/>
