        <rdfs:comment>Briefly, a random sample of 2492 children attending school in the Attica region in Greece were invited to join the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001774"/>
