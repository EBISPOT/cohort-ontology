        <rdfs:label>cardiac arrest</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000764 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0000764">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003847"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0018102"/>
        <obo:IAO_0000115>Any corneal dystrophy (disease) in which the cause of the disease is a mutation in the TGFBI gene.</obo:IAO_0000115>
        <rdfs:label>epithelial-stromal TGFBI dystrophy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000771 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0000771">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005087"/>
