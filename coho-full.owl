        <oboInOwl:hasRelatedSynonym>Cardiovascular and Metabolic disease Etiology Research Center-HIgh risk cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Cardiovascular and Metabolic Disease Etiology Research Center-High Risk</rdfs:label>
    </owl:NamedIndividual>
