    <!-- http://www.ebi.ac.uk/coho/COHO_0001753 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001753">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15661"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Latin_America_and_the_Caribbean"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Mexico"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Puerto_Rico"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:20673984</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, international, family-based study of childhood asthma run from the University of California, San Francisco, which recruited Mexican and Puerto Rican children with asthma and their parents (parent–child trios) in Mexico City, the San Francisco Bay Area, Puerto Rico and New York City, to identify clinical and genetic risk factors for asthma.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">684</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GALA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GALA Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GALA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Asthma in Latino Americans (GALA) Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Asthma in Latino Americans Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Asthma in Latino Populations</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Genetics of Asthma in Latino Americans</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15661">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001753"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15661"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.888/MediaObjects/41588_2011_BFng888_MOESM5_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Based on interviews and questionnaire data, children were included in the study if they were between the ages of 8-40 with physician diagnosed mild to moderate-severe asthma and had experienced two or more symptoms in the previous two years at time of recruitment (including wheezing, coughing and/or shortness of breath).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001753"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Puerto_Rico"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3091325/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Using 104 ancestry informative markers, we examined spouse correlations in genetic ancestry for Mexican spouse pairs recruited from Mexico City and the San Francisco Bay Area, and Puerto Rican spouse pairs recruited from Puerto Rico and New York City.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001753"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20673984</owl:annotatedTarget>
        <dcterms:title>Dual-specificity phosphatase 1 as a pharmacogenetic modifier of inhaled steroid response among asthmatic patients.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20673984</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20673984+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Study participants with asthma were drawn from the following multiethnic cohorts: the Genetics of Asthma in Latino Americans (GALA) study; the Study of African Americans, Asthma, Genes &amp; Environments (SAGE); and the Study of Asthma Phenotypes and Pharmacogenomic Interactions by Race-ethnicity (SAPPHIRE).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001753"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre, international, family-based study of childhood asthma run from the University of California, San Francisco, which recruited Mexican and Puerto Rican children with asthma and their parents (parent–child trios) in Mexico City, the San Francisco Bay Area, Puerto Rico and New York City, to identify clinical and genetic risk factors for asthma.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19930545</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19951396</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21912604</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001753"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">684</owl:annotatedTarget>
        <obo:IAO_0000116>Mexican and Puerto Rican individuals with asthma (the probands) recruited; their parents are not counted</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14617512+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To determine whether ethnicity-specific differences in therapeutic response, clinical response, and/or genetic factors contribute to differences in asthma outcomes, we compared asthma-related clinical characteristics among 684 Mexican and Puerto Rican individuals with asthma recruited from San Francisco, New York City, Puerto Rico, and Mexico City.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001753"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GALA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001754 -->

