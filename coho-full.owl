        <oboInOwl:hasRelatedSynonym>Phenotype-Genotype-Biomarker study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Phenotype, Genotype &amp; Biomarkers in ALS and Related Disorders</rdfs:label>
    </owl:NamedIndividual>
