        <dcterms:title>Genome-wide Association Study of Bladder Cancer Reveals New Biological and Translational Insights.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37210288</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://ars.els-cdn.com/content/image/1-s2.0-S030228382302780X-mmc3.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>Brescia Bladder Cancer Study (BBCS)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000815"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of bladder cancer among men resident in the province of Brescia, northern Italy, with newly diagnosed cases admitted to the urology departments of the two main Brescia hospitals in 1997–2000 and controls with non-neoplastic urological diseases, used to study occupational, environmental and genetic risk factors for bladder cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24722645</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
