    <!-- http://www.ebi.ac.uk/coho/COHO_0001962 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001962">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000534"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-28. Checked 2026-09-25: The draft left the name for research. An African American prostate cancer genetics paper that used the sample describes KCPCS as two population-based case-control studies in King County, Washington (cases from the Seattle-Puget Sound SEER registry in 1993–1996 and 2002–2005, random-digit-dialling controls); other papers from the same group confirm the design and the Fred Hutchinson base. Treated as one cohort, as the PGS Catalog and the papers treat the two King County studies (1993–1996 and 2002–2005) as one resource. Its data reach the AAPC and PRACTICAL analyses, but no text read names KCPCS as a member of the African Ancestry Prostate Cancer Consortium (COHO:0000768) or PRACTICAL (COHO:0000611) in one span, so no parent is asserted. No duplicate in COHO or this review. Curated 2026-09-28: KCPCS is the existing COHO:0000534 cohort. PMID:28145099 describes that cohort as the two population-based King County studies enrolling diagnoses in 1993-1996 and 2002-2005, matching KCPCS. Retain the existing definition, GWAS example and classifications, add the catalogue names and PGS example, and obsolete only the duplicate. Its original interview counts are reverified in PMID:19366831. Replaced by COHO:0000534 (Fred Hutchinson Prostate Cancer Study), which now carries this term&apos;s names. Found by the checks of the placeholders&apos; names against their sources recorded in the pipeline repository, completed 2026-09-28.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete King County Prostate Cancer Studies</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001963 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001963">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17247"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Kenya"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000294"/>
        <obo:IAO_0000112>PMID:30033078</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of severe Plasmodium falciparum malaria in children of Kilifi County on the coast of Kenya, carried out by the KEMRI-Wellcome Trust Research Programme in the area of the Kilifi Health and Demographic Surveillance System: its cases are children younger than 14 years admitted with severe malaria to the high-dependency ward of Kilifi County Hospital, and its controls are infants aged 3–12 months born in the same area between August 2006 and September 2010 who were recruited to a cohort study of genetic susceptibility to childhood diseases. It is the Kenyan partner study of the Malaria Genomic Epidemiology Network&apos;s multicentre case-control study of severe malaria (Consortial Project 1), whose samples were used in MalariaGEN&apos;s candidate-gene and genome-wide association studies.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2244</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3949</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6193</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>KEMRI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KEMRI-Wellcome Research Programme, Kilifi</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Kilifi severe malaria case-control study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17247">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005136"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001963"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17247"/>
        <obo:IAO_0000116>severe malaria</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6069675/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We recruited as cases children presenting with severe malaria to the high-dependency ward of Kilifi County Hospital.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001963"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
