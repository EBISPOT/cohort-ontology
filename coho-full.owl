    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002581"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A regional hospital-based register of patients admitted with acute stroke to cooperating hospitals in Westphalia, north-west Germany, with departments of neurology, internal medicine and geriatric medicine taking part, which records a standardised data set of sociodemographic and clinical characteristics, diagnostic and treatment procedures, complications and status at discharge; its case ascertainment was part of the German Competence Net Stroke, and consecutive consenting ischaemic stroke patients recruited through it have been used in genetic studies of stroke.</owl:annotatedTarget>
