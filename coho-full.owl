    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001626 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001626">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <obo:IAO_0000115>Any abnormality of the cardiovascular system.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Cardiovascular disease</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Abnormality of the cardiovascular system</rdfs:label>
    </owl:Class>
    <owl:Axiom>
