        <rdfs:comment>KSMU: is a population‐based case‐control study of adult cases of asthma and controls matched for age and sex.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001981"/>
