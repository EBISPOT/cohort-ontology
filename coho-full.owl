    <!-- http://www.ebi.ac.uk/coho/COHO_0001836 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001836">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16353"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <obo:IAO_0000112>PMID:38469817</obo:IAO_0000112>
        <obo:IAO_0000115>A randomized, multi-center, open-label clinical trial in the Republic of Korea, registered as KCT0005414, that compared the safety and efficacy of afatinib alone with afatinib combined with HAD-B1 (HangAmDan-B1), a traditional Korean medicine herbal formulation, in patients with locally advanced or metastatic EGFR-mutation-positive non-small cell lung cancer enrolled at six centres, and ran from February 2021 to April 2023.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">90</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HAD-B1-IIT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HangAmDan-B1-Investigator Initiated Trial study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">HangAmDan-B1-Investigator Initiated Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16353">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005233"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001836"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16353"/>
        <obo:IAO_0000116>EGFR-mutation-positive non-small cell lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11301725/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The clinical trial is a randomized, multi-center, open-label study to compare the safety and efficacy of HAD-B1 combined with afatinib therapy for patients with locally advanced or metastatic EGFR-mutation-positive NSCLC.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001836"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11301725/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The 90 patients with EGFR-mutation-positive locally advanced or metastatic NSCLC requiring afatinib therapy were enrolled from 6 centers, which are the Daejeon Korean Medicine University, Kosin University Gospel Hospital, Pusan National University, Yangsan Hospital, Konyang University Hospital, Catholic University of Korea Seoul St. Mary’s Hospital, and Ajou Universtity.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001836"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38469817</owl:annotatedTarget>
        <dcterms:title>Genome-wide Analysis Identified &lt;i&gt;SEMA4D&lt;/i&gt;, Novel Candidate Gene for Temperature Sensitivity in Patients With Non-Small Cell Lung Cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38469817</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10935759/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Ninety patients were enrolled in the HangAmDan-B1-Investigator Initiated Trial (HAD-B1-IIT) study, which was a randomized, multicenter, open-label study for the comparison of the safety and efficacy of afatinib monotherapy and that of the combination therapy of afatinib and HAD-B1 for patients with locally advanced NSCLC and EGFR mutations.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001836"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomized, multi-center, open-label clinical trial in the Republic of Korea, registered as KCT0005414, that compared the safety and efficacy of afatinib alone with afatinib combined with HAD-B1 (HangAmDan-B1), a traditional Korean medicine herbal formulation, in patients with locally advanced or metastatic EGFR-mutation-positive non-small cell lung cancer enrolled at six centres, and ran from February 2021 to April 2023.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38469817</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39103991</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001836"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">90</owl:annotatedTarget>
        <obo:IAO_0000116>patients with EGFR-mutation-positive advanced NSCLC enrolled and randomised, February 2021 to December 2022 (2021-2022)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11301725/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this clinical trial, 90 subjects were enrolled.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001836"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HAD-B1-IIT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001837 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001837">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16360"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Kazakhstan"/>
        <obo:IAO_0000112>PMID:22426144</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of endometrial cancer in Kazakhstan, whose own investigators genotyped its samples with TaqMan assays for the final replication stage of a 2012 genome-wide association study of endometrial cancer, and whose data were used again in a 2013 study of inflammation pathway genes and endometrial cancer risk.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">218</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">232</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>HAECS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Hannover-Almaty Endometrial Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16360">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011962"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001837"/>
