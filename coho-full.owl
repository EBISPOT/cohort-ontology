    <!-- http://www.ebi.ac.uk/coho/COHO_0002700 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002700">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000298"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:24149770</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based cohort of men and women aged 45 years and over in New South Wales, Australia, randomly sampled from the Medicare enrolment database and recruited by postal questionnaire in 2005–2009 by the Sax Institute, with oversampling of people aged 80 and over and of rural and remote residents, repeated follow-up surveys, biospecimen sub-studies and routine linkage to mortality, hospital, pharmaceutical and other health records, as a resource for research on health and ageing.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">267357</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Sax Institute&apos;s 45 and Up Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">45 and Up Study</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.saxinstitute.org.au/our-work/45-up-study/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002700"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9908035/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The 45 and Up Study (‘the Study’) recruited 267 357 participants aged ≥45 years from New South Wales, Australia between 2005 and 2009 as a resource for researchers and policy makers to source evidence to support better health and ageing.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002700"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:24149770</owl:annotatedTarget>
        <dcterms:title>Body mass index and incident hospitalisation for cardiovascular disease in 158 546 participants from the 45 and Up Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24149770</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4052432/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Sax Institute&apos;s 45 and Up Study is a large-scale Australian cohort study of 267 151 men and women aged 45 years and over, randomly sampled from the general population of New South Wales (NSW), Australia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002700"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of men and women aged 45 years and over in New South Wales, Australia, randomly sampled from the Medicare enrolment database and recruited by postal questionnaire in 2005–2009 by the Sax Institute, with oversampling of people aged 80 and over and of rural and remote residents, repeated follow-up surveys, biospecimen sub-studies and routine linkage to mortality, hospital, pharmaceutical and other health records, as a resource for research on health and ageing.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35604374</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002700"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">267357</owl:annotatedTarget>
        <obo:IAO_0000116>men and women enrolled 2005-2009</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:35604374</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1 395 174 invitations were mailed and 267 357 participants enrolled.</rdfs:comment>
    </owl:Axiom>
    


