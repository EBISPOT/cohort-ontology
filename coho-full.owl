    <!-- http://www.ebi.ac.uk/coho/COHO_0002750 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002750">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23358"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Poland"/>
        <obo:IAO_0000112>PXD033091</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based multi-centre longitudinal cohort of pregnant women recruited in Poland from 2007 to 2011, with their children followed through infancy, childhood and adolescence, to evaluate the impact of occupational, environmental and lifestyle exposures during pregnancy and after birth on pregnancy outcomes and offspring health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1763</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Polish Mother and Child Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Polish Mother and Child cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REPRO_PL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REPRO_PL cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PRIDE_subset"/>
        <rdfs:label xml:lang="en">Polish Mother and Child Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23358">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ExO_0000002"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002750"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23358"/>
        <obo:IAO_0000116>occupational, environmental and lifestyle-related exposures during the prenatal period and after birth</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9656994/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The general aim of the REPRO_PL cohort is to evaluate the impact of occupational, environmental and lifestyle-related exposures during the prenatal period and after birth on pregnancy outcomes and/or offspring health during various stages of life (infancy, childhood and adolescence).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002750"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Poland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9656994/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Polish Mother and Child Cohort (REPRO_PL) is a population-based multi-center longitudinal study established in 2007 in Poland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002750"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PXD033091</owl:annotatedTarget>
        <dcterms:title>Proteomic analysis of human neuronal SH-SY5Y in neurological diseases exposed to phtalates and metaks</dcterms:title>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/pride/ws/archive/v2/projects/PXD033091</oboInOwl:hasDbXref>
        <rdfs:comment>Mixtures of phthalates (DEHP, DiNP, BBzP) and metals (lead, methylmercury, total mercury, cadmium) were selected as they were the most abundant ones in the REPRO_PL and PHIME cohorts, respectively, in the frame of the EU project HEALS, investigating if exposure to those pollutants could be associated to neurodevelopmental disorders in children across Europe.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002750"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based multi-centre longitudinal cohort of pregnant women recruited in Poland from 2007 to 2011, with their children followed through infancy, childhood and adolescence, to evaluate the impact of occupational, environmental and lifestyle exposures during pregnancy and after birth on pregnancy outcomes and offspring health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36361044</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002750"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1763</owl:annotatedTarget>
        <obo:IAO_0000116>pregnant women recruited (2011)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9656994/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1763 women were recruited in the REPRO_PL cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002750"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>REPRO_PL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002751 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002751">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23365"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Croatia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Greece"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Slovenia"/>
        <obo:IAO_0000112>PXD033091</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of mother-infant pairs recruited in the coastal Province of Trieste, Italy, in Ljubljana, Slovenia, in Rijeka, Croatia, and on Greek islands, set up within the PHIME project (2006 to 2011) to investigate the effects of prenatal low-level mercury exposure from maternal fish and seafood consumption on child neurodevelopment.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PHIME</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PHIME cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PRIDE_subset"/>
        <rdfs:label xml:lang="en">Mediterranean PHIME cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23365">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0900006"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002751"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23365"/>
        <obo:IAO_0000116>prenatal low-level mercury exposure from maternal consumption of fish and seafood</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3700240/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We designed a prospective cohort to investigate the effects of prenatal low-level mercury exposure from maternal consumption of fish and seafood on child neurodevelopment among residents of the Mediterranean coastal areas of 4 neighboring countries.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002751"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Greece"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3700240/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The cohort includes 4 recruitment areas: (a) the coastal Province of Trieste, Italy, (b) the city of Ljubljana, Slovenia and its surroundings (up to 50 km), (c) the coastal city of Rijeka, Croatia and its county (Primorsko-goranska), and (d) the Greek islands of Lesvos, Chios, Samos, and Leros in the eastern Aegean.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002751"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PXD033091</owl:annotatedTarget>
        <dcterms:title>Proteomic analysis of human neuronal SH-SY5Y in neurological diseases exposed to phtalates and metaks</dcterms:title>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/pride/ws/archive/v2/projects/PXD033091</oboInOwl:hasDbXref>
        <rdfs:comment>Mixtures of phthalates (DEHP, DiNP, BBzP) and metals (lead, methylmercury, total mercury, cadmium) were selected as they were the most abundant ones in the REPRO_PL and PHIME cohorts, respectively, in the frame of the EU project HEALS, investigating if exposure to those pollutants could be associated to neurodevelopmental disorders in children across Europe.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002751"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of mother-infant pairs recruited in the coastal Province of Trieste, Italy, in Ljubljana, Slovenia, in Rijeka, Croatia, and on Greek islands, set up within the PHIME project (2006 to 2011) to investigate the effects of prenatal low-level mercury exposure from maternal fish and seafood consumption on child neurodevelopment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23269124</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002751"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PHIME</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002752 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002752">
