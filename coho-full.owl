        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3723635/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Amsterdam Cohort Studies on HIV infection and AIDS (ACS) in the Netherlands</rdfs:comment>
    </owl:Axiom>
