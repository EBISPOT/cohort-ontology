        <obo:IAO_0000112>GCST90246328</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal population study of more than 5000 adults aged 40 and older in Bushbuckridge, rural Mpumalanga, South Africa, recruited in 2014–2015 within the Agincourt Health and Demographic Surveillance System, collecting socio-demographic, infection history and cognitive data to study health and ageing.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5059</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HAALSI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Health and Aging in Africa: A Longitudinal Study of an INDEPTH Community in South Africa</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Health and Ageing in Africa: A Longitudinal Study of an INDEPTH Community in South Africa</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000911"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Africa"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10043003/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Socio-demographic data, infection history, and cognitive performance data were collected from 5059 consented participants (male (n = 2345) and female (n = 2714)) aged 40 years and older recruited from Bushbuckridge, Mpumalanga (November 2014 to November 2015) and a sub-set of 2246 of these participants (male (n = 935) and female (n = 1311)) had genotype data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000911"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000912"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10043003/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>HAALSI was funded by the National Institute on Aging (P01 AG041710) nested within the Agincourt Health and Demographic Surveillance System supported by the University of the Witwatersrand and Medical Research Council, South Africa, and the Wellcome Trust, UK (grants 058893/Z/99/A; 069683/Z/02/Z; 085477/Z/08/Z; 085477/B/08/Z).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000911"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90246328</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of population-standardised cognitive performance phenotypes in a rural South African community.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36973338</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10043003/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A Longitudinal Study of an INDEPTH Community in South Africa (HAALSI) collected baseline cognition data for over 5000 older adults in Bushbuckridge, rural Mpumalanga, South Africa (SA)36.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000911"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal population study of more than 5000 adults aged 40 and older in Bushbuckridge, rural Mpumalanga, South Africa, recruited in 2014–2015 within the Agincourt Health and Demographic Surveillance System, collecting socio-demographic, infection history and cognitive data to study health and ageing.</owl:annotatedTarget>
