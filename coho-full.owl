        <obo:IAO_0000112>GCST90128530</obo:IAO_0000112>
        <obo:IAO_0000115>The Northern California site of the Breast Cancer Family Registry, which from 1995 enrolled about 4000 women with incident breast cancer, ascertained through the Greater Bay Area Cancer Registry in the San Francisco Bay Area with oversampling of cases with indicators of increased genetic susceptibility, together with their family members and random-digit-dialled population controls, to study the genetic epidemiology of breast cancer.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BCFR-NC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BCFR-NCA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NC-BCFR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Northern California site of the Breast Cancer Family Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Northern California Breast Cancer Family Registry</rdfs:label>
