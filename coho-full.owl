        <owl:annotatedTarget>PGS000759</owl:annotatedTarget>
        <dcterms:title>Genetic variation associated with thyroid autoimmunity shapes the systemic immune response to PD-1 checkpoint blockade.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34099659</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001816"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34099659</owl:annotatedTarget>
        <dcterms:title>Genetic variation associated with thyroid autoimmunity shapes the systemic immune response to PD-1 checkpoint blockade.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34099659</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8184890/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We construct a polygenic risk score (PRS) for lifetime risk of hypothyroidism using a GWAS from the UK Biobank and apply this PRS to genetic data collected from 2,616 patients of European ancestry from these trials.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001816"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of germline whole-genome sequencing data, assembled by Genentech&apos;s Human Genetics Initiative, from patients in seven Roche/Genentech phase 3 trials of the anti-PD-L1 antibody atezolizumab, alone or combined with chemotherapy or bevacizumab, and their standard-of-care control arms in six cancers (IMvigor211, IMpower150, IMpower130, IMpower131, IMpower133, IMmotion151 and IMpassion130), sequenced from blood samples given under the trials&apos; optional research biosample consent.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34099659</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001816"/>
