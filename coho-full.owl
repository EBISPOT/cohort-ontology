    <!-- http://www.ebi.ac.uk/coho/COHO_0002688 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002688">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PGS000068</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:40067807</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of postmenopausal women aged 50–74 from the general population of England, Wales and Northern Ireland, recruited in 2001–2005 to the United Kingdom Collaborative Trial of Ovarian Cancer Screening (UKCTOCS), a randomised trial of ovarian cancer screening, whose donated serum samples (at recruitment and, in the multimodal screening arm, annually until 2011) and linked national health records are kept by the MRC Clinical Trials Unit at University College London as an open bioresource for studies of common diseases and disease markers.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">202280</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>UK Collaborative Trial of Ovarian Cancer Screening</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UKCTOCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UKCTOCS Longitudinal Women&apos;s Cohort (UKLWC)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UKLWC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>United Kingdom Collaborative Trial of Ovarian Cancer Screening</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">UKCTOCS Longitudinal Women&apos;s Cohort</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://directory.biobankinguk.org/Profile/Biobank/GBR-1-123"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002688"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11896025/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this trial 202,638 postmenopausal women aged 50 and above were recruited through thirteen UK centres between 2001 and 2005.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002688"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000068</owl:annotatedTarget>
        <dcterms:title>Evaluation of polygenic risk scores for ovarian cancer risk prediction in a prospective cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29730597</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002688"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40067807</owl:annotatedTarget>
        <dcterms:title>Lung cancer associated autoantibody responses are detectable years before clinical presentation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40067807</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11896025/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Using a longitudinal cohort from the United Kingdom Collaborative Trial of Ovarian Cancer Screening (UKCTOCS) study, we have established that elevated autoantibodies can be detected an average of four years in advance of clinical presentation, and in some cases up to 8 years prior to clinical presentation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002688"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of postmenopausal women aged 50–74 from the general population of England, Wales and Northern Ireland, recruited in 2001–2005 to the United Kingdom Collaborative Trial of Ovarian Cancer Screening (UKCTOCS), a randomised trial of ovarian cancer screening, whose donated serum samples (at recruitment and, in the multimodal screening arm, annually until 2011) and linked national health records are kept by the MRC Clinical Trials Unit at University College London as an open bioresource for studies of common diseases and disease markers.</owl:annotatedTarget>
        <obo:IAO_0000119>https://uklwc.mrcctu.ucl.ac.uk/overview</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.innovative-ctu.ucl.ac.uk/studies/all-studies/u/uklwc/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002688"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">202280</owl:annotatedTarget>
        <obo:IAO_0000116>postmenopausal women who joined UKCTOCS (2005)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://uklwc.mrcctu.ucl.ac.uk/overview</oboInOwl:hasDbXref>
        <rdfs:comment>UKCTOCS Longitudinal Women’s Cohort (UKLWC) includes the 202,280 postmenopausal women from the general population who joined the United Kingdom Collaborative Trial of Ovarian Cancer Screening</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002688"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>UKCTOCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
