        <obo:IAO_0000112>MTBLS395</obo:IAO_0000112>
        <obo:IAO_0000115>A registry of patients with acute myocardial infarction admitted to the coronary units of the six hospitals of the Florence health district, Italy, between April 2008 and April 2009, followed for survival after the infarction.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1496</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AMI-Florence 2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AMI-Florence 2 registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AMI-Florence II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AMI-Florence II cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>acute myocardial infarction in Florence 2 registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">Florence Acute Myocardial Infarction-2 registry</rdfs:label>
    </owl:NamedIndividual>
