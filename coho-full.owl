        <oboInOwl:hasDbXref>PMID:39808632</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11731713/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study included 3938 nulliparous women from the Italian NINFEA mother-child cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002605"/>
