    <!-- http://www.ebi.ac.uk/coho/COHO_0001746 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001746">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15589"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>PMID:22961080</obo:IAO_0000112>
        <obo:IAO_0000115>A type 2 diabetes case-control sample of Han Chinese from Beijing or Shanghai, China, made up of people with type 2 diabetes and nondiabetic controls, that was one of the four sample sets of the stage 1 genome-wide scan of a 2013 genome-wide association study of type 2 diabetes in Chinese Hans.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">807</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">339</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>Fudan-Huashan</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Fudan-Huashan Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15589">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001746"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15589"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526061/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The stage 1 samples for the GWA scan included 1,999 T2D case subjects and 1,976 nondiabetic control subjects drawn from the Nutrition and Health of Aging Population in China (NHAPC) study (312 case and 815 control subjects), the Gut Microbiota and Obesity Study (GMOS) (82 case and 163 control subjects), the Fudan-Huashan Study (807 case and 339 control subjects), and the Beijing Diabetes Survey (798 case and 659 control subjects).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001746"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526061/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In stage 1, we tested the association with T2D of 2,234,194 genotyped and imputed SNPs that passed all QC criteria in 3,712 Chinese Hans from Beijing and Shanghai, of which 1,839 were case subjects, and 1,873 were control subjects.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001746"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22961080</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study identifies GRK5 and RASGRP1 as type 2 diabetes loci in Chinese Hans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22961080</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526061/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The stage 1 samples for the GWA scan included 1,999 T2D case subjects and 1,976 nondiabetic control subjects drawn from the Nutrition and Health of Aging Population in China (NHAPC) study (312 case and 815 control subjects), the Gut Microbiota and Obesity Study (GMOS) (82 case and 163 control subjects), the Fudan-Huashan Study (807 case and 339 control subjects), and the Beijing Diabetes Survey (798 case and 659 control subjects).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
