    <!-- http://www.ebi.ac.uk/coho/COHO_0001773 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001773">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15840"/>
        <rdf:type rdf:nodeID="genid15842"/>
        <rdf:type rdf:nodeID="genid15844"/>
