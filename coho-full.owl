    <!-- http://www.ebi.ac.uk/coho/COHO_0000215 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000215">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000057"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000214"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000218"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000257"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000345"/>
        <obo:IAO_0000112>EGAS00001001917</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of research groups in Africa and the United Kingdom that brings together population cohorts and genomic resources from sub-Saharan Africa, including the African Genome Variation Project, the Uganda General Population Cohort, the Genome Diversity in Africa Project and the Durban diabetes studies, to investigate the genetics of chronic disease in African populations.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>APCDR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <rdfs:label xml:lang="en">African Partnership for Chronic Disease Research</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
