        <obo:IAO_0000112>PMID:22762150</obo:IAO_0000112>
        <obo:IAO_0000115>A French nationwide prospective cohort initiated in 2000 to estimate breast, ovarian and other cancer risks in women carrying pathogenic BRCA1 or BRCA2 variants and to assess lifestyle, environmental and genetic factors that modify these risks. Participants are recruited through family cancer clinics after genetic counseling and followed for primary or subsequent cancer, including women already diagnosed with cancer and those unaffected at enrollment.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4925</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>French National BRCA1 and BRCA2 mutations carrier cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GENEPSO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>prospective cohort of BRCAx mutation carriers</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Gene Etude Prospective Sein Ovaire</rdfs:label>
    </owl:NamedIndividual>
