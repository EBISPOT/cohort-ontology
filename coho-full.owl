    <!-- http://www.ebi.ac.uk/coho/COHO_0000127 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000127">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid1441"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90295922</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of patients with gastroparesis recruited through the Gastroparesis Clinical Research Consortium (GpCRC), a network of gastrointestinal tertiary centres in the United States sponsored by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK), whose registry provided the gastroparesis cases of the GWAS Catalog study tagged NIDDK.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">NIDDK is the National Institute of Diabetes and Digestive and Kidney Diseases, a funding institute. The GWAS Catalog uses the cohort tag NIDDK for the NIDDK-sponsored Gastroparesis Clinical Research Consortium sample (GCST90295922), which is what this term denotes and which its paper calls the Gastroparesis Clinical Research Consortium cohort; studies that name NIDDK only as a funder (e.g. EGAS00001002937) are not this cohort.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1400</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GpCRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIDDK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Institute of Diabetes and Digestive and Kidney Diseases Gastroparesis Clinical Research Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Gastroparesis Clinical Research Consortium cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid1441">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006769"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000127"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid1441"/>
        <obo:IAO_0000116>gastroparesis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37688361+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We carried out a genome-wide association study (GWAS) meta-analysis on (i) 478 GP patients from the National Institute of Diabetes and Digestive and Kidney Diseases Gastroparesis Clinical Research Consortium (GpCRC) compared to 9931 population-based controls from the University of Michigan Health and Retirement Study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000127"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10576603/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Gastroparesis Clinical Research Consortium (GpCRC) is a network of GI tertiary centers in the United States</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90295922</owl:annotatedTarget>
        <dcterms:title>A pilot genome-wide association study meta-analysis of gastroparesis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37688361</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10576603/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Gastroparesis Clinical Research Consortium (GpCRC) is a network of GI tertiary centers in the United States sponsored by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK) that aims to advance knowledge and treatments for GP.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of patients with gastroparesis recruited through the Gastroparesis Clinical Research Consortium (GpCRC), a network of gastrointestinal tertiary centres in the United States sponsored by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK), whose registry provided the gastroparesis cases of the GWAS Catalog study tagged NIDDK.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37688361</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000127"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1400</owl:annotatedTarget>
        <obo:IAO_0000116>participants enrolled in the GpCRC studies (approximate), 2022</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9691520/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>We have enrolled approximately 1400 participants to date, with both delayed and normal emptying, in an approximately 3:1 ratio.</rdfs:comment>
    </owl:Axiom>
