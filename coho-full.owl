    <!-- http://www.ebi.ac.uk/coho/COHO_0002235 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002235">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19153"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <obo:IAO_0000112>PMID:22999729</obo:IAO_0000112>
        <obo:IAO_0000115>An observational cohort of people aged 80 years or older living in 72 nursing homes in France and Italy, recruited between January 2006 and June 2008 by four French and two Italian university hospital centres and followed for two years, to determine how well blood pressure and arterial stiffness predict mortality and major cardiovascular events in very old institutionalised people.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1126</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PARTAGE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PARTAGE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Predictive Values of Blood Pressure and Arterial Stiffness in Institutionalized Very Aged Population</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Predictive Values of Blood Pressure and Arterial Stiffness in Institutionalized Very Aged Population (PARTAGE) Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Predictive Values of Blood Pressure and Arterial Stiffness in Institutionalized Very Aged Population Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19153">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002235"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19153"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22999729+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The aim of the longitudinal PARTAGE study was to determine the predictive value of blood pressure (BP) and pulse pressure amplification, a marker of arterial function, for overall mortality (primary endpoint) and major cardiovascular (CV) events, in subjects older than 80 years of age living in a nursing home.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002235"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12746773/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were recruited by 4 French (Nancy, Dijon, Paris, and Toulouse) and 2 Italian (Cesena and Verona) university hospital centers between January 2006 and June 2008.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002235"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22999729</owl:annotatedTarget>
        <dcterms:title>Mortality and cardiovascular events are best predicted by low central/peripheral pulse pressure amplification but not by high blood pressure levels in elderly nursing home subjects: the PARTAGE (Predictive Values of Blood Pressure and Arterial Stiffness in Institutionalized Very Aged Population) study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22999729</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22999729+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The aim of the longitudinal PARTAGE study was to determine the predictive value of blood pressure (BP) and pulse pressure amplification, a marker of arterial function, for overall mortality (primary endpoint) and major cardiovascular (CV) events, in subjects older than 80 years of age living in a nursing home.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002235"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An observational cohort of people aged 80 years or older living in 72 nursing homes in France and Italy, recruited between January 2006 and June 2008 by four French and two Italian university hospital centres and followed for two years, to determine how well blood pressure and arterial stiffness predict mortality and major cardiovascular events in very old institutionalised people.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22999729</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41307346</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002235"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1126</owl:annotatedTarget>
        <obo:IAO_0000116>nursing-home residents aged 80+ enrolled</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:22999729</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1,126 subjects (874 women) who were living in French and Italian nursing homes were enrolled (mean age, 88 ± 5 years).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002235"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PARTAGE</owl:annotatedTarget>
