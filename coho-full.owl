        <owl:annotatedTarget rdf:nodeID="genid21248"/>
        <obo:IAO_0000116>ovarian cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2564/MediaObjects/41588_2013_BFng2564_MOESM8_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>United Kingdom Ovarian Cancer Population Study UKO United Kingdom (England, Wales and Northern Ireland) Population based/ Case-‐control 718 1123 98.1 702(353)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002511"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3650102/</oboInOwl:hasDbXref>
        <rdfs:comment>UKO United Kingdom Ovarian Cancer Population Study United Kingdom (England, Wales and Northern Ireland) Population</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002511"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000344</owl:annotatedTarget>
        <dcterms:title>European polygenic risk score for prediction of breast cancer shows similar performance in Asian women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32737321</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002511"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23360124</owl:annotatedTarget>
        <dcterms:title>Microarray Glycoprofiling of CA125 improves differential diagnosis of ovarian cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23360124</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23360124+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In a blinded cohort study of patients with an elevated CA125 levels (30-500 kU/L) and a pelvic mass from the UK Ovarian Cancer Population Study (UKOPS), we measured STn-CA125, ST-CA125 and STn-CA15-3.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002511"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of ovarian cancer run from University College London at hospitals in England, Wales and Northern Ireland, whose cases are women with an adnexal mass suspicious of ovarian cancer about to undergo surgery or with a confirmed or probable diagnosis of primary invasive or borderline ovarian cancer, and whose controls are women with a possibly benign or borderline adnexal mass and apparently healthy women from the multimodal screening arm of UKCTOCS, set up to find genetic risk factors, markers to add to CA125 and early symptoms of ovarian cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23513043</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.mrcctu.ucl.ac.uk/studies/all-studies/u/ukops</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002511"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">718</owl:annotatedTarget>
        <obo:IAO_0000116>UKOPS cases and controls passing genotyping QC in the 2013 OCAC study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2564/MediaObjects/41588_2013_BFng2564_MOESM8_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>United Kingdom Ovarian Cancer Population Study UKO United Kingdom (England, Wales and Northern Ireland) Population based/ Case-‐control 718 1123 98.1 702(353)</rdfs:comment>
    </owl:Axiom>
