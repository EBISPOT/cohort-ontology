        <rdfs:comment>The Tromsø Study is a population based health study of the Tromsø municipality of Northern Norway.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002431"/>
