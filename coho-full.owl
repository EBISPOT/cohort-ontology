        <oboInOwl:hasRelatedSynonym>Dutch HeFH Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Dutch heterozygous familial hypercholesterolemia screening program</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Dutch HeFH cohort</rdfs:label>
    </owl:NamedIndividual>
