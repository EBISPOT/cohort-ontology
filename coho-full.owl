    <!-- http://www.ebi.ac.uk/coho/COHO_0001643 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001643">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14802"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001419"/>
        <obo:IAO_0000112>PMID:29273806</obo:IAO_0000112>
        <obo:IAO_0000115>A genome-wide association sample of asthma from the north of the Netherlands, assembled by the Dutch Asthma Genetics Consortium in two phases that were genotyped separately and meta-analysed: a family-based phase whose asthmatic cases came from a trio and family study, with non-asthmatic spouses or the untransmitted alleles of the trios as controls, and a case–control phase whose asthmatics came from earlier clinical and genetic studies of the investigators&apos; research institute, with controls from COPACETIC, a population-based lung cancer screening study of male smokers. Cases had a physician&apos;s diagnosis of asthma, asthma symptoms and bronchial hyperresponsiveness; controls had no asthma, COPD or significant airway obstruction.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">915</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">986</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>DAG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Dutch Asthma GWAS study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Dutch Asthma GWAS</rdfs:label>
    </owl:NamedIndividual>
