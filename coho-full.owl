    <!-- http://www.ebi.ac.uk/coho/COHO_0000548 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000548">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid4826"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90624167</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of about 3,000 adult outpatients of self-reported Caucasian ethnicity with prevalent type 2 diabetes, recruited in 2010–2014 at two university-based study centres in Germany and followed with biennial visits, core phenotyping and biobanking for at least 10 years to study diabetes complications, with a primary focus on renal events.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>DIACORE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DIAbetes COhoRtE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">DIAbetes COhoRtE</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid4826">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000548"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4826"/>
        <obo:IAO_0000116>type 2 diabetes mellitus</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3577512/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>DIACORE is a prospective cohort study aiming to recruit 6000 patients of self-reported Caucasian ethnicity with prevalent DM2 for at least 10 years of follow-up.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000548"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6428304/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patient recruitment at the baseline visit (Visit 1) was performed from 2/2010 through 8/2014 in two University based study centers in Germany through direct written or spoken invitation to participate, press articles, flyers or public presentations (S1 Fig).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000548"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90624167</owl:annotatedTarget>
        <dcterms:title>A large-scale genome-wide study of gene-sleep duration interactions for blood pressure in 811,405 individuals from diverse populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40181193</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-025-02954-w/MediaObjects/41380_2025_2954_MOESM2_ESM.docx</oboInOwl:hasDbXref>
        <rdfs:comment>DIAbetes COhoRtE (DIACORE): is a German prospective cohort study of 3,000 adult European diabetes mellitus type 2 outpatients, with a primary focus on renal events.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000548"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of about 3,000 adult outpatients of self-reported Caucasian ethnicity with prevalent type 2 diabetes, recruited in 2010–2014 at two university-based study centres in Germany and followed with biennial visits, core phenotyping and biobanking for at least 10 years to study diabetes complications, with a primary focus on renal events.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23409726</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30897159</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000548"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3000</owl:annotatedTarget>
        <obo:IAO_0000116>adult type 2 diabetes outpatients recruited at baseline (2010-2014)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6428304/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We thus established the DIAbetes COhoRtE study (DIACORE) [21], a cohort study of 3000 patients with DM2.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000548"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DIACORE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000549 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000549">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid4833"/>
