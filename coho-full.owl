        <owl:annotatedTarget>HKDB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001354 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001354">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>GCST90704613</obo:IAO_0000112>
        <obo:IAO_0000115>A newly established community-based prospective cohort in Zhejiang Province, China, which since June 2021 has been enrolling participants from urban and rural areas at several project sites, among them people attending routine physical examinations, and collecting blood and serum at enrolment.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym HOPE also denotes Hormones and Ovarian Cancer Prediction Study (COHO:0001872); this term is Healthy Zhejiang One Million People Cohort.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HOPE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HOPE Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HOPE_Zhejiang</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Healthy Zhejiang One Million Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Healthy Zhejiang One Million People Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001354"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12561000/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The HOPE Cohort is a newly established community-based prospective cohort enrolling participants from both urban and rural areas in Zhejiang Province, China.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001354"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90704613</owl:annotatedTarget>
        <dcterms:title>Whole-genome Sequence Analysis Revealed Novel Subjective Cognitive Decline-associated Genes in 10,763 Chinese.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40728933</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40728933+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To address this gap, we investigated genetic biomarkers associated with SCD using whole-genome sequencing (WGS) in 10,763 Chinese participants from the Healthy Zhejiang One Million People Cohort (HOPE Cohort).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001354"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A newly established community-based prospective cohort in Zhejiang Province, China, which since June 2021 has been enrolling participants from urban and rural areas at several project sites, among them people attending routine physical examinations, and collecting blood and serum at enrolment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:40728933</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42324270</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
