    <!-- http://www.ebi.ac.uk/coho/COHO_0002606 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002606">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21935"/>
        <rdf:type rdf:nodeID="genid21937"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Greece"/>
        <obo:IAO_0000112>PMID:33407552</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based mother-child cohort of pregnant women living in the prefecture of Heraklion, Crete, Greece, recruited at their first major ultrasound examination around week 12 of gestation at four prenatal clinics in Heraklion from February 2007 to February 2008, and of their children, followed from early pregnancy towards young adulthood to study how environmental, dietary and other early-life exposures affect the health of mothers and children, with a focus on childhood obesity.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1458</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/RHEA</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>Mother-Child Cohort in Crete, Greece</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RHEA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RHEA - Mother Child Cohort in Crete, Greece</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Rhea cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Rhea mother-child cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Rhea pregnancy cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Rhea project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Rhea Study</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.rhea.gr/"/>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21935">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0050001"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid21937">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011122"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002606"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21935"/>
        <obo:IAO_0000116>Mediterranean diet</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/RHEA</oboInOwl:hasDbXref>
        <rdfs:comment>The uniqueness of this cohort is that it takes place in the island of Crete where the beneficial effect of the Mediterranean diet was first described during the Seven Countries Study of Cardiovascular Diseases, started at the end of the 1950s.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002606"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21937"/>
        <obo:IAO_0000116>childhood obesity</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/RHEA</oboInOwl:hasDbXref>
        <rdfs:comment>This has changed dramatically over the last 50 years, and the Rhea cohort was created in response to the rising concerns about the high rates of childhood obesity in Greece</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002606"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Greece"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4430416/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The present study is part of the “Rhea” project, a pregnancy cohort which examines prospectively a population-based cohort of pregnant women and their children at the prefecture of Heraklion, Crete, Greece</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33407552</owl:annotatedTarget>
        <dcterms:title>Prenatal metal mixtures and child blood pressure in the Rhea mother-child cohort in Greece.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33407552</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7789252/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The current study included 176 mother-child pairs from the Rhea Study in Heraklion, Greece</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based mother-child cohort of pregnant women living in the prefecture of Heraklion, Crete, Greece, recruited at their first major ultrasound examination around week 12 of gestation at four prenatal clinics in Heraklion from February 2007 to February 2008, and of their children, followed from early pregnancy towards young adulthood to study how environmental, dietary and other early-life exposures affect the health of mothers and children, with a focus on childhood obesity.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25970502</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33407552</obo:IAO_0000119>
