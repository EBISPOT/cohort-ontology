        <rdfs:comment>After these exclusions, a total of 3,686 subjects (1,657 cases and 2,029 controls) were included for the final analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001033"/>
