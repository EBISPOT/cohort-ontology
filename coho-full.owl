    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002481"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21062"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24423220+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>An overview of the LASER-AD study: a longitudinal epidemiological study of people with Alzheimer&apos;s disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002481"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4360590/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We calculated National Health Service (NHS) and personal social services (PSS) costs associated with different levels of agitation using data from a naturalistic prospective cohort study of people with AD, covering the London and the South East Region of the UK (LASER-AD study).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002481"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000026</owl:annotatedTarget>
        <dcterms:title>Polygenic risk and hazard scores for Alzheimer&apos;s disease prediction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30911569</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002481"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:19734902</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies variants at CLU and PICALM associated with Alzheimer&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:19734902</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2845877/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>LASER-AD was funded by Lundbeck SA.</rdfs:comment>
