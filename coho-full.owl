    <!-- http://www.ebi.ac.uk/coho/COHO_0002011 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002011">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17630"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS000769</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:22792082</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised, double-blind trial of the American Lung Association Asthma Clinical Research Centers, run at centres in the United States from 2003 to 2006, in which people whose asthma was well controlled on twice-daily low-dose inhaled fluticasone were assigned to continue it or to switch to once-daily montelukast or once-daily fluticasone plus salmeterol for 16 weeks, to test whether treatment could be stepped down without loss of asthma control.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">500</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>LOCCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leukotriene Modifier Or Corticosteroid or Corticosteroid-Salmeterol trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leukotriene Modifier or Corticosteroid Salmeterol study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leukotriene Modifier or Corticosteroid or Corticosteroid-Salmeterol</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leukotriene Modifier, or Corticosteroid Salmeterol study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Leukotriene Modifier Or Corticosteroid or Corticosteroid-Salmeterol Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17630">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002011"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17630"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17507702+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We randomly assigned 500 patients with asthma that was well controlled by inhaled fluticasone (100 microg twice daily) to receive continued fluticasone (100 microg twice daily) (169 patients), montelukast (5 or 10 mg each night) (166 patients), or fluticasone (100 microg) plus salmeterol (50 microg) each night (165 patients).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002011"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3816372/</oboInOwl:hasDbXref>
        <rdfs:comment>Institutions at which the work was performed: Baylor College of Medicine, Houston, TX Columbia University-New York University Consortium, New York, NY Duke University Medical Center, Durham, NC Emory University School of Medicine, Atlanta, GA</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000769</owl:annotatedTarget>
        <dcterms:title>Pharmacogenetic Polygenic Risk Score for Bronchodilator Response in Children and Adolescents with Asthma: Proof-of-Concept.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33923870</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22792082</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analysis in asthma subjects identifies SPATS2L as a novel bronchodilator response gene.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22792082</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22792082+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A genome-wide association study (GWAS) of BDR, quantified as percent change in baseline FEV(1) after administration of a β(2)-agonist, was performed with 1,644 non-Hispanic white asthmatic subjects from six drug clinical trials: CAMP, LOCCS, LODO, a medication trial conducted by Sepracor, CARE, and ACRN.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002011"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised, double-blind trial of the American Lung Association Asthma Clinical Research Centers, run at centres in the United States from 2003 to 2006, in which people whose asthma was well controlled on twice-daily low-dose inhaled fluticasone were assigned to continue it or to switch to once-daily montelukast or once-daily fluticasone plus salmeterol for 16 weeks, to test whether treatment could be stepped down without loss of asthma control.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17507702</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26083242</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT00156819</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002011"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">500</owl:annotatedTarget>
        <obo:IAO_0000116>patients with well-controlled asthma randomised in the trial</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17507702+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We randomly assigned 500 patients with asthma that was well controlled by inhaled fluticasone (100 microg twice daily) to receive continued fluticasone (100 microg twice daily) (169 patients), montelukast (5 or 10 mg each night) (166 patients), or fluticasone (100 microg) plus salmeterol (50 microg) each night (165 patients).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002011"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LOCCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


