        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2957428/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The participants of GenoMEL in Boston, United States</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001335"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90103971</owl:annotatedTarget>
        <dcterms:title>Multi-Trait Genetic Analysis Identifies Autoimmune Loci Associated with Cutaneous Melanoma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34813871</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://ars.els-cdn.com/content/image/1-s2.0-S0022202X21025136-mmc1.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>European GenoMEL Phase 1 1,075 2,163 Illumina 317k</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001335"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international non-profit consortium, established in 1997, of most of the research groups working on the genetics of familial melanoma, in Europe, North America, Australia and elsewhere, funded by the European Commission&apos;s Sixth Framework Programme and the US National Cancer Institute, which pools data and samples from its members&apos; melanoma-prone families and case–control series to find melanoma susceptibility genes and how they interact with environmental factors such as ultraviolet radiation. Its genome-wide association study combined melanoma cases, prioritised for family history, multiple primaries or early onset, and controls from the same populations, contributed by member groups in Europe, Israel and Australia, with French and UK population controls.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20876876</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21983787</obo:IAO_0000119>
        <obo:IAO_0000119>https://genomel.org/about/</obo:IAO_0000119>
