        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002542"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21437"/>
