        <oboInOwl:hasRelatedSynonym>Tasmania Older Adult Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tasmanian Older Adult Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tasmanian older adult cohort study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Tasmanian Older Adult Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20979">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005178"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002463"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20979"/>
        <obo:IAO_0000116>osteoarthritis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC552310/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Tasmanian Older Adult Cohort Study (TASOAC), an ongoing prospective population-based study aimed at identifying the environmental, genetic, and biochemical factors associated with the development and progression of OA at multiple sites (hand, knee, hip, and spine), which commenced in 2002.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002463"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
