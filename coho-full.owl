        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001248"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based, cohort-sequential longitudinal study of European-ancestry twin pairs born in 1974-1983, ascertained at ages 8 to 16 through the state and participating private schools of Virginia, United States, who with their parents were assessed by psychiatric interviews and questionnaires in four waves about 18 months apart and again in their mid-20s, to study genetic and environmental influences on the development of child and adolescent psychopathology and substance use.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23461817</obo:IAO_0000119>
