        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28604730</owl:annotatedTarget>
        <dcterms:title>Large-scale association analysis identifies new lung cancer susceptibility loci and heterogeneity in genetic susceptibility across histological subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28604730</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Molecular Epidemiology of Lung Cancer Survival: The Total Lung Cancer (TLC) Study is a hospital-based study that included 458 lung cancer patients recruited for Moffitt Cancer Center’s Total Cancer Care™ protocol between April 2006 and August 2010.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002458"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based, case-only study of the molecular epidemiology of lung cancer survival at the H. Lee Moffitt Cancer Center in Tampa, Florida, United States, whose participants are lung cancer patients recruited from Moffitt&apos;s Thoracic Oncology Clinic between April 2006 and August 2010 under the centre&apos;s Total Cancer Care protocol, which collects self-reported, medical record and cancer registry data and blood samples.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23839018</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28604730</obo:IAO_0000119>
