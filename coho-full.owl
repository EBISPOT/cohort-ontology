    <!-- http://www.ebi.ac.uk/coho/COHO_0001708 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001708">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15291"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000954"/>
        <obo:IAO_0000112>PMID:18454148</obo:IAO_0000112>
        <obo:IAO_0000115>A German cross-sectional study of early-onset extreme obesity, made up of a case-control study of extremely obese children and adolescents recruited in hospitals specialised in the inpatient treatment of extreme obesity, with healthy lean controls ascertained at the University of Marburg, and a nuclear family study of obese children and adolescents ascertained in the same way together with both their biological parents (the Essen Obesity Trios), whose genotypes have been used in genome-wide association studies of obesity and body mass index.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">487</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">442</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>ESSEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Essen Obesity study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Essen Obesity Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15291">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011122"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001708"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15291"/>
        <obo:IAO_0000116>early onset extreme obesity</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2137937/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>487 extremely obese children and adolescents (‘cases’) were recruited in hospitals specialized for the inpatient treatment of extreme obesity (Table 2; mean BMI Z score: 4.63±2.27) while 442 healthy lean individuals (‘controls’) were ascertained at the University of Marburg (Table 2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001708"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2137937/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>for early onset extreme obesity based on 487 extremely obese young German individuals and 442 healthy lean German controls</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001708"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:18454148</owl:annotatedTarget>
        <dcterms:title>Common variants near MC4R are associated with fat mass, weight and risk of obesity.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:18454148</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2669167/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Genotypes for a fourth study of childhood BMI (Essen Obesity Study, n = 929) were available from their genome-wide association data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001708"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A German cross-sectional study of early-onset extreme obesity, made up of a case-control study of extremely obese children and adolescents recruited in hospitals specialised in the inpatient treatment of extreme obesity, with healthy lean controls ascertained at the University of Marburg, and a nuclear family study of obese children and adolescents ascertained in the same way together with both their biological parents (the Essen Obesity Trios), whose genotypes have been used in genome-wide association studies of obesity and body mass index.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18159244</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18454148</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fng.2247/MediaObjects/41588_2012_BFng2247_MOESM24_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001708"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">487</owl:annotatedTarget>
        <obo:IAO_0000116>extremely obese children and adolescents (cases) and lean controls of the case-control GWAS sample; the trio part of the study is not counted</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2137937/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>487 extremely obese children and adolescents (‘cases’) were recruited in hospitals specialized for the inpatient treatment of extreme obesity (Table 2; mean BMI Z score: 4.63±2.27) while 442 healthy lean individuals (‘controls’) were ascertained at the University of Marburg (Table 2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001708"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">442</owl:annotatedTarget>
        <obo:IAO_0000116>extremely obese children and adolescents (cases) and lean controls of the case-control GWAS sample; the trio part of the study is not counted</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2137937/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>487 extremely obese children and adolescents (‘cases’) were recruited in hospitals specialized for the inpatient treatment of extreme obesity (Table 2; mean BMI Z score: 4.63±2.27) while 442 healthy lean individuals (‘controls’) were ascertained at the University of Marburg (Table 2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001708"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ESSEN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


