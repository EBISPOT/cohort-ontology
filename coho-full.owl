    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000229"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2311"/>
        <obo:IAO_0000116>trauma-induced subglottic stenosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS50000000879</oboInOwl:hasDbXref>
        <rdfs:comment>In this study, we prospectively enrolled patients with iSGS, trauma-induced subglottic stenosis, and controls to investigate the clinical, transcriptional, and genetic features that may be associated with disease pathogenesis and treatment outcomes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000229"/>
