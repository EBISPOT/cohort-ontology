    <owl:Restriction rdf:nodeID="genid20157">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002369"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20155"/>
        <obo:IAO_0000116>breast carcinoma in situ</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8075208/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Eligibility is assessed with the following criteria: (1) a diagnosis of breast carcinoma in situ or invasive breast cancer; (2) citizens or permanent residents of Singapore; and (3) aged 21 years and above.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002369"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20157"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8075208/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Eligibility is assessed with the following criteria: (1) a diagnosis of breast carcinoma in situ or invasive breast cancer; (2) citizens or permanent residents of Singapore; and (3) aged 21 years and above.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002369"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33901219+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The cohort comprises of breast cancer patients aged 21 years and above from six public hospitals which diagnose and treat nearly 76% breast cancer cases in Singapore.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002369"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000344</owl:annotatedTarget>
        <dcterms:title>European polygenic risk score for prediction of breast cancer shows similar performance in Asian women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32737321</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002369"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33901219</owl:annotatedTarget>
        <dcterms:title>Cohort profile: The Singapore Breast Cancer Cohort (SGBCC), a multi-center breast cancer cohort for evaluation of phenotypic risk factors and genetic markers.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33901219</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33901219+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This article aims to provide a detailed description of the Singapore Breast Cancer Cohort (SGBCC), an ongoing multi-ethnic cohort established with the overarching goal to identify genetic markers for breast cancer risk, prognosis and treatment response, as well as to understand the ethnic differences in disease risk and outcome in an Asian setting.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002369"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing multi-ethnic cohort of breast cancer patients aged 21 years and over who are citizens or permanent residents of Singapore, recruited from April 2010 at the National University Hospital and later at five other public tertiary hospitals in Singapore, with retrospective and prospective components, questionnaire, medical record and biospecimen data and follow-up through linkage with the Registry of Births and Deaths, established to identify genetic markers of breast cancer risk, prognosis and treatment response and to study ethnic differences in breast cancer risk and outcome in Asia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33901219</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002369"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7768</owl:annotatedTarget>
        <obo:IAO_0000116>SGBCC breast cancer patients recruited as of 31 December 2016</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8075208/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As of 31 December 2016, 7,768 subjects have been recruited to the study with 76% subjects contributed bio-specimens.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002369"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7768</owl:annotatedTarget>
        <obo:IAO_0000116>SGBCC breast cancer patients recruited as of 31 December 2016</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8075208/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As of 31 December 2016, 7,768 subjects have been recruited to the study with 76% subjects contributed bio-specimens.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002369"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SGBCC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002370 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002370">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20166"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000116"/>
        <obo:IAO_0000112>PMID:11424985</obo:IAO_0000112>
        <obo:IAO_0000115>A family collection of the US National Institute of Mental Health Genetics Initiative, a multisite study set up as a national resource with a centralised clinical database and cell repository, in which Washington University, Harvard University and Columbia University ascertained, from 1991 to 1997, nuclear families of European and African ancestry with siblings affected by schizophrenia or schizoaffective disorder, for genetic linkage and association studies of schizophrenia; its cases later formed one of the three collections of the Molecular Genetics of Schizophrenia genome-wide association study.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">244</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NIMH Genetics Initiative on Schizophrenia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIMH-SGI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Institute of Mental Health (NIMH) Schizophrenia Genetics Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Institute of Mental Health Schizophrenia Genetics Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SGI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Schizophrenia Genetics Initiative</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">NIMH Schizophrenia Genetics Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20166">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005090"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002370"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20166"/>
        <obo:IAO_0000116>schizophrenia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature08192/MediaObjects/41586_2009_BFnature08192_MOESM270_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly: SGI subjects (2.4%) were recruited by three research groups in the United States (see Acknowledgments) in a study designed to collect families with affected sibling pairs (and other affected members when available), ascertaining through probands with schizophrenia recruited through clinical settings.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002370"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature08192/MediaObjects/41586_2009_BFnature08192_MOESM270_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly: SGI subjects (2.4%) were recruited by three research groups in the United States (see Acknowledgments) in a study designed to collect families with affected sibling pairs (and other affected members when available), ascertaining through probands with schizophrenia recruited through clinical settings.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002370"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:11424985</owl:annotatedTarget>
        <dcterms:title>Linkage disequilibrium for schizophrenia at the chromosome 15q13-14 locus of the alpha7-nicotinic acetylcholine receptor subunit gene (CHRNA7).</dcterms:title>
        <oboInOwl:hasDbXref>PMID:11424985</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11424985+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The transmission/disequilibrium test was used for fine mapping of the linkage of schizophrenia to the chromosome 15q13-14 region, the site of a candidate gene, the alpha7 nicotinic acetylcholine receptor subunit gene (CHRNA7), in parent-child triads from the NIMH Schizophrenia Genetics Initiative families.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002370"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family collection of the US National Institute of Mental Health Genetics Initiative, a multisite study set up as a national resource with a centralised clinical database and cell repository, in which Washington University, Harvard University and Columbia University ascertained, from 1991 to 1997, nuclear families of European and African ancestry with siblings affected by schizophrenia or schizoaffective disorder, for genetic linkage and association studies of schizophrenia; its cases later formed one of the three collections of the Molecular Genetics of Schizophrenia genome-wide association study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23936182</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9674971</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9674973</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000167.v1.p1</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002370"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">244</owl:annotatedTarget>
        <obo:IAO_0000116>members of the nuclear families of 92 affected sib pairs in the 1998 genome scan (analysed sample; the collection grew later)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9674971+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Millennium Schizophrenia Consortium has completed a genome-wide scan to detect susceptibility loci for schizophrenia in 244 individuals from the nuclear families of 92 independent pairs of schizophrenic sibs ascertained by the NIMH Genetics Initiative.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002370"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NIMH-SGI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002370"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SGI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


