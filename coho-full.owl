    <!-- http://www.ebi.ac.uk/coho/COHO_0000761 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000761">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sri_Lanka"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002430"/>
        <obo:IAO_0000112>GCST90132186</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based cohort of adults aged 35–64 years recruited in 2007 by age-stratified random sampling in the semi-urban Ragama Medical Officer of Health area of Gampaha district, Sri Lanka, with baseline socio-demographic, lifestyle, anthropometric, biochemical and clinical data and follow-up of mortality and its predictors.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2985</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>RHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Ragama Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000761"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sri_Lanka"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32994253+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>ObjectiveTo describe patterns and predictors of mortality in a semi-urban population in Sri Lanka.DesignA prospective population-based cohort study.SettingRagama Medical Officer of Health area in the Gampaha district, Sri Lanka.ParticipantsAdults between 35 and 64 years of age were recruited using an age stratified random sampling technique in 2007.MeasuresAt baseline, we recorded socio-demographic, lifestyle, anthropometric, biochemical and clinical data of the participants.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000761"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90132186</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genetic study of type 2 diabetes highlights the power of diverse populations for discovery and translation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35551307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9179018/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>South Asian studies of Sri Lankan, Bangladeshi and South Indian ancestry (RHS, EPIDREAM, SINDI, GRCCDS and BPC) from those of North Indian and Pakistani ancestry; and Northern European ancestry studies from the study of Greek ancestry from Southern Europe (GOMAP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000761"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of adults aged 35–64 years recruited in 2007 by age-stratified random sampling in the semi-urban Ragama Medical Officer of Health area of Gampaha district, Sri Lanka, with baseline socio-demographic, lifestyle, anthropometric, biochemical and clinical data and follow-up of mortality and its predictors.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32994253</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000761"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2985</owl:annotatedTarget>
        <obo:IAO_0000116>recruited adults with complete baseline data followed as the RHS cohort (2008)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:32994253</oboInOwl:hasDbXref>
        <rdfs:comment>At the baseline assessment 2985 of the recruited participants had complete data and were followed-up as the Ragama Health Study (RHS) cohort.</rdfs:comment>
    </owl:Axiom>
