        <rdfs:comment>The Fingesture study included all victims of sudden death that were determined to be due to cardiac disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001726"/>
