        <rdf:type rdf:nodeID="genid12854"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <obo:IAO_0000112>GCST90432152</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, hospital-based longitudinal registry, started in 2019, of consecutive individuals with abdominal aortic aneurysm seen at the vascular and endovascular surgery units of the Hospital de la Santa Creu i Sant Pau and the Hospital del Mar in Barcelona, Spain, with aortic diameter measurements by CT or ultrasound, clinical data and DNA, RNA and plasma samples collected at follow-up visits, to study aneurysm growth and its predictors and to inform surveillance intervals.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">471</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TABS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Triple-A Barcelona Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Triple A Barcelona Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12854">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005350"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001418"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12854"/>
        <obo:IAO_0000116>abdominal aortic aneurysm</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40649094+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We present the Triple-A Barcelona Study (TABS), a new hospital-based longitudinal study recruiting consecutive individuals with AAAs in Barcelona.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001418"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10632148/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>TABS: The Triple A Barcelona Study (TABS) is a hospital-based study recruiting individuals with AAA treated in the Hospital de la Santa Creu i Sant Pau in Barcelona, Spain.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001418"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90432152</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis identifies risk loci for abdominal aortic aneurysm and highlights PCSK9 as a therapeutic target.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37845353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10632148/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>TABS: The Triple A Barcelona Study (TABS) is a hospital-based study recruiting individuals with AAA treated in the Hospital de la Santa Creu i Sant Pau in Barcelona, Spain.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001418"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, hospital-based longitudinal registry, started in 2019, of consecutive individuals with abdominal aortic aneurysm seen at the vascular and endovascular surgery units of the Hospital de la Santa Creu i Sant Pau and the Hospital del Mar in Barcelona, Spain, with aortic diameter measurements by CT or ultrasound, clinical data and DNA, RNA and plasma samples collected at follow-up visits, to study aneurysm growth and its predictors and to inform surveillance intervals.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37845353</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40649094</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001418"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">471</owl:annotatedTarget>
        <obo:IAO_0000116>individuals with AAA included, 2019 to March 2025</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12250419/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Cohort DescriptionA total of 471 individuals, 454 males and 17 females (3.6%), with AAA were included.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001418"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TABS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


