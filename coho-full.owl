        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. HPFS3 is the third Health Professionals Follow-up Study case-control set of the colorectal cancer GWAS of PMID:29917119, beside NHS3. The Catalog&apos;s name for it, Prospective cohort of men (USA), is generic and is not carried over. Replaced by COHO:0000527 (Health Professionals Follow-up Study), which now carries this term&apos;s names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Prospective cohort of men (USA)</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001874 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001874">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
