        <obo:IAO_0000112>PGS000004</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:32665703</obo:IAO_0000112>
        <obo:IAO_0000115>An international collaborative prospective cohort study of carriers of BRCA1 or BRCA2 pathogenic variants that pools nationwide and centre-based carrier studies, including EMBRACE in the United Kingdom and Ireland, GENEPSO in France and HEBON in the Netherlands and smaller studies in other European countries and Quebec, Canada; participants were recruited from cancer genetics centres between 1997 and 2011 and followed actively by questionnaire and, where possible, by pathology, cancer and death registry linkage and medical records, to study breast and ovarian cancer risks and their modifiers in carriers.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1593</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>IBCCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International BRCA1/2 carirer cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">International BRCA1/2 Carrier Cohort Study</rdfs:label>
    </owl:NamedIndividual>
