    <!-- http://www.ebi.ac.uk/coho/COHO_0002357 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002357">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20075"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:26237428</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of Barrett&apos;s oesophagus and reflux-related conditions in Brisbane, Australia, whose cases were residents of metropolitan Brisbane aged 18 to 79 with a new histologically confirmed diagnosis of Barrett&apos;s oesophagus, with or without dysplasia, between February 2003 and June 2006, identified through the pathology laboratories serving the city, and whose controls were people randomly selected from the Australian electoral roll and matched to the cases by age and sex, together with endoscopy patients whose biopsies showed only oesophageal inflammation consistent with reflux and no Barrett&apos;s oesophagus.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">393</coho:numberOfCases>
        <oboInOwl:hasRelatedSynonym>SDH</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Study of Digestive Health</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20075">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0013662"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002357"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20075"/>
        <obo:IAO_0000116>Barrett&apos;s esophagus</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4474428/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, SDH included cases aged 18–79 years with newly diagnosed Barrett’s esophagus (confirmed by histology as specialized intestinal metaplasia in a biopsy from the tubular esophagus).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002357"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4474428/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study, entitled the Barrett’s Oesophagus Metabolic Study (BOMS), was nested within the Study of Digestive Health (SDH), a population-based study conducted in Brisbane, Australia between February 1, 2003 and June 30, 2006.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002357"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:26237428</owl:annotatedTarget>
        <dcterms:title>Genome-wide meta-analysis identifies five new susceptibility loci for cutaneous malignant melanoma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:26237428</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3373/MediaObjects/41588_2015_BFng3373_MOESM50_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>691 Q-MEGA cases genotyped on the Omni1-Quad array were combined with 553 healthy controls genotyped on the same array from the Study of Digestive Health (SDH)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002357"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of Barrett&apos;s oesophagus and reflux-related conditions in Brisbane, Australia, whose cases were residents of metropolitan Brisbane aged 18 to 79 with a new histologically confirmed diagnosis of Barrett&apos;s oesophagus, with or without dysplasia, between February 2003 and June 2006, identified through the pathology laboratories serving the city, and whose controls were people randomly selected from the Australian electoral roll and matched to the cases by age and sex, together with endoscopy patients whose biopsies showed only oesophageal inflammation consistent with reflux and no Barrett&apos;s oesophagus.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16284367</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22787114</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26090820</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002357"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">393</owl:annotatedTarget>
        <obo:IAO_0000116>Barrett&apos;s oesophagus cases who completed the study, 2003-2006 (no total or control count stated for the whole study)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3750988/</oboInOwl:hasDbXref>
        <rdfs:comment>Thus, 393 BE cases (285 nondysplastic, 108 dysplastic) completed the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002357"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SDH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002358 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002358">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20082"/>
        <rdf:type rdf:nodeID="genid20084"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001275"/>
        <obo:IAO_0000112>PMID:22961080</obo:IAO_0000112>
        <obo:IAO_0000115>The inpatient database of the Shanghai Diabetes Institute at Shanghai Jiao Tong University Affiliated Sixth People&apos;s Hospital, Shanghai, China: Han Chinese inpatients of the hospital&apos;s Department of Endocrinology and Metabolism, recruited from 2001, with type 2 diabetes, type 1 diabetes or genetic syndromes related to diabetes, for whom detailed phenotypes of glucose and lipid metabolism, blood pressure, liver and kidney function and diabetic complications were collected. Its type 2 diabetes patients have served as cases, with controls from the community-based Shanghai Diabetes Studies, in genetic association studies of type 2 diabetes and its complications.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5950</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SDIID</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SHDIID</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Shanghai DIabetes Inpatient Database</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Shanghai Diabetes Inpatient Database</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Shanghai Diabetes Institute inpatient database</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Shanghai Diabetes Institute Inpatient Database</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20082">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005147"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid20084">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002358"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20082"/>
        <obo:IAO_0000116>type 1 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The current study included 5,950 patients of type 1 diabetes, T2D or some genetic syndromes related to diabetes (e.g., Parder Willi, Rabson Manderhall).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002358"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20084"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The current study included 5,950 patients of type 1 diabetes, T2D or some genetic syndromes related to diabetes (e.g., Parder Willi, Rabson Manderhall).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002358"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>All participants are Chinese Han ancestry residing in Shanghai area.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002358"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22961080</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study identifies GRK5 and RASGRP1 as type 2 diabetes loci in Chinese Hans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22961080</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526061/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The stage 3 replication testing of 10 SNPs is carried out by de novo genotyping in 3,410 T2D patients and 3,412 nondiabetic control subjects from the Shanghai Diabetes Inpatient Database (SDIID) and the Shanghai Diabetes Study (SDS) and in silico replication in the AGEN-T2D GWAS datasets (6,952 T2D case and 11,865 control subjects).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002358"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The inpatient database of the Shanghai Diabetes Institute at Shanghai Jiao Tong University Affiliated Sixth People&apos;s Hospital, Shanghai, China: Han Chinese inpatients of the hospital&apos;s Department of Endocrinology and Metabolism, recruited from 2001, with type 2 diabetes, type 1 diabetes or genetic syndromes related to diabetes, for whom detailed phenotypes of glucose and lipid metabolism, blood pressure, liver and kidney function and diabetic complications were collected. Its type 2 diabetes patients have served as cases, with controls from the community-based Shanghai Diabetes Studies, in genetic association studies of type 2 diabetes and its complications.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19937226</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21911749</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22961080</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002358"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5950</owl:annotatedTarget>
        <obo:IAO_0000116>Patients in the SHDIID inpatient database described in the 2012 profile</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The current study included 5,950 patients of type 1 diabetes, T2D or some genetic syndromes related to diabetes (e.g., Parder Willi, Rabson Manderhall).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002358"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SDIID</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002358"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SHDIID</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
