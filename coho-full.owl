    <!-- http://www.ebi.ac.uk/coho/COHO_0001606 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001606">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14493"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Colombia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Mexico"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>PMID:31553449</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control study of breast cancer in Latin American women, led by investigators at the Universidad del Tolima in Ibagué, Colombia, and the University of California, Davis. From 2011 it recruited women with incident invasive breast cancer, through population cancer registries and large cancer hospitals in Bogotá, Ibagué and Neiva in central Colombia and Pasto in the south, together with cancer-free controls from the same institutions matched on education, socioeconomic status and local origin. A Mexican arm comprises cases diagnosed from 2010 at the Social Security hospital in Mexico City, with blood-donor controls from the same hospital. The study investigates inherited and environmental causes of breast cancer, and its Colombian and Mexican arms, genotyped on different arrays, are analysed as separate datasets.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">955</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1053</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>COLUMBUS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COLUMBUS Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Colombian Study of Environmental and Heritable Causes of Breast Cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Post Columbian Study of Environmental and Heritable Causes of Breast Cancer</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Post-Columbian Study of Environmental and Heritable Causes of Breast Cancer</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14493">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001606"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14493"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4204111/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>COLUMBUS is a population-based case–control study of breast cancer conducted in four cities: Bogota, Ibague and Neiva, from the Central Colombian Andes region, and Pasto, from the Colombian South.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001606"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Mexico"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11799839/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Post-Columbian Study of Environmental and Heritable Causes of Breast Cancer (COLUMBUS) is a case–control study of breast cancer with individuals recruited throughout large cancer hospitals in central and southern Colombia and Mexico City.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:31553449</owl:annotatedTarget>
        <dcterms:title>A Polygenic Risk Score for Breast Cancer in US Latinas and Latin American Women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31553449</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7301155/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Post-Columbian Study of Environmental and Heritable Causes of Breast Cancer (COLUMBUS) is a case-control study of breast cancer with individuals recruited throughout large cancer hospitals in central and 3 southern Colombia and Mexico City.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case–control study of breast cancer in Latin American women, led by investigators at the Universidad del Tolima in Ibagué, Colombia, and the University of California, Davis. From 2011 it recruited women with incident invasive breast cancer, through population cancer registries and large cancer hospitals in Bogotá, Ibagué and Neiva in central Colombia and Pasto in the south, together with cancer-free controls from the same institutions matched on education, socioeconomic status and local origin. A Mexican arm comprises cases diagnosed from 2010 at the Social Security hospital in Mexico City, with blood-donor controls from the same hospital. The study investigates inherited and environmental causes of breast cancer, and its Colombian and Mexican arms, genotyped on different arrays, are analysed as separate datasets.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25327703</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31553449</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39625644</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001606"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">955</owl:annotatedTarget>
        <obo:IAO_0000116>Colombian arm only: cases diagnosed 2011-2017 and controls in the 2024 PRS analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:39625644</oboInOwl:hasDbXref>
        <rdfs:comment>In the COLUMBUS-Colombia study, we included 955 breast cancer cases diagnosed from 2011 to 2017, ages 21 to 88 years, and 1,053 controls who did not have first-degree relatives with breast cancer and matched controls with cases by recruiting hospital, education level, socioeconomic status, and local origin data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001606"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1053</owl:annotatedTarget>
        <obo:IAO_0000116>Colombian arm only: cases diagnosed 2011-2017 and controls in the 2024 PRS analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:39625644</oboInOwl:hasDbXref>
        <rdfs:comment>In the COLUMBUS-Colombia study, we included 955 breast cancer cases diagnosed from 2011 to 2017, ages 21 to 88 years, and 1,053 controls who did not have first-degree relatives with breast cancer and matched controls with cases by recruiting hospital, education level, socioeconomic status, and local origin data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001606"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>COLUMBUS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001607 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001607">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14501"/>
        <rdf:type rdf:nodeID="genid14503"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:28598434</obo:IAO_0000112>
        <obo:IAO_0000115>A kidney cancer study run by Cancer Council Victoria with QIMR Berghofer, the Victorian and Queensland cancer registries and hospitals and familial cancer clinics across Australia; its Queensland arm is called the CARE Study. Its population-based case–control family component recruited, through the Victorian and Queensland cancer registries, people diagnosed in 2009–2015, at age 18–74, with histologically confirmed renal cell carcinoma, with siblings and partners of cases as controls. The study also enrolled people with a strong family history of kidney cancer or a hereditary kidney cancer syndrome. Participants completed questionnaires on health, lifestyle and family and medical history and gave blood, so that lifestyle, environmental and genetic causes of kidney cancer could be investigated.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1424</coho:numberOfCases>
        <oboInOwl:hasRelatedSynonym>CARES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CONFIRM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CONFIRM Kidney Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ConFIRM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Consortium For the Investigation of Renal Malignancies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>conFIRM</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Consortium for the Investigation of Renal Malignancies</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14501">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002367"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid14503">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005086"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001607"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14501"/>
        <obo:IAO_0000116>kidney cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11393909/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study included Australian residents diagnosed between 2009 and 2015 with a histologically confirmed RCC (ICD-10 C64) at age 18–74 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001607"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14503"/>
        <obo:IAO_0000116>renal cell carcinoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11393909/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study included Australian residents diagnosed between 2009 and 2015 with a histologically confirmed RCC (ICD-10 C64) at age 18–74 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001607"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11393909/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study included Australian residents diagnosed between 2009 and 2015 with a histologically confirmed RCC (ICD-10 C64) at age 18–74 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001607"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28598434</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies multiple risk loci for renal cell carcinoma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28598434</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5472706/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>ConFIRM/MCCS The ConFIRM study, also known as CARES, was supported by the Victorian Cancer Agency (PTCB08_05), the Australian National Health and Medical Research Council (Project Grant 1011626).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001607"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A kidney cancer study run by Cancer Council Victoria with QIMR Berghofer, the Victorian and Queensland cancer registries and hospitals and familial cancer clinics across Australia; its Queensland arm is called the CARE Study. Its population-based case–control family component recruited, through the Victorian and Queensland cancer registries, people diagnosed in 2009–2015, at age 18–74, with histologically confirmed renal cell carcinoma, with siblings and partners of cases as controls. The study also enrolled people with a strong family history of kidney cancer or a hereditary kidney cancer syndrome. Participants completed questionnaires on health, lifestyle and family and medical history and gave blood, so that lifestyle, environmental and genetic causes of kidney cancer could be investigated.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28598434</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34562747</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39272843</obo:IAO_0000119>
        <obo:IAO_0000119>https://web.archive.org/web/20221025011857/https://www.cancervic.org.au/research/epidemiology/cec-programs/confirm.html</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001607"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1424</owl:annotatedTarget>
        <obo:IAO_0000116>registry-identified RCC cases (diagnosed 2009-2015) who consented; controls not counted</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:39272843</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 3113 individuals diagnosed with RCC who were invited to participate in CONFIRM, 1424 provided consent.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001607"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CARES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001607"/>
