        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>RBCS Rotterdam Breast Cancer Study 36 Netherlands Familial breast cancer patients selected from the clinical genetics center at Erasmus Medical Center between 1994-2005 Spouses or mutation-negative siblings of heterozygous Cystic Fibrosis mutation carriers selected from the clinical genetics centre at Erasmus Medical Center between 1996-2006</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002309"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS001778</owl:annotatedTarget>
        <dcterms:title>Combination of a 15-SNP Polygenic Risk Score and Classical Risk Factors for the Prediction of Breast Cancer Risk in Cypriot Women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34572793</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002309"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22267197</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analysis identifies three new breast cancer susceptibility loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22267197</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>RBCS Rotterdam Breast Cancer Study 36 Netherlands Familial breast cancer patients selected from the clinical genetics center at Erasmus Medical Center between 1994-2005 Spouses or mutation-negative siblings of heterozygous Cystic Fibrosis mutation carriers selected from the clinical genetics centre at Erasmus Medical Center between 1996-2006</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002309"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based breast cancer case-control study in the southwest of the Netherlands, whose cases are index patients from families with breast or breast and ovarian cancer counselled at the Clinical Genetics Centre of Erasmus University Medical Centre in Rotterdam from 1994, and whose geographically matched controls are women from cystic fibrosis families counselled at the same centre; it is one of the studies of the Breast Cancer Association Consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22267197</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.nature.com/articles/srep30026</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002309"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2751</owl:annotatedTarget>
        <obo:IAO_0000116>RBCS BRCA1/2-negative index cases counselled 1994-2014 and geographically matched control women counselled 1996-2010</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.nature.com/articles/srep30026</oboInOwl:hasDbXref>
        <rdfs:comment>RBCS cases (N = 2,751) were selected from the database of the Clinical Genetics Centre at Erasmus University Medical Centre in Rotterdam, representing the Southwestern part of the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002309"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1159</owl:annotatedTarget>
        <obo:IAO_0000116>RBCS BRCA1/2-negative index cases counselled 1994-2014 and geographically matched control women counselled 1996-2010</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.nature.com/articles/srep30026</oboInOwl:hasDbXref>
        <rdfs:comment>The RBCS control population (N = 1,159) was geographically matched and included women from cystic fibrosis families who were either spouses of individuals at risk of being carrier of a CFTR mutation or individuals who were tested negative for a CFTR mutation and were counselled between 1996 and 2010.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002309"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RBCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002310 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002310">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19731"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000103"/>
        <obo:IAO_0000112>PMID:22085902</obo:IAO_0000112>
        <obo:IAO_0000115>A French national network for the genetic study of multiple sclerosis that since 1992 has recruited people with multiple sclerosis, with the parents and siblings of patients in trio and multiplex families, through physicians at hospital centres across France and through advertising campaigns run with patient associations, confirming each diagnosis by a network physician and collecting clinical information and a blood sample, and whose biological resource centre keeps DNA and cell lines for genetic studies of multiple sclerosis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BRC-REFGENSEP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CRB-REFGENSEP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Centre de Ressources Biologiques du Réseau Français d&apos;Etude Génétique de la Sclérose en Plaques</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>French MS Genetics group</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>French Network for MS Genetics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Multiple Sclerosis Genetics Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REFGENSEP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Réseau Français d&apos;Etude Génétique de la Sclérose en Plaques</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Réseau français de la génétique de la sclérose en plaques</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Réseau Français de la Génétique de la Sclérose En Plaques</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19731">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005301"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002310"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19731"/>
        <obo:IAO_0000116>multiple sclerosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38880029+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This sample was retrieved from REFGENSEP register of MS cases collected in 23 French hospital centers from 1992 to 2017.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002310"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2770/MediaObjects/41588_2013_BFng2770_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The French MS Genetics group (REFGENSEP) has been prospectively collecting samples with twenty-three centers covering France.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002310"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22085902</owl:annotatedTarget>
        <dcterms:title>Determination of the real effect of genes identified in GWAS: the example of IL2RA in multiple sclerosis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22085902</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3283173/</oboInOwl:hasDbXref>
        <rdfs:comment>Trio family samples were collected through REFGENSEP, whereas samples for multiplex families were obtained from both REFGENSEP and CCPGSMS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002310"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A French national network for the genetic study of multiple sclerosis that since 1992 has recruited people with multiple sclerosis, with the parents and siblings of patients in trio and multiplex families, through physicians at hospital centres across France and through advertising campaigns run with patient associations, confirming each diagnosis by a network physician and collecting clinical information and a blood sample, and whose biological resource centre keeps DNA and cell lines for genetic studies of multiple sclerosis.</owl:annotatedTarget>
