    <!-- http://www.ebi.ac.uk/coho/COHO_0002445 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002445">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Iran"/>
        <obo:IAO_0000112>PMID:30597647</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based, population-based genetic cohort in Tehran, Iran, designed by the Research Institute for Endocrine Sciences in collaboration with deCODE genetics, that genotyped participants of the Tehran Lipid and Glucose Study genome-wide and links their genotypes to the behavioural, biochemical and clinical data collected since 1999, later extended to participants of four ongoing studies with periodic follow-up, to identify genetic factors in cardiometabolic risk factors, cancers and other non-communicable diseases.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym TCGS also denotes Transcontinental COPD Genetics Study (COHO:0002446); this term is Tehran Cardiometabolic Genetic Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">20367</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TCGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tehran cardiometabolic genetic study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Tehran Cardiometabolic Genetic Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002445"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Iran"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30597647+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A novel association of rs13334070 in the RPGRIP1L gene with adiposity factors discovered by joint linkage and linkage disequilibrium analysis in Iranian pedigrees: Tehran Cardiometabolic Genetic Study (TCGS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002445"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:30597647</owl:annotatedTarget>
        <dcterms:title>A novel association of rs13334070 in the RPGRIP1L gene with adiposity factors discovered by joint linkage and linkage disequilibrium analysis in Iranian pedigrees: Tehran Cardiometabolic Genetic Study (TCGS).</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30597647</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30597647+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A novel association of rs13334070 in the RPGRIP1L gene with adiposity factors discovered by joint linkage and linkage disequilibrium analysis in Iranian pedigrees: Tehran Cardiometabolic Genetic Study (TCGS).</rdfs:comment>
    </owl:Axiom>
