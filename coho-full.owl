        <obo:IAO_0000115>A cohort of about 300 overweight or obese adults (BMI of 27 kg/m2 or more) aged 54–81 of Western European ancestry, enrolled at Radboud University Medical Center in Nijmegen, the Netherlands, within the Human Functional Genomics Project to discover pathways, including inflammation and immune responses, that contribute to cardiovascular disease in overweight and obese people.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">302</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>300 Obesity cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>300-OB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>300-Obese cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>300OB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>300OB cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>300_Obese cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">300-Obese</rdfs:label>
