        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8497954/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Columbia COVID-19 Biobank recruited consecutive COVID-19 cases (positive result from nasopharyngeal SARS-CoV-2 polymerase chain reaction test), regardless of age, sex, or race/ethnicity who received care at the Columbia University Irving Medical Center.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001071"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9428108/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Columbia University COVID-19 Biobank was established in response to the New York City infection surge in March 2020.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001071"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90132193</owl:annotatedTarget>
