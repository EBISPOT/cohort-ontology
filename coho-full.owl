    <!-- http://www.ebi.ac.uk/coho/COHO_0001165 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001165">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90271557</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study of the residents of the town of Leutkirch in Baden-Württemberg, south-western Germany, designed by the State Health Department of Baden-Württemberg and the University of Ulm, for which inhabitants aged 10 to 65 years were selected at random from the municipal population register and examined in November and December 2002 (EMIL-I) with a questionnaire, anthropometry, abdominal ultrasound and blood sampling. Its original aim, the prevalence of infection with the fox tapeworm Echinococcus multilocularis, was extended to internal diseases and public health, and a subsample was re-examined in 2013 (EMIL-II).</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2445</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>EMIL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EMIL study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EMIL-Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EMIL-Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Echinococcus multilocularis in Leutkirch study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ulm-EMIL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Echinococcus Multilocularis and Internal Diseases in Leutkirch</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001165"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1586017/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a population-based, cross-sectional health survey in the city of Leutkirch in southwestern Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001165"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90271557</owl:annotatedTarget>
        <dcterms:title>GWAS of random glucose in 476,326 individuals provide insights into diabetes pathophysiology, complications and treatment stratification.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37679419</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01462-3/MediaObjects/41588_2023_1462_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>EMIL-Cohort, a population-based cohort; the study was approved by the ethical committee of the Chamber of Physicians Baden-Württemberg in the year 2002 (Registration Number 133-02; dates 05.09.2002 and 24.09.2002).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001165"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study of the residents of the town of Leutkirch in Baden-Württemberg, south-western Germany, designed by the State Health Department of Baden-Württemberg and the University of Ulm, for which inhabitants aged 10 to 65 years were selected at random from the municipal population register and examined in November and December 2002 (EMIL-I) with a questionnaire, anthropometry, abdominal ultrasound and blood sampling. Its original aim, the prevalence of infection with the fox tapeworm Echinococcus multilocularis, was extended to internal diseases and public health, and a subsample was re-examined in 2013 (EMIL-II).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16981990</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30885181</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001165"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2445</owl:annotatedTarget>
        <obo:IAO_0000116>residents aged 10-65 who took part in EMIL-I (2002)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:16981990</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 2,445 persons aged 10–65 years participated in the study leading to a sample with a participation rate of 62.8%.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001165"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EMIL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001166 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001166">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10611"/>
        <rdf:type rdf:nodeID="genid10613"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90558259</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, multicentre observational cohort of children with cystic fibrosis aged 12 years or younger who were free of Pseudomonas aeruginosa at enrolment (no earlier positive respiratory culture, or at least two years of negative cultures) or were taking part in the companion Early Pseudomonas Infection Control clinical trial, enrolled in 2004-2006 at 59 cystic fibrosis care centres in the United States and led from the University of Washington and Seattle Children&apos;s Hospital. Participants were followed through encounter-based data collection built on the Cystic Fibrosis Foundation Patient Registry, annual family surveys, respiratory cultures and banked serum, bacterial isolates and DNA, to identify risk factors for early acquisition of P. aeruginosa and to describe its clinical consequences.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1797</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>EPIC Obs</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIC Observational Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIC observational cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIC-OBS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIC_Obs</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Early Pseudomonas Infection Control Observational study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Early Pseudomonas Infection Control Observational Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10611">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0009061"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid10613">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0040732"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10611"/>
        <obo:IAO_0000116>cystic fibrosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19470318+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Early Pseudomonas Infection Control (EPIC) program consists of two studies, a randomized multicenter trial in CF patients ages 1-12 years at first isolation of Pa from a respiratory culture, and a longitudinal cohort study enrolling Pa-negative patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10613"/>
        <obo:IAO_0000116>Pseudomonas aeruginosa infection</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19470318+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Early Pseudomonas Infection Control (EPIC) program consists of two studies, a randomized multicenter trial in CF patients ages 1-12 years at first isolation of Pa from a respiratory culture, and a longitudinal cohort study enrolling Pa-negative patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26061914+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To identify novel risk factors and corroborate previously identified risk factors for mean annual decline in FEV1% predicted in a large, contemporary, United States cohort of young cystic fibrosis (CF) patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90558259</owl:annotatedTarget>
        <dcterms:title>Genetic modifiers of body mass index in individuals with cystic fibrosis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39260370</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC11480786/</oboInOwl:hasDbXref>
        <rdfs:comment>The Cystic Fibrosis Genome Project (CFGP) is comprised of individuals with CF recruited by the CF Twin and Sibling Study (TSS)15 and Cystic Fibrosis-Related Diabetes (CFRD) Study16 (Johns Hopkins University), Genetic Modifier Study (GMS)17,18,19 and GMS of Severe CF Liver Disease (GMS CFLD)20,21 (University of North Carolina), and Early Pseudomonas Infection Control Observational (EPIC Obs) Study22 (University of Washington and Seattle Children’s Hospital).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, multicentre observational cohort of children with cystic fibrosis aged 12 years or younger who were free of Pseudomonas aeruginosa at enrolment (no earlier positive respiratory culture, or at least two years of negative cultures) or were taking part in the companion Early Pseudomonas Infection Control clinical trial, enrolled in 2004-2006 at 59 cystic fibrosis care centres in the United States and led from the University of Washington and Seattle Children&apos;s Hospital. Participants were followed through encounter-based data collection built on the Cystic Fibrosis Foundation Patient Registry, annual family surveys, respiratory cultures and banked serum, bacterial isolates and DNA, to identify risk factors for early acquisition of P. aeruginosa and to describe its clinical consequences.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19470318</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22554417</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26061914</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39260370</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1797</owl:annotatedTarget>
        <obo:IAO_0000116>children enrolled 2004-2006</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5462119/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Almost 1,800 participants (N=1797) enrolled in the EPIC Observational Study; 114 were excluded due to being Pa-positive at enrollment or having their CF diagnosis subsequently reversed.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EPIC Obs</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EPIC-OBS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EPIC_Obs</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001167 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001167">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90568440</obo:IAO_0000112>
        <obo:IAO_0000115>A nationally representative birth cohort of same-sex twins born in England and Wales in 1994-1995, drawn from a birth register of twins and recruited to represent UK families with newborns in the 1990s (ensuring enough children in disadvantaged homes and avoiding an excess of twins born to well-educated women after assisted reproduction). Proposed in 1997, funded by the Medical Research Council from 1998 and based at King&apos;s College London, it assessed the families at home when the twins were 5 (1999-2000), 7, 10, 12 and 18 years old, surveyed them online in their mid-twenties and planned a further assessment at age 30 for 2024-2025, to study how environmental and genetic factors contribute to behaviour, health and mental health problems from childhood into adulthood.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2232</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>E-Risk</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>E-Risk Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Environmental Risk (E-Risk) Longitudinal Twin Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Environmental Risk Longitudinal Twin Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001167"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15113820+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Environmental Risk Longitudinal Twin Study (E-Risk) comprised 2163 twin children from England and Wales (49.1% male) identified at birth in 1994 and 1995 and included administration of the Test of Word Reading Efficiency at age 7 years and the Wechsler Preschool and Primary Scale of Intelligence-Revised as a test of IQ at age 5 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001167"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90568440</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of childhood ADHD symptoms and diagnosis identifies new loci and potential effector genes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40962958</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02295-y/MediaObjects/41588_2025_2295_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were members of E-Risk, which tracks the development of a 1994-95 birth cohort of</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001167"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nationally representative birth cohort of same-sex twins born in England and Wales in 1994-1995, drawn from a birth register of twins and recruited to represent UK families with newborns in the 1990s (ensuring enough children in disadvantaged homes and avoiding an excess of twins born to well-educated women after assisted reproduction). Proposed in 1997, funded by the Medical Research Council from 1998 and based at King&apos;s College London, it assessed the families at home when the twins were 5 (1999-2000), 7, 10, 12 and 18 years old, surveyed them online in their mid-twenties and planned a further assessment at age 30 for 2024-2025, to study how environmental and genetic factors contribute to behaviour, health and mental health problems from childhood into adulthood.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:40350583</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.eriskstudy.com/about-the-e-risk-study/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001167"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2232</owl:annotatedTarget>
        <obo:IAO_0000116>same-sex twins in the birth cohort born 1994-1995 (1,116 families), 1999-2000</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.eriskstudy.com/about-the-e-risk-study/</oboInOwl:hasDbXref>
        <rdfs:comment>In 1998 E-Risk began by constructing a nationally representative 2-year birth cohort of 2,232 same-sex twins born in England and Wales in 1994-1995.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001167"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>E-Risk</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001168 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001168">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10627"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90428068</obo:IAO_0000112>
        <obo:IAO_0000115>The participants of a multicentre, randomised, double-blind, placebo-controlled trial at 39 UK hospital centres, funded by the Medical Research Council and National Institute for Health Research Efficacy and Mechanism Evaluation programme, in which women aged 18-50 years with chronic pelvic pain of at least three months and no obvious pelvic pathology at laparoscopy, screened between November 2015 and March 2019, were randomly assigned to gabapentin or matching placebo for 16 weeks to measure the efficacy and safety of gabapentin. Participants could give a saliva sample for genetic study at trial entry.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">306</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GaPP2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GaPP2 trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Gabapentin for chronic pelvic pain in women</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10627">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0034267"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001168"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10627"/>
        <obo:IAO_0000116>chronic pelvic pain</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32979978+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We aimed to measure the efficacy and safety of gabapentin in women with chronic pelvic pain and no obvious pelvic pathology.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001168"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11384074/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The trial, Gabapentin for chronic pelvic pain in women (GaPP2), was a UK-wide, multicenter, randomized, controlled trial of gabapentin versus placebo for the treatment of CPP.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001168"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90428068</owl:annotatedTarget>
        <dcterms:title>Genome-wide association reveals a locus in neuregulin 3 associated with gabapentin efficacy in women with chronic pelvic pain.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39258169</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11384074/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted an exploratory genome-wide association study using eligible GaPP2 participants aiming to identify genetic variants associated with gabapentin response.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001168"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The participants of a multicentre, randomised, double-blind, placebo-controlled trial at 39 UK hospital centres, funded by the Medical Research Council and National Institute for Health Research Efficacy and Mechanism Evaluation programme, in which women aged 18-50 years with chronic pelvic pain of at least three months and no obvious pelvic pathology at laparoscopy, screened between November 2015 and March 2019, were randomly assigned to gabapentin or matching placebo for 16 weeks to measure the efficacy and safety of gabapentin. Participants could give a saliva sample for genetic study at trial entry.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32979978</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39258169</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001168"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">306</owl:annotatedTarget>
        <obo:IAO_0000116>women randomised (153 gabapentin, 153 placebo), 2015-2019</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:32979978</oboInOwl:hasDbXref>
        <rdfs:comment>Of these 414 women, 306 were randomly assigned (153 to gabapentin and 153 to placebo).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001168"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GaPP2</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001169 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001169">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/India"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Asia"/>
        <obo:IAO_0000112>GCST90179179</obo:IAO_0000112>
        <obo:IAO_0000115>A single-centre prospective pregnancy cohort at Gurugram Civil Hospital, a secondary-care hospital in Gurugram district, Haryana, north India, that from May 2015 enrolled pregnant women before 20 weeks&apos; gestation (dated by ultrasound) and followed them through pregnancy to delivery and once within six months after delivery, building repositories of clinical data, biospecimens and ultrasound images. Coordinated by the Translational Health Science and Technology Institute and funded by India&apos;s Department of Biotechnology, it aims to identify clinical, epidemiological, genomic, epigenomic, proteomic and microbial correlates of preterm birth and to develop risk-prediction tools for it.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GARBH-Ini</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GARBH-Ini cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GARBH-Ini pregnancy cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Interdisciplinary Group for Advanced Research on Birth Outcomes - DBT India Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>interdisciplinary Group for Advanced Research on BirtH outcomes - DBT India Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Interdisciplinary Group for Advanced Research on BirtH outcomes - DBT India Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001169"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/India"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10363490/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Pregnant women enrolled between May 2015 to April 2021 in a large single-centre prospective cohort14 (GARBH-Ini: interdisciplinary Group for Advanced Research on BirtH outcomes - DBT India Initiative) in Haryana, India, were followed up with written informed consent till six months after delivery (cohort description provided in Appendix).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001169"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90179179</owl:annotatedTarget>
        <dcterms:title>Genetic variants associated with spontaneous preterm birth in women from India: a prospective cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37492417</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10363490/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Pregnant women enrolled between May 2015 to April 2021 in a large single-centre prospective cohort14 (GARBH-Ini: interdisciplinary Group for Advanced Research on BirtH outcomes - DBT India Initiative) in Haryana, India, were followed up with written informed consent till six months after delivery (cohort description provided in Appendix).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001169"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A single-centre prospective pregnancy cohort at Gurugram Civil Hospital, a secondary-care hospital in Gurugram district, Haryana, north India, that from May 2015 enrolled pregnant women before 20 weeks&apos; gestation (dated by ultrasound) and followed them through pregnancy to delivery and once within six months after delivery, building repositories of clinical data, biospecimens and ultrasound images. Coordinated by the Translational Health Science and Technology Institute and funded by India&apos;s Department of Biotechnology, it aims to identify clinical, epidemiological, genomic, epigenomic, proteomic and microbial correlates of preterm birth and to develop risk-prediction tools for it.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30770926</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37492417</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39030058</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001169"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8000</owl:annotatedTarget>
        <obo:IAO_0000116>pregnant women enrolled before 20 weeks&apos; gestation, May 2015 to Aug 2020</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:39030058</oboInOwl:hasDbXref>
        <rdfs:comment>In the GARBH-Ini (Interdisciplinary Group for Advanced Research on Birth Outcomes-DBT India Initiative) pregnancy cohort, 8000 participants were enrolled with less than 20 weeks&apos; gestation between May 11, 2015, and Aug 8, 2020, at a secondary-care hospital in north India.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001169"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GARBH-Ini</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001170 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001170">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000403"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000457"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000482"/>
        <obo:IAO_0000112>GCST90308666</obo:IAO_0000112>
        <obo:IAO_0000115>A collaborative network of biobanks and genomics initiatives, formed in 2019 by 23 biobanks from four continents (North America, Europe, East and West Asia, and Australia) and since joined by others, whose participants have genotypes linked to electronic health records or other health data. Member biobanks run genome-wide association studies with harmonised phenotype definitions and methods, stratified by ancestry and sex, and GBMI meta-analyses the summary statistics across biobanks and ancestries, beginning with 14 diseases and endpoints, and releases them publicly, to increase the power and ancestral diversity of genetic studies of human disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2200000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GBMI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Global Biobank Meta-analysis Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001170"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000403"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10897632/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>We combined the European-specific IGGC meta-analysis data (GCST90011767), the GLADD meta-analysis (GCST009245), and the GBMI data in which we excluded FinnGen (a subset present in IGGC of European ancestry), BioME from African ancestry (a subset present in GGLAD), and UKBB-Africa (a subset present in GGLAD) cohorts.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001170"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000457"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10897632/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>PMBB and CCPM are part of the GBMI that joined the consortium after initial analysis of the data and have been previously described and use same phenotyping and GWAS protocols as other GBMI biobanks.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001170"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000482"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10897632/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>PMBB and CCPM are part of the GBMI that joined the consortium after initial analysis of the data and have been previously described and use same phenotyping and GWAS protocols as other GBMI biobanks.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001170"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90308666</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry meta-analysis identifies 5 novel loci for ischemic stroke and reveals heterogeneity of effects between sexes and ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37601974</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37601974+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a genome-wide meta-analysis of 16 biobanks across multiple ancestries to study the genetics of ischemic stroke (60,176 cases, 1,310,725 controls) as part of the Global Biobank Meta-analysis Initiative (GBMI) and further combined the results with previously published MegaStroke.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001170"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collaborative network of biobanks and genomics initiatives, formed in 2019 by 23 biobanks from four continents (North America, Europe, East and West Asia, and Australia) and since joined by others, whose participants have genotypes linked to electronic health records or other health data. Member biobanks run genome-wide association studies with harmonised phenotype definitions and methods, stratified by ancestry and sex, and GBMI meta-analyses the summary statistics across biobanks and ancestries, beginning with 14 diseases and endpoints, and releases them publicly, to increase the power and ancestral diversity of genetic studies of human disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36777996</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.globalbiobankmeta.org/parcipating-biobanks</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001170"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2200000</owl:annotatedTarget>
        <obo:IAO_0000116>participants with genotypes and health data across the 23 member biobanks of the flagship project (as of April 2022)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9903716/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>GBMI represents 2.2 million research participants with health and genetic data from 23 biobanks: one from Australia, one from West Asia, four from East Asian countries, eight from European countries, and nine from North America.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001170"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GBMI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001171 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001171">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10646"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>GCST90267402</obo:IAO_0000112>
        <obo:IAO_0000115>Patients with diffuse large B-cell lymphoma (DLBCL) enrolled in the LNH03 (LNH 2003) programme of treatment trials of the Groupe d&apos;Etude des Lymphomes de l&apos;Adulte (GELA, later the Lymphoma Study Association, LYSA), who consented to DNA analysis. The programme&apos;s trials, opened from December 2003 at centres mainly in France and Belgium for patients of different ages and prognostic risk, were the randomised trials LNH03-1B, LNH03-2B and LNH03-6B, the phase 2 trial LNH03-3B, LNH03-39B and a phase 2 trial of R-miniCHOP in patients over 80. The patients&apos; germline DNA was genotyped as the case series of GELA&apos;s genome-wide association study of DLBCL, with controls drawn from the French component of EPIC.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">549</coho:numberOfCases>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">549</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GELA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Treatment program of DLBCL patients from the Groupe dEtude des Lymphomes de lAdulte</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Treatment program of DLBCL patients from the Groupe d&apos;Etude des Lymphomes de l&apos;Adulte</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10646">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0018905"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001171"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10646"/>
        <obo:IAO_0000116>diffuse large B-cell lymphoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4213349/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In stage 2, we included data from two unpublished and previously genotyped GWAS (GELA/EPIC and Mayo) plus one published GWAS (UCSF7), totaling 1,196 DLCBL cases and 1,445 controls (Online Methods; Supplementary Tables 1, 3).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001171"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21482186+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were included from 38 centres in France and Belgium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001171"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90267402</owl:annotatedTarget>
        <dcterms:title>Distinct germline genetic susceptibility profiles identified for common non-Hodgkin lymphoma subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36273105</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41375-022-01711-0/MediaObjects/41375_2022_1711_MOESM1_ESM.docx</oboInOwl:hasDbXref>
        <rdfs:comment>Groupe d&apos;Etude des Lymphomes de l&apos;Adulte (GELA) /EPIC GWAS</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001171"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Patients with diffuse large B-cell lymphoma (DLBCL) enrolled in the LNH03 (LNH 2003) programme of treatment trials of the Groupe d&apos;Etude des Lymphomes de l&apos;Adulte (GELA, later the Lymphoma Study Association, LYSA), who consented to DNA analysis. The programme&apos;s trials, opened from December 2003 at centres mainly in France and Belgium for patients of different ages and prognostic risk, were the randomised trials LNH03-1B, LNH03-2B and LNH03-6B, the phase 2 trial LNH03-3B, LNH03-39B and a phase 2 trial of R-miniCHOP in patients over 80. The patients&apos; germline DNA was genotyped as the case series of GELA&apos;s genome-wide association study of DLBCL, with controls drawn from the French component of EPIC.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21482186</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21546499</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22118442</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23235801</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23578722</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25261932</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36273105</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001171"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">549</owl:annotatedTarget>
        <obo:IAO_0000116>DLBCL cases from the LNH03 programme genotyped in the GELA GWAS (cases only)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4213349/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Three independent DLBCL GWAS provided genotyping data for a meta-analysis, (Supplementary Table 1), which included data generated with the following commercial, SNP microarrays: Illumina HumanHap 660W for Mayo (393 DLBCL and 172 controls), HumanCNV370-Duo for UCSF7 (254 DLBCLs and 748 controls), and HumanHap 610K for GELA (549 cases).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001171"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">549</owl:annotatedTarget>
        <obo:IAO_0000116>DLBCL cases from the LNH03 programme genotyped in the GELA GWAS (cases only)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4213349/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Three independent DLBCL GWAS provided genotyping data for a meta-analysis, (Supplementary Table 1), which included data generated with the following commercial, SNP microarrays: Illumina HumanHap 660W for Mayo (393 DLBCL and 172 controls), HumanCNV370-Duo for UCSF7 (254 DLBCLs and 748 controls), and HumanHap 610K for GELA (549 cases).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001171"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GELA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
