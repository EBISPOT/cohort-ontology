    <!-- http://www.ebi.ac.uk/coho/COHO_0002244 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002244">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>PMID:28724990</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal, prospective, population-based cohort of young-adult women from Malmö, Sweden, who were invited in 1999–2004 at the age of 25 (excluding women pregnant then or in the previous 12 months) and invited again about ten years later at age 35, set up to explore the genetic, clinical and lifestyle factors associated with attaining peak bone mass and with later changes in bone mass, with bone density and body composition measured by DXA.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1047</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PEAK 25</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PEAK Bone Mass 25 study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PEAK25</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PEAK25 Swedish Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Peak-25</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">PEAK-25</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002244"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12685719/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, during 1999-2004, 25-yr-old women from Malmö, Sweden, were invited to participate.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002244"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28724990</owl:annotatedTarget>
        <dcterms:title>Large meta-analysis of genome-wide association studies identifies five loci for lean body mass.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28724990</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5517526/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>De-novo replication genotyping was done using: KBioScience Allele-Specific Polymorphism (KASP) SNP genotyping system (in OPRA, PEAK25, AGES, CAIFOS, DOPS cohorts), TaqMan (METSIM), Illumina OmniExpress + Illumina Metabochip (PIVUS and ULSAM), or Sequenom’s iPLEX (WHI) (Supplementary Table 8).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002244"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal, prospective, population-based cohort of young-adult women from Malmö, Sweden, who were invited in 1999–2004 at the age of 25 (excluding women pregnant then or in the previous 12 months) and invited again about ten years later at age 35, set up to explore the genetic, clinical and lifestyle factors associated with attaining peak bone mass and with later changes in bone mass, with bone density and body composition measured by DXA.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:40581742</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-017-00031-7/MediaObjects/41467_2017_31_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002244"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1047</owl:annotatedTarget>
        <obo:IAO_0000116>25-year-old women included at baseline in Malmö, 1999-2004</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12685719/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The final number at inclusion was 1047 women (exclusions due to 102 who were pregnant, 3 who were outside age limit, 2 did not attend, and 12 were missing data) (Figure 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002244"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PEAK 25</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002244"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PEAK25</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002244"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Peak-25</owl:annotatedTarget>
