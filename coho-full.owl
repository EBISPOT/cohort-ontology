        <obo:IAO_0000115>A case-control sample of lung cancer patients who had never smoked, identified and recruited at Mayo Clinic, Rochester, Minnesota, between 1997 and 2008, and never-smoking community residents matched to them by age, sex and ethnic background, genotyped for a genome-wide association study of lung cancer in never smokers.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">754</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MAYOLC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo genome-wide association study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
