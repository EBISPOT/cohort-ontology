        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4254855/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>In the Carotid Atherosclerosis Progression Study (CAPS), members of a German primary healthcare scheme were invited of whom 6,962 participants (attendance rate 21%) agreed to take part.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001566"/>
