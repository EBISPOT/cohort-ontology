    <!-- http://www.ebi.ac.uk/coho/COHO_0001283 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001283">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11607"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST001189</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control sample of people of Ashkenazi Jewish ancestry from the New York area, with Parkinson&apos;s disease cases recruited at the Center for Parkinson&apos;s Disease and Other Movement Disorders at Columbia University and controls evaluated in the same way, assembled from two Columbia University studies, the Genetic Epidemiology of PD study (PD EPI) and the AJ Study, for a genome-wide association study of Parkinson&apos;s disease.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">268</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">178</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>AJ GWAS dataset</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ash-Jewish</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ashkenazi Jewish Dataset</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">The Ashkenazi Jewish Dataset</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11607">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001283"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11607"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3166909/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, for the PD EPI and AJ study, PD cases were recruited from the Center for PD and Other Movement Disorders at Columbia University.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001283"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3166909/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We applied a GWAS approach to a relatively homogeneous Ashkenazi Jewish (AJ) population from New York to search for both &apos;rare&apos; and &apos;common&apos; genetic variants that confer risk of PD by examining any SNPs with allele frequencies exceeding 2%.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001283"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST001189</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies candidate genes for Parkinson&apos;s disease in an Ashkenazi Jewish population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21812969</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3166909/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The AJ GWAS dataset was created by combining participants from two studies the Genetic Epidemiology of PD study (PD EPI) and the AJ Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001283"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control sample of people of Ashkenazi Jewish ancestry from the New York area, with Parkinson&apos;s disease cases recruited at the Center for Parkinson&apos;s Disease and Other Movement Disorders at Columbia University and controls evaluated in the same way, assembled from two Columbia University studies, the Genetic Epidemiology of PD study (PD EPI) and the AJ Study, for a genome-wide association study of Parkinson&apos;s disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21812969</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001283"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">268</owl:annotatedTarget>
        <obo:IAO_0000116>Parkinson&apos;s disease cases and controls genotyped for the AJ GWAS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3166909/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 268 cases and 178 controls were genotyped using the Illumina Human 610-quad bead arrays (Cases n = 91 and Controls n = 96) or the Illumina Human 660-quad bead arrays (Cases n = 191 and Controls n = 84).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001283"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">178</owl:annotatedTarget>
        <obo:IAO_0000116>Parkinson&apos;s disease cases and controls genotyped for the AJ GWAS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3166909/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 268 cases and 178 controls were genotyped using the Illumina Human 610-quad bead arrays (Cases n = 91 and Controls n = 96) or the Illumina Human 660-quad bead arrays (Cases n = 191 and Controls n = 84).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001283"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Ash-Jewish</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001284 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001284">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11615"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90301382</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, matched cohort study, funded by the US National Institute of Diabetes and Digestive and Kidney Diseases, that enrolled hospitalised adults with and without acute kidney injury (AKI), matched on clinical research centre, pre-admission chronic kidney disease and other risk factors, at centres in the United States and Canada between December 2009 and February 2015, together with children undergoing cardiac surgery, and followed them after discharge to examine how an episode of AKI affects the development and progression of chronic kidney disease, cardiovascular events and death.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">769</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">769</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1538</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ASSESS-AKI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ASSESS-AKI Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Assessment, Serial Evaluation, and Subsequent Sequelae in Acute Kidney Injury Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Assessment, Serial Evaluation, and Subsequent Sequelae of AKI Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Assessment, Serial Evaluation, and Subsequent Sequelae of Acute Kidney Injury Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11615">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002492"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001284"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11615"/>
        <obo:IAO_0000116>acute kidney injury</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20799966+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This prospective study will enroll a cohort of 1100 adult participants with a broad range of AKI and matched hospitalized participants without AKI at three Clinical Research Centers, as well as 100 children undergoing cardiac surgery at three Clinical Research Centers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001284"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7374148/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>during preoperative evaluation for cardiac surgery at Yale University (New Haven, CT) and London Health Sciences Center (Ontario, Canada).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001284"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2944247/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The multi-center cohort includes various U.S. and Canadian sites and health care delivery systems</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001284"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90301382</owl:annotatedTarget>
        <dcterms:title>Genome-wide Association Study for AKI.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37273234</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10371295/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a genome-wide association study in 1369 participants in the Assessment, Serial Evaluation, and Subsequent Sequelae of AKI Study; a multiethnic population of hospitalized participants with and without AKI matched on demographics, comorbidities, and kidney function before hospitalization.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001284"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, matched cohort study, funded by the US National Institute of Diabetes and Digestive and Kidney Diseases, that enrolled hospitalised adults with and without acute kidney injury (AKI), matched on clinical research centre, pre-admission chronic kidney disease and other risk factors, at centres in the United States and Canada between December 2009 and February 2015, together with children undergoing cardiac surgery, and followed them after discharge to examine how an episode of AKI affects the development and progression of chronic kidney disease, cardiovascular events and death.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20799966</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32707221</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001284"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">769</owl:annotatedTarget>
        <obo:IAO_0000116>hospitalised adults with or without AKI (matched pairs) completing the 90-day visit; children not counted (2015)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10371295/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The full ASSESS-AKI cohort included 1538 hospitalized adults who did or did not experience an episode of AKI and survived to complete a study visit 90 days after discharge.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001284"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">769</owl:annotatedTarget>
        <obo:IAO_0000116>hospitalised adults with or without AKI (matched pairs) completing the 90-day visit; children not counted (2015)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10371295/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The full ASSESS-AKI cohort included 1538 hospitalized adults who did or did not experience an episode of AKI and survived to complete a study visit 90 days after discharge.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001284"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1538</owl:annotatedTarget>
        <obo:IAO_0000116>hospitalised adults with or without AKI (matched pairs) completing the 90-day visit; children not counted (2015)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10371295/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The full ASSESS-AKI cohort included 1538 hospitalized adults who did or did not experience an episode of AKI and survived to complete a study visit 90 days after discharge.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001284"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ASSESS-AKI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001285 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001285">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST010723</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of mobile people aged 70 and over from the city and county of Regensburg in eastern Bavaria, Germany, invited from random samples of the local residents&apos; registries and examined at the University Hospital Regensburg in two baseline surveys (2013–2015 and 2017–2019), with interviews, medical and eye examinations, biobanking and genotyping and later follow-up, set up by the University of Regensburg as a research platform for late-onset chronic diseases and their genetic and non-genetic causes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2449</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Age-related diseases: understanding genetic and non-genetic influences - a study at the University of Regensburg</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Altersbezogene Untersuchungen zur Gesundheit der Universität Regensburg</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AugUR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AugUR study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Age-related diseases: Understanding Genetic and non-genetic influences - a study at the University of Regensburg</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001285"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26489512+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We establish the German AugUR study (Age-related diseases: understanding genetic and non-genetic influences - a study at the University of Regensburg), a prospective study in the mobile elderly general population in and around Regensburg in eastern Bavaria.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001285"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST010723</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis for early age-related macular degeneration highlights novel loci and insights for advanced disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32843070</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7449002/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Our studies were primarily population-based cohort studies, where the baseline survey data were used for this analysis from studies of the authors (GHS, LIFE, NICOLA, KORA, AugUR) as well as for publicly available studies from dbGaP (ARIC, CHS, WHI; accession numbers: phs000090.v5.p1, phs000287.v6.p1, phs000746.v2.p3).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001285"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of mobile people aged 70 and over from the city and county of Regensburg in eastern Bavaria, Germany, invited from random samples of the local residents&apos; registries and examined at the University Hospital Regensburg in two baseline surveys (2013–2015 and 2017–2019), with interviews, medical and eye examinations, biobanking and genotyping and later follow-up, set up by the University of Regensburg as a research platform for late-onset chronic diseases and their genetic and non-genetic causes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26489512</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37721739</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001285"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2449</owl:annotatedTarget>
        <obo:IAO_0000116>participants of the two baseline surveys (AugUR1 2013-2015: 1133; AugUR2 2017-2019: 1316)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10511022/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Among the 2449 AugUR participants (AugUR1: n = 1133 and AugUR2: n = 1316; and no overlap between the 2 datasets), information on AMD stages for at least one eye, as well as genetic data were available for 2188 persons (AugUR1: n = 1010 and AugUR2: n = 1178).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001285"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AugUR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001286 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001286">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000062"/>
        <obo:IAO_0000112>GCST90295957</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of the residents aged 60 and over of the town of Bambuí, in Minas Gerais, south-eastern Brazil, identified by a complete census on 1 January 1997 and examined at baseline in February–May 1997 with interviews, blood tests, blood pressure measurements and electrocardiograms, then followed with annual interviews, repeated examinations and death ascertainment to study health and mortality in older adults.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1606</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BAMBUI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BHAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bambui Cohort Study of Ageing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bambuí (Brazil) Cohort Study of Ageing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bambuí (Brazil) Cohort Study of Aging</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bambuí Cohort Study of Ageing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bambuí Health and Aging Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bambuí-Epigen Cohort Study of Aging</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Bambui (Brazil) Cohort Study of Ageing</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001286"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24737496+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The study took place in Bambuí, Brazil.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001286"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90295957</owl:annotatedTarget>
        <dcterms:title>Genome-wide study investigating effector genes and polygenic prediction for kidney function in persons with ancestry from Africa and the Americas.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38190104</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10794846/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Bambui (Brazil) Cohort Study of Ageing (BAMBUI): the EPIGEN-Brazil Initiative is funded by the Brazilian Ministry of Health (Department of Science and Technology from the Secretaria de Ciência, Tecnologia e Insumos Estratégicos) through Financiadora de Estudos e Projetos.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001286"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of the residents aged 60 and over of the town of Bambuí, in Minas Gerais, south-eastern Brazil, identified by a complete census on 1 January 1997 and examined at baseline in February–May 1997 with interviews, blood tests, blood pressure measurements and electrocardiograms, then followed with annual interviews, repeated examinations and death ascertainment to study health and mortality in older adults.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23251690</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33633342</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001286"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1606</owl:annotatedTarget>
        <obo:IAO_0000116>residents aged 60+ enrolled at the 1997 baseline</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3522641/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the baseline cohort population comprised 1,606 (92.2%) of all the 1,742 residents aged 60 years or more on January 1st, 1997, who were identified by means of a complete census carried out in the city.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001286"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BAMBUI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001286"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BHAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001287 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001287">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11636"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>GCST90726344</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of pregnant women in Uppsala County, Sweden, invited at their routine ultrasound examination at gestational week 16–18 at Uppsala University Hospital from September 2009 to November 2018 and followed to one year postpartum with web surveys, biological samples and medical-record data, to study the biopsychosocial causes and predictors of perinatal depression.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5492</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BASIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Biology, Affect, Stress, Imaging and Cognition Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Biology, Affect, Stress, Imaging and Cognition study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11636">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002050"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001287"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11636"/>
        <obo:IAO_0000116>perinatal depression</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31641004+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>With the population-based, prospective Biology, Affect, Stress, Imaging and Cognition (BASIC) cohort, we aim to investigate the biopsychosocial aetiological processes involved in perinatal depression (PND) and to pinpoint its predictors in order to improve early detection.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001287"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6830667/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>From September 2009 to November 2018, the BASIC study at Uppsala University Hospital, Sweden, has enrolled 5492 women, in 6478 pregnancies, of which 46.3% first-time pregnancies and with an average age of 31.5 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001287"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90726344</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analyses identify distinct genetic architectures for early-onset and late-onset depression.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41233554</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12695632/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>BASIC: The Biology, Affect, Stress, Imaging and Cognition (BASIC) study recruited 5,492 pregnant women from the Uppsala Hospital University (Uppsala, Sweden) and followed them and their children from pregnancy to one year postpartum between 2012 and 201911 .</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001287"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort of pregnant women in Uppsala County, Sweden, invited at their routine ultrasound examination at gestational week 16–18 at Uppsala University Hospital from September 2009 to November 2018 and followed to one year postpartum with web surveys, biological samples and medical-record data, to study the biopsychosocial causes and predictors of perinatal depression.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31641004</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001287"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5492</owl:annotatedTarget>
        <obo:IAO_0000116>women enrolled September 2009 - November 2018 (6478 pregnancies)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:31641004</oboInOwl:hasDbXref>
        <rdfs:comment>From September 2009 to November 2018, the BASIC study at Uppsala University Hospital, Sweden, has enrolled 5492 women, in 6478 pregnancies, of which 46.3% first-time pregnancies and with an average age of 31.5 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001287"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BASIC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001288 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001288">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11643"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001033"/>
        <obo:IAO_0000112>GCST90094651</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of breast cancer in the greater Baltimore area, Maryland, United States, in which incident breast cancer cases and controls frequency-matched to them on race and age were recruited from February 1993 to August 2003 at six hospitals, including the University of Maryland Medical Center and the Baltimore Veterans Affairs Medical Center, to identify and characterise markers of disease aggressiveness and poor outcome.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym BBCS also denotes Brescia Bladder Cancer Study (COHO:0000815) and British Breast Cancer Study (COHO:0001510); this term is Baltimore Breast Cancer Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">293</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">317</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>BBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BBCS_c</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Baltimore Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11643">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001288"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11643"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The BBCS is a case control study of breast cancer designed to identify and characterize markers of disease aggressiveness and poor outcome.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001288"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9011920/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Root consortium is comprised of six epidemiologic studies of breast cancer in women of African ancestry: the Nigerian Breast Cancer Study (Ibadan, Nigeria); the Barbados National Cancer Study (Barbados); the Southern Community Cohort (southern United States); the Baltimore Breast Cancer Study (Baltimore, United States); the Racial Variability in Genotypic Determinants of Breast Cancer Risk Study (Detroit and Pennsylvania, United States); and the Chicago Cancer Prone Study (Chicago, United States).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001288"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90094651</owl:annotatedTarget>
        <dcterms:title>Associations between age of menarche and genetic variation in women of African descent: genome-wide association study and polygenic score analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34706928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9011920/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Root consortium is comprised of six epidemiologic studies of breast cancer in women of African ancestry: the Nigerian Breast Cancer Study (Ibadan, Nigeria); the Barbados National Cancer Study (Barbados); the Southern Community Cohort (southern United States); the Baltimore Breast Cancer Study (Baltimore, United States); the Racial Variability in Genotypic Determinants of Breast Cancer Risk Study (Detroit and Pennsylvania, United States); and the Chicago Cancer Prone Study (Chicago, United States).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001288"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of breast cancer in the greater Baltimore area, Maryland, United States, in which incident breast cancer cases and controls frequency-matched to them on race and age were recruited from February 1993 to August 2003 at six hospitals, including the University of Maryland Medical Center and the Baltimore Veterans Affairs Medical Center, to identify and characterise markers of disease aggressiveness and poor outcome.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22357627</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001288"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">293</owl:annotatedTarget>
        <obo:IAO_0000116>breast cancer cases and cancer-free controls analysed in the 2006 MDM2 study (possibly a subset)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:16818855</oboInOwl:hasDbXref>
        <rdfs:comment>We used multivariable logistic and Cox regression analyses to study the relationship of SNP309 status and the status of a second MDM2 SNP in exon 12 at codon 354 (SNP354) with breast cancer incidence and with disease-specific survival among 293 case patients and 317 cancer-free control subjects.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001288"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">317</owl:annotatedTarget>
        <obo:IAO_0000116>breast cancer cases and cancer-free controls analysed in the 2006 MDM2 study (possibly a subset)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:16818855</oboInOwl:hasDbXref>
        <rdfs:comment>We used multivariable logistic and Cox regression analyses to study the relationship of SNP309 status and the status of a second MDM2 SNP in exon 12 at codon 354 (SNP354) with breast cancer incidence and with disease-specific survival among 293 case patients and 317 cancer-free control subjects.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001288"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BBCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
