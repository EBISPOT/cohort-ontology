        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6899908/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study protocol (number 2008.84) was approved by the institutional review boards of all participating tertiary referral (n = 6) and general hospitals (n = 10) in the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001644"/>
