        <oboInOwl:hasRelatedSynonym>SUCCESSC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Simultaneous Study of Docetaxel Based Anthracycline Free Adjuvant Treatment Evaluation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SuccessC</oboInOwl:hasRelatedSynonym>
