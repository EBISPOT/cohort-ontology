        <oboInOwl:hasRelatedSynonym>SweCovid-COMRI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The genetic predisposition to severe COVID-19</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
