        <rdfs:comment>Genetics of Overweight Young Adults – mothers with overweight and their children (GOYA-MO-OW) GOYA is a nested study within the Danish National Birth Cohort (DNBC)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000710"/>
