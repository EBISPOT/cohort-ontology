        <owl:annotatedTarget rdf:nodeID="genid11695"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14691062+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We have used multiple sources to identify a population-representative cohort of newly diagnosed patients with parkinsonism and Parkinson&apos;s disease in the UK over a 2-year period.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001294"/>
