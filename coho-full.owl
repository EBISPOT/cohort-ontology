    <!-- http://www.ebi.ac.uk/coho/COHO_0002232 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002232">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19131"/>
        <rdf:type rdf:nodeID="genid19133"/>
        <rdf:type rdf:nodeID="genid19135"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:21912625</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of Parkinson&apos;s disease nested in the NIH-AARP Diet and Health Study, the prospective cohort established by the National Cancer Institute in 1995–1996, whose cases are cohort members who reported Parkinson&apos;s disease in the cohort&apos;s 2004–2006 follow-up survey and were confirmed by their treating physicians or by medical record review, and whose controls are randomly selected cohort members who did not report Parkinson&apos;s disease, frequency-matched to the cases on year of birth, sex and ethnicity, with DNA collected from saliva.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym PAGE also denotes Psoriasis Association Genetics Extension (COHO:0000145), Placental Abruption Genetic Epidemiology study (COHO:0001268) and Population Architecture using Genomics and Epidemiology Study (COHO:0002752); this term is Parkinson&apos;s, Genes, and Environment Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">838</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1703</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>PAGE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ParGE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Parkinson&apos;s Genes and Environment Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Parkinson&apos;s, Genes and Environment study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Parkinson&apos;s, Genes, and Environment</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Parkinson, Genes, and Environment</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Parkinsons, Genes and Environment</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Parkinson&apos;s, Genes, and Environment Study</rdfs:label>
    </owl:NamedIndividual>
