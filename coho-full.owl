        <oboInOwl:hasRelatedSynonym>European Study of Screening for Prostate Cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European randomised study of screening for prostate cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">European Randomised Study of Screening for Prostate Cancer</rdfs:label>
    </owl:NamedIndividual>
