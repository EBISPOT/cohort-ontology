        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">331</owl:annotatedTarget>
        <obo:IAO_0000116>LAAPC Latino cases and controls in the 2019 report</obo:IAO_0000116>
