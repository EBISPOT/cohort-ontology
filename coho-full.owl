        <obo:IAO_0000119>PMID:37286573</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37399490</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
