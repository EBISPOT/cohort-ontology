        <dcterms:title>African ancestry and risk variants associated with triple-negative breast cancer susceptibility in African American women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42098873</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC13321428/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>the Los Angeles component of the Women’s Contraceptive and Reproductive Experiences Study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000110"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control collection of White and African-American women aged 35–64 in Los Angeles, United States, with invasive breast cancer or no previous breast cancer, contributing to the Women&apos;s Contraceptive and Reproductive Experiences investigation of breast cancer risk factors.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18628424</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>GPT-6 (OpenAI Codex), 2026-09</dcterms:contributor>
