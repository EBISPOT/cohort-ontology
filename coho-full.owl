        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001951"/>
        <obo:IAO_0000112>PMID:41393571</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based cohort of middle-aged and elderly residents of Nomura town, a largely rural community in Ehime Prefecture, western Japan, recruited through the annual community health check-ups at the Nomura Health and Welfare Center, with a first cohort enrolled in 2002 and a second in 2014 and followed up for mortality; run from Ehime University, it is one of the general-population cohorts of the Japanese Millennium Genome Project.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3517</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Ehime University site</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>JMGP-Nomura</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nomura</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nomura Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nomura cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nomura cohort study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Nomura Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002171"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12701544/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were recruited from rural communities in Ehime Prefecture, Japan, specifically individuals who routinely participated in annual community-based health checkups conducted at the Nomura Health and Welfare Center.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002171"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:41393571</owl:annotatedTarget>
        <dcterms:title>Association Between the Creatinine-to-Body Weight Ratio and All-Cause Mortality in a Rural Japanese Community.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41393571</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41393571+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Participants included 1553 men (aged 63 ± 14 years) and 1964 women (aged 65 ± 16 years) who participated in the Nomura cohort study conducted in 2002 (first cohort) and 2014 (second cohort) and who continued throughout the follow-up periods (median, 6316 days; interquartile ranges, 3828-8121 days).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002171"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based cohort of middle-aged and elderly residents of Nomura town, a largely rural community in Ehime Prefecture, western Japan, recruited through the annual community health check-ups at the Nomura Health and Welfare Center, with a first cohort enrolled in 2002 and a second in 2014 and followed up for mortality; run from Ehime University, it is one of the general-population cohorts of the Japanese Millennium Genome Project.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24009259</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26390057</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41393571</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002171"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3517</owl:annotatedTarget>
        <obo:IAO_0000116>analysed subset: participants of the 2002 and 2014 cohorts who continued through follow-up</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12701544/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Data from both cohorts were combined for analysis, resulting in a total sample size of 3517 participants (Appendix B).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002171"/>
