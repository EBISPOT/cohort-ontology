        <obo:IAO_0000112>PGS004592</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:35505292</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective community-based cohort of adults aged 20–69 years randomly selected from the electoral roll of the township of Nambour in subtropical Queensland, Australia, begun in 1986 with a survey of skin cancer prevalence and dermatologists&apos; skin examinations; from 1992 to 1996 most participants took part in a randomised trial of daily sunscreen use and beta-carotene supplementation for skin cancer prevention, and the cohort has since been followed for skin cancers, diet and mortality.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2095</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NSCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nambour Skin Cancer Prevention Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nambour Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Nambour Skin Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18797">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002898"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002182"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18797"/>
        <obo:IAO_0000116>skin cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9063108/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>From 1992 to 1996, 1621 of the original 2095 participants took part in a randomized trial of daily sunscreen application and beta-carotene supplementation for skin cancer prevention [16, 18, 19].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002182"/>
