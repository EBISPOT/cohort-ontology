        <oboInOwl:hasDbXref>https://www.qimrb.edu.au/studies/queensland-twin-registry-(qtwin)-study</oboInOwl:hasDbXref>
        <rdfs:comment>Queensland Twin Registry (QTwin) Study is a population-based registry of identical and non-identical twins and triplets of all ages, living in Australia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001226"/>
