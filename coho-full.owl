        <obo:IAO_0000112>PMID:25874636</obo:IAO_0000112>
        <obo:IAO_0000115>A 12-week randomised controlled dietary intervention trial of men and women aged 40 to 70 with impaired glucose metabolism and other features of the metabolic syndrome, recruited in 2007–2008 in the Kuopio area of Finland and run by the Department of Clinical Nutrition of the University of Eastern Finland, comparing a healthy Nordic-type diet rich in whole grain products, fatty fish and bilberries and a whole-grain-enriched diet with a control diet for effects on glucose and lipid metabolism, inflammation and endothelial function.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">131</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SYSDIMET</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>Dietary Modulation of Gene Expression and Metabolic Pathways in Glucose Metabolism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Health Grain intervention</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SYSDIMET</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sysdimet</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sysdimet Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Systems Biology Approach to Understand Dietary Modulation of Gene Expression and Metabolic Pathways in Subjects With Abnormal Glucose Metabolism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Sysdimet study</rdfs:label>
    </owl:NamedIndividual>
