        <obo:IAO_0000112>PGS000740</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:28604730</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of lung cancer epidemiology run from Sheffield, England, since 2006, which recruits pathologically confirmed lung cancer cases diagnosed at age 60 or younger (or older with a family history of lung cancer) and family-matched controls through several cancer treatment centres, mostly in North Trent, collecting a lifestyle, occupational-exposure and family-history questionnaire and blood for DNA.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">689</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">443</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1132</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>RESOLUCENT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ReSoLuCENT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ReSoLucent</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Resolucent</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">The Resource for the Study of Lung Cancer Epidemiology in North Trent</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19780">
