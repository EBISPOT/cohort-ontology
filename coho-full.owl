    <!-- http://www.ebi.ac.uk/coho/COHO_0002006 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002006">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid17595"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000011"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000384"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:26916295</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective study of venous thromboembolism occurrence in the United States that pools two multi-center, longitudinal, population-based cohort studies of white and African American men and women, the Atherosclerosis Risk in Communities (ARIC) Study and the Cardiovascular Health Study (CHS).</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19293</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CHS Longitudinal Investigation of Thromboembolism Etiology Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LITE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>longitudinal investigation of thromboembolism etiology</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Longitudinal Investigation of Thromboembolism Etiology</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17595">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005399"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002006"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17595"/>
        <obo:IAO_0000116>venous thromboembolism</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12020191+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To determine whether atherosclerotic risk factors are also associated with increased incidence of VTE, we conducted a prospective study of 19 293 men and women without previous VTE in 6 US communities between 1987 and 1998.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002006"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000011"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4769380/</oboInOwl:hasDbXref>
        <rdfs:comment>The LITE study is a prospective study of VTE occurrence in 2 pooled, multi-center, longitudinal population-based cohort studies: the ARIC Study [17] and the Cardiovascular Health Study (CHS) [18].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002006"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000384"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4769380/</oboInOwl:hasDbXref>
        <rdfs:comment>The LITE study is a prospective study of VTE occurrence in 2 pooled, multi-center, longitudinal population-based cohort studies: the ARIC Study [17] and the Cardiovascular Health Study (CHS) [18].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002006"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4769380/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>We used the Longitudinal Investigation of Thromboembolism Etiology (LITE), involving two pooled population-based cohorts in the United States including 16,234 participants.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002006"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:26916295</owl:annotatedTarget>
        <dcterms:title>Prospective study of γ&apos; fibrinogen and incident venous thromboembolism: The Longitudinal Investigation of Thromboembolism Etiology (LITE).</dcterms:title>
        <oboInOwl:hasDbXref>PMID:26916295</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4769380/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>We used the Longitudinal Investigation of Thromboembolism Etiology (LITE), involving two pooled population-based cohorts in the United States including 16,234 participants.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002006"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective study of venous thromboembolism occurrence in the United States that pools two multi-center, longitudinal, population-based cohort studies of white and African American men and women, the Atherosclerosis Risk in Communities (ARIC) Study and the Cardiovascular Health Study (CHS).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23650146</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26916295</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002006"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19293</owl:annotatedTarget>
        <obo:IAO_0000116>LITE participants without previous VTE in the original 1987-1998 prospective analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12020191+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To determine whether atherosclerotic risk factors are also associated with increased incidence of VTE, we conducted a prospective study of 19 293 men and women without previous VTE in 6 US communities between 1987 and 1998.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002006"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LITE</owl:annotatedTarget>
