        <oboInOwl:hasRelatedSynonym>Dutch AIH Study Group Consortium</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Dutch Autoimmune Hepatitis Study Group</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14810">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
