        <rdfs:comment>Diet, physical activity, smoking, anthropometry, medical history, NSAID use, family history of cancer, demographics, race/ethnicity, and reproductive history data were obtained by questionnaire.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000569"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid5067"/>
