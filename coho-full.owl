    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002201"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study of a genetic isolate in the Ogliastra region of Sardinia, Italy, in which the inhabitants of ten villages (Baunei, Escalaplano, Loceri, Perdasdefogu, Seui, Seulo, Talana, Triei, Urzulei and Ussassai), invited by public proclamations and letters to every family, took part from 2002 to 2008 in a cross-sectional epidemiological survey with blood sampling and extended pedigrees, to study the genetic and environmental determinants of complex traits.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23382888</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23527229</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26180744</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002201"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12517</owl:annotatedTarget>
        <obo:IAO_0000116>inhabitants of the ten Ogliastra villages (about 80% of residents, aged 3 to 105) who took part in the 2002-2008 survey</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3012770/</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a cross-sectional study on 12,517 inhabitants of ten villages (80% of residents) in a secluded area of Sardinia (Ogliastra).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002201"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>OGP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002202 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002202">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18922"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002069"/>
        <obo:IAO_0000112>PGS004921</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:19885677</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of coronary artery disease at the University of Ottawa Heart Institute, Ottawa, Canada, that recruited people of European ancestry without diabetes, with cases defined by more than 50% stenosis of a major coronary artery at angiography, myocardial infarction or coronary revascularisation, and controls who were either angiographically free of coronary disease or elderly and asymptomatic, genotyped in several phases for genome-wide association studies of coronary artery disease.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3273</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">645</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>OHGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>OHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ottawa Heart Genomic Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ottawa Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Ottawa Heart Genomics Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18922">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005010"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002202"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18922"/>
        <obo:IAO_0000116>coronary artery disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4152257/</oboInOwl:hasDbXref>
        <rdfs:comment>The OHGS excluded individuals with diabetes mellitus to ensure that the genetic risk primarily associated with coronary artery disease would not be confounded by the risk associated with diabetes, as described previously [16].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002202"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>OHGS The Ottawa Heart Genomics Study 17478681 European Canada CAD/MI Cases had at least one of myocardial infarction, coronary artery bypass graft, percutenaeous intervention or a stenosis of at least 50% in at least one epicardial vessel.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002202"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS004921</owl:annotatedTarget>
        <dcterms:title>Sexual Differences in Genetic Predisposition of Coronary Artery Disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33332181</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002202"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:19885677</owl:annotatedTarget>
        <dcterms:title>The transcription factor GATA-2 does not associate with angiographic coronary artery disease in the Ottawa Heart Genomics and Cleveland Clinic GeneBank Studies.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:19885677</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19885677+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We asked whether GATA2 associates with sporadic cases of CAD in the Ottawa Heart Genomics Study (OHGS) and Cleveland Clinic (CC) populations.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002202"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of coronary artery disease at the University of Ottawa Heart Institute, Ottawa, Canada, that recruited people of European ancestry without diabetes, with cases defined by more than 50% stenosis of a major coronary artery at angiography, myocardial infarction or coronary revascularisation, and controls who were either angiographically free of coronary disease or elderly and asymptomatic, genotyped in several phases for genome-wide association studies of coronary artery disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21378990</obo:IAO_0000119>
