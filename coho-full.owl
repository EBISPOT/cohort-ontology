    <!-- http://www.ebi.ac.uk/coho/COHO_0002277 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002277">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19453"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
        <obo:IAO_0000112>PGS000344</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:32424353</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, open-label, multicentre phase IV clinical trial in Germany which in 2009-2011 enrolled postmenopausal women with hormone receptor-positive early breast cancer whose physician had indicated five years of upfront adjuvant letrozole, to evaluate predictive factors of aromatase inhibitor effectiveness, survival and safety, with a biomaterial collection of germline DNA, plasma, serum and tumour tissue.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3529</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Evaluation of PREdictive FACtors Regarding the Effectivity of Aromatase Inhibitor Therapy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Evaluation of Predictive Factors regarding the Effectivity of Aromatase Inhibitor Therapy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PREFACE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PREFACE Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PreFace</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PreFace Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PreFace trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Evaluation of Predictive Factors Regarding the Effectivity of Aromatase Inhibitor Therapy</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19453">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004989"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002277"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19453"/>
        <obo:IAO_0000116>hormone receptor-positive breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10853028/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Postmenopausal hormone receptor-positive BC patients, for whom an upfront five-year therapy with letrozole (2.5 mg/day) was indicated, were eligible.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002277"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10853028/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study was conducted in multiple study sites across Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002277"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000344</owl:annotatedTarget>
        <dcterms:title>European polygenic risk score for prediction of breast cancer shows similar performance in Asian women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32737321</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002277"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32424353</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies 32 novel breast cancer susceptibility loci from overall and subtype-specific analyses.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32424353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7808397/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>BCAC DACC approval is required to access data from the ABCFS, ABCS, ABCTB, BBCC, BBCS, BCEES, BCFR-NY, BCFR-PA, BCFR-UT, BCINIS, BSUCH, CBCS, CECILE, CGPS, CTS, DIETCOMPLYF, ESTHER, GC-HBOC, GENICA, GEPARSIXTO, GESBC, HABCS, HCSC, HEBCS, HMBCS, HUBCS, KARBAC, KBCP, LMBC, MABCS, MARIE, MBCSG, MCBCS, MISS, MMHS, MTLGEBCS, NC-BCFR, OFBCR, ORIGO, pKARMA, POSH, PREFACE, RBCS, SKKDKFZS, SUCCESSB, SUCCESSC, SZBCS, TNBCC, UCIBCS, UKBGS and UKOPS studies (Supplementary Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002277"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, open-label, multicentre phase IV clinical trial in Germany which in 2009-2011 enrolled postmenopausal women with hormone receptor-positive early breast cancer whose physician had indicated five years of upfront adjuvant letrozole, to evaluate predictive factors of aromatase inhibitor effectiveness, survival and safety, with a biomaterial collection of germline DNA, plasma, serum and tumour tissue.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38344045</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002277"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3529</owl:annotatedTarget>
        <obo:IAO_0000116>patients registered before screening and treatment exclusions (2009–2011)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10853028/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>From February 2009 to January 2011, a total of 3529 patients were registered in the PreFace study.</rdfs:comment>
    </owl:Axiom>
