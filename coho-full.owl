        <oboInOwl:hasRelatedSynonym>Prolonged Anticoagulant During Eighteen Months vs Placebo After Initial Six-month Treatment for a First Episode of Idiopathic Pulmonary Embolism</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Prolonged Anticoagulation During eighteen months vs placebo after Initial Six-month treatment for a first episode of idiopathic Pulmonary Embolism</rdfs:label>
