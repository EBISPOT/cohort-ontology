        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002531"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000788</owl:annotatedTarget>
        <dcterms:title>Pan-cancer analysis demonstrates that integrating polygenic risk scores with modifiable risk factors improves risk prediction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33247094</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002531"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:26956414</owl:annotatedTarget>
        <dcterms:title>Meta-analysis of genome-wide association studies discovers multiple loci for chronic lymphocytic leukemia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:26956414</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4786871/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Our discovery meta-analysis included four CLL GWAS of European ancestry: National Cancer Institute NHL GWAS (NCI GWAS), Utah Chronic Lymphocytic Leukemia GWAS (UTAH), Genetic Epidemiology of CLL Consortium GWAS (GEC), and Molecular Epidemiology of Non-Hodgkin Lymphoma GWAS (UCSF).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002531"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of chronic lymphocytic leukaemia in Utah, United States, whose prevalent cases came from the Huntsman Cancer Hospital&apos;s haematology clinics or were identified in the Utah Cancer Registry and verified by medical records and pathology reports, and whose controls, from the same area, were frequency-matched to the cases by sex and birth cohort using the Utah Population Database; it was genotyped genome-wide for studies of genetic susceptibility to the disease.</owl:annotatedTarget>
