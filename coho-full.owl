        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12165857/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were recruited from eight academic hospitals in the province of Quebec, Canada.</rdfs:comment>
    </owl:Axiom>
