    <!-- http://www.ebi.ac.uk/coho/COHO_0002579 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002579">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21727"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PGS000667</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:7572679</obo:IAO_0000112>
        <obo:IAO_0000115>A primary-prevention trial of men aged 45 to 64 with raised plasma cholesterol, recruited in Scotland and randomised to pravastatin or placebo to test whether lowering serum cholesterol reduces fatal and non-fatal myocardial infarction.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6595</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>WOSCOPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">West of Scotland Coronary Prevention Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21727">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005068"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002579"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21727"/>
        <obo:IAO_0000116>myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1624967+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The principal aim is to test the hypothesis that reduction of serum cholesterol by treatment with pravastatin [a competitive inhibitor of 3-hydroxy-3-methylglutaryl coenzyme A (HMG CoA) reductase--a regulatory enzyme in cholesterol synthesis] over an average period of 5 yr will lead to a reduction in fatal and non-fatal myocardial infarction.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002579"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1624967+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This paper describes the design of the West of Scotland Coronary Prevention Study (WOSCOPS) which is a primary prevention trial involving men aged 45-64 yr with raised plasma cholesterol levels.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002579"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000667</owl:annotatedTarget>
        <dcterms:title>Clinical Utility of Lipoprotein(a) and LPA Genetic Risk Score in Risk Prediction of Incident Atherosclerotic Cardiovascular Disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33021622</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002579"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:7572679</owl:annotatedTarget>
        <dcterms:title>The West of Scotland Coronary Prevention Study: a trial of cholesterol reduction in Scottish men.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:7572679</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A7572679+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The West of Scotland Coronary Prevention Study is a primary prevention trial designed to test the hypothesis that reduction of serum cholesterol with pravastatin (a 3-hydroxy-3-methylglutaryl coenzyme A reductase inhibitor) over an average of 5 years will reduce the incidence of fatal and nonfatal myocardial infarction.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002579"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A primary-prevention trial of men aged 45 to 64 with raised plasma cholesterol, recruited in Scotland and randomised to pravastatin or placebo to test whether lowering serum cholesterol reduces fatal and non-fatal myocardial infarction.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:1624967</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:7572679</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Sonnet 5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002579"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6595</owl:annotatedTarget>
        <obo:IAO_0000116>WOSCOPS randomized men with raised cholesterol and no previous MI</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A7572679+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>At entry, 6,595 men aged 45-64 years were randomized to treatment with either pravastatin (40 mg/day) or placebo.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002579"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>WOSCOPS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


