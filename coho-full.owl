        <obo:IAO_0000112>PMID:22504420</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional, population-based study of osteoporosis in Ljubljana, Slovenia, created within projects funded by the Slovenian Research Agency, that included premenopausal women aged 35 to 50 years and postmenopausal women and men aged over 50 years in order to carry out genotype-phenotype association studies; it was one of the studies de novo genotyped for the replication stage of the 2012 GEFOS genome-wide meta-analysis of bone mineral density and fracture.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">716</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SLO-PREVAL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Slo-preval</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Prevalence of osteoporosis in Slovenia</rdfs:label>
    </owl:NamedIndividual>
