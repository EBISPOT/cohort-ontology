        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5302</owl:annotatedTarget>
        <obo:IAO_0000116>adult African Americans enrolled at baseline, including 1499 family members</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:16320381</oboInOwl:hasDbXref>
        <rdfs:comment>Data and biologic materials have been collected from 5302 adult African Americans, including 1499 members of 291 families.</rdfs:comment>
