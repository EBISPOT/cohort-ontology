        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001704"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1251</owl:annotatedTarget>
        <obo:IAO_0000116>ERASE clinical cohort in the 2021 toxicity report</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8883571/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The clinical cohort consisted of 1,251 children with ALL/LBL (Online Supplementary Figure S1) from six tertiary Australian pediatric oncology centers.</rdfs:comment>
    </owl:Axiom>
