    <!-- http://www.ebi.ac.uk/coho/COHO_0001315 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001315">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11872"/>
        <rdf:type rdf:nodeID="genid11874"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90328131</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of adults aged 18 or older living in the city of Detroit, Michigan, most of them African American, drawn from a random probability sample of the city&apos;s households and interviewed by telephone in annual waves from 2008 to 2013, with blood specimens collected from a subset, to study how biological variation, stressful and traumatic experiences and environmental factors contribute to post-traumatic stress disorder, depression and other psychopathology.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1547</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>DNHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Detroit Neighborhood Health Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Detroit Neighborhood Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11872">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002025"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid11874">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005146"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001315"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11872"/>
        <obo:IAO_0000116>psychopathology</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12975512/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The primary objective of the DNHS was to examine how biological variation, stressful and traumatic life experiences, and environmental factors contribute to the prediction of psychopathology and behavior.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001315"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11874"/>
        <obo:IAO_0000116>post-traumatic stress disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12975512/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The primary objective of the DNHS was to examine how biological variation, stressful and traumatic life experiences, and environmental factors contribute to the prediction of psychopathology and behavior.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001315"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12975512/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this investigation, we utilized data from the DNHS, a prospective population-based longitudinal cohort consisting of individuals residing in Detroit, Michigan</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001315"/>
