        <obo:IAO_0000112>GCST90504004</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based prospective cohort of 32,894 mostly White adults in Washington County, Maryland, USA, who gave blood samples, blood pressure readings and brief medical histories during a 1989 campaign against cancer and heart disease run from the Johns Hopkins George W. Comstock Center, followed through cancer-registry linkage to study risk factors for cancer and heart disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32894</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CLUE</oboInOwl:hasRelatedSynonym>
