        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1859</owl:annotatedTarget>
        <obo:IAO_0000116>women with invasive or borderline ovarian tumours among 2,456 consenting cases (2002-2006); controls enrolled</obo:IAO_0000116>
        <oboInOwl:hasDbXref>http://www.aocstudy.org/background.html</oboInOwl:hasDbXref>
