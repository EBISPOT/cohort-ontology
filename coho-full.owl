    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001758"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of type 2 diabetes conducted from September 2009 to January 2010 in Bijie city, Guizhou province, China, recruiting through advertisement unrelated Han Chinese adults aged 30 to 80 with at least ten years&apos; residence in Bijie city.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29083407</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
