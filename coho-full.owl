    <!-- http://www.ebi.ac.uk/coho/COHO_0002634 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002634">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22155"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Luxembourg"/>
        <obo:IAO_0000112>PMID:36581944</obo:IAO_0000112>
        <obo:IAO_0000115>A nationwide population-based study of adults living in the Grand Duchy of Luxembourg, run by the Luxembourg Institute of Health, whose first wave (2007-2009) examined a random sample of residents and whose second wave (2016-2018) re-examined them together with new participants from the civil registry, another national health examination survey and volunteers, with questionnaires, clinical measurements and blood, urine and hair samples, to describe the prevalence and evolution of cardiovascular risk factors.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1558</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ORISCAV-LUX-II</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>ORISCAV-LUX</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ORISCAV-LUX 2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ORISCAV-LUX-II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ORISCAV-LUX2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Observation des Risques et de la Santé Cardio-Vasculaire au Luxembourg</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Observation of Cardiovascular Risk Factors in Luxembourg</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Observation of cardiovascular risk factors in Luxembourg</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Observation of Cardiovascular Risks and Health in Luxembourg</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22155">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002634"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22155"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.lih.lu/en/oriscav-lux/</oboInOwl:hasDbXref>
        <rdfs:comment>ORISCAV-LUX (Observation des Risques et de la Santé Cardio-Vasculaire au Luxembourg = Observation of Cardiovascular Risks and Health in Luxembourg) was the first nationwide epidemiological study aimed at establishing an objective picture of the prevalence of lifestyle-related risk factors for cardiovascular disease in the general population residing in the Grand Duchy of Luxembourg.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002634"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Luxembourg"/>
        <oboInOwl:hasDbXref>https://www.lih.lu/en/oriscav-lux/</oboInOwl:hasDbXref>
        <rdfs:comment>ORISCAV-LUX (Observation des Risques et de la Santé Cardio-Vasculaire au Luxembourg = Observation of Cardiovascular Risks and Health in Luxembourg) was the first nationwide epidemiological study aimed at establishing an objective picture of the prevalence of lifestyle-related risk factors for cardiovascular disease in the general population residing in the Grand Duchy of Luxembourg.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002634"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:36581944</owl:annotatedTarget>
        <dcterms:title>Device-measured physical activity and sedentary time in a national sample of Luxembourg residents: the ORISCAV-LUX 2 study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36581944</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9798598/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Data were from the ORISCAV-LUX 2 study, a national cross-sectional survey of cardiovascular risk factors in the Luxembourgish adult population</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002634"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nationwide population-based study of adults living in the Grand Duchy of Luxembourg, run by the Luxembourg Institute of Health, whose first wave (2007-2009) examined a random sample of residents and whose second wave (2016-2018) re-examined them together with new participants from the civil registry, another national health examination survey and volunteers, with questionnaires, clinical measurements and blood, urine and hair samples, to describe the prevalence and evolution of cardiovascular risk factors.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30717671</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.lih.lu/en/oriscav-lux/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002634"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1558</owl:annotatedTarget>
        <obo:IAO_0000116>participants of wave 2 (2016-2018)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.lih.lu/en/oriscav-lux/</oboInOwl:hasDbXref>
        <rdfs:comment>The ORISCAV-LUX study was carried out by the Luxembourg Institute of Health (LIH) within the Department of Precision Health in 2007–2009 (Wave 1, 1432 participants) and in 2016-2018 (Wave 2, 1558 participants.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002634"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ORISCAV-LUX</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002634"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ORISCAV-LUX 2</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
