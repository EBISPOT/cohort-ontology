        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.723/MediaObjects/41588_2011_BFng723_MOESM3_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Studies included in the replication MD Anderson Renal Cell Cancer Study (MD Anderson)49 MD Anderson Cancer Center(MDACC) , US</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002048"/>
