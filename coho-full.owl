        <dcterms:title>Mexican Biobank Project</dcterms:title>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001005797</oboInOwl:hasDbXref>
        <rdfs:comment>we present the data from the Mexican Biobank Project</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000114"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90296592</owl:annotatedTarget>
        <dcterms:title>Mexican Biobank advances population and medical genomics of diverse ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37821706</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:37821706%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>To fill this gap, the Mexican Biobank project genotyped 6,057 individuals from 898 rural and urban localities across all 32 states in Mexico at a resolution of 1.8 million genome-wide markers with linked complex trait and disease information creating a valuable nationwide genotype-phenotype database.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000114"/>
