        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000134"/>
        <obo:IAO_0000112>PGS000082</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:21943063</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of epithelial ovarian cancer in New Jersey, United States, run by the Cancer Institute of New Jersey, whose cases were women with newly diagnosed invasive epithelial ovarian cancer living in six New Jersey counties, identified from January 2004 to May 2008 through the New Jersey State Cancer Registry, and whose controls were those of the EDGE (Estrogen, Diet, Genetics, and Endometrial Cancer) Study. It was designed to study phytoestrogens and ovarian cancer risk and is one of the studies of the Ovarian Cancer Association Consortium (study code NJO).</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">233</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">467</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>NJ Ovarian Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NJO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NJOCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">New Jersey Ovarian Cancer Study</rdfs:label>
