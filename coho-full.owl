    <!-- http://www.ebi.ac.uk/coho/COHO_0002670 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002670">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>PMID:34257407</obo:IAO_0000112>
        <obo:IAO_0000115>The participants of a randomised controlled trial run by the University of São Paulo Medical School from 2015 of Primeiros Laços, a nurse home visiting programme from early pregnancy to the child&apos;s age of two years, in low-income first-time pregnant adolescents aged 14-19 recruited through primary healthcare units in the western region of São Paulo, Brazil, and their children, followed to test the programme&apos;s effects on child development, maternal and home environment outcomes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/Primeiros%20Laços</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>First Ties Program</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Effect of the Young Pregnant Women&apos;s Home Visiting Program on Child Development: A Pilot Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Effects on Early Brain Development of a Nurse Home Visitation Program for Pregnant Youth and Their Families Living in a Poor Urban Area in Sao Paulo, Brazil</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>YCMP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Caregiving Mothers Program</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Caregiving Mothers Program (YCMP)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Caring Mothers Programme</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Primeiros Laços</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002670"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34257407+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a randomized controlled trial to test the efficacy of Primeiros Laços, a nurse HVP for adolescent mothers living in a poor urban area of São Paulo, Brazil.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002670"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34257407</owl:annotatedTarget>
        <dcterms:title>A randomized controlled trial testing the efficacy of a Nurse Home Visiting Program for Pregnant Adolescents.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34257407</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34257407+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Eighty adolescent mothers were included and randomized to receive either Primeiros Laços (intervention group, n = 40) or healthcare as usual (control group, n = 40).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002670"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The participants of a randomised controlled trial run by the University of São Paulo Medical School from 2015 of Primeiros Laços, a nurse home visiting programme from early pregnancy to the child&apos;s age of two years, in low-income first-time pregnant adolescents aged 14-19 recruited through primary healthcare units in the western region of São Paulo, Brazil, and their children, followed to test the programme&apos;s effects on child development, maternal and home environment outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34257407</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002670"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">80</owl:annotatedTarget>
        <obo:IAO_0000116>pregnant adolescents randomised (40 intervention, 40 usual care), 2015-2016</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:34257407</oboInOwl:hasDbXref>
        <rdfs:comment>Eighty adolescent mothers were included and randomized to receive either Primeiros Laços (intervention group, n = 40) or healthcare as usual (control group, n = 40).</rdfs:comment>
    </owl:Axiom>
