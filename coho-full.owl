    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000183"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2010"/>
        <obo:IAO_0000116>colon cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-023-41819-0/MediaObjects/41467_2023_41819_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Basque-colon cohort included 873 participants with colon cancer, biobanked between 2009- 2019. Participants were diagnosed and/or treated according to usual clinical practice in the Donostia University Hospital, San Sebastian, Spain, including follow-up to this date.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000183"/>
