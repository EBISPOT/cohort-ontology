        <oboInOwl:hasRelatedSynonym>GenomEUtwin study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">GenomEUtwin</rdfs:label>
