        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Anti-Aging Study Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000991"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5566649/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This medical check‐up is provided to general residents of Ehime Prefecture, Japan, and is specifically designed to evaluate ageing‐related disorders, including atherosclerosis, cardiovascular disease, physical function, and mild cognitive impairment.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000991"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90002231</owl:annotatedTarget>
        <dcterms:title>The trans-ancestral genomic architecture of glycemic traits.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34059833</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7610958/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Anti-Aging Study Cohort (AASC)</rdfs:comment>
    </owl:Axiom>
