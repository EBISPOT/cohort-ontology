        <oboInOwl:hasDbXref>https://doi.org/10.1186/1471-2407-6-148</oboInOwl:hasDbXref>
        <rdfs:comment>The total number of subjects from both series that were identified as eligible to participate in the San Francisco Bay Area Adult Glioma Study, 1991–2000, includes 1,110 cases and 1,284 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001481"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1284</owl:annotatedTarget>
        <obo:IAO_0000116>eligible (not necessarily enrolled) cases and controls of series 1-2, 1991-2000</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://doi.org/10.1186/1471-2407-6-148</oboInOwl:hasDbXref>
        <rdfs:comment>The total number of subjects from both series that were identified as eligible to participate in the San Francisco Bay Area Adult Glioma Study, 1991–2000, includes 1,110 cases and 1,284 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
