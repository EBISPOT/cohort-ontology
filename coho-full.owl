        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2305</owl:annotatedTarget>
        <obo:IAO_0000116>analysed subset: patients with TIA or stroke recruited 2002-2012</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6390174/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Among 2305 patients (mean age 74·4 years [SD 13·0]), 688 (30%) had transient ischaemic attacks and 1617 (70%) had strokes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
