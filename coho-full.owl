    <!-- http://www.ebi.ac.uk/coho/COHO_0001471 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001471">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13299"/>
        <rdf:type rdf:nodeID="genid13301"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>PMID:23001564</obo:IAO_0000112>
        <obo:IAO_0000115>A single-centre cohort study at Nancy University Hospital, France, of older treated hypertensive patients with subjective memory complaints, recruited in the early 2000s through local press advertisements and general practitioners of the Inserm clinical investigation centre network, who had cognitive testing, brain MRI for white matter hyperintensities, measurements of arterial stiffness, carotid structure and endothelial function, and DNA and serum banking, and were re-examined about eight years later (ADELAHYDE-2), to identify genetic, environmental and vascular determinants of leukoaraiosis and cognitive decline.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">376</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ADELAHYDE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADELAHYDE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADELAHYDE-Nancy study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Analyse des DEterminants génétiques et environnementaux de la Leucoaraïose dans une population à sujets Agés HYpertendus présentant des troubles cognitifs DEbutants</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Analyse des DEterminants génétiques et environnementaux de la Leucoaraiose dans une population de sujets Agés Hypertendus présentant des troubles cognitifs DEbutants</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13299">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005044"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid13301">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0850292"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001471"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13299"/>
        <obo:IAO_0000116>hypertension</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7175941/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Inclusion criteria for ADELAHYDE were age 60–85 years with arterial hypertension (&gt;1 year from diagnosis, receiving antihypertensive treatment for at least one month), presenting with low-grade subjective memory complaints (SMCs) defined as a McNair scale &gt;15 (revised validated French version of 26 items).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001471"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13301"/>
        <obo:IAO_0000116>subjective memory complaints</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7175941/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Inclusion criteria for ADELAHYDE were age 60–85 years with arterial hypertension (&gt;1 year from diagnosis, receiving antihypertensive treatment for at least one month), presenting with low-grade subjective memory complaints (SMCs) defined as a McNair scale &gt;15 (revised validated French version of 26 items).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001471"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4197385/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were recruited between 2003 and 2005 by local press advertisements or referred by general practitioners from an investigator network of the Inserm Clinical Investigation Center, France[19].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001471"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23001564</owl:annotatedTarget>
        <dcterms:title>Genome-wide meta-analysis points to CTC1 and ZNF676 as genes regulating telomere homeostasis in humans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23001564</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510758/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Samples from the Jerusalem LRC Longitudinal Study (N = 620) (68), Health ABC study (N = 337) (69), from ADELAHYDE-Nancy study and ERA-France study (N = 316) (70,71) and from a Danish collection (N = 964) (47) were included in the replication stage.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001471"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A single-centre cohort study at Nancy University Hospital, France, of older treated hypertensive patients with subjective memory complaints, recruited in the early 2000s through local press advertisements and general practitioners of the Inserm clinical investigation centre network, who had cognitive testing, brain MRI for white matter hyperintensities, measurements of arterial stiffness, carotid structure and endothelial function, and DNA and serum banking, and were re-examined about eight years later (ADELAHYDE-2), to identify genetic, environmental and vascular determinants of leukoaraiosis and cognitive decline.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19246701</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25332706</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29276677</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32039844</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT01351961</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001471"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">376</owl:annotatedTarget>
        <obo:IAO_0000116>hypertensive patients included at visit 1 (ADELAHYDE-1)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7175941/</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 376 patients included in V1, 131 participated in V2 (among the rest, 51 patients died, 60 were lost to follow-up, 130 were not able to visit due to their functional status and/or refused to participate, and 6 patients provided no specific reason).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001471"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ADELAHYDE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001472 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001472">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>PMID:23001564</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal study of the determinants of arterial ageing in French adults of a Paris cohort followed at the Centre d&apos;Investigations Préventives et Cliniques, re-examined years apart with measurements of aortic stiffness and carotid atherosclerosis, and with leukocyte telomere length measured at successive examinations.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">483</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ERA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ERA-France study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Evolution de la Rigidité Artérielle</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001472"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5903283/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were from a Parisian cohort that had been followed at the Centre d’Investigations Préventives et Cliniques.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001472"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23001564</owl:annotatedTarget>
        <dcterms:title>Genome-wide meta-analysis points to CTC1 and ZNF676 as genes regulating telomere homeostasis in humans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23001564</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510758/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Samples from the Jerusalem LRC Longitudinal Study (N = 620) (68), Health ABC study (N = 337) (69), from ADELAHYDE-Nancy study and ERA-France study (N = 316) (70,71) and from a Danish collection (N = 964) (47) were included in the replication stage.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001472"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal study of the determinants of arterial ageing in French adults of a Paris cohort followed at the Centre d&apos;Investigations Préventives et Cliniques, re-examined years apart with measurements of aortic stiffness and carotid atherosclerosis, and with leukocyte telomere length measured at successive examinations.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11889014</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28630210</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001472"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">483</owl:annotatedTarget>
        <obo:IAO_0000116>subjects with two health checkups (1992-1993 and 1998-1999) analysed</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11889014+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The aim of the present longitudinal study was to compare the progression of aortic stiffness over a 6-year period in treated hypertensive subjects and normotensive subjects, and to evaluate the determinants of this progression.Methods and resultsData for the present analysis were gathered from 483 subjects who had 2 health checkups at the Centre d&apos;Investigations Préventives et Cliniques, the first one in 1992--1993 and the second one in 1998--1999.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001472"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ERA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001473 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001473">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13313"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
