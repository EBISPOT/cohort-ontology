        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8497462/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants in the HerediGene: Population study are voluntary US residents over the age of 18 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000563"/>
