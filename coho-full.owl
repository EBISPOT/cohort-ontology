        <oboInOwl:hasRelatedSynonym>Pittsburgh Orofacial Clefts Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
