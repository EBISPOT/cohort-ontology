    <!-- http://www.ebi.ac.uk/coho/COHO_0002080 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002080">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18134"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001316"/>
        <obo:IAO_0000112>PMID:32413043</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective multicentre study of women treated for endometrial cancer (ClinicalTrials.gov NCT00598845), centred on Haukeland University Hospital in Bergen, Norway, that between May 2001 and February 2013 enrolled consenting patients at ten hospitals in Norway, Belgium and Sweden within the European Network for Individualized Treatment of Endometrial Cancer (ENITEC), collecting preoperative curettage or biopsy specimens, tumour tissue, blood and clinical follow-up to study molecular markers of lymph node metastasis and prognosis for preoperative risk stratification.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1372</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MoMaTEC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MoMaTEC study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MoMaTEC1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Molecular Markers for Treatment of Endometrial Cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Molecular Markers in Treatment in Endometrial Cancer</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Molecular Markers in Treatment of Endometrial Cancer</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18134">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011962"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002080"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18134"/>
        <obo:IAO_0000116>endometrial cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5542466/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 1372 MoMaTEC patients treated for primary endometrial cancer by hysterectomy and bilateral salpingo-oopherectomy, 1302 patients were included in the final analyses.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002080"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5542466/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We thank all participants involved in recruiting patients at the MoMaTEC centers: Haukeland University Hospital, Bergen, Norway; St.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002080"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32413043</owl:annotatedTarget>
        <dcterms:title>Preoperative risk stratification in endometrial cancer (ENDORISK) by a Bayesian network model: A development and validation study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32413043</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32413043+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>External validation was performed using 2 prospective study cohorts: the Molecular Markers in Treatment in Endometrial Cancer (MoMaTEC) study cohort, including 446 Norwegian patients, median age 64 years (IQR 59-74), treated between May 2001 and 2010; and the PIpelle Prospective ENDOmetrial carcinoma (PIPENDO) study cohort, including 384 Dutch patients, median age 66 years (IQR 60-73), treated between September 2011 and December 2013.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002080"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective multicentre study of women treated for endometrial cancer (ClinicalTrials.gov NCT00598845), centred on Haukeland University Hospital in Bergen, Norway, that between May 2001 and February 2013 enrolled consenting patients at ten hospitals in Norway, Belgium and Sweden within the European Network for Individualized Treatment of Endometrial Cancer (ENITEC), collecting preoperative curettage or biopsy specimens, tumour tissue, blood and clinical follow-up to study molecular markers of lymph node metastasis and prognosis for preoperative risk stratification.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23932335</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25897678</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27135401</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28771617</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002080"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1372</owl:annotatedTarget>
        <obo:IAO_0000116>Consenting MoMaTEC patients included at ten centers, May 2001-February 2013</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5542466/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>After obtaining written informed consent, a total of 1372 patients from 10 centers were included in the MoMaTEC study (Molecular Markers in Treatment of Endometrial Cancer, Clinical Trial Identifier NCT00598845) between May 2001 and February 2013.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002080"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MoMaTEC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002080"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MoMaTEC1</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
