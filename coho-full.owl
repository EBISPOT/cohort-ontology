        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001363"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of gastric cancer at the National Cancer Center in Goyang, South Korea, that from March 2011 to December 2014 recruited patients recently diagnosed with gastric cancer at its Center for Gastric Cancer as cases and cancer-free people attending health-screening check-ups at its Center for Cancer Prevention and Detection as controls, with lifestyle and food-frequency questionnaires and blood DNA genotyped on an exome array, to study dietary and genetic risk factors for gastric cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33634021</obo:IAO_0000119>
