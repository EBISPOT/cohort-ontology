    <!-- http://www.ebi.ac.uk/coho/COHO_0002457 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002457">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20905"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <obo:IAO_0000112>PGS000718</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33012170</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, single-blinded, multicentre randomised trial, run at centres in Switzerland and Germany from 2003 to 2008, in which patients aged 60 years or over with symptomatic congestive heart failure, a heart-failure hospitalisation within the previous year and raised NT-proBNP were randomised to NT-proBNP-guided (intensified) or symptom-guided (standard) medical therapy, to compare the two strategies in patients aged 75 or over and aged 60 to 74, with reduced or preserved ejection fraction.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">622</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TIME-CHF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Trial of Intensified Versus Standard Medical Therapy in Elderly Patients with Congestive Heart Failure</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Trial of Intensified versus Standard Medical Therapy in Elderly Patients with Congestive Heart Failure</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Trial of Intensified vs Standard Medical Therapy in Elderly Patients With Congestive Heart Failure</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Trial of Intensified versus standard Medical therapy in Elderly patients with Congestive Heart Failure</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20905">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005009"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002457"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20905"/>
        <obo:IAO_0000116>congestive heart failure</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16644310+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Therefore, the TIME-CHF study was set up (1) to evaluate the medical management of very old patients (&gt; or = 75 years) with CHF compared with younger patients (60-74 years), (2) to compare an intensified with a standard treatment approach, and (3) to differentiate between systolic and diastolic dysfunction (ejection fraction 45%).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002457"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7738407/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>TIME-CHF was a randomized controlled trial that took place at 15 centers in Switzerland and Germany from January 2003 to June 2008 that enrolled a total of 622 patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002457"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000718</owl:annotatedTarget>
        <dcterms:title>Polygenic Score for β-Blocker Survival Benefit in European Ancestry Patients With Reduced Ejection Fraction Heart Failure.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33012170</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002457"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33012170</owl:annotatedTarget>
        <dcterms:title>Polygenic Score for β-Blocker Survival Benefit in European Ancestry Patients With Reduced Ejection Fraction Heart Failure.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33012170</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7738407/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>TIME-CHF was a randomized controlled trial that took place at 15 centers in Switzerland and Germany from January 2003 to June 2008 that enrolled a total of 622 patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002457"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, single-blinded, multicentre randomised trial, run at centres in Switzerland and Germany from 2003 to 2008, in which patients aged 60 years or over with symptomatic congestive heart failure, a heart-failure hospitalisation within the previous year and raised NT-proBNP were randomised to NT-proBNP-guided (intensified) or symptom-guided (standard) medical therapy, to compare the two strategies in patients aged 75 or over and aged 60 to 74, with reduced or preserved ejection fraction.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16644310</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33012170</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002457"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">622</owl:annotatedTarget>
        <obo:IAO_0000116>TIME-CHF enrolled congestive-heart-failure patients (2008)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7738407/</oboInOwl:hasDbXref>
        <rdfs:comment>TIME-CHF was a randomized controlled trial that took place at 15 centers in Switzerland and Germany from January 2003 to June 2008 that enrolled a total of 622 patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002457"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TIME-CHF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
