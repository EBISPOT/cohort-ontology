    <!-- http://www.ebi.ac.uk/coho/COHO_0001648 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001648">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14835"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PGS004241</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:21750109</obo:IAO_0000112>
        <obo:IAO_0000115>A German hospital-based case-control study of urinary bladder cancer at the Department of Urology of St.-Josefs-Hospital Dortmund-Hörde, in the Ruhr area (a former coal, iron and steel industry region), whose cases have confirmed bladder cancer and whose controls are cancer-free patients of the same department admitted for benign urological diseases, enrolled from July 2009 to July 2010; it has contributed to genome-wide association studies of bladder cancer.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">197</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">240</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>DBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Dortmund bladder cancer study</oboInOwl:hasRelatedSynonym>
