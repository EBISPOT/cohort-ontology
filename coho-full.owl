    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000136"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7640</owl:annotatedTarget>
        <obo:IAO_0000116>participants recruited by 2017</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837504/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The 7640 participants recruited so far in the OBB have a wide range of phenotypes that allow studying specific disease characteristics in relation to both their genotype and their phenotype.</rdfs:comment>
    </owl:Axiom>
