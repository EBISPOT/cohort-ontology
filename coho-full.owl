        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0594-5/MediaObjects/41588_2020_594_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>MPIP/MARS old mmi2 584 517 1101 1 Yes 291 49.83 MPIP/MARS new mmo4 264 371 635 1 Yes 113 42.80</rdfs:comment>
