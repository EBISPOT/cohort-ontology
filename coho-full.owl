    <!-- http://www.ebi.ac.uk/coho/COHO_0002173 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002173">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18744"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>PMID:23690342</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, randomised, open, blinded-endpoint multicentre trial started in 1992 that enrolled patients aged 50-74 with primary hypertension and a diastolic blood pressure of 100 mm Hg or more at primary health care centres and hospital hypertension units in Norway and Sweden, and randomly assigned them to diltiazem or to conventional treatment with diuretics, beta-blockers or both, to compare their effects on cardiovascular morbidity and mortality.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10881</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NORDIL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nordic Diltiazem study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nordic diltiazem intervention study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Nordic Diltiazem Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18744">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001134"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002173"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18744"/>
        <obo:IAO_0000116>primary hypertension</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8173702+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Male and female patients, aged 50-69, with primary hypertension are randomly allocated to therapy starting with either diltiazem (180-360 mg daily) or conventional treatment (diuretics or beta-adrenergic blockers).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002173"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8173702+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This trial is a prospective randomized open blinded-endpoint (PROBE) multicenter, parallel-group study conducted in Norway and Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002173"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23690342</owl:annotatedTarget>
        <dcterms:title>Pharmacogenomic association of nonsynonymous SNPs in SIGLEC12, A1BG, and the selectin region and cardiovascular outcomes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23690342</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23690342+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A genetic risk score was constructed from the top 3 signals and tested in the Nordic Diltiazem study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002173"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, randomised, open, blinded-endpoint multicentre trial started in 1992 that enrolled patients aged 50-74 with primary hypertension and a diastolic blood pressure of 100 mm Hg or more at primary health care centres and hospital hypertension units in Norway and Sweden, and randomly assigned them to diltiazem or to conventional treatment with diuretics, beta-blockers or both, to compare their effects on cardiovascular morbidity and mortality.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10972367</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:8173702</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002173"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10881</owl:annotatedTarget>
        <obo:IAO_0000116>NORDIL randomized hypertensive patients</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10972367+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In a prospective, randomised, open, blinded endpoint study, we enrolled 10,881 patients, aged 50-74 years, at health centres in Norway and Sweden, who had diastolic blood pressure of 100 mm Hg or more.</rdfs:comment>
    </owl:Axiom>
