        <oboInOwl:hasRelatedSynonym>CWRU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Cleveland Clinic Foundation/Veteran Affairs Medical Center Cohort</rdfs:label>
    </owl:NamedIndividual>
