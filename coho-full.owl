    <!-- http://www.ebi.ac.uk/coho/COHO_0001106 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001106">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <obo:IAO_0000112>GCST90642419</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based register of adult twins and other multiples from the region of Murcia, southeast Spain, created in 2006 through an agreement between the University of Murcia and the Murcia Health Council, which identifies twins in the computerised databases of the regional health system and collects interview, questionnaire and anthropometric data in successive waves, with a biobank, for research on genetic and environmental influences on health and health-related behaviours; it began with female twins born 1940-1966 and later added male and opposite-sex twins.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MTR also denotes Minnesota Twin Family Registry (COHO:0002098); this term is Murcia Twin Registry.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3971</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MTR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MurciaTR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Murcia Twin Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001106"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12367547/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>MTR is a population-based register of adult twins in the region of Murcia, located in southeast Spain.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001106"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90642419</owl:annotatedTarget>
        <dcterms:title>Genetics of monozygotic twins reveals the impact of environmental sensitivity on psychiatric and neurodevelopmental phenotypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40494901</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12367547/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Murcia Twin Registry is funded by the Spanish Ministerio de Ciencia, Innovación y Universidades (RTI2018-095185-B-I00), co-funded by the European Regional Development Fund.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001106"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based register of adult twins and other multiples from the region of Murcia, southeast Spain, created in 2006 through an agreement between the University of Murcia and the Murcia Health Council, which identifies twins in the computerised databases of the regional health system and collects interview, questionnaire and anthropometric data in successive waves, with a biobank, for research on genetic and environmental influences on health and health-related behaviours; it began with female twins born 1940-1966 and later added male and opposite-sex twins.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23046559</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41913940</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001106"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3971</owl:annotatedTarget>
        <obo:IAO_0000116>individual twins with data in the registry (2026)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:41913940</oboInOwl:hasDbXref>
        <rdfs:comment>The registry currently includes data from 3971 individual twins born between 1940 and 1999, as well as an associated biobank containing samples from 1586 participants.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001106"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MTR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001106"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MurciaTR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001107 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001107">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid10141"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Greece"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Poland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90708782</obo:IAO_0000112>
        <obo:IAO_0000115>A collaboration of the University of Exeter, King&apos;s College London, Innlandet Hospital Trust, the University of Oslo and Stavanger University Hospital that undertakes secondary analysis of data on patients with Alzheimer&apos;s disease from cohort studies and patient registries, to study the genetics of neuropsychiatric symptoms such as psychosis in dementia. Its sources are the Norwegian registry of persons assessed for cognitive symptoms (NorCog) with the affiliated Progression of Alzheimer&apos;s Disease and Resource Use study, the REDIC-NH and Health and Memory Study nursing-home cohorts in Norway, AddNeuroMed, and hospital outpatient clinics in Italy and Greece.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3111</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NEXGENS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Norwegian, Exeter and King&apos;s College Consortium for Genetics of Neuropsychiatric Symptoms in Dementia</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10141">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004975"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10141"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11114588/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All were diagnosed with possible, probable, 20 and when available, autopsy‐confirmed definite 21 AD (for participant characteristics see Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Greece"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11114588/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>and from the following outpatient clinics in Italy and Greece (Italian and Greek Hospital Outpatients): Centre for Neurodegenerative Disorders, University of Brescia; IRCCS Casa Sollievo della Sofferenza, Neuropsychiatry Clinic of the Eginition Hospital, Athens.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Norway"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11114588/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>NorCog is a national quality- and research registry collecting extensive clinical data and biobank material at outpatient clinics across Norway.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Poland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11114588/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The AddNeuroMed study involves six cross-European collection study sites; London (United Kingdom), Toulouse (France), Perugia (Italy), Kuopio (Finland), Lodz (Poland), and Thessaloniki (Greece)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90708782</owl:annotatedTarget>
        <dcterms:title>Genetic associations with psychosis and affective disturbance in Alzheimer&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38784964</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11114588/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>testing, and in some cases neuropathologic assessment, conducted during participation in one of the following six source programs (see Supplemental Material for details for each source program), as previously described 15 : the Fundació ACE Barcelona Alzheimer Treatment and Research Center (ACE/GR@ACE), a Consortium of National Institute on Aging Alzheimer Disease Centers (ADC), Eli Lilly and Company (LILLY), the Norwegian, Exeter and King&apos;s College Consortium for Genetics of Neuropsychiatric Symptoms in Dementia (NEXGENS), the National Institute on Aging&apos;s Late Onset Alzheimer&apos;s Disease Family Study (NIA‐LOAD), and the University of Pittsburgh Alzheimer Disease Research Center (PITT ADRC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collaboration of the University of Exeter, King&apos;s College London, Innlandet Hospital Trust, the University of Oslo and Stavanger University Hospital that undertakes secondary analysis of data on patients with Alzheimer&apos;s disease from cohort studies and patient registries, to study the genetics of neuropsychiatric symptoms such as psychosis in dementia. Its sources are the Norwegian registry of persons assessed for cognitive symptoms (NorCog) with the affiliated Progression of Alzheimer&apos;s Disease and Resource Use study, the REDIC-NH and Health and Memory Study nursing-home cohorts in Norway, AddNeuroMed, and hospital outpatient clinics in Italy and Greece.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38784964</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3111</owl:annotatedTarget>
        <obo:IAO_0000116>AD cases from 11 cohort studies in the consortium&apos;s 2019 psychosis PRS analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6805870/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Schizophrenia PRS was calculated using Psychiatric Genomics Consortium data at ten GWAS p value thresholds ( P T ) in 3111 AD cases from 11 cohort studies characterized for psychosis using validated, standardized tools.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NEXGENS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001108 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001108">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10150"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90104085</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control sample of people with Parkinson&apos;s disease, diagnosed by modified UK Brain Bank criteria, and neurologically healthy controls (community volunteers and patients&apos; spouses), recruited by the NeuroGenetics Research Consortium at affiliated neurology and movement disorder clinics in Oregon, Washington, Georgia and New York, United States, with uniform, standardised methods for diagnosis, subject selection, data collection and DNA preparation, for genetic and gene-environment studies of Parkinson&apos;s disease, and genotyped genome-wide.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2000</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1986</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3986</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NGRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">NeuroGenetics Research Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10150">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001108"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10150"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20711177+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a genome-wide association study of 2,000 individuals with Parkinson&apos;s disease (cases) and 1,986 unaffected controls from the NeuroGenetics Research Consortium (NGRC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001108"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7293233/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects were enrolled by NGRC investigators, using standardized methods, at four NGRC-affiliated movement disorder clinics in the United States.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001108"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90104085</owl:annotatedTarget>
        <dcterms:title>Common X-Chromosome Variants Are Associated with Parkinson Disease Risk.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33583074</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8601399/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The PD cohorts include the International PD Genomics Consortium (IPDGC) NeuroX dataset, the National Institute of Neurological Disorders and Stroke (NINDS) PD dataset, the Autopsy-Confirmed PD GWAS Consortium (APDGC) dataset genotyped by the Center for Inherited Disease Research, the NeuroGenetics Research Consortium (NGRC) dataset, the UK PD Consortium, and the Wellcome Trust Case Control Consortium 2, referred to here as EBI MERGE.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001108"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control sample of people with Parkinson&apos;s disease, diagnosed by modified UK Brain Bank criteria, and neurologically healthy controls (community volunteers and patients&apos; spouses), recruited by the NeuroGenetics Research Consortium at affiliated neurology and movement disorder clinics in Oregon, Washington, Georgia and New York, United States, with uniform, standardised methods for diagnosis, subject selection, data collection and DNA preparation, for genetic and gene-environment studies of Parkinson&apos;s disease, and genotyped genome-wide.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20711177</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32566740</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001108"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
