    <!-- http://www.ebi.ac.uk/coho/COHO_0001992 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001992">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17478"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS000740</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:28604730</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of lung cancer in southeastern, Appalachian Kentucky, United States, run by the Markey Cancer Center and the University of Kentucky with Department of Defense funding, which from January 2012 to September 2014 recruited newly diagnosed cases through the Kentucky Cancer Registry and controls from the same region by random-digit dialling, and collected blood, toenail, urine, water, soil and radon samples, residential GPS mapping and an epidemiologic, occupational and health-history questionnaire, to study the region&apos;s very high lung cancer rates.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">520</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>KLCRI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LCRI DoD Lung Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LCRI-DOD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Kentucky Lung Cancer Research Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17478">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001992"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17478"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Kentucky Lung Cancer Research Initiative is a study conducted by the Markey Cancer Center Cancer Center and the University of Kentucky using a population-based, case- control framework to study the extraordinarily high rates of lung cancer in Southeastern, Appalachian Kentucky.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001992"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Kentucky Lung Cancer Research Initiative is a study conducted by the Markey Cancer Center Cancer Center and the University of Kentucky using a population-based, case- control framework to study the extraordinarily high rates of lung cancer in Southeastern, Appalachian Kentucky.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001992"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000740</owl:annotatedTarget>
        <dcterms:title>Assessing Lung Cancer Absolute Risk Trajectory Based on a Polygenic Risk Model.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33472890</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001992"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28604730</owl:annotatedTarget>
        <dcterms:title>Large-scale association analysis identifies new lung cancer susceptibility loci and heterogeneity in genetic susceptibility across histological subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28604730</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Kentucky Lung Cancer Research Initiative is a study conducted by the Markey Cancer Center Cancer Center and the University of Kentucky using a population-based, case- control framework to study the extraordinarily high rates of lung cancer in Southeastern, Appalachian Kentucky.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001992"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of lung cancer in southeastern, Appalachian Kentucky, United States, run by the Markey Cancer Center and the University of Kentucky with Department of Defense funding, which from January 2012 to September 2014 recruited newly diagnosed cases through the Kentucky Cancer Registry and controls from the same region by random-digit dialling, and collected blood, toenail, urine, water, soil and radon samples, residential GPS mapping and an epidemiologic, occupational and health-history questionnaire, to study the region&apos;s very high lung cancer rates.</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001992"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">520</owl:annotatedTarget>
        <obo:IAO_0000116>subjects recruited in Appalachian Kentucky, January 2012 to September 2014</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Study accrual began in January 5, 2012 and completed on September 5, 2014 and 520 subjects were recruited in a 4:1 ratio of controls: cases from Appalachian Kentucky.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
