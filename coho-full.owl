        <rdfs:comment>The Blue Mountains Eye Study (BMES) is a population-based cohort study of common eye diseases and other health outcomes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001061"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1524813/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study involved eligible permanent residents aged 49 years and older, living in two postcode areas in the Blue Mountains, west of Sydney, Australia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001061"/>
