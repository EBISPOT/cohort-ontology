    <!-- http://www.ebi.ac.uk/coho/COHO_0001846 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001846">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. HCSC is the Hospital Clínico San Carlos, a university hospital in Madrid, Spain. The PGS Catalog uses the id for two different contributions of that hospital: its breast cancer cases and controls in the Breast Cancer Association Consortium (BCAC, COHO:0000020), and its BRCA1/2 mutation carriers in CIMBA (COHO:0000901). In both, the papers name the sample only after the hospital (&apos;HCSC Hospital Clinico San Carlos&apos;; &apos;Hospital Clinico San Carlos (HCSC)&apos;) and describe no study design, recruitment period or study name, so the id is an institution label, as the review decided for the other institution-named CIMBA sites (BIDMC, UPENN, MSKCC, Chicago). If the curator ever mints BCAC or CIMBA site samples, this id would need two terms, one per consortium. No COHO term uses HCSC or the hospital&apos;s name. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Hospital Clinico San Carlos</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001847 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001847">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000875"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. HDAAM is the dbGaP study &apos;High Density SNP Association Analysis of Melanoma: Case-Control and Outcomes Investigation&apos; (phs000187), under which the MD Anderson melanoma GWAS deposited its data (PMID:21926416). Replaced by COHO:0000875 (MD Anderson Cancer Center melanoma study), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete High Density SNP Association Analysis of Melanoma</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001848 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001848">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
