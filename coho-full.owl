    <!-- http://www.ebi.ac.uk/coho/COHO_0001628 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001628">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14683"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <obo:IAO_0000112>PMID:23535732</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of prostate cancer in Copenhagen, Denmark, whose cases are unselected men with pathologically confirmed, mainly clinically detected prostate cancer recruited at two Copenhagen University Hospital sites, Herlev Hospital in 2008–2011 (Copenhagen Prostate Cancer Study 1, CPCS1) and Rigshospitalet in 2010–2011 (Copenhagen Prostate Cancer Study 2, CPCS2), and whose controls are prostate-cancer-free men from the Copenhagen general population who took part in the Copenhagen City Heart Study or the Copenhagen General Population Study. Participants are white men of Danish descent who completed questionnaires and gave blood samples for DNA.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CPCS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Copenhagen Prostate Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14683">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001628"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14683"/>
