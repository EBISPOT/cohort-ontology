    <!-- http://www.ebi.ac.uk/coho/COHO_0001855 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001855">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:42471507</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of men and women born in 1931–1939 in Hertfordshire, United Kingdom, who still lived there in 1998–2004, when they completed a home interview and a clinic visit for a detailed health assessment, and some of whom were followed up in later waves, recruited initially to investigate the relationship between growth in infancy and the risk of adult diseases and since used to study musculoskeletal and general health in older age.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym HCS also denotes Hunter Community Study (COHO:0000095); this term is Hertfordshire Cohort Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2997</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HerCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Hertfordshire</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Hertfordshire cohort study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Hertfordshire Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001855"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12942649/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Hertfordshire Cohort Study consists of 1579 men and 1418 women who were born in Hertfordshire (UK) from 1931–1939, and who still lived there in 1998–2004 when they completed a home interview and clinic visit for a detailed health assessment.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001855"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42471507</owl:annotatedTarget>
        <dcterms:title>Biological age-acceleration in relation to muscle mass, strength and function: findings from the Hertfordshire Cohort Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42471507</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42471507+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Overall, 331 participants from the UK community-dwelling Hertfordshire Cohort Study were analysed.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001855"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of men and women born in 1931–1939 in Hertfordshire, United Kingdom, who still lived there in 1998–2004, when they completed a home interview and a clinic visit for a detailed health assessment, and some of whom were followed up in later waves, recruited initially to investigate the relationship between growth in infancy and the risk of adult diseases and since used to study musculoskeletal and general health in older age.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:39751886</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41754086</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001855"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2997</owl:annotatedTarget>
        <obo:IAO_0000116>men and women born in Hertfordshire in 1931-1939 and still living there, who make up the cohort</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.287/MediaObjects/41588_2009_BFng287_MOESM14_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Hertfordshire Cohort Study comprises 2,997 men and women born in the English county of Hertfordshire during the period 1931-1939 and still resident there today.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001855"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
