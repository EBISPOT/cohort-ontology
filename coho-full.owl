    <!-- http://www.ebi.ac.uk/coho/COHO_0000246 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000246">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid2466"/>
        <rdf:type rdf:nodeID="genid2468"/>
