    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001571 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001571">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14195"/>
        <rdf:type rdf:nodeID="genid14197"/>
        <rdf:type rdf:nodeID="genid14199"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000560"/>
        <obo:IAO_0000112>PMID:28604730</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, randomised, double-blind, placebo-controlled trial of daily beta-carotene (30 mg) plus retinyl palmitate (25,000 IU) for the primary prevention of lung cancer in people at high risk of it, namely male and female heavy smokers and former smokers and asbestos-exposed men, recruited at centres in Seattle, Portland, San Francisco, Irvine, Baltimore and New Haven, United States, in a pilot phase from 1985 and an efficacy phase from 1989. The intervention was stopped in January 1996, 21 months early, because it increased lung cancer incidence and mortality; participants were followed through 2005, and the serum, plasma, whole blood and lung tissue collected during the trial form the CARET Biorepository.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18314</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Beta Carotene and Retinol Efficacy Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Beta-Carotene and Retinol Efficacy Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CARET</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>β-Carotene and Retinol Efficacy Trial</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Carotene and Retinol Efficacy Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14195">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid14197">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_with_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000029"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid14199">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_with_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_9000033"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001571"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14195"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8137335+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>CARET is a multicenter, two-armed, double-masked randomized chemoprevention trial in Seattle, Portland, San Francisco, Baltimore, Connecticut, and Irvine, to test whether oral administration of beta-carotene (30 mg/day) plus retinyl palmitate (25,000 IU/day) can decrease the incidence of lung cancer in high risk populations, namely, heavy smokers and asbestos-exposed workers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001571"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14197"/>
        <obo:IAO_0000116>heavy smoking</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8137335+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>CARET is a multicenter, two-armed, double-masked randomized chemoprevention trial in Seattle, Portland, San Francisco, Baltimore, Connecticut, and Irvine, to test whether oral administration of beta-carotene (30 mg/day) plus retinyl palmitate (25,000 IU/day) can decrease the incidence of lung cancer in high risk populations, namely, heavy smokers and asbestos-exposed workers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001571"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14199"/>
        <obo:IAO_0000116>occupational asbestos exposure</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8137335+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>CARET is a multicenter, two-armed, double-masked randomized chemoprevention trial in Seattle, Portland, San Francisco, Baltimore, Connecticut, and Irvine, to test whether oral administration of beta-carotene (30 mg/day) plus retinyl palmitate (25,000 IU/day) can decrease the incidence of lung cancer in high risk populations, namely, heavy smokers and asbestos-exposed workers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001571"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1844268+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>CARET is a multi-center collaboration, with participants recruited in Seattle, Portland, San Francisco, Irvine, Baltimore and New Haven.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001571"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28604730</owl:annotatedTarget>
        <dcterms:title>Large-scale association analysis identifies new lung cancer susceptibility loci and heterogeneity in genetic susceptibility across histological subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28604730</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>For the OncoArray Project, CARET provided DNA extracted from whole blood of lung cancer cases and controls matched on age at baseline (+/- 4 years), sex, race, baseline smoking status, history of occupational asbestos exposure (asbestos vs heavy smoker), and year of enrollment (2-year intervals).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001571"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre, randomised, double-blind, placebo-controlled trial of daily beta-carotene (30 mg) plus retinyl palmitate (25,000 IU) for the primary prevention of lung cancer in people at high risk of it, namely male and female heavy smokers and former smokers and asbestos-exposed men, recruited at centres in Seattle, Portland, San Francisco, Irvine, Baltimore and New Haven, United States, in a pilot phase from 1985 and an efficacy phase from 1989. The intervention was stopped in January 1996, 21 months early, because it increased lung cancer incidence and mortality; participants were followed through 2005, and the serum, plasma, whole blood and lung tissue collected during the trial form the CARET Biorepository.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15572756</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:1844268</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:8137335</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:8602180</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001571"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">18314</owl:annotatedTarget>
        <obo:IAO_0000116>participants randomised (smokers, former smokers and asbestos-exposed workers)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:15572756</oboInOwl:hasDbXref>
        <rdfs:comment>The Beta-Carotene and Retinol Efficacy Trial (CARET) tested the effect of daily beta-carotene (30 mg) and retinyl palmitate (25,000 IU) on the incidence of lung cancer, other cancers, and death in 18,314 participants who were at high risk for lung cancer because of a history of smoking or asbestos exposure.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001571"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CARET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001572 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001572">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14206"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:42473435</obo:IAO_0000112>
        <obo:IAO_0000115>A multiphase randomised trial of the effectiveness of antipsychotic drugs in adults aged 18–67 with chronic schizophrenia, run under the US National Institute of Mental Health&apos;s CATIE programme in 2001–2004 at 57 clinical sites across the United States (public mental health, academic, Veterans Affairs and managed care settings), whose double-blind first phase compared the first-generation drug perphenazine with the second-generation drugs olanzapine, quetiapine, risperidone and ziprasidone for up to 18 months, with all-cause treatment discontinuation as the primary outcome. Participants could join an optional genetic sub-study by donating DNA.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1493</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CATIE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CATIE schizophrenia trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CATIE-US</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Clinical Antipsychotic Trial of Intervention Effectiveness</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Clinical Antipsychotic Trial of Intervention Effectiveness study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Clinical Antipsychotic Trials for Intervention Effectiveness study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Clinical Antipsychotic Trials of Intervention Effectiveness</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14206">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005090"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001572"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14206"/>
        <obo:IAO_0000116>schizophrenia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42473435+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We applied TRRIP criteria to 1334 participants with chronic schizophrenia enrolled in the Clinical Antipsychotic Trials of Intervention Effectiveness (CATIE) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001572"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2888895/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To maximize representativeness, subjects were ascertained from clinical settings across the US (e.g., public mental health, academic, Veterans’ Affairs, and managed care centers).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001572"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42473435</owl:annotatedTarget>
        <dcterms:title>The prospective incidence of treatment-resistant schizophrenia: analysis of the CATIE trial using the TRRIP consensus.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42473435</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42473435+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We applied TRRIP criteria to 1334 participants with chronic schizophrenia enrolled in the Clinical Antipsychotic Trials of Intervention Effectiveness (CATIE) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001572"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multiphase randomised trial of the effectiveness of antipsychotic drugs in adults aged 18–67 with chronic schizophrenia, run under the US National Institute of Mental Health&apos;s CATIE programme in 2001–2004 at 57 clinical sites across the United States (public mental health, academic, Veterans Affairs and managed care settings), whose double-blind first phase compared the first-generation drug perphenazine with the second-generation drugs olanzapine, quetiapine, risperidone and ziprasidone for up to 18 months, with all-cause treatment discontinuation as the primary outcome. Participants could join an optional genetic sub-study by donating DNA.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:12908658</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:16172203</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18347602</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19721433</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001572"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1493</owl:annotatedTarget>
        <obo:IAO_0000116>patients with schizophrenia randomised in phase 1</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:16172203</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1493 patients with schizophrenia were recruited at 57 U.S. sites and randomly assigned to receive olanzapine (7.5 to 30 mg per day), perphenazine (8 to 32 mg per day), quetiapine (200 to 800 mg per day), or risperidone (1.5 to 6.0 mg per day) for up to 18 months.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001572"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CATIE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001572"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CATIE-US</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001573 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001573">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14214"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002595"/>
        <obo:IAO_0000112>PMID:30482948</obo:IAO_0000112>
        <obo:IAO_0000115>A retrospective case–control study of genetic and environmental contributions to heroin dependence, funded by the US National Institute on Drug Abuse in 2003 and run by Washington University, the Queensland Institute of Medical Research and the National Drug and Alcohol Research Centre (University of New South Wales), which from 2004 recruited opioid-dependent adults from opioid substitution (maintenance) treatment clinics in the greater Sydney area, Australia, and neighbourhood controls with little or no lifetime opioid use from socially disadvantaged areas served by the same clinics. Participants gave blood for DNA and completed a psychiatric diagnostic interview (SSAGA-OZ) with added assessments of childhood trauma, family history and borderline personality disorder.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1459</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">531</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>CATS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Comorbidity and Trauma Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14214">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005367"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001573"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14214"/>
        <obo:IAO_0000116>heroin dependence</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23245376+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The sample of the Comorbidity and Trauma Study, a genetic association study of heroin dependence, consists of Australian heroin dependent cases ascertained from opioid replacement therapy clinics and controls ascertained in nearby economically disadvantaged neighborhoods.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001573"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23245376+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The sample of the Comorbidity and Trauma Study, a genetic association study of heroin dependence, consists of Australian heroin dependent cases ascertained from opioid replacement therapy clinics and controls ascertained in nearby economically disadvantaged neighborhoods.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001573"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:30482948</owl:annotatedTarget>
        <dcterms:title>Transancestral GWAS of alcohol dependence reveals common genetic underpinnings with psychiatric disorders.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30482948</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6430207/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Funding support for the Comorbidity and Trauma Study (CATS) (dbGAP accession number: phs000277.v1.p1) was provided by the National Institute on Drug Abuse (R01 DA17305); GWAS genotyping services at the CIDR at The Johns Hopkins University were supported by the National Institutes of Health (contract N01-HG-65403).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001573"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A retrospective case–control study of genetic and environmental contributions to heroin dependence, funded by the US National Institute on Drug Abuse in 2003 and run by Washington University, the Queensland Institute of Medical Research and the National Drug and Alcohol Research Centre (University of New South Wales), which from 2004 recruited opioid-dependent adults from opioid substitution (maintenance) treatment clinics in the greater Sydney area, Australia, and neighbourhood controls with little or no lifetime opioid use from socially disadvantaged areas served by the same clinics. Participants gave blood for DNA and completed a psychiatric diagnostic interview (SSAGA-OZ) with added assessments of childhood trauma, family history and borderline personality disorder.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23245376</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26239289</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v1.p1</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001573"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1459</owl:annotatedTarget>
        <obo:IAO_0000116>heroin-dependent cases and neighbourhood controls in the candidate-gene study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:23303482</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1459 Australian cases ascertained from opioid replacement therapy clinics, 531 neighborhood controls ascertained from economically disadvantaged areas near opioid replacement therapy clinics, and 1495 unrelated Australian Twin Registry controls not dependent on alcohol or illicit drugs selected from a twin and family sample.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001573"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">531</owl:annotatedTarget>
        <obo:IAO_0000116>heroin-dependent cases and neighbourhood controls in the candidate-gene study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:23303482</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1459 Australian cases ascertained from opioid replacement therapy clinics, 531 neighborhood controls ascertained from economically disadvantaged areas near opioid replacement therapy clinics, and 1495 unrelated Australian Twin Registry controls not dependent on alcohol or illicit drugs selected from a twin and family sample.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001573"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CATS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001574 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001574">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14222"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Croatia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:30103784</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control study of colorectal cancer in Croatia, whose cases are patients with colorectal cancer recruited from November 2008 at the surgery departments of two tertiary hospitals in Zagreb that receive patients from across the country, and whose population controls without a history of cancer were drawn at random, by age and sex, from the &apos;10,001 Dalmatians&apos; study of the general population of Split and the islands of Vis and Korčula. Its participants were genotyped for known colorectal cancer risk variants and later genome-wide, for European colorectal cancer genome-wide association studies.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">764</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">460</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>CCCGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Croatia CRC case-control study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Croatia case-control CRC study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Croatian Colorectal Cancer Genetic Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14222">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005575"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001574"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14222"/>
        <obo:IAO_0000116>colorectal cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6090711/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Finally, a case–control CRC study from Croatia consisting of 764 cases and 460 population-based controls was also included in the analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001574"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Croatia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3774761/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the period from November 2008 to July 2009, a total of 338 colorectal cancer cases were recruited at departments of surgery in two hospitals in Zagreb, Croatia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001574"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:30103784</owl:annotatedTarget>
        <dcterms:title>Exploring causality in the association between circulating 25-hydroxyvitamin D and colorectal cancer risk: a large Mendelian randomisation study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30103784</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6090711/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Finally, a case–control CRC study from Croatia consisting of 764 cases and 460 population-based controls was also included in the analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001574"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case–control study of colorectal cancer in Croatia, whose cases are patients with colorectal cancer recruited from November 2008 at the surgery departments of two tertiary hospitals in Zagreb that receive patients from across the country, and whose population controls without a history of cancer were drawn at random, by age and sex, from the &apos;10,001 Dalmatians&apos; study of the general population of Split and the islands of Vis and Korčula. Its participants were genotyped for known colorectal cancer risk variants and later genome-wide, for European colorectal cancer genome-wide association studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24066093</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31089142</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001574"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
