        <oboInOwl:hasRelatedSynonym>Genetics of Lipid-Lowering Drugs and Diet Network study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
