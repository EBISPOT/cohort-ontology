        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">290</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SEVERE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Severe asthma study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Severe Asthma Cohorts</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20127">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002366"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20127"/>
        <obo:IAO_0000116>severe asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>SEVERE: Severe/refractory cases of asthma were recruited through three specialist severe asthma clinics; adult and childhood clinics based at the Royal Brompton Hospital, London and an adult clinic at the Glenfield Hospital, Leicester.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002366"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>adult and childhood clinics based at the Royal Brompton Hospital, London and an adult clinic at the Glenfield Hospital, Leicester</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002366"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000037</owl:annotatedTarget>
        <dcterms:title>Polygenic risk and the development and course of asthma: an analysis of data from a four-decade longitudinal study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24429243</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002366"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20860503</owl:annotatedTarget>
        <dcterms:title>A large-scale, consortium-based genomewide association study of asthma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20860503</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC4260321</oboInOwl:hasDbXref>
        <rdfs:comment>We did find a suggestive association with rs1837253 on chromosome 5, situated within the TSLP gene, among patients with severe asthma in the SEVERE study (P = 3×10−6; odds ratio, 0.56), but this association was not replicated among patients with severe asthma in the AUGOSA (Asthma UK Genetics of Severe Asthma) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002366"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of children and adults with severe or refractory asthma recruited through three specialist severe asthma clinics in England, the adult and paediatric clinics of the Royal Brompton Hospital, London, and the adult clinic of the Glenfield Hospital, Leicester, where they were characterised under the clinics&apos; severe asthma protocols, assembled as the severe asthma group of the GABRIEL consortium&apos;s genome-wide association study of asthma.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20860503</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002366"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">290</owl:annotatedTarget>
        <obo:IAO_0000116>severe asthma cases retained in the GABRIEL/TAGC GWAS after quality control (analysed subset)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>After QC a total of 290 subjects were retained in the GWAS analyses.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002366"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SEVERE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


