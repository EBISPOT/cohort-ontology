    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000657">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid5935"/>
        <obo:IAO_0000112>GCST90270100</obo:IAO_0000112>
        <obo:IAO_0000115>A research registry of community volunteers aged 18 to 65 living in the Greater Hamilton area, with or without addiction problems, run by the Peter Boris Centre for Addictions Research at St. Joseph&apos;s Healthcare Hamilton, whose participants completed questionnaires, simple physical measurements and an in-person assessment and gave saliva for DNA genotyping through 23andMe, to build a cohort for research on the causes, consequences and treatment of addiction.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2098</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PATH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PATH registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Population Assessment for Tomorrow&apos;s Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid5935">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0030858"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000657"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid5935"/>
        <obo:IAO_0000116>addiction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pbcar.healthsci.mcmaster.ca/research/projects/population-assessment-for-tomorrows-health-study-path/</oboInOwl:hasDbXref>
        <rdfs:comment>The PATH registry’s purpose is to gather information from volunteers, with or without addiction problems, to develop a cohort for future research studies, which will help further our understanding of the causes, consequences and treatment of individuals with addiction disorder.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000657"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90270100</owl:annotatedTarget>
        <dcterms:title>Leveraging related health phenotypes for polygenic prediction of impulsive choice, impulsive action, and impulsive personality traits in 1534 European ancestry community adults.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37060189</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10242187/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were from an existing research registry at St. Joseph&apos;s Healthcare Hamilton in which community adults were invited to participate in an in‐person assessment including DNA collection.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000657"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A research registry of community volunteers aged 18 to 65 living in the Greater Hamilton area, with or without addiction problems, run by the Peter Boris Centre for Addictions Research at St. Joseph&apos;s Healthcare Hamilton, whose participants completed questionnaires, simple physical measurements and an in-person assessment and gave saliva for DNA genotyping through 23andMe, to build a cohort for research on the causes, consequences and treatment of addiction.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35080193</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37060189</obo:IAO_0000119>
