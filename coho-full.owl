        <rdfs:comment>Participants were recruited from three French cities: Bordeaux (South-West), Dijon (North-East) and Montpellier (South-East).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000812"/>
