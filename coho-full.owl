    <!-- http://www.ebi.ac.uk/coho/COHO_0002743 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002743">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000160"/>
        <obo:IAO_0000112>PMID:36577740</obo:IAO_0000112>
        <obo:IAO_0000115>A study in which all living twins in the Swedish Twin Registry born in 1958 or earlier were invited, between March 1998 and December 2002, to a computer-assisted telephone interview on demographics and health conditions, and whose participants were then followed for changes in health status.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">44919</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SALT</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Screening Across the Lifespan Twin Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002743"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9925275/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Study participants were drawn from the Swedish Twin Registry (STR), a nationwide database of all twins born in Sweden since the late 1800s and the largest population-based twin registry in the world.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002743"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000160"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10711760/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SALT study, which is part of the Swedish Twin Registry, assessed 44,919 twin individuals aged between 41 and 97 years in 1998–2002</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002743"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:36577740</owl:annotatedTarget>
        <dcterms:title>Cardiometabolic multimorbidity and incident dementia: the Swedish twin registry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36577740</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9925275/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Between March 1998 and December 2002, all living twins in the registry aged &gt;40 years (i.e. born in 1958 or earlier) were invited to participate in a computer-assisted telephone interview on demographics and health conditions as part of the Screening Across the Lifespan Twin (SALT) study (response rate: 72.6%).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002743"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study in which all living twins in the Swedish Twin Registry born in 1958 or earlier were invited, between March 1998 and December 2002, to a computer-assisted telephone interview on demographics and health conditions, and whose participants were then followed for changes in health status.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36577740</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002743"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">44919</owl:annotatedTarget>
        <obo:IAO_0000116>twin individuals who took part in the baseline telephone interview, 1998-2002</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9925275/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 44 919 twin individuals participated in the SALT baseline assessment, 18 496 of whom were of older age (i.e. ≥ 60 years).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002743"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SALT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002744 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002744">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23313"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/New_Zealand"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>MTBLS5568</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional study at the Human Nutrition Unit of the University of Auckland, New Zealand, of Asian Chinese and European Caucasian adults aged 20 to 70 years across a wide range of body mass index, normoglycaemic or prediabetic, studying the greater susceptibility of Asian Chinese to visceral adiposity and type 2 diabetes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Characterising the Pre-diabetic Asian and Caucasian Phenotype: The &apos;TOFI&apos; Profile</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HVN PANaMAH TOFI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TOFI-Asia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TOFI_Asia study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">TOFI_Asia</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23313">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002744"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23313"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33040488+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The cross-sectional thin-on-the-outside-fat-on-the-inside (TOFI)_Asia study investigated adipose depots and clinical biomarkers as predictors of fasting plasma glucose (FPG) and insulin resistance (IR; assessed using the updated homeostatic model assessment of IR) in lean and overweight normo- and dysglycemic Chinese (n = 199) and Caucasian (n = 158) individuals.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002744"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/New_Zealand"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7667766/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The TOFI-Asia study is a cross-sectional study conducted at the Human Nutrition Unit (HNU), University of Auckland, New Zealand.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002744"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS5568</owl:annotatedTarget>
        <dcterms:title>The impact of ethnicity and intra-pancreatic fat on the postprandial metabolome response to whey protein in overweight Asian Chinese and European Caucasian women with prediabetes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36992769</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS5568</oboInOwl:hasDbXref>
        <rdfs:comment>The &apos;Thin on the Outside Fat on the Inside&apos; TOFI_Asia study found Asian Chinese to be more susceptible to Type 2 Diabetes (T2D) compared to European Caucasians matched for gender and body mass index (BMI).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002744"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional study at the Human Nutrition Unit of the University of Auckland, New Zealand, of Asian Chinese and European Caucasian adults aged 20 to 70 years across a wide range of body mass index, normoglycaemic or prediabetic, studying the greater susceptibility of Asian Chinese to visceral adiposity and type 2 diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33292338</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
