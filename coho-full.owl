        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">792</owl:annotatedTarget>
        <obo:IAO_0000116>subjects of the 2021 field study, as listed in the catalogue</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SPRINT</oboInOwl:hasDbXref>
