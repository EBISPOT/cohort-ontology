    <!-- http://www.ebi.ac.uk/coho/COHO_0000501 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000501">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid4399"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>GCST90275731</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective observational cohort of adults with proven or probable Lyme borreliosis in the Netherlands, included at the start of antibiotic treatment from 2015 and followed for one year with questionnaires and repeated blood sampling, run by RIVM with the Lyme borreliosis expert centres of Amsterdam UMC and Radboudumc to study the prevalence and determinants of persistent symptoms after treatment.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1138</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>LymeProspect cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LymeProspect study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">LymeProspect</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid4399">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019632"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000501"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4399"/>
        <obo:IAO_0000116>Lyme borreliosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11076587/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The LymeProspect cohort consisted of 1138 patients with a new physician-confirmed LB (either EM or disseminated manifestation) who were included at the initiation of antibiotic therapy and followed for one year, between April 2015 and October 201818,19.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000501"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6466793/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The LymeProspect study has been designed to investigate the prevalence, severity, and a wide range of hypotheses on the etiology of persistent symptoms among patients treated for Lyme borreliosis in the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000501"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90275731</owl:annotatedTarget>
        <dcterms:title>A comprehensive genetic map of cytokine responses in Lyme borreliosis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38714679</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11076587/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The LymeProspect cohort consisted of 1138 patients with a new physician-confirmed LB (either EM or disseminated manifestation) who were included at the initiation of antibiotic therapy and followed for one year</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000501"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective observational cohort of adults with proven or probable Lyme borreliosis in the Netherlands, included at the start of antibiotic treatment from 2015 and followed for one year with questionnaires and repeated blood sampling, run by RIVM with the Lyme borreliosis expert centres of Amsterdam UMC and Radboudumc to study the prevalence and determinants of persistent symptoms after treatment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30987580</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38714679</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000501"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1138</owl:annotatedTarget>
        <obo:IAO_0000116>adult patients with confirmed Lyme borreliosis included April 2015-October 2018</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11076587/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The LymeProspect cohort consisted of 1138 patients with a new physician-confirmed LB (either EM or disseminated manifestation) who were included at the initiation of antibiotic therapy and followed for one year, between April 2015 and October 2018</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000502 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000502">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Tanzania"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000471"/>
        <obo:IAO_0000112>GCST90308605</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional cohort of 323 healthy adults aged 18-65 living in the Kilimanjaro region of northern Tanzania, enrolled within the Human Functional Genomics Project by Radboudumc and Tanzanian partners, with ex vivo cytokine stimulations at the Kilimanjaro Clinical Research Institute in Moshi, to study genetic and environmental determinants of immune responses in an African population.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">323</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>300 Tanzania functional genomics (FG) study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>300TZFG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">300-Tanzania-FG</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000502"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Tanzania"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10473835/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the 300TZFG cohort consists of 323 healthy Tanzanian individuals aged between 18 and 65 years residing in the Kilimanjaro region in Northern Tanzania.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000502"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90308605</owl:annotatedTarget>
        <dcterms:title>A functional genomics approach in Tanzanian population identifies distinct genetic regulators of cytokine production compared to European population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35167808</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/articles/PMC8948159?pdf=render</oboInOwl:hasDbXref>
        <rdfs:comment>Data from the 300 Tanzania functional genomics (FG) (300TZFG) were used in this study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000502"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional cohort of 323 healthy adults aged 18-65 living in the Kilimanjaro region of northern Tanzania, enrolled within the Human Functional Genomics Project by Radboudumc and Tanzanian partners, with ex vivo cytokine stimulations at the Kilimanjaro Clinical Research Institute in Moshi, to study genetic and environmental determinants of immune responses in an African population.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37555575</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41858114</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000502"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">323</owl:annotatedTarget>
        <obo:IAO_0000116>healthy adults aged 18-65 in the Tanzanian cohort (2017)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13071459/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Tanzanian cohort comprised 323 healthy individuals (159 males, 164 females) aged 18–65 years, residing in the Kilimanjaro region of Northern Tanzania.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000502"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>300TZFG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000503 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000503">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90128454</obo:IAO_0000112>
        <obo:IAO_0000115>An ancestrally diverse biobank embedded in the UCLA Health medical system in Los Angeles County, run by the UCLA Institute for Precision Health, that links genomic data from blood samples of consenting UCLA Health patients (36,736 genotyped in 2022) to their de-identified electronic health records, for genetic and precision-health research.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">104516</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ATLAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ATLAS Community Health Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UCLA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of California, Los Angeles ATLAS Community Health Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">UCLA ATLAS Community Health Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000503"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9461263/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The UCLA Health system serves Los Angeles County, leading to a study population of great demographic, genetic, and phenotypic diversity.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000503"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90128454</owl:annotatedTarget>
        <dcterms:title>Leveraging genomic diversity for discovery in an electronic health record linked biobank: the UCLA ATLAS Community Health Initiative.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36085083</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36085083+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we explore the implications of genetic ancestry within the University of California, Los Angeles (UCLA) ATLAS Community Health Initiative-an ancestrally diverse biobank of genomic data linked with de-identified electronic health records (EHRs) of UCLA Health patients (N=36,736).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000503"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ancestrally diverse biobank embedded in the UCLA Health medical system in Los Angeles County, run by the UCLA Institute for Precision Health, that links genomic data from blood samples of consenting UCLA Health patients (36,736 genotyped in 2022) to their de-identified electronic health records, for genetic and precision-health research.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36085083</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9461263/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000503"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">104516</owl:annotatedTarget>
        <obo:IAO_0000116>UCLA Health patients who consented to ATLAS (enrolled group), as of December 2024</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13087405/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>From these, 104,516 individuals consented to participate in the ATLAS Initiative and comprised the enrolled group, with the remainder of the individuals labeled as unenrolled.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000503"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ATLAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
