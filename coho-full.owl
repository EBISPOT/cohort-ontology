    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001884"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A major depressive disorder case-control sample of the Psychiatric Genomics Consortium from the Partners HealthCare System in the United States, assembled with the i2b2 (Informatics for Integrating Biology and the Bedside) centre, whose cases were identified by natural language processing of electronic medical records with psychiatrist review (an ICD-9 diagnosis of major depressive disorder, confirmed on record review, with depression either responsive to an SSRI or unresponsive to at least two antidepressant trials) and whose controls came from neuroimaging studies, screened by self-reported psychiatric history.</owl:annotatedTarget>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/PMC3837431/</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0090-3/MediaObjects/41588_2018_90_MOESM3_ESM.xlsx</obo:IAO_0000119>
