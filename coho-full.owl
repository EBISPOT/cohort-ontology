    <!-- http://www.ebi.ac.uk/coho/COHO_0002603 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002603">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21911"/>
        <rdf:type rdf:nodeID="genid21913"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>MTBLS1684</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:41196593</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, population-based birth cohort of mother–newborn pairs recruited at delivery since February 2010 at East-Limburg Hospital (Ziekenhuis Oost-Limburg) in Genk, in the province of Limburg, Belgium, with umbilical cord blood collected at birth and follow-up of the children at 4 to 6 years of age at Hasselt University, to study how environmental exposures in early life influence the biology of human ageing.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2400</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ENVIRONAGE</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>ENVIRONAGE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Environmental Influence on Ageing in Early Life</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Environmental Influence on Early Aging</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Limburgs Geboortecohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">ENVIRonmental influence ON early AGEing</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://limburgsgeboortecohort.be/"/>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21911">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_8000036"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid21913">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ExO_0000002"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002603"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21911"/>
        <obo:IAO_0000116>air pollution</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ENVIRONAGE</oboInOwl:hasDbXref>
        <rdfs:comment>Within the ongoing population-based prospective birth cohort study ENVIRONAGE we explore new dimensions in the current understanding of human ageing and its interaction with the environment</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002603"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21913"/>
        <obo:IAO_0000116>early-life environmental exposures</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ENVIRONAGE</oboInOwl:hasDbXref>
        <rdfs:comment>Within the ongoing population-based prospective birth cohort study ENVIRONAGE we explore new dimensions in the current understanding of human ageing and its interaction with the environment</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002603"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12593129/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study includes children from a population-based cohort in Belgium recruited between January 1, 2010, and December 31, 2016, with available cord blood appetite hormone levels and participating in follow-up visits.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002603"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS1684</owl:annotatedTarget>
        <dcterms:title>A multi-omic analysis of birthweight in newborn cord blood reveals new underlying mechanisms related to cholesterol metabolism.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32553738</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS1684</oboInOwl:hasDbXref>
        <rdfs:comment>Since the results of the omics integration indicated the central role of cholesterol metabolism, we explored the association of cholesterol levels in cord blood with birthweight in the ENVIRONAGE cohort (n=1,097), finding that higher birthweight was associated with increased high-density lipoprotein cholesterol and that high-density lipoprotein cholesterol was lower in small versus large for gestational age newborns.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002603"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:41196593</owl:annotatedTarget>
        <dcterms:title>Cord Blood Appetite Hormones and Early-Life Growth and Childhood Adiposity in the ENVIRONAGE Cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41196593</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12593129/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This prospective birth cohort study was conducted within the Environmental Influence on Early Aging (ENVIRONAGE) birth cohort, with follow-up data collected at 4 to 6 years of age.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002603"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, population-based birth cohort of mother–newborn pairs recruited at delivery since February 2010 at East-Limburg Hospital (Ziekenhuis Oost-Limburg) in Genk, in the province of Limburg, Belgium, with umbilical cord blood collected at birth and follow-up of the children at 4 to 6 years of age at Hasselt University, to study how environmental exposures in early life influence the biology of human ageing.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:41106326</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41196593</obo:IAO_0000119>
        <obo:IAO_0000119>https://limburgsgeboortecohort.be/</obo:IAO_0000119>
        <obo:IAO_0000119>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ENVIRONAGE</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002603"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2400</owl:annotatedTarget>
        <obo:IAO_0000116>participants (mother-newborn pairs) enrolled since February 2010, stated as more than 2400</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://limburgsgeboortecohort.be/</oboInOwl:hasDbXref>
        <rdfs:comment>De studie werd opgestart in februari 2010 in samenwerking met Ziekenhuis Oost-Limburg en kent momenteel al meer dan 2400 deelnemers!</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002603"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ENVIRONAGE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


