        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000127.v2.p1</oboInOwl:hasDbXref>
        <rdfs:comment>Genotyping data are available on 221 SALS patients and 211 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
