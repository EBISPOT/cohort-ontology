        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetic and phenotypic determinants of blood pressure and other cardiovascular risk factors</rdfs:label>
    </owl:NamedIndividual>
