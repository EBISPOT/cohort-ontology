        <obo:IAO_0000112>PGS000076</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:28598434</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of renal cell carcinoma run from the University of Texas MD Anderson Cancer Center in Houston since 2002, whose cases are Texas residents with newly diagnosed, histologically confirmed renal cell carcinoma identified from the appointment schedules of MD Anderson&apos;s urology and genitourinary oncology departments, and whose controls are cancer-free Texas residents found by random-digit dialling and frequency-matched to cases by age, sex, ethnicity and county of residence, with an in-person interview and a blood sample from each participant.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MDA also denotes Prostate Cancer Case-Control Studies at MD Anderson (COHO:0002044) and MD Anderson Ovarian Cancer Study (COHO:0002047); this term is MD Anderson Renal Cell Cancer Study.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The acronym MDACCS also denotes MD Anderson Cancer Center lung cancer study (COHO:0000874), MD Anderson Cancer Center melanoma study (COHO:0000875), Prostate Cancer Case-Control Studies at MD Anderson (COHO:0002044) and MD Anderson Ovarian Cancer Study (COHO:0002047); this term is MD Anderson Renal Cell Cancer Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">910</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">566</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>MD Anderson RCC Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MDA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MDACCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MDARCCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">MD Anderson Renal Cell Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17854">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005086"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002048"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17854"/>
        <obo:IAO_0000116>renal cell carcinoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3276284/</oboInOwl:hasDbXref>
        <rdfs:comment>The primary scan for the discovery population of RCC case–control study (910 cases and 566 controls) was performed at MD Anderson Cancer Center using the Illumina HumanHap660W Beadchips.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002048"/>
