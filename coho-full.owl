        <obo:IAO_0000115>A cohort of patients with resected pancreatic ductal adenocarcinoma whose tumour tissues and clinical information were collected at the University of Maryland Medical System, Baltimore, United States, through a National Cancer Institute resource contract, and at the University Medical Center Göttingen, Germany.</obo:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
