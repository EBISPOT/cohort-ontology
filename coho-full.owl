        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90267548</obo:IAO_0000112>
        <obo:IAO_0000115>An international collaboration, sponsored by the Klarman Family Foundation and the US National Institute of Mental Health, that recruited individuals with a lifetime history of anorexia nervosa and controls in the United States, Australia, New Zealand, Sweden and Denmark, through treatment centres, national registers and traditional and social media, with blood samples and an online eating-disorder questionnaire, to rapidly expand the samples available for genome-wide association studies of anorexia nervosa.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13364</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ANGI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Anorexia Nervosa Genetics Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9063">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005351"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000993"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9063"/>
        <obo:IAO_0000116>anorexia nervosa</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30287268+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We describe methods and procedures for the Anorexia Nervosa Genetics Initiative (ANGI), an international collaboration designed to rapidly recruit 13,000 individuals with AN and ancestrally matched controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000993"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30287268+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>ANGI recruited from the United States (US), Australia/New Zealand (ANZ), Sweden (SE), and Denmark (DK).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000993"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90267548</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of school grades identifies genetic overlap between language ability, psychopathology and creativity.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36624241</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9829693/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>ANGI is an international collaboration established between scientists in the United States, Australia/New Zealand, Sweden and Denmark to establish a cohort of individuals with and without AN.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000993"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international collaboration, sponsored by the Klarman Family Foundation and the US National Institute of Mental Health, that recruited individuals with a lifetime history of anorexia nervosa and controls in the United States, Australia, New Zealand, Sweden and Denmark, through treatment centres, national registers and traditional and social media, with blood samples and an online eating-disorder questionnaire, to rapidly expand the samples available for genome-wide association studies of anorexia nervosa.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30287268</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000993"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13364</owl:annotatedTarget>
        <obo:IAO_0000116>individuals with lifetime AN and controls with blood samples and clinical information</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6338222/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Blood samples and clinical information were collected from 13,364 individuals with lifetime AN and from controls.</rdfs:comment>
