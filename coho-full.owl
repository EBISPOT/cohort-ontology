        <rdfs:comment>Canada Canadian screening study UHN, BCCA Lam/Tsao/Liu Canada screening cohort 2004-2011, 2008-2013 267 463 730</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001563"/>
