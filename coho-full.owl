    <!-- http://www.ebi.ac.uk/coho/COHO_0002379 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002379">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20224"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>PGS000770</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:22344219</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control genome-wide association study of hypertension among Han Chinese adults aged 37–84 living in the Shanghai metropolitan area, approved by the ethics committee of Ruijin Hospital. Its cases had hypertension diagnosed after age 30 and at least two family members with hypertension, and its controls were normotensive adults over 40; both groups had a BMI under 27 kg/m2 and cases had no diabetes.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">446</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">455</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">901</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SIH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Shanghai Institute of Hypertension GWAS</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20224">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005044"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002379"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20224"/>
        <obo:IAO_0000116>hypertension</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1087/MediaObjects/41588_2012_BFng1087_MOESM24_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Shanghai Institute of Hypertension (SIH) GWAS This is a case-control GWAS investigating the genetic variants associated with hypertension.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002379"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1087/MediaObjects/41588_2012_BFng1087_MOESM24_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The study included a total of 446 hypertension cases (224 men/222 women) and 455 controls (230 men, 225 women) aged 37-84 years, which were Chinese Han origin residing in the Shanghai metropolitan area and gave written informed consent to donating blood samples for genetic analysis and related assays.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002379"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000770</owl:annotatedTarget>
        <dcterms:title>The Challenge of Stratifying Obesity: Attempts in the Quebec Family Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31649740</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002379"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22344219</owl:annotatedTarget>
        <dcterms:title>Meta-analysis identifies common variants associated with body mass index in east Asians.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22344219</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3288728/</oboInOwl:hasDbXref>
        <rdfs:comment>The SIH was supported by the Chinese National Key Program for Basic Research (Grant 973:2004CB518603) and Chinese National High Tech Program (Grant 863:2009AA022703).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002379"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control genome-wide association study of hypertension among Han Chinese adults aged 37–84 living in the Shanghai metropolitan area, approved by the ethics committee of Ruijin Hospital. Its cases had hypertension diagnosed after age 30 and at least two family members with hypertension, and its controls were normotensive adults over 40; both groups had a BMI under 27 kg/m2 and cases had no diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1087/MediaObjects/41588_2012_BFng1087_MOESM24_ESM.pdf</obo:IAO_0000119>
