        <oboInOwl:hasRelatedSynonym>The Stabilization of pLaques usIng Darapladib-Thrombolysis in Myocardial Infarction</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Stabilization of pLaques usIng Darapladib-Thrombolysis in Myocardial Infarction</rdfs:label>
