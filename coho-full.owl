    <!-- http://www.ebi.ac.uk/coho/COHO_0000762 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000762">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid6884"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South-Eastern_Asia"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002430"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000763"/>
        <obo:IAO_0000112>GCST90244057</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of Chinese adults in Singapore examined at baseline in 2009–2011 (SCES-1) and invited for a 6-year follow-up in 2015–2017 (SCES-2) with standardised ocular and systemic examinations and questionnaires, to study the prevalence, incidence, progression and risk factors of age-related eye diseases.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3353</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SCES</oboInOwl:hasRelatedSynonym>
