    <!-- http://www.ebi.ac.uk/coho/COHO_0001446 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001446">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>GCST90000048</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of cohort studies that carries out genome-wide association meta-analyses of human reproductive behaviour, such as age at first sex, age at first birth, number of children ever born and childlessness, in people of European ancestry; after a first study of age at first birth and number of children ever born, it meta-analysed cohorts for age at first sex and age at first birth.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">542901</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HRBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Human Reproductive Behaviour Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001446"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90000048</owl:annotatedTarget>
        <dcterms:title>Identification of 371 genetic variants for age at first sex and birth linked to externalising behaviour.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34211149</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7612120/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Authors in the Human Reproductive Behaviour Consortium contributed the valuable data, conducted cohort specific GWAS and other analyses, and contributed through the administration, management, and data collection for the participating cohorts.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001446"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium of cohort studies that carries out genome-wide association meta-analyses of human reproductive behaviour, such as age at first sex, age at first birth, number of children ever born and childlessness, in people of European ancestry; after a first study of age at first birth and number of children ever born, it meta-analysed cohorts for age at first sex and age at first birth.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34211149</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001446"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">542901</owl:annotatedTarget>
        <obo:IAO_0000116>individuals in the 2021 age-at-first-birth meta-GWAS of 36 studies</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7612120/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For Age at First Birth (AFB), we included 542,901 individuals (n=124,088 males; n=418,758 females) from 36 studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001446"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HRBC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001447 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001447">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13104"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <obo:IAO_0000112>GCST90992867</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of adult volunteers living across Italy, selected by the Italian National Research Council (CNR) from respondents to its EPICOVID-19 web survey who had agreed to be recontacted, who completed an online health and lifestyle questionnaire and gave blood at collection centres in several Italian regions, with repeat sampling about 5 and 10 months later, between May 2021 and February 2022. It was set up to study the serological and genetic factors in the immune response to SARS-CoV-2 infection and COVID-19 vaccination and in susceptibility to infection, and to build a serum and DNA biobank.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7169</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SerGen-Covid-19</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SerGenCovid19</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Serum Genetic Covid-19 study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">SerGenCovid-19</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13104">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0100096"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001447"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13104"/>
        <obo:IAO_0000116>COVID-19</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12875989/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The samples used in this study are part of the SerGenCovid-19 project (https://sergencovid19.d4science.org), an initiative of the Italian National Research Council (Consiglio Nazionale delle Ricerche, CNR) aimed at identifying the genetic and serological factors involved in response to vaccination against COVID-19 and susceptibility to SARS-CoV-2 infection.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001447"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12875989/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SerGenCovid-19 project successfully collected data from 7,169 participants across Italy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001447"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90992867</owl:annotatedTarget>
        <dcterms:title>&lt;i&gt;CMTM8&lt;/i&gt; variants influence BNT162b2 COVID-19 vaccination response by regulating granulocytic/polymorphonuclear myeloid-derived suppressor cell activity.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41659846</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12875989/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we conducted a Genome Wide Association Study (GWAS) on anti-S IgG levels following Pfizer-BioNTech COVID-19 vaccination in 1,968 participants from the SerGenCovid-19 initiative, a cohort study comprising 7,169 genetically characterized individuals from the general Italian population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001447"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of adult volunteers living across Italy, selected by the Italian National Research Council (CNR) from respondents to its EPICOVID-19 web survey who had agreed to be recontacted, who completed an online health and lifestyle questionnaire and gave blood at collection centres in several Italian regions, with repeat sampling about 5 and 10 months later, between May 2021 and February 2022. It was set up to study the serological and genetic factors in the immune response to SARS-CoV-2 infection and COVID-19 vaccination and in susceptibility to infection, and to build a serum and DNA biobank.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:41659846</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.cnr.it/it/comunicato-stampa/10010/parte-il-progetto-sergen-covid-19</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.irib.cnr.it/progetti/virus-memory/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001447"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7169</owl:annotatedTarget>
        <obo:IAO_0000116>participants from whom data were collected, May 2021 to February 2022</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12875989/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SerGenCovid-19 project successfully collected data from 7,169 participants across Italy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001447"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SerGen-Covid-19</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001447"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SerGenCovid19</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001448 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001448">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13112"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <obo:IAO_0000112>GCST90026609</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised, three-arm phase III trial led by the Cancer and Leukemia Group B, with the North Central Cancer Treatment Group (as N063H), the Eastern Cooperative Oncology Group and the Southwest Oncology Group taking part, that enrolled patients aged 18 or over with locally recurrent (stage IIIC) or metastatic (stage IV) breast cancer and no prior chemotherapy for metastatic disease at institutions in the United States from 2008 to 2011, comparing first-line paclitaxel once per week with nab-paclitaxel or ixabepilone once per week, each given with bevacizumab (optional from March 2011), with progression-free survival as the primary end point.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">799</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Cancer and Leukemia Group B 40502</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCCTG N063H</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">CALGB 40502</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13112">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001448"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13112"/>
        <obo:IAO_0000116>metastatic breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33981951+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Cancer and Leukemia Group B 40502 was a randomized trial of first-line taxane-based chemotherapy for patients with metastatic breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001448"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4500830/</oboInOwl:hasDbXref>
        <rdfs:comment>The following list provides institution names, clinicians who participated in this study, and their supporting grant numbers in parentheses: Bay Area Tumor Institute Community Clinical Oncology Program (CCOP), Oakland, CA</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001448"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90026609</owl:annotatedTarget>
        <dcterms:title>Bevacizumab-induced hypertension and proteinuria: a genome-wide study of more than 1000 patients.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34616010</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34616010+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A genome-wide association study (GWAS) meta-analysis was performed in 1039 bevacizumab-treated patients of European ancestry in four clinical trials (CALGB 40502, 40503, 80303, 90401).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001448"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised, three-arm phase III trial led by the Cancer and Leukemia Group B, with the North Central Cancer Treatment Group (as N063H), the Eastern Cooperative Oncology Group and the Southwest Oncology Group taking part, that enrolled patients aged 18 or over with locally recurrent (stage IIIC) or metastatic (stage IV) breast cancer and no prior chemotherapy for metastatic disease at institutions in the United States from 2008 to 2011, comparing first-line paclitaxel once per week with nab-paclitaxel or ixabepilone once per week, each given with bevacizumab (optional from March 2011), with progression-free survival as the primary end point.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26056183</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33981951</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT00785291</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001448"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">799</owl:annotatedTarget>
        <obo:IAO_0000116>patients enrolled and randomly assigned, 2008-2011</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC4500830</oboInOwl:hasDbXref>
        <rdfs:comment>In all, 799 patients were enrolled and randomly assigned; 16 did notstarttreatment:eightwererandomlyassignedtopaclitaxel,fourto nab-paclitaxel, and four to ixabepilone (CONSORT diagram; Fig 1).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001449 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001449">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13118"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>GCST90026612</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal population study by investigators of Ghent University, Belgium, of men and women aged about 35 to 55 and free from overt cardiovascular disease, randomly sampled from the population lists of the twinned communities of Erpe-Mere and Nieuwerkerken (partners and relatives living there were also eligible), examined at a single local study site in 2002–2004 and again in 2011–2016, to study the interplay between ageing, cardiovascular haemodynamics and inflammation in preclinical cardiovascular disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2524</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ASKLEPIOS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ASKLEPIOS study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Asklepios study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Asklepios Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13118">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001449"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13118"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17446795+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Asklepios Study is a longitudinal population study focusing on the interplay between ageing, cardiovascular haemodynamics and inflammation in (preclinical) cardiovascular disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001449"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17446795+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The 2524 participants (1301 women) are a representative cohort of 35-55-year-old individuals, free from overt cardiovascular disease at study initiation, randomly sampled from the twinned Belgian communities of Erpe-Mere and Nieuwerkerken.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001449"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90026612</owl:annotatedTarget>
        <dcterms:title>Genetic investigation of fibromuscular dysplasia identifies risk loci and shared genetics with common cardiovascular diseases.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34654805</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8521585/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Depending on case control studies, controls were either ascertained from country matched population-based cohorts (3C Study, WOBASZ II and ASKLEPIOS), recruited specifically for the purpose of the study (DEFINE Study) or extracted from local clinical registries linked to electronic health record data (MGI, Mayo Clinic).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001449"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal population study by investigators of Ghent University, Belgium, of men and women aged about 35 to 55 and free from overt cardiovascular disease, randomly sampled from the population lists of the twinned communities of Erpe-Mere and Nieuwerkerken (partners and relatives living there were also eligible), examined at a single local study site in 2002–2004 and again in 2011–2016, to study the interplay between ageing, cardiovascular haemodynamics and inflammation in preclinical cardiovascular disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17446795</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29695838</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31357728</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001449"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2524</owl:annotatedTarget>
        <obo:IAO_0000116>subjects examined at baseline (round 1, 2002-2004)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6723474/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Asklepios study comprises 2524 subjects (1301 women) approximately 35 to 55 years of age at the baseline examination in 2002–2004 (round 1), with a complete re-examination of 91% of subjects after a median of 10.1 (9.8–10.8) years of follow-up (round 2: in 2011–2016).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001449"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ASKLEPIOS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001450 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001450">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Croatia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90429011</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of population-based cohorts in Europe and Australia with genome-wide genotypes and morning plasma cortisol measured in blood sampled at a controlled time of day, funded by the Chief Scientist Office of the Scottish Government and the British Heart Foundation, that combines their participants of European ancestry in genome-wide association meta-analyses of morning plasma cortisol, formed to identify genetic determinants of inter-individual variation in hypothalamic-pituitary-adrenal axis function.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25314</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CORNET</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CORNET consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CORtisol NETwork</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CORtisol NETwork Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cortisol Network</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">CORtisol NETwork consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4091794/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Western Australia Pregnancy Cohort (Raine) recruited 2,900 pregnancies from King Edward Memorial Hospital between 1989 and 1991 as part of a randomised controlled trial which evaluated repeated ultrasounds in pregnancy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Croatia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8144017/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The CROATIA-Split study, Croatia, is a population-based, cross-sectional study in the Dalmatian City of Split that so far includes 1000 examinees aged 18-95.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8144017/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Helsinki Birth Cohort Study (HBCS) is composed of 8,760 individuals born between the years 1934-44 in one of the two main maternity hospitals in Helsinki, Finland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8144017/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Study of Health in Pomerania (SHIP) is a population-based project conducted in Northeast Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4091794/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The InCHIANTI study is a population-based epidemiological study aimed at evaluating factors that influence mobility in the older population living in the Chianti region of Tuscany, Italy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8144017/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Rotterdam Study (RS) is an ongoing population-based cohort study of risk factors for chronic diseases in the elderly which includes approximately 8,000 participants who live in Rotterdam.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8144017/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The MrOS Sweden cohort consist of three sub-cohorts from three different Swedish cities (n=1,005 in Malmo, n=1,010 in Göteborg, and n=999 in Uppsala).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8144017/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>ALSPAC recruited pregnant women resident in Avon, UK with expected dates of delivery 1st April 1991 to 31st December 1992.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90429011</owl:annotatedTarget>
        <dcterms:title>Assessing the Role of Cortisol in Anxiety, Major Depression, and Neuroticism: A Mendelian Randomization Study Using &lt;i&gt;SERPINA6&lt;/i&gt;/&lt;i&gt;SERPINA1&lt;/i&gt; Variants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38525495</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10959652/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The CORNET consortium, with a pooled mean age (SD) of 53.3 (11.2) years and 36.3% men, was a GWAS meta-analysis of 25,314 participants of European ancestry from 17 European population-based cohorts adjusted for age, sex, and genetic principal components (PCs) for population structure.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium of population-based cohorts in Europe and Australia with genome-wide genotypes and morning plasma cortisol measured in blood sampled at a controlled time of day, funded by the Chief Scientist Office of the Scottish Government and the British Heart Foundation, that combines their participants of European ancestry in genome-wide association meta-analyses of morning plasma cortisol, formed to identify genetic determinants of inter-individual variation in hypothalamic-pituitary-adrenal axis function.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25010111</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33469137</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">25314</owl:annotatedTarget>
        <obo:IAO_0000116>subjects in the extended 2021 GWAS meta-analysis of morning plasma cortisol (17 cohorts)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:33469137</oboInOwl:hasDbXref>
        <rdfs:comment>The CORNET consortium extended its genome-wide association meta-analysis for morning plasma cortisol from 12,597 to 25,314 subjects and from ~2.2 M to ~7 M SNPs, in 17 population-based cohorts of European ancestries.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CORNET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001451 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001451">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000954"/>
        <obo:IAO_0000112>PMID:41550966</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, multi-ethnic birth cohort run from Amsterdam UMC that recruited pregnant women living in Amsterdam, the Netherlands, at their first prenatal visit between January 2003 and March 2004, and follows their children from pregnancy into young adulthood to identify factors in pregnancy and early childhood that explain later health and health inequalities, with particular attention to differences between ethnic groups.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym ABCD also denotes Adolescent Brain Cognitive Development Study (COHO:0000545); this term is Amsterdam Born Children and their Development.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8266</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ABCD</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>ABCD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AmBCD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Amsterdam-Born Children and their Development</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Amsterdam Born Children and their Development Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Amsterdam Born Children and their Development</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://www.abcd-studie.nl/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001451"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7805191/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Data were obtained from the Amsterdam Born Children and their Development (ABCD) study, a large prospective birth cohort in Amsterdam, the Netherlands</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001451"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:41550966</owl:annotatedTarget>
        <dcterms:title>Maternal thyroid function in the first half of pregnancy and neurodevelopmental outcomes in early adolescence in the Amsterdam Born Children and their Development (ABCD) cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41550966</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41550966+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Maternal thyroid function in the first half of pregnancy and neurodevelopmental outcomes in early adolescence in the Amsterdam Born Children and their Development (ABCD) cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001451"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, multi-ethnic birth cohort run from Amsterdam UMC that recruited pregnant women living in Amsterdam, the Netherlands, at their first prenatal visit between January 2003 and March 2004, and follows their children from pregnancy into young adulthood to identify factors in pregnancy and early childhood that explain later health and health inequalities, with particular attention to differences between ethnic groups.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:41550966</obo:IAO_0000119>
        <obo:IAO_0000119>https://abcd.amsterdamumc.nl/en/background-information-abcd-study/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001451"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8266</owl:annotatedTarget>
        <obo:IAO_0000116>pregnant women recruited at the first prenatal visit (of 12,393 eligible), 2003-2004</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:41550966</oboInOwl:hasDbXref>
        <rdfs:comment>Pregnant women living in Amsterdam between January 2003 and March 2004 were eligible to participate in the Amsterdam Born Children and their Development cohort study (n = 12,393) and were recruited at the first prenatal visit (n = 8266) [44].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001451"/>
