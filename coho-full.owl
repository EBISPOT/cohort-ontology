        <obo:IAO_0000112>PGS000344</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:21844186</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium of case-control, cohort, case-only and tumour-collection studies of breast cancer in the United States, Australia and Europe that pools women with triple-negative (estrogen receptor-, progesterone receptor- and HER2-negative) breast cancer and controls to study inherited susceptibility to triple-negative breast cancer, and that contributes its case series to the Breast Cancer Association Consortium.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2980</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4978</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7958</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TNBCC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Triple Negative Breast Cancer Consortium Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Triple-negative Breast Cancer Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Triple Negative Breast Cancer Consortium</rdfs:label>
    </owl:NamedIndividual>
