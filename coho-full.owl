        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9671605/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Plasmas of healthy donors with and without inflammation signatures were selected from participants in the Avon Longitudinal Study of Parents and Children (ALSPAC)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
