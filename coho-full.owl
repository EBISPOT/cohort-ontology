        <oboInOwl:hasDbXref>PMID:38153744</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001869"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38153744</owl:annotatedTarget>
        <dcterms:title>The Potential of Genetics in Identifying Women at Lower Risk of Breast Cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38153744</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870185/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this case-control study, we performed a retrospective analysis of 25 591 women from the all-comers Healthy Nevada Project,8,11 who had available electronic health records from Renown Health (mean length of electronic health records, 15 years; eTable 1 in Supplement 2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001869"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population health study of adult volunteers in Nevada, established in 2016 by Renown Health and the Desert Research Institute in Reno with targeted recruitment in rural and socioeconomically deprived areas of northern Nevada, that links participants&apos; genetic data (genotyping from 2016, Helix Exome+ sequencing from 2018) with their Renown Health electronic health records.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33763119</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
