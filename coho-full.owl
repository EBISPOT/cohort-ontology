        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11875162/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Cameron County Hispanic Cohort (CCHC) is a community-based cohort study initiated in 2004 of Mexican Americans in Brownsville, Texas.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000517"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based cohort of Mexican Americans in Brownsville, Cameron County, Texas, on the United States-Mexico border, established in 2004 by the University of Texas School of Public Health Brownsville campus from households in randomly selected census tract blocks, to study the prevalence and determinants of obesity, diabetes and related chronic disease in this population.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20394692</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11875162/fullTextXML</obo:IAO_0000119>
