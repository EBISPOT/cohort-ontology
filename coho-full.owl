    <!-- http://www.ebi.ac.uk/coho/COHO_0001739 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001739">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15539"/>
        <obo:IAO_0000112>PGS003355</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:31707849</obo:IAO_0000112>
        <obo:IAO_0000115>A multinational, randomised, double-blind, placebo-controlled trial (TIMI 59) of whether adding the PCSK9 inhibitor evolocumab to statin therapy reduces major cardiovascular events in patients aged 40 to 85 with clinically evident atherosclerotic cardiovascular disease (a history of myocardial infarction, non-haemorrhagic stroke or symptomatic peripheral artery disease) and raised LDL or non-HDL cholesterol.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27564</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>FOURIER</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FOURIER trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Further Cardiovascular Outcomes Research With PCSK9 Inhibition in Subjects With Elevated Risk</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TIMI 59</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Further Cardiovascular Outcomes Research with PCSK9 Inhibition in Subjects with Elevated Risk</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15539">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_1060134"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001739"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15539"/>
        <obo:IAO_0000116>atherosclerotic cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28304224+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a randomized, double-blind, placebo-controlled trial involving 27,564 patients with atherosclerotic cardiovascular disease and LDL cholesterol levels of 70 mg per deciliter (1.8 mmol per liter) or higher who were receiving statin therapy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001739"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS003355</owl:annotatedTarget>
        <dcterms:title>Discovery and systematic characterization of risk variants and genes for coronary artery disease in over a million participants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36474045</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001739"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:31707849</owl:annotatedTarget>
        <dcterms:title>Predicting Benefit From Evolocumab Therapy in Patients With Atherosclerotic Disease Using a Genetic Risk Score: Results From the FOURIER Trial.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31707849</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8058781/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The FOURIER trial was a multinational, randomized, double-blind, placebo-controlled trial of the efficacy of evolocumab in patients with clinically evident atherosclerotic cardiovascular disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001739"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multinational, randomised, double-blind, placebo-controlled trial (TIMI 59) of whether adding the PCSK9 inhibitor evolocumab to statin therapy reduces major cardiovascular events in patients aged 40 to 85 with clinically evident atherosclerotic cardiovascular disease (a history of myocardial infarction, non-haemorrhagic stroke or symptomatic peripheral artery disease) and raised LDL or non-HDL cholesterol.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31707849</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40011692</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001739"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27564</owl:annotatedTarget>
        <obo:IAO_0000116>FOURIER patients randomized in the main trial</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28304224+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a randomized, double-blind, placebo-controlled trial involving 27,564 patients with atherosclerotic cardiovascular disease and LDL cholesterol levels of 70 mg per deciliter (1.8 mmol per liter) or higher who were receiving statin therapy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001739"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FOURIER</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


