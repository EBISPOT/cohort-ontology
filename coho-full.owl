    <!-- http://www.ebi.ac.uk/coho/COHO_0001678 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001678">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid15040"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002129"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002394"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002588"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Czech_Republic"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:24920014</obo:IAO_0000112>
        <obo:IAO_0000115>A European genome-wide association study of classical Hodgkin lymphoma that genotyped, at the Centre National de Génotypage in France, cases from five European Hodgkin lymphoma studies (the EPILYMPH Study, the Scotland and Newcastle Lymphoma Group, the Young Adult Hodgkin&apos;s Disease Case–Control Study, the Scandinavian Lymphoma Etiology Study and the Northern Dutch Hodgkin Lymphoma Study) and compared them with generic controls chosen by country from earlier genome-wide association studies of other cancers in populations of European ancestry, among them ARCAGE, the IARC Central Europe Study, the Pancreatic Cancer Cohort Consortium, the Nijmegen Biomedical Study and the Wellcome Trust Case–Control Consortium. It was the European discovery sample of the 2014 Hodgkin lymphoma GWAS meta-analysis with the University of Southern California and University of Chicago GWAS.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1200</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6417</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>ECS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European Collaborative GWAS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">European Collaborative Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15040">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004952"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001678"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15040"/>
        <obo:IAO_0000116>Hodgkin lymphoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4055950/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The European Collaborative Study, presented elsewhere, included 1,241 HL cases aged 13–80 (median age = 33 years) from five European-based HL studies and 5,726 generic controls aged 17–94 (mean age = 62) used in the initial GWAS scan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001678"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002129"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4055950/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The European Collaborative Study, presented elsewhere, included 1,241 HL cases aged 13–80 (median age = 33 years) from five European-based HL studies and 5,726 generic controls aged 17–94 (mean age = 62) used in the initial GWAS scan. In addition to the classical HL cases described in the initial GWAS, 41 non-cHL cases were also included in the total. The distribution of cases among the five European-based HL studies is: the EPILYMPH Study (N = 196), the Scotland and Newcastle Lymphoma Group and the Young Adult Hodgkin’s Disease Case–Control Study (N = 397), the Scandinavian Lymphoma Etiology Study (SCALE) (N = 344), and the Northern Dutch Hodgkin Lymphoma Study (N = 304).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001678"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002394"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4055950/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>the Scotland and Newcastle Lymphoma Group and the Young Adult Hodgkin’s Disease Case–Control Study (N = 397)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001678"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002588"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4055950/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The European Collaborative Study, presented elsewhere, included 1,241 HL cases aged 13–80 (median age = 33 years) from five European-based HL studies and 5,726 generic controls aged 17–94 (mean age = 62) used in the initial GWAS scan. In addition to the classical HL cases described in the initial GWAS, 41 non-cHL cases were also included in the total. The distribution of cases among the five European-based HL studies is: the EPILYMPH Study (N = 196), the Scotland and Newcastle Lymphoma Group and the Young Adult Hodgkin’s Disease Case–Control Study (N = 397), the Scandinavian Lymphoma Etiology Study (SCALE) (N = 344), and the Northern Dutch Hodgkin Lymphoma Study (N = 304).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001678"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC3274508</oboInOwl:hasDbXref>
        <rdfs:comment>as well as 1395 study-specific control subjects representing nine European countries, including the Czech Republic, Denmark, France, Germany, Ireland, the Netherlands, Spain, Sweden, and the United Kingdom.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:24920014</owl:annotatedTarget>
        <dcterms:title>A meta-analysis of Hodgkin lymphoma reveals 19p13.3 TCF3 as a novel susceptibility locus.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24920014</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4055950/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The European Collaborative Study, presented elsewhere, included 1,241 HL cases aged 13–80 (median age = 33 years) from five European-based HL studies and 5,726 generic controls aged 17–94 (mean age = 62) used in the initial GWAS scan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001678"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A European genome-wide association study of classical Hodgkin lymphoma that genotyped, at the Centre National de Génotypage in France, cases from five European Hodgkin lymphoma studies (the EPILYMPH Study, the Scotland and Newcastle Lymphoma Group, the Young Adult Hodgkin&apos;s Disease Case–Control Study, the Scandinavian Lymphoma Etiology Study and the Northern Dutch Hodgkin Lymphoma Study) and compared them with generic controls chosen by country from earlier genome-wide association studies of other cancers in populations of European ancestry, among them ARCAGE, the IARC Central Europe Study, the Pancreatic Cancer Cohort Consortium, the Nijmegen Biomedical Study and the Wellcome Trust Case–Control Consortium. It was the European discovery sample of the 2014 Hodgkin lymphoma GWAS meta-analysis with the University of Southern California and University of Chicago GWAS.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22286212</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24920014</obo:IAO_0000119>
