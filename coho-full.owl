        <oboInOwl:hasRelatedSynonym>MsOS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MsOS (Hong Kong)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Osteoporotic Fractures in Women Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Ms. OS (Hong Kong)</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18243">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
