        <oboInOwl:hasRelatedSynonym>University of Noth Carolina Rectal Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">North Carolina Colon Cancer Study</rdfs:label>
    </owl:NamedIndividual>
