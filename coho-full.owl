    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002196"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3310</owl:annotatedTarget>
        <obo:IAO_0000116>OCCPI patients completing tumour screening and germline testing</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8232834/</oboInOwl:hasDbXref>
        <rdfs:comment>Tumor screening and germline testing were completed for 3,310 patients, representing 12.4% of CRC diagnosed in Ohio during the study period per the Ohio Incidence and Surveillance System (N = 26,692).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
