    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000922"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective Dutch birth cohort of healthy pregnant women enrolled from October 2000 to 2002, recruited from a cohort study on pregnancy-related pelvic girdle pain (&apos;conventional lifestyles&apos;) and, for contrast, through organic food shops, anthroposophic doctors and midwives, Steiner schools and dedicated magazines (&apos;alternative lifestyles&apos;), and their children, set up to identify lifestyle and other early-life factors that influence atopic disease and followed into young adulthood.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16343090</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42116128</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000922"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2877</owl:annotatedTarget>
        <obo:IAO_0000116>children whose mothers were included, 2000-2002</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13335302/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In total, mothers of 2,877 children were included in the Koala Birth Cohort Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000922"/>
