        <obo:IAO_0000112>PGS004608</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:37178517</obo:IAO_0000112>
        <obo:IAO_0000115>A naturalistic, longitudinal observational study run by the Laureate Institute for Brain Research in Tulsa, Oklahoma, United States, that recruited healthy controls and treatment-seeking individuals with mood, anxiety, substance use and eating disorders from the Tulsa metropolitan area from 2015 to 2018 and assessed them at levels from self-report, behaviour and physiology to neuroimaging, cells, molecules and genes, following the NIMH Research Domain Criteria, to predict symptom severity, treatment outcome and prognosis.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1050</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>T-1000</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>T1000</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tulsa 1000</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tulsa-1000 study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Tulsa 1000 study</rdfs:label>
    </owl:NamedIndividual>
