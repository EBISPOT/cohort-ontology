        <obo:IAO_0000112>GCST90012825</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal clinical-pathologic cohort study of ageing and Alzheimer&apos;s disease run by the Rush Alzheimer&apos;s Disease Center, which since 1994 has enrolled older Catholic nuns, priests and brothers from across the United States who are free of dementia at enrolment and agree to annual clinical evaluations and brain donation at death.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1168</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ROS</oboInOwl:hasRelatedSynonym>
