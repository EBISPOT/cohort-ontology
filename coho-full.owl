    <!-- http://www.ebi.ac.uk/coho/COHO_0002695 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002695">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:39934197</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort study and research infrastructure in Sweden, run from Karolinska Institutet, that from 2009 to 2016 recruited adults from the general population, mainly in the Stockholm region, with index persons aged 18 to 45 years invited to bring their household members, and collected questionnaires, physical assessments and biological samples with planned repeated follow-up, to study diseases with onset early in life, pregnancy and early-life exposures, and later co-morbidity.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">50437</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>LifeGene Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LifeGene cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LifeGene study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Swedish LifeGene cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">LifeGene</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://lifegene.se/For-scientists/About-LifeGene/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002695"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11814342/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The LifeGene study randomly invited individuals 18 years or older from the general population in Stockholm, Sweden, between 2009 and 2016</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002695"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39934197</owl:annotatedTarget>
        <dcterms:title>Early life factors and variation in adult kidney function in the Swedish LifeGene cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39934197</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:39934197%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The population-based LifeGene study (Sweden) randomly recruited individuals aged 18 to 43 years (n = 12 167).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002695"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort study and research infrastructure in Sweden, run from Karolinska Institutet, that from 2009 to 2016 recruited adults from the general population, mainly in the Stockholm region, with index persons aged 18 to 45 years invited to bring their household members, and collected questionnaires, physical assessments and biological samples with planned repeated follow-up, to study diseases with onset early in life, pregnancy and early-life exposures, and later co-morbidity.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21104112</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39934197</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
