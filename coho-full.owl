        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Born in Bradford</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://borninbradford.nhs.uk/"/>
