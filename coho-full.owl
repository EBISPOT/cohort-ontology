        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13017</owl:annotatedTarget>
        <obo:IAO_0000116>French adults (7,876 women aged 35-60 and 5,141 men aged 45-60) included in the trial</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15557412+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 13 017 French adults (7876 women aged 35-60 years and 5141 men aged 45-60 years) were included.</rdfs:comment>
    </owl:Axiom>
