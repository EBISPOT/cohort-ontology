        <obo:IAO_0000112>PMID:26997371</obo:IAO_0000112>
        <obo:IAO_0000115>A project combining the RADAR-Young and RADAR-Old adolescent cohorts in the Netherlands, followed through repeated questionnaires to investigate development and relationships with parents, friends and romantic partners.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">RADAR also names the cohort of children of radiation-exposed radar technicians in the EGA (COHO:0000326, EGAS00001007321); this term is the Dutch adolescent development study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>Radar</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Research on Adolescent Development and Relationships</rdfs:label>
    </owl:NamedIndividual>
