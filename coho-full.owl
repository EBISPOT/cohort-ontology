        <obo:IAO_0000112>PMID:33079599</obo:IAO_0000112>
        <obo:IAO_0000115>A retrospective clinic-based cohort of patients with familial hypercholesterolaemia caused by a known mutation, identified by genetic screening among the patients with dyslipidaemia attending the lipid clinic (Nutrition, Metabolism and Atherosclerosis Clinic) of the Institut de recherches cliniques de Montréal in Montreal, Canada, whose clinical records and lipid profiles, measured after a washout of cholesterol-lowering medication, are used to study genetic and clinical modifiers of lipid levels and cardiovascular disease in familial hypercholesterolaemia.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">725</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CNMA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CNMA cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Clinique de nutrition métabolisme et athérosclérose</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nutrition, Metabolism and Atherosclerosis Clinic</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nutrition, Metabolism and Atherosclerosis Clinic (CNMA) of Institut de recherches cliniques de Montréal</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Nutrition, Metabolism and Atherosclerosis Clinic cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14421">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005439"/>
