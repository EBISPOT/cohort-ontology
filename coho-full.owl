    <!-- http://www.ebi.ac.uk/coho/COHO_0001490 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001490">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13467"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000134"/>
        <obo:IAO_0000112>PMID:25349970</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based, retrospective study of the histological types of ovarian carcinoma in the province of Alberta, Canada, whose cases are women with ovarian carcinoma identified through the Alberta Cancer Registry and sampled by histological type (endometrioid, clear cell, mucinous and high-grade serous carcinoma), with archival tumour tissue and pathology reports reviewed by a gynaecological pathologist, clinical data abstracted from medical charts and yearly updates of vital status, to study molecular and clinical differences between the types and survival.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AOTT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AOV</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Alberta Ovarian Tumor Types study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Alberta Ovarian Tumor Types Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13467">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005140"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001490"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13467"/>
        <obo:IAO_0000116>ovarian carcinoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3794544/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were sampled from an ongoing study of ovarian histological types comprising approximately 1,000 women with ovarian carcinomas (300 endometrioid, 300 clear cell, 300 mucinous, and 100 high-grade serous).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001490"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13578740/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>AOV (Alberta Ovarian Tumor Types study, Canada, 1978–2010, PubMed ID: 25349970)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001490"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25349970</owl:annotatedTarget>
        <dcterms:title>Evidence for a time-dependent association between FOLR1 expression and survival from ovarian carcinoma: implications for clinical testing. An Ovarian Tumour Tissue Analysis consortium study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25349970</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4264456/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For the Alberta Ovarian Tumor Types study (AOV), Calgary Serous Carcinoma study (CAL), Nottingham Ovarian Cancer study (NOT), Toronto Ovarian Cancer study (TOC) and British Columbia Cancer Agency study (VAN), the institutional research ethics boards waived the need to obtain consent and all local human research investigations committees approved each study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001490"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based, retrospective study of the histological types of ovarian carcinoma in the province of Alberta, Canada, whose cases are women with ovarian carcinoma identified through the Alberta Cancer Registry and sampled by histological type (endometrioid, clear cell, mucinous and high-grade serous carcinoma), with archival tumour tissue and pathology reports reviewed by a gynaecological pathologist, clinical data abstracted from medical charts and yearly updates of vital status, to study molecular and clinical differences between the types and survival.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24175302</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25349970</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41922350</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001490"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1000</owl:annotatedTarget>
        <obo:IAO_0000116>women with ovarian carcinoma in the study (approximate), 2013</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3794544/</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were sampled from an ongoing study of ovarian histological types comprising approximately 1,000 women with ovarian carcinomas (300 endometrioid, 300 clear cell, 300 mucinous, and 100 high-grade serous).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001490"/>
