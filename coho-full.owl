        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort study of common eye diseases and other health outcomes among permanent residents aged 49 years or older of two postcode areas in the Blue Mountains, west of Sydney, Australia, identified through a census and examined at baseline in 1992–1994 and then every five years to 2007–2009, with newly eligible residents added in an extension study in 1999–2000.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16623958</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33732727</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001061"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3654</owl:annotatedTarget>
