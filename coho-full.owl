    <!-- http://www.ebi.ac.uk/coho/COHO_0000593 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000593">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000105"/>
        <obo:IAO_0000112>GCST90105058</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of about 1,700 people from six isolated villages in the Friuli Venezia Giulia region of north-eastern Italy, examined between 2008 and 2010 in the Genetic Park of Friuli Venezia Giulia project; one of the isolated populations of the Italian Network of Genetic Isolates, which studies the genetic basis of complex diseases and phenotypes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1700</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>FVG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Friuli-Venezia Giulia Genetic Park</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Park of Friuli Venezia Giulia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>INGI-FVG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>INGI-Friuli Venezia Giulia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Italian Network on Genetic Isolates - Friuli Venezia Giulia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Italian Network on Genetic Isolates-Friuli-Venezia Giulia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Italian Network of Genetic Isolates - Friuli Venezia Giulia</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000593"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4997959/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In particular, our study used 370 individuals from INGI-CARL, a population coming from Carlantino, a small village located in Puglia (Southern Italy), and 843 defined as INGI-FVG, making reference to 6 villages situated in the Friuli Venezia Region in North-Eastern Italy for a total of 1207 samples.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000593"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90105058</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis identifies 48 risk variants and highlights the role of the stria vascularis in hearing loss.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35580588</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9247887/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Italian Network of Genetic Isolates - Friuli Venezia Giulia (INGI-FVG; n = 339)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000593"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of about 1,700 people from six isolated villages in the Friuli Venezia Giulia region of north-eastern Italy, examined between 2008 and 2010 in the Genetic Park of Friuli Venezia Giulia project; one of the isolated populations of the Italian Network of Genetic Isolates, which studies the genetic basis of complex diseases and phenotypes.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10178705/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7080768/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9436946/supplementaryFiles</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000593"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1700</owl:annotatedTarget>
        <obo:IAO_0000116>subjects from the Genetic Park of Friuli Venezia Giulia project (approximate)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-022-32821-z/MediaObjects/41467_2022_32821_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The INGI-FVG cohort consisted of about 1700 subjects drawn from the project “Genetic Park of Friuli Venezia Giulia”.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000593"/>
