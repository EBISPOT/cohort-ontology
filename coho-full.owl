    <!-- http://www.ebi.ac.uk/coho/COHO_0002306 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002306">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19691"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PGS002252</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:21655089</obo:IAO_0000112>
        <obo:IAO_0000115>An open-label randomised phase 3 trial in which patients aged 18 or older who had undergone potentially curative surgery for stage III or high-risk stage II colorectal cancer were recruited at 170 hospitals in seven countries, led from the United Kingdom, between 2005 and 2010 and randomly assigned to adjuvant capecitabine alone or capecitabine plus bevacizumab, to test whether bevacizumab improves disease-free survival.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1952</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Multicentre international study of capecitabine ± bevacizumab as adjuvant treatment of colorectal cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>QUASAR2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>QUick And Simple And Reliable trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Quick and Simple and Reliable trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">QUASAR 2</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19691">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005575"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002306"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19691"/>
        <obo:IAO_0000116>colorectal cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3107194/</oboInOwl:hasDbXref>
        <rdfs:comment>VQ58 comprised 1,832 CRC cases (1,099 males, mean age of diagnosis 62.5 years; SD±10.9) from the VICTOR [12] and QUASAR2 (www.octo-oxford.org.uk/alltrials/trials/q2.html) trials.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002306"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5098601/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>These trials recruited patients from throughout the United Kingdom.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002306"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS002252</owl:annotatedTarget>
        <dcterms:title>Risk Stratification for Early-Onset Colorectal Cancer Using a Combination of Genetic and Environmental Risk Scores: An International Multi-Center Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35026030</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002306"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21655089</owl:annotatedTarget>
        <dcterms:title>Multiple common susceptibility variants near BMP pathway loci GREM1, BMP4, and BMP2 explain part of the missing heritability of colorectal cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21655089</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3107194/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>VQ58 comprised 1,832 CRC cases (1,099 males, mean age of diagnosis 62.5 years; SD±10.9) from the VICTOR [12] and QUASAR2 (www.octo-oxford.org.uk/alltrials/trials/q2.html) trials.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002306"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An open-label randomised phase 3 trial in which patients aged 18 or older who had undergone potentially curative surgery for stage III or high-risk stage II colorectal cancer were recruited at 170 hospitals in seven countries, led from the United Kingdom, between 2005 and 2010 and randomly assigned to adjuvant capecitabine alone or capecitabine plus bevacizumab, to test whether bevacizumab improves disease-free survival.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27660192</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.isrctn.com/api/query/format/default?q=ISRCTN45133151</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002306"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1952</owl:annotatedTarget>
        <obo:IAO_0000116>Eligible patients enrolled in QUASAR 2, 2005-2010</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27660192+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Between April 25, 2005, and Oct 12, 2010, 1952 eligible patients were enrolled, of whom 1941 had assessable data (968 in the capecitabine alone group and 973 in the capecitabine and bevacizumab group).</rdfs:comment>
    </owl:Axiom>
