        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000047"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000063"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000064"/>
