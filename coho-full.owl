        <oboInOwl:hasDbXref>PMID:33332181</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001874"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:26343387</owl:annotatedTarget>
        <dcterms:title>A comprehensive 1,000 Genomes-based genome-wide association meta-analysis of coronary artery disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:26343387</oboInOwl:hasDbXref>
