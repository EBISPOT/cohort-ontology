        <owl:annotatedTarget>PMID:20972438</owl:annotatedTarget>
        <dcterms:title>A multi-stage genome-wide association study of bladder cancer identifies multiple susceptibility loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20972438</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.687/MediaObjects/41588_2010_BFng687_MOESM14_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Lutherstadt Wittenberg Bladder Cancer Study (LWBCS) 217 200 Hospital-based case-control, Germany</rdfs:comment>
