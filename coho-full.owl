    <!-- http://www.ebi.ac.uk/coho/COHO_0002721 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002721">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23103"/>
        <rdf:type rdf:nodeID="genid23105"/>
        <rdf:type rdf:nodeID="genid23107"/>
        <rdf:type rdf:nodeID="genid23109"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001813"/>
        <obo:IAO_0000112>PMID:22886559</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of adults aged 18 or older with newly diagnosed primary glioma or other neuroepitheliomatous tumors, meningioma, or acoustic neuroma, and patients admitted for nonmalignant conditions, recruited at referral hospitals in Boston, Phoenix and Pittsburgh, United States, between June 1994 and August 1998. Controls were frequency-matched to the case series on age, sex, race or ethnicity, hospital and residential distance from the hospital. Interviews and biological samples support investigation of brain-tumor risk factors, including cellular-telephone use, occupational exposures and genetic susceptibility.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">782</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">799</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>NCI-BTS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCI_BTS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">National Cancer Institute Adult Brain Study</rdfs:label>
    </owl:NamedIndividual>
