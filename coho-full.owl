    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid2897">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0018905"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000316"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
