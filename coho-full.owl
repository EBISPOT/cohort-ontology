    <!-- http://www.ebi.ac.uk/coho/COHO_0002017 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002017">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17681"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002499"/>
        <obo:IAO_0000112>PMID:28112199</obo:IAO_0000112>
        <obo:IAO_0000115>The patients of the Leukaemia Research Fund CLL4 trial, a UK randomised phase III trial that between 1999 and 2004 assigned previously untreated patients with chronic lymphocytic leukaemia requiring treatment (Binet stage progressive A, B or C) to first-line chlorambucil, fludarabine, or fludarabine plus cyclophosphamide. Markers measured at trial entry were used to study prognosis, and blood samples from a subset of its patients were genotyped for the UK genome-wide association studies of chronic lymphocytic leukaemia and for studies of germline variants and patient outcome.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">777</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CLL4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LRCCL-4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LRF CLL4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leukaemia Research CLL-4 trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK Leukemia Research Fund CLL4 trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UKCLL4</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Leukaemia Research Fund CLL4 trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17681">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004948"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002017"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17681"/>
        <obo:IAO_0000116>chronic lymphocytic leukaemia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17658394+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>777 patients with chronic lymphocytic leukaemia requiring treatment were randomly assigned to fludarabine (n=194) or fludarabine plus cyclophosphamide (196) for six courses, or chlorambucil (387) for 12 courses.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002017"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4832371/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The deaths of LRF CLL4 trial patients still resident in the UK were flagged and reported to the Clinical Trial Service Unit at Oxford.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002017"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28112199</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analysis of chronic lymphocytic leukaemia, Hodgkin lymphoma and multiple myeloma identifies pleiotropic risk loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28112199</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5253627/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The CLL-UK1 GWAS comprised 517 cases: (i) 155 cases (95 male; mean age at diagnosis: 59 years) from ICLLLC; and (ii) 362 cases (269 male; mean age at diagnosis: 63 years) from the Leukaemia Research CLL-4 trial.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002017"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The patients of the Leukaemia Research Fund CLL4 trial, a UK randomised phase III trial that between 1999 and 2004 assigned previously untreated patients with chronic lymphocytic leukaemia requiring treatment (Binet stage progressive A, B or C) to first-line chlorambucil, fludarabine, or fludarabine plus cyclophosphamide. Markers measured at trial entry were used to study prognosis, and blood samples from a subset of its patients were genotyped for the UK genome-wide association studies of chronic lymphocytic leukaemia and for studies of germline variants and patient outcome.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17658394</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20511662</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26457986</obo:IAO_0000119>
