        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001000681</oboInOwl:hasDbXref>
        <rdfs:comment>We used the NELSON cohort as a discovery set, comprising 1,030 cases and 1,808 controls, and the LifeLines cohort as a replication set, with 711 cases and 3,013 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000058"/>
