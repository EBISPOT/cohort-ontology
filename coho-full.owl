    <!-- http://www.ebi.ac.uk/coho/COHO_0002601 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002601">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21896"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>PMID:29752553</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, population-based cohort of children born in Skåne, Sweden, between September 2000 and August 2004 who were screened as newborns for risk of type 1 diabetes, with children at increased risk followed with yearly capillary blood samples for islet autoantibodies from two to 15 years of age or until diabetes onset, to investigate the genetic and environmental factors contributing to or triggering type 1 diabetes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35683</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/DiPiS</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>DiPiS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DiPiS study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Diabetes Prediction in Skåne study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Diabetes Prediction in Skåne</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21896">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005147"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002601"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21896"/>
        <obo:IAO_0000116>type 1 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6060880/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Diabetes Prediction in Skåne (DiPiS) study is a prospective follow-up of children at risk of T1D in southern Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002601"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:30109365%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>The aim of this study was to analyse glycaemic control over a longer period, past the period of partial remission, after diagnosis in children followed before diagnosis in the Swedish Diabetes Prediction in Skåne (DiPiS) study compared with children of equal age not enrolled in pre-diabetes follow-up, receiving equivalent diabetes care.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002601"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29752553</owl:annotatedTarget>
        <dcterms:title>Influence of early-life parental severe life events on the risk of type 1 diabetes in children: the DiPiS study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29752553</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6060880/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>influence the risk of developing type 1 diabetes (T1D) using data from the prospective Diabetes Prediction in Skåne (DiPiS) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002601"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, population-based cohort of children born in Skåne, Sweden, between September 2000 and August 2004 who were screened as newborns for risk of type 1 diabetes, with children at increased risk followed with yearly capillary blood samples for islet autoantibodies from two to 15 years of age or until diabetes onset, to investigate the genetic and environmental factors contributing to or triggering type 1 diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29752553</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40664750</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
