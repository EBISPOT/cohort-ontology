        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000301"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of 1,000 healthy individuals of western European ancestry recruited in France by the Institut Pasteur&apos;s Milieu Intérieur project to dissect the interplay between genetics, environment and the immune system.</owl:annotatedTarget>
