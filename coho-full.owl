        <obo:IAO_0000112>PMID:27780307</obo:IAO_0000112>
        <obo:IAO_0000115>A school-based cohort study of myopia in Singapore children, begun in three Singapore schools in 1999–2001, which recruited children aged 7 to 9 years and examined them yearly in their schools, with cycloplegic autorefraction and ocular biometry, to study the risk factors for the onset and progression of myopia.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1979</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SCORM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SCORM study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Cohort Of the Risk factors for Myopia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Cohort Study of Risk Factors for Myopia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Cohort Study of the Risk factors for Myopia study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Cohort of Risk Factors for Myopia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Cohort study Of the Risk factors for Myopia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Cohort study Of the Risk factors for Myopia study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Singapore Cohort Study of the Risk Factors for Myopia</rdfs:label>
    </owl:NamedIndividual>
