    <!-- http://www.ebi.ac.uk/coho/COHO_0001507 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001507">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13652"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:34214236</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based prostate cancer risk-screening study in the United Kingdom, coordinated by the Institute of Cancer Research, that invites men of European ancestry via their general practitioners to undergo a germline genetic profile test of prostate cancer risk single nucleotide polymorphisms. Men in the highest genetic-risk stratum are offered MRI-led prostate screening and targeted biopsy; the study began with a feasibility pilot before opening to wider recruitment.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6393</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BARCODE 1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The BARCODE 1 Study: The Use of Genetic Profiling to Guide Prostate Cancer Targeted Screening</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">BARCODE1</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13652">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001507"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13652"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9292247/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The BARCODE1 study (NCT03857477) is enrolling men of European ancestry from the community via their GPs to undergo a germline genetic profile test utilising 130 PCa risk SNPs.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001507"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34214236+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The BARCODE1 Pilot has shown this community study in the UK to be feasible, with an overall uptake of 26%.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001507"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34214236</owl:annotatedTarget>
        <dcterms:title>The BARCODE1 Pilot: a feasibility study of using germline single nucleotide polymorphisms to target prostate cancer screening.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34214236</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9292247/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The BARCODE1 study (NCT03857477) is enrolling men of European ancestry from the community via their GPs to undergo a germline genetic profile test utilising 130 PCa risk SNPs.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001507"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based prostate cancer risk-screening study in the United Kingdom, coordinated by the Institute of Cancer Research, that invites men of European ancestry via their general practitioners to undergo a germline genetic profile test of prostate cancer risk single nucleotide polymorphisms. Men in the highest genetic-risk stratum are offered MRI-led prostate screening and targeted biopsy; the study began with a feasibility pilot before opening to wider recruitment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34214236</obo:IAO_0000119>
        <dcterms:contributor>Claude Sonnet 5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001507"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6393</owl:annotatedTarget>
        <obo:IAO_0000116>men with a polygenic risk score calculated (genotyped participants), 2025</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:40214032%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Among 40,292 persons invited to participate, 8953 (22.2%) expressed interest in participating and 6393 had their polygenic risk score calculated; 745 (11.7%) had a polygenic risk score in the 90th percentile or higher and were invited to undergo screening.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001508 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001508">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid13658"/>
        <obo:IAO_0000112>PMID:19879194</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of patients with relapsing–remitting multiple sclerosis or a clinically isolated syndrome with MRI signs of demyelination, assembled by Bayer Schering Pharma from four of its clinical trials: three studies of interferon beta-1b (BENEFIT, BEYOND and the 16-year long-term follow-up of the pivotal interferon beta-1b trial in relapsing–remitting multiple sclerosis) and one of a CCR1 antagonist. It was genotyped genome-wide and used as multiple sclerosis cases in genetic studies of susceptibility.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1340</coho:numberOfCases>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1340</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BayerScheringPharma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TT</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Therapeutic Trial collection</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13658">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005301"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001508"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13658"/>
        <obo:IAO_0000116>multiple sclerosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19879194+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>a validation set of 1340 individuals with MS and 1109 controls taken from several MS therapeutic trials (TT cohort)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001508"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:19879194</owl:annotatedTarget>
        <dcterms:title>Integration of genetic risk factors into a clinical algorithm for multiple sclerosis susceptibility: a weighted genetic risk score.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:19879194</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3099419/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>This sample collection is therefore referred to as the Therapeutic Trial (TT) collection.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001508"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of patients with relapsing–remitting multiple sclerosis or a clinically isolated syndrome with MRI signs of demyelination, assembled by Bayer Schering Pharma from four of its clinical trials: three studies of interferon beta-1b (BENEFIT, BEYOND and the 16-year long-term follow-up of the pivotal interferon beta-1b trial in relapsing–remitting multiple sclerosis) and one of a CCR1 antagonist. It was genotyped genome-wide and used as multiple sclerosis cases in genetic studies of susceptibility.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19879194</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22190364</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001508"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1340</owl:annotatedTarget>
        <obo:IAO_0000116>MS/CIS patients pooled from the Bayer Schering Pharma trials (cases in the 2009 validation set)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3099419/</oboInOwl:hasDbXref>
        <rdfs:comment>Similarly, details on the first validation set that includes subjects assembled by Bayer Schering Pharma from its therapeutic trials include a total of 1340 cases (Table 1b).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001508"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1340</owl:annotatedTarget>
        <obo:IAO_0000116>MS/CIS patients pooled from the Bayer Schering Pharma trials (cases in the 2009 validation set)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3099419/</oboInOwl:hasDbXref>
        <rdfs:comment>Similarly, details on the first validation set that includes subjects assembled by Bayer Schering Pharma from its therapeutic trials include a total of 1340 cases (Table 1b).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001508"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BayerScheringPharma</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001508"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001509 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001509">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:28817493</obo:IAO_0000112>
        <obo:IAO_0000115>A birth cohort of mother–child pairs recruited at delivery in the 2000s from women with singleton pregnancies giving birth consecutively at the obstetrics department of the Charité university hospital in Berlin, Germany, with maternal blood, umbilical cord blood, placentas and birth measurements collected at birth. It is used to study maternal and fetal influences, including genetic ones, on birth weight, pregnancy outcomes and maternal physiology in pregnancy.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2089</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Berlin Birth Cohort study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Berlin Birth Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001509"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6976643/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study was conducted in 1023 mothers with singleton pregnancies delivering at the Charité obstetrics department, Berlin, Germany from 2000 to 2008.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001509"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28817493</owl:annotatedTarget>
        <dcterms:title>DNA methylation of the glucocorticoid receptor gene promoter in the placenta is associated with blood pressure regulation in human pregnancy.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28817493</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28817493+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The study was performed as a nested case-control study (n = 80) out of 1045 mother/child pairs from the Berlin Birth Cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001509"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A birth cohort of mother–child pairs recruited at delivery in the 2000s from women with singleton pregnancies giving birth consecutively at the obstetrics department of the Charité university hospital in Berlin, Germany, with maternal blood, umbilical cord blood, placentas and birth measurements collected at birth. It is used to study maternal and fetal influences, including genetic ones, on birth weight, pregnancy outcomes and maternal physiology in pregnancy.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17030683</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19696694</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29309628</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31954177</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31969597</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001509"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2089</owl:annotatedTarget>
        <obo:IAO_0000116>women (mother-child pairs) analysed in a 2009 study of the cohort; analysed subset, no whole-cohort total found</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:19696694</oboInOwl:hasDbXref>
        <rdfs:comment>Two thousand and eighty-nine (2089) Caucasian women without preexisting diabetes and preexisting hypertension with singleton pregnancies delivering consecutively at the Charité obstetrics department participated in this study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001509"/>
