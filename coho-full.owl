        <obo:IAO_0000115>An abnormality of head and neck.</obo:IAO_0000115>
        <rdfs:label>Abnormality of head or neck</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0000234 -->

