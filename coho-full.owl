        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002455"/>
        <obo:IAO_0000112>GCST90002243</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based sample of Han Chinese individuals in Taiwan, selected at random from the healthy controls of the Taiwan Han Chinese Cell and Genome Bank, who had been recruited by stratified three-stage probability cluster sampling through the registry of the non-aboriginal townships and city districts of Taiwan. It was genotyped genome-wide with support from the Academia Sinica Genomic Medicine Multicenter Study.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">920</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TWSC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Taiwan Super Control Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001425"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002455"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3405/MediaObjects/41588_2015_BFng3405_MOESM35_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Control participants of the Taiwan Super Control Study (Taiwan) who took part in the current analysis included 1,000 randomly selected individuals whose genetic data were extracted from the Han‐Chinese Cell and Genome Bank in Taiwan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001425"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90002243</owl:annotatedTarget>
        <dcterms:title>The trans-ancestral genomic architecture of glycemic traits.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34059833</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-021-00852-9/MediaObjects/41588_2021_852_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>TWSC This work was supported by Academia Sinica GMM project.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001425"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based sample of Han Chinese individuals in Taiwan, selected at random from the healthy controls of the Taiwan Han Chinese Cell and Genome Bank, who had been recruited by stratified three-stage probability cluster sampling through the registry of the non-aboriginal townships and city districts of Taiwan. It was genotyped genome-wide with support from the Academia Sinica Genomic Medicine Multicenter Study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24647736</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32453789</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001425"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">920</owl:annotatedTarget>
        <obo:IAO_0000116>non-diabetic participants analysed for HbA1c (analysed subset)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7274451/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We tested the association of the SLC2A10 polymorphism with HbA1c in the Taiwan Super Control Study (TWSC) [35]. Subjects with diabetes were excluded, as defined by physician diagnosis, medication use, or HbA1c ≥ 6.5%. A total of 920 participants were included.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001425"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TWSC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


