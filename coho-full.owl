    <!-- http://www.ebi.ac.uk/coho/COHO_0001942 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001942">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <obo:IAO_0000112>PMID:24244950</obo:IAO_0000112>
        <obo:IAO_0000115>A study of exceptional longevity, approved by the ethics committee of Keio University School of Medicine, that enrols centenarians from throughout Japan, with an emphasis on semi-supercentenarians aged 105 or more whose ages are validated with the Basic Resident Registration Card, together with referent subjects (spouses of centenarians&apos; offspring and healthy younger volunteers), and whose genotyped cases and geographically matched controls serve as a Japanese case-control set in genetic studies of extreme old age.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym JCS also denotes Johannesburg Cancer Study (COHO:0000823); this term is Japanese Centenarian Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">513</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">561</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>JCS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Japanese Centenarian Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001942"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3808698/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The JCS enrolls Japanese centenarians from throughout Japan with an emphasis upon recruiting semi-supercentenarians (age 105+ years) and referent cohort subjects comprising spouses of centenarians&apos; offspring and healthy younger volunteers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001942"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:24244950</owl:annotatedTarget>
        <dcterms:title>Meta‐analysis of genetic variants associated with human exceptional longevity.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24244950</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3808698/</oboInOwl:hasDbXref>
        <rdfs:comment>The Japanese Centenarian Study (JCS) included 513 long lived individuals (median survival 106 years; age range 100-114) and 561 geographically matched controls (median age 75 years; range: 26-89).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001942"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study of exceptional longevity, approved by the ethics committee of Keio University School of Medicine, that enrols centenarians from throughout Japan, with an emphasis on semi-supercentenarians aged 105 or more whose ages are validated with the Basic Resident Registration Card, together with referent subjects (spouses of centenarians&apos; offspring and healthy younger volunteers), and whose genotyped cases and geographically matched controls serve as a Japanese case-control set in genetic studies of extreme old age.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20011587</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24244950</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001942"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">513</owl:annotatedTarget>
        <obo:IAO_0000116>long-lived individuals (cases) and geographically matched controls of the JCS in the 2013 longevity meta-analysis (genotyped set)</obo:IAO_0000116>
