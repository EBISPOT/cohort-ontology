    <!-- http://www.ebi.ac.uk/coho/COHO_0001933 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001933">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17058"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Portugal"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <obo:IAO_0000112>PGS000741</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33623038</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case–control study of prostate cancer at the Portuguese Oncology Institute of Porto (IPO-Porto), Portugal, whose cases are men with early-onset and/or familial prostate cancer and whose controls are blood donors, contributing to the PRACTICAL consortium&apos;s genome-wide association and polygenic risk studies of prostate cancer.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">462</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">132</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>IPO-Porto</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IPO-Porto Prostate Cancer study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">IPO-Porto study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17058">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001933"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17058"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4503425/</oboInOwl:hasDbXref>
        <rdfs:comment>This study comprised a total of 462 index cases (HPC samples) from families with early-onset and/or familial/hereditary PrCa, which were selected based on one of the following criteria: 1) PrCa diagnosis before the age of 56 or 2) PrCa diagnosis at any age with family history of the disease (up to fourth degree relatives) and at least one family member (the proband or a relative) with PrCa before the age of 66.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001933"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Portugal"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4596899/</oboInOwl:hasDbXref>
        <rdfs:comment>IPO-Porto Portugal 66 183 59.3 8.3 82.8 20.0 15.8 64.5 0.0</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001933"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000741</owl:annotatedTarget>
        <dcterms:title>Polygenic hazard score is associated with prostate cancer in multi-ethnic populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33623038</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001933"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33623038</owl:annotatedTarget>
        <dcterms:title>Polygenic hazard score is associated with prostate cancer in multi-ethnic populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33623038</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-021-21287-0/MediaObjects/41467_2021_21287_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The IPO-Porto study was funded by Fundação para a Ciência e a Tecnologia (FCT; UID/DTP/00776/2013 and PTDC/DTP-PIC/1308/2014) and FEDER (POCI-01-0145-FEDER-028245).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001933"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case–control study of prostate cancer at the Portuguese Oncology Institute of Porto (IPO-Porto), Portugal, whose cases are men with early-onset and/or familial prostate cancer and whose controls are blood donors, contributing to the PRACTICAL consortium&apos;s genome-wide association and polygenic risk studies of prostate cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-021-21287-0/MediaObjects/41467_2021_21287_MOESM1_ESM.pdf</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001933"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">462</owl:annotatedTarget>
        <obo:IAO_0000116>IPO-Porto index cases and blood donor controls in the 2015 HOXB13 study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4503425/</oboInOwl:hasDbXref>
        <rdfs:comment>This study comprised a total of 462 index cases (HPC samples) from families with early-onset and/or familial/hereditary PrCa, which were selected based on one of the following criteria: 1) PrCa diagnosis before the age of 56 or 2) PrCa diagnosis at any age with family history of the disease (up to fourth degree relatives) and at least one family member (the proband or a relative) with PrCa before the age of 66.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001933"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">132</owl:annotatedTarget>
        <obo:IAO_0000116>IPO-Porto index cases and blood donor controls in the 2015 HOXB13 study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4503425/</oboInOwl:hasDbXref>
        <rdfs:comment>As control subjects, we used 132 male blood donors (mean age 56.8 years; SD±5.1 years) from the Portuguese Oncology Institute of Porto with no personal history of cancer at the time of blood collection.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001933"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IPO-Porto</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


