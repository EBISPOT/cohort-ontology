    <!-- http://www.ebi.ac.uk/coho/COHO_0000545 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000545">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90270327</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal cohort of about 11,500 children aged 9-10, including about 1,720 twins, recruited largely through schools at 21 data acquisition sites across the United States to reflect the nation&apos;s diversity, and followed for ten years with annual assessments and biennial MRI to study adolescent brain and cognitive development.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym ABCD also denotes Amsterdam Born Children and their Development (COHO:0001451); this term is Adolescent Brain Cognitive Development Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11878</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ABCD%20study</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>ABCD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ABCD Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ABCD study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Adolescent Brain Cognitive Development</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Adolescent Brain Cognitive Development Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000545"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6314286/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>the marginal race and ethnic composition for children living within the site-defined recruitment catchment areas of these 21 sites (described below) closely matches the distribution of the U.S. as a whole.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000545"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90270327</owl:annotatedTarget>
        <dcterms:title>Joint multi-ancestry and admixed GWAS reveals the complex genetics behind human cranial vault shape.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37973980</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37973980+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>magnetic resonance images of 6772 children from the ABCD study cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000545"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal cohort of about 11,500 children aged 9-10, including about 1,720 twins, recruited largely through schools at 21 data acquisition sites across the United States to reflect the nation&apos;s diversity, and followed for ten years with annual assessments and biennial MRI to study adolescent brain and cognitive development.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29703560</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
