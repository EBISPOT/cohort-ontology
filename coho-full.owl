        <obo:IAO_0000112>PGS000344</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:23360124</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of ovarian cancer run from University College London at hospitals in England, Wales and Northern Ireland, whose cases are women with an adnexal mass suspicious of ovarian cancer about to undergo surgery or with a confirmed or probable diagnosis of primary invasive or borderline ovarian cancer, and whose controls are women with a possibly benign or borderline adnexal mass and apparently healthy women from the multimodal screening arm of UKCTOCS, set up to find genetic risk factors, markers to add to CA125 and early symptoms of ovarian cancer.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">718</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1123</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>UKO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UKOPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>United Kingdom Ovarian Cancer Population Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">UK Ovarian Cancer Population Study</rdfs:label>
