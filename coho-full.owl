        <obo:IAO_0000112>PMID:20693352</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional health and nutrition study of urban Greek adults aged 60 years and over, a randomly selected group of members of the Centers of Open Protection for the Elderly in the Athens region recruited between 2004 and 2008, assessed with standardized anthropometric, biochemical and clinical procedures and extensive questionnaires to investigate the interactions among socioeconomic, lifestyle, dietary, psychological and biochemical factors that determine the health status of elderly Greeks.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">782</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GHRAS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Greek Health Randomized Aging Study</rdfs:label>
    </owl:NamedIndividual>
