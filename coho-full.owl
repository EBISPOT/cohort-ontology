    <!-- http://www.ebi.ac.uk/coho/COHO_0002183 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002183">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18805"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001316"/>
        <obo:IAO_0000112>PGS000786</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:27008869</obo:IAO_0000112>
        <obo:IAO_0000115>A UK study of women with histologically confirmed endometrial cancer, identified through collaborating clinicians throughout the United Kingdom, with the help of the National Cancer Research Network, from 2008 to 2013 (avoiding centres that recruited to the SEARCH study) and coordinated from the University of Oxford, to find inherited genetic variants that influence endometrial cancer risk; its cases have been compared with controls from other UK studies, such as the CORGI study and the 1958 Birth Cohort.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">925</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NSECG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Study of Endometrial Cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Study of the Genetics of Endometrial Cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK National Study of Endometrial Cancer Genetics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">National Study of Endometrial Cancer Genetics</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18805">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011962"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002183"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18805"/>
        <obo:IAO_0000116>endometrial cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM302_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>NSECG | UK National Study of Endometrial Cancer Genetics | UK; population based cases</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002183"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM301_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>National Study of the Genetics of Endometrial Cancer (NSECG) cases were identified from collaborating clinicians throughout the UK from 2008 to 2013, taking care not to recruit from centres involved in SEARCH.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002183"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000786</owl:annotatedTarget>
        <dcterms:title>Pan-cancer analysis demonstrates that integrating polygenic risk scores with modifiable risk factors improves risk prediction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33247094</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002183"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27008869</owl:annotatedTarget>
        <dcterms:title>GWAS meta-analysis of 16 852 women identifies new susceptibility locus for endometrial cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27008869</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC5868213</oboInOwl:hasDbXref>
        <rdfs:comment>Meta-analysis of GWAS results from the Australian National Endometrial Cancer Study (ANECS), the US Epidemiology of Endometrial Cancer Consortium (E2C2), the UK National Study of Endometrial Cancer Genetics (NSECG) and the UK Studies of Epidemiology and Risk factors in Cancer Heredity (SEARCH) in 4907 cases and 11 945 controls of European ancestry examined 9 486 271 SNPs for association with risk of EC.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002183"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A UK study of women with histologically confirmed endometrial cancer, identified through collaborating clinicians throughout the United Kingdom, with the help of the National Cancer Research Network, from 2008 to 2013 (avoiding centres that recruited to the SEARCH study) and coordinated from the University of Oxford, to find inherited genetic variants that influence endometrial cancer risk; its cases have been compared with controls from other UK studies, such as the CORGI study and the 1958 Birth Cohort.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27135401</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM301_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002183"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">925</owl:annotatedTarget>
        <obo:IAO_0000116>NSECG cases genotyped on Illumina 660W Quads for the GWAS scan</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM301_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>925 samples were genotyped using the Ilumina 660W Quads in the GWAS scan, 965 samples were genotyped in the phase 1 additional genotyping using iCOGS arrays, and a further 1195 were genotyped using KASPar and Fluidigm genotyping for the second phase.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002183"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NSECG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


