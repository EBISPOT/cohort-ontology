        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002734"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1164</owl:annotatedTarget>
        <obo:IAO_0000116>adults hospitalised with COVID-19 enrolled May 2020 to March 2021</obo:IAO_0000116>
