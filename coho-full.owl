        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004781"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002726"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23169"/>
        <obo:IAO_0000116>acute myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30616610+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In total, 978 acute myocardial infarction patients were enrolled in this study; of these, 146 died and 832 survived during 2 years of follow-up after the acute myocardial infarction.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002726"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22777311+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We compared clinical features, hospital management and prognosis of STEMI/NSTEMI in an unselected cohort of 1,496 prospectively enrolled patients (STEMI, 36.9 % and NSTEMI, 63.1 %), admitted in 1 year to one of the six hospitals in Florence health district (Italy).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002726"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS395</owl:annotatedTarget>
        <dcterms:title>NMR-based metabolomics identifies patients at high risk of death within two years after acute myocardial infarction in the AMI-Florence II cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30616610</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS395</oboInOwl:hasDbXref>
        <rdfs:comment>NMR-based metabolomics identifies patients at high risk of death within two years after acute myocardial infarction in the AMI-Florence II cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002726"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A registry of patients with acute myocardial infarction admitted to the coronary units of the six hospitals of the Florence health district, Italy, between April 2008 and April 2009, followed for survival after the infarction.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30616610</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
