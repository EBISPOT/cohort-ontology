        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Iceland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11054002+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A population-based cataract epidemiological study, the Reykjavik Eye Study, was conducted to determine the prevalence and characteristics of lens opacities in Iceland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002315"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000350</owl:annotatedTarget>
        <dcterms:title>Association of a Primary Open-Angle Glaucoma Genetic Risk Score With Earlier Age at Diagnosis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31436842</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002315"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20835238</owl:annotatedTarget>
        <dcterms:title>Common variants near CAV1 and CAV2 are associated with primary open-angle glaucoma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20835238</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3222888/</oboInOwl:hasDbXref>
        <rdfs:comment>in 316 samples with IOP and CCT measurements without glaucoma from the Reykjavik Eye Study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002315"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based epidemiological study of eye disease, run by Icelandic and Japanese study groups, in which citizens of Reykjavik, Iceland, aged 50 years and older, randomly selected from the national population census, were given ophthalmological examinations to determine the prevalence of lens opacities, refractive error and visual acuity, and open-angle glaucoma.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11054002</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:11167223</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:12928689</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002315"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1045</owl:annotatedTarget>
        <obo:IAO_0000116>randomly selected Reykjavik residents aged 50 and over who took part in the baseline examination</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11054002+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>1,635 randomly selected residents of Reykjavik, Iceland, were enrolled, and among them, 1,045 responded and took part in the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002315"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


