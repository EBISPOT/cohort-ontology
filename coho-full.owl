    <!-- http://www.ebi.ac.uk/coho/COHO_0000484 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000484">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid4256"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000608"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000985"/>
        <obo:IAO_0000112>GCST90093118</obo:IAO_0000112>
        <obo:IAO_0000115>A family study of the NHLBI Family Blood Pressure Program that from 1995 to 2000 recruited African American and white sibships with two or more members with hypertension diagnosed before age 60, with their untreated adult offspring and random population samples, at centres in Birmingham (Alabama), Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), to identify genes promoting hypertension.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2407</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Family Blood Pressure Program-HyperGEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HYPERGEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HyperGEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HyperGEN Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HyperGen</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hypertension Genetic Epidemiology Network</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid4256">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005044"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000484"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4256"/>
        <obo:IAO_0000116>hypertension</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>HyperGEN recruited African American and White hypertensive sibships with 2 or more hypertensive sibs, at least 1 of them having severe HT.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000484"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>HyperGEN (Hypertension Genetic Epidemiology Network) included field centers in Birmingham AL, which recruited African Americans; the rest of centers in Forsyth County, NC, in Framingham, MA, in Minneapolis, MN, and in Salt Lake City, UT recruited Whites.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000484"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90093118</owl:annotatedTarget>
        <dcterms:title>Whole-Exome Sequencing and hiPSC Cardiomyocyte Models Identify MYRIP, TRAPPC11, and SLC27A6 of Potential Importance to Left Ventricular Hypertrophy in an African Ancestry Population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33679876</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:33679876%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>among 1,364 participants of African ancestry (AAs) in the Hypertension Genetic Epidemiology Network (HyperGEN)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000484"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family study of the NHLBI Family Blood Pressure Program that from 1995 to 2000 recruited African American and white sibships with two or more members with hypertension diagnosed before age 60, with their untreated adult offspring and random population samples, at centres in Birmingham (Alabama), Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), to identify genes promoting hypertension.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10964005</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7933688/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000484"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2407</owl:annotatedTarget>
        <obo:IAO_0000116>hypertensive siblings examined 1995-2000 (sibship component only; offspring and random samples not included)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:10964005</oboInOwl:hasDbXref>
        <rdfs:comment>The projected sample size of 2244 hypertensive participants was surpassed, as 2407 hypertensive individuals (1262 African-Americans and 1145 whites) from 917 sibships were examined.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000484"/>
