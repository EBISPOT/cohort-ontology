        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002669"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective mother-child cohort of pregnant women living in the Butajira Health and Demographic Surveillance Site, Meskan and Mareko district, Ethiopia, enrolled from 2017-2018 by the School of Public Health of Addis Ababa University and followed through pregnancy and after birth to study how maternal nutrition, mycotoxin exposure and mental health affect prenatal and postnatal growth and development.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37620778</obo:IAO_0000119>
        <obo:IAO_0000119>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/BUNMAP</obo:IAO_0000119>
