        <obo:IAO_0000112>GCST90013445</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of people with type 1 diabetes diagnosed before the age of 17, assembled by the JDRF/Wellcome Trust Diabetes and Inflammation Laboratory from paediatric and adult diabetes clinics at National Health Service hospitals across mainland United Kingdom, whose DNA and plasma samples are used in genetic and other studies of type 1 diabetes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8344</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GRID</oboInOwl:hasRelatedSynonym>
