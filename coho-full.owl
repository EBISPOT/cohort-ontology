        <rdfs:comment>T1DGC was organized into four regional networks (Asia-Pacific, Europe, North America, and the United Kingdom)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000174"/>
