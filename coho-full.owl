        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <obo:IAO_0000112>PMID:36239614</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based inception cohort of all patients newly diagnosed with inflammatory bowel disease (ulcerative colitis or Crohn&apos;s disease) from 1990 to 1993 while living in four counties of south-eastern Norway, each matched for age and sex with five controls drawn from the Norwegian Population Register, set up to establish the incidence of the disease in the region and followed prospectively for its natural course at 1, 5, 10, 20 and 30 years.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">843</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>IBSEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IBSEN study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Inflammatory Bowel South-Eastern Norway</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Inflammatory Bowel disease in South-Eastern Norway</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Inflammatory Bowel Disease in South-Eastern Norway</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16793">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005011"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid16795">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005101"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001892"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16793"/>
        <obo:IAO_0000116>Crohn&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10115228/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The IBSEN cohort included 519 incident patients with ulcerative colitis [UC] and 237 patients with Crohn’s disease [CD] between 1990 and 1993, each matched with five controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001892"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16795"/>
        <obo:IAO_0000116>ulcerative colitis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10115228/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The IBSEN cohort included 519 incident patients with ulcerative colitis [UC] and 237 patients with Crohn’s disease [CD] between 1990 and 1993, each matched with five controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001892"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Norway"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10115228/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In summary, all newly diagnosed IBD patients from January 1, 1990 to December 31, 1993 residing in four geographically well-defined areas [counties] in Southeast Norway were included.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001892"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:36239614</owl:annotatedTarget>
        <dcterms:title>Mortality in Patients with Inflammatory Bowel Disease: Results from 30 Years of Follow-up in a Norwegian Inception Cohort (the IBSEN study).</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36239614</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10115228/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The IBSEN cohort included 519 incident patients with ulcerative colitis [UC] and 237 patients with Crohn’s disease [CD] between 1990 and 1993, each matched with five controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001892"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based inception cohort of all patients newly diagnosed with inflammatory bowel disease (ulcerative colitis or Crohn&apos;s disease) from 1990 to 1993 while living in four counties of south-eastern Norway, each matched for age and sex with five controls drawn from the Norwegian Population Register, set up to establish the incidence of the disease in the region and followed prospectively for its natural course at 1, 5, 10, 20 and 30 years.</owl:annotatedTarget>
