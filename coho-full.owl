    <!-- http://www.ebi.ac.uk/coho/COHO_0001125 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001125">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid10287"/>
        <obo:IAO_0000112>GCST90572789</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium of large, well-phenotyped cohort studies, mostly population-based, formed to study the determinants and effects of thyroid diseases and thyroid function with genomic, epigenomic, transcriptomic, proteomic and metabolomic data, which meta-analyses genome-wide association data from its member cohorts on thyroid-stimulating hormone, free thyroxine, triiodothyronine, thyroid dysfunction and related traits and makes the summary statistics available.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">271040</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>The ThyroidOmics Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ThyroidOmics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">ThyroidOmics Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10287">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003240"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001125"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10287"/>
        <obo:IAO_0000116>thyroid disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://genepi.med.uni-greifswald.de/thyroidomics/</oboInOwl:hasDbXref>
        <rdfs:comment>The ThyroidOmics Consortium was formed to study the determinants and effects of thyroid diseases and thyroid function, using various omics technologies in multiple large and well-phenotyped cohort studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001125"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90572789</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study and polygenic risk prediction of hypothyroidism.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41238958</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12695664/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The SumHer heritability estimates seem to be quite heterogeneous, e.g., the heritability of TSH in the ThyroidOmics meta-analysis is less than the TSH variance explained by the independent index SNPs in that study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001125"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium of large, well-phenotyped cohort studies, mostly population-based, formed to study the determinants and effects of thyroid diseases and thyroid function with genomic, epigenomic, transcriptomic, proteomic and metabolomic data, which meta-analyses genome-wide association data from its member cohorts on thyroid-stimulating hormone, free thyroxine, triiodothyronine, thyroid dysfunction and related traits and makes the summary statistics available.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30367059</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38291025</obo:IAO_0000119>
        <obo:IAO_0000119>https://genepi.med.uni-greifswald.de/thyroidomics/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001125"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">271040</owl:annotatedTarget>
        <obo:IAO_0000116>euthyroid individuals (maximum N) in the 2024 reference-range thyroid function GWAS meta-analysis of 46 cohorts</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10828500/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted GWAS meta-analyses of reference range thyroid function including up to 271,040 euthyroid individuals from European ancestry across 46 predominantly population-based cohorts from the ThyroidOmics Consortium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001125"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ThyroidOmics</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001126 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001126">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10293"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90044894</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre randomized clinical trial funded by the US National Institute of Diabetes and Digestive and Kidney Diseases that from 2004 to 2009 enrolled children and adolescents aged 10–17 years with type 2 diabetes of less than two years&apos; duration, a body-mass index at or above the 85th percentile and no diabetes autoantibodies at 15 clinical centres in the United States, and compared metformin alone with metformin plus rosiglitazone or plus an intensive lifestyle intervention for durable glycaemic control until 2011; its participants were then followed into adulthood in the observational TODAY2 study (2011–2020).</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">699</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TODAY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TODAY2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Treatment Options for type 2 Diabetes in Adolescents and Youth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Treatment Options for Type 2 Diabetes in Adolescents and Youth</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10293">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001126"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10293"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22540912+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We compared the efficacy of three treatment regimens to achieve durable glycemic control in children and adolescents with recent-onset type 2 diabetes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001126"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11570374/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, 699 participants, 10 to 17 years old, diagnosed with type 2 diabetes by American Diabetes Association criteria, with duration 2 years or less, body mass index (BMI) ≥ 85th percentile for age and sex, were enrolled across 15 clinical centers in the United States</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001126"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90044894</owl:annotatedTarget>
        <dcterms:title>Genome-wide Association Study of Lipid Traits in Youth With Type 2 Diabetes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34568709</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34568709+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We genotyped 206 928 variants and imputed 17 642 824 variants in 1076 youth (mean age 15.0 ± 2.48 years) with T2D from the Treatment Options for Type 2 Diabetes in Adolescents and Youth (TODAY) and SEARCH for Diabetes in Youth (SEARCH) studies as part of the Progress in Diabetes Genetics in Youth (ProDiGY) consortium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001126"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre randomized clinical trial funded by the US National Institute of Diabetes and Digestive and Kidney Diseases that from 2004 to 2009 enrolled children and adolescents aged 10–17 years with type 2 diabetes of less than two years&apos; duration, a body-mass index at or above the 85th percentile and no diabetes autoantibodies at 15 clinical centres in the United States, and compared metformin alone with metformin plus rosiglitazone or plus an intensive lifestyle intervention for durable glycaemic control until 2011; its participants were then followed into adulthood in the observational TODAY2 study (2011–2020).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17448130</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22540912</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38815053</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001126"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">699</owl:annotatedTarget>
        <obo:IAO_0000116>participants randomised to a treatment group (2009)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3478667/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 1211 children and adolescents who were screened, 927 (76.5%) entered the run-in phase and 699 (75.4%) were randomly assigned to a treatment group, for an overall enrollment rate of 57.7%.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001126"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TODAY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001126"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TODAY2</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001127 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001127">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10301"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90709786</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, multicentre, longitudinal epidemiological and biomarker study of Parkinson&apos;s disease in the United Kingdom, funded by Parkinson&apos;s UK, that recruited patients aged 18–90 with a clinical diagnosis of Parkinson&apos;s disease of recent onset (diagnosed within the preceding 3.5 years) or young onset (diagnosed at or before age 50) at 72 National Health Service secondary-care sites, together with unaffected siblings of patients, and follows them with repeated motor, non-motor and quality-of-life assessments, genotyping and biosamples, to explain variation in the clinical phenotype of Parkinson&apos;s disease, including its relation to genetic variation.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2247</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PRoBaND</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Parkinson&apos;s repository of biosamples and networked datasets</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TPD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tracking Parkinson&apos;s Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Tracking Parkinson&apos;s</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10301">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001127"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10301"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26485428+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Patients attending specialist clinics in the United Kingdom with recent onset (&lt;3.5 years) and young onset (diagnosed &lt;50 years of age) PD were enrolled.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001127"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11161485/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were recruited at 72 secondary healthcare centres that are part of the UK National Health Service.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90709786</owl:annotatedTarget>
        <dcterms:title>Genome-wide determinants of mortality and motor progression in Parkinson&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38849413</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11161485/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Tracking Parkinson’s is a longitudinal, prospective, multi-centre observational study in the UK51.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, multicentre, longitudinal epidemiological and biomarker study of Parkinson&apos;s disease in the United Kingdom, funded by Parkinson&apos;s UK, that recruited patients aged 18–90 with a clinical diagnosis of Parkinson&apos;s disease of recent onset (diagnosed within the preceding 3.5 years) or young onset (diagnosed at or before age 50) at 72 National Health Service secondary-care sites, together with unaffected siblings of patients, and follows them with repeated motor, non-motor and quality-of-life assessments, genotyping and biosamples, to explain variation in the clinical phenotype of Parkinson&apos;s disease, including its relation to genetic variation.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26485428</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38849413</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001127"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2247</owl:annotatedTarget>
        <obo:IAO_0000116>Parkinson&apos;s disease patients recruited (recent onset and young onset); siblings not included (2015)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4927877/</oboInOwl:hasDbXref>
        <rdfs:comment>2247 PD cases were recruited (1987 recent onset, 260 young onset).</rdfs:comment>
    </owl:Axiom>
