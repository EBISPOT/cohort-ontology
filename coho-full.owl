    <!-- http://www.ebi.ac.uk/coho/COHO_0001912 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001912">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. Checked 2026-09-23: The PGS Catalog&apos;s full name for ILUH, &apos;Infanta Leonor University Hospital (Madrid, Spain)&apos;, is wrong: in the CIMBA papers the Catalog curated, ILUH is Iceland&apos;s Landspitali University Hospital. ILUH is the PGS Catalog&apos;s id for the BRCA1/BRCA2 pathogenic-variant carriers contributed to CIMBA (COHO:0000901) by Landspitali University Hospital in Reykjavik, Iceland (PMID:28448241, 34320204, 32665703, 36203093); the Catalog&apos;s expansion &apos;Infanta Leonor University Hospital (Madrid, Spain)&apos; is an error. The sample has no name of its own beyond the hospital, so, like the other institution-named CIMBA sites the review decided (MSKCC, UPENN, BRICOH, Chicago, FCCC, OUH, and E522 ICO in this batch), it is not a cohort. It is not the deCODE genetics Icelandic cohort (COHO:0000428): CIMBA lists it as a clinic-based site sample of mutation carriers. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Infanta Leonor University Hospital (Madrid, Spain)</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001913 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001913">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000533"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. IMM labels the Tohoku Medical Megabank cohort data (the Community-Based Cohort and the Birth and Three-Generation Cohort) analysed by the Iwate group in the papers the PGS Catalog records the id in (PMID:39174808, PMID:40695273). Replaced by COHO:0000533 (Tohoku Medical Megabank Project), which now carries this term&apos;s names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Iwate Tohoku Medical Megabank</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001914 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001914">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16896"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000398"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000536"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000641"/>
        <obo:IAO_0000112>PGS000217</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33067605</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre prospective cohort study of European adults aged 54 to 79 years with at least three vascular risk factors but no previous cardiovascular or cerebrovascular events, enrolled at seven centres in Finland, France, Italy, the Netherlands and Sweden and followed for vascular events by visits at 15 and 30 months and a final telephone interview, to assess carotid intima-media thickness and its progression as predictors of vascular events.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3711</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Carotid Intima Media Thickness [IMT] and IMT-progression as predictors of vascular events in a high risk European population</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IMPROVE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IMPROVE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Carotid Intima-Media Thickness (IMT) and IMT-Progression as Predictors of Vascular Events in a High-Risk European Population</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16896">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001914"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16896"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19952003+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The &apos;IMPROVE study&apos; was designed to investigate whether cross-sectional carotid artery intima-media thickness (IMT) and overall IMT progression are predictors of new vascular events in European individuals at high risk of cardiovascular diseases.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001914"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5567407/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The participants were enrolled at 7 centers in 5 European countries: Finland (Kuopio, 2 centers), France (Paris), Italy (Milan and Perugia), The Netherlands (Groningen) and Sweden (Stockholm).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001914"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000217</owl:annotatedTarget>
        <dcterms:title>Genomic and drug target evaluation of 90 cardiovascular proteins in 30,931 individuals.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33067605</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001914"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33067605</owl:annotatedTarget>
        <dcterms:title>Genomic and drug target evaluation of 90 cardiovascular proteins in 30,931 individuals.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33067605</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC7611474</oboInOwl:hasDbXref>
        <rdfs:comment>In addition, we calculated the inter-plate coefficient of variation using data from a pooled plasma sample in one of the participating cohorts -the IMPROVE study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001914"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre prospective cohort study of European adults aged 54 to 79 years with at least three vascular risk factors but no previous cardiovascular or cerebrovascular events, enrolled at seven centres in Finland, France, Italy, the Netherlands and Sweden and followed for vascular events by visits at 15 and 30 months and a final telephone interview, to assess carotid intima-media thickness and its progression as predictors of vascular events.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19952003</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28602434</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001914"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3711</owl:annotatedTarget>
        <obo:IAO_0000116>adults aged 54-79 with at least three vascular risk factors recruited at seven centres in five European countries</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19952003+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 3711 subjects (age range 54-79 years) with at least three vascular risk factors (VRFs) were recruited in seven centres in Finland, France, Italy, the Netherlands, and Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001914"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IMPROVE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001915 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001915">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16904"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000103"/>
        <obo:IAO_0000112>PGS000809</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:21654844</obo:IAO_0000112>
