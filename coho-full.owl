    <!-- http://www.ebi.ac.uk/coho/COHO_0000632 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000632">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid5680"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90841377</obo:IAO_0000112>
        <obo:IAO_0000115>A phase 3 clinical prevention trial that screened cognitively unimpaired adults aged 65–85 with amyloid PET at 67 sites in Australia, Canada, Japan and the USA from 2014 to 2017 and tested, in those with elevated brain amyloid, whether the anti-amyloid antibody solanezumab slows cognitive decline in preclinical Alzheimer&apos;s disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1169</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>A4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>A4 Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Anti-Amyloid Treatment in Asymptomatic Alzheimer Disease Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Anti-Amyloid Treatment in Asymptomatic Alzheimer&apos;s Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Anti-Amyloid Treatment in Asymptomatic Alzheimer&apos;s Disease Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid5680">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004975"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid5680"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12825300/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The A4 Study was a secondary prevention trial in preclinical Alzheimer’s disease, aiming to slow cognitive decline associated with brain amyloid accumulation in clinically normal older individuals.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12825300/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were screened for the A4 study from 67 sites across Australia, Canada, Japan and the USA between April 2014 to December 2017.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000632"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90841377</owl:annotatedTarget>
        <dcterms:title>Large multi-ethnic genetic analyses of amyloid imaging identify new genes for Alzheimer disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37101235</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10134547/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>These subjects were recruited from the Memory and Aging Project (MAP) at the Knight Alzheimer Disease Research Center (Knight-ADRC) [16, 17], Alzheimer&apos;s Disease Neuroimaging Initiative (ADNI) [18], the Dominantly Inherited Alzheimer Network (DIAN) [19], Anti-Amyloid Treatment in Asymptomatic Alzheimer&apos;s Disease (A4) [20], ADNI Department of Defense (ADNIDOD) studies, Australian Imaging, Biomarkers and Lifestyle (AIBL) [21], The Harvard Aging Brain Study (HABS) [22], and University of Pittsburgh (UPitt) [23].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000632"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A phase 3 clinical prevention trial that screened cognitively unimpaired adults aged 65–85 with amyloid PET at 67 sites in Australia, Canada, Japan and the USA from 2014 to 2017 and tested, in those with elevated brain amyloid, whether the anti-amyloid antibody solanezumab slows cognitive decline in preclinical Alzheimer&apos;s disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:41569280</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1169</owl:annotatedTarget>
        <obo:IAO_0000116>participants randomised (578 solanezumab, 591 placebo)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:37458272</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1169 persons underwent randomization: 578 were assigned to the solanezumab group and 591 to the placebo group.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000632"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>A4</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000633 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000633">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid5687"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000160"/>
        <obo:IAO_0000112>GCST90642411</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing longitudinal study of all twins born in Sweden since July 1992, whose parents are interviewed about the children&apos;s somatic and mental health and social environment at age 9 or 12, with follow-up questionnaires at ages 15 and 18 and clinical assessments at 15 of screen-positive twin pairs and controls, to study the aetiology of childhood mental health problems and their role in later adjustment.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32952</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CATSS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Child and Adolescent Twin Study in Sweden</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid5687">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005084"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000633"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid5687"/>
        <obo:IAO_0000116>childhood mental health problems</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22506305+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The CATSS study has the potential of answering important questions on the etiology of childhood mental health problems and their role in the development of later adjustment problems.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000633"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22506305+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Child and Adolescent Twin Study in Sweden (CATSS) is an ongoing longitudinal twin study targeting all twins born in Sweden since July 1, 1992.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000633"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000160"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13580976/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Since 2004, the Swedish Twin Registry has invited parents of twins to participate in CATSS, contacting them at age 9 years in most years and at age 12 years during the first 3 years of data collection.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000633"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90642411</owl:annotatedTarget>
        <dcterms:title>Genetics of monozygotic twins reveals the impact of environmental sensitivity on psychiatric and neurodevelopmental phenotypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40494901</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12367547/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For the Swedish Twin Registry’s Child and Adolescent Twin Study in Sweden, E.A. performed the data analysis, P.L. was the principal investigator and R.K., M.T., S.L. and H.L. collected and prepared the data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000633"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing longitudinal study of all twins born in Sweden since July 1992, whose parents are interviewed about the children&apos;s somatic and mental health and social environment at age 9 or 12, with follow-up questionnaires at ages 15 and 18 and clinical assessments at 15 of screen-positive twin pairs and controls, to study the aetiology of childhood mental health problems and their role in later adjustment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22506305</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000633"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32952</owl:annotatedTarget>
        <obo:IAO_0000116>twins whose parents completed the age 9/12 interview (2019)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://doi.org/10.1017/thg.2019.99</oboInOwl:hasDbXref>
        <rdfs:comment>By May 2019, 16,476 parental interviews concerning 32,952 twins had been completed, with an overall response rate of 69%.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000633"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CATSS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


