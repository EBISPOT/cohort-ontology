        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11878</owl:annotatedTarget>
        <obo:IAO_0000116>children aged 9-10 enrolled at baseline (2016-2018)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8844713/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Out of the 11,878 participants in the study 127 (1.1%) withdrew.</rdfs:comment>
