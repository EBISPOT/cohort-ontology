    <!-- http://www.ebi.ac.uk/coho/COHO_0002007 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002007">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17604"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <obo:IAO_0000112>PGS000866</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:29280273</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional study of adults of European descent who underwent liver biopsy for suspected non-alcoholic steatohepatitis or for severe obesity, consecutively enrolled at the Metabolic Liver Diseases outpatient service and bariatric surgery centre of the Fondazione IRCCS Ca&apos; Granda Ospedale Policlinico in Milan and at Palermo University Hospital, Italy, and in the Northern Savo Hospital District in Kuopio, Finland, excluding people with excess alcohol intake or other causes of liver disease, and used to study the genetics of non-alcoholic fatty liver disease.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym LBC also denotes Lothian Birth Cohorts (COHO:0000111); this term is Liver Biopsy Cohort.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1515</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>LBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LiverBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Liver Biopsy Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17604">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0013209"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002007"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17604"/>
        <obo:IAO_0000116>non-alcoholic fatty liver disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8803605/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>the Liver Biopsy Cohort (LBC; n = 1,951) consisting of individuals at risk for non-alcoholic fatty liver disease (NAFLD) from northern and southern Europe</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002007"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5983109/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1,388 adult individuals of European descent were consecutively enrolled from the Metabolic Liver Diseases outpatient service and bariatric surgery center, Fondazione IRCCS Ca&apos; Granda Ospedale Policlinico Milano, Milan, Italy, and from the Northern Savo Hospital District, Kuopio, Finland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000866</owl:annotatedTarget>
        <dcterms:title>Causal relationship of hepatic fat with liver damage and insulin resistance in nonalcoholic fatty liver.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29280273</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29280273</owl:annotatedTarget>
        <dcterms:title>Causal relationship of hepatic fat with liver damage and insulin resistance in nonalcoholic fatty liver.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29280273</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5900872/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To this end, we evaluated complementary cohorts of individuals at risk of progressive NAFLD due to suspected NASH in the Liver Biopsy Cohort (LBC), or to severe obesity in the Swedish Obese Subjects Study (SOS), and individuals from the population‐based Dallas Heart Study (DHS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002007"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional study of adults of European descent who underwent liver biopsy for suspected non-alcoholic steatohepatitis or for severe obesity, consecutively enrolled at the Metabolic Liver Diseases outpatient service and bariatric surgery centre of the Fondazione IRCCS Ca&apos; Granda Ospedale Policlinico in Milan and at Palermo University Hospital, Italy, and in the Northern Savo Hospital District in Kuopio, Finland, excluding people with excess alcohol intake or other causes of liver disease, and used to study the genetics of non-alcoholic fatty liver disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29280273</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29881818</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35102341</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002007"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1515</owl:annotatedTarget>
        <obo:IAO_0000116>adults of European descent consecutively enrolled at liver biopsy (as of the 2018 report)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5900872/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, a total of 1515 adult European individuals who underwent liver biopsy for suspected NASH or severe obesity were consecutively enrolled.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002007"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LBC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002007"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LiverBC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002008 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002008">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17613"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:24388013</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of adults of European ancestry with physician-diagnosed mild, moderate or severe asthma, recruited through the Lung Institute of Western Australia from specialty asthma clinics and hospital databases, together with non-asthmatic controls selected at random from the metropolitan telephone directory, assembled for studies of the genetics of asthma and its severity.</obo:IAO_0000115>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">883</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>LIWA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LIWA cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Lung Institute of Western Australia</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Lung Institute of Western Australia Asthma Genetic Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17613">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002008"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17613"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3972120/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The LIWA cohort included a total of 883 unrelated Caucasians (125 severe, 172 moderate, 386 mild and 200 non-asthmatics) aged between 18 and 85.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002008"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:24388013</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analysis identifies 11 risk variants associated with the asthma with hay fever phenotype.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24388013</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4280183/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Cases and control subjects were drawn from 4 studies: the Queensland Institute of Medical Research (n = 921), the Lung Institute of Western Australia (n = 475), the Busselton Health Study (n = 445), and the Tasmanian Longitudinal Health Study (n = 296).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002008"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of adults of European ancestry with physician-diagnosed mild, moderate or severe asthma, recruited through the Lung Institute of Western Australia from specialty asthma clinics and hospital databases, together with non-asthmatic controls selected at random from the metropolitan telephone directory, assembled for studies of the genetics of asthma and its severity.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24691493</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
