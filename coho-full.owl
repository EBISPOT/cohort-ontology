    <!-- http://www.ebi.ac.uk/coho/COHO_0002239 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002239">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19190"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Barbados"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Latin_America_and_the_Caribbean"/>
        <obo:IAO_0000112>PGS000751</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:22402288</obo:IAO_0000112>
        <obo:IAO_0000115>A nationwide population-based case-control study of prostate cancer in Barbados, West Indies, whose cases were male citizens with newly diagnosed, histologically confirmed prostate cancer identified from July 2002 to January 2011 and whose controls were age-matched residents randomly selected from a national database, designed to evaluate genetic and epidemiologic contributors to prostate cancer in this Afro-Caribbean population.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1007</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1005</coho:numberOfControls>
