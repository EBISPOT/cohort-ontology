    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001313"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11857"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature05616/MediaObjects/41586_2007_BFnature05616_MOESM286_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Stage 1: Inclusion criteria for cases were (i) T2DM according to 1997 American Diabetes Association (ADA) criteria1 ; (ii) family history of diabetes in first degree relatives; (iii) BMI &lt; 30 kg/m².</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001313"/>
