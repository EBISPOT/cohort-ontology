    <!-- http://www.ebi.ac.uk/coho/COHO_0001331 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001331">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90909136</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based study of healthy young people aged 14–35, recruited at the University of Michigan in Ann Arbor, United States, between June 2006 and January 2009 from the university&apos;s undergraduate and graduate students together with their biological siblings, with blood samples for measuring plasma haemostatic proteins (such as von Willebrand factor and plasminogen), genome-wide genotyping and a survey of common morphological traits, to identify the genetic factors behind variation in blood clotting in healthy people, using its sibling structure for linkage as well as association analysis.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1189</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GABC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genes and Blood Clotting Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001331"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12314372/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1189 healthy individuals (ages 14-35) representing 507 sibships (with 2-6 siblings per family) from the University of Michigan, Ann Arbor, were recruited between June 26, 2006, and January 30, 2009.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001331"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90909136</owl:annotatedTarget>
        <dcterms:title>Genome-Wide Scan of Fifth Finger Clinodactyly.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40071514</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11897800/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The third cohort included participants recruited as part of the GABC study between 2006 and 2009 (Desch et al. 2013).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001331"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family-based study of healthy young people aged 14–35, recruited at the University of Michigan in Ann Arbor, United States, between June 2006 and January 2009 from the university&apos;s undergraduate and graduate students together with their biological siblings, with blood samples for measuring plasma haemostatic proteins (such as von Willebrand factor and plasminogen), genome-wide genotyping and a survey of common morphological traits, to identify the genetic factors behind variation in blood clotting in healthy people, using its sibling structure for linkage as well as association analysis.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23267103</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25208887</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40071514</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40756183</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001331"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1189</owl:annotatedTarget>
        <obo:IAO_0000116>healthy individuals recruited in 507 sibships (2009)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12314372/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1189 healthy individuals (ages 14-35) representing 507 sibships (with 2-6 siblings per family) from the University of Michigan, Ann Arbor, were recruited between June 26, 2006, and January 30, 2009.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001331"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GABC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001332 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001332">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid12021"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Austria"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90565134</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium of psoriasis genetics research groups in the United Kingdom, Ireland, Austria, Finland, Germany, Italy, the Netherlands, Spain and Sweden, with a management committee chaired from King&apos;s College London, that pools its members&apos; collections of people of European descent with psoriasis vulgaris, together with controls from national control collections, for genetic association studies of psoriasis, including a genome-wide association study with the Wellcome Trust Case Control Consortium 2 and an Immunochip case–control study.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2997</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9183</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12180</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GAP consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GAPC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetic Analysis of Psoriasis Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12021">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005083"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12021"/>
        <obo:IAO_0000116>psoriasis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We combined three existing GWAS datasets (hereafter referred to as Kiel3, CASP4 and WTCCC25) with two independent European-descent case-control datasets genotyped on the Immunochip: the Psoriasis Association Genetics Extension (PAGE: 3,580 cases and 5,902 controls) and the Genetic Analysis of Psoriasis Consortium (GAPC: 2,997 cases and 9,183 controls)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Finland control data were from the DILGOM (Dietary, Lifestyle, and Genetic determinants of Obesity and Metabolic syndrome) collection</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The German controls were obtained from the PopGen biobank and genotyped at the Institute of Clinical Molecular Biology, Christian-Albrechts-University of Kiel.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2467/MediaObjects/41588_2012_BFng2467_MOESM43_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Groningen group (Italian and Dutch controls)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We did not include specific controls from Austria or Sweden, but PCA analysis suggested that the cases from these cohorts were well matched to the controls from the Netherlands and Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Irish controls were provided by the Irish Blood Transfusion Service / TCD Biobank and the Irish cases collected with the aid of the Dublin Centre for Clinical Research.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GAPC cases and the Irish and Spanish controls were genotyped at the Wellcome Trust Sanger Institute (WTSI)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The UK controls were the WTCCC common controls that did not overlap with samples included in the original GWA studies (the dataset consisted of 6,740 1958 British Birth cohort and 2,900 UK Blood Service samples genotyped at the WTSI and the University of Virginia).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90565134</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genome-wide meta-analysis with 472,819 individuals identifies 32 novel risk loci for psoriasis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39885523</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11783861/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Samples of the Genetic Analysis of Psoriasis Consortium (GAPC) datasets were collected from subjects of European Caucasian descent at the participating institutions after obtaining informed consent in adherence with the Declaration of Helsinki Principles.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium of psoriasis genetics research groups in the United Kingdom, Ireland, Austria, Finland, Germany, Italy, the Netherlands, Spain and Sweden, with a management committee chaired from King&apos;s College London, that pools its members&apos; collections of people of European descent with psoriasis vulgaris, together with controls from national control collections, for genetic association studies of psoriasis, including a genome-wide association study with the Wellcome Trust Case Control Consortium 2 and an Immunochip case–control study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20953190</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23143594</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2467/MediaObjects/41588_2012_BFng2467_MOESM43_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
