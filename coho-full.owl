        <obo:IAO_0000112>GCST90565484</obo:IAO_0000112>
        <obo:IAO_0000115>A pan-Canadian prospective cohort platform, established by the Canadian Partnership Against Cancer in June 2008 as the Canadian Partnership for Tomorrow Project, that federates regional cohorts (seven across ten provinces, among them CARTaGENE and the Ontario Health Study; 307,017 participants aged 30–74 from 8 provinces in five cohorts in its 2018 profile) with harmonized questionnaire, physical measurement and biosample data and linkage to administrative health databases, to study how genetics, behaviour and environment affect cancer and other chronic diseases.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">307017</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CPTP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CanPath</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian Partnership for Tomorrow Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Canadian Partnership for Tomorrow&apos;s Health</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://canpath.ca/"/>
    </owl:NamedIndividual>
