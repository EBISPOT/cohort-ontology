        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001004434</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we present the first 391 Egyptian healthy volunteers (EHVols) recruited to establish a pilot phenotyped control cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000245"/>
