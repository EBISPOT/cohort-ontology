        <rdfs:comment>The GIST aimed to recruit all cases of glaucoma in Tasmania (an island state of Australia)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000087"/>
