        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">516</owl:annotatedTarget>
        <obo:IAO_0000116>women diagnosed with breast cancer in KBCP recruitment, 1990-1995</obo:IAO_0000116>
