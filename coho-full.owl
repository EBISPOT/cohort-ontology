    <!-- http://www.ebi.ac.uk/coho/COHO_0002330 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002330">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19875"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002462"/>
        <obo:IAO_0000112>PGS001778</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:25855707</obo:IAO_0000112>
        <obo:IAO_0000115>A biobank at Roswell Park Cancer Institute in Buffalo, New York, that collects blood samples before treatment, clinical data and an epidemiological questionnaire from patients newly diagnosed with cancer at the institute and, as controls, from people with no personal history of cancer (family members and friends of patients and community members), and supplies them to cancer research studies.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DBBR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Data Bank and BioRepository</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RPCI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RPCI Data Bank and Biorepository</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RPCI DataBank and BioRepository</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Roswell Park Cancer Institute</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Roswell Park Cancer Institute Data Bank and BioRepository</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19875">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004992"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002330"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19875"/>
        <obo:IAO_0000116>cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3433139/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Newly diagnosed cancer patients are asked to contribute specimens and data to the DBBR prior to treatment, and non-patients (family members and friends of patients and community members) with no personal history of cancer are also asked to participate in the DBBR as controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002330"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3433139/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a cross-sectional study including 75 healthy women, between 20 and 80 years of age, who participated in the Data Bank and BioRepository (DBBR) program at Roswell Park Cancer Institute (RPCI), Buffalo, NY, USA.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002330"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
