        <oboInOwl:hasRelatedSynonym>Estudio Familiar de Influencia Genetica de Alzheimer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
