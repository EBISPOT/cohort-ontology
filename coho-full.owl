        <rdfs:comment>All participants were residents of Kentucky.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000732"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90504004</owl:annotatedTarget>
        <dcterms:title>Genome-wide interaction study of dietary intake of fibre, fruits, and vegetables with risk of colorectal cancer.</dcterms:title>
