    <!-- http://www.ebi.ac.uk/coho/COHO_0000711 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000711">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001729"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001734"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001785"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001876"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001951"/>
        <obo:IAO_0000112>GCST90239828</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of genome-wide association studies of systolic and diastolic blood pressure, whose 2011 multi-stage meta-analysis combined about 200,000 individuals of European descent to find blood pressure loci and relate them to hypertension and cardiovascular disease risk.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ICBP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International Consortium for Blood Pressure</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International Consortium for Blood Pressure Genome-wide Association Studies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">International Consortium for Blood Pressure Genome-Wide Association Studies</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001729"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature10405/MediaObjects/41586_2011_BFnature10405_MOESM207_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Fourteen cohorts (DiaGen, HUNT2, FINRISK97, FUSION2, METSIM, CLUE, MDC, MPP, FBPP-HyperGen, FBPP-GenNet, Jamaicans-GXE, Jamaicans-SPT, CCMB cohorts and IRAS) were genotyped using the iPLEX Sequenom MassARRAY platform.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001734"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature10405/MediaObjects/41586_2011_BFnature10405_MOESM207_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Five studies (YFS, EPIC-TURIN, FLEMENGHO, Nigerians, and JMGP) were genotyped using Taqman assays (Applied Biosystems, USA).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001785"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature10405/MediaObjects/41586_2011_BFnature10405_MOESM207_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Fourteen cohorts (DiaGen, HUNT2, FINRISK97, FUSION2, METSIM, CLUE, MDC, MPP, FBPP-HyperGen, FBPP-GenNet, Jamaicans-GXE, Jamaicans-SPT, CCMB cohorts and IRAS) were genotyped using the iPLEX Sequenom MassARRAY platform.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001876"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0205-x/MediaObjects/41588_2018_205_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>ICBP GWAS is an international consortium to investigate BP genetics6-8 . We combined previously reported post-quality control (QC) GWAS data from 54 studies (N=150,134)8 , with newly available GWAS data from a further 23 independent studies (N=148,890) using a fixed effects inverse variance weighted meta-analysis. All study participants were of European descent and were imputed to either the 1000 Genomes Project Phase 1 integrated release version 3 [March 2012] all ancestry reference panel or the Haplotype Reference Consortium (HRC) panel. The final enlarged ICBP GWAS dataset included 77 studies comprising data from 299,024 individuals from the following cohorts: The initial ICBP GWAS included: AGES (n=3215), ARIC (n=9402), ASPS (n=828), B58C (n=6458), BHS (n=4492), CHS (n=3254), Cilento study (n=999), COLAUS (n=5404), COROGENE-CTRL (n=1878), CROATIA-Vis (n=945), CROATIA-Split (n=494), CROATIA-Korcula (n=867), EGCUT (n=6395), EGCUT2 (n=1844), EPIC (n=2100), ERF (n=2617), Fenland (n=1357), FHS (n=8096), FINRISK-ctrl (n=861), FINRISK CASE (n=839), FUSION (n=1045), GRAPHIC (n=1010), H2000-CTRL (n=1078), HealthABC (n=1661), HTO (n=1000)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001951"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature10405/MediaObjects/41586_2011_BFnature10405_MOESM207_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Japanese Millenium Genome Project comprises 7 independent study cohorts for studies of cardiovascular diseases and related risk factors.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90239828</owl:annotatedTarget>
        <dcterms:title>Genome-wide pleiotropy analysis identifies novel blood pressure variants and improves its polygenic risk scores.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34989438</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34989438+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We report here a bidirectional Mendelian Randomization (MR) and horizontal pleiotropy analysis of S/DBP summary statistics from the UK Biobank (UKB)-International Consortium for Blood Pressure (ICBP) (UKB-ICBP) BP genome-wide association study and construct a composite genetic risk score (GRS) by including pleiotropic variants.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium of genome-wide association studies of systolic and diastolic blood pressure, whose 2011 multi-stage meta-analysis combined about 200,000 individuals of European descent to find blood pressure loci and relate them to hypertension and cardiovascular disease risk.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21909115</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200000</owl:annotatedTarget>
        <obo:IAO_0000116>individuals of European descent in the 2011 multi-stage GWAS meta-analysis (discovery plus follow-up)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3340926/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>This genome-wide association study of SBP and DBP, which used a multi-stage design in 200,000 individuals of European descent, identified 16 novel loci: six of these loci contain genes previously known or suspected to regulate BP (GUCY1A3-GUCY1B3; NPR3-C5orf23; ADM; FURIN-FES; GOSR2; GNAS-EDN3); the other 10 provide new clues to BP physiology.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ICBP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000712 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000712">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid6398"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90104462</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control sample of 219 children with language impairment and 209 sex- and age-matched, unrelated controls collected at the University of Iowa, United States, who completed a battery of language measures (including the Peabody Picture Vocabulary Test and nonword repetition) used to define case status, and reading, spelling and IQ assessments, used in genetic association studies of language impairment and of reading- and language-related skills.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">219</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">209</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">428</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Iowa</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Iowa cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Iowa study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Iowa LI cohort</rdfs:label>
    </owl:NamedIndividual>
