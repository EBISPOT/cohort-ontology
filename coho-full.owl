        <obo:IAO_0000112>PGS005200</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:29892015</obo:IAO_0000112>
        <obo:IAO_0000115>A nested case-control study of atrial fibrillation within the Malmö Preventive Project in Malmö, Sweden, in which participants with prevalent or incident atrial fibrillation identified from national registers, with DNA from the project&apos;s 2002-2006 re-examination, were matched one to one to controls from the same cohort by sex, age and date of baseline examination.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MPP AF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MPP-AF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Malmö Preventive Project atrial fibillation study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Malmö Preventive Project atrial fibrillation study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18189">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004981"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002087"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18189"/>
        <obo:IAO_0000116>atrial fibrillation</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects with prevalent or incident AF were identified from national registers as previously described14 , and cases with DNA were then matched in a 1:1 fashion to controls with DNA from the same cohort by sex, age (±1 year), and date of baseline exam (±1 year).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002087"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>MPP: The Malmö Preventive Project (MPP) was a community-based disease prevention program including 33 346 inhabitants from the city of Malmö in Southern Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002087"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000787"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects with prevalent or incident AF were identified from national registers as previously described14 , and cases with DNA were then matched in a 1:1 fashion to controls with DNA from the same cohort by sex, age (±1 year), and date of baseline exam (±1 year).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002087"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005200</owl:annotatedTarget>
        <dcterms:title>Polygenic prediction of body mass index and obesity through the life course and across ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40691366</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002087"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29892015</owl:annotatedTarget>
        <dcterms:title>Polygenic prediction of body mass index and obesity through the life course and across ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29892015</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Malmö Preventive Project (MPP) was a community-based disease prevention program including 33 346 inhabitants from the city of Malmö in Southern Sweden. Complete birth cohorts between 1921-1949 were invited, and the participation rate was 71%. Participants underwent screening between 1974 to 1992 for cardiovascular risk factors, alcohol abuse, and breast cancer. Between 2002-2006, surviving participants were invited to a reexamination which included blood sampling13 from which DNA has been extracted. Subjects with prevalent or incident AF were identified from national registers as previously described14 , and cases with DNA were then matched in a 1:1 fashion to controls with DNA from the same cohort by sex, age (±1 year), and date of baseline exam (±1 year).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002087"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nested case-control study of atrial fibrillation within the Malmö Preventive Project in Malmö, Sweden, in which participants with prevalent or incident atrial fibrillation identified from national registers, with DNA from the project&apos;s 2002-2006 re-examination, were matched one to one to controls from the same cohort by sex, age and date of baseline examination.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29892015</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002087"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MPP-AF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


