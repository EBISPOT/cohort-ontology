    <!-- http://www.ebi.ac.uk/coho/COHO_0002645 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002645">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22255"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/India"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Asia"/>
        <obo:IAO_0000112>PMID:40838581</obo:IAO_0000112>
        <obo:IAO_0000115>A nationally representative in-depth study of late-life cognition and dementia in India, led from the University of Southern California with Indian partners, that recruited a sub-sample of Longitudinal Aging Study in India (LASI) respondents aged 60 and older, oversampling those at high risk of cognitive impairment, from 18 states and union territories in 2017–2019 and 22 in 2022–2024, and assessed them with the Harmonized Cognitive Assessment Protocol, informant interviews, geriatric assessments, blood biomarkers, neuroimaging, genomics and environmental exposure measures.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4635</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/LASI-DAD</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>Diagnostic Assessment of Dementia for the Longitudinal Aging Study in India</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Harmonized Diagnostic Assessment for the Longitudinal Aging Study in India</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Harmonized Diagnostic Assessment of Dementia for the Longitudinal Aging study in India</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LASI-DAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Longitudinal Aging Study in India-Diagnostic Assessment of Dementia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Harmonized Diagnostic Assessment of Dementia for the Longitudinal Aging Study in India</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22255">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001627"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002645"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22255"/>
        <obo:IAO_0000116>dementia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12497661/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>LASI-DAD is a representative subsample of LASI that has a focus on cognitive aging and dementia among persons aged 60 and over in India, with an oversampling of those at a higher risk of cognitive impairment.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002645"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/India"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39482079+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 4635 participants were recruited between 2022 and 2024 from 22 states and union territories of India, accounting for 97.9% of the population in India.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002645"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40838581</owl:annotatedTarget>
