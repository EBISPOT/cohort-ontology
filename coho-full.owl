    <!-- http://www.ebi.ac.uk/coho/COHO_0000756 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000756">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid6835"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90301675</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of 4,814 adults aged 45–75 randomly selected from the resident registries of Bochum, Essen and Mülheim an der Ruhr in the Ruhr area of Germany, examined in 2000–2003 and followed up repeatedly, set up to evaluate coronary artery calcification measured by electron-beam CT for predicting myocardial infarction and cardiac death beyond traditional risk factors.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4814</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HNR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HNR study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Heinz-Nixdorf Recall study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Heinz Nixdorf Recall Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid6835">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005068"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000756"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid6835"/>
        <obo:IAO_0000116>myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The initial aim of the HNR study was to evaluate the predictive value of coronary artery calcification using electron beam CT for myocardial infarction and cardiac death besides traditional cardiovascular risk factors (see Schmermund et al16).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000756"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the study participants, aged 45–75, were randomly selected from the residents’ registration offices of the cities of Bochum, Essen and Mülheim an der Ruhr, Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000756"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90301675</owl:annotatedTarget>
        <dcterms:title>Association of CLEC16A with human common variable immunodeficiency disorder and role in murine B cells.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25891430</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4444044/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>1,500 German controls were recruited from the population-based epidemiological Heinz-Nixdorf Recall (HNR) study and genotyped at the Life and Brain Center at the University Clinic Bonn.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000756"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of 4,814 adults aged 45–75 randomly selected from the resident registries of Bochum, Essen and Mülheim an der Ruhr in the Ruhr area of Germany, examined in 2000–2003 and followed up repeatedly, set up to evaluate coronary artery calcification measured by electron-beam CT for predicting myocardial infarction and cardiac death beyond traditional risk factors.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000756"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4814</owl:annotatedTarget>
        <obo:IAO_0000116>participants aged 45-75 at the baseline examination 2000-2003</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>N=4814 participants aged 45–75 years were included in the baseline examination (T0) between 2000 and 2003 (recruitment rate: 55.8%).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000756"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HNR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000757 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000757">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid6842"/>
