    <!-- http://www.ebi.ac.uk/coho/COHO_0002056 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002056">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17945"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:34607834</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of patients of Kaiser Permanente Northern California, United States, established with funding from GlaxoSmithKline in collaboration with the University of California San Francisco and Kaiser Permanente Northern California for a genome-wide association study of extreme responders to metformin: patients who met the study criteria were invited, gave blood samples for genotyping, and had their drug response taken from the electronic health record. Its participants with type 2 diabetes who had a sulfonylurea added to initial metformin therapy formed one of the data sets of the MetGen Plus and DIRECT genome-wide meta-analysis of glycaemic response to sulfonylureas.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">434</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>METRO</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Metformin Response cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17945">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002056"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17945"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8669535/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Included participants had a clinical diagnosis of type 2 diabetes and were treated with sulfonylureas as monotherapy or as an add-on to metformin.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002056"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://ndownloader.figshare.com/files/30717650</oboInOwl:hasDbXref>
        <rdfs:comment>The patients from Kaiser Permanente 2 Northern California (KPNC), who met the study criteria (see https://www.gsk-studyregister.com/en/trial- details/?id=207926) were invited to participate.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002056"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34607834</owl:annotatedTarget>
        <dcterms:title>Genome-Wide Meta-analysis Identifies Genetic Variants Associated With Glycemic Response to Sulfonylureas.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34607834</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8669535/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>who completed imputation for the Metformin Response (METRO) cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002056"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of patients of Kaiser Permanente Northern California, United States, established with funding from GlaxoSmithKline in collaboration with the University of California San Francisco and Kaiser Permanente Northern California for a genome-wide association study of extreme responders to metformin: patients who met the study criteria were invited, gave blood samples for genotyping, and had their drug response taken from the electronic health record. Its participants with type 2 diabetes who had a sulfonylurea added to initial metformin therapy formed one of the data sets of the MetGen Plus and DIRECT genome-wide meta-analysis of glycaemic response to sulfonylureas.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34607834</obo:IAO_0000119>
