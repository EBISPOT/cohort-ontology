        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2756173/</oboInOwl:hasDbXref>
        <rdfs:comment>recruited women aged 35–64 years old diagnosed with invasive breast cancer between 1994–1998 from five metropolitan areas: Atlanta, Detroit, Los Angeles, Philadelphia, and Seattle.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000110"/>
