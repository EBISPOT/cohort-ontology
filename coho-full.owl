    <!-- http://www.ebi.ac.uk/coho/COHO_0002279 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002279">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19473"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002231"/>
        <obo:IAO_0000112>PMID:20339536</obo:IAO_0000112>
        <obo:IAO_0000115>An investigator-initiated, multicentre, community-based trial in office-based practices in the United States that from February to December 2000 evaluated the effect of pravastatin 40 mg/d on C-reactive protein: men and women with no prior cardiovascular disease (the primary prevention cohort) were randomly assigned, double-blind, to pravastatin or placebo for 24 weeks, and patients with known cardiovascular disease (the secondary prevention cohort) received open-label pravastatin, with lipid profiles and high-sensitivity C-reactive protein measured at baseline, 12 and 24 weeks. DNA collected from participants was later used in genome-wide studies of the lipid-lowering response to statins.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1536</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PRINCE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PRavastatin Inflammation CRP Evaluation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pravastatin Inflammation CRP Evaluation study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pravastatin Inflammation/CRP Evaluation Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pravastatin/Inflammation CRP Evaluation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pravastatin inflammation CRP evaluation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pravastatin inflammation/CRP evaluation</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Pravastatin Inflammation/CRP Evaluation</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19473">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002279"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19473"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11434828+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Community-based, prospective, randomized, double-blind trial including 1702 men and women with no prior history of cardiovascular disease (primary prevention cohort) and open-label study including 1182 patients with known cardiovascular disease (secondary prevention cohort) who provided at least baseline and 12-week blood samples.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002279"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11434828+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The study was conducted in US office-based practices from February to December 2000.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002279"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20339536</owl:annotatedTarget>
        <dcterms:title>Genome-wide association of lipid-lowering response to statins in combined study populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20339536</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2842298/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>DNA samples were collected from 1536 PRINCE participants including 1362 that were self-identified as Caucasian [22].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002279"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An investigator-initiated, multicentre, community-based trial in office-based practices in the United States that from February to December 2000 evaluated the effect of pravastatin 40 mg/d on C-reactive protein: men and women with no prior cardiovascular disease (the primary prevention cohort) were randomly assigned, double-blind, to pravastatin or placebo for 24 weeks, and patients with known cardiovascular disease (the secondary prevention cohort) received open-label pravastatin, with lipid profiles and high-sensitivity C-reactive protein measured at baseline, 12 and 24 weeks. DNA collected from participants was later used in genome-wide studies of the lipid-lowering response to statins.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11376301</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:11434828</obo:IAO_0000119>
