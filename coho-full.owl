        <obo:IAO_0000112>GCST90243993</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of colon cancer in women in Los Angeles County, United States, comprising 831 English-speaking women aged 55–74 years diagnosed with primary colon cancer from 1998 to 2002, identified through the Los Angeles County Cancer Surveillance Program (a SEER registry), and 755 race/ethnicity- and age-matched neighbourhood control women, with in-person interviews on hormone use, reproductive history and lifestyle and blood samples, set up to study menopausal hormone therapy and colon cancer risk.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym USC also denotes Los Angeles County Case-Control Studies of Ovarian Cancer (COHO:0001988); this term is University of Southern California Hormone Replacement Therapy Colorectal Cancer Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">831</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">755</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>USC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>USC-HRT-CRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>USC_HRT_CRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">University of Southern California Hormone Replacement Therapy Colorectal Cancer Study</rdfs:label>
    </owl:NamedIndividual>
