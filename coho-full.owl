    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000818">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid7423"/>
