    <!-- http://www.ebi.ac.uk/coho/COHO_0002129 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002129">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18509"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001678"/>
        <obo:IAO_0000112>PMID:22286212</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based series of patients with Hodgkin lymphoma diagnosed in the northern Netherlands between 1987 and 2009, whose tumours were classified by WHO criteria and Epstein-Barr virus status and whose germline DNA, with that of first-degree relatives of patients diagnosed up to 2000, was used to study HLA associations with Epstein-Barr virus-positive and -negative Hodgkin lymphoma; its classical Hodgkin lymphoma cases were one of the five case series of the European genome-wide association study of classical Hodgkin lymphoma.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200</coho:numberOfCases>
        <oboInOwl:hasRelatedSynonym>NDHLS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Northern Dutch Hodgkin Lymphoma Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18509">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004952"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002129"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18509"/>
        <obo:IAO_0000116>Hodgkin lymphoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15978930+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Germline DNA was isolated from 200 patients diagnosed between 1987 and 2000 and from their first-degree relatives.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002129"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3274508/</oboInOwl:hasDbXref>
        <rdfs:comment>the Northern Dutch Hodgkin Lymphoma Study comprises a population-based case patient series of HL diagnosed in Northern Netherlands between January 1987 and April 2009 (8).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002129"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22286212</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of classical Hodgkin lymphoma and Epstein-Barr virus status-defined subgroups.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22286212</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3274508/</oboInOwl:hasDbXref>
        <rdfs:comment>Genome-wide genotyping was performed on cHL case samples from five European-based HL studies: the EPILYMPH Study, the Scotland and Newcastle Lymphoma Group, the Young Adult Hodgkin’s Disease Case–Control Study, the Scandinavian Lymphoma Etiology Study, and the Northern Dutch Hodgkin Lymphoma Study (Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002129"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based series of patients with Hodgkin lymphoma diagnosed in the northern Netherlands between 1987 and 2009, whose tumours were classified by WHO criteria and Epstein-Barr virus status and whose germline DNA, with that of first-degree relatives of patients diagnosed up to 2000, was used to study HLA associations with Epstein-Barr virus-positive and -negative Hodgkin lymphoma; its classical Hodgkin lymphoma cases were one of the five case series of the European genome-wide association study of classical Hodgkin lymphoma.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15978930</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22286212</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24920014</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002129"/>
