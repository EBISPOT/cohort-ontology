    <!-- http://www.ebi.ac.uk/coho/COHO_0001411 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001411">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000388"/>
        <obo:IAO_0000112>GCST90502757</obo:IAO_0000112>
        <obo:IAO_0000115>An ancillary study of the Hispanic Community Health Study/Study of Latinos that in 2012–2014 enrolled Hispanic/Latino children aged 8–16 whose parents or legal guardians took part in HCHS/SOL, at its field centres in the Bronx, Chicago, Miami and San Diego, United States, to examine how youth&apos;s lifestyle behaviours and cardiometabolic risk factors relate to acculturation, parenting and family behaviours, and psychosocial functioning.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1466</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SOL Youth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SOLYouth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study of Latino Youth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study of Latino Youth Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hispanic Community Children&apos;s Health Study/Study of Latino Youth</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001411"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24120345+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This article describes the design and methodology of the Study of Latino Youth (SOL Youth) study, a multicenter study of Hispanic/Latino children living in the United States.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001411"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000388"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11875162/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Hispanic Community Children’s Health Study/Study of Latino Youth (SOL Youth) cohort is an ancillary study of the Hispanic Community Health Study/Study of Latinos (HCHS/SOL) that recruited n = 1,466 children aged 8–16 years between 2012 and 2014 whose parents/legal guardians participated in the HCHS/SOL at one of four field centers (Chicago, Bronx, San Diego, and Miami).33 A total of n = 1,073 children were included in GWAS analyses (mean age = 12.00 years).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001411"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90502757</owl:annotatedTarget>
        <dcterms:title>Trans-ancestry genome-wide association study of childhood body mass index identifies novel loci and age-specific effects.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39885687</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11875162/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Hispanic Community Children’s Health Study/Study of Latino Youth (SOL Youth) cohort is an ancillary study of the Hispanic Community Health Study/Study of Latinos (HCHS/SOL) that recruited n = 1,466 children aged 8–16 years between 2012 and 2014 whose parents/legal guardians participated in the HCHS/SOL at one of four field centers (Chicago, Bronx, San Diego, and Miami).33 A total of n = 1,073 children were included in GWAS analyses (mean age = 12.00 years).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001411"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ancillary study of the Hispanic Community Health Study/Study of Latinos that in 2012–2014 enrolled Hispanic/Latino children aged 8–16 whose parents or legal guardians took part in HCHS/SOL, at its field centres in the Bronx, Chicago, Miami and San Diego, United States, to examine how youth&apos;s lifestyle behaviours and cardiometabolic risk factors relate to acculturation, parenting and family behaviours, and psychosocial functioning.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24120345</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39885687</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41294090</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001411"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1466</owl:annotatedTarget>
        <obo:IAO_0000116>youth aged 8-16 enrolled 2012-2014</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:41294090</oboInOwl:hasDbXref>
        <rdfs:comment>Between 2012 and 2014, SOL Youth enrolled 1466 youth aged 8 to 16 years living in the household of a parent/caregiver who were participants in HCHS/SOL.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001411"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SOL Youth</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
