    <!-- http://www.ebi.ac.uk/coho/COHO_0002390 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002390">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20282"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sri_Lanka"/>
        <obo:IAO_0000112>PMID:21874001</obo:IAO_0000112>
        <obo:IAO_0000115>A Sri Lankan type 2 diabetes case-control study whose cases came mostly from the Sri Lankan Young Diabetes Study of patients with early-onset diabetes recruited from the three largest hospitals in Sri Lanka, augmented with diabetes cases from the Sri Lankan Diabetes Cardiovascular Study, and whose controls were participants in the Sri Lankan Diabetes Cardiovascular Study, a cross-sectional nationally representative epidemiological investigation.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1066</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1576</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>SLDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sri Lankan Diabetes Studies</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Sri Lankan Diabetes Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20282">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002390"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20282"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.921/MediaObjects/41588_2011_BFng921_MOESM16_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>T2D cases were mostly derived from the Sri Lankan Young Diabetes Study (SLYDS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002390"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sri_Lanka"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.921/MediaObjects/41588_2011_BFng921_MOESM16_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 992 patients with early onset diabetes (42.1% male) were recruited from the three largest hospitals in Sri Lanka in 2005-2006.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002390"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21874001</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study in individuals of South Asian ancestry identifies six new type 2 diabetes susceptibility loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21874001</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3773920/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Replication testing amongst South Asians was carried out amongst 13,170 T2D cases and 25,398 controls participants from the following studies: the Chennai Urban Rural Epidemiology Study (CURES) the COBRA study the Diabetes Genetics in Pakistan (DGP) and UK Asian Diabetes Study (UKADS), the Mauritius study, the Ragama Health Study (RHS), the Sikh Diabetes Study (SDS), the Singapore Consortium of Cohort Studies (SCCS), the Sri Lankan Diabetes Study (SLDS), and the LOLIPOP and PROMIS studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002390"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Sri Lankan type 2 diabetes case-control study whose cases came mostly from the Sri Lankan Young Diabetes Study of patients with early-onset diabetes recruited from the three largest hospitals in Sri Lanka, augmented with diabetes cases from the Sri Lankan Diabetes Cardiovascular Study, and whose controls were participants in the Sri Lankan Diabetes Cardiovascular Study, a cross-sectional nationally representative epidemiological investigation.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21874001</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.921/MediaObjects/41588_2011_BFng921_MOESM16_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002390"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1066</owl:annotatedTarget>
        <obo:IAO_0000116>Combined SLDS type 2 diabetes cases and SLDCS-derived controls available for genotyping</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.921/MediaObjects/41588_2011_BFng921_MOESM16_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Additional exclusion criteria were applied to the combined cases set (GADA ≥ 14units/ml, age ≥80 years, and missing sex information) to generate a total of 1066 cases available for genotyping.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002390"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1576</owl:annotatedTarget>
        <obo:IAO_0000116>Combined SLDS type 2 diabetes cases and SLDCS-derived controls available for genotyping</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.921/MediaObjects/41588_2011_BFng921_MOESM16_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>DNA collection was only initiated midway through the SLDCS collection, limiting the number of control samples available for genotyping to 1576.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002390"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SLDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002391 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002391">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20290"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:30326636</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal observational cohort study of systemic lupus erythematosus among the Gullah African Americans of the Sea Island region of South Carolina, United States, run from the Medical University of South Carolina, which enrols self-identified Gullah patients with lupus meeting the American College of Rheumatology classification criteria, their relatives, and unrelated unaffected Gullah controls, to study the genetic and environmental factors that contribute to lupus in this population. It is one of the community-engaged Sea Island Families Project studies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">605</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SLE in Gullah Health</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SLE in Gullah Health Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SLE in Gullah Health study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SLEIGH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Systemic Lupus Erythematosus in Gullah Health study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Systemic Lupus Erythematosus in Gullah Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20290">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007915"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002391"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20290"/>
        <obo:IAO_0000116>systemic lupus erythematosus</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3658981/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Sea Island Gullah African American population enrolled in the SLE in Gullah Health (SLEIGH) study, an established cohort of African American patients with SLE, is an ideal cohort for defining genetic and environmental risk factors for SLE because of their genetic homogeneity with very low non-African genetic admixture and preserved family unit.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002391"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8286328/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All self‐identified Gullah African American participants and their parents were born and raised in the Sea Islands region of South Carolina, or South Carolina low country (along the coastal border and 30 miles inland).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002391"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:30326636</owl:annotatedTarget>
        <dcterms:title>An Analytic Approach Using Candidate Gene Selection and Logic Forest to Identify Gene by Environment Interactions (G × E) for Systemic Lupus Erythematosus in African Americans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30326636</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6211136/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SLE study used a case control design, and subjects were selected from people participating in the SLE in Gullah Health (SLEIGH) Study, which began recruitment in 2003</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002391"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal observational cohort study of systemic lupus erythematosus among the Gullah African Americans of the Sea Island region of South Carolina, United States, run from the Medical University of South Carolina, which enrols self-identified Gullah patients with lupus meeting the American College of Rheumatology classification criteria, their relatives, and unrelated unaffected Gullah controls, to study the genetic and environmental factors that contribute to lupus in this population. It is one of the community-engaged Sea Island Families Project studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18438839</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22031537</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30326636</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34008864</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002391"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">605</owl:annotatedTarget>
        <obo:IAO_0000116>individuals in the SLEIGH cohort (lupus patients, relatives and unrelated controls) at the time of the quality-of-life study published in 2011</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3535475/</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 605 total individuals in the SLEIGH cohort, 128 female subjects (91 cases and 37 related controls) attempted the SF-36 with 96 completing the SF-36.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002391"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SLEIGH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002392 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002392">
