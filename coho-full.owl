        <rdfs:label xml:lang="en">obsolete Leiden University Medical Center</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002023 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002023">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002024"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. LW is the Lutherstadt Wittenberg study of the deCODE bladder cancer GWAS (PMID:21750109), the Lutherstadt Wittenberg Bladder Cancer Study. Replaced by COHO:0002024 (Lutherstadt Wittenberg Bladder Cancer Study), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete The Lutherstadt Wittenberg study</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
