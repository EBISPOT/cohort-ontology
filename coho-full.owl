    <!-- http://www.ebi.ac.uk/coho/COHO_0002185 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002185">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18814"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:20372189</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based study of the genetics of asthma in Nottingham, United Kingdom, whose families were recruited on the basis of pairs of siblings affected by asthma and were used in association studies of candidate genes with atopy; its index cases, children with asthma of European ancestry, later served as childhood asthma cases in a genetic study of the 17q21 asthma locus.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NSPA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nottingham sib pair asthma study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Nottingham Sib Pair Asthma study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18814">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002185"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18814"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12189166+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Association analysis in families recruited on the basis of affected sib pairs for asthma reveal significant association for both coding region polymorphisms with atopy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002185"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fejhg.2010.38/MediaObjects/41431_2010_BFejhg201038_MOESM31_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>United Kingdom: Asthmatic subjects and controls were selected from the Nottingham area from 3 study cohorts recruited over the period 1995-2008.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20372189</owl:annotatedTarget>
        <dcterms:title>A sequence variant on 17q21 is associated with age at onset and severity of asthma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20372189</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fejhg.2010.38/MediaObjects/41431_2010_BFejhg201038_MOESM31_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Childhood asthma cases (n=57) were included by using index cases from the Nottingham sib pair asthma study12 and additional adult asthma cases were recruited from an ongoing study of asthma severity (N=141).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family-based study of the genetics of asthma in Nottingham, United Kingdom, whose families were recruited on the basis of pairs of siblings affected by asthma and were used in association studies of candidate genes with atopy; its index cases, children with asthma of European ancestry, later served as childhood asthma cases in a genetic study of the 17q21 asthma locus.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:12189166</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20372189</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002185"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NSPA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002186 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002186">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. Checked 2026-09-23: The one id is used for two unrelated samples from the same health system, a CIMBA contributing centre and an active-surveillance prostate cancer series, neither with a study name. NSUHS is the PGS Catalog&apos;s id for NorthShore University HealthSystem, Evanston, Illinois, USA, as a site, used for two unrelated samples: (1) the BRCA1/BRCA2 pathogenic-variant carriers NorthShore contributed to CIMBA (CIMBA&apos;s code NORTHSHORE; PMID:32665703, 28346442), and (2) 432 prostate cancer patients of European ancestry on active surveillance at NorthShore, evaluated for a prostate cancer PRS together with Johns Hopkins patients (PMID:33956350, PSS001140). Neither sample has a study name or a design of its own beyond the institution (&apos;separate active surveillance studies conducted at ... NorthShore University HealthSystem&apos;), so the id denotes an institution, not a named cohort. The CIMBA carriers are covered by CIMBA (COHO:0000901). It is not the Polish Breast Cancer Study (COHO:0000930), which the triage matched only through a shared line of the ethics list. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete North Shore University Health System</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


