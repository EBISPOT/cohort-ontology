    <!-- http://www.ebi.ac.uk/coho/COHO_0002692 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002692">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:41047337</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of residents aged 40 to 74 years of 16 municipalities in seven prefectural areas of Japan, enrolled from 2011 to 2016 through a central office at the National Cancer Center and regional public health centres and universities as the successor to the Japan Public Health Center-based Prospective Study, with questionnaires and blood and urine samples, to identify risk factors for lifestyle-related diseases and factors that extend healthy life expectancy.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">115385</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>JPHC (Japan Public Health Center-based Prospective) Study and JPHC-NEXT Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>JPHC Study for the Next Generation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>JPHC-NEXT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>JPHC-NEXT Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Japan Public Health Center-based Prospective Study for the Next Generation</rdfs:label>
        <rdfs:seeAlso rdf:resource="http://epi.ncc.go.jp/en/jphc/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002692"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6908844/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The JPHC-NEXT is being conducted under a population-based cohort design in 16 municipalities of seven prefectural areas across Japan</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002692"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:41047337</owl:annotatedTarget>
        <dcterms:title>Association Between Women&apos;s Birth Weight and Reproductive Characteristics in Adulthood: The JPHC-NEXT Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41047337</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:41047337%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We used data from the Japan Public Health Center-based Prospective Study for the Next Generation (JPHC-NEXT), a population-based cohort in Japan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002692"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort of residents aged 40 to 74 years of 16 municipalities in seven prefectural areas of Japan, enrolled from 2011 to 2016 through a central office at the National Cancer Center and regional public health centres and universities as the successor to the Japan Public Health Center-based Prospective Study, with questionnaires and blood and urine samples, to identify risk factors for lifestyle-related diseases and factors that extend healthy life expectancy.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30713262</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002692"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">115385</owl:annotatedTarget>
        <obo:IAO_0000116>persons enrolled 2011-2016</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC6908844</oboInOwl:hasDbXref>
        <rdfs:comment>Results: As of December 31, 2016, we have established a population-based cohort of 115,385 persons (Response rate 44.1%), among whom 55,278 (47.9% of participants) have provided blood and urine samples.</rdfs:comment>
    </owl:Axiom>
