    <!-- http://www.ebi.ac.uk/coho/COHO_0000606 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000606">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid5413"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002430"/>
        <obo:IAO_0000112>GCST90091013</obo:IAO_0000112>
        <obo:IAO_0000115>A long-running programme of studies of type 2 diabetes and related chronic disease among Mexican Americans in Starr County, Texas, on the Texas-Mexico border, run from the University of Texas Health Science Center at Houston, which include a random sample of 14% of the county&apos;s population reported in 1983, type 2 diabetes case-control collections in 1987-2006, and a household survey of randomly selected blocks with examinations in 2002-2006 and re-examinations in 2010-2014, to study the prevalence, risk factors, genetics and complications of diabetes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5230</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>STARR COUNTY</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Starr</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Starr County</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Starr County Health Studies</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid5413">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000606"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid5413"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A6637993+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To assess the prevalence and morbidity of noninsulin-dependent diabetes mellitus among Mexican Americans, 14% of the Starr County, Texas, population (97% Mexican-American) was randomly sampled.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000606"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:27266869%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>Starr County, Texas, with its predominantly Mexican American population has been shown previously to bear a disproportionate burden of the major disease categories</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90091013</owl:annotatedTarget>
        <dcterms:title>Whole-genome association analyses of sleep-disordered breathing phenotypes in the NHLBI TOPMed program.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34446064</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Starr County Health Studies (Starr) investigates the risk factors for diabetes in Mexican-Americans [31, 32].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A long-running programme of studies of type 2 diabetes and related chronic disease among Mexican Americans in Starr County, Texas, on the Texas-Mexico border, run from the University of Texas Health Science Center at Houston, which include a random sample of 14% of the county&apos;s population reported in 1983, type 2 diabetes case-control collections in 1987-2006, and a household survey of randomly selected blocks with examinations in 2002-2006 and re-examinations in 2010-2014, to study the prevalence, risk factors, genetics and complications of diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21647700</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:6637993</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4897940/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8990175/supplementaryFiles</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000606"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5230</owl:annotatedTarget>
        <obo:IAO_0000116>individuals aged 20+ screened in the 2002-2006 household survey (one component of the programme)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4897940/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Household screening of 5230 individuals aged 20 years and above followed by direct physical assessment of 1610 identified 23.7 % of men and 26.7 % of women with type 2 diabetes, 46.2 and 49.5 % of men and women, respectively with obesity and 32.1 and 32.4 % with hypertension.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000606"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>STARR COUNTY</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000606"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Starr</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


