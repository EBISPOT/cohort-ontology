        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The study recruited pathologically confirmed lung cancer cases diagnosed at age 60 years or younger and family matched controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
