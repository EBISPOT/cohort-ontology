        <rdfs:comment>Consecutive patients referred for coronary angiography, classified as CAD/MI cases based on the coronary angiogram</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001487"/>
