        <obo:IAO_0000115>A population-based case-control study of epithelial ovarian cancer conducted in Montreal, Canada, from 2011 to 2016, in which women aged 18–79 who were Canadian citizens living in the greater Montreal area, with incident borderline or invasive epithelial cancer of the ovary, fallopian tube or peritoneum identified at seven Montreal hospitals, and controls sampled from the Quebec electoral list and frequency-matched to them by age and region of Montreal, were interviewed in person.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">498</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">908</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>PROVAQ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PRevention of OVArian Cancer in Quebec</oboInOwl:hasRelatedSynonym>
