        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002140 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002140">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18585"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>PMID:29494586</obo:IAO_0000112>
        <obo:IAO_0000115>A study initiated in 2011 that consecutively recruited, until 2017, patients undergoing total knee or hip replacement, largely for osteoarthritis, at St. Clare&apos;s Mercy Hospital and the Health Science Centre General Hospital in St. John&apos;s, Newfoundland and Labrador, Canada. It collects blood before surgery and follows the patients up after it, to identify genetic, epigenetic and biochemical markers for osteoarthritis.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1086</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NFOAS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Newfoundland Osteoarthritis Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18585">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005178"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002140"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18585"/>
        <obo:IAO_0000116>osteoarthritis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5849325/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The NFOAS recruited OA patients who underwent a total knee replacement surgery due to primary OA between November 2011 and December 2013 at the St. Clare’s Mercy Hospital and Health Science Centre General Hospital in St. John’s, the capital city of Newfoundland and Labrador (NL), Canada.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002140"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5849325/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The NFOAS recruited OA patients who underwent a total knee replacement surgery due to primary OA between November 2011 and December 2013 at the St. Clare’s Mercy Hospital and Health Science Centre General Hospital in St. John’s, the capital city of Newfoundland and Labrador (NL), Canada.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002140"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29494586</owl:annotatedTarget>
        <dcterms:title>An evolutionary learning and network approach to identifying key metabolites for osteoarthritis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29494586</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5849325/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Applied to the Newfoundland Osteoarthritis Study (NFOAS) dataset, our methodology was able to identify nine key metabolites including some known osteoarthritis-associated metabolites and some novel metabolic markers that have never been reported before.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002140"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study initiated in 2011 that consecutively recruited, until 2017, patients undergoing total knee or hip replacement, largely for osteoarthritis, at St. Clare&apos;s Mercy Hospital and the Health Science Centre General Hospital in St. John&apos;s, Newfoundland and Labrador, Canada. It collects blood before surgery and follows the patients up after it, to identify genetic, epigenetic and biochemical markers for osteoarthritis.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29494586</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31743460</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40608839</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002140"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1086</owl:annotatedTarget>
        <obo:IAO_0000116>patients undergoing total knee or hip arthroplasty recruited November 2011 to February 2017 (2011-2017)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12225861/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study participants were derived from the Newfoundland Osteoarthritis Study (NFOAS) which recruited 1086 patients aged at least 20 years old who underwent total knee or hip arthroplasty largely due to osteoarthritis (OA) with a small number of patients due to other joint diseases between 30/11/2011 and 05/02/2017 in St. Clare’s Mercy Hospital and Health Science Centre General Hospital in St. John’s, Newfoundland and Labrador (NL), Canada [10].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002140"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NFOAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002141 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002141">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. NHMRC is Australia&apos;s National Health and Medical Research Council, and the Australian NHMRC program a funding programme: the bipolar disorder GWAS of PMID:21353194 credits it with the recruitment of its Australian sample. A funder, not a cohort. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Australian NHMRC program</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002142 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002142">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000456"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. NHS3 is the third Nurses&apos; Health Study case-control set of the colorectal cancer GWAS of PMID:29917119, beside HPFS3, not the Nurses&apos; Health Study 3 cohort begun in 2010, which could not have supplied its cases. The Catalog&apos;s name for it, Nurses Health Study III, names that other cohort and is not carried over. Replaced by COHO:0000456 (Nurses&apos; Health Study), which now carries this term&apos;s names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Nurses Health Study III</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002143 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002143">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South-Eastern_Asia"/>
        <obo:IAO_0000112>PMID:18599522</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based, cross-sectional survey conducted between September and November 1998 of Chinese, Malay and Asian Indian Singapore residents aged 18-69, based on the World Health Organization model for field surveys of diabetes and other noncommunicable diseases and the WHO MONICA protocol, with interviewer-administered questionnaires, anthropometric and blood pressure measurements and fasting blood samples.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4723</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>1998 Singapore National Health Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NHS98</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore National Health Survey</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">1998 Singapore National Health Survey</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002143"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2682664/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The reference population was 2.16 million Chinese, Malay, and Asian Indian Singapore residents aged between 18 and 69 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002143"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:18599522</owl:annotatedTarget>
        <dcterms:title>FTO variants are associated with obesity in the Chinese and Malay populations in Singapore.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:18599522</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2551698/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We examined associations between nine previously reported FTO single nucleotide polymorphisms (SNPs) with obesity, type 2 diabetes, and related traits in 4,298 participants (2,919 Chinese, 785 Malays, and 594 Asian Indians) from the 1998 Singapore National Health Survey (NHS98) and 2,996 Malays from the Singapore Malay Eye Study (SiMES).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002143"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based, cross-sectional survey conducted between September and November 1998 of Chinese, Malay and Asian Indian Singapore residents aged 18-69, based on the World Health Organization model for field surveys of diabetes and other noncommunicable diseases and the WHO MONICA protocol, with interviewer-administered questionnaires, anthropometric and blood pressure measurements and fasting blood samples.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18599522</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19252135</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002143"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4723</owl:annotatedTarget>
        <obo:IAO_0000116>participants of the 1998 survey</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2682664/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study used data from the cross-sectional population-based 1998 Singapore National Health Survey (NHS98; n = 4,723).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002143"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NHS98</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


