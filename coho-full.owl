        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001005828</oboInOwl:hasDbXref>
        <rdfs:comment>5 biology-based risk profiles could be reproduced in an independent cohort of DLBCL patients, from the PETAL trial.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000316"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of patients with diffuse large B-cell lymphoma treated in the German PETAL trial of PET-guided therapy, whose tumours were exome and shallow whole-genome sequenced to reproduce biology-based risk profiles.</owl:annotatedTarget>
        <obo:IAO_0000119>https://ega-archive.org/studies/EGAS00001005828</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000316"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">609</owl:annotatedTarget>
