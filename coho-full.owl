    <!-- http://www.ebi.ac.uk/coho/COHO_0001668 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001668">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14988"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:42231601</obo:IAO_0000112>
        <obo:IAO_0000115>The prospective registry study of the US Drug-Induced Liver Injury Network (DILIN), which the National Institute of Diabetes and Digestive and Kidney Diseases set up in 2003. Since September 2004 it has enrolled children aged 2 or over and adults referred to the network&apos;s clinical sites within 6 months of a suspected liver injury caused by a prescription or over-the-counter drug or a herbal or dietary supplement. Causality is adjudicated by expert review, clinical data and blood (DNA), serum and some tissue samples are collected, and confirmed cases are followed for at least 6 months, in order to study the clinical, genetic, environmental and immunological risk factors and the outcomes of drug-induced liver injury.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2622</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>A Multi-Center, Longitudinal Study of Drug-and CAM-Induced Liver Injury</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DILIN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DILIN - Prospective Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DILIN Prospective Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DILIN prospective study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Drug Induced Liver Injury Network</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Drug-Induced Liver Injury Network</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Drug-Induced Liver Injury Network Prospective Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14988">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005359"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001668"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14988"/>
        <obo:IAO_0000116>drug-induced liver injury</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3637941/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The DILIN study aims to do this by creating within 6 months of onset a registry and tissue bank from people who have experienced liver injury due to prescription and over-the-counter drugs as well as herbal products.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001668"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19132805+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>DILIN is a multicentre research network charged with improving our understanding of the aetiologies, risk factors and outcomes of DILI in the US.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001668"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42231601</owl:annotatedTarget>
        <dcterms:title>Liver Injury From Medications Used for Treating Inflammatory Bowel Disease: The Drug-Induced Liver Injury Network Experience.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42231601</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42231601+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Using the Drug-Induced Liver Injury Network (DILIN) prospective study, we evaluated definite, highly likely, or probable DILI attributed to IBD therapies, including use for non-IBD indications (but excluding corticosteroids).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001668"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The prospective registry study of the US Drug-Induced Liver Injury Network (DILIN), which the National Institute of Diabetes and Digestive and Kidney Diseases set up in 2003. Since September 2004 it has enrolled children aged 2 or over and adults referred to the network&apos;s clinical sites within 6 months of a suspected liver injury caused by a prescription or over-the-counter drug or a herbal or dietary supplement. Causality is adjudicated by expert review, clinical data and blood (DNA), serum and some tissue samples are collected, and confirmed cases are followed for at least 6 months, in order to study the clinical, genetic, environmental and immunological risk factors and the outcomes of drug-induced liver injury.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19132805</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT00345930</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001668"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2622</owl:annotatedTarget>
        <obo:IAO_0000116>participants with suspected DILI enrolled 2004-2024</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC12133418/</oboInOwl:hasDbXref>
        <rdfs:comment>Between 2004 and 2024, a total of 2622 participants with suspected DILI were enrolled in the DILIN prospective study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001668"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DILIN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001669 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001669">
