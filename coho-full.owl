    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002227"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42081549</owl:annotatedTarget>
        <dcterms:title>Genetic variants and polygenic risk scores associated with paroxysmal atrial fibrillation in the Japanese population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42081549</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13138623/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In total, 2,604 participants were enrolled between March 1, 2020 and December 31, 2021, including inpatients and outpatients from the Department of Cardiology of Tokyo Medical and Dental University Hospital, Jichi Medical University Hospital, Yokohama City Minato Red Cross Hospital, Jichi Medical University Saitama Medical Center, Yokosuka Kyosai Hospital, National Hospital Organization Disaster Medical Center, and Tsuchiura Kyodo General Hospital.</rdfs:comment>
