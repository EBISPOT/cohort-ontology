    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000955"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based incidence study of all acute vascular events in a defined population covered by nine primary care practices in Oxfordshire, United Kingdom, in which patients presenting with such events, including transient ischaemic attack and stroke, have been ascertained prospectively since 2002 and followed up.</owl:annotatedTarget>
