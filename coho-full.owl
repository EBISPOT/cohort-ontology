    <!-- http://www.ebi.ac.uk/coho/COHO_0002290 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002290">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19561"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000283"/>
        <obo:IAO_0000112>PGS000777</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33958783</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based longitudinal cohort of patients with idiopathic Parkinson&apos;s disease, recruited from neurology clinics of university and regional hospitals in the western Netherlands across strata of age at onset and disease duration and examined mainly at Leiden University Medical Center, who were assessed on a broad range of motor and non-motor features at baseline in 2003-2005 and annually for five years, to profile the clinical course of the disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">420</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PROPARK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PROPARK study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PROfiling PARKinson&apos;s disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Profiling Parkinson&apos;s disease study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SCOPA-PROPARK cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Profiling Parkinson&apos;s disease</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19561">
