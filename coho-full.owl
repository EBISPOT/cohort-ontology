        <oboInOwl:hasDbXref>PMID:38014556</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:38014556%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>1376 control subjects were selected from the reference population GenomeAsia, Phase 2.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000084"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of people from diverse population groups across Asia whose genomes are sequenced by the GenomeAsia 100K Project, to catalogue genetic variation, population structure, disease associations and founder effects and to support genetic analyses: a pilot phase sequenced people of population groups from countries across Asia, and a second phase (GenomeAsia Phase 2) added people recruited from the healthcare delivery systems of Pakistan, India and Bangladesh and from isolated South Asian population groups.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31802016</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37291107</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
