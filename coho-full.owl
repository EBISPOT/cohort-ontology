        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PRIDE_subset"/>
        <rdfs:label xml:lang="en">Study of Health in Pomerania</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
