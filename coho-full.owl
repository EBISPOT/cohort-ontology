    <!-- http://www.ebi.ac.uk/coho/COHO_0002546 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002546">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21472"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <obo:IAO_0000112>PGS000349</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:30646800</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing regional study at the university hospital of Verona, Italy, of adults from the Verona district who underwent coronary angiography, comprising patients with angiographically documented coronary artery disease and coronary artery disease-free subjects angiographed for other reasons (mainly valvular heart disease), with cross-sectional and prospective designs, to search for new risk factors for coronary artery disease and myocardial infarction.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">807</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">213</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1020</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>VHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Verona Heart Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Verona Heart Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21472">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005010"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002546"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21472"/>
        <obo:IAO_0000116>coronary artery disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6497332/</oboInOwl:hasDbXref>
        <rdfs:comment>The VHS is an ongoing survey that uses cross‐sectional and prospective designs aimed to search for new risk factors for CAD in patients using objective, angiographic documentation of their coronary vessels.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002546"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6497332/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The ethics committee of our institution (Azienda Ospedaliera Universitaria Integrata, Verona, Italy) approved the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000349</owl:annotatedTarget>
        <dcterms:title>Risk prediction for coronary heart disease by a genetic risk score - results from the Heinz Nixdorf Recall study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32912153</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:30646800</owl:annotatedTarget>
        <dcterms:title>Systematic Evaluation of Pleiotropy Identifies 6 Further Loci Associated With Coronary Artery Disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30646800</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6497332/</oboInOwl:hasDbXref>
        <rdfs:comment>The population for this study was selected from the cohort of the VHS (Verona Heart Study).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing regional study at the university hospital of Verona, Italy, of adults from the Verona district who underwent coronary angiography, comprising patients with angiographically documented coronary artery disease and coronary artery disease-free subjects angiographed for other reasons (mainly valvular heart disease), with cross-sectional and prospective designs, to search for new risk factors for coronary artery disease and myocardial infarction.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18253477</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30646800</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002546"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">807</owl:annotatedTarget>
        <obo:IAO_0000116>VHS patients with prospective data in the 2019 study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6497332/</oboInOwl:hasDbXref>
        <rdfs:comment>On the basis of an angiographic evaluation, the patients were classified as CAD‐free (n=213, individuals who underwent coronary angiography for reasons other than suspected CAD, primarily valvular heart disease) and patients with CAD (n=807 individuals with at least 1 of the major epicardial coronary arteries [left anterior descending, circumflex, and right] affected by ≥1 significant stenosis [≥50% lumen reduction]).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002546"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">213</owl:annotatedTarget>
        <obo:IAO_0000116>VHS patients with prospective data in the 2019 study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6497332/</oboInOwl:hasDbXref>
        <rdfs:comment>On the basis of an angiographic evaluation, the patients were classified as CAD‐free (n=213, individuals who underwent coronary angiography for reasons other than suspected CAD, primarily valvular heart disease) and patients with CAD (n=807 individuals with at least 1 of the major epicardial coronary arteries [left anterior descending, circumflex, and right] affected by ≥1 significant stenosis [≥50% lumen reduction]).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002546"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1020</owl:annotatedTarget>
        <obo:IAO_0000116>VHS patients with prospective data in the 2019 study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6497332/</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1020 patients (723 men and 297 women) who lived in the District of Verona and for whom prospective data were available were included in this study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002546"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>VHS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002547 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002547">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21482"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PGS000074</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:22634755</obo:IAO_0000112>
        <obo:IAO_0000115>A phase III, placebo-controlled randomized trial of the COX-2 inhibitor rofecoxib (Vioxx) in patients from throughout the United Kingdom who had undergone potentially curative surgery and completed adjuvant therapy for stage II or III colorectal cancer, testing whether rofecoxib reduced recurrence and improved survival; it was terminated early by the worldwide withdrawal of rofecoxib. Its patients, together with those of the QUASAR2 trial, form the VQ58 case series of colorectal cancer genome-wide association studies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2434</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>VICTOR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>VICTOR trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Vioxx in Colorectal Cancer Therapy: Definition of Optimal Regime</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21482">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005575"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002547"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21482"/>
        <obo:IAO_0000116>colorectal cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4747430/</oboInOwl:hasDbXref>
        <rdfs:comment>The VQ58 GWAS comprised 1,800 CRC cases from the UK-based VICTOR and QUASAR2 adjuvant chemotherapy clinical trials.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002547"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5098601/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In order to augment our ability to detect additional CRC loci, we have undertaken a further GWA analysis of a set of cases from the VICTOR and QUASAR2 clinical trials of adjuvant therapy in potentially curable colorectal carcinoma These trials recruited patients from throughout the United Kingdom.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002547"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000074</owl:annotatedTarget>
        <dcterms:title>Cross-cancer evaluation of polygenic risk scores for 16 cancer types in two large cohorts.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33579919</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002547"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22634755</owl:annotatedTarget>
        <dcterms:title>Common variation near CDKN1A, POLD3 and SHROOM2 influences colorectal cancer risk.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22634755</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4747430/</oboInOwl:hasDbXref>
        <rdfs:comment>The VQ58 GWAS comprised 1,800 CRC cases from the UK-based VICTOR and QUASAR2 adjuvant chemotherapy clinical trials.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002547"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A phase III, placebo-controlled randomized trial of the COX-2 inhibitor rofecoxib (Vioxx) in patients from throughout the United Kingdom who had undergone potentially curative surgery and completed adjuvant therapy for stage II or III colorectal cancer, testing whether rofecoxib reduced recurrence and improved survival; it was terminated early by the worldwide withdrawal of rofecoxib. Its patients, together with those of the QUASAR2 trial, form the VQ58 case series of colorectal cancer genome-wide association studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20837956</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20972440</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22634755</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24062397</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002547"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2434</owl:annotatedTarget>
        <obo:IAO_0000116>Patients entered into the VICTOR trial</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20837956+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Two thousand four hundred thirty-four patients were entered onto the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002547"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>VICTOR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002548 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002548">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. Checked 2026-09-23: The id is on the PGS Catalog&apos;s cohort reference list but has no released score, sample set or publication (REST record empty, no papers in cohort_papers.json), so there is no PGS paper to read. VIO is the PGS Catalog&apos;s reference-list entry for the Valencia Institute of Oncology (Fundación Instituto Valenciano de Oncología, Valencia, Spain), a cancer hospital. No released PGS score, sample set or publication uses it. The only literature under this name is clinical case series and affiliations of the institute&apos;s clinicians. Its melanoma patients appear in consortium genetics papers as part of the MelaNostrum Consortium (&apos;Spain (Valencia, Barcelona)&apos;), not as a named study. Nothing shows a defined, named collection behind the id, so the name denotes only the institution. Not a cohort. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Valencia Institute of Oncology</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002549 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002549">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21490"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001177"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000927"/>
        <obo:IAO_0000112>PGS000030</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:35396534</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing population-based cohort study initiated in 1985 in which all residents of Västerbotten County, Sweden, are invited to a health examination at ages 40, 50 and 60, with blood drawn for cryopreservation; one of the three sub-surveys of the Northern Sweden Health and Disease Study, used for nested case–control studies of cancer and cardiovascular disease and for evaluating polygenic risk scores.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">86242</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>VIP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>VIP study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Västerbotten Intervention Program</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Västerbotten Intervention Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21490">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002549"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21490"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8438896/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The programme was initiated in parts of the county in 1985 as a community-level and individual-level programme to reduce the morbidity and mortality from CVD in Northern Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002549"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8993880/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The VIP is an ongoing population-based cohort study initiated in 1985 in which all residents of Västerbotten County, Sweden, are invited to receive a health examination at ages 40, 50, and 60 with blood drawn for cryopreservation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002549"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000927"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12807872/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Northern Sweden Health and Disease Study (NSHDS) comprises three sub-surveys, the Västerbotten Intervention Program (VIP), the Northerns Sweden MONICA study and the Mammography Screening Program (MSP), whereof VIP and MONICA are actively recruiting.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002549"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000030</owl:annotatedTarget>
        <dcterms:title>Prostate cancer polygenic risk score and prediction of lethal prostate cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35396534</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002549"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:35396534</owl:annotatedTarget>
        <dcterms:title>Prostate cancer polygenic risk score and prediction of lethal prostate cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35396534</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8993880/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Herein, PRS for incident prostate cancer was evaluated in two population-based cohorts of unscreened middle-aged men linked to cancer and death registries: the Västerbotten Intervention Project (VIP) and the Malmö Diet and Cancer study (MDC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002549"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing population-based cohort study initiated in 1985 in which all residents of Västerbotten County, Sweden, are invited to a health examination at ages 40, 50 and 60, with blood drawn for cryopreservation; one of the three sub-surveys of the Northern Sweden Health and Disease Study, used for nested case–control studies of cancer and cardiovascular disease and for evaluating polygenic risk scores.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35396534</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41419686</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002549"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">86242</owl:annotatedTarget>
        <obo:IAO_0000116>individuals who had participated in the VIP health examinations since inception (2007)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:20339479</oboInOwl:hasDbXref>
        <rdfs:comment>Between inception through 2007, a total of 86,242 individuals have participated with almost 27,000 participating twice.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002549"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>VIP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002550 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002550">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21499"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
