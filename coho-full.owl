    <!-- http://www.ebi.ac.uk/coho/COHO_0000998 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000998">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid9105"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000985"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002374"/>
        <obo:IAO_0000112>GCST90258648</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, randomized, double-masked clinical trial of long-term inhaled treatment for mild to moderate asthma (budesonide, nedocromil or placebo, each with albuterol as needed) in children aged 5–12 years, who were enrolled in 1993–1995 at eight clinical centres in the United States and Canada and followed after the trial into adulthood, with a genetic ancillary study of the children and their parents.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CAMP also denotes MGH Cardiology and Metabolic Patient Cohort (COHO:0002061); this term is Childhood Asthma Management Program.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1041</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CAMP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Childhood Asthma Management Program</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9105">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9105"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8255344/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The CAMP was a randomized, placebo-controlled, four-year trial of inhaled anti-inflammatory therapy for mild-to-moderate persistent childhood asthma.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8255344/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects were recruited from 8 different North American cities: Albuquerque, Baltimore, Boston, Denver, San Diego, Seattle, St. Louis, and Toronto.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000998"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90258648</owl:annotatedTarget>
        <dcterms:title>Zinc finger protein 33B demonstrates sex interaction with atopy-related markers in childhood asthma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35953101</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35953101+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a genome-wide gene-by-sex interaction analysis for atopy-related markers using whole-genome sequencing data based on 889 trios from the Genetic Epidemiology of Asthma in Costa Rica Study (GACRS) and 284 trios from the Childhood Asthma Management Program (CAMP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000998"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre, randomized, double-masked clinical trial of long-term inhaled treatment for mild to moderate asthma (budesonide, nedocromil or placebo, each with albuterol as needed) in children aged 5–12 years, who were enrolled in 1993–1995 at eight clinical centres in the United States and Canada and followed after the trial into adulthood, with a genetic ancillary study of the children and their parents.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10027502</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34212545</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001726</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1041</owl:annotatedTarget>
        <obo:IAO_0000116>children aged 5-12 enrolled in the trial, 1993-1995</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8255344/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1,041 participants were enrolled in the trial between 1993 and 1995 at age 5–12 years; follow-up continued to 2012 when participants were aged 22–30 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000998"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CAMP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000999 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000999">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>PMID:21738479</obo:IAO_0000112>
        <obo:IAO_0000115>A network of cohorts of African ancestry and of other populations under-represented in genome-wide association studies, whose consortia meta-analyse the cohorts&apos; genome-wide data to find genetic variants for complex traits, such as white blood cell count, blood pressure and hypertension in African-ancestry cohorts (COGENT-BP) and kidney traits across diverse ancestries (COGENT-Kidney, established in 2014).</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16388</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>COGENT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COGENT Network</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Continental Origins and Genetic Epidemiology Network</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000999"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21738479</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of white blood cell count in 16,388 African Americans: the continental origins and genetic epidemiology network (COGENT).</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21738479</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3128101/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The subjects participating in the GWAS consisted of a total of 16,388 self-identified African-American individuals from 7 population-based cohorts (ARIC, CARDIA, JHS, WHI, HANDLS, Health ABC, and GeneSTAR) that belong to the Continental Origins and Genetic Epidemiology Network (COGENT).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000999"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A network of cohorts of African ancestry and of other populations under-represented in genome-wide association studies, whose consortia meta-analyse the cohorts&apos; genome-wide data to find genetic variants for complex traits, such as white blood cell count, blood pressure and hypertension in African-ancestry cohorts (COGENT-BP) and kidney traits across diverse ancestries (COGENT-Kidney, established in 2014).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21738479</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32571486</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000999"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16388</owl:annotatedTarget>
        <obo:IAO_0000116>African-American participants from 7 cohorts in the 2011 WBC count GWAS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:21738479</oboInOwl:hasDbXref>
        <rdfs:comment>In order to address this, we performed a large genome-wide association study (GWAS) of total WBC and cell subtype counts in 16,388 African-American participants from 7 population-based cohorts available in the Continental Origins and Genetic Epidemiology Network.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000999"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>COGENT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001000 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001000">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid9116"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001440"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001444"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90103973</obo:IAO_0000112>
        <obo:IAO_0000115>The cohort studies of the Center for Oral Health Research in Appalachia, established in 2000 by the University of Pittsburgh in partnership with West Virginia University to find the factors behind poor oral health in northern Appalachia. They are a family-based etiology study (COHRA1), which recruited households in West Virginia and western Pennsylvania, and a longitudinal cohort (COHRA2), which since 2011 has recruited pregnant women in Pennsylvania and West Virginia and followed them and their children.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>COHRA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Center for Oral Health Research in Appalachia</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9116">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006858"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9116"/>
        <obo:IAO_0000116>oral diseases</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2443132/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>An initial aim of COHRA is to determine the contributions of individual, family, and community factors to oral diseases in Appalachian children.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001440"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8297786/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For the current study, data from COHRA1 (a cohort of the Center for Oral Health Research in Appalachia) was analyzed.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001444"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4451284/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Center for Oral Health Research in Appalachia (COHRA) has been enrolling pregnant women and their babies since 2011 in the COHRA2 study of genetic, microbial, and environmental factors involved in oral health in Northern Appalachia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9378791/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Our second cohort (n = 1,837) comes from the Center for Oral Health Research in Appalachia (COHRA), which was designed to address oral health disparities in the Appalachian region in the USA.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001000"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90103973</owl:annotatedTarget>
        <dcterms:title>Genetic Analyses of Enamel Hypoplasia in Multiethnic Cohorts.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35172313</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9378791/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Our second cohort (n = 1,837) comes from the Center for Oral Health Research in Appalachia (COHRA), which was designed to address oral health disparities in the Appalachian region in the USA.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001000"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The cohort studies of the Center for Oral Health Research in Appalachia, established in 2000 by the University of Pittsburgh in partnership with West Virginia University to find the factors behind poor oral health in northern Appalachia. They are a family-based etiology study (COHRA1), which recruited households in West Virginia and western Pennsylvania, and a longitudinal cohort (COHRA2), which since 2011 has recruited pregnant women in Pennsylvania and West Virginia and followed them and their children.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18522740</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35172313</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36981009</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001000"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>COHRA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001001 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001001">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid9124"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
