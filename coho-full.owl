        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7695147/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 793 children from those recruited in the GENOBOX clinic cohort participated in this study after applying the inclusion and exclusion criteria.</rdfs:comment>
    </owl:Axiom>
