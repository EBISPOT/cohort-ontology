        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9426371/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In total, 1327 NP swab residuals were collected from 1049 individuals (736 positive and 313 negative, Fig. 1A and S2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002410"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
