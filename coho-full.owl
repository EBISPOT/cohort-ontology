    <!-- http://www.ebi.ac.uk/coho/COHO_0001675 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001675">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <obo:IAO_0000112>PMID:20881960</obo:IAO_0000112>
        <obo:IAO_0000115>Two case-control panels of self-described white adults sampled from the tails of the height distribution (the 5th to 10th and the 90th to 95th percentiles), one of European Americans born in the United States and one of people born in Poland, studied under the approval of the Institutional Review Board of Children&apos;s Hospital, Boston, and genotyped to validate variants associated with adult height.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3207</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>EAPEH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European American and Poland Extreme Height panels</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">European American and Polish height panels</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001675"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20881960</owl:annotatedTarget>
        <dcterms:title>Hundreds of variants clustered in genomic loci and biological pathways affect human height.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20881960</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature09410/MediaObjects/41586_2010_BFnature09410_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Association results for 33 SNPs selected randomly among the 180 SNPs that reached genome-wide significance (P=5x10-8 ) in the Stage 1 meta-analysis and genotyped in European American (N=2,181) and Poland (N=1,009) panels at tails of height distribution.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001675"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>Two case-control panels of self-described white adults sampled from the tails of the height distribution (the 5th to 10th and the 90th to 95th percentiles), one of European Americans born in the United States and one of people born in Poland, studied under the approval of the Institutional Review Board of Children&apos;s Hospital, Boston, and genotyped to validate variants associated with adult height.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17767157</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature09410/MediaObjects/41586_2010_BFnature09410_MOESM23_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001675"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3207</owl:annotatedTarget>
        <obo:IAO_0000116>combined extreme-height adult panels genotyped in the 2007 HMGA2 study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3086278/</oboInOwl:hasDbXref>
        <rdfs:comment>We genotyped an additional 29,098 individuals of European ancestry from five studies, including three population-based studies (15,167 adults and 6,827 children), a type 2 diabetes case-control set (3,897 adults) and a collection of 3,207 adults sampled from the near-extremes of the height distribution (the 5th to 10th and 90th to 95th percentiles; Supplementary Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001675"/>
