    <!-- http://www.ebi.ac.uk/coho/COHO_0002336 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002336">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19905"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000649"/>
        <obo:IAO_0000112>PMID:27039371</obo:IAO_0000112>
        <obo:IAO_0000115>A family study of Mexican Americans in San Antonio, Texas, United States, begun in 1991 as the San Antonio Family Diabetes Study to identify susceptibility genes for type 2 diabetes, which recruited low-income Mexican Americans with type 2 diabetes identified in the San Antonio Heart Study and their extended families, examined them repeatedly, and at its second recall added a gallbladder disease component and further families; with the San Antonio Family Heart Study it makes up the San Antonio Family Studies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">906</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SAFDGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SAFDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>San Antonio Family Diabetes Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>San Antonio Family Diabetes/Gallbladder study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">San Antonio Family Diabetes/Gallbladder Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19905">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002336"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19905"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16123354+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Evidence was previously reported of linkage to diabetes on 10q with suggestive evidence on 3p and 9p in a genome-wide scan of 440 individuals from 27 pedigrees ascertained through a single diabetic proband.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002336"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4145406/</oboInOwl:hasDbXref>
        <rdfs:comment>The GAW18 data set was drawn from T2D-GENES Project 2, a complex pedigree-based study designed to identify low-frequency or rare variants that influence susceptibility to type 2 diabetes using information from whole genome sequencing (WGS) of 1043 individuals from 20 Mexican American pedigrees enriched for type 2 diabetes from San Antonio, Texas.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002336"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000649"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4145406/</oboInOwl:hasDbXref>
        <rdfs:comment>These family data were obtained from two studies: the San Antonio Family Heart Study (SAFHS) and the San Antonio Family Diabetes/Gallbladder Study (SAFDGS), which are together referred to as the San Antonio Family Studies (SAFS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002336"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27039371</owl:annotatedTarget>
        <dcterms:title>GWAS and transcriptional analysis prioritize ITPR1 and CNTN4 for a serum uric acid 3p26 QTL in Mexican Americans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27039371</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4818944/</oboInOwl:hasDbXref>
        <rdfs:comment>As a follow up, we examined genome-wide single nucleotide polymorphism data in an extended cohort of 1281 Mexican Americans from multigenerational families of the San Antonio Family Heart Study and the San Antonio Family Diabetes/Gallbladder Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002336"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family study of Mexican Americans in San Antonio, Texas, United States, begun in 1991 as the San Antonio Family Diabetes Study to identify susceptibility genes for type 2 diabetes, which recruited low-income Mexican Americans with type 2 diabetes identified in the San Antonio Heart Study and their extended families, examined them repeatedly, and at its second recall added a gallbladder disease component and further families; with the San Antonio Family Heart Study it makes up the San Antonio Family Studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16123354</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:16400619</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25519314</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002336"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">906</owl:annotatedTarget>
        <obo:IAO_0000116>members of 39 extended Mexican American pedigrees after the study&apos;s expansion</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16123354+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Subsequently, the study was expanded to include 906 individuals from 39 extended Mexican-American pedigrees, two additional examination cycles approximately 5.3 and 7.6 years after baseline, and genotypes for a new set of genome-wide markers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002336"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SAFDGS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002336"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SAFDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002337 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002337">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19914"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000649"/>
        <obo:IAO_0000112>PGS005354</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:25519314</obo:IAO_0000112>
        <obo:IAO_0000115>A family study of Mexican Americans in San Antonio, Texas, begun in 1991, that recruited low-income Mexican Americans aged 40 to 60, selected at random without regard to disease from Mexican American census tracts, together with their extended families, and followed them with repeated examinations to study the genetic and environmental contributions to cardiovascular disease risk factors. With the San Antonio Family Diabetes/Gallbladder Study it makes up the San Antonio Family Studies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1236</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SAFHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The San Antonio Family Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">San Antonio Family Heart Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19914">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002337"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19914"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8901667+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Among Mexican Americans from San Antonio (Tex), we quantified the relative contributions of both genetic and environmental influences to a large panel of cardiovascular risk factors, including serum levels of lipids, lipoproteins, glucose, hormones, adiposity, and blood pressure.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002337"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4145406/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SAFHS began in 1991 with 40- to 60-year-old low-income Mexican Americans, selected at random without regard to presence or absence of disease, who were almost exclusively from Mexican American census tracts in San Antonio, Texas [1].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002337"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000649"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4145406/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>These family data were obtained from two studies: the San Antonio Family Heart Study (SAFHS) and the San Antonio Family Diabetes/Gallbladder Study (SAFDGS), which are together referred to as the San Antonio Family Studies (SAFS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002337"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005354</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry polygenic risk scores for the prediction of type 2 diabetes and complications in diverse ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40778152</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002337"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25519314</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry polygenic risk scores for the prediction of type 2 diabetes and complications in diverse ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25519314</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4145406/</oboInOwl:hasDbXref>
        <rdfs:comment>gene expression measures from the San Antonio Family Heart Study (not distributed as part of the GAW18 data) were used to identify genes whose mRNA levels were correlated with blood pressure.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002337"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family study of Mexican Americans in San Antonio, Texas, begun in 1991, that recruited low-income Mexican Americans aged 40 to 60, selected at random without regard to disease from Mexican American census tracts, together with their extended families, and followed them with repeated examinations to study the genetic and environmental contributions to cardiovascular disease risk factors. With the San Antonio Family Diabetes/Gallbladder Study it makes up the San Antonio Family Studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25519314</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:8901667</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002337"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1236</owl:annotatedTarget>
        <obo:IAO_0000116>Relatives of randomly ascertained probands and spouses in the original SAFHS report</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8901667+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Members of 42 extended families were studied, including 1236 first-, second-, and third-degree relatives of randomly ascertained probands and their spouses.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002337"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SAFHS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002338 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002338">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19923"/>
        <rdf:type rdf:nodeID="genid19925"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001419"/>
        <obo:IAO_0000112>PGS000037</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:29273806</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of children born in the province of Manitoba, Canada, in 1995, whose families were surveyed in 2002 about the child&apos;s health and home environment, with linkage to the child&apos;s health care records, and from which children with asthma or allergy and a random sample of children with neither were invited to a nested case-control study of the early-life genetic and environmental origins of asthma. It is one of the Canadian cohorts of the ALLERGEN consortium.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym SAGE also denotes Study of Addiction: Genetics and Environment (COHO:0000793) and Study of African Americans, Asthma, Genes and Environments (COHO:0000794); this term is Study of Asthma, Genes and the Environment.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16320</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Canadian Childhood Cohorts: Study of Asthma Genes and Environment</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SAGE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SAGE.AST</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study of Asthma Genes and Environment</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study of Asthma Genes and Environment Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study of Asthma, Genetics and Environment</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Study of Asthma, Genes and the Environment</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19923">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ExO_0000002"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid19925">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002338"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19923"/>
        <obo:IAO_0000116>home environmental exposures</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&amp;id=19416140&amp;retmode=xml</oboInOwl:hasDbXref>
        <rdfs:comment>Nested within the birth cohort is a case-control study, which was created to collect information on home environmental exposures from detailed surveys and home dust sampling</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002338"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19925"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&amp;id=19416140&amp;retmode=xml</oboInOwl:hasDbXref>
        <rdfs:comment>It is a general population-based cohort, composed of children at high and low risk for asthma, living in urban and rural environments in Manitoba, Canada.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002338"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Study of Asthma Genes and Environment Study (SAGE5 ) is a population‐based sample of 16,320 children, born in the province of Manitoba, Canada in the year of 1995.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002338"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000037</owl:annotatedTarget>
        <dcterms:title>Polygenic risk and the development and course of asthma: an analysis of data from a four-decade longitudinal study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24429243</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002338"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29273806</owl:annotatedTarget>
        <dcterms:title>Multiancestry association study identifies new asthma risk loci that colocalize with immune-cell enhancer marks.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29273806</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Study of Asthma Genes and Environment Study (SAGE5 ) is a population‐based sample of 16,320 children, born in the province of Manitoba, Canada in the year of 1995.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002338"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of children born in the province of Manitoba, Canada, in 1995, whose families were surveyed in 2002 about the child&apos;s health and home environment, with linkage to the child&apos;s health care records, and from which children with asthma or allergy and a random sample of children with neither were invited to a nested case-control study of the early-life genetic and environmental origins of asthma. It is one of the Canadian cohorts of the ALLERGEN consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002338"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">16320</owl:annotatedTarget>
        <obo:IAO_0000116>children born in Manitoba in 1995 (population-based birth cohort from administrative records), 1995 births</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Study of Asthma Genes and Environment Study (SAGE5 ) is a population‐based sample of 16,320 children, born in the province of Manitoba, Canada in the year of 1995.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002338"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SAGE</owl:annotatedTarget>
