        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Southern_Africa"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002697"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:27956187</obo:IAO_0000112>
        <obo:IAO_0000115>An open population cohort of all resident and non-resident members of households in a demographic and health surveillance area in the uMkhanyakude district of rural KwaZulu-Natal, South Africa, established in 2000 by the Africa Centre for Health and Population Studies (now the Africa Health Research Institute) and expanded and renamed the Population Intervention Platform in 2017, with repeated household surveillance and population-based HIV surveys, to describe the demographic, social and health impact of the HIV epidemic, and later of tuberculosis and non-communicable diseases, and to evaluate interventions.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">231179</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ACDIS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ACDIS cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AHRI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AHRI Population Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Africa Centre Demographic Information System and population-based HIV survey</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Africa Health Research Institute (AHRI) Population Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Africa Health Research Institute Population Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PIP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PIP cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Population Intervention Platform</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Population Intervention Programme</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Africa Centre Demographic Information System</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.ahri.org"/>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22722">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005109"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002694"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22722"/>
        <obo:IAO_0000116>HIV</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7938501/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The aim of ACDIS was to describe the demographic, social and health impacts of a rapidly progressing HIV epidemic in rural South Africa, and to monitor the impact of intervention strategies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002694"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Africa"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7938501/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The aim of ACDIS was to describe the demographic, social and health impacts of a rapidly progressing HIV epidemic in rural South Africa, and to monitor the impact of intervention strategies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002694"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27956187</owl:annotatedTarget>
        <dcterms:title>Trends in the burden of HIV mortality after roll-out of antiretroviral therapy in KwaZulu-Natal, South Africa: an observational community cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27956187</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:27956187%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Data come from the Africa Centre Demographic Information System (ACDIS), an observational community cohort study in the uMkhanyakude district in northern KwaZulu-Natal, South Africa.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002694"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An open population cohort of all resident and non-resident members of households in a demographic and health surveillance area in the uMkhanyakude district of rural KwaZulu-Natal, South Africa, established in 2000 by the Africa Centre for Health and Population Studies (now the Africa Health Research Institute) and expanded and renamed the Population Intervention Platform in 2017, with repeated household surveillance and population-based HIV surveys, to describe the demographic, social and health impact of the HIV epidemic, and later of tuberculosis and non-communicable diseases, and to evaluate interventions.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33437994</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002694"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">231179</owl:annotatedTarget>
        <obo:IAO_0000116>unique individuals who have participated since 2000 (ACDIS and its 2017 expansion, PIP), 2018</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:33437994</oboInOwl:hasDbXref>
        <rdfs:comment>Since 2000, 231 179 unique individuals have participated in the cohort, generating &gt;2 million person-years of follow-up.</rdfs:comment>
    </owl:Axiom>
