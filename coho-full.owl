        <obo:IAO_0000116>GEOS participants: first ischaemic stroke cases and stroke-free controls (2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3582818/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Characteristics of the 1737 GEOS study participants (830 cases - 43% African-American and 907 controls - 39% African-American) are summarized in Table 1.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001337"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
