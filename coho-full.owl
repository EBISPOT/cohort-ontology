    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000603"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42509442</owl:annotatedTarget>
        <dcterms:title>Validation of fracture-derived polygenic scores with FRAX for fracture risk prediction in postmenopausal women.</dcterms:title>
