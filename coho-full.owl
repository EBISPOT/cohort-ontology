        <obo:IAO_0000116>nutrition</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Originated from a monitoring study on cardiovascular disease risk factors, the Doetinchem Cohort study has been expanded to a study on lifestyle and other determinants of chronic conditions and ageing, with individual data covering 25 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000906"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Doetinchem Cohort Study is carried out by the Dutch National Institute for Public Health and the Environment.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000906"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90428625</owl:annotatedTarget>
        <dcterms:title>Circulating anti-Müllerian hormone levels in pre-menopausal women: novel genetic insights from a genome-wide association meta-analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38815977</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11759094/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>cardiovascular disease in women: results from the Doetinchem Cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000906"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort study in Doetinchem, the Netherlands, started by the Dutch National Institute for Public Health and the Environment (RIVM) as a monitoring study of cardiovascular risk factors, in which 12,404 inhabitants aged 20–59, drawn as an age- and sex-stratified sample of the population register, were examined in 1987–1991 and two-thirds of them were re-invited to repeated rounds, to study lifestyle and other determinants of health, functioning and chronic disease over the life course.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000906"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12404</owl:annotatedTarget>
        <obo:IAO_0000116>inhabitants examined at baseline, 1987-1991</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In 1987 it started with an age-sex-stratified sample (20–59 years) of the inhabitants of Doetinchem, a mid-size Dutch town, of whom 12 404 (62%) participated in the baseline examination between 1987 and 1991.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000906"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000906"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Doetinchem</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000906"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Doetinchem Cohort Studie</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000907 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000907">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid8293"/>
        <rdf:type rdf:nodeID="genid8295"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90095141</obo:IAO_0000112>
        <obo:IAO_0000115>A clinic-based case-control study of self-identified Latino children and young adults aged 8–22 years with and without asthma, recruited at centres in the mainland United States and Puerto Rico under the University of California, San Francisco, to study the genetic and environmental basis of childhood-onset asthma.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4157</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GALA II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GALA_II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genes- Environments &amp; Admixture in Latino Americans study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genes-environments &amp; Admixture in Latino Americans</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid8293">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid8295">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ExO_0000002"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000907"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8293"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8625344/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Cases were subjects with a physician diagnosis of asthma and manifestations of symptoms within the two years before recruitment, while controls were selected based on the absence of a medical history of asthma, allergic diseases, or other respiratory affections.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000907"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8295"/>
        <obo:IAO_0000116>environmental basis of childhood-onset asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8625344/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>GALA II and SAGE are two clinic-based case-control studies focused on untangling the genetic and environmental basis of childhood-onset asthma disease in minority ethnic groups of the United States of America [22].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000907"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8625344/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Recruitment was performed in different centers throughout mainland United States and Puerto Rico for GALA II subjects, while SAGE participants were recruited in the San Francisco Bay Area.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000907"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90095141</owl:annotatedTarget>
        <dcterms:title>Role of Sex on the Genetic Susceptibility to Childhood Asthma in Latinos and African Americans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34834492</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8625344/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The genetic role of sex on asthma susceptibility was assessed in the Genes-environments &amp; Admixture in Latino Americans (GALA II) and the Study of African Americans, Asthma, Genes, and Environments (SAGE) studies [22].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000907"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A clinic-based case-control study of self-identified Latino children and young adults aged 8–22 years with and without asthma, recruited at centres in the mainland United States and Puerto Rico under the University of California, San Francisco, to study the genetic and environmental basis of childhood-onset asthma.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34834492</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000907"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4157</owl:annotatedTarget>
        <obo:IAO_0000116>participants enrolled 2006-2011 (cases and controls)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3778732/</oboInOwl:hasDbXref>
        <rdfs:comment>Results The GALA II and SAGE II studies have enrolled 4,157 and 1,281 participants, respectively, from 2006 to 2011.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000907"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GALA II</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000907"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GALA_II</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


