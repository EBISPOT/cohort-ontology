    <!-- http://www.ebi.ac.uk/coho/COHO_0001478 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001478">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13358"/>
        <rdf:type rdf:nodeID="genid13360"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:31152163</obo:IAO_0000112>
        <obo:IAO_0000115>The Danish part of the European Rational Approach for the Genetics of Diabetic Complications (EURAGEDIC) study: a case–control sample of adults with type 1 diabetes attending the outpatient clinic of the Steno Diabetes Center, Denmark, recruited from 1993 to 2000, with diabetic nephropathy (cases) or with persistent normoalbuminuria after more than 15 years of diabetes (controls), whose blood samples and clinical data were collected to study genetic risk factors for diabetic nephropathy and who were followed prospectively for mortality and cardiovascular and renal outcomes.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">451</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">440</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">891</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AFTER (EURAGEDIC) European Rational Approach for the Genetics of Diabetic Complications</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AFTER EU study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AFTER-EU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AFTER_EU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AfterEU</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">AFTER EU</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13358">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005016"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid13360">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005147"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001478"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13358"/>
        <obo:IAO_0000116>diabetic nephropathy</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17704113+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Single nucleotide polymorphisms (SNPs) in candidate genes were tested for association with overt diabetic nephropathy (persistent albuminuria &gt;300 mg/24 h) in a large (n=2499) Type 1 diabetes case/control study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001478"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13360"/>
        <obo:IAO_0000116>type 1 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17704113+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Single nucleotide polymorphisms (SNPs) in candidate genes were tested for association with overt diabetic nephropathy (persistent albuminuria &gt;300 mg/24 h) in a large (n=2499) Type 1 diabetes case/control study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001478"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-019-0407-x/MediaObjects/41588_2019_407_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The AFTER EU study is the Danish part of the EURAGEDIC study which was supported by the European Commission (contract QLG2-CT-2001– 01669).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001478"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:31152163</owl:annotatedTarget>
        <dcterms:title>A catalog of genetic loci associated with kidney function from analyses of a million individuals.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31152163</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-019-0407-x/MediaObjects/41588_2019_407_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The AFTER EU study is the Danish part of the EURAGEDIC study which was supported by the European Commission (contract QLG2-CT-2001– 01669).</rdfs:comment>
