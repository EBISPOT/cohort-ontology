    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002483">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21080"/>
