        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002445"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family-based, population-based genetic cohort in Tehran, Iran, designed by the Research Institute for Endocrine Sciences in collaboration with deCODE genetics, that genotyped participants of the Tehran Lipid and Glucose Study genome-wide and links their genotypes to the behavioural, biochemical and clinical data collected since 1999, later extended to participants of four ongoing studies with periodic follow-up, to identify genetic factors in cardiometabolic risk factors, cancers and other non-communicable diseases.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28232301</obo:IAO_0000119>
