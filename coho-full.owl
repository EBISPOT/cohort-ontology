    <!-- http://www.ebi.ac.uk/coho/COHO_0001268 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001268">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11466"/>
        <rdf:type rdf:nodeID="genid11468"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Peru"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>GCST90271572</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of women admitted for obstetric care at seven hospitals in Lima, Peru, between March 2013 and December 2015, with cases of placental abruption and of preterm birth and controls selected at random from women delivering at the same hospitals, designed to investigate the genetic and environmental determinants of placental abruption and other adverse pregnancy outcomes.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym PAGE also denotes Psoriasis Association Genetics Extension (COHO:0000145), Parkinson&apos;s, Genes, and Environment Study (COHO:0002232) and Population Architecture using Genomics and Epidemiology Study (COHO:0002752); this term is Placental Abruption Genetic Epidemiology study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">933</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1279</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2212</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PAGE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PAGEPI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Placental Abruption Genetic Epidemiology</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Placental Abruption Genetic Epidemiology study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11466">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0001622"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid11468">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004846"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001268"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11466"/>
        <obo:IAO_0000116>preterm birth</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29884306+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Participants of the Placental Abruption Genetic Epidemiology (PAGE) study, a population based case-control study of PA conducted in Lima, Peru, were genotyped using the Illumina HumanCore-24 BeadChip platform.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001268"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11468"/>
        <obo:IAO_0000116>placental abruption</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29884306+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Participants of the Placental Abruption Genetic Epidemiology (PAGE) study, a population based case-control study of PA conducted in Lima, Peru, were genotyped using the Illumina HumanCore-24 BeadChip platform.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001268"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Peru"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5995331/</oboInOwl:hasDbXref>
        <rdfs:comment>Participants of the Placental Abruption Genetic Epidemiology (PAGE) study, a population based case-control study of PA conducted in Lima, Peru, were genotyped using the Illumina HumanCore-24 BeadChip platform.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001268"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90271572</owl:annotatedTarget>
        <dcterms:title>Genetic association study of preterm birth and gestational age in a population-based case-control study in Peru.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39302385</oboInOwl:hasDbXref>
