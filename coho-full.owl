        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">115</owl:annotatedTarget>
        <obo:IAO_0000116>pathology-confirmed rpAD cases identified at NPDPSC</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10984493/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We identified 115 pathology‐confirmed cases of rpAD in NPDPSC.</rdfs:comment>
    </owl:Axiom>
