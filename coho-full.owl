        <obo:IAO_0000115>A hypersensitivity reaction type II disease that involves the alimentary part of gastrointestinal system.</obo:IAO_0000115>
        <rdfs:label>autoimmune disorder of gastrointestinal tract</rdfs:label>
    </owl:Class>
    


