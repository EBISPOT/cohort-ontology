    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002666">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>PMID:33952246</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective birth cohort of babies born at the University Hospital of the University of São Paulo School of Medicine between April 2012 and March 2014 to mothers living in the Butantã-Jaguaré area of São Paulo&apos;s Western Region, Brazil, followed to study how social and environmental factors, including toxic stress, affect early childhood development in a low-income urban setting.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6207</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ROC</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>ROC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ROC-Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Região Oeste Coorte</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>São Paulo Western Region Birth Cohort (ROC)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Western Region Birth Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">São Paulo Western Region Birth Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002666"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8097258/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study was conducted in the municipality of São Paulo, Brazil.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002666"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33952246</owl:annotatedTarget>
        <dcterms:title>Associations between neighborhood violence during pregnancy and birth outcomes: evidence from São Paulo&apos;s Western Region Birth Cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33952246</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33952246+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Using geocoded birth records from the ongoing Western Region Birth Cohort (Região Oeste Coorte - ROC-Cohort) of infants born between 2012 and 2014 and geocoded crime reports, we assessed the associations between exposure to violent crimes during pregnancy within a 1-km radius of the mother&apos;s residence and low birth weight, preterm delivery, and being born small-for-gestational-age.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002666"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective birth cohort of babies born at the University Hospital of the University of São Paulo School of Medicine between April 2012 and March 2014 to mothers living in the Butantã-Jaguaré area of São Paulo&apos;s Western Region, Brazil, followed to study how social and environmental factors, including toxic stress, affect early childhood development in a low-income urban setting.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33952246</obo:IAO_0000119>
        <obo:IAO_0000119>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ROC</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002666"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6207</owl:annotatedTarget>
        <obo:IAO_0000116>mother-child pairs enrolled (births April 2012 - March 2014), 2012-2014</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:33952246</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 7066 births occurred in the period, and 6207 mother-child pairs who resided in the studied setting were enrolled in the cohort.</rdfs:comment>
    </owl:Axiom>
