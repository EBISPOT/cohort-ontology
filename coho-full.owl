        <rdfs:comment>| 10 | MoMaTEC | Molecular Markers in Treatment of Endometrial Cancer | Norway; population based cases | Norway; female blood donors | Illumina Infinium iSelect | 599 | 505</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001316"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
