        <oboInOwl:hasRelatedSynonym>CEPH Utah residents with ancestry from northern and western Europe</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CEU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Hap Map CEU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HapMap CEU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Utah residents (CEPH) with Northern and Western European ancestry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000637"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
