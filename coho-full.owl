    <!-- http://www.ebi.ac.uk/coho/COHO_0001820 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001820">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16252"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS005200</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:26231842</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective multicentre observational study at seven hospitals and practices in Pennsylvania, Georgia, Massachusetts and Ohio of adults with a left ventricular ejection fraction of 30% or less who had received a new implantable cardioverter-defibrillator or an ICD generator change within the previous five years, followed yearly for up to five years for appropriate ICD shocks and for death, heart transplant or ventricular assist device placement, with blood drawn at enrolment to relate genetic polymorphisms to these outcomes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1808</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GRADE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GRADE Multicenter Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Genetic Risk Assessment of Defibrillator Events</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16252">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0025169"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001820"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16252"/>
        <obo:IAO_0000116>LV systolic dysfunction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4599449/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Second, patients recruited into the GRADE study all had an LVEF ≤30%, and therefore these results cannot be extrapolated to patients with lesser degrees of LV systolic dysfunction.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001820"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4599449/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Enrolling centers were the University of Pittsburgh Medical Center, the Pittsburgh VA Healthcare System, Emory University Hospitals, Atlanta VA Medical Center, Massachusetts General Hospital, Mid-Ohio Cardiology Group, and the Ohio State Medical Center.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001820"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
