        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">743</owl:annotatedTarget>
        <obo:IAO_0000116>unrelated volunteers analysed in the 2017 head-hair shape GWAS (analysed subset)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5886212/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>US sample consists of 743 unrelated volunteers (498 females, 245 males) recruited in the USA, who were of European (98%), and non-European ancestry (2% South American/South Asian/Middle Eastern).</rdfs:comment>
    </owl:Axiom>
