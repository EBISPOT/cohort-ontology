        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001033"/>
        <obo:IAO_0000112>GCST90094651</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of breast cancer conducted in the Philadelphia and Detroit metropolitan areas of the United States from 1999 to 2003, whose cases, diagnosed with invasive ductal breast cancer within 18 months of recruitment and over-sampled for diagnosis before age 40, were identified in the University of Pennsylvania Health System and the Karmanos Cancer Institute or recruited through local advertisement, with controls without breast cancer recruited in the same way.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">254</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>RVGBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RVGDBCR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Racial Variability in Genotypic Determinants of Breast Cancer Risk Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12697">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001399"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12697"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Breast cancer cases were identified in the University of Pennsylvania Health System and Karmanos Cancer Institute.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001399"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9011920/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Root consortium is comprised of six epidemiologic studies of breast cancer in women of African ancestry: the Nigerian Breast Cancer Study (Ibadan, Nigeria); the Barbados National Cancer Study (Barbados); the Southern Community Cohort (southern United States); the Baltimore Breast Cancer Study (Baltimore, United States); the Racial Variability in Genotypic Determinants of Breast Cancer Risk Study (Detroit and Pennsylvania, United States); and the Chicago Cancer Prone Study (Chicago, United States).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001399"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90094651</owl:annotatedTarget>
        <dcterms:title>Associations between age of menarche and genetic variation in women of African descent: genome-wide association study and polygenic score analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34706928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9011920/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Root consortium is comprised of six epidemiologic studies of breast cancer in women of African ancestry: the Nigerian Breast Cancer Study (Ibadan, Nigeria); the Barbados National Cancer Study (Barbados); the Southern Community Cohort (southern United States); the Baltimore Breast Cancer Study (Baltimore, United States); the Racial Variability in Genotypic Determinants of Breast Cancer Risk Study (Detroit and Pennsylvania, United States); and the Chicago Cancer Prone Study (Chicago, United States).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001399"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of breast cancer conducted in the Philadelphia and Detroit metropolitan areas of the United States from 1999 to 2003, whose cases, diagnosed with invasive ductal breast cancer within 18 months of recruitment and over-sampled for diagnosis before age 40, were identified in the University of Pennsylvania Health System and the Karmanos Cancer Institute or recruited through local advertisement, with controls without breast cancer recruited in the same way.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34706928</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001399"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">143</owl:annotatedTarget>
        <obo:IAO_0000116>African-ancestry cases and controls included in the ROOT consortium after QC (analysed subset); no stated total</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>After quality control, we included 143 cases and 254 controls of African ancestry from BNCS in the ROOT consortium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001399"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">254</owl:annotatedTarget>
        <obo:IAO_0000116>African-ancestry cases and controls included in the ROOT consortium after QC (analysed subset); no stated total</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>After quality control, we included 143 cases and 254 controls of African ancestry from BNCS in the ROOT consortium.</rdfs:comment>
    </owl:Axiom>
