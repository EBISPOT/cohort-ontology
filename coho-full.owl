    <!-- http://www.ebi.ac.uk/coho/COHO_0000620 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000620">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90014287</obo:IAO_0000112>
        <obo:IAO_0000115>A sample of healthy controls of European American and African American ancestry recruited at the National Institute on Alcohol Abuse and Alcoholism, National Institutes of Health, USA, who did not meet criteria for alcohol dependence or other major psychiatric disorders on the Structured Clinical Interview for DSM-IV and gave blood samples used for genome-wide DNA methylation analysis and genotyping on Illumina OmniExpress arrays.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NIAAA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">National Institute on Alcohol Abuse and Alcoholism cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000620"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8243879/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The sample consisted of 119 European American (EA) and 82 African American (AA) healthy controls that were recruited at the National Institute on Alcohol Abuse and Alcoholism (NIAAA) at the National Institutes of Health (NIH), USA.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000620"/>
