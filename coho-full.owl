    <!-- http://www.ebi.ac.uk/coho/COHO_0001129 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001129">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10317"/>
        <rdf:type rdf:nodeID="genid10319"/>
        <rdf:type rdf:nodeID="genid10321"/>
