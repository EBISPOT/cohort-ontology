    <!-- http://www.ebi.ac.uk/coho/COHO_0001510 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001510">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13671"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002462"/>
        <obo:IAO_0000112>PMID:32424353</obo:IAO_0000112>
        <obo:IAO_0000115>A UK case-control study of breast cancer, led by investigators at the Institute of Cancer Research and the London School of Hygiene and Tropical Medicine, which in 2001–2008 recruited women with bilateral breast cancer identified through English and Scottish cancer registries and breast cancer clinics, and clinic patients with breast cancer and at least two affected female first-degree relatives, together with controls who were friends or non-blood relatives of the cases. It is one of the studies of the Breast Cancer Association Consortium.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym BBCS also denotes Brescia Bladder Cancer Study (COHO:0000815) and Baltimore Breast Cancer Study (COHO:0001288); this term is British Breast Cancer Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1695</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2001</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>BBCS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">British Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13671">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001510"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13671"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2655767/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Peripheral blood DNA samples from a second set of 190 bilateral cases and 190 controls were obtained from the British Breast Cancer study (40,41).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001510"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4756509/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All cases were genotyped with the iCOGS chip and compared to 5,000 UK controls selected from four UK studies (BBCS 1,231 controls, SBCS 704 controls, UKBGS 370 controls, SEARCH 2,695 controls) participating in BCAC</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001510"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32424353</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies 32 novel breast cancer susceptibility loci from overall and subtype-specific analyses.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32424353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0609-2/MediaObjects/41588_2020_609_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>British Breast Cancer Study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001510"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A UK case-control study of breast cancer, led by investigators at the Institute of Cancer Research and the London School of Hygiene and Tropical Medicine, which in 2001–2008 recruited women with bilateral breast cancer identified through English and Scottish cancer registries and breast cancer clinics, and clinic patients with breast cancer and at least two affected female first-degree relatives, together with controls who were friends or non-blood relatives of the cases. It is one of the studies of the Breast Cancer Association Consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16257342</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19153073</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22768030</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26884359</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature24284/MediaObjects/41586_2017_BFnature24284_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001510"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1695</owl:annotatedTarget>
        <obo:IAO_0000116>analysed subset: cases and controls of white ancestry in a 2012 BBCS analysis; no total stated</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3272480/</oboInOwl:hasDbXref>
        <rdfs:comment>For this analysis we included 1695 cases, 1564 of whom had two sequential or simultaneous primary breast cancers, and 131 of whom had at least two affected first degree relatives. The excess relative risk among cases with a second primary and those with two affected first degree relatives has been shown to be equivalent( 1 ) so the subsequent analysis assumes that all cases are bilateral. 2001 controls were ascertained as friends and non-blood relatives of the cases.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001510"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2001</owl:annotatedTarget>
        <obo:IAO_0000116>analysed subset: cases and controls of white ancestry in a 2012 BBCS analysis; no total stated</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3272480/</oboInOwl:hasDbXref>
        <rdfs:comment>For this analysis we included 1695 cases, 1564 of whom had two sequential or simultaneous primary breast cancers, and 131 of whom had at least two affected first degree relatives. The excess relative risk among cases with a second primary and those with two affected first degree relatives has been shown to be equivalent( 1 ) so the subsequent analysis assumes that all cases are bilateral. 2001 controls were ascertained as friends and non-blood relatives of the cases.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001510"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BBCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001511 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001511">
