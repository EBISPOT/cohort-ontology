    <!-- http://www.ebi.ac.uk/coho/COHO_0001123 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001123">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10274"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000651"/>
        <obo:IAO_0000112>GCST90301368</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based study of ischaemic stroke that from 1999 to 2011 enrolled, at clinical centres in the United States and Canada, adult probands with radiographically confirmed ischaemic stroke who had at least one living full sibling with stroke, together with their stroke-affected siblings, confirmed by central review of medical records, and where possible a stroke-free sibling, confirmed by structured telephone interview, all contacted through the proband, to search the genome for genetic risk factors for ischaemic stroke by linkage and family-based association analysis.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">555</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SWISS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sibling with Ischemic Stroke Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Siblings with Ischemic Stroke Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Siblings With Ischemic Stroke Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10274">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_1060198"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001123"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10274"/>
        <obo:IAO_0000116>ischemic stroke</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21940970+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Siblings With Ischemic Stroke Study enrolled 312 probands with ischemic stroke from 70 US and Canadian centers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001123"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21940970+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Siblings With Ischemic Stroke Study enrolled 312 probands with ischemic stroke from 70 US and Canadian centers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001123"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90301368</owl:annotatedTarget>
        <dcterms:title>Evidence of survival bias in the association between APOE-Є4 and age at ischemic stroke onset.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39286457</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11403718/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Sibling with Ischemic Stroke Study (SWISS) was supported by the NINDS (R01 NS39987; PI Dr Meschia).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001123"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family-based study of ischaemic stroke that from 1999 to 2011 enrolled, at clinical centres in the United States and Canada, adult probands with radiographically confirmed ischaemic stroke who had at least one living full sibling with stroke, together with their stroke-affected siblings, confirmed by central review of medical records, and where possible a stroke-free sibling, confirmed by structured telephone interview, all contacted through the proband, to search the genome for genetic risk factors for ischaemic stroke by linkage and family-based association analysis.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11882254</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21940970</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24021684</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001123"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">555</owl:annotatedTarget>
        <obo:IAO_0000116>probands and siblings in the final genome-wide scan after QC (analysed subset), 2011</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3251509/</oboInOwl:hasDbXref>
        <rdfs:comment>After quality control filtering, the final study population consisted of 223 probands, 248 stroke-affected siblings, and 84 stroke-unaffected siblings (total sample size, 555).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001123"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SWISS</owl:annotatedTarget>
