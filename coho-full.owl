        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13169920/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To ensure accurate comparisons and minimize confounding, stroke cases were matched with stroke-free controls at a 1:1 ratio on key demographic factors known to confound stroke epidemiology, including age (± 5 years), sex, and ethnicity, for a total of 7368 participants (3684 cases and 3684 controls) in this study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000335"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7368</owl:annotatedTarget>
        <obo:IAO_0000116>1:1 matched stroke cases and stroke-free controls analysed in a 2026 SIREN report</obo:IAO_0000116>
