    <!-- http://www.ebi.ac.uk/coho/COHO_0000684 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000684">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid6170"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <obo:IAO_0000112>GCST005840</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of ischaemic stroke in Japan combining 1,113 patients with ischaemic stroke recruited in 2004 from seven hospitals in Fukuoka Prefecture (the Fukuoka Stroke Registry) with 901 controls free of stroke and coronary heart disease drawn from the population-based Hisayama Study, used in genome-wide association studies of ischaemic stroke and its subtypes.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1113</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">901</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>HISAYAMA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HISAYAMA_FSR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Hisayama-FSR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hisayama-FSR study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid6170">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_1060198"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000684"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid6170"/>
        <obo:IAO_0000116>ischemic stroke</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The individuals with ischemic stroke were recruited from seven hospitals in Fukuoka Prefecture, Japan (Kyushu University Hospital, Hakujyuji Hospital, Fukuoka Red Cross Hospital, Kyushu Medical Center, Imazu Red Cross Hospital, Fukuoka Higashi Medical Center, and Seiai Rehabilitation Hospital) in 2004 (The Fukuoka Stroke Registry [FSR]) .</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000684"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The individuals with ischemic stroke were recruited from seven hospitals in Fukuoka Prefecture, Japan (Kyushu University Hospital, Hakujyuji Hospital, Fukuoka Red Cross Hospital, Kyushu Medical Center, Imazu Red Cross Hospital, Fukuoka Higashi Medical Center, and Seiai Rehabilitation Hospital) in 2004 (The Fukuoka Stroke Registry [FSR]) .</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000684"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST005840</owl:annotatedTarget>
        <dcterms:title>Multiancestry genome-wide association study of 520,000 subjects identifies 32 loci associated with stroke and stroke subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29531354</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Stroke ascertainment in the Hisayama-FSR study: Ischemic stroke was defined as a sudden non- convulsive, focal neurologic deficit lasting longer than 24 hours due to brain ischemia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000684"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of ischaemic stroke in Japan combining 1,113 patients with ischaemic stroke recruited in 2004 from seven hospitals in Fukuoka Prefecture (the Fukuoka Stroke Registry) with 901 controls free of stroke and coronary heart disease drawn from the population-based Hisayama Study, used in genome-wide association studies of ischaemic stroke and its subtypes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29531354</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000684"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1113</owl:annotatedTarget>
        <obo:IAO_0000116>ischaemic stroke cases and stroke-free controls in the GWAS (no total stated), 2004</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>In the genome-wide association study, 1113 cases with ischemic stroke (370 large artery stroke, 137 cardioembolic stroke, 483 small vessel occlusion, 123 undetermined subtype) were included.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000684"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">901</owl:annotatedTarget>
        <obo:IAO_0000116>ischaemic stroke cases and stroke-free controls in the GWAS (no total stated), 2004</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>In the genome-wide association study, 1113 cases with ischemic stroke (370 large artery stroke, 137 cardioembolic stroke, 483 small vessel occlusion, 123 undetermined subtype) were included.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000684"/>
