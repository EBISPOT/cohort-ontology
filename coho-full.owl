        <oboInOwl:hasDbXref>PMID:29611518</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/articles/PMC5883334</oboInOwl:hasDbXref>
        <rdfs:comment>The SCOT study was an international, randomised, phase 3, non-inferiority trial</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000154"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
