        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5013013/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>MrOS Sweden 1 941 - 0 - 100 75 113.1 (85.2, 145.8) NA Sweden [PMID: 16598372] Mellström et al. 2006 J Bone Miner Res 21, 529-535.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000835"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based multicentre study of 3,014 men aged 69–81, randomly selected from the Swedish national population register and examined at hospitals in Malmö, Gothenburg and Uppsala in 2001–2004, the Swedish part of the Osteoporotic Fractures in Men study, set up to identify risk factors for osteoporosis and fracture.</owl:annotatedTarget>
