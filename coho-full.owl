    <!-- http://www.ebi.ac.uk/coho/COHO_0002081 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002081">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18142"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>PGS003405</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:36528340</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cross-sectional survey of cardiovascular risk factors in France, in which women and men aged 35 to 74 years were randomly selected from electoral rolls between 2005 and 2007 in three areas: the Lille urban community in northern France, the Bas-Rhin department in eastern France and the Haute-Garonne department in southwestern France.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4825</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MONA LISA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MONA LISA Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MONA LISA survey</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MONA-LISA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MOnitoring NAtionaL du rISque Artériel</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Monitoring National du risque Art_rie</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Monitoring of Arterial Risk</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Monitoring National du Risque Artériel</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18142">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002081"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18142"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23527913+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Participants aged 35 to 74 years (n=4609) were randomly selected from the general population of three French regions. A standardized data collection was performed to assess cardiovascular risk as described in the French and European guidelines.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002081"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12143755/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, between 2005 and 2007, women and men aged 35–74 years were randomly selected from electoral rolls in three French regions: Lille urban community in Northern France, Bas-Rhin department in Eastern France, and Haute-Garonne department in Southwestern France.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002081"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS003405</owl:annotatedTarget>
        <dcterms:title>A new 165-SNP low-density lipoprotein cholesterol polygenic risk score based on next generation sequencing outperforms previously published scores in routine diagnostics of familial hypercholesterolemia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36528340</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002081"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:36528340</owl:annotatedTarget>
        <dcterms:title>A new 165-SNP low-density lipoprotein cholesterol polygenic risk score based on next generation sequencing outperforms previously published scores in routine diagnostics of familial hypercholesterolemia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36528340</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36528340+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>They were established using two French control cohorts (MONA LISA n=1082 and FranceGenRef n=856).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002081"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cross-sectional survey of cardiovascular risk factors in France, in which women and men aged 35 to 74 years were randomly selected from electoral rolls between 2005 and 2007 in three areas: the Lille urban community in northern France, the Bas-Rhin department in eastern France and the Haute-Garonne department in southwestern France.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24885863</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40485857</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002081"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4825</owl:annotatedTarget>
        <obo:IAO_0000116>women and men aged 35-74 recruited in the three areas, 2005-2007</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20852444+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Four thousand eight hundred and twenty-five participants were recruited (mean age 55.5 ± 11.3 years).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002081"/>
