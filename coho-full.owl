        <owl:annotatedTarget>GCST90132222</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genome-wide association analyses identify novel genetic mechanisms in rheumatoid arthritis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36333501</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01213-w/MediaObjects/41588_2022_1213_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Institute of Rheumatology, Rheumatoid Arthritis (IORRA). The study was approved by Tokyo Women&apos;s Medical University Ethics Committee (#217I).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
