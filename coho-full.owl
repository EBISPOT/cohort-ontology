        <rdfs:comment>Aircraft noise exposure and body mass index among female participants in two Nurses’ Health Study prospective cohorts living around 90 airports in the United States</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000619"/>
