    <!-- http://www.ebi.ac.uk/coho/COHO_0001186 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001186">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>GCST90002310</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional population-based study of the Research Centre for Prevention and Health in Glostrup, Denmark, conducted in 2008–2009 on a random sample of men and women aged 30–60, drawn from the Danish Central Personal Register, living in the western part of the Copenhagen area; pregnant women and people with known diabetes, cardiovascular disease, chronic obstructive pulmonary disease, hypertension or a history of blood clots, or unable to do physical activities such as climbing stairs, were excluded. The examination included questionnaires, clinical and biochemical measurements, an oral glucose tolerance test and two tests estimating maximal oxygen uptake.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">795</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Health 2008 study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Health2008</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Health2008 cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Health2008 Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001186"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:22587629%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The study comprised 771 participants from the Danish, population-based cross-sectional &apos;Health2008&apos; study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001186"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90002310</owl:annotatedTarget>
        <dcterms:title>Trans-ethnic and Ancestry-Specific Blood-Cell Genetics in 746,667 Individuals from 5 Global Populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32888493</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://ars.els-cdn.com/content/image/1-s2.0-S0092867420308229-mmc1.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>Health2008</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001186"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional population-based study of the Research Centre for Prevention and Health in Glostrup, Denmark, conducted in 2008–2009 on a random sample of men and women aged 30–60, drawn from the Danish Central Personal Register, living in the western part of the Copenhagen area; pregnant women and people with known diabetes, cardiovascular disease, chronic obstructive pulmonary disease, hypertension or a history of blood clots, or unable to do physical activities such as climbing stairs, were excluded. The examination included questionnaires, clinical and biochemical measurements, an oral glucose tolerance test and two tests estimating maximal oxygen uptake.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22587629</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23022702</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26372449</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
