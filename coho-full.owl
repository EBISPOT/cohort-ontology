        <oboInOwl:hasRelatedSynonym>KANC cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KANC newborns cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Kaunas cohort</rdfs:label>
