        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Southern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Tanzania"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Turkey"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Arab_Emirates"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Zimbabwe"/>
        <obo:IAO_0000112>PMID:34910150</obo:IAO_0000112>
        <obo:IAO_0000115>A large international prospective epidemiological cohort study, funded by the Population Health Research Institute (Hamilton, Canada) with Canadian research funders, that has recruited since 2002 adults aged 35 to 70 years, with their household members, from representative samples of urban and rural communities in low-, middle- and high-income countries on five continents (17 countries at first, 27 later), to examine how societal influences and social, behavioural, genetic and environmental factors relate to lifestyle, cardiovascular risk factors and chronic non-communicable diseases, above all cardiovascular disease. Participants give medical history, lifestyle, anthropometric and electrocardiogram data and blood stored for biochemistry and genetic analysis, and are followed up for at least 10 years for events and death.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">166762</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PURE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PURE Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PURE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prospective Urban Rural Epidemiology</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prospective Urban and Rural Epidemiology</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prospective Urban and Rural Epidemiology Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Prospective Urban Rural Epidemiology study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19625">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002299"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19625"/>
        <obo:IAO_0000116>cardiovascular diseases</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24093842+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The PURE study was established to investigate associations between social, behavioural, genetic, and environmental factors and cardiovascular diseases in 17 countries.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002299"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Zimbabwe"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8674745/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participating countries are 4 high-income countries (Canada, Saudi Arabia, Sweden, and United Arab Emirates), 12 middle-income countries (Argentina, Brazil, Chile, China, Colombia, Iran, Malaysia, Occupied Palestinian Territory, Philippines, Poland, South Africa, and Turkey) and 5 low-income countries (Bangladesh, India, Pakistan, Tanzania, and Zimbabwe).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002299"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34910150</owl:annotatedTarget>
        <dcterms:title>Psychosocial Risk Factors and Cardiovascular Disease and Death in a Population-Based Cohort From 21 Low-, Middle-, and High-Income Countries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34910150</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8674745/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This population-based cohort study used data from the Prospective Urban Rural Epidemiology study, collected between January 2003 and March 2021.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002299"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A large international prospective epidemiological cohort study, funded by the Population Health Research Institute (Hamilton, Canada) with Canadian research funders, that has recruited since 2002 adults aged 35 to 70 years, with their household members, from representative samples of urban and rural communities in low-, middle- and high-income countries on five continents (17 countries at first, 27 later), to examine how societal influences and social, behavioural, genetic and environmental factors relate to lifestyle, cardiovascular risk factors and chronic non-communicable diseases, above all cardiovascular disease. Participants give medical history, lifestyle, anthropometric and electrocardiogram data and blood stored for biochemistry and genetic analysis, and are followed up for at least 10 years for events and death.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19540385</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24093842</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34910150</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40519856</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002299"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">166762</owl:annotatedTarget>
        <obo:IAO_0000116>individuals aged 35-70 enrolled from the general population in 21 countries (as reported in 2023)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10361015/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>In brief, the PURE Study is an ongoing large-scale epidemiological cohort study that has enrolled 166 762 individuals, 35–70 years of age, from the general population in 21 low-, middle-, and high-income countries on 5 continents (see Supplementary data online, Appendices S1 and S2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002299"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PURE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002300 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002300">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19632"/>
        <rdf:type rdf:nodeID="genid19634"/>
        <rdf:type rdf:nodeID="genid19636"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Latin_America_and_the_Caribbean"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Puerto_Rico"/>
        <obo:IAO_0000112>PMID:25389437</obo:IAO_0000112>
        <obo:IAO_0000115>A familial cancer registry established in 2006 at the University of Puerto Rico Comprehensive Cancer Center, the first familial cancer registry in Puerto Rico, which enrols Hispanic individuals with a clinical or genetic diagnosis of a hereditary colorectal cancer or polyposis syndrome (familial adenomatous polyposis, attenuated FAP, hamartomatous polyposis syndromes or Lynch syndrome), referred with a personal or family history of possible familial colorectal cancer or polyposis by gastroenterologists, oncologists and colorectal surgeons. Consenting probands complete questionnaires on medical history, environmental exposures and cancer family history, their pedigrees are traced, and the registry offers affected families education, genetic testing and surveillance.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">31</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PURIFICAR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Puerto Rico Familial Cancer Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Puerto Rico Familial Colorectal Cancer Registry</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Puerto Rico Familial Colorectal Cancer Registry</rdfs:label>
    </owl:NamedIndividual>
