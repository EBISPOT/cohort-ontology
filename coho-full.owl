    <!-- http://www.ebi.ac.uk/coho/COHO_0002560 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002560">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21563"/>
        <rdf:type rdf:nodeID="genid21565"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>PMID:39699891</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing prospective cohort that since August 2019 has recruited pregnant women aged 18 years or older with gestational diabetes at 24–28 weeks&apos; gestation from the Hangzhou Maternity and Child Health Care Hospital in Hangzhou, China, who intend to deliver there and to stay in Hangzhou with their children for at least four years; it was approved by the institutional review board of Westlake University and integrates multi-omics with precision nutrition research on gestational diabetes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1902</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>WeBirth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WeBirth cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WeBirth study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Westlake Precision Birth Cohort study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Westlake Precision Birth Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21563">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005406"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid21565">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000021"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002560"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21563"/>
        <obo:IAO_0000116>gestational diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11659911/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Inclusion criteria for WeBirth involved pregnant women (1) who were aged 18 years or older and had received a diagnosis of GD, and with a gestational age ranging from 24 to 28 weeks; and (2) who intended to deliver at Hangzhou Women’s Hospital and remain in Hangzhou with their children for 4 or more years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002560"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21565"/>
        <obo:IAO_0000116>diet</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12751878/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To date, there are no prediction models based on large Chinese general population data, though the Westlake Precision Birth Cohort study aimed to develop personalized dietary recommendations for Chinese women with gestational diabetes mellitus [17].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002560"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11659911/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This cohort study was based on the data from the Westlake Precision Birth Cohort (WeBirth) in Hangzhou, China.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002560"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39699891</owl:annotatedTarget>
        <dcterms:title>Physical Activity During Pregnancy and Preterm Birth Among Women With Gestational Diabetes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39699891</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11659911/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This cohort study was based on the data from the Westlake Precision Birth Cohort (WeBirth) in Hangzhou, China.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002560"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing prospective cohort that since August 2019 has recruited pregnant women aged 18 years or older with gestational diabetes at 24–28 weeks&apos; gestation from the Hangzhou Maternity and Child Health Care Hospital in Hangzhou, China, who intend to deliver there and to stay in Hangzhou with their children for at least four years; it was approved by the institutional review board of Westlake University and integrates multi-omics with precision nutrition research on gestational diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:39699891</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002560"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1902</owl:annotatedTarget>
        <obo:IAO_0000116>pregnant women with gestational diabetes recruited August 2019 to August 2023 (2019-2023)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11659911/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Up to August 2023, a total of 1902 participants with GD were recruited in the WeBirth study.</rdfs:comment>
    </owl:Axiom>
