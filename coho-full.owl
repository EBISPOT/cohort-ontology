    <!-- http://www.ebi.ac.uk/coho/COHO_0001824 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001824">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:21082022</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing research programme at the renal function unit of the University Medical Center Groningen, the Netherlands, that hosts and harmonises a series of studies of renal hemodynamics, mainly in healthy volunteers, under a common protocol of integrated measurement of renal hemodynamics and extracellular volume, with standardised methods and calibration over time; participants are typically studied on a standardised dietary sodium intake.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GRECO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Groningen Renal Hemodynamic Cohorts</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Groningen Renal Hemodynamic Cohort Study Group</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001824"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4552520/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GRECO program hosts and harmonizes studies on renal hemodynamics at the renal function unit of the University Medical Center Groningen, by standardization of methodology, including harmonization of study protocols and calibration over time.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001824"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21082022</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of blood pressure extremes identifies variant near UMOD associated with hypertension.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21082022</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2965757/</oboInOwl:hasDbXref>
        <rdfs:comment>In the small GRECO cohort, urinary uromodulin concentration (p = 0.004) and 24 hour uromodulin excretion (p = 0.002; Wilcoxon′s signed ranks test) were found to be significantly increased after a high sodium intake (Table 6).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001824"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing research programme at the renal function unit of the University Medical Center Groningen, the Netherlands, that hosts and harmonises a series of studies of renal hemodynamics, mainly in healthy volunteers, under a common protocol of integrated measurement of renal hemodynamics and extracellular volume, with standardised methods and calibration over time; participants are typically studied on a standardised dietary sodium intake.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21082022</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26149279</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001824"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GRECO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001825 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001825">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16291"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002507"/>
        <obo:IAO_0000112>PMID:19536330</obo:IAO_0000112>
        <obo:IAO_0000115>A self-referred registry of families with two or more cases of ovarian cancer among blood relatives, or with a cancer syndrome possibly related to ovarian cancer, established in 1981 at Roswell Park Cancer Institute in Buffalo, New York, United States, which receives family cancer information from throughout the United States, obtains detailed family histories, documents cancers through medical records and pathology review, and collects and stores biological samples from registry participants for research on familial ovarian cancer.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3802</coho:numberOfCases>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7669</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Familial Ovarian Cancer Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GRFOCR</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Gilda Radner Familial Ovarian Cancer Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16291">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008170"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001825"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16291"/>
        <obo:IAO_0000116>ovarian cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2694280/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The families included in the present study comprised of 1412 families ascertained to have two or more cases of ovarian cancer; 17 families with one case of ovarian cancer and two cases of cancer at other sites; and 490 families in the category of those having at least one female with more than one primary tumors with one of the primaries being ovarian cancer or having more than one case of cancer with at least one case being ovarian cancer and the other cancer considered to be of early onset.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001825"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2694280/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The primary function of the Registry is to receive family cancer information voluntarily contributed throughout the United States by ovarian cancer patients, referring and concerned physicians, concerned women, and patients of the Roswell Park Cancer Institute (RPCI) Gynecologic Oncology Department.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001825"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:19536330</owl:annotatedTarget>
        <dcterms:title>Complex segregation analysis of pedigrees from the Gilda Radner Familial Ovarian Cancer Registry reveals evidence for mendelian dominant inheritance.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:19536330</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19536330+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The goal of this study was to investigate the inheritance model that best fits the observed transmission pattern of ovarian cancer among 7669 members of 1919 pedigrees ascertained through probands from the Gilda Radner Familial Ovarian Cancer Registry at Roswell Park Cancer Institute, Buffalo, New York.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001825"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A self-referred registry of families with two or more cases of ovarian cancer among blood relatives, or with a cancer syndrome possibly related to ovarian cancer, established in 1981 at Roswell Park Cancer Institute in Buffalo, New York, United States, which receives family cancer information from throughout the United States, obtains detailed family histories, documents cancers through medical records and pathology review, and collects and stores biological samples from registry participants for research on familial ovarian cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19536330</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29447163</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:8420680</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001825"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3802</owl:annotatedTarget>
        <obo:IAO_0000116>Real adult registry pedigree members in the 2009 segregation analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2694280/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 6213 females, 3802 were affected and 2253 unaffected while affection status for 158 females was unknown.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001825"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7669</owl:annotatedTarget>
        <obo:IAO_0000116>Real adult registry pedigree members in the 2009 segregation analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2694280/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects for this study consisted of 7669 adult members from 1919 different pedigrees from the GRFOCR.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001825"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GRFOCR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001826 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001826">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16299"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:23157996</obo:IAO_0000112>
        <obo:IAO_0000115>A research program at Cedars-Sinai Medical Center, Los Angeles, launched as the Gilda Radner Hereditary Cancer Early Detection Program, that from 1991 enrolled women at elevated risk of cancer because of their family histories, among them carriers of BRCA1 and BRCA2 mutations, offered them ovarian cancer screening and, once it became clinically available, BRCA genetic testing, and keeps their serum samples and lymphoblastoid cell lines in a biorepository for later studies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3623</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GRHCP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gilda Radner Hereditary Cancer Early Detection Program</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Gilda Radner Hereditary Cancer Program</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16299">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008170"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001826"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16299"/>
        <obo:IAO_0000116>ovarian cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11047303/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The program enrolled women at elevated risk due to their family histories of cancer, and participants underwent regular screenings with CA125 and ultrasound in an attempt to diagnose ovarian cancer before it had spread.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001826"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4572843/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Under Institutional Review Board-approved protocol (18941) women with BRCA 1/2 mutations were identified through the Gilda Radner Hereditary Cancer Program at Cedars-Sinai Medical Center.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001826"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23157996</owl:annotatedTarget>
        <dcterms:title>Biopsychological stress factors in BRCA mutation carriers.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23157996</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23157996+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>BRCA-carriers with known maternal transmission enrolled in the Gilda Radner Hereditary Cancer Program were invited to participate.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001826"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A research program at Cedars-Sinai Medical Center, Los Angeles, launched as the Gilda Radner Hereditary Cancer Early Detection Program, that from 1991 enrolled women at elevated risk of cancer because of their family histories, among them carriers of BRCA1 and BRCA2 mutations, offered them ovarian cancer screening and, once it became clinically available, BRCA genetic testing, and keeps their serum samples and lymphoblastoid cell lines in a biorepository for later studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23157996</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25256924</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34965417</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38230704</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001826"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3623</owl:annotatedTarget>
        <obo:IAO_0000116>women who consented to the program and the Women&apos;s Cancer Program biorepository, 1991-2008</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:25256924</oboInOwl:hasDbXref>
        <rdfs:comment>Between 1991–2008, 3623 women consented to the Gilda Radner Hereditary Cancer Program and the Women’s Cancer Program biorepository.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001826"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GRHCP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001827 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001827">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16306"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Greece"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000617"/>
        <obo:IAO_0000112>PGS005170</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:34887591</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of survivors of myocardial infarction in Greece, followed for recurrent events, whose participants have been genotyped and profiled for gene expression after the index infarction to study the genetics of recurrent myocardial infarction and of cardiometabolic traits.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">173</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GRMIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Greek Recurrent Myocardial Infarction Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16306">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005068"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001827"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16306"/>
        <obo:IAO_0000116>myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6778823/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Five of the identified genes (CHD7, IST1, KIAA1958, MAP3K5, UBFD1) were also found to be differentially expressed six months after a MI in 39 MI survivors (Greek Recurrent Myocardial Infarction Cohort) that had not experienced any recurrent event during that period (p-adj ≤10-5).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001827"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005170</owl:annotatedTarget>
        <dcterms:title>Polygenic score integrating neurodegenerative and vascular risk informs dementia risk stratification.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40042447</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001827"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34887591</owl:annotatedTarget>
        <dcterms:title>The power of genetic diversity in genome-wide association studies of lipids.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34887591</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-021-04064-3/MediaObjects/41586_2021_4064_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Greek Recurrent Myocardial Infarction Cohort /NAFLD Study Work was supported by the British Heart Foundation (BHF) grant RG/14/5/30893 (P.D.)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001827"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of survivors of myocardial infarction in Greece, followed for recurrent events, whose participants have been genotyped and profiled for gene expression after the index infarction to study the genetics of recurrent myocardial infarction and of cardiometabolic traits.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34887591</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6778823/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
