        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS50000000168</oboInOwl:hasDbXref>
        <rdfs:comment>In the phase 2 PANDA trial, patients with previously untreated resectable G/GEJ tumors (n=21) received neoadjuvant treatment with one cycle of atezolizumab monotherapy followed by 4 cycles of atezolizumab plus docetaxel, oxaliplatin and capecitabine.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000314"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2889"/>
        <obo:IAO_0000116>gastric adenocarcinoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS50000000168</oboInOwl:hasDbXref>
        <rdfs:comment>In the phase 2 PANDA trial, patients with previously untreated resectable G/GEJ tumors (n=21) received neoadjuvant treatment with one cycle of atezolizumab monotherapy followed by 4 cycles of atezolizumab plus docetaxel, oxaliplatin and capecitabine.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000314"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of 21 patients with previously untreated resectable gastric or gastro-oesophageal junction adenocarcinoma treated in the phase 2 PANDA trial with neoadjuvant atezolizumab and chemotherapy, sampled at multiple time points to study the tumour microenvironment.</owl:annotatedTarget>
        <obo:IAO_0000119>https://ega-archive.org/studies/EGAS50000000168</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000314"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21</owl:annotatedTarget>
        <obo:IAO_0000116>patients included in the phase 2 PANDA trial (2024)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS50000000168</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 21 patients were included, of whom 20 patients underwent surgery and were evaluable for the secondary pathologic response and survival endpoints, while 19 were evaluable for exploratory translational analyses.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000315 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000315">
