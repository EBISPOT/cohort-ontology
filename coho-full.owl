    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002650"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based prospective birth cohort of pregnant women aged 16 or over living in the city of Rio de Janeiro, Brazil, and their children born at the Maternity School of the Federal University of Rio de Janeiro, coordinated by the university&apos;s Institute for Studies in Collective Health with Fiocruz, in which mothers and children are followed with interviews, examinations and biological samples from pregnancy to age four to study the effects of prenatal and early-life exposure to metals, pesticides and plasticisers on child health and development; a pilot phase ran from September 2017 to August 2018.</owl:annotatedTarget>
