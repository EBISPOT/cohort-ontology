        <rdfs:comment>Participants in the Irish Affected Sib Pair Study of Alcohol Dependence (IASPSAD)42 were recruited in Ireland and Northern Ireland between 1998 and 2002.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001887"/>
