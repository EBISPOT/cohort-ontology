        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001002"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002430"/>
        <obo:IAO_0000112>PGS005204</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:40691366</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of Indian cohorts brought together for genetic studies of type 2 diabetes by the Genomic Research on Complex Diseases group at the CSIR-Centre for Cellular and Molecular Biology (CCMB), Hyderabad, including the Indian Diabetes Prevention Study 3, the Pune Maternal Nutrition Study and the Wellcome Genetics (WellGen) study, whose type 2 diabetes cases (by history, treatment or WHO 1999 oral glucose tolerance criteria) and normoglycaemic controls were genotyped genome-wide.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2219</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GRCCDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genomic Research Cohort for CCMB Diabetes Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Genomic Research Cohorts for CCMB Diabetes Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16279">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001823"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16279"/>
        <obo:IAO_0000116>type 2 diabetes mellitus</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://link.springer.com/article/10.1007/s00125-006-0502-2</oboInOwl:hasDbXref>
        <rdfs:comment>We studied 955 type 2 diabetes mellitus patients and 399 ethnically matched control subjects (Indo-Europeans) from Pune, Maharashtra, Western India.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001823"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/India"/>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC10363502</oboInOwl:hasDbXref>
        <rdfs:comment>People with T2D (n = 3111) being treated at the Diabetes Unit, KEM Hospital (Pune, India) and associated clinics were included in the WellGen cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001823"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005204</owl:annotatedTarget>
        <dcterms:title>Polygenic prediction of body mass index and obesity through the life course and across ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40691366</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001823"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40691366</owl:annotatedTarget>
        <dcterms:title>Polygenic prediction of body mass index and obesity through the life course and across ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40691366</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41591-025-03827-z/MediaObjects/41591_2025_3827_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Indian Diabetes Prevention Study 3 (IDPP3) (part of Genomic Research Cohorts for CCMB Diabetes Study (GRCCDS))</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001823"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of Indian cohorts brought together for genetic studies of type 2 diabetes by the Genomic Research on Complex Diseases group at the CSIR-Centre for Cellular and Molecular Biology (CCMB), Hyderabad, including the Indian Diabetes Prevention Study 3, the Pune Maternal Nutrition Study and the Wellcome Genetics (WellGen) study, whose type 2 diabetes cases (by history, treatment or WHO 1999 oral glucose tolerance criteria) and normoglycaemic controls were genotyped genome-wide.</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM1_ESM.pdf</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41591-025-03827-z/MediaObjects/41591_2025_3827_MOESM1_ESM.pdf</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM3_ESM.xlsx</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001823"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
