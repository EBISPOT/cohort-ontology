    <!-- http://www.ebi.ac.uk/coho/COHO_0001716 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001716">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15357"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Estonia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Portugal"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>PMID:37404302</obo:IAO_0000112>
        <obo:IAO_0000115>A school-based population study of risk factors for future cardiovascular disease in children aged 9 and 15 years, randomly sampled through schools in Denmark, Estonia, Norway, Portugal and Sweden in the late 1990s, with objectively measured physical activity and fitness; its Danish part, recruited in 1997, has been followed longitudinally into early adulthood.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">399</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>EYHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European youth heart study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The European Youth Heart Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">European Youth Heart Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15357">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001716"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15357"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10315841/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The other cohort is the European Youth Heart Study (EYHS), which is an international, population-based, multicentre study that addresses cardiovascular disease risk factors in children and adolescents.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001716"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Norway"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14707773+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects were 2185 children aged 9 and 15 yr from Denmark, Portugal, Estonia, and Norway.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001716"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12740078+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Thirty-seven state schools in two regions of Central Sweden (Orebro and southern Stockholm) were visited during the school year 1998/1999.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001716"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:37404302</owl:annotatedTarget>
        <dcterms:title>Bidirectional associations between adiposity and physical activity: a longitudinal study from pre-puberty to early adulthood.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37404302</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37404302+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In the European Youth Heart Study (EYHS), height, weight and habitual PA were measured at age 9.6-years, 15.7-years and 21.8-years in 399 Danish boys and girls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001716"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A school-based population study of risk factors for future cardiovascular disease in children aged 9 and 15 years, randomly sampled through schools in Denmark, Estonia, Norway, Portugal and Sweden in the late 1990s, with objectively measured physical activity and fitness; its Danish part, recruited in 1997, has been followed longitudinally into early adulthood.</owl:annotatedTarget>
