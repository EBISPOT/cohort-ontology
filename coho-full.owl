        <obo:IAO_0000112>GCST90444478</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of young adults aged 18–30 years, balanced by sex and by Black and White race, recruited in 1985–1986 at four field centres in Birmingham, Alabama, Chicago, Illinois, Minneapolis, Minnesota and Oakland, California, and followed with repeated examinations into midlife to study the development of cardiovascular risk factors and disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5115</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CARDIA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Coronary Artery Risk Development in Young Adults</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Coronary Artery Risk Development in Young Adults Study</rdfs:label>
    </owl:NamedIndividual>
