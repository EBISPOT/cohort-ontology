        <obo:IAO_0000112>PMID:31157323</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort study of breast cancer survivors in urban Shanghai, China, which enrolled women aged 20 to 75 years with newly diagnosed breast cancer identified through the Shanghai Cancer Registry between March 2002 and April 2006, about six months after diagnosis, and followed them in person at 18 months and 3, 5 and 10 years after diagnosis for cancer outcomes, health status, lifestyle and medication use.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5042</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SBCSS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Shanghai Breast Cancer Survival Study</rdfs:label>
    </owl:NamedIndividual>
