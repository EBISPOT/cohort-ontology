    <!-- http://www.ebi.ac.uk/coho/COHO_0002224 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002224">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19059"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001090"/>
        <obo:IAO_0000112>PMID:21151130</obo:IAO_0000112>
        <obo:IAO_0000115>A United Kingdom-based international genetic study of endometriosis, run from the University of Oxford, that from 1995 to 2006 recruited women with surgically confirmed endometriosis, both families with two or more affected sisters and single cases, through collaborating clinicians in Britain, Ireland and the United States, advertisements and its website, to identify susceptibility genes by linkage analysis and positional cloning; with the Australian Genes Behind Endometriosis Study it forms the International Endogene Study.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1030</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>OXEGENE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>OXEGENE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Oxford Endometriosis Gene</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Oxford Endometriosis Gene study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Oxford Endometriosis Gene Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19059">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005133"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002224"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19059"/>
        <obo:IAO_0000116>endometriosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.731/MediaObjects/41588_2011_BFng731_MOESM17_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>From 1995-2006, the Oxford Endometriosis Gene (OXEGENE) study, Oxford, UK, recruited 245 families with ≥2 affected sisters with surgically confirmed endometriosis, and 785 single cases.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002224"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2939902/</oboInOwl:hasDbXref>
        <rdfs:comment>In brief, women were identified from the clinic databases of collaborating clinicians in Britain, Ireland, and the United States, or through advertisements, by the OXEGENE website, or research centers throughout the world.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002224"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21151130</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies a locus at 7p15.2 associated with endometriosis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21151130</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3019124/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>For the current study, 2,351 surgically-confirmed endometriosis cases were drawn from individuals recruited by The Queensland Institute of Medical Research (QIMR) and a further 1,030 cases from individuals recruited by the Oxford Endometriosis Gene (OXEGENE) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002224"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A United Kingdom-based international genetic study of endometriosis, run from the University of Oxford, that from 1995 to 2006 recruited women with surgically confirmed endometriosis, both families with two or more affected sisters and single cases, through collaborating clinicians in Britain, Ireland and the United States, advertisements and its website, to identify susceptibility genes by linkage analysis and positional cloning; with the Australian Genes Behind Endometriosis Study it forms the International Endogene Study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10206402</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:16080113</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:17498711</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.731/MediaObjects/41588_2011_BFng731_MOESM17_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002224"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1030</owl:annotatedTarget>
        <obo:IAO_0000116>women with surgically confirmed endometriosis recruited by the study and drawn into the 2011 endometriosis GWAS (1995-2006)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3019124/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>For the current study, 2,351 surgically-confirmed endometriosis cases were drawn from individuals recruited by The Queensland Institute of Medical Research (QIMR) and a further 1,030 cases from individuals recruited by the Oxford Endometriosis Gene (OXEGENE) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002224"/>
