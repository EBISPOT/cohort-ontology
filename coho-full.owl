        <rdfs:comment>EPIC-CVD is a multi centre case-cohort study nested within the EPIC cohort designed to investigate the determinants of cardiovascular disease (CVD).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001004"/>
