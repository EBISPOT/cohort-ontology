        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5059</owl:annotatedTarget>
        <obo:IAO_0000116>consented participants aged 40+ at baseline, 2014-2015</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10043003/fullTextXML</oboInOwl:hasDbXref>
