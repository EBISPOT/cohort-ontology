        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13479210/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The University of Michigan Institutional Review Board approved the Genes for Good study.</rdfs:comment>
    </owl:Axiom>
