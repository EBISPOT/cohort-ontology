    <!-- http://www.ebi.ac.uk/coho/COHO_0001474 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001474">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13323"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Czech_Republic"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Estonia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Hungary"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/India"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Lithuania"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Malaysia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/New_Zealand"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Philippines"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Poland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Russia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Slovakia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South-Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:26631737</obo:IAO_0000112>
        <obo:IAO_0000115>A multinational randomised controlled trial with a 2×2 factorial design, conducted from 2001 by 215 collaborating centres in 20 countries in Asia, Australasia, Europe and North America among people with type 2 diabetes diagnosed at age 30 or older, aged 55 or older and with cardiovascular disease or at least one other cardiovascular risk factor, which compared a fixed combination of perindopril and indapamide with placebo, whatever the initial blood pressure, and an intensive gliclazide modified-release-based glucose control regimen targeting an HbA1c of 6.5% or less with standard glucose control, for their effects on major macrovascular and microvascular events; surviving participants were followed after the trial in ADVANCE-ON.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym ADVANCE also denotes ADVANCE trial (COHO:0001052) and Atherosclerotic Disease, Vascular Function, and Genetic Epidemiology Study (COHO:0001053); this term is Action in Diabetes and Vascular disease: Preterax and Diamicron-MR Controlled Evaluation.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11140</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ADVANCE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADVANCE_TRIAL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Action in Diabetes and Vascular Disease: PreterAx and DiamicroN Modified-Release Controlled Evaluation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Action in Diabetes and Vascular Disease: Preterax and Diamicron MR Controlled Evaluation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Action in Diabetes and Vascular disease: preterAx and diamicroN mr Controlled Evaluation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Action in Diabetes and Vascular disease; preterAx and diamicroN-MR Controlled Evaluation</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Action in Diabetes and Vascular disease: Preterax and Diamicron-MR Controlled Evaluation</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13323">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001474"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13323"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11596665+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The study is a 2 x 2 factorial randomised controlled trial that will include 10000 adults with Type II diabetes at high risk of vascular disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001474"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7496988/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As in previous analyses based on ADVANCE 15, 19, the primary comparison in the present study was between three groupings of countries based on geography and economic development: Asia, comprising China, India, Malaysia and the Philippines; Eastern Europe, comprising the Czech Republic, Estonia, Hungary, Lithuania, Poland, Russia and Slovakia; and &apos;established market economies&apos;, comprising Australia, Canada, France, Germany, Ireland, Italy, the Netherlands, New Zealand, and the UK.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001474"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:26631737</owl:annotatedTarget>
        <dcterms:title>Genome-wide Association Studies Identify Genetic Loci Associated With Albuminuria in Diabetes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:26631737</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4764151/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Our study was based on 30 discovery and replication studies mostly from the general population, with the exception of Action in Diabetes and Vascular Disease: Preterax and Diamicron MR Controlled Evaluation (ADVANCE) and Genetics of Diabetic Nephropathy (GENDIAN), which enrolled exclusively individuals with type 2 diabetes, totaling 67,452 participants of European ancestry across the different analyses (up to 7,787 with diabetes in discovery and replication).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001474"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multinational randomised controlled trial with a 2×2 factorial design, conducted from 2001 by 215 collaborating centres in 20 countries in Asia, Australasia, Europe and North America among people with type 2 diabetes diagnosed at age 30 or older, aged 55 or older and with cardiovascular disease or at least one other cardiovascular risk factor, which compared a fixed combination of perindopril and indapamide with placebo, whatever the initial blood pressure, and an intensive gliclazide modified-release-based glucose control regimen targeting an HbA1c of 6.5% or less with standard glucose control, for their effects on major macrovascular and microvascular events; surviving participants were followed after the trial in ADVANCE-ON.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11596665</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:16075030</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21972410</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31967344</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001474"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11140</owl:annotatedTarget>
        <obo:IAO_0000116>participants randomised (2003)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.nature.com/articles/1001890</oboInOwl:hasDbXref>
        <rdfs:comment>Following successful recruitment and randomisation of 11 140 participants by March 2003, the study is currently half way through its planned follow-up of 4.5 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001474"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ADVANCE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001474"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ADVANCE_TRIAL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001475 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001475">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13331"/>
        <rdf:type rdf:nodeID="genid13333"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:40691366</obo:IAO_0000112>
        <obo:IAO_0000115>A biobank study at University Medical Center Utrecht and St. Antonius Hospital Nieuwegein, the Netherlands, set up in 2003 as a derivative of the Athero-Express, of patients undergoing open surgical repair of abdominal aortic and other arterial aneurysms, which stores aneurysm wall tissue collected during surgery together with blood, clinical data and three years of follow-up for cardiovascular events, to study aneurysm heterogeneity in relation to postoperative outcomes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">503</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AEB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Abdominal Aortic Aneurysm Express Biobank Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Aneurysm Express Biobank Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Aneurysm-Express Biobank Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Aneurysm-Express biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Aneurysm-Express biobank study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Aneurysm-Express study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Aneurysm-Express Biobank Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13331">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005160"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid13333">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005350"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001475"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13331"/>
        <obo:IAO_0000116>arterial aneurysm</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4220929/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Aneurysm-Express study (which is a derivative of the previously mentioned Athero-Express study) is a longitudinal biobank study that includes aneurysm tissue from all patients undergoing open surgical abdominal aortic aneurysm (AAA) repair in two Dutch hospitals.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001475"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13333"/>
        <obo:IAO_0000116>abdominal aortic aneurysm</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4220929/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Aneurysm-Express study (which is a derivative of the previously mentioned Athero-Express study) is a longitudinal biobank study that includes aneurysm tissue from all patients undergoing open surgical abdominal aortic aneurysm (AAA) repair in two Dutch hospitals.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001475"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4220929/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Aneurysm-Express study was approved by the institutional review boards of both participating hospitals (University Medical Center Utrecht, Utrecht, The Netherlands, and St. Antonius Hospital, Nieuwegein, The Netherlands) and patients gave written informed consent.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001475"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40691366</owl:annotatedTarget>
        <dcterms:title>Polygenic prediction of body mass index and obesity through the life course and across ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40691366</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12443623/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Lastly, we would like to thank all participants of the Aneurysm-Express Biobank Study; without you these kinds of studies would not be possible.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001475"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A biobank study at University Medical Center Utrecht and St. Antonius Hospital Nieuwegein, the Netherlands, set up in 2003 as a derivative of the Athero-Express, of patients undergoing open surgical repair of abdominal aortic and other arterial aneurysms, which stores aneurysm wall tissue collected during surgery together with blood, clinical data and three years of follow-up for cardiovascular events, to study aneurysm heterogeneity in relation to postoperative outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20720431</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25372389</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31882626</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001475"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">503</owl:annotatedTarget>
        <obo:IAO_0000116>patients whose DNA was extracted for the Aneurysm-Express Genomics Study (inclusions 2003-2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6934821/</oboInOwl:hasDbXref>
        <rdfs:comment>DNA of 503 patients in Aneurysm-Express biobank study was extracted from whole blood EDTA or (when no blood was available) aneurysm tissue samples following standardized in-house validated protocols for the Aneurysm-Express Genomics Study (AAAGS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001475"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AEB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001476 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001476">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13340"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000855"/>
        <obo:IAO_0000112>PMID:40691366</obo:IAO_0000112>
        <obo:IAO_0000115>A biobank and ongoing prospective registry of patients with atrial fibrillation from the arrhythmia clinic of the Department of Medicine I, University Hospital Munich, Ludwig-Maximilians-University, Germany, established within the Arrhythmia-Biobank-LMU with support from the German Federal Ministry of Education and Research, which collects blood samples and clinical data and follows patients for recurrence of atrial fibrillation after rhythm-control interventions such as catheter ablation.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3573</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AFLMU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AFLMU Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AFLMU study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Atrial Fibrillation Biobank Ludwig Maximilian University Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Atrial Fibrillation Biobank LMU</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13340">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004981"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001476"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13340"/>
        <obo:IAO_0000116>atrial fibrillation</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7455124/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Third, while the AFLMU data set is rather large for an AF ablation cohort with biomarkers, further studies in independent patient data sets, ideally assessing atrial PITX2 and plasma BMP10 concentrations in the same patients, are warranted to confirm our findings.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001476"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7080569/</oboInOwl:hasDbXref>
        <rdfs:comment>The AFLMU Biobank has been established at the Department of Medicine I at the University Hospital Munich of the Ludwig-Maximilians-University of Munich Germany with the support of the German Federal Ministry of Education and Research (BMBF).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001476"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
