    <!-- http://www.ebi.ac.uk/coho/COHO_0001680 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001680">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15059"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:24516880</obo:IAO_0000112>
        <obo:IAO_0000115>A clinic-based, cross-sectional study of patients referred for assessment of osteoporosis in Edinburgh and the Lothians, Scotland, supported by Arthritis Research UK, with bone mineral density measurements, fracture histories documented from medical records and radiographs, and DNA. It has been used in genetic association studies of bone density and fracture, including de novo replication genotyping for the GEFOS consortium&apos;s meta-analyses and the replication stages of vertebral fracture GWAS.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2020</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>EDOS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Edinburgh Osteoporosis Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15059">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005298"/>
    </owl:Restriction>
