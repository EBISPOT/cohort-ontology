        <oboInOwl:hasRelatedSynonym>proteopathic disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>proteopathy</oboInOwl:hasRelatedSynonym>
        <rdfs:label>proteostasis deficiencies</rdfs:label>
    </owl:Class>
    


