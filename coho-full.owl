        <rdfs:comment>Incident Latino PrCa cases were identified by linking with the cancer registries in Hawaii and California.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001199"/>
