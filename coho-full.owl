    <!-- http://www.ebi.ac.uk/coho/COHO_0001137 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001137">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10380"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <obo:IAO_0000112>GCST90026609</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised, multicentre trial of the Cancer and Leukemia Group B (now the Alliance for Clinical Trials in Oncology), begun in the United States in 2008, of first-line endocrine therapy alone or with bevacizumab for women with hormone receptor-positive advanced-stage breast cancer who were postmenopausal or receiving ovarian suppression: a phase III comparison with letrozole, run in parallel with a phase II comparison with tamoxifen.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">394</coho:numberOfParticipants>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">CALGB 40503</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10380">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006256"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001137"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10380"/>
        <obo:IAO_0000116>hormone receptor-positive metastatic breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27138575+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Women with hormone receptor-positive MBC were randomly assigned 1:1 in a multicenter, open-label, phase III trial of letrozole (2.5 mg orally per day) with or without bevacizumab (15 mg/kg intravenously once every 3 weeks) within strata defined by measurable disease and disease-free interval.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001137"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5012690/</oboInOwl:hasDbXref>
        <rdfs:comment>The following institutions (along with the principal investigator and grant number) participated in this study: Colorado Cancer Research Program (National Cancer Institute Community Oncology Research Program [NCORP]), Denver, CO</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001137"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90026609</owl:annotatedTarget>
        <dcterms:title>Bevacizumab-induced hypertension and proteinuria: a genome-wide study of more than 1000 patients.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34616010</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8770703/</oboInOwl:hasDbXref>
        <rdfs:comment>The genotyping and QC for CALGB 40503 has not been previously reported and it is described in the Supplementary File.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001137"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised, multicentre trial of the Cancer and Leukemia Group B (now the Alliance for Clinical Trials in Oncology), begun in the United States in 2008, of first-line endocrine therapy alone or with bevacizumab for women with hormone receptor-positive advanced-stage breast cancer who were postmenopausal or receiving ovarian suppression: a phase III comparison with letrozole, run in parallel with a phase II comparison with tamoxifen.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27138575</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT00601900</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001137"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">394</owl:annotatedTarget>
        <obo:IAO_0000116>women enrolled across the letrozole phase III and tamoxifen phase II parts (registry actual enrolment)</obo:IAO_0000116>
