    <!-- http://www.ebi.ac.uk/coho/COHO_0001362 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001362">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid12318"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002462"/>
        <obo:IAO_0000112>GCST90104709</obo:IAO_0000112>
        <obo:IAO_0000115>A breast cancer case-control study in Stockholm, Sweden, whose cases are consecutive breast cancer patients treated at the oncology departments of Huddinge and Söder hospitals from 1998 to 2000 and women with familial breast cancer without BRCA1 or BRCA2 mutations seen at the Department of Clinical Genetics of Karolinska University Hospital from 2000, and whose controls are blood donors from the same region, used to study inherited susceptibility to breast cancer.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">722</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">662</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>KARBAC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KARBAC cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KARBAC study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Karolinska Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12318">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001362"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12318"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8909613/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We included 3215 invasive breast cancer cases from two Swedish cohorts, KARMA (n = 2712) and KARBAC (n = 503), and controls without family history of breast cancer from KARMA (n = 5032) in the analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001362"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8909613/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We included 3215 invasive breast cancer cases from two Swedish cohorts, KARMA (n = 2712) and KARBAC (n = 503), and controls without family history of breast cancer from KARMA (n = 5032) in the analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001362"/>
