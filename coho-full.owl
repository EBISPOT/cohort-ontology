        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000854"/>
        <obo:IAO_0000112>PGS000344</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33901219</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing multi-ethnic cohort of breast cancer patients aged 21 years and over who are citizens or permanent residents of Singapore, recruited from April 2010 at the National University Hospital and later at five other public tertiary hospitals in Singapore, with retrospective and prospective components, questionnaire, medical record and biospecimen data and follow-up through linkage with the Registry of Births and Deaths, established to identify genetic markers of breast cancer risk, prognosis and treatment response and to study ethnic differences in breast cancer risk and outcome in Asia.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7768</coho:numberOfCases>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7768</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SGBCC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Singapore Breast Cancer Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20155">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004658"/>
