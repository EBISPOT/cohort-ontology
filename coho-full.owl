    <!-- http://www.ebi.ac.uk/coho/COHO_0001935 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001935">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>PMID:29113070</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing prospective internet-based cohort (e-cohort) of students aged 18 or over who are enrolled at a university or other higher education institution in France and can read French, recruiting since February 2013 with the support of the universities of Bordeaux, Versailles and Nice, which collects online questionnaires on sociodemographic and academic characteristics, health status, personal and family medical history, lifestyle and mental health to study the health of university students over ten years.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14795</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Internet-based Students HeAlth Research Enterprise</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Internet-based Students&apos; Health Research Enterprise</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>i-Share</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>i-Share cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>i-Share project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>i-Share study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>internet-based Students Health Research Enterprise</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Internet-based Students Health Research Enterprise</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001935"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6561426/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study is based on the internet-based Students Health Research Enterprise (i-Share, www.i-share.fr) project, a prospective population-based cohort study of students in higher education institutions in France.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001935"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29113070</owl:annotatedTarget>
        <dcterms:title>Electronic Cigarette Use in Students and Its Relation with Tobacco-Smoking: A Cross-Sectional Analysis of the i-Share Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29113070</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29113070+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In 2016, data were collected from 2720 French-speaking students participating in a web-based study on students&apos; health: the internet-based Students Health Research Enterprise (i-Share) project.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001935"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing prospective internet-based cohort (e-cohort) of students aged 18 or over who are enrolled at a university or other higher education institution in France and can read French, recruiting since February 2013 with the support of the universities of Bordeaux, Versailles and Nice, which collects online questionnaires on sociodemographic and academic characteristics, health status, personal and family medical history, lifestyle and mental health to study the health of university students over ten years.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29113070</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31167858</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001935"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14795</owl:annotatedTarget>
        <obo:IAO_0000116>students included in the cohort from February 2013 to 6 February 2016 (recruitment ongoing)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6561426/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As of 6 February 2016, 14 795 participants were included in the cohort, with the average age being 21 years and 74% were female.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001935"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>i-Share</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001936 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001936">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17072"/>
        <rdf:type rdf:nodeID="genid17074"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:16839190</obo:IAO_0000112>
        <obo:IAO_0000115>The programme of the International Studies of Infarct Survival (ISIS) collaborative group, which ran large randomised trials of treatments for suspected acute myocardial infarction (ISIS-1 to ISIS-4) through collaborating hospitals, and its case-control study in more than 100 UK hospitals, in which blood was taken from ISIS-3 patients on admission and, in the early 1990s, surviving patients of the ISIS-3 and ISIS-4 trials aged 30-79, their siblings and children, and those relatives&apos; spouses, who served as controls, completed postal questionnaires on smoking and other habits and were asked for blood, for studies of smoking, blood markers and genetic variants in relation to the risk of non-fatal myocardial infarction.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13926</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32389</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>ISIS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ISIS case-control study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International Study of Infarct Survival</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">International Studies of Infarct Survival</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17072">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005068"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid17074">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000038"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001936"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17072"/>
        <obo:IAO_0000116>myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.bmj.com/content/311/7003/471</oboInOwl:hasDbXref>
        <rdfs:comment>In the early 1990s responses to a postal questionnaire were obtained from 13926 survivors of myocardial infarction (cases) recently discharged from hospitals in the United Kingdom and 32389 of their relatives (controls).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001936"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17074"/>
        <obo:IAO_0000116>cigarette smoking</obo:IAO_0000116>
        <obo:IAO_0000116>tar yields of manufactured cigarettes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.bmj.com/content/311/7003/471</oboInOwl:hasDbXref>
        <rdfs:comment>To assess the effects of cigarette smoking on the incidence of non-fatal myocardial infarction, and to compare tar in different types of manufactured cigarettes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001936"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1487176/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The chief acknowledgement for the ISIS study is to the patients and their relatives who collaborated, to their general practitioners, and to the medical and nursing staff from more than 100 hospitals in the UK.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001936"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:16839190</owl:annotatedTarget>
        <dcterms:title>Lymphotoxin-alpha gene and risk of myocardial infarction in 6,928 cases and 2,712 controls in the ISIS case-control study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:16839190</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1487176/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We examined the association of seven single nucleotide polymorphisms (SNPs) across the LTA gene, and their related haplotypes, with risk of myocardial infarction (MI) in the International Study of Infarct Survival (ISIS) case-control study involving 6,928 non-fatal MI cases and 2,712 unrelated controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001936"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The programme of the International Studies of Infarct Survival (ISIS) collaborative group, which ran large randomised trials of treatments for suspected acute myocardial infarction (ISIS-1 to ISIS-4) through collaborating hospitals, and its case-control study in more than 100 UK hospitals, in which blood was taken from ISIS-3 patients on admission and, in the early 1990s, surviving patients of the ISIS-3 and ISIS-4 trials aged 30-79, their siblings and children, and those relatives&apos; spouses, who served as controls, completed postal questionnaires on smoking and other habits and were asked for blood, for studies of smoking, blood markers and genetic variants in relation to the risk of non-fatal myocardial infarction.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16839190</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:1746418</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19567438</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:7647641</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001936"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">13926</owl:annotatedTarget>
        <obo:IAO_0000116>UK survivors of myocardial infarction from the ISIS-3 and ISIS-4 trials (cases) and their relatives (controls) who returned the case-control study&apos;s postal questionnaires in the early 1990s</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.bmj.com/content/311/7003/471</oboInOwl:hasDbXref>
        <rdfs:comment>In the early 1990s responses to a postal questionnaire were obtained from 13926 survivors of myocardial infarction (cases) recently discharged from hospitals in the United Kingdom and 32389 of their relatives (controls).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001936"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32389</owl:annotatedTarget>
        <obo:IAO_0000116>UK survivors of myocardial infarction from the ISIS-3 and ISIS-4 trials (cases) and their relatives (controls) who returned the case-control study&apos;s postal questionnaires in the early 1990s</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.bmj.com/content/311/7003/471</oboInOwl:hasDbXref>
        <rdfs:comment>In the early 1990s responses to a postal questionnaire were obtained from 13926 survivors of myocardial infarction (cases) recently discharged from hospitals in the United Kingdom and 32389 of their relatives (controls).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001936"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ISIS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001937 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001937">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17082"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS004611</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:37188791</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing adaptive phase II platform clinical trial, run collaboratively by academic investigators, the US National Cancer Institute, the US Food and Drug Administration and industry under the Foundation for the NIH Biomarkers Consortium, conducted at multiple clinical sites in the United States with participants continuously enrolled since 2010, testing novel neoadjuvant therapeutic agents and biomarkers in women with locally advanced, high-risk breast cancer.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1123</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>I-SPY 2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>I-SPY 2 TRIAL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>I-SPY2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Investigation of Serial Studies to Predict Your Therapeutic Response With Imaging and Molecular Analysis 2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Investigation of Serial Studies to Predict Your Therapeutic Response with Imaging And moLecular analysis 2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Investigation of Serial studies to Predict Your Therapeutic Response with Imaging And molecular anaLysis 2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Investigation of Serial Studies to Predict Your Therapeutic Response with Imaging And molecular analysis 2</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17082">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006256"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001937"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17082"/>
        <obo:IAO_0000116>locally advanced breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19440188+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The framework is an adaptive phase II clinical trial design in the neoadjuvant setting for women with locally advanced breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001937"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42530945+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The I-SPY2 (Investigation of Serial Studies to Predict Your Therapeutic Response With Imaging and Molecular Analysis 2) is an ongoing randomized clinical platform trial being conducted at multiple US clinical sites including patients with early-stage (II or III) ERBB2-negative, high-risk breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001937"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS004611</owl:annotatedTarget>
        <dcterms:title>Development and testing of a polygenic risk score for breast cancer aggressiveness.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37188791</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001937"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:37188791</owl:annotatedTarget>
        <dcterms:title>Development and testing of a polygenic risk score for breast cancer aggressiveness.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37188791</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10185660/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We developed the ROR-P PRS using 2363 breast cancers from three studies: The Cancer Genome Atlas (TCGA)21, Molecular Taxonomy of Breast Cancer International Consortium (METABRIC)22, and Investigation of Serial Studies to Predict Your Therapeutic Response with Imaging And molecular analysis 2 (I-SPY 2 TRIAL)23 (Fig. 1, Supplementary Table 1, Supplementary Fig. 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001937"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing adaptive phase II platform clinical trial, run collaboratively by academic investigators, the US National Cancer Institute, the US Food and Drug Administration and industry under the Foundation for the NIH Biomarkers Consortium, conducted at multiple clinical sites in the United States with participants continuously enrolled since 2010, testing novel neoadjuvant therapeutic agents and biomarkers in women with locally advanced, high-risk breast cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19440188</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42530945</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Sonnet 5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001937"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1123</owl:annotatedTarget>
        <obo:IAO_0000116>patients randomized from March 2010 to November 2016 (the first 10 therapies, including control)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7378873/</oboInOwl:hasDbXref>
        <rdfs:comment>From March 3, 2010, to November 5, 2016, a total of 1896 patients were screened for eligibility for the trial, and 1123 were randomized; 773 patients did not proceed to randomization for various reasons (Figure 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001937"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>I-SPY 2</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001937"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>I-SPY 2 TRIAL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001937"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>I-SPY2</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001938 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001938">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000428"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. deCODE genetics describes its sick sinus syndrome sample set among its Icelandic data (&apos;The deCODE genetics SSS sample consisted of 3577 Icelanders diagnosed with SSS&apos;, PMID:33580673): the sample is part of the deCODE genetics Icelandic cohort. The Catalog&apos;s name describes only that disease subset and is not carried over. Replaced by COHO:0000428 (deCODE genetics Icelandic cohort), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Icelandic Sick Sinus Syndrome sample</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001939 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001939">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:25798622</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of non-diabetic adults of European ancestry pooled from studies of insulin resistance carried out at Stanford University over about ten years, whose insulin sensitivity was measured directly by the insulin suppression test (as steady-state plasma glucose) and who were genotyped genome-wide for genetic studies of insulin sensitivity and related traits.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">448</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>IST</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stanford IST</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stanford IST Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stanford IST cohort</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Stanford Insulin Suppression Test Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001939"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4030103/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Sample collection for the Stanford IST Cohort was carried out in part in the Clinical and Translational Research Unit, Stanford University</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001939"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25798622</owl:annotatedTarget>
        <dcterms:title>Identification and validation of N-acetyltransferase 2 as an insulin sensitivity gene.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25798622</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4409020/</oboInOwl:hasDbXref>
        <rdfs:comment>The four studies in the GWAS included the RISC consortium (n = 1,004), ULSAM (Uppsala Longitudinal Study of Adult Men; n = 899), the EUGENE2 consortium (n = 591), and the Stanford IST cohort (n = 270).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001939"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of non-diabetic adults of European ancestry pooled from studies of insulin resistance carried out at Stanford University over about ten years, whose insulin sensitivity was measured directly by the insulin suppression test (as steady-state plasma glucose) and who were genotyped genome-wide for genetic studies of insulin sensitivity and related traits.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23378610</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23583979</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24296717</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25798622</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001939"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">448</owl:annotatedTarget>
        <obo:IAO_0000116>genotyped cohort members (total sample size in the heart-rate GWAS study table; 327 analysed)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2610/MediaObjects/41588_2013_BFng2610_MOESM4_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Stanford IST cohort Stanford Study Population-based 448 &gt;98.5% Eigenvector analysis; Duplicates identified by PLINK 327 Peripheral pulse rate</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
