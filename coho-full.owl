        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6355367/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The participants were from the Georgia Stress and Heart (GSH) study, an ongoing longitudinal study designed to evaluate the development of cardiovascular risk factors from childhood to adulthood</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000910"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6355367/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>All participants were recruited using family health history questionnaires obtained from a county-wide (Richmond County, Georgia) public school screening of children in kindergarten through grade 8 whose families were interested in health research.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
