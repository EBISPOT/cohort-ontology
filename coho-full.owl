        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8817039/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>we used data from the Gene-Environment of Interaction and phenotype (GENIE) cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000186"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of Korean participants undergoing comprehensive health examinations at Seoul National University Hospital&apos;s Gangnam Center, with linked clinical and biobank data used to investigate genetic and environmental influences on phenotypes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35121771</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>GPT-6 (OpenAI Codex), 2026-09</dcterms:contributor>
    </owl:Axiom>
