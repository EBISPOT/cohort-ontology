    <!-- http://www.ebi.ac.uk/coho/COHO_0002512 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002512">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21258"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:2097090</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre randomised intervention trial in the United Kingdom, begun in 1977 and expanded to 23 centres by 1987, of patients aged 25–65 years with newly diagnosed type 2 diabetes, who after initial diet treatment were randomly allocated to intensive blood-glucose control (with a sulphonylurea or insulin, or metformin for overweight patients) or to conventional diet-based treatment, with the Hypertension in Diabetes Study nested in a factorial design comparing tight with less tight blood-pressure control; its participants were followed for diabetic complications and death for decades after the intervention ended.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4209</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>UKPDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>United Kingdom Prospective Diabetes Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">UK Prospective Diabetes Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21258">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002512"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21258"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1778353+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The UK Prospective Diabetes Study (UKPDS) is a multi-centre, prospective, randomised, intervention trial of 5100 newly-diagnosed patients with Type 2 (non-insulin-dependent) diabetes mellitus which aims to determine whether improved blood glucose control will prevent complications and reduce the associated morbidity and mortality.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002512"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:2097090</owl:annotatedTarget>
        <dcterms:title>UK Prospective Diabetes Study 6. Complications in newly diagnosed type 2 diabetic patients and their association with different clinical and biochemical risk factors.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:2097090</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2097090+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The patients entered into the UK Prospective Diabetes Study were aged between 25 and 65 (mean age 52 yr) and 33% had either an abnormal ECG or retinopathy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002512"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre randomised intervention trial in the United Kingdom, begun in 1977 and expanded to 23 centres by 1987, of patients aged 25–65 years with newly diagnosed type 2 diabetes, who after initial diet treatment were randomly allocated to intensive blood-glucose control (with a sulphonylurea or insulin, or metformin for overweight patients) or to conventional diet-based treatment, with the Hypertension in Diabetes Study nested in a factorial design comparing tight with less tight blood-pressure control; its participants were followed for diabetic complications and death for decades after the intervention ended.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:1778353</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40485651</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9742976</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002512"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4209</owl:annotatedTarget>
        <obo:IAO_0000116>UKPDS participants randomized to glycaemic-control policies (1991)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38772405+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>5102 patients enrolled between 1977 and 1991, of whom 4209 (82·5%) participants were originally randomly allocated to receive either intensive glycaemic control (sulfonylurea or insulin, or if overweight, metformin) or conventional glycaemic control (primarily diet).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002512"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>UKPDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002513 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002513">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21264"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:20453842</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of adult patients with rheumatoid arthritis fulfilling the 1987 American College of Rheumatology criteria, and of healthy controls, assembled for genetic studies by the UK Rheumatoid Arthritis Genetics consortium, a collaboration of six UK rheumatology research groups. Cases were recruited in Manchester, Aberdeen, Leeds, Sheffield, London and Oxford, mostly from NHS rheumatology clinics but also from the Arthritis Research Campaign National Repository of Family Material and the Norfolk Arthritis Register, and controls in five of these centres; its samples were used to replicate and extend rheumatoid arthritis susceptibility loci from genome-wide association studies.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5063</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3849</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>UK Rheumatoid Arthritis Genetics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK Rheumatoid Arthritis Genetics Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK Rheumatoid Arthritis Genetics Group</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UKRAG</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">United Kingdom Rheumatoid Arthritis Genetics</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21264">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008383"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002513"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21264"/>
        <obo:IAO_0000116>rheumatoid arthritis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2978888/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>DNA samples for 3,838 RA cases and 2,719 healthy unrelated controls were made available from the UK Rheumatoid Arthritis Genetics (UKRAG) consortium, a collaboration of six UK rheumatology research groups.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002513"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2978888/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>DNA samples for 3,838 RA cases and 2,719 healthy unrelated controls were made available from the UK Rheumatoid Arthritis Genetics (UKRAG) consortium, a collaboration of six UK rheumatology research groups.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002513"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20453842</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study meta-analysis identifies seven new rheumatoid arthritis risk loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20453842</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4243840/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>(7) CCP or RF positive cases recruited at multiple sites in the United Kingdom by the United Kingdom Rheumatoid Arthritis Genetics (UKRAG) collaboration</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002513"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of adult patients with rheumatoid arthritis fulfilling the 1987 American College of Rheumatology criteria, and of healthy controls, assembled for genetic studies by the UK Rheumatoid Arthritis Genetics consortium, a collaboration of six UK rheumatology research groups. Cases were recruited in Manchester, Aberdeen, Leeds, Sheffield, London and Oxford, mostly from NHS rheumatology clinics but also from the Arthritis Research Campaign National Repository of Family Material and the Norfolk Arthritis Register, and controls in five of these centres; its samples were used to replicate and extend rheumatoid arthritis susceptibility loci from genome-wide association studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17982455</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19898481</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20852893</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002513"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5063</owl:annotatedTarget>
        <obo:IAO_0000116>rheumatoid arthritis cases and healthy controls of the six-centre UK validation cohort, the UKRAG collection as described in detail in 2007 (2007 report)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2674282/</oboInOwl:hasDbXref>
        <rdfs:comment>SNPs at these loci were genotyped in an independent cohort of 5,063 rheumatoid arthritis cases and 3,849 healthy controls</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002513"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3849</owl:annotatedTarget>
        <obo:IAO_0000116>rheumatoid arthritis cases and healthy controls of the six-centre UK validation cohort, the UKRAG collection as described in detail in 2007 (2007 report)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2674282/</oboInOwl:hasDbXref>
        <rdfs:comment>SNPs at these loci were genotyped in an independent cohort of 5,063 rheumatoid arthritis cases and 3,849 healthy controls</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002513"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>UKRAG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
