    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001160"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/New_Zealand"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41321066+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Study members from the Christchurch Health and Development Study, a population-based New Zealand birth cohort study (N = 1265 at birth) were followed to age 40 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001160"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90568440</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of childhood ADHD symptoms and diagnosis identifies new loci and potential effector genes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40962958</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02295-y/MediaObjects/41588_2025_2295_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Christchurch Health and Development Study, a longitudinal study of the life course development of a</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001160"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based longitudinal birth cohort of the children born in the Christchurch urban region of New Zealand during a four-month period from April to August 1977, studied by the University of Otago, Christchurch, at birth, 4 months, 1 year, annually to age 16 and at intervals into adulthood (to age 40), on their health, development, social circumstances and wellbeing across the life course.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33096046</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40212739</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41321066</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001160"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
