        <owl:annotatedTarget>The Philadelphia site of the Breast Cancer Family Registry, run from Fox Chase Cancer Center in Philadelphia, Pennsylvania, which from 1996 enrolled families with breast or ovarian cancer through family cancer clinics and community outreach in the Philadelphia area, including Ashkenazi Jewish and minority families, when a woman had breast or ovarian cancer before age 35, both cancers, or bilateral breast cancer first diagnosed before 50, a man had breast cancer, affected relatives spanned two generations or a BRCA1 or BRCA2 mutation was known. Affected and unaffected probands and their relatives gave family-history and epidemiological questionnaires and blood samples and are contacted annually for follow-up, for studies of the genetic epidemiology of breast cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15217505</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26174520</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.bcfamilyregistry.org/for-participants/participating-sites</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001515"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">780</owl:annotatedTarget>
        <obo:IAO_0000116>probands (index family members) recruited at the Philadelphia site 1996-2003; relatives not included</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC468645/</oboInOwl:hasDbXref>
        <rdfs:comment>Total probands 2927 4766 2160 1134 780 183 11,950</rdfs:comment>
    </owl:Axiom>
