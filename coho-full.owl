    <!-- http://www.ebi.ac.uk/coho/COHO_0002460 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002460">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20930"/>
        <rdf:type rdf:nodeID="genid20932"/>
        <rdf:type rdf:nodeID="genid20934"/>
