        <obo:IAO_0000116>acute myeloid leukemia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8548922/fullTextXML</oboInOwl:hasDbXref>
