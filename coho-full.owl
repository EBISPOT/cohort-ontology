        <oboInOwl:hasRelatedSynonym>Genomics Research in Cardiovascular disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Korean GenRIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Genomics Research in Cardiovascular Disease</rdfs:label>
