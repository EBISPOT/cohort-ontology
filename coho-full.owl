        <obo:IAO_0000112>PMID:28835639</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional study of the metabolic syndrome in Germany whose participants, randomly recruited from Berlin, Potsdam and their surroundings, underwent a 75 g oral glucose tolerance test with insulin measurements and nutritional assessment, and included people with normal glucose metabolism as well as people with impaired glucose metabolism or type 2 diabetes; part of it was later re-examined in a follow-up study.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2364</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MESYBEPO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MeSy BePo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MeSyBePo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MesyBePo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MesyBepo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Metabolic Syndrome Berlin Potsdam</oboInOwl:hasRelatedSynonym>
