    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002347"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19992"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6527440/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, 5042 patients with newly diagnosed breast cancer, aged 20 to 75 years, were identified from the Shanghai Cancer Registry between March 2002 and April 2006 and enrolled in the SBCSS approximately 6 months after cancer diagnosis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002347"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19994"/>
        <obo:IAO_0000116>soy food intake</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2874068/</oboInOwl:hasDbXref>
        <rdfs:comment>Our study is the largest population-based study of breast cancer survival to date and was specifically designed to evaluate the influence of soy food intake on breast cancer outcomes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002347"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18928393+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>SUBJECTS/SETTING/LOCATION: Subjects were 5046 women who participated in the SBCSS, conducted in urban Shanghai, China.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002347"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:31157323</owl:annotatedTarget>
        <dcterms:title>Soy Food Consumption, Exercise, and Body Mass Index and Osteoporotic Fracture Risk Among Breast Cancer Survivors: The Shanghai Breast Cancer Survival Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31157323</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6527440/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study used data from the Shanghai Breast Cancer Survival Study (SBCSS), a large population-based longitudinal cohort of 5042 breast cancer survivors.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002347"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort study of breast cancer survivors in urban Shanghai, China, which enrolled women aged 20 to 75 years with newly diagnosed breast cancer identified through the Shanghai Cancer Registry between March 2002 and April 2006, about six months after diagnosis, and followed them in person at 18 months and 3, 5 and 10 years after diagnosis for cancer outcomes, health status, lifestyle and medication use.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18409069</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31157323</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002347"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5042</owl:annotatedTarget>
        <obo:IAO_0000116>women with newly diagnosed breast cancer enrolled 2002-2006</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6527440/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, 5042 patients with newly diagnosed breast cancer, aged 20 to 75 years, were identified from the Shanghai Cancer Registry between March 2002 and April 2006 and enrolled in the SBCSS approximately 6 months after cancer diagnosis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002347"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SBCSS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


