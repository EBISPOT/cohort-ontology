        <obo:IAO_0000112>PMID:27067890</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective birth cohort of pregnant women living in Kaunas municipality, Lithuania, recruited in the first trimester at four prenatal care clinics of the Kaunas University of Medicine hospitals from 2007, first as the Kaunas cohort of the EU HiWATE project on drinking-water contaminants and pregnancy outcomes, and their children, later followed up in childhood and within the HELIX exposome project.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3294</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/KANC</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>HiWATE cohort study</oboInOwl:hasRelatedSynonym>
