    <!-- http://www.ebi.ac.uk/coho/COHO_0002163 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002163">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18677"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001393"/>
        <obo:IAO_0000112>PGS000778</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33495596</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control cohort from the population-based registry of amyotrophic lateral sclerosis (ALS) in the Netherlands, one of the cohorts of the international ALS genome-wide association study linked to Project MinE, whose cases have probable or definite ALS diagnosed by neurologists at the tertiary referral centres University Medical Center Utrecht, Academic Medical Centre Amsterdam and Radboud University Medical Center Nijmegen, and whose controls, free of neuromuscular disease and matched for age, sex and ethnicity, were ascertained through a population-based study of ALS in the Netherlands. Its genotyped controls have been reused as a Dutch control group in other genetic association studies.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1226</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2262</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>Project Mine (Netherlands NL4 controls)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>cohort NL4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">NL4</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18677">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004976"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002163"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18677"/>
        <obo:IAO_0000116>amyotrophic lateral sclerosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3622/MediaObjects/41588_2016_BFng3622_MOESM43_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Cases were diagnosed with probable or definite ALS according to the revised El-Escorial Criteria by neurologists specialized in motor neuron diseases11 . Both cases with and without a family history for ALS were included. Tertiary referral centers for ALS were University Medical Center Utrecht, Academic Medical Centre Amsterdam and Radboud University Medical Center Nijmegen.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002163"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3622/MediaObjects/41588_2016_BFng3622_MOESM43_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>26. NL4, Population based ALS registry, The Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002163"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000778</owl:annotatedTarget>
        <dcterms:title>Shared genetic pathways contribute to risk of hypertrophic and dilated cardiomyopathies with opposite directions of effect.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33495596</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
