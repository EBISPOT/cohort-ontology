        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000536"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002430"/>
        <obo:IAO_0000112>GCST90840420</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of 6,673 men and women aged 45–65 from the greater area of Leiden, the Netherlands, oversampling people with overweight or obesity, recruited in 2008–2012 for extensive phenotyping to investigate the pathways that lead to obesity-related diseases.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6673</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NEO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Netherlands Epidemiology of Obesity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Netherlands Epidemiology of Obesity Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid3638">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011122"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000412"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid3638"/>
        <obo:IAO_0000116>obesity</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://link.springer.com/article/10.1007/s10654-013-9801-3</oboInOwl:hasDbXref>
        <rdfs:comment>The Netherlands Epidemiology of Obesity (NEO) study is designed to investigate the pathways that lead to obesity-related diseases and conditions in a population-based prospective cohort study of individuals aged 45–65 years, with an oversampling of individuals with overweight or obesity.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000412"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13352909/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, men and women aged between 45 and 65 years with a self-reported body mass index (BMI) of 27 kg/m2 or higher living in the greater area of Leiden (in the west of the Netherlands) were eligible to participate in NEO.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000412"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90840420</owl:annotatedTarget>
        <dcterms:title>Genome-wide association studies of missing metabolite measures from two population-based studies.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42426908</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42426908+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We perform a logistic GWAS of metabolite missingness from an untargeted mass spectrometry-based platform in the Netherlands Epidemiology of Obesity Study (N = 594) and the Rhineland Study (N = 4,165).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000412"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort of 6,673 men and women aged 45–65 from the greater area of Leiden, the Netherlands, oversampling people with overweight or obesity, recruited in 2008–2012 for extensive phenotyping to investigate the pathways that lead to obesity-related diseases.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23576214</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11130664/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000412"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6673</owl:annotatedTarget>
        <obo:IAO_0000116>individuals aged 45-65 included 2008-2012</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:23576214</oboInOwl:hasDbXref>
        <rdfs:comment>In total, 6,673 participants have been included, of whom 5,217 with a BMI of 27 kg/m2 or higher.</rdfs:comment>
    </owl:Axiom>
