    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002399"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33185476</owl:annotatedTarget>
        <dcterms:title>Clinical Application of a Novel Genetic Risk Score for Ischemic Stroke in Patients With Cardiometabolic Disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33185476</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7856243/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a genetic cohort analysis pooling individual patient-level data from five cardiovascular clinical trials: ENGAGE AF-TIMI 48, SOLID-TIMI 52, SAVOR-TIMI 53, PEGASUS-TIMI 54, and FOURIER.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
