    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001473"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13313"/>
        <obo:IAO_0000116>attention-deficit hyperactivity disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnpp.2014.267/MediaObjects/41386_2015_BFnpp2014267_MOESM62_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>All patients were adults of Caucasian origin, recruited and evaluated at the Hospital Universitari Vall d’Hebron located in Barcelona (Spain), and met Diagnostic and Statistical Manual for Mental Disorders-IV (DSM-IV) criteria for ADHD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001473"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnpp.2014.267/MediaObjects/41386_2015_BFnpp2014267_MOESM62_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>All patients were adults of Caucasian origin, recruited and evaluated at the Hospital Universitari Vall d’Hebron located in Barcelona (Spain), and met Diagnostic and Statistical Manual for Mental Disorders-IV (DSM-IV) criteria for ADHD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001473"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29531354</owl:annotatedTarget>
        <dcterms:title>Multiancestry genome-wide association study of 520,000 subjects identifies 32 loci associated with stroke and stroke subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29531354</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Vall d&apos;Hebron Research Institute (VHIR) cohort included 435 blood donors of Caucasian origin recruited from 2004 to 2008 at the Hospital Universitari Vall d&apos;Hebron (Barcelona, Spain) to identify loci conferring susceptibility to Attention-Deficit Hyperactivity Disorder.</rdfs:comment>
    </owl:Axiom>
