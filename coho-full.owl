        <rdf:type rdf:nodeID="genid6585"/>
        <rdf:type rdf:nodeID="genid6587"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000134"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000901"/>
        <obo:IAO_0000112>GCST012467</obo:IAO_0000112>
        <obo:IAO_0000115>A collaborative genotyping experiment of four cancer genetics consortia, studying breast cancer (the Breast Cancer Association Consortium), ovarian cancer, prostate cancer, and breast and ovarian cancer in BRCA1 and BRCA2 mutation carriers, funded by the EU Seventh Framework Programme, which genotyped samples from their member studies on a custom Illumina iSelect array (iCOGS) of more than 200,000 SNPs to identify cancer susceptibility loci.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym COGS also denotes Colorectal Cancer Genetic Susceptibility Study (COHO:0001603); this term is Collaborative Oncological Gene-environment Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">239832</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>COGES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Collaborative Oncological Gene-Environment Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Collaborative Oncology Gene-Environment Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Collaborative Oncology Gene-environment Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International Collaborative Oncology Gene-environment Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>iCOGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Collaborative Oncological Gene-environment Study</rdfs:label>
    </owl:NamedIndividual>
