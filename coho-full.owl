        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000661"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre prospective cohort of more than 1,100 patients newly diagnosed with non-muscle-invasive bladder cancer, recruited in 2014–2021 from 22 hospitals in the Netherlands and followed with questionnaires, diaries, blood and tumour samples and cancer registry data to study how lifestyle habits relate to prognosis and health-related quality of life.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31619424</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000661"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1512</owl:annotatedTarget>
        <obo:IAO_0000116>invited eligible patients who agreed to participate, 2014-2021</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11826114/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 3181 invited patients, 2929 met the eligibility criteria, and 1512 (52%) agreed to participate (Figure 1 ).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000661"/>
