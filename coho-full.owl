        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11670</owl:annotatedTarget>
        <obo:IAO_0000116>Han Chinese women recruited (cases and controls)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4522619/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The CONVERGE (China, Oxford and Virginia Commonwealth University Experimental Research on Genetic Epidemiology) consortium recruited 11,670 Han Chinese women through a collaboration involving 58 hospitals in China.</rdfs:comment>
