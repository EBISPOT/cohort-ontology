        <obo:IAO_0000112>PGS000138</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:22472876</obo:IAO_0000112>
        <obo:IAO_0000115>A major depressive disorder case-control sample of the Psychiatric Genomics Consortium from the Partners HealthCare System in the United States, assembled with the i2b2 (Informatics for Integrating Biology and the Bedside) centre, whose cases were identified by natural language processing of electronic medical records with psychiatrist review (an ICD-9 diagnosis of major depressive disorder, confirmed on record review, with depression either responsive to an SSRI or unresponsive to at least two antidepressant trials) and whose controls came from neuroimaging studies, screened by self-reported psychiatric history.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">806</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1067</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1873</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Harvard i2b2 sample</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Integrating Biology &amp; the Bedside</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>i2b2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>i2b2-TRD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>i2b3</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Harvard i2b2</rdfs:label>
