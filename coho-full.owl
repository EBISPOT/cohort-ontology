        <obo:IAO_0000112>PGS000788</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:26956414</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of chronic lymphocytic leukaemia in Utah, United States, whose prevalent cases came from the Huntsman Cancer Hospital&apos;s haematology clinics or were identified in the Utah Cancer Registry and verified by medical records and pathology reports, and whose controls, from the same area, were frequency-matched to the cases by sex and birth cohort using the Utah Population Database; it was genotyped genome-wide for studies of genetic susceptibility to the disease.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym UTAH also denotes UTAH Study (COHO:0002533); this term is Utah Chronic Lymphocytic Leukemia Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">355</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">420</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>UTAH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Utah Chronic Lymphocytic Leukemia GWAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Utah Chronic Lymphocytic Leukemia Study</rdfs:label>
