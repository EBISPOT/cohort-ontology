    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002643"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2287</owl:annotatedTarget>
        <obo:IAO_0000116>eligible participants of wave 1 (2019)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SDACS</oboInOwl:hasDbXref>
        <rdfs:comment>Data were collected across three examination waves in 2019, 2022, and 2024, with 2287, 1518, and 3554 eligible participants included after exclusions, respectively.</rdfs:comment>
    </owl:Axiom>
