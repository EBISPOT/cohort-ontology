    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000494"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90095479</owl:annotatedTarget>
        <dcterms:title>Genomics of Postprandial Lipidomics in the Genetics of Lipid-Lowering Drugs and Diet Network Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34836252</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:34836252%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>in 668 participants from the Genetics of Lipid-Lowering Drugs and Diet Network study (GOLDN)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000494"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family intervention study of the NHLBI Programs in Gene by Environment Interaction, of 1,048 white participants in 184 three-generation pedigrees previously screened at the Minnesota and Utah centres of the NHLBI Family Heart Study, who took a standardised high-fat meal challenge and three weeks of fenofibrate treatment, to study genetic determinants of the lipid response to diet and lipid-lowering drugs.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8617762/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000494"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1048</owl:annotatedTarget>
        <obo:IAO_0000116>Caucasian individuals in 184 pedigrees</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8617762/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GOLDN sample consisted of 1048 Caucasian individuals belonging to 184 pedigrees (average family size 6.2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000494"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GOLDN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000495 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000495">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90428625</obo:IAO_0000112>
        <obo:IAO_0000115>A multi-site, multiethnic, community-based longitudinal cohort of 3,302 women aged 42–52 enrolled in 1996–1997 at seven US sites (Boston, Chicago, Detroit, Los Angeles, Pittsburgh, Oakland and Newark) and followed about yearly to study how women&apos;s physical, biological, psychological and social health in midlife affects health during ageing.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3302</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SWAN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Study of Women&apos;s Health Across the Nation</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000495"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Study of Women’s Health Across the Nation interviewed women in their 40s and 50s from seven U.S. cities approximately yearly to collect information on their physical, biological, psychological, and social health.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000495"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90428625</owl:annotatedTarget>
        <dcterms:title>Circulating anti-Müllerian hormone levels in pre-menopausal women: novel genetic insights from a genome-wide association meta-analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38815977</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11759094/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>SWAN</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000495"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multi-site, multiethnic, community-based longitudinal cohort of 3,302 women aged 42–52 enrolled in 1996–1997 at seven US sites (Boston, Chicago, Detroit, Los Angeles, Pittsburgh, Oakland and Newark) and followed about yearly to study how women&apos;s physical, biological, psychological and social health in midlife affects health during ageing.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000495"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3302</owl:annotatedTarget>
        <obo:IAO_0000116>women enrolled at baseline 1996-1997</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12459529/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of these, a total of 3302 women, comprising 1550 Caucasian, 935 African American, 286 Hispanic, 250 Chinese and 281 Japanese, were deemed eligible and subsequently enrolled into the SWAN cohort for the longitudinal survey, completing the baseline study from January 1996 to December 1997.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000495"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SWAN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000496 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000496">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid4361"/>
        <rdf:type rdf:nodeID="genid4363"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002753"/>
        <obo:IAO_0000112>GCST90451702</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing nationwide multicentre observational study in Finland, established in 1997 and run from the Folkhälsan Research Center and the University of Helsinki, of nearly 9,000 adults with type 1 diabetes recruited and clinically characterised at study centres across the country and followed through re-examinations, national registries and medical records, to identify factors leading to diabetic kidney disease and other diabetic complications.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>FinnDiane</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FinnDiane Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Finnish Diabetic Nephropathy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Finnish Diabetic Nephropathy Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid4361">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005016"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid4363">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005147"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000496"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4361"/>
        <obo:IAO_0000116>diabetic kidney disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11696681/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Finnish diabetic nephropathy study (FinnDiane) is an ongoing (1997-&gt;), nation-wide multicentre study focusing on diabetic complications and currently comprises of over 5000 adults with type 1 diabetes9,10.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000496"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4363"/>
        <obo:IAO_0000116>type 1 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11696681/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Finnish diabetic nephropathy study (FinnDiane) is an ongoing (1997-&gt;), nation-wide multicentre study focusing on diabetic complications and currently comprises of over 5000 adults with type 1 diabetes9,10.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000496"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11696681/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this study, we performed genome-wide association study (GWAS) meta-analyses in a total of 8011 individuals to investigate single nucleotide variants (SNVs) associated with 54 urinary metabolites measured by NMR in one Finnish cohort of individuals with type 1 diabetes (T1D) and two Scottish cohorts from a general population setting.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000496"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90451702</owl:annotatedTarget>
        <dcterms:title>Genome-wide characterization of 54 urinary metabolites reveals molecular impact of kidney function.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39746953</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11696681/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The analysis included in total of 8011 individuals from the Finnish Diabetic Nephropathy Study (FinnDiane, n = 3244, including 1632 men and 1612 women)9,10, Generation Scotland (GS, n = 2743, including 1373 men and 1370 women)11, and the VIKING study (VIKING, n = 2024, including 811 men and 1213 women)12 (Fig. 1, Supplementary Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000496"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing nationwide multicentre observational study in Finland, established in 1997 and run from the Folkhälsan Research Center and the University of Helsinki, of nearly 9,000 adults with type 1 diabetes recruited and clinically characterised at study centres across the country and followed through re-examinations, national registries and medical records, to identify factors leading to diabetic kidney disease and other diabetic complications.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:39235140</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39746953</obo:IAO_0000119>
        <obo:IAO_0000119>https://research.folkhalsan.fi/genetics/finndiane-study</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000496"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9000</owl:annotatedTarget>
        <obo:IAO_0000116>participants with type 1 diabetes (approximate, &apos;nearly 9000&apos;), 2024</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11733665/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Starting as a small‐scale pilot project with the goal of recruiting a few hundred individuals, the FinnDiane Study has evolved over the years into one of the largest well‐characterized cohorts of individuals with type 1 diabetes, now encompassing nearly 9000 participants from across the country.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000496"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FinnDiane</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000497 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000497">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid4370"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90128543</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal multicentre genetic-neuroimaging cohort of about 2,000 healthy 14-year-old adolescents recruited from high schools at eight European sites in England, Ireland, France and Germany, followed up at ages 16, 19 and 22 with behavioural, neuropsychological, MRI and genome-wide data, to study the genetic and neurobiological basis of impulsivity, reinforcer sensitivity and emotional reactivity and their value in predicting psychiatric disorders.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2223</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>IMAGEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IMAGEN cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">IMAGEN study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid4370">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002025"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000497"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4370"/>
        <obo:IAO_0000116>psychiatric disorders</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21102431+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The IMAGEN study is the first multicentre genetic-neuroimaging study aimed at identifying the genetic and neurobiological basis of individual variability in impulsivity, reinforcer sensitivity and emotional reactivity, and determining their predictive value for the development of frequent psychiatric disorders.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000497"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9815590/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were recruited from a diverse range of high schools across eight European sites (Dresden, Berlin, Mannheim, and Hamburg in Germany; London and Nottingham in the U.K.; Dublin in Ireland; and Paris in France).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000497"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90128543</owl:annotatedTarget>
        <dcterms:title>Genetic variants associated with longitudinal changes in brain structure across the lifespan.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35383335</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10040206/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>for the largest adolescent cohort (IMAGEN; N=1,068)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000497"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal multicentre genetic-neuroimaging cohort of about 2,000 healthy 14-year-old adolescents recruited from high schools at eight European sites in England, Ireland, France and Germany, followed up at ages 16, 19 and 22 with behavioural, neuropsychological, MRI and genome-wide data, to study the genetic and neurobiological basis of impulsivity, reinforcer sensitivity and emotional reactivity and their value in predicting psychiatric disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21102431</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32601453</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36603003</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000497"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2223</owl:annotatedTarget>
        <obo:IAO_0000116>adolescents recruited in schools around age 14</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10827811/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Neuroimaging and clinical data were obtained from an existing large European multi-site longitudinal study of adolescent development ( https://imagen-project.org ) across eight European sites in France, United Kingdom, Ireland, and Germany, which includes 2,223 adolescents recruited in schools around age 14 (standard deviation = 0.41; age range: 12.9–15.7).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000497"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IMAGEN</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000498 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000498">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid4377"/>
        <rdf:type rdf:nodeID="genid4379"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <obo:IAO_0000112>GCST000471</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:23377640</obo:IAO_0000112>
        <obo:IAO_0000115>A naturalistic, open-label longitudinal treatment study of inpatients admitted with a moderate to severe unipolar or bipolar depressive episode to the hospital of the Max Planck Institute of Psychiatry in Munich and collaborating hospitals in Southern Bavaria and Switzerland, characterised clinically, neuroendocrinologically (dex/CRH test) and genetically and followed weekly during treatment, to identify predictors of antidepressant treatment response.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MARS also denotes Minority Aging Research Study (COHO:0000499); this term is Munich Antidepressant Response Signature.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">842</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MARS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Munich Antidepressant Response Signature project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Munich Antidepressant Response Signature study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Munich Antidepressant Response Signature</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid4377">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002050"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid4379">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004985"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000498"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4377"/>
        <obo:IAO_0000116>depression</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6387218/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>MARS is a naturalistic open-label longitudinal treatment study with inpatients suffering from a depressive episode.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000498"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4379"/>
        <obo:IAO_0000116>bipolar disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6387218/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>MARS is a naturalistic open-label longitudinal treatment study with inpatients suffering from a depressive episode.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000498"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6387218/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients with a moderate to severe depressive episode were recruited from the hospital of the Max Planck Institute of Psychiatry and collaborating hospitals of Southern Bavaria and Switzerland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000498"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST000471</owl:annotatedTarget>
        <dcterms:title>A genomewide association study points to multiple loci that predict antidepressant drug treatment outcome in depression.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:19736353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:19736353%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a genomewide association study in patients from the Munich Antidepressant Response Signature (MARS) project and in pooled DNA from an independent German replication sample.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000498"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23377640</owl:annotatedTarget>
        <dcterms:title>Common genetic variation and antidepressant efficacy in major depressive disorder: a meta-analysis of three genome-wide pharmacogenetic studies.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23377640</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23377640+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>the Munich Antidepressant Response Signature [MARS] project</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000498"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A naturalistic, open-label longitudinal treatment study of inpatients admitted with a moderate to severe unipolar or bipolar depressive episode to the hospital of the Max Planck Institute of Psychiatry in Munich and collaborating hospitals in Southern Bavaria and Switzerland, characterised clinically, neuroendocrinologically (dex/CRH test) and genetically and followed weekly during treatment, to identify predictors of antidepressant treatment response.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18586274</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30678080</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000498"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">842</owl:annotatedTarget>
        <obo:IAO_0000116>participants recruited by 2008</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10416089/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 842 participants recruited by 2008, 339 were included in a previously reported genome-wide pharmacogenetic study, and additional samples from this cohort have been genotyped since then, resulting in 604 (72%) samples from patients with unipolar depression available for the present meta-analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000498"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MARS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000499 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000499">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid4387"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000561"/>
        <obo:IAO_0000112>GCST90448418</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal epidemiologic cohort of older African Americans without known dementia, recruited from 2004 from churches, senior buildings and community organisations in the Chicago metropolitan area and followed at Rush University Medical Center, with optional brain donation, to study decline in cognitive function and risk of Alzheimer disease.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MARS also denotes Munich Antidepressant Response Signature (COHO:0000498); this term is Minority Aging Research Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">366</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MARS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MARS-AA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Minority Aging Research Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid4387">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004975"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000499"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4387"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22471868+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Minority Aging Research Study (MARS) is a longitudinal, epidemiologic cohort study of decline in cognitive function and risk of Alzheimer&apos;s disease (AD) in older African Americans, with brain donation after death added as an optional component for those willing to consider organ donation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000499"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11350028/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>both MARS and AA Core recruited older African Americans from churches, senior buildings, and social clubs and organizations that serve diverse populations in the Chicago metropolitan area.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000499"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90448418</owl:annotatedTarget>
        <dcterms:title>Sex-specific genetic architecture of late-life memory performance.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37984853</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_json/PMC10917043/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Religious Orders Study (ROS)/Rush Memory and Aging Project (MAP)/Minority Aging Research Study (MARS)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000499"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal epidemiologic cohort of older African Americans without known dementia, recruited from 2004 from churches, senior buildings and community organisations in the Chicago metropolitan area and followed at Rush University Medical Center, with optional brain donation, to study decline in cognitive function and risk of Alzheimer disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22471868</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38934297</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000499"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">366</owl:annotatedTarget>
        <obo:IAO_0000116>persons enrolled by the time of the 2012 design paper</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3409294/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>After discussing the study in detail with each potential participant, 223 were found to be inelligible because they were either too young, had a prior dementia diagnosis, or were taking AD medications, 112 refused, 71 were reluctant, and 366 persons enrolled in the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000499"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MARS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000499"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MARS-AA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000500 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000500">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>GCST90128543</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal study of Australian twins aged 65 years and over, with some of their equivalently aged siblings, recruited through the Australian Twin Registry and a recruitment drive and assessed every two years with psychiatric, neuropsychological, cardiovascular, metabolic, neuroimaging and genetic measures, to study genetic and environmental influences on healthy brain ageing and ageing-related neurocognitive disorders.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">623</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>OATS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Older Australian Twin Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Older Australian Twins Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000500"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90128543</owl:annotatedTarget>
        <dcterms:title>Genetic variants associated with longitudinal changes in brain structure across the lifespan.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35383335</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10040206/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Older Australian Twin Study (OATS) is supported by the Australian NHMRC/Australian Research Council Strategic Award (Grant 401162) and the NHMRC Project grant 1405325.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000500"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal study of Australian twins aged 65 years and over, with some of their equivalently aged siblings, recruited through the Australian Twin Registry and a recruitment drive and assessed every two years with psychiatric, neuropsychological, cardiovascular, metabolic, neuroimaging and genetic measures, to study genetic and environmental influences on healthy brain ageing and ageing-related neurocognitive disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19943720</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27030319</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000500"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">623</owl:annotatedTarget>
        <obo:IAO_0000116>twins and their siblings aged 65+ recruited</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9896753/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>OATS recruited 623 twins and their siblings, aged 65 years and older and residing in New South Wales, Victoria or Queensland from the Australian Twin Registry.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000500"/>
