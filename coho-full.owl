    <!-- http://www.ebi.ac.uk/coho/COHO_0002387 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002387">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid20259"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000864"/>
        <obo:IAO_0000112>PMID:28025329</obo:IAO_0000112>
        <obo:IAO_0000115>A South Korean multi-centre lung cancer study that brings together three previously described case-control studies of ethnic Koreans, the Seoul National University study, the Korea University Medical Center study and the Kyungpook National University Hospital study, which recruited lung cancer patients at university hospitals and a lung cancer research centre and controls from hospital health check-up programmes; it takes part in the Female Lung Cancer Consortium in Asia as one study.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">546</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1082</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>SKLCS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">South Korea Multi-Center Lung Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20259">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002387"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20259"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The SKLCS study of lung cancer in Korea consists of several studies conducted at multiple study centers, which have been previously described6-8 , as follows: The SNU study of lung cancer in Korea was conducted between 2001 and 2008 and is described in. The lung cancer patients were recruited from patients at Seoul National University Hospitals in Seoul and Bundang</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002387"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>SKLCS South Korea 546 419 28 1082</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002387"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28025329</owl:annotatedTarget>
        <dcterms:title>Association between GWAS-identified lung adenocarcinoma susceptibility loci and EGFR mutations in never-smoking Asian women, and comparison with findings from Western populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28025329</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5856088/</oboInOwl:hasDbXref>
        <rdfs:comment>These 11 study centres include the Chinese Academy of Medical Sciences Cancer Hospital Study (CAMSCH), the Guangdong Study (GDS), the Genetic Epidemiological Study of Lung Adenocarcinoma (GELAC), the Hong Kong Study (HKS), the Hospital-based Epidemiologic Research Program at Aichi Cancer Center (HERPACC), the Japan National Cancer Center (NCC), the South Korea Multi-Center Lung Cancer Study (SKLCS- Korea University, Kyungpook University, Seoul National University Department of Preventive Medicine (SNUPM)), the Chonnam National University Lung Cancer Study (CNUCLS), and the Tianjin Lung Cancer Study (TLCS), which have all been previously described (4,10,38–44).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002387"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A South Korean multi-centre lung cancer study that brings together three previously described case-control studies of ethnic Koreans, the Seoul National University study, the Korea University Medical Center study and the Kyungpook National University Hospital study, which recruited lung cancer patients at university hospitals and a lung cancer research centre and controls from hospital health check-up programmes; it takes part in the Female Lung Cancer Consortium in Asia as one study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23143601</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28025329</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002387"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">546</owl:annotatedTarget>
        <obo:IAO_0000116>never-smoking female lung cancer cases and controls that SKLCS contributed to the 2012 FLCCA GWAS (Supplementary Table 1 columns: all cases, adenocarcinomas, squamous cell carcinomas, controls); no total stated</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>SKLCS South Korea 546 419 28 1082 61.6(11.0) 61.6(10.7) 63.6(11.2) 51.1(14.7) NA*</rdfs:comment>
    </owl:Axiom>
