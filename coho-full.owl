        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Iceland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90102434</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre randomised controlled trial that recruited hypertensive men and women aged 40–79 with at least three other cardiovascular risk factors, mostly through family practices in the United Kingdom, Ireland and the Nordic countries between February 1998 and May 2000, to compare an amlodipine-based with an atenolol-based antihypertensive regimen for preventing coronary and other cardiovascular events (the Blood Pressure-Lowering Arm), those with total cholesterol of 6.5 mmol/L or less being also randomised to atorvastatin or placebo in a factorial Lipid-Lowering Arm.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19342</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ASCOT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Anglo Scandinavian Cardiac Outcomes Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Anglo-Scandinavian Cardiac Outcome Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Anglo-Scandinavian cardiac Outcomes Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Anglo-Scandinavian Cardiac Outcomes Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11596">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid11598">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005044"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001282"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11596"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12322408/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>ASCOT was a prospective randomised controlled trial of two different blood pressure-lowering strategies in 19 342 hypertensive subjects with three additional risk factors for CV disease—ASCOT Blood Pressure-Lowering Arm (BPLA).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001282"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11598"/>
        <obo:IAO_0000116>hypertension</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12322408/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>ASCOT was a prospective randomised controlled trial of two different blood pressure-lowering strategies in 19 342 hypertensive subjects with three additional risk factors for CV disease—ASCOT Blood Pressure-Lowering Arm (BPLA).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001282"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8769168/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>For this genome-wide study only a proportion of United Kingdom, Irish, Sweden, Norway, Finland and Denmark consented to participate.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001282"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Iceland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10984564/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The protocol and all subsequent amendments were reviewed and ratified by central and regional ethics review boards in the UK and by national ethics and statutory bodies in Ireland and the Nordic countries (Sweden, Denmark, Iceland, Norway, and Finland).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001282"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10984564/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the Nordic countries, participants were recruited from 686 family practices and in the UK and Ireland, most participants were referred from family practices to the regional centres for the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001282"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90102434</owl:annotatedTarget>
        <dcterms:title>The Pharmacogenetics of Statin Therapy on Clinical Events: No Evidence that Genetic Variation Affects Statin Response on Myocardial Infarction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35069183</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8769168/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Anglo-Scandinavian Cardiac Outcomes Trial (ASCOT) trial was funded by an investigator-initiated grant from Pfizer USA.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001282"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre randomised controlled trial that recruited hypertensive men and women aged 40–79 with at least three other cardiovascular risk factors, mostly through family practices in the United Kingdom, Ireland and the Nordic countries between February 1998 and May 2000, to compare an amlodipine-based with an atenolol-based antihypertensive regimen for preventing coronary and other cardiovascular events (the Blood Pressure-Lowering Arm), those with total cholesterol of 6.5 mmol/L or less being also randomised to atorvastatin or placebo in a factorial Lipid-Lowering Arm.</owl:annotatedTarget>
