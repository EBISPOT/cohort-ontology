        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4486</owl:annotatedTarget>
        <obo:IAO_0000116>subjects enrolled (thoracic surgery patients with and without lung disease)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://biolincc.nhlbi.nih.gov/studies/ltrc/</oboInOwl:hasDbXref>
        <rdfs:comment>Participants A total of 4,486 subjects were enrolled, and lung tissue was obtained from 3,333 of these.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
