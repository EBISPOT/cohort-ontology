        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021068"/>
        <obo:IAO_0000115>A non-metastasizing neoplasm that arises from the ovary. Representative examples include serous cystadenoma, mucinous cystadenoma, clear cell adenofibroma, benign Brenner tumor, thecoma, and fibroma.</obo:IAO_0000115>
        <rdfs:label>ovarian benign neoplasm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000649 -->

