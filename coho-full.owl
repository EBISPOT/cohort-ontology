        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005300"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002749"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23353"/>
        <obo:IAO_0000116>chronic kidney disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37566114+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This retrospective real-world study used data from two registries, International Pediatric Peritoneal Dialysis Network (IPPN) and International Pediatric Hemodialysis Network (IPHN), to characterize the efficacy and safety of continuous erythropoietin receptor activator (C.E.R.A.) in pediatric patients with chronic kidney disease (CKD) on peritoneal dialysis (PD) or hemodialysis (HD).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002749"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PXD022183</owl:annotatedTarget>
        <dcterms:title>Peritoneal Dialysis Fluid Supplementation with Alanyl-Glutamine Attenuates Conventional Dialysis Fluid-Mediated Endothelial Cell Injury by Restoring Perturbed Cytoprotective Responses.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33334074</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/pride/ws/archive/v2/projects/PXD022183</oboInOwl:hasDbXref>
        <rdfs:comment>The study was part of the International Pediatric Dialysis Network (IPDN; www.pedpd.org).</rdfs:comment>
    </owl:Axiom>
