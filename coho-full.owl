        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002588"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">237</owl:annotatedTarget>
        <obo:IAO_0000116>YAHD participants in its own young-adult case-control report</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2374437/fullTextXML</oboInOwl:hasDbXref>
