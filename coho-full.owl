    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001506"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13637"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4593391/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Recruitment is directed at subjects with a clinical diagnosis of Alzheimer’s disease (AD), Parkinson’s disease (PD) or cancer or who are free of other major neurological conditions.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001506"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13639"/>
