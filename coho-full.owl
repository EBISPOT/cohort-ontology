    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000921"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8413"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7660788/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>JUPITER was a randomized, double‐blind, placebo‐controlled trial of rosuvastatin 20 mg daily versus placebo in the primary prevention of CVD in 17 802 asymptomatic men ≥50 years and women ≥60 years with low‐density lipoprotein cholesterol (LDL‐C) &lt;130 mg/dL and hsCRP (high‐sensitivity C‐reactive protein) ≥2.0 mg/L who were monitored for a median follow‐up period of 1.9 years (maximum 5 years).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000921"/>
