    <!-- http://www.ebi.ac.uk/coho/COHO_0001298 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001298">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11731"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90897930</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre observational cohort and database of children and adults with sickle cell disease receiving care at the National Heart, Lung, and Blood Institute&apos;s Comprehensive Sickle Cell Centers in the United States, run from March 2005 to September 2008 at nine of the centres and their satellite sites, which collected clinical data abstracted from medical records, yearly health and lifestyle interviews and quality-of-life questionnaires, and from 2007 blood and DNA samples for a genotype-phenotype repository, to describe the disease&apos;s complications and identify participants for future clinical trials.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3640</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>C-DATA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>C-Data</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>C-data</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CSCC C-Data</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Collaborative Data Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Comprehensive Sickle Cell Centers Collaborative Data project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Comprehensive Sickle Cell Centers Collaborative Data Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11731">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011382"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001298"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11731"/>
        <obo:IAO_0000116>sickle cell disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2911637/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Adult and pediatric patients with all forms of SCD at participating CSCC Centers and satellite sites were considered eligible for C-Data Project enrollment if seen within the last 24 months and were expected to return for care.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001298"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3630835/</oboInOwl:hasDbXref>
        <rdfs:comment>Pediatric patients with SCA and documented evaluation of cerebrovascular disease were recruited from multiple US institutions for several different clinical trials.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001298"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90897930</owl:annotatedTarget>
        <dcterms:title>FLT1 and other candidate fetal haemoglobin modifying loci in sickle cell disease in African ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40025045</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11873275/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The cohorts included: Cooperative Study of Sickle Cell Disease (CSSCD: n = 841), Multicenter Study of Hydroxyurea (MSH: n = 178), Pulmonary Hypertension and the Hypoxic Response in Sickle Cell Disease (PUSH) study (n = 73), Comprehensive Sickle Cell Centers Collaborative Data (C-data) project (n = 127), Treatment of Pulmonary Hypertension and Sickle Cell Disease with Sildenafil Treatment (Walk-PHaSST) trial (n = 181), Duke University Outcome Modifying Genes study (n = 152), and Silent Infarct Transfusion (SIT) trial (SITT: n = 488).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001298"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre observational cohort and database of children and adults with sickle cell disease receiving care at the National Heart, Lung, and Blood Institute&apos;s Comprehensive Sickle Cell Centers in the United States, run from March 2005 to September 2008 at nine of the centres and their satellite sites, which collected clinical data abstracted from medical records, yearly health and lifestyle interviews and quality-of-life questionnaires, and from 2007 blood and DNA samples for a genotype-phenotype repository, to describe the disease&apos;s complications and identify participants for future clinical trials.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19902523</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20658620</obo:IAO_0000119>
