    <!-- http://www.ebi.ac.uk/coho/COHO_0002096 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002096">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18260"/>
        <rdf:type rdf:nodeID="genid18262"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:17164261</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based genetic study of nicotine dependence in which African American and European American smoker probands (aged at least 21, smoking at least 20 cigarettes a day for the preceding year and for at least five years) were recruited in the Mid-South states of the United States, primarily Tennessee, Mississippi and Arkansas, in 1999–2004, together with their biological parents and full siblings, with nicotine dependence assessed by smoking quantity, the Heaviness of Smoking Index and the Fagerström Test for Nicotine Dependence, for linkage and association studies of nicotine dependence.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2037</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MSTF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mid-South Tobacco Family cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mid-South Tobacco Family sample</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Mid-South Tobacco Family</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18260">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_with_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000013"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid18262">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008575"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002096"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18260"/>
        <obo:IAO_0000116>smoking</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2739294/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Proband smokers were required to be at least 21 years old, to have smoked for at least the last five years, and to have consumed at least 20 cigarettes per day for the preceding 12 months.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002096"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18262"/>
        <obo:IAO_0000116>nicotine dependence</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC1592559/</oboInOwl:hasDbXref>
        <rdfs:comment>Once a proband and a full sibling who was also nicotine dependent (for most of our families) were identified, additional siblings and biological parents were recruited whenever possible, regardless of their smoking status.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002096"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2739294/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The AA and EA participants were recruited from the US Mid-South States during 1999–2004 [10], [12], [18].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002096"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:17164261</owl:annotatedTarget>
        <dcterms:title>Fine mapping of a linkage region on chromosome 17p13 reveals that GABARAP and DLG4 are associated with vulnerability to nicotine dependence in European-Americans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:17164261</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17164261+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were 2037 subjects from 602 nuclear families of either African-American (AA) or European-American (EA) origin from our Mid-South Tobacco Family (MSTF) cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002096"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family-based genetic study of nicotine dependence in which African American and European American smoker probands (aged at least 21, smoking at least 20 cigarettes a day for the preceding year and for at least five years) were recruited in the Mid-South states of the United States, primarily Tennessee, Mississippi and Arkansas, in 1999–2004, together with their biological parents and full siblings, with nicotine dependence assessed by smoking quantity, the Heaviness of Smoking Index and the Fagerström Test for Nicotine Dependence, for linkage and association studies of nicotine dependence.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16960812</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:17164261</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:17579606</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19763258</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002096"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2037</owl:annotatedTarget>
        <obo:IAO_0000116>participants (smoker probands, siblings and parents) from 602 African American and European American nuclear families (1999-2004)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18354387+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We examined 16 single nucleotide polymorphisms (SNPs) at DRD2 and 7 SNPs at ANKK1 in our Mid-South Tobacco Family cohort, which consisted of 2037 participants representing two distinct American populations.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002096"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MSTF</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002097 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002097">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18269"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000020"/>
