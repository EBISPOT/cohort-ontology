    <!-- http://www.ebi.ac.uk/coho/COHO_0002514 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002514">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21272"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001463"/>
        <obo:IAO_0000112>PMID:9853437</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, open, randomised trial at university and general hospitals across the United Kingdom that allocated patients aged 60–76 years with symptomless abdominal aortic aneurysms 4.0–5.5 cm in diameter to early elective open surgical repair or to ultrasonographic surveillance, comparing mortality, health service costs and quality of life, and following the natural history of small aneurysms in the surveillance group.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1090</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>U.K. Small Aneurysm Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UKSAT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>United Kingdom Small Aneurysm Trial</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">UK Small Aneurysm Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21272">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005350"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002514"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21272"/>
        <obo:IAO_0000116>abdominal aortic aneurysm</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9853436+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We randomly assigned 1090 patients aged 60-76 years, with symptomless abdominal aortic aneurysms 4.0-5.5 cm in diameter to undergo early elective open surgery (n=563) or ultrasonographic surveillance (n=527).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002514"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A7664011+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>University and general hospitals across the UK.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002514"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:9853437</owl:annotatedTarget>
        <dcterms:title>Health service costs and quality of life for early elective surgery or ultrasonographic surveillance for small abdominal aortic aneurysms. UK Small Aneurysm Trial Participants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:9853437</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9853437+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The UK Small Aneurysm Trial showed that surveillance and early prophylactic elective surgical repair had similar survival benefits.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002514"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre, open, randomised trial at university and general hospitals across the United Kingdom that allocated patients aged 60–76 years with symptomless abdominal aortic aneurysms 4.0–5.5 cm in diameter to early elective open surgical repair or to ultrasonographic surveillance, comparing mortality, health service costs and quality of life, and following the natural history of small aneurysms in the surveillance group.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:7664011</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9853436</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9853437</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
