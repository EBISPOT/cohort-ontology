    <!-- http://www.ebi.ac.uk/coho/COHO_0001985 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001985">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:42065824</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort study of the oldest old in the city of Leiden, the Netherlands, which enrolled all inhabitants who turned 85 between September 1997 and September 1999 in the month of their 85th birthday and examined them with interviews and clinical examinations at baseline and yearly for five years, to study health, functioning and well-being in very old age; an earlier survey under the same name studied the prevalence of morbidity in the whole population of Leiden aged 85 and over, living independently or in institutions.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">599</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>L85PLUS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leiden 85-Plus Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leiden 85-plus study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Leiden 85-plus Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001985"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9074345/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Included were all people from Leiden, the Netherlands, who turned 85 between 1 September 1997 and 1 September 1999.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001985"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42065824</owl:annotatedTarget>
        <dcterms:title>Low genetic risk for coronary artery disease underlies multigenerational longevity and healthy aging.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42065824</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42065824+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We investigated this hypothesis in the Leiden Longevity Study, a cohort with data from more than 420 long-lived families in three generations and the Leiden 85-plus study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001985"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort study of the oldest old in the city of Leiden, the Netherlands, which enrolled all inhabitants who turned 85 between September 1997 and September 1999 in the month of their 85th birthday and examined them with interviews and clinical examinations at baseline and yearly for five years, to study health, functioning and well-being in very old age; an earlier survey under the same name studied the prevalence of morbidity in the whole population of Leiden aged 85 and over, living independently or in institutions.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15374369</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10732458/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9074345/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001985"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">599</owl:annotatedTarget>
        <obo:IAO_0000116>85-year-old inhabitants of Leiden enrolled 1997-1999 (the 1997-99 cohort)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3889888/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of these, 14 died before enrolment and 92 refused to participate, resulting in a study population of 599 participants (response rate, 87 %).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001985"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>L85PLUS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


