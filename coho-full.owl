    <!-- http://www.ebi.ac.uk/coho/COHO_0000822 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000822">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid7467"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>GCST90572747</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based study at Brest University Hospital, France, launched in 2000, that enrols consecutive patients with objectively confirmed venous thromboembolism (more than 5,000 so far), with matched hospital controls, to study genetic and environmental risk factors for venous thromboembolism and their interactions.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>EDITH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EDITH case-control study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EDITH study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Etude des Déterminants/Interaction de la THrombose veineuse</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Etude des Déterminants/Interaction de la Thrombose veineuse</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid7467">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005399"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000822"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7467"/>
        <obo:IAO_0000116>venous thromboembolism</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5959061/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The observational EDITH case-control study was designed to assess interactions between genetic and environmental risk factors for VTE.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000822"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29775482+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The EDITH hospital-based case-control study enrolled 182 patients with cancer and VTE as well as 182 control patients with cancer, matched for gender, age and cancer location, between 2000 and 2012, in the University Hospital of Brest.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000822"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90572747</owl:annotatedTarget>
        <dcterms:title>Molecular determinants of thrombosis recurrence risk across venous thromboembolism subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40811855</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.medrxiv.org/content/early/2024/12/03/2024.12.02.24317788.source.xml</oboInOwl:hasDbXref>
        <rdfs:comment>The recurrent VT GWAS meta-analysis included eight studies with confirmed unrelated VT cases of European ancestry free of cancer history: EDITH, FHS, HVH (HVH1 and HVH23), MARTHA, MEGA, PADIS-PE and REVERSE-I (Supplementary Material).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000822"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based study at Brest University Hospital, France, launched in 2000, that enrols consecutive patients with objectively confirmed venous thromboembolism (more than 5,000 so far), with matched hospital controls, to study genetic and environmental risk factors for venous thromboembolism and their interactions.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29775482</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000822"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5000</owl:annotatedTarget>
        <obo:IAO_0000116>patients with VTE enrolled since 2000 (lower bound: &apos;&gt;5000&apos;; controls not counted)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Since its inception, it has enrolled &gt;5000 patients with VTE.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000822"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EDITH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000823 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000823">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid7474"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Southern_Africa"/>
        <obo:IAO_0000112>GCST90551892</obo:IAO_0000112>
        <obo:IAO_0000115>A cancer case-control study that enrolled 24,971 Black patients with incident, mostly histologically proven cancers of any type in Johannesburg, South Africa, between 1995 and 2016, collecting questionnaire data and serum and whole-blood samples and using patients with cancers unrelated to the exposure of interest as controls, to study lifestyle and infection (particularly HIV) risk factors for cancer; the ERICA-SA project uses its data and samples to study lifestyle, infection and genetic susceptibility to cancer.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym JCS also denotes Japanese Centenarian Study (COHO:0001942); this term is Johannesburg Cancer Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24971</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ERICA-SA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>JCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Johannesburg Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid7474">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004992"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000823"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7474"/>
        <obo:IAO_0000116>cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32169796+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 24 971 black patients with an incident histologically proven (&gt;95%) cancer of any type were enrolled between 1995-2016.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000823"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Africa"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:32169796%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>The Johannesburg Cancer Study (JCS) aims were to examine whether cancer risk factors identified in Western countries applied to black patients in Johannesburg, South Africa and to understand the impact of HIV on cancer risk, with a view to identifying previously unrecognised HIV associated cancers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000823"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90551892</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies common variants associated with breast cancer in South African Black women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40229280</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11997036/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The JCS samples formed part of a larger study, Evolving Risk Factors for Cancer in African Populations (ERICA-SA)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000823"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cancer case-control study that enrolled 24,971 Black patients with incident, mostly histologically proven cancers of any type in Johannesburg, South Africa, between 1995 and 2016, collecting questionnaire data and serum and whole-blood samples and using patients with cancers unrelated to the exposure of interest as controls, to study lifestyle and infection (particularly HIV) risk factors for cancer; the ERICA-SA project uses its data and samples to study lifestyle, infection and genetic susceptibility to cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32169796</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.samrc.ac.za/intramural-research-units/evolving-risk-factors-cancers-african-populations-erica-sa</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000823"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">24971</owl:annotatedTarget>
        <obo:IAO_0000116>Black patients with incident cancer enrolled 1995-2016 (cases and cancer controls together)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32169796+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 24 971 black patients with an incident histologically proven (&gt;95%) cancer of any type were enrolled between 1995-2016.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000823"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ERICA-SA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
