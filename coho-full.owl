        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Chinese genetic sample for colorectal neoplasia drawn from the population-based colorectal cancer screening programme of Jiashan County, Zhejiang Province, made up of a one-to-one matched case-control study conducted from 2015 to 2022 and a cross-sectional colonoscopy screening study performed in 2014, whose participants were genotyped on the Illumina Asian Screening Array.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38872215</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
