    <!-- http://www.ebi.ac.uk/coho/COHO_0001556 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001556">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000027"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002430"/>
        <obo:IAO_0000112>PMID:36224396</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing population-based cohort of people aged over 18 years in Amagasaki, Hyogo Prefecture, Japan, consecutively enrolled for a baseline examination between September 2002 and August 2003, which is one of the member studies of the Cardio-metabolic Genome Epidemiology (CAGE) Network and whose samples are used in genetic studies of blood pressure, lipids and other cardiometabolic traits.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5745</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CAGE-AMA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CAGE-Amagasaki</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CAGE-Amagasaki Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cardio-metabolic Genome Epidemiology Network, Amagasaki</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cardio-metabolic Genome Epidemiology Network, Amagasaki Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cardio-metabolic Genome Epidemiology Study - Amagasaki</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Amagasaki Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001556"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3458872/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A replication study of the previously identified variants at 22 candidate lipid loci was performed in the general Japanese population; from 5745 individuals consecutively enrolled in the population-based setting, which is known as Amagasaki Study [26], 4990 individuals without receiving current treatment for dyslipidemia were included in the present study (Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001556"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:36224396</owl:annotatedTarget>
        <dcterms:title>A saturated map of common genetic variants associated with human height.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36224396</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9605867/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>CAGE-Amagasaki Cardio-metabolic Genome Epidemiology Network, Amagasaki</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001556"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing population-based cohort of people aged over 18 years in Amagasaki, Hyogo Prefecture, Japan, consecutively enrolled for a baseline examination between September 2002 and August 2003, which is one of the member studies of the Cardio-metabolic Genome Epidemiology (CAGE) Network and whose samples are used in genetic studies of blood pressure, lipids and other cardiometabolic traits.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23050023</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26648100</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fng.834/MediaObjects/41588_2011_BFng834_MOESM19_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001556"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5745</owl:annotatedTarget>
        <obo:IAO_0000116>individuals recruited at baseline, September 2002 to August 2003</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fng.834/MediaObjects/41588_2011_BFng834_MOESM19_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Amagasaki Study (CAGE-‐Amagasaki) is an ongoing population-‐based cohort study of 5,745 individuals (3,435 males and 2,310 females), aged &gt;18 years and recruited for a baseline examination between September 2002 to August 2003</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001556"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CAGE-AMA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001556"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CAGE-Amagasaki</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001557 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001557">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000027"/>
        <obo:IAO_0000112>PMID:20205615</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based prospective cohort of middle-aged and older Japanese men and women in Fukuoka, Japan, run by Kyushu University, who took part in a baseline survey with a questionnaire and DNA collection between February 2004 and August 2007 and are followed up to investigate lifestyle factors and genetic susceptibility to lifestyle-related diseases such as cardiovascular diseases, cancer and diabetes mellitus.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CAGE-Fukuoka also denotes Fukuoka Colorectal Cancer Study (COHO:0001720); this term is Kyushu University Fukuoka Cohort Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12959</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CAGE-FUK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CAGE-Fukuoka</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fukuoka Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fukuoka Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fukuoka Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Kyushu University Fukuoka Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001557"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3022068/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For study of lifestyle-related diseases, the Fukuoka Cohort was constructed from 2003 to 2009 in Kyushu area in Japan, which contains a total of 12,949 persons.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001557"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20205615</owl:annotatedTarget>
        <dcterms:title>Relation of coffee consumption and serum liver enzymes in Japanese men and women with reference to effect modification of alcohol use and body mass index.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20205615</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20205615+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The data were derived from the baseline survey of the Kyushu University Fukuoka Cohort Study, and included 12,020 Japanese men and women aged 49-76 years who were free of chronic liver diseases.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001557"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based prospective cohort of middle-aged and older Japanese men and women in Fukuoka, Japan, run by Kyushu University, who took part in a baseline survey with a questionnaire and DNA collection between February 2004 and August 2007 and are followed up to investigate lifestyle factors and genetic susceptibility to lifestyle-related diseases such as cardiovascular diseases, cancer and diabetes mellitus.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21297916</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24647736</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26648100</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34313618</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001557"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12959</owl:annotatedTarget>
        <obo:IAO_0000116>participants in the baseline survey, February 2004 to August 2007</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4673465/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Kyushu University Fukuoka Cohort Study is a community-based prospective epidemiologic cohort of 12,959 subjects, who participated in the baseline survey during the period from February 2004 to August 2007.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001557"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CAGE-FUK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
