    <!-- http://www.ebi.ac.uk/coho/COHO_0002598 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002598">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21875"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:32414410</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of persons aged 45 to 64 years in the Netherlands, stratified by age and employment status, followed from 2010 by the Netherlands Organisation for Applied Scientific Research TNO through online questionnaires on work characteristics, health, employment transitions, work ability and productivity, to study sustainable work participation of older workers; a second group was recruited in 2015.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15118</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/STREAM</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>STREAM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study on TRansitions in Employment, Ability and Motivation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Study on Transitions in Employment, Ability and Motivation</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21875">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0001591"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002598"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21875"/>
        <obo:IAO_0000116>work characteristics</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7227258/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>From the inception of the cohort in 2010 (T1) onwards, participants completed an online questionnaire on topics such as work characteristics, health, employment status and transitions, work ability, and work productivity.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002598"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7227258/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>STREAM is an ongoing prospective cohort among persons aged 45 to 64 years in the Netherlands stratified by age and employment status.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002598"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32414410</owl:annotatedTarget>
        <dcterms:title>Long-term sickness absence in a working population: development and validation of a risk prediction model in a large Dutch prospective cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32414410</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7227258/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Data from 11,221 working persons included in the prospective Study on Transitions in Employment, Ability and Motivation (STREAM) conducted in the Netherlands were used to develop a multivariable risk prediction model for LTSA lasting ≥28 accumulated working days in the coming year.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002598"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of persons aged 45 to 64 years in the Netherlands, stratified by age and employment status, followed from 2010 by the Netherlands Organisation for Applied Scientific Research TNO through online questionnaires on work characteristics, health, employment transitions, work ability and productivity, to study sustainable work participation of older workers; a second group was recruited in 2015.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32414410</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42615545</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002598"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15118</owl:annotatedTarget>
        <obo:IAO_0000116>persons in the first STREAM cohort at baseline (T1, 2010)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:32414410</oboInOwl:hasDbXref>
        <rdfs:comment>This cohort comprised 15,118 persons who participated in STREAM of which 82.2% responded at T2 (N = 12,430).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002598"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>STREAM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002599 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002599">
