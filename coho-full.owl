    <!-- http://www.ebi.ac.uk/coho/COHO_0001097 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001097">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10059"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Ghana"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Nigeria"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Southern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Western_Africa"/>
        <obo:IAO_0000112>GCST90461907</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, clinic-based case-control study of prostate cancer run since 2016 by the Men of African Descent and Carcinoma of the Prostate (MADCaP) Network at seven accrual centres in Ghana, Nigeria, Senegal and South Africa, with partner institutions in the United States, which under common eligibility criteria, instruments and biosample protocols enrols men over 30 who self-identify as black African: incident, histologically confirmed prostate cancer cases from urology and oncology clinics, and cancer-free controls frequency-matched by age from other clinics in the same catchment areas, to study the genetics and epidemiology of prostate cancer in sub-Saharan Africa.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2505</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2222</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>MADCaP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MADCap</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Men of African Descent and Carcinoma of the Prostate Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Men of African Descent and Carcinoma of the Prostate Network</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Men of African Descent and Carcinoma of the Prostate</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10059">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001097"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10059"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30260755+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We tested this infrastructure by collecting epidemiologic, medical record, and genomic data from a total of 311 patients with CaP and 218 matched controls recruited at the seven SSA centers.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001097"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Africa"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6223491/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Figure 1 depicts the MADCaP Network’s organizational structure, which has seven participant accrual centers in Ghana, Nigeria, Senegal, and South Africa with several SSA and US centers partnered to enhance capacity building and offer mentorship.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001097"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90461907</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of prostate-specific antigen levels in 392,522 men identifies new loci and improves prediction across ancestry groups.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39930085</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11821537/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Local and national IRBs approved Men of African Descent and Carcinoma of the Prostate (MADCaP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001097"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre, clinic-based case-control study of prostate cancer run since 2016 by the Men of African Descent and Carcinoma of the Prostate (MADCaP) Network at seven accrual centres in Ghana, Nigeria, Senegal and South Africa, with partner institutions in the United States, which under common eligibility criteria, instruments and biosample protocols enrols men over 30 who self-identify as black African: incident, histologically confirmed prostate cancer cases from urology and oncology clinics, and cancer-free controls frequency-matched by age from other clinics in the same catchment areas, to study the genetics and epidemiology of prostate cancer in sub-Saharan Africa.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30260755</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001097"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2505</owl:annotatedTarget>
        <obo:IAO_0000116>prostate cancer cases and age-matched controls from seven African centres (no total stated), 2026</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:41812093</oboInOwl:hasDbXref>
        <rdfs:comment>Using the Men of African Descent and Carcinoma of the Prostate (MADCaP) network, we evaluated the association of self-reported FHx of CaP in fathers and brothers in a case-control study of 2,505 prostate cancer cases and 2,222 age-matched controls ascertained from seven centers across Africa.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001097"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2222</owl:annotatedTarget>
        <obo:IAO_0000116>prostate cancer cases and age-matched controls from seven African centres (no total stated), 2026</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:41812093</oboInOwl:hasDbXref>
        <rdfs:comment>Using the Men of African Descent and Carcinoma of the Prostate (MADCaP) network, we evaluated the association of self-reported FHx of CaP in fathers and brothers in a case-control study of 2,505 prostate cancer cases and 2,222 age-matched controls ascertained from seven centers across Africa.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001097"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
