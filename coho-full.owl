        <rdfs:comment>This study investigated the relation of MTHFR C677T and A1298C polymorphisms to colorectal cancer in a case-control study in Fukuoka, Japan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001720"/>
