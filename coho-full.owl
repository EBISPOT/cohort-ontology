    <!-- http://www.ebi.ac.uk/coho/COHO_0001618 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001618">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14589"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:30482948</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal family high-risk study of the development of substance use disorder, run in Pittsburgh, Pennsylvania, United States, by the Center for Education and Drug Abuse Research of the University of Pittsburgh, a Center of Excellence funded by the National Institute on Drug Abuse and completed in 2015, which recruited nuclear families of a father with or without a lifetime substance use disorder (or with another psychiatric disorder), his partner and their biological child aged 10–12 (at first sons only, daughters from its second funding cycle) and followed the index children to age 30; index children and their siblings were genotyped under the Genes, Environment and Development Initiative.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CEDAR also denotes Correlated Expression and Disease Association Research (COHO:0000432); this term is Center for Education and Drug Abuse Research.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>CEDAR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CEDAR_Penn</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Center for Education and Drug Abuse research</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Center for Education and Drug Abuse Research</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14589">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002494"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001618"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14589"/>
        <obo:IAO_0000116>substance use disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21320228+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The family high-risk design was used to recruit proband fathers with and without substance use disorder and track their sons longitudinally from late childhood to adulthood.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001618"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
