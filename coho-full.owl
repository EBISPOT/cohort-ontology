        <obo:IAO_0000112>PMID:27825389</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective longitudinal cohort of pregnant women enrolled since 2009 at prenatal clinics in the Concord and Lebanon regions of New Hampshire, USA, by the Geisel School of Medicine at Dartmouth, and of their children, followed from early pregnancy into childhood to study how environmental contaminants, such as arsenic from private well water, affect the health of pregnant women and their children.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1500</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/NHBCS</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>NH Birth Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NHBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>New Hampshire birth cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">New Hampshire Birth Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22230">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0000931"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid22232">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0080000"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002642"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22230"/>
        <obo:IAO_0000116>environmental contaminants</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.protectkidshealth.com/about</oboInOwl:hasDbXref>
        <rdfs:comment>The New Hampshire Birth Cohort Study is a research project that is investigating how various factors such as contaminants in the environment affect the health of pregnant women and their children.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002642"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22232"/>
        <obo:IAO_0000116>arsenic from private well water</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.protectkidshealth.com/about</oboInOwl:hasDbXref>
        <rdfs:comment>The New Hampshire Birth Cohort Study is a research project that is investigating how various factors such as contaminants in the environment affect the health of pregnant women and their children.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002642"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.protectkidshealth.com/about</oboInOwl:hasDbXref>
        <rdfs:comment>Beginning in 2009, with the help of medical providers in New Hampshire, the study staff at the Geisel School of Medicine at Dartmouth, began enrolling pregnant women at clinics in the Concord and Lebanon regions of New Hampshire.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002642"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27825389</owl:annotatedTarget>
        <dcterms:title>Maternal arsenic exposure and gestational diabetes and glucose intolerance in the New Hampshire birth cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27825389</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27825389+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We investigated the association between As exposure and risk of glucose intolerance and GDM among 1151 women enrolled in the New Hampshire Birth Cohort Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002642"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective longitudinal cohort of pregnant women enrolled since 2009 at prenatal clinics in the Concord and Lebanon regions of New Hampshire, USA, by the Geisel School of Medicine at Dartmouth, and of their children, followed from early pregnancy into childhood to study how environmental contaminants, such as arsenic from private well water, affect the health of pregnant women and their children.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27825389</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.protectkidshealth.com/about</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002642"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1500</owl:annotatedTarget>
        <obo:IAO_0000116>women enrolled (more than), with over 1,500 children</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.protectkidshealth.com/about</oboInOwl:hasDbXref>
        <rdfs:comment>Today our study has over 1,500 women and 1,500 children from New Hampshire and Vermont participating in this important study.</rdfs:comment>
    </owl:Axiom>
