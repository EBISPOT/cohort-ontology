        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005010"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001821"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16260"/>
        <obo:IAO_0000116>coronary artery disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12382207/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 3779 individuals included in GRAND, 2296 had CAD, comprising 453 with myocardial infarction, 815 with stable angina, and 967 with unstable angina (Additional file 1: Table S2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
