    <!-- http://www.ebi.ac.uk/coho/COHO_0002443 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002443">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20827"/>
        <rdf:type rdf:nodeID="genid20829"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
