        <obo:IAO_0000112>PGS000740</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:28604730</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of non-small cell lung cancer in Western Norway, run by the National Institute of Occupational Health (NIOH) in Oslo within its lung cancer genetics project, whose cases are patients of Norwegian origin with histologically confirmed early-stage non-small cell lung cancer admitted to Haukeland University Hospital in Bergen, and whose healthy controls come from the same region and are frequency-matched to the cases on cumulative smoking; recruitment ran from 1986 to 2005.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">335</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">422</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">757</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NorwayLCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Norway Lung Cancer Study</rdfs:label>
    </owl:NamedIndividual>
