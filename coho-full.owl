        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000752"/>
        <obo:IAO_0000112>PMID:37239075</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal clinical research database of military health care beneficiaries who consent to enrolment, typically at prostate biopsy for suspected prostate cancer, at United States military treatment facilities (Walter Reed and other Army, Navy and Air Force medical centres, now with one civilian centre), run by the Department of Defense Center for Prostate Disease Research of the Uniformed Services University of the Health Sciences, which records their demographic, clinical, pathology, treatment, quality-of-life and outcome data. It began as prospective data collection at Walter Reed Army Medical Center in January 1994, with retrospective data back to 1980, and is linked to a biospecimen bank of blood and tissue collected at Walter Reed since 1993.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CPDR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CPDR multicenter national clinical database</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Center for Prostate Disease Research</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Center for Prostate Disease Research Multi-center National Database</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Center for Prostate Disease Research multicenter national database</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Triservice Multicenter Prostate Cancer Longitudinal Database</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Center for Prostate Disease Research Multicenter National Database</rdfs:label>
    </owl:NamedIndividual>
