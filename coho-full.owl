    <!-- http://www.ebi.ac.uk/coho/COHO_0002331 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002331">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>PMID:28134330</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based observational cohort study in Rugao, a city in Jiangsu province, China, with two arms: a longevity arm that in 2007–2008 recruited long-lived residents aged 95 years and over together with population controls drawn at random from the resident registry, and an ageing arm that in 2014 randomly recruited residents aged 70–84 years from rural communities of Jiang&apos;an Township by age and sex strata and is followed up longitudinally, both examined with structured questionnaires, physical examinations and blood samples to study longevity and ageing.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>RuLAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Rugao Longevity and Aging Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Rugao Longevity and Ageing Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Rugao Longevity and Ageing Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002331"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5278549/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All data used in this study were obtained from the RuLAS, a population-based observational two-arm cohort study performed in Rugao, a typical medium-sized city of Jiangsu province, China.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002331"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28134330</owl:annotatedTarget>
        <dcterms:title>Associations of triglyceride levels with longevity and frailty: A Mendelian randomization analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28134330</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5278549/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Based on data from the Rugao Longevity and Ageing Study (RuLAS), we used MR analysis to determine whether the observational associations of triglyceride levels with the two ageing phenotypes, longevity and frailty, are causal.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002331"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based observational cohort study in Rugao, a city in Jiangsu province, China, with two arms: a longevity arm that in 2007–2008 recruited long-lived residents aged 95 years and over together with population controls drawn at random from the resident registry, and an ageing arm that in 2014 randomly recruited residents aged 70–84 years from rural communities of Jiang&apos;an Township by age and sex strata and is followed up longitudinally, both examined with structured questionnaires, physical examinations and blood samples to study longevity and ageing.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28134330</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31906855</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002331"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RuLAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002332 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002332">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000629"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. The KoGES rural cohort was renamed the Cardiovascular Disease Association Study: &apos;the Cardiovascular disease association study (CAVAS) cohort (formerly RURAL cohort)&apos; (PMC7670174). Replaced by COHO:0000629 (Cardiovascular Disease Association Study), which now carries this term&apos;s names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Rural cohort</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002333 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002333">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000810"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. RUSHMAP is not the university: in the source GWAS (Okbay et al. 2016, SSGAC well-being, depressive symptoms and neuroticism) it is the Rush Memory and Aging Project, which COHO already has as COHO:0000810. The supplement names it &apos;Rush University Medical Center - Memory and Aging Project&apos; and &apos;Rush MAP&apos; and thanks &apos;the study participants of the Rush Memory and Aging Project&apos;. It is not ROSMAP (COHO:0000400): the Religious Orders Study is not part of this id. Add RUSHMAP as an acronym and the Catalog&apos;s and the paper&apos;s spellings as synonyms of COHO:0000810. The placeholder COHO:0002333 is then a duplicate. No COHO term carries RUSHMAP or &apos;Rush MAP&apos;, so there is no clash. Replaced by COHO:0000810 (Rush Memory and Aging Project), which now carries this term&apos;s names. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Rush University Medical Centre- Memory and Aging Project</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


