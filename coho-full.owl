        <obo:IAO_0000115>A Dutch prospective cohort study, run in the North of the Netherlands, consisting of a population cohort of 2,230 children born between October 1989 and September 1991 and a clinical cohort of 543 children referred to child psychiatric outpatient care before age 11, followed from about age 11 into young adulthood with repeated assessments of mental health, social development and physical health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2230</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TRAILS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tracking Adolescents Individual Lives Survey</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">TRacking Adolescents&apos; Individual Lives Survey</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid4606">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005084"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000524"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4606"/>
        <obo:IAO_0000116>mental disorders</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4339762/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>the overall objective of TRAILS is ‘to contribute to the understanding of the determinants of adolescents’ mental (ill-)health and social development during adolescence and young adulthood, as well as the mechanisms underlying the associations between determinants and outcomes’</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000524"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
