    <!-- http://www.ebi.ac.uk/coho/COHO_0002575 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002575">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid21695"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:28540026</obo:IAO_0000112>
        <obo:IAO_0000115>A combination of Californian autism spectrum disorder collections, namely the UCSF/Weiss trios and cases, the UCSF/Hendren cases, the USC/Levitt cases and controls, trios, cases and controls from the CHARGE study at UC Davis and cases and controls of the Autism Phenome Project of the UC Davis MIND Institute, whose samples were genotyped by the laboratory of L. A. Weiss at the University of California, San Francisco, on Affymetrix Axiom EUR arrays, and which contributed its European-American participants to the Psychiatric Genomics Consortium autism GWAS.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>WLAC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Weiss Laboratory Autism Collections</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Weiss Laboratory Autism Collection</rdfs:label>
    </owl:NamedIndividual>
