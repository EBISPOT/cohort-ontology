        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4212555/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GOLDR study is a family-based study assessing diabetes and diabetic complications in families (siblings and/or parents) of a proband, defined as having type 2 diabetes and either known DR or a diabetes duration of ≥10 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001342"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12136"/>
        <obo:IAO_0000116>diabetic retinopathy</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4212555/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GOLDR study is a family-based study assessing diabetes and diabetic complications in families (siblings and/or parents) of a proband, defined as having type 2 diabetes and either known DR or a diabetes duration of ≥10 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001342"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
