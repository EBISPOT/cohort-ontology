    <!-- http://www.ebi.ac.uk/coho/COHO_0002231 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002231">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid19121"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000038"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002279"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000617"/>
        <obo:IAO_0000112>PGS005170</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:25898129</obo:IAO_0000112>
        <obo:IAO_0000115>A pharmacogenomic study of the response to statins that combines two clinical populations of white adults in the United States given a statin for a fixed period: participants of the Cholesterol and Atherosclerosis Pharmacogenetics (CAP) study, recruited at two clinical sites in Los Angeles and San Francisco and treated with simvastatin for six weeks, and participants of the Pravastatin Inflammation CRP Evaluation (PRINCE) trial, enrolled at sites across the country and treated with pravastatin for twelve weeks.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1939</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PARC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pharmacogenomics and Risk of Cardiovascular Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pharmacogenomics and Risk of Cardiovascular Disease study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Pharmacogenomics and Risk of Cardiovascular Disease Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19121">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002231"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19121"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature09270/MediaObjects/41586_2010_BFnature09270_MOESM283_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>They were recruited for having an LDL-cholesterol concentration ≥3.5 mmol/L (&gt;135 mg/dL) or a history of myocardial infarction, stroke, or coronary revascularization regardless of their baseline LDL-cholesterol.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002231"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000038"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature09270/MediaObjects/41586_2010_BFnature09270_MOESM283_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The first was derived from the Cholesterol Atherosclerosis Pharmacogenetics (CAP) Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002231"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002279"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature09270/MediaObjects/41586_2010_BFnature09270_MOESM283_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>derived from the Pravastatin Inflammation CRP Evaluation (PRINCE).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002231"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature09270/MediaObjects/41586_2010_BFnature09270_MOESM283_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>CAP subjects were recruited from two clinical sites located in Los Angeles and San Francisco, California.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002231"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005170</owl:annotatedTarget>
        <dcterms:title>Polygenic score integrating neurodegenerative and vascular risk informs dementia risk stratification.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40042447</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002231"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25898129</owl:annotatedTarget>
        <dcterms:title>A multivariate genome-wide association analysis of 10 LDL subfractions, and their response to statin treatment, in 1868 Caucasians.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25898129</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25898129+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a genome-wide association analysis of 7 subfractions of low density lipoproteins (LDLs) and 3 subfractions of intermediate density lipoproteins (IDLs) measured by gradient gel electrophoresis, and their response to statin treatment, in 1868 individuals of European ancestry from the Pharmacogenomics and Risk of Cardiovascular Disease study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002231"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pharmacogenomic study of the response to statins that combines two clinical populations of white adults in the United States given a statin for a fixed period: participants of the Cholesterol and Atherosclerosis Pharmacogenetics (CAP) study, recruited at two clinical sites in Los Angeles and San Francisco and treated with simvastatin for six weeks, and participants of the Pravastatin Inflammation CRP Evaluation (PRINCE) trial, enrolled at sites across the country and treated with pravastatin for twelve weeks.</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature09270/MediaObjects/41586_2010_BFnature09270_MOESM283_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002231"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1939</owl:annotatedTarget>
        <obo:IAO_0000116>PARC combined CAP/PRINCE individuals available for the 2010 genetic analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature09270/MediaObjects/41586_2010_BFnature09270_MOESM283_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1,939 individuals were available for analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002231"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PARC</owl:annotatedTarget>
