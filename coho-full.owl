        <oboInOwl:hasRelatedSynonym>High Density SNP Association Analysis of Melanoma: Case-Control and Outcomes Investigation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MD Anderson Cancer Center Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MDACC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MDACCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
