        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">35683</owl:annotatedTarget>
        <obo:IAO_0000116>newborns screened with cord blood samples at birth, 2000-2004</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:29752553</oboInOwl:hasDbXref>
        <rdfs:comment>35,683 cord blood samples were collected at birth along with basic demographic data.</rdfs:comment>
    </owl:Axiom>
