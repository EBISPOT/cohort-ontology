    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002293"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38754871</owl:annotatedTarget>
        <dcterms:title>Predicted 25-hydroxyvitamin D over the adult lifetime and the risk of ovarian cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38754871</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11369219/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Prevention of Ovarian Cancer in Quebec (PROVAQ) study is a population-based case-control study of female Canadian citizens aged 18-79 years conducted in Montreal, Canada, from 2011 to 2016.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002293"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of epithelial ovarian cancer conducted in Montreal, Canada, from 2011 to 2016, in which women aged 18–79 who were Canadian citizens living in the greater Montreal area, with incident borderline or invasive epithelial cancer of the ovary, fallopian tube or peritoneum identified at seven Montreal hospitals, and controls sampled from the Quebec electoral list and frequency-matched to them by age and region of Montreal, were interviewed in person.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28102526</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38509513</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38754871</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002293"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">498</owl:annotatedTarget>
        <obo:IAO_0000116>Eligible PROVAQ cases and participating population controls, 2011-2016</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11369219/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Nine cases were later identified as nonepithelial or metastatic, for a total of 498 cases.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002293"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">908</owl:annotatedTarget>
        <obo:IAO_0000116>Eligible PROVAQ cases and participating population controls, 2011-2016</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11369219/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Among 1634 eligible women invited to serve as controls, 908 (56%) agreed to participate.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002293"/>
