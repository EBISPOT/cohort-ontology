        <oboInOwl:hasDbXref>PMID:41408349</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002177"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:41408349</owl:annotatedTarget>
        <dcterms:title>Genetic liability to psoriasis predicts severe disease outcomes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41408349</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41408349+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The distribution of psoriasis polygenic risk was also evaluated in a cohort of 4151 participants in the UK-based severe psoriasis registry, BSTOP, and a cohort of 1461 participants from Novartis clinical trials of secukinumab for psoriasis.</rdfs:comment>
    </owl:Axiom>
