        <rdfs:comment>Participants were recruited within 40 miles of the Norwich Research Park, Norwich, UK.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002745"/>
