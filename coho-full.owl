        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7000</owl:annotatedTarget>
        <obo:IAO_0000116>memory-clinic patients in the cohort (almost 7000), 2019</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.alzheimercentrum.nl/wetenschap/amsterdam-dementia-cohort/</oboInOwl:hasDbXref>
        <rdfs:comment>This patients population comprises the Amsterdam Dementia Cohort, which currently consists of almost 7000 individuals.</rdfs:comment>
    </owl:Axiom>
