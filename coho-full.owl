        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11538854/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The PREMIER consortium (May 2019 and December 2022) recruited a research cohort to establish an R&amp;BD platform for the development of early diagnosis and precision medicine-based treatment of mild cognitive impairment (MCI) and dementia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002278"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
