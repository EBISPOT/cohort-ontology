    <!-- http://www.ebi.ac.uk/coho/COHO_0001415 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001415">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid12830"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90244683</obo:IAO_0000112>
        <obo:IAO_0000115>A long-term, multicentre study funded by the US National Institute of Mental Health that enrolled outpatients aged 15 or older with any subtype of bipolar disorder at 22 academic medical centres in the United States and followed them over seven years. All participants entered a naturalistic standard care pathway, with randomized care pathways for acute and refractory depression, to answer questions about the effectiveness of treatments for bipolar disorder.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4360</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>STEP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STEP-BD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Systematic Treatment Enhancement Program for Bipolar Disorder</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12830">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004985"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001415"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12830"/>
        <obo:IAO_0000116>bipolar disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35773558+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Data were drawn from the Systematic Treatment Enhancement Program for Bipolar Disorder (STEP-BD), a naturalistic study of 4360 outpatients 15 years or older with BD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001415"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9247121/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study was conducted across 22 academic medical centers in the United States and was approved by the institutional review board of the participating institutions.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001415"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244683</owl:annotatedTarget>
        <dcterms:title>Body weight changes and bipolar disorder: a molecular pathway analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36305391</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36305391+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The STEP-BD sample is analyzed through a hypothesis-free molecular pathway analysis in order to detect the molecular pathways that distinguish individuals who experience weight change during BD treatment from those who do not.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001415"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A long-term, multicentre study funded by the US National Institute of Mental Health that enrolled outpatients aged 15 or older with any subtype of bipolar disorder at 22 academic medical centres in the United States and followed them over seven years. All participants entered a naturalistic standard care pathway, with randomized care pathways for acute and refractory depression, to answer questions about the effectiveness of treatments for bipolar disorder.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25844303</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35773558</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001415"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4360</owl:annotatedTarget>
        <obo:IAO_0000116>outpatients aged 15+ with bipolar disorder enrolled</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:35773558</oboInOwl:hasDbXref>
        <rdfs:comment>Data were drawn from the Systematic Treatment Enhancement Program for Bipolar Disorder (STEP-BD), a naturalistic study of 4360 outpatients 15 years or older with BD.</rdfs:comment>
