        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000864"/>
        <obo:IAO_0000112>PMID:22367405</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of lung cancer in ethnic Chinese in the Shanghai area of China, whose cases were patients presenting with primary lung cancer and whose controls were patients diagnosed with diseases unrelated to any cancer at four hospitals (Shanghai Changhai Hospital, Jiangsu Taizhou People&apos;s Hospital, Zhongshan Hospital of Fudan University and Shanghai Chest Hospital); it is one of the studies pooled in the Female Lung Cancer Consortium in Asia.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">295</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">386</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>FLCS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Fudan Lung Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15498">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001733"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15498"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Cases were patients who presented to these hospitals with primary lung cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001733"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The FLCS enrolled cases and controls from four hospitals in the Shanghai area of China.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001733"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22367405</owl:annotatedTarget>
        <dcterms:title>Genetic variant in TP63 on locus 3q28 is associated with risk of lung adenocarcinoma among never-smoking females in Asia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22367405</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3875137/</oboInOwl:hasDbXref>
        <rdfs:comment>For this effort, we pooled an additional three studies from Mainland China, including the Shenyang Lung Cancer Study (SLCS) (Yin et al. 2009), the Fudan Lung Cancer Study (FLCS), and the Tianjin Lung Cancer Study (TLCS) (Qian et al. 2011).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001733"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of lung cancer in ethnic Chinese in the Shanghai area of China, whose cases were patients presenting with primary lung cancer and whose controls were patients diagnosed with diseases unrelated to any cancer at four hospitals (Shanghai Changhai Hospital, Jiangsu Taizhou People&apos;s Hospital, Zhongshan Hospital of Fudan University and Shanghai Chest Hospital); it is one of the studies pooled in the Female Lung Cancer Consortium in Asia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23143601</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
