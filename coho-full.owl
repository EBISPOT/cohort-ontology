        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005098"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002016"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17671"/>
        <obo:IAO_0000116>atrial fibrillation</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13300126/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The LOOP study (Atrial Fibrillation Detected by Continuous ECG Monitoring Using Implantable Loop Recorder to Prevent Stroke in High-Risk Individuals) randomised 6,004 individuals aged 70 years or older without AF but with risk factors for AF and stroke to either screening with ILR or usual care.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002016"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17673"/>
        <obo:IAO_0000116>stroke</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13300126/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The LOOP study (Atrial Fibrillation Detected by Continuous ECG Monitoring Using Implantable Loop Recorder to Prevent Stroke in High-Risk Individuals) randomised 6,004 individuals aged 70 years or older without AF but with risk factors for AF and stroke to either screening with ILR or usual care.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002016"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC13350093/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>We also assessed the Mult-t-EUR score in the LOOP study, a Danish clinical trial assessing implantable loop recorder (ILR) screening in older participants without AF but at elevated cardiovascular risk.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002016"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS004706</owl:annotatedTarget>
        <dcterms:title>Multi-trait polygenic risk scores improve genomic prediction of atrial fibrillation across diverse ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42086565</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002016"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42086565</owl:annotatedTarget>
        <dcterms:title>Multi-trait polygenic risk scores improve genomic prediction of atrial fibrillation across diverse ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42086565</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC13350093/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>We also assessed the Mult-t-EUR score in the LOOP study, a Danish clinical trial assessing implantable loop recorder (ILR) screening in older participants without AF but at elevated cardiovascular risk.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002016"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Danish randomised clinical trial, Atrial Fibrillation Detected by Continuous ECG Monitoring Using Implantable Loop Recorder to Prevent Stroke in High-Risk Individuals, which randomised 6,004 individuals aged 70 years or older without atrial fibrillation but with risk factors for atrial fibrillation and stroke to screening with an implantable loop recorder, with anticoagulation upon detection of atrial fibrillation, or usual care; its participants’ genetic data are used to evaluate polygenic scores for atrial fibrillation.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:42086565</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13300126/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002016"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6004</owl:annotatedTarget>
        <obo:IAO_0000116>participants randomised (1:3 to implantable loop recorder or usual care)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13350093/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>LOOP was a randomized clinical trial, including 6004 participants at risk of AF but without diagnosed AF, with 1:3 randomization to screening with an implantable loop recorder (ILR) and anticoagulation upon detection of AF or usual care (Supplementary Note 2).</rdfs:comment>
    </owl:Axiom>
