        <oboInOwl:hasRelatedSynonym>CARE subglottic stenosis cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <rdfs:label xml:lang="en">Canadian Airways Research Group</rdfs:label>
