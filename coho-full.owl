        <oboInOwl:hasRelatedSynonym>Queensland Twin Registry Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Queensland Twin and Family Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Queensland Twin Registry</rdfs:label>
