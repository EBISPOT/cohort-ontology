    <!-- http://www.ebi.ac.uk/coho/COHO_0001021 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001021">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid9315"/>
        <rdf:type rdf:nodeID="genid9317"/>
        <obo:IAO_0000112>GCST90570641</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium that meta-analyses genome-wide association data on suicide attempt and suicide death from cohorts worldwide, including cohorts ascertained for psychiatric disorders or substance use, studies of suicide or suicide attempt, and population-based biobanks, to identify genetic risk loci for suicidal behaviour and separate them from those of psychiatric disorders.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">29782</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">519961</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>ISGC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International Suicide Genomics Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">International Suicide Genetics Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9315">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_5200330"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid9317">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_5200330"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9315"/>
        <obo:IAO_0000116>suicide attempt</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8851871/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we present the first GWAS meta-analysis of SA from the International Suicide Genetics Consortium (ISGC), including over 29,000 SA or suicide cases from 18 cohorts worldwide.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001021"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9317"/>
        <obo:IAO_0000116>suicide</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8851871/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we present the first GWAS meta-analysis of SA from the International Suicide Genetics Consortium (ISGC), including over 29,000 SA or suicide cases from 18 cohorts worldwide.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90570641</owl:annotatedTarget>
        <dcterms:title>Correlates of suicidal behaviors and genetic risk among United States veterans with schizophrenia or bipolar I disorder.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38491344</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-024-02472-1/MediaObjects/41380_2024_2472_MOESM1_ESM.docx</oboInOwl:hasDbXref>
        <rdfs:comment>(bottom) Forest plot of effect sizes in CSP #572, PGC, and ISGC GWAS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001021"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium that meta-analyses genome-wide association data on suicide attempt and suicide death from cohorts worldwide, including cohorts ascertained for psychiatric disorders or substance use, studies of suicide or suicide attempt, and population-based biobanks, to identify genetic risk loci for suicidal behaviour and separate them from those of psychiatric disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34861974</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001021"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
