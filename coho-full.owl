        <obo:IAO_0000115>A prospective single-centre population-based study of community-dwelling elderly people without stroke or dementia, randomly selected from the community register of Graz, Austria, and enrolled between 1991 and 2004, examining the effects of vascular risk factors on brain structure and function in normal ageing.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym ASPS also denotes Austrian Stroke Prevention Family Study (COHO:0000858); this term is Austrian Stroke Prevention Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1960</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ASPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Austrian Stroke Prevention Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid7801">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005098"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid7803">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011057"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000857"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7801"/>
        <obo:IAO_0000116>stroke</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8751593/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The ASPS is a prospective single-centre community-based study established in 1991 on the cerebral effects of vascular risk factors in the normal aged population of the city of Graz, Austria.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000857"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7803"/>
        <obo:IAO_0000116>cerebrovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8751593/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The ASPS is a prospective single-centre community-based study established in 1991 on the cerebral effects of vascular risk factors in the normal aged population of the city of Graz, Austria.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000857"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Austria"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8064143/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Randomly selected individuals from the community register of the city of Graz, Austria, were enrolled between 1991 and 2004.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000857"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90239648</owl:annotatedTarget>
        <dcterms:title>Genetic architecture of orbital telorism.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34791242</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9071440/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In short, we included 34 130 participants from four population-based studies, namely the UK Biobank (20) (N = 28 919), the Austrian Stroke Prevention Study (ASPS) (N = 183), the ASPS Family Study (ASPS-Fam) (21,22) (N = 302) and the Rotterdam Study (23,24) (N = 4726).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000857"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective single-centre population-based study of community-dwelling elderly people without stroke or dementia, randomly selected from the community register of Graz, Austria, and enrolled between 1991 and 2004, examining the effects of vascular risk factors on brain structure and function in normal ageing.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8064143/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000857"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1960</owl:annotatedTarget>
        <obo:IAO_0000116>randomly selected subjects aged 50-75 recruited in the first 3-year enrolment period (1991-1994)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:9139470</oboInOwl:hasDbXref>
        <rdfs:comment>The Austrian Stroke Prevention Study recruited 1960 randomly selected subjects aged 50 to 75 years during a 3-year period of enrollment.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000857"/>
