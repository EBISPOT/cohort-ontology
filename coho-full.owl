        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:26868379</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium established in 2007 that pools harmonized individual-level epidemiologic and germline genetic data from independent case-control and cohort studies to investigate causes of childhood leukemia and other childhood cancers, with its scope expanded to other cancers in 2019. Its collaborative analyses examine environmental and genetic risk factors, their interactions, exposure timing, and differences among disease subtypes.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">150000</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">300000</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>CLIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Childhood Leukemia International Consortium</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Childhood Cancer and Leukemia International Consortium</rdfs:label>
    </owl:NamedIndividual>
