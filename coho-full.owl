        <obo:IAO_0000116>cases and controls analysed in the 2010 NGRC genome-wide association study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.642/MediaObjects/41588_2010_BFng642_MOESM8_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Parkinson 2014 99.92±0.08 1 13 2000 67.3 58.34±11.93 67.26±10.67 Controls 1999 99.92±0.08 3 10 1986 38.7 -- 70.32±14.09 Total 4013 99.92±0.08 4 23 3986</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001108"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1986</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls analysed in the 2010 NGRC genome-wide association study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.642/MediaObjects/41588_2010_BFng642_MOESM8_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Parkinson 2014 99.92±0.08 1 13 2000 67.3 58.34±11.93 67.26±10.67 Controls 1999 99.92±0.08 3 10 1986 38.7 -- 70.32±14.09 Total 4013 99.92±0.08 4 23 3986</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001108"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3986</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls analysed in the 2010 NGRC genome-wide association study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.642/MediaObjects/41588_2010_BFng642_MOESM8_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Parkinson 2014 99.92±0.08 1 13 2000 67.3 58.34±11.93 67.26±10.67 Controls 1999 99.92±0.08 3 10 1986 38.7 -- 70.32±14.09 Total 4013 99.92±0.08 4 23 3986</rdfs:comment>
    </owl:Axiom>
