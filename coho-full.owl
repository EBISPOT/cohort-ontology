    <!-- http://www.ebi.ac.uk/coho/COHO_0002394 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002394">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20313"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001678"/>
        <obo:IAO_0000112>PMID:22286212</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based series of patients with Hodgkin lymphoma in Scotland and northern England, collected through the Scotland and Newcastle Lymphoma Group, a clinical collaborative group that registered lymphoma patients in these regions prospectively on a shared database from 1979; the genetic series comprises the Scotland and Newcastle Epidemiological Study of Hodgkin&apos;s Disease, a case–control study conducted in 1993–1997, and a local case series collected prospectively in 1992–2008, and its cases were genotyped in European genome-wide association studies of classical Hodgkin lymphoma.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">282</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">32</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>SNLG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Scotland and Newcastle Lymphoma Group series</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Scotland and Newcastle Lymphoma Group</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20313">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004952"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002394"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20313"/>
        <obo:IAO_0000116>Hodgkin lymphoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3274508/</oboInOwl:hasDbXref>
        <rdfs:comment>The Scotland and Newcastle Lymphoma Group includes the Scotland and Newcastle Epidemiological Study of Hodgkin&apos;s Disease, which is a case–control study conducted in Scotland and Northern England between January 1993 and July 1997 (6), and the “local case series,” a prospectively collected series of patients within those regions between January 1992 and March 2008 (9).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002394"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3274508/</oboInOwl:hasDbXref>
        <rdfs:comment>The Scotland and Newcastle Lymphoma Group includes the Scotland and Newcastle Epidemiological Study of Hodgkin&apos;s Disease, which is a case–control study conducted in Scotland and Northern England between January 1993 and July 1997 (6), and the “local case series,” a prospectively collected series of patients within those regions between January 1992 and March 2008 (9).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002394"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22286212</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of classical Hodgkin lymphoma and Epstein-Barr virus status-defined subgroups.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22286212</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3274508/</oboInOwl:hasDbXref>
        <rdfs:comment>Genome-wide genotyping was performed on cHL case samples from five European-based HL studies: the EPILYMPH Study, the Scotland and Newcastle Lymphoma Group, the Young Adult Hodgkin’s Disease Case–Control Study, the Scandinavian Lymphoma Etiology Study, and the Northern Dutch Hodgkin Lymphoma Study (Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002394"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based series of patients with Hodgkin lymphoma in Scotland and northern England, collected through the Scotland and Newcastle Lymphoma Group, a clinical collaborative group that registered lymphoma patients in these regions prospectively on a shared database from 1979; the genetic series comprises the Scotland and Newcastle Epidemiological Study of Hodgkin&apos;s Disease, a case–control study conducted in 1993–1997, and a local case series collected prospectively in 1992–2008, and its cases were genotyped in European genome-wide association studies of classical Hodgkin lymphoma.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15359994</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:2069849</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22286212</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
