        <obo:IAO_0000112>GCST90451684</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based study of aging of 1,453 residents aged 20 to 102, mostly older people, selected by multistage sampling from the registries of Greve in Chianti and Bagno a Ripoli in Tuscany, Italy, examined at baseline in 1998-2000 and followed up to identify risk factors for the loss of walking ability and other age-related decline.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1453</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Aging in Chianti</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>INCHIANTI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>InCHIANTI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>InCHIANTI study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Invecchiare in Chianti</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Invecchiare in Chianti</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000570"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12452345/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The InCHIANTI (“Invecchiare in Chianti”) study is a prospective study of aging conducted in two municipalities (Bagno a Ripoli and Greve in Chianti) in Tuscany, Italy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000570"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90451684</owl:annotatedTarget>
        <dcterms:title>Novel loci and biomedical consequences of iron homoeostasis variation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39643614</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11624196/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>InCHIANTI. The study baseline (1998-2000) was supported by the Italian Ministry of Health (ICS110.1/RF97.71)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000570"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based study of aging of 1,453 residents aged 20 to 102, mostly older people, selected by multistage sampling from the registries of Greve in Chianti and Bagno a Ripoli in Tuscany, Italy, examined at baseline in 1998-2000 and followed up to identify risk factors for the loss of walking ability and other age-related decline.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11129752</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40981293</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000570"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1453</owl:annotatedTarget>
        <obo:IAO_0000116>participants recruited at baseline, aged 20-102 (1998-2000)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:40981293</oboInOwl:hasDbXref>
        <rdfs:comment>In brief, a total of 1453 participants spanning various age groups were recruited at baseline in 1998–2000 via two-stage sampling methods and then followed longitudinally.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
