    <!-- http://www.ebi.ac.uk/coho/COHO_0001719 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001719">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15380"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>PMID:21655089</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based series of colorectal cancer patients, run from the University of Helsinki, in which tumour and normal tissue were collected from consecutive newly diagnosed patients at nine central hospitals in south-eastern Finland in 1994–1998, and afterwards at two of them, to find hereditary nonpolyposis colorectal cancer and other inherited predisposition to colorectal cancer; its genetic association studies compared the patients with Finnish blood donors from the same region.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1514</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>FCCPS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Finnish Colorectal Cancer Predisposition Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15380">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005575"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001719"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15380"/>
        <obo:IAO_0000116>colorectal cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2836775/</oboInOwl:hasDbXref>
        <rdfs:comment>FCCPS: 962 CRC cases (509 males, 452 females, one unknown; mean age at diagnosis 66.9 years; s.d. ± 12.2) and 846 controls (randomly selected anonymous Finnish blood donors) ascertained in southeastern Finland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001719"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3107194/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Helsinki (FCCPS) study (http://research.med.helsinki.fi/gsb/aaltonen/) comprised 988 cases from a population-based collection centred on south-eastern Finland and 864 population controls from the same collection.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001719"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21655089</owl:annotatedTarget>
        <dcterms:title>Multiple common susceptibility variants near BMP pathway loci GREM1, BMP4, and BMP2 explain part of the missing heritability of colorectal cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21655089</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3107194/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Helsinki (FCCPS) study (http://research.med.helsinki.fi/gsb/aaltonen/) comprised 988 cases from a population-based collection centred on south-eastern Finland and 864 population controls from the same collection.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001719"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based series of colorectal cancer patients, run from the University of Helsinki, in which tumour and normal tissue were collected from consecutive newly diagnosed patients at nine central hospitals in south-eastern Finland in 1994–1998, and afterwards at two of them, to find hereditary nonpolyposis colorectal cancer and other inherited predisposition to colorectal cancer; its genetic association studies compared the patients with Finnish blood donors from the same region.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10829038</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19011631</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19920828</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20501757</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24146633</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001719"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1514</owl:annotatedTarget>
        <obo:IAO_0000116>consecutive colorectal cancer patients in the series (2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:24146633</oboInOwl:hasDbXref>
        <rdfs:comment>To identify susceptibility genes for this common phenotype, we examined familial cases derived from a consecutive series of 1514 Finnish CRC patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001719"/>
