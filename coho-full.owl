    <!-- http://www.ebi.ac.uk/coho/COHO_0001522 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001522">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13769"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000551"/>
        <obo:IAO_0000112>PMID:24958192</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control cohort for genetic studies of Alzheimer&apos;s disease, drawn from a prospective study of Alzheimer&apos;s disease in Flanders, Belgium, whose genetic studies are run from the University of Antwerp: unrelated patients with early- or late-onset possible or probable Alzheimer&apos;s disease, diagnosed by consensus of at least two neurologists at the memory clinics of the Hospital Network Antwerp (Middelheim and Hoge Beuken) and the University Hospitals Leuven and at other neurology centres of the Belgian Neurology (BELNEU) consortium, and healthy unrelated control individuals from Belgium, patients&apos; partners or community volunteers, with blood samples for DNA, cell lines and plasma and, for some patients, cerebrospinal fluid biomarkers.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1263</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1107</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2370</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Belgium_AD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Flanders-Belgian study cohort</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Flanders-Belgian AD cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13769">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004975"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001522"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13769"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4370231/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Flanders-Belgian study cohort (Belgium_AD, n = 2370), was ascertained in the frame of a prospective study of AD, as previously described in.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001522"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01024-z/MediaObjects/41588_2022_1024_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The patients were ascertained at the memory clinic of Middelheim and Hoge Beuken (Hospital Network Antwerp, Belgium) and at the memory clinic of the University Hospitals of Leuven, Belgium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001522"/>
