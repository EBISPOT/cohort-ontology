    <!-- http://www.ebi.ac.uk/coho/COHO_0002702 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002702">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22856"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002069"/>
        <obo:IAO_0000112>PMID:19198609</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of premature coronary artery disease at Massachusetts General Hospital in Boston, United States, with recruitment reported from 1999. Its Myocardial Infarction Genetics Consortium sample comprised men aged 50 or younger and women aged 60 or younger hospitalized with myocardial infarction between 1999 and 2004, with age- and sex-matched controls recruited through newspaper advertisements in Boston and its vicinity who reported no cardiovascular disease or cardiac medication use.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">295</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">145</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>MGH PCAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MGH Premature Coronary Artery Disease Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Massachusetts General Hospital Premature Coronary Artery Disease</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Massachusetts General Hospital Premature Coronary Artery Disease Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22856">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005542"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002702"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22856"/>
        <obo:IAO_0000116>acute coronary syndrome</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1289285/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Inclusion criteria were; documented acute coronary syndrome (myocardial infarction or unstable angina) confirmed on coronary angiogram; and age ≤ 50 years for males or ≤ 55 years for females.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002702"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2681011/</oboInOwl:hasDbXref>
        <rdfs:comment>Stage 1 consisted of the Myocardial Infarction Genetics Consortium (MIGen), a collection of 2,967 cases of early-onset MI (in men ≤50 years old or women ≤60 years old) and 3,075 age- and sex-matched controls free of MI from six international sites: Boston and Seattle in the United States as well as Sweden, Finland, Spain, and Italy (Table 1 and Supplementary Methods).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002702"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:19198609</owl:annotatedTarget>
        <dcterms:title>Genome-wide association of early-onset myocardial infarction with single nucleotide polymorphisms and copy number variants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:19198609</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>MGH PCAD3 study is a hospital-based case-control study of cases of early-onset MI and controls matched on age and sex.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002702"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of premature coronary artery disease at Massachusetts General Hospital in Boston, United States, with recruitment reported from 1999. Its Myocardial Infarction Genetics Consortium sample comprised men aged 50 or younger and women aged 60 or younger hospitalized with myocardial infarction between 1999 and 2004, with age- and sex-matched controls recruited through newspaper advertisements in Boston and its vicinity who reported no cardiovascular disease or cardiac medication use.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16262891</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19198609</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>GPT-6 (OpenAI), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002702"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">295</owl:annotatedTarget>
        <obo:IAO_0000116>Recruitment of patients with premature coronary artery disease presenting as acute coronary syndromes and outpatient controls during 1999–2003, reported in the original 2005 profile PMID:16262891; not the later MIGen GWAS sample.</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1289285/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>During the study period we enrolled 295 subjects with premature CAD and 145 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002702"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">145</owl:annotatedTarget>
        <obo:IAO_0000116>Recruitment of patients with premature coronary artery disease presenting as acute coronary syndromes and outpatient controls during 1999–2003, reported in the original 2005 profile PMID:16262891; not the later MIGen GWAS sample.</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1289285/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>During the study period we enrolled 295 subjects with premature CAD and 145 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002702"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MGH PCAD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


