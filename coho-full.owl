        <oboInOwl:hasRelatedSynonym>Metabolic Syndrome Berlin-Potsdam</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Metabolisches Syndrom Berlin Potsdam</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Metabolic Syndrome Berlin Potsdam Study</rdfs:label>
    </owl:NamedIndividual>
