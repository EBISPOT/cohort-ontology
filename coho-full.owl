        <obo:IAO_0000112>GCST006085</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:24484606</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of men aged 40–69 years from families with BRCA1 or BRCA2 mutations, including mutation carriers and age-matched non-carriers, undergoing annual prostate-specific antigen testing in an international investigation of targeted prostate-cancer screening.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym IMPACT also denotes Immune and Metabolic Markers during Pregnancy and Child Development Study (COHO:0000443), written IMPaCT; this term is Identification of Men with a genetic predisposition to ProstAte Cancer.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3063</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>IMPACT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Identification of Men with a genetic predisposition to ProstAte Cancer</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid1178">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000097"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid1178"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20840664+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Men aged 40-69 years from families with BRCA1 or BRCA2 mutations were offered annual prostate specific antigen (PSA) testing, and those with PSA &gt; 3 ng/mL, were offered a prostate biopsy. Controls were men age-matched (± 5 years) who were negative for the familial mutation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000097"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8576477/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>eight countries (Australia, Israel, Italy, Norway, Portugal, Spain, the UK, and the USA</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000097"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST006085</owl:annotatedTarget>
        <dcterms:title>Association analyses of more than 140,000 men identify 63 new prostate cancer susceptibility loci.</dcterms:title>
