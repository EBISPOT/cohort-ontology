        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international prostate cancer genetics consortium, linked to the PRACTICAL consortium, that meta-analyses existing genome-wide association data and generates new GWAS, exome-array, iCOGS and OncoArray genotype data from prostate cancer case-control studies to discover prostate cancer risk loci.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001120.v1.p1</obo:IAO_0000119>
