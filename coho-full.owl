    <!-- http://www.ebi.ac.uk/coho/COHO_0002247 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002247">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002246"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. PEGASUS-TIMI_54 is the PEGASUS-TIMI 54 trial of ticagrelor after myocardial infarction, pooled with other TIMI trials in the papers the PGS Catalog records the id in (PMID:33185476, PMID:36474045, PMID:41419686). Replaced by COHO:0002246 (Prevention of Cardiovascular Events in Patients with Prior Heart Attack Using Ticagrelor Compared to Placebo on a Background of Aspirin), which now carries this term&apos;s names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete PEGASUS-TIMI 54</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002248 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002248">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19259"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Peru"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>PGS000317</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:36925912</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based cohort of women diagnosed with invasive breast cancer in 2010 or later at ages 21 to 79 and recruited at the Instituto Nacional de Enfermedades Neoplásicas (INEN) in Lima, Peru, who complete a standardised survey and give a blood sample for genotyping, with tumour subtypes from pathology at INEN, used to study genetic ancestry and other factors in breast cancer among Peruvian women.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1943</coho:numberOfCases>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1943</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PEGEN-BC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Peruvian Genetics and Genomics of Breast Cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Peruvian Genetics and Genomics of Breast Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Peru Genetics and Genomics of Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19259">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006256"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002248"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19259"/>
        <obo:IAO_0000116>invasive breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10013058/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Women were invited to participate if they had a diagnosis of invasive breast cancer in 2010 or later and were between 21 and 79 years of age when diagnosed.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002248"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Peru"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10013058/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As of April 2022, we have recruited 1,943 participants from the INEN in Lima, Peru.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002248"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000317</owl:annotatedTarget>
        <dcterms:title>A Polygenic Risk Score for Breast Cancer in US Latinas and Latin American Women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31553449</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002248"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:36925912</owl:annotatedTarget>
        <dcterms:title>Breast cancer subtype and clinical characteristics in women from Peru.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36925912</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10013058/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The PEGEN-BC study is a hospital-based breast cancer cohort that includes 1943 patients diagnosed at the Instituto Nacional de Enfermedades Neoplásicas in Lima, Peru.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002248"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based cohort of women diagnosed with invasive breast cancer in 2010 or later at ages 21 to 79 and recruited at the Instituto Nacional de Enfermedades Neoplásicas (INEN) in Lima, Peru, who complete a standardised survey and give a blood sample for genotyping, with tumour subtypes from pathology at INEN, used to study genetic ancestry and other factors in breast cancer among Peruvian women.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36925912</obo:IAO_0000119>
