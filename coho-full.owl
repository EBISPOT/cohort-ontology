        <obo:IAO_0000112>PMID:42013351</obo:IAO_0000112>
        <obo:IAO_0000115>A single-centre, hospital-based case cohort of women with ovarian, fallopian tube or primary peritoneal cancer in Malaysia, recruited consecutively at a private hospital from October 2008 to February 2015 and tested for germline variants in BRCA1 and BRCA2; it takes part in the Ovarian Cancer Association Consortium under the study code MAS.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MAS also denotes German Multicenter Allergy Study (COHO:0001178) and Sydney Memory and Ageing Study (COHO:0002033); this term is Malaysian Ovarian Cancer Genetic Study.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">218</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Malaysia Ovarian Cancer Genetic Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Malaysia Ovarian Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MyOvCa</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Malaysian Ovarian Cancer Genetic Study</rdfs:label>
    </owl:NamedIndividual>
