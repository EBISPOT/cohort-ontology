    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002748"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23344"/>
        <obo:IAO_0000116>HIV infection</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://clinicaltrials.gov/api/v2/studies/NCT00310726</oboInOwl:hasDbXref>
        <rdfs:comment>All HIV-seropositive pregnant subjects electing to breastfeed their child will be counselled to exclusively breastfeed through 4 months of age.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002748"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23346"/>
        <obo:IAO_0000116>abrupt weaning at 4 months versus continued breastfeeding</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://clinicaltrials.gov/api/v2/studies/NCT00310726</oboInOwl:hasDbXref>
        <rdfs:comment>The primary objective of the study, based on the random assignment, is to compare HIV transmission rates and under-2 year mortality rates in children who abruptly wean at four months of age versus children who are weaned according to local practice.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002748"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Zambia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2137948/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>HIV-infected women were recruited between May 2001 and September 2004 from prevention of mother-to-child transmission (PMTCT) programs established at two antenatal clinics in Lusaka, Zambia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002748"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS2307</owl:annotatedTarget>
        <dcterms:title>Altered milk tryptophan and tryptophan metabolites and health of children born to women with HIV (ZEBS study milk assays).</dcterms:title>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS2307</oboInOwl:hasDbXref>
        <rdfs:comment>Altered milk tryptophan and tryptophan metabolites and health of children born to women with HIV (ZEBS study milk assays).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002748"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised trial in Lusaka, Zambia, in which HIV-infected women who planned to breastfeed exclusively to four months were assigned to counselling that encouraged abrupt weaning at four months or continued breastfeeding, to evaluate the effect of early weaning on the HIV-free survival of their children to 24 months.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18525036</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002748"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">958</owl:annotatedTarget>
        <obo:IAO_0000116>HIV-infected women and their infants enrolled and randomised (2004)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18525036+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We enrolled 958 HIV-infected women and their infants in Lusaka, Zambia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002748"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ZEBS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002749 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002749">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
