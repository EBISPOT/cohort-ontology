        <oboInOwl:hasRelatedSynonym>Luxembourg Parkinson Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Luxembourg Parkinson&apos;s study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
