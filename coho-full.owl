    <!-- http://www.ebi.ac.uk/coho/COHO_0000714 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000714">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000832"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90627735</obo:IAO_0000112>
        <obo:IAO_0000115>A genotype-phenotype resource assembled at Mayo Clinic from participants of multiple Mayo Clinic research studies who gave general research consent to share their high-throughput genotyping data, linked to electronic medical record data for phenotype extraction, to enable cost-effective genome-wide association studies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6307</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Mayo Clinic Genome Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MayoGC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Mayo Genome Consortia</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000714"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000832"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3127556/</oboInOwl:hasDbXref>
        <rdfs:comment>Phase 1, which has been completed, includes participants from 3 studies funded by the National Institutes of Health, which sought to identify genetic determinants of peripheral arterial disease (PAD), venous thromboembolism, and pancreatic cancer, respectively, with a combined total sample size of 6307 unique participants</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000714"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC11396662/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>These cohorts consisted of four US-based sites (Vanderbilt University Medical Center’s BioVu, the Mass General Brigham Biobank, Mount Sinai’s BioMe, and Mayo Clinic’s MayoGC) and six non-US sites (iPSYCH from Denmark, FinnGen, HUNT Study from Norway, STR-STAGE from Sweden, UK Biobank, and Estonia Biobank).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000714"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90627735</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analyses identify 95 risk loci and provide insights into the neurobiology of post-traumatic stress disorder.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38637617</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC11396662/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>These cohorts consisted of four US-based sites (Vanderbilt University Medical Center’s BioVu, the Mass General Brigham Biobank, Mount Sinai’s BioMe, and Mayo Clinic’s MayoGC) and six non-US sites (iPSYCH from Denmark, FinnGen, HUNT Study from Norway, STR-STAGE from Sweden, UK Biobank, and Estonia Biobank).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000714"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genotype-phenotype resource assembled at Mayo Clinic from participants of multiple Mayo Clinic research studies who gave general research consent to share their high-throughput genotyping data, linked to electronic medical record data for phenotype extraction, to enable cost-effective genome-wide association studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21646302</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000714"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6307</owl:annotatedTarget>
        <obo:IAO_0000116>unique genotyped participants in phase 1 (three contributing studies), 2011</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC3127556</oboInOwl:hasDbXref>
        <rdfs:comment>Phase 1, which has been completed, includes participants from 3 studies funded by the National Institutes of Health, which sought to identify genetic determinants of peripheral arterial disease (PAD), venous thromboembolism, and pan- creatic cancer, respectively, with a combined total sample size of 6307 unique participants (Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000714"/>
