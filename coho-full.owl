        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000022 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000022">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid519"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000227"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001134"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001135"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001137"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001448"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>EGAS00001007563</obo:IAO_0000112>
        <obo:IAO_0000112>GCST90020034</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of institutional cancer trial cohorts, established in 1956 as the Acute Leukemia Group B, that coordinates trials of treatments for adult solid tumours and haematological malignancies to improve patient outcomes and investigate malignant disease biology.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CALGB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Cancer and Leukemia Group B</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid519">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004992"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid519"/>
        <obo:IAO_0000116>cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16740784+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In the ensuing 50 years, the Cancer and Leukemia Group B has expanded to national and even international membership, and its research programs have expanded to include all of the common adult solid tumors and hematologic malignancies in a multidisciplinary effort to improve the outcomes for patients with cancer and to better understand the biology of malignant disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000227"/>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001007563</oboInOwl:hasDbXref>
        <rdfs:comment>two phase III trials, namely NeoALTTO and CALGB 40601</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001134"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2917317/</oboInOwl:hasDbXref>
        <rdfs:comment>These encouraging data led Cancer and Leukemia Group B (CALGB) to conduct a double-blind, placebo-controlled, randomized phase III trial of gemcitabine/bevacizumab versus gemcitabine/placebo in advanced pancreatic cancer patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001135"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3383121/</oboInOwl:hasDbXref>
        <rdfs:comment>The study was designed by the CALGB, endorsed by the ECOG, and approved by the NCI Cancer Therapy Evaluation Program (CTEP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001137"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5012690/</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted Cancer and Leukemia Group B (CALGB, now known as Alliance) 40503, a randomized phase III trial, to determine whether bevacizumab can prolong progression-free survival (PFS) when added to first-line ET with letrozole for hormone receptor–positive advanced-stage breast cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001448"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4500830/</oboInOwl:hasDbXref>
        <rdfs:comment>The Cancer and Leukemia Group B (CALGB) 40502 (Paclitaxel, Nab-Paclitaxel, or Ixabepilone With or Without Bevacizumab in Treating Patients With Stage IIIC or Stage IV Breast Cancer) trial was a three-arm randomized phase III trial comparing paclitaxel once per week to nanoparticle albumin-bound nab-paclitaxel once per week and to ixabepilone as first-line chemotherapy with bevacizumab for locally recurrent or metastatic BC.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://academic.oup.com/jncics/article/4/1/pkz078/5588850?searchresult=1</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were recruited from 508 study sites in the United States and Canada.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS00001007563</owl:annotatedTarget>
        <dcterms:title>Immunological and clinicopathological features predict HER2-positive breast cancer prognosis in the neoadjuvant NeoALTTO and CALGB 40601 randomized trials.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37923752</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001007563</oboInOwl:hasDbXref>
        <rdfs:comment>we investigated the complexity of B and T cell receptor (BCR and TCR) repertoires, reflecting antigen-specific immune response, in the context of two phase III trials, namely NeoALTTO and CALGB 40601</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90020034</owl:annotatedTarget>
        <dcterms:title>Genome-wide association studies of survival in 1520 cancer patients treated with bevacizumab-containing regimens.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34528705</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8627468/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The phase III clinical trials included in this study are from the Cancer and Leukemia Group B</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium of institutional cancer trial cohorts, established in 1956 as the Acute Leukemia Group B, that coordinates trials of treatments for adult solid tumours and haematological malignancies to improve patient outcomes and investigate malignant disease biology.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16740784</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>GPT-6 (OpenAI Codex), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000022"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CALGB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


