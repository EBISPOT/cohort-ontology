    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002721"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23103"/>
        <obo:IAO_0000116>acoustic neuroma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&amp;id=11150357&amp;retmode=xml</oboInOwl:hasDbXref>
        <rdfs:comment>We enrolled 782 patients through hospitals in Phoenix, Arizona; Boston; and Pittsburgh; 489 had histologically confirmed glioma, 197 had meningioma, and 96 had acoustic neuroma. The 799 controls were patients admitted to the same hospitals as the patients with brain tumors for a variety of nonmalignant conditions.</rdfs:comment>
    </owl:Axiom>
