        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based breast cancer case-control study of the University of Oulu and Oulu University Hospital, Finland, whose cases are breast cancer patients from Northern Finland, unselected for age and family history, collected at Oulu University Hospital from 2000 onwards, and whose controls are healthy female blood donors of the Finnish Red Cross from the Oulu area; it studies inherited susceptibility to breast cancer and contributes to the Breast Cancer Association Consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27542569</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28702895</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30177847</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
