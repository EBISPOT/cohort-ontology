    <!-- http://www.ebi.ac.uk/coho/COHO_0002615 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002615">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22004"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>PMID:34909561</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal cohort of healthy pregnant and non-pregnant women in Finland, enrolled by the University of Oulu from 2022 within the EU Human Exposome Assessment Platform (HEAP) project and followed for at least four months with wearable personal exposome monitors and repeated biological sampling (blood, saliva, sweat, urine), to pilot personal profiling of chemical and biological exposures.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/WDC</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>HEAP wearable sensor cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Monitoring exposures during pregnancy with a wearable device</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WDC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Wearable data collection study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22004">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ExO_0000002"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002615"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22004"/>
        <obo:IAO_0000116>exposome estimated from blood, saliva, sweat and personal aerosols</obo:IAO_0000116>
        <obo:IAO_0000116>multiple exposures monitored with wearable exposure sensors</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/WDC</oboInOwl:hasDbXref>
        <rdfs:comment>Longitudinal cohort of pregnant and non-pregnant women for exposome estimation from blood, saliva, sweat and personal aerosols.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002615"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://api.datacite.org/dois/10.5281/zenodo.7499101</oboInOwl:hasDbXref>
        <rdfs:comment>This improved PEM will be used for longitudinal monitoring of pregnant women from the Finnish Maternity Cohort (FMC), which collects data and samples from all pregnant women in Finland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002615"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34909561</owl:annotatedTarget>
        <dcterms:title>Human exposome assessment platform.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34909561</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8663864/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Some of the pregnant women in the HPV vaccination Cohort (~100 pregnant women) will be followed using an innovative wearable exposure sensors system for the monitoring of multiple exposures and health measurements, to investigate how the exposome influences the health of the mother and the baby.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002615"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal cohort of healthy pregnant and non-pregnant women in Finland, enrolled by the University of Oulu from 2022 within the EU Human Exposome Assessment Platform (HEAP) project and followed for at least four months with wearable personal exposome monitors and repeated biological sampling (blood, saliva, sweat, urine), to pilot personal profiling of chemical and biological exposures.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34909561</obo:IAO_0000119>
        <obo:IAO_0000119>https://api.datacite.org/dois/10.5281/zenodo.10707225</obo:IAO_0000119>
        <obo:IAO_0000119>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/WDC</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002615"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">100</owl:annotatedTarget>
        <obo:IAO_0000116>healthy pregnant and non-pregnant women</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://api.datacite.org/dois/10.5281/zenodo.10707225</oboInOwl:hasDbXref>
        <rdfs:comment>The wearablesensor cohort in HEAP consists of healthy pregnant and non-pregnant women (N=100)followed up for at least four months with systematic longitudinal sampling using wearablesdevices and urine sampling.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002615"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>WDC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002616 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002616">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22011"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Czech_Republic"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:30011827</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based cohort of a random, sex- and age-stratified 1% sample of residents of Brno, Czech Republic, aged 25–64 years, drawn from health insurance registries in 2013 and examined at St Anne&apos;s University Hospital in Brno, to study how biological, psychosocial, environmental, behavioural and economic factors relate to cardiovascular disease and its outcomes in a Central European urban population.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2160</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/KARDIOVIZE</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>KARDIOVIZE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Kardiovize</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Kardiovize Brno 2030 Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Kardiovize Brno 2030 study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Kardiovize Brno cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Kardiovize study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Kardiovize Brno 2030</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22011">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002616"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22011"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28812915+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Kardiovize Brno 2030 study was designed as a prospective cohort study to investigate the complex relationships of cardiovascular disease and outcomes with a range of biological, psychosocial, environmental, behavioral, and economic factors in an urban population of the Czech Republic.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002616"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Czech_Republic"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6073665/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this cross-sectional study, we used data from the Kardiovize Brno 2030 cohort which included a random sample of residents from the city of Brno, Czech Republic [17].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002616"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:30011827</owl:annotatedTarget>
        <dcterms:title>Association of Dietary Patterns with Metabolic Syndrome: Results from the Kardiovize Brno 2030 Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30011827</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6073665/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To explore the complex association of biological, environmental and behavioral risk factors with cardiovascular diseases (CVD), we recently designed the Kardiovize Brno 2030 study, which recruited a randomly-selected sample of residents in an urban population of Brno, Czech Republic [17].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002616"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of a random, sex- and age-stratified 1% sample of residents of Brno, Czech Republic, aged 25–64 years, drawn from health insurance registries in 2013 and examined at St Anne&apos;s University Hospital in Brno, to study how biological, psychosocial, environmental, behavioural and economic factors relate to cardiovascular disease and its outcomes in a Central European urban population.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28812915</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34631132</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002616"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2160</owl:annotatedTarget>
        <obo:IAO_0000116>participants enrolled at baseline (2013-2014)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:28812915</oboInOwl:hasDbXref>
        <rdfs:comment>Results The study enrolled 2160 participants (54.8% women), with a mean age of 47 ± 11.3 years.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002616"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>KARDIOVIZE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002617 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002617">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:42528938</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal birth cohort of the people born in England, Scotland and Wales in a single week of 1970, which began as the British Births Survey and has followed its members&apos; health, physical, educational and social development and economic circumstances through childhood and adult life; it is managed by the Centre for Longitudinal Studies at University College London and core funded by the Economic and Social Research Council.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17000</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/BCS%201970</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>1970 British birth cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BCS 1970</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BCS70</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>British Births Survey</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">1970 British Cohort Study</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://cls.ucl.ac.uk/cls-studies/1970-british-cohort-study/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002617"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244059/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The 1970 British Cohort Study (BCS70) is an ongoing, multidisciplinary, longitudinal study of a cohort of over 17 000 births in England, Scotland and Wales.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002617"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42528938</owl:annotatedTarget>
        <dcterms:title>The relationship between resistance exercise and cardiometabolic health: a cross-sectional analysis of the 1970 British cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42528938</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13415302/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This research was conducted using data from the 1970 British Cohort Study (BCS70).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002617"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal birth cohort of the people born in England, Scotland and Wales in a single week of 1970, which began as the British Births Survey and has followed its members&apos; health, physical, educational and social development and economic circumstances through childhood and adult life; it is managed by the Centre for Longitudinal Studies at University College London and core funded by the Economic and Social Research Council.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35849349</obo:IAO_0000119>
        <obo:IAO_0000119>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/BCS%201970</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002617"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17000</owl:annotatedTarget>
        <obo:IAO_0000116>births in a single week of 1970 (stated as over 17 000)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244059/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The 1970 British Cohort Study (BCS70) is an ongoing, multidisciplinary, longitudinal study of a cohort of over 17 000 births in England, Scotland and Wales.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002617"/>
