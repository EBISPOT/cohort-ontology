        <rdfs:comment>A statewide case-control study was conducted in New South Wales, Australia, with population-based sampling of cases (n = 704) and controls (n = 694).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002187"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
