        <oboInOwl:hasRelatedSynonym>Anonymous blood donor cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DKctrl</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Anonymous Blood Donor Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001461"/>
