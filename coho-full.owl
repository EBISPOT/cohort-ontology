        <oboInOwl:hasRelatedSynonym>CaePS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Caerphilly Prospective Heart Disease study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Caerphilly study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Caerphilly Prospective Study</rdfs:label>
    </owl:NamedIndividual>
