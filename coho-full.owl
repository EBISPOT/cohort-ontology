    <!-- http://www.ebi.ac.uk/coho/COHO_0000111 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000111">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000699"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000700"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>EGAS00001000910</obo:IAO_0000112>
        <obo:IAO_0000112>GCST001195</obo:IAO_0000112>
        <obo:IAO_0000115>A research programme comprising two cohorts, the Lothian Birth Cohorts of 1921 and 1936, whose members took an intelligence test at age 11 in the Scottish Mental Surveys of 1932 and 1947 and were recruited in older age, mostly in Edinburgh and the Lothians, for repeated study of cognitive ageing.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym LBC also denotes Liver Biopsy Cohort (COHO:0002007); this term is Lothian Birth Cohorts.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>LBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Lothian Birth Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Lothian Birth Cohorts</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000111"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000699"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6124629/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The original Lothian Birth Cohorts of 1921 (LBC1921) and 1936 (LBC1936) were designed as follow-up studies to the Scottish Mental Surveys of 1932 (SMS1932) and 1947 (SMS1947), respectively.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000111"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000700"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6124629/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The original Lothian Birth Cohorts of 1921 (LBC1921) and 1936 (LBC1936) were designed as follow-up studies to the Scottish Mental Surveys of 1932 (SMS1932) and 1947 (SMS1947), respectively.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000111"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6124629/</oboInOwl:hasDbXref>
        <rdfs:comment>participants of both Surveys, mostly living in Edinburgh and the surrounding area (the Lothians) in older age, were invited to participate</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000111"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS00001000910</owl:annotatedTarget>
        <dcterms:title>DNA methylation repeatability in the Lothian Birth Cohorts of 1921 and 1936.</dcterms:title>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001000910</oboInOwl:hasDbXref>
        <rdfs:comment>The Lothian Birth Cohort of 1921 and the Lothian Birth Cohort of 1936.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000111"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST001195</owl:annotatedTarget>
        <dcterms:title>Genome-wide association studies establish that human intelligence is highly heritable and polygenic.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21826061</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3182557/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We present here the results of a genome-wide association study (GWAS) which examines cognitive ability phenotype-genotype associations in the five cohorts which constitute the CAGES (Cognitive Ageing Genetics in England and Scotland) project: the Lothian Birth Cohorts of 1921 and 1936 (LBC1921, LBC1936), the Aberdeen Birth Cohort 1936 (ABC1936), and the Manchester and Newcastle Longitudinal Studies of Cognitive Aging (Supplementary Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000111"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A research programme comprising two cohorts, the Lothian Birth Cohorts of 1921 and 1936, whose members took an intelligence test at age 11 in the Scottish Mental Surveys of 1932 and 1947 and were recruited in older age, mostly in Edinburgh and the Lothians, for repeated study of cognitive ageing.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29546429</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000111"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LBC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


