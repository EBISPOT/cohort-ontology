    <!-- http://www.ebi.ac.uk/coho/COHO_0002112 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002112">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PGS001800</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:32649918</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal study of health and aging, established by the Veterans Administration in 1963, of healthy men aged 21 to 80 from the greater Boston area, United States, who were free of known chronic medical conditions at enrolment.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2280</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>VA Normative Aging Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Veterans Administration Normative Aging Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Normative Aging Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002112"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01314-0/MediaObjects/41588_2023_1314_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Normative Aging Study is a longitudinal study of healthy men established in 1963 aged 21 to 80 years from the greater Boston area, free of known chronic medical conditions.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002112"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS001800</owl:annotatedTarget>
        <dcterms:title>Chronic obstructive pulmonary disease and related phenotypes: polygenic risk scores in population-based and case-control cohorts.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32649918</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002112"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32649918</owl:annotatedTarget>
        <dcterms:title>Chronic obstructive pulmonary disease and related phenotypes: polygenic risk scores in population-based and case-control cohorts.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32649918</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7429152/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Case-control studies included COPDGene (non-Hispanic white and African American participants),23 ECLIPSE,24 NETT25 and Normative Aging Study (NAS),26 SPIROMICS,27, 28 and the Lung Health Study (LHS).29, 30 Population-based studies included MESA (African American, non-Hispanic white, Hispanic, and Chinese participants),31, 32 Cardiovascular Health Study (CHS; African American and European ancestry participants),33 the Rotterdam Study (all three cohorts),34 and a study by Kangwon University.35 For lung-function growth patterns, we did an analysis using individuals in the Childhood Asthma Management Program (CAMP).18 CAMP was a randomised placebo-controlled trial of anti-inflammatory</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002112"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal study of health and aging, established by the Veterans Administration in 1963, of healthy men aged 21 to 80 from the greater Boston area, United States, who were free of known chronic medical conditions at enrolment.</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01314-0/MediaObjects/41588_2023_1314_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Sonnet 5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002112"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2280</owl:annotatedTarget>
        <obo:IAO_0000116>male volunteers aged 21-80 from the greater Boston area enrolled in the closed cohort from 1963</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5010417/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the VA Normative Aging Study is a closed cohort of 2,280 male volunteers from the greater Boston area (Massachusetts), 21–80 years of age at study entry, who enrolled after an initial health screening determined that they were free of known chronic medical conditions.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002112"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


