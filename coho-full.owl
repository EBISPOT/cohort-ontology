    <!-- http://www.ebi.ac.uk/coho/COHO_0001876 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001876">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16664"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <obo:IAO_0000112>PMID:20847302</obo:IAO_0000112>
        <obo:IAO_0000115>A family cohort of white British nuclear and extended families from Oxford, United Kingdom, recruited from 1993 through a proband with essential hypertension in the upper 5% of the blood pressure distribution, with other family members collected regardless of their blood pressure, for quantitative genetic study of hypertension, left ventricular mass and other cardiovascular risk factors; families were recalled for further cardiovascular phenotyping, including electrocardiography, echocardiography and cardiac magnetic resonance imaging.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1425</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HTO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Oxford Family Blood Pressure cohort</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Oxford Family Blood Pressure Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16664">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005044"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001876"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16664"/>
        <obo:IAO_0000116>hypertension</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6753112/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Families were ascertained through a hypertensive proband (through a hospital hypertension service or via their family physicians) defined as daytime ambulatory blood pressure of &gt;140/90 mmHg before the age of 65 years, a level which corresponds to the upper 5% of the distribution in Caucasian populations.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001876"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0205-x/MediaObjects/41588_2018_205_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>This family study in which probands were ascertained based on blood pressure, and family members were collected regardless of case or control status. | U.K Oxford cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001876"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20847302</owl:annotatedTarget>
        <dcterms:title>Coronary artery disease-related genetic variant on chromosome 10q11 is associated with carotid intima-media thickness and atherosclerosis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20847302</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20847302+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We genotyped 3 population cohorts (Bruneck [age range, 45 to 94 years; 50.0% men; n=738], Health2000 [age range, 46 to 76 years; 55.4% men; n=1237], and essential hypertension in families collected in the region of Oxford [HTO] [age range, 19 to 88 years; 47.9% men; n=770]) for single-nucleotide polymorphism rs501120 at the 10q11.21 locus and conducted a meta-analysis in these cohorts to ascertain a relationship between the polymorphism and carotid IMT.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001876"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family cohort of white British nuclear and extended families from Oxford, United Kingdom, recruited from 1993 through a proband with essential hypertension in the upper 5% of the blood pressure distribution, with other family members collected regardless of their blood pressure, for quantitative genetic study of hypertension, left ventricular mass and other cardiovascular risk factors; families were recalled for further cardiovascular phenotyping, including electrocardiography, echocardiography and cardiac magnetic resonance imaging.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23372812</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30224653</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31537879</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001876"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1425</owl:annotatedTarget>
        <obo:IAO_0000116>members of 248 families recruited in Oxford, 1993-1997</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6753112/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Between 1993 and 1997, we recruited 248 families with 1425 members from Oxford for quantitative genetic study of hypertension and other cardiovascular risk factors3.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001876"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HTO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


