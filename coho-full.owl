    <!-- http://www.ebi.ac.uk/coho/COHO_0001265 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001265">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11440"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/India"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Asia"/>
        <obo:IAO_0000112>GCST90320240</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, pan-India, multicentre study of people with juvenile-, young- and early-onset Parkinson&apos;s disease (onset by about 50 years of age), started by the Parkinson Research Alliance of India, which over two years recruited patients under the care of movement disorder specialists at ten specialty movement disorder centres and neurology clinics across India, to study the clinical and genetic patterns of early-onset Parkinson&apos;s disease in India.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">674</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GOPI-YOPD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics Of Parkinson&apos;s in India - Young Onset Parkinson&apos;s Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of PAN-India Young Onset Parkinson Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PRAI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PRAI cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Parkinson&apos;s Research Alliance of India cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetics of Parkinson&apos;s in India – Young Onset Parkinson&apos;s Disease</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11440">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001265"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11440"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.medrxiv.org/content/medrxiv/early/2023/06/22/2023.06.18.23291407.full.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Specifically, we jointly profiled 674 PD subjects predominantly with earlier onset PD from the Parkinson’s Research Alliance of India (PRAI) cohort via genotype array and whole exome sequencing (WES)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001265"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/India"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38014556+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 674 PD subjects predominantly with age of onset (AoO) ≤50 years (encompassing juvenile, young, or early-onset PD) were recruited from 10 specialty movement disorder centers across India over a 2-year period</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001265"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90320240</owl:annotatedTarget>
        <dcterms:title>The Genetic Drivers of Juvenile, Young, and Early-Onset Parkinson&apos;s Disease in India.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38014556</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.medrxiv.org/content/medrxiv/early/2023/06/22/2023.06.18.23291407.full.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Specifically, we jointly profiled 674 PD subjects predominantly with earlier onset PD from the Parkinson’s Research Alliance of India (PRAI) cohort via genotype array and whole exome sequencing (WES)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001265"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, pan-India, multicentre study of people with juvenile-, young- and early-onset Parkinson&apos;s disease (onset by about 50 years of age), started by the Parkinson Research Alliance of India, which over two years recruited patients under the care of movement disorder specialists at ten specialty movement disorder centres and neurology clinics across India, to study the clinical and genetic patterns of early-onset Parkinson&apos;s disease in India.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33685545</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.mdsabstracts.org/abstract/genetics-of-parkinsons-in-india-young-onset-parkinsons-disease-gopi-yopd-genetics-of-juvenile-young-and-early-onset-parkinsons-disease/</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.medrxiv.org/content/medrxiv/early/2023/06/22/2023.06.18.23291407.full.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001265"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">674</owl:annotatedTarget>
        <obo:IAO_0000116>people with Parkinson&apos;s disease recruited over two years</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.medrxiv.org/content/medrxiv/early/2023/06/22/2023.06.18.23291407.full.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>674 subjects with PD were recruited through a network of 10 specialty movement disorder centers and/or neurology clinics located across India.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001265"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GOPI-YOPD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
