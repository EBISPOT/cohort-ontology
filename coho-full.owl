        <obo:IAO_0000112>GCST90002231</obo:IAO_0000112>
        <obo:IAO_0000115>A household-based cohort of individuals, households and communities in provinces across China, surveyed repeatedly since 1989 with all household members studied and in-depth community data collected, to understand how social and economic change in China affects nutrition and health outcomes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27447</coho:numberOfParticipants>
