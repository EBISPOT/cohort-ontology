    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001196 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001196">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
