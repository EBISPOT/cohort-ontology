        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000765"/>
        <obo:IAO_0000112>PMID:32499647</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing hospital-based cohort of patients undergoing coronary angiography or percutaneous coronary intervention for stable angina pectoris or prior myocardial infarction at National Taiwan University Hospital, enrolling patients both in the north of Taiwan, where the main hospital is, and at a branch of the hospital in south-central Taiwan, with electronic medical records, fasting blood samples taken before cardiac catheterisation and blood collected in the catheter laboratory for DNA. It is one of the seven Taiwan-based cohorts of the TAICHI consortium.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">383</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TCAGEN</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Taiwan Coronary Artery Disease GENetic study</rdfs:label>
    </owl:NamedIndividual>
