        <oboInOwl:hasRelatedSynonym>Juvenile Diabetes Research Foundation/Wellcome Trust Diabetes and Inflammation Laboratorys British case collection</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK GRID</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK Genetic Resource Investigating Diabetes</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
