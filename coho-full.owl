    <!-- http://www.ebi.ac.uk/coho/COHO_0002632 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002632">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22138"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Czech_Republic"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:39500766</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective birth cohort run by RECETOX at Masaryk University with University Hospital Brno, Czech Republic, which enrolled pregnant women from 2017 (after a 2015-2016 pilot) and follows them and their children from pregnancy through early childhood, collecting biological samples and questionnaires, to study exposome factors such as environment, lifestyle, nutrition, genetics and the gut microbiome behind chronic diseases and developmental disorders in children.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3200</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/CELSPAC-TNG</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>CELSPAC-TNG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CELSPAC: TNG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Central European Longitudinal Study of Parents and Children: The Next Generation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TNG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Next Generation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Central European Longitudinal Studies of Parents and Children: The Next Generation</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.celspac.cz/tng"/>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22138">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ExO_0000002"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002632"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22138"/>
        <obo:IAO_0000116>exposome factors (environment, lifestyle, nutrition) in pregnancy and early childhood</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/CELSPAC-TNG</oboInOwl:hasDbXref>
        <rdfs:comment>This prospective birth cohort is designed to follow up 7000 children from their prenatal period to adolescence with the aim of assessing EXPOSOME factors potentially affecting children health.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002632"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Czech_Republic"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11303690/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The mothers (age ≥18 years) were recruited in their 38th week of pregnancy at University Hospital Brno, Czech Republic, in 2015 and 2016.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002632"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39500766</owl:annotatedTarget>
        <dcterms:title>Fecal tryptophan metabolite profiling in newborns in relation to microbiota and antibiotic treatment.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39500766</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11538234/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Infants’ meconium and stool samples were collected between day 1 and day 4 from birth from 134 neonates (20 delivered via caesarean section and 114 delivered vaginally) at the University Hospital Brno within the CELSPAC: TNG cohort study (Central European Longitudinal Study of Parents and Children: The Next Generation).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002632"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective birth cohort run by RECETOX at Masaryk University with University Hospital Brno, Czech Republic, which enrolled pregnant women from 2017 (after a 2015-2016 pilot) and follows them and their children from pregnancy through early childhood, collecting biological samples and questionnaires, to study exposome factors such as environment, lifestyle, nutrition, genetics and the gut microbiome behind chronic diseases and developmental disorders in children.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:39107353</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.celspac.cz/tng</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002632"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3200</owl:annotatedTarget>
        <obo:IAO_0000116>mothers and children who joined 2017-2026 (more than; website, in Czech)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.celspac.cz/tng</oboInOwl:hasDbXref>
        <rdfs:comment>Celkem do ní vstoupilo více než 3 200 maminek a dětí.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002632"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CELSPAC-TNG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002632"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CELSPAC: TNG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002632"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>TNG</owl:annotatedTarget>
