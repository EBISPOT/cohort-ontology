        <obo:IAO_0000112>PMID:24562863</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of DNA samples from people of Mexican ancestry in Los Angeles, California, one of the seven population samples added in phase 3 of the International HapMap Project and used as a reference for human genetic variation.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">77</coho:numberOfParticipants>
