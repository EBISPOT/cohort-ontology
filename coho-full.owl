        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000463"/>
        <oboInOwl:hasDbXref>https://metadata.ega-archive.org/studies/EGAS00001000052</oboInOwl:hasDbXref>
        <rdfs:comment>Over the last two years pedigree histories have been compiled from the AMC-PAS cohort and so far ten families have been identified with evidence of autosomal inheritance of CVD without any known monogenic causes of CVD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000322"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS00001000052</owl:annotatedTarget>
        <dcterms:title>PAS Pedigrees: Identification of novel genetic variants contributing to cardiovascular disease in pedigrees with premature atherosclerosis.</dcterms:title>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000322"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of pedigrees with premature atherosclerosis from the Amsterdam Medical Center, exome sequenced to identify rare genetic variants contributing to cardiovascular disease.</owl:annotatedTarget>
        <obo:IAO_0000119>https://ega-archive.org/studies/EGAS00001000052</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    


