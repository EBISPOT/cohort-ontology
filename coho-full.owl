    <!-- http://www.ebi.ac.uk/coho/COHO_0001523 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001523">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13778"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000985"/>
        <obo:IAO_0000112>PMID:15539711</obo:IAO_0000112>
        <obo:IAO_0000115>A family study begun in 1994 at Brigham and Women&apos;s Hospital, Boston, to find genetic determinants of chronic obstructive pulmonary disease other than alpha-1 antitrypsin deficiency, which enrols extended pedigrees, mainly in New England, ascertained through probands with severe COPD (FEV1 at most 40% predicted) before age 53 and without severe alpha-1 antitrypsin deficiency, recruited from lung transplant and general pulmonary clinics, together with their first- and second-degree relatives aged 10 years or older.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">139</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>BECOPD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BEOCOPD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Boston Early-Onset COPD population</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Boston Early-Onset COPD study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Boston Early-Onset Chronic Obstructive Pulmonary Disease study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Boston Early-Onset COPD Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13778">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005002"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001523"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13778"/>
        <obo:IAO_0000116>chronic obstructive pulmonary disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000946.v1.p1</oboInOwl:hasDbXref>
        <rdfs:comment>This study has enrolled subjects with severe COPD (forced expiratory volume in one second (FEV1) &lt; 40% predicted) at an early age (&lt; 53 years) without alpha-1 antitrypsin deficiency (a known Mendelian risk factor for COPD).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001523"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:15539711</owl:annotatedTarget>
        <dcterms:title>Predictors of survival in severe, early onset COPD.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:15539711</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15539711+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The cohort of 139 probands in the Boston Early-Onset COPD Study was recruited from lung transplant and general pulmonary clinics between September 1994 and July 2002.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001523"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family study begun in 1994 at Brigham and Women&apos;s Hospital, Boston, to find genetic determinants of chronic obstructive pulmonary disease other than alpha-1 antitrypsin deficiency, which enrols extended pedigrees, mainly in New England, ascertained through probands with severe COPD (FEV1 at most 40% predicted) before age 53 and without severe alpha-1 antitrypsin deficiency, recruited from lung transplant and general pulmonary clinics, together with their first- and second-degree relatives aged 10 years or older.</owl:annotatedTarget>
