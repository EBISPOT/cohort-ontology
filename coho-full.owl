        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium of German cancer centres, coordinated by the German Cancer Research Center in Heidelberg, that runs joint translational research programmes such as the DKTK MASTER precision oncology cohort.</owl:annotatedTarget>
