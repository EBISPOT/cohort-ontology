        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000956"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5855</owl:annotatedTarget>
        <obo:IAO_0000116>postmenopausal Danish women enrolled at baseline (PERF I) 1999-2001</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10754934/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>PERF is comprised of 5855 post-menopausal Danish women, enrolled at baseline (PERF I) between 1999 and 2001.</rdfs:comment>
    </owl:Axiom>
