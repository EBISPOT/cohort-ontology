        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">429</owl:annotatedTarget>
        <obo:IAO_0000116>unrelated subjects recruited in 2003-2004 (patients with asthma and matched controls)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 429 unrelated subjects were recruited in this study, (215 patients with asthma and 214 controls).</rdfs:comment>
    </owl:Axiom>
