    <!-- http://www.ebi.ac.uk/coho/COHO_0002037 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002037">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid17784"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:30648747</obo:IAO_0000112>
        <obo:IAO_0000115>A study of postmenopausal women with resected early-stage oestrogen receptor-positive breast cancer, recruited at Mayo Clinic, MD Anderson Cancer Center and Memorial Sloan Kettering Cancer Center under the NIGMS-funded Pharmacogenomics Research Network, who were treated with adjuvant anastrozole 1 mg daily and had blood drawn before and during therapy for DNA and for plasma drug and hormone measurements, set up to study genetic variation in response to aromatase inhibitors.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">687</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>M3</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>M3 study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo Pharmacogenetics Research Network Aromatase Inhibitor AI Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo-MDA-MSK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo-MDA-MSK PGRN AI pharmacogenomic trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo_PGRN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PGRN Aromatase Inhibitor Pharmacogenomics Trial</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Mayo Clinic-MD Anderson-Memorial Sloan Kettering Pharmacogenomics Research Network Breast Cancer Aromatase Inhibitor Pharmacogenomics Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17784">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006512"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002037"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17784"/>
        <obo:IAO_0000116>ER+ breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6612579/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Postmenopausal patients with resected early stage ER+ breast cancer were recruited from the Mayo Clinic, MD Anderson Cancer Center, and Memorial Sloan Kettering Cancer Center as part of the National Institute of General Medical Sciences–funded PGRN Aromatase Inhibitor Pharmacogenomics Trial (Mayo‐MDA‐MSK).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002037"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6612579/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Postmenopausal patients with resected early stage ER+ breast cancer were recruited from the Mayo Clinic, MD Anderson Cancer Center, and Memorial Sloan Kettering Cancer Center as part of the National Institute of General Medical Sciences–funded PGRN Aromatase Inhibitor Pharmacogenomics Trial (Mayo‐MDA‐MSK).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002037"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:30648747</owl:annotatedTarget>
        <dcterms:title>Anastrozole Aromatase Inhibitor Plasma Drug Concentration Genome-Wide Association Study: Functional Epistatic Interaction Between SLC38A7 and ALPPL2.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30648747</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6612579/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To test that hypothesis, we performed a genome‐wide association study (GWAS) of plasma anastrozole concentrations in 687 postmenopausal patients with ER+ breast cancer enrolled in the Mayo Clinic‐MD Anderson‐Memorial Sloan Kettering (Mayo‐MDA‐MSK) Pharmacogenomics Research Network (PGRN) Breast Cancer Aromatase Inhibitor Pharmacogenomics study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002037"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study of postmenopausal women with resected early-stage oestrogen receptor-positive breast cancer, recruited at Mayo Clinic, MD Anderson Cancer Center and Memorial Sloan Kettering Cancer Center under the NIGMS-funded Pharmacogenomics Research Network, who were treated with adjuvant anastrozole 1 mg daily and had blood drawn before and during therapy for DNA and for plasma drug and hormone measurements, set up to study genetic variation in response to aromatase inhibitors.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20354183</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30648747</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002037"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">687</owl:annotatedTarget>
        <obo:IAO_0000116>women in the plasma anastrozole GWAS (analysed subset of those enrolled), 2019</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6612579/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To test that hypothesis, we performed a genome‐wide association study (GWAS) of plasma anastrozole concentrations in 687 postmenopausal patients with ER+ breast cancer enrolled in the Mayo Clinic‐MD Anderson‐Memorial Sloan Kettering (Mayo‐MDA‐MSK) Pharmacogenomics Research Network (PGRN) Breast Cancer Aromatase Inhibitor Pharmacogenomics study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
