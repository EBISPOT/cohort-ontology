        <obo:IAO_0000116>SARS-CoV-2 RT-PCR positive (cases) and negative (controls) individuals sampled at the Valladolid (March-April 2020) and Málaga (August-October 2020) hospitals</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9357033/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Whole blood samples from SARS-CoV-2 RT-PCR negative (101) and positive lab tested individuals (473) were obtained from two clinical centers (Hospital Clínico Universitario de Valladolid, discovery cohort and Hospital Regional Universitario de Málaga, replication cohort).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002404"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">101</owl:annotatedTarget>
        <obo:IAO_0000116>SARS-CoV-2 RT-PCR positive (cases) and negative (controls) individuals sampled at the Valladolid (March-April 2020) and Málaga (August-October 2020) hospitals</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9357033/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Whole blood samples from SARS-CoV-2 RT-PCR negative (101) and positive lab tested individuals (473) were obtained from two clinical centers (Hospital Clínico Universitario de Valladolid, discovery cohort and Hospital Regional Universitario de Málaga, replication cohort).</rdfs:comment>
