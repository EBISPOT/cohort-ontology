    <!-- http://www.ebi.ac.uk/coho/COHO_0002410 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002410">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20441"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000238"/>
        <obo:IAO_0000112>PMID:34237774</obo:IAO_0000112>
        <obo:IAO_0000115>A COVID-19 pandemic-tracking study at Stanford Health Care in northern California that, from March to July 2020, collected the residual nasopharyngeal swab media of clinical SARS-CoV-2 tests from approximately consecutive SARS-CoV-2-positive and -negative patients, linked them to electronic health record data, and sequenced the patients&apos; genomes at low coverage together with viral genomes and transcriptomes, to study host genetic, viral and clinical correlates of COVID-19 severity; it contributed its host genetic data to the COVID-19 Host Genetics Initiative.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">736</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">313</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1049</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Stanford</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Genomic epidemiology of SARS-Cov-2 and host genetics in Coronavirus Disease 2019 (COVID-19)</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20441">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0100096"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002410"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20441"/>
        <obo:IAO_0000116>COVID-19</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9426371/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We leverage a pandemic tracking strategy in which we sequence viral and host genomes and transcriptomes from nasopharyngeal swabs of 1049 individuals (736 SARS-CoV-2 positive and 313 SARS-CoV-2 negative) and integrate them with digital phenotypes from electronic health records from a diverse catchment area in Northern California.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002410"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9426371/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Residual viral transport media (VTM) from SARS-CoV-2 clinical diagnostic tests were prospectively collected from March 2020 to July 2020 from Stanford Health Care in northern California, USA.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002410"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34237774</owl:annotatedTarget>
        <dcterms:title>Mapping the human genetic architecture of COVID-19.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34237774</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-021-03767-x/MediaObjects/41586_2021_3767_MOESM7_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Genomic epidemiology of SARS-Cov-2 and host genetics in Coronavirus Disease 2019 (COVID-19) Data Collection Lead</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002410"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A COVID-19 pandemic-tracking study at Stanford Health Care in northern California that, from March to July 2020, collected the residual nasopharyngeal swab media of clinical SARS-CoV-2 tests from approximately consecutive SARS-CoV-2-positive and -negative patients, linked them to electronic health record data, and sequenced the patients&apos; genomes at low coverage together with viral genomes and transcriptomes, to study host genetic, viral and clinical correlates of COVID-19 severity; it contributed its host genetic data to the COVID-19 Host Genetics Initiative.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34237774</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36042219</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002410"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">736</owl:annotatedTarget>
        <obo:IAO_0000116>patients tested for SARS-CoV-2 at Stanford Health Care whose residual nasopharyngeal swabs were collected, March-July 2020 (positive and negative)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9426371/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In total, 1327 NP swab residuals were collected from 1049 individuals (736 positive and 313 negative, Fig. 1A and S2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002410"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
