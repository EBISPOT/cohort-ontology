    <!-- http://www.ebi.ac.uk/coho/COHO_0002714 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002714">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23002"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001802"/>
        <obo:IAO_0000112>PMID:23321510</obo:IAO_0000112>
        <obo:IAO_0000115>A randomized multicentre trial cohort of patients aged 16–75 years with newly diagnosed, biopsy-proven, early-stage Hodgkin lymphoma without adverse risk factors, assembled by the German Hodgkin Study Group to compare two or four cycles of ABVD chemotherapy followed by involved-field radiotherapy at 20 or 30 Gy.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1370</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HD10</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HD10 study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">HD10 trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23002">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004952"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002714"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23002"/>
        <obo:IAO_0000116>Hodgkin&apos;s lymphoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20818855+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We randomly assigned 1370 patients with newly diagnosed early-stage Hodgkin&apos;s lymphoma with a favorable prognosis to one of four treatment groups</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002714"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23321510</owl:annotatedTarget>
        <dcterms:title>Sexual quality of life in Hodgkin Lymphoma: a longitudinal analysis by the German Hodgkin Study Group.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23321510</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3553532/</oboInOwl:hasDbXref>
        <rdfs:comment>In the HD10 study for early stages (CS I, II without risk factors) patients were randomized to receive 2 or 4 cycles of doxorubicin, bleomycin, vinblastine, and dacarbazine (ABVD) followed by either 30 Gy or 20 Gy involved-field (IF) radiotherapy</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002714"/>
