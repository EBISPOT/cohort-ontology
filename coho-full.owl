        <owl:annotatedTarget>GCST90292521</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analyses of ovarian cancer patients undergoing primary debulking surgery identify candidate genes for residual disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38443389</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10915171/fullTextXML</oboInOwl:hasDbXref>
