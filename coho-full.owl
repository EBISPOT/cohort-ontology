        <obo:IAO_0000112>PMID:25105248</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based case-control study of colorectal cancer among residents of Fukuoka City and three adjacent areas of Japan, comparing patients having surgery for a first diagnosis of colorectal cancer at eight hospitals, interviewed from 2000 to 2003, with community controls randomly selected and frequency-matched on sex, age and residence, surveyed in 2001 and 2002; diet and lifestyle were assessed by in-person interview and blood was taken for genotyping, to study dietary, behavioural and genetic factors in colorectal carcinogenesis.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CAGE-Fukuoka also denotes Kyushu University Fukuoka Cohort Study (COHO:0001557); this term is Fukuoka Colorectal Cancer Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">840</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">833</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>CAGE-Fukuoka</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FCCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fukuoka colorectal cancer study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Fukuoka Colorectal Cancer Study</rdfs:label>
    </owl:NamedIndividual>
