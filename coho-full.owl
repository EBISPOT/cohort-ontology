    <!-- http://www.ebi.ac.uk/coho/COHO_0000917 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000917">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid8384"/>
        <obo:IAO_0000112>GCST90854196</obo:IAO_0000112>
        <obo:IAO_0000115>A multinational study that recruited HIV-1 controllers, people with HIV whose plasma viral load stays below 2000 RNA copies/ml (at least three measurements over at least 12 months) without antiretroviral therapy, for genome-wide association analysis of host genetic effects on the control of HIV infection.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym IHCS also denotes Intermountain Heart Collaborative Study (COHO:0000565); this term is International HIV Controllers Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">974</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2648</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>ICSC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IHCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IHIVCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International HIV controllers Study Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">International HIV Controllers Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid8384">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005109"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000917"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8384"/>
        <obo:IAO_0000116>HIV infection</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3235490/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>To determine the genetic basis for this rare phenomenon, we established a multinational consortium (www.hivcontrollers.org) to recruit HIV-1 controllers, who are defined by at least three measurements of plasma virus load (VL) &lt; 2000 RNA copies/ml over at least a 12-month period in the absence of antiviral therapy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000917"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90854196</owl:annotatedTarget>
        <dcterms:title>Multiancestry sex-stratified genomic associations with HIV viral load and controller status from the ICGH.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37097752</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10393222/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We additionally used a binary definition of HIV spontaneous control in the subset of samples obtained from the International HIV Controllers Study and the AIDS Clinical Trials Group (Supplemental Table 1) (17).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000917"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multinational study that recruited HIV-1 controllers, people with HIV whose plasma viral load stays below 2000 RNA copies/ml (at least three measurements over at least 12 months) without antiretroviral therapy, for genome-wide association analysis of host genetic effects on the control of HIV infection.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21051598</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000917"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">974</owl:annotatedTarget>
        <obo:IAO_0000116>HIV controllers (cases) and progressors (controls) after QC in the 2010 GWAS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3235490/</oboInOwl:hasDbXref>
        <rdfs:comment>After quality control and imputation on the basis of HapMap Phase 3 (3), we obtained data on 1,384,048 single-nucleotide polymorphisms (SNPs) in 974 controllers (cases) and 2648 progressors (controls) from multiple populations (table S1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000917"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2648</owl:annotatedTarget>
        <obo:IAO_0000116>HIV controllers (cases) and progressors (controls) after QC in the 2010 GWAS</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3235490/</oboInOwl:hasDbXref>
        <rdfs:comment>After quality control and imputation on the basis of HapMap Phase 3 (3), we obtained data on 1,384,048 single-nucleotide polymorphisms (SNPs) in 974 controllers (cases) and 2648 progressors (controls) from multiple populations (table S1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000917"/>
