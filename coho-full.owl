        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001640 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001640">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14779"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:34039022</obo:IAO_0000112>
        <obo:IAO_0000115>An autopsy registry of people who died suddenly and unexpectedly, whose hearts have been referred since the mid-1990s to CVPath Institute in Gaithersburg, Maryland, by the Office of the Chief Medical Examiner of the State of Maryland through an ongoing cardiovascular pathology consultation service. The cause of death is determined by detailed histopathological examination of the heart and coronary arteries, and DNA extracted from the archived tissue is used to study the genetics of sudden cardiac death and of coronary plaque.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5262</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CVPI-SCDr</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CVPath Sudden Death Autopsy Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CVPath Sudden Death Registry</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">CVPath Institute Sudden Cardiac Death registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14779">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0001645"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001640"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14779"/>
        <obo:IAO_0000116>sudden cardiac death</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8173469/</oboInOwl:hasDbXref>
        <rdfs:comment>In our autopsy registry of more than 5000 cases of suspected SCD referred from OCME-MD, we identified 683 hearts from White and African American decedents with unexplained SCD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001640"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8173469/</oboInOwl:hasDbXref>
        <rdfs:comment>Between January 1995 and December 2015, CVPath Institute was referred 5262 hearts from cases of unexpected sudden death from the Office of the Chief Medical Examiner of the State of Maryland (OCME-MD).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001640"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34039022</owl:annotatedTarget>
        <dcterms:title>&lt;i&gt;APOL1&lt;/i&gt; Genetic Variants Are Associated With Increased Risk of Coronary Atherosclerotic Plaque Rupture in the Black Population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34039022</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8651054/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The CVPath Institute Sudden Cardiac Death registry heart samples are received through an ongoing joint consultation service provided to the Maryland Office of the Chief Medical Examiner.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001640"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An autopsy registry of people who died suddenly and unexpectedly, whose hearts have been referred since the mid-1990s to CVPath Institute in Gaithersburg, Maryland, by the Office of the Chief Medical Examiner of the State of Maryland through an ongoing cardiovascular pathology consultation service. The cause of death is determined by detailed histopathological examination of the heart and coronary arteries, and DNA extracted from the archived tissue is used to study the genetics of sudden cardiac death and of coronary plaque.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34039022</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34076677</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37916415</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001640"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5262</owl:annotatedTarget>
        <obo:IAO_0000116>hearts of sudden-death cases referred January 1995 to December 2015</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8173469/</oboInOwl:hasDbXref>
        <rdfs:comment>Between January 1995 and December 2015, CVPath Institute was referred 5262 hearts from cases of unexpected sudden death from the Office of the Chief Medical Examiner of the State of Maryland (OCME-MD).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001640"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CVPI-SCDr</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


