        <obo:IAO_0000112>GCST90454200</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of 3D facial images, self-reported age, height, weight and ancestry, and DNA from volunteers recruited without restriction on ancestry (minors with a parent&apos;s or guardian&apos;s consent) in Indianapolis, Indiana and in Twinsburg, Ohio under one Indiana University-Purdue University Indianapolis ethics protocol, with support from the US National Institute of Justice, and genotyped to study the genetics of facial shape and of other visible traits such as head hair shape.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">743</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>IUPUI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IUPUI cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IUPUI dataset</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IUPUI sample</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Indiana University-Purdue University Indianapolis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>US Indiana Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Indiana University-Purdue University Indianapolis cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001360"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
