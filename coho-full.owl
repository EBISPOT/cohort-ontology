        <obo:IAO_0000112>GCST90104583</obo:IAO_0000112>
        <obo:IAO_0000115>A single-health-system biobank of more than 91,000 adult patients recruited mainly during surgical encounters at Michigan Medicine, the University of Michigan health system, linking genotypes to electronic health records for disease genetics research.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">91695</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MGI</oboInOwl:hasRelatedSynonym>
