        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001244"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of current and former radiologic technologists in the United States, women and men certified by the American Registry of Radiologic Technologists for at least two years between 1926 and 1982, assembled in 1982 by the US National Cancer Institute with the University of Minnesota and the Registry and followed through four mailed questionnaires (1983–1989, 1994–1998, 2003–2005 and 2012–2014), to assess risks of cancer and other diseases from protracted low-dose occupational and personal medical ionising radiation and other exposures.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29992993</obo:IAO_0000119>
        <obo:IAO_0000119>https://dceg.cancer.gov/research/who-we-study/cohorts/us-radiologic-technologists</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001244"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">110373</owl:annotatedTarget>
        <obo:IAO_0000116>technologists who completed at least one of the first two questionnaires (study participants), 1998</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6041262/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 110,373 radiological technologists completed at least one of the first two questionnaires and are considered study participants.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001244"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>USRT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001245 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001245">
