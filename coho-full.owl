        <oboInOwl:hasRelatedSynonym>MER</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Molecular Epidemiology Resource</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of Iowa-Mayo Clinic Lymphoma Specialized Program of Research Excellence</oboInOwl:hasRelatedSynonym>
