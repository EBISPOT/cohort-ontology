        <owl:annotatedTarget>GCST90797639</owl:annotatedTarget>
        <dcterms:title>Genetic determinants of childhood blood pressure and heart rate in relation to adult health outcomes: the consortium of childhood blood pressure.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42036355</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13533560/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>GINIplus&amp;LISA German Infant Study on the influence of Nutrition Intervention and Influence of Life-style related factors on the development of the Immune System and Allergies in East and West Germany - plus the influence of traffic emissions and genetics Prospective population-based birth cohort Munich, Germany PMID: 20082618 (GINIplus)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000708"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based German birth cohort of 5,991 healthy term newborns recruited in obstetric hospitals in Munich and Wesel in 1995–1998, comprising a double-blind randomised trial of hydrolysed infant formula in children with a family history of allergy (the German Infant Nutritional Intervention study, GINI) and a non-interventional arm, about 55% of whom were followed for the first 10 years to study the natural course of atopic diseases and their determinants.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30402607</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000708"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5991</owl:annotatedTarget>
        <obo:IAO_0000116>healthy term newborns recruited (interventional and non-interventional arms), 1998</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6040001/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 5,991 newborns recruited, 3,317 (55.4%) could be followed until the age of 10 years.</rdfs:comment>
    </owl:Axiom>
