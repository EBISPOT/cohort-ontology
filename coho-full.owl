    <!-- http://www.ebi.ac.uk/coho/COHO_0001343 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001343">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid12143"/>
        <obo:IAO_0000112>GCST90320242</obo:IAO_0000112>
        <obo:IAO_0000115>A worldwide programme, the first resource project of the Aligning Science Across Parkinson&apos;s initiative, that genotypes and sequences people with Parkinson&apos;s disease, and some controls, from existing and newly collected patient and cohort collections, working with established Parkinson&apos;s disease consortia and focusing on populations under-represented in genetic research, and shares the harmonised data to find genetic causes of and risk factors for typical and monogenic Parkinson&apos;s disease.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36127</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19475</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>GP2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Global Parkinson&apos;s Disease Genetics Program</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Global Parkinson&apos;s Genetics Program</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12143">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001343"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12143"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9290711/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For the most part, GP2 will use existing or ongoing patient and cohort collections and will work with established PD consortia; however, in some instances GP2 will support the collection of additional patients, particularly from underserved communities.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001343"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90320242</owl:annotatedTarget>
        <dcterms:title>Identification of genetic risk loci and causal insights associated with Parkinson&apos;s disease in African and African admixed populations: a genome-wide association study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37633302</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37633302+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Individuals were included from several cohorts that were available as a part of the Global Parkinson&apos;s Genetics Program, the International Parkinson&apos;s Disease Genomics Consortium Africa, and 23andMe.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001343"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A worldwide programme, the first resource project of the Aligning Science Across Parkinson&apos;s initiative, that genotypes and sequences people with Parkinson&apos;s disease, and some controls, from existing and newly collected patient and cohort collections, working with established Parkinson&apos;s disease consortia and focusing on populations under-represented in genetic research, and shares the harmonised data to find genetic causes of and risk factors for typical and monogenic Parkinson&apos;s disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33513272</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37633302</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001343"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">36127</owl:annotatedTarget>
        <obo:IAO_0000116>PD cases and controls across nine ancestries in a 2026 GP2 analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:41808632</oboInOwl:hasDbXref>
        <rdfs:comment>Using genotyping, imputed, and whole-genome sequencing data from 36,127 PD cases and 19,475 controls across nine ancestral populations from the Global Parkinson&apos;s Genetics Program, we aimed to identify novel regions of homozygosity contributing to PD heritability.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001343"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19475</owl:annotatedTarget>
        <obo:IAO_0000116>PD cases and controls across nine ancestries in a 2026 GP2 analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:41808632</oboInOwl:hasDbXref>
        <rdfs:comment>Using genotyping, imputed, and whole-genome sequencing data from 36,127 PD cases and 19,475 controls across nine ancestral populations from the Global Parkinson&apos;s Genetics Program, we aimed to identify novel regions of homozygosity contributing to PD heritability.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001343"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GP2</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


