        <oboInOwl:hasRelatedSynonym>Transdisciplinary Tobacco Use Research Centers Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UW-TTURC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UW-TTURC trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of Wisconsin Transdisciplinary Tobacco Use Research Center</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of Wisconsin-Transdisciplinary Tobacco Use Research Cente</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of Wisconsin-Transdisciplinary Tobacco Use Research Center</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Wisconsin TTURC Cessation Trial</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">University of Wisconsin Transdisciplinary Tobacco Use Research Center Trial</rdfs:label>
    </owl:NamedIndividual>
