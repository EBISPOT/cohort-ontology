    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000449"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90094988</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of problematic opioid prescription use in 132,113 23andMe research participants of European ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34728798</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562028/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To test this hypothesis, we performed a genome-wide association study (GWAS) of problematic opioid use (POU) in 23andMe research participants of European ancestry (N = 132,113; 21% cases).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000449"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of customers of 23andMe, Inc., a direct-to-consumer genetics company, who have been genotyped and have consented to take part in online research, answering web-based questionnaires under an IRB-approved protocol, whose genotype and self-reported data are used for genome-wide association studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34728798</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000449"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">7194265</owl:annotatedTarget>
        <obo:IAO_0000116>research-consented genotyped 23andMe participants screened in a 2024 carrier study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:39669632</oboInOwl:hasDbXref>
        <rdfs:comment>Results Demographics Out of 7,194,265 consented participants, 116,517 (1.6%) were heterozygous for pathogenic variants in genes associated with ACOG-AJ conditions (commonly referred to as “carriers” in the context of reproductive risk) ( Table 1 ).</rdfs:comment>
    </owl:Axiom>
