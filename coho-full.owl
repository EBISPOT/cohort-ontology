        <oboInOwl:hasRelatedSynonym>Genetics UndeRlying Diabetes In hispANics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics Underlying Diabetes in Hispanics</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Genetics UndeRlying DIAbetes in HispaNics</rdfs:label>
