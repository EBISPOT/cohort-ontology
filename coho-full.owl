        <obo:IAO_0000112>MTBLS7290</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised crossover pilot trial in which healthy adults ate two-week diets high or low in plant bioactives, with matched total fibre and separated by a four-week washout, to assess changes in the gut microbiome and in urinary and faecal metabolites.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">27</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>DIME</oboInOwl:hasRelatedSynonym>
