        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>GCST001266</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, population-based case-control-family study in Australia, recruiting people with early-onset first-primary cutaneous melanoma, population-based and spouse or friend controls, and their relatives, between 2001 and 2005, to investigate genetic and environmental influences on melanoma risk.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">629</coho:numberOfCases>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1164</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>AMFS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Australian Melanoma Family Study</rdfs:label>
    </owl:NamedIndividual>
