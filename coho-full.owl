        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000720"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005391</owl:annotatedTarget>
        <dcterms:title>Consensus meta-analysis of genome-wide association studies for Alzheimer&apos;s disease and related dementias.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42237039</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000720"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sample collected at the University of Munich, Germany, of about 3,000 healthy volunteers of German descent from the Munich area, assessed with structured psychiatric interviews covering themselves and their first-degree relatives, together with about 1,000 patients with schizophrenia and about 300 people with other diagnoses, including Alzheimer&apos;s disease patients from the psychiatric memory clinic, used as a case and control resource in genetic studies of psychiatric, neurological and neurodegenerative disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32157568</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33133009</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35379992</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000720"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3000</owl:annotatedTarget>
        <obo:IAO_0000116>approximate components only: healthy controls, schizophrenia patients, other diagnoses</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7579408/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>DNA samples from 1,775 unrelated healthy subjects of European ancestry were taken from the Phenomics and Genomics Sample (PAGES), which is comprised of ~3,000 controls, 1,000 schizophrenia patients and 300 individuals with other diagnoses.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000720"/>
