    <!-- http://www.ebi.ac.uk/coho/COHO_0001807 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001807">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16121"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001089"/>
        <obo:IAO_0000112>PMID:23935489</obo:IAO_0000112>
        <obo:IAO_0000115>A European-African consortium project of the European Commission&apos;s Sixth Framework Programme on the genetics and immunology of HIV-1 long-term non-progression, and its French-Italian cohort of untreated, HIV-1-infected Caucasian long-term non-progressors (CD4+ T-cell counts above 500/μL for more than seven years after infection without antiretroviral therapy) drawn from the French asymptomatic long-term cohort, the Italian ELVIS study and the Chelsea and Westminster cohort. The cohort was genotyped genome-wide and compared with seroconverters of the French PRIMO cohort to find host genetic factors of long-term non-progression, and it contributed to the International Collaboration for the Genomics of HIV.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">144</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GISHEAL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic and Immunological Studies of European and African HIV-1 Long Term Non-Progressors</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic and Immunological Studies of European and African HIV-1+ Long Term Non Progressors</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic and Immunological Studies on HIV+ European and African LTNP</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Genetic and Immunological Studies of European and African HIV-1+ Long Term Non-Progressors</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16121">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005109"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001807"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16121"/>
        <obo:IAO_0000116>HIV-1 infection</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2766982/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Here we performed a GWAS on a cohort of 160 HIV-1 infected Caucasian Long Term Non Progressors (LTNP) from the EC-funded European-African &apos;&apos;GISHEAL&apos;&apos; Consortium in order to explore whether novel genetic factors could account for the LTNP phenotype (i.e. maintenance of CD4 T cell counts &gt;500 cells/μl and good health conditions without therapy).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001807"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3723635/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Genetic and Immunological Studies of European and African HIV-1+ Long Term Non-Progressors (GISHEAL) Study, in France and Italy</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001807"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23935489</owl:annotatedTarget>
        <dcterms:title>Association study of common genetic variants and HIV-1 acquisition in 6,300 infected cases and 7,200 controls.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23935489</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3723635/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Genetic and Immunological Studies of European and African HIV-1+ Long Term Non-Progressors (GISHEAL) Study, in France and Italy</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001807"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A European-African consortium project of the European Commission&apos;s Sixth Framework Programme on the genetics and immunology of HIV-1 long-term non-progression, and its French-Italian cohort of untreated, HIV-1-infected Caucasian long-term non-progressors (CD4+ T-cell counts above 500/μL for more than seven years after infection without antiretroviral therapy) drawn from the French asymptomatic long-term cohort, the Italian ELVIS study and the Chelsea and Westminster cohort. The cohort was genotyped genome-wide and compared with seroconverters of the French PRIMO cohort to find host genetic factors of long-term non-progression, and it contributed to the International Collaboration for the Genomics of HIV.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23459797</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23750159</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23935489</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28702030</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2766982/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001807"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">144</owl:annotatedTarget>
        <obo:IAO_0000116>HIV-1-infected long-term non-progressors recruited (the genotyped GISHEAL cohort), 2012 report</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3664380/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Finally, the French-Italian GISHEAL cohort recruited 144 LTNP defined by a CD4+ T-cell count above 500/μL for more than 7 years after HIV infection in the absence of antiretroviral therapy (Figure 3) (Guergnon et al., 2012).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001807"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GISHEAL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001808 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001808">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16128"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <obo:IAO_0000112>PMID:20403154</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre Italian randomized trial of the Gruppo Italiano per lo Studio della Sopravvivenza nell&apos;Infarto miocardico (GISSI) in which patients surviving a recent (3 months or less) myocardial infarction, with no limits of age and sex, were randomly assigned from October 1993 to September 1995 in a factorial design to supplements of n-3 polyunsaturated fatty acids, vitamin E, both, or none for 3.5 years, with death, non-fatal myocardial infarction and stroke as the combined primary endpoint.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11324</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GISSI Prevenzione</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GISSI-P</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GISSI-Prevenzione</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GISSI-Prevenzione study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gruppo Italiano per lo Studio della Sopravvivenza nell&apos;Infarto miocardico (GISSI) -Prevenzione trial</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">GISSI-Prevenzione trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16128">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005068"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001808"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16128"/>
        <obo:IAO_0000116>myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10465168+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We investigated the effects of these substances as supplements in patients who had myocardial infarction.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001808"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2871267/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>GISSI-P and IGLOO are both multicentre Italian studies approved by the local ethics committees of the participating hospitals (see references 16,17 for the complete list).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001808"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20403154</owl:annotatedTarget>
        <dcterms:title>Common genetic variants on chromosome 9p21 are associated with myocardial infarction and type 2 diabetes in an Italian population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20403154</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2871267/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The other case groups of 600 MI only and 600 MI&amp;T2D were selected at random from the GISSI-Prevenzione study (GISSI-P)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001808"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre Italian randomized trial of the Gruppo Italiano per lo Studio della Sopravvivenza nell&apos;Infarto miocardico (GISSI) in which patients surviving a recent (3 months or less) myocardial infarction, with no limits of age and sex, were randomly assigned from October 1993 to September 1995 in a factorial design to supplements of n-3 polyunsaturated fatty acids, vitamin E, both, or none for 3.5 years, with death, non-fatal myocardial infarction and stroke as the combined primary endpoint.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10465168</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20403154</obo:IAO_0000119>
