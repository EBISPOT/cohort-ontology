    <!-- http://www.ebi.ac.uk/coho/COHO_0002317 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002317">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19793"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <obo:IAO_0000112>PMID:32406072</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based prospective cohort in Taiwan made up of the participants of the REVEAL study who were seropositive for hepatitis B surface antigen: the REVEAL study enrolled residents aged 30 to 65 years from seven townships in Taiwan in 1991–1992, who gave blood samples, completed questionnaires and had health examinations at enrolment, and its HBsAg-seropositive participants were followed with blood collection and abdominal ultrasonography every 6–12 months and by linkage to the Taiwan National Cancer Registry and death certification, to study the risk factors for hepatocellular carcinoma in chronic hepatitis B virus carriers. Its sister cohort, REVEAL-HCV, followed the participants seropositive for antibodies to hepatitis C virus.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4155</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>REVEAL-HBV</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Risk Evaluation of Viral Load Elevation and Associated Liver Disease/Cancer-Hepatitis B Virus study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Risk Evaluation of Viral Load Elevation and Associated Liver Disease/Cancer-Hepatitis B Virus</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19793">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007256"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002317"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19793"/>
        <obo:IAO_0000116>hepatocellular carcinoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10548479/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>To examine whether biomarkers of gut barrier dysfunction (i.e., anti-LPS, anti-flagellin, soluble CD14, and LPS-binding protein) are related to risk of HCC in chronic HBV and HCV carriers in an Asian population, we analyzed samples from the Risk Evaluation of Viral Load Elevation and Associated Liver Disease/Cancer (REVEAL)-HBV and -HCV cohorts of Taiwan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002317"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7529994/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Between 1991–1992, 23,820 participants aged 30 to 65 years old from seven townships in Taiwan enrolled in the study, completed questionnaires, and underwent health examinations.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002317"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32406072</owl:annotatedTarget>
        <dcterms:title>Prediagnostic concentrations of circulating bile acids and hepatocellular carcinoma risk: REVEAL-HBV and HCV studies.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32406072</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7529994/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Thus, to examine circulating bile acids in relationship to risk of liver cancer, we leveraged the Risk Evaluation of Viral Load Elevation and Associated Liver Disease/Cancer (REVEAL)-HBV and -HCV cohorts from Taiwan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002317"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based prospective cohort in Taiwan made up of the participants of the REVEAL study who were seropositive for hepatitis B surface antigen: the REVEAL study enrolled residents aged 30 to 65 years from seven townships in Taiwan in 1991–1992, who gave blood samples, completed questionnaires and had health examinations at enrolment, and its HBsAg-seropositive participants were followed with blood collection and abdominal ultrasonography every 6–12 months and by linkage to the Taiwan National Cancer Registry and death certification, to study the risk factors for hepatocellular carcinoma in chronic hepatitis B virus carriers. Its sister cohort, REVEAL-HCV, followed the participants seropositive for antibodies to hepatitis C virus.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29600553</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32406072</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36878686</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002317"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4155</owl:annotatedTarget>
        <obo:IAO_0000116>HBsAg-seropositive participants of the REVEAL community cohort enrolled 1991-1992 and followed as REVEAL-HBV</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10548479/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Of the study enrollees, 4,155 (17.4%) were hepatitis B virus surface antigen (HBsAg) seropositive and were followed as part of the REVEAL-HBV study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002317"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>REVEAL-HBV</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002318 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002318">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19800"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PGS000351</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:20403914</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of prostate cancer run by the Cancer Council Victoria, which in 1994-1997 recruited men resident in Melbourne and Perth, Australia, who were diagnosed with prostate cancer before age 70, through the state cancer registries, together with controls identified from government electoral rolls and frequency-matched to the cases by age.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">798</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">527</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>RFPCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Risk Factors for Prostate Cancer Study of the Victoria Cancer Council</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Risk Factors for Prostate Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19800">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002318"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19800"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3877662/</oboInOwl:hasDbXref>
        <rdfs:comment>The Risk Factors for Prostate Cancer Study (RFPCS) is a population-based case-control study of prostate cancer in Australia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002318"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.450/MediaObjects/41588_2009_BFng450_MOESM22_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>MCCS/RFPCS/EOPCFS: Cancer Council Victoria, Melbourne, Australia</rdfs:comment>
    </owl:Axiom>
