        <rdfs:comment>from the ProtecT population-based study [15, 28], one of the PRACTICAL studies with the relevant phenotypic data in a well-defined control group.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
