    <!-- http://www.ebi.ac.uk/coho/COHO_0001488 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001488">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13450"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/New_Zealand"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:22190364</obo:IAO_0000112>
        <obo:IAO_0000115>A multiple sclerosis case-control collection assembled for genome-wide association studies by the Australia and New Zealand Multiple Sclerosis Genetics Consortium (ANZgene), a collaboration of multiple sclerosis research groups in Australia and New Zealand, whose cases are people with multiple sclerosis of European ancestry from Australia and New Zealand; its genome-wide scan compared them with shared genotype data from controls of European ancestry from Australia, the United Kingdom and the United States, and further ANZgene cases and controls were collected for replication and fine-mapping, to identify genetic variants that influence susceptibility to multiple sclerosis.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3268</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3579</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>ANZGene</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ANZgene</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ANZgene Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ANZgene Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Australian and New Zealand Multiple Sclerosis Genetics Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Australia and New Zealand Multiple Sclerosis Genetics Conortium</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Australia and New Zealand Multiple Sclerosis Genetics Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13450">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005301"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001488"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13450"/>
        <obo:IAO_0000116>multiple sclerosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3035668/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Following quality control as outlined in the ANZgene GWAS [28], this dataset consisted of 1618 MS cases of European ancestry from Australia and New Zealand, and 3413 healthy controls of European ancestry from Australia, the UK and the US.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001488"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
