        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14696"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4053164/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The California Pacific Medical Center Breast Health Cohort is linked to the San Francisco Mammography Registry, part of the NCI Breast Cancer Surveillance Consortium that collects demographic and risk factor data on women receiving mammography.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001630"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4053164/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The California Pacific Medical Center Breast Health Cohort is linked to the San Francisco Mammography Registry, part of the NCI Breast Cancer Surveillance Consortium that collects demographic and risk factor data on women receiving mammography.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001630"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27565998</owl:annotatedTarget>
        <dcterms:title>Breast cancer risk prediction using a clinical risk model and polygenic risk score.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27565998</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5033764/</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a nested case-control study within the California Pacific Medical Center (CPMC) Research Institute Cohort, which participates in the San Francisco Mammography Registry (SFMR).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001630"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of women having screening mammography at the Breast Health Center of California Pacific Medical Center in San Francisco, California, United States, an imaging facility of the San Francisco Mammography Registry (part of the NCI Breast Cancer Surveillance Consortium), who completed the registry&apos;s demographic and risk-factor questionnaire and, from 2004 to 2011, were asked to give blood for research and consent to genotyping; breast cancers are ascertained by linkage to the California Cancer Registry.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23668689</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27565998</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3132306/unicode</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5669824/unicode</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001630"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">19276</owl:annotatedTarget>
        <obo:IAO_0000116>women who gave blood samples 2004-2011</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:27565998</oboInOwl:hasDbXref>
        <rdfs:comment>Samples were obtained from 19,276 women.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001630"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
