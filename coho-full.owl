    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000652"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid5889"/>
        <obo:IAO_0000116>current and former smokers (≥ 20 pack years)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8077917/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SPIROMICS study is a multicenter study that includes current and former smokers (≥ 20 pack years) with or without airflow obstruction and healthy participants who were non-smokers aged 40 to 80 years recruited from 12 clinical sites spread across the United States.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000652"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid5891"/>
        <obo:IAO_0000116>chronic obstructive pulmonary disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3954445/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The goal is to enroll 3,200 participants in four strata: severe COPD, mild/moderate COPD, smokers without airflow obstruction and non-smoking controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000652"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8077917/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SPIROMICS study is a multicenter study that includes current and former smokers (≥ 20 pack years) with or without airflow obstruction and healthy participants who were non-smokers aged 40 to 80 years recruited from 12 clinical sites spread across the United States.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000652"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90269923</owl:annotatedTarget>
        <dcterms:title>Genetic regulators of sputum mucin concentration and their associations with COPD phenotypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37352370</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37352370+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a GWAS to identify quantitative trait loci for sputum mucin protein concentration (pQTL) in the Sub-Populations and InteRmediate Outcome Measures in COPD Study (SPIROMICS, n = 708 for total mucin, n = 215 for MUC5AC, MUC5B).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000652"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre observational cohort of current and former smokers aged 40–80 with or without airflow obstruction, and never-smoking controls, recruited at clinical sites across the United States with baseline and annual follow-up visits, to find subgroups of chronic obstructive pulmonary disease and biomarkers usable as intermediate outcomes in therapeutic trials.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24029743</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000652"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2982</owl:annotatedTarget>
        <obo:IAO_0000116>participants originally enrolled (SPIROMICS I)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.spiromics.org/spiromics/participants</oboInOwl:hasDbXref>
        <rdfs:comment>SPIROMICS originally enrolled 2,982 participants, for a three-year study of current and former smokers and individuals who had never smoked.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000652"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
