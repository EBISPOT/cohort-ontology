    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001375"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A UK Medical Research Council open-label randomised trial that enrolled adults aged 18 or older with newly diagnosed symptomatic multiple myeloma at 120 UK centres between May 2003 and November 2007, allocating them to an intensive pathway (induction followed by high-dose melphalan and autologous stem-cell transplantation) or a non-intensive pathway, and randomising first-line bisphosphonate (zoledronic versus clodronic acid) with induction chemotherapy and, later, maintenance treatment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21131037</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001375"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1970</owl:annotatedTarget>
        <obo:IAO_0000116>patients enrolled May 2003 to November 2007</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:21131037</oboInOwl:hasDbXref>
        <rdfs:comment>1970 patients were enrolled between May, 2003, and November, 2007, of whom 1960 were eligible for intention-to-treat analysis: 981 in the zoledronic acid group (555 on intensive chemotherapy, 426 on non-intensive chemotherapy); and 979 on clodronic acid (556 on intensive chemotherapy, 423 on non-intensive chemotherapy).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
