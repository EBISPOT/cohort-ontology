        <obo:IAO_0000112>GCST90565484</obo:IAO_0000112>
        <obo:IAO_0000115>A University of Michigan study that engages the public through a Facebook application for health-history and daily-tracking surveys and mails saliva kits for genotyping to participants who complete enough surveys, having engaged more than 80,000 people from all 50 US states by 2019 for genetic research on health and behaviour.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">81110</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GFG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GGP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genes for Good Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genes for Good</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000647"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31204010+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Rates of important chronic health indicators are consistent with those estimated for the general U.S. population using more traditional study designs.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000647"/>
