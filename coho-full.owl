        <obo:IAO_0000112>GCST90797639</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of normotensive children of African or European ancestry aged 5–16 years in 1989, recruited through a county-wide public school screening in Richmond County, Georgia, United States, and re-evaluated repeatedly into adulthood to study the development of cardiovascular risk factors from childhood to adulthood.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">740</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GSH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Georgia Stress and Heart study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Georgia Stress and Heart Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid8334">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000910"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8334"/>
