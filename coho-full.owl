        <obo:IAO_0000112>PGS019953</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:30482948</obo:IAO_0000112>
        <obo:IAO_0000115>A family study of alcohol dependence in Ireland and Northern Ireland that between 1998 and 2002 recruited probands meeting DSM-IV criteria for alcohol dependence, ascertained in community alcoholism treatment facilities and public and private hospitals and with all four grandparents born in Ireland or Great Britain, together with their siblings and parents, all interviewed by clinically trained interviewers, probands and siblings with a modified Semi-Structured Assessment for the Genetics of Alcoholism and parents with a modified Structured Clinical Interview for DSM.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1414</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GFG, Irish Affected Sib Pair Study of Alcohol Dependence</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IASPSAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Irish Affected Sib-Pair Study of Alcohol Dependence</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Irish Affected Sib Pair Study of Alcohol Dependence</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16732">
