    <!-- http://www.ebi.ac.uk/coho/COHO_0001192 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001192">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10834"/>
        <rdf:type rdf:nodeID="genid10836"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000522"/>
        <obo:IAO_0000112>GCST90270120</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based sleep cohort nested in the CoLaus/PsyCoLaus study of Lausanne, Switzerland: consecutive participants of CoLaus/PsyCoLaus&apos;s first follow-up (2009–12), who also answered sleep questionnaires and had clinical and biological phenotyping, were invited from September 2009 to June 2013 to a full polysomnography at home, organised from the sleep centre of Lausanne University Hospital, to study the prevalence and determinants of sleep disorders such as sleep-disordered breathing and their links with cardiometabolic and mental health. Participants were re-examined at the cohort&apos;s second follow-up in 2014–17.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2162</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HypnoLaus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HypnoLaus Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HypnoLaus cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">HypnoLaus Sleep Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10834">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_5200283"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid10836">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003406"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001192"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10834"/>
        <obo:IAO_0000116>sleep-disordered breathing</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25682233+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Taking into account improvements in recording techniques and new criteria used to define respiratory events, we aimed to assess the prevalence of sleep-disordered breathing and associated clinical features in a large population-based sample.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001192"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10836"/>
        <obo:IAO_0000116>sleep disorders</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25682233+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Taking into account improvements in recording techniques and new criteria used to define respiratory events, we aimed to assess the prevalence of sleep-disordered breathing and associated clinical features in a large population-based sample.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001192"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6509728/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>HypnoLaus is a population‐based sleep cohort study conducted in Lausanne, Switzerland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001192"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000522"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6509728/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The HypnoLaus study was performed between September 1, 2009 and June 30, 2013, and participants were recruited among the CoLaus/PsyCoLaus study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001192"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90270120</owl:annotatedTarget>
        <dcterms:title>The genetic etiology of periodic limb movement in sleep.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35670608</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35670608+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Replication in the HypnoLaus and MESA cohorts (1002 cases) preceded joint meta-analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001192"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based sleep cohort nested in the CoLaus/PsyCoLaus study of Lausanne, Switzerland: consecutive participants of CoLaus/PsyCoLaus&apos;s first follow-up (2009–12), who also answered sleep questionnaires and had clinical and biological phenotyping, were invited from September 2009 to June 2013 to a full polysomnography at home, organised from the sleep centre of Lausanne University Hospital, to study the prevalence and determinants of sleep disorders such as sleep-disordered breathing and their links with cardiometabolic and mental health. Participants were re-examined at the cohort&apos;s second follow-up in 2014–17.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25682233</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30898062</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35861817</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001192"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2162</owl:annotatedTarget>
        <obo:IAO_0000116>CoLaus/PsyCoLaus participants with a complete home polysomnography, 2009-2013</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9707830/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 2162 participants included in HypnoLaus, 1172 who had hypertension at baseline with complete polysomnography and known hypertension status at follow‐up were included in this analysis (Figure 2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001192"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HypnoLaus</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001193 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001193">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10844"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>GCST90624430</obo:IAO_0000112>
        <obo:IAO_0000115>A French prospective multicentre cohort, sponsored by Assistance Publique – Hôpitaux de Paris, of women of European ancestry aged over 18 who gave birth in eight maternity departments of the Paris metropolitan area and were included two to five days after delivery between November 2011 and June 2016. The women gave a blood sample for DNA and were assessed for depression by trained clinicians with DSM-5 criteria at inclusion, at 8 weeks and at 1 year postpartum, to study how genetic factors and maternal stressors interact in the risk of postpartum depression.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3310</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>IGEDEPP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Interaction Between Genetic Factors and Maternal Stressors During Pregnancy in the Risk of Postpartum Depression</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Interaction of Gene and Environment of Depression in PostPartum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>interaction of gene and environment of depression during postpartum</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Interaction of Gene and Environment of Depression during PostPartum</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10844">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005929"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001193"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10844"/>
        <obo:IAO_0000116>postpartum depression</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33932643+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>IGEDEPP (Interaction of Gene and Environment of Depression during PostPartum) is a prospective multicenter cohort study of 3310 Caucasian women who gave birth between 2011 and 2016, with follow-up until one year postpartum.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001193"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11059250/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Our study among the interaction of gene and environment of depression during postpartum (IGEDEPP) women, in the Paris areas (France), showed 1-year cumulative incidence of PPD of 18.1%, a prevalence of early-onset PPD of 8.3%, and a prevalence of late-onset PPD of 12.9% [6], in line with previous works [7].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001193"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90624430</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of early-onset and late-onset postpartum depression: the IGEDEPP prospective study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38555957</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11059250/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>With the French multicenter interaction of gene and environment of depression during postpartum (IGEDEPP) cohort, we conducted a genome-wide association study (GWAS) on 234 women with early-onset PPD and 223 women with late-onset PPD, as well as 1,204 controls with no history of lifetime depression.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001193"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A French prospective multicentre cohort, sponsored by Assistance Publique – Hôpitaux de Paris, of women of European ancestry aged over 18 who gave birth in eight maternity departments of the Paris metropolitan area and were included two to five days after delivery between November 2011 and June 2016. The women gave a blood sample for DNA and were assessed for depression by trained clinicians with DSM-5 criteria at inclusion, at 8 weeks and at 1 year postpartum, to study how genetic factors and maternal stressors interact in the risk of postpartum depression.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33932643</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38555957</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT01648816</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001193"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3310</owl:annotatedTarget>
        <obo:IAO_0000116>women included after delivery, 2011-2016</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33932643+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>BackgroundIGEDEPP (Interaction of Gene and Environment of Depression during PostPartum) is a prospective multicenter cohort study of 3310 Caucasian women who gave birth between 2011 and 2016, with follow-up until one year postpartum.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001193"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>IGEDEPP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001194 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001194">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10851"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <obo:IAO_0000112>GCST90568440</obo:IAO_0000112>
        <obo:IAO_0000115>A school-based cohort of children and adolescents aged 5–17 from primary and secondary general-education schools across Catalonia, Spain, set up to study neurodevelopmental disorders, school performance and their genetic and environmental factors. Since the 2011–2012 school year, parents and teachers complete screening questionnaires for mental health problems and learning difficulties, children who screen positive are assessed by psychiatrists and neuropsychologists for DSM diagnoses, academic marks are taken from school records, and DNA is collected from saliva or buccal swabs.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9018</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>INSchool</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>INSchool cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Impact of Neurodevelopmental disorders and School performance: genes and environment</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10851">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0700092"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001194"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10851"/>
        <obo:IAO_0000116>neurodevelopmental disorders</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41554769+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Children who screened positive were interviewed for diagnostic confirmation according to the Diagnostic and Statistical Manual of Mental Disorders, while students who screened negative served as controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001194"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12820112/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study sample was drawn from 77 general education schools in Catalonia, Spain, as part of the INSchool cohort, a larger, ongoing research.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001194"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90568440</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of childhood ADHD symptoms and diagnosis identifies new loci and potential effector genes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40962958</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02295-y/MediaObjects/41588_2025_2295_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The INSchool cohort consist of 3, 557 children from 23 schools in Catalonia (age range: 5-17 years; 234 mean age: 9.8 years, s.d.=2.9).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001194"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A school-based cohort of children and adolescents aged 5–17 from primary and secondary general-education schools across Catalonia, Spain, set up to study neurodevelopmental disorders, school performance and their genetic and environmental factors. Since the 2011–2012 school year, parents and teachers complete screening questionnaires for mental health problems and learning difficulties, children who screen positive are assessed by psychiatrists and neuropsychologists for DSM diagnoses, academic marks are taken from school records, and DNA is collected from saliva or buccal swabs.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38783053</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40962958</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41554769</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001194"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9018</owl:annotatedTarget>
        <obo:IAO_0000116>analysed subset: students screening negative or with a confirmed neurodevelopmental diagnosis, with school marks (77 schools)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41554769+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The final sample comprised 9018 participants aged 5-17.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001194"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>INSchool</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001195 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001195">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10858"/>
