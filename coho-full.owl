        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1857</owl:annotatedTarget>
        <obo:IAO_0000116>cases with MDD and controls at low liability for MDD selected for GAIN genome-wide genotyping; no total stated</obo:IAO_0000116>
