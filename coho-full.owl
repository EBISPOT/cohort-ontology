        <oboInOwl:hasDbXref>https://clinicaltrials.gov/api/v2/studies/NCT02119182</oboInOwl:hasDbXref>
        <rdfs:comment>&quot;enrollmentInfo&quot;:{&quot;count&quot;:2996,&quot;type&quot;:&quot;ACTUAL&quot;}</rdfs:comment>
    </owl:Axiom>
