        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1082</owl:annotatedTarget>
        <obo:IAO_0000116>never-smoking female lung cancer cases and controls that SKLCS contributed to the 2012 FLCCA GWAS (Supplementary Table 1 columns: all cases, adenocarcinomas, squamous cell carcinomas, controls); no total stated</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>SKLCS South Korea 546 419 28 1082 61.6(11.0) 61.6(10.7) 63.6(11.2) 51.1(14.7) NA*</rdfs:comment>
    </owl:Axiom>
