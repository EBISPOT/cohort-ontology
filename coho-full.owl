    <!-- http://www.ebi.ac.uk/coho/COHO_0000868 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000868">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid7906"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000915"/>
        <obo:IAO_0000112>GCST90448084</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective registry of Black and White patients with heart failure enrolled within the Henry Ford Health System in Detroit, Michigan, from 2007 to 2015, with genotyping and pharmacy claims data, designed to discover ways to predict heart failure prognosis and responses to heart failure therapies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1700</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HF pharmacogenomic registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HFGR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HFPGR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Henry Ford Heart Failure Pharmacogenomic Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid7906">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005252"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000868"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7906"/>
        <obo:IAO_0000116>heart failure</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The inclusion criteria were as follows: age ≥ 18 years; a diagnosis of HF using the Framingham Heart Study criteria [16]; and at least one documented LVEF &lt; 50% measured via echocardiography, nuclear stress tests, or radionuclide blood pool imaging.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000868"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The registry began enrolling patients in October 2007, within the Henry Ford Health System in Detroit, MI, USA, and enrolment was completed in March 2015.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000868"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90448084</owl:annotatedTarget>
        <dcterms:title>Genome-Wide Association Study of Beta-Blocker Survival Benefit in Black and White Patients with Heart Failure with Reduced Ejection Fraction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38002962</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The discovery dataset came from a prospective HF pharmacogenomic registry (HFGR) designed to discover novel ways to predict HF prognoses and responses to HF therapies [9].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000868"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective registry of Black and White patients with heart failure enrolled within the Henry Ford Health System in Detroit, Michigan, from 2007 to 2015, with genotyping and pharmacy claims data, designed to discover ways to predict heart failure prognosis and responses to heart failure therapies.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000868"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1700</owl:annotatedTarget>
        <obo:IAO_0000116>heart failure patients enrolled (stated as more than 1700), 2017</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5679305/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Henry Ford Heart Failure Pharmacogenomic registry has enrolled more than 1700 HF patients of any type and collected blood/plasma samples and detailed phenotypic information.</rdfs:comment>
    </owl:Axiom>
