        <oboInOwl:hasRelatedSynonym>CerePP French Prostate Cancer Case-Control Study (ProGene)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FPCC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>French Center for Research on Prostate Diseases</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>French Prostate Case–Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ProGene</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
