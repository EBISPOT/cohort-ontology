        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:38829475</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre prospective population-based cohort of men aged 40–79 years recruited from population registers in eight European centres (Florence, Leuven, Lodz, Malmö, Manchester, Santiago de Compostela, Szeged and Tartu) with an age-stratified sample at each centre, who completed a detailed questionnaire on personal and medical history, lifestyle and sexual function, designed to examine the prevalence, incidence and geographical distribution of gender-specific and general symptoms of ageing in men and their endocrine, genetic and psychosocial predictors, particularly age-related changes in hormone levels.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3369</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>EMAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European Male Aging Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European male ageing study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">European Male Ageing Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001687"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Estonia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18328041+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Men aged 40-79 years were recruited from eight European centres: Florence (Italy), Leuven (Belgium), Lodz (Poland), Malmö (Sweden), Manchester (UK), Santiago de Compostela (Spain), Szeged (Hungary) and Tartu (Estonia).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001687"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38829475</owl:annotatedTarget>
        <dcterms:title>Evidence-based definition of hypoprolactinemia in European men aged 40-86 years: the European male ageing study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38829475</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38829475+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Using data from the European Male Ageing Study (EMAS), we analyzed the distribution of PRL in 3,369 community-dwelling European men, aged 40-80 years at phase-1 and free from acute illnesses.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001687"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre prospective population-based cohort of men aged 40–79 years recruited from population registers in eight European centres (Florence, Leuven, Lodz, Malmö, Manchester, Santiago de Compostela, Szeged and Tartu) with an age-stratified sample at each centre, who completed a detailed questionnaire on personal and medical history, lifestyle and sexual function, designed to examine the prevalence, incidence and geographical distribution of gender-specific and general symptoms of ageing in men and their endocrine, genetic and psychosocial predictors, particularly age-related changes in hormone levels.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18328041</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18653627</obo:IAO_0000119>
