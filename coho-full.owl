        <obo:IAO_0000112>PGS000733</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:32930425</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of prostate cancer in Montreal, Quebec, Canada, in which men aged 75 or under with histologically confirmed prostate cancer diagnosed in 2005–2009 were ascertained across Montreal&apos;s French-language hospitals and controls were randomly selected from the provincial electoral list of French-speaking men, frequency-matched on age, and interviewed in person on sociodemographic, lifestyle, environmental and medical factors, with a genetic component.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1937</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1995</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>Montreal PROtEuS Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PROtEuS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prostate Cancer &amp; Environment Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Prostate Cancer and Environment Study</rdfs:label>
    </owl:NamedIndividual>
