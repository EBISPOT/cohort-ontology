        <obo:IAO_0000112>EGAS00001004556</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of Polish patients with gliomas of WHO grades II to IV whose tumours and matched blood were sequenced with a panel of cancer- and epigenetics-related genes to characterise somatic and germline variants.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">182</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Polish Glioma Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
