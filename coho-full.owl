        <oboInOwl:hasDbXref>PMID:40691366</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001800"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29892015</owl:annotatedTarget>
        <dcterms:title>Polygenic prediction of body mass index and obesity through the life course and across ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29892015</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The GGAF cohort (n=2207) is a genotype and phenotype repository of individuals with AF and age- and sex-matched controls from 5 different sources.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001800"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of individuals with atrial fibrillation and age- and sex-matched controls, assembled at the University Medical Center Groningen, the Netherlands, as a genotype and phenotype repository for genetic studies of atrial fibrillation, whose cases come from three hospital-based atrial fibrillation cohorts (the AF-Risk, Young-AF and Biomarker-AF studies) and whose controls come from the GIPS-III trial and the PREVEND community cohort of Groningen.</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001800"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1108</owl:annotatedTarget>
        <obo:IAO_0000116>GGAF genotype and phenotype repository in the 2018 profile</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Individuals with AF (n=1108) were included in 3 registry cohorts at the University Medical Center (www.atrialfibrillationresearch.nl), and Maastricht University Medical Center (AF-Risk n=6).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001800"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2207</owl:annotatedTarget>
        <obo:IAO_0000116>GGAF genotype and phenotype repository in the 2018 profile</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The GGAF cohort (n=2207) is a genotype and phenotype repository of individuals with AF and age- and sex-matched controls from 5 different sources.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001800"/>
