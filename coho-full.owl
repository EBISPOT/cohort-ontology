    <!-- http://www.ebi.ac.uk/coho/COHO_0001626 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001626">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14665"/>
        <rdf:type rdf:nodeID="genid14667"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:20972440</obo:IAO_0000112>
        <obo:IAO_0000115>A UK family study that since 1999 has recruited, through Clinical Genetics Departments throughout the United Kingdom, members of families with colorectal tumours who developed colorectal cancer by age 80 or significant colorectal adenomas (three or more, with severe dysplasia or villous histology, or presenting before age 45; adenoma-only cases having a first- or second-degree relative with colorectal cancer), with their unaffected spouses or partners as controls, to identify genes that predispose to colorectal tumours. Its cases and controls formed the first UK genome-wide association study of colorectal cancer (UK1) and later sample sets.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1476</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1666</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>CORGI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CORGI Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CORGI study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COloRectal Gene Identification consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COloRectal tumour Gene Identification</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CoRGI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Colorectal Tumour Gene Identification study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">COloRectal tumour Gene Identification study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14665">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005484"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid14667">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005575"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001626"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14665"/>
        <obo:IAO_0000116>colorectal adenoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5098601/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The UK4/CORGI2BCD samples comprised additional CRC cases and unaffected spouse/partner controls from the CORGI study collected since the UK1/CORGI samples.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001626"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14667"/>
        <obo:IAO_0000116>colorectal cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5098601/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The UK4/CORGI2BCD samples comprised additional CRC cases and unaffected spouse/partner controls from the CORGI study collected since the UK1/CORGI samples.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001626"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3785128/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study has recruited through Clinical Genetics Departments from throughout the United Kingdom since 1999 and has to date enrolled 1,698 families.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001626"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20972440</owl:annotatedTarget>
        <dcterms:title>Meta-analysis of three genome-wide association studies identifies susceptibility loci for colorectal cancer at 1q41, 3q26.2, 12q13.13 and 20q13.33.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20972440</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5098601/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We therefore directly proceeded to a combined analysis of the three GWA studies, comprising UK1/CORGI and Scotland1/COGS in addition to VQ58 (Supplementary Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001626"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A UK family study that since 1999 has recruited, through Clinical Genetics Departments throughout the United Kingdom, members of families with colorectal tumours who developed colorectal cancer by age 80 or significant colorectal adenomas (three or more, with severe dysplasia or villous histology, or presenting before age 45; adenoma-only cases having a first- or second-degree relative with colorectal cancer), with their unaffected spouses or partners as controls, to identify genes that predispose to colorectal tumours. Its cases and controls formed the first UK genome-wide association study of colorectal cancer (UK1) and later sample sets.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17618284</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20972440</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23263490</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31089142</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001626"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1476</owl:annotatedTarget>
        <obo:IAO_0000116>CORGI cases (colorectal cancer or adenomas) and spouse/partner controls used in a 2013 study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:23263490</oboInOwl:hasDbXref>
        <rdfs:comment>CORGI cases comprised 1,476 individuals from the COloRectal tumour Gene Identification study 30.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001626"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1666</owl:annotatedTarget>
