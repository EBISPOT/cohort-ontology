    <!-- http://www.ebi.ac.uk/coho/COHO_0000750 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000750">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>GCST90503108</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of population-based pregnancy and birth cohort studies, set up alongside the Early Growth Genetics consortium, that pools genome-wide data to study the genetic basis of phenotypes from fetal life into adolescence such as asthma, eczema, childhood psychopathology, cognition and neurodevelopment.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym EAGLE also denotes Environment And Genetics in Lung cancer Etiology study (COHO:0000749) and EAGLE BioVU (COHO:0000751); this term is EArly Genetics and Lifecourse Epidemiology consortium.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21399</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95464</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>EAGLE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAGLE consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EArly Genetics &amp; Lifecourse Epidemiology</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EArly Genetics Lifecourse Epidemiology consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EArly Genetics and Life course Epidemiology</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EArly Genetics and Lifecourse Epidemiology</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EGLE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Early Genetics and Lifecourse Epidemiology</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">EArly Genetics and Lifecourse Epidemiology consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000750"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90503108</owl:annotatedTarget>
        <dcterms:title>Integration of GWAS, QTLs and keratinocyte functional assays reveals molecular mechanisms of atopic dermatitis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40164604</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The EArly Genetics and Lifecourse Epidemiology (EAGLE) Consortium AD meta-analysis published by Paternoster et al in ref. 12, performed fixed-effect GWAS meta-analysis on ~21,000 cases and 95,000 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000750"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium of population-based pregnancy and birth cohort studies, set up alongside the Early Growth Genetics consortium, that pools genome-wide data to study the genetic basis of phenotypes from fetal life into adolescence such as asthma, eczema, childhood psychopathology, cognition and neurodevelopment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30887376</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000750"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">21399</owl:annotatedTarget>
        <obo:IAO_0000116>discovery cases and controls in the 2015 EAGLE atopic dermatitis meta-analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:26482879%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>we performed a meta-analysis of &gt;15 million genetic variants in 21,399 cases and 95,464 controls from populations of European, African, Japanese and Latino ancestry, followed by replication in 32,059 cases and 228,628 controls from 18 studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000750"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">95464</owl:annotatedTarget>
        <obo:IAO_0000116>discovery cases and controls in the 2015 EAGLE atopic dermatitis meta-analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:26482879%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>we performed a meta-analysis of &gt;15 million genetic variants in 21,399 cases and 95,464 controls from populations of European, African, Japanese and Latino ancestry, followed by replication in 32,059 cases and 228,628 controls from 18 studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000750"/>
