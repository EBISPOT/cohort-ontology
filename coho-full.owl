        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">632</owl:annotatedTarget>
        <obo:IAO_0000116>T2D cases and nondiabetic controls in the AGEN-T2D stage 3 replication</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Seoul National University Hospital (SNUH) Study The Seoul National University Hospital (SNUH) case-control samples were consisted of 761 T2D patients of the Diabetes Clinic of SNUH and 632 nondiabetic control subjects.</rdfs:comment>
    </owl:Axiom>
