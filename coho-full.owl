        <obo:IAO_0000112>GCST90104595</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based survey of Caucasian adults aged 40 years or older, randomly selected in 2006 from the patient lists of randomly chosen general practitioners in four areas of the Veneto region (Verona, Padova and Venice) in north-eastern Italy, with centralised laboratory measurement of kidney function and albuminuria, set up at the University of Verona to determine the prevalence of chronic kidney disease and its risk factors; two subsets of its participants were genotyped for genetic studies.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3870</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>INCIPE</oboInOwl:hasRelatedSynonym>
