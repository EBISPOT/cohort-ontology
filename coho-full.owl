    <!-- http://www.ebi.ac.uk/coho/COHO_0002477 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002477">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21037"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001439"/>
        <obo:IAO_0000112>PMID:35650188</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of young Dutch adults recruited online through a project website launched in 2006, who reported their cannabis use and psychotic-like experiences in a web-based survey; to increase power for gene-environment interaction, a genotyped subset combines participants from the general population with participants selected from the top or bottom quintile of psychotic-like experience scores who were either cannabis non-users or heavy users.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17698</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CannabisQuest</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UCC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Utrecht cannabis cohort</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Utrecht Cannabis Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21037">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0100005"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002477"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21037"/>
        <obo:IAO_0000116>cannabis use</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10106286/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This is compared with the cross-sectional Utrecht cannabis cohort, which is a cohort that has been enriched for PLE and heavy cannabis use; heavy cannabis use being a particularly strong risk factor for development of psychosis and PLE.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002477"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Ftp.2016.36/MediaObjects/41398_2016_BFtp201636_MOESM267_ESM.doc</oboInOwl:hasDbXref>
        <rdfs:comment>Utrecht: Utrecht Cannabis Cohort (CannabisQuest) –The Netherlands</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002477"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:35650188</owl:annotatedTarget>
        <dcterms:title>Childhood maltreatment mediates the effect of the genetic background on psychosis risk in young adults.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35650188</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9160238/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The relationship between schizophrenia polygenetic risk, CM, and psychotic-like experiences (PLE) was investigated in participants from the Utrecht Cannabis Cohort (N = 1262) and replicated in the independent IMAGEN cohort (N = 1740).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002477"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of young Dutch adults recruited online through a project website launched in 2006, who reported their cannabis use and psychotic-like experiences in a web-based survey; to increase power for gene-environment interaction, a genotyped subset combines participants from the general population with participants selected from the top or bottom quintile of psychotic-like experience scores who were either cannabis non-users or heavy users.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21592732</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35650188</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37310336</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Ftp.2016.36/MediaObjects/41398_2016_BFtp201636_MOESM267_ESM.doc</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002477"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17698</owl:annotatedTarget>
        <obo:IAO_0000116>young Dutch adults who completed the cohort&apos;s online assessment (CannabisQuest), of whom 1259 were then genotyped</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Ftp.2016.36/MediaObjects/41398_2016_BFtp201636_MOESM267_ESM.doc</oboInOwl:hasDbXref>
        <rdfs:comment>From the online data (N = 17,698), 1259 participants were included for subsequent genetic assessment in two waves.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002477"/>
