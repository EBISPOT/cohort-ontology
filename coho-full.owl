    <!-- http://www.ebi.ac.uk/coho/COHO_0001159 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001159">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10546"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90446233</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based longitudinal cohort of Black and White adults aged 65 and over living in four adjacent neighbourhoods on the south side of Chicago, Illinois, recruited through a door-to-door census from 1993, with later age groups entered as residents turned 65. Participants were followed until 2012 with in-home interviews every three years and clinical evaluation of stratified random samples, to study common chronic conditions of late life, especially risk factors for Alzheimer&apos;s disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10802</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CHAP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Chicago Health and Aging Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10546">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004975"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001159"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10546"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14646025+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>CHAP is a longitudinal population study of common chronic health problems of older persons, especially of risk factors for incident Alzheimer&apos;s disease, in a biracial neighborhood of the south side of Chicago.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001159"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42583594+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We set our study in the Chicago Health and Aging Project, a longitudinal cohort of community-dwelling older adults from four Chicago, Illinois, neighborhoods, followed from 1993 to 2012.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90446233</owl:annotatedTarget>
        <dcterms:title>Extended genome-wide association study employing the African genome resources panel identifies novel susceptibility loci for Alzheimer&apos;s disease in individuals of African ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38958117</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11350055/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>When not available, other information was used instead, such as age at diagnosis (Chicago Health and Aging Project [CHAP], Minority Aging Research Study/Clinical Minority Core [MARS/CORE]) or age at ascertainment (Indiana University).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based longitudinal cohort of Black and White adults aged 65 and over living in four adjacent neighbourhoods on the south side of Chicago, Illinois, recruited through a door-to-door census from 1993, with later age groups entered as residents turned 65. Participants were followed until 2012 with in-home interviews every three years and clinical evaluation of stratified random samples, to study common chronic conditions of late life, especially risk factors for Alzheimer&apos;s disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:14646025</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39641998</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40575494</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001159"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">10802</owl:annotatedTarget>
        <obo:IAO_0000116>participants enrolled 1993-2012 (initial cohort plus successive age-eligible cohorts)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:39641998</oboInOwl:hasDbXref>
        <rdfs:comment>An additional 4,644 participants who later became age-eligible were recruited in successive cohorts, leading to a total study population of 10,802 participants by 2012.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001159"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CHAP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001160 -->

