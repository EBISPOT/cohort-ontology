    <!-- http://www.ebi.ac.uk/coho/COHO_0001212 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001212">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11018"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90274713</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of prostate cancer of the US National Cancer Institute in the Baltimore area of Maryland, which from 2005 to 2015 enrolled African American and European American men diagnosed with prostate cancer at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center, and population controls identified through the Maryland motor vehicle administration and frequency-matched to cases on age and race. Participants were interviewed about their demographics, lifestyle and medical and family history and gave blood or mouthwash samples, to study environmental and genetic factors in prostate cancer among African American men.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">976</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1034</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2010</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Maryland Prostate Cancer Case-Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCI-MD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCI-Maryland prostate Cancer Case-Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">NCI-Maryland Prostate Cancer Case-Control Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11018">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008315"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11018"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29784730+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>the NCI-Maryland Prostate Cancer Case-Control Study consisting of 798 men with incident prostate cancer (402 AA and 496 EA) and 1,008 population-based controls (474 AA and 534 EA).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9592685/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Cases were recruited at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90274713</owl:annotatedTarget>
        <dcterms:title>Characterizing prostate cancer risk through multi-ancestry genome-wide discovery of 187 novel risk variants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37945903</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10841479/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The present study included an additional 49,072 cases and 661,437 controls from the UK Biobank, the FinnGen study, the Electronic Medical Records and Genomics (eMERGE) Network, the BioVU Biobank, the BioMe Biobank, the Prostate, Lung, Colorectal, and Ovarian Cancer Screening Trial (PLCO), the MD Anderson prostate cancer study (MD Anderson), the California and Uganda Prostate Cancer Study (CA UG), the VA Million Veteran Program (MVP), and the Maryland Prostate Cancer Case-Control Study (NCI-MD) (Supplementary Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of prostate cancer of the US National Cancer Institute in the Baltimore area of Maryland, which from 2005 to 2015 enrolled African American and European American men diagnosed with prostate cancer at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center, and population controls identified through the Maryland motor vehicle administration and frequency-matched to cases on age and race. Participants were interviewed about their demographics, lifestyle and medical and family history and gave blood or mouthwash samples, to study environmental and genetic factors in prostate cancer among African American men.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29784730</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35468990</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">976</owl:annotatedTarget>
        <obo:IAO_0000116>men recruited 2005-2015 (cases and population controls)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9592685/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In addition, we could not evaluate the relationship of HHV-8 seropositivity with prostate cancer for all men in the NCI-Maryland study because we could not collect sera samples and germline DNA from a subset of the men, leading to the inclusion of 1541 men in the analysis out of the 2010 recruited men (76.7%).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1034</owl:annotatedTarget>
        <obo:IAO_0000116>men recruited 2005-2015 (cases and population controls)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9592685/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In addition, we could not evaluate the relationship of HHV-8 seropositivity with prostate cancer for all men in the NCI-Maryland study because we could not collect sera samples and germline DNA from a subset of the men, leading to the inclusion of 1541 men in the analysis out of the 2010 recruited men (76.7%).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2010</owl:annotatedTarget>
        <obo:IAO_0000116>men recruited 2005-2015 (cases and population controls)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9592685/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In addition, we could not evaluate the relationship of HHV-8 seropositivity with prostate cancer for all men in the NCI-Maryland study because we could not collect sera samples and germline DNA from a subset of the men, leading to the inclusion of 1541 men in the analysis out of the 2010 recruited men (76.7%).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NCI-MD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001213 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001213">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000435"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002719"/>
        <obo:IAO_0000112>GCST90841457</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective birth cohort of the University of Oulu comprising the children of all mothers in the two northernmost provinces of Finland, Oulu and Lapland, whose expected date of delivery fell in 1966, recruited during pregnancy at the region&apos;s antenatal clinics from 1965. Set up to study the risk factors for and consequences of preterm birth and intrauterine growth retardation, it has followed its members with questionnaires at 1, 14, 31 and 46 years of age, clinical examinations in adulthood and linked national registers to study the life-course origins of health and disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12058</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/NFBC1966</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>1966 Northern Finland Birth Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NFBC-66</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NFBC1966</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NFBC66</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Northern Finland Birth Cohort of 1966</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Northern Finland Premature Birth Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Northern Finland birth cohort 1966</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Northern Finland Birth Cohort 1966</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.oulu.fi/nfbc"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001213"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11202814+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Data were obtained from 5696 subjects born in the year 1966 in northern Finland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90841457</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry, trans-generational GWAS meta-analysis of gestational diabetes and glycaemic traits during pregnancy reveals limited evidence of pregnancy-specific genetic effects.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42225636</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13226718/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Northern Finland Birth Cohort 1966</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective birth cohort of the University of Oulu comprising the children of all mothers in the two northernmost provinces of Finland, Oulu and Lapland, whose expected date of delivery fell in 1966, recruited during pregnancy at the region&apos;s antenatal clinics from 1965. Set up to study the risk factors for and consequences of preterm birth and intrauterine growth retardation, it has followed its members with questionnaires at 1, 14, 31 and 46 years of age, clinical examinations in adulthood and linked national registers to study the life-course origins of health and disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34999878</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001213"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12058</owl:annotatedTarget>
        <obo:IAO_0000116>live-born children included in the cohort follow-ups (1966)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8743124/</oboInOwl:hasDbXref>
        <rdfs:comment>Finally, 12 058 live-born children were included in the follow-ups, i.e. 5890 girls and 6168 boys, of whom were 314 twins (see Table 2 under ‘Loss to follow-up’).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001213"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NFBC-66</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001213"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NFBC1966</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
