        <obo:IAO_0000112>GCST90797639</obo:IAO_0000112>
        <obo:IAO_0000115>An unselected Danish mother-child birth cohort of 738 pregnant women from eastern Denmark recruited in 2008–2010 at week 24 of pregnancy and their 700 children, deeply phenotyped at the COPSAC clinic with nested randomised trials of vitamin D and fish oil in pregnancy, to study how perinatal exposures such as the microbiome and maternal nutrition interact with genetics in the development of asthma and other chronic inflammatory diseases.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">738</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>COPSAC2010</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Copenhagen Prospective Studies on Asthma in Childhood 2010</rdfs:label>
    </owl:NamedIndividual>
