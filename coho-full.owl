        <obo:IAO_0000119>PMID:32871146</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37404302</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001716"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">399</owl:annotatedTarget>
        <obo:IAO_0000116>Danish EYHS longitudinal sample measured at three ages in the 2023 study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10315841/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the European Youth Heart Study (EYHS), height, weight and habitual PA were measured at age 9.6-years, 15.7-years and 21.8-years in 399 Danish boys and girls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001716"/>
