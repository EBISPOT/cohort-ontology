    <!-- http://www.ebi.ac.uk/coho/COHO_0000847 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000847">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>GCST90131442</obo:IAO_0000112>
        <obo:IAO_0000115>A single-centre longitudinal family cohort of 4,295 people from 1,006 families of the Lorraine region, recruited in 1993–1995 at the Center for Preventive Medicine in Nancy, France, and re-examined over about 20 years, to study the familial and genetic determinants of cardiovascular and metabolic traits.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4295</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SFS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STANISLAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STANISLAS Family Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STANISLAS cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STANISLAS study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STANISLAS study cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Suivi Temporaire Annuel Non-Invasif de la Santé des Lorrains Assurés Sociaux</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000847"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
