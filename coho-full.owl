    <!-- http://www.ebi.ac.uk/coho/COHO_0002667 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002667">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
