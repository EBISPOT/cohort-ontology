        <rdfs:comment>SLIC families were all selected on the basis of a single proband with receptive and/or expressive language skills more than 1.5 SD below the normative mean for his or her age.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000850"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
