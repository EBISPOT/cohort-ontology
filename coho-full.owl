        <oboInOwl:hasRelatedSynonym>Precube</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prevention Cube: data warehouse for detection and evaluation of trends of occupational diseases</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prevention Cube: data warehouse for detection and evaluation of trends of occupational diseases (Precube)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Prevention Cube</rdfs:label>
    </owl:NamedIndividual>
