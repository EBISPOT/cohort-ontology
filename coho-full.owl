        <oboInOwl:hasRelatedSynonym>BusSante</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Bus Santé</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001551"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10209490/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We used data from the Bus Santé study, an ongoing yearly population-based cross-sectional study of adults living in the state of Geneva, Switzerland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001551"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
