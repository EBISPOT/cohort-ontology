    <!-- http://www.ebi.ac.uk/coho/COHO_0000635 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000635">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90000059</obo:IAO_0000112>
        <obo:IAO_0000115>A family cohort of about 2,000 white European adults from 520 nuclear families (both parents aged 40–60 and two adult offspring), identified through general practices in Leicestershire, UK, and recruited in 2002–2005 to study the genetic regulation of blood pressure and related cardiovascular traits.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2024</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GRAPHIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GRAPHIC Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Regulation of Arterial Pressure in Humans in the Community</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetic Regulation of Arterial Pressure in Humans in the Community Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000635"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5144126/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, nuclear families (all of white European ancestry) with both parents (aged 40–60 years) and two adult (⩾18 years) offspring were identified through general practices in Leicestershire, UK, and invited to participate through an invitation letter sent through the mother.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000635"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90000059</owl:annotatedTarget>
        <dcterms:title>Discovery of rare variants associated with blood pressure regulation through meta-analysis of 1.3 million individuals.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33230300</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7610439/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>GRAPHIC Genetic Regulation of Arterial Pressure in Humans In the Community Three clinic blood pressure measurments using an Omron HEM-705CP digital BP monitor.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000635"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family cohort of about 2,000 white European adults from 520 nuclear families (both parents aged 40–60 and two adult offspring), identified through general practices in Leicestershire, UK, and recruited in 2002–2005 to study the genetic regulation of blood pressure and related cardiovascular traits.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24391740</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5144126/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000635"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2024</owl:annotatedTarget>
        <obo:IAO_0000116>adults recruited from 520 nuclear families</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5144126/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of the 2024 individuals from 520 nuclear families recruited in GRAPHIC, individuals who were receiving anti-hypertensive medications (n=135) were excluded from the current analysis to avoid any confounding caused by modulation of diurnal variation in BP by drugs.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000635"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GRAPHIC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000636 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000636">
