    <!-- http://www.ebi.ac.uk/coho/COHO_0002070 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002070">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid18060"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PGS000004</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:36689693</obo:IAO_0000112>
        <obo:IAO_0000115>A randomized phase III trial of the European Organisation for Research and Treatment of Cancer (EORTC 10041/BIG 3-04) that enrolled women aged 18–70 years with operable early-stage invasive breast cancer and up to three positive lymph nodes at institutions in nine European countries from 2007 to 2011, to test whether the 70-gene signature (MammaPrint), used with clinical-pathological criteria, can select patients for adjuvant chemotherapy.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6693</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>EORTC 10041/BIG 03-04</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EORTC 10041/BIG 3-04</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MINDACT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Microarray In Node-Negative and 1 to 3 Positive Lymph Node Disease May Avoid Chemotherapy Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Microarray in Node-negative Disease May Avoid Chemotherapy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Microarray in Node-Negative and 1 to 3 Positive Lymph Node Disease May Avoid Chemotherapy</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18060">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002070"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid18060"/>
        <obo:IAO_0000116>early-stage breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27557300+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In this randomized, phase 3 study, we enrolled 6693 women with early-stage breast cancer and determined their genomic risk (using the 70-gene signature) and their clinical risk (using a modified version of Adjuvant! Online).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002070"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Europe"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7385160/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were enrolled in 112 participating institutions in nine European countries between February 2007 and September 2011.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002070"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000004</owl:annotatedTarget>
        <dcterms:title>Associations of a Breast Cancer Polygenic Risk Score With Tumor Characteristics and Survival.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36689693</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002070"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:36689693</owl:annotatedTarget>
        <dcterms:title>Associations of a Breast Cancer Polygenic Risk Score With Tumor Characteristics and Survival.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36689693</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36689693+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Women with invasive breast cancer were included, 98,397 of European ancestry and 12,920 of Asian ancestry, from the Breast Cancer Association Consortium (BCAC), and 683 women from the European MINDACT trial.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002070"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomized phase III trial of the European Organisation for Research and Treatment of Cancer (EORTC 10041/BIG 3-04) that enrolled women aged 18–70 years with operable early-stage invasive breast cancer and up to three positive lymph nodes at institutions in nine European countries from 2007 to 2011, to test whether the 70-gene signature (MammaPrint), used with clinical-pathological criteria, can select patients for adjuvant chemotherapy.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27557300</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32719399</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36689693</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002070"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6693</owl:annotatedTarget>
        <obo:IAO_0000116>women with early-stage breast cancer enrolled, February 2007 to September 2011 (2007-2011)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27557300+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In this randomized, phase 3 study, we enrolled 6693 women with early-stage breast cancer and determined their genomic risk (using the 70-gene signature) and their clinical risk (using a modified version of Adjuvant! Online).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002070"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MINDACT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
