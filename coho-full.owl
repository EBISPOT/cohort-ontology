        <oboInOwl:hasRelatedSynonym>The Role of Diet, Complementary Treatments &amp; Lifestyle in Breast Cancer Survival</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">DietCompLyf Breast Cancer Survival Study</rdfs:label>
    </owl:NamedIndividual>
