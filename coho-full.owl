    <!-- http://www.ebi.ac.uk/coho/COHO_0002100 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002100">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. MUV is the PGS Catalog&apos;s id for the BRCA1 and BRCA2 mutation carriers that the Medical University of Vienna (Department of Obstetrics and Gynaecology, General Hospital Vienna) contributed to the Consortium of Investigators of Modifiers of BRCA1/2 (CIMBA, COHO:0000901). CIMBA itself names this study only &apos;General Hospital Vienna&apos; (PMID:28346442 Supplementary Table 1; PMID:32665703 supplement), so it is a centre&apos;s unnamed set of carriers, not a named cohort. It is a site of CIMBA, like OUH and OSUCCG, which the review already marked as not cohorts. Not to be confused with DNMUV (COHO:0001672, Department of Neurology, Medical University of Vienna). Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Medical University of Vienna</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002101 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002101">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000114"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. MXB is the Mexican Biobank (MXBB), the training sample of the PGS Catalog score it is recorded in (PMID:37148359). Replaced by COHO:0000114 (Mexican Biobank), which now carries this term&apos;s names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete MXB</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


