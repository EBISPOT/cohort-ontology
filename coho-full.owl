    <!-- http://www.ebi.ac.uk/coho/COHO_0001645 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001645">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PGS005170</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:28275316</obo:IAO_0000112>
        <obo:IAO_0000115>A Danish population-based cohort of men and women aged 18 to 76, drawn at random from the national registers among people born in Denmark and living in the western part of greater Copenhagen and examined at the Research Centre for Prevention and Health, Glostrup, from 2011 to 2015, set up to study the epidemiology of functional somatic syndromes (such as fibromyalgia, irritable bowel syndrome and chronic fatigue syndrome) and bodily distress syndrome. It merges a follow-up examination of the Health2006 cohort (DanFunD part one, 2011-2012) with a new random sample examined from 2012 to 2015 (DanFunD part two).</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9656</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>DANFUND</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DanFunD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DanFund</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Danfund</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Danish Study of Functional Disorders</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Danish study of functional disorders</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">The Danish study of Functional Disorders</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001645"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33626058+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Data were derived from a random sample of the Danish adult population enrolled in the Danish Study of Functional Disorders (DanFunD; n = 9,656).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001645"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005170</owl:annotatedTarget>
        <dcterms:title>Polygenic score integrating neurodegenerative and vascular risk informs dementia risk stratification.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40042447</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001645"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28275316</owl:annotatedTarget>
        <dcterms:title>Cohort description: The Danish study of Functional Disorders.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28275316</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5333638/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Danish study of Functional Disorders (DanFunD) cohort was initiated to outline the epidemiology of functional somatic syndromes (FSS) and is the first larger coordinated epidemiological study focusing exclusively on FSS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001645"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Danish population-based cohort of men and women aged 18 to 76, drawn at random from the national registers among people born in Denmark and living in the western part of greater Copenhagen and examined at the Research Centre for Prevention and Health, Glostrup, from 2011 to 2015, set up to study the epidemiology of functional somatic syndromes (such as fibromyalgia, irritable bowel syndrome and chronic fatigue syndrome) and bodily distress syndrome. It merges a follow-up examination of the Health2006 cohort (DanFunD part one, 2011-2012) with a new random sample examined from 2012 to 2015 (DanFunD part two).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28275316</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001645"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9656</owl:annotatedTarget>
        <obo:IAO_0000116>participants examined in the combined DanFunD cohort 2011-2015</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5333638/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The cohort comprises a total of 9,656 men and women aged 18–76 years, born in Denmark and living in the western part of the greater Copenhagen.</rdfs:comment>
    </owl:Axiom>
