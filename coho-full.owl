    <!-- http://www.ebi.ac.uk/coho/COHO_0000965 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000965">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid8785"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90011857</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre case-control study of pancreatic ductal adenocarcinoma carried out at centres in Spain, Italy, Sweden, Germany, the United Kingdom and Ireland in 2009-2014 and 2016-2018, which recruited newly diagnosed patients aged 18 and older and, as controls, sex-, age- and area-matched hospital in-patients without cancer whose primary diagnoses were not associated with known risk factors for the disease (population-based controls in Ireland and Sweden), and collected lifestyle, environmental-exposure and medical-history information by in-person interviews.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2009</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1532</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>European Study of Digestive Diseases and Genetics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PanGenEU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PanGenEU Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PanGenEU case-control study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PanGenEU study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">European Study into Digestive Illnesses and Genetics</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid8785">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005184"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8785"/>
        <obo:IAO_0000116>pancreatic ductal adenocarcinoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12663176/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We observed significant differences in the proportion of stage I-II and III-IV PDAC tumors across studies, PanGenEU was the study population with the highest proportion of stage III-IV PDAC tumors and, therefore, more representative of the full spectrum of the disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7849104/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We used the resources from the PanGenEU case-control study conducted in Spain, Italy, Sweden, Germany, UK, and Ireland, between 2009 and 2014 [17, 18].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000965"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90011857</owl:annotatedTarget>
        <dcterms:title>A multilayered post-GWAS assessment on genetic susceptibility to pancreatic cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33517887</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7849104/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We used the resources from the PanGenEU case-control study conducted in Spain, Italy, Sweden, Germany, UK, and Ireland, between 2009 and 2014 [17, 18].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000965"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre case-control study of pancreatic ductal adenocarcinoma carried out at centres in Spain, Italy, Sweden, Germany, the United Kingdom and Ireland in 2009-2014 and 2016-2018, which recruited newly diagnosed patients aged 18 and older and, as controls, sex-, age- and area-matched hospital in-patients without cancer whose primary diagnoses were not associated with known risk factors for the disease (population-based controls in Ireland and Sweden), and collected lifestyle, environmental-exposure and medical-history information by in-person interviews.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33517887</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41315260</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2009</owl:annotatedTarget>
        <obo:IAO_0000116>pancreatic cancer cases and controls recruited (2020 smoking analysis)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:32051190</oboInOwl:hasDbXref>
        <rdfs:comment>Tobacco smoking habits and other relevant information were obtained from 2,009 cases and 1,532 controls recruited in the PanGenEU study using standardized tools.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1532</owl:annotatedTarget>
        <obo:IAO_0000116>pancreatic cancer cases and controls recruited (2020 smoking analysis)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:32051190</oboInOwl:hasDbXref>
        <rdfs:comment>Tobacco smoking habits and other relevant information were obtained from 2,009 cases and 1,532 controls recruited in the PanGenEU study using standardized tools.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000965"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PanGenEU</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
