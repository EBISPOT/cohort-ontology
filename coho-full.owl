    <!-- http://www.ebi.ac.uk/coho/COHO_0002716 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002716">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23014"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001802"/>
        <obo:IAO_0000112>PMID:21990399</obo:IAO_0000112>
        <obo:IAO_0000115>A randomized multicentre trial cohort of patients aged 16–65 years with newly diagnosed, histologically confirmed, advanced-stage Hodgkin lymphoma, enrolled by the German Hodgkin Study Group from January 1999 to January 2003 to compare eight cycles of escalated-dose BEACOPP with four escalated-dose followed by four baseline-dose cycles, and to compare consolidation radiotherapy with no radiotherapy for initial bulky or residual disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1670</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HD12</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HD12 study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HD12 trial of the German Hodgkin Study Group</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">HD12 trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23014">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004952"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002716"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23014"/>
        <obo:IAO_0000116>Hodgkin&apos;s lymphoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30290903+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In HD12 (Jan 4, 1999, to Jan 13, 2003; registered with ClinicalTrials.gov [NCT00265031]), 1670 patients with newly diagnosed, histology-proven, advanced-stage Hodgkin&apos;s lymphoma received eight cycles of eBEACOPP or four cycles of eBEACOPP plus four cycles of bBEACOPP (4 + 4), plus consolidation radiotherapy to initial bulk and residual disease or no radiotherapy, to analyse two non-inferiority objectives.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002716"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21990399</owl:annotatedTarget>
        <dcterms:title>Eight cycles of escalated-dose BEACOPP compared with four cycles of escalated-dose BEACOPP followed by four cycles of baseline-dose BEACOPP with or without radiotherapy in patients with advanced-stage hodgkin&apos;s lymphoma: final analysis of the HD12 trial of the German Hodgkin Study Group.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21990399</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21990399+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Between January 1999 and January 2003, 1,670 patients age 16 to 65 years were enrolled onto the HD12 study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002716"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
