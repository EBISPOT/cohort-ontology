        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002710"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2560/MediaObjects/41588_2013_BFng2560_MOESM4_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>27 STHM1 2,330 2,056 4,386 2,224 2,006 4,230</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90308762</owl:annotatedTarget>
        <dcterms:title>Pan-cancer and cross-population genome-wide association studies dissect shared genetic backgrounds underlying carcinogenesis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37340002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10282036/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We thank the Breast Cancer Association Consortium (BCAC) for breast cancer summary statistics and the Prostate Cancer Association Group to Investigate Cancer Associated Alterations in the Genome (PRACTICAL) consortium for prostate cancer summary statistics.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium of prostate cancer study groups, reported in 2008 as a worldwide consortium of 13 groups, that pools genotype and clinical data from prostate cancer case-control and cohort studies in North America, Europe, Asia and Australia to investigate inherited susceptibility to prostate cancer and its clinical course.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18708398</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4596899/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8381233/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">79194</owl:annotatedTarget>
        <obo:IAO_0000116>prostate cancer cases and controls of European ancestry in the 2018 OncoArray GWAS meta-analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6568012/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a fixed-effects meta-analysis combining the summary statistics from our OncoArray analysis and seven previous PrCa GWAS or high-density SNP panels of European ancestry imputed to the 1KGP The final meta-analysis included 79,194 PrCa cases and 61,112 controls without a known diagnosis of PrCa (Fig. 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">61112</owl:annotatedTarget>
        <obo:IAO_0000116>prostate cancer cases and controls of European ancestry in the 2018 OncoArray GWAS meta-analysis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6568012/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a fixed-effects meta-analysis combining the summary statistics from our OncoArray analysis and seven previous PrCa GWAS or high-density SNP panels of European ancestry imputed to the 1KGP The final meta-analysis included 79,194 PrCa cases and 61,112 controls without a known diagnosis of PrCa (Fig. 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PRACTICAL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000612 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000612">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000481"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South-Eastern_Asia"/>
        <obo:IAO_0000112>PMID:31110091</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of 14,465 Singapore citizens and permanent residents of Chinese, Malay and Indian ethnicity aged 21 years and older, recruited in 2004–2010 mainly from the Singapore Prospective Study Program and the Singapore Cardiovascular Cohort Study, with additional recruitment oversampling Malays and Indians, to study chronic disease in a multi-ethnic Asian population.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MEC also denotes Multiethnic Cohort Study of Diet and Health (COHO:0000121); this term is Singapore Multi-Ethnic Cohort.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">14530</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MEC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Multi-Ethnic Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SingaporeMEC</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Singapore Multi-Ethnic Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000612"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
