    <!-- http://www.ebi.ac.uk/coho/COHO_0001700 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001700">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15237"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000283"/>
        <obo:IAO_0000112>PGS000777</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:33958783</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort set up in 2010 in Lübeck, Germany, in which inhabitants screened by mailed questionnaire were assigned to groups ranging from healthy controls to people with suspected early motor signs of parkinsonism, alongside Parkinson&apos;s disease patients, and selected participants were examined in person and followed up, to investigate the specificity of non-motor symptoms for Parkinson&apos;s disease.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5838</coho:numberOfParticipants>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">EPIPARK</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15237">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001700"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15237"/>
        <obo:IAO_0000116>Parkinson&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23257687+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This cohort was set up in 2010 to investigate the specificity of non-motor symptoms for Parkinson&apos;s disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001700"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23257687+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Using a mailed questionnaire, we screened 5838 inhabitants of Lübeck, Germany, out of a target population of 10 000 citizens, enquiring about motor impairment, pain, quality of life, comorbidities, somatization and demographics.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001700"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000777</owl:annotatedTarget>
        <dcterms:title>Genome-wide survival study identifies a novel synaptic locus and polygenic score for cognitive progression in Parkinson&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33958783</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001700"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33958783</owl:annotatedTarget>
        <dcterms:title>Genome-wide survival study identifies a novel synaptic locus and polygenic score for cognitive progression in Parkinson&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33958783</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8459648/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>To further test the performance of the PHS score in independent patients (that were not previously used to discover and replicate the progression variants, nor to build and optimize the PHS), we analyzed three new independent cohorts (EPIPARK, DeNoPa; HBS2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001700"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort set up in 2010 in Lübeck, Germany, in which inhabitants screened by mailed questionnaire were assigned to groups ranging from healthy controls to people with suspected early motor signs of parkinsonism, alongside Parkinson&apos;s disease patients, and selected participants were examined in person and followed up, to investigate the specificity of non-motor symptoms for Parkinson&apos;s disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23257687</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001700"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5838</owl:annotatedTarget>
        <obo:IAO_0000116>inhabitants of Lübeck screened by mailed questionnaire (the population arm; Parkinson&apos;s disease patients not included)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:23257687</oboInOwl:hasDbXref>
        <rdfs:comment>Using a mailed questionnaire, we screened 5838 inhabitants of Lübeck, Germany, out of a target population of 10 000 citizens, enquiring about motor impairment, pain, quality of life, comorbidities, somatization and demographics.</rdfs:comment>
    </owl:Axiom>
    


