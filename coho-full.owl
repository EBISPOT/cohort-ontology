        <obo:IAO_0000116>atrial fibrillation</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001032.v7.p2</oboInOwl:hasDbXref>
        <rdfs:comment>Patients with AF and family members are prospectively enrolled.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001249"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6123807/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We genotyped novel atrial fibrillation variants in an atrial fibrillation sample set (759 cases and 759 controls) from the Vanderbilt Atrial Fibrillation Registry, a clinical and genetic registry at the Vanderbilt University Medical Center in Nashville, Tennessee.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001249"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90502911</owl:annotatedTarget>
        <dcterms:title>Whole genome sequencing analysis of body mass index identifies novel African ancestry-specific risk allele.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40216759</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11992084/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>NHLBI TOPMed: Vanderbilt Genetic Basis of Atrial Fibrillation (VU_AF)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001249"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A clinical and genetic registry at Vanderbilt University Medical Center in Nashville, Tennessee, United States, founded in 2001, that prospectively enrols patients with atrial fibrillation together with affected and unaffected family members, recording a detailed medical and drug history, an atrial fibrillation symptom severity assessment and a blood sample for DNA, and follows them with serial symptom assessments; its early-onset cases were whole-genome sequenced by the NHLBI TOPMed programme.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30271950</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001032.v7.p2</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
