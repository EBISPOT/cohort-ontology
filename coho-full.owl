        <rdfs:comment>The GRAND study recruited adult participants from 38 cardiac centers across China between May 2017 and April 2019.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001821"/>
