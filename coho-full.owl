        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002051"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004992"/>
        <obo:IAO_0000115>A malignant neoplasm involving the integumental system</obo:IAO_0000115>
        <rdfs:label>integumentary system cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000693 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0000693">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004985"/>
        <obo:IAO_0000115>A bipolar disorder that is characterized by at least one hypomanic episode and at least one major depressive episode; with this disorder, depressive episodes are more frequent and more intense than manic episodes.</obo:IAO_0000115>
        <rdfs:label>bipolar II disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000723 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0000723">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004730"/>
