    <owl:Restriction rdf:nodeID="genid9822">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004975"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001073"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9820"/>
        <obo:IAO_0000116>dementia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-026-02583-1/MediaObjects/41588_2026_2583_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The DietBB sample included in this GWAS is a subsample extracted from the AgeCoDe cohort in the context of an ongoing genome-wide methylation analysis for dementia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001073"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9822"/>
        <obo:IAO_0000116>dementia of the AD-type</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-026-02583-1/MediaObjects/41588_2026_2583_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The DietBB sample included in this GWAS is a subsample extracted from the AgeCoDe cohort in the context of an ongoing genome-wide methylation analysis for dementia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001073"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were recruited in six German cities (Bonn, Dusseldorf, Hamburg, Leipzig, Mannheim, and Munich) with a total of 138 GPs connected to the study sites.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001073"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90704646</owl:annotatedTarget>
        <dcterms:title>Consensus meta-analysis of genome-wide association studies for Alzheimer&apos;s disease and related dementias.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42237039</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The DietBB sample included in this GWAS is a subsample extracted from the AgeCoDe cohort in the context of an ongoing genome-wide methylation analysis for dementia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001073"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A subsample of the German Study on Ageing, Cognition and Dementia in Primary Care Patients (AgeCoDe), a general-practice registry-based longitudinal study of people aged 75 and over recruited in 2002–2003 in six German cities, made up of participants who were free of dementia at baseline and had DNA available and who either developed Alzheimer-type dementia during follow-up or stayed free of dementia, selected for a genome-wide DNA methylation study of dementia and also genotyped genome-wide.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:42237039</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001073"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">120</owl:annotatedTarget>
        <obo:IAO_0000116>AgeCoDe participants selected for DietBB</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-026-02583-1/MediaObjects/41588_2026_2583_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>This criterion led to the selection of 320 participants.</rdfs:comment>
    </owl:Axiom>
