    <!-- http://www.ebi.ac.uk/coho/COHO_0000734 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000734">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid6623"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Mexico"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>GCST90095033</obo:IAO_0000112>
        <obo:IAO_0000112>PGS005201</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control collection of Mexican adults with hypertriglyceridaemia and normotriglyceridaemic controls recruited at the Instituto Nacional de Ciencias Médicas y Nutrición Salvador Zubirán in Mexico City, Mexico, for the first genome-wide association study of lipids in Mexicans.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">4400</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MHC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MexHTG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MexTG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mexican Hypertriglyceridemia cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mexican hypertriglyceridemia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Mexican Hypertriglyceride Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid6623">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005347"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000734"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid6623"/>
        <obo:IAO_0000116>hypertriglyceridemia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3917605/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>It is also worth noting that unlike the study samples of the European GWA consortia that are predominantly from unascertained population-based cohorts or from case-control studies ascertained for a non-lipid trait (e.g. type 2 diabetes), the Mexican GWA study sample was specifically ascertained for hypertriglyceridemia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000734"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Mexico"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3917605/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>All participants were recruited at the Instituto Nacional de Ciencias Médicas y Nutrición Salvador Zubirán (INCMNSZ), Mexico City.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000734"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90095033</owl:annotatedTarget>
        <dcterms:title>Ancestral diversity improves discovery and fine-mapping of genetic loci for anthropometric traits-The Hispanic/Latino Anthropometry Consortium.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35399580</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8990175/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>MHS Mexican Hypertriglyceride Study Case-control Departamento de Endocrinología y Metabolismo of the Instituto Nacional de Ciencias Médicas y Nutrición, Mexico City, Mexico</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000734"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005201</owl:annotatedTarget>
        <dcterms:title>Polygenic prediction of body mass index and obesity through the life course and across ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40691366</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000734"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control collection of Mexican adults with hypertriglyceridaemia and normotriglyceridaemic controls recruited at the Instituto Nacional de Ciencias Médicas y Nutrición Salvador Zubirán in Mexico City, Mexico, for the first genome-wide association study of lipids in Mexicans.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23505323</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
