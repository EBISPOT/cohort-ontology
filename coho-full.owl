    <!-- http://www.ebi.ac.uk/coho/COHO_0001908 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001908">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. IGE-PCV is a research unit of INSERM and the Université de Lorraine in Nancy, with its biobank, which supplied two different samples to the VEGF GWAS of PMID:26910538: an institution, not a cohort. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Interaction Gåne-Environment en Physiopathologie Cardio-Vasculaire</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
