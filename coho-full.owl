        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005010"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001299"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11741"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10164599/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All patients who visited the Division of Cardiology at a university hospital, for a health check-up or due to chest symptoms from January 2001 to August 2009 were included in the CGC cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001299"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11743"/>
        <obo:IAO_0000116>coronary artery disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10164599/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All patients who visited the Division of Cardiology at a university hospital, for a health check-up or due to chest symptoms from January 2001 to August 2009 were included in the CGC cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001299"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10164599/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We selected male participants from two cohorts: The Cardiovascular Genome Center (CGC) cohort and Cardiovascular and Metabolic Disease Etiology Research Center-High Risk (CMERC-HI) cohort at a university, Seoul, Korea.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001299"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90270122</owl:annotatedTarget>
        <dcterms:title>Genetic Variants Associated with Supernormal Coronary Arteries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35793981</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10164599/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All patients who visited the Division of Cardiology at a university hospital, for a health check-up or due to chest symptoms from January 2001 to August 2009 were included in the CGC cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001299"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based registry cohort of the Cardiovascular Genome Center of Yonsei University College of Medicine, enrolling from November 2000 patients who visited the cardiology division of Severance Hospital in Seoul, South Korea, for chest symptoms, cardiovascular risk-factor control or a health check-up, with clinical data collected by trained nurses, blood samples for DNA and, where symptoms warranted, coronary angiography, for genetic research on coronary artery disease and other cardiovascular and metabolic conditions.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24142632</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27736948</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35352885</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35793981</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001299"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8839</owl:annotatedTarget>
        <obo:IAO_0000116>individuals in the CGC cohort screened for a genetic study</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:35793981</oboInOwl:hasDbXref>
        <rdfs:comment>Among 8839 individuals in the CGC cohort, 4425 males received coronary angiography; 7 individuals showing a study-feasible Framingham score but normal coronary arteries were enrolled as supernormal.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001299"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CGC</owl:annotatedTarget>
