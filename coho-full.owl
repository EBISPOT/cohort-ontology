        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000260"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1310</owl:annotatedTarget>
        <obo:IAO_0000116>patients in the flagship DKTK MASTER analysis (2021)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=TITLE:%22Guiding%20Therapeutic%20Decisions%20in%20Patients%20with%20Rare%20Cancers%22&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We analyzed the molecular profiles and clinical outcomes of 1,310 patients (rare cancers, 75.5%) enrolled in a prospective observational study by the German Cancer Consortium that applies whole-genome/exome and RNA sequencing to inform the care of adults with incurable cancers.</rdfs:comment>
    </owl:Axiom>
