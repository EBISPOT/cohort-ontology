        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetics of Latinos Diabetic Retinopathy</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12134">
