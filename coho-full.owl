        <oboInOwl:hasRelatedSynonym>NINFEA cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NINFEA project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NINFEA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nascita e INFanzia gli Effetti dell’Ambiente</oboInOwl:hasRelatedSynonym>
