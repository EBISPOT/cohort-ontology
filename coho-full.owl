        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001264"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international, open-label, randomised phase 3 trial of the Gynecologic Cancer InterGroup, led by the UK Medical Research Council, in which women with newly diagnosed high-risk early-stage or advanced epithelial ovarian, fallopian tube or primary peritoneal cancer were recruited in 2006–2009 at centres in Europe, Canada, Australia and New Zealand and randomised to carboplatin and paclitaxel chemotherapy with or without concurrent and maintenance bevacizumab.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23333117</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26115797</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
