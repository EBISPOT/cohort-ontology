    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002481"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A naturalistic, prospective cohort of people with Alzheimer&apos;s disease and their carers in London and the South East Region of the UK, run from University College London, recruited in 2002-2003 through community mental health teams, memory clinics, care homes, day hospitals and the voluntary sector to be representative of people with Alzheimer&apos;s disease in the community by sex, living setting and severity, and followed for up to 54 months to study the progression, characteristics and costs of the disease and the problems of carers.</owl:annotatedTarget>
