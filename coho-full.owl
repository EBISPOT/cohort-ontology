        <rdfs:comment>The Tasmanian Older Adult Cohort (TASOAC) is a prospective study in southern Tasmania, Australia [19].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002463"/>
