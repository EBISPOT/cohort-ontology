    <!-- http://www.ebi.ac.uk/coho/COHO_0001755 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001755">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15673"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000561"/>
        <obo:IAO_0000112>PGS012590</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:39428694</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based longitudinal cohort study of Alzheimer&apos;s disease and related dementias in South Korea, established in 2013 and run by the GARD Cohort Research Center at Chosun University in Gwangju, whose participants, aged 60 or over, come mainly from local senior citizens&apos; centres in the city of Gwangju, with additional people with Alzheimer&apos;s disease or mild cognitive impairment recruited from Chosun University Hospital and its affiliated hospitals in Gwangju and elsewhere in Korea, and are followed with repeated clinical and neuropsychological evaluation, neuroimaging and biospecimen collection for multi-omics analyses, for early detection and monitoring of dementia.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12877</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GARD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gwangju Alzheimer and Related Dementias Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gwangju Alzheimer&apos; and Related Dementias</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gwangju Alzheimer&apos;s &amp; Related Dementias</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gwangju Alzheimer&apos;s and Related Dementia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Gwangju Alzheimer&apos;s and Related Dementias</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15673">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004975"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001755"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15673"/>
        <obo:IAO_0000116>Alzheimer&apos;s disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12805525/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GARD cohort was established in 2013 as a large‐scale, community‐based prospective study to investigate early risk and protective factors across the AD spectrum.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001755"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11667495/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In brief, the primary GARD sample included individuals living in local senior citizens centers in the southwestern Korean city of Gwangju.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001755"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS012590</owl:annotatedTarget>
        <dcterms:title>A multiancestry polygenic risk score for Alzheimer&apos;s disease is associated with cognitive decline and neuropathological hallmarks in diverse populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42661068</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001755"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39428694</owl:annotatedTarget>
        <dcterms:title>Whole-genome sequencing study in Koreans identifies novel loci for Alzheimer&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39428694</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11667495/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Korean sample included participants of the Gwangju Alzheimer&apos;s and Related Dementias (GARD) Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001755"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based longitudinal cohort study of Alzheimer&apos;s disease and related dementias in South Korea, established in 2013 and run by the GARD Cohort Research Center at Chosun University in Gwangju, whose participants, aged 60 or over, come mainly from local senior citizens&apos; centres in the city of Gwangju, with additional people with Alzheimer&apos;s disease or mild cognitive impairment recruited from Chosun University Hospital and its affiliated hospitals in Gwangju and elsewhere in Korea, and are followed with repeated clinical and neuropsychological evaluation, neuroimaging and biospecimen collection for multi-omics analyses, for early detection and monitoring of dementia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:39428694</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41537461</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001755"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12877</owl:annotatedTarget>
        <obo:IAO_0000116>participants enrolled (from over 17,000 screened)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:41537461</oboInOwl:hasDbXref>
        <rdfs:comment>From over 17,000 screened individuals, 12,877 were enrolled.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001755"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GARD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


