    <!-- http://www.ebi.ac.uk/coho/COHO_0002311 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002311">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19739"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002069"/>
        <obo:IAO_0000112>PMID:37781316</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study of cardiovascular disease in the province of Girona, north-eastern Spain, run by the REGICOR study group of the Hospital del Mar Research Institute, Barcelona. It began as a registry of patients with myocardial infarction in Girona, with data from 1978, and its population cohort, established in 1995 to study the prevalence and control of cardiovascular risk factors, novel risk factors and biomarkers of cardiovascular disease and cardiovascular risk prediction, combines participants of four surveys (1995, 2000, 2005 and 2018) randomly sampled from towns of the province and the city of Girona. Participants were re-examined, followed up for cardiovascular and other events and death, including by linkage to electronic health records, and genotyped, with other omics measured in subsets.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11631</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Girona Heart Register</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REGICOR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REGICOR Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REGICOR cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REGICOR study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REgistre GIroni del COr</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Registre GIroní del COR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Registre Gironi del COR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Registre Gironi del Cor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Registre Gironí del Cor</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Girona Heart Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19739">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002311"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19739"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12231538/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>population cohort was established to study cardiovascular (CV) risk factor prevalence and control, investigate novel risk factors associated with the incidence of CV diseases, and develop CV risk prediction models.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002311"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12231538/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The REGICOR cohort integrates the participants of four population-based surveys conducted in 1995, 2000, 2005, and 2018 in the Girona province (North-Eastern Spain), with a current reference population of approximately 790 000 inhabitants.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002311"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:37781316</owl:annotatedTarget>
        <dcterms:title>Predictive capacity of a genetic risk score for coronary artery disease in assessing recurrences and cardiovascular mortality among patients with myocardial infarction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37781316</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10537937/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the REGICOR Study, follow-up was conducted through data linkage with population-based myocardial infarction records, official mortality registries, and telephone interviews.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002311"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study of cardiovascular disease in the province of Girona, north-eastern Spain, run by the REGICOR study group of the Hospital del Mar Research Institute, Barcelona. It began as a registry of patients with myocardial infarction in Girona, with data from 1978, and its population cohort, established in 1995 to study the prevalence and control of cardiovascular risk factors, novel risk factors and biomarkers of cardiovascular disease and cardiovascular risk prediction, combines participants of four surveys (1995, 2000, 2005 and 2018) randomly sampled from towns of the province and the city of Girona. Participants were re-examined, followed up for cardiovascular and other events and death, including by linkage to electronic health records, and genotyped, with other omics measured in subsets.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16371198</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37781316</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40611603</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:7588921</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002311"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11631</owl:annotatedTarget>
        <obo:IAO_0000116>REGICOR population cohort participants from four surveys, 1995-2018</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12231538/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The REGICOR cohort includes 11 631 individuals (1748 in 1995, 3030 in 2000, 6308 in 2005, and 545 in 2018).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002311"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>REGICOR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002312 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002312">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19746"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001316"/>
        <obo:IAO_0000112>PMID:40101186</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of endometrial cancer in Sweden, whose patients underwent surgery for uterine cancer from 2008 at Karolinska University Hospital, Solna, in Stockholm, to which women of Stockholm County with newly diagnosed uterine cancer are referred, and gave blood and tumour samples, questionnaires on their own risk factors and on cancers in their families, and pedigrees in which cancers in relatives were verified from the Swedish Cancer Registry, medical records or death certificates where possible. Its cases were genotyped in the genome-wide association studies of the Endometrial Cancer Association Consortium.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">520</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>RENDOCAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Registry of Endometrial Cancer in Stockholm</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Registry of Endometrial Cancer in Sweden</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19746">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011962"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002312"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19746"/>
        <obo:IAO_0000116>endometrial cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM301_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Patients (n=520) who underwent surgery for endometrial cancer at Karolinska University hospital Solna, Sweden between 2008 and 2011 were included in the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002312"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM301_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Patients (n=520) who underwent surgery for endometrial cancer at Karolinska University hospital Solna, Sweden between 2008 and 2011 were included in the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002312"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40101186</owl:annotatedTarget>
        <dcterms:title>A Swedish genome-wide haplotype association analysis identifies novel candidate loci associated with endometrial cancer risk.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40101186</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13537468/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients within the first cohort, RENDOCAS (n = 555), underwent surgery for EC at the Karolinska University Hospital between 2008 and 2011 [11].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002312"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of endometrial cancer in Sweden, whose patients underwent surgery for uterine cancer from 2008 at Karolinska University Hospital, Solna, in Stockholm, to which women of Stockholm County with newly diagnosed uterine cancer are referred, and gave blood and tumour samples, questionnaires on their own risk factors and on cancers in their families, and pedigrees in which cancers in relatives were verified from the Swedish Cancer Registry, medical records or death certificates where possible. Its cases were genotyped in the genome-wide association studies of the Endometrial Cancer Association Consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24851142</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27135401</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40101186</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002312"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">520</owl:annotatedTarget>
        <obo:IAO_0000116>RENDOCAS patients operated for endometrial cancer in 2008-2011 in the ECAC profile</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM301_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Patients (n=520) who underwent surgery for endometrial cancer at Karolinska University hospital Solna, Sweden between 2008 and 2011 were included in the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002312"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>RENDOCAS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


