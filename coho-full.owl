        <oboInOwl:hasRelatedSynonym>Ovarian cancer Prognosis And Lifestyle study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ovarian cancer Prognosis and Lifestyle study</oboInOwl:hasRelatedSynonym>
