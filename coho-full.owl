    <!-- http://www.ebi.ac.uk/coho/COHO_0002614 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002614">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>PMID:42241480</obo:IAO_0000112>
        <obo:IAO_0000115>A register-based cohort of all children born in Finland from 1987 onwards, identified from the Finnish Medical Birth Register and linked with other national health, social and population registers and with data on their parents, held by the University of Oulu (earlier by the Finnish Institute for Health and Welfare) to study how preterm birth, pregnancy disorders and other early-life factors predict health, well-being and societal outcomes from childhood to adulthood, and the intergenerational transmission of health.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2100000</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/NORDCAP</oboInOwl:hasDbXref>
