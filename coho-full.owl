        <oboInOwl:hasRelatedSynonym>Total Lung Cancer: Molecular Epidemiology of Lung Cancer Survival</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
