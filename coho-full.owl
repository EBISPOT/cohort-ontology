        <obo:IAO_0000112>PMID:20453842</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective collection of Dutch patients with rheumatoid arthritis meeting the 1987 American College of Rheumatology criteria, recruited from the outpatient rheumatology clinics of the VU University Medical Center, the Jan van Breemen Institute and the Academic Medical Center/University of Amsterdam in the Amsterdam region of the Netherlands, together with healthy blood-donor controls from the same region, which the Genetics Network Rheumatology Amsterdam contributed to genetic studies of rheumatoid arthritis susceptibility and of response to anti-TNF therapy.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">519</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1155</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>GENRA</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Genetics Network Rheumatology Amsterdam</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15973">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008383"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001788"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15973"/>
        <obo:IAO_0000116>rheumatoid arthritis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.479/MediaObjects/41588_2009_BFng479_MOESM310_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Cases were recruited from the outpatient rheumatology clinics of the VU university medical center, the Jan van Breemen institute, and the AMC/University of Amsterdam, all situated in the Amsterdam region in the Netherlands. All cases had RA consistent with 1987 ACR criteria, and only those patients that were CCP positive were used in this study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001788"/>
