        <obo:IAO_0000112>PMID:22961080</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of overweight or obese adults and age- and sex-matched normal-weight controls aged 35–54 years, noninstitutionalized residents of two urban districts of Shanghai, China (Luwan and Zhabei), recruited from November 2007 to January 2008 to investigate the effects of gut microbiota and environmental factors on obesity and related metabolic disorders.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">559</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">500</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1059</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GMOS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Gut Microbiota and Obesity Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16204">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0025502"/>
