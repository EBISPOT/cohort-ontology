    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000549"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4833"/>
        <obo:IAO_0000116>osteoporosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Osteoporotic Fractures in Men Study (MrOS) is a prospective cohort study examining the risk factors for fractures, osteoporosis, and prostate cancer [94,95] in males age 65 or older from six U.S. communities.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000549"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4835"/>
        <obo:IAO_0000116>fractures</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Osteoporotic Fractures in Men Study (MrOS) is a prospective cohort study examining the risk factors for fractures, osteoporosis, and prostate cancer [94,95] in males age 65 or older from six U.S. communities.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000549"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid4837"/>
        <obo:IAO_0000116>prostate cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Osteoporotic Fractures in Men Study (MrOS) is a prospective cohort study examining the risk factors for fractures, osteoporosis, and prostate cancer [94,95] in males age 65 or older from six U.S. communities.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000549"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13269534/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For the MrOS study men were recruited at six US clinical centers in Birmingham, AL; Minneapolis, MN; Palo Alto, CA; the Monongahela Valley near Pittsburgh, PA; Portland, OR; and San Diego, CA</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000549"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90091013</owl:annotatedTarget>
        <dcterms:title>Whole-genome association analyses of sleep-disordered breathing phenotypes in the NHLBI TOPMed program.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34446064</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Osteoporotic Fractures in Men Study (MrOS) is a multi-center cohort study initially designed to examine the risk factors for osteoporosis, fractures, and prostate cancer in older males [28, 29].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000549"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A US prospective multicentre cohort of men aged 65 or older recruited at six clinical centres (Birmingham, Minneapolis, Palo Alto, near Pittsburgh, Portland and San Diego), designed to examine risk factors for osteoporosis, fractures and prostate cancer in older men, with ancillary studies such as MrOS Sleep (2003-2005, in-home polysomnography of 3,135 men).</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13269534/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000549"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5995</owl:annotatedTarget>
        <obo:IAO_0000116>men aged 65 or older enrolled at baseline (2000-2002)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:16084776</oboInOwl:hasDbXref>
        <rdfs:comment>5995 men enrolled with a mean (+/-SD) age of 73.7 (+/-5.9) years, 11% of which were minorities.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000549"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MrOS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
