    <!-- http://www.ebi.ac.uk/coho/COHO_0001469 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001469">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid13282"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>PMID:32066700</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal naturalistic cohort of outpatients with bipolar disorder, launched in 2005 by the Karolinska Institutet and the St. Göran bipolar outpatient clinic (the Affective Center) of Northern Stockholm Psychiatry in Stockholm, Sweden, with a second centre in Gothenburg from 2009, which consecutively enrols patients treated at these clinics, with age- and sex-matched population controls randomly selected by Statistics Sweden. It combines clinical ratings, cognitive testing, blood and cerebrospinal fluid sampling, brain imaging and genetics, with follow-up planned at 7 and 14 years, to identify predictors of long-term outcome in bipolar disorder.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ACSGH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SBP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SGBP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>St G_ran Bipolar Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>St. Göran Project</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">St. Göran Bipolar Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid13282">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004985"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001469"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid13282"/>
        <obo:IAO_0000116>bipolar disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39746340+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The St. Göran Bipolar Project (SBP) is a longitudinal outpatient study investigation aimed at identifying predictive factors associated with long-term outcomes in individuals with bipolar disorder.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001469"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11965871/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>SBP is a collaborative effort between academia and healthcare, enrolling study participants from bipolar outpatient clinics in Stockholm (SBP-S) and Gothenburg (SBP-G), Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001469"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32066700</owl:annotatedTarget>
        <dcterms:title>Genome-wide study of immune biomarkers in cerebrospinal fluid and serum from patients with bipolar disorder and controls.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32066700</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7026056/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects were recruited from a long-term naturalistic study of bipolar disorder, the St. Göran Bipolar Project, at the bipolar outpatient unit at the Northern Stockholm psychiatric clinic in Stockholm, Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001469"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal naturalistic cohort of outpatients with bipolar disorder, launched in 2005 by the Karolinska Institutet and the St. Göran bipolar outpatient clinic (the Affective Center) of Northern Stockholm Psychiatry in Stockholm, Sweden, with a second centre in Gothenburg from 2009, which consecutively enrols patients treated at these clinics, with age- and sex-matched population controls randomly selected by Statistics Sweden. It combines clinical ratings, cognitive testing, blood and cerebrospinal fluid sampling, brain imaging and genetics, with follow-up planned at 7 and 14 years, to identify predictors of long-term outcome in bipolar disorder.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28072414</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28468681</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39746340</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
