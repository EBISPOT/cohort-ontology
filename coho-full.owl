    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000904"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid8253"/>
        <obo:IAO_0000116>schizophrenia spectrum disorder</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8989876/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were included if they: (1) were aged 18 years or older, (2) had a primary diagnosis of schizophrenia spectrum disorder (SSD), and (3) were using clozapine (no minimum duration of treatment).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000904"/>
