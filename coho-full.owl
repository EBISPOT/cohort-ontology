        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001000923</oboInOwl:hasDbXref>
        <rdfs:comment>have been recruited through primary care with the involvement of UKPrimary Care Research Networks (PCRNs)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000336"/>
