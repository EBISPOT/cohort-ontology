        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000219"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A project that assembles and sequences cohorts of patients with distinct blood cancers, including blastic plasmacytoid dendritic cell neoplasm, high-grade B-cell lymphoma and T lymphoblastic leukaemia/lymphoma, to build a genomic atlas of haematological malignancies.</owl:annotatedTarget>
        <obo:IAO_0000119>https://ega-archive.org/studies/EGAS50000001346</obo:IAO_0000119>
