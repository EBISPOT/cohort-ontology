    <!-- http://www.ebi.ac.uk/coho/COHO_0001434 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001434">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid12990"/>
        <rdf:type rdf:nodeID="genid12992"/>
        <rdf:type rdf:nodeID="genid12994"/>
        <rdf:type rdf:nodeID="genid12996"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90455651</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of contralateral breast cancer, designed to examine the joint roles of radiation exposure and genetic susceptibility, in which women diagnosed before age 55 with a first primary invasive breast cancer who later developed contralateral breast cancer were individually matched to women with unilateral breast cancer. Participants were identified through population-based cancer registries in the United States, Canada and Denmark and recruited in two phases, WECARE I (2001–2004) and WECARE II (2009–2012).</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1521</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2212</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>WECARE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WECARE Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Women&apos;s Environment, Cancer, and Radiation Epidemiology Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Women&apos;s Environmental Cancer and Radiation Epidemiology Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid12990">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid12992">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid12994">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0000001"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid12996">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_2000079"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12990"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27400983+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The population-based WECARE Study included 1521 cases with CBC and 2212 age- and year of first diagnosis-matched controls with unilateral breast cancer recruited during two phases in the USA, Canada, and Denmark.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12992"/>
        <obo:IAO_0000116>contralateral breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27400983+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The population-based WECARE Study included 1521 cases with CBC and 2212 age- and year of first diagnosis-matched controls with unilateral breast cancer recruited during two phases in the USA, Canada, and Denmark.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12994"/>
        <obo:IAO_0000116>radiation exposure</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15084244+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To examine the joint roles of radiation exposure and genetic susceptibility in the etiology of breast cancer, we designed a case-control study nested within five population-based cancer registries.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid12996"/>
        <obo:IAO_0000116>radiation absorbed dose to the contralateral breast after radiation therapy</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15084244+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To examine the joint roles of radiation exposure and genetic susceptibility in the etiology of breast cancer, we designed a case-control study nested within five population-based cancer registries.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4940926/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All participants were identified through eight population-based cancer registries: six in the USA, one in Canada and one in Denmark (Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC400669/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All study subjects were identified, recruited, and interviewed through five population-based cancer registries, four in the USA (three Surveillance, Epidemiology and End Results registries, namely Iowa, Los Angeles County [CA], and Seattle [WA], and the Cancer Surveillance Program of Orange County [CA]) and one in Denmark (the Danish Cancer Registry).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90455651</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study of contralateral breast cancer in the Women&apos;s Environmental Cancer and Radiation Epidemiology Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38263039</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10807183/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a genome-wide association analysis in the Women’s Environmental Cancer and Radiation Epidemiology (WECARE) Study of women with first breast cancer diagnosed at age &lt; 55 years including 1161 with CBC who served as cases and 1668 with unilateral breast cancer (UBC) who served as controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of contralateral breast cancer, designed to examine the joint roles of radiation exposure and genetic susceptibility, in which women diagnosed before age 55 with a first primary invasive breast cancer who later developed contralateral breast cancer were individually matched to women with unilateral breast cancer. Participants were identified through population-based cancer registries in the United States, Canada and Denmark and recruited in two phases, WECARE I (2001–2004) and WECARE II (2009–2012).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15084244</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27400983</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1521</owl:annotatedTarget>
        <obo:IAO_0000116>CBC cases and UBC controls who completed interview and biospecimen, WECARE I and II</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4940926/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The population-based WECARE Study included 1521 cases with CBC and 2212 age- and year of first diagnosis-matched controls with unilateral breast cancer recruited during two phases in the USA, Canada, and Denmark.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2212</owl:annotatedTarget>
        <obo:IAO_0000116>CBC cases and UBC controls who completed interview and biospecimen, WECARE I and II</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4940926/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The population-based WECARE Study included 1521 cases with CBC and 2212 age- and year of first diagnosis-matched controls with unilateral breast cancer recruited during two phases in the USA, Canada, and Denmark.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>WECARE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


