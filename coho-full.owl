        <obo:IAO_0000115>A hypersensitivity reaction type II disease that involves the exocrine system.</obo:IAO_0000115>
        <rdfs:label>autoimmune disorder of exocrine system</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000588 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0000588">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004335"/>
