        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:21696813</obo:IAO_0000112>
        <obo:IAO_0000115>A UK family-based collection of white families recruited from the Southampton area, each with at least two biological siblings aged 5 to 21 years with a current physician&apos;s diagnosis of asthma who were taking asthma medication regularly, originally recruited in collaboration with Genome Therapeutics Corporation and Schering-Plough for the study that identified ADAM33 as an asthma gene, and later used to test asthma genetic associations by transmission disequilibrium tests.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1481</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Wessex</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Wessex Family Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Wessex Family-Based Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Wessex family study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21580">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002562"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21580"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3185108/</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the Wessex population consisted of families with at least two biologic siblings with a current physician’s diagnosis of asthma.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002562"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3185108/</oboInOwl:hasDbXref>
        <rdfs:comment>Isle of Wight 1989–1990 Birth Cohort (IOW) Wessex family study Childhood Asthma Management Program (CAMP) Childhood Asthma Research and Education (CARE) Genetics of Asthma in Latino Americans (GALA) Mexico Childhood Asthma Study International Consortium for SLE Genetics (SLEGEN) Wellcome Trust Case Control Consortium (WTCCC) Location UK UK</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002562"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21696813</owl:annotatedTarget>
        <dcterms:title>Identification of ATPAF1 as a novel candidate gene for asthma in children.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21696813</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3185108/</oboInOwl:hasDbXref>
        <rdfs:comment>Transmission disequilibrium tests (TDT) in the Wessex replication population confirmed the association of rs2275380 with asthma diagnosis (Table II).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002562"/>
