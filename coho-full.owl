        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001185 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001185">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid10780"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000854"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002709"/>
        <obo:IAO_0000112>GCST90090980</obo:IAO_0000112>
        <obo:IAO_0000115>The breast cancer arm of the Hwasun Cancer Epidemiology Study, a hospital-based case-control study at Chonnam National University Hwasun Hospital, a cancer hospital in Jeollanam-do province, South Korea, that aims to identify factors in cancer development and clinical progression in a Korean population. Its cases are women newly diagnosed with breast cancer at the hospital from April 2004 to February 2013, excluding secondary or recurrent tumours, and its controls are women with no previous cancer drawn at random from the Namwon Study and the Dong-gu Study, community-based cohorts in South Korea.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3387</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3186</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6573</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HCES-Br</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hwasun Cancer Epidemiology Study-Breast</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10780">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0007254"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001185"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid10780"/>
        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7057957/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Included in this project were 3,387 female breast 94 cancer cases, who were newly diagnosed between April 2004 and February 2013 at 95 Chonnam National University Hwasun Hospital, a cancer specified hospital in 96 Jeollanam-do province, South Korea.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001185"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7057957/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Included in this project were 3,387 female breast 94 cancer cases, who were newly diagnosed between April 2004 and February 2013 at 95 Chonnam National University Hwasun Hospital, a cancer specified hospital in 96 Jeollanam-do province, South Korea.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001185"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002709"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-020-15046-w/MediaObjects/41467_2020_15046_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Hwasun Cancer Epidemiology Study (HCES-Br) is a hospital-based case-control 92 study whose goal is to identify factors of the cancer development and clinical 93 progression in a Korean population.6,7 Included in this project were 3,387 female breast 94 cancer cases, who were newly diagnosed between April 2004 and February 2013 at 95 Chonnam National University Hwasun Hospital, a cancer specified hospital in 96 Jeollanam-do province, South Korea.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90090980</owl:annotatedTarget>
        <dcterms:title>Identification of novel breast cancer susceptibility loci in meta-analyses conducted among Asian and European descendants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32139696</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7057957/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Hwasun Cancer Epidemiology Study (HCES-Br) is a hospital-based case-control 92 study whose goal is to identify factors of the cancer development and clinical 93 progression in a Korean population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The breast cancer arm of the Hwasun Cancer Epidemiology Study, a hospital-based case-control study at Chonnam National University Hwasun Hospital, a cancer hospital in Jeollanam-do province, South Korea, that aims to identify factors in cancer development and clinical progression in a Korean population. Its cases are women newly diagnosed with breast cancer at the hospital from April 2004 to February 2013, excluding secondary or recurrent tumours, and its controls are women with no previous cancer drawn at random from the Namwon Study and the Dong-gu Study, community-based cohorts in South Korea.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32139696</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001185"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3387</owl:annotatedTarget>
        <obo:IAO_0000116>breast cancer cases and controls in HCES-Br (2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4127632/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Korean participants came from five studies: the Seoul Breast Cancer Study (SeBCS) (n = 6,179), the Hwasun Cancer Epidemiology Study-Breast (HCES-Br) (n = 6,573), the Korea Genome Epidemiology Study (KoGES; n = 3,209), the Korean Hereditary Breast Cancer study (KOHBRA; n = 1,397), and the Korean National Cancer Center (n = 1,009).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001185"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3186</owl:annotatedTarget>
        <obo:IAO_0000116>breast cancer cases and controls in HCES-Br (2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4127632/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Korean participants came from five studies: the Seoul Breast Cancer Study (SeBCS) (n = 6,179), the Hwasun Cancer Epidemiology Study-Breast (HCES-Br) (n = 6,573), the Korea Genome Epidemiology Study (KoGES; n = 3,209), the Korean Hereditary Breast Cancer study (KOHBRA; n = 1,397), and the Korean National Cancer Center (n = 1,009).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001185"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">6573</owl:annotatedTarget>
        <obo:IAO_0000116>breast cancer cases and controls in HCES-Br (2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4127632/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Korean participants came from five studies: the Seoul Breast Cancer Study (SeBCS) (n = 6,179), the Hwasun Cancer Epidemiology Study-Breast (HCES-Br) (n = 6,573), the Korea Genome Epidemiology Study (KoGES; n = 3,209), the Korean Hereditary Breast Cancer study (KOHBRA; n = 1,397), and the Korean National Cancer Center (n = 1,009).</rdfs:comment>
