        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002713"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25174022</owl:annotatedTarget>
        <dcterms:title>Rationale and Design of the International Lymphoma Epidemiology Consortium (InterLymph) Non-Hodgkin Lymphoma Subtypes Project.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25174022</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4155460/</oboInOwl:hasDbXref>
        <rdfs:comment>The International Lymphoma Epidemiology Consortium therefore undertook the NHL Subtypes Project, an international collaborative effort to investigate the etiologies of NHL subtypes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002713"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium that facilitates collaboration among epidemiologic studies of lymphoma and pools individual-level data from lymphoid malignancy case-control studies to investigate lymphoma etiology and subtype-specific risk factors, including associations with rare exposures and less common lymphoma subtypes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17185468</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25174022</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26340796</obo:IAO_0000119>
        <dcterms:contributor>GPT-6 (OpenAI), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002713"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">17471</owl:annotatedTarget>
        <obo:IAO_0000116>Cases and controls in the InterLymph NHL Subtypes Project pooled dataset from 20 case-control studies, reported in the 2014 design paper; not total consortium enrollment.</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4155460/</oboInOwl:hasDbXref>
        <rdfs:comment>We pooled individual-level data from 20 case-control studies (17471 NHL cases, 23096 controls) from North America, Europe, and Australia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002713"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23096</owl:annotatedTarget>
        <obo:IAO_0000116>Cases and controls in the InterLymph NHL Subtypes Project pooled dataset from 20 case-control studies, reported in the 2014 design paper; not total consortium enrollment.</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC4155460/</oboInOwl:hasDbXref>
        <rdfs:comment>We pooled individual-level data from 20 case-control studies (17471 NHL cases, 23096 controls) from North America, Europe, and Australia.</rdfs:comment>
    </owl:Axiom>
