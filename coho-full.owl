    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002539 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002539">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. VARI is the PGS Catalog&apos;s id for a case series in the renal cell carcinoma GWAS of PMID:28598434. It holds about 1,050 kidney cancer patients treated at Spectrum Health Hospital in Grand Rapids, Michigan, and at hospitals of the Cooperative Human Tissue Network, with germline DNA extracted from normal kidney tissue next to the tumour. The supplement calls it only a &apos;Van Andel Research Institute Case series&apos; (E1193.7), with no study name, recruitment period or design beyond that. Not a cohort. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Van Andel Research Institute</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002540 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002540">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid21424"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:22055160</obo:IAO_0000112>
        <obo:IAO_0000115>A single-centre randomised controlled trial of screening for abdominal aortic aneurysm in Viborg County, Denmark, which randomised all men born in 1921–29 who lived in the county in 1994, and those who turned 65 in 1995–98, either to an invitation to abdominal ultrasound screening or to a control group; men found to have an aneurysm of 30–49 mm were offered annual surveillance.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12639</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>VCAAA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Viborg Country AAA screening program</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Viborg Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Viborg study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Viborg Aneurysm Screening Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid21424">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005350"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002540"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid21424"/>
        <obo:IAO_0000116>abdominal aortic aneurysm</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC555873/</oboInOwl:hasDbXref>
        <rdfs:comment>Consequently, we carried out a randomised controlled trial to determine whether screening Danish men aged 64-73 for abdominal aortic aneurysms reduces mortality.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002540"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC555873/</oboInOwl:hasDbXref>
        <rdfs:comment>In 1994 we randomised all men born during 1921-9 who lived in Viborg County, Denmark.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002540"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22055160</owl:annotatedTarget>
        <dcterms:title>Abdominal aortic aneurysm is associated with a variant in low-density lipoprotein receptor-related protein 1.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22055160</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3213391/</oboInOwl:hasDbXref>
        <rdfs:comment>A follow-up study of SNPs demonstrating association with AAA in the replication studies was performed in independent samples (11,090 controls and 1491 AAA) from the Copenhagen City Heart Study and the Viborg Country AAA screening program and samples collected by two of the contributing centers during the conduct of the discovery and replication studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002540"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A single-centre randomised controlled trial of screening for abdominal aortic aneurysm in Viborg County, Denmark, which randomised all men born in 1921–29 who lived in the county in 1994, and those who turned 65 in 1995–98, either to an invitation to abdominal ultrasound screening or to a control group; men found to have an aneurysm of 30–49 mm were offered annual surveillance.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15757960</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32158272</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002540"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12639</owl:annotatedTarget>
        <obo:IAO_0000116>men randomised to invitation to screening (6333) or to the control group (6306), 1994-1998</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC555873/</oboInOwl:hasDbXref>
        <rdfs:comment>We randomised all 12 639 men aged 64-73 (mean age 67.7 years) living in Viborg County, Denmark (fig 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002540"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>VCAAA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002541 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002541">
