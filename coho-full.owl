        <obo:IAO_0000112>PGS000733</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:26387087</obo:IAO_0000112>
        <obo:IAO_0000115>A prostate cancer case-control study from Utah, United States, and part of the PRACTICAL consortium. Its cases are prostate cancer cases sampled from extended Utah high-risk pedigrees, chosen so that no two are closely related. Its controls come from other high-risk pedigree studies and have no cancer, no link to a prostate cancer kindred and no first-degree relative with prostate cancer.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym UTAH also denotes Utah Chronic Lymphocytic Leukemia Study (COHO:0002531); this term is UTAH Study.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">455</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">256</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>The Utah Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UTAH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UTAHSTUD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">UTAH Study</rdfs:label>
    </owl:NamedIndividual>
