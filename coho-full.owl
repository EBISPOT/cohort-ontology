        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005184"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002738"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23274"/>
        <obo:IAO_0000116>pancreatic ductal adenocarcinoma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10842852/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Pancreatic tumor tissues from resected PDAC patients were collected at the University of Maryland Medical System (UMMS) in Baltimore, MD, through an NCI-UMD resource contract and at the University Medical Center Göttingen, Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002738"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10842852/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Pancreatic tumor tissues from resected PDAC patients were collected at the University of Maryland Medical System (UMMS) in Baltimore, MD, through an NCI-UMD resource contract and at the University Medical Center Göttingen, Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002738"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS9418</owl:annotatedTarget>
        <dcterms:title>ELAPOR1 induces the classical/progenitor subtype and contributes to reduced disease aggressiveness through metabolic reprogramming in pancreatic cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38630934</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS9418</oboInOwl:hasDbXref>
        <rdfs:comment>Using our integrated approach, we identified endosome-lysosome associated apoptosis and autophagy regulator 1 (ELAPOR1/KIAA1324) as a candidate tumor suppressor in both our NCI-UMD-German cohort and additional validation cohorts.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002738"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
