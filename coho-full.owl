        <oboInOwl:hasRelatedSynonym>Generation 21</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Generation XXI birth cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Geração 21</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Geração XXI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Generation XXI</rdfs:label>
