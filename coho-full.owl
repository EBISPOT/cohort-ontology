    <!-- http://www.ebi.ac.uk/coho/COHO_0002001 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002001">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000532"/>
        <obo:IAO_0000112>PGS000822</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:42675291</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective longitudinal cohort study of children and adolescents in the city of Leipzig, Germany, run since July 2011 by the Leipzig Research Centre for Civilization Diseases (LIFE) at Leipzig University, made up of a birth cohort recruited in pregnancy, a health cohort and an obesity cohort, whose participants have repeated medical, psychological and sociodemographic assessments and give biological samples from fetal life to adulthood, to monitor normal growth, development and health and to study non-communicable diseases such as childhood obesity, atopy and mental health problems.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>LIFE Child</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LIFE Child study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LIFE-Child</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Leipzig Research Centre for Civilization Diseases (LIFE) Child Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">LIFE Child Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002001"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13410585/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>LIFE Child is a pediatric cohort study conducted in the city of Leipzig, Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000822</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analyses and fine-mapping elucidate pathways influencing albuminuria.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31511532</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42675291</owl:annotatedTarget>
        <dcterms:title>High prevalence of magnesium supplementation during pregnancy: results from the LIFE Child study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42675291</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13529859/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The LIFE Child Study (Leipzig, Germany) recruited pregnant women and collected data in the 24th and 36th week of pregnancy from 2011 to 2019.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective longitudinal cohort study of children and adolescents in the city of Leipzig, Germany, run since July 2011 by the Leipzig Research Centre for Civilization Diseases (LIFE) at Leipzig University, made up of a birth cohort recruited in pregnancy, a health cohort and an obesity cohort, whose participants have repeated medical, psychological and sociodemographic assessments and give biological samples from fetal life to adulthood, to monitor normal growth, development and health and to study non-communicable diseases such as childhood obesity, atopy and mental health problems.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28144813</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3533937/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002001"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3000</owl:annotatedTarget>
        <obo:IAO_0000116>children who had taken part by the end of 2015 (stated as a lower bound, &apos;more than 3000&apos;)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28144813+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Due to the high popularity of the study, more than 3000 children have already participated until the end of 2015, and two-thirds of them participate continuously.</rdfs:comment>
    </owl:Axiom>
