    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001197">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
        <obo:IAO_0000115>An abnormality of the fetus or the birth of the fetus, excluding structural abnormalities.</obo:IAO_0000115>
        <rdfs:label>Abnormality of prenatal development or birth</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001268 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001268">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100543"/>
        <obo:IAO_0000115>Loss of previously present mental abilities, generally in adults.</obo:IAO_0000115>
        <rdfs:label>Mental deterioration</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001297 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001297">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0100659"/>
        <obo:IAO_0000115>Sudden impairment of blood flow to a part of the brain due to occlusion or rupture of an artery to the brain.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Cerebrovascular accidents</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Stroke</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001298 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001298">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0012638"/>
        <obo:IAO_0000115>Encephalopathy is a term that means brain disease, damage, or malfunction. In general, encephalopathy is manifested by an altered mental state.</obo:IAO_0000115>
        <rdfs:label>Encephalopathy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001438 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001438">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0025031"/>
        <obo:IAO_0000115>A structural abnormality of the abdomen (&apos;belly&apos;), that is, the part of the body between the pelvis and the thorax.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Abdomen abnormality</oboInOwl:hasRelatedSynonym>
        <rdfs:label>Abnormal abdomen morphology</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/HP_0001438"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Abdomen abnormality</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/hp#layperson"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/HP_0001507 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/HP_0001507">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/HP_0000118"/>
