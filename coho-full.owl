    <!-- http://www.ebi.ac.uk/coho/COHO_0001622 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001622">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14623"/>
        <rdf:type rdf:nodeID="genid14625"/>
        <rdf:type rdf:nodeID="genid14627"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000058"/>
        <obo:IAO_0000112>PMID:23349703</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of male heavy smokers (at least 20 pack-years) aged 50–75, participants of the Dutch-Belgian NELSON lung cancer screening trial recruited by the University Medical Centers of Groningen and Utrecht in the Netherlands, with spirometry, low-dose chest CT and blood DNA and RNA. It was assembled and genotyped genome-wide as the discovery cohort of the European Union FP7 project COPACETIC, begun in 2008 under the coordination of UMC Utrecht, to find genetic determinants of susceptibility to COPD and emphysema in smokers, and its lung function was measured again after about three years.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3784</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>COPACETIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COPACETIC cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COPD Pathology: Addressing Critical gaps, Early Treatment and Innovative Concepts</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COPD Pathology: Adressing Critical gaps, Early Treatment &amp; diagnosis and Innovative Concepts</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">COPD Pathology: Addressing Critical gaps, Early Treatment &amp; diagnosis and Innovative Concepts</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14623">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004849"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid14625">
