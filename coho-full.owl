    <!-- http://www.ebi.ac.uk/coho/COHO_0000601 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000601">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid5370"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000610"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000773"/>
        <obo:IAO_0000112>GCST90053837</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based registry of colorectal cancer patients in the Canadian province of Newfoundland and Labrador, run from Memorial University of Newfoundland, that in 1999–2003 recruited about 750 patients diagnosed under the age of 75 to study the genetic and familial factors behind the province&apos;s high colorectal cancer incidence and has followed them for recurrence and survival for up to 19 years. For a population-based case-control study, controls frequency-matched to the cases by age group and sex were selected from the province&apos;s residents by random digit dialling.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">730</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NFCCR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Newfoundland Case-Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Newfoundland Familial Colon Cancer Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Newfoundland Familial Colorectal Cancer Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Newfoundland Familial Colorectal Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Newfoundland Colorectal Cancer Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid5370">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005575"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000601"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid5370"/>
        <obo:IAO_0000116>colorectal cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17039269+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In order to investigate the factors, especially genetic components, responsible for CRC we established the Newfoundland Colorectal Cancer Registry.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000601"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8637572/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this study, we examined 505 and 495 Caucasian patients from Newfoundland, Canada, in the SNP and CNV analysis parts, respectively.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000601"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90053837</owl:annotatedTarget>
        <dcterms:title>A comprehensive analysis of SNPs and CNVs identifies novel markers associated with disease outcomes in colorectal cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34309201</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8637572/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients in the Newfoundland Colorectal Cancer Registry (NFCCR) cohort were diagnosed between 1999 and 2003</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000601"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based registry of colorectal cancer patients in the Canadian province of Newfoundland and Labrador, run from Memorial University of Newfoundland, that in 1999–2003 recruited about 750 patients diagnosed under the age of 75 to study the genetic and familial factors behind the province&apos;s high colorectal cancer incidence and has followed them for recurrence and survival for up to 19 years. For a population-based case-control study, controls frequency-matched to the cases by age group and sex were selected from the province&apos;s residents by random digit dialling.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17039269</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21033532</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4393623/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8637572/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000601"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">730</owl:annotatedTarget>
        <obo:IAO_0000116>consenting colorectal cancer cases diagnosed under 75 in a 5-year period (1999-2003)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:17039269</oboInOwl:hasDbXref>
        <rdfs:comment>In a 5-year period we examined every case of CRC diagnosed under the age of 75 years and obtained consent from 730 cases.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000601"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NFCCR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000602 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000602">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
