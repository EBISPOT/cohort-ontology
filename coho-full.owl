    <!-- http://www.ebi.ac.uk/coho/COHO_0002655 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002655">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Chile"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002701"/>
        <obo:IAO_0000112>PMID:39343441</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of adults aged 38 to 74 years living in the agricultural county of Molina, in the Maule Region of central Chile, identified through a household census and enrolled from December 2014 by the Advanced Center for Chronic Diseases (ACCDiS) of the Universidad de Chile and the Pontificia Universidad Católica de Chile, with questionnaires, physical examinations, ultrasound and a biobank of blood, urine and saliva, and followed with repeat visits and surveillance of hospital events to study the natural history and environmental, lifestyle and social determinants of chronic diseases such as cardiometabolic diseases and cancer.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9462</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/MAUCO</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>MAUCO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MAUCO cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Maule Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Maule cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#IHCC_subset"/>
        <rdfs:label xml:lang="en">Maule Cohort</rdfs:label>
        <rdfs:seeAlso rdf:resource="https://www.mauco.org/"/>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002655"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Chile"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4743396/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Maule Cohort (MAUCO), a Chilean cohort study, seeks to analyze the natural history of chronic diseases in the agricultural county of Molina (40,000 inhabitants) in the Maule Region, Chile.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002655"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39343441</owl:annotatedTarget>
        <dcterms:title>Sex disparities in gallstone disease: insights from the MAUCO prospective population-based cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39343441</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11440185/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>8948 MAUCO participants (aged 38–74 years) underwent abdominal ultrasound at baseline (2015–2019); 4385 received follow-up ultrasound at years 2 or 4.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002655"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort of adults aged 38 to 74 years living in the agricultural county of Molina, in the Maule Region of central Chile, identified through a household census and enrolled from December 2014 by the Advanced Center for Chronic Diseases (ACCDiS) of the Universidad de Chile and the Pontificia Universidad Católica de Chile, with questionnaires, physical examinations, ultrasound and a biobank of blood, urine and saliva, and followed with repeat visits and surveillance of hospital events to study the natural history and environmental, lifestyle and social determinants of chronic diseases such as cardiometabolic diseases and cancer.</owl:annotatedTarget>
        <obo:IAO_0000119> https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/MAUCO</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26847446 </obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002655"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9462</owl:annotatedTarget>
        <obo:IAO_0000116>adults recruited 2014-2020</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/MAUCO</oboInOwl:hasDbXref>
        <rdfs:comment>The study recruited 9,462 adults aged 35–74 years between 2014 and 2020.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002655"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MAUCO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002656 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002656">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Colombia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>PMID:31607766</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cross-sectional national survey of community-dwelling adults aged 60 years and over in urban and rural areas of Colombia, carried out in 2015 for the Colombian Ministry of Health and Social Protection by the University of Caldas and the Universidad del Valle with the design of the Latin American and Caribbean Survey on Health, Well-Being, and Aging (SABE), to study health, active ageing and the social determinants of health inequities in older people.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23694</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SABE</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>SABE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SABE (Health, Wellbeing, and Aging) Colombia project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SABE Colombia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SABE Colombia 2015</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SABE-2015 Colombia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Survey on Health, Well-Being, and Aging in Colombia</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002656"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Colombia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5124445/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This is a cross-sectional study of community-dwelling elderly individuals living in urban and rural areas of Colombia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002656"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:31607766</owl:annotatedTarget>
        <dcterms:title>Frailty in older adults and their association with social determinants of Health. The SABE Colombia Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31607766</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31607766+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The SABE (Health, Wellbeing, and Aging) Colombia project is a cross-sectional study, carried out in 2014-2015, involving 24,553 men and women aged 60 years and older who live in the community in Colombia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002656"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cross-sectional national survey of community-dwelling adults aged 60 years and over in urban and rural areas of Colombia, carried out in 2015 for the Colombian Ministry of Health and Social Protection by the University of Caldas and the Universidad del Valle with the design of the Latin American and Caribbean Survey on Health, Well-Being, and Aging (SABE), to study health, active ageing and the social determinants of health inequities in older people.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27956896</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31607769</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002656"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">23694</owl:annotatedTarget>
        <obo:IAO_0000116>older adults surveyed (effective surveys) in 244 municipalities (2015)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:31607769</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 36,153 older adults were found, of these 23,694 surveys were carried out, for a percentage of national effective response of 66% in 244 municipalities (Table 2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002656"/>
