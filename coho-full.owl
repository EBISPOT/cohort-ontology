        <obo:IAO_0000112>EGAS00001003741</obo:IAO_0000112>
        <obo:IAO_0000115>A study cohort of healthy donors, a patient with IL10RA deficiency and children with severe paediatric inflammatory bowel disease at Erasmus MC, whose monocyte-derived dendritic cells and blood mononuclear cells were profiled by RNA sequencing to investigate IL-10 control of T-cell responses.</obo:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <rdfs:label xml:lang="en">EMC-DC-IL10R study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid2466">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005265"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid2468">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0013153"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000246"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2466"/>
        <obo:IAO_0000116>inflammatory bowel disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001003741</oboInOwl:hasDbXref>
        <rdfs:comment>Using monocyte derived dendritic cells from a patient with an IL10RA deficiency or moDC and PBMC from patients with severe Pediatric Inflammatory Bowel disease we demonstrate that IL-10 signaling in moDCs, but not T cells, is essential for controlling IFNg-secreting CD4+ T cells.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000246"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2468"/>
        <obo:IAO_0000116>IL10RA deficiency</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001003741</oboInOwl:hasDbXref>
        <rdfs:comment>Using monocyte derived dendritic cells from a patient with an IL10RA deficiency or moDC and PBMC from patients with severe Pediatric Inflammatory Bowel disease we demonstrate that IL-10 signaling in moDCs, but not T cells, is essential for controlling IFNg-secreting CD4+ T cells.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000246"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS00001003741</owl:annotatedTarget>
        <dcterms:title>EMC-DC-IL10R study: RNASeq analysis of moDC and PBMC from healthy human donors and pediatric IBD patients</dcterms:title>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000246"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study cohort of healthy donors, a patient with IL10RA deficiency and children with severe paediatric inflammatory bowel disease at Erasmus MC, whose monocyte-derived dendritic cells and blood mononuclear cells were profiled by RNA sequencing to investigate IL-10 control of T-cell responses.</owl:annotatedTarget>
