        <oboInOwl:hasRelatedSynonym>Korean Childhood</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Korean Children-Adolescents Cohort Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Korean Children-Adolescents Study</rdfs:label>
    </owl:NamedIndividual>
