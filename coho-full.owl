        <rdfs:comment>The study included 856 female twins from the TwinsUK registry [27,55] who participated in the MuTHER study [52].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000307"/>
