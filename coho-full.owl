        <oboInOwl:hasRelatedSynonym>Asthma, Occupational</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Asthmas, Occupational</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Industrial asthma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Occupational Asthmas</oboInOwl:hasRelatedSynonym>
