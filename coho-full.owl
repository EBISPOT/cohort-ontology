    <!-- http://www.ebi.ac.uk/coho/COHO_0001828 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001828">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001809"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-27. GSICSS is the Stroke Genetics Network&apos;s Glasgow ImmunoChip Study (PMID:26708676), the Glasgow ischaemic stroke sample with the same cases and controls as the Glasgow Stroke Sample. Replaced by COHO:0001809 (Glasgow Stroke Sample), which now carries this term&apos;s names. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Glasgow, Scotland ImmunoChip Study Samples</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001829 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001829">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:27754483</obo:IAO_0000112>
        <obo:IAO_0000115>A neuroimaging genetics study of clinically normal participants, mostly young adults aged 18 to 35, recruited from the Boston community, United States, in 2008–2012 through ongoing research studies at Harvard University and Massachusetts General Hospital that shared a common acquisition protocol, who underwent structural and functional magnetic resonance imaging, gave saliva for DNA and completed demographic, health, behavioural, cognitive and personality assessments, to link individual differences in brain structure and function to behaviour and genetic variation.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>GSP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Harvard/MGH Brain Genomics Superstruct Project</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Brain Genomics Superstruct Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001829"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4493828/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Between 2008 and 2012 young adults (ages 18 to 35) with normal or corrected-to-normal vision were recruited from the Boston community to participate in the GSP.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27754483</owl:annotatedTarget>
        <dcterms:title>Association between polygenic risk for schizophrenia, neurocognition and social cognition across development.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27754483</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27754483+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We then looked at the association between schizophrenia polygenic risk and emotion identification speed in the Harvard/MGH Brain Genomics Superstruct Project sample (695 participants ages 18-35 years), where we replicated the association between schizophrenia polygenic risk and emotion identification speed.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A neuroimaging genetics study of clinically normal participants, mostly young adults aged 18 to 35, recruited from the Boston community, United States, in 2008–2012 through ongoing research studies at Harvard University and Massachusetts General Hospital that shared a common acquisition protocol, who underwent structural and functional magnetic resonance imaging, gave saliva for DNA and completed demographic, health, behavioural, cognitive and personality assessments, to link individual differences in brain structure and function to behaviour and genetic variation.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26175908</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001829"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3000</owl:annotatedTarget>
        <obo:IAO_0000116>participants in the broader GSP control sample (stated as a lower bound, &apos;over 3,000&apos;)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:26175908</oboInOwl:hasDbXref>
        <rdfs:comment>The broader GSP control sample, which has over 3,000 participants, includes individuals over the age of 35 and also several hundred datasets acquired using a 32-channel head coil.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001829"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GSP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


