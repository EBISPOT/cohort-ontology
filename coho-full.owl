    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000509"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genetically homogeneous sample of healthy Norwegian adults spanning the adult life span, collected from 2003 to study cognitive ageing and genetic risk factors and genome-wide genotyped in 2009, with MRI and experimental cognitive data on attention and working memory, for studies of the genetics of cognitive and brain function.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22856377</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000509"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">670</owl:annotatedTarget>
        <obo:IAO_0000116>participants genome-wide genotyped (GWA sample), 2012</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:22856377</oboInOwl:hasDbXref>
        <rdfs:comment>The sample on which the GWA study was successfully performed consists of 670 persons recruited through newspaper advertisements in the Oslo and Bergen urban areas.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000509"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NCNG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000510 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000510">
