        <obo:IAO_0000112>GCST90454398</obo:IAO_0000112>
        <obo:IAO_0000115>A corporate genome cohort of employees of Toshiba Corporation, a Japanese electronics company, whose health-care database for precision-medicine research holds genomic, health check-up, questionnaire and prescription data of consenting employees (over 11,600 of whom had given genetic samples by 2024), used for genetic studies such as of side effects after COVID-19 booster vaccination.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">11605</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Toshiba</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Toshiba cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000602"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12531883/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study was conducted at Toshiba Corp, an electronics manufacturer in Japan.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000602"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90454398</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of common side effects following COVID-19 booster vaccination in a cohort of corporate employees in Japan.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40222985</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11994816/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Toshiba has established a health-care database focusing on “Research aimed at realizing precision medicine that can select optimal preventive and treatment methods”.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000602"/>
