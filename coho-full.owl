    <!-- http://www.ebi.ac.uk/coho/COHO_0000320 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000320">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
