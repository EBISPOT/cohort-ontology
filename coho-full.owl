    <!-- http://www.ebi.ac.uk/coho/COHO_0001767 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001767">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15784"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000864"/>
        <obo:IAO_0000112>PGS005169</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:37955902</obo:IAO_0000112>
        <obo:IAO_0000115>A genetic epidemiological study of lung cancer in Taiwan whose case-control component, from September 2002, recruited ethnically Han Chinese patients aged 18 years or older with histologically confirmed incident primary lung cancer from six medical centres, together with cancer-free controls matched on age, gender and ethnicity from the health-examination departments of the same hospitals, to evaluate questionnaire-based and genetic risk factors for lung cancer.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3204</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2734</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>GELAC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Epidemiological Study for Lung AdenoCarcinoma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Taiwan Genetic Epidemiological Study for Lung Adenocarcinoma</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Genetic Epidemiological Study of Lung Adenocarcinoma</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15784">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001767"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15784"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Cases were 18 years or more of age with incident primary lung cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001767"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10644212/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study used the case-control component of GELAC in Taiwan, which aimed to evaluate the associations between questionnaire-based and genetic risk factors and lung cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001767"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS005169</owl:annotatedTarget>
        <dcterms:title>Polygenic Risk Score, Environmental Tobacco Smoke, and Risk of Lung Adenocarcinoma in Never-Smoking Women in Taiwan.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37955902</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001767"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:37955902</owl:annotatedTarget>
        <dcterms:title>Polygenic Risk Score, Environmental Tobacco Smoke, and Risk of Lung Adenocarcinoma in Never-Smoking Women in Taiwan.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37955902</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10644212/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a preliminary study of never-smoking Asian women from the Genetic Epidemiological Study of Lung Adenocarcinoma (GELAC) to estimate the absolute risk of LUAD by integrating data on ETS exposure and genetic susceptibility, as well as test for gene-environment interactions.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001767"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genetic epidemiological study of lung cancer in Taiwan whose case-control component, from September 2002, recruited ethnically Han Chinese patients aged 18 years or older with histologically confirmed incident primary lung cancer from six medical centres, together with cancer-free controls matched on age, gender and ethnicity from the health-examination departments of the same hospitals, to evaluate questionnaire-based and genetic risk factors for lung cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23143601</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37955902</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001767"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3204</owl:annotatedTarget>
        <obo:IAO_0000116>interviewed cases and recruited eligible controls in GELAC, September 2002 to April 2009</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://doi.org/10.1007/s10552-012-9994-x</oboInOwl:hasDbXref>
        <rdfs:comment>Among a total of 3,408 eligible cases, 3,204 were interviewed with a response rate of 94 %.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001767"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2734</owl:annotatedTarget>
        <obo:IAO_0000116>interviewed cases and recruited eligible controls in GELAC, September 2002 to April 2009</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://doi.org/10.1007/s10552-012-9994-x</oboInOwl:hasDbXref>
        <rdfs:comment>We recruited 2,734 eligible controls with a response rate of 87 %.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001767"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GELAC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001768 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001768">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15793"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PGS002270</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:19654303</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control DNA resource for lung cancer established in March 1999 by the Institute of Cancer Research and adopted in 2002 onto the portfolio of the National Cancer Research Network, through which oncology departments across England recruited patients diagnosed with lung cancer between March 1999 and July 2004, and their spouses or partners without a history of cancer as controls, to collect DNA and clinico-pathological data for identifying low-penetrance susceptibility alleles for lung cancer.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5269</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2094</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>GELCAPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GEnetic Lung CAncer Predisposition Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Genetic Lung Cancer Predisposition Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15793">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001768"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15793"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2535604/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All patients diagnosed with lung cancer between March 1999 and July 2004 were eligible for the study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001768"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18715499+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>GELCAPS was one of the first genetic epidemiological trials in the UK to be adopted by the National Cancer Research Network (NCRN) onto its portfolio with the participation of over 100 oncology departments specialising in the management of lung cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001768"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS002270</owl:annotatedTarget>
        <dcterms:title>Association of smoking and polygenic risk with the incidence of lung cancer: a prospective cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35194190</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001768"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:19654303</owl:annotatedTarget>
        <dcterms:title>Deciphering the impact of common genetic variation on lung cancer risk: a genome-wide association study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:19654303</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2754318/</oboInOwl:hasDbXref>
        <rdfs:comment>UK-GWA study Phase 2: An additional 2,484 cases (1,690 male, 794 female; mean age at diagnosis 72 years, SD 7) were ascertained through GELCAPS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001768"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control DNA resource for lung cancer established in March 1999 by the Institute of Cancer Research and adopted in 2002 onto the portfolio of the National Cancer Research Network, through which oncology departments across England recruited patients diagnosed with lung cancer between March 1999 and July 2004, and their spouses or partners without a history of cancer as controls, to collect DNA and clinico-pathological data for identifying low-penetrance susceptibility alleles for lung cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18715499</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001768"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5269</owl:annotatedTarget>
        <obo:IAO_0000116>cases with primary lung cancer and spouse or partner controls recruited between March 1999 and July 2004; the source states no combined total</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:18715499</oboInOwl:hasDbXref>
        <rdfs:comment>We terminated accrual to GELCAPS in July 2004 by which time samples from 5,269 cases with primary lung cancer and 2,094 controls had been recruited.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001768"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2094</owl:annotatedTarget>
        <obo:IAO_0000116>cases with primary lung cancer and spouse or partner controls recruited between March 1999 and July 2004; the source states no combined total</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:18715499</oboInOwl:hasDbXref>
        <rdfs:comment>We terminated accrual to GELCAPS in July 2004 by which time samples from 5,269 cases with primary lung cancer and 2,094 controls had been recruited.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001768"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GELCAPS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001769 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001769">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15802"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South-Eastern_Asia"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000864"/>
        <obo:IAO_0000112>PMID:34750403</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of lung cancer in ethnic Chinese women in Singapore, recruited from 2005 to 2008 in the major public-sector hospitals (Changi General Hospital, National Cancer Centre, National University Hospital, Singapore General Hospital and Tan Tock Seng Hospital), with cases of primary lung carcinoma of all histological types and controls from the same hospitals frequency-matched by 10-year age group; it is one of the studies pooled in the Female Lung Cancer Consortium in Asia.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">399</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">815</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>GEL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GEL-S</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genes and Environment in Lung Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genes and Environment in Lung Cancer, Singapore study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Genes and Environment in Lung Cancer, Singapore Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15802">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0008903"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001769"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15802"/>
        <obo:IAO_0000116>lung cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8575905/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Diagnosis of primary lung cancer was ascertained either through histologic or cytologic reports (358 cases) or through radiologic reports (16 cases) with metastatic cancer to the lung from other sites was ruled unlikely.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001769"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Singapore"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The GEL-S study is a case-control study carried out in the 5 major public-sector hospitals in Singapore5 (Changi General Hospital, National Cancer Centre, National University Hospital, Singapore General Hospital and Tan Tock Seng Hospital).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001769"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34750403</owl:annotatedTarget>
        <dcterms:title>Association between family history and lung cancer risk among Chinese women in Singapore.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34750403</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8575905/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Data for the present analysis was obtained from the Genes and Environment in Lung Cancer (GEL) study, a case–control study conducted in public hospitals from 2005 to 2008.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001769"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of lung cancer in ethnic Chinese women in Singapore, recruited from 2005 to 2008 in the major public-sector hospitals (Changi General Hospital, National Cancer Centre, National University Hospital, Singapore General Hospital and Tan Tock Seng Hospital), with cases of primary lung carcinoma of all histological types and controls from the same hospitals frequency-matched by 10-year age group; it is one of the studies pooled in the Female Lung Cancer Consortium in Asia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23143601</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34750403</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36530673</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001769"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">399</owl:annotatedTarget>
        <obo:IAO_0000116>GEL cases and eligible controls recruited in 2005-2008</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9755194/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GEL study is a hospital-based case-control study of 815 controls and 399 cases recruited from 2005 to 2008, from Singapore public hospitals, including SGH, CGH, National University Hospital (NUH), and Tan Tock Seng Hospital (TTSH) (31, 32).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001769"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">815</owl:annotatedTarget>
        <obo:IAO_0000116>GEL cases and eligible controls recruited in 2005-2008</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9755194/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GEL study is a hospital-based case-control study of 815 controls and 399 cases recruited from 2005 to 2008, from Singapore public hospitals, including SGH, CGH, National University Hospital (NUH), and Tan Tock Seng Hospital (TTSH) (31, 32).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001769"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GEL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
