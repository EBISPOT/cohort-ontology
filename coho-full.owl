    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000618"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90301397</owl:annotatedTarget>
        <dcterms:title>Germline genetic regulation of the colorectal tumor immune microenvironment.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38664626</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11046907/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To evaluate the contribution of germline genetics to regulating the briskness and diversity of T cell responses in CRC, we conducted a genome-wide association study to examine the associations between germline genetic variation and quantitative measures of T cell landscapes in 2,876 colorectal tumors from participants in the Molecular Epidemiology of Colorectal Cancer Study (MECC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000618"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of incident colorectal cancer cases and healthy controls recruited in northern Israel from 1998 to 2017, used to study genetic and environmental risk factors for colorectal cancer and the tumour immune microenvironment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38664626</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000618"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5581</owl:annotatedTarget>
        <obo:IAO_0000116>participants genotyped (colorectal cancer cases and controls); a subset of all enrolled</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11046907/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>DNA samples from 10,364 MECC participants (5,581 CRC cases and 4,783 controls) were genotyped using four platforms.</rdfs:comment>
    </owl:Axiom>
