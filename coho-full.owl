    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002024"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case–control study of bladder cancer in Lutherstadt Wittenberg, Germany, whose cases were patients with confirmed bladder cancer enrolled at the Department of Urology of the Paul Gerhardt Foundation from 1995 to 1999 and whose controls were patients of the same department admitted for benign urological diseases and enrolled from 2000 to 2005; occupational history, exposure to occupational bladder carcinogens, smoking and family history of bladder cancer were documented for cases and controls.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20972438</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21750109</obo:IAO_0000119>
