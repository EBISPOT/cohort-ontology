        <obo:IAO_0000112>GCST90435416</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium, established in 2009, of cohorts of cancer patients treated with radiotherapy (for prostate, head and neck, breast and lung cancer, among others) that shares genotype and normal-tissue toxicity data and develops meta-analysis methods to identify genetic variants associated with radiation-induced toxicity.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">12042</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>RGC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Radiogenomic Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Radiogenomics Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid8020">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
