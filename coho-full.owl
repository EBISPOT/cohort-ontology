    <!-- http://www.ebi.ac.uk/coho/COHO_0001016 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001016">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid9257"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000679"/>
