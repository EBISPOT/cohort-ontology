        <rdfs:comment>Data were drawn from Generation XXI, a prospective population-based birth cohort study assembled in Porto, Portugal</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002630"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:41874644</owl:annotatedTarget>
        <dcterms:title>Trajectories of appetitive traits and dietary patterns from childhood to adolescence: findings from the Generation XXI birth cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41874644</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13013234/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We included 5040 participants from the Generation XXI cohort (Porto, Portugal).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002630"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based birth cohort of infants born between April 2005 and August 2006 in all the public maternity units of the Porto Metropolitan Area, Portugal, and their families, set up at the University of Porto and followed through childhood and adolescence to study how pregnancy and early-life characteristics relate to later growth, health and risk of chronic disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:41874644</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.geracao21.com/en/project</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002630"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8647</owl:annotatedTarget>
        <obo:IAO_0000116>liveborn infants enrolled 2005-2006</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13013234/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Between April 2005 and August 2006, 8647 liveborn infants were enrolled in all the public maternity wards in the Porto Metropolitan Area.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
