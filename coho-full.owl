        <obo:IAO_0000116>breast cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5645429/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The unselected breast cancer samples were collected from patients operated at the Oulu University Hospital during 2000–2014, and they were unselected for age at disease onset and a family history of cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002195"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
