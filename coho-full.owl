        <obo:IAO_0000112>PMID:38555241</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based longitudinal study of growth, development and body composition begun in 1929 in Yellow Springs, Ohio, United States, whose participants are usually enrolled at birth and followed with serial examinations until death or infirmity, now run under Wright State University in Dayton, Ohio, with genotype data used in genetic analyses of adiposity and liver fat.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1612</coho:numberOfParticipants>
