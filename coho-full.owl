    <!-- http://www.ebi.ac.uk/coho/COHO_0001313 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001313">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11857"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000641"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002430"/>
        <obo:IAO_0000112>GCST90132184</obo:IAO_0000112>
        <obo:IAO_0000115>A French case–control sample of people of European ancestry assembled for a genome-wide association study of type 2 diabetes: people with type 2 diabetes, a family history of diabetes in first-degree relatives and a BMI below 30, recruited at the CNRS UMR8090 unit in Lille and the Endocrinology-Diabetology Department of the Corbeil-Essonnes Hospital, and normoglycaemic controls drawn mostly from the D.E.S.I.R. cohort of volunteers attending French health examination centres.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">661</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">614</coho:numberOfControls>
