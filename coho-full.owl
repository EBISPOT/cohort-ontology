    <!-- http://www.ebi.ac.uk/coho/COHO_0002705 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002705">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid22886"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001800"/>
        <obo:IAO_0000112>PMID:29892015</obo:IAO_0000112>
        <obo:IAO_0000115>An observational cohort of adults with atrial fibrillation first diagnosed before age 60, recruited at the outpatient clinic of the University Medical Center Groningen, the Netherlands, in 2012–2013, combining retrospective information near the first diagnosis with prospective follow-up to characterize their clinical and familial profile, atrial fibrillation progression and cardiovascular outcomes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">500</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>YOUNG-AF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young AF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young AF study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young-AF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young-AF study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Phenotyping Young-Onset Atrial Fibrillation Patients study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid22886">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004981"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002705"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid22886"/>
        <obo:IAO_0000116>atrial fibrillation</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6923497/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>At the outpatient clinic patients with AF onset &lt;60 years, ≥18 years at time of inclusion were asked to participate.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002705"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6923497/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In brief, YOUNG-AF was a partly prospective, partly retrospective, observational study performed at the University Medical Center Groningen, The Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002705"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29892015</owl:annotatedTarget>
        <dcterms:title>Polygenic prediction of body mass index and obesity through the life course and across ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29892015</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Young-AF study is an observational hospital-based cohort (n=500; in GGAF 311) to seek describe the phenotypic profile of patients with AF onset at age &lt;60 years and the occurrence of AF progression during 5 years follow up.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002705"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An observational cohort of adults with atrial fibrillation first diagnosed before age 60, recruited at the outpatient clinic of the University Medical Center Groningen, the Netherlands, in 2012–2013, combining retrospective information near the first diagnosis with prospective follow-up to characterize their clinical and familial profile, atrial fibrillation progression and cardiovascular outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31890859</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>GPT-6 (OpenAI), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002705"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">500</owl:annotatedTarget>
        <obo:IAO_0000116>Patients included August 2012–December 2013, before three later eligibility exclusions. (2012–2013)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6923497/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Between August 2012 and December 2013, 500 patients were included.</rdfs:comment>
    </owl:Axiom>
