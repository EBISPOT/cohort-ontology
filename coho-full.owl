        <oboInOwl:hasRelatedSynonym>GERAD/PERADES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GERAD1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GERAD1 Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic and Environmental Risk for Alzheimer&apos;s disease Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic and Environmental Risk in AD</oboInOwl:hasRelatedSynonym>
