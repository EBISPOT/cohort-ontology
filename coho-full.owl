    <!-- http://www.ebi.ac.uk/coho/COHO_0002095 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002095">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000927"/>
        <obo:IAO_0000112>PGS000349</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:28209224</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of women who attended mammography screening in Västerbotten, Sweden, between 1995 and 2006 and gave blood samples and brief questionnaire data on reproductive factors at the mammography centre, many at repeated screening visits; one of the three sub-cohorts of the Northern Sweden Health and Disease Study.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">28822</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MSP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mammography Screening Project in Vasterbotten</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Northern Sweden Mammography Screening Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Mammography Screening Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002095"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The NSHDS is a population-based prospective longitudinal cohort comprising &gt;140 000 participants in the two northernmost regions in Sweden, Norrbotten and Västerbotten, with &gt;240 000 blood samples and 1.5 million person-years of follow-up.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002095"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000927"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The NSHDS includes three sub-cohorts: the Västerbotten Intervention Programme (VIP), the expanded Northern Sweden Monitoring of Trends and Determinants of Cardiovascular Disease (MONICA) Study, and the Mammography Screening Project (MSP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002095"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS000349</owl:annotatedTarget>
        <dcterms:title>Risk prediction for coronary heart disease by a genetic risk score - results from the Heinz Nixdorf Recall study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32912153</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002095"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28209224</owl:annotatedTarget>
        <dcterms:title>Systematic Evaluation of Pleiotropy Identifies 6 Further Loci Associated With Coronary Artery Disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28209224</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5314135/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Cases of MI occurring in participants from Vasterbotten Intervention Program (VIP), WHO’s Multinational Monitoring of Trends and Determinants in Cardiovascular Disease (MONICA) study in northern Sweden and the Mammography Screening Project (MSP) in Vasterbotten</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002095"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of women who attended mammography screening in Västerbotten, Sweden, between 1995 and 2006 and gave blood samples and brief questionnaire data on reproductive factors at the mammography centre, many at repeated screening visits; one of the three sub-cohorts of the Northern Sweden Health and Disease Study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:39899988</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
