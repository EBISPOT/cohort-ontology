        <obo:IAO_0000112>PMID:32649918</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre randomised clinical trial in the United States that compared medical therapy, including pulmonary rehabilitation, with medical therapy plus lung-volume-reduction surgery in former smokers with severe bilateral emphysema and severe airflow obstruction, with survival as its primary outcome.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1218</coho:numberOfParticipants>
