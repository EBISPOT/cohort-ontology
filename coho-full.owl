    <!-- http://www.ebi.ac.uk/coho/COHO_0002249 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002249">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19268"/>
        <rdf:type rdf:nodeID="genid19270"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Colombia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>PMID:30787307</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study run by the Institute for Immunological Research of the University of Cartagena, Colombia, to identify environmental and genetic risk factors for asthma and allergies, which recruited unrelated people with asthma, diagnosed by GINA criteria with a standardised questionnaire and confirmed by a study physician from the clinical history and reversible airway obstruction on lung function testing, and unrelated controls without a personal or family history of asthma or allergies from the Social Security Clinic and outpatient health centres in Cartagena from 2002 to 2005, together with nuclear and extended families recruited through asthmatic probands. It is one of the asthma genetics studies of the Consortium on Asthma among African-ancestry Populations in the Americas (CAAPA).</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">836</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">574</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>PGCA</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Proyecto Genes Candidatos en Asma</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19268">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid19270">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ExO_0000002"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002249"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19268"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms12522/MediaObjects/41467_2016_BFncomms12522_MOESM1276_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 836 unrelated asthma cases and 574 non-asthmatic controls were recruited from the Social Security Clinic and outpatient health centers in Cartagena from 2002 to 2005.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002249"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19270"/>
        <obo:IAO_0000116>environmental risk factors</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Proyecto Genes Candidatos en Asma (PGCA) study is a population-based study conducted by the Institute for Immunological Research of The University of Cartagena (Colombia) to identify environmental and genetic risk factors for asthma and allergies [16, 19, 21, 22].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002249"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Colombia"/>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Proyecto Genes Candidatos en Asma (PGCA) study is a population-based study conducted by the Institute for Immunological Research of The University of Cartagena (Colombia) to identify environmental and genetic risk factors for asthma and allergies [16, 19, 21, 22].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002249"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:30787307</owl:annotatedTarget>
        <dcterms:title>Association study in African-admixed populations across the Americas recapitulates asthma risk loci in non-African populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30787307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6382865/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>While this association was observed in multiple African American samples, the strongest effects were observed in three non-U.S. studies from Barbados (BAGS), Cartagena, Colombia (PGCA), and Puerto Rico (GALA II; Supplementary Fig. 15).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002249"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study run by the Institute for Immunological Research of the University of Cartagena, Colombia, to identify environmental and genetic risk factors for asthma and allergies, which recruited unrelated people with asthma, diagnosed by GINA criteria with a standardised questionnaire and confirmed by a study physician from the clinical history and reversible airway obstruction on lung function testing, and unrelated controls without a personal or family history of asthma or allergies from the Social Security Clinic and outpatient health centres in Cartagena from 2002 to 2005, together with nuclear and extended families recruited through asthmatic probands. It is one of the asthma genetics studies of the Consortium on Asthma among African-ancestry Populations in the Americas (CAAPA).</owl:annotatedTarget>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms12522/MediaObjects/41467_2016_BFncomms12522_MOESM1276_ESM.pdf</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002249"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">836</owl:annotatedTarget>
        <obo:IAO_0000116>unrelated asthma cases and non-asthmatic controls recruited in Cartagena, 2002-2005 (the families recruited through asthmatic probands are not counted)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms12522/MediaObjects/41467_2016_BFncomms12522_MOESM1276_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 836 unrelated asthma cases and 574 non-asthmatic controls were recruited from the Social Security Clinic and outpatient health centers in Cartagena from 2002 to 2005.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002249"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">574</owl:annotatedTarget>
        <obo:IAO_0000116>unrelated asthma cases and non-asthmatic controls recruited in Cartagena, 2002-2005 (the families recruited through asthmatic probands are not counted)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms12522/MediaObjects/41467_2016_BFncomms12522_MOESM1276_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 836 unrelated asthma cases and 574 non-asthmatic controls were recruited from the Social Security Clinic and outpatient health centers in Cartagena from 2002 to 2005.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002249"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PGCA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002250 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002250">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid19278"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001780"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002283"/>
        <obo:IAO_0000112>PGS001774</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:25064009</obo:IAO_0000112>
        <obo:IAO_0000115>A genome-wide association sample of familial Parkinson&apos;s disease that combines unrelated cases, one per multiplex family, from two familial Parkinson&apos;s disease studies, PROGENI and GenePD, diagnosed by modified UK Parkinson&apos;s Disease Society Brain Bank criteria and primarily Caucasian and non-Hispanic, with Caucasian non-Hispanic controls without neurological disease from the NINDS repository at the Coriell Institute, genotyped at the Center for Inherited Disease Research to find genetic risk factors for Parkinson&apos;s disease.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">857</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">867</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1724</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CIDR: Genome Wide Association Study in Familial Parkinson Disease (PD)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GenePD-PROGENI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PGPD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PROGENI-GenePD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PROGENI/GenePD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#PGS_subset"/>
        <rdfs:label xml:lang="en">Genome Wide Association Study in Familial Parkinson Disease</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19278">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005180"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002250"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19278"/>
        <obo:IAO_0000116>familial Parkinson disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18985386+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Unlike previous studies that focused primarily on sporadic PD, we have performed the first genomewide association study (GWAS) in familial PD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002250"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001780"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2758866/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>One PD case (n = 935) from each family recruited from two ongoing studies of familial PD, the GenePD study and the PROGENI study, was selected for the GWAS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002250"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002283"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2758866/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>One PD case (n = 935) from each family recruited from two ongoing studies of familial PD, the GenePD study and the PROGENI study, was selected for the GWAS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002250"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS001774</owl:annotatedTarget>
        <dcterms:title>Prediction of Parkinson&apos;s Disease Risk Based on Genetic Profile and Established Risk Factors.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34440451</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002250"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25064009</owl:annotatedTarget>
        <dcterms:title>Large-scale meta-analysis of genome-wide association data identifies six new risk loci for Parkinson&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25064009</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4146673/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For each locus identified as genome-wide significant in the discovery phase, we reran cohort level analyses in a subset of 7 datasets with the largest counts of cases (due to primary data availability at the participant level, only IPDGC-NIA, IPDGC-NL, IPDGC-GE, 23&amp;Me, PROGENI-GenePD, NGRC and HIHG were included) testing all SNPs within +/− 1MB from the 26 genome-wide significant SNPs in Table 1, while adjusting for the SNP with the most extreme p-value per locus.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002250"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genome-wide association sample of familial Parkinson&apos;s disease that combines unrelated cases, one per multiplex family, from two familial Parkinson&apos;s disease studies, PROGENI and GenePD, diagnosed by modified UK Parkinson&apos;s Disease Society Brain Bank criteria and primarily Caucasian and non-Hispanic, with Caucasian non-Hispanic controls without neurological disease from the NINDS repository at the Coriell Institute, genotyped at the Center for Inherited Disease Research to find genetic risk factors for Parkinson&apos;s disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18985386</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000126.v1.p1</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002250"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">857</owl:annotatedTarget>
        <obo:IAO_0000116>familial Parkinson&apos;s disease cases and NINDS repository controls in the final GWAS analysis sample (2009)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2627511/</oboInOwl:hasDbXref>
        <rdfs:comment>The final sample used in analyses included 857 PD cases and 867 controls (n = 1,724 individuals).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002250"/>
