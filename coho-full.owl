    <!-- http://purl.obolibrary.org/obo/MONDO_0000837 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0000837">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000833"/>
        <obo:IAO_0000115>A disease that has its basis in the disruption of bone resorption. Bone resorption is a process in which specialized cells known as osteoclasts degrade the organic and inorganic portions of bone, and endocytose and transport the degradation products.</obo:IAO_0000115>
        <rdfs:label>bone resorption disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000870 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0000870">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003659"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004355"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004967"/>
        <obo:IAO_0000115>An acute lymphoblastic leukemia occurring during childhood. The majority of cases are B-acute lymphoblastic leukemias. Approximately 15% of the cases are T-acute lymphoblastic leukemias.</obo:IAO_0000115>
        <rdfs:label>childhood acute lymphoblastic leukemia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000873 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0000873">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003538"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0018908"/>
        <obo:IAO_0000115>A lymphoma composed of immature small to medium-sized precursor lymphoid cells (lymphoblasts). It includes the B- and T-cell lymphoblastic lymphoma.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>lymphoma, lymphoblastic</oboInOwl:hasRelatedSynonym>
        <rdfs:label>lymphoblastic lymphoma</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000931 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0000931">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002654"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects the endometrium. Representative examples include endometritis, endometrial hyperplasia, and endometrial carcinoma.</obo:IAO_0000115>
        <rdfs:label>endometrial disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000940 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0000940">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002428"/>
        <obo:IAO_0000115>Infection with protozoa of the genus trypanosoma.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Trypanosomiases</oboInOwl:hasRelatedSynonym>
        <rdfs:label>trypanosomiasis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0000942 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0000942">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005328"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects the cornea. Representative examples include keratitis, bullous keratopathy, and squamous cell carcinoma.</obo:IAO_0000115>
        <rdfs:label>corneal disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001014 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001014">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005059"/>
        <obo:IAO_0000115>A slowly progressing leukemia characterized by a clonal (malignant) proliferation of maturing and mature myeloid cells or mature lymphocytes. When the clonal cellular population is composed of myeloid cells, the process is called chronic myelogenous leukemia. When the clonal cellular population is composed of lymphocytes, it is classified as chronic lymphocytic leukemia, hairy cell leukemia, or T-cell large granular lymphocyte leukemia.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>adult chronic leukaemia</oboInOwl:hasRelatedSynonym>
        <rdfs:label>chronic leukemia</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001014"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>adult chronic leukaemia</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003005"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001020 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001020">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021084"/>
        <obo:IAO_0000115>Decreased vision that results from abnormal visual development.</obo:IAO_0000115>
        <rdfs:label>amblyopia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001056 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001056">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002516"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021085"/>
        <obo:IAO_0000115>A primary or metastatic malignant neoplasm involving the stomach.</obo:IAO_0000115>
        <rdfs:label>gastric cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001063 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001063">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001056"/>
        <obo:IAO_0000115>A malignant neoplasm involving the cardia of stomach.</obo:IAO_0000115>
        <rdfs:label>cardia cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001104 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001104">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004425"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005397"/>
        <rdfs:label>toxic diffuse goiter</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001106 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001106">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005240"/>
        <obo:IAO_0000115>An acute or chronic condition that is characterized by the inability of the kidneys to adequately filter the blood.</obo:IAO_0000115>
        <rdfs:label>kidney failure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001134 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001134">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005044"/>
        <obo:IAO_0000115>Hypertension that presents without an identifiable cause.</obo:IAO_0000115>
        <rdfs:label>essential hypertension</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001142 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001142">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006858"/>
        <obo:IAO_0000115>A disease involving the saliva-secreting gland.</obo:IAO_0000115>
        <rdfs:label>salivary gland disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001176 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001176">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005328"/>
        <obo:IAO_0000115>A disease involving the lens of camera-type eye.</obo:IAO_0000115>
        <rdfs:label>lens disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001187 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001187">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004987"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006295"/>
        <obo:IAO_0000115>A primary or metastatic malignant neoplasm involving the bladder.</obo:IAO_0000115>
        <rdfs:label>urinary bladder cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001208 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001208">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0020683"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021113"/>
        <obo:IAO_0000115>Life-threatening respiratory failure that develops rapidly. Causes include injury, sepsis, drug overdose, and pancreatitis. It manifests with dyspnea and cyanosis and may lead to cardiovascular shock.</obo:IAO_0000115>
        <rdfs:label>acute respiratory failure</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001265 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001265">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005485"/>
        <obo:IAO_0000115>A disorder that differs from schizophrenia specifically in total duration (schizophreniform disorder lasts at least 1 month but less than 6 months whereas schizophrenia lasts at least 6 months); schizophreniform disorder also typically causes less impairment in the individual&apos;s social and occupational functioning.</obo:IAO_0000115>
        <rdfs:label>schizophreniform disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001318 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001318">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004298"/>
        <oboInOwl:hasDbXref>ICD9:306.4</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>ICD9:536.9</oboInOwl:hasDbXref>
        <rdfs:label>functional gastric disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001336 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001336">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002525"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021187"/>
        <obo:IAO_0000115>An instance of hyperlipidemia (disease) that is caused by an inherited modification of the individual&apos;s genome.</obo:IAO_0000115>
        <rdfs:label>familial hyperlipidemia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001358 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001358">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000270"/>
        <obo:IAO_0000115>A disease involving the bronchus.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9:519.19</oboInOwl:hasDbXref>
        <rdfs:label>bronchial disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001377 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001377">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004860"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004884"/>
        <rdfs:label>vitreous syneresis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001384 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001384">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003847"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004892"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0100581"/>
        <obo:IAO_0000115>The condition in which the individual does not see far distances clearly.</obo:IAO_0000115>
        <rdfs:label>myopia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001406 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003620"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021248"/>
        <obo:IAO_0000115>A benign or malignant neoplasm arising from a peripheral nerve or the perineural sheaths.</obo:IAO_0000115>
        <rdfs:label>peripheral nervous system neoplasm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003749"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021166"/>
        <obo:IAO_0000115>An acute or chronic inflammatory disease affecting the esophageal wall.</obo:IAO_0000115>
        <rdfs:label>esophagitis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001416 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001416">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002149"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021148"/>
        <obo:IAO_0000115>A primary or metastatic malignant neoplasm involving the female reproductive system. Representative examples include endometrial carcinoma, cervical carcinoma, ovarian carcinoma, uterine corpus leiomyosarcoma, adenosarcoma, malignant mixed mesodermal (mullerian) tumor, and gestational choriocarcinoma.</obo:IAO_0000115>
        <rdfs:label>female reproductive organ cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001531 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005570"/>
        <obo:IAO_0000115>A condition in which there is a deviation from or interruption of the normal coagulation properties of the blood.</obo:IAO_0000115>
        <rdfs:label>blood coagulation disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001569 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001569">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002546"/>
        <obo:IAO_0000115>A type of benign brain tumor that begins in the Schwann cells, which produce the myelin that protects the acoustic nerve - the nerve of hearing.</obo:IAO_0000115>
        <rdfs:label>acoustic neuroma</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001584 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001584">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003569"/>
        <rdfs:label>ocular motility disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001593 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001593">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0024634"/>
        <obo:IAO_0000115>A disease that involves the rectum.</obo:IAO_0000115>
        <rdfs:label>rectal disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001612 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001612">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005269"/>
        <obo:IAO_0000115>A narrowing of the carotid artery lumen. It is usually caused by the formation of an atherosclerotic plaque. Symptoms are usually present when there is severe narrowing or obstruction of the arterial lumen and manifest as ischemic cerebrovascular accidents.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>HP:0100546</oboInOwl:hasDbXref>
        <rdfs:label>carotid stenosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001627 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001627">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002039"/>
        <obo:IAO_0000115>Loss of intellectual abilities interfering with an individual&apos;s social and occupational functions. Causes include Alzheimer&apos;s disease, brain injuries, brain tumors, and vascular disorders.</obo:IAO_0000115>
        <rdfs:label>dementia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001660 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001660">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005266"/>
        <obo:IAO_0000115>Advanced retinopathy due to diabetes mellitus characterized by the formation of new vessels in the retina. The new vessels are abnormal and fragile. If hemorrhage occurs due to the vascular fragility, there is increased risk of vision loss or blindness.</obo:IAO_0000115>
        <rdfs:label>proliferative diabetic retinopathy</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001697 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001697">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004681"/>
        <obo:IAO_0000115>A learning disability involving difficulty reading resulting primarily from neurological factors which affect any part of the reading process.</obo:IAO_0000115>
        <rdfs:label>reading disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001854 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001854">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000462"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005328"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects the lacrimal apparatus.</obo:IAO_0000115>
        <rdfs:label>lacrimal apparatus disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001866 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001866">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004985"/>
        <obo:IAO_0000115>A bipolar disorder that is characterized by at least one manic or mixed episode.</obo:IAO_0000115>
        <rdfs:label>bipolar I disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001933 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001933">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002356"/>
        <obo:IAO_0000115>A disease involving the endocrine pancreas.</obo:IAO_0000115>
        <rdfs:label>endocrine pancreas disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0001941 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0001941">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021084"/>
        <obo:IAO_0000115>The lack of vision. It is caused by neurological or physiological factors.</obo:IAO_0000115>
        <rdfs:label>blindness (disorder)</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002009 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002009">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002050"/>
        <obo:IAO_0000115>An episode of depression lasting two or more weeks without an intervening episode of mania.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MFOMD:0000143</oboInOwl:hasDbXref>
        <rdfs:label>major depressive disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002022 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002022">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_7770006"/>
        <obo:IAO_0000115>A disease that involves the orbital region.</obo:IAO_0000115>
        <rdfs:label>disorder of orbital region</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002025 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002025">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_7770007"/>
        <obo:IAO_0000115>A disorder characterized by behavioral and/or psychological abnormalities, often accompanied by physical symptoms. The symptoms may cause clinically significant distress or impairment in social and occupational areas of functioning. Representative examples include anxiety disorders, cognitive disorders, mood disorders and schizophrenia.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MFOMD:0000004</oboInOwl:hasDbXref>
        <rdfs:label>psychiatric disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002031 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002031">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003409"/>
        <obo:IAO_0000115>Pathological developments in the cecum.</obo:IAO_0000115>
        <rdfs:label>cecal disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002037 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002037">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000270"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects the pleura. Representative examples include pleural infection, pleural mesothelioma, and pleural solitary fibrous tumor.</obo:IAO_0000115>
        <rdfs:label>pleural disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002038 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002038">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004993"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005627"/>
        <obo:IAO_0000115>A carcinoma that arises from the head and neck region. Representative examples include oral cavity squamous cell carcinoma, laryngeal squamous cell carcinoma, and salivary gland carcinoma.</obo:IAO_0000115>
        <rdfs:label>head and neck carcinoma</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002039 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002039">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002025"/>
        <obo:IAO_0000115>A disease affects cognitive processes.</obo:IAO_0000115>
        <rdfs:label>cognitive disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002050 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002050">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005371"/>
        <obo:IAO_0000115>A melancholy feeling of sadness and despair.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>MFOMD:0000013</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>melancholia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>melancholias</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>syndrome, depressive</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>syndromes, depressive</oboInOwl:hasRelatedSynonym>
        <rdfs:label>depressive disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002051 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002051">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_7770006"/>
        <obo:IAO_0000115>A disease involving the integumental system.</obo:IAO_0000115>
        <rdfs:label>integumentary system disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002052 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002052">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004928"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021166"/>
        <obo:IAO_0000115>Acute or chronic inflammation of one or more lymph nodes. It is usually caused by an infectious process.</obo:IAO_0000115>
        <rdfs:label>lymphadenitis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002081 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002081">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_7770006"/>
        <obo:IAO_0000115>A disease involving the musculoskeletal system.</obo:IAO_0000115>
        <rdfs:label>musculoskeletal system disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002082 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002082">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005070"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005151"/>
        <obo:IAO_0000115>A benign or malignant neoplasm arising from the epithelial cells of an endocrine organ. Representative examples include pituitary gland adenoma, pituitary gland carcinoma, thyroid gland carcinoma, carcinoid tumor, and neuroendocrine carcinoma.</obo:IAO_0000115>
        <rdfs:label>endocrine gland neoplasm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002087 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002087">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004992"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006901"/>
        <obo:IAO_0000115>A malignant neoplasm involving the peritoneum</obo:IAO_0000115>
        <rdfs:label>peritoneum cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002113 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002113">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002087"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004993"/>
        <obo:IAO_0000115>A peritoneum cancer that is located in the inside of the abdomen.</obo:IAO_0000115>
        <rdfs:label>peritoneal carcinoma</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002116 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002116">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0009831"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021076"/>
        <obo:IAO_0000115>A malignant neoplasm that arises from the epithelial cells of the exocrine pancreatic tissue.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>tumour of exocrine pancreas</oboInOwl:hasRelatedSynonym>
        <rdfs:label>malignant exocrine pancreas neoplasm</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002116"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>tumour of exocrine pancreas</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003005"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002118 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002118">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_7770006"/>
        <obo:IAO_0000115>A disease involving the renal system.</obo:IAO_0000115>
        <rdfs:label>urinary system disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002120 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002120">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004993"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019496"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021069"/>
        <obo:IAO_0000115>A malignant neuroendocrine neoplasm composed of cells containing secretory granules that stain positive for NSE and chromogranin. The neoplastic cells are often round and form clusters or trabecular sheets. Representative examples are small cell carcinoma, large cell neuroendocrine carcinoma, and Merkel cell carcinoma.</obo:IAO_0000115>
        <rdfs:label>neuroendocrine carcinoma</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002129 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002129">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000637"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019060"/>
        <obo:IAO_0000115>A primary or metastatic malignant neoplasm affecting the bone or articular cartilage.</obo:IAO_0000115>
        <rdfs:label>bone cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002149 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002149">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004992"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006054"/>
        <obo:IAO_0000115>A malignant neoplasm involving the reproductive organ</obo:IAO_0000115>
        <rdfs:label>reproductive system cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002156 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002156">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002263"/>
        <obo:IAO_0000115>A disease involving the fallopian tube.</obo:IAO_0000115>
        <rdfs:label>fallopian tube disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002158 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002158">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001416"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021092"/>
        <obo:IAO_0000115>A primary or metastatic malignant neoplasm that affects the fallopian tube. Representative examples include carcinoma, carcinosarcoma, and leiomyosarcoma.</obo:IAO_0000115>
        <rdfs:label>fallopian tube cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002165 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002165">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001593"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005335"/>
        <obo:IAO_0000115>A benign or malignant neoplasm that affects the rectum. Representative examples of benign neoplasms include lipoma and leiomyoma. Representative examples of malignant neoplasms include carcinoma, lymphoma, and sarcoma. Rectal adenomas always exhibit epithelial dysplasia and are considered premalignant neoplasms.</obo:IAO_0000115>
        <rdfs:label>rectal neoplasm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002175 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002175">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003004"/>
        <rdfs:label>degeneration of macula and posterior pole</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002182 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002182">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000592"/>
        <obo:IAO_0000115>A disorder characterized by an individual&apos;s inability to comprehend or share ideas or feelings because of an impairment in language, speech, or hearing.</obo:IAO_0000115>
        <rdfs:label>communication disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002220 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002220">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006999"/>
        <rdfs:label>tooth hard tissue disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002229 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002229">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005626"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021068"/>
        <obo:IAO_0000115>A benign, borderline, or malignant tumor that originates from the surface epithelium of the ovary. It is composed of epithelial cells and stroma. Representative examples of benign tumors include serous cystadenoma, mucinous cystadenoma, and benign Brenner tumor. Representative examples of borderline tumors include serous surface papillary tumor, mucinous adenofibroma, and borderline Brenner tumor. Representative examples of malignant tumors include serous adenocarcinoma, mucinous adenocarcinoma, endometrioid adenocarcinoma, and malignant Brenner tumor.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>OVT</oboInOwl:hasRelatedSynonym>
        <rdfs:label>ovarian epithelial tumor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002232 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002232">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002436"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004867"/>
        <obo:IAO_0000115>A disease involving the nasal cavity.</obo:IAO_0000115>
        <rdfs:label>nasal cavity disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002236 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002236">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000649"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005627"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021220"/>
        <obo:IAO_0000115>A benign or malignant neoplasm affecting the structures of the eye.</obo:IAO_0000115>
        <rdfs:label>ocular cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002242 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002242">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001531"/>
        <obo:IAO_0000115>Congenital or acquired deficiency of one of the coagulation factors. It results in bleeding.</obo:IAO_0000115>
        <rdfs:label>coagulation protein disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002251 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002251">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005154"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021166"/>
        <obo:IAO_0000115>An active inflammatory process affecting the liver for more than six months. Causes include viral infections, autoimmune disorders, drugs, and metabolic disorders.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Hepatitides</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hepatitis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002254 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002254">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_7770006"/>
        <obo:IAO_0000115>A group of signs, symptoms, and clinicopathological characteristics that may or may not have a genetic basis and collectively define an abnormal condition.</obo:IAO_0000115>
        <rdfs:label>syndromic disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002256 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002256">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002654"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects the cervix. Representative examples include cervicitis, endocervical polyp, and carcinoma.</obo:IAO_0000115>
        <rdfs:label>cervix disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002259 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002259">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005039"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005151"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects the testis or the ovary.</obo:IAO_0000115>
        <rdfs:label>gonadal disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002260 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002260">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021166"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0024467"/>
        <obo:IAO_0000115>An inflammatory disease involving a pathogenic inflammatory response in the apocrine sweat gland.</obo:IAO_0000115>
        <rdfs:label>hidradenitis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002263 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002263">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005039"/>
        <obo:IAO_0000115>A disease involving the female reproductive system.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>gynaecological disease</oboInOwl:hasRelatedSynonym>
        <rdfs:label>female reproductive system disorder</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002263"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>gynaecological disease</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003005"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002267 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002267">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005275"/>
        <obo:IAO_0000115>Any disorder marked by obstruction of conducting airways of the lung. airway obstruction may be acute, chronic, intermittent, or persistent.</obo:IAO_0000115>
        <rdfs:label>obstructive lung disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002269 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002269">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005020"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021166"/>
        <obo:IAO_0000115>An inflammatory disorder that affects the upper and lower gastrointestinal tract. Most commonly, this is attributed to viruses; however bacteria, parasites or adverse reactions can also be the culprit. Symptoms include acute diarrhea and vomiting.</obo:IAO_0000115>
        <rdfs:label>gastroenteritis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002273 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002273">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019052"/>
        <obo:IAO_0000115>An inherited metabolic disorder that involves plasma protein metabolism malfunction.</obo:IAO_0000115>
        <rdfs:label>plasma protein metabolism disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002277 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002277">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000473"/>
        <obo:IAO_0000115>A vascular disorder characterized by thickening and hardening of the walls of the arteries.</obo:IAO_0000115>
        <rdfs:label>arteriosclerosis disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002305 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002305">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001531"/>
        <obo:IAO_0000115>A condition characterized by an abnormally high level of thrombi. Causes include thrombotic thrombocytopenic purpura, disseminated intravascular coagulation, bone marrow disorders, and antiphospholipid antibody syndrome.</obo:IAO_0000115>
        <rdfs:label>thrombophilia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002311 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002311">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005283"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005552"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0043218"/>
        <obo:IAO_0000115>Retinal damage resulting from diminished blood flow/oxygenation due to abnormalities of the retinal vessels. Causes include hypertension, diabetes, thrombosis, embolism, and hemorrhage.</obo:IAO_0000115>
        <rdfs:label>retinal vascular disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002329 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002329">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002259"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0003150"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder affecting the testis. Representative examples include torsion, infarction, germ cell tumor, sex cord-stromal tumor, lymphoma, and leukemia.</obo:IAO_0000115>
        <rdfs:label>testicular disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002331 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002331">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005240"/>
        <obo:IAO_0000115>Pathological processes of the KIDNEY without inflammatory or neoplastic components. Nephrosis may be a primary disorder or secondary complication of other diseases. It is characterized by the NEPHROTIC SYNDROME indicating the presence of PROTEINURIA and HYPOALBUMINEMIA with accompanying EDEMA.</obo:IAO_0000115>
        <rdfs:label>nephrosis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002334 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002334">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005070"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005570"/>
        <obo:IAO_0000115>Neoplasms of the hematopoietic system, including hematopoietic cell neoplasms (e.g. leukemias, lymphomas) and non-hematopoietic cell neoplasms that can affect the hematopoietic system (e.g. lymph node and splenic sarcomas). --2003</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>malignant haematopoietic neoplasm</oboInOwl:hasRelatedSynonym>
        <rdfs:label>hematopoietic and lymphoid system neoplasm</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002334"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>malignant haematopoietic neoplasm</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003005"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002352 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002352">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000376"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021071"/>
        <obo:IAO_0000115>A primary or metastatic malignant neoplasm involving the larynx. The majority are carcinomas.</obo:IAO_0000115>
        <rdfs:label>larynx cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002356 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002356">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004335"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005151"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects the pancreas. Representative examples of non-neoplastic disorders include pancreatitis and pancreatic insufficiency. Representative examples of neoplastic disorders include cystadenomas, carcinomas, lymphomas, and neuroendocrine neoplasms.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>ICD9:577.9</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>disease, pancreatic</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>diseases, pancreatic</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>pancreatic disease</oboInOwl:hasRelatedSynonym>
        <rdfs:label>pancreas disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002367 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002367">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006295"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021163"/>
        <obo:IAO_0000115>Primary or metastatic malignant neoplasm involving the kidney.</obo:IAO_0000115>
        <rdfs:label>kidney cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002406 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002406">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005093"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021166"/>
        <obo:IAO_0000115>An inflammatory process affecting the skin. Signs include red rash, itching, and blister formation. Representative examples are contact dermatitis, atopic dermatitis, and seborrheic dermatitis.</obo:IAO_0000115>
        <rdfs:label>dermatitis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002409 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002409">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_7770006"/>
        <obo:IAO_0000115>A disease involving the auditory system.</obo:IAO_0000115>
        <rdfs:label>auditory system disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002427 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002427">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005560"/>
        <obo:IAO_0000115>Diseases that affect the structure or function of the cerebellum. Cardinal manifestations of cerebellar dysfunction include dysmetria, gait ataxia, and muscle hypotonia.</obo:IAO_0000115>
        <rdfs:label>cerebellar disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002428 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002428">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005135"/>
        <obo:IAO_0000115>An infection that is caused by protozoans.</obo:IAO_0000115>
        <rdfs:label>protozoa infectious disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002429 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002429">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005249"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0700007"/>
        <obo:IAO_0000115>A class of diffuse lung diseases that typically affect the pulmonary interstitium, although some also have a component affecting the airways (for instance, Cryptogenic organizing pneumonitis).</obo:IAO_0000115>
        <rdfs:label>idiopathic interstitial pneumonia</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002436 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002436">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0024623"/>
        <obo:IAO_0000115>A disease involving the nose.</obo:IAO_0000115>
        <rdfs:label>nasal disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002447 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002447">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005213"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011962"/>
        <obo:IAO_0000115>A malignant tumor arising from the epithelium that lines the cavity of the uterine body. The vast majority of endometrial carcinomas are adenocarcinomas; squamous cell and adenosquamous carcinomas represent a minority of the cases. Endometrioid adenocarcinoma is the most frequently seen variant of endometrial adenocarcinoma. Uterine bleeding is an initial clinical sign. The prognosis depends on the stage of the tumor, the depth of myometrial wall invasion, and the degree of differentiation.</obo:IAO_0000115>
        <rdfs:label>endometrial carcinoma</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002465 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002465">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005275"/>
        <obo:IAO_0000115>Inflammation of the bronchioles characterized by swelling of the bronchioles and mucus accumulation. It is usually caused by the respiratory syncytial virus and affects children. Signs and symptoms include coughing, wheezing, and shortness of breath.</obo:IAO_0000115>
        <rdfs:label>bronchiolitis</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002480 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002480">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005626"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021148"/>
        <obo:IAO_0000115>A benign, borderline, or malignant epithelial tumor of the female reproductive system characterized by the presence of glands and/or cysts lined by neoplastic cells that resemble endometrial cells.</obo:IAO_0000115>
        <rdfs:label>endometrioid tumor</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002488 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002488">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021100"/>
        <obo:IAO_0000115>A benign or malignant epithelial neoplasm that arises anywhere in the ductal system of the breast. This category includes intraductal papilloma, intraductal papillary carcinoma, ductal hyperplasia with or without atypia, and ductal carcinoma in situ.</obo:IAO_0000115>
        <rdfs:label>intraductal breast neoplasm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002491 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002491">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002494"/>
        <obo:IAO_0000115>The use of a drug for a reason other than which it was intended or in a manner or in quantities other than directed.</obo:IAO_0000115>
        <rdfs:label>substance abuse</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002492 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002492">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001106"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0020683"/>
        <obo:IAO_0000115>Sudden and sustained deterioration of the kidney function characterized by decreased glomerular filtration rate, increased serum creatinine or oliguria.</obo:IAO_0000115>
        <rdfs:label>acute kidney injury</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002494 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002494">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002025"/>
        <obo:IAO_0000115>A category of psychiatric disorders which include disorders related to the taking of a drug of abuse (including alcohol, prescribed medications and recreational drugs).</obo:IAO_0000115>
        <rdfs:label>substance-related disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002514 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002514">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002515"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021223"/>
        <obo:IAO_0000115>A benign or malignant neoplasm that affects the liver parenchyma, bile ducts, and gallbladder. Representative examples of benign neoplasms include hepatocellular adenoma, bile duct adenoma, and gallbladder lipoma. Representative examples of malignant neoplasms include hepatocellular carcinoma, intrahepatic and extrahepatic cholangiocarcinoma, and gallbladder carcinoma.</obo:IAO_0000115>
        <rdfs:label>hepatobiliary neoplasm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002515 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002515">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004335"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects the liver, bile ducts, and gallbladder. Representative examples of non-neoplastic disorders include hepatitis, cirrhosis, cholangitis, and cholecystitis. Representative examples of neoplastic disorders include hepatocellular adenoma, hepatocellular carcinoma, and cholangiocarcinoma.</obo:IAO_0000115>
        <rdfs:label>hepatobiliary disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002516 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002516">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004335"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004992"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021223"/>
        <obo:IAO_0000115>A primary or metastatic malignant neoplasm involving any part of the digestive system.</obo:IAO_0000115>
        <rdfs:label>digestive system cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002525 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002525">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019052"/>
        <obo:IAO_0000115>An inherited metabolic disorder caused by an enzyme deficiency, resulting in an inability to oxidize fatty acids for energy production.</obo:IAO_0000115>
        <rdfs:label>inherited lipid metabolism disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002529 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002529">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002656"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005096"/>
        <obo:IAO_0000115>A carcinoma arising from the squamous cells of the epidermis. Skin squamous cell carcinoma is most commonly found on sun-exposed areas. The majority of the tumors are well-differentiated.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CSCC</oboInOwl:hasRelatedSynonym>
        <rdfs:label>skin squamous cell carcinoma</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002531 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002531">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005070"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005093"/>
        <obo:IAO_0000115>A benign or malignant tumor involving the skin. Representative examples of benign skin neoplasms include the benign melanocytic skin nevus, acanthoma, sebaceous adenoma, sweat gland adenoma, lipoma, hemangioma, fibroma, and benign fibrous histiocytoma. Representative examples of malignant skin neoplasms include basal cell carcinoma, squamous cell carcinoma, melanoma, and Kaposi sarcoma.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>skin</oboInOwl:hasRelatedSynonym>
        <rdfs:label>skin neoplasm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002532 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002532">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005626"/>
        <obo:IAO_0000115>A neoplasm that is composed of squamous epithelial cells. Squamous cell carcinoma is a representative example.</obo:IAO_0000115>
        <rdfs:label>squamous cell neoplasm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002545 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002545">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002602"/>
        <obo:IAO_0000115>A disease involving the spinal cord.</obo:IAO_0000115>
        <rdfs:label>spinal cord disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002546 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002546">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002547"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0016752"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021637"/>
        <obo:IAO_0000115>A benign, usually encapsulated slow growing tumor composed of Schwann cells. It affects peripheral and cranial nerves. It recurs infrequently and only rare cases associated with malignant transformation have been reported.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SCHW</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>neurolemmoma</oboInOwl:hasRelatedSynonym>
        <rdfs:label>schwannoma</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002547 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002547">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001406"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021042"/>
        <obo:IAO_0000115>A benign or malignant neoplasm arising from the perineural cells in the sheaths surrounding the nerves. Representative examples include neurofibroma, schwannoma, and malignant peripheral nerve sheath tumor.</obo:IAO_0000115>
        <rdfs:label>nerve sheath neoplasm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002562 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002562">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005559"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021147"/>
        <obo:IAO_0000115>A broad group of disorders that affect the myelin sheaths that cover the neurons. Myelin sheathes cover neuronal axons in the central and peripheral nervous system and function to increase traveling impulse speeds. Disruption of this sheath impairs neuronal transmission and can result in disorders such as multiple sclerosis and Guillain-Barre syndrome, among others.</obo:IAO_0000115>
        <rdfs:label>demyelinating disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002567 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002567">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0000270"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004867"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects the trachea. Representative examples of non-neoplastic disorders include congenital malformations and infection. Representative examples of neoplastic disorders include carcinoma and lymphoma.</obo:IAO_0000115>
        <rdfs:label>tracheal disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002602 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002602">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005071"/>
        <obo:IAO_0000115>A disease involving the central nervous system.</obo:IAO_0000115>
        <rdfs:label>central nervous system disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002614 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002614">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005381"/>
        <obo:IAO_0000115>Inflammation of the bone.</obo:IAO_0000115>
        <rdfs:label>bone inflammation disease</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002616 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002616">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005070"/>
        <obo:IAO_0000115>A benign, intermediate, or malignant neoplasm that arises from the mesenchyma-derived cells of the soft tissue or bone. Representative examples include lipoma, leiomyoma, leiomyosarcoma and osteosarcoma.</obo:IAO_0000115>
        <rdfs:label>mesenchymal cell neoplasm</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002635 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002635">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005172"/>
        <obo:IAO_0000115>An inflammatory process of the gingival tissues and/or periodontal membrane of the teeth, resulting in an abnormally deep gingival sulcus, possibly producing periodontal pockets and loss of alveolar bone support.</obo:IAO_0000115>
        <rdfs:label>periodontal disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002654 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002654">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002263"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects the uterine corpus or the cervix. Representative examples of non-neoplastic disorders include endometritis and cervicitis. Representative examples of neoplastic disorders include endometrial carcinoma, carcinosarcoma, and cervical carcinoma.</obo:IAO_0000115>
        <rdfs:label>uterine disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002656 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002656">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002898"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004993"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021634"/>
        <obo:IAO_0000115>A carcinoma that arises from epithelial cells of the zone of skin</obo:IAO_0000115>
        <rdfs:label>skin carcinoma</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002657 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002657">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_7770006"/>
        <obo:IAO_0000115>A disease involving the breast.</obo:IAO_0000115>
        <rdfs:label>breast disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002659 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002659">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002236"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021225"/>
        <obo:IAO_0000115>A primary or metastatic malignant neoplasm that affects the choroid, ciliary body, or iris.</obo:IAO_0000115>
        <rdfs:label>uveal cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002661 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002661">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005328"/>
        <obo:IAO_0000115>A non-neoplastic or neoplastic disorder that affects the uvea. Representative examples include uveitis, chorioretinitis, and uveal melanoma.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>disorder of uveal tract</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>uveal diseases</oboInOwl:hasRelatedSynonym>
        <rdfs:label>uveal disorder</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002679 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002679">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005394"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_1060198"/>
        <obo:IAO_0000115>An ischemic condition of the brain, producing a persistent focal neurological deficit in the area of distribution of the cerebral arteries.</obo:IAO_0000115>
        <rdfs:label>cerebral infarction</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002691 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002691">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002516"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021069"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0024477"/>
        <obo:IAO_0000115>An epithelial or non-epithelial malignant neoplasm that arises from the liver. Representative examples include hepatocellular carcinoma, intrahepatic cholangiocarcinoma, lymphoma, and sarcoma.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>primary cancer of liver</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>primary tumor of the liver</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>primary tumour of the liver</oboInOwl:hasRelatedSynonym>
        <rdfs:label>liver cancer</rdfs:label>
    </owl:Class>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002691"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>primary tumour of the liver</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003005"/>
    </owl:Axiom>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002714 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002714">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005872"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006130"/>
        <obo:IAO_0000115>A malignant neoplasm involving the central nervous system</obo:IAO_0000115>
        <rdfs:label>central nervous system cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002715 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002715">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0001416"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021353"/>
        <obo:IAO_0000115>Primary or metastatic malignant neoplasm involving the uterine corpus and/or the cervix.</obo:IAO_0000115>
        <rdfs:label>uterine cancer</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002752 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002752">
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004970"/>
        <rdfs:subClassOf rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005140"/>
        <obo:IAO_0000115>An adenocarcinoma that arises from the ovary. It is the most common type of ovarian carcinoma. It includes the serous adenocarcinoma, mucinous adenocarcinoma, clear cell adenocarcinoma, and endometrioid adenocarcinoma.</obo:IAO_0000115>
        <rdfs:label>ovarian adenocarcinoma</rdfs:label>
    </owl:Class>
    


    <!-- http://purl.obolibrary.org/obo/MONDO_0002816 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/MONDO_0002816">
