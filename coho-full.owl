        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0609-2/MediaObjects/41588_2020_609_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>ABCS-F Amsterdam Breast Cancer Study – Familial</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001459"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The familial arm of the Amsterdam Breast Cancer Study, whose cases are breast cancer patients of any age without a pathogenic BRCA1 or BRCA2 mutation who were counselled and tested from 1995 at the family cancer clinic of the Netherlands Cancer Institute – Antoni van Leeuwenhoek Hospital in Amsterdam, and whose controls are healthy women from the general population recruited through the blood bank. The Breast Cancer Association Consortium lists it as a study separate from the main ABCS.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25855707</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27424772</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32424353</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001459"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1769</owl:annotatedTarget>
        <obo:IAO_0000116>cases and controls of the ABCS-F case-control study (2016)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4948019/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>ABCS-F cases (N = 1,769) were selected from the linked databases of the Division of Diagnostic Oncology and the Tumor Registry of the Antoni van Leeuwenhoek hospital in Amsterdam32.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001459"/>
