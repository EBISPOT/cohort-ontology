    <!-- http://www.ebi.ac.uk/coho/COHO_0002727 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002727">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23177"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>MTBLS2806</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of primary and recurrent glioma samples, with genomic data and patient follow-up, from patients treated at Beijing Tiantan Hospital and other hospitals in China, all re-diagnosed by independent neuropathologists and made available through a cross-omics data portal.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CGGA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CGGA cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">Chinese Glioma Genome Atlas</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23177">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0021042"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002727"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23177"/>
        <obo:IAO_0000116>glioma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8498921/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>According to the pathological reassessment of independent neuropathologists, all the subjects were consistently diagnosed with glioma and were then further classified according to the 2007/2016 WHO classification system.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002727"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8498921/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Glioma tissues and corresponding genomic data and patient follow-up information were obtained from Beijing Tiantan Hospital at Capital Medical University, Tianjin Medical University General Hospital, Sanbo Brain Hospital at Capital Medical University, the Second Affiliated Hospital of Harbin Medical University, the First Affiliated Hospital of Nanjing Medical University, and the First Hospital of China Medical University.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002727"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS2806</owl:annotatedTarget>
        <dcterms:title>SNAP25 Inhibits Glioma Progression by Regulating Synapse Plasticity via GLS-Mediated Glutaminolysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34490096</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS2806</oboInOwl:hasDbXref>
        <rdfs:comment>Cox proportional hazards regression analysis and survival analysis indicated that the candidate gene SNAP25 could differentiate the outcome of low- and high-risk patients, and the Chinese Glioma Genome Atlas (CGGA) cohort was used for validation of the data set.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002727"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of primary and recurrent glioma samples, with genomic data and patient follow-up, from patients treated at Beijing Tiantan Hospital and other hospitals in China, all re-diagnosed by independent neuropathologists and made available through a cross-omics data portal.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33662628</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002727"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CGGA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002728 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002728">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23183"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>MTBLS205</obo:IAO_0000112>
        <obo:IAO_0000115>A French national cohort of haematopoietic stem cell transplant recipients, and for some of them their donors, sampled before transplantation, at 100 days, one and two years afterwards and when graft-versus-host disease occurred, to study the complications of haematopoietic stem cell transplantation.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5900</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>CRYOSTEM Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CRYOSTEM cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CRYOSTEM collection</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cryostem biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">CRYOSTEM</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23183">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0013730"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002728"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23183"/>
        <obo:IAO_0000116>Graft-versus-Host Disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.cryostem.org/en/about-cryostem/ethics-and-regulation/</oboInOwl:hasDbXref>
        <rdfs:comment>The initial objective of the constitution of the collection was to conduct research in the field of GvHD, being the major complication of HSCT. This research topic was broadened to all the complications of HSCT, after validation in March 2016 by the Committee of the Protection of Persons – CPP – South Mediterranean I.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002728"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6910937/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients and their related donors analyzed in this study underwent an allogeneic HSCT in Saint Louis hospital, Paris, France (cohort 1, n = 43) or in one of the 33 French national transplant centers involved in CRYOSTEM Consortium, funded under the French Government’s National Investment Program (Investissement d’avenir) (cohort 2, n = 56).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002728"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS205</owl:annotatedTarget>
        <dcterms:title>Metabolomics analysis of human acute graft-versus-host disease reveals changes in host and microbiota-derived metabolites.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31836702</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS205</oboInOwl:hasDbXref>
        <rdfs:comment>A first monocentric cohort from Saint Louis hospital (Paris, France) was used as an exploratory cohort (n=43) and a second multicentric national cohort from Cryostem biobank was used as a confimatory cohort (n=56).Metabolomic profile markedly differed between recipients and donors.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002728"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A French national cohort of haematopoietic stem cell transplant recipients, and for some of them their donors, sampled before transplantation, at 100 days, one and two years afterwards and when graft-versus-host disease occurred, to study the complications of haematopoietic stem cell transplantation.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.cryostem.org/en/about-cryostem/</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002728"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">5900</owl:annotatedTarget>
        <obo:IAO_0000116>transplant recipients sampled up to the end of collection on 31 December 2021 (the source says &apos;more than 5,900&apos;), besides 2,400 donors</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.cryostem.org/en/about-cryostem/</oboInOwl:hasDbXref>
        <rdfs:comment>Today, this national collective has made it possible to constitute a collection rich in the biological resources of 82% of transplanted patients in France, i.e. nearly 200,000 biological samples taken pre- and post-transplant, from more than 5,900 patients and 2,400 donors (data as of December 31, 2021 – date of the end of collection).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002729 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002729">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid23189"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>MTBLS2394</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium formed in 1981 by the Dana-Farber Cancer Institute and other institutions in the United States and Canada that has conducted consecutive multi-institutional clinical trial protocols in childhood acute lymphoblastic leukaemia.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DFCI ALL Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Dana Farber Cancer Institute ALL Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Dana-Farber Cancer Institute (DFCI) acute lymphoblastic leukemia (ALL) Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">Dana-Farber Cancer Institute ALL Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23189">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004967"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002729"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23189"/>
        <obo:IAO_0000116>acute lymphoblastic leukemia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2820141/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Between 1985–2000, 1457 children aged 0–18 years with newly diagnosed ALL (excluding mature B-cell ALL) were enrolled on four consecutive DFCI ALL Consortium protocols: 85-01 (1981–5, N=220), 87-01 (1987–91, N=369), 91-01 (1991–5, N=377) and 95-01 (1996–2000, N=491).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002729"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2820141/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>In 1981, DFCI and several other institutions in the United States and Canada formed the DFCI ALL Consortium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002729"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS2394</owl:annotatedTarget>
        <dcterms:title>Impact of acute lymphoblastic leukemia induction therapy: findings from metabolomics on non-fasted plasma samples from a biorepository.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34175981</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS2394</oboInOwl:hasDbXref>
        <rdfs:comment>Several chemotherapies intercept cancer metabolism, but little is known about their collective role in altering host metabolism.OBJECTIVES: We profiled the metabolomic changes in plasma of ALL patients initial- and post- induction therapy.METHODS: We exploited a biorepository of non-fasted plasma samples derived from the Dana Farber Cancer Institute ALL Consortium; these samples were obtained from 50 ALL patients initial- and post-induction therapy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002729"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium formed in 1981 by the Dana-Farber Cancer Institute and other institutions in the United States and Canada that has conducted consecutive multi-institutional clinical trial protocols in childhood acute lymphoblastic leukaemia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20016537</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002729"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DFCI ALL Consortium</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002730 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002730">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23195"/>
        <rdf:type rdf:nodeID="genid23197"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Tanzania"/>
        <obo:IAO_0000112>MTBLS13213</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised, placebo-controlled, factorial trial of antimicrobials (azithromycin and nitazoxanide) and nicotinamide in children recruited within the first 14 days of life in rural Haydom, Tanzania, followed with their mothers through monthly home visits, with the child&apos;s length-for-age at 18 months as its primary outcome.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1188</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ELICIT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ELICIT trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Early Life Interventions for Childhood Growth and Development In Tanzania</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Early Life Interventions for Childhood growth and development in Tanzania</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">Early Life Interventions for Childhood Growth and Development in Tanzania</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23195">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0004322"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid23197">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0900090"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002730"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23195"/>
        <obo:IAO_0000116>stunting</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34582462+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Our goal was to test whether administration of scheduled antimicrobials and daily nicotinamide improved linear growth in a region with a high prevalence of stunting and enteric pathogen carriage.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002730"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23197"/>
        <obo:IAO_0000116>nicotinamide</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34582462+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Those randomized to nicotinamide arm received daily nicotinamide to the mother (250 mg pills months 0 to 6) and to the child (100 mg sachets months 6 to 18).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002730"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Tanzania"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6042604/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Haydom is a rural area in north-central Tanzania, approximately 300 km west of Arusha, the nearest urban centre.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002730"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS13213</owl:annotatedTarget>
        <dcterms:title>Birth season shapes the infant metabolome and development in Tanzania: a secondary explorative analysis of the early life interventions for childhood growth and development in Tanzania (ELICIT) trial.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41390468</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS13213</oboInOwl:hasDbXref>
        <rdfs:comment>Birth season shapes the infant metabolome and development in Tanzania: a secondary explorative analysis of The Early Life Interventions for Childhood growth and development in Tanzania (ELICIT) trial</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002730"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised, placebo-controlled, factorial trial of antimicrobials (azithromycin and nitazoxanide) and nicotinamide in children recruited within the first 14 days of life in rural Haydom, Tanzania, followed with their mothers through monthly home visits, with the child&apos;s length-for-age at 18 months as its primary outcome.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29982218</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002730"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1188</owl:annotatedTarget>
        <obo:IAO_0000116>children randomized between September 2017 and August 2018</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34582462+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Between September 5, 2017 and August 31, 2018, 1,188 children were randomized, of whom 1,084 (n = 277 placebo/placebo, 273 antimicrobial/placebo, 274 placebo/nicotinamide, and 260 antimicrobial/nicotinamide) were included in the modified intention-to-treat analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002730"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ELICIT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002731 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002731">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23204"/>
        <rdf:type rdf:nodeID="genid23206"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>MTBLS690</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of pancreatic islets and of liver, muscle, fat and other tissues, with donor information and disease history, from organ donors, established in 2007 by Lund University and Uppsala University within the Excellence of Diabetes Research in Sweden (EXODIAB) collaboration.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>EXODIAB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EXODIAB biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Excellence in Diabetes biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HTL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">Human Tissue Laboratory</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23204">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005147"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid23206">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002731"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23204"/>
        <obo:IAO_0000116>type 1 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ludc.lu.se/resources/human-tissue-laboratory</oboInOwl:hasDbXref>
        <rdfs:comment>HTL’s access to all tissues involved in diabetes from the same individuals allows the researchers to map the genetic and environmental factors that may cause type 1 diabetes and type 2 diabetes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002731"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23206"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ludc.lu.se/resources/human-tissue-laboratory</oboInOwl:hasDbXref>
        <rdfs:comment>HTL’s access to all tissues involved in diabetes from the same individuals allows the researchers to map the genetic and environmental factors that may cause type 1 diabetes and type 2 diabetes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002731"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6609645/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A collaborative initiative between the universities of Uppsala and Lund created the Human Tissue Laboratory (HTL) funded by a strategic grant from the Excellence of Diabetes Research in Sweden (EXODIAB). They have created a large biobank of tissue samples from deceased human multi-organ donors.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002731"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS690</owl:annotatedTarget>
        <dcterms:title>Intra- and inter-individual metabolic profiling highlights carnitine and lysophosphatidylcholine pathways as key molecular defects in type 2 diabetes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31273253</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS690</oboInOwl:hasDbXref>
        <rdfs:comment>The samples originate from the Excellence in Diabetes biobank (EXODIAB) in Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002731"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of pancreatic islets and of liver, muscle, fat and other tissues, with donor information and disease history, from organ donors, established in 2007 by Lund University and Uppsala University within the Excellence of Diabetes Research in Sweden (EXODIAB) collaboration.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ludc.lu.se/resources/human-tissue-laboratory</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002731"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">200</owl:annotatedTarget>
        <obo:IAO_0000116>multi-organ donors in the biobank (the source says &apos;more than 200&apos;), 2019</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6609645/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The subjects were selected from a cohort of more than 200 multi-organ donors from the EXODIAB biobank with no statistical difference for age, body-mass index (BMI) and gender across the different phenotypes to accurately capture the metabolic fingerprint of T2D onset.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002731"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EXODIAB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002731"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HTL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002732 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002732">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23214"/>
        <rdf:type rdf:nodeID="genid23216"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>MTBLS198</obo:IAO_0000112>
        <obo:IAO_0000115>A single-blind, parallel, randomised controlled dietary intervention trial in which men and women with low fruit and vegetable intake and at least a 1.5-fold increased risk of cardiovascular disease were assigned to high-flavonoid or low-flavonoid fruit and vegetables or to their habitual diet, to measure the dose-response relation with vascular function and other cardiovascular risk indicators.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">174</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>FLAVURS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FLAVURS trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">FLAVonoids: University of Reading Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23214">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid23216">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0070232"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002732"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23214"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22476876+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Participants with a CVD relative risk of 1.5 assessed by risk scores were randomly assigned to one of the 3 groups: habitual (control, CT), high-flavonoid (HF) or low-flavonoid (LF) diets.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002732"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23216"/>
        <obo:IAO_0000116>flavonoid-rich versus flavonoid-poor fruit and vegetables</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.isrctn.com/api/query/format/default?q=FLAVURS</oboInOwl:hasDbXref>
        <rdfs:comment>To determine the impact of different amounts and types (flavonoid-rich versus flavonoid-poor) of fruit and vegetables on heart disease risk factors in an &apos;at risk&apos; group.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002732"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24452238+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Hugh Sinclair Unit of Human Nutrition (ALM, TWG, MFC, DSA, YJ, AV, JPES, OBK, KMT, A-MM, MHG, and JAL), and the Institute for Cardiovascular and Metabolic Research, Department of Food and Nutritional Sciences (ALM and JAL), University of Reading, Reading, Berkshire, United Kingdom.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002732"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS198</owl:annotatedTarget>
        <dcterms:title>Urinary metabolomic profiling to identify biomarkers of a flavonoid-rich and flavonoid-poor fruits and vegetables diet in adults: the FLAVURS trial</dcterms:title>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS198</oboInOwl:hasDbXref>
        <rdfs:comment>Urinary metabolomic profiling to identify biomarkers of a flavonoid-rich and flavonoid-poor fruits and vegetables diet in adults: the FLAVURS trial</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002732"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A single-blind, parallel, randomised controlled dietary intervention trial in which men and women with low fruit and vegetable intake and at least a 1.5-fold increased risk of cardiovascular disease were assigned to high-flavonoid or low-flavonoid fruit and vegetables or to their habitual diet, to measure the dose-response relation with vascular function and other cardiovascular risk indicators.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24452238</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002732"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">174</owl:annotatedTarget>
        <obo:IAO_0000116>low fruit and vegetable consumers at increased cardiovascular risk randomly assigned</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24452238+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Male and female low-F&amp;V consumers who had a ≥ 1.5-fold increased risk of CVD (n = 174) were randomly assigned to receive an HF F&amp;V, an LF F&amp;V, or a habitual diet, with HF and LF F&amp;V amounts sequentially increasing by 2, 4, and 6 (+2, +4, and +6) portions/d every 6 wk over habitual intakes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002732"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FLAVURS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002733 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002733">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23223"/>
        <rdf:type rdf:nodeID="genid23225"/>
        <rdf:type rdf:nodeID="genid23227"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>MTBLS89</obo:IAO_0000112>
        <obo:IAO_0000115>A study in which young healthy male volunteers underwent a highly controlled four-day challenge protocol of 36 hours of fasting, oral glucose and lipid tests, liquid test meals, physical exercise and cold stress, with blood, urine, exhaled air and breath condensate analysed at up to 56 time points, to analyse the dynamics of the human metabolome in response to environmental stimuli.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HuMet</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HuMet Repository</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HuMet study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">Human Metabolome study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23223">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0001057"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid23225">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_2000118"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid23227">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_6000002"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002733"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23223"/>
        <obo:IAO_0000116>cold stress</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22426117+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To analyze the dynamics of the human metabolome in response to environmental stimuli, we submitted 15 young healthy male volunteers to a highly controlled 4 d challenge protocol, including 36 h fasting, oral glucose and lipid tests, liquid test meals, physical exercise, and cold stress.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002733"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23225"/>
        <obo:IAO_0000116>36 h fasting</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22426117+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To analyze the dynamics of the human metabolome in response to environmental stimuli, we submitted 15 young healthy male volunteers to a highly controlled 4 d challenge protocol, including 36 h fasting, oral glucose and lipid tests, liquid test meals, physical exercise, and cold stress.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002733"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23227"/>
        <obo:IAO_0000116>physical exercise</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22426117+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To analyze the dynamics of the human metabolome in response to environmental stimuli, we submitted 15 young healthy male volunteers to a highly controlled 4 d challenge protocol, including 36 h fasting, oral glucose and lipid tests, liquid test meals, physical exercise, and cold stress.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002733"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_json/PMC11513335/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The present work is based on samples of the Human Metabolome (HuMet) study conducted at the Human Study Center of the Else-Kröner-Fresenius Center of Nutritional Medicine at the Technical University Munich.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002733"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS89</owl:annotatedTarget>
        <dcterms:title>The HuMet Repository: Watching human metabolism at work.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39033506</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS89</oboInOwl:hasDbXref>
        <rdfs:comment>We present the HuMet Repository for exploring dynamic metabolic responses to oral glucose/lipid loads, mixed meals, 36-h fasting, exercise, and cold stress in healthy subjects.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002733"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study in which young healthy male volunteers underwent a highly controlled four-day challenge protocol of 36 hours of fasting, oral glucose and lipid tests, liquid test meals, physical exercise and cold stress, with blood, urine, exhaled air and breath condensate analysed at up to 56 time points, to analyse the dynamics of the human metabolome in response to environmental stimuli.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22426117</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002733"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">15</owl:annotatedTarget>
        <obo:IAO_0000116>young healthy male participants</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_json/PMC11513335/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, 15 healthy male participants were recruited for the study. Participants were young (mean age of 27.8 years ±2.9), had normal weight (mean body mass index (BMI) of 23.1 kg/m2 ± 1.8), did not take any medication, and did not show any metabolic abnormalities.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002733"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HuMet</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002734 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002734">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid23234"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>MTBLS850</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective longitudinal study of adults hospitalised with COVID-19 in the United States, launched in May 2020 by the National Institute of Allergy and Infectious Diseases, following their clinical course and immune responses through serial sampling.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1164</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>IMPACC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IMPACC study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IMmunoPhenotyping Assessment in a COVID-19 Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#MetaboLight_subset"/>
        <rdfs:label xml:lang="en">Immunophenotyping Assessment in a COVID-19 Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid23234">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0100096"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002734"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid23234"/>
        <obo:IAO_0000116>COVID-19</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://clinicaltrials.gov/api/v2/studies/NCT04378777</oboInOwl:hasDbXref>
        <rdfs:comment>The study population consists of adult participants hospitalized with known or presumptive coronavirus disease 2019 (COVID-19), a human disease caused by Severe Acute Respiratory Syndrome Coronavirus-2 (SARS-CoV-2) infection.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002734"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10764789/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients 18 years and older admitted to 20 US hospitals (affiliated with 15 academic institutions) between May 2020 and March 2021 were enrolled within 72 h of hospital admission for COVID-19 infection.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002734"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>MTBLS850</owl:annotatedTarget>
        <dcterms:title>Features of acute COVID-19 associated with post-acute sequelae of SARS-CoV-2 phenotypes: results from the IMPACC study.</dcterms:title>
