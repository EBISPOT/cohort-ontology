        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002465"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>GABRIEL TOMSK study (childhood-onset asthma) TOMSK-ch European Russia Family study</rdfs:comment>
