    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001853">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16476"/>
        <rdf:type rdf:nodeID="genid16478"/>
