    <!-- http://www.ebi.ac.uk/coho/COHO_0001734 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001734">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15506"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000711"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001882"/>
        <obo:IAO_0000112>PMID:35390065</obo:IAO_0000112>
        <obo:IAO_0000115>An observational, community-based prospective cohort study of cardiovascular risk factors and outcomes in adults, whose family-based population sample was randomly recruited between 1985 and 2010, stratified by age and sex, from a geographically defined area in northeastern Belgium, and followed up with in-person examinations and records of health outcomes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3343</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>FLEMENGHO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FLEMENGHO study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FLEmish study on Environment, Genes and Health Outcome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Flemish Study on Environment, Genes, and Health Outcomes</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Flemish Study on Environment, Genes and Health Outcomes</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15506">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004995"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001734"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15506"/>
        <obo:IAO_0000116>cardiovascular disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12445332/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Flemish Study on Environment, Genes, and Health Outcomes (FLEMENGHO) is an observational, community-based cohort study on cardiovascular risk factors and outcomes in the adult Belgian population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001734"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12445332/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Between 1985 and 2010, we randomly recruited a family-based population sample, stratified by age and sex, from a geographically defined area in northeastern Belgium, as described previously.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001734"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:35390065</owl:annotatedTarget>
        <dcterms:title>Association of colorectal cancer with genetic and epigenetic variation in PEAR1-A population-based cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35390065</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35390065+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We therefore tested the association of incident colorectal cancer and genetic and epigenetic variability in PEAR1 among 2532 randomly recruited participants enrolled in the family-based Flemish Study on Environment, Genes and Health Outcomes (51.2% women; mean age 44.8 years).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001734"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An observational, community-based prospective cohort study of cardiovascular risk factors and outcomes in adults, whose family-based population sample was randomly recruited between 1985 and 2010, stratified by age and sex, from a geographically defined area in northeastern Belgium, and followed up with in-person examinations and records of health outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35390065</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40979826</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001734"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3343</owl:annotatedTarget>
        <obo:IAO_0000116>participants enrolled from 1985 to 2007 (1985-2007)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8989234/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Of 3343 participants, we excluded 811 from analysis, because blood stored in the biobank had been depleted or the DNA was degraded (n = 453), because participants were younger than 20 years old at enrolment and therefore not at risk (n = 393), because they had a history of colorectal cancer prior to enrolment (n = 4), because they had been lost to follow-up (n = 37), or because their rs12566888 genotype was missing (n = 4).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001734"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FLEMENGHO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001735 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001735">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>PMID:22216207</obo:IAO_0000112>
        <obo:IAO_0000115>The second phase of the Fleurbaix Laventie Ville Santé study: a prospective, community-based study of nuclear families (parents and their children) living in the two small towns of Fleurbaix and Laventie in northern France, recruited in 1999 among the families of the first phase (FLVS I, families with a child in primary school in 1992) and examined again in 2001, to identify determinants of adiposity and of weight and adiposity changes in the general population.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1175</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>FLVS II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FLVS II Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FLVS-II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fleurbaix Laventie Ville Santé II Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fleurbaix Laventie Ville Santé II study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fleurbaix Laventie Ville Santé Study II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fleurbaix-Laventie Ville Sant_ II study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Fleurbaix-Laventie Ville-Santé II study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Fleurbaix-Laventie Ville Santé II study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001735"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3247254/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Nuclear families, defined as family groups consisting of a father and/or mother and their children who share living quarters, were drawn from the Fleurbaix-Laventie Ville-Santé II (FLVS II) study, a prospective study (1999–2001) aimed at identifying determinants of adiposity and its changes over time in families living in two small towns in Northern France, Fleurbaix and Laventie [16], [17].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001735"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22216207</owl:annotatedTarget>
        <dcterms:title>Parent-offspring correlations in pedometer-assessed physical activity.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22216207</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3247254/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Nuclear families, defined as family groups consisting of a father and/or mother and their children who share living quarters, were drawn from the Fleurbaix-Laventie Ville-Santé II (FLVS II) study, a prospective study (1999–2001) aimed at identifying determinants of adiposity and its changes over time in families living in two small towns in Northern France, Fleurbaix and Laventie [16], [17].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001735"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The second phase of the Fleurbaix Laventie Ville Santé study: a prospective, community-based study of nuclear families (parents and their children) living in the two small towns of Fleurbaix and Laventie in northern France, recruited in 1999 among the families of the first phase (FLVS I, families with a child in primary school in 1992) and examined again in 2001, to identify determinants of adiposity and of weight and adiposity changes in the general population.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20433707</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22216207</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fng.2247/MediaObjects/41588_2012_BFng2247_MOESM24_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001735"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1175</owl:annotatedTarget>
        <obo:IAO_0000116>parents and children aged 8 or more in the 294 families that joined the 1999 baseline examination</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2043091/</oboInOwl:hasDbXref>
        <rdfs:comment>In 1999, 393 families were still residing in the area, and 294 (1175 parents and children ≥ 8 y) of them accepted to participate in the baseline examination of Phase II.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001735"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FLVS II</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001735"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FLVS-II</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


