        <obo:IAO_0000112>PMID:20010834</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing collection, in Nottingham and funded by the University of Nottingham, of smokers of European ancestry over 40 years of age with a smoking history of more than 10 pack-years, whose lung function (FEV1 and FVC) was measured by spirometry at enrolment, before and after bronchodilation, and from which people with asthma were excluded; divided by spirometry into COPD cases and smoking controls, it has served as a follow-up sample in genetic association studies of lung function and COPD.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">538</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Nottingham Smokers Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nottingham Smokers cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nottingham Smokers study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nottingham_Smokers</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Nottingham Smokers</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid18768">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_participants_at_risk_of"/>
