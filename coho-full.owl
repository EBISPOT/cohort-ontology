    <owl:AnnotationProperty rdf:about="http://www.ebi.ac.uk/coho#PRIDE_subset">
        <obo:IAO_0000115 xml:lang="en">The cohorts that datasets in the PRIDE proteomics archive draw on.</obo:IAO_0000115>
        <rdfs:label>PRIDE_subset</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.ebi.ac.uk/coho/numberOfCases -->

    <owl:AnnotationProperty rdf:about="http://www.ebi.ac.uk/coho/numberOfCases">
        <obo:IAO_0000115 xml:lang="en">The number of cases a cohort reports, as its own design or profile paper or website states it: the participants with the condition under study in a case-control study. It is the number a source states, never one derived; the assertion carries that source, the sentence stating the number and what it counts. Asserted beside numberOfParticipants, or instead of it where no source states a total.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">numberOfCases</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.ebi.ac.uk/coho/numberOfControls -->

    <owl:AnnotationProperty rdf:about="http://www.ebi.ac.uk/coho/numberOfControls">
        <obo:IAO_0000115 xml:lang="en">The number of controls a cohort reports, as its own design or profile paper or website states it: the participants without the condition under study in a case-control study. It is the number a source states, never one derived; the assertion carries that source, the sentence stating the number and what it counts. Asserted beside numberOfParticipants, or instead of it where no source states a total.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">numberOfControls</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.ebi.ac.uk/coho/numberOfParticipants -->

    <owl:AnnotationProperty rdf:about="http://www.ebi.ac.uk/coho/numberOfParticipants">
        <obo:IAO_0000115 xml:lang="en">The number of participants a cohort reports: the people it enrolled or recruited, as its own design or profile paper or website states them, or, for a cohort aggregation, the pooled number of participants in its main analysis. It is the number a source states, never one computed, summed or inferred; the assertion carries that source, the sentence stating the number and what it counts. A definition never gives a size.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">numberOfParticipants</rdfs:label>
        <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    </owl:AnnotationProperty>
    


