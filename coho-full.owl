    <!-- http://www.ebi.ac.uk/coho/COHO_0001834 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001834">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid16333"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001848"/>
        <obo:IAO_0000112>PMID:22158537</obo:IAO_0000112>
        <obo:IAO_0000115>A type 2 diabetes case-control sample of Korean adults contributed by the Korea National Institute of Health to the Asian Genetic Epidemiology Network&apos;s type 2 diabetes meta-analysis. Its cases, with type 2 diabetes of onset at age 40 or older, were drawn from the population-based Health2 cohort of the Korean Genome and Epidemiology Study; its controls, without diabetes or anti-diabetic medication and with normal fasting glucose, came partly from the Health2 cohort (those older than 60 with a normal oral glucose tolerance test) and partly from the Health Examinee (HEXA) shared control study. It was genotyped genome-wide on the Affymetrix Genome-Wide Human SNP Array 6.0.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1183</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1305</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2488</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>H2T2DS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HT2DS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Health2 T2D Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid16333">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001834"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid16333"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1,183 T2D cases were selected from population-based &apos;Health2 cohort&apos;.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001834"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Health2 cohort recruited a total of 8,500 participants aged 40-69 years from five regional cities in Korea based on the Korean Genome Epidemiologic Study (KoGES) project.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001834"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001848"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1,183 T2D cases were selected from population-based &apos;Health2 cohort&apos;.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001834"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22158537</owl:annotatedTarget>
        <dcterms:title>Meta-analysis of genome-wide association studies identifies eight new loci for type 2 diabetes in east Asians.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22158537</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3582398/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Stage 2 subjects included 5,843 cases and 4,574 controls from three independent GWA studies including the BioBank Japan Study (BBJ), the Health2 T2D Study (H2T2DS) and the Shanghai Jiao Tong University Diabetes Study (SJTUDS) for in silico replication analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001834"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A type 2 diabetes case-control sample of Korean adults contributed by the Korea National Institute of Health to the Asian Genetic Epidemiology Network&apos;s type 2 diabetes meta-analysis. Its cases, with type 2 diabetes of onset at age 40 or older, were drawn from the population-based Health2 cohort of the Korean Genome and Epidemiology Study; its controls, without diabetes or anti-diabetic medication and with normal fasting glucose, came partly from the Health2 cohort (those older than 60 with a normal oral glucose tolerance test) and partly from the Health Examinee (HEXA) shared control study. It was genotyped genome-wide on the Affymetrix Genome-Wide Human SNP Array 6.0.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22158537</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
