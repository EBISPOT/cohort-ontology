    <!-- http://www.ebi.ac.uk/coho/COHO_0000673 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000673">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000016"/>
        <obo:IAO_0000112>GCST90014287</obo:IAO_0000112>
        <obo:IAO_0000115>A sub-study of the Avon Longitudinal Study of Parents and Children comprising 1,018 mother-offspring pairs with genome-wide DNA methylation profiled at birth, in childhood and in adolescence for the children and at two time points for the mothers, established as an openly accessible resource to study the determinants and consequences of epigenetic variation.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1018</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>ARIES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Accessible Resource for Integrated Epigenomic Studies</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000673"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5593097/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>It recruited more than 14 000 pregnant women in the former county of Avon, who were due to give birth between April 1991 and December 1992.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000673"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000016"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5593097/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>ARIES is a sub-study of the Avon Longitudinal Study of Parents and Children (ALSPAC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000673"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90014287</owl:annotatedTarget>
        <dcterms:title>Genome-wide association studies identify 137 genetic loci for DNA methylation biomarkers of aging.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34187551</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8243879/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The maximum prediction for a single cohort was 4.21% for PAI1 levels in ARIES.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000673"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sub-study of the Avon Longitudinal Study of Parents and Children comprising 1,018 mother-offspring pairs with genome-wide DNA methylation profiled at birth, in childhood and in adolescence for the children and at two time points for the mothers, established as an openly accessible resource to study the determinants and consequences of epigenetic variation.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25991711</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000673"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1018</owl:annotatedTarget>
        <obo:IAO_0000116>mother-offspring pairs (pairs, not individuals), 2014</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5593097/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 1018 mother-child pairs have been profiled (v.1 data release 2014) at each of the five time points indicated, using the Illumina Infinium HumanMethylation450K BeadChip array.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000673"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ARIES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000674 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000674">
