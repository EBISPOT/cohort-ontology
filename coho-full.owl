        <obo:IAO_0000112>PMID:21907864</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective study of childhood asthma, also known as the Melbourne Asthma Study, initiated in 1964 by Howard Williams of the Royal Children’s Hospital, Melbourne, Australia, which recruited four asthma or wheeze groups and a control group of children aged 7 and has followed them into their seventh decade, providing the first prospective evidence linking childhood asthma to the development of COPD; its participants contributed to the Australian Asthma Genetics Consortium’s genome-wide association study.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">484</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MESCA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Melbourne Asthma Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Melbourne Epidemiological Study of Childhood Asthma</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid17923">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002465"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid17925">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0004979"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002054"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17923"/>
        <obo:IAO_0000116>wheezy bronchitis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13331842/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>MESCA started in 1964, when four asthma/wheeze groups and a control group, all aged 7, were recruited and have been followed into their seventh decade.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002054"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid17925"/>
        <obo:IAO_0000116>asthma</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13331842/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>MESCA started in 1964, when four asthma/wheeze groups and a control group, all aged 7, were recruited and have been followed into their seventh decade.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002054"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13331842/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Introduction The study set-up The Melbourne Epidemiological Study of Childhood Asthma (MESCA) also known as the Melbourne Asthma Study, was initiated in 1964 by the late Howard Williams of the Royal Children’s Hospital, Melbourne, with the initial aim of determining the prevalence and describing the natural history of childhood asthma and wheezy bronchitis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21907864</owl:annotatedTarget>
        <dcterms:title>Identification of IL6R and chromosome 11q13.5 as risk loci for asthma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21907864</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3517659/</oboInOwl:hasDbXref>
        <rdfs:comment>Phenotype and genotype collection for MESCA: C.H., M.R., P.LeS., C.R.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002054"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective study of childhood asthma, also known as the Melbourne Asthma Study, initiated in 1964 by Howard Williams of the Royal Children’s Hospital, Melbourne, Australia, which recruited four asthma or wheeze groups and a control group of children aged 7 and has followed them into their seventh decade, providing the first prospective evidence linking childhood asthma to the development of COPD; its participants contributed to the Australian Asthma Genetics Consortium’s genome-wide association study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21907864</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41849083</obo:IAO_0000119>
        <dcterms:contributor>Claude Fable 5.1 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002054"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">484</owl:annotatedTarget>
        <obo:IAO_0000116>combined sample: 401 recruited at age 7 in 1964 plus 83 severe asthmatics added at age 10 (1967)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13331842/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>†The percentages from ages 14 to 50 follow-ups are based on the combined sample of 484 participants (401 original at age 7 + 83 SA added at age 10)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002054"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MESCA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0002055 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002055">
