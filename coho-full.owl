        <oboInOwl:hasRelatedSynonym>Japanese Consortium for Amyotrophic Lateral Sclerosis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Japanese Consortium for Amyotrophic Lateral Sclerosis Research</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Japanese consortium for amyotrophic lateral sclerosis research</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Japanese Consortium for Amyotrophic Lateral Sclerosis research</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid10858">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
