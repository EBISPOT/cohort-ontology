    <!-- http://www.ebi.ac.uk/coho/COHO_0002643 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002643">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>PMID:41606232</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based open cohort of residents aged 65 and older of the Dapu (Dapuqiao) neighbourhood of Huangpu District in central Shanghai, China, recruited through the Shanghai Municipal Annual Physical Examination Program for older residents and examined in three waves in 2019, 2022 and 2024, mostly as repeated cross-sectional samples with a small longitudinal subset, to study health, lifestyle and cognition in an ageing urban population.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2287</coho:numberOfParticipants>
        <oboInOwl:hasDbXref>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SDACS</oboInOwl:hasDbXref>
        <oboInOwl:hasRelatedSynonym>SDACS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GEC_subset"/>
        <rdfs:label xml:lang="en">Shanghai Dapuqiao Aging and Cognition Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002643"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12910095/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The population-based cross-sectional community study, which was carried out in conjunction with the elderly medical examination program, recruited 2287 adults (including males and females, aged 60 years and older) from Dapuqiao Street, Huangpu District, Shanghai, China, from March 2019 to November 2019.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002643"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:41606232</owl:annotatedTarget>
        <dcterms:title>The association of Alzheimer&apos;s disease-related SNPs with mild cognitive impairment susceptibility in the Chinese population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41606232</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12910095/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The population-based cross-sectional community study, which was carried out in conjunction with the elderly medical examination program, recruited 2287 adults (including males and females, aged 60 years and older) from Dapuqiao Street, Huangpu District, Shanghai, China, from March 2019 to November 2019.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002643"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based open cohort of residents aged 65 and older of the Dapu (Dapuqiao) neighbourhood of Huangpu District in central Shanghai, China, recruited through the Shanghai Municipal Annual Physical Examination Program for older residents and examined in three waves in 2019, 2022 and 2024, mostly as repeated cross-sectional samples with a small longitudinal subset, to study health, lifestyle and cognition in an ageing urban population.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:41606232</obo:IAO_0000119>
        <obo:IAO_0000119>https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SDACS</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
