        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">German Myocardial Infarction Family Study</rdfs:label>
    </owl:NamedIndividual>
