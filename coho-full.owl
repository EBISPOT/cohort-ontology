        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">79831</owl:annotatedTarget>
        <obo:IAO_0000116>people signed up to the study (live website counter), 2026</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://gladstudy.org.uk/</oboInOwl:hasDbXref>
        <rdfs:comment>79,831 people have signed up so far</rdfs:comment>
    </owl:Axiom>
