    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002086"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control sample for major depressive disorder at the Max Planck Institute of Psychiatry in Munich, Germany, whose cases were patients admitted to the institute&apos;s hospital for treatment of major depressive disorder and diagnosed by psychiatrists according to DSM-IV criteria, and whose controls were drawn at random from Munich community registries and screened for the absence of any lifetime axis I disorder; it contributed genotypes to the major depressive disorder analyses of the Psychiatric Genomics Consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22472876</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
