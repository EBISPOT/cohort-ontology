        <rdf:type rdf:nodeID="genid15483"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>PMID:20159113</obo:IAO_0000112>
        <obo:IAO_0000115>A Finnish case-control sample of multiple sclerosis patients with at least one parent born in Southern Ostrobothnia, the internal isolate on the western coast of Finland with an increased prevalence of multiple sclerosis, and anonymous population controls collected at the Central Hospital of Seinäjoki in Southern Ostrobothnia, that was genotyped as the isolate replication set of a 2010 genome-wide association study of multiple sclerosis in that isolate.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">83</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">365</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>FinSO</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Finland SO replication</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid15483">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005301"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001731"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15483"/>
        <obo:IAO_0000116>multiple sclerosis</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2820168/</oboInOwl:hasDbXref>
        <rdfs:comment>The MS cases have at least one parent born within SO, and anonymous population controls were collected from the Central Hospital of Seinajoki in Southern Ostrobothnia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001731"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2820168/</oboInOwl:hasDbXref>
        <rdfs:comment>Because of the limited power, we analyzed all 27 loci (28 of the 37 initial SNPs) showing nominal association in the GWAS analysis (p &lt; 10−4; Table S4) in a larger independent Finnish sample set of 711 cases and 1029 controls, of which 83 MS cases and 365 controls were from the isolate (Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001731"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20159113</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study in a high-risk isolate for multiple sclerosis reveals associated variants in STAT3 gene.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20159113</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC2820168</oboInOwl:hasDbXref>
        <rdfs:comment>Finland SO replicationb 83 365 Sequenom iPlex Gold</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
