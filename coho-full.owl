        <owl:annotatedTarget rdf:nodeID="genid15844"/>
        <obo:IAO_0000116>chronic graft dysfunction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001667/phs001667.v1.p1/GapExchange_phs001667.v1.p1.xml</oboInOwl:hasDbXref>
        <rdfs:comment>Kidney (or kidney-pancreas) transplant recipient no more than 10 days post-transplant, or kidney donor no more than 30 days post-transplant, or previously enrolled in the Genomics of Kidney Transplantation study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001773"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid15846"/>
        <obo:IAO_0000116>acute rejection</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001667/phs001667.v1.p1/GapExchange_phs001667.v1.p1.xml</oboInOwl:hasDbXref>
        <rdfs:comment>Kidney (or kidney-pancreas) transplant recipient no more than 10 days post-transplant, or kidney donor no more than 30 days post-transplant, or previously enrolled in the Genomics of Kidney Transplantation study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001773"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PGS019955</owl:annotatedTarget>
        <dcterms:title>Polygenic risk score for acute rejection based on donor-recipient non-HLA genotype mismatch.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38820342</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001773"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38820342</owl:annotatedTarget>
        <dcterms:title>Polygenic risk score for acute rejection based on donor-recipient non-HLA genotype mismatch.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38820342</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11142483/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Kidney transplant clinical information and genotyping data was collected from two cohort studies: DeKAF Genomics (2005–2011, NCT00270712) and GEN-03 (2012–2016, NCT01714440).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001773"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective observational cohort of kidney or kidney-pancreas transplant recipients, enrolled within 10 days of transplantation, and kidney donors, recruited from 2012 to 2016 at transplant centres in the United States (University of Alabama in Birmingham, University of Minnesota, Hennepin County Medical Center and Mayo Clinic) and Canada (University of Alberta) in a study sponsored by the National Institute of Allergy and Infectious Diseases with the Genomics of Transplantation Cooperative Research Program, to investigate the relationship between genetic variation and kidney transplant outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38820342</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/study/NCT01714440</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001773"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">962</owl:annotatedTarget>
        <obo:IAO_0000116>transplant recipients with DNA samples and clinical data; the same sentence reports 442 donors as well, and the two are not added together</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001667/phs001667.v1.p1/GapExchange_phs001667.v1.p1.xml</oboInOwl:hasDbXref>
        <rdfs:comment>We have developed a quality-controlled multicenter database with high quality data, and obtained DNA samples and clinical data on 962 recipients and 442 donors.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001773"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GEN-03</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


