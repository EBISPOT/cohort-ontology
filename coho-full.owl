    <!-- http://www.ebi.ac.uk/coho/COHO_0000829 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000829">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid7547"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001079"/>
        <obo:IAO_0000112>GCST90129535</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium that meta-analyses genome-wide association studies of venous thromboembolism from many case-control and population studies (30,234 cases and 172,122 controls from 18 studies in its 2019 analysis, 29 studies in later case-only analyses) to identify genetic risk factors for venous thromboembolism and its subtypes.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30234</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">172122</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>INVENT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>INVENT Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International Network Against Venous Thrombosis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">International Network Against Venous Thrombosis Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid7547">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005399"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid7547"/>
        <obo:IAO_0000116>venous thromboembolism</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9412533/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The INVENT Consortium included 30,234 VTE cases and 172,122 controls from 18 studies with varying diagnostic approaches, which were detailly described in the genome-wide association study [25].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001079"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5379621/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Because 865 MARTHA/EOVT participants examined in the current study also took part in the INVENT study, we were able to calculate the Spearman correlation between the true rs121918472 genotype as provided by Illumina Exome array results, and the imputed dose-derived from GWAS arrays.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90129535</owl:annotatedTarget>
        <dcterms:title>Multi-phenotype analyses of hemostatic traits with cardiovascular events reveal novel genetic associations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35285134</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9314075/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Appendix B contains a list of investigators from the INVENT consortium that contributed to the VTE summary data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium that meta-analyses genome-wide association studies of venous thromboembolism from many case-control and population studies (30,234 cases and 172,122 controls from 18 studies in its 2019 analysis, 29 studies in later case-only analyses) to identify genetic risk factors for venous thromboembolism and its subtypes.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9412533/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">30234</owl:annotatedTarget>
        <obo:IAO_0000116>VTE cases and controls in the 2019 GWAS meta-analysis of 18 studies</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:31420334</oboInOwl:hasDbXref>
        <rdfs:comment>We meta-analyzed GWAS data from 18 studies for 30 234 VTE cases and 172 122 controls and assessed the association between 12 923 718 genetic variants and VTE.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">172122</owl:annotatedTarget>
        <obo:IAO_0000116>VTE cases and controls in the 2019 GWAS meta-analysis of 18 studies</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:31420334</oboInOwl:hasDbXref>
        <rdfs:comment>We meta-analyzed GWAS data from 18 studies for 30 234 VTE cases and 172 122 controls and assessed the association between 12 923 718 genetic variants and VTE.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000829"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
