        <obo:IAO_0000112>GCST90274717</obo:IAO_0000112>
        <obo:IAO_0000115>A nested case-control genome-wide association study of prostate cancer in Latino men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Latino component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Latinos.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1043</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1057</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2100</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>LAPC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">LAPC GWAS</rdfs:label>
    </owl:NamedIndividual>
