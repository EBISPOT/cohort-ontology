        <rdfs:comment>These nuclear families were selected from breast cancer families participating in the Metropolitan New York Registry, one of the six centers of the National Cancer Institute&apos;s Breast Cancer Family Registry.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001514"/>
