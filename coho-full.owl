    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002298"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19616"/>
        <obo:IAO_0000116>HIV-1 infection</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3486297/</oboInOwl:hasDbXref>
        <rdfs:comment>The Pumwani sex worker cohort was established in Nairobi, Kenya, in 1985 (27, 48) and has become well known for a small group of women who remain seronegative and PCR negative to HIV despite repeated exposure through active high-risk sex work.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002298"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19618"/>
        <obo:IAO_0000116>repeated exposure to HIV through active high-risk sex work</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3486297/</oboInOwl:hasDbXref>
        <rdfs:comment>The Pumwani sex worker cohort was established in Nairobi, Kenya, in 1985 (27, 48) and has become well known for a small group of women who remain seronegative and PCR negative to HIV despite repeated exposure through active high-risk sex work.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002298"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Kenya"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5795417/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Pumwani sex worker cohort in Kenya was established in 1985.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002298"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22915813</owl:annotatedTarget>
        <dcterms:title>A genetic polymorphism of FREM1 is associated with resistance against HIV infection in the Pumwani sex worker cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22915813</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22915813+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A subgroup of women enrolled in the Pumwani sex worker cohort remain seronegative and PCR negative for human immunodeficiency virus type 1 despite repeated exposure through high-risk sex work.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002298"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An open cohort of female sex workers in Pumwani, Nairobi, Kenya, established in 1985 with follow-up visits twice a year and studied with the University of Nairobi and the University of Manitoba, in which a subgroup of women remain uninfected by HIV-1 despite heavy exposure through sex work; it is used to study natural resistance to HIV-1 infection, seroconversion and disease progression, including host genetic studies of HLA and other variants.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22915813</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24992306</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29295533</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9840285</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002298"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3000</owl:annotatedTarget>
        <obo:IAO_0000116>sex workers enrolled 1985-2010 (stated as a lower bound, &apos;more than 3,000&apos;)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3486297/</oboInOwl:hasDbXref>
        <rdfs:comment>From 1985 to 2010, more than 3,000 sex workers have been enrolled in the cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002298"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
