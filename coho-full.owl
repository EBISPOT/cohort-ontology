    <!-- http://www.ebi.ac.uk/coho/COHO_0002264 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002264">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid19371"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:34607834</obo:IAO_0000112>
        <obo:IAO_0000115>A pharmacogenomic study of glycaemic response to metformin and sulfonylureas in adults with type 2 diabetes who are members of Kaiser Permanente in the United States, with drug response defined from HbA1c measurements and prescriptions in electronic health records. Its first cohort, PMET1 (previously named PMT2, from the Pharmacogenomics of Membrane Transporters project of the NIH Pharmacogenomics Research Network), was drawn from the Genetic Epidemiology Research on Adult Health and Aging (GERA) cohort of the Kaiser Permanente Research Program on Genes, Environment, and Health in Northern California; Kaiser Permanente Northern California also supplied the phenotype data of a second cohort, PMET2.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PMET</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pharmacogenomics of metformin study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Pharmacogenomics of Metformin</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid19371">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002264"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid19371"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8669535/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Included participants had a clinical diagnosis of type 2 diabetes and were treated with sulfonylureas as monotherapy or as an add-on to metformin.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002264"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC6014560/</oboInOwl:hasDbXref>
        <rdfs:comment>The PMET1-EU in REP1 and the REP3 cohorts were collected from the Research Program on Genes, Environment and Health (RPGEH), based at Kaiser Permanente Northern California</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002264"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34607834</owl:annotatedTarget>
        <dcterms:title>Genome-Wide Meta-analysis Identifies Genetic Variants Associated With Glycemic Response to Sulfonylureas.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34607834</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8669535/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Genotyping and quality control procedures for the Genetics of Diabetes Audit and Research in Tayside Scotland (GoDARTS), Hoorn Diabetes Care System (DCS), and Pharmacogenomics of Metformin (PMET) cohorts have previously been described (13,15,16).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002264"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pharmacogenomic study of glycaemic response to metformin and sulfonylureas in adults with type 2 diabetes who are members of Kaiser Permanente in the United States, with drug response defined from HbA1c measurements and prescriptions in electronic health records. Its first cohort, PMET1 (previously named PMT2, from the Pharmacogenomics of Membrane Transporters project of the NIH Pharmacogenomics Research Network), was drawn from the Genetic Epidemiology Research on Adult Health and Aging (GERA) cohort of the Kaiser Permanente Research Program on Genes, Environment, and Health in Northern California; Kaiser Permanente Northern California also supplied the phenotype data of a second cohort, PMET2.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27500523</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29650774</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34607834</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42504935</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002264"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PMET</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


