        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4491026/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>For analyses of the polygenic risk score (PRS) we also excluded 5 studies (MAYO, PCFS, TASPRAC, ULM and UTAH) that oversampled cases with family history of PrCa.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
