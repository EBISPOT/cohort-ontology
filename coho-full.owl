        <oboInOwl:hasRelatedSynonym>GenerAAtions Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic and Environmental Risk Factors for Alzheimer Disease Among African Americans</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic and Environmental Risk Factors for Alzheimer Disease Among African Americans Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic and Environmental Risk Factors for Alzheimer&apos;s Disease Among African Americans</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
