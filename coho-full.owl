    <!-- http://www.ebi.ac.uk/coho/COHO_0002079 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002079">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:20144221</obo:IAO_0000112>
        <obo:IAO_0000115>An observational study of mammographic density nested within the intervention arm of the Age Trial, a British trial of annual mammographic screening in young women, which from 2000 to 2003 invited cancer-free women of the intervention arm who were still attending screening to give a blood sample and complete a questionnaire on demographic, anthropometric, lifestyle and reproductive characteristics, and enrolled women from 17 screening centres in England and Wales.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8000</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MOG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mammography Oestrogens and Growth Factors Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mammography Oestrogens and Growth Factors study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mammography Oestrogens and Growth factors study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mammography, Oestrogens and Growth factor study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mammography, Oestrogens and Growth factors study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Mammography, Oestrogens and Growth Factors study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002079"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2829497/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Over 8,000 women from 17 screening centres in England and Wales were enrolled into the MOG study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002079"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20144221</owl:annotatedTarget>
        <dcterms:title>Mammographic density and markers of socioeconomic status: a cross-sectional study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20144221</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2829497/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Mammography, Oestrogens and Growth factors (MOG) study is an observational study of mammographic density conducted within the intervention arm of the Age trial of mammographic screening in young women, in which about 54,000 women were randomised to receive yearly mammographic screening from ages 40 to 48 [16].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002079"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An observational study of mammographic density nested within the intervention arm of the Age Trial, a British trial of annual mammographic screening in young women, which from 2000 to 2003 invited cancer-free women of the intervention arm who were still attending screening to give a blood sample and complete a questionnaire on demographic, anthropometric, lifestyle and reproductive characteristics, and enrolled women from 17 screening centres in England and Wales.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19490643</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20144221</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33495599</obo:IAO_0000119>
