    <!-- http://www.ebi.ac.uk/coho/COHO_0000922 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000922">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid8421"/>
        <rdf:type rdf:nodeID="genid8423"/>
        <rdf:type rdf:nodeID="genid8425"/>
        <rdf:type rdf:nodeID="genid8427"/>
        <rdf:type rdf:nodeID="genid8429"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>GCST90797639</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective Dutch birth cohort of healthy pregnant women enrolled from October 2000 to 2002, recruited from a cohort study on pregnancy-related pelvic girdle pain (&apos;conventional lifestyles&apos;) and, for contrast, through organic food shops, anthroposophic doctors and midwives, Steiner schools and dedicated magazines (&apos;alternative lifestyles&apos;), and their children, set up to identify lifestyle and other early-life factors that influence atopic disease and followed into young adulthood.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">2877</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>Child, parents and health: lifestyle and genetic constitution</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KOALA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Koala Birth Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">KOALA Birth Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid8421">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_designed_to_study_exposure"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/ECTO_0070224"/>
    </owl:Restriction>
