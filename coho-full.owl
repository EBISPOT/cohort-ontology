        <obo:IAO_0000112>GCST90091134</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based family study of African Americans from the Washington, DC metropolitan area, enrolling randomly ascertained families and unrelated individuals through Howard University without selection on any phenotype, to study the genetic and environmental basis of common complex diseases including hypertension, obesity and type 2 diabetes.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">1976</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>HUFS</oboInOwl:hasRelatedSynonym>
