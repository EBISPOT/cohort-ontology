        <owl:annotatedTarget>GCST90129631</owl:annotatedTarget>
        <dcterms:title>Genome-wide studies reveal factors associated with circulating uromodulin and its relationships to complex diseases.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35446786</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9220927/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Outcome Reduction with an Initial Glargine Intervention</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000133"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised trial cohort of adults aged at least 50 with cardiovascular disease and dysglycaemia in 40 countries, enrolled during the two years ending December 2005 to compare insulin glargine with standard glycaemic care and omega-3 fatty acids with placebo for cardiovascular prevention.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18082485</obo:IAO_0000119>
