    <!-- http://www.ebi.ac.uk/coho/COHO_0000219 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000219">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid2259"/>
        <rdf:type rdf:nodeID="genid2261"/>
        <obo:IAO_0000112>EGAS50000001346</obo:IAO_0000112>
        <obo:IAO_0000115>A project that assembles and sequences cohorts of patients with distinct blood cancers, including blastic plasmacytoid dendritic cell neoplasm, high-grade B-cell lymphoma and T lymphoblastic leukaemia/lymphoma, to build a genomic atlas of haematological malignancies.</obo:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <rdfs:label xml:lang="en">Atlas of Blood Cancer Genomes</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid2259">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0002334"/>
    </owl:Restriction>
    <owl:Restriction rdf:nodeID="genid2261">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0019467"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000219"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2259"/>
        <obo:IAO_0000116>blood cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS50000001346</oboInOwl:hasDbXref>
        <rdfs:comment>To address this gap, we performed integrated DNA and RNA sequencing on 88 BPDCN patients representing the largest and most ancestrally diverse cohort described to date (~77% European, ~16% Asian, ~7% African).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000219"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid2261"/>
        <obo:IAO_0000116>blastic plasmacytoid dendritic cell neoplasm</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS50000001346</oboInOwl:hasDbXref>
        <rdfs:comment>To address this gap, we performed integrated DNA and RNA sequencing on 88 BPDCN patients representing the largest and most ancestrally diverse cohort described to date (~77% European, ~16% Asian, ~7% African).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000219"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS50000001346</owl:annotatedTarget>
        <dcterms:title>Blastic Plasmacytoid Dendritic Cell Neoplasm: Atlas of Blood Cancer Genomes</dcterms:title>
    </owl:Axiom>
