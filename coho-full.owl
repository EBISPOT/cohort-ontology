        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:18572229</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort study of respiratory health that began in 1968 with a survey of the children born in 1961 who were attending school in Tasmania, Australia, and has followed these probands with repeated surveys and lung function testing from age 7 into their sixth decade, with their parents also surveyed.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">8583</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>TAHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TLHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tasmanian Longitudinal Health STUDY</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Tasmanian Longitudinal Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20941">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/is_population_study_of"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005087"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002461"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20941"/>
        <obo:IAO_0000116>respiratory disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19187325+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Tasmanian Longitudinal Health Study (TAHS) is a population-based cohort (n=8583) study of respiratory disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002461"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12926821/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the baseline survey was carried out to assess the respiratory illnesses of 8583 offspring born in 1961, who were attending schools in Tasmania, Australia, in 1968.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002461"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:18572229</owl:annotatedTarget>
        <dcterms:title>Childhood eczema and asthma incidence and persistence: a cohort study from childhood to middle age.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:18572229</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18572229+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Data were gathered from the 1968, 1974, and 2004 surveys of the Tasmanian Longitudinal Health Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002461"/>
