    <!-- http://www.ebi.ac.uk/coho/COHO_0001881 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001881">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. HUVH is the Hospital Universitari Vall d&apos;Hebron in Barcelona, Spain. Every PGS Catalog use of the id goes back to CIMBA (COHO:0000901) data: the hospital&apos;s contribution of BRCA1/2 mutation carriers, which CIMBA papers call only &apos;University Hospital Vall d&apos;Hebron (HVH)&apos; and describe no further (no study name, recruitment period or design). It is an institution label for a CIMBA site, decided as the review decided BIDMC, UPENN, MSKCC and Chicago. Do not confuse with COHO:0000564 (Heart and Vascular Health Study), which carries the acronym HVH; neither HUVH nor &apos;HVH&apos; in this sense should be added there. If the curator ever mints CIMBA site samples, this would be the Vall d&apos;Hebron CIMBA study, memberOf COHO:0000901, with PMID:32665703 as its example. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Hospital Universitari Vall dHebron</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001882 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001882">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdf:type rdf:nodeID="genid16711"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001734"/>
