        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11065350/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Born in Bradford (BiB) is a multi-ethnic birth cohort in Bradford, UK, which recruited 12 453 women with 13 776 pregnancies and 3448 of their partners between 2007 and 2011.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000226"/>
