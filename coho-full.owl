        <obo:IAO_0000112>GCST90179151</obo:IAO_0000112>
        <obo:IAO_0000115>A Dutch study of individual differences in cognition and cognition-related disorders. It has a general-population sample of volunteers recruited through media advertisements or the Science Live research programme of the NEMO Science Center in Amsterdam, who performed cognitive tasks and completed an online questionnaire on life events, personality, environment and behaviour, and a genetically informative family sample of twins and their siblings.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">837</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>NESCOG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Netherlands Study of Cognition</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Netherlands Study on Cognition, Environment and Genes</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Netherlands Study of Cognition, Environment and Genes</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001378"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3738022/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Sample 1 (S1, n = 837) was recruited through media advertisement or through the Science Live Program of the NEMO Science Center in Amsterdam (www.sciencelive.nl).</rdfs:comment>
    </owl:Axiom>
