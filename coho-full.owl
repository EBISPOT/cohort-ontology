    <!-- http://www.ebi.ac.uk/coho/COHO_0002393 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0002393">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid20305"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:19377074</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study from Leiden, the Netherlands, of men born in the Netherlands, comparing men younger than 70 years who had a first myocardial infarction between 1990 and 1996 with control men without a history of myocardial infarction, frequency-matched on 10-year age groups, used to study coagulation and fibrinolytic factors, their genetic variants and cardiovascular risk factors as risk factors for myocardial infarction.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">560</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">646</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>SMILE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study of Myocardial Infarction in LEiden</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Study of Myocardial Infarctions Leiden</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20305">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005068"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002393"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20305"/>
        <obo:IAO_0000116>myocardial infarction</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11123505+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A case-control study including 560 patients with a first myocardial infarction who had survived at least 6 months, plus 646 control subjects.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002393"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC9797027/</oboInOwl:hasDbXref>
        <rdfs:comment>In the Study of Myocardial Infarctions Leiden (SMILE), which was a case–control study of men born in the Netherlands, higher FIXc was associated with increased risk of a first MI among men aged &lt; 70 years, with the highest risk being seen among men aged &lt; 55 years [23].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002393"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:19377074</owl:annotatedTarget>
        <dcterms:title>Low thrombin activatable fibrinolysis inhibitor activity levels are associated with an increased risk of a first myocardial infarction in men.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:19377074</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2688572/</oboInOwl:hasDbXref>
        <rdfs:comment>We included 554 men under 70 years old with a first myocardial infarction and 643 controls participating in the Study of Myocardial Infarctions Leiden (SMILE), a case-control study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
