        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41591-025-03827-z/MediaObjects/41591_2025_3827_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>Broad Bayer AFLMU (EUR) Atrial Fibrillation Biobank Ludwig Maximilian University Study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001476"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A biobank and ongoing prospective registry of patients with atrial fibrillation from the arrhythmia clinic of the Department of Medicine I, University Hospital Munich, Ludwig-Maximilians-University, Germany, established within the Arrhythmia-Biobank-LMU with support from the German Federal Ministry of Education and Research, which collects blood samples and clinical data and follows patients for recurrence of atrial fibrillation after rhythm-control interventions such as catheter ablation.</owl:annotatedTarget>
