        <rdfs:comment>The studies were conducted in the Kumasi Metropolitan District of the Ashanti Region of Ghana where Kumasi is the capital city.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001969"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25261933</owl:annotatedTarget>
        <dcterms:title>Reappraisal of known malaria resistance loci in a large multicenter study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25261933</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4617542/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Ghana (Kumasi) 1496 (4) 230 (10) 551 (2) 75 (13) 640 (2) 2042</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001969"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, unmatched case-control study of severe malaria conducted in August 2006 – December 2008 in the Kumasi Metropolitan District, Ashanti Region, Ghana, with ethics approval from Komfo Anokye Teaching Hospital and the Kwame Nkrumah University of Science and Technology. Its cases were children aged 3 months to 12 years with severe malaria admitted to the Paediatric Emergency Unit of Komfo Anokye Teaching Hospital, its controls were cord-blood samples collected in the same hospital&apos;s labour ward, and blood was also taken from the biological parents of cases (family trios); its clinical data and DNA samples were contributed to MalariaGEN Consortial Project 1.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25261933</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.malariagen.net/partner_study/human-genetic-determinants-severe-malaria-kumasi-ghana/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001969"/>
