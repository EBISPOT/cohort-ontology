        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001631 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001631">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid14703"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>PMID:40709894</obo:IAO_0000112>
        <obo:IAO_0000115>A pan-Canadian collection of children and adults treated with drugs of interest who have been enrolled since 2005 by trained surveillance clinicians at major Canadian hospitals (first paediatric hospitals, as the Genotype-specific Approaches to Therapy in Childhood network), either as cases of serious adverse drug reactions, such as anthracycline-induced cardiotoxicity or cisplatin-induced hearing loss, or as drug-tolerant controls, and whose clinical data and biological samples are collected for genetic association studies to find genomic predictors of adverse drug reactions. The network is based at the University of British Columbia in Vancouver.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym GATC also denotes Cleveland Clinic GeneBank Study (COHO:0001576); this term is Canadian Pharmacogenomics Network for Drug Safety.</obo:IAO_0000116>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9800</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">88500</coho:numberOfControls>
        <oboInOwl:hasRelatedSynonym>CPNDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian Pharmacogenomics Network for Drug Safety Database</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian Pharmacogenomics Network for Drug Safety cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GATC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genotype-specific Approaches to Therapy in Childhood</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genotype-specific Approaches to Therapy in Children</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Canadian Pharmacogenomics Network for Drug Safety</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid14703">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/HP_0020172"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001631"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid14703"/>
        <obo:IAO_0000116>adverse drug reactions</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20578893+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A surveillance network has been established in 17 of Canada&apos;s major hospitals to identify patients experiencing specific ADRs and to collect biological samples and relevant clinical history for genetic association studies.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001631"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20578893+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Canadian Pharmacogenomics Network for Drug Safety is a nation-wide effort established in Canada to identify novel predictive genomic markers of severe ADRs in children and adults.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001631"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40709894</owl:annotatedTarget>
        <dcterms:title>Four Pharmacogenomic Variants Strongly Linked to Corticosteroid-Induced Avascular Necrosis in Children with Cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40709894</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12649305/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Study participants were recruited through the Canadian Pharmacogenomics Network for Drug Safety (CPNDS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001631"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A pan-Canadian collection of children and adults treated with drugs of interest who have been enrolled since 2005 by trained surveillance clinicians at major Canadian hospitals (first paediatric hospitals, as the Genotype-specific Approaches to Therapy in Childhood network), either as cases of serious adverse drug reactions, such as anthracycline-induced cardiotoxicity or cisplatin-induced hearing loss, or as drug-tolerant controls, and whose clinical data and biological samples are collected for genetic association studies to find genomic predictors of adverse drug reactions. The network is based at the University of British Columbia in Vancouver.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19507171</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20578893</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30452777</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31083486</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4610716/unicode</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001631"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfCases"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">9800</owl:annotatedTarget>
        <obo:IAO_0000116>ADR cases and matched controls enrolled, as of June 2018 (no total stated)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.bcchr.ca/POPi/research-capabilities</oboInOwl:hasDbXref>
        <rdfs:comment>As of June 2018, 9,800 ADR cases and 88,500 matched controls have been enrolled from across 13 pediatric academic health centres in Canada</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001631"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfControls"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">88500</owl:annotatedTarget>
        <obo:IAO_0000116>ADR cases and matched controls enrolled, as of June 2018 (no total stated)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.bcchr.ca/POPi/research-capabilities</oboInOwl:hasDbXref>
        <rdfs:comment>As of June 2018, 9,800 ADR cases and 88,500 matched controls have been enrolled from across 13 pediatric academic health centres in Canada</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001631"/>
