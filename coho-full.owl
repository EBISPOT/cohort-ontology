        <obo:IAO_0000119>PMID:21342495</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23143601</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
