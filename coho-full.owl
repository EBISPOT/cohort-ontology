        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>PMID:22158537</obo:IAO_0000112>
        <obo:IAO_0000115>A study of type 2 diabetes and glucose metabolism in Han Chinese run from the Shanghai Diabetes Institute of Shanghai Jiao Tong University. Its participants, probands of type 2 diabetes pedigrees diagnosed before age 40 with normoglycaemic controls over 50 without a family history of diabetes recruited at the institute, and people with normal glucose tolerance drawn from the community-based Shanghai Diabetes Study I and II, were genotyped for East Asian genome-wide association studies of type 2 diabetes and fasting glucose.</obo:IAO_0000115>
        <coho:numberOfCases rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">190</coho:numberOfCases>
        <coho:numberOfControls rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">198</coho:numberOfControls>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">388</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>SJTUDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Shanghai Jiao Tong University Diabetes</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Shanghai Jiao Tong University Diabetes Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid20240">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005148"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002385"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid20240"/>
        <obo:IAO_0000116>type 2 diabetes</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Shanghai Jiao Tong University Diabetes Study (SJTUDS) The cases (n = 190) were probands of type 2 diabetic pedigrees with fasting plasma glucose ≥ 7.0 mmol/L and/or 2-h post plasma glucose ≥ 11.1 mmol/L and diagnosed before 40 years old.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002385"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>All subjects were recruited from Shanghai Diabetes Institute of Shanghai Jiao Tong University.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002385"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:22158537</owl:annotatedTarget>
        <dcterms:title>Meta-analysis of genome-wide association studies identifies eight new loci for type 2 diabetes in east Asians.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22158537</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3582398/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Stage 2 subjects included 5,843 cases and 4,574 controls from three independent GWA studies including the BioBank Japan Study (BBJ), the Health2 T2D Study (H2T2DS) and the Shanghai Jiao Tong University Diabetes Study (SJTUDS) for in silico replication analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0002385"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study of type 2 diabetes and glucose metabolism in Han Chinese run from the Shanghai Diabetes Institute of Shanghai Jiao Tong University. Its participants, probands of type 2 diabetes pedigrees diagnosed before age 40 with normoglycaemic controls over 50 without a family history of diabetes recruited at the institute, and people with normal glucose tolerance drawn from the community-based Shanghai Diabetes Study I and II, were genotyped for East Asian genome-wide association studies of type 2 diabetes and fasting glucose.</owl:annotatedTarget>
