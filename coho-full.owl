    <!-- http://www.ebi.ac.uk/coho/COHO_0000987 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000987">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid9007"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90897930</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised, double-blind, placebo-controlled trial, conducted in 1992–1995 at 21 sickle cell referral centres in the United States and Canada, of whether hydroxyurea reduces vaso-occlusive events in adults with sickle cell anaemia and frequent painful episodes, whose participants were then followed observationally in 1996–2001.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MSH also denotes BioMe Biobank (COHO:0000424) and Mount Sinai Hospital-Princess Margaret Multicancer Study (COHO:0002267); this term is Multicenter Study of Hydroxyurea in Sickle Cell Anemia.</obo:IAO_0000116>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>MSH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MSH_CSA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Multicenter Study of Hydroxyurea</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Multicenter Study of Hydroxyurea in Patients With Sickle Cell Anemia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Multicenter Study of Hydroxyurea in Sickle Cell Anemia</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9007">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0011382"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000987"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9007"/>
        <obo:IAO_0000116>sickle cell anemia</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12672732+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Long-term observational follow-up study of mortality in patients with SCA who originally participated in the randomized, double-blind, placebo-controlled Multicenter Study of Hydroxyurea in Sickle Cell Anemia (MSH), conducted in 1992-1995, to determine if hydroxyurea reduces vaso-occlusive events.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000987"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:12672732%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>Inpatients and outpatients in 21 sickle cell referral centers in the United States and Canada.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000987"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90897930</owl:annotatedTarget>
        <dcterms:title>FLT1 and other candidate fetal haemoglobin modifying loci in sickle cell disease in African ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40025045</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11873275/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The cohorts included: Cooperative Study of Sickle Cell Disease (CSSCD: n = 841), Multicenter Study of Hydroxyurea (MSH: n = 178), Pulmonary Hypertension and the Hypoxic Response in Sickle Cell Disease (PUSH) study (n = 73), Comprehensive Sickle Cell Centers Collaborative Data (C-data) project (n = 127), Treatment of Pulmonary Hypertension and Sickle Cell Disease with Sildenafil Treatment (Walk-PHaSST) trial (n = 181), Duke University Outcome Modifying Genes study (n = 152), and Silent Infarct Transfusion (SIT) trial (SITT: n = 488).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000987"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised, double-blind, placebo-controlled trial, conducted in 1992–1995 at 21 sickle cell referral centres in the United States and Canada, of whether hydroxyurea reduces vaso-occlusive events in adults with sickle cell anaemia and frequent painful episodes, whose participants were then followed observationally in 1996–2001.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:12672732</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000987"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">299</owl:annotatedTarget>
        <obo:IAO_0000116>patients randomised in the trial (1992-1995)</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:12672732</oboInOwl:hasDbXref>
        <rdfs:comment>Seventy-five of the original 299 patients died, 28% from pulmonary disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000987"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MSH</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000987"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MSH_CSA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000988 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000988">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid9015"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Austria"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Czech_Republic"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000137"/>
        <obo:IAO_0000112>GCST90013831</obo:IAO_0000112>
        <obo:IAO_0000115>A subgroup of the PanCareLIFE ototoxicity genetics study made up of patients diagnosed with cancer before age 18 who were treated with upfront cisplatin and had no radiotherapy to the brain or inner ear, recruited in 2015–2017 through data providers in Switzerland, Italy, the Czech Republic, Denmark, Germany, Austria and the Netherlands for a genome-wide association study of cisplatin-induced hearing loss.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">598</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PCL WP4b</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WP4b</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">PanCareLIFE Work Package 4b</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid9015">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0006517"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000988"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid9015"/>
        <obo:IAO_0000116>childhood cancer</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6444213/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Within this large cohort we defined a group of 598 cisplatin-treated childhood cancer patients not confounded by cranial radiotherapy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000988"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6444213/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Study participants were recruited through a network of 14 institutions from 7 countries: Switzerland, Italy, Czech Republic, Denmark, Germany, Austria, and the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000988"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90013831</owl:annotatedTarget>
        <dcterms:title>TCERG1L allelic variation is associated with cisplatin-induced hearing loss in childhood cancer, a PanCareLIFE study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34262104</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8280110/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The discovery cohort (PCL discovery cohort, D) consists of childhood cancer patients from the PCL consortium, a multicenter cohort of childhood cancer patients and survivors across Europe designed to address ototoxicity, fertility impairment, and quality of life.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000988"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A subgroup of the PanCareLIFE ototoxicity genetics study made up of patients diagnosed with cancer before age 18 who were treated with upfront cisplatin and had no radiotherapy to the brain or inner ear, recruited in 2015–2017 through data providers in Switzerland, Italy, the Czech Republic, Denmark, Germany, Austria and the Netherlands for a genome-wide association study of cisplatin-induced hearing loss.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30888333</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000988"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/numberOfParticipants"/>
        <owl:annotatedTarget rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">598</owl:annotatedTarget>
        <obo:IAO_0000116>cisplatin-treated patients without cranial radiotherapy enrolled in WP4b</obo:IAO_0000116>
        <oboInOwl:hasDbXref>PMID:30888333</oboInOwl:hasDbXref>
        <rdfs:comment>Compared to WP5, WP4b investigated a more restricted study population of 598 patients.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000988"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>PCL WP4b</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
