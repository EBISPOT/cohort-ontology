    <!-- http://www.ebi.ac.uk/coho/COHO_0001220 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001220">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid11095"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000745"/>
        <obo:IAO_0000112>GCST90103991</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based study of genes and biomarkers for coronary artery disease at the University of Pennsylvania Medical Center, United States, which from July 1998 to March 2003 recruited consecutive patients undergoing cardiac catheterisation and coronary angiography. A nested case-control genome-wide association study of angiographic coronary artery disease in its white patients is one of the core studies of the CARDIoGRAM consortium.</obo:IAO_0000115>
        <coho:numberOfParticipants rdf:datatype="http://www.w3.org/2001/XMLSchema#integer">3815</coho:numberOfParticipants>
        <oboInOwl:hasRelatedSynonym>PennCATH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PennCath</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">University of Pennsylvania Catheterization Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Restriction rdf:nodeID="genid11095">
        <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/has_patients_with"/>
        <owl:someValuesFrom rdf:resource="http://purl.obolibrary.org/obo/MONDO_0005010"/>
    </owl:Restriction>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001220"/>
        <owl:annotatedProperty rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#type"/>
        <owl:annotatedTarget rdf:nodeID="genid11095"/>
        <obo:IAO_0000116>coronary artery disease</obo:IAO_0000116>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3297116/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Discovery studies were PennCath and MedStar (webappendix p 2), which recruited patients before coronary angiography at the University of Pennsylvania Medical Center (Penn) and Washington Hospital Center (WHC), respectively.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001220"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2662558/</oboInOwl:hasDbXref>
        <rdfs:comment>PennCATH is composed of consecutive participants undergoing coronary angiography at University of Pennsylvania Health System hospitals</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001220"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90103991</owl:annotatedTarget>
        <dcterms:title>Multi-Trait Genome-Wide Association Study of Atherosclerosis Detects Novel Pleiotropic Loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35186008</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8847690/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Meta-analysis of MVP, Biobank Japan, PMBB, Pakistan Genomic Resource, MedStar, PennCath, DIAMANTE, and Malmö Diet and Cancer Study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001220"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based study of genes and biomarkers for coronary artery disease at the University of Pennsylvania Medical Center, United States, which from July 1998 to March 2003 recruited consecutive patients undergoing cardiac catheterisation and coronary angiography. A nested case-control genome-wide association study of angiographic coronary artery disease in its white patients is one of the core studies of the CARDIoGRAM consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19287092</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21239051</obo:IAO_0000119>
