    <!-- http://www.ebi.ac.uk/coho/COHO_0001672 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001672">
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-24. DNMUV is the PGS Catalog&apos;s id for the Department of Neurology of the Medical University of Vienna (Austria), a hospital department, and the Catalog records no released score or sample set that uses it, so no study sample can be identified behind it. The papers found by name each describe a different unnamed set of the department&apos;s patients (E270.1, E270.4, E270.7, E270.10, E270.13; abstracts of PMID:23841974, 25861769, 29987508, 36630660, 34711480). No COHO term matches; the review&apos;s MUV (&apos;Medical University of Vienna&apos;, COHO:0002100, placeholder) is the parent institution, a CIMBA site label, and not the same thing. Reconsider if a released PGS score ever cites DNMUV. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Department of Neurology, Medical University of Vienna</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001673 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001673">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdf:type rdf:nodeID="genid15011"/>
