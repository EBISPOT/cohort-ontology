    <!-- http://www.ebi.ac.uk/coho#EGA_subset -->

    <owl:AnnotationProperty rdf:about="http://www.ebi.ac.uk/coho#EGA_subset">
        <obo:IAO_0000115 xml:lang="en">The cohorts that studies in the European Genome-phenome Archive (EGA) draw on.</obo:IAO_0000115>
        <rdfs:label>EGA_subset</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.ebi.ac.uk/coho#GWAS_subset -->

    <owl:AnnotationProperty rdf:about="http://www.ebi.ac.uk/coho#GWAS_subset">
        <obo:IAO_0000115 xml:lang="en">The cohorts that studies in the GWAS Catalog draw on.</obo:IAO_0000115>
        <rdfs:label>GWAS_subset</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.ebi.ac.uk/coho#MetaboLight_subset -->

    <owl:AnnotationProperty rdf:about="http://www.ebi.ac.uk/coho#MetaboLight_subset">
        <obo:IAO_0000115 xml:lang="en">The cohorts that studies in MetaboLights draw on.</obo:IAO_0000115>
        <rdfs:label>MetaboLight_subset</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    </owl:AnnotationProperty>
    


    <!-- http://www.ebi.ac.uk/coho#PRIDE_subset -->

    <owl:AnnotationProperty rdf:about="http://www.ebi.ac.uk/coho#PRIDE_subset">
        <obo:IAO_0000115 xml:lang="en">The cohorts that datasets in the PRIDE proteomics archive draw on.</obo:IAO_0000115>
        <rdfs:label>PRIDE_subset</rdfs:label>
        <rdfs:subPropertyOf rdf:resource="http://www.geneontology.org/formats/oboInOwl#SubsetProperty"/>
    </owl:AnnotationProperty>
    


