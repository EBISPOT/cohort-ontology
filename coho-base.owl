     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:coho="http://www.ebi.ac.uk/coho/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:coho1="http://www.ebi.ac.uk/coho#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://www.ebi.ac.uk/coho/coho-base.owl">
        <owl:versionIRI rdf:resource="http://www.ebi.ac.uk/coho/releases/2026-09-22/coho-base.owl"/>
        <dce:type rdf:resource="http://purl.obolibrary.org/obo/IAO_8000001"/>
        <dcterms:description>None</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/unspecified"/>
        <dcterms:title>Cohort Ontology</dcterms:title>
        <owl:versionInfo>2026-09-22</owl:versionInfo>
    </owl:Ontology>
    


