     -->

    


    <!-- http://purl.obolibrary.org/obo/RO_0001025 -->

    <owl:ObjectProperty rdf:about="http://purl.obolibrary.org/obo/RO_0001025"/>
    


    <!-- http://www.ebi.ac.uk/coho/hasCohort -->

    <owl:ObjectProperty rdf:about="http://www.ebi.ac.uk/coho/hasCohort">
        <rdfs:domain rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <rdfs:range rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <obo:IAO_0000115 xml:lang="en">A relation between a cohort aggregation and a cohort whose participants or data it combines or compares.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">hasCohort</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ebi.ac.uk/coho/hasSubCohort -->

    <owl:ObjectProperty rdf:about="http://www.ebi.ac.uk/coho/hasSubCohort">
        <owl:inverseOf rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <rdfs:domain rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdfs:range rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <obo:IAO_0000115 xml:lang="en">A relation between a cohort and a cohort whose participants are drawn from it: a sub-study, a sub-sample or a component trial. The inverse of isSubCohortOf.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">hasSubCohort</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ebi.ac.uk/coho/has_data_collection_location -->

    <owl:ObjectProperty rdf:about="http://www.ebi.ac.uk/coho/has_data_collection_location">
        <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#TransitiveProperty"/>
        <rdfs:range rdf:resource="http://purl.obolibrary.org/obo/NCIT_C16632"/>
        <owl:propertyChainAxiom rdf:parseType="Collection">
            <rdf:Description rdf:about="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
            <rdf:Description rdf:about="http://purl.obolibrary.org/obo/RO_0001025"/>
        </owl:propertyChainAxiom>
        <obo:IAO_0000115 xml:lang="en">A relation between a cohort and a geographical area in which its participants were recruited. Where the data were analysed or are stored does not count.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">has_data_collection_location</rdfs:label>
    </owl:ObjectProperty>
    


    <!-- http://www.ebi.ac.uk/coho/isSubCohortOf -->

    <owl:ObjectProperty rdf:about="http://www.ebi.ac.uk/coho/isSubCohortOf">
        <rdfs:domain rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <rdfs:range rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <obo:IAO_0000115 xml:lang="en">A relation between a cohort and the cohort its participants are drawn from, of which it is a sub-study, a sub-sample or a component trial.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">isSubCohortOf</rdfs:label>
    </owl:ObjectProperty>
    


