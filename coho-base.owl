<?xml version="1.0"?>
<rdf:RDF xmlns="http://www.ebi.ac.uk/coho/coho-base.owl#"
     xml:base="http://www.ebi.ac.uk/coho/coho-base.owl"
     xmlns:dce="http://purl.org/dc/elements/1.1/"
     xmlns:obo="http://purl.obolibrary.org/obo/"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:coho="http://www.ebi.ac.uk/coho/"
     xmlns:doap="http://usefulinc.com/ns/doap#"
     xmlns:foaf="http://xmlns.com/foaf/0.1/"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:coho1="http://www.ebi.ac.uk/coho#"
     xmlns:dcterms="http://purl.org/dc/terms/"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://www.ebi.ac.uk/coho/coho-base.owl">
        <owl:versionIRI rdf:resource="http://www.ebi.ac.uk/coho/releases/2026-09-22.2/coho-base.owl"/>
        <dce:rights>Copyright 2026 EMBL - European Bioinformatics Institute
Licensed under the Apache License, Version 2.0 (the &quot;License&quot;); you may not use this file except in compliance with the License. You may obtain a copy of the License at http://www.apache.org/licenses/LICENSE-2.0 Unless required by applicable law or agreed to in writing, software distributed under the License is distributed on an &quot;AS IS&quot; BASIS, WITHOUT WARRANTIES OR CONDITIONS OF ANY KIND, either express or implied. See the License for the specific language governing permissions and limitations under the License.</dce:rights>
        <dce:type rdf:resource="http://purl.obolibrary.org/obo/IAO_8000001"/>
        <dcterms:description>A lightweight ontology for the consistent identification and description of human cohorts across EMBL-EBI resources. Each cohort is represented as a named individual with a stable identifier and minimal metadata: a definition, synonyms, the locations where its data were collected, its relations to sub-cohorts and cohort aggregations, and example studies from EMBL-EBI resources such as the GWAS Catalog, EGA, MetaboLights and PRIDE. This enables linkage, discovery and integration of cohort-related data while supporting both named and implicitly defined cohorts.</dcterms:description>
        <dcterms:license rdf:resource="http://www.apache.org/licenses/LICENSE-2.0"/>
        <dcterms:title>Cohort Ontology</dcterms:title>
        <doap:bug-database rdf:resource="https://github.com/EBISPOT/cohort-ontology/issues"/>
        <owl:versionInfo>2026-09-22.2</owl:versionInfo>
        <foaf:homepage rdf:resource="https://github.com/EBISPOT/cohort-ontology"/>
    </owl:Ontology>
    


