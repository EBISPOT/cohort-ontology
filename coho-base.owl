    <!-- http://purl.obolibrary.org/obo/NCIT_C16632 -->

    <owl:Class rdf:about="http://purl.obolibrary.org/obo/NCIT_C16632"/>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000000 -->

    <owl:Class rdf:about="http://www.ebi.ac.uk/coho/COHO_0000000">
        <obo:IAO_0000115>A group of individuals grouped together based on a shared characteristic or property of interest.</obo:IAO_0000115>
        <oboInOwl:hasDbXref>EFO:0004445</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>NCIT:C61512</oboInOwl:hasDbXref>
        <rdfs:label xml:lang="en">cohort</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000001 -->

    <owl:Class rdf:about="http://www.ebi.ac.uk/coho/COHO_0000001">
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
                <owl:someValuesFrom rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <rdfs:subClassOf>
            <owl:Restriction>
                <owl:onProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
                <owl:minQualifiedCardinality rdf:datatype="http://www.w3.org/2001/XMLSchema#nonNegativeInteger">2</owl:minQualifiedCardinality>
                <owl:onClass rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
            </owl:Restriction>
        </rdfs:subClassOf>
        <obo:IAO_0000115>A study, project or consortium that compares multiple cohorts.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">cohort aggregation</rdfs:label>
    </owl:Class>
    


    <!-- http://www.ebi.ac.uk/coho/TEMP_temporary_unclassified -->

    <owl:Class rdf:about="http://www.ebi.ac.uk/coho/TEMP_temporary_unclassified">
        <obo:IAO_0000115 xml:lang="en">A holding class for a cohort individual that has not yet been classified as a cohort or a cohort aggregation. Nothing should remain here.</obo:IAO_0000115>
        <rdfs:label xml:lang="en">temporary unclassified</rdfs:label>
    </owl:Class>
    


