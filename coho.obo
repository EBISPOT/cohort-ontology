relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21179049+AND+SRC%3AMED&format=json&resultType=core", comment="This cross-sectional study examined 3236 Scottish women age 50-59 years, who were members of the Aberdeen Prospective Osteoporosis Screening Study."}
property_value: coho:numberOfParticipants "5119" xsd:integer {IAO:0000116="women attending the baseline visit 1990-1994", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5506508/", comment="Subjects are women from the Aberdeen Prospective Osteoporosis Screening Study (APOSS) cohort, a population-based screening program for assessing osteoporotic fracture risk, which initially recruited 5119 women aged 45–54 years between 1990 and 1994 using random selection from Community Health Index [15]."}
property_value: IAO:0000112 "PMID:28159758" xsd:string {dcterms:title="Longitudinal study of weight, energy intake and physical activity change across two decades in older Scottish women.", xref="PMID:28159758", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28159758+AND+SRC%3AMED&format=json&resultType=core", comment="A longitudinal cohort of 5119 perimenopausal women from the Aberdeen Prospective Osteoporosis Screening Study (APOSS) recruited between 1990 and 1994, with follow-up visits at 1997-1999 and 2009-2011."}

[Instance]
id: coho:COHO_0001493
name: Apixaban for Reduction in Stroke and Other Thromboembolic Events in Atrial Fibrillation
def: "A multinational, randomised, double-blind, double-dummy phase 3 trial, sponsored by Bristol-Myers Squibb and Pfizer, in which patients with atrial fibrillation or atrial flutter and at least one additional risk factor for stroke, enrolled from 2006 at over 1,000 centres in about 40 countries, were randomly assigned to apixaban or warfarin to test whether apixaban is non-inferior to warfarin in preventing stroke or systemic embolism. The trial ended in 2011; its participants' baseline blood samples and genotypes have since been used in biomarker and genetic studies." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27306620", IAO:0000119="PMID:20211292", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT00412984", IAO:0000119="PMID:21870978"}
synonym: "Apixaban for reduction in stroke and other ThromboemboLic events in atrial fibrillation" RELATED []
synonym: "Apixaban for the Prevention of Stroke in Subjects With Atrial Fibrillation" RELATED []
synonym: "ARISTOTLE" RELATED OMO:0003000 []
