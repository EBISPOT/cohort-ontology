[Instance]
id: coho:COHO_0002682
name: Coronagenes
def: "A cohort of volunteers recruited online from 2020 by the MRC Human Genetics Unit at the University of Edinburgh who shared genotype data from direct-to-consumer genetic testing services and completed questionnaires on their health, lifestyle and COVID-19 symptoms, to identify genes that influence the risk and severity of COVID-19." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://institute-genetics-cancer.ed.ac.uk/news-and-events/news-2020/home-dna-test-data-wanted-boost-coronavirus-fight", IAO:0000119="http://web.archive.org/web/20241104022517/https://www.ed.ac.uk/coronagenes/about/coronagenes-study"}
subset: coho1:IHCC_subset
