property_value: IAO:0000112 "GCST90841377" xsd:string {dcterms:title="Large multi-ethnic genetic analyses of amyloid imaging identify new genes for Alzheimer disease.", xref="PMID:37101235", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10134547/fullTextXML", comment="These cohorts included Memento [24], Mayo Clinic Study of Aging (MCSA) [25], Wisconsin Registry for Alzheimer's Prevention (WRAP) [26], Berkeley Aging Cohort study (BACS) [27], Korean study [28], and MISSION-AD."}

