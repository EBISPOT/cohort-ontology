[Instance]
id: coho:COHO_0002706
name: Biomarker AF study
def: "An observational hospital-based registry of patients with atrial fibrillation at the University Medical Center Groningen, the Netherlands, combining standard clinical atrial fibrillation assessment with blood sampling and longitudinal follow-up to identify risk profiles that guide atrial fibrillation therapy." [] {IAO:0000119="PMID:33600500", IAO:0000119="PMID:29892015", dcterms:contributor="GPT-6 (OpenAI), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf"}
