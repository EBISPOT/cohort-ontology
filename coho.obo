property_value: IAO:0000112 "PMID:22961080" xsd:string {dcterms:title="A genome-wide association study identifies GRK5 and RASGRP1 as type 2 diabetes loci in Chinese Hans.", xref="PMID:22961080", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526061/fullTextXML", comment="The stage 3 replication testing of 10 SNPs is carried out by de novo genotyping in 3,410 T2D patients and 3,412 nondiabetic control subjects from the Shanghai Diabetes Inpatient Database (SDIID) and the Shanghai Diabetes Study (SDS) and in silico replication in the AGEN-T2D GWAS datasets (6,952 T2D case and 11,865 control subjects)."}

[Instance]
id: coho:COHO_0002359
name: obsolete Service de Neurologie Mazarin, Groupe Hospitalier Pitié-Salpêtrière Paris
comment: Obsoleted 2026-09-24. SdNM is the PGS Catalog's id for the Service de Neurologie Mazarin (neuro-oncology department) of the Pitié-Salpêtrière hospital group in Paris, the site through which the 1,495 glioma patients of the French GWAS were ascertained (PMID:28346443). The sources give the case series no name of its own, no recruitment design beyond ascertainment at the department, and no study identity apart from 'the French GWAS', whose controls come from a separate cohort (SU.VI.MAX). The id denotes a hospital department's unnamed set of patients, so it is not a cohort. No COHO term or review row covers it. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.
is_obsolete: true

[Instance]
id: coho:COHO_0002360
name: Stockholm Diabetes Prevention Program
def: "A population-based prospective cohort of men and women aged 35–56 without previously diagnosed diabetes from five municipalities of Stockholm County, Sweden, surveyed at baseline in 1992–1994 (men) and 1996–1998 (women) with the sample enriched to about half with a family history of diabetes, and re-examined after 8–10 years and again in 2014–2017 with health examinations, oral glucose tolerance tests and questionnaires, set up at the Karolinska Institute to study the determinants of prediabetes and type 2 diabetes." [] {IAO:0000119="PMID:35435501", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:12406920"}
synonym: "SDPP" RELATED OMO:0003000 []
