relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7064039/fullTextXML", comment="The US National Cancer Institute (NCI) has developed research networks focused on improving survival and health outcomes for cancer patients through the conduct of large‐scale clinical trials, including the National Clinical Trials Network (NCTN), the NCI Cancer Centers Program, and the NCI Community Oncology Research Program (NCORP). The NCTN provides funding and clinical trial infrastructure support to over 3000 sites via membership in NCTN network groups, including the SWOG Cancer Research Network (SWOG; formerly the Southwest Oncology Group)."}
relationship: coho:hasCohort coho:COHO_0000693 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4983010/fullTextXML", comment="SELECT was coordinated by SWOG, a national consortium of institutions and investigators that conducts multidisciplinary clinical trials to improve the practice of medicine in preventing, detecting, and treating cancer, and to enhance the quality of life for cancer survivors."}
relationship: coho:hasCohort coho:COHO_0002241 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3139891/fullTextXML", comment="The PCPT was a Phase III double-blinded, placebo-controlled trial, administered through the Southwest Oncology Group, that tested whether finasteride could reduce the period prevalence of prostate cancer during a 7-year intervention."}
property_value: IAO:0000112 "GCST90651081" xsd:string {dcterms:title="Common variation in a long non-coding RNA gene modulates variation of circulating TGF-β2 levels in metastatic colorectal cancer patients (Alliance).", xref="PMID:38745123", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11092225/fullTextXML", comment="To this end, we used clinical, genotyping, and pre-treatment candidate protein marker data obtained from patients with mCRC randomized to the Cancer and Leukemia Group B (CALGB, now part of the Alliance for Clinical Trials in Oncology (Alliance)) and the Southwest Oncology Group, CALGB/SWOG 80405."}

[Instance]
id: coho:COHO_0000596
name: Leeds Colorectal Cancer Study
def: "A population-based case-control study of colorectal cancer in the United Kingdom that recruited histologically confirmed incident cases aged 45–80, diagnosed in 1997–2000 at hospitals in Dundee, Leeds and York and in 2000–2013 in Leeds only, with controls matched for age and sex from the cases' general practice lists (supplemented after 2000 by friends or spouses of Leeds cases), all interviewed about diet, smoking and other lifestyle factors." [] {IAO:0000119="PMID:12584178", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5806861/fullTextXML"}
