property_value: coho:numberOfParticipants "7342" xsd:integer {IAO:0000116="individuals collected into the prospective cohort", xref="PMID:35130028", comment="We collected a prospective cohort of 7342 individuals (64% women, mean age 56 years) and estimated their 10-year risk for atherosclerotic cardiovascular disease both by a traditional risk score and a composite score combining the effect of a polygenic risk score and clinical risk factors."}
property_value: IAO:0000112 "GCST90277238" xsd:string {dcterms:title="Genome-wide association analysis of plasma lipidome identifies 495 genetic associations.", xref="PMID:37907536", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10618167/fullTextXML", comment="Here we report univariate and multivariate GWAS of 179 lipid species from 13 lipid classes in 7174 Finnish individuals from the GeneRISK cohort, followed by a phenome-wide association study (PheWAS) of the identified lipid-associated genetic loci in 377,277 biobank participants of the FinnGen study and a colocalization analysis with these endpoints."}

[Instance]
id: coho:COHO_0000438
name: Healthy Aging in Neighborhoods of Diversity across the Life Span
def: "A community-based prospective longitudinal cohort of 3,722 socioeconomically diverse African American and white adults aged 30-64, recruited between 2004 and 2009 by household screening from an area probability sample of 13 neighbourhoods of Baltimore, Maryland, in a factorial design by age, sex, race and poverty status, to examine how race and socioeconomic status influence the development of age-related health disparities." [] {IAO:0000119="PMID:20828101", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://handls.nih.gov/01Design.htm", IAO:0000119="PMID:42050538"}
subset: coho1:GWAS_subset
synonym: "HANDLS" RELATED OMO:0003000 []
synonym: "HANDLS Study" RELATED []
synonym: "Healthy Aging in Neighborhoods of Diversity across the Life Span Study" RELATED []
