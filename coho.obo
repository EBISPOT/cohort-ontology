relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12596486/fullTextXML", comment="The ASPREE was a large-scale placebo-controlled randomized trial (NCT01038583) of daily low-dose (100 mg) enteric-coated aspirin conducted in 19 114 adults aged over 70 years residing in Australia and the USA (≥ 65 years for US minorities) who had no prior cardiovascular events, dementia, or independence-limiting physical disability at trial enrolment.21 The median enrolment age of the cohort was 74 years [interquartile range (IQR) 72–78 ]."}
property_value: coho:numberOfParticipants "19114" xsd:integer {IAO:0000116="participants randomized in the trial", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12596486/fullTextXML", comment="Randomization was to daily low-dose aspirin or matching placebo for the 4.7 years of the trial.ResultsOf the 19 114 participants randomized (9525 aspirin, 9589 placebo), 15 668 without in-trial MACE consented to post-trial follow-up."}
property_value: IAO:0000112 "GCST90448086" xsd:string {dcterms:title="Genome-Wide Association Study of Cardiovascular Resilience Identifies Protective Variation in the CETP Gene.", xref="PMID:37929782", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37929782+AND+SRC%3AMED&format=json&resultType=core", comment="Our discovery genome-wide association study of N=12 031 ASCVD event-free individuals from the ASPREE (Aspirin in Reducing Events in the Elderly) trial identified 2 independent variants, rs9939224 (P-8) and rs56156922 (P-6), in the CETP (cholesteryl ester transfer protein) gene."}

