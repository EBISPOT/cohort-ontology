property_value: coho:numberOfParticipants "174180" xsd:integer {IAO:0000116="individuals pooled from 32 cohorts at the first datalock (29 March 2020)", xref="PMID:32888015", comment="At the time of the first datalock, data from 174 180 individuals have been pooled: 171 937 (98.7%) have complete follow-up or were censored (e.g. lost-to follow-up or death by other causes), 578 (0.3%) have had a first non-fatal cardiovascular event and 1665 (1.0%) have experienced a fatal cardiovascular event (Table 1)."}
property_value: IAO:0000112 "PMID:42724639" xsd:string {dcterms:title="Visceral adipose tissue and incident cardiovascular disease among individuals without diabetes: an analysis of 15 prospective cohorts from 7 countries in Latin America.", xref="PMID:42724639", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42724639+AND+SRC%3AMED&format=json&resultType=core", comment="Here, we evaluated the association between estimated VAT (eVAT) and incident CVD among individuals without diabetes and estimated its population-attributable fraction (PAF) using data from the Cohorts Consortium of Latin America and the Caribbean (CC-LAC)."}

[Instance]
id: coho:COHO_0002659
name: Ecuador Life
def: "A prospective birth cohort of newborns recruited from 2006 to 2009 at the hospital serving the rural district of Quinindé, Esmeraldas Province, in tropical coastal Ecuador, run by the Laboratorio de Investigaciones FEPIS with St George's, University of London, that follows the children through childhood to study how soil-transmitted helminth infections and other early-life microbial and environmental exposures affect immune development, atopy, allergic disease and asthma." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24990475"}
