property_value: coho:numberOfCases "12906" xsd:integer {IAO:0000116="cases and controls in the 2018 ECAC-led endometrial cancer GWAS meta-analysis", xref="PMID:30093612", comment="Here, we present an expanded meta-analysis of 12,906 endometrial cancer cases and 108,979 controls (including new genotype data for 5624 cases) and identify nine novel genome-wide significant loci, including a locus on 12q24.12 previously identified by meta-GWAS of endometrial and colorectal cancer."}
property_value: coho:numberOfControls "108979" xsd:integer {IAO:0000116="cases and controls in the 2018 ECAC-led endometrial cancer GWAS meta-analysis", xref="PMID:30093612", comment="Here, we present an expanded meta-analysis of 12,906 endometrial cancer cases and 108,979 controls (including new genotype data for 5624 cases) and identify nine novel genome-wide significant loci, including a locus on 12q24.12 previously identified by meta-GWAS of endometrial and colorectal cancer."}
property_value: IAO:0000112 "GCST90454186" xsd:string {dcterms:title="GWAS meta-analysis identifies five susceptibility loci for endometrial cancer.", xref="PMID:40633141", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40633141+AND+SRC%3AMED&format=json&resultType=core", comment="Building on genome-wide association studies (GWASs) by the Endometrial Cancer Association Consortium, we conducted a GWAS meta-analysis of 17,278 endometrial cancer cases and 289,180 controls, incorporating biobank samples from the UK, Finland, Estonia and Japan."}

[Instance]
id: coho:COHO_0001317
name: European Challenge for Healthy Aging
def: "A European family study of longevity that recruited people aged 90 or older, many of them centenarians, in Southern Denmark, Languedoc-Roussillon in France and Calabria in Italy, together with one of their children and, in a cousin-pair design, a child of a sibling who was or was not also long-lived, to investigate genetic and environmental factors in longevity and healthy ageing." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:17989723", IAO:0000119="PMID:42176242", IAO:0000119="PMID:16870633", IAO:0000119="PMID:20584770"}
subset: coho1:GWAS_subset
