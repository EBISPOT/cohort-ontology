relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/South_Korea {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11301725/fullTextXML", comment="The 90 patients with EGFR-mutation-positive locally advanced or metastatic NSCLC requiring afatinib therapy were enrolled from 6 centers, which are the Daejeon Korean Medicine University, Kosin University Gospel Hospital, Pusan National University, Yangsan Hospital, Konyang University Hospital, Catholic University of Korea Seoul St. Mary’s Hospital, and Ajou Universtity."}
property_value: coho:numberOfParticipants "90" xsd:integer {IAO:0000116="patients with EGFR-mutation-positive advanced NSCLC enrolled and randomised, February 2021 to December 2022 (2021-2022)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11301725/fullTextXML", comment="In this clinical trial, 90 subjects were enrolled."}
property_value: IAO:0000112 "PMID:38469817" xsd:string {dcterms:title="Genome-wide Analysis Identified <i>SEMA4D</i>, Novel Candidate Gene for Temperature Sensitivity in Patients With Non-Small Cell Lung Cancer.", xref="PMID:38469817", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10935759/fullTextXML", comment="Ninety patients were enrolled in the HangAmDan-B1-Investigator Initiated Trial (HAD-B1-IIT) study, which was a randomized, multicenter, open-label study for the comparison of the safety and efficacy of afatinib monotherapy and that of the combination therapy of afatinib and HAD-B1 for patients with locally advanced NSCLC and EGFR mutations."}

[Instance]
id: coho:COHO_0001837
name: Hannover-Almaty Endometrial Cancer Study
def: "A hospital-based case-control study of endometrial cancer in Kazakhstan, whose own investigators genotyped its samples with TaqMan assays for the final replication stage of a 2012 genome-wide association study of endometrial cancer, and whose data were used again in a 2013 study of inflammation pathway genes and endometrial cancer risk." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:23221126", IAO:0000119="PMID:22426144"}
