is_a: MONDO:0002516 ! digestive system cancer
is_a: MONDO:0021253 ! gallbladder neoplasm

[Term]
id: MONDO:0005414
name: treatment-refractory schizophrenia
def: "Schizophrenia which does not respond to commonly used treatments." []
is_a: MONDO:0005090 ! schizophrenia

[Term]
id: MONDO:0005416
name: osteoarthritis, knee
def: "Noninflammatory degenerative disease of the knee joint consisting of three large categories: conditions that block normal synchronous movement, conditions that produce abnormal pathways of motion, and conditions that cause stress concentration resulting in changes to articular cartilage. (Crenshaw, Campbell's Operative Orthopaedics, 8th ed, p2019)" []
is_a: MONDO:0005178 ! osteoarthritis

[Term]
id: MONDO:0005439
