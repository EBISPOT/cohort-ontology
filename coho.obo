relationship: coho:has_data_collection_location http://dbpedia.org/resource/Netherlands {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6080529/fullTextXML", comment="The Subjective Cognitive Impairment Cohort (SCIENCe) is a prospective cohort study including consecutive patients with SCD presenting at the Alzheimer Center of the VU University Medical Center Amsterdam."}
relationship: coho:isSubCohortOf coho:COHO_0000374 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12185448/fullTextXML", comment="We included 329 participants with SCD from the Subjective Cognitive Impairment Cohort (SCIENCe), embedded within the Amsterdam Dementia Cohort at the Alzheimer Center Amsterdam, Amsterdam UMC for whom baseline amyloid status had been assessed using cerebrospinal fluid (CSF) or positron emission tomography (PET)."}
property_value: coho:numberOfParticipants "151" xsd:integer {IAO:0000116="participants included in the first two years of inclusion (from June 2014); inclusion ongoing (2016)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6080529/fullTextXML", comment="In addition, we report results based on a selection of cross-sectional data of the first 151 SCIENCe participants."}
property_value: IAO:0000112 "PGS001775" xsd:string {dcterms:title="Risk of dementia in APOE ε4 carriers is mitigated by a polygenic risk score.", xref="PMID:34541285"}
property_value: IAO:0000112 "PMID:34541285" xsd:string {dcterms:title="Risk of dementia in APOE ε4 carriers is mitigated by a polygenic risk score.", xref="PMID:34541285", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8438688/fullTextXML", comment="We retrospectively studied 829 cognitively normal individuals with SCD from the Amsterdam Dementia Cohort and SCIENCe project (Subjective Cognitive Impairment Cohort).20 We selected all individuals with a baseline SCD diagnosis with available array genotyping, and availability of either ATN biomarkers, and/or follow‐up information."}

[Instance]
id: coho:COHO_0002352
name: Skin Cancer Nested Case-Control Study
def: "A case-control study of skin cancer nested within the Nurses' Health Study in the United States, in which women of the cohort's blood subcohort (blood given in 1989-1990) with incident melanoma, squamous cell carcinoma or basal cell carcinoma diagnosed after blood collection, and no earlier skin cancer, were compared with a common series of controls randomly selected from blood donors free of diagnosed skin cancer and matched by year of birth, with pigmentation and sun exposure information collected by a retrospective supplementary questionnaire." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:16943234", IAO:0000119="PMID:19500394"}
synonym: "SCNCCS" RELATED OMO:0003000 []
synonym: "skin cancer nested case-control study" RELATED []
synonym: "Skin Cancer Nested Case-Control Study within the NHS" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2367449/", comment="The NHS was established in 1976, when 121,700 female U.S. registered nurses between the ages of 30 and 55, residing in 11 larger U.S. states, completed and returned the initial self-administered questionnaire on their medical histories and baseline health-related exposures, forming the basis for the NHS cohort."}
relationship: coho:isSubCohortOf coho:COHO_0000456 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2367449/", comment="The sample consisted of 870 controls of European ancestry from a nested case-control study of skin cancer within the Nurses' Health Study (NHS)."}
property_value: coho:numberOfCases "218" xsd:integer {IAO:0000116="NHS skin-cancer nested study: melanoma cases and common controls in 2009", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2699349/fullTextXML", comment="We evaluated the associations of four genetic variants in the FGFR2 gene highly related to breast cancer risk and the three common tag-SNPs in the FGFR4 gene with skin cancer risk in a nested case-control study of Caucasians within the Nurses' Health Study (NHS) among 218 melanoma cases, 285 squamous cell carcinoma (SCC) cases, 300 basal cell carcinoma (BCC) cases, and 870 controls."}
