property_value: coho:numberOfParticipants "64941" xsd:integer {IAO:0000116="individuals in the lifetime MDD GWAS mega-analysis (16 655 cases, 48 286 controls)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13569458/fullTextXML", comment="We performed a genome-wide association mega-analysis of lifetime MDD case-control status in 64 941 individuals (16 655 cases and 48 286 controls) and evaluated the extent to which this design captured common-variant signal by estimating SNP-based heritability and genetic overlap with the latest Psychiatric Genomics Consortium major depression GWAS [10]."}
property_value: IAO:0000112 "GCST90841074" xsd:string {dcterms:title="Genetics of major depressive disorder in a homogeneous population with uniform phenotyping.", xref="PMID:42230966", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13569458/fullTextXML", comment="This genome-wide association (GWAS) mega-analysis combines lifetime major depressive disorder (MDD) and genotype data from sixteen Dutch cohorts in the BIONIC (BIObanks Netherlands Internet Collaboration) project."}

[Instance]
id: coho:COHO_0000898
name: Bone Mineral Density in Childhood Study
def: "A multiethnic longitudinal study of healthy children at five clinical centres in the United States, enrolled from 2002–2003 at ages 6 to 16 years (1,554 children), with a later enrolment wave of 5- and 19-year-olds, measured annually by dual-energy X-ray absorptiometry for up to 6 years, established to provide reference curves for bone mineral content and density by age, sex and race." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:17311856", IAO:0000119="PMID:34754074"}
