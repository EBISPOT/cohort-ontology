[Instance]
id: coho:COHO_0001498
name: Athens Study of Psychosis Proneness and Incidence of Schizophrenia
def: "A study of young men aged 18–24 doing compulsory military service in Greece, randomly selected in successive waves during their first two weeks at the National Basic Air Force Training Center in Tripolis, who completed self-rated questionnaires on schizotypy and psychopathology and computerised neurocognitive and eye-movement tasks and gave DNA, a subgroup being reassessed at discharge two years later. Led from the University Mental Health Research Institute in Athens, it studies psychosis proneness and its cognitive and genetic correlates in the general population." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:18834502", IAO:0000119="PMID:23155182", IAO:0000119="PMID:22503357"}
synonym: "ASPIS" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Greece {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15279051+AND+SRC%3AMED&format=json&resultType=core", comment="The aim of this study within the Athens Study of Psychosis Proneness and Incidence of Schizophrenia (ASPIS) was the examination of the latent structure of schizotypal dimensions among a large population of young male conscripts in the Greek Air Force during their first week of military training."}
property_value: coho:numberOfParticipants "2243" xsd:integer {IAO:0000116="young male conscripts examined", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2572614/fullTextXML", comment="Briefly, the Athens Study of Psychosis Proneness and Incidence of Schizophrenia (ASPIS) examined 2243 randomly selected young male conscripts aged 18 to 24 years from the Greek Air Force in their first 2 weeks of admission to the National Basic Air Force Training Center."}
property_value: IAO:0000112 "PMID:15279051" xsd:string {dcterms:title="Factorial composition of self-rated schizotypal traits among young males undergoing military training.", xref="PMID:15279051", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15279051+AND+SRC%3AMED&format=json&resultType=core", comment="The aim of this study within the Athens Study of Psychosis Proneness and Incidence of Schizophrenia (ASPIS) was the examination of the latent structure of schizotypal dimensions among a large population of young male conscripts in the Greek Air Force during their first week of military training."}

[Instance]
id: coho:COHO_0001499
name: Australian Twin Eye Study
def: "An Australian twin study of eye traits that combines twins, and some of their siblings, given an eye examination in the Twins Eye Study in Tasmania or in the Brisbane Adolescent Twin Study, with measures such as cycloplegic refraction, intraocular pressure and retinal photographs and with genome-wide genotypes, used in heritability, linkage and genome-wide association studies of ophthalmic traits. Its participants were recruited through the Australian Twin Registry, existing twin studies, schools and publicity." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19803772", IAO:0000119="PMID:23599335", IAO:0000119="PMID:23116649", IAO:0000119="PMID:20835236"}
synonym: "ATES" RELATED OMO:0003000 []
synonym: "Australian Twin Eye study" RELATED []
