property_value: IAO:0000112 "PMID:2951410" xsd:string {dcterms:title="Excess mortality of bipolar and unipolar manic-depressive patients.", xref="PMID:2951410", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2951410+AND+SRC%3AMED&format=json&resultType=core", comment="To compare mortality in bipolar and unipolar manic-depressive patients, 2168 manic-depressive first admissions reported to the Danish Psychiatric Central Register were divided into a bipolar group (19%), i.e., patients with at least one admission for mania during an average observation period of six years, and a unipolar group."}

[Instance]
id: coho:COHO_0001614
name: Danish Pelvic Mass Study
def: "A prospective Danish study that from September 2004 enrolled consecutive women aged 18 or older admitted for surgery because of a suspected pelvic mass to the Gynaecologic Clinic of Copenhagen University Hospital, Rigshospitalet, collecting their blood and tumour tissue with clinical data to identify factors that distinguish benign from malignant pelvic masses and predict the prognosis of ovarian cancer." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22363532", IAO:0000119="PMID:27418945", IAO:0000119="PMID:29696206"}
