relationship: coho:has_data_collection_location http://dbpedia.org/resource/Oceania
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Sweden {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4907351/supplementaryFiles", comment="this population based case-control study was conducted among Swedish women aged 50-74 years, who were residing in Sweden between January 1st 1994 and December 31st 1995."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4907351/supplementaryFiles", comment="National Study of the Genetics of Endometrial Cancer (NSECG) cases were identified from collaborating clinicians throughout the UK from 2008 to 2013, taking care not to recruit from centres involved in SEARCH."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4907351/supplementaryFiles", comment="USA; Clinic based cases"}
relationship: coho:hasCohort coho:COHO_0001486 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4907351/supplementaryFiles", comment="606 ANECS samples all of endometrioid-only histology were used for the original endometrial cancer case-control GWAS and a further 538 were genotyped using iCOGS for the first additional genotyping phase."}
relationship: coho:hasCohort coho:COHO_0001520 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13537468/fullTextXML", comment="We conducted replication analysis of the 15 loci detected in the discovery GWAS in two separate cohorts (Belgian and German), previously used within the collaboration of ECAC [5]. Replication in the Belgian population included 528 cases from the Leuven Endometrial Cancer Study (LES) and 1,266 controls from blood donors of the Leuven Multidisciplinary Breast Centre Study (LMBC). Replication analysis in the German population included 221 cases from the Bavarian Endometrial Cancer Study (BECS) and 251 healthy controls aged 55 years and older from the Bavarian Breast Cancer Cases and Controls (BBCC)."}
relationship: coho:hasCohort coho:COHO_0001861 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM302_ESM.xlsx", comment="| 9 | BECS/HJECS | Bavarian Endometrial Cancer Study/Hannover-Jena Endometrial Cancer Study | Germany; hospital-based cases, population-based cases |  | Illumina Infinium iSelect | 137 | 112"}
relationship: coho:hasCohort coho:COHO_0001997 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM302_ESM.xlsx", comment="| 8 | LES | Leuven Endometrial Cancer Study | Belgium; hospital based cases |  | Illumina Infinium iSelect | 321 | 219"}
relationship: coho:hasCohort coho:COHO_0002050 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-018-05427-7/MediaObjects/41467_2018_5427_MOESM2_ESM.pdf", comment="The sampling frame for the US studies WHI and E2C2 is not expected to overlap with the Mayo study, which provided a relatively small number of cases to ECAC."}
relationship: coho:hasCohort coho:COHO_0002080 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM302_ESM.xlsx", comment="| 10 | MoMaTEC | Molecular Markers in Treatment of Endometrial Cancer | Norway; population based cases | Norway; female blood donors | Illumina Infinium iSelect | 599 | 505"}
relationship: coho:hasCohort coho:COHO_0002130 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM302_ESM.xlsx", comment="|  | NECS | Newcastle Endometrial Cancer Study | Australia;  hospital-based cases |  | Illumina Infinium iSelect | 165 | 116"}
relationship: coho:hasCohort coho:COHO_0002183 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM302_ESM.xlsx", comment="| 6 | NSECG | National Study of Endometrial Cancer Genetics | England; population based cases |  | Illumina Infinium iSelect | 965 | 839"}
