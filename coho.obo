property_value: coho:numberOfParticipants "1203" xsd:integer {IAO:0000116="unrelated F508del homozygotes at lung-function extremes genotyped for the first consortium GWAS (extremes arm only)", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2995003/unicode", comment="The extremes of phenotype study collected and genotyped 1,203 unrelated CF patients who (a) were homozygous for F508del, the most common CFTR mutation and (b) had lung function at the extremes of the population distribution."}
property_value: IAO:0000112 "GCST90558259" xsd:string {dcterms:title="Genetic modifiers of body mass index in individuals with cystic fibrosis.", xref="PMID:39260370", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC11480786/", comment="The Cystic Fibrosis Genome Project (CFGP) is comprised of individuals with CF recruited by the CF Twin and Sibling Study (TSS)15 and Cystic Fibrosis-Related Diabetes (CFRD) Study16 (Johns Hopkins University), Genetic Modifier Study (GMS)17,18,19 and GMS of Severe CF Liver Disease (GMS CFLD)20,21 (University of North Carolina), and Early Pseudomonas Infection Control Observational (EPIC Obs) Study22 (University of Washington and Seattle Children’s Hospital)."}
