relationship: coho:has_data_collection_location http://dbpedia.org/resource/Finland {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11696681/fullTextXML", comment="In this study, we performed genome-wide association study (GWAS) meta-analyses in a total of 8011 individuals to investigate single nucleotide variants (SNVs) associated with 54 urinary metabolites measured by NMR in one Finnish cohort of individuals with type 1 diabetes (T1D) and two Scottish cohorts from a general population setting."}
relationship: coho:isCohortOf coho:COHO_0002753
property_value: coho:numberOfParticipants "9000" xsd:integer {IAO:0000116="participants with type 1 diabetes (approximate, 'nearly 9000'), 2024", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11733665/fullTextXML", comment="Starting as a small‐scale pilot project with the goal of recruiting a few hundred individuals, the FinnDiane Study has evolved over the years into one of the largest well‐characterized cohorts of individuals with type 1 diabetes, now encompassing nearly 9000 participants from across the country."}
property_value: IAO:0000112 "GCST90451702" xsd:string {dcterms:title="Genome-wide characterization of 54 urinary metabolites reveals molecular impact of kidney function.", xref="PMID:39746953", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11696681/fullTextXML", comment="The analysis included in total of 8011 individuals from the Finnish Diabetic Nephropathy Study (FinnDiane, n = 3244, including 1632 men and 1612 women)9,10, Generation Scotland (GS, n = 2743, including 1373 men and 1370 women)11, and the VIKING study (VIKING, n = 2024, including 811 men and 1213 women)12 (Fig. 1, Supplementary Table 1)."}

[Instance]
id: coho:COHO_0000497
name: IMAGEN study
def: "A longitudinal multicentre genetic-neuroimaging cohort of about 2,000 healthy 14-year-old adolescents recruited from high schools at eight European sites in England, Ireland, France and Germany, followed up at ages 16, 19 and 22 with behavioural, neuropsychological, MRI and genome-wide data, to study the genetic and neurobiological basis of impulsivity, reinforcer sensitivity and emotional reactivity and their value in predicting psychiatric disorders." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:21102431", IAO:0000119="PMID:32601453", IAO:0000119="PMID:36603003"}
