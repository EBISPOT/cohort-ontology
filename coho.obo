property_value: IAO:0000112 "PMID:21771975" xsd:string {dcterms:title="A genome-wide association study reveals a quantitative trait locus of adiponectin on CDH13 that predicts cardiometabolic outcomes.", xref="PMID:21771975", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3161336/fullTextXML", comment="In this study, we included 941 hypertensive subjects recruited by the Academia Sinica Multicentered Young-Onset Hypertension Genetic Study: 382 in the first-stage genome-wide scan and 559 in the second-stage confirmatory study."}

