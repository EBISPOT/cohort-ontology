property_value: IAO:0000112 "PMID:27649491" xsd:string {dcterms:title="Prediction of Bone Mineral Density and Fragility Fracture by Genetic Profiling.", xref="PMID:27649491", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27649491+AND+SRC%3AMED&format=json&resultType=core", comment="Sixty-two bone mineral density (BMD)-associated single-nucleotide polymorphisms (SNPs) were genotyped in 557 men and 902 women who had participated in the Dubbo Osteoporosis Epidemiology Study."}

[Instance]
id: coho:COHO_0001611
name: Danish Osteoporosis Prevention Study
def: "An investigator-initiated, partly randomised multicentre trial in Denmark that in 1990–1993 enrolled healthy white women aged 45–58 in early menopause, recruited by direct mailing to a random sample of women from the general population, and allocated them, open label, to hormone replacement therapy or no treatment either at random or by their own choice. Planned to run for 20 years, with its randomised treatment stopped in 2002, it was set up to test whether hormone replacement therapy started soon after menopause prevents osteoporotic fractures and to find clinical, biochemical and densitometric predictors of low bone mass and fracture." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:10340280", IAO:0000119="PMID:23048011"}
synonym: "DOPS" RELATED OMO:0003000 []
