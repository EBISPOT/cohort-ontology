relationship: coho:hasSubCohort coho:COHO_0002568
relationship: coho:isSubCohortOf coho:COHO_0000409 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9933300/fullTextXML", comment="From 1993 to 1998, the WHI enrolled 161,808 women aged 50 to 79 in randomized clinical trials (CT) or an observational study (OS)."}
property_value: coho:numberOfParticipants "68132" xsd:integer {IAO:0000116="women enrolled and randomised in the WHI Clinical Trial, 1993-1998", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2608/MediaObjects/41588_2013_BFng2608_MOESM1_ESM.pdf", comment="There are two major components of WHI: (1) a Clinical Trial (CT) that enrolled and randomized 68,132 women ages 50 – 79 into at least one of three placebo-control clinical trials (hormone therapy, dietary modification, and calcium/vitamin D); and (2) an Observational Study (OS) that enrolled 93,676 women of the same age range into a parallel prospective cohort study."}
property_value: IAO:0000112 "PMID:36797788" xsd:string {dcterms:title="Genome-wide polygenic risk score for major osteoporotic fractures in postmenopausal women using associated single nucleotide polymorphisms.", xref="PMID:36797788", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9933300/fullTextXML", comment="WHI CT examined the effects of menopausal hormone therapy (HT) vs. placebo, calcium and vitamin D supplementation vs. placebo, and low-fat eating patterns vs. usual eating patterns."}

[Instance]
id: coho:COHO_0002567
name: Women's Health Initiative Genetic Components of HIP Fracture Consortium
def: "A genetic study of hip fracture and bone mineral density within the Women's Health Initiative in the United States, made up of a case-control sample in which all hip fractures in the WHI Clinical Trial and Observational Study up to August 2007 were matched to controls, and a subsample of the WHI bone mineral density cohort, measured at three of the 40 WHI clinical centres, in which women with the best or worst hip bone density Z-scores and physical functioning scores were selected." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2249/MediaObjects/41588_2012_BFng2249_MOESM26_ESM.pdf", IAO:0000119="PMID:22504420"}
