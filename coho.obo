property_value: IAO:0000112 "GCST90558252" xsd:string {dcterms:title="Exploring the Germline Genetics of In Situ and Invasive Cutaneous Melanoma: A Genome-Wide Association Study Meta-Analysis.", xref="PMID:39141363", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39141363+AND+SRC%3AMED&format=json&resultType=core", comment="Three genome-wide association study meta-analyses were conducted of in situ melanoma vs controls, invasive melanoma vs controls, and in situ vs invasive melanoma (case-case) using 4 population-based genetic cohorts: the UK Biobank, the FinnGen cohort, the QSkin Sun and Health Study, and the Queensland Study of Melanoma: Environmental and Genetic Associations (Q-MEGA)."}

[Instance]
id: coho:COHO_0001032
name: Royal Brompton & Harefield Cardiovascular Research Centre Biobank
def: "A research biobank of the Royal Brompton and Harefield hospitals in London, United Kingdom, which since 2009 has collected blood and other samples, including cardiac tissue, with clinical, imaging and follow-up data from adult and paediatric patients attending the hospitals for the investigation or treatment of cardiovascular conditions, and from their relatives, to find genes and biomarkers for the diagnosis and prognosis of cardiovascular disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38032570", IAO:0000119="PMID:35086919", IAO:0000119="https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/royal-brompton-harefield-cardiovascular-research-centre-biobank/"}
