[Instance]
id: coho:COHO_0000854
name: Asia Breast Cancer Consortium
def: "A consortium of breast cancer genetic association studies in women of Asian ancestry, with studies in mainland China, Taiwan, South Korea and Japan (genome-wide data on about 24,000 cases and 25,000 controls by 2020), formed to discover breast cancer susceptibility loci in Asian populations." [] {IAO:0000119="PMID:39753771", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32139696", IAO:0000119="PMID:20585626"}
