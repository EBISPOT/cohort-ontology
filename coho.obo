relationship: coho:has_data_collection_location http://dbpedia.org/resource/Sweden {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:30109365%20AND%20SRC:MED&resultType=core&format=json", comment="The aim of this study was to analyse glycaemic control over a longer period, past the period of partial remission, after diagnosis in children followed before diagnosis in the Swedish Diabetes Prediction in Skåne (DiPiS) study compared with children of equal age not enrolled in pre-diabetes follow-up, receiving equivalent diabetes care."}
property_value: coho:numberOfParticipants "35683" xsd:integer {IAO:0000116="newborns screened with cord blood samples at birth, 2000-2004", xref="PMID:29752553", comment="35,683 cord blood samples were collected at birth along with basic demographic data."}
property_value: IAO:0000112 "PMID:29752553" xsd:string {dcterms:title="Influence of early-life parental severe life events on the risk of type 1 diabetes in children: the DiPiS study.", xref="PMID:29752553", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6060880/fullTextXML", comment="influence the risk of developing type 1 diabetes (T1D) using data from the prospective Diabetes Prediction in Skåne (DiPiS) study."}

[Instance]
id: coho:COHO_0002602
name: Étude Longitudinale Française depuis l'Enfance
def: "The first French national birth cohort, of children recruited at birth in 2011 in a random sample of maternity units in metropolitan France during 25 selected days spread over the year and followed by the French Institute for Demographic Studies (Ined), Inserm and the French Blood Agency, to study the determinants of development, health and socialisation of children from birth to adulthood through a multidisciplinary approach." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31747017", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ELFE"}
