property_value: coho:numberOfParticipants "10802" xsd:integer {IAO:0000116="participants enrolled 1993-2012 (initial cohort plus successive age-eligible cohorts)", xref="PMID:39641998", comment="An additional 4,644 participants who later became age-eligible were recruited in successive cohorts, leading to a total study population of 10,802 participants by 2012."}
property_value: IAO:0000112 "GCST90446233" xsd:string {dcterms:title="Extended genome-wide association study employing the African genome resources panel identifies novel susceptibility loci for Alzheimer's disease in individuals of African ancestry.", xref="PMID:38958117", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11350055/fullTextXML", comment="When not available, other information was used instead, such as age at diagnosis (Chicago Health and Aging Project [CHAP], Minority Aging Research Study/Clinical Minority Core [MARS/CORE]) or age at ascertainment (Indiana University)."}

[Instance]
id: coho:COHO_0001160
name: Christchurch Health and Development Study
def: "A population-based longitudinal birth cohort of the children born in the Christchurch urban region of New Zealand during a four-month period from April to August 1977, studied by the University of Otago, Christchurch, at birth, 4 months, 1 year, annually to age 16 and at intervals into adulthood (to age 40), on their health, development, social circumstances and wellbeing across the life course." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:33096046", IAO:0000119="PMID:41321066", IAO:0000119="PMID:40212739"}
