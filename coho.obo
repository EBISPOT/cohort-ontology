relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC10038917/", comment="Saliva collection kits were sent to 2,286 of these participants meeting the following criteria: they had completed the entire survey, reported that their data was usable, and had a valid US mailing address."}
property_value: coho:numberOfParticipants "3258" xsd:integer {IAO:0000116="participants who consented, completed at least part of the online study and passed QC", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC10038917/", comment="In total, 3,258 participants (1,948 females, 727 males, 583 unknown) consented to the study, completed at least a portion of the online study, and passed quality control filters (see Figure 2)."}
property_value: IAO:0000112 "GCST90809464" xsd:string {dcterms:title="Genome-wide investigation of prosody perception: Shared genetic influences between speech rhythm, musical rhythm, and reading traits.", xref="PMID:41715922", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13091348/fullTextXML", comment="The study population was a subset of those who participated in the Vanderbilt Online Musicality Study,47 where participants completed various internet-based tasks, including TOPsy, and submitted genetic samples."}

[Instance]
id: coho:COHO_0001431
name: Viva la Familia Study
def: "A family study of Hispanic children in Houston, Texas, conducted at the USDA/ARS Children's Nutrition Research Center of Baylor College of Medicine, which in 2000–2005 recruited families through a proband aged 4–19 with a BMI above the 95th percentile, together with the proband's siblings aged 4–19 and their parents. The children were phenotyped in depth (anthropometry, body composition by dual-energy X-ray absorptiometry, diet, physical activity, energy expenditure and metabolic risk factors) and followed up after one year, to map genetic and environmental contributions to childhood obesity and its comorbidities." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:23251661", IAO:0000119="PMID:16960181"}
subset: coho1:GWAS_subset
