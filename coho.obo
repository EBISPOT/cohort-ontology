property_value: IAO:0000112 "PMID:18483556" xsd:string {dcterms:title="A genome-wide association study identifies novel alleles associated with hair color and skin pigmentation.", xref="PMID:18483556", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2367449/", comment="The promising SNPs from the initial GWAS were further genotyped among 870 controls in the skin cancer nested case-control study within the NHS."}

