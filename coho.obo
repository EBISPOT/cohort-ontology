[Instance]
id: coho:COHO_0002702
name: Massachusetts General Hospital Premature Coronary Artery Disease Study
def: "A hospital-based case-control study of premature coronary artery disease at Massachusetts General Hospital in Boston, United States, with recruitment reported from 1999. Its Myocardial Infarction Genetics Consortium sample comprised men aged 50 or younger and women aged 60 or younger hospitalized with myocardial infarction between 1999 and 2004, with age- and sex-matched controls recruited through newspaper advertisements in Boston and its vicinity who reported no cardiovascular disease or cardiac medication use." [] {IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf", dcterms:contributor="GPT-6 (OpenAI), 2026-09", IAO:0000119="PMID:16262891", IAO:0000119="PMID:19198609"}
synonym: "Massachusetts General Hospital Premature Coronary Artery Disease" RELATED []
synonym: "MGH PCAD" RELATED OMO:0003000 []
synonym: "MGH Premature Coronary Artery Disease Study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2681011/", comment="Stage 1 consisted of the Myocardial Infarction Genetics Consortium (MIGen), a collection of 2,967 cases of early-onset MI (in men ≤50 years old or women ≤60 years old) and 3,075 age- and sex-matched controls free of MI from six international sites: Boston and Seattle in the United States as well as Sweden, Finland, Spain, and Italy (Table 1 and Supplementary Methods)."}
relationship: coho:isCohortOf coho:COHO_0002069
property_value: coho:numberOfCases "295" xsd:integer {IAO:0000116="Recruitment of patients with premature coronary artery disease presenting as acute coronary syndromes and outpatient controls during 1999–2003, reported in the original 2005 profile PMID:16262891; not the later MIGen GWAS sample.", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1289285/fullTextXML", comment="During the study period we enrolled 295 subjects with premature CAD and 145 controls."}
property_value: coho:numberOfControls "145" xsd:integer {IAO:0000116="Recruitment of patients with premature coronary artery disease presenting as acute coronary syndromes and outpatient controls during 1999–2003, reported in the original 2005 profile PMID:16262891; not the later MIGen GWAS sample.", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1289285/fullTextXML", comment="During the study period we enrolled 295 subjects with premature CAD and 145 controls."}
property_value: IAO:0000112 "PMID:19198609" xsd:string {dcterms:title="Genome-wide association of early-onset myocardial infarction with single nucleotide polymorphisms and copy number variants.", xref="PMID:19198609", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf", comment="MGH PCAD3 study is a hospital-based case-control study of cases of early-onset MI and controls matched on age and sex."}

[Instance]
id: coho:COHO_0002703
name: Special Turku Coronary Risk Factor Intervention Project, Parents
def: "The parents of the infants enrolled in the Special Turku Coronary Risk Factor Intervention Project (STRIP) in Turku, Finland, between 1989 and 1992, who enrolled in the trial with their children and contributed as a parent sample to genome-wide studies of blood lipids and anthropometric traits." [] {IAO:0000119="PMID:36224396", IAO:0000119="PMID:40691366", IAO:0000119="PMID:42011282", dcterms:contributor="GPT-6 (OpenAI), 2026-09", IAO:0000119="PMID:34887591"}
