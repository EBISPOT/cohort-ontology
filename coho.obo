id: coho:COHO_0002718
name: IARC-Thai Breast Cancer Study
def: "A hospital-based case-control study of breast cancer in Thai women in Thailand, initially recruiting women with newly diagnosed, histologically confirmed breast cancer at the National Cancer Institute in Bangkok and Khon Kaen Hospital during May 2002–March 2004, with controls randomly selected among healthy women visiting patients at the same hospitals for diseases other than breast or ovarian cancer, to investigate breast cancer susceptibility, including variation in DNA repair genes." [] {IAO:0000119="PMID:27931260", dcterms:contributor="GPT-6 (OpenAI), 2026-09", IAO:0000119="PMID:17922186", IAO:0000119="PMID:31066241", IAO:0000119="PMID:23535729"}
subset: coho1:PGS_subset
