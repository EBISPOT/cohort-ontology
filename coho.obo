relationship: coho:has_data_collection_location http://dbpedia.org/resource/Netherlands {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4552520/fullTextXML", comment="The GRECO program hosts and harmonizes studies on renal hemodynamics at the renal function unit of the University Medical Center Groningen, by standardization of methodology, including harmonization of study protocols and calibration over time."}
property_value: IAO:0000112 "PMID:21082022" xsd:string {dcterms:title="Genome-wide association study of blood pressure extremes identifies variant near UMOD associated with hypertension.", xref="PMID:21082022", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2965757/", comment="In the small GRECO cohort, urinary uromodulin concentration (p = 0.004) and 24 hour uromodulin excretion (p = 0.002; Wilcoxon′s signed ranks test) were found to be significantly increased after a high sodium intake (Table 6)."}

[Instance]
id: coho:COHO_0001825
name: Gilda Radner Familial Ovarian Cancer Registry
def: "A self-referred registry of families with two or more cases of ovarian cancer among blood relatives, or with a cancer syndrome possibly related to ovarian cancer, established in 1981 at Roswell Park Cancer Institute in Buffalo, New York, United States, which receives family cancer information from throughout the United States, obtains detailed family histories, documents cancers through medical records and pathology review, and collects and stores biological samples from registry participants for research on familial ovarian cancer." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29447163", IAO:0000119="PMID:19536330", IAO:0000119="PMID:8420680"}
