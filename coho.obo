relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4756509/fullTextXML", comment="All cases were genotyped with the iCOGS chip and compared to 5,000 UK controls selected from four UK studies (BBCS 1,231 controls, SBCS 704 controls, UKBGS 370 controls, SEARCH 2,695 controls) participating in BCAC"}
relationship: coho:isCohortOf coho:COHO_0000020
