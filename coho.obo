[Instance]
id: coho:COHO_0000564
name: Heart and Vascular Health Study
def: "A population-based case-control study of risk factors for cardiovascular outcomes among members of Group Health (now Kaiser Permanente Washington), an integrated health care system in western Washington State, with case groups of incident myocardial infarction, stroke, venous thromboembolism and atrial fibrillation and a shared control group frequency-matched to the myocardial infarction cases. Myocardial infarction, stroke and venous thromboembolism cases were identified from diagnosis codes (and, for venous thrombosis, heparin prescriptions) and validated by medical-record review; consenting participants gave blood for genotyping, and venous thromboembolism cases were followed for recurrence." [] {IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://pmc.ncbi.nlm.nih.gov/articles/instance/10152894/bin/NIHMS1835943-supplement-Supplemental_Publication_Material.pdf", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML"}
subset: coho1:GWAS_subset
synonym: "Heart and Vascular Health" RELATED []
