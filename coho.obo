relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7444809/fullTextXML", comment="Our study consisted primarily of a white population and was based in a specific region of the United States, which may limit the generalizability of our study results."}
property_value: coho:numberOfCases "787" xsd:integer {IAO:0000116="participants enrolled Nov 2012-Jun 2018 (endometriosis cases and controls), 2012-2018", xref="PMID:38665804", comment="The Women's Health Study: From Adolescence to Adulthood (A2A) is a longitudinal observational cohort study that enrolled 1,549 participants [n = 787 surgically confirmed women with endometriosis (cases) and n = 762 controls] from November 2012–June 2018, enrolling 85% of those who were eligible to participate in the study."}
property_value: coho:numberOfControls "762" xsd:integer {IAO:0000116="participants enrolled Nov 2012-Jun 2018 (endometriosis cases and controls), 2012-2018", xref="PMID:38665804", comment="The Women's Health Study: From Adolescence to Adulthood (A2A) is a longitudinal observational cohort study that enrolled 1,549 participants [n = 787 surgically confirmed women with endometriosis (cases) and n = 762 controls] from November 2012–June 2018, enrolling 85% of those who were eligible to participate in the study."}
property_value: coho:numberOfParticipants "1549" xsd:integer {IAO:0000116="participants enrolled Nov 2012-Jun 2018 (endometriosis cases and controls), 2012-2018", xref="PMID:38665804", comment="The Women's Health Study: From Adolescence to Adulthood (A2A) is a longitudinal observational cohort study that enrolled 1,549 participants [n = 787 surgically confirmed women with endometriosis (cases) and n = 762 controls] from November 2012–June 2018, enrolling 85% of those who were eligible to participate in the study."}
property_value: IAO:0000112 "PMID:38665804" xsd:string {dcterms:title="Plasma microRNA expression in adolescents and young adults with endometriosis: the importance of hormone use.", xref="PMID:38665804", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38665804+AND+SRC%3AMED&format=json&resultType=core", comment="The Women's Health Study: from Adolescence to Adulthood (A2A) is an ongoing WERF EPHect compliant longitudinal cohort."}

[Instance]
id: coho:COHO_0001455
name: African Ancestry Breast Cancer Genetic Consortium
def: "A consortium for genetic studies of breast cancer in women of African ancestry that pools whole-genome sequencing data, new Multi-Ethnic Genotyping Array genotypes and existing genotype data on breast cancer cases and controls from more than 20 studies in the United States, Africa and Barbados, among them the samples of the AMBER, ROOT, AABC and GAME-ON OncoArray consortia, for genome-wide association analyses and polygenic risk prediction." [] {IAO:0000119="PMID:41629673", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38741014"}
