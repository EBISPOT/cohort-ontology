relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13291382/fullTextXML", comment="This study examined how traumatic brain injury and post-traumatic stress disorder relate to cognitive function and neuroimaging markers in U.S. veterans from the Department of Defense Alzheimer's Disease Neuroimaging Initiative (ADNI-DOD)."}
relationship: coho:isSubCohortOf coho:COHO_0000367 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13311454/fullTextXML", comment="The DoD-ADNI is a multi-site extension of ADNI designed to investigate the effects of TBI and PTSD on AD-related pathology in Vietnam-era Veterans (Weiner et al., 2014, 2017)."}
property_value: coho:numberOfParticipants "289" xsd:integer {IAO:0000116="non-demented veterans with baseline neuropsychological testing", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13311454/fullTextXML", comment="Briefly, participant flow proceeded from the full non-demented DoD-ADNI cohort with baseline neuropsychological testing (n = 289) to the analytic WMH sample (n = 228) and the FreeSurfer subset (n = 183), with participants excluded for incomplete neuropsychological data (n = 5), incomplete/inconclusive TBI/PTSD screening data (n = 17), missing WMH data (n = 39), missing T1 data (n = 11), and FreeSurfer QC failures (n = 34)."}
property_value: IAO:0000112 "GCST90841377" xsd:string {dcterms:title="Large multi-ethnic genetic analyses of amyloid imaging identify new genes for Alzheimer disease.", xref="PMID:37101235", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10134547/fullTextXML", comment="These subjects were recruited from the Memory and Aging Project (MAP) at the Knight Alzheimer Disease Research Center (Knight-ADRC) [16, 17], Alzheimer's Disease Neuroimaging Initiative (ADNI) [18], the Dominantly Inherited Alzheimer Network (DIAN) [19], Anti-Amyloid Treatment in Asymptomatic Alzheimer's Disease (A4) [20], ADNI Department of Defense (ADNIDOD) studies, Australian Imaging, Biomarkers and Lifestyle (AIBL) [21], The Harvard Aging Brain Study (HABS) [22], and University of Pittsburgh (UPitt) [23]."}

[Instance]
id: coho:COHO_0000993
name: Anorexia Nervosa Genetics Initiative
def: "An international collaboration, sponsored by the Klarman Family Foundation and the US National Institute of Mental Health, that recruited individuals with a lifetime history of anorexia nervosa and controls in the United States, Australia, New Zealand, Sweden and Denmark, through treatment centres, national registers and traditional and social media, with blood samples and an online eating-disorder questionnaire, to rapidly expand the samples available for genome-wide association studies of anorexia nervosa." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:30287268"}
