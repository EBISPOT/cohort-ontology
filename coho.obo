[Instance]
id: coho:COHO_0001988
name: Los Angeles County Case-Control Studies of Ovarian Cancer
def: "Population-based case-control studies of ovarian cancer among women resident in Los Angeles County, California, United States, run at the Keck School of Medicine of the University of Southern California, in which cases with newly diagnosed ovarian cancer were identified through the county's SEER cancer registry (the Cancer Surveillance Program) and controls were recruited from the cases' neighbourhoods and matched on race/ethnicity and age; the studies take part in the Ovarian Cancer Association Consortium under the code USC." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19065661", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3108163/fullTextXML", IAO:0000119="PMID:18431743"}
