relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10764789/fullTextXML", comment="Patients 18 years and older admitted to 20 US hospitals (affiliated with 15 academic institutions) between May 2020 and March 2021 were enrolled within 72 h of hospital admission for COVID-19 infection."}
property_value: coho:numberOfParticipants "1164" xsd:integer {IAO:0000116="adults hospitalised with COVID-19 enrolled May 2020 to March 2021", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10764789/fullTextXML", comment="In all, 1164 participants were enrolled between May 5th, 2020 and March 19th, 2021 and followed up to 28 days while hospitalized."}
property_value: IAO:0000112 "MTBLS850" xsd:string {dcterms:title="Features of acute COVID-19 associated with post-acute sequelae of SARS-CoV-2 phenotypes: results from the IMPACC study.", xref="PMID:38172101", xref="https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS850", comment="Features of acute COVID-19 associated with post-acute sequelae of SARS-CoV-2 phenotypes: results from the IMPACC study"}

[Instance]
id: coho:COHO_0002735
name: Interactive Diet and Activity Tracking in AARP Study
def: "A study of adult AARP members aged 50 to 74 years recruited from the Pittsburgh area, Pennsylvania, United States, in 2012 and followed for 12 months with repeated dietary, physical activity and biomarker measurements." [] {IAO:0000119="PMID:32819883", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09"}
subset: coho1:MetaboLight_subset
synonym: "IDATA" RELATED OMO:0003000 []
synonym: "IDATA Study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12091781/fullTextXML", comment="In brief, IDATA participants were recruited from a list of AARP members, aged 50–74 years, who resided in or nearby Pittsburgh, Pennsylvania, spoke English, had internet access, were not on a weight-loss diet, and were free of major medical conditions and mobility limitations."}
property_value: coho:numberOfParticipants "1110" xsd:integer {IAO:0000116="adult AARP members aged 50 to 74 recruited (2012)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32819883+AND+SRC%3AMED&format=json&resultType=core", comment="From January through September 2012, 1,110 adult members of AARP, 50 to 74 years of age, were recruited from the Pittsburgh, PA, area to participate in the Interactive Diet and Activity Tracking in AARP (IDATA) study."}
property_value: IAO:0000112 "MTBLS12705" xsd:string {dcterms:title="Identification and validation of poly-metabolite scores for diets high in ultra-processed food: An observational study and post-hoc randomized controlled crossover-feeding trial.", xref="PMID:40392756", xref="https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS12705", comment="We aimed to identify poly-metabolite scores in blood and urine that are predictive of UPF intake.METHODS AND FINDINGS: Of the 1082 Interactive Diet and Activity Tracking in AARP (IDATA) Study (clinicaltrials.gov ID NCT03268577) participants, aged 50-74 years, who provided biospecimen consent, n=718 with serially collected blood and urine and one to six 24-hour dietary recalls (ASA-24s), collected over 12-months, met eligibility criteria and were included in the metabolomics analysis."}

[Instance]
id: coho:COHO_0002736
name: Isala
def: "A citizen-science cohort of women in Belgium who provided self-collected vaginal samples and completed extensive questionnaires, to characterise the vaginal microbiome and its associations with health, lifestyle and life-course events." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09", IAO:0000119="PMID:37884815"}
