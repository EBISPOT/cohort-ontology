property_value: IAO:0000112 "PMID:34435564" xsd:string {dcterms:title="Pre- and early post-natal exposure to phthalates and DINCH in a new type of mother-child cohort relying on within-subject pools of repeated urine samples.", xref="PMID:34435564", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8444084/fullTextXML", comment="Women of the French SEPAGES mother-child cohort were asked to collect three urine samples per day over seven consecutive days, twice during their pregnancy"}
property_value: seeAlso https://cohorte-sepages.fr/en

[Instance]
id: coho:COHO_0002609
name: Sysdimet study
def: "A 12-week randomised controlled dietary intervention trial of men and women aged 40 to 70 with impaired glucose metabolism and other features of the metabolic syndrome, recruited in 2007–2008 in the Kuopio area of Finland and run by the Department of Clinical Nutrition of the University of Eastern Finland, comparing a healthy Nordic-type diet rich in whole grain products, fatty fish and bilberries and a whole-grain-enriched diet with a control diet for effects on glucose and lipid metabolism, inflammation and endothelial function." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24587337", IAO:0000119="PMID:21870174", IAO:0000119="https://clinicaltrials.gov/study/NCT00573781"}
subset: coho1:GEC_subset
synonym: "Dietary Modulation of Gene Expression and Metabolic Pathways in Glucose Metabolism" RELATED []
synonym: "Health Grain intervention" RELATED []
synonym: "SYSDIMET" RELATED OMO:0003000 []
synonym: "Sysdimet" RELATED OMO:0003000 []
synonym: "Sysdimet Study" RELATED []
synonym: "Systems Biology Approach to Understand Dietary Modulation of Gene Expression and Metabolic Pathways in Subjects With Abnormal Glucose Metabolism" RELATED []
xref: https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SYSDIMET
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Finland {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3938672/fullTextXML", comment="The trial was conducted at the Department of Clinical Nutrition, University of Eastern Finland (Kuopio, Finland)."}
property_value: coho:numberOfParticipants "131" xsd:integer {IAO:0000116="individuals randomised to the three diets", xref="PMID:21870174", comment="Altogether, 131 individuals were assigned to either the Healthy Diet (n = 44), a whole-grain-enriched diet (WGED) (n = 42) or a control (n = 45) diet, and 104 participants (mean ± SD: age 59 ± 7 years; BMI 31.1 ± 3.5 kg/m(2)) who had completed the study, were analysed (Healthy Diet n = 36, WGED n = 34 and control diet n = 34)."}
property_value: IAO:0000112 "PMID:25874636" xsd:string {dcterms:title="CMPF does not associate with impaired glucose metabolism in individuals with features of metabolic syndrome.", xref="PMID:25874636", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4398480/fullTextXML", comment="In this Sysdimet study, 106 men and women were randomized into three groups"}

[Instance]
id: coho:COHO_0002610
name: Finnish Maternity Cohort
def: "A nationwide population-based biobank cohort of the women in Finland who have been pregnant since 1983, made up of the first-trimester serum samples left over from the screening for congenital infections offered to all pregnant women, now held by the Northern Finland Biobank Borealis and linkable to national health registers such as the Finnish Cancer Registry and the Medical Birth Register, as a resource for epidemiological, biomarker and surveillance studies of cancer and other diseases." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29071810", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/MAT"}
subset: coho1:GEC_subset
subset: coho1:IHCC_subset
synonym: "Finnish Maternity Cohort Serum Bank" RELATED OMO:0003000 []
synonym: "FMC" RELATED OMO:0003000 []
synonym: "MAT" RELATED OMO:0003000 []
synonym: "Maternity cohort" RELATED []
xref: https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/MAT
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Finland {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5727241/fullTextXML", comment="Because the FMC is nationwide and contains samples from 94% of all Finnish pregnant women 11, very large‐scale over‐generation studies can be designed by linking the identities of the mothers to their offspring and/or relatives 13."}
relationship: coho:isCohortOf coho:COHO_0002701
property_value: coho:numberOfParticipants "1000000" xsd:integer {IAO:0000116="women with stored serum samples (about 1 million; 2.0 million samples), 2016", xref="PMID:29071810", comment="At the end of 2016 the FMC comprised 2.0 million serum samples from about 1 million women."}
property_value: IAO:0000112 "PMID:37196097" xsd:string {dcterms:title="Sexually Transmitted Infections and Risk of Epithelial Ovarian Cancer: Results From the Finnish Maternity Cohort.", xref="PMID:37196097", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10681868/fullTextXML", comment="We measured antibodies (Abs) to CT, MG, HSV-2, and HPV-16/18 in serum samples in a nested case-control study in the Finnish Maternity Cohort (N = 484 cases 1:1 matched to controls)."}
property_value: seeAlso http://esis.fi/description/
property_value: seeAlso https://www.ppshp.fi/Tutkimus-ja-opetus/Biopankki/Pages/default.aspx

[Instance]
id: coho:COHO_0002611
name: Polish-Norwegian Study
def: "A prospective community-based cohort of volunteer men and women aged 45–64 years recruited in 2010–2011 from the city of Kielce and its surrounding rural area in south-eastern Poland, with questionnaires and stored blood and urine samples, set up with support from the Polish-Norwegian Research Fund to study health, health-related behaviours and risk factors for chronic diseases and premature mortality." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28626626", IAO:0000119="PMID:25948663"}
