property_value: IAO:0000112 "PMID:27028160" xsd:string {dcterms:title="Genome-wide Association Study of Cannabis Dependence Severity, Novel Risk Variants, and Shared Genetic Risks.", xref="PMID:27028160", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27028160+AND+SRC%3AMED&format=json&resultType=core", comment="This genome-wide association study for DSM-IV CAD criterion count was performed in 3 independent substance dependence cohorts (the Yale-Penn Study, Study of Addiction: Genetics and Environment [SAGE], and International Consortium on the Genetics of Heroin Dependence [ICGHD])."}

