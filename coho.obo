relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
property_value: coho:numberOfCases "2331" xsd:integer {IAO:0000116="cases and controls of the genome-wide scan (Nanjing and Beijing studies)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21725308+AND+SRC%3AMED&format=json&resultType=core", comment="To identify genetic factors that modify the risk of lung cancer in individuals of Chinese ancestry, we performed a genome-wide association scan in 5,408 subjects (2,331 individuals with lung cancer (cases) and 3,077 controls) followed by a two-stage validation among 12,722 subjects (6,313 cases and 6,409 controls)."}
property_value: coho:numberOfControls "3077" xsd:integer {IAO:0000116="cases and controls of the genome-wide scan (Nanjing and Beijing studies)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21725308+AND+SRC%3AMED&format=json&resultType=core", comment="To identify genetic factors that modify the risk of lung cancer in individuals of Chinese ancestry, we performed a genome-wide association scan in 5,408 subjects (2,331 individuals with lung cancer (cases) and 3,077 controls) followed by a two-stage validation among 12,722 subjects (6,313 cases and 6,409 controls)."}
property_value: coho:numberOfParticipants "5408" xsd:integer {IAO:0000116="cases and controls of the genome-wide scan (Nanjing and Beijing studies)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21725308+AND+SRC%3AMED&format=json&resultType=core", comment="To identify genetic factors that modify the risk of lung cancer in individuals of Chinese ancestry, we performed a genome-wide association scan in 5,408 subjects (2,331 individuals with lung cancer (cases) and 3,077 controls) followed by a two-stage validation among 12,722 subjects (6,313 cases and 6,409 controls)."}
property_value: IAO:0000112 "PMID:22899653" xsd:string {dcterms:title="Influence of common genetic variation on lung cancer risk: meta-analysis of 14 900 cases and 29 485 controls.", xref="PMID:22899653", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3607485/fullTextXML", comment="The Nanjing and Beijing Lung Cancer Studies provided summary data on the top SNPs for overall lung cancer risk and risk by specific histology."}

[Instance]
id: coho:COHO_0002118
name: Norwegian Bone Marrow Donor Registry
def: "The national registry of healthy volunteer bone marrow donors in Norway, held at Oslo University Hospital, whose members are HLA-typed on inclusion in the registry; random selections of registered donors, with their HLA data and samples, serve as healthy population controls in Norwegian genetic and epidemiological studies of immune-mediated disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:26207384", IAO:0000119="PMID:22590574", IAO:0000119="PMID:29684411"}
