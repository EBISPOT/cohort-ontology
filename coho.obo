relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13913/fullTextXML", comment="Women are asked to join the Million Women Study when they are invited to routine screening for breast cancer at 61 of the screening centres of the UK National Health Service Breast Screening Programme (NHSBSP)."}
