[Instance]
id: coho:COHO_0000992
name: Department of Defense Alzheimer's Disease Neuroimaging Initiative
def: "A multi-site extension of the Alzheimer's Disease Neuroimaging Initiative, funded by the US Department of Defense, that enrolled Vietnam War veterans with a history of traumatic brain injury and/or ongoing post-traumatic stress disorder, with or without mild cognitive impairment, and veteran controls without either, identified mainly through Veterans Affairs records, and studies them with ADNI's clinical, cognitive, imaging and fluid biomarker methods to find whether these conditions contribute to the development of Alzheimer's disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28758146", IAO:0000119="PMID:42316769"}
subset: coho1:GWAS_subset
