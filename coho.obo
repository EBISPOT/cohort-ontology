synonym: "Epidemiology of Prostate Cancer" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/France {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10807638/fullTextXML", comment="EPICAP (Epidemiological study of prostate cancer) is a population‐based case–control study conducted in the department of Hérault located in the south of France between 2012 and 2014 to investigate the role of environmental and genetic factors in the occurrence of prostate cancer."}
property_value: coho:numberOfCases "819" xsd:integer {IAO:0000116="Interviewed EPICAP cases and controls", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38174802+AND+SRC%3AMED&format=json&resultType=core", comment="A total of 819 incident cases and 879 controls were interviewed face-to-face using a standardized questionnaire gathering information on known or suspected risk factors of prostate cancer and personal history of specific sexually and non-sexually transmitted infections: gonorrhea, syphilis, trichomonas, herpes, mononucleosis, Epstein-Barr virus, varicella-zoster, and dengue."}
property_value: coho:numberOfControls "879" xsd:integer {IAO:0000116="Interviewed EPICAP cases and controls", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38174802+AND+SRC%3AMED&format=json&resultType=core", comment="A total of 819 incident cases and 879 controls were interviewed face-to-face using a standardized questionnaire gathering information on known or suspected risk factors of prostate cancer and personal history of specific sexually and non-sexually transmitted infections: gonorrhea, syphilis, trichomonas, herpes, mononucleosis, Epstein-Barr virus, varicella-zoster, and dengue."}
property_value: IAO:0000112 "PGS000733" xsd:string {dcterms:title="African-specific improvement of a polygenic hazard score for age at diagnosis of prostate cancer.", xref="PMID:32930425"}
property_value: IAO:0000112 "PMID:38174802" xsd:string {dcterms:title="Sexually and non-sexually transmitted infections and the risk of prostate cancer: Results from the EPICAP study.", xref="PMID:38174802", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10807638/fullTextXML", comment="We used data from epidemiological study of prostate cancer (EPICAP), a population‐based case–control study."}

