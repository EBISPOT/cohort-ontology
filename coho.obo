property_value: coho:numberOfParticipants "18314" xsd:integer {IAO:0000116="participants randomised (smokers, former smokers and asbestos-exposed workers)", xref="PMID:15572756", comment="The Beta-Carotene and Retinol Efficacy Trial (CARET) tested the effect of daily beta-carotene (30 mg) and retinyl palmitate (25,000 IU) on the incidence of lung cancer, other cancers, and death in 18,314 participants who were at high risk for lung cancer because of a history of smoking or asbestos exposure."}
property_value: IAO:0000112 "PMID:28604730" xsd:string {dcterms:title="Large-scale association analysis identifies new lung cancer susceptibility loci and heterogeneity in genetic susceptibility across histological subtypes.", xref="PMID:28604730", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf", comment="For the OncoArray Project, CARET provided DNA extracted from whole blood of lung cancer cases and controls matched on age at baseline (+/- 4 years), sex, race, baseline smoking status, history of occupational asbestos exposure (asbestos vs heavy smoker), and year of enrollment (2-year intervals)."}

[Instance]
id: coho:COHO_0001572
name: Clinical Antipsychotic Trials of Intervention Effectiveness
def: "A multiphase randomised trial of the effectiveness of antipsychotic drugs in adults aged 18–67 with chronic schizophrenia, run under the US National Institute of Mental Health's CATIE programme in 2001–2004 at 57 clinical sites across the United States (public mental health, academic, Veterans Affairs and managed care settings), whose double-blind first phase compared the first-generation drug perphenazine with the second-generation drugs olanzapine, quetiapine, risperidone and ziprasidone for up to 18 months, with all-cause treatment discontinuation as the primary outcome. Participants could join an optional genetic sub-study by donating DNA." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:16172203", IAO:0000119="PMID:19721433", IAO:0000119="PMID:12908658", IAO:0000119="PMID:18347602"}
