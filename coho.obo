relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf", comment="Participants were recruited at four clinical sites: 1) Brown University (Providence, RI); 2) The Ohio State University (Columbus, OH); 3) University of Maryland and The Johns Hopkins University (Baltimore, MD); and 4) University of Pittsburgh (Pittsburgh, PA)."}
property_value: coho:numberOfParticipants "4796" xsd:integer {IAO:0000116="men and women aged 45-79 recruited 2004-2006", xref="https://www.niams.nih.gov/grants-funding/funded-research/osteoarthritis-initiative", comment="The OAI cohort of 4,796 participants is 58% female and ranged in age from 45-79 at time of recruitment."}
property_value: IAO:0000112 "GCST90566795" xsd:string {dcterms:title="Translational genomics of osteoarthritis in 1,962,069 individuals.", xref="PMID:40205036", xref="https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf", comment="The Osteoarthritis Initiative (OAI) is a prospective longitudinal study designed to identify risk factors for the incidence and progression of symptomatic tibiofemoral knee osteoarthritis."}

[Instance]
id: coho:COHO_0000595
name: SWOG Cancer Research Network
def: "A cancer clinical trials network, formerly the Southwest Oncology Group, that is one of the network groups of the US National Cancer Institute's National Clinical Trials Network and runs multicentre cancer treatment and cancer prevention trials in adults at its member sites; its trial cohorts include the CALGB/SWOG 80405 trial in metastatic colorectal cancer, the Selenium and Vitamin E Cancer Prevention Trial and the Prostate Cancer Prevention Trial." [] {IAO:0000119="PMID:25028457", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27519183", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11092225/fullTextXML", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7064039/fullTextXML"}
subset: coho1:GWAS_subset
