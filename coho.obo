property_value: coho:numberOfParticipants "7169" xsd:integer {IAO:0000116="participants from whom data were collected, May 2021 to February 2022", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12875989/fullTextXML", comment="The SerGenCovid-19 project successfully collected data from 7,169 participants across Italy."}
property_value: IAO:0000112 "GCST90992867" xsd:string {dcterms:title="<i>CMTM8</i> variants influence BNT162b2 COVID-19 vaccination response by regulating granulocytic/polymorphonuclear myeloid-derived suppressor cell activity.", xref="PMID:41659846", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12875989/fullTextXML", comment="Here, we conducted a Genome Wide Association Study (GWAS) on anti-S IgG levels following Pfizer-BioNTech COVID-19 vaccination in 1,968 participants from the SerGenCovid-19 initiative, a cohort study comprising 7,169 genetically characterized individuals from the general Italian population."}

[Instance]
id: coho:COHO_0001448
name: CALGB 40502
def: "A randomised, three-arm phase III trial led by the Cancer and Leukemia Group B, with the North Central Cancer Treatment Group (as N063H), the Eastern Cooperative Oncology Group and the Southwest Oncology Group taking part, that enrolled patients aged 18 or over with locally recurrent (stage IIIC) or metastatic (stage IV) breast cancer and no prior chemotherapy for metastatic disease at institutions in the United States from 2008 to 2011, comparing first-line paclitaxel once per week with nab-paclitaxel or ixabepilone once per week, each given with bevacizumab (optional from March 2011), with progression-free survival as the primary end point." [] {IAO:0000119="PMID:33981951", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:26056183", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT00785291"}
