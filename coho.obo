[Instance]
id: coho:COHO_0001875
name: Hubei Type 2 Diabetes Studies
def: "A type 2 diabetes case-control sample of unrelated Han Chinese from Hubei province, China, made up of people with type 2 diabetes and nondiabetic controls, genotyped as one of three independent replication populations in a genome-wide association study of type 2 diabetes in Chinese Hans." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22961080"}
