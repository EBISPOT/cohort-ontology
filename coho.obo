property_value: IAO:0000112 "PMID:32066700" xsd:string {dcterms:title="Genome-wide study of immune biomarkers in cerebrospinal fluid and serum from patients with bipolar disorder and controls.", xref="PMID:32066700", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7026056/fullTextXML", comment="Subjects were recruited from a long-term naturalistic study of bipolar disorder, the St. Göran Bipolar Project, at the bipolar outpatient unit at the Northern Stockholm psychiatric clinic in Stockholm, Sweden."}

[Instance]
id: coho:COHO_0001470
name: Alzheimer's Disease Cardiff Cohort
def: "A case–control cohort of people with sporadic early- or late-onset Alzheimer's disease and elderly controls screened for dementia, recruited from community and hospital settings in the United Kingdom between the early 2000s and 2020 with funding from the Medical Research Council, the Moondance Foundation and Health and Care Research Wales, and assessed with a standardised clinical and neuropsychological protocol. Its longitudinal clinical and cognitive data and blood samples support genome-wide genotyping, plasma biomarker and induced pluripotent stem cell studies of Alzheimer's disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:37480051", IAO:0000119="PMID:35383826", IAO:0000119="PMID:40614728"}
synonym: "AD Cardiff Cohort" RELATED []
synonym: "ADCC" RELATED OMO:0003000 []
