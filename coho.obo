property_value: IAO:0000112 "GCST90809085" xsd:string {dcterms:title="Genetic survey of biomarkers at early and mid-pregnancy identifies pregnancy-specialized immune regulation.", xref="PMID:42378311", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13340790/fullTextXML", comment="The IMPaCT cohort included 2436 mothers across three child outcome groups (ASD N = 339, DD N = 1193, GP N = 904) with blood sample measurements taken at two timepoints (14–147 days apart) [S7c Fig] per individual over the first and second trimesters (Fig 1a)."}
