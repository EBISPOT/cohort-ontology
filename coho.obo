[Instance]
id: coho:COHO_0000594
name: Osteoarthritis Initiative
def: "A multicentre prospective observational study of knee osteoarthritis, run as a public-private partnership between the NIH and industry, that recruited 4,796 men and women aged 45-79 at four US clinical sites in 2004-2006 into progression (symptomatic knee osteoarthritis), incidence (increased risk) and non-exposed reference subcohorts, and followed them with clinical examinations, knee radiographs at baseline and 12, 24, 36, 48, 72 and 96 months, and biospecimen collection, to identify risk factors and biomarkers for the onset and progression of knee osteoarthritis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8342605/fullTextXML", IAO:0000119="PMID:23372535", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8487312/fullTextXML", IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf", IAO:0000119="https://www.niams.nih.gov/grants-funding/funded-research/osteoarthritis-initiative"}
subset: coho1:GWAS_subset
synonym: "OAI" RELATED OMO:0003000 []
