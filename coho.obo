relationship: coho:has_data_collection_location http://dbpedia.org/resource/Norway {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10684646/fullTextXML", comment="The trial was conducted at the Department of Neurology, Haukeland University Hospital, Bergen, Norway."}
property_value: coho:numberOfParticipants "20" xsd:integer {IAO:0000116="individuals with Parkinson's disease enrolled and randomised (2022)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10684646/fullTextXML", comment="In total, 26 individuals with PD were screened, and 20 eligible participants were enrolled, all of whom completed the study (Fig. 1)."}
property_value: IAO:0000112 "MTBLS8812" xsd:string {dcterms:title="NR-SAFE: a randomized, double-blind safety trial of high dose nicotinamide riboside in Parkinson's disease.", xref="PMID:38016950", xref="https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS8812", comment="NR-SAFE: a randomized, double-blind safety trial of high dose nicotinamide riboside in Parkinson's disease"}

[Instance]
id: coho:COHO_0002740
name: OmegaROP
def: "A prospective cohort of all preterm infants born before 29 weeks of gestational age and admitted to the neonatal intensive care unit of Dijon University Hospital, France, between July 2015 and January 2018, whose erythrocyte polyunsaturated fatty acids were measured shortly after birth to evaluate their value in predicting retinopathy of prematurity." [] {IAO:0000119="PMID:31138879", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09"}
subset: coho1:MetaboLight_subset
