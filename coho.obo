[Instance]
id: coho:COHO_0002267
name: Mount Sinai Hospital-Princess Margaret Multicancer Study
def: "A hospital-based case–control study of lung and head and neck cancers conducted from 2008 in the Greater Toronto Area, Canada, at Mount Sinai Hospital (Sinai Health System) and Princess Margaret Cancer Centre, in which histologically confirmed cases seen at the hospitals' clinics and controls selected at random from family medicine clinic databases, frequency-matched on age and sex, were interviewed with a standard questionnaire on lifestyle, occupational, medical and family history." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32857771", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf"}
