[Instance]
id: coho:COHO_0001853
name: Hellenic Longitudinal Investigation of Aging and Diet
def: "A population-based, multidisciplinary longitudinal study of older adults in Greece, randomly selected at age 65 or over from the municipality registries of Marousi, a suburb of Athens, and of the city of Larissa and its rural surroundings, with baseline evaluations from 2011 to 2015 and follow-up evaluations thereafter, designed to estimate the prevalence and incidence of Alzheimer's disease, other dementias, mild cognitive impairment and other neuropsychiatric conditions of ageing and to study their associations with nutrition in this Mediterranean population." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24993387", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11817854/fullTextXML"}
subset: coho1:PGS_subset
