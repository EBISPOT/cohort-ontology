property_value: IAO:0000112 "GCST90797644" xsd:string {dcterms:title="Deciphering tissue-specific protein regulation for insights into cardiometabolic disease.", xref="PMID:41456820", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12824914/fullTextXML", comment="Utilizing Olink technology, we assessed relative protein levels across plasma and tissue (aortic wall, mammary artery, liver, and skeletal muscle) from the STARNET cohort: 284 individuals with a high prevalence of coronary artery disease (CAD)."}

