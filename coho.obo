[Instance]
id: coho:COHO_0002175
name: North of Scotland Osteoporosis Study
def: "A population-based osteoporosis screening programme of postmenopausal women aged 60-82 at baseline, recruited at centres in Aberdeen and Dingwall in the north of Scotland, who underwent bone mineral density measurement in 2001-2003 and gave questionnaire data and DNA samples." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fng.2249/MediaObjects/41588_2012_BFng2249_MOESM26_ESM.pdf", IAO:0000119="PMID:18633668", IAO:0000119="PMID:20966103"}
