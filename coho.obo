[Instance]
id: coho:COHO_0000695
name: SpiroMeta Consortium
def: "A consortium of cohort studies of European-ancestry individuals, initially 14 genome-wide association studies with over 20,000 participants and later expanded to about 79,000, established to meta-analyse genome-wide association studies of spirometric lung function." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:20010834"}
subset: coho1:GWAS_subset
