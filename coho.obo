property_value: IAO:0000112 "PMID:10577996" xsd:string {dcterms:title="Human prostacyclin synthase gene and hypertension : the Suita Study.", xref="PMID:10577996", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10577996+AND+SRC%3AMED&format=json&resultType=core", comment="We then investigated the possible association of this repeat polymorphism with blood pressure in a large population-based sample (the Suita Study), which consisted of 4971 Japanese participants."}

[Instance]
id: coho:COHO_0002419
name: SUpplementation en VItamines et Minéraux AntioXydants
def: "A randomised, double-blind, placebo-controlled primary-prevention trial in the general adult population of France, which in 1994 enrolled women aged 35 to 60 and men aged 45 to 60 and followed them for eight years to test whether daily supplementation with antioxidant vitamins (vitamin C, vitamin E and beta-carotene) and minerals (selenium and zinc) at nutritional doses reduces cancers and cardiovascular diseases." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:9503043", IAO:0000119="PMID:9683310"}
