property_value: coho:numberOfParticipants "3614" xsd:integer {IAO:0000116="adults aged 24-77, from a random population-register sample of western Sweden, examined at baseline in 2001-2004", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12959171/fullTextXML", comment="A random sample of 8626 adults aged 24–77 years was drawn from population registers, of whom 3614 (42%) accepted the invitation and underwent baseline clinical examination between 2001 and 2004."}
property_value: IAO:0000112 "PMID:38809556" xsd:string {dcterms:title="Domain-Specific Physical Activity and Stroke in Sweden.", xref="PMID:38809556", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38809556+AND+SRC%3AMED&format=json&resultType=core", comment="The prospective, population-based Interplay Between Genetic Susceptibility and External Factors (INTERGENE) cohort study was conducted among a random sample of individuals from an urban-rural area covering western Sweden; 3614 individuals aged 24 to 77 years were examined in 2001 to 2004, and 1394 individuals were reexamined in 2014 to 2016."}

[Instance]
id: coho:COHO_0001927
name: INTERPHONE study
def: "A multinational case-control study of glioma, meningioma, acoustic neurinoma and parotid gland tumours in residents aged 30 to 59, carried out with a common core protocol by sixteen centres in thirteen countries (Australia, Canada, Denmark, Finland, France, Germany, Israel, Italy, Japan, New Zealand, Norway, Sweden and the United Kingdom) with cases diagnosed during 2000–2004, set up to investigate whether mobile phone use and the radiofrequency fields it emits increase the risk of these tumours, and also collecting information on other potential risk factors." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:34648614", IAO:0000119="PMID:17636416"}
