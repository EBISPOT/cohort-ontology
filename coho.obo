property_value: IAO:0000112 "GCST90429011" xsd:string {dcterms:title="Assessing the Role of Cortisol in Anxiety, Major Depression, and Neuroticism: A Mendelian Randomization Study Using <i>SERPINA6</i>/<i>SERPINA1</i> Variants.", xref="PMID:38525495", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10959652/fullTextXML", comment="The CORNET consortium, with a pooled mean age (SD) of 53.3 (11.2) years and 36.3% men, was a GWAS meta-analysis of 25,314 participants of European ancestry from 17 European population-based cohorts adjusted for age, sex, and genetic principal components (PCs) for population structure."}

[Instance]
id: coho:COHO_0001451
name: Amsterdam Born Children and their Development
def: "A prospective, multi-ethnic birth cohort run from Amsterdam UMC that recruited pregnant women living in Amsterdam, the Netherlands, at their first prenatal visit between January 2003 and March 2004, and follows their children from pregnancy into young adulthood to identify factors in pregnancy and early childhood that explain later health and health inequalities, with particular attention to differences between ethnic groups." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://abcd.amsterdamumc.nl/en/background-information-abcd-study/", IAO:0000119="PMID:41550966"}
