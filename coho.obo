property_value: IAO:0000112 "PMID:33901219" xsd:string {dcterms:title="Cohort profile: The Singapore Breast Cancer Cohort (SGBCC), a multi-center breast cancer cohort for evaluation of phenotypic risk factors and genetic markers.", xref="PMID:33901219", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33901219+AND+SRC%3AMED&format=json&resultType=core", comment="This article aims to provide a detailed description of the Singapore Breast Cancer Cohort (SGBCC), an ongoing multi-ethnic cohort established with the overarching goal to identify genetic markers for breast cancer risk, prognosis and treatment response, as well as to understand the ethnic differences in disease risk and outcome in an Asian setting."}

[Instance]
id: coho:COHO_0002370
name: NIMH Schizophrenia Genetics Initiative
def: "A family collection of the US National Institute of Mental Health Genetics Initiative, a multisite study set up as a national resource with a centralised clinical database and cell repository, in which Washington University, Harvard University and Columbia University ascertained, from 1991 to 1997, nuclear families of European and African ancestry with siblings affected by schizophrenia or schizoaffective disorder, for genetic linkage and association studies of schizophrenia; its cases later formed one of the three collections of the Molecular Genetics of Schizophrenia genome-wide association study." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:9674971", IAO:0000119="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000167.v1.p1", IAO:0000119="PMID:23936182", IAO:0000119="PMID:9674973"}
