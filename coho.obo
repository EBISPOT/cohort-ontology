property_value: coho:numberOfParticipants "5499" xsd:integer {IAO:0000116="adults with CKD enrolled in phases 1 (2003-2008) and 3 (2013-2015)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8855239/fullTextXML", comment="The Chronic Renal Insufficiency Cohort (CRIC) Study is a multicenter observational cohort study that enrolled 5499 adults from 7 clinical centers across the US."}
property_value: IAO:0000112 "GCST90257106" xsd:string {dcterms:title="Trans-ethnic genome-wide association study of blood metabolites in the Chronic Renal Insufficiency Cohort (CRIC) study.", xref="PMID:35120996", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35120996+AND+SRC%3AMED&format=json&resultType=core", comment="Here, we conducted a GWAS of 537 blood metabolites measured in the Chronic Renal Insufficiency Cohort (CRIC) Study, with separate analyses in 822 White and 687 Black study participants."}

