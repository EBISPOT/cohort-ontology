property_value: IAO:0000112 "PMID:24121790" xsd:string {dcterms:title="A genome-wide association study identifies new susceptibility loci for esophageal adenocarcinoma and Barrett's esophagus.", xref="PMID:24121790", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3840115/", comment="Of these, 87 were genotyped in 874 histologically confirmed esophageal adenocarcinoma cases from the Stomach and Oesophageal Cancer Study (SOCS), 759 histologically confirmed Barrett’s esophagus cases from the UK Barrett’s Oesophagus Gene Study (UK Gene Study) and 6,911 controls, of which 1,711 were from the SEARCH Study and 5,200 from the Welcome Trust Case Control Consortium 2 (WTCCC2)."}

[Instance]
id: coho:COHO_0002497
name: obsolete Universitäts Klinikum Bonn
comment: Obsoleted 2026-09-24. UKBonn ('Universitäts Klinikum Bonn') is the PGS Catalog's id for the Lynch syndrome carriers from the University Hospital of Bonn in the Dueñas 2023 polygenic-score study: 547 people with genetically confirmed Lynch syndrome from 392 families, index patients and relatives found by cascade testing at Bonn's Institute of Human Genetics. The paper names them only by the hospital ('the UKB LS cohort'). No study name, design paper or registry name is given, and the paper does not say whether they come from the German HNPCC Consortium registry. It is a hospital's patient series, so, like HZ, it is not a cohort. No COHO term for a Bonn Lynch syndrome series (the Bonn terms in COHO are COVID, OMNI and psychiatric studies). The Spanish half, ICO (E522, placeholder COHO:0001901, 'the ICO LS cohort' from the Catalan Institute of Oncology's Lynch Syndrome Database), is a separate row. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.
is_obsolete: true

[Instance]
id: coho:COHO_0002498
name: United Kingdom Colorectal Adenoma Prevention trial
def: "A multicentre, randomised, double-blind, placebo-controlled trial in the United Kingdom and Denmark of aspirin (300 mg/day) and folic acid (0.5 mg/day) in a 2 x 2 factorial design for the prevention of colorectal adenoma recurrence, in patients who had had a colorectal adenoma removed in the six months before recruitment and who were followed up with a second colonoscopy after about three years; DNA from its participants has been used in genetic studies of adenoma risk and recurrence." [] {IAO:0000119="PMID:17971770", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:18022173", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10641704/fullTextXML"}
