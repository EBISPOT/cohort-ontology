property_value: coho:numberOfCases "515" xsd:integer {IAO:0000116="bipolar disorder cases and UK controls (2009)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19089808+AND+SRC%3AMED&format=json&resultType=core", comment="The aim of our study is to explore the association of DTNBP1 with BD and with a sub phenotype, presence/absence of psychotic symptoms, in a sample of 515 patients with BD (ICD10/DSMIV) and 1,316 ethnically matched control subjects recruited from the UK."}
