relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12649793/fullTextXML", comment="the study population consisted primarily of middle-aged and older adults from community-dwelling populations in the United States"}
relationship: coho:isCohortOf coho:COHO_0001586
