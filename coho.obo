relationship: coho:has_data_collection_location http://dbpedia.org/resource/Finland {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3324479/fullTextXML", comment="The samples were taken from patients subjected to open vascular surgical procedures at the Division of Vascular Surgery, Tampere University Hospital."}
property_value: IAO:0000112 "PGS005096" xsd:string {dcterms:title="Genetic risk score for coronary artery calcification and its predictive ability for coronary artery disease.", xref="PMID:39483246"}
property_value: IAO:0000112 "PMID:39483246" xsd:string {dcterms:title="Genetic risk score for coronary artery calcification and its predictive ability for coronary artery disease.", xref="PMID:39483246", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11525111/fullTextXML", comment="We investigated the association of CAC GRSs with CAD and coronary calcification among the participants in the Ludwigshafen Risk and Cardiovascular Health study (LURIC) (n = 2742), the Tampere Vascular Study (TVS) (n = 133), and the Tampere Sudden Death Study (TSDS) (n = 660) using summary data from the largest multi-ancestry GWAS meta-analysis of CAC to date."}

