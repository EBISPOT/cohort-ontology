relationship: coho:has_data_collection_location http://dbpedia.org/resource/Australia {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13106845/fullTextXML", comment="The BTNS cohort has measurements for iris nevi in addition to the skin nevi used in the nevus GWAS meta-analysis. The cohort comprises a sample of predominantly adolescent twins (age 9–23 years) and their parents from Southeastern Queensland, Australia."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Oceania
relationship: coho:isSubCohortOf coho:COHO_0000744 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5540428/fullTextXML", comment="SPHERE-34 was administered as part of three main projects that make up the Brisbane Longitudinal Twin Study (BLTS; also known as the Brisbane Adolescent Twin Study (BATS)) [8]. The first two waves of data were collected in the clinic, following an assessment of Melanocyte Naevi (moles) around the twelfth (TWin Mole study visit 1: TW1) and fourteenth birthday of the twins (TWin Mole study visit 2: TW2)"}
property_value: coho:numberOfParticipants "3957" xsd:integer {IAO:0000116="12-year-old twins and nearest-age siblings examined 1992-2016", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40576277+AND+SRC%3AMED&format=json&resultType=core", comment="Among 3957 participants (158 per year), we saw an approximate halving of naevus counts over the 25-year period, and examined multiple explanations for this trend."}
property_value: IAO:0000112 "PMID:21655089" xsd:string {dcterms:title="Multiple common susceptibility variants near BMP pathway loci GREM1, BMP4, and BMP2 explain part of the missing heritability of colorectal cancer.", xref="PMID:21655089", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3107194/fullTextXML", comment="The 2,353 controls were derived from Queensland or Melbourne: for the former, the controls came from the Brisbane Twin Nevus Study [16]; for the latter, individuals were participants in the Genes in Myopia study [17]."}

[Instance]
id: coho:COHO_0001551
name: Bus Santé
def: "A repeated cross-sectional population-based health examination survey of adults living in the canton of Geneva, Switzerland, which since 1992 has examined in a mobile unit, each year, a new random sample of residents drawn from the cantonal residents list and stratified by age and sex, collecting questionnaires, physical measurements and blood samples on risk factors for cardiovascular and other lifestyle-related chronic diseases." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:37250185", IAO:0000119="PMID:39081844", IAO:0000119="PMID:40235578"}
