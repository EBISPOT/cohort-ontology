property_value: coho:numberOfParticipants "3100" xsd:integer {IAO:0000116="prostate cancer patients in the bioresource (2018)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5923293/", comment="The validation cohort of prostate cancer patients (N = 40) were recruited as part of the Australian Prostate Cancer BioResource (APCB) consisting of 3,100 patients including 350 men recruited via collaborations with urologists, 2,000 men from the QLD node of APCB, and 750 men recruited in collaboration with The Cancer Council Queensland."}
property_value: IAO:0000112 "PMID:29892016" xsd:string {dcterms:title="Association analyses of more than 140,000 men identify 63 new prostate cancer susceptibility loci.", xref="PMID:29892016", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf", comment="APCB = Acquired through the Australian Prostate Cancer BioResource (APCB), where cases were recruited through local urologists at the time of diagnosis."}

[Instance]
id: coho:COHO_0001492
name: Aberdeen Prospective Osteoporosis Screening Study
def: "A population-based osteoporosis screening study and longitudinal cohort of women from the Aberdeen area of north-east Scotland, selected at random from Community Health Index (primary care) records within 25 miles of Aberdeen and invited, when aged 45–54, to a baseline health visit with bone density measurement in 1990–1994, with further visits in 1997–1999, when blood was taken for DNA, and in 2007–2011, to study bone loss, osteoporotic fracture risk and falls and their dietary, medical and genetic determinants." [] {IAO:0000119="PMID:28702941", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32547728", IAO:0000119="PMID:22234152"}
synonym: "APOSS" RELATED OMO:0003000 []
