property_value: coho:numberOfParticipants "746667" xsd:integer {IAO:0000116="individuals in the second-phase (BCX2) trans-ethnic GWAS of blood-cell traits (2020)", xref="PMID:34925446", comment="BCX2 is a consortium comprising of trans-ethnic data of blood cell traits of 746,667 individuals from five different ancestries."}
property_value: IAO:0000112 "PMID:27346685" xsd:string {dcterms:title="Exome Genotyping Identifies Pleiotropic Variants Associated with Red Blood Cell Traits.", xref="PMID:27346685", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5005438/", comment="The Blood-Cell Consortium (BCX) aims to identify novel common and rare variants associated with blood-cell traits using an exome array."}

[Instance]
id: coho:COHO_0001520
name: Bavarian Endometrial Cancer Cases and Controls Study
def: "A single-centre case-control study of endometrial cancer at the University Hospital Erlangen in Bavaria, Germany, conducted between 2002 and 2008 to investigate genetic and epidemiological risk factors for endometrial cancer, whose cases were incident cases referred to the hospital by surrounding practitioners or prevalent cases approached during follow-up care after treatment there for primary endometrial cancer, with epidemiological information from a structured interview questionnaire and clinical data from health records." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27135401"}
