[Instance]
id: coho:COHO_0001647
name: Deprenyl and tocopherol antioxidative therapy of parkinsonism
def: "A double-blind, multicentre, placebo-controlled clinical trial of the Parkinson Study Group that enrolled patients with early, otherwise untreated Parkinson's disease at sites in the United States and Canada and randomised them, in a 2 x 2 factorial design, to deprenyl, tocopherol (vitamin E), both or placebo, to test whether long-term treatment extends the time until disability requires levodopa therapy." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:2508608", IAO:0000119="PMID:2515723"}
subset: coho1:PGS_subset
synonym: "DATATOP" RELATED OMO:0003000 []
