property_value: coho:numberOfParticipants "785" xsd:integer {IAO:0000116="BEST participants in the parent study (Black women diagnosed 2005-2018 at age 50 or younger)", xref="PMID:41360000", comment="For the present retrospective cohort analysis, of the 785 BEST participants in the parent study, we excluded women missing data on stage at diagnosis (n = 30), those with stage IV disease at diagnosis (n = 27), with bilateral breast cancer (n = 36), those missing timing of genetic testing (n = 45), or missing timing of surgery (n = 14) yielding a final analytic sample of 633."}
property_value: IAO:0000112 "PMID:41629673" xsd:string {dcterms:title="Improved polygenic risk prediction models for breast cancer subtypes in women of African ancestry.", xref="PMID:41629673", xref="https://europepmc.org/api/getPdf?pmcid=PMC13007722", comment="We additionally performed external validation of PRS models for each of the four BC phenotypes in an independent combined dataset of women of African ancestry (580 cases and 3,011 controls) from three studies of women of African ancestry including The Vanderbilt Biobank (BioVU),42,43 Black Women: Etiology and Survival of Triple-negative Breast Cancers (BEST) Study,44 and the Women Firefighters Biomonitoring Collaborative (WFBC).45"}
