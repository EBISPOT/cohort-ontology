relationship: coho:hasCohort coho:COHO_0002467 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnn.4398/MediaObjects/41593_2016_BFnn4398_MOESM27_ESM.xlsx", comment="TOP | ENIGMA | Case-control (SCZ, BD, other psychoses, and healthy controls) | European | 849 | 407 | 34.0 (10.4) | 17 - 73 | 305 | 145 | 35.4 (9.9) | 18 - 73"}
property_value: coho:numberOfParticipants "50000" xsd:integer {IAO:0000116="people with imaging and genetic data in ENIGMA's genetic studies (\"more than 50,000\"), 2020", xref="PMID:32198361", comment="In addition, ENIGMA’s genetic studies are now analyzing imaging and genetics data from more than 50,000 people to uncover genetic markers that most robustly associated with brain structure and function, or imaging derived neurobiological traits related to various disease conditions13–16."}
property_value: IAO:0000112 "GCST90267908" xsd:string {dcterms:title="Cross-ancestry genome-wide association meta-analyses of hippocampal and subfield volumes.", xref="PMID:37337106", xref="https://www.nature.com/articles/s41588-023-01425-8", comment="The GWAS summary statistics used in this work from following two publicly available datasets: the UKBB study (https://open.win.ox.ac.uk/ukbiobank/big40/) and the ENIGMA study (https://enigma.ini.usc.edu/research/download-enigma-gwas-results/data-agreement-for-hippocampal-volume-gwas-download/)."}

[Instance]
id: coho:COHO_0000970
name: Tirschenreuth Study
def: "A prospective population-based cohort of inhabitants aged 14 or older of the county of Tirschenreuth in north-eastern Bavaria, Germany, one of the German counties hardest hit by SARS-CoV-2 in spring 2020, randomly selected with stratification by sex and municipality, who gave blood samples and questionnaires at a baseline survey in June-July 2020 and at follow-ups in November 2020 and April 2021, to determine SARS-CoV-2 seroprevalence and its course over time, including undetected infections, the durability of antibody responses and new infections." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35746640", IAO:0000119="PMID:34200766"}
subset: coho1:GWAS_subset
