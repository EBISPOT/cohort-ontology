[Instance]
id: coho:COHO_0001783
name: GENEVA study
def: "A German case-control sample for genetic studies of atopic dermatitis, whose cases are patients recruited at the tertiary dermatology clinics of the Technische Universität München (in the GENEVA study itself), the University of Kiel and the University of Bonn and diagnosed by dermatologists on skin examination, and whose controls come from the PopGen biobank and the population-based KORA surveys." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-023-41180-2/MediaObjects/41467_2023_41180_MOESM1_ESM.pdf", IAO:0000119="PMID:22197932", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3985/MediaObjects/41588_2017_BFng3985_MOESM1_ESM.pdf"}
