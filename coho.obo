property_value: IAO:0000112 "GCST007410" xsd:string {dcterms:title="Genome-wide by environment interaction studies of depressive symptoms and psychosocial stress in UK Biobank and Generation Scotland.", xref="PMID:30718454", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30718454+AND+SRC%3AMED&format=json&resultType=core", comment="To improve our understanding of this link, we performed genome-wide association studies (GWAS) of depressive symptoms and genome-wide by environment interaction studies (GWEIS) of depressive symptoms and stressful life events (SLE) in two UK population-based cohorts (Generation Scotland and UK Biobank)."}

