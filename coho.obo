property_value: IAO:0000112 "PMID:33079599" xsd:string {dcterms:title="Polygenic Contribution to Low-Density Lipoprotein Cholesterol Levels and Cardiovascular Risk in Monogenic Familial Hypercholesterolemia.", xref="PMID:33079599", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7889287/fullTextXML", comment="In the UK Biobank cohort, cases of monogenic FH were identified from the general population based on genotype, whereas individuals from the BCFH and CNMA cohorts were identified from lipid clinics based on a clinical diagnosis of FH."}

[Instance]
id: coho:COHO_0001600
name: Chonnam National University Lung Cancer Study
def: "A case–control study of lung cancer based at Chonnam National University Hwasun Hospital in Jeollanam-do, South Korea. From 2000 it enrolled consecutive patients, all ethnic Koreans, with newly diagnosed, histologically confirmed incident lung cancer, excluding secondary or recurrent tumours, and compared them with population-based controls to study genetic susceptibility to lung cancer. Its never-smoking women were genotyped genome-wide as one of the studies of the Female Lung Cancer Consortium in Asia." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:21342495", IAO:0000119="PMID:21316118", IAO:0000119="PMID:23143601"}
