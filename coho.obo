relationship: coho:has_data_collection_location http://dbpedia.org/resource/Sweden {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/supplementaryFiles", comment="The Gothenburg H70 Birth Cohort Studies and Clinical AD from Sweden (Gothenburg) AD cases originate from Sweden and were either collected in memory clinics (in different parts of Sweden) or as a part of two population-based epidemiological studies in Gothenburg; the Prospective Population Study of Women (PPSW) and the Gothenburg Birth Cohort Studies (H70, H85 and 95+), described in detail previously100–103 . Controls originate from the Gothenburg Birth Cohort Studies and PPSW."}
property_value: coho:numberOfCases "712" xsd:integer {IAO:0000116="AD cases and controls in the genotyped Gothenburg dataset (2021 GWAS); no combined total stated", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-021-00921-z/MediaObjects/41588_2021_921_MOESM1_ESM.pdf", comment="The Gothenburg H70 Birth Cohort Studies and Clinical AD from Sweden (Gothenburg) dataset (712 cases, 2523 controls) was used as the independent test set because it was the dataset with the largest number of cases of the available genotype-level data."}
