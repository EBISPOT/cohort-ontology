[Instance]
id: coho:COHO_0002244
name: PEAK-25
def: "A longitudinal, prospective, population-based cohort of young-adult women from Malmö, Sweden, who were invited in 1999–2004 at the age of 25 (excluding women pregnant then or in the previous 12 months) and invited again about ten years later at age 35, set up to explore the genetic, clinical and lifestyle factors associated with attaining peak bone mass and with later changes in bone mass, with bone density and body composition measured by DXA." [] {IAO:0000119="PMID:40581742", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-017-00031-7/MediaObjects/41467_2017_31_MOESM1_ESM.pdf"}
synonym: "PEAK 25" RELATED OMO:0003000 []
synonym: "PEAK Bone Mass 25 study" RELATED []
synonym: "Peak-25" RELATED OMO:0003000 []
synonym: "PEAK25" RELATED OMO:0003000 []
synonym: "PEAK25 Swedish Study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Sweden {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12685719/fullTextXML", comment="Briefly, during 1999-2004, 25-yr-old women from Malmö, Sweden, were invited to participate."}
property_value: coho:numberOfParticipants "1047" xsd:integer {IAO:0000116="25-year-old women included at baseline in Malmö, 1999-2004", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12685719/fullTextXML", comment="The final number at inclusion was 1047 women (exclusions due to 102 who were pregnant, 3 who were outside age limit, 2 did not attend, and 12 were missing data) (Figure 1)."}
property_value: IAO:0000112 "PMID:28724990" xsd:string {dcterms:title="Large meta-analysis of genome-wide association studies identifies five loci for lean body mass.", xref="PMID:28724990", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5517526/fullTextXML", comment="De-novo replication genotyping was done using: KBioScience Allele-Specific Polymorphism (KASP) SNP genotyping system (in OPRA, PEAK25, AGES, CAIFOS, DOPS cohorts), TaqMan (METSIM), Illumina OmniExpress + Illumina Metabochip (PIVUS and ULSAM), or Sequenom’s iPLEX (WHI) (Supplementary Table 8)."}

[Instance]
id: coho:COHO_0002245
name: Polish Endometrial Cancer Study
def: "A population-based case-control study of endometrial cancer, the endometrial component of the US National Cancer Institute's Polish Cancer Study, that in 2001–2003 enrolled women aged 20–74 years in Warsaw and Łódź, Poland: cases with incident, pathologically confirmed endometrial cancer identified through a rapid hospital-based identification system and cancer registries, and controls selected from the Polish Electronic System and frequency-matched on site and age, all interviewed in person and giving blood samples." [] {IAO:0000119="PMID:41094331", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24096698", IAO:0000119="PMID:22730518"}
