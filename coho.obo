relationship: coho:has_data_collection_location http://dbpedia.org/resource/Netherlands {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6466793/fullTextXML", comment="The LymeProspect study has been designed to investigate the prevalence, severity, and a wide range of hypotheses on the etiology of persistent symptoms among patients treated for Lyme borreliosis in the Netherlands."}
property_value: coho:numberOfParticipants "1138" xsd:integer {IAO:0000116="adult patients with confirmed Lyme borreliosis included April 2015-October 2018", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11076587/fullTextXML", comment="The LymeProspect cohort consisted of 1138 patients with a new physician-confirmed LB (either EM or disseminated manifestation) who were included at the initiation of antibiotic therapy and followed for one year, between April 2015 and October 2018"}
