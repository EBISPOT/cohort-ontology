relationship: coho:has_data_collection_location http://dbpedia.org/resource/Germany {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6164542/fullTextXML", comment="Between June 1999 and March 2004, 3800 patients who underwent coronary angiography were recruited in the AtheroGene Study at the Department of Medicine II of the Johannes Gutenberg-University Mainz and the Bundeswehr-Zentralkrankenhaus Koblenz"}
property_value: coho:numberOfParticipants "3800" xsd:integer {IAO:0000116="patients undergoing coronary angiography recruited June 1999-March 2004", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC7428563/", comment="Three thousand eight hundred patients, who underwent coronary angiography, were recruited in the AtheroGene Study at the Department of Medicine II of the Johannes Gutenberg‐University Mainz or the Bundeswehr‐Zentralkrankenhaus Koblenz, from June 1999 to March 2004."}
property_value: IAO:0000112 "PMID:17132649" xsd:string {dcterms:title="Impact of C-reactive protein and fibrinogen on cardiovascular prognosis in patients with stable angina pectoris: the AtheroGene study.", xref="PMID:17132649", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17132649+AND+SRC%3AMED&format=json&resultType=core", comment="In a substudy of the prospective AtheroGene registry, we assessed in 1806 patients with documented CAD and stable angina pectoris, the risk of cardiovascular death and non-fatal myocardial infarction (n=183) over a median follow-up of 3.5 (maximum 7.7) years according to baseline levels of C-reactive protein and fibrinogen."}

[Instance]
id: coho:COHO_0001501
name: Australian Twin Migraine
def: "A genome-wide association case–control sample of unrelated Australians of European descent, one from each family, drawn from the twins and their relatives studied at the Queensland Institute of Medical Research (QIMR) who were genotyped genome-wide: migraine cases, identified in semi-structured telephone interviews based on the International Classification of Headache Disorders (ICHD-II) or by self-report and chosen preferentially for severity, and population controls from families with no known migraine. It is one of the studies of the International Headache Genetics Consortium." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2676/MediaObjects/41588_2013_BFng2676_MOESM11_ESM.pdf", IAO:0000119="PMID:24081561"}
