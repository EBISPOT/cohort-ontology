relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11929344/fullTextXML", comment="For external validation, we obtained summary statistics from six different data sources based on a pre-defined protocol: the TransOmics and Precision Medicine Program supported by NHLBI (TOPMed) Program including multiple studies and a trans-ancestry population in the USA (n = 51,732), [40] the population-based deCODE dataset in Iceland (n = 345,992), [41] the hospital-based Penn Medicine Biobank (PMBB, n = 43,721), [42] the Million Veteran Program (MVP, n = 438,905), [43] the Geisinger DiscovEHR-MyCode cohort in central and northeastern Pennsylvania (n = 145,826), [44] as well as the hospital-based Mass General Brigham Biobank (MGBB, n = 36,419) [45]."}
relationship: coho:isSubCohortOf coho:COHO_0000448 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8457092/fullTextXML", comment="In short, the DiscovEHR cohort is a subset of individuals enrolled in the Geisinger Healthcare system who consented to participate in Geisinger's MyCode Community Health Initiative."}
property_value: coho:numberOfParticipants "50726" xsd:integer {IAO:0000116="adult MyCode participants exome-sequenced in the first DiscovEHR release (2016)", xref="PMID:28008009", comment="We sequenced the exomes of 50,726 adult participants in the DiscovEHR study to identify ~4.2 million rare single-nucleotide variants and insertion/deletion events, of which ~176,000 are predicted to result in a loss of gene function."}
property_value: IAO:0000112 "GCST90025866" xsd:string {dcterms:title="Genome-wide association analysis of serum alanine and aspartate aminotransferase, and the modifying effects of BMI in 388k European individuals.", xref="PMID:34184762", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8457092/fullTextXML", comment="Here we report a GWAS of serum ALT and AST levels in 388k unrelated individuals of European ancestry from UKB and DiscovEHR."}

