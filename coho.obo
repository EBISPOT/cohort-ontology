relationship: coho:has_data_collection_location http://dbpedia.org/resource/Spain {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9526730/unicode", comment="Colon cancer patients were retrospectively selected during 2012 from those that had received radical surgery in the Bellvitge University Hospital (Barcelona, Spain) between January 1996 and December 2000, and had fresh frozen tumor samples in the hospital biobank."}
property_value: coho:numberOfCases "100" xsd:integer {IAO:0000116="stage II colon cancer patients (paired tumour/normal) and healthy mucosa donors (2012)", xref="PMID:36182938", comment="Colonomics is a multi-omics dataset that includes 250 samples: 50 samples from healthy colon mucosa donors and 100 paired samples from colon cancer patients (tumor/adjacent)."}
property_value: coho:numberOfControls "50" xsd:integer {IAO:0000116="stage II colon cancer patients (paired tumour/normal) and healthy mucosa donors (2012)", xref="PMID:36182938", comment="Colonomics is a multi-omics dataset that includes 250 samples: 50 samples from healthy colon mucosa donors and 100 paired samples from colon cancer patients (tumor/adjacent)."}
property_value: IAO:0000112 "GCST90301397" xsd:string {dcterms:title="Germline genetic regulation of the colorectal tumor immune microenvironment.", xref="PMID:38664626", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11046907/fullTextXML", comment="Three independent data sets were available for replication of our discovery phase findings: Colonomics (“CLX”, N = 99; clonality, abundance, TILs/hpf), the CRC Genetics Study (“CRCGEN”, N = 162; clonality, abundance), and the Nurses’ Health Study and the Health Professionals Follow-up Study (N = 505; TILs)."}

