relationship: coho:has_data_collection_location http://dbpedia.org/resource/Italy {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8888857/fullTextXML", comment="As target sample, 1,292 samples from Italy cohorts were selected, divided into 561 hypertensives (43.4%) and 731 normotensives (56.6%) (Table 1)."}
relationship: coho:hasCohort coho:COHO_0001734 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature11401/MediaObjects/41586_2012_BFnature11401_MOESM14_ESM.pdf", comment="Regarding the present work, cases and controls were recruited within specific cohorts/networks: FLEMENGHO/EPOGH cohort"}
