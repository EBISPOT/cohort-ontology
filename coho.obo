relationship: coho:hasCohort coho:COHO_0002131 {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4731307/unicode", comment="For the overall NEIGHBORHOOD (NBH), the summary value for the population cohorts (POP; NHS/HPFS/WGHS) are presented separately from the case/control cohorts (CC; Iowa, OHTS (Ocular Hypertension Treatment Study), Marshfield, MEEI, NEIGHBOR)."}
relationship: coho:hasCohort coho:COHO_0002205 {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4731307/unicode", comment="For all 8 NEIGHBORHOOD studies cases were primarily defined as at least 1 reliable visual field showing loss consistent with glaucoma, without a secondary cause, or CDR (cup-to-disc ratio) ≥ 0.7 or CDR asymmetry ≥ 0.2 or documented progression of optic nerve degeneration (in the Ocular Hypertension Treatment Study [OHTS])."}
property_value: coho:numberOfCases "3853" xsd:integer {IAO:0000116="POAG cases and controls in the 8-dataset discovery meta-analysis (2016)", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4731307/unicode", comment="To identify new susceptibility loci, we meta-analyzed GWAS results from 8 independent studies from the United States (3,853 cases and 33,480 controls) and investigated the most significant SNPs in two Australian studies (1,252 cases and 2,592 controls), 3 European studies (875 cases and 4,107 controls) and a Singaporean Chinese study (1,037 cases and 2,543 controls)."}
property_value: coho:numberOfControls "33480" xsd:integer {IAO:0000116="POAG cases and controls in the 8-dataset discovery meta-analysis (2016)", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4731307/unicode", comment="To identify new susceptibility loci, we meta-analyzed GWAS results from 8 independent studies from the United States (3,853 cases and 33,480 controls) and investigated the most significant SNPs in two Australian studies (1,252 cases and 2,592 controls), 3 European studies (875 cases and 4,107 controls) and a Singaporean Chinese study (1,037 cases and 2,543 controls)."}
property_value: IAO:0000112 "PMID:27760082" xsd:string {dcterms:title="Age at natural menopause genetic risk score in relation to age at natural menopause and primary open-angle glaucoma in a US-based sample.", xref="PMID:27760082", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27760082+AND+SRC%3AMED&format=json&resultType=core", comment="Subsequently, to assess the relation with POAG, we used data from 2,160 female POAG cases and 29,110 controls in the National Eye Institute Glaucoma Human Genetics Collaboration Heritable Overall Operational Database (NEIGHBORHOOD), which consists of 8 datasets with imputed genotypes to 5.6+ million markers."}

[Instance]
id: coho:COHO_0002133
name: New England Lung Cancer Study
def: "A population-based case-control study of lung cancer, based at Dartmouth College, among residents of northern and central New Hampshire counties and the bordering region of Vermont, United States, in which cases of histologically confirmed primary incident lung cancer were identified from 2005 to 2007 through the New Hampshire State Cancer Registry and the Dartmouth-Hitchcock Medical Center Tumor Registry, and controls identified from a commercial database were matched to them on five-year age group, sex and county." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28604730", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf"}
