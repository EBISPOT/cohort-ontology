property_value: IAO:0000112 "GCST90572789" xsd:string {dcterms:title="Genome-wide association study and polygenic risk prediction of hypothyroidism.", xref="PMID:41238958", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12695664/supplementaryFiles", comment="The SumHer heritability estimates seem to be quite heterogeneous, e.g., the heritability of TSH in the ThyroidOmics meta-analysis is less than the TSH variance explained by the independent index SNPs in that study."}

[Instance]
id: coho:COHO_0001126
name: Treatment Options for Type 2 Diabetes in Adolescents and Youth
def: "A multicentre randomized clinical trial funded by the US National Institute of Diabetes and Digestive and Kidney Diseases that from 2004 to 2009 enrolled children and adolescents aged 10–17 years with type 2 diabetes of less than two years' duration, a body-mass index at or above the 85th percentile and no diabetes autoantibodies at 15 clinical centres in the United States, and compared metformin alone with metformin plus rosiglitazone or plus an intensive lifestyle intervention for durable glycaemic control until 2011; its participants were then followed into adulthood in the observational TODAY2 study (2011–2020)." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:17448130", IAO:0000119="PMID:38815053", IAO:0000119="PMID:22540912"}
subset: coho1:GWAS_subset
synonym: "TODAY" RELATED OMO:0003000 []
