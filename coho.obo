relationship: coho:has_data_collection_location http://dbpedia.org/resource/Netherlands {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3178591/supplementaryFiles", comment="A collection of DNA samples from blood donors from the north-west region of the Netherlands was established as controls for this study."}
property_value: IAO:0000112 "PMID:21966275" xsd:string {dcterms:title="Large-scale gene-centric analysis identifies novel variants for coronary artery disease.", xref="PMID:21966275", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3178591/supplementaryFiles", comment="The Dutch component of the BLOODOMICS collaboration comprises of cases drawn from the Academic Medical Centre Amsterdam Premature Atherosclerosis Study (AMC-PAS) and the AGNES study, with controls ascertained from the Sanquin Common Controls (SANQUIN-CC) study."}

[Instance]
id: coho:COHO_0001539
name: BRCA-gene mutations and breast cancer in South African women
def: "A South African study of BRCA1 and BRCA2 mutations in women with breast cancer and their families, based at the University of Pretoria and funded by the Cancer Association of South Africa. The women it identifies as carriers of pathogenic BRCA1 or BRCA2 variants are contributed to the Consortium of Investigators of Modifiers of BRCA1/2 (CIMBA) for studies of genetic modifiers of breast and ovarian cancer risk in carriers." [] {IAO:0000119="PMID:28346442", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32665703", IAO:0000119="PMID:23544013", IAO:0000119="PMID:36203093"}
