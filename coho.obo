property_value: IAO:0000112 "PMID:33952246" xsd:string {dcterms:title="Associations between neighborhood violence during pregnancy and birth outcomes: evidence from São Paulo's Western Region Birth Cohort.", xref="PMID:33952246", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33952246+AND+SRC%3AMED&format=json&resultType=core", comment="Using geocoded birth records from the ongoing Western Region Birth Cohort (Região Oeste Coorte - ROC-Cohort) of infants born between 2012 and 2014 and geocoded crime reports, we assessed the associations between exposure to violent crimes during pregnancy within a 1-km radius of the mother's residence and low birth weight, preterm delivery, and being born small-for-gestational-age."}

[Instance]
id: coho:COHO_0002667
name: Next Steps
def: "A national longitudinal cohort of people born in 1989-90 who were in Year 9 of secondary school in England in 2004, sampled through schools with over-sampling of deprived schools and ethnic minorities, begun by the Department for Education and run since 2013 by the Centre for Longitudinal Studies at University College London, following their education, work, economic circumstances, family life, health and wellbeing." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:39540417"}
