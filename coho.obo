[Instance]
id: coho:COHO_0002477
name: Utrecht Cannabis Cohort
def: "A cohort of young Dutch adults recruited online through a project website launched in 2006, who reported their cannabis use and psychotic-like experiences in a web-based survey; to increase power for gene-environment interaction, a genotyped subset combines participants from the general population with participants selected from the top or bottom quintile of psychotic-like experience scores who were either cannabis non-users or heavy users." [] {IAO:0000119="PMID:35650188", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Ftp.2016.36/MediaObjects/41398_2016_BFtp201636_MOESM267_ESM.doc", IAO:0000119="PMID:21592732", IAO:0000119="PMID:37310336"}
