property_value: IAO:0000112 "GCST90482691" xsd:string {dcterms:title="Genome-wide meta-analysis across East Asian and European populations provides insights into the molecular basis of lung cancer.", xref="PMID:42152146", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13348699/fullTextXML", comment="Specifically, these included the NJMU Global Screening Array project (10,248 cases and 9,298 controls), with participants recruited from five major cities in China (Nanjing, Shanghai, Beijing, Tianjin, and Guangzhou); the NJMU GWAS dataset (2,126 cases and 3,077 controls) [17]; and the NJMU OncoArray dataset (953 cases and 953 controls)."}

[Instance]
id: coho:COHO_0001111
name: Parkinson's Disease Cognitive Genetics Consortium
def: "A consortium of academic Parkinson's disease research centres in the United States, several of them Morris K. Udall Centers of Excellence for Parkinson's Disease Research, that pools patients with Parkinson's disease enrolled in the centres' studies, each given a detailed neurological evaluation and a shared core battery of cognitive tests, with a coordinating centre at the University of Washington and VA Puget Sound Health Care System in Seattle, to identify genetic risk factors for cognitive impairment in Parkinson's disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38870440", IAO:0000119="PMID:26296077", IAO:0000119="PMID:27571329", IAO:0000119="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001664.v1.p1"}
