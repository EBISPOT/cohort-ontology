relationship: coho:has_data_collection_location http://dbpedia.org/resource/Oceania
property_value: coho:numberOfParticipants "6682" xsd:integer {IAO:0000116="adults living with bipolar disorder recruited in three waves and completing the survey (2021)", xref="PMID:37655588", comment="A total of 6682 participants (68.3% female; aged 44.8 ± 13.6 years [range = 18–90]) were recruited in three waves: a nation-wide media campaign, a mail-out based on prescriptions for lithium carbonate and through the Australian Genetics of Depression Study."}
property_value: IAO:0000112 "PMID:38062264" xsd:string {dcterms:title="Multi-ancestry study of the genetics of problematic alcohol use in over 1 million individuals.", xref="PMID:38062264", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10719093/fullTextXML", comment="for example, the QIMR Berghofer Australian Genetics of Depression Study (AGDS) cohort has high major depression comorbidity, and the Australian Genetics of Bipolar Disorder Study (GBP) cohort has high bipolar disorder comorbidity."}

