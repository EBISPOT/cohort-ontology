relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Japan
relationship: coho:hasCohort coho:COHO_0000781 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8761561/fullTextXML", comment="The J-CGE consists of data analyzed among healthy participants from the Tohoku Medical Megabank Community-Based Cohort (TMM) Study, the Japan Public Health Centre-based Prospective (JPHC) Study, the Japan Multi-Institutional Collaborative Cohort (J-MICC) Study, and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center (HERPACC) Study (Table 1)."}
relationship: coho:hasCohort coho:COHO_0000783 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8761561/fullTextXML", comment="The J-CGE consists of data analyzed among healthy participants from the Tohoku Medical Megabank Community-Based Cohort (TMM) Study, the Japan Public Health Centre-based Prospective (JPHC) Study, the Japan Multi-Institutional Collaborative Cohort (J-MICC) Study, and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center (HERPACC) Study (Table 1)."}
property_value: coho:numberOfParticipants "36305" xsd:integer {IAO:0000116="healthy participants from JPHC, J-MICC, TMM and HERPACC in the J-CGE BMI/height/weight GWAS (2021)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8761561/fullTextXML", comment="After quality control of the sample, the JPHC (3,525 men and 6,767 women), J-MICC (6,334 men and 7,736 women), TMM (3,123 men and 5,778 women), and HERPACC (1,502 men and 1,540 women) were combined to analyze 36,305 participants (Table 1)."}
property_value: IAO:0000112 "PMID:34897183" xsd:string {dcterms:title="Public Access to Summary Statistics for Genome-wide Association Studies of Body Mass Index, Weight, and Height Among Healthy Japanese Individuals: The Japanese Consortium of Genetic Epidemiology Studies.", xref="PMID:34897183", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8761561/fullTextXML", comment="The J-CGE consists of data analyzed among healthy participants from the Tohoku Medical Megabank Community-Based Cohort (TMM) Study, the Japan Public Health Centre-based Prospective (JPHC) Study, the Japan Multi-Institutional Collaborative Cohort (J-MICC) Study, and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center (HERPACC) Study (Table 1)."}

[Instance]
id: coho:COHO_0000783
name: Japan Public Health Center-based Prospective Study
def: "A population-based prospective cohort of about 140,000 registered residents aged 40–69 years in 11 public health centre areas across Japan, enrolled as Cohort I in 1990 and Cohort II in 1993 with questionnaires, blood samples and health check-up data and followed with repeat surveys, to study causes of cancer, cardiovascular disease and other diseases." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:11763136", IAO:0000119="PMID:25104790"}
