relationship: coho:hasCohort coho:COHO_0000347 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf", comment="UK2 UK UK cancer genetics clinics + oncology clinicas WTCCC2: 1958 Birth Cohort + UK National Blood Service Illumina 670k (cases) Illumina 1.2M (controls) 3628 5190"}
relationship: coho:hasCohort coho:COHO_0001718 {xref="https://www.nature.com/articles/ng.1049", comment="FBCS organized patient recruitment and data and sample collection for the UK2 GWAS."}
