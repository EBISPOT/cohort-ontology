property_value: IAO:0000112 "PMID:15277424" xsd:string {dcterms:title="Association of carotid intima-media thickness and arterial stiffness with diabetic retinopathy: the Chennai Urban Rural Epidemiology Study (CURES-2).", xref="PMID:15277424", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15277424+AND+SRC%3AMED&format=json&resultType=core", comment="The study was conducted on 600 type 2 diabetic subjects randomly selected from the Chennai Urban Rural Epidemiology Study (CURES), which is an ongoing population-based study of a representative population of Chennai."}
property_value: IAO:0000116 "The acronym CURES also denotes China Pulmonary Thromboembolism Registry Study (COHO:0001639); this term is Chennai Urban Rural Epidemiology Study." xsd:string

[Instance]
id: coho:COHO_0001639
name: China Pulmonary Thromboembolism Registry Study
def: "An ongoing national, prospective, multicentre registry of patients with suspected or confirmed acute pulmonary embolism, with or without deep vein thrombosis, enrolled at medical centres of the China PE-DVT network across China and led from the China-Japan Friendship Hospital in Beijing, to describe the spectrum, trends, causes and outcomes of pulmonary embolism in China. Started in January 2009 with in-hospital outcomes, it has followed patients for at least three months since July 2011 and, since August 2016, has collected their blood samples and followed them for at least two years." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32522676", IAO:0000119="PMID:35242828"}
synonym: "China pUlmonary Thromboembolism REgistry Study" RELATED []
synonym: "China pUlmonary thromboembolism REgistry Study" RELATED []
