property_value: IAO:0000112 "GCST90274713" xsd:string {dcterms:title="Characterizing prostate cancer risk through multi-ancestry genome-wide discovery of 187 novel risk variants.", xref="PMID:37945903", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10841479/unicode", comment="The present study included an additional 49,072 cases and 661,437 controls from the UK Biobank, the FinnGen study, the Electronic Medical Records and Genomics (eMERGE) Network, the BioVU Biobank, the BioMe Biobank, the Prostate, Lung, Colorectal, and Ovarian Cancer Screening Trial (PLCO), the MD Anderson prostate cancer study (MD Anderson), the California and Uganda Prostate Cancer Study (CA UG), the VA Million Veteran Program (MVP), and the Maryland Prostate Cancer Case-Control Study (NCI-MD) (Supplementary Table 1)."}

[Instance]
id: coho:COHO_0001154
name: Cryptosporidiosis and Enteropathogens in Bangladesh Birth Cohort
def: "A prospective birth cohort of children enrolled within a week of birth between June 2014 and March 2016 in Mirpur, an urban neighbourhood of Dhaka, and Mirzapur, a rural subdistrict north-west of Dhaka, Bangladesh, whose mothers were identified in the second trimester of pregnancy. The children were followed with twice-weekly home visits for diarrhoea, monthly stool samples and three-monthly growth measurements, to study the incidence of cryptosporidiosis, the immune response to it, host genetic susceptibility and its effect on child growth." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:40488529", IAO:0000119="PMID:29897482", IAO:0000119="PMID:32019797"}
