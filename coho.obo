[Instance]
id: coho:COHO_0000800
name: Transdisciplinary Research in Cancer of the Lung
def: "A lung cancer genetic epidemiology consortium, one of the NIH-funded GAME-ON post-GWAS consortia and working with the International Lung Cancer Consortium, that integrates genome-wide data from multiple lung cancer studies of European populations to identify lung cancer susceptibility loci." [] {IAO:0000119="PMID:42152146", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
subset: coho1:GWAS_subset
synonym: "Transdisciplinary Research In Cancer of the Lung" RELATED []
synonym: "Transdisciplinary Research In Cancer of the Lung (TRICL) Research Team" RELATED []
synonym: "Transdisciplinary Research on Cancer of the Lung Consortium" RELATED []
synonym: "TRICL" RELATED OMO:0003000 []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:hasCohort coho:COHO_0000165 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5429754/fullTextXML", comment="The present study first used genotyping data from the TRICL-ILCCO consortium, which included 12,160 lung cancer cases and 16,838 controls (all Europeans) of six previously published GWAS studies: The University of Texas MD Anderson Cancer Center (MDACC), Institute of Cancer Research (ICR), National Cancer Institute (NCI), International Agency for Research on Cancer (IARC), Toronto study from Samuel Lunenfeld Research Institute study (Toronto), and German Lung Cancer Study (GLC)."}
relationship: coho:hasCohort coho:COHO_0001994 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5050097/", comment="The association study with lung cancer risk was conducted using the GWAS data assembled by the TRICL consortium. The overall study design and methods for TRICL have been described in detail elsewhere for most studies (17). The meta-analysis was based on summary data from 19 GWAS undertaken by eight analytic centers providing genotype data on 13,479 patients with lung cancer and 43,218 controls of European descent: the MD Anderson Cancer Center lung cancer study (24); the NCI lung cancer GWAS including the Environment and Genetics in Lung Cancer Etiology (EAGLE) study (25) and the Prostate, Lung, Colon, Ovary Screening Trial (PLCO) (26); the IARC lung cancer GWAS (5) including Central Europe GWAS (27); the Carotene and Retinol Efficacy Trial (CARET) cohort lung cancer GWAS (28); the HUNT2/Tromso 4 study (29); several lung cancer GWAS studies from Central Europe and France (30); the lung cancer study from Estonia (31);"}
relationship: coho:hasCohort coho:COHO_0002009 {xref="https://europepmc.org/api/getPdf?pmcid=PMC3607485", comment="Liverpool Lung Project 543 2501 Liverpool, UK Population-bases cases, UK Blood Service collections controls"}
relationship: coho:isCohortOf coho:COHO_0000774
property_value: coho:numberOfCases "29266" xsd:integer {IAO:0000116="lung cancer cases and controls of European descent in the 2017 TRICL-ILCCO OncoArray aggregated GWAS (no stated overall total)", xref="PMID:28604730", comment="Here 14,803 cases and 12,262 controls of European descent were genotyped on the OncoArray and combined with existing data for an aggregated genome-wide association study (GWAS) analysis of lung cancer in 29,266 cases and 56,450 controls."}
property_value: coho:numberOfControls "56450" xsd:integer {IAO:0000116="lung cancer cases and controls of European descent in the 2017 TRICL-ILCCO OncoArray aggregated GWAS (no stated overall total)", xref="PMID:28604730", comment="Here 14,803 cases and 12,262 controls of European descent were genotyped on the OncoArray and combined with existing data for an aggregated genome-wide association study (GWAS) analysis of lung cancer in 29,266 cases and 56,450 controls."}
property_value: IAO:0000112 "GCST90243964" xsd:string {dcterms:title="Genetic Analysis of Lung Cancer and the Germline Impact on Somatic Mutation Burden.", xref="PMID:35511172", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9360465/fullTextXML", comment="The family history GWAS (GWAx) on 48 843 self-reported family history LC patients and 195 387 controls from the UK Biobank (Supplementary Table 1, available online) identified 5 loci (5p15.33, 6p21.32, 12p13.33, 13q13.1, and 15q25.1) that had previously been discovered from the traditional GWAS previously performed on the Transdisciplinary Research In Cancer of the Lung cohort (Supplementary Table 2 and Supplementary Figure 1, available online)."}

