[Instance]
id: coho:COHO_0001289
name: Beaver Dam Eye Study
def: "A population-based cohort of the residents of the city and township of Beaver Dam, Wisconsin, United States, aged 43 to 84 years at a private census begun in 1987. They were examined at baseline in 1988–1990 and re-examined about every five years (up to a 25-year follow-up in 2014–2016) by the University of Wisconsin-Madison, to study the prevalence, incidence and risk factors of age-related eye diseases, such as age-related macular degeneration and cataract, and of visual impairment." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32200810", IAO:0000119="PMID:30208419", IAO:0000119="PMID:25905023", IAO:0000119="PMID:29242907"}
subset: coho1:GWAS_subset
synonym: "BDES" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/supplementaryFiles", comment="The recruitment population consisted of European ancestry individuals ages 43-84 from the town of Beaver Dam, Wisconsin, United States. 4,926 individuals were recruited into the study from 1988- 1990."}
relationship: coho:isCohortOf coho:COHO_0000905
property_value: coho:numberOfParticipants "4926" xsd:integer {IAO:0000116="persons examined at baseline (1988-1990)", xref="PMID:25905023", comment="In brief, a private census identified 5924 persons living in the city and township of Beaver Dam, Wisconsin aged 43–86 years, of which 4926 participated in the baseline examination in 1988–1990 and in up to four follow-up examinations in 1993–1995, 1998–2000, 2003–2005 and 2008–2010."}
property_value: IAO:0000112 "GCST90244057" xsd:string {dcterms:title="Rare variant analyses across multiethnic cohorts identify novel genes for refractive error.", xref="PMID:36596879", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/fullTextXML", comment="These 14 cohorts were: Singapore Chinese Eye Study (SCES), Singapore Malay Eye Study (SiMES), Singapore Indian Eye Study (SINDI), Age Related Eye Study (AREDS), Rotterdam Study I (RSI), Erasmus Rucphen Family (ERF), Raine Eye Health Study (REHS) of the Raine Study, Beaver Dam Eye Study (BDES), Estonian Genome Center for the University of Tartu (EGCUT), Finnish Twin Study on Aging (FITSA), Ogliastra, Croatia-Korcula, TwinsUK, and EPIC-Norfolk."}

[Instance]
id: coho:COHO_0001290
name: BioImage Study: A Clinical Study of Burden of Atherosclerotic Disease in an At-Risk Population
def: "A prospective observational cohort of asymptomatic adults at risk of, but without, clinical atherosclerotic cardiovascular disease (men aged 55–80 and women aged 60–80). They were recruited in 2008–2009 by the High-Risk Plaque Initiative from members of the Humana health plan in Chicago, Illinois, and Fort Lauderdale, Florida, United States, and examined with vascular imaging and blood sampling, to identify imaging and circulating biomarkers that predict near-term atherothrombotic events." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT00738725", IAO:0000119="PMID:21800090", IAO:0000119="PMID:35234888"}
