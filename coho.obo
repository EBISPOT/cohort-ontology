relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38997326+AND+SRC%3AMED&format=json&resultType=core", comment="The Knight-Alzheimer Disease Research Center (Knight-ADRC) at Washington University in St. Louis has pioneered and led worldwide seminal studies that have expanded our clinical, social, pathological, and molecular understanding of Alzheimer Disease."}
relationship: coho:isCohortOf coho:COHO_0000480
relationship: coho:isCohortOf coho:COHO_0000518
relationship: coho:isCohortOf coho:COHO_0000561
property_value: coho:numberOfParticipants "6625" xsd:integer {IAO:0000116="Knight-ADRC participants recruited during the last 30 years (2024)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11245521/fullTextXML", comment="Out of the 6,625 Knight-ADRC participants (Table 1) recruited during the last 30 years, 2,746 of them are classified at the last assessment as AD (with 29 of them being Autosomal Dominant AD), 2,369 are considered cognitively unimpaired, and 1,510 are considered to suffer from other dementias (1,285 AD Related Dementias (ADRD), 153 FTD, and 72 DLB - Table 1."}
property_value: IAO:0000112 "GCST90727422" xsd:string {dcterms:title="Identification of genetic modifiers of autosomal dominant Alzheimer's disease: a genome-wide association study.", xref="PMID:42127933", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13340468/fullTextXML", comment="In this genome-wide association study (GWAS), we analysed data from individuals carrying ADAD mutations and control participants from three cohorts— the Knight Alzheimer Disease Research Center (Knight-ADRC),18 the Dominantly Inherited Alzheimer Network (DIAN) observational study, and the Alzheimer Disease Sequencing Project (ADSP) R4."}

[Instance]
id: coho:COHO_0000367
name: Alzheimer's Disease Neuroimaging Initiative
def: "A multi-site longitudinal cohort of cognitively normal older adults and people with mild cognitive impairment or mild Alzheimer disease, recruited from 2004 at over 60 clinical sites in the United States and Canada by the Alzheimer's Disease Neuroimaging Initiative, a public-private partnership, to evaluate neuroimaging, fluid biomarker and clinical measures of Alzheimer disease progression." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://adni.loni.usc.edu/about/", IAO:0000119="PMID:20042704", IAO:0000119="https://adni.loni.usc.edu/about/governance/"}
