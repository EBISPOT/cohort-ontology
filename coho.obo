relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5837578/", comment="At both Mayo Clinic Rochester and the University of Iowa, all consecutive cases of lymphoma, including Hodgkin lymphoma (HL) and chronic lymphocytic leukaemia (CLL), who were within 9 months of their initial diagnosis at presentation, a US resident and age 18 years and older, were eligible for enrolment into the MER from 1 September 2002 to 30 June 2015."}
