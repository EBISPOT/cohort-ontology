[Instance]
id: coho:COHO_0002336
name: San Antonio Family Diabetes/Gallbladder Study
def: "A family study of Mexican Americans in San Antonio, Texas, United States, begun in 1991 as the San Antonio Family Diabetes Study to identify susceptibility genes for type 2 diabetes, which recruited low-income Mexican Americans with type 2 diabetes identified in the San Antonio Heart Study and their extended families, examined them repeatedly, and at its second recall added a gallbladder disease component and further families; with the San Antonio Family Heart Study it makes up the San Antonio Family Studies." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:16123354", IAO:0000119="PMID:16400619", IAO:0000119="PMID:25519314"}
synonym: "SAFDGS" RELATED OMO:0003000 []
synonym: "SAFDS" RELATED OMO:0003000 []
synonym: "San Antonio Family Diabetes Study" RELATED []
synonym: "San Antonio Family Diabetes/Gallbladder study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC4145406/", comment="The GAW18 data set was drawn from T2D-GENES Project 2, a complex pedigree-based study designed to identify low-frequency or rare variants that influence susceptibility to type 2 diabetes using information from whole genome sequencing (WGS) of 1043 individuals from 20 Mexican American pedigrees enriched for type 2 diabetes from San Antonio, Texas."}
relationship: coho:isSubCohortOf coho:COHO_0000649 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC4145406/", comment="These family data were obtained from two studies: the San Antonio Family Heart Study (SAFHS) and the San Antonio Family Diabetes/Gallbladder Study (SAFDGS), which are together referred to as the San Antonio Family Studies (SAFS)."}
property_value: coho:numberOfParticipants "906" xsd:integer {IAO:0000116="members of 39 extended Mexican American pedigrees after the study's expansion", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16123354+AND+SRC%3AMED&format=json&resultType=core", comment="Subsequently, the study was expanded to include 906 individuals from 39 extended Mexican-American pedigrees, two additional examination cycles approximately 5.3 and 7.6 years after baseline, and genotypes for a new set of genome-wide markers."}
property_value: IAO:0000112 "PMID:27039371" xsd:string {dcterms:title="GWAS and transcriptional analysis prioritize ITPR1 and CNTN4 for a serum uric acid 3p26 QTL in Mexican Americans.", xref="PMID:27039371", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC4818944/", comment="As a follow up, we examined genome-wide single nucleotide polymorphism data in an extended cohort of 1281 Mexican Americans from multigenerational families of the San Antonio Family Heart Study and the San Antonio Family Diabetes/Gallbladder Study."}

[Instance]
id: coho:COHO_0002337
name: San Antonio Family Heart Study
def: "A family study of Mexican Americans in San Antonio, Texas, begun in 1991, that recruited low-income Mexican Americans aged 40 to 60, selected at random without regard to disease from Mexican American census tracts, together with their extended families, and followed them with repeated examinations to study the genetic and environmental contributions to cardiovascular disease risk factors. With the San Antonio Family Diabetes/Gallbladder Study it makes up the San Antonio Family Studies." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:8901667", IAO:0000119="PMID:25519314"}
subset: coho1:PGS_subset
