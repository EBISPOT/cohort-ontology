relationship: coho:has_data_collection_location http://dbpedia.org/resource/Spain {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22294762+AND+SRC%3AMED&format=json&resultType=core", comment="It recruited consecutive, unselected, population-based colorectal cancer (CRC) cases and control subjects matched by age and gender without personal or familial history of cancer all over Spain with the main goal of gaining knowledge in Lynch syndrome and familial CRC."}
property_value: coho:numberOfCases "2000" xsd:integer {IAO:0000116="Approximate EPICOLON phase I/II cases and controls in its own 2012 review", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22294762+AND+SRC%3AMED&format=json&resultType=core", comment="This epidemiological, prospective and multicentre study collected extensive clinical data and biological samples from ∼2000 CRC cases and 2000 controls in Phases 1 and 2 involving 25 and 14 participating hospitals, respectively."}
property_value: coho:numberOfControls "2000" xsd:integer {IAO:0000116="Approximate EPICOLON phase I/II cases and controls in its own 2012 review", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22294762+AND+SRC%3AMED&format=json&resultType=core", comment="This epidemiological, prospective and multicentre study collected extensive clinical data and biological samples from ∼2000 CRC cases and 2000 controls in Phases 1 and 2 involving 25 and 14 participating hospitals, respectively."}
property_value: IAO:0000112 "PGS000734" xsd:string {dcterms:title="Cumulative Burden of Colorectal Cancer-Associated Genetic Variants Is More Strongly Associated With Early-Onset vs Late-Onset Cancer.", xref="PMID:31866242"}
property_value: IAO:0000112 "PMID:21655089" xsd:string {dcterms:title="Multiple common susceptibility variants near BMP pathway loci GREM1, BMP4, and BMP2 explain part of the missing heritability of colorectal cancer.", xref="PMID:21655089", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3107194/", comment="EPICOLON [19] included 1,410 cases matched with the same number of controls collected in a prospective fashion from centres in Spain."}

[Instance]
id: coho:COHO_0001695
name: Epidemiology of Functional Disorders
def: "A prospective population-based study of pain in North West England, in which adults aged 25 to 65 years recruited from the registers of three general practices in socio-economically diverse areas answered postal questionnaires on pain and psychological factors at baseline and were followed up at about 15 months and 4 years; it has been used to study the onset, persistence and genetics of chronic widespread pain." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:20400346", IAO:0000119="PMID:19723618", IAO:0000119="PMID:19059720", IAO:0000119="PMID:19369469"}
