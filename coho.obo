id: coho:COHO_0000670
name: Northern Manhattan Study
def: "A community-based longitudinal cohort of 3,298 stroke-free, predominantly Hispanic, Black and White adults aged 40 or older living in northern Manhattan, New York City, recruited by random-digit dialling in 1993–2001 and followed for stroke, vascular risk factors, brain MRI markers and cognitive outcomes." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13482911/fullTextXML"}
subset: coho1:GWAS_subset
synonym: "NOMAS" RELATED OMO:0003000 []
