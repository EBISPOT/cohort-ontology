relationship: coho:has_data_collection_location http://dbpedia.org/resource/Australia {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC4191666/", comment="Geographic region was defined as REGION_US (United States): AgHealth, CPS-II, DFCI, HPFS, MEC, NHS, NYU-WHS, PHS, PLCO, SELECT, VITAL, WHI; REGION_CNE (Central and Northern Europe): ATBC, EPIC, PANDoRA-Heidelberg, MCCS (Melbourne); and REGION_SE (Southern Europe): SBCS (Spain controls), PANKRAS-II (cases)."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/China {xref="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000206.v5.p3", comment="Also included are 61 pancreatic cancer cases and 67 control subjects from PanScan I as well as 173 pancreatic cancer cases from PanScan III of Asian ancestry from the Shanghai Men's and Women's Health Study (Supplemental Table 10, Wolpin et al. (Nat Genet, 2014))."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
