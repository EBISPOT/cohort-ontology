property_value: IAO:0000112 "GCST90833053" xsd:string {dcterms:title="Large-scale exome analyses reveal new rare variant contributions in amyotrophic lateral sclerosis.", xref="PMID:41917433", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13083253/fullTextXML", comment="Case cohorts included the Project MinE ALS sequencing consortium (7,614 cases; 2,605 controls)47, the NYGC ALS Consortium (2,650 cases; 342 controls), the ALS Sequencing Consortium (2,851 cases)5, two cohorts from the FALS consortium (1,277 cases; phs001585), the National Institutes of Health (NIH) Exome Sequencing of FALS Project (194 cases; phs000101), two Australian cohorts described in ref. 48 (125 cases, 18 controls) and ref. 49 (568 cases), and a Chinese motor neurone disease (MND) cohort50 (583 cases, 182 controls)."}

[Instance]
id: coho:COHO_0001394
name: Pulmonary Hypertension and the Hypoxic Response in Sickle Cell Disease
def: "A prospective multicentre observational study of children and adolescents aged 3–20 years with sickle cell disease, examined at steady state, and of controls without the disease matched by age, sex and ethnicity, recruited at Howard University Hospital and Children's National Medical Center in Washington, DC, and the University of Michigan in Ann Arbor, with echocardiography, six-minute walk tests and blood markers, designed to identify factors in pre-symptomatic children that predict pulmonary hypertension and other cardiopulmonary complications." [] {IAO:0000119="PMID:19211639", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19956689"}
subset: coho1:GWAS_subset
synonym: "Pulmonary Hypertension and Hypoxic Response in Sickle Cell Disease" RELATED []
synonym: "Pulmonary Hypertension and the Hypoxic Response in SCD" RELATED []
synonym: "PUSH" RELATED OMO:0003000 []
