property_value: coho:numberOfParticipants "2315" xsd:integer {IAO:0000116="participants recruited at baseline 2010-2013 (depression, CVD and reference cohorts)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4065391/fullTextXML", comment="Overall, 2315 participants were recruited for BiDirect-Baseline; 2258 (97.5%) of them matched the final inclusion criteria."}
property_value: IAO:0000112 "GCST90444478" xsd:string {dcterms:title="Genome-wide association study meta-analysis of neurofilament light (NfL) levels in blood reveals novel loci related to neurodegeneration.", xref="PMID:39251807", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11385583/supplementaryFiles", comment="The BiDirect Study was initiated in 2009 as a prospective, observational study integrating three cohorts: 1) community-dwelling adults (control diagnostic group), 2) patients with an acute depressive episode (depression diagnostic group), and 3) patients who recently suffered from acute myocardial infarction (MI diagnostic group)."}

[Instance]
id: coho:COHO_0001061
name: Blue Mountains Eye Study
def: "A population-based cohort study of common eye diseases and other health outcomes among permanent residents aged 49 years or older of two postcode areas in the Blue Mountains, west of Sydney, Australia, identified through a census and examined at baseline in 1992–1994 and then every five years to 2007–2009, with newly eligible residents added in an extension study in 1999–2000." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:16623958", IAO:0000119="PMID:33732727"}
