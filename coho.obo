property_value: IAO:0000112 "PGS000350" xsd:string {dcterms:title="Association of a Primary Open-Angle Glaucoma Genetic Risk Score With Earlier Age at Diagnosis.", xref="PMID:31436842"}
property_value: IAO:0000112 "PMID:22570617" xsd:string {dcterms:title="Common variants at 9p21 and 8q22 are associated with increased susceptibility to optic nerve degeneration in glaucoma.", xref="PMID:22570617", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3343074/fullTextXML", comment="After data cleaning, 976 cases and 1,140 controls collected from three study sites [Nurses' Health Study, Health Professionals Follow-up Study and the Genetic Etiologies of Primary-Open angle Glaucoma Study (GEP)] were analyzed for the GLAUGEN study, and 2,170 cases and 2,347 controls collected from 12 sites (Table S1) were analyzed for the NEIGHBOR study."}

[Instance]
id: coho:COHO_0002132
name: National Eye Institute Glaucoma Human Genetics Collaboration Heritable Overall Operational Database
def: "A genome-wide meta-analysis resource for primary open-angle glaucoma that combines summary data from eight independent case-control and population-based datasets of European ancestry from the United States: the NEIGHBOR study, the Nurses' Health Study, the Health Professionals Follow-up Study, the Women's Genome Health Study, the Ocular Hypertension Treatment Study, and collections from Iowa, Marshfield and the Massachusetts Eye and Ear Infirmary. Cases in all datasets were defined by a harmonised glaucoma definition." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27760082", IAO:0000119="PMID:26752265"}
synonym: "national eye institute glaucoma human collaboration heritable overall operational database" RELATED []
