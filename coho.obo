property_value: IAO:0000112 "GCST90134661" xsd:string {dcterms:title="Cross-ancestry genome-wide meta-analysis of 61,047 cases and 947,237 controls identifies new susceptibility loci contributing to lung cancer.", xref="PMID:35915169", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01115-x/MediaObjects/41588_2022_1115_MOESM1_ESM.pdf", comment="Cross-ancestry genome-wide meta-analyses were conducted in the twelve different studies consisting of Affymetrix Axome Array Study (AFFY), the Female Lung Cancer Consortium in Asia (FLCCA), the Genetic Epidemiology of Lung Cancer Consortium (GELCC), the Environment and Genetics in Lung cancer Etiology study (EAGLE), Helmholtz-Gemeinschaft Deutscher Forschungszentren Lung Cancer GWAS (GERMAN), the International Agency for Research on Cancer (IARC), the Institute of Cancer Research (ICR), MD Anderson Cancer Center Study (MDACC), NCI Lung Cancer and Smoking Phenotypes in African- American Cases and Controls (NCI), OncoArray Consortium Lung Study (ONCO), the Prostate, Lung, Colorectal and Ovarian Cancer Screening Trial (PLCO), and Samuel Lunenfeld Research Institute Study (SLRI)."}

[Instance]
id: coho:COHO_0001008
name: Genetics of Hypertension Associated Treatment
def: "An ancillary pharmacogenetic study of the Antihypertensive and Lipid-Lowering Treatment to Prevent Heart Attack Trial (ALLHAT), a double-blind randomised trial of antihypertensive drugs in people aged 55 or older with hypertension and at least one other cardiovascular risk factor, conducted in 1994–2002 at centres in the United States and Canada. GenHAT genotyped the ALLHAT participants with available DNA to test whether variants in hypertension genes modify the effect of the randomised treatment on coronary heart disease and other cardiovascular outcomes." [] {IAO:0000119="PMID:12439737", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35886043", IAO:0000119="PMID:21887284", IAO:0000119="PMID:26791477"}
subset: coho1:GWAS_subset
synonym: "Genetics of Hypertension Associated Treatments" RELATED []
synonym: "Genetics of Hypertension-Associated Treatment" RELATED []
synonym: "GenHAT" RELATED OMO:0003000 []
