[Instance]
id: coho:COHO_0002752
name: Population Architecture using Genomics and Epidemiology Study
def: "A consortium initiated in 2008 by the National Human Genome Research Institute to investigate the epidemiologic architecture of well-replicated genetic variants associated with complex diseases across several large, ethnically diverse population-based studies of African American, white, Hispanic/Latino, Asian/Pacific Islander and American Indian participants, harmonising phenotypes across the studies and running coordinated cohort-specific analyses and meta-analyses." [] {IAO:0000119="PMID:21836165", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-10", dcterms:contributor="Claude Sonnet 5.5 (Anthropic), 2026-10"}
subset: coho1:GWAS_subset
synonym: "PAGE" RELATED OMO:0003000 []
synonym: "PAGE consortium" RELATED []
synonym: "PAGE Study" RELATED []
synonym: "PAGE study" RELATED []
synonym: "Population Architecture through Genomics and Environment" RELATED []
synonym: "Population Architecture Using Genetics and Epidemiology" RELATED []
synonym: "Population Architecture using Genomics and Epidemiology" RELATED []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6785182/unicode", comment="The PAGE study was developed by the National Human Genome Research Institute and the National Institute on Minority Health and Health Disparities to conduct genetic epidemiological research in ancestrally diverse populations within the United States."}
relationship: coho:hasCohort coho:COHO_0000011 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3176830/fullTextXML", comment="The PAGE consortium consists of 4 large, ongoing population-based studies or consortia: Epidemiologic Architecture for Genes Linked to Environment (EAGLE), which is based on data from 3 National Health and Nutrition Examination Surveys (NHANES; https://chgr.mc.vanderbilt.edu/eagle) (7); the Multiethnic Cohort Study (http://www.crch.org/multiethniccohort/) (8); the Women's Health Initiative (http://www.whi.org) (9); and Causal Variants Across the Life Course (CALiCo), a consortium of 5 cohort studies—Atherosclerosis Risk in Communities (ARIC; http://www.cscc.unc.edu/aric/) (10), Coronary Artery Risk Development in Young Adults (CARDIA; http://www.cardia.dopm.uab.edu/) (11), the Cardiovascular Health Study (http://www.chs-nhlbi.org/) (12), the Hispanic Community Health Study/Study of Latinos (http://www.cscc.unc.edu/hchs/) (13), and the Strong Heart Study (http://strongheart.ouhsc.edu/) (14, 15)."}
relationship: coho:hasCohort coho:COHO_0000119 {xref="https://www.pagestudy.org/studies/", comment="The PAGE MESA PI is Dr. Steven Rich."}
relationship: coho:hasCohort coho:COHO_0000121 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3176830/fullTextXML", comment="The PAGE consortium consists of 4 large, ongoing population-based studies or consortia: Epidemiologic Architecture for Genes Linked to Environment (EAGLE), which is based on data from 3 National Health and Nutrition Examination Surveys (NHANES; https://chgr.mc.vanderbilt.edu/eagle) (7); the Multiethnic Cohort Study (http://www.crch.org/multiethniccohort/) (8); the Women's Health Initiative (http://www.whi.org) (9); and Causal Variants Across the Life Course (CALiCo), a consortium of 5 cohort studies—Atherosclerosis Risk in Communities (ARIC; http://www.cscc.unc.edu/aric/) (10), Coronary Artery Risk Development in Young Adults (CARDIA; http://www.cardia.dopm.uab.edu/) (11), the Cardiovascular Health Study (http://www.chs-nhlbi.org/) (12), the Hispanic Community Health Study/Study of Latinos (http://www.cscc.unc.edu/hchs/) (13), and the Strong Heart Study (http://strongheart.ouhsc.edu/) (14, 15)."}
relationship: coho:hasCohort coho:COHO_0000384 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3176830/fullTextXML", comment="The PAGE consortium consists of 4 large, ongoing population-based studies or consortia: Epidemiologic Architecture for Genes Linked to Environment (EAGLE), which is based on data from 3 National Health and Nutrition Examination Surveys (NHANES; https://chgr.mc.vanderbilt.edu/eagle) (7); the Multiethnic Cohort Study (http://www.crch.org/multiethniccohort/) (8); the Women's Health Initiative (http://www.whi.org) (9); and Causal Variants Across the Life Course (CALiCo), a consortium of 5 cohort studies—Atherosclerosis Risk in Communities (ARIC; http://www.cscc.unc.edu/aric/) (10), Coronary Artery Risk Development in Young Adults (CARDIA; http://www.cardia.dopm.uab.edu/) (11), the Cardiovascular Health Study (http://www.chs-nhlbi.org/) (12), the Hispanic Community Health Study/Study of Latinos (http://www.cscc.unc.edu/hchs/) (13), and the Strong Heart Study (http://strongheart.ouhsc.edu/) (14, 15)."}
relationship: coho:hasCohort coho:COHO_0000388 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3176830/fullTextXML", comment="The PAGE consortium consists of 4 large, ongoing population-based studies or consortia: Epidemiologic Architecture for Genes Linked to Environment (EAGLE), which is based on data from 3 National Health and Nutrition Examination Surveys (NHANES; https://chgr.mc.vanderbilt.edu/eagle) (7); the Multiethnic Cohort Study (http://www.crch.org/multiethniccohort/) (8); the Women's Health Initiative (http://www.whi.org) (9); and Causal Variants Across the Life Course (CALiCo), a consortium of 5 cohort studies—Atherosclerosis Risk in Communities (ARIC; http://www.cscc.unc.edu/aric/) (10), Coronary Artery Risk Development in Young Adults (CARDIA; http://www.cardia.dopm.uab.edu/) (11), the Cardiovascular Health Study (http://www.chs-nhlbi.org/) (12), the Hispanic Community Health Study/Study of Latinos (http://www.cscc.unc.edu/hchs/) (13), and the Strong Heart Study (http://strongheart.ouhsc.edu/) (14, 15)."}
relationship: coho:hasCohort coho:COHO_0000409 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3176830/fullTextXML", comment="The PAGE consortium consists of 4 large, ongoing population-based studies or consortia: Epidemiologic Architecture for Genes Linked to Environment (EAGLE), which is based on data from 3 National Health and Nutrition Examination Surveys (NHANES; https://chgr.mc.vanderbilt.edu/eagle) (7); the Multiethnic Cohort Study (http://www.crch.org/multiethniccohort/) (8); the Women's Health Initiative (http://www.whi.org) (9); and Causal Variants Across the Life Course (CALiCo), a consortium of 5 cohort studies—Atherosclerosis Risk in Communities (ARIC; http://www.cscc.unc.edu/aric/) (10), Coronary Artery Risk Development in Young Adults (CARDIA; http://www.cardia.dopm.uab.edu/) (11), the Cardiovascular Health Study (http://www.chs-nhlbi.org/) (12), the Hispanic Community Health Study/Study of Latinos (http://www.cscc.unc.edu/hchs/) (13), and the Strong Heart Study (http://strongheart.ouhsc.edu/) (14, 15)."}
relationship: coho:hasCohort coho:COHO_0000424 {xref="https://www.pagestudy.org/studies/", comment="The PAGE BioMe PI is Dr. Ruth Loos."}
relationship: coho:hasCohort coho:COHO_0000425 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3176830/fullTextXML", comment="The PAGE consortium consists of 4 large, ongoing population-based studies or consortia: Epidemiologic Architecture for Genes Linked to Environment (EAGLE), which is based on data from 3 National Health and Nutrition Examination Surveys (NHANES; https://chgr.mc.vanderbilt.edu/eagle) (7); the Multiethnic Cohort Study (http://www.crch.org/multiethniccohort/) (8); the Women's Health Initiative (http://www.whi.org) (9); and Causal Variants Across the Life Course (CALiCo), a consortium of 5 cohort studies—Atherosclerosis Risk in Communities (ARIC; http://www.cscc.unc.edu/aric/) (10), Coronary Artery Risk Development in Young Adults (CARDIA; http://www.cardia.dopm.uab.edu/) (11), the Cardiovascular Health Study (http://www.chs-nhlbi.org/) (12), the Hispanic Community Health Study/Study of Latinos (http://www.cscc.unc.edu/hchs/) (13), and the Strong Heart Study (http://strongheart.ouhsc.edu/) (14, 15)."}
relationship: coho:hasCohort coho:COHO_0000751 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6059436/fullTextXML", comment="Briefly, the first phase of the PAGE study was comprised of a coordinating center, four large study sites/consortia [Causal Variants Across the Life Course (CALiCo) Consortium, including the Atherosclerosis Risk in Communities (ARIC) Study, Coronary Artery Risk Development in Young Adults (CARDIA), the Hispanic Community Health Study/Study of Latinos (HCHS/SOL); Epidemiologic Architecture for Genes Linked to Environment (EAGLE)-accessing the Vanderbilt University Medical Center’s biorepository (BioVU); Multiethnic Cohort (MEC); the Women’s Health Initiative (WHI)], and additional collaborating studies [The Hypertension Genetic Epidemiology Network (HyperGEN) Study, the MEC-Slim Initiative in Genomic Medicine for the Americas Type 2 Diabetes Consortium (MEC-SIGMA), Multi-Ethnic Study of Atherosclerosis (MESA), and Mount Sinai School of Medicine BioBank (BioME)]."}
relationship: coho:hasCohort coho:COHO_0000848 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3176830/fullTextXML", comment="The PAGE consortium consists of 4 large, ongoing population-based studies or consortia: Epidemiologic Architecture for Genes Linked to Environment (EAGLE), which is based on data from 3 National Health and Nutrition Examination Surveys (NHANES; https://chgr.mc.vanderbilt.edu/eagle) (7); the Multiethnic Cohort Study (http://www.crch.org/multiethniccohort/) (8); the Women's Health Initiative (http://www.whi.org) (9); and Causal Variants Across the Life Course (CALiCo), a consortium of 5 cohort studies—Atherosclerosis Risk in Communities (ARIC; http://www.cscc.unc.edu/aric/) (10), Coronary Artery Risk Development in Young Adults (CARDIA; http://www.cardia.dopm.uab.edu/) (11), the Cardiovascular Health Study (http://www.chs-nhlbi.org/) (12), the Hispanic Community Health Study/Study of Latinos (http://www.cscc.unc.edu/hchs/) (13), and the Strong Heart Study (http://strongheart.ouhsc.edu/) (14, 15)."}
property_value: coho:numberOfParticipants "121200" xsd:integer {IAO:0000116="participants available for study across the PAGE cohorts (the source says 'over 121,200')", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3176830/fullTextXML", comment="With over 121,200 African-American, white, Hispanic/Latino, Asian/Pacific Islander, and American Indian participants available for study across the cohorts, PAGE investigators are well poised to address the critical research questions that follow the establishment of GWAS associations through large-scale replication and generalization."}
property_value: IAO:0000112 "GCST008025" xsd:string {dcterms:title="Genetic analyses of diverse populations improves discovery for complex traits.", xref="PMID:31217584", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31217584+AND+SRC%3AMED&format=json&resultType=core", comment="The Population Architecture using Genomics and Epidemiology (PAGE) study conducted a GWAS of 26 clinical and behavioural phenotypes in 49,839 non-European individuals."}
property_value: IAO:0000116 "The acronym PAGE also denotes Psoriasis Association Genetics Extension (COHO:0000145), Placental Abruption Genetic Epidemiology study (COHO:0001268) and Parkinson's, Genes, and Environment Study (COHO:0002232); this term is Population Architecture using Genomics and Epidemiology Study." xsd:string

[Instance]
id: coho:COHO_0002753
name: GEnetics of Nephropathy: an International Effort
def: "A consortium formed to examine previously reported genetic associations with diabetic nephropathy in type 1 diabetes, bringing together similarly ascertained participants of European ancestry with type 1 diabetes, with and without diabetic nephropathy, from the All Ireland-Warren 3-Genetics of Kidneys in Diabetes UK and Republic of Ireland collection and the Finnish Diabetic Nephropathy Study, with reanalysed data from the Genetics of Kidneys in Diabetes US Study." [] {IAO:0000119="PMID:22721967", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-10", dcterms:contributor="Claude Sonnet 5.5 (Anthropic), 2026-10"}
subset: coho1:GWAS_subset
synonym: "GEnetics of Nephropathy - an International Effort" RELATED []
synonym: "GEnetics of Nephropathy-an International Effort" RELATED []
synonym: "GENIE" RELATED OMO:0003000 []
synonym: "GENIE consortium" RELATED []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Finland
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Republic_of_Ireland
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22721967+AND+SRC%3AMED&format=json&resultType=core", comment="GENIE consists of 6,366 similarly ascertained participants of European ancestry with type 1 diabetes, with and without DN, from the All Ireland-Warren 3-Genetics of Kidneys in Diabetes U.K. and Republic of Ireland (U.K.-R.O.I.) collection and the Finnish Diabetic Nephropathy Study (FinnDiane), combined with reanalyzed data from the Genetics of Kidneys in Diabetes U.S. Study (U.S. GoKinD)."}
relationship: coho:hasCohort coho:COHO_0000496 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3447939/fullTextXML", comment="In GENIE, we leveraged three existing collections for T1D nephropathy (All Ireland Warren 3 Genetics of Kidneys in Diabetes UK Collection [UK-ROI], Finnish Diabetic Nephropathy Study [FinnDiane], and Genetics of Kidneys in Diabetes US Study [GoKinD US]) comprising 6,691 individuals to perform the most comprehensive and well powered DN susceptibility genome-wide association study (GWAS) and meta-analysis to date, with the aim to identify genetic markers associated with DN by meta-analyzing independent GWAS, imputed to HapMap CEU II (Table 1, Figure 1)."}
relationship: coho:hasCohort coho:COHO_0001084 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3447939/fullTextXML", comment="In GENIE, we leveraged three existing collections for T1D nephropathy (All Ireland Warren 3 Genetics of Kidneys in Diabetes UK Collection [UK-ROI], Finnish Diabetic Nephropathy Study [FinnDiane], and Genetics of Kidneys in Diabetes US Study [GoKinD US]) comprising 6,691 individuals to perform the most comprehensive and well powered DN susceptibility genome-wide association study (GWAS) and meta-analysis to date, with the aim to identify genetic markers associated with DN by meta-analyzing independent GWAS, imputed to HapMap CEU II (Table 1, Figure 1)."}
property_value: coho:numberOfParticipants "6366" xsd:integer {IAO:0000116="participants of European ancestry with type 1 diabetes, with and without diabetic nephropathy", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22721967+AND+SRC%3AMED&format=json&resultType=core", comment="GENIE consists of 6,366 similarly ascertained participants of European ancestry with type 1 diabetes, with and without DN, from the All Ireland-Warren 3-Genetics of Kidneys in Diabetes U.K. and Republic of Ireland (U.K.-R.O.I.) collection and the Finnish Diabetic Nephropathy Study (FinnDiane), combined with reanalyzed data from the Genetics of Kidneys in Diabetes U.S. Study (U.S. GoKinD)."}
property_value: IAO:0000112 "GCST001688" xsd:string {dcterms:title="New susceptibility loci associated with kidney disease in type 1 diabetes.", xref="PMID:23028342", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3447939/fullTextXML", comment="In GENIE, we leveraged three existing collections for T1D nephropathy (All Ireland Warren 3 Genetics of Kidneys in Diabetes UK Collection [UK-ROI], Finnish Diabetic Nephropathy Study [FinnDiane], and Genetics of Kidneys in Diabetes US Study [GoKinD US]) comprising 6,691 individuals to perform the most comprehensive and well powered DN susceptibility genome-wide association study (GWAS) and meta-analysis to date, with the aim to identify genetic markers associated with DN by meta-analyzing independent GWAS, imputed to HapMap CEU II (Table 1, Figure 1)."}
property_value: IAO:0000116 "The acronym GENIE also denotes Gene-Environmental Interaction and phenotype study (COHO:0000186) and AACR Project GENIE (COHO:0000209); this term is GEnetics of Nephropathy: an International Effort." xsd:string

[Instance]
id: coho:COHO_0002754
name: Northwest Institute of Genetic Medicine biorepository
def: "A biorepository based at the University of Washington and co-managed by the University of Washington and Kaiser Permanente Washington, built as infrastructure for a broad range of future genetic research, through which Kaiser Permanente Washington participants were enrolled in the eMERGE Network." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-10", IAO:0000119="https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001584/phs001584.v2.p2/GapExchange_phs001584.v2.p2.xml", dcterms:contributor="Claude Sonnet 5.5 (Anthropic), 2026-10"}
synonym: "NWIGM" RELATED OMO:0003000 []
synonym: "NWIGM biorepository" RELATED []
synonym: "NWIGM repository" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001584/phs001584.v2.p2/GapExchange_phs001584.v2.p2.xml", comment="Kaiser Permanente Washington with the University of Washington and the Fred Hutchinson Cancer Research Center, Seattle, WA, USA"}
relationship: coho:isCohortOf coho:COHO_0000491
property_value: IAO:0000112 "PMID:26221186" xsd:string {dcterms:title="Prospective participant selection and ranking to maximize actionable pharmacogenetic variants and discovery in the eMERGE Network.", xref="PMID:26221186", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4517371/fullTextXML", comment="Potential GH participants for the PGx project were enrolled in the eMERGE Network through the Northwest Institute of Genetic Medicine (NWIGM) biorepository, and provided the appropriate consent to receive clinically relevant genetic results (N ∼6300)."}

