property_value: IAO:0000112 "PMID:30787307" xsd:string {dcterms:title="Association study in African-admixed populations across the Americas recapitulates asthma risk loci in non-African populations.", xref="PMID:30787307", xref="https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf", comment="The Brazilian Immunogenetics of Asthma and Schistosomiasis (BIAS) study is a whole-population ascertainment designed study of asthma and schistosomiasis in the rural district of Conde, Bahia, located 200 km north of Salvador, Brazil [14-16]."}

[Instance]
id: coho:COHO_0001530
name: Biobank Innovations for Chronic Cerebrovascular Disease With Alzheimer's Disease Study
def: "A prospective, longitudinal, multicentre biobank cohort of older adults with cognitive complaints (subjective cognitive decline, mild cognitive impairment, Alzheimer's disease, vascular and other dementias) enrolled from October 2016 to December 2020 at five South Korean university hospitals (Ajou University Hospital, Samsung Medical Center, Inha University Hospital, Pusan National University Hospital and Chonnam National University Hospital), planned and funded by the Korea Disease Control and Prevention Agency for the Korea Biobank Project to bank biospecimens and data for research on Alzheimer's disease, chronic cerebrovascular disease and mixed pathology; participants have clinical and neuropsychological assessments and blood tests, subsets have brain MRI, amyloid PET, Korea Biobank Array genotyping, actigraphy and skin fibroblast sampling, and follow-up is planned annually." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35042283"}
