[Instance]
id: coho:COHO_0000465
name: Cleveland Family Speech and Reading Study
def: "A family-based longitudinal cohort of children with speech sound disorder of unknown cause and their siblings, ascertained through probands referred by speech-language pathologists in the Cleveland area of Ohio, United States, and followed for about 25 years to study long-term speech, language and literacy outcomes and their genetic basis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:34315907", IAO:0000119="PMID:41118674"}
subset: coho1:GWAS_subset
