[Instance]
id: coho:COHO_0001040
name: Wake Forest School of Medicine Study
def: "A case-control study of African Americans in North Carolina, South Carolina, Georgia, Tennessee and Virginia, United States, recruited by Wake Forest School of Medicine for genetic studies of type 2 diabetes and nephropathy. Cases with type 2 diabetes and end-stage kidney disease were recruited from dialysis facilities and controls without diabetes or kidney disease from the community and internal medicine clinics, later joined by people with type 2 diabetes but no nephropathy and people with non-diabetic end-stage kidney disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31092297", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2608/MediaObjects/41588_2013_BFng2608_MOESM1_ESM.pdf", IAO:0000119="PMID:22238593"}
