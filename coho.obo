property_value: IAO:0000112 "PMID:33171599" xsd:string {dcterms:title="Dietary Patterns and Their Association with Body Composition and Cardiometabolic Markers in Children and Adolescents: Genobox Cohort.", xref="PMID:33171599", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7695147/fullTextXML", comment="A total of 793 children from those recruited in the GENOBOX clinic cohort participated in this study after applying the inclusion and exclusion criteria."}

[Instance]
id: coho:COHO_0002650
name: Rio Birth Cohort Study on Environmental Exposure and Childhood Development
def: "A hospital-based prospective birth cohort of pregnant women aged 16 or over living in the city of Rio de Janeiro, Brazil, and their children born at the Maternity School of the Federal University of Rio de Janeiro, coordinated by the university's Institute for Studies in Collective Health with Fiocruz, in which mothers and children are followed with interviews, examinations and biological samples from pregnancy to age four to study the effects of prenatal and early-life exposure to metals, pesticides and plasticisers on child health and development; a pilot phase ran from September 2017 to August 2018." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32566487 ", IAO:0000119=" https://pipaufrj.me.ufrj.br/sobre/"}
