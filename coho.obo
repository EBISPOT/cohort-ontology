property_value: coho:numberOfControls "652" xsd:integer {IAO:0000116="participants recruited: 2329 with depressive/anxiety disorder, 367 siblings, 652 healthy controls", xref="PMID:33773360", comment="The NESDA sample recruited initially 2329 persons with a remitted or current DSM-IV based depressive (major depressive disorder, dysthymia) and/or anxiety disorder (panic disorder, social phobia, agoraphobia, generalized anxiety disorder), 367 of their siblings and 652 healthy controls, yielding a total of 3348 participants."}
