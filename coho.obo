property_value: coho:numberOfParticipants "3310" xsd:integer {IAO:0000116="OCCPI patients completing tumour screening and germline testing", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC8232834/", comment="Tumor screening and germline testing were completed for 3,310 patients, representing 12.4% of CRC diagnosed in Ohio during the study period per the Ohio Incidence and Surveillance System (N = 26,692)."}
property_value: IAO:0000112 "PGS000734" xsd:string {dcterms:title="Cumulative Burden of Colorectal Cancer-Associated Genetic Variants Is More Strongly Associated With Early-Onset vs Late-Onset Cancer.", xref="PMID:31866242"}
property_value: IAO:0000112 "PMID:31866242" xsd:string {dcterms:title="Cumulative Burden of Colorectal Cancer-Associated Genetic Variants Is More Strongly Associated With Early-Onset vs Late-Onset Cancer.", xref="PMID:31866242", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7103489/unicode", comment="Screening of colorectal cancer cases for the presence of Lynch syndrome was systematically carried out for CRC cases recruited through the Ohio State University Medical Center (OSUMC) (Table S1: HNPCC, OCCPI, and OSUMC) as described in detail elsewhere."}

