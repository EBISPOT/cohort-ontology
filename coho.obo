property_value: coho:numberOfParticipants "4360" xsd:integer {IAO:0000116="outpatients aged 15+ with bipolar disorder enrolled", xref="PMID:35773558", comment="Data were drawn from the Systematic Treatment Enhancement Program for Bipolar Disorder (STEP-BD), a naturalistic study of 4360 outpatients 15 years or older with BD."}
property_value: IAO:0000112 "GCST90244683" xsd:string {dcterms:title="Body weight changes and bipolar disorder: a molecular pathway analysis.", xref="PMID:36305391", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36305391+AND+SRC%3AMED&format=json&resultType=core", comment="The STEP-BD sample is analyzed through a hypothesis-free molecular pathway analysis in order to detect the molecular pathways that distinguish individuals who experience weight change during BD treatment from those who do not."}

[Instance]
id: coho:COHO_0001416
name: Simultaneous Study of Gemcitabine-Docetaxel Combination adjuvant treatment, as well as Extended Bisphosphonate and Surveillance-Trial
def: "An open-label, multicentre, randomised phase III trial in Germany, sponsored by Ludwig-Maximilians-University Munich, that enrolled adult patients with invasive early breast cancer at high risk of recurrence from 2005 to 2007 and compared, in a 2×2 factorial design, adjuvant FEC–docetaxel chemotherapy with or without gemcitabine and two versus five years of zoledronic acid, with an affiliated translational research programme on circulating tumour cells, serum tumour markers and pharmacogenetics." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24832787", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT02181101", IAO:0000119="PMID:33097092"}
