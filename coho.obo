[Instance]
id: coho:COHO_0000474
name: Africa America Diabetes Mellitus Study
def: "A genetic epidemiology study of type 2 diabetes begun in 1997 as a collaboration of West African and US investigators, enrolling affected sib-pairs with type 2 diabetes and unaffected controls in Ghana and Nigeria and later participants in Eldoret, Kenya, to map type 2 diabetes susceptibility genes in the West African ancestral populations of African Americans." [] {IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8499470/fullTextXML", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:11164120"}
