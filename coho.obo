synonym: "Altersbezogene Untersuchungen zur Gesundheit der Universität Regensburg" RELATED []
synonym: "AugUR" RELATED OMO:0003000 []
synonym: "AugUR study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Germany {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26489512+AND+SRC%3AMED&format=json&resultType=core", comment="We establish the German AugUR study (Age-related diseases: understanding genetic and non-genetic influences - a study at the University of Regensburg), a prospective study in the mobile elderly general population in and around Regensburg in eastern Bavaria."}
property_value: coho:numberOfParticipants "2449" xsd:integer {IAO:0000116="participants of the two baseline surveys (AugUR1 2013-2015: 1133; AugUR2 2017-2019: 1316)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10511022/fullTextXML", comment="Among the 2449 AugUR participants (AugUR1: n = 1133 and AugUR2: n = 1316; and no overlap between the 2 datasets), information on AMD stages for at least one eye, as well as genetic data were available for 2188 persons (AugUR1: n = 1010 and AugUR2: n = 1178)."}
property_value: IAO:0000112 "GCST010723" xsd:string {dcterms:title="Genome-wide association meta-analysis for early age-related macular degeneration highlights novel loci and insights for advanced disease.", xref="PMID:32843070", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7449002/fullTextXML", comment="Our studies were primarily population-based cohort studies, where the baseline survey data were used for this analysis from studies of the authors (GHS, LIFE, NICOLA, KORA, AugUR) as well as for publicly available studies from dbGaP (ARIC, CHS, WHI; accession numbers: phs000090.v5.p1, phs000287.v6.p1, phs000746.v2.p3)."}

[Instance]
id: coho:COHO_0001286
name: Bambui (Brazil) Cohort Study of Ageing
def: "A population-based cohort of the residents aged 60 and over of the town of Bambuí, in Minas Gerais, south-eastern Brazil, identified by a complete census on 1 January 1997 and examined at baseline in February–May 1997 with interviews, blood tests, blood pressure measurements and electrocardiograms, then followed with annual interviews, repeated examinations and death ascertainment to study health and mortality in older adults." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:23251690", IAO:0000119="PMID:33633342"}
