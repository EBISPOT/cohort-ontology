relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2776981/fullTextXML", comment="Participants were recruited at three centers: Howard University and Children's National Medical Center in Washington, DC and the University of Michigan in Ann Arbor, Michigan."}
property_value: coho:numberOfParticipants "381" xsd:integer {IAO:0000116="children and adolescents with sickle cell anaemia (HbSS) recruited (HbSS subset only; controls and other genotypes excluded)", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_json/PMC3258348/unicode"}
property_value: IAO:0000112 "GCST90897930" xsd:string {dcterms:title="FLT1 and other candidate fetal haemoglobin modifying loci in sickle cell disease in African ancestries.", xref="PMID:40025045", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11873275/fullTextXML", comment="The cohorts included: Cooperative Study of Sickle Cell Disease (CSSCD: n = 841), Multicenter Study of Hydroxyurea (MSH: n = 178), Pulmonary Hypertension and the Hypoxic Response in Sickle Cell Disease (PUSH) study (n = 73), Comprehensive Sickle Cell Centers Collaborative Data (C-data) project (n = 127), Treatment of Pulmonary Hypertension and Sickle Cell Disease with Sildenafil Treatment (Walk-PHaSST) trial (n = 181), Duke University Outcome Modifying Genes study (n = 152), and Silent Infarct Transfusion (SIT) trial (SITT: n = 488)."}

[Instance]
id: coho:COHO_0001395
name: Queen Square Brain Bank for Neurological Disorders
def: "A research tissue bank at the UCL Queen Square Institute of Neurology in London that archives brains and other tissue from donors across the UK, registered through its donor scheme during life, who had neurological and mostly neurodegenerative diseases such as Parkinson's disease, multiple system atrophy and progressive supranuclear palsy, and from neurologically normal controls, and supplies well-characterised tissue and data for research." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:12784275", IAO:0000119="PMID:38849413", IAO:0000119="https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/queen-square-brain-bank-for-neurological-disorders-qsbb-and-neurores/"}
subset: coho1:GWAS_subset
synonym: "QSBB" RELATED OMO:0003000 []
synonym: "Queen Square Brain Bank" RELATED []
