relationship: coho:hasCohort coho:COHO_0001440 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8297786/fullTextXML", comment="For the current study, data from COHRA1 (a cohort of the Center for Oral Health Research in Appalachia) was analyzed."}
relationship: coho:hasCohort coho:COHO_0001444 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4451284/fullTextXML", comment="The Center for Oral Health Research in Appalachia (COHRA) has been enrolling pregnant women and their babies since 2011 in the COHRA2 study of genetic, microbial, and environmental factors involved in oral health in Northern Appalachia."}
