[Instance]
id: coho:COHO_0000753
name: Helsinki 2000 Ischemic Stroke Genetics Study
def: "A hospital-based case-control study of ischaemic stroke in Finland, in which patients with neuroimaging-confirmed new-onset brain infarction were recruited at Helsinki University Central Hospital, with TOAST subtyping, detailed phenotype data and blood samples, and controls were FINRISK 1992, 1997 and 2002 participants from the Greater Helsinki region frequency-matched by age and sex, to investigate genetic factors underlying ischaemic stroke." [] {IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29531354"}
subset: coho1:GWAS_subset
