[Instance]
id: coho:COHO_0002597
name: My Purchases cohort
def: "A cohort of adult Danish residents who, since June 2021, have consented through a web application run by Statens Serum Institut to donate the digital receipts of their consumer purchases, linked through their personal identification number to national health registers, to study how purchases, diet and household lifestyle exposures affect health." [] {IAO:0000119="PMID:38062070", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/CON"}
