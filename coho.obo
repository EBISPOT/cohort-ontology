property_value: IAO:0000112 "GCST90104085" xsd:string {dcterms:title="Common X-Chromosome Variants Are Associated with Parkinson Disease Risk.", xref="PMID:33583074", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8601399/unicode", comment="The PD cohorts include the International PD Genomics Consortium (IPDGC) NeuroX dataset, the National Institute of Neurological Disorders and Stroke (NINDS) PD dataset, the Autopsy-Confirmed PD GWAS Consortium (APDGC) dataset genotyped by the Center for Inherited Disease Research, the NeuroGenetics Research Consortium (NGRC) dataset, the UK PD Consortium, and the Wellcome Trust Case Control Consortium 2, referred to here as EBI MERGE."}

[Instance]
id: coho:COHO_0001056
name: Alcohol-Related Cancers and Genetic susceptibility in Europe
def: "A multicentre case-control study of upper aerodigestive tract cancers (oral cavity, pharynx, larynx and oesophagus), initiated by the International Agency for Research on Cancer in 2002, that recruited newly diagnosed cases and hospital controls (population controls in the United Kingdom) at centres in about ten European countries, mostly in 2002-2005, with interviews on smoking, drinking and diet and biological samples, to study genetic susceptibility to these cancers and its interplay with lifestyle factors." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:20506380", IAO:0000119="PMID:18830131"}
