relationship: coho:isSubCohortOf coho:COHO_0000016 {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5593097/unicode", comment="ARIES is a sub-study of the Avon Longitudinal Study of Parents and Children (ALSPAC)."}
