[Instance]
id: coho:COHO_0001412
name: Sao Paulo Heart Failure Cohort
def: "A cohort of adults with symptomatic (stage C) heart failure of different aetiologies, prospectively enrolled from the outpatient clinic of the Heart Institute of the University of São Paulo Medical School in São Paulo, Brazil. Its genotyped participants, with atrial fibrillation ascertained from electrocardiograms and medical records, have contributed to genome-wide association studies of atrial fibrillation." [] {IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:40050429"}
