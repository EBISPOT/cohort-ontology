property_value: IAO:0000112 "PMID:30326636" xsd:string {dcterms:title="An Analytic Approach Using Candidate Gene Selection and Logic Forest to Identify Gene by Environment Interactions (G × E) for Systemic Lupus Erythematosus in African Americans.", xref="PMID:30326636", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6211136/fullTextXML", comment="The SLE study used a case control design, and subjects were selected from people participating in the SLE in Gullah Health (SLEIGH) Study, which began recruitment in 2003"}

[Instance]
id: coho:COHO_0002392
name: Prevalence of osteoporosis in Slovenia
def: "A cross-sectional, population-based study of osteoporosis in Ljubljana, Slovenia, created within projects funded by the Slovenian Research Agency, that included premenopausal women aged 35 to 50 years and postmenopausal women and men aged over 50 years in order to carry out genotype-phenotype association studies; it was one of the studies de novo genotyped for the replication stage of the 2012 GEFOS genome-wide meta-analysis of bone mineral density and fracture." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2249/MediaObjects/41588_2012_BFng2249_MOESM26_ESM.pdf", IAO:0000119="PMID:30158200"}
