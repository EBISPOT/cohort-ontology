relationship: coho:has_data_collection_location http://dbpedia.org/resource/Italy {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33988330+AND+SRC%3AMED&format=json&resultType=core", comment="In the frame of The Vobarno Study blood samples for hematochemistry and DNA extraction, clinic and 24-hour blood pressure measurements, cardiac and carotid ultrasound, and aortic stiffness were measured in all subjects, living in a small town (Vobarno) between Brescia and the Garda Lake (Italy), and randomly selected from electoral roles."}
property_value: coho:numberOfParticipants "600" xsd:integer {IAO:0000116="about 600 individuals, the Vobarno Study population as a 2009 congress abstract gives it (approximate)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7101653/fullTextXML", comment="We have examined about 600 individuals (Vobarno Study population), who have been characterized for traditional cardiovascular risk factors, including cigarette smoking."}
property_value: IAO:0000112 "PMID:20520574" xsd:string {dcterms:title="Pulse wave velocity and cardiovascular risk stratification in a general population: the Vobarno study.", xref="PMID:20520574", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20520574+AND+SRC%3AMED&format=json&resultType=core", comment="Pulse wave velocity and cardiovascular risk stratification in a general population: the Vobarno study."}

[Instance]
id: coho:COHO_0002552
name: Vlagtwedde/Vlaardingen study
def: "A population-based cohort study of the epidemiology of pulmonary diseases in adults of Dutch descent from the general population of Vlagtwedde and Vlaardingen, the Netherlands, who from 1965 until the last survey in 1989/1990 had medical examinations with a respiratory questionnaire and spirometry every three years, and whose vital status was later updated; its genotyped participants have been used in genetic studies of lung function, airflow obstruction and respiratory symptoms." [] {IAO:0000119="PMID:23054033", IAO:0000119="PMID:27055053", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28273074", IAO:0000119="PMID:28073367", IAO:0000119="PMID:30845926"}
