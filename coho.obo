[Instance]
id: coho:COHO_0001724
name: Framingham Eye Study
def: "An ophthalmological study nested within the Framingham Heart Study in Framingham, Massachusetts, United States, in which participants of the Heart Study's original cohort were given eye examinations in 1973–1975 to evaluate senile cataract, age-related macular degeneration, glaucoma and retinopathy, and offspring of the original participants were examined in 1989–1991." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:141882", IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf"}
