property_value: coho:numberOfParticipants "1955" xsd:integer {IAO:0000116="postmenopausal women with extreme high or low hip BMD in the GWAS discovery sample", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3080863/fullTextXML", comment="In order to improve study power and to address the demographic group of highest risk from osteoporotic fracture, we have used a unique study design, studying 1,955 postmenopausal women with either extreme high or low hip bone mineral density."}
property_value: IAO:0000112 "GCST001595" xsd:string {dcterms:title="WNT16 influences bone mineral density, cortical bone thickness, bone strength, and osteoporotic fracture risk.", xref="PMID:22792071", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3390364/fullTextXML", comment="The Anglo-Australasian Osteoporosis Genetics Consortium (AOGC) study collected unrelated individuals with extreme BMD phenotypes as a powerful strategy for gene discovery in quantitative traits [11], [52]."}

[Instance]
id: coho:COHO_0001280
name: Anakinra for Pustular Psoriasis: Response in a Controlled Trial
def: "A randomised, double-blind, placebo-controlled, two-stage adaptive trial, funded by the NIHR Efficacy and Mechanism Evaluation programme, that enrolled adults with palmoplantar pustulosis severe enough to need systemic therapy at 16 sites in England, Scotland and Wales between October 2016 and January 2020, to test whether 8 weeks of the interleukin-1 receptor antagonist anakinra reduces disease severity." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:30157880", IAO:0000119="PMID:34411292"}
subset: coho1:GWAS_subset
