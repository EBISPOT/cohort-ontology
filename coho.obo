property_value: IAO:0000112 "GCST90308732" xsd:string {dcterms:title="A genome-wide search for pleiotropy in more than 100,000 harmonized longitudinal cognitive domain scores.", xref="PMID:37349795", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10286470/fullTextXML", comment="This study included non-Hispanic white participants of the Framingham Heart Study (FHS), National Institute on Aging sponsored Alzheimer’s Disease Research Centers whose phenotypic information was assembled and curated by the National Alzheimer’s Coordinating Center (NACC), the Adult Changes in Thought (ACT) Study, the Alzheimer’s Disease Neuroimaging Initiative (ADNI), and the Religious Orders Study/Rush Memory and Aging Project (ROSMAP)."}

[Instance]
id: coho:COHO_0000401
name: Mayo Clinic Biobank
def: "A clinic-based prospective cohort of about 57,000 adult Mayo Clinic patients who are US residents, enrolled at Rochester, Minnesota, Jacksonville, Florida and La Crosse, Wisconsin, established to supply control groups for case-control studies, form a prospective cohort for common outcomes and support electronic health record and genotype-driven research." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31699749"}
