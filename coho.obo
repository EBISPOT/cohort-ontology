property_value: IAO:0000112 "PGS000770" xsd:string {dcterms:title="The Challenge of Stratifying Obesity: Attempts in the Quebec Family Study.", xref="PMID:31649740"}
property_value: IAO:0000112 "PMID:31649740" xsd:string {dcterms:title="The Challenge of Stratifying Obesity: Attempts in the Quebec Family Study.", xref="PMID:31649740", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31649740+AND+SRC%3AMED&format=json&resultType=core", comment="A total of 231 single nucleotide polymorphisms (SNP) significantly associated to body mass index (BMI) from 21 genome-wide association studies were genotyped or imputed in 881 subjects from the Quebec Family Study (QFS)."}

[Instance]
id: coho:COHO_0002304
name: SYNERGIQC
def: "A research cohort of ever-smokers aged 55–74 at high clinical risk of lung cancer (a PLCOm2012norace risk of 2% or more) enrolled in the provincial multicentre pilot lung cancer screening program of Quebec, Canada, launched in 2021, who gave blood samples to the AIRS biobank at the IUCPQ and CUSM sites at their first or second screening visit and are followed for incident lung cancer after low-dose CT screening managed with Lung-RADS." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:41990546"}
