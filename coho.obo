property_value: coho:numberOfParticipants "3100" xsd:integer {IAO:0000116="subjects enrolled since 1987 (stated as 'more than 3100'), 2015", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4593391/unicode", comment="The BBDP has been in existence since 1987 and has enrolled more than 3100 subjects over that time, which constitutes more than 2% of the current combined populations of the surrounding retirement communities."}
property_value: IAO:0000112 "PMID:33958783" xsd:string {dcterms:title="Genome-wide survival study identifies a novel synaptic locus and polygenic score for cognitive progression in Parkinson's disease.", xref="PMID:33958783", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8459648/unicode", comment="HBS, Arizona Study of Aging/Brain and Body Donation Program, NET-PD LS1, CamPaIGN, PICNICS, DIGPD, PDBP, PIB, ParkWest, PROPARK and PROPARK-C cohorts comprised the discovery population and DATATOP, PPMI, PreCEPT and Tartu the replication population."}

[Instance]
id: coho:COHO_0001507
name: BARCODE1
def: "A community-based prostate cancer risk-screening study in the United Kingdom, coordinated by the Institute of Cancer Research, that invites men of European ancestry via their general practitioners to undergo a germline genetic profile test of prostate cancer risk single nucleotide polymorphisms. Men in the highest genetic-risk stratum are offered MRI-led prostate screening and targeted biopsy; the study began with a feasibility pilot before opening to wider recruitment." [] {IAO:0000119="PMID:34214236", dcterms:contributor="Claude Sonnet 5 (Anthropic), 2026-09"}
synonym: "BARCODE 1" RELATED []
synonym: "The BARCODE 1 Study: The Use of Genetic Profiling to Guide Prostate Cancer Targeted Screening" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34214236+AND+SRC%3AMED&format=json&resultType=core", comment="The BARCODE1 Pilot has shown this community study in the UK to be feasible, with an overall uptake of 26%."}
property_value: coho:numberOfParticipants "6393" xsd:integer {IAO:0000116="men with a polygenic risk score calculated (genotyped participants), 2025", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:40214032%20AND%20SRC:MED&format=json&resultType=core", comment="Among 40,292 persons invited to participate, 8953 (22.2%) expressed interest in participating and 6393 had their polygenic risk score calculated; 745 (11.7%) had a polygenic risk score in the 90th percentile or higher and were invited to undergo screening."}
property_value: IAO:0000112 "PMID:34214236" xsd:string {dcterms:title="The BARCODE1 Pilot: a feasibility study of using germline single nucleotide polymorphisms to target prostate cancer screening.", xref="PMID:34214236", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9292247/fullTextXML", comment="The BARCODE1 study (NCT03857477) is enrolling men of European ancestry from the community via their GPs to undergo a germline genetic profile test utilising 130 PCa risk SNPs."}

[Instance]
id: coho:COHO_0001508
name: Therapeutic Trial collection
def: "A collection of patients with relapsing–remitting multiple sclerosis or a clinically isolated syndrome with MRI signs of demyelination, assembled by Bayer Schering Pharma from four of its clinical trials: three studies of interferon beta-1b (BENEFIT, BEYOND and the 16-year long-term follow-up of the pivotal interferon beta-1b trial in relapsing–remitting multiple sclerosis) and one of a CCR1 antagonist. It was genotyped genome-wide and used as multiple sclerosis cases in genetic studies of susceptibility." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19879194", IAO:0000119="PMID:22190364"}
synonym: "BayerScheringPharma" RELATED OMO:0003000 []
synonym: "TT" RELATED OMO:0003000 []
