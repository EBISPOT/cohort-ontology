[Instance]
id: coho:COHO_0001430
name: Vanderbilt Online Musicality Study
def: "An online study of adults aged 18 or over who speak English fluently, conducted by researchers at Vanderbilt University Medical Center in Nashville, Tennessee, and recruited worldwide, mainly through ResearchMatch and also through Vanderbilt newsletters and research mailing lists, Reddit, Facebook advertising and social media sharing. Participants completed web-based questionnaires on music engagement and auditory tasks of musical rhythm and speech perception, and those with a US mailing address were invited to return mail-in saliva samples for genotyping, to study the genetics of musicality." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:41715922", IAO:0000119="PMID:36718543"}
subset: coho1:GWAS_subset
synonym: "Vanderbilt_OM" RELATED OMO:0003000 []
