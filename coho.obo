[Instance]
id: coho:COHO_0000443
name: Immune and Metabolic Markers during Pregnancy and Child Development Study
def: "A case-control study of mothers and children born at Kaiser Permanente Northern California from January 2011 to January 2016, oversampling children later diagnosed with autism spectrum disorder or other developmental delay alongside general-population controls, with maternal first- and second-trimester blood samples from the RPGEH pregnancy cohort, to study maternal immune and metabolic markers and child neurodevelopment." [] {IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13340790/fullTextXML", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10689278/fullTextXML"}
