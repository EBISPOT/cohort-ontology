relationship: coho:has_data_collection_location http://dbpedia.org/resource/Italy
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Sweden {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2575233/fullTextXML", comment="We conducted our study on SGK genetic variance and potential associations with insulin secretory function in the German TUEF cohort and the EUGENE2 consortium (Denmark, Finland, Germany, Italy, and Sweden), as these two European diabetes risk populations were extensively phenotyped for insulin secretion traits at the prediabetic stage."}
property_value: coho:numberOfParticipants "849" xsd:integer {IAO:0000116="non-diabetic offspring of type 2 diabetes patients with DNA available, five centres (2009)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2747270/fullTextXML", comment="Altogether DNA from 849 non-diabetic offspring was available for examination: Danes (n = 253), Finns (n = 217), Germans (n = 149), Italians (n = 130), and Swedes (n = 100)."}
