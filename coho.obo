relationship: coho:has_data_collection_location http://dbpedia.org/resource/Oceania
property_value: coho:numberOfParticipants "3801" xsd:integer {IAO:0000116="participants who had taken part in the core online survey by 21 August 2020", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7750170/fullTextXML", comment="To date, 3801 participants have taken part in the core survey with 65% of those going on to complete all additional modules (Fig. 3)."}
property_value: IAO:0000112 "PGS005221" xsd:string {dcterms:title="Uncovering the multivariate genetic architecture of frailty with genomic structural equation modeling.", xref="PMID:40759756"}
property_value: IAO:0000112 "PMID:40759756" xsd:string {dcterms:title="Uncovering the multivariate genetic architecture of frailty with genomic structural equation modeling.", xref="PMID:40759756", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12626885/fullTextXML", comment="To validate latent frailty factors as phenotypes that capture frailty-specific variance, we created polygenic risk scores (PRSs) for each latent frailty factor and used regression models to test how well they predicted frailty and frailty-related outcomes in three external older adult cohorts (the Lothian Birth Cohort 1936 (LBC1936) (n = 1,005; mean age = 69.60), the English Longitudinal Study of Aging (ELSA) (n = 7,181, mean age = 68.45) and the Prospective Imaging Study of Aging (PISA) (n = 3,265, mean age = 60.34)) (Methods and Supplementary Note)."}

