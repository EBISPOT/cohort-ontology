property_value: coho:numberOfParticipants "957" xsd:integer {IAO:0000116="screen-positive participants who consented to phase II (clinical, neuropsychological and MRI assessment)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7021682/fullTextXML", comment="Screen positives who provided consent (n = 957) participated in the second phase of the study, which included comprehensive clinical and neuropsychological evaluations, together with neuroimaging at the same session."}
