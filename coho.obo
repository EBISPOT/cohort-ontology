property_value: IAO:0000112 "PMID:22426144" xsd:string {dcterms:title="Genome-wide association study identifies a possible susceptibility locus for endometrial cancer.", xref="PMID:22426144", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3372671/", comment="additional samples from ANECS that were not included in Stage 2 analyzed together with Australian cases recruited into the Newcastle Endometrial Cancer Study (NECS) and Australian controls recruited via the Australian Red Cross Blood Service (ARCBS)"}

[Instance]
id: coho:COHO_0002131
name: National Eye Institute Glaucoma Human Genetics Collaboration
def: "A case-control study for a genome-wide association study of primary open-angle glaucoma, run by a consortium of investigators at 12 institutions across the United States, whose cases and controls, aged 35 or over and of European or Hispanic white ancestry, were collected at the 12 sites. Most came from university glaucoma and general ophthalmology clinics, and some from other studies such as the Marshfield Personalized Medicine Research Project and the CIGTS and AGIS glaucoma trials. The case and control definitions were harmonised with the GLAUGEN study, and the clinical data were reviewed centrally at the Massachusetts Eye and Ear Infirmary." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22570617", IAO:0000119="PMID:22828004"}
