property_value: IAO:0000112 "GCST90446466" xsd:string {dcterms:title="Genome-Wide Search for Nonadditive Allele Effects Identifies <i>PSKH2</i> as Involved in the Variability of Factor V Activity.", xref="PMID:39424413", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39424413+AND+SRC%3AMED&format=json&resultType=core", comment="QUICKTEST was applied to 4 independent genome-wide association studies studies (LURIC [Ludwigshafen RIsk and Cardiovascular Health Study], MARTHA [Marseille Thrombosis Association], MEGA [Multiple Environmental and Genetic Assessment], and RETROVE [Riesgo de Enfermedad Tromboembolica Venosa]) totaling 4505 participants of European ancestry with measured FV plasma levels."}

[Instance]
id: coho:COHO_0000846
name: Recurrent Venous Thromboembolism Risk Stratification Evaluation
def: "A multicentre prospective cohort of 646 patients with a first unprovoked major venous thromboembolism, enrolled from 12 tertiary care centres in 4 countries while on oral anticoagulation 5–7 months after the event and followed after stopping anticoagulation (to September 2006), to derive a clinical decision rule identifying patients at low risk of recurrent venous thromboembolism." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML", IAO:0000119="PMID:18725614"}
