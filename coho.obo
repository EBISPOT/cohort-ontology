[Instance]
id: coho:COHO_0000546
name: Study to Understand the Genetics of the Acute Response to Metformin and Glipizide in Humans
def: "A pharmacogenetic study established in 2007 at Massachusetts General Hospital, which from 2008 enrolled about 1,000 adults of diverse ancestry enriched for risk of type 2 diabetes and challenged them with glipizide and metformin at clinical research centres in Boston, Massachusetts, to identify genetic variants influencing the acute response to glucose-lowering drugs." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:37233759", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML"}
subset: coho1:GWAS_subset
synonym: "SUGAR-MGH" RELATED OMO:0003000 []
synonym: "The Study to Understand the Genetics of the Acute Response to Metformin and Glipizide in Humans" RELATED []
