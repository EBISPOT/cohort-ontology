[Instance]
id: coho:COHO_0001105
name: MUNICH stroke study
def: "A hospital-based collection of consecutive patients of European ancestry with ischaemic stroke, recruited from 2002 to 2009 at the dedicated stroke unit of the Department of Neurology, Klinikum Großhadern, Ludwig-Maximilians-University, Munich, Germany, with stroke subtypes assigned by TOAST criteria; the cases were genotyped genome-wide in the Wellcome Trust Case Control Consortium 2 ischaemic stroke study and contribute to METASTROKE, the Stroke Genetics Network (SiGN) and MEGASTROKE." [] {IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24021684", IAO:0000119="PMID:22306652", IAO:0000119="PMID:23041239"}
