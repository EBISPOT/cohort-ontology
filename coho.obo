property_value: IAO:0000112 "GCST90451684" xsd:string {dcterms:title="Novel loci and biomedical consequences of iron homoeostasis variation.", xref="PMID:39643614", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11624196/supplementaryFiles", comment="FinDonor 10000 (FinDonor) is a prospective study observing blood donor iron stores and genetic and lifestyle factors associated with iron stores."}

[Instance]
id: coho:COHO_0001326
name: National FinHealth 2017 Study
def: "A national health examination survey of adults aged 18 or older living in mainland Finland, run by the Finnish Institute for Health and Welfare (THL) at 50 study locations between January and May 2017 in a representative sample drawn from the Population Register by one- and two-stage stratified random sampling, in which participants answered questionnaires on sociodemographic factors, health, quality of life, lifestyle, diseases and medication and attended a health examination with physical measurements and blood sampling, to monitor the health, functional capacity and welfare of the Finnish population and the prevalence and risk factors of common health problems. It combined the protocols of the FINRISK surveys and the Health 2000 and 2011 surveys." [] {IAO:0000119="PMID:34706593", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38413574", IAO:0000119="PMID:35405960", IAO:0000119="PMID:32499541", IAO:0000119="PMID:34784307"}
subset: coho1:GWAS_subset
