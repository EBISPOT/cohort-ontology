relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Netherlands
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Tanzania {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10473835/fullTextXML", comment="Using a 92-plex proteomic panel based on a proximity extension assay technology, we compared the inflammatory proteome of healthy Tanzanians of African origin residing in Tanzania with that of healthy individuals of Western-European ancestry living in the Netherlands."}
relationship: coho:hasCohort coho:COHO_0000208 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10851559/fullTextXML", comment="Both cohorts are part of the Human Functional Genomics Project (wwww.humanfunctionalgenomics.org), aimed at identifying the genetic and non-genetic determinants of the immune response."}
relationship: coho:hasCohort coho:COHO_0000447 {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5787854/unicode", comment="The 500FG cohort consists of 534 healthy individuals of Caucasian origin and is part of the Human Functional Genomics Project (HFGP)."}
relationship: coho:hasCohort coho:COHO_0000502 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10473835/fullTextXML", comment="Both cohorts were enrolled within the Human Functional Genomics Project (https://www.humanfunctionalgenomics.org)."}
relationship: coho:hasCohort coho:COHO_0000631 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7320834/fullTextXML", comment="The 300-Obese (300-OB) cohort, one of the studies of the Human Functional Genomics Project, comprises a group of more than 300 individuals of Western-European ancestry with a body mass index (BMI) greater than or equal to greater than or equal to 27 kg/m2, aged between 55 and 80 years (12)."}
property_value: IAO:0000112 "PMID:27814508" xsd:string {dcterms:title="Host and Environmental Factors Influencing Individual Human Cytokine Responses.", xref="PMID:27814508", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5787854/unicode", comment="In three studies within the Human Functional Genomics Project we assessed the effect of environmental and non-genetic host factors, of the genetic make-up of the host, and of the intestinal microbiome, on the cytokine responses in humans."}

