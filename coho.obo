[Instance]
id: coho:COHO_0000528
name: ARGO study
def: "A Greek collection of more than 1,500 well-phenotyped patients with severe hip or knee osteoarthritis undergoing total joint replacement, recruited in hospitals of Athens (2015-2017) and Larissa together with healthy controls, set up to study the genetic architecture of osteoarthritis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://metadata.ega-archive.org/studies/EGAS00001000917", IAO:0000119="PMID:34450027", IAO:0000119="PMID:30470734"}
