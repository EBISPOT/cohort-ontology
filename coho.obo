property_value: coho:numberOfParticipants "2364" xsd:integer {IAO:0000116="participants of the cross-sectional study, randomly recruited from Berlin, Potsdam and surroundings", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5569105/fullTextXML", comment="The study included 2364 participants, who were randomly recruited from Berlin, Potsdam and surroundings, Germany."}
property_value: IAO:0000112 "PMID:28835639" xsd:string {dcterms:title="Dietary Fat Intake Modulates Effects of a Frequent ACE Gene Variant on Glucose Tolerance with association to Type 2 Diabetes.", xref="PMID:28835639", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5569105/fullTextXML", comment="Additionally, the cross-sectional Metabolic Syndrome Berlin Potsdam (MeSyBePo) study, which includes nutritional assessments, was analyzed to evaluate the influence of dietary fat intake on the association between ACE genotype and type 2 diabetes prevalence in order to complement and validate the analysis in the NUGAT study."}

[Instance]
id: coho:COHO_0002056
name: Metformin Response cohort
def: "A cohort of patients of Kaiser Permanente Northern California, United States, established with funding from GlaxoSmithKline in collaboration with the University of California San Francisco and Kaiser Permanente Northern California for a genome-wide association study of extreme responders to metformin: patients who met the study criteria were invited, gave blood samples for genotyping, and had their drug response taken from the electronic health record. Its participants with type 2 diabetes who had a sulfonylurea added to initial metformin therapy formed one of the data sets of the MetGen Plus and DIRECT genome-wide meta-analysis of glycaemic response to sulfonylureas." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://ndownloader.figshare.com/files/30717650", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09", IAO:0000119="PMID:34607834"}
synonym: "METRO" RELATED OMO:0003000 []
