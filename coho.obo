property_value: IAO:0000112 "PMID:40814824" xsd:string {dcterms:title="Associations between home gardening and obstructive sleep apnoea: role of behavioural factors in the COMmunity-based Behaviour and Attitude Study in Tuvalu (COMBAT).", xref="PMID:40814824", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40814824+AND+SRC%3AMED&format=json&resultType=core", comment="ConclusionsIn the COMBAT study, home gardening was associated with lower OSA probability among subgroups with specific lifestyle factors."}

[Instance]
id: coho:COHO_0002666
name: São Paulo Western Region Birth Cohort
def: "A prospective birth cohort of babies born at the University Hospital of the University of São Paulo School of Medicine between April 2012 and March 2014 to mothers living in the Butantã-Jaguaré area of São Paulo's Western Region, Brazil, followed to study how social and environmental factors, including toxic stress, affect early childhood development in a low-income urban setting." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:33952246", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ROC"}
