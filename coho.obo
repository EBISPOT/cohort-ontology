[Instance]
id: coho:COHO_0000062
name: EPIGEN
def: "A project combining population-based genomic data from northeastern, southeastern and southern Brazil to investigate ancestry, admixture, kinship, inbreeding and deleterious genetic variation, known as the EPIGEN Brazil Initiative." [] {dcterms:contributor="GPT-6 (OpenAI Codex), 2026-09", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09", IAO:0000119="PMID:26124090"}
subset: coho1:EGA_subset
subset: coho1:GWAS_subset
