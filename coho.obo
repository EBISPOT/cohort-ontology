property_value: coho:numberOfParticipants "2996" xsd:integer {IAO:0000116="actual enrolment registered for the TRACK-TBI study (NCT02119182), 2014-2018", xref="https://clinicaltrials.gov/api/v2/studies/NCT02119182", comment="\"enrollmentInfo\":{\"count\":2996,\"type\":\"ACTUAL\"}"}
property_value: IAO:0000112 "GCST90104613" xsd:string {dcterms:title="A genome-wide association study of outcome from traumatic brain injury.", xref="PMID:35301180", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8927841/supplementaryFiles", comment="The majority of patients in the US cohort were recruited between 2014 and 2018 to TRACK-TBI, a NIH-NINDS funded prospective multicenter study aimed at improving the characterization of TBI through the collection of clinical and genetic data, plasma biomarkers, as well as neuroimaging and other multidimensional outcomes."}

