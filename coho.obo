[Term]
id: HP:0001607
name: Subglottic stenosis
is_a: HP:0025423 ! Abnormal larynx morphology

[Term]
id: HP:0001622
name: Premature birth
def: "The birth of a baby of less than 37 weeks of gestational age." []
is_a: HP:0001197 ! Abnormality of prenatal development or birth

[Term]
id: HP:0001626
name: Abnormality of the cardiovascular system
def: "Any abnormality of the cardiovascular system." []
synonym: "Cardiovascular disease" RELATED layperson []
is_a: HP:0000118 ! Phenotypic abnormality

[Term]
id: HP:0001627
