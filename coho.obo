property_value: IAO:0000112 "GCST90668562" xsd:string {dcterms:title="A genome-wide association study in 10,000 individuals links plasma N-glycome to liver disease and anti-inflammatory proteins.", xref="PMID:40593539", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12218978/fullTextXML", comment="We conducted a multicenter study using data from seven studies – TwinsUK (N = 3918), EPIC-Potsdam (N = 2192), PainOmics (N = 1873), SOCCS (N = 1742), SABRE (N = 544), QMDiab (N = 325), and CEDAR (N = 170) with a total sample size N = 10,764."}

