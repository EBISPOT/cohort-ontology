property_value: IAO:0000112 "GCST90668017" xsd:string {dcterms:title="Genome-wide association study of childhood B-cell acute lymphoblastic leukemia reveals novel African ancestry-specific susceptibility loci.", xref="PMID:41125582", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12546916/fullTextXML", comment="In this study, we show differences in the genetic architecture of childhood B-ALL risk in African ancestral populations with an analysis of 4200 African American children, including 840 B-ALL cases, as a part of the ADMIxture and Risk of Acute Leukemia (ADMIRAL) Study."}

[Instance]
id: coho:COHO_0001274
name: Amish Family Osteoporosis Study
def: "A family study of the Old Order Amish of Lancaster County, Pennsylvania, United States, begun by the University of Maryland in 1997, which identified Amish adults with osteoporosis by bone mineral density screening and recruited their first-degree relatives aged 20 and over and their spouses, measuring bone density by dual-energy X-ray absorptiometry, to find genetic and clinical determinants of osteoporosis and bone health in large multigenerational families." [] {IAO:0000119="PMID:29739999", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:15899951", IAO:0000119="PMID:16939402"}
