[Instance]
id: coho:COHO_0001159
name: Chicago Health and Aging Project
def: "A population-based longitudinal cohort of Black and White adults aged 65 and over living in four adjacent neighbourhoods on the south side of Chicago, Illinois, recruited through a door-to-door census from 1993, with later age groups entered as residents turned 65. Participants were followed until 2012 with in-home interviews every three years and clinical evaluation of stratified random samples, to study common chronic conditions of late life, especially risk factors for Alzheimer's disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:14646025", IAO:0000119="PMID:39641998", IAO:0000119="PMID:40575494"}
subset: coho1:GWAS_subset
