[Instance]
id: coho:COHO_0001746
name: Fudan-Huashan Study
def: "A type 2 diabetes case-control sample of Han Chinese from Beijing or Shanghai, China, made up of people with type 2 diabetes and nondiabetic controls, that was one of the four sample sets of the stage 1 genome-wide scan of a 2013 genome-wide association study of type 2 diabetes in Chinese Hans." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22961080"}
synonym: "Fudan-Huashan" RELATED OMO:0003000 []
