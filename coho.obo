[Instance]
id: coho:COHO_0001628
name: Copenhagen Prostate Cancer Study
def: "A hospital-based case-control study of prostate cancer in Copenhagen, Denmark, whose cases are unselected men with pathologically confirmed, mainly clinically detected prostate cancer recruited at two Copenhagen University Hospital sites, Herlev Hospital in 2008–2011 (Copenhagen Prostate Cancer Study 1, CPCS1) and Rigshospitalet in 2010–2011 (Copenhagen Prostate Cancer Study 2, CPCS2), and whose controls are prostate-cancer-free men from the Copenhagen general population who took part in the Copenhagen City Heart Study or the Copenhagen General Population Study. Participants are white men of Danish descent who completed questionnaires and gave blood samples for DNA." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29321194", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2560/MediaObjects/41588_2013_BFng2560_MOESM4_ESM.pdf"}
synonym: "CPCS" RELATED OMO:0003000 []
