relationship: coho:isSubCohortOf coho:COHO_0000787 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf", comment="Subjects with prevalent or incident AF were identified from national registers as previously described14 , and cases with DNA were then matched in a 1:1 fashion to controls with DNA from the same cohort by sex, age (±1 year), and date of baseline exam (±1 year)."}
property_value: IAO:0000112 "PGS005200" xsd:string {dcterms:title="Polygenic prediction of body mass index and obesity through the life course and across ancestries.", xref="PMID:40691366"}
property_value: IAO:0000112 "PMID:29892015" xsd:string {dcterms:title="Polygenic prediction of body mass index and obesity through the life course and across ancestries.", xref="PMID:29892015", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf", comment="The Malmö Preventive Project (MPP) was a community-based disease prevention program including 33 346 inhabitants from the city of Malmö in Southern Sweden. Complete birth cohorts between 1921-1949 were invited, and the participation rate was 71%. Participants underwent screening between 1974 to 1992 for cardiovascular risk factors, alcohol abuse, and breast cancer. Between 2002-2006, surviving participants were invited to a reexamination which included blood sampling13 from which DNA has been extracted. Subjects with prevalent or incident AF were identified from national registers as previously described14 , and cases with DNA were then matched in a 1:1 fashion to controls with DNA from the same cohort by sex, age (±1 year), and date of baseline exam (±1 year)."}

[Instance]
id: coho:COHO_0002088
name: Malmö Preventive Project echo study
def: "An echocardiography study within the 2002-2006 re-examination of the Malmö Preventive Project in Malmö, Sweden, in which a subsample of re-examined participants, randomly selected from groups defined by glucometabolic status with impaired fasting glucose and diabetes oversampled, underwent echocardiography." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31860786"}
