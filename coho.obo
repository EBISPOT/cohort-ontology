property_value: IAO:0000112 "GCST90027859" xsd:string {dcterms:title="A polygenic risk score for asthma in a large racially diverse population.", xref="PMID:34459047", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8551047/unicode", comment="We computed a PRS for asthma for subjects across all racial/ethnic groups, using genome wide significant polymorphisms identified from the Trans-National Asthma Genetic Consortium (TAGC) from Demenais et al."}

[Instance]
id: coho:COHO_0001420
name: LITMUS Metacohort
def: "The part of the European NAFLD Registry, a prospective observational cohort of adults with non-alcoholic fatty liver disease sponsored by Newcastle University, made up of patients with biopsy-characterised NAFLD who were recruited at liver centres across Europe from 2010 to December 2017 in the FLIP, EPoS and HEPAmet studies of NAFLD pathogenesis, or came from earlier single-centre cohorts, and used by the IMI2 LITMUS project to evaluate non-invasive biomarkers. Patients recruited since 2018 form the Registry's separate LITMUS Study Cohort." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:36958367", IAO:0000119="PMID:38421999", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT04442334", IAO:0000119="PMID:33045403"}
