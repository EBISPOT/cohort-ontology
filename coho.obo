[Instance]
id: coho:COHO_0001563
name: Canadian screening study
def: "A Canadian lung cancer case–control sample, drawn as nested case–control sets for the OncoArray lung cancer genome-wide association project from three low-dose computed tomography screening programmes for smokers: the International Early Lung Cancer Action Program site in the Greater Toronto Area organised by Princess Margaret Hospital (enrolling since 2003), the PanCan study, which screened smokers aged 50 to 75 in eight cities across Canada from 2008 to 2011, and the screening programme of the British Columbia Cancer Agency (BCCA), which enrolled heavy smokers from 1990 to 2007." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28604730", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf"}
