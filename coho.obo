property_value: IAO:0000112 "PMID:29273806" xsd:string {dcterms:title="Multiancestry association study identifies new asthma risk loci that colocalize with immune-cell enhancer marks.", xref="PMID:29273806", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf", comment="The Canadian Asthma Primary Prevention Study (CAPPS4 ) was initiated in 1995 to assess the effectiveness of a multifaceted intervention program on the primary prevention of asthma in high‐risk infants."}

[Instance]
id: coho:COHO_0001566
name: Carotid Atherosclerosis Progression Study
def: "A community-based prospective cohort study in Germany in which adults aged about 19 to 90, volunteers from among the members of a German primary health-care scheme, had vascular risk factors and carotid intima–media thickness measured by ultrasound at baseline and again after about three years, and were followed for about ten years for myocardial infarction, stroke, transient ischaemic attack and death, to study the progression of early carotid atherosclerosis and its value in predicting vascular events." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:16339465", IAO:0000119="PMID:17332447", IAO:0000119="PMID:20431077", IAO:0000119="PMID:22617119", IAO:0000119="PMID:15243147"}
