[Instance]
id: coho:COHO_0001292
name: Brigham and Women's Rheumatoid Arthritis Sequential Study
def: "A single-centre prospective observational registry cohort of adults with rheumatoid arthritis diagnosed by a rheumatologist, enrolled from March 2003 at the Brigham and Women's Hospital Arthritis Center in Boston, Massachusetts, United States. Participants are followed with annual visits, semi-annual questionnaires and stored blood samples, to find biomarkers that predict drug response, toxicity, disease activity and prognosis and to describe the natural history of treated rheumatoid arthritis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31002669", IAO:0000119="PMID:33002337", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT01793103"}
subset: coho1:GWAS_subset
