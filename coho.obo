[Instance]
id: coho:COHO_0000823
name: Johannesburg Cancer Study
def: "A cancer case-control study that enrolled 24,971 Black patients with incident, mostly histologically proven cancers of any type in Johannesburg, South Africa, between 1995 and 2016, collecting questionnaire data and serum and whole-blood samples and using patients with cancers unrelated to the exposure of interest as controls, to study lifestyle and infection (particularly HIV) risk factors for cancer; the ERICA-SA project uses its data and samples to study lifestyle, infection and genetic susceptibility to cancer." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32169796", IAO:0000119="https://www.samrc.ac.za/intramural-research-units/evolving-risk-factors-cancers-african-populations-erica-sa"}
subset: coho1:GWAS_subset
synonym: "ERICA-SA" RELATED OMO:0003000 []
synonym: "JCS" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Africa
relationship: coho:has_data_collection_location http://dbpedia.org/resource/South_Africa {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:32169796%20AND%20SRC:MED&resultType=core&format=json", comment="The Johannesburg Cancer Study (JCS) aims were to examine whether cancer risk factors identified in Western countries applied to black patients in Johannesburg, South Africa and to understand the impact of HIV on cancer risk, with a view to identifying previously unrecognised HIV associated cancers."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Southern_Africa
