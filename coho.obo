relationship: coho:has_data_collection_location http://dbpedia.org/resource/Costa_Rica {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4256696/fullTextXML", comment="The Infants’ Environmental Health Study [Infantes y Salud Ambiental (ISA)] is a prospective community-based birth cohort study in Matina County, Limón, Costa Rica, aimed at examining possible effects of prenatal pesticide and manganese exposure on children’s growth and neurodevelopment."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
property_value: coho:numberOfParticipants "451" xsd:integer {IAO:0000116="pregnant women enrolled (2010-2011)", xref="PMID:25198283", comment="We enrolled 451 pregnant women from Matina County, Costa Rica, which has large-scale banana production."}
property_value: IAO:0000112 "PMID:29847083" xsd:string {dcterms:title="Prenatal Mancozeb Exposure, Excess Manganese, and Neurodevelopment at 1 Year of Age in the Infants' Environmental Health (ISA) Study.", xref="PMID:29847083", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6072008/fullTextXML", comment="We measured urinary ETU, hair Mn, and blood Mn concentrations in samples collected 1–3 times during pregnancy from mothers enrolled in the Infants’ Environmental Health (ISA) study."}

[Instance]
id: coho:COHO_0002653
name: Multi-Partner Consortium to Expand Dementia Research in Latin America
def: "A multicentre cohort of people with Alzheimer's disease or frontotemporal dementia and cognitively unimpaired controls, recruited at memory clinics and other clinical and community sites in Argentina, Brazil, Chile, Colombia, Mexico and Peru by the Multi-Partner Consortium to Expand Dementia Research in Latin America with the University of California San Francisco Memory and Aging Center, and assessed under a harmonised protocol (clinical, cognitive, genetic, neuroimaging and EEG data, and a questionnaire on lifelong social exposures) to study how genetic, social and environmental factors shape dementia and brain health in Latin America compared with the United States." [] {IAO:0000119="PMID:33776890 ", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119=" PMID:42251497 ", IAO:0000119=" https://red-lat.com/en-the-project/", IAO:0000119=" PMID:41586258 "}
