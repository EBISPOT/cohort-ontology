property_value: IAO:0000112 "PMID:35195259" xsd:string {dcterms:title="A polygenic risk score improves risk stratification of coronary artery disease: a large-scale prospective Chinese cohort study.", xref="PMID:35195259", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9076396/fullTextXML", comment="The validation cohorts were derived from three cohorts in the China-PAR project, including the International Collaborative Study of Cardiovascular Disease in Asia (InterASIA), the China Multi-Center Collaborative Study of Cardiovascular Epidemiology (ChinaMUCA-1998), and Community Intervention of Metabolic Syndrome in China and Chinese Family Health Study (CIMIC)."}

[Instance]
id: coho:COHO_0001589
name: Chingford 1000 Women Study
def: "A prospective population-based cohort of women aged 45–64 registered with a large general practice in Chingford, North-East London, United Kingdom, recruited in 1988–1989 to study osteoarthritis, osteoporosis and other musculoskeletal disease and assessed annually for over 20 years (to 2010) with clinical examinations, nurse-administered questionnaires, hand and knee radiographs and bone density measurements; deaths are traced through the Office for National Statistics." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32005116", IAO:0000119="PMID:34288584", IAO:0000119="PMID:34537387", IAO:0000119="PMID:38637130"}
