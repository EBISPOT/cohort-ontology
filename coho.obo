property_value: coho:numberOfParticipants "5492" xsd:integer {IAO:0000116="women enrolled September 2009 - November 2018 (6478 pregnancies)", xref="PMID:31641004", comment="From September 2009 to November 2018, the BASIC study at Uppsala University Hospital, Sweden, has enrolled 5492 women, in 6478 pregnancies, of which 46.3% first-time pregnancies and with an average age of 31.5 years."}
property_value: IAO:0000112 "GCST90726344" xsd:string {dcterms:title="Genome-wide association analyses identify distinct genetic architectures for early-onset and late-onset depression.", xref="PMID:41233554", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12695632/supplementaryFiles", comment="BASIC: The Biology, Affect, Stress, Imaging and Cognition (BASIC) study recruited 5,492 pregnant women from the Uppsala Hospital University (Uppsala, Sweden) and followed them and their children from pregnancy to one year postpartum between 2012 and 201911 ."}

[Instance]
id: coho:COHO_0001288
name: Baltimore Breast Cancer Study
def: "A case-control study of breast cancer in the greater Baltimore area, Maryland, United States, in which incident breast cancer cases and controls frequency-matched to them on race and age were recruited from February 1993 to August 2003 at six hospitals, including the University of Maryland Medical Center and the Baltimore Veterans Affairs Medical Center, to identify and characterise markers of disease aggressiveness and poor outcome." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf", IAO:0000119="PMID:22357627"}
