relationship: coho:hasCohort coho:COHO_0001812 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3615132/", comment="This study describes the demographic and clinical characteristics of the largest series of non-syndromic glioma families ascertained from 14 centres in the United States (US), Europe and Israel as part of the Gliogene Consortium."}
