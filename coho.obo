relationship: coho:isSubCohortOf coho:COHO_0000649 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4145406/fullTextXML", comment="These family data were obtained from two studies: the San Antonio Family Heart Study (SAFHS) and the San Antonio Family Diabetes/Gallbladder Study (SAFDGS), which are together referred to as the San Antonio Family Studies (SAFS)."}
property_value: coho:numberOfParticipants "1236" xsd:integer {IAO:0000116="Relatives of randomly ascertained probands and spouses in the original SAFHS report", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8901667+AND+SRC%3AMED&format=json&resultType=core", comment="Members of 42 extended families were studied, including 1236 first-, second-, and third-degree relatives of randomly ascertained probands and their spouses."}
property_value: IAO:0000112 "PGS005354" xsd:string {dcterms:title="Multi-ancestry polygenic risk scores for the prediction of type 2 diabetes and complications in diverse ancestries.", xref="PMID:40778152"}
property_value: IAO:0000112 "PMID:25519314" xsd:string {dcterms:title="Multi-ancestry polygenic risk scores for the prediction of type 2 diabetes and complications in diverse ancestries.", xref="PMID:25519314", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC4145406/", comment="gene expression measures from the San Antonio Family Heart Study (not distributed as part of the GAW18 data) were used to identify genes whose mRNA levels were correlated with blood pressure."}

[Instance]
id: coho:COHO_0002338
name: Study of Asthma, Genes and the Environment
def: "A population-based cohort of children born in the province of Manitoba, Canada, in 1995, whose families were surveyed in 2002 about the child's health and home environment, with linkage to the child's health care records, and from which children with asthma or allergy and a random sample of children with neither were invited to a nested case-control study of the early-life genetic and environmental origins of asthma. It is one of the Canadian cohorts of the ALLERGEN consortium." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf"}
