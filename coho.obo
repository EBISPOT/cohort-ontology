relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
property_value: coho:numberOfParticipants "2016" xsd:integer {IAO:0000116="women enrolled 1990-1993 (randomised and non-randomised arms)", xref="PMID:23048011", comment="Between 1990 and 1993, 2016 women were enrolled in a prospectively followed cohort."}
property_value: IAO:0000112 "PMID:10340280" xsd:string {dcterms:title="The Danish Osteoporosis Prevention Study (DOPS): project design and inclusion of 2000 normal perimenopausal women.", xref="PMID:10340280", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10340280+AND+SRC%3AMED&format=json&resultType=core", comment="In 1990 we initiated a 20 year, partly randomised study (Danish Osteoporosis Prevention Study, DOPS) in order to (a) evaluate clinical, biochemical and osteodensitometric variables as predictors of low bone mass and future osteoporotic fractures, and (b) test the hypothesis, that hormone replacement therapy (HRT) initiated shortly after menopause reduces the risk of later osteoporotic fractures."}

[Instance]
id: coho:COHO_0001612
name: Diseases of the Ovary and their Evaluation Study
def: "A population-based case–control study of epithelial ovarian cancer in western Washington State, United States, run from Seattle with funding from the US National Cancer Institute, that enrolled women aged 35–74 diagnosed in 2002–2009 in a 13-county area, identified through the region's SEER cancer registry, together with controls from the same area identified by random-digit dialling, and collected in-person interviews and, from cases, tumour tissue." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19127255", IAO:0000119="PMID:36826816", IAO:0000119="PMID:23065074", IAO:0000119="PMID:42365137", IAO:0000119="PMID:19240718"}
