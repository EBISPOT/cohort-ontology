property_value: coho:numberOfParticipants "18624" xsd:integer {IAO:0000116="patients with acute coronary syndrome randomised (2008)", xref="PMID:19717846", comment="In this multicenter, double-blind, randomized trial, we compared ticagrelor (180-mg loading dose, 90 mg twice daily thereafter) and clopidogrel (300-to-600-mg loading dose, 75 mg daily thereafter) for the prevention of cardiovascular events in 18,624 patients admitted to the hospital with an acute coronary syndrome, with or without ST-segment elevation."}
property_value: IAO:0000112 "GCST90277419" xsd:string {dcterms:title="Vascular endothelial growth factor-D plasma levels and VEGFD genetic variants are independently associated with outcomes in patients with cardiovascular disease.", xref="PMID:36869765", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36869765+AND+SRC%3AMED&format=json&resultType=core", comment="Levels of VEGF biomarkers, including bFGF, Flt-1, KDR (VEGFR2), PlGF, Tie-2, VEGF-A, VEGF-C, and VEGF-D, were measured in the PLATO ACS cohort (n = 2091, discovery cohort)."}

[Instance]
id: coho:COHO_0001391
name: Pustular Psoriasis, Elucidating Underlying Mechanisms
def: "A UK research study sponsored by Guy's and St Thomas' NHS Foundation Trust and run as the sister mechanistic study of the APRICOT trial of anakinra, which recruited people with pustular psoriasis through specialist dermatology centres across the UK, together with disease controls, healthy volunteers and patients' relatives, and collected blood and optional skin and hair samples to identify genes, immune pathways and treatment responses involved in pustular psoriasis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:30036598", IAO:0000119="https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/plum/", IAO:0000119="PMID:32936291"}
subset: coho1:GWAS_subset
synonym: "PLUM" RELATED OMO:0003000 []
synonym: "Pustular psoriasis: eLucidating Underlying Mechanisms" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32936291+AND+SRC%3AMED&format=json&resultType=core", comment="A UK data set including 203 patients was obtained through the Anakinra in Pustular Psoriasis, Response in a Controlled Trial (2016-2019) and its sister research study Pustular Psoriasis, Elucidating Underlying Mechanisms (2016-2020)."}
property_value: coho:numberOfParticipants "161" xsd:integer {IAO:0000116="patients with palmoplantar pustulosis enrolled through PLUM 2016-2020 (analysed subset only)", xref="PMID:32936291", comment="The remaining 161 patients were enrolled between 2016 and 2020 through the sister research study Pustular Psoriasis, Elucidating Underlying Mechanisms (PLUM)."}
property_value: IAO:0000112 "GCST90624455" xsd:string {dcterms:title="A genome-wide meta-analysis of palmoplantar pustulosis implicates TH2 responses and cigarette smoking in disease pathogenesis.", xref="PMID:38815935", xref="https://www.medrxiv.org/content/medrxiv/early/2024/01/17/2024.01.17.24301406.full.pdf", comment="The UK dataset included 288 affected individuals of European descent, who were recruited in specialist dermatology centers as part of the APRICOT clinical trial4 and its sister study PLUM."}

[Instance]
id: coho:COHO_0001392
name: Primary Open-Angle African American Glaucoma Genetics Study
def: "A case-control genetic study of primary open-angle glaucoma led by the University of Pennsylvania's Scheie Eye Institute, which since July 2010 has enrolled self-identified Black adults (African American, African descent or African Caribbean) aged 35 or over from the Philadelphia region, mainly from University of Pennsylvania eye clinics and also through community screenings, two other Philadelphia ophthalmology practices and the Penn Medicine Biobank, with glaucoma specialists classifying them as cases, controls or glaucoma suspects, to identify genetic and clinical risk factors for the disease." [] {IAO:0000119="PMID:25576993", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:40782885", IAO:0000119="PMID:28705151"}
subset: coho1:GWAS_subset
synonym: "POAAGG" RELATED OMO:0003000 []
synonym: "Primary Open-Angle African American Glaucoma Genetics study" RELATED []
synonym: "primary open-angle African American glaucoma genetics study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40782885+AND+SRC%3AMED&format=json&resultType=core", comment="Participants were recruited from ophthalmology clinics in Philadelphia between July 2010 and August 2024."}
property_value: coho:numberOfParticipants "10255" xsd:integer {IAO:0000116="individuals of African descent recruited (cases, controls and glaucoma suspects), 2024", xref="PMID:40782885", comment="The Primary Open-Angle African American Glaucoma Genetics (POAAGG) study recruited 10,255 individuals of African descent from the Philadelphia area, representing the largest single-city study of POAG nationwide."}
property_value: IAO:0000112 "GCST90455614" xsd:string {dcterms:title="A multi-cohort genome-wide association study in African ancestry individuals reveals risk loci for primary open-angle glaucoma.", xref="PMID:38242088", xref="https://europepmc.org/api/getPdf?pmcid=PMC11844349", comment="In brief, the POAAGG study population consists of self-identified Blacks (African American, African descent, or African Caribbean), aged 35 years or older, recruited from the Philadelphia area."}

[Instance]
id: coho:COHO_0001393
name: Project MinE
def: "An international collaboration of amyotrophic lateral sclerosis research groups from about 16 countries, coordinated from the ALS Centre Netherlands at University Medical Center Utrecht and begun with a pilot in Dutch patients, in which people with ALS and matched controls are recruited through the groups' ALS clinics under a common protocol with a standardised core clinical data set and their whole genomes sequenced, to identify and fine-map genetic risk loci for ALS and share the data with researchers." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://projectmine.com/about/", IAO:0000119="PMID:29955173", IAO:0000119="PMID:36589292"}
subset: coho1:GWAS_subset
