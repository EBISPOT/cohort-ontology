[Instance]
id: coho:COHO_0001502
name: Asthma UK Genetics of Severe Asthma
def: "A genetic study of severe asthma in the United Kingdom, supported by Asthma UK, which recruited people of European ancestry with severe asthma (Global Initiative for Asthma classes 3–5) at UK centres and compared them in genome-wide association studies with controls without asthma or wheeze, to identify genetic determinants of severe asthma and whether they differ from those of mild to moderate asthma." [] {IAO:0000119="PMID:22561531", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:20860503"}
synonym: "AUGOSA" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://thorax.bmj.com/content/67/9/762", comment="Only subjects in classes 3–5 were included, recruited across UK-based centres."}
property_value: coho:numberOfCases "1026" xsd:integer {IAO:0000116="severe asthma cases genotyped (discovery cohort), 2012", xref="https://doi.org/10.1136/thoraxjnl-2011-201262", comment="We genotyped 1026 individuals of European ancestry with severe asthma based on the Global Initiative for Asthma (GINA) criteria.18 Only subjects in classes 3–5 were included, recruited across UK-based centres."}
property_value: coho:numberOfParticipants "1026" xsd:integer {IAO:0000116="severe asthma cases genotyped (discovery cohort), 2012", xref="https://doi.org/10.1136/thoraxjnl-2011-201262", comment="We genotyped 1026 individuals of European ancestry with severe asthma based on the Global Initiative for Asthma (GINA) criteria.18 Only subjects in classes 3–5 were included, recruited across UK-based centres."}
property_value: IAO:0000112 "PMID:20860503" xsd:string {dcterms:title="A large-scale, consortium-based genomewide association study of asthma.", xref="PMID:20860503", xref="https://europepmc.org/api/getPdf?pmcid=PMC4260321", comment="We did find a suggestive association with rs1837253 on chromosome 5, situated within the TSLP gene, among patients with severe asthma in the SEVERE study (P = 3×10−6; odds ratio, 0.56), but this association was not replicated among patients with severe asthma in the AUGOSA (Asthma UK Genetics of Severe Asthma) study."}

[Instance]
id: coho:COHO_0001503
name: Amsterdam UMC dilated cardiomyopathy GWAS cohort
def: "A case–control dataset for genome-wide association studies of dilated cardiomyopathy assembled at Amsterdam UMC, the Netherlands. Its cases are adult index patients referred by secondary or tertiary cardiologists to Amsterdam UMC for genetic testing for dilated cardiomyopathy, with the diagnosis confirmed from the medical chart and a left ventricular ejection fraction below 50%, and its controls are unrelated participants of the Netherlands Twin Register." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:39572784"}
synonym: "Amsterdam UMC cohort" RELATED []
synonym: "AUMC" RELATED OMO:0003000 []
synonym: "AUMC_DCM" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Netherlands {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11631763/fullTextXML", comment="The clinical DCM datasets included (1) a published GWAS by Garnier et al. that enrolled 2,651 DCM cases from France, Germany, Italy, the UK and the United States8; (2) a reanalyzed dataset of 909 DCM cases from Heidelberg, Germany10 (Supplementary Note) and (3) a new dataset of Dutch DCM cases from Amsterdam UMC."}
property_value: coho:numberOfCases "978" xsd:integer {IAO:0000116="DCM cases and NTR controls passing genotype QC (2024)", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01975-5/MediaObjects/41588_2024_1975_MOESM1_ESM.pdf", comment="Following QC procedures, the genome-wide data (the non-pruned data) for the 978 high-quality cases and 7207 high-quality controls were imputed to the TOPMed imputation panel on the Michigan Imputation Server."}
property_value: coho:numberOfControls "7207" xsd:integer {IAO:0000116="DCM cases and NTR controls passing genotype QC (2024)", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01975-5/MediaObjects/41588_2024_1975_MOESM1_ESM.pdf", comment="Following QC procedures, the genome-wide data (the non-pruned data) for the 978 high-quality cases and 7207 high-quality controls were imputed to the TOPMed imputation panel on the Michigan Imputation Server."}
property_value: IAO:0000112 "PMID:39572784" xsd:string {dcterms:title="Genome-wide association study reveals mechanisms underlying dilated cardiomyopathy and myocardial resilience.", xref="PMID:39572784", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11631763/fullTextXML", comment="The Amsterdam cohort comprised DCM patients referred for genetic testing at Amsterdam UMC, who underwent chart review for DCM diagnosis and had evidence of hypocontractility on imaging; 978 DCM cases passed all genotype quality-control criteria, of which 783 homogeneous cases of patients of European ancestry were included in GWAS (Supplementary Note and Supplementary Table 3)."}

[Instance]
id: coho:COHO_0001504
name: Austrian Diabetic Nephropathy Study
def: "A clinic-based cohort study of patients with type 1 diabetes in the state of Salzburg, Austria, initiated in 2012 as the Austrian study of the International Diabetic Nephropathy Consortium (InterDiane), which follows the protocol of the Finnish Diabetic Nephropathy Study to identify risk factors for diabetic nephropathy and other chronic complications of type 1 diabetes. Patients are recruited consecutively at the outpatient departments of Paracelsus Medical University Hospital Salzburg and Diakonissen-Wehrle Hospital Salzburg, with clinical data drawn mainly from the Type 1 diabetes Registry of the state of Salzburg, and are re-examined every 1 to 1.5 years." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://cdn-links.lww.com/permalink/jsn/c/jsn_30_10_2022_12_07_salem_2019030218_sdc1.pdf"}
synonym: "AusDiane" RELATED OMO:0003000 []
synonym: "Austrian Diabetes Nephropathy Study" RELATED []
