[Instance]
id: coho:COHO_0000612
name: Singapore Multi-Ethnic Cohort
def: "A population-based cohort of 14,465 Singapore citizens and permanent residents of Chinese, Malay and Indian ethnicity aged 21 years and older, recruited in 2004–2010 mainly from the Singapore Prospective Study Program and the Singapore Cardiovascular Cohort Study, with additional recruitment oversampling Malays and Indians, to study chronic disease in a multi-ethnic Asian population." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31110091", IAO:0000119="PMID:29452397"}
