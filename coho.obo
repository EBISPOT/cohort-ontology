is_a: MONDO:0005070 ! neoplasm

[Term]
id: MONDO:0005399
name: venous thromboembolism
def: "Occlusion of the lumen of a vein by a thrombus that has migrated from a distal site via the blood stream." []
is_a: MONDO:0005385 ! vascular disorder

[Term]
id: MONDO:0005401
name: colonic neoplasm
def: "A benign or malignant neoplasm that affects the colon. Representative examples of benign neoplasms include lipoma and leiomyoma. Representative examples of malignant neoplasms include carcinoma, lymphoma, and sarcoma. Colonic adenomas always exhibit epithelial dysplasia and are considered premalignant neoplasms." []
is_a: MONDO:0003409 ! colonic disorder
is_a: MONDO:0005335 ! colorectal neoplasm

[Term]
id: MONDO:0005402
