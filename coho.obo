[Instance]
id: coho:COHO_0002651
name: Programming Research in Obesity, Growth, Environment and Social Stressors
def: "A prospective birth cohort of pregnant women receiving prenatal care through the Mexican Social Security Institute (IMSS) in Mexico City, recruited from July 2007 to February 2010, and their children, run by the Icahn School of Medicine at Mount Sinai, Harvard University and Mexico's National Institute of Public Health, and followed to study how prenatal and early-life exposure to metals, air pollution and phthalates, together with chronic psychosocial stress, affects child neurodevelopment, growth and metabolic health." [] {IAO:0000119=" https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PROGRESS", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119=" https://mountsinaiexposomics.org/progress/ ", IAO:0000119="PMID:42225914 "}
subset: coho1:GEC_subset
