relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
property_value: coho:numberOfParticipants "2400" xsd:integer {IAO:0000116="participants (mother-newborn pairs) enrolled since February 2010, stated as more than 2400", xref="https://limburgsgeboortecohort.be/", comment="De studie werd opgestart in februari 2010 in samenwerking met Ziekenhuis Oost-Limburg en kent momenteel al meer dan 2400 deelnemers!"}
property_value: IAO:0000112 "MTBLS1684" xsd:string {dcterms:title="A multi-omic analysis of birthweight in newborn cord blood reveals new underlying mechanisms related to cholesterol metabolism.", xref="PMID:32553738", xref="https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS1684", comment="Since the results of the omics integration indicated the central role of cholesterol metabolism, we explored the association of cholesterol levels in cord blood with birthweight in the ENVIRONAGE cohort (n=1,097), finding that higher birthweight was associated with increased high-density lipoprotein cholesterol and that high-density lipoprotein cholesterol was lower in small versus large for gestational age newborns."}
property_value: IAO:0000112 "PMID:41196593" xsd:string {dcterms:title="Cord Blood Appetite Hormones and Early-Life Growth and Childhood Adiposity in the ENVIRONAGE Cohort.", xref="PMID:41196593", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12593129/fullTextXML", comment="This prospective birth cohort study was conducted within the Environmental Influence on Early Aging (ENVIRONAGE) birth cohort, with follow-up data collected at 4 to 6 years of age."}
property_value: seeAlso https://limburgsgeboortecohort.be/

[Instance]
id: coho:COHO_0002604
name: Finnish HPV vaccination cohort
def: "The participants of a community-randomised phase IV trial in which early adolescents born 1992–1995 and resident in 33 Finnish communities were invited in 2007–2009 and assigned by community to gender-neutral HPV16/18 vaccination, HPV16/18 vaccination of girls with hepatitis B vaccination of boys, or gender-neutral hepatitis B vaccination, and followed up with cervicovaginal sampling from 18.5 years of age, to compare the overall and herd effects of gender-neutral and girls-only HPV vaccination." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29055031", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/HPV", IAO:0000119="PMID:25593103"}
