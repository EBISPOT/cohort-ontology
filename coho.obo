property_value: IAO:0000112 "PMID:41159539" xsd:string {dcterms:title="\"I Put a Lot of Emphasis on Work Because I Want to Keep My Job\": A Population-Based Interview Study of Long Covid and Employment Changes in England.", xref="PMID:41159539", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41159539+AND+SRC%3AMED&format=json&resultType=core", comment="We conducted a qualitative analysis of data from the Real-time Assessment of Community Transmission (REACT) Study."}

[Instance]
id: coho:COHO_0002663
name: 3xG study
def: "A local birth cohort of children born between 2010 and 2015 to mothers living in the neighbouring rural municipalities of Dessel, Mol and Retie in Flanders, Belgium, run by the Flemish Institute for Technological Research (VITO) and co-financed by the Belgian radioactive waste agency and local consultation bodies, that follows the children with human biomonitoring and questionnaires, alongside the municipalities' disease and mortality registers, to monitor the effects of environmental and lifestyle exposures on health." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://studie3xg.be/nl", IAO:0000119="PMID:36976969"}
