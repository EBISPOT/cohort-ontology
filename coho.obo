[Instance]
id: coho:COHO_0000379
name: Stanford Alzheimer's Disease Research Center
def: "A longitudinal observational cohort of volunteers followed by the Stanford Alzheimer's Disease Research Center (the Iqbal Farrukh and Asad Jamal Stanford ADRC) at Stanford University, California, one of the US National Institute on Aging-funded Alzheimer's Disease Research Centers, comprising people with Alzheimer disease, dementia with Lewy bodies, Parkinson disease or mild cognitive impairment and cognitively unimpaired older adults, who undergo standardized clinical, neurological and neuropsychological assessments following National Alzheimer's Coordinating Center procedures and give blood and cerebrospinal fluid used in proteomic and genetic studies, in line with the center's focus on Alzheimer disease and Lewy body disorders." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38172904", IAO:0000119="https://med.stanford.edu/adrc.html", IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-024-01972-8/MediaObjects/41588_2024_1972_MOESM1_ESM.pdf"}
subset: coho1:GWAS_subset
