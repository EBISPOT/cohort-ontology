relationship: coho:has_data_collection_location http://dbpedia.org/resource/China {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12910095/fullTextXML", comment="The population-based cross-sectional community study, which was carried out in conjunction with the elderly medical examination program, recruited 2287 adults (including males and females, aged 60 years and older) from Dapuqiao Street, Huangpu District, Shanghai, China, from March 2019 to November 2019."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
property_value: coho:numberOfParticipants "2287" xsd:integer {IAO:0000116="eligible participants of wave 1 (2019)", xref="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SDACS", comment="Data were collected across three examination waves in 2019, 2022, and 2024, with 2287, 1518, and 3554 eligible participants included after exclusions, respectively."}
property_value: IAO:0000112 "PMID:41606232" xsd:string {dcterms:title="The association of Alzheimer's disease-related SNPs with mild cognitive impairment susceptibility in the Chinese population.", xref="PMID:41606232", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12910095/fullTextXML", comment="The population-based cross-sectional community study, which was carried out in conjunction with the elderly medical examination program, recruited 2287 adults (including males and females, aged 60 years and older) from Dapuqiao Street, Huangpu District, Shanghai, China, from March 2019 to November 2019."}

[Instance]
id: coho:COHO_0002644
name: Survey of Health, Ageing and Retirement in Europe
def: "A multidisciplinary, cross-nationally harmonised longitudinal panel survey of people aged 50 and older, begun in 2004 in eleven European countries and Israel and extended to all EU member states and Switzerland, run as a European Research Infrastructure Consortium (SHARE-ERIC, coordinated from Munich and later Berlin), that collects data on health, biomarkers, cognition, employment, socio-economic status and social and family networks to study the effects of health, social, economic and environmental policies over the life course." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:23778574", IAO:0000119="https://share-eric.eu/data/data-documentation/waves-overview/wave-7", IAO:0000119="https://share-eric.eu/data/data-documentation/waves-overview/wave-1", IAO:0000119="https://share-eric.eu/infrastructure"}
