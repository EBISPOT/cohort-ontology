[Instance]
id: coho:COHO_0001494
name: Aarhus Osteoporosis Study
def: "A case–control study of osteoporosis at Aarhus University Hospital, Denmark, whose cases are osteoporotic men and women with vertebral fractures and low bone mineral density and whose controls are normal individuals, assessed with dual-energy X-ray absorptiometry, radiographs and bone turnover markers and genotyped for candidate-gene studies and for replication of genome-wide association findings on bone mineral density and fracture. It took part in the GENOMOS consortium and in the GEFOS meta-analysis of bone mineral density and fracture." [] {IAO:0000119="http://www.gefos.org/?q=content/aarhus-osteoporosis-study-0", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:16475872", IAO:0000119="PMID:17205326", IAO:0000119="PMID:24516880", IAO:0000119="PMID:22504420"}
synonym: "AROS" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Denmark {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21104233+AND+SRC%3AMED&format=json&resultType=core", comment="We examined the effect of ALOX12 polymorphisms on BMD and the risk of fractures in two Danish cohorts: AROS, a case-control population comprising 809 individuals and DOPS, a population comprising 1,716 perimenopausal women allocated to hormone therapy or not at baseline and followed for up to 10 years."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
property_value: coho:numberOfCases "462" xsd:integer {IAO:0000116="osteoporotic cases and normal controls", xref="https://doi.org/10.1007/s00223-006-0059-6", comment="We investigated if the polymorphisms in the IL-1α gene affect the risk of osteoporotic fractures, bone mineral density (BMD), and bone turnover in 462 osteoporotic patients and 336 normal controls."}
property_value: coho:numberOfControls "336" xsd:integer {IAO:0000116="osteoporotic cases and normal controls", xref="https://doi.org/10.1007/s00223-006-0059-6", comment="We investigated if the polymorphisms in the IL-1α gene affect the risk of osteoporotic fractures, bone mineral density (BMD), and bone turnover in 462 osteoporotic patients and 336 normal controls."}
property_value: IAO:0000112 "PMID:21104233" xsd:string {dcterms:title="Polymorphisms in the ALOX12 gene and osteoporosis.", xref="PMID:21104233", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21104233+AND+SRC%3AMED&format=json&resultType=core", comment="We examined the effect of ALOX12 polymorphisms on BMD and the risk of fractures in two Danish cohorts: AROS, a case-control population comprising 809 individuals and DOPS, a population comprising 1,716 perimenopausal women allocated to hormone therapy or not at baseline and followed for up to 10 years."}

[Instance]
id: coho:COHO_0001495
name: Amsterdam Resuscitation Studies
def: "An ongoing prospective, community-based registry, set up in June 2005 and run from the Academic Medical Center in Amsterdam, of all out-of-hospital cardiac arrests with a resuscitation attempt by emergency medical services in the province of North Holland, the Netherlands, which collects resuscitation and ECG data, outcomes, medical history from hospitals and general practitioners, medication use from community pharmacies and, since July 2007, DNA from patients with documented ventricular tachycardia or fibrillation. It studies the outcome and the clinical, pharmacological, environmental and genetic determinants of out-of-hospital cardiac arrest, taking controls from pharmacy and general-practice databases for case–control analyses." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:25332818", IAO:0000119="https://pure.amsterdamumc.nl/en/datasets/arrest-amsterdam-resuscitation-studies/"}
synonym: "AmsteRdam REsuscitation STudies" RELATED []
synonym: "AmsteRdam Resuscitation Studies" RELATED []
synonym: "ARREST" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Netherlands {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3419243/fullTextXML", comment="ARREST is a prospective, community-based study aimed at establishing the genetic and clinical determinants of SCA in the population of a contiguous region (urban and rural communities, ∼2.4 million inhabitants) of the Netherlands."}
property_value: coho:numberOfParticipants "3005" xsd:integer {IAO:0000116="OHCA cases with VT/VF and DNA collected, July 2007-January 2014 (DNA sub-collection only)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC4189338/", comment="We included 3005 cases and continue to collect DNA samples at the same rate."}
property_value: IAO:0000112 "PMID:39462804" xsd:string {dcterms:title="Association Between Delay to First Shock and Successful First-Shock Ventricular Fibrillation Termination in Patients With Witnessed Out-of-Hospital Cardiac Arrest.", xref="PMID:39462804", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39462804+AND+SRC%3AMED&format=json&resultType=core", comment="Patients with a witnessed out-of-hospital cardiac arrest and ventricular fibrillation (VF) as an initial rhythm were included using the prospective ARREST registry (Amsterdam Resuscitation Studies)."}

[Instance]
id: coho:COHO_0001496
name: Alzheimer's Research Trust Collaboration
def: "A collaboration of United Kingdom Alzheimer's disease research groups at the Universities of Nottingham, Manchester, Southampton and Bristol, Queen's University Belfast and the Oxford Project to Investigate Memory and Ageing, funded by the Alzheimer's Research Trust (renamed Alzheimer's Research UK, after which the collaboration is called the ARUK Consortium), that pooled DNA from people with probable or post-mortem-confirmed Alzheimer's disease and from elderly controls into a DNA bank hosted at the University of Nottingham. Its cases and controls formed one of the sample collections of the GERAD genome-wide association study of Alzheimer's disease." [] {IAO:0000119="PMID:23459933", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:23990795", IAO:0000119="PMID:32274467", IAO:0000119="PMID:29675612", IAO:0000119="PMID:19734902"}
