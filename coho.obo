property_value: coho:numberOfControls "3206" xsd:integer {IAO:0000116="SHEEP first-MI cases and controls included in 1992-1994", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2465514/", comment="In total, 2246 patients and 3206 controls were included."}
property_value: IAO:0000112 "PMID:24462138" xsd:string {dcterms:title="Association of interleukin 8 with myocardial infarction: results from the Stockholm Heart Epidemiology Program.", xref="PMID:24462138", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24462138+AND+SRC%3AMED&format=json&resultType=core", comment="To investigate the association of IL8 serum levels with the risk of MI and the association of the IL8 (IL8) and IL8 receptors (CXCR1 and CXCR2) genetic variants with IL8 levels and MI risk in a large case control study, the Stockholm Heart Epidemiology Program."}

[Instance]
id: coho:COHO_0002376
name: Sleep Heart Health Study
def: "A multicentre prospective cohort study of the US National Heart, Lung, and Blood Institute that enrolled adults aged 40 years or older in 1995–1998 from existing epidemiological cohorts (sites of the Atherosclerosis Risk in Communities Study and the Cardiovascular Health Study, the Framingham Offspring Cohort, the Strong Heart Study, the New York Hypertension Cohorts and two Tucson studies) and added an in-home polysomnogram at baseline and again in 2001–2003 to their data, to study obstructive sleep apnoea and other sleep-disordered breathing as risk factors for cardiovascular disease, hypertension and death." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:9493915", IAO:0000119="https://biolincc.nhlbi.nih.gov/studies/shhs/"}
synonym: "SHHS" RELATED OMO:0003000 []
