property_value: coho:numberOfParticipants "2000" xsd:integer {IAO:0000116="participants recruited 2004-2007", xref="PMID:20394692", comment="From 2004 through 2007, we recruited 2,000 participants to the CCHC who are residents of Brownsville, Texas, which has 8 international crossing points to Matamoros, Mexico."}
property_value: IAO:0000112 "GCST90502757" xsd:string {dcterms:title="Trans-ancestry genome-wide association study of childhood body mass index identifies novel loci and age-specific effects.", xref="PMID:39885687", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11875162/fullTextXML", comment="The Cameron County Hispanic Cohort (CCHC) is a community-based cohort study initiated in 2004 of Mexican Americans in Brownsville, Texas."}

[Instance]
id: coho:COHO_0000518
name: Alzheimer's Disease Genetics Consortium
def: "A US consortium that assembles genome-wide genotype data and harmonized phenotypes from many case-control, family-based, population-based and longitudinal Alzheimer disease cohorts, in more than 30 GWAS datasets of several ancestries, for genetic studies of late-onset Alzheimer disease." [] {IAO:0000119="PMID:41268768", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:39250132"}
