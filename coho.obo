relationship: coho:has_data_collection_location http://dbpedia.org/resource/Switzerland {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6509728/fullTextXML", comment="HypnoLaus is a population‐based sleep cohort study conducted in Lausanne, Switzerland."}
relationship: coho:isSubCohortOf coho:COHO_0000522 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6509728/fullTextXML", comment="The HypnoLaus study was performed between September 1, 2009 and June 30, 2013, and participants were recruited among the CoLaus/PsyCoLaus study."}
property_value: coho:numberOfParticipants "2162" xsd:integer {IAO:0000116="CoLaus/PsyCoLaus participants with a complete home polysomnography, 2009-2013", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9707830/fullTextXML", comment="Of the 2162 participants included in HypnoLaus, 1172 who had hypertension at baseline with complete polysomnography and known hypertension status at follow‐up were included in this analysis (Figure 2)."}
property_value: IAO:0000112 "GCST90270120" xsd:string {dcterms:title="The genetic etiology of periodic limb movement in sleep.", xref="PMID:35670608", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35670608+AND+SRC%3AMED&format=json&resultType=core", comment="Replication in the HypnoLaus and MESA cohorts (1002 cases) preceded joint meta-analysis."}

[Instance]
id: coho:COHO_0001193
name: Interaction of Gene and Environment of Depression during PostPartum
def: "A French prospective multicentre cohort, sponsored by Assistance Publique – Hôpitaux de Paris, of women of European ancestry aged over 18 who gave birth in eight maternity departments of the Paris metropolitan area and were included two to five days after delivery between November 2011 and June 2016. The women gave a blood sample for DNA and were assessed for depression by trained clinicians with DSM-5 criteria at inclusion, at 8 weeks and at 1 year postpartum, to study how genetic factors and maternal stressors interact in the risk of postpartum depression." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38555957", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT01648816", IAO:0000119="PMID:33932643"}
subset: coho1:GWAS_subset
synonym: "IGEDEPP" RELATED OMO:0003000 []
synonym: "Interaction Between Genetic Factors and Maternal Stressors During Pregnancy in the Risk of Postpartum Depression" RELATED []
synonym: "interaction of gene and environment of depression during postpartum" RELATED []
synonym: "Interaction of Gene and Environment of Depression in PostPartum" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/France {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11059250/fullTextXML", comment="Our study among the interaction of gene and environment of depression during postpartum (IGEDEPP) women, in the Paris areas (France), showed 1-year cumulative incidence of PPD of 18.1%, a prevalence of early-onset PPD of 8.3%, and a prevalence of late-onset PPD of 12.9% [6], in line with previous works [7]."}
property_value: coho:numberOfParticipants "3310" xsd:integer {IAO:0000116="women included after delivery, 2011-2016", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33932643+AND+SRC%3AMED&format=json&resultType=core", comment="BackgroundIGEDEPP (Interaction of Gene and Environment of Depression during PostPartum) is a prospective multicenter cohort study of 3310 Caucasian women who gave birth between 2011 and 2016, with follow-up until one year postpartum."}
property_value: IAO:0000112 "GCST90624430" xsd:string {dcterms:title="Genome-wide association study of early-onset and late-onset postpartum depression: the IGEDEPP prospective study.", xref="PMID:38555957", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11059250/fullTextXML", comment="With the French multicenter interaction of gene and environment of depression during postpartum (IGEDEPP) cohort, we conducted a genome-wide association study (GWAS) on 234 women with early-onset PPD and 223 women with late-onset PPD, as well as 1,204 controls with no history of lifetime depression."}

[Instance]
id: coho:COHO_0001194
name: Impact of Neurodevelopmental disorders and School performance: genes and environment
def: "A school-based cohort of children and adolescents aged 5–17 from primary and secondary general-education schools across Catalonia, Spain, set up to study neurodevelopmental disorders, school performance and their genetic and environmental factors. Since the 2011–2012 school year, parents and teachers complete screening questionnaires for mental health problems and learning difficulties, children who screen positive are assessed by psychiatrists and neuropsychologists for DSM diagnoses, academic marks are taken from school records, and DNA is collected from saliva or buccal swabs." [] {IAO:0000119="PMID:40962958", IAO:0000119="PMID:41554769", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38783053"}
subset: coho1:GWAS_subset
synonym: "INSchool" RELATED OMO:0003000 []
