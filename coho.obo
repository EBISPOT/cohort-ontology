property_value: IAO:0000112 "GCST90012174" xsd:string {dcterms:title="Investigation of gene-gene interactions in cardiac traits and serum fatty acid levels in the LURIC Health Study.", xref="PMID:32915819", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7485803/fullTextXML", comment="We performed interaction analyses using the two filtering methods, adjusting for age, sex, body mass index (BMI), waist-hip ratio, and the first three principal components from genetic data, among 2,824 samples from the Ludwigshafen Risk and Cardiovascular (LURIC) Health Study."}

[Instance]
id: coho:COHO_0000460
name: Diabetes Heart Study
def: "A community-based, family-based study of European American and African American siblings concordant for type 2 diabetes and their unaffected relatives (1,443 participants from 564 families), recruited from internal medicine and endocrinology clinics in western North Carolina, United States, and examined at Wake Forest Baptist Medical Center to study genetic and epidemiological contributions to diabetic heart disease and subclinical cardiovascular disease; a parallel African American-Diabetes Heart Study (AA-DHS) later enrolled unrelated African Americans with type 2 diabetes to study ethnic differences in calcified atherosclerotic plaque." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:23230101", IAO:0000119="PMID:21409311", IAO:0000119="PMID:29221444"}
