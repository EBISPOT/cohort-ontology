relationship: coho:has_data_collection_location http://dbpedia.org/resource/Canada {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3160956/fullTextXML", comment="We note that both the Black and Hispanic groups likely had diverse ancestry given that participants were recruited in the US, Canada, and the Caribbean; therefore, some degree of population substructure is expected."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States
property_value: coho:numberOfParticipants "39114" xsd:integer {IAO:0000116="ALLHAT participants in the original GenHAT study", xref="PMID:35886043", comment="The original GenHAT study (n = 39,114) evaluated the interaction between candidate hypertensive genetic variants and different antihypertensive treatments to modify the risk of fatal and non-fatal CVD outcomes [24]."}
property_value: IAO:0000112 "GCST90101797" xsd:string {dcterms:title="Genetic Contributors of Incident Stroke in 10,700 African Americans With Hypertension: A Meta-Analysis From the Genetics of Hypertension Associated Treatments and Reasons for Geographic and Racial Differences in Stroke Studies.", xref="PMID:34992631", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34992631+AND+SRC%3AMED&format=json&resultType=core", comment="Methods: In a population comprising over 10,700 AAs treated for hypertension from the Genetics of Hypertension Associated Treatments (GenHAT) and Reasons for Geographic and Racial Differences in Stroke (REGARDS) studies, we performed an inverse variance-weighted meta-analysis of incident stroke."}

[Instance]
id: coho:COHO_0001009
name: Genetics of Chronic Obstructive Lung Disease
def: "A genetic case-control study of chronic obstructive pulmonary disease conducted in Bergen, Norway, in 2003–2005 and sponsored by GlaxoSmithKline, which enrolled current and former smokers aged 40 or older: patients with at least moderate COPD, recruited from a hospital patient registry and from the general population, and smokers with normal lung function as controls." [] {IAO:0000119="PMID:19300482", IAO:0000119="PMID:25134640", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31413559", IAO:0000119="PMID:32944202", IAO:0000119="PMID:25241909"}
