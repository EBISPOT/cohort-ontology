property_value: coho:numberOfParticipants "17312" xsd:integer {IAO:0000116="employees recruited and examined 2000-2007", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-024-02688-1/MediaObjects/41380_2024_2688_MOESM1_ESM.pdf", comment="For PROCAM-2, 17,312 employees were recruited in more than 50 regional companies and government authorities on a voluntary basis."}
property_value: IAO:0000112 "GCST90454271" xsd:string {dcterms:title="A meta-analysis of genome-wide studies of resilience in the German population.", xref="PMID:39112778", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11746137/fullTextXML", comment="Briefly, this study included participants with available genotype data and the relevant phenotypic information from the BiDirect Study (N = 1453) [7], the FOR2107 consortium (N = 1789) [8], the PROCAM-2 Study (N = 3879) [9, 10], both SHIP cohorts (SHIP-START/-LEGEND, N = 2230; SHIP-TREND, N = 2330) [11, 12], and the LIFE-Adult-Study (N = 4141) [13, 14]."}

[Instance]
id: coho:COHO_0001030
name: PsyCourse Study
def: "A multicentre, naturalistic longitudinal study of adults with schizophrenia-spectrum, bipolar or recurrent depressive disorders and of healthy controls, recruited at clinical centres in Germany and Austria from 2011 to 2019 and assessed four times at six-month intervals over 18 months with deep phenotyping, dimensional ratings of psychopathology, cognitive tests and blood sampling, to identify clinical, neurobiological and genetic signatures of the course of major psychiatric disorders across the affective-to-psychotic continuum." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:39721961", IAO:0000119="PMID:30070057"}
subset: coho1:GWAS_subset
