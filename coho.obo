[Instance]
id: coho:COHO_0002060
name: Myaesthenia Gravis GWAS
def: "A set of healthy Norwegian controls, recruited through the Norwegian Bone Marrow Donor Registry of the Institute of Immunology, Oslo University Hospital, whose genome-wide genotypes were generated on the Illumina 550 chip by the Myasthenia Gravis Genetic Consortium and shared as external control data for genome-wide association studies." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature10251/MediaObjects/41586_2011_BFnature10251_MOESM243_ESM.pdf"}
