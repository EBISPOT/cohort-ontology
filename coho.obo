property_value: IAO:0000112 "PMID:21203820" xsd:string {dcterms:title="Dietary intake of micronutrients and the risk of developing bladder cancer: results from the Belgian case-control study on bladder cancer risk.", xref="PMID:21203820", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21203820+AND+SRC%3AMED&format=json&resultType=core", comment="A semi-quantitative 322 item food frequency questionnaire (FFQ) was used to collect dietary data from 200 bladder cancer cases and 386 control subjects participating in the Belgian case-control study on bladder cancer risk."}

[Instance]
id: coho:COHO_0001548
name: Breast Cancer Study of the University Clinic Heidelberg
def: "A case-control study of breast cancer in Germany whose cases are women diagnosed with breast cancer in 2007-2009 at the University Women's Clinic Heidelberg and whose controls are female blood donors recruited in the same years at the Institute of Transfusion Medicine and Immunology in Mannheim; it is one of the studies of the Breast Cancer Association Consortium." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32424353", IAO:0000119="PMID:22267197", IAO:0000119="PMID:23535729"}
