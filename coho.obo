property_value: coho:numberOfCases "1476" xsd:integer {IAO:0000116="CORGI cases (colorectal cancer or adenomas) and spouse/partner controls used in a 2013 study", xref="PMID:23263490", comment="CORGI cases comprised 1,476 individuals from the COloRectal tumour Gene Identification study 30."}
