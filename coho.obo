property_value: coho:numberOfParticipants "31" xsd:integer {IAO:0000116="PURIFICAR FAP patients evaluated in the 2013 study", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23460355+AND+SRC%3AMED&format=json&resultType=core", comment="A total of 31 FAP (from 19 families) and 13 MAP (from 13 families) Hispanic patients recruited from the PURIFICAR were evaluated."}
property_value: IAO:0000112 "PMID:25389437" xsd:string {dcterms:title="Report of a Novel Mutation in MLH1 Gene in a Hispanic Family from Puerto Rico Fulfilling Classic Amsterdam Criteria for Lynch Syndrome.", xref="PMID:25389437", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25389437+AND+SRC%3AMED&format=json&resultType=core", comment="In this paper we report a novel mutation in the hMLH1 gene in a Puerto Rican Hispanic family with Lynch syndrome recruited through the Puerto Rico Familial Colorectal Cancer Registry (PURIFICAR)."}

[Instance]
id: coho:COHO_0002301
name: Quit2Live
def: "A smoking-cessation clinical trial run by the University of Kansas Medical Center in Kansas City, United States, from 2013 to 2017, in which adult non-Hispanic African American and White smokers of 3–20 cigarettes a day who wanted to quit were treated with varenicline, to study racial differences in quitting smoking and their causes." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:33300144", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT01836276"}
