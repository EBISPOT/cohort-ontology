relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3691951/fullTextXML", comment="The studies are from the UK (the British 1958 Birth Cohort (1958BC),23 36–38 the Chingford Study (CHINGFORD),39 40 the Dyne Steel DNA Bank for Aging and Cognition (DSDBAC),41 the EPIdemiological study of FUNctional Disorders (EPIFUND),20 and the Hertfordshire Cohort Study (HCS)42);"}
property_value: coho:numberOfParticipants "6791" xsd:integer {IAO:0000116="adults aged 25-65 who took part in the baseline postal survey (2001)", xref="https://doi.org/10.3899/jrheum.080541", comment="Of the 6791 baseline participants, 3985 and 2761 completed first and second followup surveys, respectively, as shown in Figure 1."}
property_value: IAO:0000112 "PMID:22956598" xsd:string {dcterms:title="Genome-wide association study meta-analysis of chronic widespread pain: evidence for involvement of the 5p15.2 region.", xref="PMID:22956598", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3691951/fullTextXML", comment="The stage 2b studies (CHINGFORD, EPIFUND and HCS) performed de novo genotyping, using both Sequenom iPLEX and TaqMan-based assays (supplementary methods)."}

[Instance]
id: coho:COHO_0001696
name: Johns Hopkins Epidemiology-Genetics Program Ashkenazi Jewish schizophrenia case-control sample
def: "A case-control sample of Ashkenazi Jewish people with schizophrenia, including schizoaffective disorder, and screened Ashkenazi Jewish controls, all reporting four grandparents of Ashkenazi Jewish descent, recruited in the United States by the Epidemiology-Genetics Program in Psychiatry of Johns Hopkins University: the cases through advertisements, talks and letters to the Jewish community and a study website, interviewed in person and diagnosed by consensus, and the controls at Jewish community meetings, community centres and synagogues." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:25781172", IAO:0000119="PMID:20431428"}
synonym: "Epi_Gen_AJ_SZ" RELATED OMO:0003000 []
