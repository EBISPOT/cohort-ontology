property_value: IAO:0000112 "GCST90328131" xsd:string {dcterms:title="Multi-ancestry genome-wide association study of major depression aids locus discovery, fine mapping, gene prioritization and causal inference.", xref="PMID:38177345", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10864182/fullTextXML", comment="We had access to individual-level data for Army STARRS, UKB, Women’s Health Initiative (WHI), Intern Health Study (IHS), GERA, Jackson Heart Study (JHS), Drakenstein Child Health Study and the Detroit Neighborhood Health Study."}

[Instance]
id: coho:COHO_0001312
name: Dental Strategies Concentrating on Risk Evaluation
def: "A sub-study of Heart SCORE (Heart Strategies Concentrating on Risk Evaluation), a community-based cohort begun in 2003 of White and African American adults aged 45–75 in the greater Pittsburgh area, Pennsylvania, set up to investigate racial disparities in cardiovascular disease, in which a subgroup of participants had extended dental and periodontal examinations following the COHRA1 protocols and gave blood or saliva for DNA in 2007–2010, run by the University of Pittsburgh." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:41006734", IAO:0000119="PMID:35172313"}
