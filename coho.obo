relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10364164/fullTextXML", comment="Participants were enrolled at either Duke University Medical Center or East Carolina University (ECU)."}
property_value: coho:numberOfParticipants "947" xsd:integer {IAO:0000116="adults randomised across STRRIDE I, STRRIDE AT/RT and STRRIDE-PD", xref="PMID:37492634", comment="A total of 947 adults with dyslipidemia (STRRIDE I, STRRIDE AT/RT) or prediabetes (STRRIDE-PD) were randomized to either inactive control or to 1 of 10 exercise interventions, ranging from doses of 8–23 kcal/kg/week, intensities of 50%–75% V˙O2 peak, and durations of 6–8 months."}
property_value: IAO:0000112 "GCST90624054" xsd:string {dcterms:title="Genome-Wide Genetic Analysis of Dropout in a Controlled Exercise Intervention in Sedentary Adults With Overweight or Obesity and Cardiometabolic Disease.", xref="PMID:38489667", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11008589/fullTextXML", comment="Therefore, in this report, we undertook a genome-wide association study (GWAS) approach to identify other putative genetic variants associated with dropout from exercise training interventions among 603 individuals in the STRRIDE (Studies of a Targeted Risk Reduction Intervention through Defined Exercise) randomized trials."}

[Instance]
id: coho:COHO_0000984
name: Rare Variants for Hypertension in Taiwan Chinese
def: "A study of rare variants for hypertension in Taiwan Chinese that combines three cohorts based in Taiwan: families from the SAPPHIRe study, launched in 1995, with at least two hypertensive siblings, and unrelated participants from Tri-Service General Hospital and Taichung Veterans General Hospital matched to SAPPHIRe participants for age, sex and BMI category. All its participants were selected for whole-genome sequencing in the NHLBI TOPMed programme." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml"}
