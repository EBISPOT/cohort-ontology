[Instance]
id: coho:COHO_0002708
name: Shanghai CRC Study
def: "A population-based colorectal cancer case-control collection in Shanghai, China, assembled for genetic studies in the Asia Colorectal Cancer Consortium from the Shanghai-1, Shanghai-2 and Shanghai-3 sample series. The early series include colorectal cancer cases and cancer-free controls from the Shanghai Women’s Health Study and Shanghai Men’s Health Study, with additional controls from Shanghai breast cancer studies; Shanghai-3 includes colorectal cancer cases newly recruited through the Shanghai Cancer Registry in 2009–2011, with controls from the health cohorts and breast cancer studies." [] {IAO:0000119="PMID:23263487", dcterms:contributor="GPT-6 (OpenAI), 2026-09", IAO:0000119="PMID:24836286", IAO:0000119="PMID:35765848"}
subset: coho1:PGS_subset
