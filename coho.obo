relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7190044/fullTextXML", comment="The Intern Health Study is a prospective cohort study assessing stress and depression during the first year of residency training in the US."}
property_value: coho:numberOfParticipants "740" xsd:integer {IAO:0000116="interns of the founding 2007-2008 and 2008-2009 cohorts at 13 US hospitals who agreed to take part (the study enrols a new cohort each year), 2007-2009", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC4036806/", comment="58% (740/1271) of the remaining invited subjects agreed to participate in the study."}
property_value: IAO:0000112 "PMID:38177345" xsd:string {dcterms:title="Multi-ancestry genome-wide association study of major depression aids locus discovery, fine mapping, gene prioritization and causal inference.", xref="PMID:38177345", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10864182/fullTextXML", comment="We had access to individual-level data for Army STARRS, UKB, Women’s Health Initiative (WHI), Intern Health Study (IHS), GERA, Jackson Heart Study (JHS), Drakenstein Child Health Study and the Detroit Neighborhood Health Study."}

[Instance]
id: coho:COHO_0001911
name: Icelandic Kidney Stone Registry
def: "A registry of patients with kidney stone disease in Iceland, kept at Landspitali – The National University Hospital of Iceland in Reykjavik and established in 2008 in conjunction with a nationwide study of kidney stone disease that searched the computerised records of all major hospitals and medical imaging centres in Iceland for codes indicating kidney stones; its patients with confirmed radiopaque stones who had given blood to the genetic research programmes of deCODE genetics were the Icelandic cases of deCODE's genetic association studies of kidney stones." [] {IAO:0000119="PMID:26316205", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22992468", IAO:0000119="PMID:20686651"}
synonym: "Icelandic Kidney Stone Disease Registry" RELATED []
