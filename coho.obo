property_value: coho:numberOfParticipants "21162" xsd:integer {IAO:0000116="PEGASUS-TIMI 54 randomized prior-MI patients (2013)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25773268+AND+SRC%3AMED&format=json&resultType=core", comment="We randomly assigned, in a double-blind 1:1:1 fashion, 21,162 patients who had had a myocardial infarction 1 to 3 years earlier to ticagrelor at a dose of 90 mg twice daily, ticagrelor at a dose of 60 mg twice daily, or placebo."}
property_value: IAO:0000112 "PGS000016" xsd:string {dcterms:title="A polygenic risk score predicts atrial fibrillation in cardiovascular disease.", xref="PMID:35980763"}
