relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3485429/", comment="The NEIGHBOR (NEI Glaucoma Human genetics collaBORation) consortium is a unique collaborative effort involving investigators at 12 institutions located throughout the United States."}
