property_value: IAO:0000112 "GCST90179214" xsd:string {dcterms:title="Identifying causal serum protein-cardiometabolic trait relationships using whole genome sequencing.", xref="PMID:36349687", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10077504/fullTextXML", comment="Meta-analyzing whole-genome sequencing (WGS) data from two Greek cohorts, MANOLIS (n = 1356; 22.5× WGS) and Pomak (n = 1537; 18.4× WGS), we detect 301 independently associated pQTL variants for 170 proteins, including 12 rare variants (minor allele frequency < 1%)."}

[Instance]
id: coho:COHO_0000431
name: Genetic Epidemiology Research on Adult Health and Aging
def: "A multi-ethnic cohort of over 100,000 adult members of the Kaiser Permanente Northern California health plan who consented to the Research Program on Genes, Environment and Health (RPGEH), linking survey data, saliva-derived DNA with genome-wide genotypes and telomere length, and electronic health records for research on the genetic and environmental determinants of common age-related diseases." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:33778338", IAO:0000119="PMID:26092718"}
