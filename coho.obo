relationship: coho:has_data_collection_location http://dbpedia.org/resource/South_Korea {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6463169/fullTextXML", comment="We have recruited 71 CN participants, 96 SCD, 72 MCI, and 56 ADD in nine memory clinics across South Korea from April 2015 to August 2016."}
property_value: IAO:0000112 "PMID:33436035" xsd:string {dcterms:title="Alzheimer's cerebrospinal biomarkers from Lumipulse fully automated immunoassay: concordance with amyloid-beta PET and manual immunoassay in Koreans : CSF AD biomarkers measured by Lumipulse in Koreans.", xref="PMID:33436035", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7802266/fullTextXML", comment="Herein, we analyzed CSF samples from a validation cohort in the Korean Brain Aging Study for the Early Diagnosis and Prediction of Alzheimer’s Disease (KBASE-V study) using a fully automated immunoassay Lumipulse G and two manual immunoassay platforms: xMAP-Luminex INNOBIA-AlzBio3 multiplex assay (Luminex) and ELISA with INNOTEST kit (INNOTEST) for Aβ42, Aβ40 (only for INNOTEST and Lumipulse G), t-tau, or p-tau."}

