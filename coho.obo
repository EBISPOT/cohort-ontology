property_value: coho:numberOfControls "740" xsd:integer {IAO:0000116="endometrial cancer cases and population controls with interview data (2007)", xref="https://link.springer.com/article/10.1007/s10552-011-9894-5", comment="Table 1 Descriptive characteristics of 1,399 women with endometrial cancer and 740 population-based controls"}
property_value: IAO:0000112 "PMID:27135401" xsd:string {dcterms:title="Five endometrial cancer risk loci identified through genome-wide association analysis.", xref="PMID:27135401", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4907351/fullTextXML", comment="As described previously, cases with endometrioid histology were selected from two population studies; the UK Studies of Epidemiology and Risk factors in Cancer Heredity (SEARCH, n=681) and the Australian National Endometrial Cancer Study (ANECS, n=606), and genotypes generated using Illumina Infinium 610K arrays 10."}

[Instance]
id: coho:COHO_0001487
name: Lübeck Registry of Structural Heart Disease
def: "A registry of patients with heart disease treated at the University of Lübeck hospital (University Hospital Schleswig-Holstein, Campus Lübeck) in Germany, with blood samples and clinical data, whose angiography sample (Angio-Lueb) consists of consecutive patients referred for coronary angiography and classified from the angiogram as having coronary artery disease or myocardial infarction or not. It has provided cases for genetic association studies of coronary artery disease, with population controls from KORA, and of dilated cardiomyopathy." [] {IAO:0000119="PMID:20975947", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27150028", IAO:0000119="PMID:23202125", IAO:0000119="PMID:19348677"}
