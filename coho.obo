property_value: coho:numberOfParticipants "3263" xsd:integer {IAO:0000116="people aged 18-44 without TMD enrolled into the prospective cohort, May 2006 to November 2008; cases and controls are those of the baseline case-control study, whose 1,633 controls were drawn from the cohort and whose 185 chronic TMD cases were enrolled in addition (2006-2008)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3666856/", comment="Volunteers aged 18-44 years were recruited at four US study sites: 3,263 people without TMD were enrolled into the prospective cohort study; 1,633 of them were selected as controls for the baseline case-control study."}
property_value: IAO:0000112 "PMID:22074755" xsd:string {dcterms:title="Potential genetic risk factors for chronic TMD: genetic associations from the OPPERA case control study.", xref="PMID:22074755", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22074755+AND+SRC%3AMED&format=json&resultType=core", comment="This study evaluated 358 genes involved in pain processes, comparing allelic frequencies between 166 cases with chronic TMD and 1,442 controls enrolled in the OPPERA (Orofacial Pain: Prospective Evaluation and Risk Assessment) study cooperative agreement."}

[Instance]
id: coho:COHO_0002212
name: IARC Oral Cancer Multicenter study
def: "An international hospital-based case–control study of cancer of the oral cavity and oropharynx, coordinated by the International Agency for Research on Cancer in nine countries (Italy, Spain, Northern Ireland, Poland, Canada, India, Sudan, Australia and Cuba), which interviewed its participants and collected oral exfoliated cells and blood from cases and controls, and fresh tumour biopsies from cases, to study the role of human papillomavirus in these cancers. It is one of the studies of the International Head and Neck Cancer Epidemiology Consortium, and participants from its centres in Canada, Italy, Poland and Spain were genotyped for a genome-wide association study of oral cavity and pharyngeal cancer." [] {IAO:0000119="PMID:27749845", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19190158", IAO:0000119="PMID:21437268", IAO:0000119="PMID:11437401", IAO:0000119="PMID:14652239"}
