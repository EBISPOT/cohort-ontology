relationship: coho:has_data_collection_location http://dbpedia.org/resource/South_Africa {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11134365/fullTextXML", comment="The African Research Kidney Disease (ARK) study is a well characterised population-based cohort study of 2021 adults (20–80 years) of self-identified black ethnicity from Agincourt, (Mpumalanga, South Africa) with demographic data, health-related questionnaire data, and anthropometric measurements collected at enrolment (Fabian et al., 2022)."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Southern_Africa
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Uganda {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35839814+AND+SRC%3AMED&format=json&resultType=core", comment="We measured serum creatinine, cystatin C, and glomerular filtration rate (GFR) using the slope-intercept method for iohexol plasma clearance (mGFR) in population cohorts from Malawi, Uganda, and South Africa."}
property_value: coho:numberOfParticipants "3025" xsd:integer {IAO:0000116="people who underwent measured GFR testing (Malawi 1020, South Africa 986, Uganda 1019), 2022", xref="PMID:35839814", comment="Of 3025 people who underwent measured GFR testing (Malawi n=1020, South Africa n=986, and Uganda n=1019), we analysed data for 2578 participants who had complete data and adequate quality measurements."}
property_value: IAO:0000112 "GCST90399578" xsd:string {dcterms:title="Genetic association and transferability for urinary albumin-creatinine ratio as a marker of kidney disease in four Sub-Saharan African populations and non-continental individuals of African ancestry.", xref="PMID:38812969", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11134365/fullTextXML", comment="The African Research Kidney Disease (ARK) study is a well characterised population-based cohort study of 2021 adults (20–80 years) of self-identified black ethnicity from Agincourt, (Mpumalanga, South Africa) with demographic data, health-related questionnaire data, and anthropometric measurements collected at enrolment (Fabian et al., 2022)."}

[Instance]
id: coho:COHO_0001145
name: Berkeley Aging Cohort Study
def: "A longitudinal study of typical cognitive aging at the University of California, Berkeley, and Lawrence Berkeley National Laboratory. It recruits cognitively normal older adults (and some young adults) living in the community in the San Francisco Bay Area through advertisements and word of mouth, and follows them with repeated neuropsychological testing, MRI, and PET imaging of amyloid and tau, to study brain changes in normal aging and early Alzheimer's disease pathology." [] {IAO:0000119="PMID:29527500", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38334195", IAO:0000119="PMID:40441049", IAO:0000119="PMID:37502020"}
