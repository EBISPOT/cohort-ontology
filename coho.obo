property_value: IAO:0000112 "PMID:22199011" xsd:string {dcterms:title="Association between chromosome 9p21 variants and the ankle-brachial index identified by a meta-analysis of 21 genome-wide association studies.", xref="PMID:22199011", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3303225/unicode", comment="The replication studies included 5 population-based studies and 3 clinically-based studies including a total of over 16,000 participants: the Bruneck Study (n=786), the Copenhagen City Heart Study (CCHS, n=5,330), the Multi-Ethnic Study of Atherosclerosis (MESA, n=2,611), the National Health and Nutrition Examination Surveys (NHANES 1999–2002, n=2,335), Prevention of Renal and Vascular End-stage disease (PREVEND, n=3,691) cohort, Cardiovascular Disease in Intermittent Claudication (CAVASIC, n=443) Study, Genetic Determinants of Peripheral Arterial Disease (GenePAD, n=850), and the Linz Peripheral Arterial Disease (LIPAD, n=671) Study."}

[Instance]
id: coho:COHO_0002005
name: Lithuanian Diabetic Nephropathy Study
def: "A study of people with type 1 diabetes at the Lithuanian University of Health Sciences in Kaunas, Lithuania, run with the Finnish Diabetic Nephropathy Study group as the Lithuanian part of the InterDiane project, to identify clinical, genetic and environmental risk factors for the late complications of type 1 diabetes, in particular genes related to diabetic nephropathy." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://lsmu.lt/en/about-lsmu/structure/medical-academy/faculty-of-medicine/departments/department-of-endocrinology/", IAO:0000119="https://lsmu.lt/en/research-and-innovations/research-institutes/institute-of-endocrinology/", IAO:0000119="https://www.endocrine-abstracts.org/ea/0081/ea0081ep1182"}
