[Instance]
id: coho:COHO_0000391
name: Swedish CArdioPulmonary bioImage Study
def: "A national multicentre population-based cohort of 30,154 Swedish men and women aged 50–64, randomly recruited in 2013–2018 from the national population register in six areas adjacent to six Swedish university hospitals and characterised with imaging, large-scale omics and epidemiological data to improve risk prediction of cardiopulmonary diseases and study their mechanisms." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:40164586", IAO:0000119="PMID:26096600"}
subset: coho1:GWAS_subset
subset: coho1:MetaboLight_subset
synonym: "SCAPIS" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Sweden {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26096600+AND+SRC%3AMED&format=json&resultType=core", comment="The Swedish CArdioPulmonarybioImage Study (SCAPIS) combines the use of new imaging technologies, advances in large-scale 'omics' and epidemiological analyses to extensively characterize a Swedish cohort of 30 000 men and women aged between 50 and 64 years."}
property_value: coho:numberOfParticipants "30154" xsd:integer {IAO:0000116="men and women aged 50-64 recruited 2013-2018", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958696/fullTextXML", comment="Between 2013 and 2018, 30,154 subjects aged 50–64 were randomly recruited from the national population register in six areas adjacent to six Swedish university hospitals."}
property_value: IAO:0000112 "GCST90837374" xsd:string {dcterms:title="Genome-wide association study of image-based emphysema scoring in the Swedish CArdioPulmonary bioImage Study (SCAPIS) suggests two new risk loci in smokers.", xref="PMID:42634071", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42634071+AND+SRC%3AMED&format=json&resultType=core", comment="We conducted a genome-wide association study (GWAS) of CT-based emphysema, with a particular focus on non-smoking-related genetic determinants.MethodsWe analyzed 25,639 individuals of European ancestry from the SCAPIS national cohort, aged 50-65 years, of which 51% were never-smokers."}
property_value: IAO:0000112 "MTBLS407" xsd:string {dcterms:title="An online atlas of human plasma metabolite signatures of gut microbiome composition.", xref="PMID:36151114", xref="https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS407", comment="In this cross-sectional study, we used deep metagenomic sequencing and ultra-high-performance liquid chromatography linked to mass spectrometry for a detailed characterization of the gut microbiota and plasma metabolome, respectively, of 8583 participants invited at age 50 to 64 from the population-based Swedish CArdioPulmonary bioImage Study."}

[Instance]
id: coho:COHO_0000392
name: Malmö Offspring Study
def: "A family-based cohort of the adult children and grandchildren of participants in the Malmö Diet and Cancer Study–Cardiovascular Cohort in Malmö, Sweden, identified from Swedish Tax Agency registers and invited by mail, and examined from 2013 (4,721 participants aged 18–71 by 2020) with genotyping and cardiovascular, respiratory, metabolic, cognitive, dietary and gut and oral microbiota phenotyping, to study family traits of chronic disease across three generations." [] {IAO:0000119="PMID:41688638", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:33222051"}
