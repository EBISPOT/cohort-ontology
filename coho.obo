property_value: coho:numberOfParticipants "1066" xsd:integer {IAO:0000116="ET2DS participants recruited at baseline in 2006-2007", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2621220/fullTextXML", comment="Participants recruited at baseline (2006–2007) constitute 1066 men and women aged 60 to 75 years with established type 2 diabetes, living in the Lothian region of central Scotland."}
property_value: IAO:0000112 "PMID:19959761" xsd:string {dcterms:title="Association between raised inflammatory markers and cognitive decline in elderly people with type 2 diabetes: the Edinburgh Type 2 Diabetes Study.", xref="PMID:19959761", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2828661/fullTextXML", comment="The Edinburgh Type 2 Diabetes Study (ET2DS) tested the association between three markers of inflammation (C-reactive protein [CRP], interleukin [IL]-6, and tumor necrosis factor [TNF]-α) and cognitive impairment in a representative cohort of people with type 2 diabetes."}

[Instance]
id: coho:COHO_0001711
name: EUDRAGENE
def: "A European collaboration, supported by the European Commission's 5th Framework Programme, that established a DNA case-control collection for studying the genetic basis of susceptibility to serious adverse drug reactions, ascertaining cases mainly through adverse drug reaction reports to pharmacovigilance centres; its cases have been used in genetic studies of drug-induced liver injury, statin-induced myopathy and other reactions." [] {IAO:0000119="PMID:21570397", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:18637888", IAO:0000119="PMID:31220337", IAO:0000119="PMID:16753010"}
