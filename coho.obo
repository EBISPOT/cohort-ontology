property_value: coho:numberOfParticipants "1085" xsd:integer {IAO:0000116="patients recruited into the GRAS data collection in 2005-2010; blood-donor controls not counted", xref="PMID:21067598", comment="For this purpose, 1085 patients were recruited between 2005 and 2010 by an invariable team of traveling investigators in a cross-sectional field study that comprised 23 German psychiatric hospitals."}
property_value: IAO:0000112 "PMID:28623238" xsd:string {dcterms:title="A normal genetic variation modulates synaptic MMP-9 protein levels and the severity of schizophrenia symptoms.", xref="PMID:28623238", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28623238+AND+SRC%3AMED&format=json&resultType=core", comment="In the present study, we performed a phenotype-based genetic association study (PGAS) in > 1,000 schizophrenia patients from the Göttingen Research Association for Schizophrenia (GRAS) data collection and found an association between the MMP-9 rs20544 C/T single-nucleotide polymorphism (SNP) located in the 3'untranslated region (UTR) and the severity of a chronic delusional syndrome."}

[Instance]
id: coho:COHO_0001823
name: Genomic Research Cohorts for CCMB Diabetes Study
def: "A collection of Indian cohorts brought together for genetic studies of type 2 diabetes by the Genomic Research on Complex Diseases group at the CSIR-Centre for Cellular and Molecular Biology (CCMB), Hyderabad, including the Indian Diabetes Prevention Study 3, the Pune Maternal Nutrition Study and the Wellcome Genetics (WellGen) study, whose type 2 diabetes cases (by history, treatment or WHO 1999 oral glucose tolerance criteria) and normoglycaemic controls were genotyped genome-wide." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM1_ESM.pdf", IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM3_ESM.xlsx", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41591-025-03827-z/MediaObjects/41591_2025_3827_MOESM1_ESM.pdf"}
