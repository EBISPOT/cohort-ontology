property_value: IAO:0000112 "PMID:41664457" xsd:string {dcterms:title="Serum ferritin levels in a sample of older participants in the Greek HYDRIA survey: associations with sociodemographic and lifestyle parameters including dietary iron intake and Mediterranean diet score.", xref="PMID:41664457", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13423517/fullTextXML", comment="As part of the HYDRIA 2013–2014 National Health and Nutrition study, a cross-sectional survey of a nationally representative sample of adults in Greece, serum ferritin levels (SFL) were measured in participants aged ≥ 55 years, and dietary intake was assessed using two non-consecutive 24-h dietary recalls per participant."}

[Instance]
id: coho:COHO_0002621
name: Grain Fibre Modification for Gut-mediated Health Effects
def: "The participants of a randomised crossover dietary intervention trial started in 2011 by the University of Eastern Finland with VTT Technical Research Centre of Finland, within the FIBREFECTS project, in which adults with self-reported gastrointestinal symptoms after eating grain products ate white wheat bread during a run-in and then wholegrain rye bread and wheat bread enriched with bioprocessed rye bran, to study the effects of modified cereal fibre on glucose metabolism, gut fermentation and gut-mediated health." [] {IAO:0000119="PMID:25370913", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://clinicaltrials.gov/study/NCT03550365"}
