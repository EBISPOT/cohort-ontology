property_value: coho:numberOfParticipants "602" xsd:integer {IAO:0000116="employees enrolled and randomised (2016-2018)", xref="PMID:34097048", comment="Among 602 employees enrolled (mean [SD] age, 43.6 [12.2] years; 478 [79.4%] women), 299 were randomized to the intervention group and 303 were randomized to the control group."}
property_value: IAO:0000112 "PMID:37217678" xsd:string {dcterms:title="Genetic predisposition to macronutrient preference and workplace food choices.", xref="PMID:37217678", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37217678+AND+SRC%3AMED&format=json&resultType=core", comment="Here we examined the associations of polygenic scores for carbohydrate, fat, and protein preference with 12 months' workplace food purchases among 397 hospital employees from the ChooseWell 365 study."}

[Instance]
id: coho:COHO_0001592
name: Children's Health Study
def: "A prospective study of schoolchildren in southern California, run by the University of Southern California, that from 1993 recruited successive cohorts from school classrooms in 16 communities chosen to differ in regional air pollution (fourth, seventh and tenth graders in 1993, fourth graders in 1996, and kindergarten and first-grade children in 2002–2003) and followed them through school with yearly questionnaires and lung function tests, to study the chronic effects of air pollution and other environmental and genetic factors on children's respiratory health, asthma and lung function growth." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:20371422", IAO:0000119="PMID:25694817", IAO:0000119="https://healthstudy.usc.edu/", IAO:0000119="PMID:29273806"}
