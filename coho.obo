property_value: IAO:0000112 "PMID:42065824" xsd:string {dcterms:title="Low genetic risk for coronary artery disease underlies multigenerational longevity and healthy aging.", xref="PMID:42065824", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42065824+AND+SRC%3AMED&format=json&resultType=core", comment="We investigated this hypothesis in the Leiden Longevity Study, a cohort with data from more than 420 long-lived families in three generations and the Leiden 85-plus study."}

[Instance]
id: coho:COHO_0001986
name: Los Angeles County Asian-American Breast Cancer Case-Control Study
def: "A population-based case-control study of incident breast cancer among Asian American women in Los Angeles County, California, whose cases, ascertained through the Los Angeles Cancer Surveillance Program, are Chinese, Japanese or Filipino women aged 25–74 with histologically confirmed primary breast cancer diagnosed between 1996 and 2006, and whose controls were recruited from the neighbourhoods where the cases lived, frequency-matched on specific Asian ethnicity and five-year age group." [] {IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-020-15046-w/MediaObjects/41467_2020_15046_MOESM1_ESM.pdf", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32139696"}
