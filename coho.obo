property_value: IAO:0000112 "PMID:24836286" xsd:string {dcterms:title="Large-scale genetic study in East Asians identifies six new loci associated with colorectal cancer risk.", xref="PMID:24836286", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4068797/unicode", comment="Specifically, stage 1 (GWAS discovery) consisted of five studies: Shanghai CRC Study 1 (Shanghai-1, n = 3,102), Shanghai CRC Study 2 (Shanghai-2, n = 908), Guangzhou CRC Study 1 (Guangzhou-1, n = 1,603), Aichi CRC Study 1 (Aichi-1, n =1,346), and Korean Cancer Prevention Study-II CRC (KCPS-II, n = 1,301)."}

[Instance]
id: coho:COHO_0001483
name: African American Breast Cancer Epidemiology and Risk Consortium
def: "A consortium, funded by the US National Cancer Institute as a Program Project, that pools the questionnaire data, tumour tissue and DNA of four epidemiological studies of breast cancer in African American women in the United States (two case-control studies, the Carolina Breast Cancer Study and the Women's Circle of Health Study, and two cohorts, the Black Women's Health Study and the Multiethnic Cohort Study), with tumour subtyping, genotyping and data harmonisation done centrally in shared cores, to study the causes of breast cancer subtypes, especially oestrogen receptor-negative breast cancer, in African American women." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24343304", IAO:0000119="PMID:25849024"}
