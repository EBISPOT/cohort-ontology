property_value: IAO:0000112 "GCST90129578" xsd:string {dcterms:title="Genome-Wide Association Study of Campylobacter-Positive Diarrhea Identifies Genes Involved in Toxin Processing and Inflammatory Response.", xref="PMID:35420468", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9239263/fullTextXML", comment="Here, we aimed to identify genetic variants associated with host susceptibility to Campylobacter infection using two well-characterized birth cohorts: the Performance of Rotavirus and Oral Polio Vaccines in Developing Countries (PROVIDE) Study (19) and the Cryptosporidiosis Birth Cohort (CBC) (20)."}

[Instance]
id: coho:COHO_0001155
name: Childhood Cancer Survivor Study
def: "A multi-institutional retrospective cohort, with longitudinal follow-up, of five-year survivors of the most common childhood cancers diagnosed before age 21 at participating paediatric centres in the United States and Canada, with a comparison cohort of their siblings. It was funded by the US National Cancer Institute in 1994 for survivors diagnosed in 1970-1986 and later expanded to those diagnosed in 1987-1999, as a resource for research on the long-term effects of childhood cancer and its treatment." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19364948", IAO:0000119="PMID:31941657"}
