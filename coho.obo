relationship: coho:has_data_collection_location http://dbpedia.org/resource/Sweden {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22561842+AND+SRC%3AMED&format=json&resultType=core", comment="Other health-care regions joined and since 1998 virtually all prostate cancer (PCa) cases are registered in the National Prostate Cancer Register (NPCR) of Sweden to provide data for quality assurance, bench marking and clinical research."}
relationship: coho:hasSubCohort coho:COHO_0002725
property_value: IAO:0000112 "PMID:18930283" xsd:string {dcterms:title="Surveillance and deferred treatment for localized prostate cancer. Population based study in the National Prostate Cancer Register of Sweden.", xref="PMID:18930283", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18930283+AND+SRC%3AMED&format=json&resultType=core", comment="In the National Prostate Cancer Register of Sweden, with a 98% coverage vs the compulsory Swedish Cancer Registry, we identified 8,304 incident cases of prostate cancer in 1997 to 2002 with age younger than 70 years, clinical local stage T1 or 2, N0 or Nx, M0 or Mx and serum prostate specific antigen less than 20 ng/ml."}

[Instance]
id: coho:COHO_0002725
name: National Prostate Cancer Register of Sweden Follow-up Study
def: "A nationwide retrospective observational cohort of men with localized prostate cancer selected from the National Prostate Cancer Register of Sweden, with registration from January 1997 to December 2002, beginning in January 1998 in one healthcare region. Participants were aged 70 years or younger at diagnosis, had clinical local tumour stage T1–T2 and serum prostate-specific antigen below 20 ng/mL, and had no recorded signs of lymph-node or bone metastasis (N0/Nx and M0/Mx). Medical-record review and linkage to national registers were used to assess management and outcomes." [] {IAO:0000119="PMID:31343436", dcterms:contributor="GPT-6 (OpenAI), 2026-09", IAO:0000119="PMID:20562373"}
synonym: "NPCR Follow-up Study" RELATED OMO:0003000 []
synonym: "NPCR of Sweden Follow-up Study" RELATED OMO:0003000 []
