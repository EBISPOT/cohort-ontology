property_value: coho:numberOfParticipants "23" xsd:integer {IAO:0000116="participants with documented ALS Reversal consented and enrolled", xref="PMID:39079071", comment="A total of 23 participants with previously documented ALS Reversal were successfully consented and enrolled."}
property_value: IAO:0000112 "GCST90838706" xsd:string {dcterms:title="Genetic Associations With an Amyotrophic Lateral Sclerosis Reversal Phenotype.", xref="PMID:39079071", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11286288/fullTextXML", comment="All contactable patients with an ALS Reversal phenotype in our database were invited to participate in this genetic study named Study of ALS Reversals 2: Genetic Analyses (StAR2)."}

