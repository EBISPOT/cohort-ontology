property_value: IAO:0000112 "GCST90711139" xsd:string {dcterms:title="Novel genomic variants related to visceral adiposity index (VAI) and body adiposity index (BAI) in Indian sib-pairs.", xref="PMID:38971891", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38971891+AND+SRC%3AMED&format=json&resultType=core", comment="2265 sib-pairs from Indian Migration Study were used for examining the association of genetic variants from the Cardio-Metabochip array with VAI, and BAI."}

[Instance]
id: coho:COHO_0001020
name: Institute of Rheumatology, Rheumatoid Arthritis
def: "A single-centre prospective observational cohort of Japanese patients with rheumatoid arthritis, established in October 2000 at the Institute of Rheumatology, Tokyo Women's Medical University, Tokyo, which registers consenting patients with rheumatoid arthritis treated at the institute and collects patient questionnaires, physician assessments of disease activity and laboratory data twice a year, in April and October." [] {IAO:0000119="PMID:30188930", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:39017907", IAO:0000119="PMID:42050091"}
