relationship: coho:has_data_collection_location http://dbpedia.org/resource/Netherlands {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6290855/fullTextXML", comment="For this, we initiated the 100-plus Study in 2013 at the Alzheimer Center Amsterdam in the Netherlands"}
relationship: coho:isCohortOf coho:COHO_0000551
property_value: coho:numberOfParticipants "332" xsd:integer {IAO:0000116="centenarians included by September 2018 (family members and partners not counted)", xref="PMID:30362018", comment="To date (September 2018), 332 centenarians were included in the study."}
property_value: IAO:0000112 "PMID:33216869" xsd:string {dcterms:title="Polygenic Risk Score of Longevity Predicts Longer Survival Across an Age Continuum.", xref="PMID:33216869", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8087277/fullTextXML", comment="As cases, we used a sample of 358 participants from the 100-plus Study cohort (20)."}

[Instance]
id: coho:COHO_0001453
name: Two Sister Study
def: "A family-based study of young-onset breast cancer, conducted by the US National Institute of Environmental Health Sciences as an offshoot of the Sister Study, that in 2008–2010 enrolled women diagnosed with breast cancer before age 50 who had a sister in the Sister Study, together with their parents, and used the breast cancer-free Sister Study sisters as matched controls, to study genetic and environmental causes of young-onset breast cancer. The affected women are followed prospectively as breast cancer survivors." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://sisterstudy.niehs.nih.gov/English/2sis.htm", IAO:0000119="PMID:22773825"}
synonym: "2SISTER" RELATED OMO:0003000 []
synonym: "The Two Sister Study" RELATED []
