[Instance]
id: coho:COHO_0001767
name: Genetic Epidemiological Study of Lung Adenocarcinoma
def: "A genetic epidemiological study of lung cancer in Taiwan whose case-control component, from September 2002, recruited ethnically Han Chinese patients aged 18 years or older with histologically confirmed incident primary lung cancer from six medical centres, together with cancer-free controls matched on age, gender and ethnicity from the health-examination departments of the same hospitals, to evaluate questionnaire-based and genetic risk factors for lung cancer." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:37955902", IAO:0000119="PMID:23143601"}
subset: coho1:PGS_subset
