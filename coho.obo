property_value: IAO:0000112 "PMID:27825389" xsd:string {dcterms:title="Maternal arsenic exposure and gestational diabetes and glucose intolerance in the New Hampshire birth cohort study.", xref="PMID:27825389", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27825389+AND+SRC%3AMED&format=json&resultType=core", comment="We investigated the association between As exposure and risk of glucose intolerance and GDM among 1151 women enrolled in the New Hampshire Birth Cohort Study."}

[Instance]
id: coho:COHO_0002643
name: Shanghai Dapuqiao Aging and Cognition Study
def: "A community-based open cohort of residents aged 65 and older of the Dapu (Dapuqiao) neighbourhood of Huangpu District in central Shanghai, China, recruited through the Shanghai Municipal Annual Physical Examination Program for older residents and examined in three waves in 2019, 2022 and 2024, mostly as repeated cross-sectional samples with a small longitudinal subset, to study health, lifestyle and cognition in an ageing urban population." [] {IAO:0000119="PMID:41606232", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SDACS"}
subset: coho1:GEC_subset
