property_value: coho:numberOfParticipants "1755" xsd:integer {IAO:0000116="psoriasis cases and controls in the Genizon GWAS dataset (after QC, as analysed)", xref="https://europepmc.org/api/getPdf?pmcid=PMC4423213", comment="Genizon European Canada 760 995 1,755 1.039 1.045"}
property_value: IAO:0000112 "GCST90565134" xsd:string {dcterms:title="Multi-ancestry genome-wide meta-analysis with 472,819 individuals identifies 32 novel risk loci for psoriasis.", xref="PMID:39885523", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11783861/fullTextXML", comment="Currently published GWASs include eight Europe-originated psoriasis-associated GWAS cohorts, including CASP [7], Kiel [8], Genizon [8], PsA GWAS [9], WTCCC2 [10], Exomechip [11], PAGE [12], and GAPC [12], two South Asia-originated psoriasis-associated GWAS cohort including three batches [13], and one East Asia-originated psoriasis-associated GWAS cohort [14]."}

[Instance]
id: coho:COHO_0001175
name: GEnetic analysis of NUclear Families with Atopic Dermatitis
def: "A family-based genetic study of atopic dermatitis run from Charité Universitätsmedizin Berlin, which recruited complete nuclear families, mostly German and a few Swedish, through at least two children with physician-diagnosed, moderate to severe atopic dermatitis that began before the age of two, and in its extended phase also unrelated children with such early-onset disease, recording asthma and hay fever at recruitment, for genetic studies of atopic dermatitis and allergic disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:25757221", IAO:0000119="PMID:29083406", IAO:0000119="PMID:37794016"}
