property_value: IAO:0000112 "PMID:32820175" xsd:string {dcterms:title="Polygenic background modifies penetrance of monogenic variants for tier 1 genomic conditions.", xref="PMID:32820175", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7441381/fullTextXML", comment="Second, a breast cancer case-control study consisted of 19,264 women (1920 cases and 17,344 controls) who underwent clinical grade genetic testing for hereditary breast and ovarian cancer syndrome at a commercial testing laboratory (Color Genomics; Burlingame, CA)."}

[Instance]
id: coho:COHO_0001586
name: Candidate Gene Association Resource
def: "A shared genotype–phenotype resource set up by the US National Heart, Lung, and Blood Institute in 2006, which brought DNA samples and phenotype data from nine NHLBI cohort studies (ARIC, CARDIA, the Cleveland Family Study, the Cardiovascular Health Study, the Cooperative Study of Sickle Cell Disease, the Framingham Heart Study, the Jackson Heart Study, MESA and the Sleep Heart Health Study) to the Broad Institute, genotyped their European American, African American, Hispanic and Chinese American participants on a candidate-gene array (the ITMAT-Broad-CARe array) and the African American participants of five of the cohorts genome-wide, and makes the data available to approved researchers, to find genetic variants associated with cardiovascular, pulmonary, haematological and sleep-related traits." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000283.v6.p3", IAO:0000119="PMID:20400780"}
