[Instance]
id: coho:COHO_0000855
name: Atrial Fibrillation Genetics Consortium
def: "A consortium of cohort and case-control studies with genome-wide genotype data that pools them in meta-analyses of genome-wide association studies of atrial fibrillation, to identify genetic loci for atrial fibrillation; together with the Broad AF Study, its studies formed the majority of the 2018 multi-ethnic meta-analysis of more than half a million individuals." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29892015"}
subset: coho1:GWAS_subset
synonym: "AFGen" RELATED OMO:0003000 []
synonym: "AFGen Consortium" RELATED []
synonym: "Atrial Fibrillation Genetics (AFGen) consortium" RELATED []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:hasCohort coho:COHO_0001476 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf", comment="The meta-analyses described in this manuscript included the following studies described elsewhere: The Age, Gene/Environment Susceptibility Study (AGES) Reykjavik study169 , the Atrial Fibrillation Biobank LMU (AFLMU) in the context of the Arrhythmia-Biobank-LMU (formerly known as AFNET) and the Cooperative Health Research in the Region of Augsburg (KORA)169"}
property_value: coho:numberOfCases "65446" xsd:integer {IAO:0000116="AF cases in the 2018 multi-ethnic meta-analysis (AFGen + Broad AF + others); total only as 'more than half a million'", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6136836/unicode", comment="In sum, we identified a total of 97 distinct AF loci from 65,446 AF cases and more than 522,000 referents."}
property_value: IAO:0000112 "GCST90624411" xsd:string {dcterms:title="Cross-population GWAS and proteomics improve risk prediction and reveal mechanisms in atrial fibrillation.", xref="PMID:40645996", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12254421/fullTextXML", comment="Eight studies (the Nord-Trøndelag Health Study [HUNT], deCODE, DiscoverEHR, Michigan Genomics Initiative [MGI], AFGen consortium4, FinnGen R12, Swedish Infrastructure for Medical Population-Based Life-Course and Environmental Research [SIMPLER, https://www.simpler4health.se/], and Million Veteran Program[MVP]) contributed to the discovery analysis for the European GWAS, comprising 192,851 atrial fibrillation (AF) cases and 1,239,541 controls6,41,42."}

[Instance]
id: coho:COHO_0000856
name: ASPirin in Reducing Events in the Elderly
def: "A placebo-controlled randomized trial of daily low-dose aspirin in 19,114 community-dwelling adults aged 70 or over (65 or over for US minorities) in Australia and the United States without prior cardiovascular events, dementia or independence-limiting physical disability, followed as a cohort after the trial to study healthy ageing." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:40796244"}
subset: coho1:GWAS_subset
