property_value: coho:numberOfParticipants "7171" xsd:integer {IAO:0000116="participants whose buccal DNA samples passed quality criteria (2016)", xref="PMID:32390825", comment="The MxGDAR/Encodat database included 7171 of the 13,228 buccal epithelial samples collected (54.21%) that met the following quality criteria: i) 230/260 and 260/230 ratios > 1.8, ii) concentration > 50 ng/µL, and iii) no signs of DNA degradation."}
property_value: IAO:0000112 "GCST90708781" xsd:string {dcterms:title="Exploring the relationship between admixture and genetic susceptibility to attention deficit hyperactivity disorder in two Latin American cohorts.", xref="PMID:38714835", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11269173/fullTextXML", comment="Those from Mexico were part of the subsample MxGDAR-Encodat [17] from the Mexican National Survey of Tobacco, Alcohol, and Drug Use [18], which found an ADHD prevalence of 1.4% based on a questionnaire used to assign participants to the ADHD group."}

[Instance]
id: coho:COHO_0001377
name: Nicotine Addiction Genetics Finland study
def: "The Finnish arm of the multisite Nicotine Addiction Genetics consortium (Finland, Australia and the United States), in which twin pairs from the older Finnish Twin Cohort (born 1938–1957) concordant for ever-smoking, with priority to heavier smokers, were recruited in 2001–2005 together with their family members, mainly siblings, and assessed by a structured diagnostic psychiatric interview and DNA sampling to study the genetics of smoking behaviour and nicotine dependence." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24927283", IAO:0000119="PMID:29532581"}
