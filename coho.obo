property_value: IAO:0000112 "GCST90255389" xsd:string {dcterms:title="Association of Early Childhood Caries with Bitter Taste Receptors: A Meta-Analysis of Genome-Wide Association Studies and Transcriptome-Wide Association Study.", xref="PMID:36672800", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9858612/fullTextXML", comment="The second cohort of the Center for Oral Health Research in Appalachia (COHRA2) is a longitudinal study of the genetic, microbial, and environmental factors impacting oral health and is separate from COHRA1."}

[Instance]
id: coho:COHO_0001445
name: Genetic Analysis of Idiopathic Thrombophilia 2 Project
def: "A family-based study, run at the Hospital de la Santa Creu i Sant Pau in Barcelona, of extended Spanish families recruited from 2006 to 2010 through a proband with idiopathic thrombophilia (recurrent thrombosis, a spontaneous thrombosis with an affected first-degree relative, or thrombosis before age 45, with known biological causes excluded), each family having at least ten living members in three or more generations. It follows the GAIT-1 Project with a new set of families and studies the genetic basis of thrombosis risk and of intermediate phenotypes such as thrombin generation." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35272364", IAO:0000119="PMID:26784699"}
