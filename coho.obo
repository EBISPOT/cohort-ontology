[Instance]
id: coho:COHO_0000576
name: RIKEN cohort
def: "A Japanese pharmacogenetic cohort of 219 patients with metastatic renal cell carcinoma treated with sunitinib, recruited from 15 Japanese medical institutes with data collected at the laboratory for pharmacogenomics of the RIKEN Center for Integrative Medical Sciences, to study germline genetic variants related to sunitinib toxicity and efficacy." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:26914831", IAO:0000119="PMID:35740506"}
