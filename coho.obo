[Term]
id: MONDO:0005815
name: pancreatic neuroendocrine neoplasm
def: "A neoplasm with neuroendocrine differentiation that arises from the pancreas. It includes neuroendocrine tumors (low and intermediate grade) and neuroendocrine carcinomas (high grade)." []
