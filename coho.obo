[Instance]
id: coho:COHO_0002542
name: Vejle Diabetes Biobank
def: "A regional diabetes case-control biobank in Vejle, Denmark, established from 2007 to 2010, holding blood, DNA and urine samples and examination, questionnaire and interview data from patients with diabetes and an age- and sex-matched control population aged 25 to 75, linked to the Danish Civil Registration System, National Patient Registry and National Prescription Registry, for studies of the causes of diabetes and its comorbidities." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27799821", dcterms:contributor="Claude Sonnet 5 (Anthropic), 2026-09"}
