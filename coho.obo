property_value: IAO:0000112 "GCST90651078" xsd:string {dcterms:title="Genome-wide association meta-analysis of age at onset of walking in over 70,000 infants of European ancestry.", xref="PMID:40335706", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12283345/fullTextXML", comment="We conducted a GWAS meta-analysis of AOW in 70,560 children including data from four European-ancestry cohorts: the Norwegian Mother, Father and Child Cohort Study20,21 (MoBa, N = 58,302), the Netherlands Twin Register22 (NTR, N = 6,251), the Lifelines multigenerational prospective population-based birth cohort study23 from the North of the Netherlands (N = 3,415) and the United Kingdom Medical Research Council National Study for Health and Development24 (NSHD, N = 2,592)."}
property_value: IAO:0000112 "MTBLS616" xsd:string {dcterms:title="A lipidomic human population and translational feeding study of hepatic steatosis and de novo lipogenesis (Human plasma assay)", xref="https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS616", comment="Results: We conducted direct infusion mass spectrometry of lipids in plasma to study the association between specific triacylglycerols (TAGs) and hepatic steatosis assessed by ultrasound and fatty liver index in volunteers from the UK-based Fenland Study (n=1507), and evaluated clustering of TAGs in the National Survey of Health and Development UK cohort (n=1701)."}

[Instance]
id: coho:COHO_0001027
name: Oxford Down Syndrome Cohort Study
def: "A prospective cohort of newborns with Down syndrome enrolled at birth in 18 hospitals in the United Kingdom from 2006 to 2017, screened for GATA1 mutations and followed with serial clinical and haematological data from birth to 4 years of age, to study transient abnormal myelopoiesis, preleukaemic GATA1 mutations and the risk of myeloid leukaemia in children with Down syndrome." [] {IAO:0000119="PMID:40249915", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:40407036", IAO:0000119="PMID:24021668"}
subset: coho1:GWAS_subset
synonym: "ODSCS" RELATED OMO:0003000 []
synonym: "Oxford DS Cohort Study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12391799/fullTextXML", comment="The study comprised 434 newborns with DS from the ODSCS, a prospective cohort that enrolled children with DS between 2006 to 2017 from 18 hospitals in the United Kingdom."}
property_value: coho:numberOfParticipants "450" xsd:integer {IAO:0000116="neonates with Down syndrome studied in the prospective cohort's mature analysis (2025)", xref="PMID:40561204", comment="Of 450 neonates with DS, 113 (25%) had GATA1s mutations, among whom 20/113 (17.7%) had multiple mutations and 59 (52%) were clinically silent."}
property_value: IAO:0000112 "GCST90624115" xsd:string {dcterms:title="Genome-wide association study of somatic GATA1s mutations in newborns with Down syndrome.", xref="PMID:40249915", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12391799/fullTextXML", comment="To address the question of why only a subset of DS newborns develop transient leukemia, we performed a comprehensive genetic epidemiology study of GATA1s mutations via whole-genome sequencing (WGS) plus targeted GATA1 sequencing of 434 children with DS in the Oxford Down Syndrome Cohort Study (ODSCS)."}

[Instance]
id: coho:COHO_0001028
name: Pharmacogenetics of Opioid Substitution Treatment Response
def: "A prospective cohort of patients aged 16 or older receiving methadone or buprenorphine–naloxone treatment for opioid use disorder at outpatient clinics of the Canadian Addiction Treatment Centres across Ontario, Canada, recruited by McMaster University researchers from May 2018 to January 2023 as an extension of the Genetics of Opioid Addiction study with a similar protocol. Participants were interviewed at entry, gave a saliva sample for DNA and were followed for up to 12 months through their medical records and urine drug screens, to study biopsychosocial and genetic factors in treatment outcomes." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38102185", IAO:0000119="PMID:32326982", IAO:0000119="PMID:40527567", IAO:0000119="PMID:33622351"}
