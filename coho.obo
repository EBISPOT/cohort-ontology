[Instance]
id: coho:COHO_0001235
name: Swiss HIV Cohort Study
def: "A nationwide prospective longitudinal cohort of people with HIV aged 16 or older in Switzerland, established in 1988 as a collaboration of the Swiss university hospitals, large cantonal hospitals, affiliated smaller hospitals and private physicians, who recruit and follow the participants, to improve the health of people with HIV through clinical, translational and basic research." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:37532928", IAO:0000119="https://www.shcs.ch/about-shcs/study-design/"}
