[Instance]
id: coho:COHO_0000471
name: Human Functional Genomics Project
def: "A research programme based at Radboud University Medical Center in Nijmegen, the Netherlands, that collects distinct cohorts of healthy volunteers and patients (among them 500FG, 200FG, 300BCG, 300OB, 300DM and 2000HIV) profiled with genetic, immunological and other omics data, to identify the genetic and non-genetic determinants of human immune and cytokine responses." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5787854/unicode", IAO:0000119="https://humanfunctionalgenomics.org/projects/", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10851559/fullTextXML"}
synonym: "HFGP" RELATED OMO:0003000 []
