property_value: IAO:0000112 "PMID:28190761" xsd:string {dcterms:title="Prevalence of Circulating Tumor Cells After Adjuvant Chemotherapy With or Without Anthracyclines in Patients With HER2-negative, Hormone Receptor-positive Early Breast Cancer.", xref="PMID:28190761", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28190761+AND+SRC%3AMED&format=json&resultType=core", comment="Based on data suggesting a limited benefit of anthracyclines in human epidermal growth factor receptor 2 (HER2)-negative patients, the Simultaneous Study of Docetaxel Based Anthracycline Free Adjuvant Treatment Evaluation, as well as Life Style Intervention Strategies (SUCCESS) C study randomized patients to either anthracycline-containing or anthracycline-free chemotherapy."}

[Instance]
id: coho:COHO_0002418
name: Suita Study
def: "A population-based prospective cohort of residents of Suita, an urban city in Osaka, Japan, made up of two groups randomly selected from the general population by sex and 10-year age group (recruited in 1989 and 1998) and a volunteer group (recruited 1992-2006), who had a baseline health examination with questionnaire, clinical examination, blood and urine analysis and electrocardiogram at the National Cerebral and Cardiovascular Center and return there every two years for follow-up, to investigate risk factors for cardiovascular disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:9056605", IAO:0000119="PMID:40383629", IAO:0000119="PMID:40898037"}
synonym: "Suita" RELATED OMO:0003000 []
synonym: "suita study" RELATED []
