[Instance]
id: coho:COHO_0002739
name: NR-SAFE
def: "A single-centre, randomised, placebo-controlled, double-blind phase I trial at Haukeland University Hospital, Bergen, Norway, in which people with Parkinson's disease received 1,500 mg of nicotinamide riboside twice daily or placebo for four weeks, to evaluate the safety of high-dose nicotinamide riboside." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38016950", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09"}
