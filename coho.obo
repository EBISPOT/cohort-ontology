property_value: IAO:0000112 "PMID:17925548" xsd:string {dcterms:title="Pharmacogenetic assessment of toxicity and outcome after platinum plus taxane chemotherapy in ovarian cancer: the Scottish Randomised Trial in Ovarian Cancer.", xref="PMID:17925548", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17925548+AND+SRC%3AMED&format=json&resultType=core", comment="We assessed 27 selected polymorphisms based on previously described associations or putative functional effects in 16 key genes from pathways that may influence cellular sensitivity to taxanes (ABCB1, ABCC1, ABCC2, ABCG2, CDKN1A, CYP1B1, CYP2C8, CYP3A4, CYP3A5, MAPT, and TP53) and platinum (ABCC2, ABCG2, ERCC1, ERCC2, GSTP1, MPO, and XRCC1) using polymerase chain reaction and Pyrosequencing in 914 ovarian cancer patients from the Scottish Randomised Trial in Ovarian Cancer phase III trial who were treated at presentation with carboplatin and taxane regimens after cytoreductive surgery."}

[Instance]
id: coho:COHO_0002409
name: South Stockholm Ischemic Stroke Study
def: "A case-control study of ischaemic cerebrovascular disease in southern Stockholm, Sweden, whose stroke patients underwent clinical investigation and standardised blood tests and whose patients and controls were genotyped for 100 polymorphisms in 47 candidate susceptibility genes to study the genetic profile of ischaemic stroke and its subtypes." [] {IAO:0000119="PMID:22784820", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
