relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3316565/fullTextXML", comment="Samples and data from this prospective, unselected, population-based cohort were collected between 1996 and 2003 at a single maternity unit in West Cumbria, UK."}
property_value: coho:numberOfParticipants "7000" xsd:integer {IAO:0000116="offspring born 1996-2003 with DNA and tissue samples (approximate; approximately 3000 mothers also gave samples)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3516066/fullTextXML", comment="The NCCGP is a community-based DNA-banking project, consisting of DNA and tissue samples from approximately 3000 mothers and approximately 7000 offspring born between 1996 and 2003 (46)."}
property_value: IAO:0000112 "PMID:22479380" xsd:string {dcterms:title="Genetic and non-genetic influences during pregnancy on infant global and site specific DNA methylation: role for folate gene variants and vitamin B12.", xref="PMID:22479380", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3316565/fullTextXML", comment="A nested cohort study was undertaken within the North Cumbria Community Genetics Project [44] and included 430 cord blood DNA samples (mean (± SD) gestation = 39.5 (1.4) weeks) for methylation and genotype analysis."}

[Instance]
id: coho:COHO_0002122
name: Nagano Colorectal Cancer Study
def: "A hospital-based case-control study of colorectal cancer conducted between October 1998 and March 2002 at four hospitals in Nagano Prefecture, Japan, enrolling patients aged 20-74 with newly diagnosed, histologically confirmed colorectal cancer and cancer-free controls from medical check-up examinees at the same hospitals, matched on sex, age, hospital and residential area, with self-administered and food-frequency questionnaires and blood samples." [] {IAO:0000119="PMID:25105248", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
