relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Hong_Kong {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs42003-020-0802-y/MediaObjects/42003_2020_802_MOESM1_ESM.pdf", comment="For the Myopia Genomics Study of Hong Kong, unrelated individuals of Chinese descent aged between 18 and 45 years were recruited via the Optometry Clinic at the Hong Kong Polytechnic University with details as described previously23-25 ."}
