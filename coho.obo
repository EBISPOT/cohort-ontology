[Instance]
id: coho:COHO_0002126
name: North Carolina Prostate Cancer Study
def: "A population-based case-control study of prostate cancer in 12 contiguous counties of western North Carolina, United States, which from November 2006 to November 2008 recruited men aged 40 to 70 with a new histological diagnosis of prostate cancer, identified through the rapid case ascertainment centre of the North Carolina Central Cancer Registry, and controls recruited by friend referral and matched to the cases on age, race and county, each giving a blood sample and completing a food-frequency and a medical and family history questionnaire." [] {IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3094/MediaObjects/41588_2014_BFng3094_MOESM58_ESM.pdf", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.839/MediaObjects/41588_2011_BFng839_MOESM33_ESM.pdf"}
