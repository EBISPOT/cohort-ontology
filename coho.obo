property_value: IAO:0000112 "PMID:25105248" xsd:string {dcterms:title="Trans-ethnic genome-wide association study of colorectal cancer identifies a new susceptibility locus in VTI1A.", xref="PMID:25105248", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4180879/fullTextXML", comment="In the first GWAS, Japanese samples (n = 6,424) were identified from the Multiethnic Cohort study (MEC), the Colorectal Cancer Family Registry (CCFR), the Japan Public Health Center cohort study (JPHC) and three case-control studies in Hawaii (CR2&3) and in Fukuoka and Nagano, Japan (Supplementary Table 1)."}

[Instance]
id: coho:COHO_0002123
name: NCI Bladder Cancer
def: "The US National Cancer Institute's genome-wide association study of bladder cancer, which pooled cases with histologically confirmed bladder cancer and controls of European descent from two case-control studies in Spain and the United States (the Spanish Bladder Cancer Study and the Maine and Vermont components of the New England Bladder Cancer Study) and three prospective cohorts in Finland and the United States (the Alpha-Tocopherol, Beta-Carotene Cancer Prevention Study, the Prostate, Lung, Colorectal and Ovarian Cancer Screening Trial and the American Cancer Society Cancer Prevention Study II Nutrition Cohort) in its first scan (NCI-GWAS1), and added a second scan (NCI-GWAS2) of further cases, including the New Hampshire component of the New England Bladder Cancer Study, with cancer-free controls from previously scanned NCI studies, to identify susceptibility loci for bladder cancer." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24163127", IAO:0000119="PMID:22238607", IAO:0000119="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000346.v1.p1"}
synonym: "Genome-wide association study for Bladder Cancer Risk" RELATED []
