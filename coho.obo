[Instance]
id: coho:COHO_0000905
name: Consortium for Refractive Error and Myopia
def: "An international consortium of cohorts of European and Asian ancestry that pools cohort-level genome-wide association results to study refractive error, myopia and ocular biometric traits such as axial length and corneal curvature." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32193507"}
subset: coho1:GWAS_subset
synonym: "CREAM" RELATED OMO:0003000 []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:hasCohort coho:COHO_0001142 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/fullTextXML", comment="Fourteen population-based CREAM cohorts that had exome chip genotypes on individuals with refractive error measurements were used in this study. These 14 cohorts were: Singapore Chinese Eye Study (SCES), Singapore Malay Eye Study (SiMES), Singapore Indian Eye Study (SINDI), Age Related Eye Study (AREDS)"}
relationship: coho:hasCohort coho:COHO_0001289 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/fullTextXML", comment="Fourteen population-based CREAM cohorts that had exome chip genotypes on individuals with refractive error measurements were used in this study. These 14 cohorts were: Singapore Chinese Eye Study (SCES), Singapore Malay Eye Study (SiMES), Singapore Indian Eye Study (SINDI), Age Related Eye Study (AREDS), Rotterdam Study I (RSI), Erasmus Rucphen Family (ERF), Raine Eye Health Study (REHS) of the Raine Study, Beaver Dam Eye Study (BDES), Estonian Genome Center for the University of Tartu (EGCUT), Finnish Twin Study on Aging (FITSA), Ogliastra, Croatia-Korcula, TwinsUK, and EPIC-Norfolk."}
relationship: coho:hasCohort coho:COHO_0001489 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4551475/fullTextXML", comment="The CREAM meta-analysis included data from 32 studies: 1958 British Birth Cohort, ALSPAC (mothers), ANZRAG, AREDS1a1b, AREDS1c, Beijing Eye Study, BMES, CROATIA-Korcula, CROATIA-Split, CROATIA-Vis, DCCT, EGCUT, ERF, FECD, FITSA, Framingham, GHS 1, GHS 2, KORA, OGP Talana, ORCADES, RS1, RS2, RS3, SCES, SIMES, SINDI, SP2, TEST/BATS, TwinsUK, WESDR, and YFS."}
relationship: coho:hasCohort coho:COHO_0001722 {xref="https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf", comment="FECD United States case-control (controls only) 393 71.50(9.18) 60.2 -0.14(2.49)"}
relationship: coho:hasCohort coho:COHO_0001806 {xref="https://doi.org/10.1017/thg.2012.96", comment="The Australian twins from both the ATES and GEM study are also part of the newly formed Consortium of Refractive Error and Myopia (CREAM) that brings together 31 cohorts representing four continents and 55,177 individuals, with the aim to identify genes and gene variants associated with myopia and its related sub-phenotypes."}
relationship: coho:hasCohort coho:COHO_0002102 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3772747/", comment="Myopia Genomics Study (Hong Kong HTI)"}
relationship: coho:hasCohort coho:COHO_0002201 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10203044/supplementaryFiles", comment="OGP Ogliastra Genetic Park Talana Study Italy 509 51.43 (19.51) 59.2 -0.10 (1.67)"}
relationship: coho:hasCohort coho:COHO_0002411 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs42003-020-0802-y/MediaObjects/42003_2020_802_MOESM1_ESM.pdf", comment="The Strabismus, Amblyopia and Refractive Error Study in Singaporean Chinese Preschoolers (STARS) Family study is a family-based study nested in a prevalence survey of Singaporean preschool children (n=3,009)"}
property_value: coho:numberOfParticipants "44042" xsd:integer {IAO:0000116="European and Asian ancestry individuals in the 2020 corneal curvature GWAS meta-analysis", xref="PMID:32193507", comment="Here we present a trans-ethnic meta-analysis of corneal curvature GWAS in 44,042 individuals of Caucasian and Asian with replication in 88,218 UK Biobank data."}
property_value: IAO:0000112 "GCST90012795" xsd:string {dcterms:title="Genome-wide association meta-analysis of corneal curvature identifies novel loci and shared genetic influences across axial length and refractive error.", xref="PMID:32193507", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7081241/fullTextXML", comment="Thus, we conducted the largest GWAS meta-analysis of CC to date, incorporating both European and Asian cohorts in a single analysis from the Consortium for Refractive Error and Myopia (CREAM) and validated our findings in the United Kingdom (UK) Biobank."}

[Instance]
id: coho:COHO_0000906
name: Doetinchem Cohort Study
def: "A population-based cohort study in Doetinchem, the Netherlands, started by the Dutch National Institute for Public Health and the Environment (RIVM) as a monitoring study of cardiovascular risk factors, in which 12,404 inhabitants aged 20–59, drawn as an age- and sex-stratified sample of the population register, were examined in 1987–1991 and two-thirds of them were re-invited to repeated rounds, to study lifestyle and other determinants of health, functioning and chronic disease over the life course." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML"}
