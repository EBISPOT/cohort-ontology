relationship: coho:has_data_collection_location http://dbpedia.org/resource/Latin_America_and_the_Caribbean
property_value: coho:numberOfParticipants "897" xsd:integer {IAO:0000116="Jamaican adolescents in the cross-sectional prevalence study", xref="https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf", comment="The Jamaican Adolescent Asthma Study (JAAS) is a cross-sectional study on the prevalence of asthma and allergies in 897 Jamaican adolescents [29]."}
property_value: IAO:0000112 "PMID:23554133" xsd:string {dcterms:title="African ancestry is a risk factor for asthma and high total IgE levels in African admixed populations.", xref="PMID:23554133", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4051322/unicode", comment="A sample of 706 unrelated individuals (177 asthmatics, 529 nonasthmatic controls) was recruited from Kingston, St. Andrew, and St. Catherine, Jamaica as part of the Jamaican Adolescent Asthma Study as described in supplementary materials and methods and in references."}

[Instance]
id: coho:COHO_0001942
name: Japanese Centenarian Study
def: "A study of exceptional longevity, approved by the ethics committee of Keio University School of Medicine, that enrols centenarians from throughout Japan, with an emphasis on semi-supercentenarians aged 105 or more whose ages are validated with the Basic Resident Registration Card, together with referent subjects (spouses of centenarians' offspring and healthy younger volunteers), and whose genotyped cases and geographically matched controls serve as a Japanese case-control set in genetic studies of extreme old age." [] {IAO:0000119="PMID:20011587", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24244950"}
synonym: "JCS" RELATED OMO:0003000 []
