relationship: coho:isSubCohortOf coho:COHO_0000428 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3188988/", comment="The 37 781 controls (41% males; mean age 61 years; SD = 21) used in this study consisted of individuals from other ongoing GWAS at deCODE and represent >15% of the adult population of Iceland."}
