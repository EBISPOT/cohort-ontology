relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11093576/fullTextXML", comment="The GenomALC study participants were recruited at clinical sites in Australia, France, Germany, Switzerland, the United Kingdom, and the United States using our previously published enrollment protocol.16 Briefly, chronic heavy drinkers who reported consuming ≥80 g of alcohol/day (male) or 50 g/d (female) for ≥10 years with cirrhosis (cases) or without significant alcohol-associated liver disease (controls) were recruited."}
property_value: coho:numberOfCases "1293" xsd:integer {IAO:0000116="cases and drinking controls of the GenomALC case-control study (GenomALC-1), 2021", xref="PMID:32868629", comment="We conducted a multicenter case-control study (GenomALC) comparing 1,293 cases (with alcohol-related cirrhosis, 75.6% male) and 754 controls (with equivalent alcohol exposure but no evidence of liver disease, 73.6% male)."}
property_value: coho:numberOfControls "754" xsd:integer {IAO:0000116="cases and drinking controls of the GenomALC case-control study (GenomALC-1), 2021", xref="PMID:32868629", comment="We conducted a multicenter case-control study (GenomALC) comparing 1,293 cases (with alcohol-related cirrhosis, 75.6% male) and 754 controls (with equivalent alcohol exposure but no evidence of liver disease, 73.6% male)."}
property_value: IAO:0000112 "GCST90428821" xsd:string {dcterms:title="A polygenic risk score for alcohol-associated cirrhosis among heavy drinkers with European ancestry.", xref="PMID:38727677", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11093576/fullTextXML", comment="The GenomALC study participants were recruited at clinical sites in Australia, France, Germany, Switzerland, the United Kingdom, and the United States using our previously published enrollment protocol.16 Briefly, chronic heavy drinkers who reported consuming ≥80 g of alcohol/day (male) or 50 g/d (female) for ≥10 years with cirrhosis (cases) or without significant alcohol-associated liver disease (controls) were recruited."}

[Instance]
id: coho:COHO_0001335
name: Melanoma Genetics Consortium
def: "An international non-profit consortium, established in 1997, of most of the research groups working on the genetics of familial melanoma, in Europe, North America, Australia and elsewhere, funded by the European Commission's Sixth Framework Programme and the US National Cancer Institute, which pools data and samples from its members' melanoma-prone families and case–control series to find melanoma susceptibility genes and how they interact with environmental factors such as ultraviolet radiation. Its genome-wide association study combined melanoma cases, prioritised for family history, multiple primaries or early onset, and controls from the same populations, contributed by member groups in Europe, Israel and Australia, with French and UK population controls." [] {IAO:0000119="https://genomel.org/about/", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:20876876", IAO:0000119="PMID:21983787", IAO:0000119="https://genomel.org/research/programme-and-aims/"}
