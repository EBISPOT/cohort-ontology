property_value: coho:numberOfParticipants "438" xsd:integer {IAO:0000116="children randomised in phase 1 (2016-2017)", xref="PMID:30514630", comment="ParticipantsA total of 438 children aged 4 to 12 years with myopia of at least -1.0 diopter (D) and astigmatism of -2.5 D or less."}
property_value: IAO:0000112 "GCST90566418" xsd:string {dcterms:title="Genome-wide association study identified novel loci and gene-environment interaction for refractive error in children.", xref="PMID:40410244", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40410244+AND+SRC%3AMED&format=json&resultType=core", comment="To identify novel genetic loci for children refractive error, we performed a meta-analysis of two genome-wide association studies (GWASs) of spherical equivalent (SE) in 1,237 children from the population-based Hong Kong Children Eye Study (HKCES) and the Low Concentration Atropine for Myopia Progression (LAMP) study."}

[Instance]
id: coho:COHO_0001366
name: Leipzig Childhood Obesity cohort
def: "An obesity-enriched cohort of children and adolescents from the Leipzig area, Germany, recruited through the paediatric obesity outpatient clinic of Leipzig University Medical Center and run by its Center for Pediatric Research, with oral glucose tolerance tests, serum and DNA samples collected at clinic visits and regular follow-up, some into adulthood, to identify genetic variants and biomarkers underlying childhood obesity and its metabolic consequences." [] {IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT04491344", IAO:0000119="PMID:41168416", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:37465325"}
