property_value: coho:numberOfParticipants "1727" xsd:integer {IAO:0000116="participants (cases and controls) enrolled March 2011 to December 2014", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7902036/fullTextXML", comment="Of these initial 1,727 participants who were enrolled in this study, 56 individuals with an incomplete semiquantitative food frequency questionnaire (SQFFQ) and 15 individuals with an implausible total energy intake (< 500 or > 4,000 kcal/day) were excluded."}
property_value: IAO:0000112 "GCST90319844" xsd:string {dcterms:title="Functional Annotation and Gene Set Analysis of Gastric Cancer Risk Loci in a Korean Population.", xref="PMID:37340842", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10789951/fullTextXML", comment="For GWAS analysis, genotypes from the National Cancer Center (NCC) and an urban community of the Korean Genome Epidemiology Study (KoGES) were used."}
property_value: IAO:0000116 "The acronym Korea-NCC also denotes Korea-NCC (National Cancer Center) Colorectal Cancer Study (COHO:0001364); this term is Korea National Cancer Center gastric cancer case-control study." xsd:string

[Instance]
id: coho:COHO_0001364
name: Korea-NCC (National Cancer Center) Colorectal Cancer Study
def: "A hospital-based case-control study of colorectal cancer at the National Cancer Center in Goyang, South Korea, whose cases are patients newly diagnosed with colorectal cancer at its Center for Colorectal Cancer from 2010 and whose controls are people attending the national health check-up programme at its Center for Cancer Prevention and Detection, with lifestyle and food-frequency questionnaires and genome-wide genotyping, contributing to the Asia Colorectal Cancer Consortium's studies of genetic susceptibility to colorectal cancer." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:30529582", IAO:0000119="PMID:38514198", IAO:0000119="PMID:35765848"}
