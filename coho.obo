[Instance]
id: coho:COHO_0002159
name: NIPT PLUS cohort
def: "A cohort of pregnant women recruited in 2020 and 2021 through the pregnancy screening programme of Shenzhen Baoan Women's and Children's Hospital in Shenzhen, China, whose non-invasive prenatal testing (NIPT) was sequenced at greater depth than conventional NIPT, and whose genotypes and hospital records are used to replicate and validate genetic studies of pregnancy traits such as platelet counts, gestational thrombocytopenia and gestational diabetes." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:40325049", IAO:0000119="PMID:38064665", IAO:0000119="PMID:38372780", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11033587/supplementaryFiles"}
