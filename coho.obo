property_value: IAO:0000112 "PMID:23599335" xsd:string {dcterms:title="Copy number variation at chromosome 5q21.2 is associated with intraocular pressure.", xref="PMID:23599335", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23599335+AND+SRC%3AMED&format=json&resultType=core", comment="The Australian Twin Eye Study and BMES both replicated the 5q21.2 CNV association and direction of effect (P = 0.001 and P = 0.02, respectively)."}

[Instance]
id: coho:COHO_0001500
name: AtheroGene Registry
def: "A prospective clinical cohort of patients with coronary artery disease (at least one coronary stenosis over 30% on angiography), from stable angina to acute coronary syndromes, enrolled in successive phases from November 1996 to early 2004 when they underwent coronary angiography at the Department of Medicine II of the Johannes Gutenberg University Mainz or the Bundeswehrzentralkrankenhaus Koblenz, Germany, and followed for cardiovascular death and non-fatal myocardial infarction. It studies clinical, genetic and laboratory determinants of the progression and outcome of coronary atherosclerosis, and for genetic case–control analyses also recruited healthy controls from the Rhein-Main area." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32321351", IAO:0000119="PMID:19495570", IAO:0000119="PMID:23136988", IAO:0000119="PMID:26154343"}
synonym: "AtheroGene" RELATED OMO:0003000 []
