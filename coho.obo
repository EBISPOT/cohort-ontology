relationship: coho:has_data_collection_location http://dbpedia.org/resource/France {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6910937/fullTextXML", comment="Patients and their related donors analyzed in this study underwent an allogeneic HSCT in Saint Louis hospital, Paris, France (cohort 1, n = 43) or in one of the 33 French national transplant centers involved in CRYOSTEM Consortium, funded under the French Government’s National Investment Program (Investissement d’avenir) (cohort 2, n = 56)."}
property_value: coho:numberOfParticipants "5900" xsd:integer {IAO:0000116="transplant recipients sampled up to the end of collection on 31 December 2021 (the source says 'more than 5,900'), besides 2,400 donors", xref="https://www.cryostem.org/en/about-cryostem/", comment="Today, this national collective has made it possible to constitute a collection rich in the biological resources of 82% of transplanted patients in France, i.e. nearly 200,000 biological samples taken pre- and post-transplant, from more than 5,900 patients and 2,400 donors (data as of December 31, 2021 – date of the end of collection)."}
property_value: IAO:0000112 "MTBLS205" xsd:string {dcterms:title="Metabolomics analysis of human acute graft-versus-host disease reveals changes in host and microbiota-derived metabolites.", xref="PMID:31836702", xref="https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS205", comment="A first monocentric cohort from Saint Louis hospital (Paris, France) was used as an exploratory cohort (n=43) and a second multicentric national cohort from Cryostem biobank was used as a confimatory cohort (n=56).Metabolomic profile markedly differed between recipients and donors."}

