property_value: coho:numberOfParticipants "235" xsd:integer {IAO:0000116="Gullah African Americans with type 2 diabetes examined (2004-2006)", xref="PMID:19563285", comment="A total of 235 subjects were examined; 173 (73.62%) were female and 62 (26.38%) male."}
property_value: IAO:0000112 "PMID:34008864" xsd:string {dcterms:title="Genetic landscape of Gullah African Americans.", xref="PMID:34008864", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8286328/fullTextXML", comment="Participants from three SIFP projects were included in our study: the Sea Island Genetic African American Registry (Project SuGAR) (Divers et al., 2010); the Center of Biomedical Research Excellence (COBRE) for Oral Health pilot project, “An Epidemiological Study of Periodontal Disease and Diabetes: Cytokine Genes and Inflammation Factors” (Fernandes et al., 2009); and the Systemic Lupus Erythematosus in Gullah Health (SLEIGH) Study (Kamen et al., 2008)."}

[Instance]
id: coho:COHO_0001602
name: Copenhagen Cardiovascular Genetic study
def: "A biobank of whole blood left over from the clinical care of patients admitted in 2010–2017 to six cardiology departments in the Capital Region of Denmark, around Copenhagen. The samples are linked to Danish clinical registries such as the Eastern Danish Heart Registry, and genotyped subsets of the patients, for example those who underwent coronary angiography in 2010–2014, are used to study the genetics of coronary artery disease, heart failure and other cardiovascular disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:30566436", IAO:0000119="PMID:30726294", IAO:0000119="PMID:34143812", IAO:0000119="PMID:34480422"}
