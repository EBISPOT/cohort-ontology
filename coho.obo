property_value: IAO:0000112 "PMID:25748612" xsd:string {dcterms:title="Genetic risk, coronary heart disease events, and the clinical benefit of statin therapy: an analysis of primary and secondary prevention trials.", xref="PMID:25748612", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4608367/unicode", comment="CARE was a secondary-prevention trial that investigated the clinical benefit of pravastatin 40 mg daily versus placebo in individuals with prior MI who had total cholesterol ≤240 mg/dL and LDL cholesterol between 115 and 174 mg/dL."}
property_value: IAO:0000116 "The acronym CARE also denotes Los Angeles component of The Womens Contraceptive and Reproductive Experiences Study (COHO:0000110), Canadian Airways Research Group (COHO:0000229), Childhood Asthma Research and Education Network (COHO:0001570) and Candidate Gene Association Resource (COHO:0001586); this term is Cholesterol and Recurrent Events." xsd:string

[Instance]
id: coho:COHO_0001570
name: Childhood Asthma Research and Education Network
def: "A paediatric asthma clinical research network created in 1999 by the US National Heart, Lung, and Blood Institute, made up of five clinical centres (University of California, San Diego; University of Arizona, Tucson; Washington University, St. Louis; University of Wisconsin, Madison; National Jewish Medical and Research Center, Denver) and a data coordinating centre at Penn State University, Hershey, to evaluate new and existing asthma therapies in children through multicentre randomised clinical trials. Its trial cohorts include the Prevention of Early Asthma in Kids (PEAK) trial in preschool children at high risk of asthma and the CLIC and PACT trials in school-aged children with mild-to-moderate persistent asthma." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:15157730", IAO:0000119="PMID:17141853"}
synonym: "CARE" RELATED OMO:0003000 []
