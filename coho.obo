[Instance]
id: coho:COHO_0001336
name: GENetics of SEPsis-induced ARDS Network
def: "A multicentre observational cohort of adult patients of European ancestry with sepsis of any cause admitted to a network of intensive care units in Spain, recruited through the GEN-SEP Network of Spanish investigators in two periods (2002–2015 and 2016–2019) and followed for the development of acute respiratory distress syndrome and for 28-day survival, whose DNA is used in genetic studies of sepsis-associated ARDS and sepsis outcomes." [] {IAO:0000119="PMID:41033104", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29987654", IAO:0000119="PMID:36335405"}
subset: coho1:GWAS_subset
synonym: "GEN-SEP" RELATED OMO:0003000 []
synonym: "GEN-SEP Network" RELATED []
synonym: "Genetics of Sepsis Network" RELATED []
synonym: "Genetics of Sepsis-induced ARDS Network" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Spain {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12516505/supplementaryFiles", comment="GEN-SEP is a multicentre, observational study conducted in a Spanish network of ICUs comprising adult patients with all-cause sepsis of European ancestry recruited in two periods (in 2002-2015 and in 2016-2019) (Hernandez-Beeftink et al., 2022)."}
property_value: coho:numberOfCases "304" xsd:integer {IAO:0000116="sepsis patients in the 2025 ARDS GWAS (analysed subset; 304 with ARDS, 501 without)", xref="PMID:41033104", comment="We included a total of 805 patients from the GEN-SEP cohort (304 ARDS cases and 501 at-risk controls), 740 patients from SepNet (91 ARDS cases and 649 at-risk controls), and 3570 patients from UKBB (321 ARDS cases and 3249 at-risk controls)."}
property_value: coho:numberOfControls "501" xsd:integer {IAO:0000116="sepsis patients in the 2025 ARDS GWAS (analysed subset; 304 with ARDS, 501 without)", xref="PMID:41033104", comment="We included a total of 805 patients from the GEN-SEP cohort (304 ARDS cases and 501 at-risk controls), 740 patients from SepNet (91 ARDS cases and 649 at-risk controls), and 3570 patients from UKBB (321 ARDS cases and 3249 at-risk controls)."}
property_value: coho:numberOfParticipants "805" xsd:integer {IAO:0000116="sepsis patients in the 2025 ARDS GWAS (analysed subset; 304 with ARDS, 501 without)", xref="PMID:41033104", comment="We included a total of 805 patients from the GEN-SEP cohort (304 ARDS cases and 501 at-risk controls), 740 patients from SepNet (91 ARDS cases and 649 at-risk controls), and 3570 patients from UKBB (321 ARDS cases and 3249 at-risk controls)."}
property_value: IAO:0000112 "GCST90700332" xsd:string {dcterms:title="Genome-wide association study of susceptibility to acute respiratory distress syndrome.", xref="PMID:41033104", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12516505/fullTextXML", comment="We performed a GWAS meta-analysis on 5115 critically ill patients, 82.8% with severe infections, comprising 716 ARDS cases and 4399 at-risk controls from three independent studies (Fig. 1, Table S1): the GENetics of SEPsis-induced ARDS Network (GEN-SEP), the Critical Care Trials Group of the German Sepsis Competence Network (SepNet), and UK Biobank (UKBB)."}

[Instance]
id: coho:COHO_0001337
name: Genetics of Early Onset Stroke Study
def: "A population-based case–control study of early-onset ischaemic stroke, run from the University of Maryland, Baltimore, that recruited women and men aged 15–49 with a first ischaemic stroke, identified by discharge surveillance at 59 hospitals of the greater Baltimore–Washington area of the United States and by referral from regional neurologists, in four periods between 1992 and 2008, together with controls without stroke found by random-digit dialling and matched on age and region of residence, in a biracial sample of European American and African American participants; it was designed to identify the genetic determinants of early-onset ischaemic stroke and their interactions with environmental risk factors." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:23459313", IAO:0000119="https://cdn-links.lww.com/permalink/wnl/c/wnl_2022_08_08_mitchell_1_sdc1.pdf", IAO:0000119="PMID:38094903"}
