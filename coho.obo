property_value: IAO:0000112 "GCST90090980" xsd:string {dcterms:title="Identification of novel breast cancer susceptibility loci in meta-analyses conducted among Asian and European descendants.", xref="PMID:32139696", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7057957/supplementaryFiles", comment="This study also contributed 5,574 cases and 3,793 controls 106 for the replication study genotyped by Sequenom. 107 Seoul Breast Cancer Study (SeBCS): 108 The SeBCS is a hospital-based case-control study conducted in two teaching hospitals 109 in Seoul.9,10 Total 2,342 incident breast patients histopathologically diagnosed with 110 primary breast cancer were included in this project and they were consecutively 111 recruited between 2001 and 2007."}

[Instance]
id: coho:COHO_0000967
name: Molecular Epidemiology of non-Hodgkin lymphoma
def: "A population-based case-control study of non-Hodgkin lymphoma in the San Francisco Bay Area, California, that enrolled residents of six Bay Area counties aged 20-85 with incident non-Hodgkin lymphoma diagnosed from 2001 through 2006, identified through the cancer registry by rapid case ascertainment, and controls found by random-digit dialling and from Medicare lists, frequency-matched to the cases on age, sex and county, with in-person interviews, blood or buccal specimens and expert re-review of the cases' pathology." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:18636124", IAO:0000119="PMID:25133503"}
