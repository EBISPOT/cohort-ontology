relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/France
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Italy {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17989723+AND+SRC%3AMED&format=json&resultType=core", comment="Population pools of 1.6, 2.3 and 2.0 million inhabitants were screened, respectively, in Denmark, France and Italy to identify families matching the design requirements."}
property_value: coho:numberOfParticipants "598" xsd:integer {IAO:0000116="long-lived probands (aged 90+) in the handgrip analysis; analysed subset, probands only (2006)", xref="PMID:16870633", comment="Among 598 very old people (median age = 98 years) a clear North-South gradient was observed:"}
property_value: IAO:0000112 "GCST90726611" xsd:string {dcterms:title="Genetic associations with longevity in a Calabrian cohort: an exploratory genome-wide study.", xref="PMID:42176242", xref="https://link.springer.com/article/10.1007/s11357-026-02334-4", comment="The oldest subjects (90-plus individuals) were enrolled in two European projects investigating genetic and environmental factors associated with aging: the European Challenge for Healthy Aging (ECHA) project [24] and the GEnetics of Healthy Ageing (GEHA) project [25]."}

[Instance]
id: coho:COHO_0001318
name: Pittsburgh Epidemiology of Diabetes Complications Study
def: "A prospective cohort study of people with childhood-onset type 1 diabetes (onset before age 17) who were diagnosed, or seen within a year of diagnosis, at Children's Hospital of Pittsburgh between 1950 and 1980, followed since a baseline examination in 1986–1988 with biennial examinations and questionnaires for ten years and later questionnaires and examinations, to ascertain the incidence of and risk factors for complications of type 1 diabetes." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:37533055", IAO:0000119="PMID:22851572", IAO:0000119="PMID:39932735"}
subset: coho1:GWAS_subset
synonym: "EDC" RELATED OMO:0003000 []
synonym: "Epidemiology of Diabetes Complications study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3478551/fullTextXML", comment="The Pittsburgh Epidemiology of Diabetes Complications (EDC) study cohort provides a unique opportunity to examine mortality and life-expectancy changes over time in a U.S. cohort with long-term (>30 years) follow-up, because the participants were all diagnosed with childhood-onset type 1 diabetes between 1950 and 1980."}
property_value: coho:numberOfParticipants "658" xsd:integer {IAO:0000116="participants examined at the 1986-1988 baseline", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11932817/fullTextXML", comment="All participants (n = 658) were diagnosed with type 1 diabetes, or seen within 1 year of their diagnosis, at Children’s Hospital of Pittsburgh between 1950 and 1980."}
property_value: IAO:0000112 "GCST90662914" xsd:string {dcterms:title="Genetics of C-Peptide and Age at Diagnosis in Type 1 Diabetes.", xref="PMID:39556808", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11755686/fullTextXML", comment="A meta-GWAS of AAD was performed that comprised all studies included in the C-peptide meta-GWAS plus the Pittsburgh Epidemiology of Diabetes Complications (EDC) study (22)."}

[Instance]
id: coho:COHO_0001319
name: Scottish AMD study
def: "A clinic-based case-control study of age-related macular degeneration in Scotland, collected by a group in Edinburgh with funding from the Chief Scientist Office (Scotland), whose cases with advanced or intermediate AMD and controls were ascertained by fundus examination or photography; its cases and controls replicated the association of complement C3 with AMD and were contributed to the International AMD Genomics Consortium's genome-wide association study." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:26691988", IAO:0000119="PMID:17634448"}
subset: coho1:GWAS_subset
synonym: "Edinburgh" RELATED OMO:0003000 []
