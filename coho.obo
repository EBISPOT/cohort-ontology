relationship: coho:has_data_collection_location http://dbpedia.org/resource/Japan {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11834036/fullTextXML", comment="The ROAD study was a prospective investigation of OA conducted among population-based cohorts in various cities across Japan."}
property_value: coho:numberOfParticipants "3040" xsd:integer {IAO:0000116="residents enrolled at the baseline survey in three communities (2005-2007)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11834036/fullTextXML", comment="We initially enrolled 3040 participants (1061 men and 1979 women; mean age 70.3 years; range 23–95 years) during the baseline period and have since conducted multiple follow-up surveys since 2005."}
property_value: IAO:0000112 "PMID:39968102" xsd:string {dcterms:title="Trends in knee osteoarthritis prevalence over a 10-year period in Japan: The ROAD study 2005-2015.", xref="PMID:39968102", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11834036/fullTextXML", comment="This study aimed to reveal trends in the prevalence and distribution of knee OA and symptomatic knee OA using cohorts from the ROAD study at the baseline survey and the fourth survey, which was conducted 10 years after the initial survey."}

[Instance]
id: coho:COHO_0002326
name: Partners/Roche Cohort
def: "An observational study of patients with diabetes mellitus and of non-diabetic controls with no personal or first-degree family history of diabetes and with normal fasting glucose, recruited and evaluated by the Diabetes Center of Massachusetts General Hospital and the Division of Endocrinology and Metabolism of Brigham and Women's Hospital in Boston, United States, and assembled with support from Roche; its participants were genotyped for glycaemic-trait and type 2 diabetes association studies of the MAGIC consortium." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24296717", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.521/MediaObjects/41588_2010_BFng521_MOESM16_ESM.pdf", IAO:0000119="PMID:19465013"}
