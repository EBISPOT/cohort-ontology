[Instance]
id: coho:COHO_0002000
name: Long Island Breast Cancer Study Project
def: "A federally mandated, population-based case-control study of breast cancer among women living in Nassau and Suffolk counties on Long Island, New York, United States, whose cases were newly diagnosed with a first primary in situ or invasive breast cancer between August 1996 and July 1997; cases and controls were interviewed and gave blood and urine, and long-term residents gave household dust, soil and water samples, to determine whether breast cancer risk is associated with environmental exposures, and the cases were later followed up to study prognosis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:12206514", IAO:0000119="PMID:35010632"}
subset: coho1:PGS_subset
synonym: "LI" RELATED OMO:0003000 []
synonym: "LIBCSP" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8751127/fullTextXML", comment="Breast cancer cases were women from the Nassau and Suffolk Counties on Long Island, New York with newly diagnosed first primary in situ or invasive breast cancer between 1 August 1996 and 31 July 1997"}
property_value: coho:numberOfCases "1508" xsd:integer {IAO:0000116="interviewed breast cancer cases and population controls; no total stated (1996-1997)", xref="https://link.springer.com/content/pdf/10.1023/A:1016387020854.pdf", comment="The main questionnaire was completed by 1,508 (82.1%) of eligible case women (n=235 with in situ and 1,273 with invasive breast cancer) and 1,556 (62.7%) of eligible control women (Table 1)."}
property_value: coho:numberOfControls "1556" xsd:integer {IAO:0000116="interviewed breast cancer cases and population controls; no total stated (1996-1997)", xref="https://link.springer.com/content/pdf/10.1023/A:1016387020854.pdf", comment="The main questionnaire was completed by 1,508 (82.1%) of eligible case women (n=235 with in situ and 1,273 with invasive breast cancer) and 1,556 (62.7%) of eligible control women (Table 1)."}
property_value: IAO:0000112 "PGS000351" xsd:string {dcterms:title="Polygenic risk scores and breast and epithelial ovarian cancer risks for carriers of BRCA1 and BRCA2 pathogenic variants.", xref="PMID:32665703"}
property_value: IAO:0000112 "PMID:12206514" xsd:string {dcterms:title="The Long Island Breast Cancer Study Project: description of a multi-institutional collaboration to identify environmental risk factors for breast cancer.", xref="PMID:12206514", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12206514+AND+SRC%3AMED&format=json&resultType=core", comment="The Long Island Breast Cancer Study Project is a federally mandated, population-based case-control study to determine whether breast cancer risk among women in the counties of Nassau and Suffolk, NY, is associated with selected environmental exposures, assessed by blood samples, self-reports, and environmental home samples."}

[Instance]
id: coho:COHO_0002001
name: LIFE Child Study
def: "A population-based prospective longitudinal cohort study of children and adolescents in the city of Leipzig, Germany, run since July 2011 by the Leipzig Research Centre for Civilization Diseases (LIFE) at Leipzig University, made up of a birth cohort recruited in pregnancy, a health cohort and an obesity cohort, whose participants have repeated medical, psychological and sociodemographic assessments and give biological samples from fetal life to adulthood, to monitor normal growth, development and health and to study non-communicable diseases such as childhood obesity, atopy and mental health problems." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28144813", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3533937/fullTextXML"}
