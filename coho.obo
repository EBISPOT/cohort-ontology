[Instance]
id: coho:COHO_0001185
name: Hwasun Cancer Epidemiology Study-Breast
def: "The breast cancer arm of the Hwasun Cancer Epidemiology Study, a hospital-based case-control study at Chonnam National University Hwasun Hospital, a cancer hospital in Jeollanam-do province, South Korea, that aims to identify factors in cancer development and clinical progression in a Korean population. Its cases are women newly diagnosed with breast cancer at the hospital from April 2004 to February 2013, excluding secondary or recurrent tumours, and its controls are women with no previous cancer drawn at random from the Namwon Study and the Dong-gu Study, community-based cohorts in South Korea." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32139696"}
subset: coho1:GWAS_subset
