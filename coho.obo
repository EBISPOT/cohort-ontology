[Instance]
id: coho:COHO_0001136
name: Colonomics
def: "A multi-omics colon cancer study run by the Catalan Institute of Oncology of patients with microsatellite-stable stage II colon adenocarcinoma who had radical surgery without adjuvant therapy at Bellvitge University Hospital (Barcelona, Spain) in 1996-2000 and were selected in 2012; their tumour and paired adjacent normal mucosa, with colon mucosa from healthy donors undergoing colonoscopy as reference, were profiled for gene expression, DNA methylation, SNPs, copy number and miRNAs to find diagnostic and prognostic biomarkers of colorectal cancer." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:36182938", IAO:0000119="https://www.colonomics.org/home/team/"}
subset: coho1:GWAS_subset
synonym: "CLX" RELATED OMO:0003000 []
synonym: "COLONOMICS" RELATED []
instance_of: coho:COHO_0000000 ! cohort
