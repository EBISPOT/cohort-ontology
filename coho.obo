[Instance]
id: coho:COHO_0001556
name: Amagasaki Study
def: "An ongoing population-based cohort of people aged over 18 years in Amagasaki, Hyogo Prefecture, Japan, consecutively enrolled for a baseline examination between September 2002 and August 2003, which is one of the member studies of the Cardio-metabolic Genome Epidemiology (CAGE) Network and whose samples are used in genetic studies of blood pressure, lipids and other cardiometabolic traits." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fng.834/MediaObjects/41588_2011_BFng834_MOESM19_ESM.pdf", IAO:0000119="PMID:26648100", IAO:0000119="PMID:23050023"}
