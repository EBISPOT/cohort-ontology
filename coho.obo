property_value: coho:numberOfParticipants "500" xsd:integer {IAO:0000116="patients with well-controlled asthma randomised in the trial", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17507702+AND+SRC%3AMED&format=json&resultType=core", comment="We randomly assigned 500 patients with asthma that was well controlled by inhaled fluticasone (100 microg twice daily) to receive continued fluticasone (100 microg twice daily) (169 patients), montelukast (5 or 10 mg each night) (166 patients), or fluticasone (100 microg) plus salmeterol (50 microg) each night (165 patients)."}
property_value: IAO:0000112 "PGS000769" xsd:string {dcterms:title="Pharmacogenetic Polygenic Risk Score for Bronchodilator Response in Children and Adolescents with Asthma: Proof-of-Concept.", xref="PMID:33923870"}
