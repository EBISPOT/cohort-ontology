property_value: coho:numberOfParticipants "4867" xsd:integer {IAO:0000116="subjects of all ages surveyed in 2010-2011 (adults, children, adolescents and mothers)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4509523/fullTextXML", comment="The children’s samples were pair collected with the mothers (whenever possible).During 2010 and 2011, 4867 subjects were surveyed."}
