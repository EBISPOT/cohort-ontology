[Instance]
id: coho:COHO_0002595
name: International Consortium on the Genetics of Heroin Dependence
def: "A collaboration of Australian and American investigators to identify genes associated with liability for heroin dependence, using a case–control design in which cases met lifetime DSM-IV criteria for heroin dependence and controls were assessed individuals without heroin dependence or unassessed general population controls, with cases and controls drawn from several investigations including the Comorbidity and Trauma Study, Heroin Dependence in Western Australia, the OZ-ALC Study, a twin study of mole development in adolescence and genetic studies of substance dependence at Yale; its data, collected from 2004 to 2009, are held in dbGaP as phs000277." [] {IAO:0000119="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v2.p1", IAO:0000119="PMID:27028160", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09"}
synonym: "ICGHD" RELATED OMO:0003000 []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:hasCohort coho:COHO_0000841 {xref="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v2.p1", comment="This collaboration of Australian and American investigators aims to identify genes associated with liability for heroin dependence. The project uses a case-control design in which cases met lifetime DSM-IV criteria for heroin dependence. Controls included assessed individuals who did not meet DSM-IV heroin dependence criteria and unassessed general population controls. Cases and controls were obtained from the several large investigations including: The Comorbidity and Trauma Study, Heroin Dependence in Western Australia, the OZ-ALC Study, a Twin Study of Mole Development in Adolescence, and ongoing genetic studies of substance dependence conducted by investigators at Yale and collaborating institutions."}
relationship: coho:hasCohort coho:COHO_0001573 {xref="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v2.p1", comment="This collaboration of Australian and American investigators aims to identify genes associated with liability for heroin dependence. The project uses a case-control design in which cases met lifetime DSM-IV criteria for heroin dependence. Controls included assessed individuals who did not meet DSM-IV heroin dependence criteria and unassessed general population controls. Cases and controls were obtained from the several large investigations including: The Comorbidity and Trauma Study, Heroin Dependence in Western Australia, the OZ-ALC Study, a Twin Study of Mole Development in Adolescence, and ongoing genetic studies of substance dependence conducted by investigators at Yale and collaborating institutions."}
relationship: coho:hasCohort coho:COHO_0001896 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5656555/", comment="The ICGHD data set consisted of three subsets (CIDR: Center for Inherited Disease Research; RATRP: Research on Alcohol and Tobacco Related Phenotypes; and ARC: Alcohol Related Conditions) that were genotyped using three different arrays."}
relationship: coho:hasCohort coho:COHO_0001897 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5656555/", comment="The ICGHD data set consisted of three subsets (CIDR: Center for Inherited Disease Research; RATRP: Research on Alcohol and Tobacco Related Phenotypes; and ARC: Alcohol Related Conditions) that were genotyped using three different arrays."}
relationship: coho:hasCohort coho:COHO_0001898 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5656555/", comment="The ICGHD data set consisted of three subsets (CIDR: Center for Inherited Disease Research; RATRP: Research on Alcohol and Tobacco Related Phenotypes; and ARC: Alcohol Related Conditions) that were genotyped using three different arrays."}
