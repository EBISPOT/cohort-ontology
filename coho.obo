[Instance]
id: coho:COHO_0001737
name: Framingham Offspring Study
def: "A community-based cohort of offspring and spouses of the original Framingham Heart Study participants, recruited from 1971 to study cardiovascular disease and the familial clustering of its risk factors, followed with repeated in-person examinations and telephone contacts." [] {IAO:0000119="PMID:474565", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35880530", dcterms:contributor="Claude Sonnet 5 (Anthropic), 2026-09", IAO:0000119="PMID:37536150"}
