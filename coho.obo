property_value: IAO:0000112 "PMID:20972440" xsd:string {dcterms:title="Meta-analysis of three genome-wide association studies identifies susceptibility loci for colorectal cancer at 1q41, 3q26.2, 12q13.13 and 20q13.33.", xref="PMID:20972440", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5098601/fullTextXML", comment="We therefore directly proceeded to a combined analysis of the three GWA studies, comprising UK1/CORGI and Scotland1/COGS in addition to VQ58 (Supplementary Table 1)."}

