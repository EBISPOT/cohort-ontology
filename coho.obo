relationship: coho:has_data_collection_location http://dbpedia.org/resource/Brazil {xref="https://europepmc.org/abstract/MED/26124090", comment="three populations with different histories from the Northeast (African ancestry: 50%), Southeast, and South (both with European ancestry >70%) of Brazil"}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/SouthAmerica
relationship: coho:hasCohort coho:COHO_0000739 {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9952852/unicode", comment="We performed admixture mapping (followed by fine-mapping) of BMI using data of ~2.3 million SNPs for three Brazilian population-based cohorts, from Northeast (Salvador), Southeast (Bambuí), and South (Pelotas), with distinct admixture and socio-demographic backgrounds, studied by the EPIGEN-Brazil Initiative (https://epigen.grude.ufmg.br,)."}
relationship: coho:hasCohort coho:COHO_0001286 {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9952852/unicode", comment="We performed admixture mapping (followed by fine-mapping) of BMI using data of ~2.3 million SNPs for three Brazilian population-based cohorts, from Northeast (Salvador), Southeast (Bambuí), and South (Pelotas), with distinct admixture and socio-demographic backgrounds, studied by the EPIGEN-Brazil Initiative (https://epigen.grude.ufmg.br,)."}
relationship: coho:hasCohort coho:COHO_0001402 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4669662/fullTextXML", comment="The SCAALA composes the EPIGEN-Brazil initiative, it is based on three well-defined ongoing population-based cohorts from Brazil’s regions"}
property_value: coho:numberOfParticipants "6487" xsd:integer {IAO:0000116="genotyped individuals from the three member cohorts in the flagship 2015 analysis", xref="PMID:26124090", comment="A population-based genome-wide analysis of 6,487 individuals was performed in the context of worldwide genomic diversity to elucidate how ancestry, kinship, and inbreeding interact in three populations with different histories from the Northeast (African ancestry: 50%), Southeast, and South (both with European ancestry >70%) of Brazil."}
property_value: IAO:0000112 "EGAS00001001245" xsd:string {dcterms:title="Origin and dynamics of admixture in Brazilians and its effect on the pattern of deleterious mutations.", xref="PMID:26124090", xref="https://ega-archive.org/studies/EGAS00001001245", comment="The EPIGEN-Brasil Initiative is so far the largest Latin American initiative in population genomics and genetic epidemiology."}
property_value: IAO:0000112 "GCST011890" xsd:string {dcterms:title="Trans-ethnic meta-analysis identifies new loci associated with longitudinal blood pressure traits.", xref="PMID:33603002", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7893038/fullTextXML", comment="We used the genotype data (Illumina Infinium Omni2.5) from 1442 participants from the Bambui Study in the context of the EPIGEN project39."}
property_value: IAO:0000112 "PMID:26124090" xsd:string {dcterms:title="Origin and dynamics of admixture in Brazilians and its effect on the pattern of deleterious mutations.", xref="PMID:26124090", xref="https://europepmc.org/article/MED/26124090", comment="We present the results of the EPIGEN Brazil Initiative"}

