[Instance]
id: coho:COHO_0000542
name: Minnesota Center for Twin and Family Research
def: "A collection of longitudinal, community-representative twin and adoptive family studies in Minnesota, including the Minnesota Twin Registry, the Minnesota Twin Family Study, the Enrichment Study, the Adolescent Brain study and the Sibling Interaction and Behavior Study, focusing on psychological adjustment, personality, cognitive ability and brain function with an emphasis on substance use and related psychopathology." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:17254440", IAO:0000119="PMID:31796137"}
subset: coho1:GWAS_subset
