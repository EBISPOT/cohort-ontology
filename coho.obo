[Instance]
id: coho:COHO_0001980
name: Kangbuk Samsung Cohort Study
def: "A prospective cohort study of Korean adults attending health screening examinations at Kangbuk Samsung Hospital, South Korea, set up to study the natural history, prognosis and genetic and environmental determinants of a wide range of health traits and diseases, whose participants have consented since 2011 to linkage with national registries of death, cancer and medical use, and some of whom have been genotyped. It is distinct from the hospital's retrospective Kangbuk Samsung Health Study of routinely collected screening data." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf", IAO:0000119="PMID:38320993", IAO:0000119="PMID:40348730"}
