property_value: IAO:0000112 "PMID:28817493" xsd:string {dcterms:title="DNA methylation of the glucocorticoid receptor gene promoter in the placenta is associated with blood pressure regulation in human pregnancy.", xref="PMID:28817493", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28817493+AND+SRC%3AMED&format=json&resultType=core", comment="The study was performed as a nested case-control study (n = 80) out of 1045 mother/child pairs from the Berlin Birth Cohort."}

[Instance]
id: coho:COHO_0001510
name: British Breast Cancer Study
def: "A UK case-control study of breast cancer, led by investigators at the Institute of Cancer Research and the London School of Hygiene and Tropical Medicine, which in 2001–2008 recruited women with bilateral breast cancer identified through English and Scottish cancer registries and breast cancer clinics, and clinic patients with breast cancer and at least two affected female first-degree relatives, together with controls who were friends or non-blood relatives of the cases. It is one of the studies of the Breast Cancer Association Consortium." [] {IAO:0000119="PMID:16257342", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22768030", IAO:0000119="PMID:19153073", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature24284/MediaObjects/41586_2017_BFnature24284_MOESM1_ESM.pdf", IAO:0000119="PMID:26884359"}
synonym: "BBCS" RELATED OMO:0003000 []
