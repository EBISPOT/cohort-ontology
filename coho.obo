relationship: coho:has_data_collection_location http://dbpedia.org/resource/Italy {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11706450/fullTextXML", comment="For the host genetic analyses participants were recruited at 16 different sites, 15 of which were situated in Germany, and one in the German-speaking region of Italy (South Tyrol), from individual COVID-19 studies that were being conducted at the respective institutions."}
property_value: coho:numberOfParticipants "1220" xsd:integer {IAO:0000116="SARS-CoV-2-positive individuals with WGS after quality control", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11706450/fullTextXML", comment="These analyses comprehensively characterize the joint contribution of variants of the entire allelic spectrum to severe COVID-19.ResultsThe DeCOI cohortFollowing quality control (see Methods), the DeCOI cohort comprised 1,220 individuals from across the entire phenotypic spectrum of SARS-CoV-2 infections (Figs 1A–1C and S1)."}
