[Instance]
id: coho:COHO_0002639
name: Prevention Cube
def: "An occupational cohort of the employees of employers in Belgium that chose IDEWE as their External Service for Prevention and Protection at Work, followed from 1993 through the records of their legally required occupational health surveillance. IDEWE pools the records in a data warehouse for research on work-related diseases and sector-specific health problems." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/Precube", IAO:0000119="PMID:42615545", IAO:0000119="PMID:26503980"}
