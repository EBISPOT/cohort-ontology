relationship: coho:hasCohort coho:COHO_0000966 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7057957/supplementaryFiles", comment="The SeBCS has been described above, which also contributed samples to ABCC."}
relationship: coho:hasCohort coho:COHO_0001185 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6838373/fullTextXML", comment="For studies participating in the ABCC, the BBJ1 was supported by the Ministry of Education, Culture, Sports, Sciences and Technology from the Japanese Government. The SeBCS was supported by the BRL (Basic Research Laboratory) program through the National Research Foundation of Korea, funded by the Ministry of Education, Science and Technology (2011-0001564). The biospecimens and data of the Hwasun Cancer Epidemiology Study-Breast were provided by the Biobank of Chonnam National University Hwasun Hospital, a member of the Korea Biobank Network (07SA2014020)."}
