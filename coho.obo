[Instance]
id: coho:COHO_0001170
name: Global Biobank Meta-analysis Initiative
def: "A collaborative network of biobanks and genomics initiatives, formed in 2019 by 23 biobanks from four continents (North America, Europe, East and West Asia, and Australia) and since joined by others, whose participants have genotypes linked to electronic health records or other health data. Member biobanks run genome-wide association studies with harmonised phenotype definitions and methods, stratified by ancestry and sex, and GBMI meta-analyses the summary statistics across biobanks and ancestries, beginning with 14 diseases and endpoints, and releases them publicly, to increase the power and ancestral diversity of genetic studies of human disease." [] {IAO:0000119="PMID:36777996", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.globalbiobankmeta.org/parcipating-biobanks"}
subset: coho1:GWAS_subset
synonym: "GBMI" RELATED OMO:0003000 []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:hasCohort coho:COHO_0000403 {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10897632/unicode", comment="We combined the European-specific IGGC meta-analysis data (GCST90011767), the GLADD meta-analysis (GCST009245), and the GBMI data in which we excluded FinnGen (a subset present in IGGC of European ancestry), BioME from African ancestry (a subset present in GGLAD), and UKBB-Africa (a subset present in GGLAD) cohorts."}
relationship: coho:hasCohort coho:COHO_0000457 {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10897632/unicode", comment="PMBB and CCPM are part of the GBMI that joined the consortium after initial analysis of the data and have been previously described and use same phenotyping and GWAS protocols as other GBMI biobanks."}
relationship: coho:hasCohort coho:COHO_0000482 {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10897632/unicode", comment="PMBB and CCPM are part of the GBMI that joined the consortium after initial analysis of the data and have been previously described and use same phenotyping and GWAS protocols as other GBMI biobanks."}
property_value: coho:numberOfParticipants "2200000" xsd:integer {IAO:0000116="participants with genotypes and health data across the 23 member biobanks of the flagship project (as of April 2022)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9903716/fullTextXML", comment="GBMI represents 2.2 million research participants with health and genetic data from 23 biobanks: one from Australia, one from West Asia, four from East Asian countries, eight from European countries, and nine from North America."}
property_value: IAO:0000112 "GCST90308666" xsd:string {dcterms:title="Multi-ancestry meta-analysis identifies 5 novel loci for ischemic stroke and reveals heterogeneity of effects between sexes and ancestries.", xref="PMID:37601974", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37601974+AND+SRC%3AMED&format=json&resultType=core", comment="We performed a genome-wide meta-analysis of 16 biobanks across multiple ancestries to study the genetics of ischemic stroke (60,176 cases, 1,310,725 controls) as part of the Global Biobank Meta-analysis Initiative (GBMI) and further combined the results with previously published MegaStroke."}

[Instance]
id: coho:COHO_0001171
name: Treatment program of DLBCL patients from the Groupe d'Etude des Lymphomes de l'Adulte
def: "Patients with diffuse large B-cell lymphoma (DLBCL) enrolled in the LNH03 (LNH 2003) programme of treatment trials of the Groupe d'Etude des Lymphomes de l'Adulte (GELA, later the Lymphoma Study Association, LYSA), who consented to DNA analysis. The programme's trials, opened from December 2003 at centres mainly in France and Belgium for patients of different ages and prognostic risk, were the randomised trials LNH03-1B, LNH03-2B and LNH03-6B, the phase 2 trial LNH03-3B, LNH03-39B and a phase 2 trial of R-miniCHOP in patients over 80. The patients' germline DNA was genotyped as the case series of GELA's genome-wide association study of DLBCL, with controls drawn from the French component of EPIC." [] {IAO:0000119="PMID:23578722", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:25261932", IAO:0000119="PMID:21482186", IAO:0000119="PMID:22118442", IAO:0000119="PMID:36273105", IAO:0000119="PMID:21546499", IAO:0000119="PMID:23235801"}
