relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
property_value: coho:numberOfParticipants "3061" xsd:integer {IAO:0000116="Han Chinese adults aged 30 or over taking part in the 2010 survey, all genotyped", xref="https://pmc.ncbi.nlm.nih.gov/articles/instance/3972802/bin/NIHMS514903-supplement-1.docx", comment="A total of 3,061 individuals who were ≥30 years of age, of Han ethnicity, had no evidence of end organ damage, chronic renal disease, tumors, or urinary tract infections were selected to participate in the study."}
property_value: IAO:0000112 "PMID:24001895" xsd:string {dcterms:title="Genome-wide association study meta-analysis reveals transethnic replication of mean arterial and pulse pressure loci.", xref="PMID:24001895", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3972802/", comment="Suzhou Study 3,061 Chinese Standard mercury sphygmomanometer, 2 54.2 (10.5) 61.7 24.8 (3.6) 134.2 (19.8) 86.4 (10.2) 70.5 (9.9) 47.8 (14.3) 47.2 27.5"}

[Instance]
id: coho:COHO_0002421
name: Shanghai-Vanderbilt Colorectal Cancer Genetic Project
def: "A colorectal cancer case-control study nested in two population-based cohorts in urban Shanghai, China, the Shanghai Women's Health Study and the Shanghai Men's Health Study, whose cases were colorectal cancer patients identified among the cohorts' participants and whose controls were cancer-free participants of the same cohorts frequency-matched to the cases by age and sex. Its samples, with additional community controls from the Shanghai Breast Cancer Study, were genotyped as the Shanghai-1 and Shanghai-2 sets of the discovery stage of the Asia Colorectal Cancer Consortium's genome-wide association study." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:23263487", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2505/MediaObjects/41588_2013_BFng2505_MOESM12_ESM.pdf"}
synonym: "Shanghai-Vanderbilt Colorectal Cancer Genetics Project" RELATED []
synonym: "SVCRCGP" RELATED OMO:0003000 []
