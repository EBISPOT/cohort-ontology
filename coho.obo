property_value: IAO:0000112 "GCST90000048" xsd:string {dcterms:title="Identification of 371 genetic variants for age at first sex and birth linked to externalising behaviour.", xref="PMID:34211149", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7612120/fullTextXML", comment="Authors in the Human Reproductive Behaviour Consortium contributed the valuable data, conducted cohort specific GWAS and other analyses, and contributed through the administration, management, and data collection for the participating cohorts."}

[Instance]
id: coho:COHO_0001447
name: SerGenCovid-19
def: "A cohort of adult volunteers living across Italy, selected by the Italian National Research Council (CNR) from respondents to its EPICOVID-19 web survey who had agreed to be recontacted, who completed an online health and lifestyle questionnaire and gave blood at collection centres in several Italian regions, with repeat sampling about 5 and 10 months later, between May 2021 and February 2022. It was set up to study the serological and genetic factors in the immune response to SARS-CoV-2 infection and COVID-19 vaccination and in susceptibility to infection, and to build a serum and DNA biobank." [] {IAO:0000119="https://www.irib.cnr.it/progetti/virus-memory/", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:41659846", IAO:0000119="https://www.cnr.it/it/comunicato-stampa/10010/parte-il-progetto-sergen-covid-19"}
subset: coho1:GWAS_subset
synonym: "SerGen-Covid-19" RELATED OMO:0003000 []
