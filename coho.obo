property_value: IAO:0000112 "GCST001153" xsd:string {dcterms:title="European genome-wide association study identifies SLC14A1 as a new urinary bladder cancer susceptibility gene.", xref="PMID:21750109", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3188988/", comment="The Dutch patients were recruited for the Nijmegen Bladder Cancer Study (NBCS: http://dceg.cancer.gov/icbc/membership.html)."}
property_value: IAO:0000112 "PMID:25429525" xsd:string {dcterms:title="Recurrent urinary tract infection and risk of bladder cancer in the Nijmegen bladder cancer study.", xref="PMID:25429525", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML", comment="In this study, we analysed data of the Nijmegen Bladder Cancer Study (NBCS), one of the largest case–control studies for UBC worldwide, as to gain better insights into the role of recurrent infections of the (lower) urinary tract as a risk factor for UBC."}
