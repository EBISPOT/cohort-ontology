[Instance]
id: coho:COHO_0001936
name: International Studies of Infarct Survival
def: "The programme of the International Studies of Infarct Survival (ISIS) collaborative group, which ran large randomised trials of treatments for suspected acute myocardial infarction (ISIS-1 to ISIS-4) through collaborating hospitals, and its case-control study in more than 100 UK hospitals, in which blood was taken from ISIS-3 patients on admission and, in the early 1990s, surviving patients of the ISIS-3 and ISIS-4 trials aged 30-79, their siblings and children, and those relatives' spouses, who served as controls, completed postal questionnaires on smoking and other habits and were asked for blood, for studies of smoking, blood markers and genetic variants in relation to the risk of non-fatal myocardial infarction." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:16839190", IAO:0000119="PMID:1746418", IAO:0000119="PMID:19567438", IAO:0000119="PMID:7647641"}
synonym: "International Study of Infarct Survival" RELATED []
synonym: "ISIS" RELATED OMO:0003000 []
synonym: "ISIS case-control study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1487176/fullTextXML", comment="The chief acknowledgement for the ISIS study is to the patients and their relatives who collaborated, to their general practitioners, and to the medical and nursing staff from more than 100 hospitals in the UK."}
property_value: coho:numberOfCases "13926" xsd:integer {IAO:0000116="UK survivors of myocardial infarction from the ISIS-3 and ISIS-4 trials (cases) and their relatives (controls) who returned the case-control study's postal questionnaires in the early 1990s", xref="https://www.bmj.com/content/311/7003/471", comment="In the early 1990s responses to a postal questionnaire were obtained from 13926 survivors of myocardial infarction (cases) recently discharged from hospitals in the United Kingdom and 32389 of their relatives (controls)."}
property_value: coho:numberOfControls "32389" xsd:integer {IAO:0000116="UK survivors of myocardial infarction from the ISIS-3 and ISIS-4 trials (cases) and their relatives (controls) who returned the case-control study's postal questionnaires in the early 1990s", xref="https://www.bmj.com/content/311/7003/471", comment="In the early 1990s responses to a postal questionnaire were obtained from 13926 survivors of myocardial infarction (cases) recently discharged from hospitals in the United Kingdom and 32389 of their relatives (controls)."}
property_value: IAO:0000112 "PMID:16839190" xsd:string {dcterms:title="Lymphotoxin-alpha gene and risk of myocardial infarction in 6,928 cases and 2,712 controls in the ISIS case-control study.", xref="PMID:16839190", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1487176/fullTextXML", comment="We examined the association of seven single nucleotide polymorphisms (SNPs) across the LTA gene, and their related haplotypes, with risk of myocardial infarction (MI) in the International Study of Infarct Survival (ISIS) case-control study involving 6,928 non-fatal MI cases and 2,712 unrelated controls."}

