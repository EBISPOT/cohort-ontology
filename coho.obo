[Instance]
id: coho:COHO_0000779
name: EUGENE2 study
def: "A multicentre sample of healthy non-diabetic offspring of patients with type 2 diabetes, recruited in Denmark, Finland, Germany, Italy and Sweden by the European Network on Functional Genomics of Type 2 Diabetes and examined with glucose tolerance tests and hyperinsulinaemic euglycaemic clamps to study the genetics of insulin secretion and insulin sensitivity." [] {IAO:0000119="PMID:18985156", IAO:0000119="PMID:19789630", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
subset: coho1:GWAS_subset
