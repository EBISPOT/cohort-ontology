[Instance]
id: coho:COHO_0001410
name: Seoul National University Hospital Diabetes Study
def: "A case–control study of Korean patients with type 2 diabetes from the Diabetes Clinic of Seoul National University Hospital, South Korea, excluding patients positive for GAD antibodies, and of nondiabetic control subjects aged 60 or over with no history of diabetes in themselves or their first-degree relatives, used as a replication study in the Asian Genetic Epidemiology Network meta-analysis of genome-wide association studies of type 2 diabetes." [] {IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22158537"}
