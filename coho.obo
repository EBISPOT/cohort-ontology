[Instance]
id: coho:COHO_0000575
name: RIKEN Study
def: "A Japanese knee osteoarthritis case-control collection assembled at the RIKEN Center for Genomic Medicine, of about 900 symptomatic knee osteoarthritis cases diagnosed by orthopaedic surgeons from clinical and radiographic examination at several Japanese medical institutes and about 3,400 controls from BioBank Japan and Osaka volunteers, genotyped genome-wide to find knee osteoarthritis susceptibility loci." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf", IAO:0000119="PMID:20305777"}
