property_value: coho:numberOfParticipants "9018" xsd:integer {IAO:0000116="analysed subset: students screening negative or with a confirmed neurodevelopmental diagnosis, with school marks (77 schools)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41554769+AND+SRC%3AMED&format=json&resultType=core", comment="The final sample comprised 9018 participants aged 5-17."}
property_value: IAO:0000112 "GCST90568440" xsd:string {dcterms:title="Genome-wide association meta-analysis of childhood ADHD symptoms and diagnosis identifies new loci and potential effector genes.", xref="PMID:40962958", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02295-y/MediaObjects/41588_2025_2295_MOESM1_ESM.pdf", comment="The INSchool cohort consist of 3, 557 children from 23 schools in Catalonia (age range: 5-17 years; 234 mean age: 9.8 years, s.d.=2.9)."}

[Instance]
id: coho:COHO_0001195
name: Japanese Consortium for Amyotrophic Lateral Sclerosis research
def: "A multicentre patient registry established in Japan in 2006 to register and follow up patients with amyotrophic lateral sclerosis across many participating institutions, collecting DNA samples and clinical data with periodic telephone follow-up to study the natural history, genetic background and prognosis of ALS." [] {IAO:0000119="PMID:31722307", IAO:0000119="PMID:41350806", dcterms:contributor="Claude Sonnet 5 (Anthropic), 2026-09"}
