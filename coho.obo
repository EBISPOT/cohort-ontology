property_value: IAO:0000112 "PMID:24562863" xsd:string {dcterms:title="DNA mismatch repair MSH2 gene-based SNP associated with different populations.", xref="PMID:24562863", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24562863+AND+SRC%3AMED&format=json&resultType=core", comment="We investigated the MSH2 gene regional linkage association with the determined SNP (rs748780), KCNK12 variant (Allele T>C) in the intronic region, in HapMap3 full dataset populations, Yoruba in Ibadan, Nigeria (YRI), Utah residents with ancestry from northern Europe (CEU), Han Chinese in Beijing, China (CHB), and a population of Mexican ancestry in Los Angeles, California (MEX)."}

[Instance]
id: coho:COHO_0002059
name: Minority GWAS African American study
def: "A genome-wide association study of colorectal cancer in African Americans, part of a 'Minority GWAS' effort alongside a Japanese study, that pooled African American cases and controls identified from the Multiethnic Cohort, the Colorectal Cancer Family Registry, the Southern Community Cohort Study, the MD Anderson Cancer Center, the University of North Carolina CanCORS and Rectal Cancer studies and the Prostate, Lung, Colorectal and Ovarian Cancer Screening Trial." [] {IAO:0000119="PMID:25105248", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-023-41819-0/MediaObjects/41467_2023_41819_MOESM1_ESM.pdf"}
subset: coho1:PGS_subset
synonym: "MG-AA" RELATED OMO:0003000 []
instance_of: coho:COHO_0000001 ! cohort aggregation
