property_value: IAO:0000112 "PMID:34650201" xsd:string {dcterms:title="The role of family factors in the association between early adulthood BMI and risk of cardiovascular disease. An intergenerational study of BMI in early adulthood and cardiovascular mortality in parents, aunts and uncles.", xref="PMID:34650201", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7612210/fullTextXML", comment="Data from the Armed Forces Personnel Data Base (1985-2012) were linked with data from the Norwegian Population Registry, generational data from the Norwegian Family Based Life Course Study (NFLC), National Educational Registry and the Cause of Death Registry using the unique national personal identification numbers."}

[Instance]
id: coho:COHO_0002673
name: Chilean COVID-19 Biorepository
def: "A nationwide multicentre cohort of adults with confirmed SARS-CoV-2 infection, from asymptomatic to fatal, recruited from September 2020 into 2021 through nine recruitment centres in seven regions of Chile by a network of Chilean universities and health centres coordinated by the University of Chile's Biobank of Tissue and Fluids, with blood samples and clinical data banked for multi-omics studies of host genetics and COVID-19 severity, and recontacted for long COVID follow-up; the network behind it became the COVID-19 Genomics Network (C19-GenoNet)." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:39596552 ", IAO:0000119=" https://biobanco.uchile.cl/proyecto-c19-genonet-2/"}
subset: coho1:IHCC_subset
synonym: "C19-GenoNet" RELATED OMO:0003000 []
synonym: "Chilean COVID-19 Genomics Network Biorepository" RELATED []
synonym: "COVID-19 Genomics Network" RELATED []
synonym: "RED GENÓMICA COVID-19" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Chile {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11593408/fullTextXML", comment="This paper reports the articulation of a network across Chile and the creation of the Chilean COVID-19 Biorepository, the first nationwide multicenter repository built under biobanking standards to ensure the high quality, reproducibility, and interoperability of samples and data as a resource for collaborative multi-omics research."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/SouthAmerica
relationship: coho:isCohortOf coho:COHO_0002701
property_value: coho:numberOfParticipants "2262" xsd:integer {IAO:0000116="adults with confirmed SARS-CoV-2 infection enrolled (2020-2021)", xref="PMID:39596552", comment="In five months, 2262 participants were enrolled, pseudonymized, and sorted by disease severity."}
property_value: IAO:0000112 "PMID:40399555" xsd:string {dcterms:title="Genome-wide association study of long COVID.", xref="PMID:40399555", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12165857/fullTextXML", comment="For the replication of the FOXP4 lead variants, we obtained data from the following nine additional studies: COVID-19 cohort at LGDB (LatviaGDB), COVID-19 Genomics Network (C19-GenoNet), COVID-19 Host Immune Response Pathogenesis Study (CHIRP), Estonian Biobank (EstBB), Fondazione Genomics SARS-CoV-2 Study (FoGS), GENCOV Study (GENCOV), Mass General Brigham Biobank (MGB), The Post-hospitalization COVID-19 study (PHOSP-COVID) and VA MVP."}
property_value: seeAlso https://biobanco.uchile.cl/proyecto-c19-genonet-2/

[Instance]
id: coho:COHO_0002674
name: Million Women Study
def: "A population-based prospective cohort of women aged 50–64 years in the United Kingdom, recruited in 1996–2001 when invited to routine mammography by the National Health Service Breast Screening Programme at centres in England and Scotland and coordinated by the Cancer Epidemiology Unit of the University of Oxford, set up to study the effects of hormone replacement therapy on breast cancer and other outcomes and followed for the effects of many other factors on women's health as they age." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:11056681", IAO:0000119="https://www.ceu.ox.ac.uk/research/the-million-women-study"}
