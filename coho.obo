property_value: IAO:0000112 "PMID:24997018" xsd:string {dcterms:title="Association of exceptional parental longevity and physical function in aging.", xref="PMID:24997018", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24997018+AND+SRC%3AMED&format=json&resultType=core", comment="The LonGenity study recruited a relatively genetically homogenous cohort of Ashkenazi Jewish (AJ) adults age 65 and older, who were defined as either OPEL (having at least one parent who lived to age 95 or older) or OPUS (neither parent survived to age 95)."}

[Instance]
id: coho:COHO_0002015
name: Action for Health in Diabetes
def: "A randomised clinical trial at 16 centres in the United States that assigned overweight or obese people aged 45 to 76 with type 2 diabetes to an intensive lifestyle intervention for weight loss, through reduced caloric intake and increased physical activity, or to diabetes support and education, with major cardiovascular events as the primary outcome; after the intervention ended, follow-up of the cohort continued as a study of ageing-related outcomes." [] {IAO:0000119="PMID:14500058", dcterms:contributor="GPT-6 (OpenAI), 2026-09", IAO:0000119="PMID:23796131", IAO:0000119="PMID:41575388"}
