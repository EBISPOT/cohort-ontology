property_value: coho:numberOfParticipants "2414" xsd:integer {IAO:0000116="singletons born alive at term in the Wilhelmina Gasthuis 1943-1947 whose birth records were kept", xref="PMID:33664071", comment="The Dutch famine birth cohort consists of 2414 singletons born alive and at term in the Wilhelmina Gasthuis in Amsterdam around the time of the Dutch famine (1943–1947) whose birth records have been kept."}
property_value: IAO:0000112 "PMID:39349457" xsd:string {dcterms:title="Prenatal exposure to undernutrition is associated with a specific lipid profile predicting future brain aging.", xref="PMID:39349457", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11442854/fullTextXML", comment="801 plasma samples of members of the Dutch famine birth cohort were assessed for lipidomics and leptin at age 58."}
property_value: seeAlso https://www.hongerwinter.nl/

[Instance]
id: coho:COHO_0002601
name: Diabetes Prediction in Skåne
def: "A prospective, population-based cohort of children born in Skåne, Sweden, between September 2000 and August 2004 who were screened as newborns for risk of type 1 diabetes, with children at increased risk followed with yearly capillary blood samples for islet autoantibodies from two to 15 years of age or until diabetes onset, to investigate the genetic and environmental factors contributing to or triggering type 1 diabetes." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:40664750", IAO:0000119="PMID:29752553"}
subset: coho1:GEC_subset
synonym: "Diabetes Prediction in Skåne study" RELATED []
synonym: "DiPiS" RELATED OMO:0003000 []
