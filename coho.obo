[Instance]
id: coho:COHO_0002536
name: University of Wisconsin Transdisciplinary Tobacco Use Research Center Trial
def: "A randomized, placebo-controlled smoking cessation trial of the University of Wisconsin Transdisciplinary Tobacco Use Research Center, run at the University of Wisconsin Center for Tobacco Research and Intervention with participants recruited in Madison and Milwaukee, Wisconsin, United States, in which adults who smoked 10 or more cigarettes a day and were motivated to quit were randomly assigned to placebo, nicotine patch, nicotine lozenge, sustained-release bupropion or a combination, and whose genotyped participants are used in genetic studies of nicotine dependence and smoking cessation." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35170738", IAO:0000119="PMID:26440539", IAO:0000119="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3433845/unicode"}
