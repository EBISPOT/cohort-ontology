property_value: IAO:0000112 "PMID:19918004" xsd:string {dcterms:title="Maternal but not paternal association of ambulatory blood pressure with albumin excretion in young offspring with type 1 diabetes.", xref="PMID:19918004", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2809284/fullTextXML", comment="The study population was composed of young people with type 1 diabetes and their parents recruited in the Nephropathy Family Study (NFS)."}

[Instance]
id: coho:COHO_0001381
name: Nigerian Breast Cancer Study
def: "A case-control study of breast cancer in women aged 18 or older, begun in 1998 in Ibadan, Nigeria. Women with invasive breast cancer are recruited at University College Hospital, Ibadan (from 2014 also at Lagos State University Teaching Hospital). Women without cancer are enrolled as controls from the hospital's outpatient clinics and from communities randomly selected in its catchment area. Enrolment was extended to Cameroon and Uganda in 2011 with the same questionnaire and protocol. It collects questionnaire data and biospecimens to study epidemiological and inherited risk factors for breast cancer in African women." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:40249615", IAO:0000119="PMID:30130155", IAO:0000119="PMID:20716701"}
