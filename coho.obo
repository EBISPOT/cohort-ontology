synonym: "Candidate Gene Association Resource Consortium" RELATED []
synonym: "Candidate-gene Association Resource" RELATED []
synonym: "CARe" RELATED OMO:0003000 []
synonym: "CARe Consortium" RELATED []
synonym: "CGARe" RELATED OMO:0003000 []
synonym: "National Heart, Lung, and Blood Institute Candidate Gene Association Resource" RELATED []
synonym: "NHLBI Candidate Gene Association Resource" RELATED []
synonym: "NHLBI CARe Project" RELATED []
synonym: "NHLBI_CARe" RELATED OMO:0003000 []
