property_value: IAO:0000112 "PMID:37781316" xsd:string {dcterms:title="Predictive capacity of a genetic risk score for coronary artery disease in assessing recurrences and cardiovascular mortality among patients with myocardial infarction.", xref="PMID:37781316", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10537937/fullTextXML", comment="In the REGICOR Study, follow-up was conducted through data linkage with population-based myocardial infarction records, official mortality registries, and telephone interviews."}

[Instance]
id: coho:COHO_0002312
name: Registry of Endometrial Cancer in Sweden
def: "A hospital-based case-control study of endometrial cancer in Sweden, whose patients underwent surgery for uterine cancer from 2008 at Karolinska University Hospital, Solna, in Stockholm, to which women of Stockholm County with newly diagnosed uterine cancer are referred, and gave blood and tumour samples, questionnaires on their own risk factors and on cancers in their families, and pedigrees in which cancers in relatives were verified from the Swedish Cancer Registry, medical records or death certificates where possible. Its cases were genotyped in the genome-wide association studies of the Endometrial Cancer Association Consortium." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24851142", IAO:0000119="PMID:27135401", IAO:0000119="PMID:40101186"}
synonym: "Registry of Endometrial Cancer in Stockholm" RELATED []
synonym: "RENDOCAS" RELATED OMO:0003000 []
