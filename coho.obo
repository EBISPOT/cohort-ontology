property_value: coho:numberOfParticipants "64" xsd:integer {IAO:0000116="participants randomised October 2016 - January 2020 (31 anakinra, 33 placebo)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9255857/fullTextXML", comment="From October 2016 to January 2020, 374 patients were screened and 64 eligible participants were enrolled; 33 were randomized to placebo and 31 to anakinra (Figure 1)."}
property_value: IAO:0000112 "GCST90624455" xsd:string {dcterms:title="A genome-wide meta-analysis of palmoplantar pustulosis implicates TH2 responses and cigarette smoking in disease pathogenesis.", xref="PMID:38815935", xref="https://www.medrxiv.org/content/medrxiv/early/2024/01/17/2024.01.17.24301406.full.pdf", comment="The UK dataset included 288 affected individuals of European descent, who were recruited in specialist dermatology centers as part of the APRICOT clinical trial"}

