relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4636631/fullTextXML", comment="The Midspan Family Study is a general population survey of 1477 Caucasian families in Renfrew and Paisley (Scotland), which included 15 402 participants in the first, parental, generation (aged 45–64 years) surveyed between 1972 and 1976."}
property_value: coho:numberOfParticipants "2338" xsd:integer {IAO:0000116="adult offspring aged 30-59 surveyed in 1996", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4636631/fullTextXML", comment="In the second generation, 2338 offspring (1040 sons and 1298 daughters) aged 30–59 years were surveyed in 1996 from an eligible population of 3202 offspring aged 30–59 years who lived locally."}
property_value: IAO:0000112 "PMID:20593021" xsd:string {dcterms:title="Which circulating antioxidant vitamins are confounded by socioeconomic deprivation? The MIDSPAN family study.", xref="PMID:20593021", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20593021+AND+SRC%3AMED&format=json&resultType=core", comment="Socioeconomic and lifestyle measures were available in 1040 men and 1298 women from the MIDSPAN Family Study (30-59 years at baseline) together with circulating levels of vitamins A, C, E, and carotenoids (alpha-carotene, beta-carotene, lutein and lycopene)."}

[Instance]
id: coho:COHO_0002069
name: Myocardial Infarction Genetics Consortium
def: "An international consortium of myocardial infarction and coronary artery disease case-control studies, formed for a genome-wide association study of early-onset myocardial infarction (men aged 50 or younger, women 60 or younger) and age- and sex-matched controls from sites in Boston and Seattle in the United States, Sweden, Finland, Spain and Italy, and later extended with further case-control cohorts for exome and gene sequencing studies of coronary artery disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28267856", IAO:0000119="PMID:19198609"}
