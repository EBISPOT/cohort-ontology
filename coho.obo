synonym: "Lifestyle Immune System Allergy study" RELATED []
synonym: "Lifestyle-Immune System-Allergy Plus Environment and Genetics Study" RELATED []
synonym: "LISA" RELATED OMO:0003000 []
synonym: "LISAplus" RELATED OMO:0003000 []
xref: https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/LISA
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Germany {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6040001/fullTextXML", comment="The two large German birth cohorts, GINIplus and LISAplus, recruited 5,991 and 3,097 children, respectively, in Munich (West), Leipzig (East), Wesel (West), and Bad Honnef (West) to investigate various influences on the development of the immune system and the etiology of allergic diseases."}
property_value: coho:numberOfParticipants "3097" xsd:integer {IAO:0000116="newborns recruited at birth 1997-1999", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6040001/fullTextXML", comment="Of the 3,097 recruited newborns, 1,760 (56.8%) children could be followed until the age of 10 years."}
property_value: IAO:0000112 "GCST90054778" xsd:string {dcterms:title="Genome-wide Association Meta-analysis of Childhood and Adolescent Internalizing Symptoms.", xref="PMID:35378236", xref="https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx", comment="LISA The influence of Life-style factors on the development of the Immune System and Allergies in East and West Germany PLUS the influence of traffic emissions and genetics (LISAplus) Study is a population based birth cohort study."}

