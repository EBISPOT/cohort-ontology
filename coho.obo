property_value: IAO:0000112 "PMID:22158537" xsd:string {dcterms:title="Meta-analysis of genome-wide association studies identifies eight new loci for type 2 diabetes in east Asians.", xref="PMID:22158537", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3582398/unicode", comment="Stage 2 subjects included 5,843 cases and 4,574 controls from three independent GWA studies including the BioBank Japan Study (BBJ), the Health2 T2D Study (H2T2DS) and the Shanghai Jiao Tong University Diabetes Study (SJTUDS) for in silico replication analysis."}

