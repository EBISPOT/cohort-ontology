property_value: IAO:0000112 "PMID:20860503" xsd:string {dcterms:title="A large-scale, consortium-based genomewide association study of asthma.", xref="PMID:20860503", xref="https://europepmc.org/api/getPdf?pmcid=PMC4260321", comment="We did find a suggestive association with rs1837253 on chromosome 5, situated within the TSLP gene, among patients with severe asthma in the SEVERE study (P = 3×10−6; odds ratio, 0.56), but this association was not replicated among patients with severe asthma in the AUGOSA (Asthma UK Genetics of Severe Asthma) study."}

[Instance]
id: coho:COHO_0002367
name: Seattle Familial Colorectal Cancer Registry
def: "A population-based colorectal cancer family registry in western Washington State, United States, one of the sites of the Colon Cancer Family Registry, which enrolled people aged 20 to 74 with incident colorectal cancer in three Washington State counties, identified through the Puget Sound SEER cancer registry, together with their first-degree relatives, and age- and sex-matched population controls recruited from driver's licence lists (under 65) and health care finance files (65 to 74), all of whom completed epidemiology and family-history questionnaires by telephone." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27253385", IAO:0000119="PMID:19245865", IAO:0000119="PMID:17618283"}
