[Instance]
id: coho:COHO_0002174
name: Norway Lung Cancer Study
def: "A population-based case-control study of non-small cell lung cancer in Western Norway, run by the National Institute of Occupational Health (NIOH) in Oslo within its lung cancer genetics project, whose cases are patients of Norwegian origin with histologically confirmed early-stage non-small cell lung cancer admitted to Haukeland University Hospital in Bergen, and whose healthy controls come from the same region and are frequency-matched to the cases on cumulative smoking; recruitment ran from 1986 to 2005." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:18258609", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf"}
