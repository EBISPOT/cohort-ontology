relationship: coho:has_data_collection_location http://dbpedia.org/resource/Spain {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9806164/fullTextXML", comment="Hence, the PUBMEP study aimed to evaluate the prevalence of MetS and the progression of cardiometabolic risk factors related to it from prepuberty to puberty in a cohort of Spanish children."}
relationship: coho:isSubCohortOf coho:COHO_0002649 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9806164/fullTextXML", comment="The PUBMEP is a longitudinal study based on the follow-up of a cohort of children who had previously participated in the GENOBOX study (22–29)."}
property_value: coho:numberOfParticipants "191" xsd:integer {IAO:0000116="children followed from prepuberty to puberty", xref="PMID:36601007", comment="Longitudinal study based on the follow-up until puberty of a cohort of 191 prepubertal Spanish boys and girls without congenital, chronic, or inflammatory diseases: undernutrition: or intake of any drug that could alter blood glucose, blood pressure, or lipid metabolism."}
property_value: IAO:0000112 "PMID:36601007" xsd:string {dcterms:title="Progression of metabolic syndrome and associated cardiometabolic risk factors from prepuberty to puberty in children: The PUBMEP study.", xref="PMID:36601007", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9806164/fullTextXML", comment="Hence, the PUBMEP study aimed to evaluate the prevalence of MetS and the progression of cardiometabolic risk factors related to it from prepuberty to puberty in a cohort of Spanish children."}

[Instance]
id: coho:COHO_0002637
name: Study of Secondary Exposure to Pesticides among Children, Adolescents, and Adults
def: "A prospective cohort set up in 2008 of children living in the agricultural (floricultural) community of Pedro Moncayo County, Pichincha, Ecuador, recruited to include a balanced mix of children who did and did not live with a floricultural or agricultural worker and followed with repeated examinations into adolescence and adulthood, run by the University of California San Diego with Fundación Cimas del Ecuador to study the health effects of pesticide and other agrochemical exposures from childhood to adulthood." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://espina.ucsd.edu/", IAO:0000119="PMID:40777557"}
