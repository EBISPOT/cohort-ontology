property_value: IAO:0000112 "PMID:36006149" xsd:string {dcterms:title="Glyphosate and AMPA in Human Urine of HBM4EU Aligned Studies: Part A Children.", xref="PMID:36006149", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9415901/fullTextXML", comment="The urinary data on Gly and AMPA were obtained from Germany (GerES V-sub; 2015–2017), Cyprus (ORGANIKO; 2017), Slovenia (SLO CRP; 2018), France (ESTEBAN; 2014–2016) and Belgium (3XG; 2019–2020)."}

[Instance]
id: coho:COHO_0002664
name: Cohort ’18, Growing Up in Hungary
def: "A nationally representative longitudinal birth cohort of children born in Hungary between March 2018 and April 2019 and their parents, recruited in pregnancy and run by the Hungarian Demographic Research Institute of the Hungarian Central Statistical Office, to study the circumstances of childbearing and childrearing and the parental, family and social factors that shape children's development." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://kohorsz18.hu/en/", IAO:0000119="PMID:37656714"}
