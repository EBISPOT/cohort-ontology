relationship: coho:has_data_collection_location http://dbpedia.org/resource/Australia {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23245376+AND+SRC%3AMED&format=json&resultType=core", comment="The sample of the Comorbidity and Trauma Study, a genetic association study of heroin dependence, consists of Australian heroin dependent cases ascertained from opioid replacement therapy clinics and controls ascertained in nearby economically disadvantaged neighborhoods."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Oceania
