property_value: IAO:0000112 "PMID:34607834" xsd:string {dcterms:title="Genome-Wide Meta-analysis Identifies Genetic Variants Associated With Glycemic Response to Sulfonylureas.", xref="PMID:34607834", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8669535/fullTextXML", comment="Genotyping and quality control procedures for the Genetics of Diabetes Audit and Research in Tayside Scotland (GoDARTS), Hoorn Diabetes Care System (DCS), and Pharmacogenomics of Metformin (PMET) cohorts have previously been described (13,15,16)."}

