[Instance]
id: coho:COHO_0001794
name: GeparSixto trial
def: "A multicentre, randomised, open-label phase II neoadjuvant trial run in Germany by the German Breast Group in patients with triple-negative or HER2-positive early breast cancer, which tested whether adding carboplatin to anthracycline- and taxane-based chemotherapy (given with trastuzumab and lapatinib for HER2-positive and bevacizumab for triple-negative disease) increases the rate of pathological complete response." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27611952", IAO:0000119="PMID:25534375", IAO:0000119="PMID:28715532", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature24284/MediaObjects/41586_2017_BFnature24284_MOESM1_ESM.pdf", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0609-2/MediaObjects/41588_2020_609_MOESM1_ESM.pdf"}
