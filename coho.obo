[Instance]
id: coho:COHO_0002580
name: Warfarin Pharmacogenomics Cohort
def: "A prospective inception cohort of adults starting chronic warfarin therapy with a target INR of 2–3 for venous thromboembolism, stroke or transient ischaemic attack, atrial fibrillation, myocardial infarction or peripheral arterial disease, enrolled at anticoagulation clinics by the University of Alabama at Birmingham and followed at monthly clinic visits for warfarin dose, INR, medications and outcomes, to study genetic and clinical determinants of warfarin response in African American and European American patients." [] {IAO:0000119="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000708.v1.p1", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28806200", IAO:0000119="PMID:35765100"}
