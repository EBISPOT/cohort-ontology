property_value: coho:numberOfParticipants "283" xsd:integer {IAO:0000116="adolescents and young adults (high-risk and controls) recruited to the SBFS", xref="PMID:32954013", comment="Participants were adolescents and young adults (N = 283, age 15–30 years) recruited as part of the Scottish Bipolar Family Study (SBFS) (Chan et al., 2016; Ganzola et al., 2018; Sprooten et al., 2011; Whalley et al., 2015)."}
property_value: IAO:0000112 "PMID:25229638" xsd:string {dcterms:title="Dysfunction of emotional brain systems in individuals at high risk of mood disorder with depression and predictive features prior to illness.", xref="PMID:25229638", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25229638+AND+SRC%3AMED&format=json&resultType=core", comment="The Bipolar Family Study (BFS) is a prospective longitudinal study that has examined individuals at familial risk of mood disorder and healthy controls on three occasions, 2 years apart."}

[Instance]
id: coho:COHO_0001529
name: Brazilian Immunogenetics of Asthma and Schistosomiasis
def: "A family-based study of asthma and schistosomiasis in five rural communities of the district of Conde, Bahia, north-eastern Brazil, an area endemic for Schistosoma mansoni about 200 km north of Salvador, in which residents aged 5 to 85, most of them members of two large pedigrees, were enrolled by whole-population ascertainment from July to September 2004 by the Federal University of Bahia and Johns Hopkins University, with later follow-up visits, to study the genetic control of total serum IgE, S. mansoni infection intensity and asthma; it is one of the studies of the Consortium on Asthma among African-ancestry Populations in the Americas (CAAPA)." [] {IAO:0000119="PMID:22574126", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:30787307", IAO:0000119="PMID:27725671", IAO:0000119="PMID:18717640"}
