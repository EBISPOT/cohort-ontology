relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5399750/fullTextXML", comment="This investigation utilizes a prospective CVD observational study that was conducted at 16 different UK hospital sites between 2008 and 2013, entitled the Pharmacogenetics of Acute Coronary Syndrome (PhACS) study."}
property_value: coho:numberOfParticipants "1470" xsd:integer {IAO:0000116="PhACS patients recruited at 16 UK sites, 2008-2013", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7687685/fullTextXML", comment="Briefly, PhACS was a UK 16-site prospective observational study between 2008 and 2013 that recruited 1470 patients hospitalised with an NSTE-ACS."}
property_value: IAO:0000112 "PMID:35356681" xsd:string {dcterms:title="Chromosomal Region 11p14.1 is Associated with Pharmacokinetics and Pharmacodynamics of Bisoprolol.", xref="PMID:35356681", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8958266/fullTextXML", comment="Two separate cohorts of patients were used to achieve these aims: PK were determined in a cohort of patients with NSTE-ACS in the Pharmacogenetics of Acute Coronary Syndrome (PhACS) study,6,7 while the PD parameter was determined in an independent cohort from the Genetics of Drug Responsiveness in Essential Hypertension (GENRES) study.8"}

[Instance]
id: coho:COHO_0002252
name: PHArmacogenetic study of Statins in the Elderly at risk
def: "A genome-wide association study within the Prospective Study of Pravastatin in the Elderly at Risk (PROSPER), a trial of pravastatin in men and women aged 70 to 82 screened in Scotland, Ireland and the Netherlands from 1997 to 1999, in which the trial's participants were genotyped genome-wide to find the genetic variation responsible for individual differences in response to pravastatin; it was funded by the European Union's Seventh Framework Programme." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:21977987"}
