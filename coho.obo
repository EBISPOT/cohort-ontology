[Instance]
id: coho:COHO_0002110
name: Norwegian Addison Registry
def: "A national registry and biobank of patients with primary adrenal insufficiency (Addison's disease) in Norway, established in 1996 within the National Registry of Organ-Specific Autoimmune Diseases (ROAS) at Haukeland University Hospital, Bergen, that collects clinical information, demographics and serial biological samples from most Norwegian patients with the disease." [] {IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8208662/fullTextXML", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8052519/fullTextXML"}
