[Instance]
id: coho:COHO_0001842
name: Human Biological Data Interchange Repository
def: "A publicly available collection of DNA samples and immortalized cell lines from families with type 1 diabetes, chiefly multiplex families and largely from the United States, built up from 1990 by the Human Biological Data Interchange in Philadelphia from pedigrees obtained through questionnaires sent to members of the Juvenile Diabetes Foundation, and used in genetic linkage and association studies of type 1 diabetes." [] {IAO:0000119="PMID:9326346", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:11507694", IAO:0000119="PMID:20595243", IAO:0000119="PMID:2239968"}
