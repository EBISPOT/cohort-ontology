relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml", comment="Nicotine dependent smokers seeking cessation treatment were identified and recruited from Madison and Milwaukee, WI."}
relationship: coho:hasCohort coho:COHO_0000727 {xref="https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml", comment="The COGEND sample includes unrelated cases and controls for a genetic association study of nicotine dependence."}
relationship: coho:hasCohort coho:COHO_0002536 {xref="https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml", comment="The UW-TTURC sample includes nicotine dependent smokers from three smoking cessation studies."}
property_value: coho:numberOfParticipants "1515" xsd:integer {IAO:0000116="individuals in the genotyped dataset, from the two contributing projects (the number the 2019 analysis of the dataset reports; it may be that paper's cleaned set rather than every subject dbGaP holds)", xref="PMID:31033776", comment="All individuals (n = 1515) in the study were from two projects:"}
property_value: IAO:0000112 "PMID:31033776" xsd:string {dcterms:title="Determining population stratification and subgroup effects in association studies of rare genetic variants for nicotine dependence.", xref="PMID:31033776", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6636808/fullTextXML", comment="To evaluate the validity of the extended methods, we analyzed the Genetic Architecture of Smoking and Smoking Cessation database, which includes African Americans and European Americans genotyped on Illumina Human Omni2.5, and we compared the results with those obtained with the sequence kernel association test (SKAT) and its modification, SKAT-O that included population stratification and subgroup effect as covariates."}

[Instance]
id: coho:COHO_0001757
name: Australian Genetics of Bipolar Disorder Study
def: "A nation-wide cohort of adults living with bipolar disorder in Australia, run by QIMR Berghofer Medical Research Institute, recruited from 2018 in three waves (a nation-wide media campaign, a Services Australia mail-out to people dispensed lithium carbonate, and a follow-up survey of the Australian Genetics of Depression Study) who completed an online survey and were asked for a saliva sample for genotyping and consent to linkage of their Pharmaceutical and Medicare Benefits Schedule records, to study the relationships between genetic risk, symptom severity, treatment response, medication side effects and health care usage in bipolar disorder." [] {IAO:0000119="PMID:37655588", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
synonym: "Australian Genetics of Bipolar Disorder" RELATED []
synonym: "Australian Genetics of Bipolar Disorder study" RELATED []
synonym: "GBP" RELATED OMO:0003000 []
synonym: "GBP Study" RELATED []
