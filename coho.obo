relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML", comment="The Study of Women’s Health Across the Nation interviewed women in their 40s and 50s from seven U.S. cities approximately yearly to collect information on their physical, biological, psychological, and social health."}
property_value: coho:numberOfParticipants "3302" xsd:integer {IAO:0000116="women enrolled at baseline 1996-1997", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12459529/fullTextXML", comment="Of these, a total of 3302 women, comprising 1550 Caucasian, 935 African American, 286 Hispanic, 250 Chinese and 281 Japanese, were deemed eligible and subsequently enrolled into the SWAN cohort for the longitudinal survey, completing the baseline study from January 1996 to December 1997."}
property_value: IAO:0000112 "GCST90428625" xsd:string {dcterms:title="Circulating anti-Müllerian hormone levels in pre-menopausal women: novel genetic insights from a genome-wide association meta-analysis.", xref="PMID:38815977", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11759094/supplementaryFiles", comment="SWAN"}

[Instance]
id: coho:COHO_0000496
name: Finnish Diabetic Nephropathy Study
def: "An ongoing nationwide multicentre observational study in Finland, established in 1997 and run from the Folkhälsan Research Center and the University of Helsinki, of nearly 9,000 adults with type 1 diabetes recruited and clinically characterised at study centres across the country and followed through re-examinations, national registries and medical records, to identify factors leading to diabetic kidney disease and other diabetic complications." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:39746953", IAO:0000119="PMID:39235140", IAO:0000119="https://research.folkhalsan.fi/genetics/finndiane-study"}
subset: coho1:GWAS_subset
synonym: "FinnDiane" RELATED OMO:0003000 []
