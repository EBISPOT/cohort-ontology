[Instance]
id: coho:COHO_0000400
name: Religious Orders Study and Rush Memory and Aging Project
def: "A pair of harmonized longitudinal clinical-pathologic cohort studies of aging and Alzheimer's disease run at Rush University, the Religious Orders Study (from 1994, nuns, priests and brothers from across the United States) and the Rush Memory and Aging Project (from 1997, lay persons from northeastern Illinois), whose older participants enrol without dementia and agree to annual clinical evaluations and organ donation." [] {IAO:0000119="PMID:29865057", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
