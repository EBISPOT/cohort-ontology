property_value: IAO:0000112 "GCST90244787" xsd:string {dcterms:title="European and multi-ancestry genome-wide association meta-analysis of atopic dermatitis highlights importance of systemic immune regulation.", xref="PMID:37794016", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-023-41180-2/MediaObjects/41467_2023_41180_MOESM1_ESM.pdf", comment="Participants within the ECRHS were eligible for inclusion in this analysis if they were identified by random sampling of those who fulfilled the following criteria: 1) lived in centers that took part in genome-wide genotyping initiative under the auspices of GABRIEL7 AND 2) were initially selected to take part in the ECRHS clinical measurements as part of the random sample (i.e. not specifically selected for inclusion because of any pre-existing disease)."}

[Instance]
id: coho:COHO_0001164
name: EDRN Colorectal and Pancreatic Neoplasm Virtual Biorepository
def: "A University of Pittsburgh biorepository, funded by the National Cancer Institute in 2001 as an Early Detection Research Network resource, of clinically annotated biospecimens and data from adults with, or suspected of having, digestive diseases who were managed in University of Pittsburgh Medical Center hospitals for colorectal cancer screening or for gastrointestinal malignancies, premalignant conditions, inflammatory bowel disease, pancreatic diseases or pancreatic and colorectal cancers. Patients followed from 1990 to 2000 were gathered retrospectively and new patients have been enrolled prospectively since 2001 and followed continuously, to support translational research." [] {IAO:0000119="PMID:21031013", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
subset: coho1:GWAS_subset
synonym: "Colorectal and Pancreatic Neoplasm Virtual Biorepository" RELATED []
