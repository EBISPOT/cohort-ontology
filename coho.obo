relationship: coho:has_data_collection_location http://dbpedia.org/resource/Australia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Belgium {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11093576/fullTextXML", comment="Patients enrolled in GenomALC-2 were from hospitals and clinics in the countries in GenomALC-1 and from Belgium."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/France
