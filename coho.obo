synonym: "International Consortium for Blood Pressure Genome-wide Association Studies" RELATED []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:hasCohort coho:COHO_0001729 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature10405/MediaObjects/41586_2011_BFnature10405_MOESM207_ESM.pdf", comment="Fourteen cohorts (DiaGen, HUNT2, FINRISK97, FUSION2, METSIM, CLUE, MDC, MPP, FBPP-HyperGen, FBPP-GenNet, Jamaicans-GXE, Jamaicans-SPT, CCMB cohorts and IRAS) were genotyped using the iPLEX Sequenom MassARRAY platform."}
relationship: coho:hasCohort coho:COHO_0001734 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature10405/MediaObjects/41586_2011_BFnature10405_MOESM207_ESM.pdf", comment="Five studies (YFS, EPIC-TURIN, FLEMENGHO, Nigerians, and JMGP) were genotyped using Taqman assays (Applied Biosystems, USA)."}
relationship: coho:hasCohort coho:COHO_0001785 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature10405/MediaObjects/41586_2011_BFnature10405_MOESM207_ESM.pdf", comment="Fourteen cohorts (DiaGen, HUNT2, FINRISK97, FUSION2, METSIM, CLUE, MDC, MPP, FBPP-HyperGen, FBPP-GenNet, Jamaicans-GXE, Jamaicans-SPT, CCMB cohorts and IRAS) were genotyped using the iPLEX Sequenom MassARRAY platform."}
relationship: coho:hasCohort coho:COHO_0001876 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0205-x/MediaObjects/41588_2018_205_MOESM1_ESM.pdf", comment="ICBP GWAS is an international consortium to investigate BP genetics6-8 . We combined previously reported post-quality control (QC) GWAS data from 54 studies (N=150,134)8 , with newly available GWAS data from a further 23 independent studies (N=148,890) using a fixed effects inverse variance weighted meta-analysis. All study participants were of European descent and were imputed to either the 1000 Genomes Project Phase 1 integrated release version 3 [March 2012] all ancestry reference panel or the Haplotype Reference Consortium (HRC) panel. The final enlarged ICBP GWAS dataset included 77 studies comprising data from 299,024 individuals from the following cohorts: The initial ICBP GWAS included: AGES (n=3215), ARIC (n=9402), ASPS (n=828), B58C (n=6458), BHS (n=4492), CHS (n=3254), Cilento study (n=999), COLAUS (n=5404), COROGENE-CTRL (n=1878), CROATIA-Vis (n=945), CROATIA-Split (n=494), CROATIA-Korcula (n=867), EGCUT (n=6395), EGCUT2 (n=1844), EPIC (n=2100), ERF (n=2617), Fenland (n=1357), FHS (n=8096), FINRISK-ctrl (n=861), FINRISK CASE (n=839), FUSION (n=1045), GRAPHIC (n=1010), H2000-CTRL (n=1078), HealthABC (n=1661), HTO (n=1000)"}
relationship: coho:hasCohort coho:COHO_0001951 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature10405/MediaObjects/41586_2011_BFnature10405_MOESM207_ESM.pdf", comment="The Japanese Millenium Genome Project comprises 7 independent study cohorts for studies of cardiovascular diseases and related risk factors."}
property_value: coho:numberOfParticipants "200000" xsd:integer {IAO:0000116="individuals of European descent in the 2011 multi-stage GWAS meta-analysis (discovery plus follow-up)", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3340926/unicode", comment="This genome-wide association study of SBP and DBP, which used a multi-stage design in 200,000 individuals of European descent, identified 16 novel loci: six of these loci contain genes previously known or suspected to regulate BP (GUCY1A3-GUCY1B3; NPR3-C5orf23; ADM; FURIN-FES; GOSR2; GNAS-EDN3); the other 10 provide new clues to BP physiology."}
property_value: IAO:0000112 "GCST90239828" xsd:string {dcterms:title="Genome-wide pleiotropy analysis identifies novel blood pressure variants and improves its polygenic risk scores.", xref="PMID:34989438", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34989438+AND+SRC%3AMED&format=json&resultType=core", comment="We report here a bidirectional Mendelian Randomization (MR) and horizontal pleiotropy analysis of S/DBP summary statistics from the UK Biobank (UKB)-International Consortium for Blood Pressure (ICBP) (UKB-ICBP) BP genome-wide association study and construct a composite genetic risk score (GRS) by including pleiotropic variants."}

