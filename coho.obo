property_value: IAO:0000112 "GCST005047" xsd:string {dcterms:title="Large-scale association analysis provides insights into the genetic architecture and pathophysiology of type 2 diabetes.", xref="PMID:22885922", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2383/MediaObjects/41588_2012_BFng2383_MOESM31_ESM.pdf", comment="EAS. The EAS was funded by the British Heart Foundation (RG/98002). Genotyping was funded by a project grant from the Chief Scientist Office, Scotland (CZB/4/672), and undertaken at the Wellcome Trust Clinical Research Facility in Edinburgh"}
