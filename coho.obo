[Instance]
id: coho:COHO_0002443
name: Taiwan Coronary Artery Disease GENetic study
def: "An ongoing hospital-based cohort of patients undergoing coronary angiography or percutaneous coronary intervention for stable angina pectoris or prior myocardial infarction at National Taiwan University Hospital, enrolling patients both in the north of Taiwan, where the main hospital is, and at a branch of the hospital in south-central Taiwan, with electronic medical records, fasting blood samples taken before cardiac catheterisation and blood collected in the catheter laboratory for DNA. It is one of the seven Taiwan-based cohorts of the TAICHI consortium." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-020-2263-3/MediaObjects/41586_2020_2263_MOESM1_ESM.pdf", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3874/MediaObjects/41588_2017_BFng3874_MOESM1_ESM.pdf"}
