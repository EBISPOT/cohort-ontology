relationship: coho:has_data_collection_location http://dbpedia.org/resource/Greece {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8640022/fullTextXML", comment="For MANOLIS, biological samples were collected from the mountainous Mylopomatos villages in Crete, Greece; whereas, Pomak refers to a set of mountainous villages in the North of Greece."}
