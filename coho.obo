property_value: IAO:0000112 "PMID:34607834" xsd:string {dcterms:title="Genome-Wide Meta-analysis Identifies Genetic Variants Associated With Glycemic Response to Sulfonylureas.", xref="PMID:34607834", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8669535/fullTextXML", comment="who completed imputation for the Metformin Response (METRO) cohort"}

[Instance]
id: coho:COHO_0002057
name: Metabolic Syndrome Cohort
def: "A prospective observational cohort of apparently healthy adults aged 20 or over whose parents and grandparents were born in Mexico, recruited from 2007 to 2011 at workplaces, homes and medical units in urban centres of central Mexico (Mexico City, Aguascalientes, León, Toluca and Cuernavaca) and re-examined about three years later, to study the incidence of type 2 diabetes, hypertension and cardiovascular disease; its samples are processed centrally at the Instituto Nacional de Ciencias Médicas y Nutrición in Mexico City." [] {IAO:0000119="PMID:31030672", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
subset: coho1:PGS_subset
synonym: "metabolic syndrome cohort" RELATED []
