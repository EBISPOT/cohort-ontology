is_a: MONDO:0002118 ! urinary system disorder
is_a: MONDO:0005070 ! neoplasm

[Term]
id: MONDO:0021068
name: ovarian neoplasm
def: "A benign, borderline, or malignant neoplasm involving the ovary." []
is_a: MONDO:0005558 ! ovarian disorder
is_a: MONDO:0021148 ! female reproductive system neoplasm

[Term]
id: MONDO:0021069
name: malignant endocrine neoplasm
def: "A malignant neoplasm affecting the endocrine glands. Representative examples include thyroid gland carcinoma, parathyroid gland carcinoma, pituitary gland carcinoma, and adrenal cortex carcinoma." []
is_a: MONDO:0002082 ! endocrine gland neoplasm
is_a: MONDO:0004992 ! cancer

[Term]
id: MONDO:0021071
name: laryngeal neoplasm
def: "A benign or malignant neoplasm involving the larynx." []
is_a: MONDO:0004382 ! laryngeal disorder
is_a: MONDO:0020641 ! respiratory tract neoplasm

[Term]
id: MONDO:0021074
name: precancerous condition
def: "A pathological process with signs indicating it may become cancerous. Representative examples include leukoplakia, dysplastic nevus, actinic keratosis, xeroderma pigmentosum, and intraepithelial neoplasia." []
is_a: MONDO:0045024 ! cancer or benign tumor

[Term]
id: MONDO:0021076
name: pancreatic exocrine neoplasm
def: "A benign or malignant neoplasm that arises from the epithelial cells of the exocrine pancreatic tissue." []
is_a: MONDO:0021040 ! pancreatic neoplasm

[Term]
id: MONDO:0021079
name: childhood neoplasm
def: "A benign or malignant neoplasm arising during childhood." []
is_a: MONDO:0005070 ! neoplasm

[Term]
id: MONDO:0021084
name: vision disorder
def: "Any impairment to the vision." []
