property_value: IAO:0000112 "PMID:27174798" xsd:string {dcterms:title="Development and Validation of a Model to Predict Absolute Vascular Risk Reduction by Moderate-Intensity Statin Therapy in Individual Patients With Type 2 Diabetes Mellitus: The Anglo Scandinavian Cardiac Outcomes Trial, Antihypertensive and Lipid-Lowering Treatment to Prevent Heart Attack Trial, and Collaborative Atorvastatin Diabetes Study.", xref="PMID:27174798", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27174798+AND+SRC%3AMED&format=json&resultType=core", comment="External validation of the model was performed in data from the Antihypertensive and Lipid-Lowering Treatment to Prevent Heart Attack Trial (ALLHAT-LLT; pravastatin 40 mg versus usual care) and Collaborative Atorvastatin Diabetes Study (CARDS; atorvastatin 10 mg versus placebo) of 3878 and 2838 patients with type 2 diabetes mellitus, respectively."}

[Instance]
id: coho:COHO_0001569
name: Cholesterol and Recurrent Events
def: "A randomised, double-blind, placebo-controlled secondary-prevention trial of pravastatin 40 mg daily in men and postmenopausal women aged 21–75 who had had a myocardial infarction 3 to 20 months earlier and had average cholesterol levels (total cholesterol below 240 mg/dl and LDL cholesterol of 115–174 mg/dl), enrolled at 80 hospitals and affiliated centres in the United States and Canada and followed for about five years to test whether lowering cholesterol reduces fatal coronary heart disease and nonfatal myocardial infarction. It was initiated by its investigators and funded by Bristol-Myers Squibb." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:16714328", IAO:0000119="PMID:7572695", IAO:0000119="PMID:9841599", IAO:0000119="PMID:8801446", IAO:0000119="PMID:1746424"}
