relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11757223/fullTextXML", comment="This hypothesis was explored in a population-based cohort study, the Northern Manhattan Study (NOMAS), a multiethnic urban sample of individuals living in New York City."}
property_value: coho:numberOfParticipants "3298" xsd:integer {IAO:0000116="stroke-free adults enrolled 1993-2001", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13482911/fullTextXML", comment="NOMAS is a community‐based longitudinal cohort study of 3298 urban‐dwelling adults 40 years of age or older with a household telephone at the baseline visit."}
property_value: IAO:0000112 "GCST90245988" xsd:string {dcterms:title="Genome-wide association study of executive function in a multi-ethnic cohort implicates LINC01362: Results from the northern Manhattan study.", xref="PMID:36658081", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36658081+AND+SRC%3AMED&format=json&resultType=core", comment="We performed a GWAS on a composite measure of executive function that included measures of mental flexibility and reasoning using data from the Northern Manhattan Study, a racially and ethnically diverse cohort (N = 1077, 69% Hispanic, 17% non-Hispanic Black and 14% non-Hispanic White)."}

[Instance]
id: coho:COHO_0000671
name: Pittsburgh Orofacial Cleft Study
def: "A multiethnic family-based collection of people with nonsyndromic orofacial clefts, their unaffected relatives and unaffected controls, recruited by the University of Pittsburgh through cleft centres in the United States and Puerto Rico and in Argentina, the Philippines, Colombia, Guatemala and Hungary to study the genetics of orofacial clefts and related dental traits." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35172313"}
