property_value: IAO:0000112 "GCST90627781" xsd:string {dcterms:title="Large-Scale Whole-Genome Sequencing Reveals the Genetic Architecture of Primary Membranoproliferative GN and C3 Glomerulopathy.", xref="PMID:31919107", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:31919107%20AND%20SRC:MED&resultType=core&format=json", comment="We analyzed whole-genome sequence data from 165 primary membranoproliferative GN cases and 10,250 individuals without the condition (controls) as part of the National Institutes of Health Research BioResource-Rare Diseases Study."}

[Instance]
id: coho:COHO_0000405
name: Australian Imaging, Biomarker & Lifestyle Flagship Study of Ageing
def: "A longitudinal cohort of volunteers aged over 60 in Australia, including people with Alzheimer's disease, mild cognitive impairment and healthy controls, recruited at centres in Perth and Melbourne and reassessed at 18-month intervals with cognitive testing, blood biomarkers, lifestyle questionnaires and amyloid PET and MRI imaging to study predictors of Alzheimer's disease and cognitive decline." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19470201", IAO:0000119="PMID:38770381"}
