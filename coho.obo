relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Finland {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3107194/fullTextXML", comment="The Helsinki (FCCPS) study (http://research.med.helsinki.fi/gsb/aaltonen/) comprised 988 cases from a population-based collection centred on south-eastern Finland and 864 population controls from the same collection."}
property_value: coho:numberOfParticipants "1514" xsd:integer {IAO:0000116="consecutive colorectal cancer patients in the series (2013)", xref="PMID:24146633", comment="To identify susceptibility genes for this common phenotype, we examined familial cases derived from a consecutive series of 1514 Finnish CRC patients."}
property_value: IAO:0000112 "PMID:21655089" xsd:string {dcterms:title="Multiple common susceptibility variants near BMP pathway loci GREM1, BMP4, and BMP2 explain part of the missing heritability of colorectal cancer.", xref="PMID:21655089", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3107194/fullTextXML", comment="The Helsinki (FCCPS) study (http://research.med.helsinki.fi/gsb/aaltonen/) comprised 988 cases from a population-based collection centred on south-eastern Finland and 864 population controls from the same collection."}

[Instance]
id: coho:COHO_0001720
name: Fukuoka Colorectal Cancer Study
def: "A community-based case-control study of colorectal cancer among residents of Fukuoka City and three adjacent areas of Japan, comparing patients having surgery for a first diagnosis of colorectal cancer at eight hospitals, interviewed from 2000 to 2003, with community controls randomly selected and frequency-matched on sex, age and residence, surveyed in 2001 and 2002; diet and lifestyle were assessed by in-person interview and blood was taken for genotyping, to study dietary, behavioural and genetic factors in colorectal carcinogenesis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:15546244"}
