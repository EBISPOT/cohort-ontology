relationship: coho:has_data_collection_location http://dbpedia.org/resource/Spain {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9562128/unicode", comment="Barcelona -1 is a longitudinal observational study consisting of ~300 subjects at baseline carried out in the Memory and Disorder unit at the University Hospital Mutua de Terrassa, Terrassa, Barcelona, Spain."}
property_value: coho:numberOfParticipants "300" xsd:integer {IAO:0000116="subjects at baseline (approximate)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC9562128/", comment="Barcelona -1 is a longitudinal observational study consisting of ~300 subjects at baseline carried out in the Memory and Disorder unit at the University Hospital Mutua de Terrassa, Terrassa, Barcelona, Spain."}
property_value: IAO:0000112 "GCST90421033" xsd:string {dcterms:title="Proteogenomic analysis of human cerebrospinal fluid identifies neurologically relevant regulation and implicates causal proteins for Alzheimer's disease.", xref="PMID:39528825", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC11831731/", comment="Genomic datasets from ADNI, DIAN, Knight-ADRC (Oct 2021), Knight-ADRC (June 2023), MARS, FACE, and Barcelona-1 were genotyped on multiple arrays at different times and were imputed individually using the GRCh38 Version R2 reference panel on the TOPMed imputation server."}

[Instance]
id: coho:COHO_0000370
name: Stockholm-Tartu Atherosclerosis Reverse Networks Engineering Task
def: "A cohort of patients with coronary artery disease undergoing coronary artery bypass grafting, with comparison patients undergoing other open-heart surgery, enrolled at the Department of Cardiac Surgery of Tartu University Hospital in Estonia, whose vascular and metabolic tissues and blood were genotyped, RNA-sequenced and proteomically profiled to study gene regulation underlying cardiometabolic disease." [] {IAO:0000119="PMID:27540175", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:41456820"}
subset: coho1:GWAS_subset
