property_value: IAO:0000112 "GCST90094651" xsd:string {dcterms:title="Associations between age of menarche and genetic variation in women of African descent: genome-wide association study and polygenic score analysis.", xref="PMID:34706928", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9011920/unicode", comment="The Root consortium is comprised of six epidemiologic studies of breast cancer in women of African ancestry: the Nigerian Breast Cancer Study (Ibadan, Nigeria); the Barbados National Cancer Study (Barbados); the Southern Community Cohort (southern United States); the Baltimore Breast Cancer Study (Baltimore, United States); the Racial Variability in Genotypic Determinants of Breast Cancer Risk Study (Detroit and Pennsylvania, United States); and the Chicago Cancer Prone Study (Chicago, United States)."}

[Instance]
id: coho:COHO_0001298
name: Comprehensive Sickle Cell Centers Collaborative Data Project
def: "A multicentre observational cohort and database of children and adults with sickle cell disease receiving care at the National Heart, Lung, and Blood Institute's Comprehensive Sickle Cell Centers in the United States, run from March 2005 to September 2008 at nine of the centres and their satellite sites, which collected clinical data abstracted from medical records, yearly health and lifestyle interviews and quality-of-life questionnaires, and from 2007 blood and DNA samples for a genotype-phenotype repository, to describe the disease's complications and identify participants for future clinical trials." [] {IAO:0000119="PMID:19902523", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT00528203", IAO:0000119="https://biolincc.nhlbi.nih.gov/studies/cscc_c_data/", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT00529061", IAO:0000119="PMID:20658620"}
