property_value: coho:numberOfParticipants "10285" xsd:integer {IAO:0000116="individuals registered in the OBi analysed by PCA (analysed subset), 2025", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11846991/fullTextXML", comment="We analyzed 10,285 individuals registered in the OBi using principal component analysis (PCA), along with individuals in the 1KGP phase 3 reference panel (AFR, n = 661; AMR, n = 347; EAS, n = 504; EUR, n = 503; SAS, n = 489), and defined 10,136 individuals as the Japanese population (Supplementary Fig. 2b)."}
property_value: IAO:0000112 "GCST90454537" xsd:string {dcterms:title="Genome-wide association studies for pelvic organ prolapse in the Japanese population.", xref="PMID:39349682", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11443051/fullTextXML", comment="We performed a GWAS for POP in Japanese participants registered in the Okinawa Bioinformation Bank (OBi) and Biobank Japan (BBJ) (Supplementary Fig. 1)."}

[Instance]
id: coho:COHO_0001218
name: Pancreatic Cancer Cohort Consortium
def: "A consortium formed in 2006 within the US National Cancer Institute's Cohort Consortium by investigators of 12 prospective cohort studies to run PanScan, a multi-stage genome-wide association study of pancreatic cancer funded by the NCI. PanScan I genotyped cases and controls from the cohorts and one case-control study, PanScan II (from 2007) those of eight case-control studies, and PanScan III new incident cases from 14 cohorts and from case series and case-control studies, mostly people of European ancestry from the United States and Europe." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://dceg.cancer.gov/research/cancer-types/pancreas/panscan", IAO:0000119="PMID:25086665", IAO:0000119="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000206.v5.p3"}
subset: coho1:GWAS_subset
synonym: "PANSCAN" RELATED OMO:0003000 []
