relationship: coho:has_data_collection_location http://dbpedia.org/resource/Poland {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3431573/", comment="Our study subjects were derived from the Polish Endometrial Cancer Study, a large, population-based, endometrial case-control study (18) conducted among women residing in two Polish cities, Warsaw and Lodz, from 2001 to 2003."}
relationship: coho:isCohortOf coho:COHO_0001077
