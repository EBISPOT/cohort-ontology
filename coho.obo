property_value: IAO:0000112 "GCST90267543" xsd:string {dcterms:title="Genome-wide analyses of platinum-induced ototoxicity in childhood cancer patients: Results of GO-CAT and United Kingdom MAGIC consortia.", xref="PMID:36699085", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36699085+AND+SRC%3AMED&format=json&resultType=core", comment="Therefore, a genome-wide association study was performed in the Genetics of Childhood Cancer Treatment (GO-CAT) cohort (n = 261) and the United Kingdom Molecular Genetics of Adverse Drug Reactions in Children Study (United Kingdom MAGIC) cohort (n = 248)."}

[Instance]
id: coho:COHO_0001340
name: Genetic Origin of Dupuytren Disease and Associated Fibromatosis study
def: "A case collection of people with Dupuytren disease recruited from 2007 through plastic and hand surgery clinics in the Netherlands, with blood samples for DNA and surgeon-recorded clinical data such as age at onset, family history, bilateral and ectopic disease and recurrence, for genetic studies of Dupuytren disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28886342", IAO:0000119="PMID:30688894", IAO:0000119="PMID:37257093"}
