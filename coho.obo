property_value: IAO:0000112 "GCST90129576" xsd:string {dcterms:title="Genome-wide interaction analysis of menopausal hormone therapy use and breast cancer risk among 62,370 women.", xref="PMID:35418701", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9007944/fullTextXML", comment="The GENICA was funded by the Federal Ministry of Education and Research (BMBF) Germany grants 01KW9975/5, 01KW9976/8, 01KW9977/0 and 01KW0114, the Robert Bosch Foundation, Stuttgart, Deutsches Krebsforschungszentrum (DKFZ), Heidelberg, the Institute for Prevention and Occupational Medicine of the German Social Accident Insurance, Institute of the Ruhr University Bochum (IPA), Bochum, as well as the Department of Internal Medicine, Evangelische Kliniken Bonn gGmbH, Johanniter Krankenhaus, Bonn, Germany."}

[Instance]
id: coho:COHO_0001174
name: Genizon GWAS
def: "A case-control sample of people with psoriasis, ascertained through dermatologists or other secondary-care specialists, and controls, all drawn from the Québec founder population (people whose four grandparents had French-Canadian family names and were born in Québec or neighbouring areas), assembled by Genizon BioSciences of Saint-Laurent, Québec, and genotyped genome-wide on the Illumina Human 1M BeadChip; it is one of the European-ancestry GWAS datasets of the international psoriasis genetics meta-analyses." [] {IAO:0000119="PMID:40021644", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:25903422", IAO:0000119="PMID:20953188"}
