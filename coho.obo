relationship: coho:has_data_collection_location http://dbpedia.org/resource/Bangladesh {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23590571+AND+SRC%3AMED&format=json&resultType=core", comment="This study reports on the design, methods and baseline analyses from the Bangladesh Vitamin E and Selenium Trial (BEST), a population-based chemoprevention study conducted among adults in Bangladesh with visible arsenic toxicity."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/South_Asia
property_value: coho:numberOfParticipants "7000" xsd:integer {IAO:0000116="participants randomised (enrolled April 2006-August 2009)", xref="PMID:23590571", comment="There were 7,000 participants enrolled in the trial between April 2006 and August 2009."}
property_value: IAO:0000112 "PMID:25133637" xsd:string {dcterms:title="Genome-wide association studies and heritability estimates of body mass index related phenotypes in Bangladeshi adults.", xref="PMID:25133637", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4136799/fullTextXML", comment="The Bangladesh Vitamin E and Selenium Trial (BEST) [28] was established in Araihazar and surrounding areas in 2006 to determine whether 7,000 arsenic-exposed participants who supplemented their diet with vitamin E and selenium would reduce their rate of non-melanoma skin cancer."}
property_value: IAO:0000116 "The acronym BEST also denotes Black Women with Breast Cancer: Etiology, Survival, and Treatment Outcomes Study (COHO:0001525); this term is Bangladesh Vitamin E and Selenium Trial." xsd:string

[Instance]
id: coho:COHO_0001525
name: Black Women with Breast Cancer: Etiology, Survival, and Treatment Outcomes Study
def: "A population-based longitudinal cohort of self-identified Black women diagnosed with invasive breast cancer at age 50 or younger, identified through the state cancer registries of Florida and Tennessee (diagnoses from 2005 to 2018; its first phase recruited women diagnosed in Florida in 2009–2012), who completed a questionnaire on sociodemographic, reproductive, epidemiologic and lifestyle factors, released their medical records and tumour tissue and gave saliva for germline genetic testing, now based at Vanderbilt University Medical Center, to study the causes, inherited predisposition, treatment and survival of breast cancer, including triple-negative breast cancer, in young Black women." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:41360000", IAO:0000119="PMID:42252839", IAO:0000119="PMID:26287763", IAO:0000119="PMID:33947654"}
