[Instance]
id: coho:COHO_0001250
name: WeGene cohort
def: "A research cohort of customers of WeGene, a direct-to-consumer genetic testing company based in Shenzhen, China, who were genotyped from saliva on microarrays through the WeGene Personal Genome Services and consented to take part in research online, answering surveys posted on WeGene's online platform, website and WeChat channels." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:39359028", IAO:0000119="PMID:28442769", IAO:0000119="PMID:42009823", IAO:0000119="PMID:34457340"}
