property_value: coho:numberOfParticipants "4254" xsd:integer {IAO:0000116="heart failure patients in the index (2516) and validation (1738) cohorts combined", xref="https://europepmc.org/api/getPdf?pmcid=PMC7319410", comment="Patient selection For the current analysis the BIOSTAT-CHF index cohort (n =2516) and validation cohort (n =1738) were combined to achieve a larger set of patients (n =4254)."}
property_value: IAO:0000112 "PMID:31919934" xsd:string {dcterms:title="Genetic risk and atrial fibrillation in patients with heart failure.", xref="PMID:31919934", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31919934+AND+SRC%3AMED&format=json&resultType=core", comment="An AF genetic risk score was calculated in 3759 European ancestry individuals (1783 with sinus rhythm, 1976 with AF) from the BIOlogy Study to TAilored Treatment in Chronic Heart Failure (BIOSTAT-CHF) by summing 97 single nucleotide polymorphism (SNP) alleles (ranging from 0-2) weighted by the natural logarithm of the relative SNP risk from the latest AF genome-wide association study."}

[Instance]
id: coho:COHO_0001536
name: Human genetic determinants of severe malaria in Malawi
def: "An unmatched case-control study of severe Plasmodium falciparum malaria at Queen Elizabeth Central Hospital, Blantyre, Malawi, run by the Malawi-Liverpool Wellcome Trust Clinical Research Programme with the Blantyre Malaria Project. Its cases are children aged 2 months to 14 years admitted with severe malaria (cerebral malaria or severe malarial anaemia) in 1994-2007, its controls are cord-blood samples from infants born at the same hospital in 2006-2007, and blood was also taken from some cases' parents; it is the Malawi partner study of the MalariaGEN Consortial Project 1 and its genome-wide association studies of severe malaria." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.malariagen.net/partner_study/human-genetic-determinants-severe-malaria-malawi/", IAO:0000119="PMID:23717212"}
synonym: "Blantyre" RELATED OMO:0003000 []
synonym: "Blantyre-Wellcome Trust Project in Blantyre, Malawi" RELATED []
synonym: "Malawi-Liverpool Wellcome Clinical Research Programme, Blantyre" RELATED []
synonym: "MLWCRP" RELATED OMO:0003000 []
