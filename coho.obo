relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11384074/fullTextXML", comment="The trial, Gabapentin for chronic pelvic pain in women (GaPP2), was a UK-wide, multicenter, randomized, controlled trial of gabapentin versus placebo for the treatment of CPP."}
property_value: coho:numberOfParticipants "306" xsd:integer {IAO:0000116="women randomised (153 gabapentin, 153 placebo), 2015-2019", xref="PMID:32979978", comment="Of these 414 women, 306 were randomly assigned (153 to gabapentin and 153 to placebo)."}
property_value: IAO:0000112 "GCST90428068" xsd:string {dcterms:title="Genome-wide association reveals a locus in neuregulin 3 associated with gabapentin efficacy in women with chronic pelvic pain.", xref="PMID:39258169", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11384074/fullTextXML", comment="We conducted an exploratory genome-wide association study using eligible GaPP2 participants aiming to identify genetic variants associated with gabapentin response."}

[Instance]
id: coho:COHO_0001169
name: Interdisciplinary Group for Advanced Research on BirtH outcomes - DBT India Initiative
def: "A single-centre prospective pregnancy cohort at Gurugram Civil Hospital, a secondary-care hospital in Gurugram district, Haryana, north India, that from May 2015 enrolled pregnant women before 20 weeks' gestation (dated by ultrasound) and followed them through pregnancy to delivery and once within six months after delivery, building repositories of clinical data, biospecimens and ultrasound images. Coordinated by the Translational Health Science and Technology Institute and funded by India's Department of Biotechnology, it aims to identify clinical, epidemiological, genomic, epigenomic, proteomic and microbial correlates of preterm birth and to develop risk-prediction tools for it." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:37492417", IAO:0000119="PMID:30770926", IAO:0000119="PMID:39030058"}
