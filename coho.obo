property_value: coho:numberOfCases "352" xsd:integer {IAO:0000116="cases and controls interviewed (2004-2008)", xref="PMID:21795665", comment="We conducted interviews, in person, with 352 case patients (participation rate: 83%) and 646 control subjects (participation rate: 71%) and their parents."}
