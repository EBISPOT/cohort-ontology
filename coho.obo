property_value: IAO:0000112 "GCST90301252" xsd:string {dcterms:title="A genome-wide association meta-analysis implicates Hedgehog and Notch signaling in Dupuytren's disease.", xref="PMID:38172110", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10764787/fullTextXML", comment="This study (‘The role of genetic variants in Dupuytren disease’) has Lifelines study ID OV18_0461; (3) The British Society for Surgery of the Hand Genetics of Dupuytren’s Disease (BSSH-GODD) study (United Kingdom) was approved by the Oxfordshire Research Ethics Committee, document number B/09/H0605/65; (4) The UK Biobank (United Kingdom) was approved by the North West Multi-Centre Research Ethics Committee, document number 11/NW/0382."}

[Instance]
id: coho:COHO_0001294
name: Cambridgeshire Parkinson's Incidence from GP to Neurologist
def: "An observational, longitudinal, population-representative incident cohort of people newly diagnosed with parkinsonism or Parkinson's disease in the county of Cambridgeshire, United Kingdom, between December 2000 and December 2002. Cases were referred through general practitioners, neurologists, geriatricians, Parkinson's disease specialist nurses and hospital discharge coding, and were followed from diagnosis by the University of Cambridge with clinical, neuropsychological and genetic assessments, to describe the natural history of Parkinson's disease." [] {IAO:0000119="PMID:31965629", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38849413", IAO:0000119="PMID:14691062", IAO:0000119="PMID:23781007"}
