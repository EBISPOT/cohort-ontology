relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Japan {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3808698/fullTextXML", comment="The JCS enrolls Japanese centenarians from throughout Japan with an emphasis upon recruiting semi-supercentenarians (age 105+ years) and referent cohort subjects comprising spouses of centenarians' offspring and healthy younger volunteers."}
property_value: coho:numberOfCases "513" xsd:integer {IAO:0000116="long-lived individuals (cases) and geographically matched controls of the JCS in the 2013 longevity meta-analysis (genotyped set)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3808698/", comment="The Japanese Centenarian Study (JCS) included 513 long lived individuals (median survival 106 years; age range 100-114) and 561 geographically matched controls (median age 75 years; range: 26-89)."}
property_value: coho:numberOfControls "561" xsd:integer {IAO:0000116="long-lived individuals (cases) and geographically matched controls of the JCS in the 2013 longevity meta-analysis (genotyped set)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3808698/", comment="The Japanese Centenarian Study (JCS) included 513 long lived individuals (median survival 106 years; age range 100-114) and 561 geographically matched controls (median age 75 years; range: 26-89)."}
property_value: IAO:0000112 "PMID:24244950" xsd:string {dcterms:title="Meta‐analysis of genetic variants associated with human exceptional longevity.", xref="PMID:24244950", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3808698/", comment="The Japanese Centenarian Study (JCS) included 513 long lived individuals (median survival 106 years; age range 100-114) and 561 geographically matched controls (median age 75 years; range: 26-89)."}
