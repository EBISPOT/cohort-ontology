property_value: IAO:0000112 "PMID:33385923" xsd:string {dcterms:title="Sub-multiplicative interaction between polygenic risk score and household coal use in relation to lung adenocarcinoma among never-smoking women in Asia.", xref="PMID:33385923", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC8378844/", comment="Our primary analysis included 1,472 lung adenocarcinoma cases and 1,497 controls from the Genetic Epidemiological Study of Lung Adenocarcinoma (GELAC) (Jou et al., 2009), the Shenyang Lung Cancer Study (SLCS) (Yin et al., 2009), and the Shanghai Women’s Health Study (SWHS) (Zhang et al., 2007; Zheng et al., 2005)."}

[Instance]
id: coho:COHO_0002390
name: Sri Lankan Diabetes Study
def: "A Sri Lankan type 2 diabetes case-control study whose cases came mostly from the Sri Lankan Young Diabetes Study of patients with early-onset diabetes recruited from the three largest hospitals in Sri Lanka, augmented with diabetes cases from the Sri Lankan Diabetes Cardiovascular Study, and whose controls were participants in the Sri Lankan Diabetes Cardiovascular Study, a cross-sectional nationally representative epidemiological investigation." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:21874001", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.921/MediaObjects/41588_2011_BFng921_MOESM16_ESM.pdf"}
