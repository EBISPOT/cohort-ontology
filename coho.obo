property_value: IAO:0000112 "GCST90860773" xsd:string {dcterms:title="Large-scale meta- and cross-trait analyses uncover shared genetic risk factors for IBS and psychiatric disorders.", xref="PMID:42221328", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13216503/fullTextXML", comment="This dataset was derived from a prior meta-analysis (12) that integrated two independent cohorts: the UK Biobank (UKB; 40,548 cases and 293,220) and the Bellygenes initiative (12,852 cases and 139,981 controls)."}

