property_value: IAO:0000112 "GCST90444398" xsd:string {dcterms:title="Uncommon Protein-Coding Variants Associated With Suicide Attempt in a Diverse Sample of U.S. Army Soldiers.", xref="PMID:38141912", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38141912+AND+SRC%3AMED&format=json&resultType=core", comment="Here, we advance this search for genetic risk by analyzing the association between suicide attempt and uncommon variation exome-wide in a large, ancestrally diverse sample.MethodsWe sequenced whole genomes of 13,584 soldiers from the Army STARRS (Army Study to Assess Risk and Resilience in Servicemembers), including 979 individuals with a history of suicide attempt."}

[Instance]
id: coho:COHO_0000959
name: Barbados Asthma Genetics Study
def: "A family-based asthma genetics study initiated in Barbados in 1993 on nuclear and extended families, self-reported as African Caribbean, of paediatric asthmatic probands referred from local polyclinics or the Accident and Emergency Department of the Queen Elizabeth Hospital, with recruitment continuing through the Chronic Disease Research Centre in Barbados." [] {IAO:0000119="PMID:15940135", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38714703"}
