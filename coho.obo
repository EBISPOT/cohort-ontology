relationship: coho:has_data_collection_location http://dbpedia.org/resource/Australia {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4474428/fullTextXML", comment="This study, entitled the Barrett’s Oesophagus Metabolic Study (BOMS), was nested within the Study of Digestive Health (SDH), a population-based study conducted in Brisbane, Australia between February 1, 2003 and June 30, 2006."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Oceania
property_value: coho:numberOfCases "393" xsd:integer {IAO:0000116="Barrett's oesophagus cases who completed the study, 2003-2006 (no total or control count stated for the whole study)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3750988/", comment="Thus, 393 BE cases (285 nondysplastic, 108 dysplastic) completed the study."}
property_value: IAO:0000112 "PMID:26237428" xsd:string {dcterms:title="Genome-wide meta-analysis identifies five new susceptibility loci for cutaneous malignant melanoma.", xref="PMID:26237428", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3373/MediaObjects/41588_2015_BFng3373_MOESM50_ESM.pdf", comment="691 Q-MEGA cases genotyped on the Omni1-Quad array were combined with 553 healthy controls genotyped on the same array from the Study of Digestive Health (SDH)"}

[Instance]
id: coho:COHO_0002358
name: Shanghai Diabetes Institute Inpatient Database
def: "The inpatient database of the Shanghai Diabetes Institute at Shanghai Jiao Tong University Affiliated Sixth People's Hospital, Shanghai, China: Han Chinese inpatients of the hospital's Department of Endocrinology and Metabolism, recruited from 2001, with type 2 diabetes, type 1 diabetes or genetic syndromes related to diabetes, for whom detailed phenotypes of glucose and lipid metabolism, blood pressure, liver and kidney function and diabetic complications were collected. Its type 2 diabetes patients have served as cases, with controls from the community-based Shanghai Diabetes Studies, in genetic association studies of type 2 diabetes and its complications." [] {IAO:0000119="PMID:21911749", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22961080", IAO:0000119="PMID:19937226"}
