property_value: IAO:0000112 "PMID:40838581" xsd:string {dcterms:title="Association of blood-based neurodegenerative biomarkers with cognitive functioning and dementia in India (LASI-DAD) and the United States (HRS).", xref="PMID:40838581", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12497661/fullTextXML", comment="LASI-DAD is a representative subsample of LASI that has a focus on cognitive aging and dementia among persons aged 60 and over in India, with an oversampling of those at a higher risk of cognitive impairment."}

[Instance]
id: coho:COHO_0002646
name: Hokkaido Study on Environment and Children's Health
def: "An ongoing prospective birth cohort study run by the Center for Environmental and Health Sciences of Hokkaido University, Japan, made up of the Sapporo cohort, recruited in pregnancy at one Sapporo hospital in 2002–2005, and the Hokkaido cohort, recruited in the first trimester at clinics and hospitals across Hokkaido Prefecture in 2003–2012, that follows the children to study the effects of prenatal and postnatal exposure to environmental chemicals on birth outcomes, birth defects, growth, allergies, infections and neurodevelopment, and genetic susceptibility to them." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/Hokkaido%20Study", IAO:0000119="PMID:34022817"}
