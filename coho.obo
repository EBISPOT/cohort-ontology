[Instance]
id: coho:COHO_0001003
name: Discovery, Biology, and Risk of Inherited Variants in Breast Cancer
def: "A breast cancer genetics consortium, one of the five projects funded in 2010 under the NCI's Genetic Associations and Mechanisms in Oncology (GAME-ON) post-GWAS initiative. It meta-analysed genome-wide summary data shared by existing breast cancer GWAS and genotyped breast cancer cases and controls on the OncoArray, to replicate known and find new breast cancer susceptibility loci." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27598322", IAO:0000119="https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001265/phs001265.v1.p1/GapExchange_phs001265.v1.p1.xml"}
subset: coho1:GWAS_subset
synonym: "Discovery, Biology and Risk of Inherited Variants in Breast Cancer Consortium" RELATED []
synonym: "DRIVE" RELATED OMO:0003000 []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:hasCohort coho:COHO_0001039 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11322043/fullTextXML", comment="OncoArray genotyping and phenotype data harmonization for the Discovery, Biology, and Risk of Inherited Variants in Breast Cancer (DRIVE) breast-cancer case control samples was supported by X01 HG007491 and U19 CA148065 and by Cancer Research UK (C1287/A16563). Genotyping was conducted by the Center for Inherited Disease Research (CIDR), Centre for Cancer Genetic Epidemiology, University of Cambridge, and the National Cancer Institute. The following studies contributed germline DNA from breast cancer cases and controls: the Two Sister Study (2SISTER), Breast Oncology Galicia Network (BREOGAN), Copenhagen General Population Study (CGPS), Cancer Prevention Study 2 (CPSII), The European Prospective Investigation into Cancer and Nutrition (EPIC), Melbourne Collaborative Cohort Study (MCCS), Multiethnic Cohort (MEC), Nashville Breast Health Study (NBHS), Nurses Health Study (NHS), Nurses Health Study 2 (NHS2), Polish Breast Cancer Study (PBCS), Prostate Lung Colorectal and Ovarian Cancer Screening Trial (PLCO), Studies of Epidemiology and Risk Factors in Cancer Heredity (SEARCH), The Sister Study (SISTER), Swedish Mammographic Cohort (SMC), Women of African Ancestry Breast Cancer Study (WAABCS), Women’s Health Initiative (WHI)."}
relationship: coho:hasCohort coho:COHO_0001048 {xref="https://journals.plos.org/plosmedicine/article?id=10.1371/journal.pmed.1002118", comment="Members of DRIVE DRIVE acknowledges the following GWASs and investigators that shared genome-wide summary data as part of the breast-cancer GWAS meta-analysis: the Australian Breast Cancer Family Study (ABCFS)"}
relationship: coho:isCohortOf coho:COHO_0000774
property_value: coho:numberOfParticipants "60015" xsd:integer {IAO:0000116="breast cancer cases and controls genotyped on the OncoArray in DRIVE's dbGaP submission", xref="https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001265/phs001265.v1.p1/GapExchange_phs001265.v1.p1.xml", comment="The DRIVE data included under this dbGAP submission include OncoArray data from 60,015 breast cancer cases and controls genotyped at the Center for Inherited Disease Research (CIDR), University of Cambridge, National Cancer Institute, University of Copenhagen, University of Southern California and Mayo Clinic."}
property_value: IAO:0000112 "GCST90134421" xsd:string {dcterms:title="Investigating the shared genetic architecture of uterine leiomyoma and breast cancer: A genome-wide cross-trait analysis.", xref="PMID:35803233", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC9300879/", comment="This GWAS meta-analyzed data from BCAC and DRIVE (Discovery, Biology and Risk of Inherited Variants in Breast Cancer Consortium), combining 11.8 million variants in 122,977 BC-affected women (of which 69,501 were ER+ cases and 21,468 were ER–) and 105,974 female control subjects (all of European ancestry)."}

[Instance]
id: coho:COHO_0001004
name: European Prospective Investigation into Cancer and Nutrition–Cardiovascular Disease Study
def: "A case-cohort study nested within the European Prospective Investigation into Cancer and Nutrition, designed to investigate the determinants of cardiovascular disease. EPIC participants with incident coronary heart disease or stroke, identified from 1991 to 2010, are compared with a centre-stratified random subcohort of EPIC participants with stored blood samples, in which molecular factors, including genotypes, are measured." [] {IAO:0000119="PMID:40099743", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29844013", IAO:0000119="PMID:34796724"}
