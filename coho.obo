property_value: IAO:0000112 "GCST90451683" xsd:string {dcterms:title="Novel loci and biomedical consequences of iron homoeostasis variation.", xref="PMID:39643614", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11624196/supplementaryFiles", comment="The INGI‐Val Borbera (INGI-VB) study comprises 1,785 healthy participants enrolled in the Val Borbera Valley, a geographically isolated region located within the Apennine Mountains in Northwest Italy."}

