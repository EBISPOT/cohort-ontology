property_value: coho:numberOfParticipants "4085" xsd:integer {IAO:0000116="participants of all ages enrolled in Phase 1 (1978-1988)", xref="https://biolincc.nhlbi.nih.gov/studies/csscd/", comment="A total of 4,085 participants, ranging in age from newborns to adults, were enrolled in Phase 1 from 23 centers across the US."}
property_value: IAO:0000112 "GCST90897930" xsd:string {dcterms:title="FLT1 and other candidate fetal haemoglobin modifying loci in sickle cell disease in African ancestries.", xref="PMID:40025045", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11873275/fullTextXML", comment="Similarly, variants within the genomic region of FLT1 were observed in the Cooperative Study of Sickle Cell Disease (CSSCD) cohort at P = 6.9e-03 (rs61763174, intronic variant, β = −0.24, MAF = 0.06)24, and in the Silent Cerebral Infarct Transfusion Trial (SITT) cohort at P = 2e-04 (rs9578046, 94 kb upstream, β = 0.14, MAF = 0.12)25 (Supplementary Data 2)."}

[Instance]
id: coho:COHO_0001309
name: Dallas Heart Study
def: "A single-site, multiethnic, population-based probability sample of residents of Dallas County, Texas, aged 18 to 65, weighted to be about half African American and run by the University of Texas Southwestern Medical Center, surveyed and examined in 2000–2002 (DHS-1) and re-examined in 2007–2009 together with spouses and other new participants (DHS-2), designed to produce unbiased estimates of ethnic differences in cardiovascular health and to support research on their biological and social mechanisms using genetics, imaging, and clinical and social-science methods." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:33619548", IAO:0000119="PMID:15194016", IAO:0000119="PMID:24531328"}
subset: coho1:GWAS_subset
synonym: "DaHS" RELATED OMO:0003000 []
synonym: "DHS" RELATED OMO:0003000 []
