[Instance]
id: coho:COHO_0002249
name: Proyecto Genes Candidatos en Asma
def: "A population-based study run by the Institute for Immunological Research of the University of Cartagena, Colombia, to identify environmental and genetic risk factors for asthma and allergies, which recruited unrelated people with asthma, diagnosed by GINA criteria with a standardised questionnaire and confirmed by a study physician from the clinical history and reversible airway obstruction on lung function testing, and unrelated controls without a personal or family history of asthma or allergies from the Social Security Clinic and outpatient health centres in Cartagena from 2002 to 2005, together with nuclear and extended families recruited through asthmatic probands. It is one of the asthma genetics studies of the Consortium on Asthma among African-ancestry Populations in the Americas (CAAPA)." [] {IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms12522/MediaObjects/41467_2016_BFncomms12522_MOESM1276_ESM.pdf"}
synonym: "PGCA" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Colombia {xref="https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf", comment="The Proyecto Genes Candidatos en Asma (PGCA) study is a population-based study conducted by the Institute for Immunological Research of The University of Cartagena (Colombia) to identify environmental and genetic risk factors for asthma and allergies [16, 19, 21, 22]."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/SouthAmerica
property_value: coho:numberOfCases "836" xsd:integer {IAO:0000116="unrelated asthma cases and non-asthmatic controls recruited in Cartagena, 2002-2005 (the families recruited through asthmatic probands are not counted)", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms12522/MediaObjects/41467_2016_BFncomms12522_MOESM1276_ESM.pdf", comment="A total of 836 unrelated asthma cases and 574 non-asthmatic controls were recruited from the Social Security Clinic and outpatient health centers in Cartagena from 2002 to 2005."}
property_value: coho:numberOfControls "574" xsd:integer {IAO:0000116="unrelated asthma cases and non-asthmatic controls recruited in Cartagena, 2002-2005 (the families recruited through asthmatic probands are not counted)", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms12522/MediaObjects/41467_2016_BFncomms12522_MOESM1276_ESM.pdf", comment="A total of 836 unrelated asthma cases and 574 non-asthmatic controls were recruited from the Social Security Clinic and outpatient health centers in Cartagena from 2002 to 2005."}
property_value: IAO:0000112 "PMID:30787307" xsd:string {dcterms:title="Association study in African-admixed populations across the Americas recapitulates asthma risk loci in non-African populations.", xref="PMID:30787307", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6382865/fullTextXML", comment="While this association was observed in multiple African American samples, the strongest effects were observed in three non-U.S. studies from Barbados (BAGS), Cartagena, Colombia (PGCA), and Puerto Rico (GALA II; Supplementary Fig. 15)."}

[Instance]
id: coho:COHO_0002250
name: Genome Wide Association Study in Familial Parkinson Disease
def: "A genome-wide association sample of familial Parkinson's disease that combines unrelated cases, one per multiplex family, from two familial Parkinson's disease studies, PROGENI and GenePD, diagnosed by modified UK Parkinson's Disease Society Brain Bank criteria and primarily Caucasian and non-Hispanic, with Caucasian non-Hispanic controls without neurological disease from the NINDS repository at the Coriell Institute, genotyped at the Center for Inherited Disease Research to find genetic risk factors for Parkinson's disease." [] {IAO:0000119="PMID:18985386", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000126.v1.p1"}
