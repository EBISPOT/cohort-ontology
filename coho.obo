property_value: coho:numberOfParticipants "1252" xsd:integer {IAO:0000116="young adults assessed in the laboratory battery at the two sites (2016)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5204128/", comment="Participants were 1252 young adults (62% female) with low levels of addictive behavior who were assessed in individual laboratory rooms at the University of Chicago and the University of Georgia."}
property_value: IAO:0000112 "GCST90336598" xsd:string {dcterms:title="Polygenic contributions to performance on the Balloon Analogue Risk Task.", xref="PMID:37582857", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10618088/fullTextXML", comment="Genetic, cognitive and behavioral data were similarly collected in the Genetics of Impulsivity (GOI) project, performed at the University of Georgia and the University of Chicago."}

[Instance]
id: coho:COHO_0001342
name: Genetics of Latinos Diabetic Retinopathy
def: "A family-based study of Latinos of Mexican or Central American origin in the Los Angeles area, run jointly by Cedars-Sinai Medical Center and the Los Angeles Biomedical Research Institute at Harbor-UCLA Medical Center, which from 2007 recruited probands with type 2 diabetes and either diabetic retinopathy or diabetes of at least ten years' duration together with their siblings and parents, with retinopathy graded from fundus photographs, to study the genetics of diabetic retinopathy and other complications of diabetes." [] {IAO:0000119="PMID:22330960", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:25452868"}
