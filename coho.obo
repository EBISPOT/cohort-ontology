[Instance]
id: coho:COHO_0001279
name: Anglo-Australasian Osteoporosis Genetics Consortium
def: "A sample of postmenopausal women aged 55–85 of white European ancestry with extreme high or extreme low hip bone mineral density, recruited from population-based and clinical sources at centres in Australia, New Zealand and the United Kingdom by the Anglo-Australasian Osteoporosis Genetics Consortium and genotyped together for a genome-wide association study of bone mineral density and fracture that used extreme truncate selection." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:21533022", IAO:0000119="PMID:22792071"}
subset: coho1:GWAS_subset
