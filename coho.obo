relationship: coho:has_data_collection_location http://dbpedia.org/resource/Switzerland {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13266212/fullTextXML", comment="The Swiss Pediatric Sepsis Study was a nationwide, prospective, multicentre cohort conducted from September 1, 2011, to December 31, 2015, across 10 tertiary and regional paediatric hospitals in Switzerland, including all five university centres and all paediatric intensive care units."}
property_value: coho:numberOfParticipants "1096" xsd:integer {IAO:0000116="children enrolled Sept 2011-Dec 2015 (1181 sepsis episodes), 2011-2015", xref="PMID:30169202", comment="Between Sept 1, 2011, and Dec 31, 2015, we enrolled 1096 children to our study."}
property_value: IAO:0000112 "GCST90726424" xsd:string {dcterms:title="Genome-wide association study of paediatric bacteraemia and sepsis.", xref="PMID:42241732", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42241732+AND+SRC%3AMED&format=json&resultType=core", comment="Using samples and clinical data from 650 children enrolled in the Swiss Pediatric Sepsis Study, a national multicentre cohort for culture-proven bacterial sepsis, we conducted within-cohort analyses and a separate case-control analysis in 510 cases and 994 controls, testing genome-wide polymorphisms for association with sepsis susceptibility and, in cases only, with disease characteristics."}

[Instance]
id: coho:COHO_0001415
name: Systematic Treatment Enhancement Program for Bipolar Disorder
def: "A long-term, multicentre study funded by the US National Institute of Mental Health that enrolled outpatients aged 15 or older with any subtype of bipolar disorder at 22 academic medical centres in the United States and followed them over seven years. All participants entered a naturalistic standard care pathway, with randomized care pathways for acute and refractory depression, to answer questions about the effectiveness of treatments for bipolar disorder." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:25844303", IAO:0000119="PMID:35773558"}
