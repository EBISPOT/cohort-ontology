property_value: coho:numberOfParticipants "2037" xsd:integer {IAO:0000116="participants (smoker probands, siblings and parents) from 602 African American and European American nuclear families (1999-2004)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18354387+AND+SRC%3AMED&format=json&resultType=core", comment="We examined 16 single nucleotide polymorphisms (SNPs) at DRD2 and 7 SNPs at ANKK1 in our Mid-South Tobacco Family cohort, which consisted of 2037 participants representing two distinct American populations."}
property_value: IAO:0000112 "PMID:17164261" xsd:string {dcterms:title="Fine mapping of a linkage region on chromosome 17p13 reveals that GABARAP and DLG4 are associated with vulnerability to nicotine dependence in European-Americans.", xref="PMID:17164261", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17164261+AND+SRC%3AMED&format=json&resultType=core", comment="Participants were 2037 subjects from 602 nuclear families of either African-American (AA) or European-American (EA) origin from our Mid-South Tobacco Family (MSTF) cohort."}

