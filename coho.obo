property_value: coho:numberOfParticipants "1545" xsd:integer {IAO:0000116="people who took part in the baseline in-laboratory sleep study", xref="https://europepmc.org/api/getPdf?pmcid=PMC10091093", comment="There were 1545 individuals (53% of those invited) who agreed to come in for a baseline sleep study (the primary reason for non-participation was the burden of being away from home overnight)."}
property_value: IAO:0000112 "GCST90270120" xsd:string {dcterms:title="The genetic etiology of periodic limb movement in sleep.", xref="PMID:35670608", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35670608+AND+SRC%3AMED&format=json&resultType=core", comment="We conducted a genome-wide association study (GWAS) of periodic limb movements in sleep (PLMS) using a joint analysis (i.e., discovery, replication, and joint meta-analysis) of four cohorts (MrOS, the Wisconsin Sleep Cohort Study, HypnoLaus, and MESA), comprised of 6843 total subjects."}

[Instance]
id: coho:COHO_0001252
name: ZOE 2.0
def: "A community-based, multi-ethnic, cross-sectional genetic epidemiologic study of early childhood oral health, run by the University of North Carolina at Chapel Hill, that enrolled children aged 3 to 5 attending public preschools (Head Start programmes) across North Carolina, United States, from August 2016 to February 2019, examining their teeth in the preschools and collecting guardian questionnaires, saliva for genotyping and dental plaque, to study the genomics of early childhood caries." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:33139633"}
