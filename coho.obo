relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17921364+AND+SRC%3AMED&format=json&resultType=core", comment="We conducted a longitudinal study of young adults from Barry and Caerphilly, United Kingdom, who had previously taken part between 1972 and 1974 in a randomized controlled trial of milk supplementation."}
property_value: coho:numberOfParticipants "1163" xsd:integer {IAO:0000116="infants born March 1972-October 1974 in the milk-token trial", xref="PMID:22479550", comment="The Barry Caerphilly Growth (BCG) cohort study is a long-term follow-up of a randomized controlled trial of 1,163 infants born consecutively between March 1972 and October 1974 in two populations from the towns of Barry and Caerphilly in South Wales [15]."}
property_value: IAO:0000112 "PMID:12791629" xsd:string {dcterms:title="Infant nutrition and blood pressure in early adulthood: the Barry Caerphilly Growth study.", xref="PMID:12791629", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12791629+AND+SRC%3AMED&format=json&resultType=core", comment="We conducted a long-term follow-up (1997-1999) of the Barry Caerphilly Growth study cohort (1972-1974) into which mothers and their offspring had originally been randomly assigned to receive a milk supplement or usual care."}

[Instance]
id: coho:COHO_0001518
name: Breast Cancer in Northern Israel Study
def: "A population-based case-control study of breast cancer in northern Israel, conducted by the Clalit National Cancer Control Center in Haifa with family medicine, surgery, pathology and oncology teams across the region, which since January 2000 has enrolled consecutively diagnosed breast cancer patients living in a defined area of northern Israel and cancer-free controls randomly selected from the Clalit Health Services register of insured people in the same area, matched on age, ethnic group and primary care clinic. Participants are interviewed about their medical history, medication use and health habits and give a blood sample, for studies of breast cancer risk factors, including genetic ones." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:21952991", IAO:0000119="PMID:37451831", IAO:0000119="PMID:29324747", IAO:0000119="PMID:20567021"}
