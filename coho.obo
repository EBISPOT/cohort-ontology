[Instance]
id: coho:COHO_0000711
name: International Consortium for Blood Pressure Genome-Wide Association Studies
def: "A consortium of genome-wide association studies of systolic and diastolic blood pressure, whose 2011 multi-stage meta-analysis combined about 200,000 individuals of European descent to find blood pressure loci and relate them to hypertension and cardiovascular disease risk." [] {IAO:0000119="PMID:21909115", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
subset: coho1:GWAS_subset
synonym: "ICBP" RELATED OMO:0003000 []
