relationship: coho:has_data_collection_location http://dbpedia.org/resource/Finland {xref="https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf", comment="Helsinki 2000 Ischemic Stroke Genetics Study was designed for investigating genetic factors underlying ischemic stroke in a Finnish population and in the long-term to be incorporated to multicenter multinational similar datasets."}
property_value: IAO:0000112 "GCST005838" xsd:string {dcterms:title="Multiancestry genome-wide association study of 520,000 subjects identifies 32 loci associated with stroke and stroke subtypes.", xref="PMID:29531354", xref="https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf", comment="Helsinki 2000 Ischemic Stroke Genetics Study was designed for investigating genetic factors underlying ischemic stroke in a Finnish population and in the long-term to be incorporated to multicenter multinational similar datasets."}

[Instance]
id: coho:COHO_0000754
name: GEN-COVID Multicenter Study
def: "A multicentre study coordinated by the University of Siena of SARS-CoV-2-positive individuals in Italy, hospitalised and non-hospitalised, whose biospecimens, detailed clinical data and exome and genotype data are collected in the GEN-COVID Biobank, Patient Registry and Genetic Data Repository to find genetic factors for COVID-19 susceptibility and severity." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:33456056"}
