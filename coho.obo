property_value: coho:numberOfParticipants "1671" xsd:integer {IAO:0000116="GenKOLS cases and controls analysed in a smoking GWAS (analysed subset)", xref="PMID:29767774", comment="We performed genome-wide association analyses for average cigarettes per day (CPD) across the Genetic Epidemiology of COPD (COPDGene) non-Hispanic white (NHW) (n = 6659) and African American (AA) (n = 3260), GenKOLS (the Genetics of Chronic Obstructive Lung Disease) (n = 1671), and ECLIPSE (the Evaluation of COPD Longitudinally to Identify Predictive Surrogate Endpoints) (n = 1942) cohorts."}
property_value: IAO:0000112 "GCST90132135" xsd:string {dcterms:title="A genome-wide association study of bronchodilator response in participants of European and African ancestry from six independent cohorts.", xref="PMID:35769418", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9234425/fullTextXML", comment="Six non-overlapping cohorts contributed to our primary analysis: the Framingham Heart Study (FHS) [21]; Genetic Epidemiology of COPD (COPDGene) [22]; Evaluation of COPD Longitudinally to Identify Predictive Surrogate End-points (ECLIPSE) [23]; Treatment of Emphysema with a Gamma-Selective Retinoid Agonist (TESRA) [24]; the Bergen, Norway COPD Cohort, Genetics of Chronic Obstructive Lung Disease (GenKOLS) [25]; and the Subpopulations and Intermediate Outcome Measures in COPD Study (SPIROMICS) [26]."}

[Instance]
id: coho:COHO_0001010
name: Genetic Links to Anxiety and Depression Study
def: "A recontactable cohort of people aged 16 or over living in the United Kingdom, run by the NIHR Mental Health BioResource at King's College London, which recruits online people with current or past depression or anxiety, and also people with no history of mental disorder, into the NIHR BioResource. Participants complete questionnaires, give saliva samples for genotyping and consent to medical record linkage and recontact, to support research on risk factors for depression and anxiety." [] {IAO:0000119="https://gladstudy.org.uk/about/", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31715324"}
