property_value: IAO:0000112 "PMID:42005644" xsd:string {dcterms:title="Measuring Environmental Noise for Babies in Special Care Nurseries and Neonatal Intensive Care Units on a Large Scale: Research Methods.", xref="PMID:42005644", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13087638/fullTextXML", comment="For our current study—Generation Victoria (GenV) [18], the ethical approval is in place (Royal Children's Hospital Human Research Ethics Committee (HREC)‐2019/11), including consent to access clinical data."}
property_value: seeAlso https://genv.org.au//

[Instance]
id: coho:COHO_0002678
name: South Asia Biobank
def: "A population-based study of adults aged 18 years and over of South Asian ethnicity, recruited from 2018 at non-communicable disease surveillance sites centred on primary community health care units in Bangladesh, India, Pakistan and Sri Lanka by a partnership of centres in those countries and the United Kingdom led from Imperial College London, with standardised health assessments, environmental mapping and biological samples, to identify the genetic and environmental causes of type 2 diabetes, cardiovascular and other non-communicable diseases in South Asians." [] {IAO:0000119="PMID:34143882", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
subset: coho1:IHCC_subset
synonym: "SAB" RELATED OMO:0003000 []
