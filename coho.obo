relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11570374/fullTextXML", comment="Briefly, 699 participants, 10 to 17 years old, diagnosed with type 2 diabetes by American Diabetes Association criteria, with duration 2 years or less, body mass index (BMI) ≥ 85th percentile for age and sex, were enrolled across 15 clinical centers in the United States"}
property_value: coho:numberOfParticipants "699" xsd:integer {IAO:0000116="participants randomised to a treatment group (2009)", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3478667/unicode", comment="Of the 1211 children and adolescents who were screened, 927 (76.5%) entered the run-in phase and 699 (75.4%) were randomly assigned to a treatment group, for an overall enrollment rate of 57.7%."}
property_value: IAO:0000112 "GCST90044894" xsd:string {dcterms:title="Genome-wide Association Study of Lipid Traits in Youth With Type 2 Diabetes.", xref="PMID:34568709", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34568709+AND+SRC%3AMED&format=json&resultType=core", comment="We genotyped 206 928 variants and imputed 17 642 824 variants in 1076 youth (mean age 15.0 ± 2.48 years) with T2D from the Treatment Options for Type 2 Diabetes in Adolescents and Youth (TODAY) and SEARCH for Diabetes in Youth (SEARCH) studies as part of the Progress in Diabetes Genetics in Youth (ProDiGY) consortium."}

[Instance]
id: coho:COHO_0001127
name: Tracking Parkinson's
def: "A prospective, multicentre, longitudinal epidemiological and biomarker study of Parkinson's disease in the United Kingdom, funded by Parkinson's UK, that recruited patients aged 18–90 with a clinical diagnosis of Parkinson's disease of recent onset (diagnosed within the preceding 3.5 years) or young onset (diagnosed at or before age 50) at 72 National Health Service secondary-care sites, together with unaffected siblings of patients, and follows them with repeated motor, non-motor and quality-of-life assessments, genotyping and biosamples, to explain variation in the clinical phenotype of Parkinson's disease, including its relation to genetic variation." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38849413", IAO:0000119="PMID:26485428"}
