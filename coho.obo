property_value: IAO:0000112 "PMID:31816882" xsd:string {dcterms:title="Public Health Insurance, Non-Farm Labor Supply, and Farmers' Income: Evidence from New Rural Cooperative Medical Scheme.", xref="PMID:31816882", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31816882+AND+SRC%3AMED&format=json&resultType=core", comment="Our dataset comprised of 8273 people, aged 45 or above, from the China Health and Retirement Longitudinal Study (CHARLS) conducted in 2011 and 2013."}

[Instance]
id: coho:COHO_0002662
name: REal-time Assessment of Community Transmission
def: "A national cohort in England of people who took part in the REal-time Assessment of Community Transmission programme of Imperial College London, which from 2020 sent random samples of people aged 5 years and older, drawn from National Health Service general practice registers, SARS-CoV-2 swab tests (REACT-1) and antibody self-tests (REACT-2) for the Department of Health and Social Care, and who consented to recontact and linkage to their health records, used to study the longer-term effects of the COVID-19 pandemic and other factors on health and wellbeing." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:36893367", IAO:0000119="PMID:37733993", IAO:0000119="https://www.imperial.ac.uk/medicine/research-and-impact/groups/react-study/"}
