[Instance]
id: coho:COHO_0002473
name: Tampere Vascular Study
def: "A study of atherosclerosis at Tampere University Hospital, Finland, that collected arterial tissue from patients undergoing open vascular surgery (carotid or femoral endarterectomy, or aortic bypass, for occlusive atherosclerosis), with internal thoracic artery samples from coronary bypass patients as controls, and, in a second arm collected in 2008, whole blood and monocyte samples from patients with angiographically verified coronary artery disease and angiographically normal controls drawn from the patients given an exercise test at the hospital, for gene-expression and genetic studies." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28128285", IAO:0000119="PMID:22509262", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6180013/fullTextXML"}
subset: coho1:PGS_subset
synonym: "TVS" RELATED OMO:0003000 []
