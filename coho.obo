property_value: IAO:0000112 "GCST90984764" xsd:string {dcterms:title="A polygenic score for acute vaso-occlusive pain in pediatric sickle cell disease.", xref="PMID:34283174", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC8341359/", comment="To better define genotype–phenotype relations in SCD, we initiated the Sickle Cell Genome Project (SGP) by performing whole-genome sequencing (WGS) on participants from Baylor College of Medicine (BCM) and from the St. Jude Children’ Research Hospital Sickle Cell Clinical Research and Intervention Program (SCCRIP) longitudinal cohort study (clinicaltrials.gov #NCT02098863)."}

