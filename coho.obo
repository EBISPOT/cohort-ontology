relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9214725/unicode", comment="Patients with UC (n=484) or CD (n=464) and HCs (ages 18+, n=365) were recruited as part of a cross-sectional study, the Mount Sinai Crohn’s and Colitis Registry (MSCCR), between December 2013 and September 2016 from the outpatient and endoscopy units of the Mount Sinai Hospital."}
property_value: coho:numberOfParticipants "1500" xsd:integer {IAO:0000116="approximately 1500 IBD patients and controls recruited Dec 2013-Sep 2016", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9873918/fullTextXML", comment="The Mount Sinai Crohn’s and Colitis registry (MSCCR is a prospective cross-sectional cohort consisting of ~1500 IBD patients and controls recruited during their endoscopy visit from December 2013–September 2016."}
property_value: IAO:0000112 "GCST90095485" xsd:string {dcterms:title="Integrative Analysis of the Inflammatory Bowel Disease Serum Metabolome Improves Our Understanding of Genetic Etiology and Points to Novel Putative Therapeutic Targets.", xref="PMID:34780722", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9214725/unicode", comment="Patients with UC (n=484) or CD (n=464) and HCs (ages 18+, n=365) were recruited as part of a cross-sectional study, the Mount Sinai Crohn’s and Colitis Registry (MSCCR), between December 2013 and September 2016 from the outpatient and endoscopy units of the Mount Sinai Hospital."}

[Instance]
id: coho:COHO_0000440
name: Netherlands Study of Depression and Anxiety
def: "A multi-site naturalistic longitudinal case-control cohort in the Netherlands of 2,981 adults aged 18-65, 2,329 with a current or remitted depressive and/or anxiety disorder and 652 healthy controls, recruited from 2004 in the general population, primary care and specialised mental health care in the regions of Amsterdam, Leiden and Groningen, extended from 2014 with 367 of their siblings to 3,348 participants and reassessed repeatedly over more than nine years, to study the aetiology, long-term course and consequences of depressive and anxiety disorders by integrating psychological, social, biological and genetic factors." [] {IAO:0000119="PMID:18763692", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.nesda.nl/researchers/about-nesda/", IAO:0000119="PMID:33773360"}
subset: coho1:GWAS_subset
synonym: "NESDA" RELATED OMO:0003000 []
