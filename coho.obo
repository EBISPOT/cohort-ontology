property_value: IAO:0000112 "GCST90726344" xsd:string {dcterms:title="Genome-wide association analyses identify distinct genetic architectures for early-onset and late-onset depression.", xref="PMID:41233554", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12695632/supplementaryFiles", comment="The PREFECT sample constituted N=1,796 cases who had a clinical diagnosis of MDD and were treated for a major depressive episode with electroconvulsive therapy (ECT)6 ."}

[Instance]
id: coho:COHO_0001225
name: Performance of Rotavirus and Oral Polio Vaccines in Developing Countries
def: "A birth cohort of children enrolled with their mothers within seven days of birth in low-income wards of Mirpur, Dhaka, Bangladesh, from May 2011, into a randomized controlled trial with a two-by-two factorial design, conducted by the International Centre for Diarrhoeal Disease Research, Bangladesh (icddr,b) with the University of Vermont and the University of Virginia, that tested a delayed-dose oral rotavirus vaccine and the replacement of one oral polio vaccine dose by an injectable polio vaccine, and followed the children through their first two years of life to study why oral vaccines underperform in children living with poverty, poor sanitation and overcrowding." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38524222", IAO:0000119="PMID:35420468", IAO:0000119="PMID:25711607"}
