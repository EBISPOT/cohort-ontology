property_value: IAO:0000112 "PMID:23770605" xsd:string {dcterms:title="Genome-wide association study identifies multiple risk loci for chronic lymphocytic leukemia.", xref="PMID:23770605", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3729927/", comment="In stage 3, 10 SNPs in the most promising loci and one SNP from an established locus were taken forward for de novo replication in an additional 392 cases and 4561 controls from the NCI replication study (NCI Rep) and from the Utah/Sheffield Chronic Lymphocytic Leukemia study (Utah-Sheffield) (Supplementary Table 1)."}

[Instance]
id: coho:COHO_0002533
name: UTAH Study
def: "A prostate cancer case-control study from Utah, United States, and part of the PRACTICAL consortium. Its cases are prostate cancer cases sampled from extended Utah high-risk pedigrees, chosen so that no two are closely related. Its controls come from other high-risk pedigree studies and have no cancer, no link to a prostate cancer kindred and no first-degree relative with prostate cancer." [] {IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3094/MediaObjects/41588_2014_BFng3094_MOESM58_ESM.pdf", IAO:0000119="https://pmc.ncbi.nlm.nih.gov/articles/PMC4596899/", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
