relationship: coho:has_data_collection_location http://dbpedia.org/resource/Western_Africa
property_value: coho:numberOfParticipants "1614" xsd:integer {IAO:0000116="unrelated Nigerian adults in the quality-controlled genome-wide dataset (2012)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3353888/fullTextXML", comment="The final cleaned dataset thus consisted of 1614 unrelated adult hypertensive (n = 790) and normotensive (n = 824) subjects, 940 females and 674 males with 759,215 SNPs across both the 22 autosomal and X chromosomes."}
property_value: IAO:0000112 "GCST001263" xsd:string {dcterms:title="Identification, replication, and fine-mapping of Loci associated with adult height in individuals of african ancestry.", xref="PMID:21998595", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3188544/fullTextXML", comment="The meta-analysis included results from nine studies: four population-based African-American studies (ARIC (N = 2,740), CARDIA (N = 699), JHS (N = 2,119), and MESA (N = 1,646)), one family-based African-American study (CFS (N = 386)), African-American GWA study consortia of breast (AABC (N = 5,380)) and prostate cancer (AAPC (N = 5,526)) and two case-control studies of obesity (Maywood (N = 743)) and hypertension (Nigeria (N = 1,188)) (Materials and Methods, Text S1 and Table S1)."}

[Instance]
id: coho:COHO_0001110
name: Nanjing Medical University Global Screening Array project
def: "A case-control sample of Chinese patients with histologically confirmed incident non-small cell lung cancer, untreated by chemotherapy or radiotherapy before diagnosis, and cancer-free controls from community screening for non-communicable diseases, frequency-matched on age, sex and region, genotyped on the Illumina Global Screening Array by Nanjing Medical University, China; it combines three regional case-control studies, from Nanjing and Shanghai, from Beijing and Tianjin, and from Guangdong." [] {IAO:0000119="PMID:42152146", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31326317"}
