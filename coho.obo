property_value: coho:numberOfParticipants "3722" xsd:integer {IAO:0000116="participants accrued at baseline 2004-2009", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3040595/", comment="We accrued 3,722 participants (Table 1): 2,200 African Americans (59%) and 1,522 whites (41%), 1,536 (41%) with household incomes below 125% of the poverty level and 2,186 (59%) above the poverty level."}
property_value: IAO:0000112 "GCST90093143" xsd:string {dcterms:title="Multi-Ancestry Genome-wide Association Study Accounting for Gene-Psychosocial Factor Interactions Identifies Novel Loci for Blood Pressure Traits.", xref="PMID:34734193", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles", comment="HANDLS (Healthy Aging in Neighborhoods of Diversity across the Life Span): HANDLS is a community-based, longitudinal epidemiologic study examining the influences of race and socioeconomic status (SES) on the development of age-related health disparities among a sample of socioeconomically diverse African Americans and whites."}

[Instance]
id: coho:COHO_0000439
name: Mount Sinai Crohn's and Colitis Registry
def: "A prospective cross-sectional cohort of about 1,500 adults with Crohn's disease or ulcerative colitis and non-IBD controls (people undergoing colon cancer screening), recruited between December 2013 and September 2016 during their endoscopy visits to the outpatient and endoscopy units of the Mount Sinai Hospital, with paired intestinal biopsies and blood samples, RNA sequencing, genotype data and clinical, endoscopic and histological assessments for molecular studies of inflammatory bowel disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8263768/fullTextXML", IAO:0000119="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9214725/unicode", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9873918/fullTextXML", IAO:0000119="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10014487/unicode"}
subset: coho1:GWAS_subset
synonym: "MSCCR" RELATED OMO:0003000 []
