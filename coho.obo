property_value: IAO:0000112 "GCST90095044" xsd:string {dcterms:title="CYP11B1 variants influence skeletal maturation via alternative splicing.", xref="PMID:34754074", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8578655/fullTextXML", comment="A GWAS meta-analysis including 9,806,907 single-nucleotide polymorphisms (SNPs) was performed in 4557 children of multiethnic background participating in the Generation R Study (N = 3510, 49% boys; mean age 9.8, SD = 0.33 years) and the Bone Mineral Density in Childhood Study (BMDCS) (N = 1047, 47% boys; mean age 10.9, SD = 1.39 years) to identify loci associated with SA (assessed in years in both cohorts)."}

