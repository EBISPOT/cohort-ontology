property_value: IAO:0000112 "GCST90132186" xsd:string {dcterms:title="Multi-ancestry genetic study of type 2 diabetes highlights the power of diverse populations for discovery and translation.", xref="PMID:35551307", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9179018/fullTextXML", comment="South Asian studies of Sri Lankan, Bangladeshi and South Indian ancestry (RHS, EPIDREAM, SINDI, GRCCDS and BPC) from those of North Indian and Pakistani ancestry; and Northern European ancestry studies from the study of Greek ancestry from Southern Europe (GOMAP)."}

[Instance]
id: coho:COHO_0000762
name: Singapore Chinese Eye Study
def: "A population-based cohort of Chinese adults in Singapore examined at baseline in 2009–2011 (SCES-1) and invited for a 6-year follow-up in 2015–2017 (SCES-2) with standardised ocular and systemic examinations and questionnaires, to study the prevalence, incidence, progression and risk factors of age-related eye diseases." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31401553"}
