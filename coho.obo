property_value: IAO:0000112 "PMID:37845353" xsd:string {dcterms:title="Genome-wide association meta-analysis identifies risk loci for abdominal aortic aneurysm and highlights PCSK9 as a therapeutic target.", xref="PMID:37845353", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10632148/fullTextXML", comment="These two sets of weights were then used to calculate PRS in three external validation cohorts, two with control groups representative of the general population (UK Aneurysm Growth Study-UK Biobank (UKAGS-UKB) and Aneurysm Consortium-Wellcome Trust Case Control Consortium (AC-WTCCC)) and one representative of populations with cardiovascular disease (Second manifestations of ARTerial disease (SMART))."}

[Instance]
id: coho:COHO_0001464
name: Autism Case-Control cohort
def: "A case-control collection for genome-wide studies of autism spectrum disorders assembled at the Center for Applied Genomics of the Children's Hospital of Philadelphia, combining people with autism spectrum disorders from several US sites, diagnosed with the Autism Diagnostic Interview and Autism Diagnostic Observation Schedule and from simplex and multiplex families (with some of their parents and siblings), with control subjects without autism spectrum disorders from the Children's Hospital of Philadelphia." [] {IAO:0000119="PMID:19404256", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19404257"}
