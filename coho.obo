relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3064014/fullTextXML", comment="Between 2000 and 2005, the NFS recruited adolescents aged 10–16 years with type 1 diabetes throughout England (8)."}
relationship: coho:hasCohort coho:COHO_0001437 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5280020/", comment="The GWAS discovery stage included 3135–5156 subjects with T1D, depending on phenotypic comparison (Supplemental Figure 1), from four studies: FinnDiane,23 the EURODIAB Family Study,24 the Scania Diabetes Registry (SDR),25 and the UK Nephropathy Family Study and Oxford Regional Prospective Study (NFS-ORPS/Cambridge)26,27 (Supplemental Tables 2 and 3, Table 1)."}
property_value: coho:numberOfParticipants "1232" xsd:integer {IAO:0000116="analysed subset: ORPS and NFS participants with more than one HbA1c (84% of both cohorts)", xref="PMID:21335371", comment="The study population consisted of 1,232 participants in the Oxford Regional Prospective Study (ORPS, n = 418) and Nephropathy Family Study (NFS, n = 814) with more than one A1C assessment, representing 84% of the whole cohorts."}
property_value: IAO:0000112 "GCST003864" xsd:string {dcterms:title="The Genetic Landscape of Renal Complications in Type 1 Diabetes.", xref="PMID:27647854", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5280020/", comment="The GWAS discovery stage included 3135–5156 subjects with T1D, depending on phenotypic comparison (Supplemental Figure 1), from four studies: FinnDiane,23 the EURODIAB Family Study,24 the Scania Diabetes Registry (SDR),25 and the UK Nephropathy Family Study and Oxford Regional Prospective Study (NFS-ORPS/Cambridge)26,27 (Supplemental Tables 2 and 3, Table 1)."}

[Instance]
id: coho:COHO_0001380
name: Nephropathy Family Study
def: "A longitudinal study of young people with type 1 diabetes in England, set up in 2000 within the Genetic Resource Investigating Diabetes (GRID) study of the JDRF/Wellcome Trust Diabetes and Inflammation Laboratory. In 2000–2005 it recruited adolescents aged 10–16 years who had developed type 1 diabetes before the age of 16 in East Anglia, Birmingham, Bristol and Oxford, together with their parents. It followed them with annual urinary albumin-to-creatinine ratios and HbA1c measurements for phenotypic and genetic study of the early pathogenesis of microalbuminuria." [] {IAO:0000119="PMID:19171721", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19918004"}
