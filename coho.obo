[Instance]
id: coho:COHO_0001939
name: Stanford Insulin Suppression Test Cohort
def: "A cohort of non-diabetic adults of European ancestry pooled from studies of insulin resistance carried out at Stanford University over about ten years, whose insulin sensitivity was measured directly by the insulin suppression test (as steady-state plasma glucose) and who were genotyped genome-wide for genetic studies of insulin sensitivity and related traits." [] {IAO:0000119="PMID:23378610", IAO:0000119="PMID:25798622", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24296717", IAO:0000119="PMID:23583979"}
