property_value: IAO:0000112 "GCST90013445" xsd:string {dcterms:title="Fine-mapping, trans-ancestral and genomic analyses identify causal variants, cells, genes and drug targets for type 1 diabetes.", xref="PMID:34127860", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8273124/fullTextXML", comment="P.K.G. provided samples for genotyping through the New York Cancer Project (NYCP)."}

[Instance]
id: coho:COHO_0001217
name: Okinawa Bioinformation Bank
def: "A population-based biobank study established in 2016 in Okinawa Prefecture, Japan, through the Okinawa Bioinformation Bank Project promoted by the University of the Ryukyus and Okinawa Prefecture, whose participants, recruited on Okinawa's islands including the Miyako Islands, give blood or saliva for DNA and genome-wide genotyping together with health check-up results, lifestyle questionnaires and, for some, the birthplaces of their four grandparents. It aims to clarify the population history of the Ryukyu islanders and to find genetic factors in common and rare diseases." [] {IAO:0000119="PMID:37903429", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:33432348", IAO:0000119="PMID:39987337"}
subset: coho1:GWAS_subset
