relationship: coho:hasCohort coho:COHO_0000082 {xref="https://ega-archive.org/studies/EGAS00001002937", comment="GoDARTS T2D-GENES Exome Sequencing Study is a subset of the ~52,000 Type 2 diabetes exome sequencing project."}
relationship: coho:hasCohort coho:COHO_0000649 {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4145406/unicode", comment="From the SAFS families, 20 large pedigrees, consisting of 1043 individuals, were selected for T2D-GENES Project 2 by focusing on large lineages to maximize the number of potential copies of founder alleles and to get an optimal ratio of sequencing efficiency and number of individuals with type 2 diabetes."}
property_value: coho:numberOfCases "6504" xsd:integer {IAO:0000116="T2D cases and controls in the joint T2D-GENES/GoT2D exome data set after QC (2016)", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5034897/unicode", comment="This created a joint data set (after all QC) comprised of 12,940 individuals (6,504 cases; 6,436 controls) drawn from five ancestry groups: 4,541 of European origin, and ~2,000 [range: 1,943-2,217] each of South Asian, East Asian, Hispanic, and African American origin (Extended Data Fig. 1; Extended Data Table 2; Supplementary 4)."}
property_value: coho:numberOfControls "6436" xsd:integer {IAO:0000116="T2D cases and controls in the joint T2D-GENES/GoT2D exome data set after QC (2016)", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5034897/unicode", comment="This created a joint data set (after all QC) comprised of 12,940 individuals (6,504 cases; 6,436 controls) drawn from five ancestry groups: 4,541 of European origin, and ~2,000 [range: 1,943-2,217] each of South Asian, East Asian, Hispanic, and African American origin (Extended Data Fig. 1; Extended Data Table 2; Supplementary 4)."}
property_value: coho:numberOfParticipants "12940" xsd:integer {IAO:0000116="T2D cases and controls in the joint T2D-GENES/GoT2D exome data set after QC (2016)", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5034897/unicode", comment="This created a joint data set (after all QC) comprised of 12,940 individuals (6,504 cases; 6,436 controls) drawn from five ancestry groups: 4,541 of European origin, and ~2,000 [range: 1,943-2,217] each of South Asian, East Asian, Hispanic, and African American origin (Extended Data Fig. 1; Extended Data Table 2; Supplementary 4)."}
property_value: IAO:0000112 "EGAS00001001460" xsd:string {dcterms:title="The genetic architecture of type 2 diabetes.", xref="PMID:27398621"}

