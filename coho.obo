[Instance]
id: coho:COHO_0000560
name: International Lung Cancer Consortium
def: "An international consortium established in 2004 by research groups leading large molecular epidemiology studies of lung cancer, which pools data from its member case-control and cohort studies to study lung cancer risk and prognosis; its OncoArray project genotyped about 36,000 participants of European descent." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3002160/fullTextXML", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5619832/fullTextXML"}
subset: coho1:GWAS_subset
