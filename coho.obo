property_value: coho:numberOfControls "531" xsd:integer {IAO:0000116="heroin-dependent cases and neighbourhood controls in the candidate-gene study", xref="PMID:23303482", comment="A total of 1459 Australian cases ascertained from opioid replacement therapy clinics, 531 neighborhood controls ascertained from economically disadvantaged areas near opioid replacement therapy clinics, and 1495 unrelated Australian Twin Registry controls not dependent on alcohol or illicit drugs selected from a twin and family sample."}
property_value: IAO:0000112 "PMID:30482948" xsd:string {dcterms:title="Transancestral GWAS of alcohol dependence reveals common genetic underpinnings with psychiatric disorders.", xref="PMID:30482948", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6430207/fullTextXML", comment="Funding support for the Comorbidity and Trauma Study (CATS) (dbGAP accession number: phs000277.v1.p1) was provided by the National Institute on Drug Abuse (R01 DA17305); GWAS genotyping services at the CIDR at The Johns Hopkins University were supported by the National Institutes of Health (contract N01-HG-65403)."}

[Instance]
id: coho:COHO_0001574
name: Croatian Colorectal Cancer Genetic Study
def: "A case–control study of colorectal cancer in Croatia, whose cases are patients with colorectal cancer recruited from November 2008 at the surgery departments of two tertiary hospitals in Zagreb that receive patients from across the country, and whose population controls without a history of cancer were drawn at random, by age and sex, from the '10,001 Dalmatians' study of the general population of Split and the islands of Vis and Korčula. Its participants were genotyped for known colorectal cancer risk variants and later genome-wide, for European colorectal cancer genome-wide association studies." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24066093", IAO:0000119="PMID:31089142"}
