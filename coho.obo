property_value: coho:numberOfParticipants "1643" xsd:integer {IAO:0000116="consenting melanoma cases", xref="PMID:21474410", comment="The final sample consisted of 1643 consenting cases out of 3420 cancer notifications (48.04%), of which 1455 cases completed one or more components of the study and 1157 completed all components."}
property_value: IAO:0000112 "GCST010304" xsd:string {dcterms:title="Genome-wide association meta-analyses combining multiple risk phenotypes provide insights into the genetic architecture of cutaneous melanoma susceptibility.", xref="PMID:32341527", xref="https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-020-0611-8/MediaObjects/41588_2020_611_MOESM1_ESM.pdf", comment="The WAMHS population based study was collected from Perth, Australia based on histopathology confirmed invasive, cutaneous melanoma cases in the Western Australian Cancer Registry."}

[Instance]
id: coho:COHO_0001433
name: Warfarin Anticoagulation in Patients in sub-Saharan Africa
def: "An observational study of adults taking warfarin at a stable maintenance dose for venous thromboembolism, atrial fibrillation or valvular heart disease, Black African and, in South Africa, also of mixed ancestry, recruited from June 2018 to March 2020 at outpatient clinics and hospital departments in Uganda and South Africa by the NIHR Global Health Research Group on warfarin anticoagulation in sub-Saharan Africa (the University of Liverpool, the Infectious Diseases Institute in Kampala and the University of Cape Town), with clinical data and blood samples for genotyping, to develop clinical and genetic warfarin dosing algorithms for sub-Saharan African patients." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://warpath.info/", IAO:0000119="PMID:36210801", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT03512080", IAO:0000119="PMID:39163621"}
