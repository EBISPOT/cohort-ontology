property_value: IAO:0000112 "PMID:32887683" xsd:string {dcterms:title="Genomic risk scores for juvenile idiopathic arthritis and its subtypes.", xref="PMID:32887683", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7677485/fullTextXML", comment="Finally, in the Australian cohort, from the ChiLdhood Arthritis Risk factor Identification sTudY (CLARITY),28 29 all the cases were JIA diagnosed by a paediatric rheumatologist."}

[Instance]
id: coho:COHO_0001597
name: California Men's Health Study
def: "A prospective multiethnic cohort of men aged 45 to 69 who were members of the northern and southern California regions of the Kaiser Permanente health plan, recruited in 2002–2003 through a two-stage mailed or online questionnaire with mailing strategies to enrich the cohort with non-white men, and followed through linkage with the health plan's electronic clinical, laboratory, hospitalisation, cancer registry and mortality data, mainly to study the causes of prostate cancer and also of other cancers and non-cancerous conditions in men." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:16813653"}
synonym: "California Mens Health Study" RELATED []
