relationship: coho:has_data_collection_location http://dbpedia.org/resource/Sweden {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2897875/", comment="Verification of eligibility, data on treatment, and the date that surveillance was terminated were extracted from medical records by research nurses in each of six health-care regions in Sweden at a median time of 4 years after the date of diagnosis."}
relationship: coho:hasSubCohort coho:COHO_0002281
relationship: coho:isSubCohortOf coho:COHO_0002724 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2897875/", comment="The Follow-up Study was an observational study in the NPCR, with the aim of assessing outcome among patients with localized prostate cancer who were diagnosed after PSA testing had become prevalent in Sweden and for whom curative treatment may have been indicated."}
property_value: coho:numberOfParticipants "7960" xsd:integer {IAO:0000116="Patients accepting inclusion in the original NPCR Follow-up Study, with diagnoses/registration 1997–2002; eligible frame8304. (1997–2002 diagnoses)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2897875/", comment="In total, 8304 patients fulfilled these criteria and 7960 accepted inclusion to the study (Figure 1)."}
property_value: IAO:0000112 "PMID:20562373" xsd:string {dcterms:title="Outcomes in localized prostate cancer: National Prostate Cancer Register of Sweden follow-up study.", xref="PMID:20562373", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2897875/", comment="In the National Prostate Cancer Register of Sweden Follow-up Study, a nationwide cohort, we identified 6849 patients aged 70 years or younger."}

