property_value: IAO:0000112 "GCST90093097" xsd:string {dcterms:title="A Whole-Genome Sequencing Association Study of Low Bone Mineral Density Identifies New Susceptibility Loci in the Phase I Qatar Biobank Cohort.", xref="PMID:33430342", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33430342+AND+SRC%3AMED&format=json&resultType=core", comment="Here we sequenced the whole genomes of 3000 individuals from the Qatar Biobank and conducted genome-wide association analyses to identify genetic risk factors associated with low BMD in the Qatari population."}
