property_value: IAO:0000112 "GCST90244057" xsd:string {dcterms:title="Rare variant analyses across multiethnic cohorts identify novel genes for refractive error.", xref="PMID:36596879", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/supplementaryFiles", comment="Finnish Twin Study on Aging (FITSA) is a study of genetic and environmental effects on the disablement process in older female twins."}

[Instance]
id: coho:COHO_0001329
name: Follow-up of Ovarian Cancer Genetic Association and Interaction Studies
def: "A post-GWAS research programme on epithelial ovarian cancer, funded by the US National Cancer Institute (U19-CA148112) as the ovarian cancer consortium of the Genetic Associations and Mechanisms in Oncology (GAME-ON) initiative, led from Moffitt Cancer Center and built on the collaboration of the Ovarian Cancer Association Consortium, that pools genome-wide and further genotyping data (including exome-chip and OncoArray genotyping) from the case-control studies of that consortium, to discover and replicate susceptibility variants, including histotype-specific variants and variants associated with survival, to study their biological mechanisms, and to investigate gene–gene and gene–environment interactions and risk prediction." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27598322", IAO:0000119="PMID:40973091", IAO:0000119="PMID:29089348", IAO:0000119="PMID:23382860", IAO:0000119="https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001133/phs001133.v1.p1/GapExchange_phs001133.v1.p1.xml"}
