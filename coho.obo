relationship: coho:has_data_collection_location http://dbpedia.org/resource/Denmark {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18523221+AND+SRC%3AMED&format=json&resultType=core", comment="Three studies of white individuals from Copenhagen, Denmark, were used: the Copenhagen City Heart Study (CCHS), a 31-year prospective general population study (n = 9022; 28 heterozygotes); the Copenhagen General Population Study (CGPS), a cross-sectional general population study (n = 31,241; 76 heterozygotes); and the Copenhagen Ischemic Heart Disease Study (CIHDS), a case-control study (n = 16,623; 44 heterozygotes)."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
property_value: coho:numberOfParticipants "160000" xsd:integer {IAO:0000116="adults enrolled since 2003 (approximate, enrolment ongoing), 2023", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC9960719/", comment="The Copenhagen General Population Study Adults (≥20 years) from the Copenhagen area enrolled since 2003 (~160,000)"}
property_value: IAO:0000112 "PMID:28530674" xsd:string {dcterms:title="Fifteen new risk loci for coronary artery disease highlight arterial-wall-specific mechanisms.", xref="PMID:28530674", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5555387/unicode", comment="In brief, the European (EUR) studies comprised 16,093 CAD cases and 16,616 controls from EPIC-CVD (a case-cohort study embedded in the pan-European EPIC prospective study), the Copenhagen City Heart Study (CCHS), the Copenhagen Ischemic Heart Disease Study (CIHDS) and the Copenhagen General Population Study (CGPS) all recruited within Copenhagen, Denmark."}

[Instance]
id: coho:COHO_0001588
name: China Multi-Center Collaborative Study of Cardiovascular Epidemiology 1998
def: "A population-based cohort of Chinese men and women aged 35–59, selected in 1998 by cluster random sampling in several provinces of China for the 1998 survey of the China Multi-Center Collaborative Study of Cardiovascular Epidemiology (a separate sample from that study's 1992–1994 cohort), whose participants were followed up in 2007–2008, 2012–2015 and 2018–2020 under the uniform protocol of the China-PAR project to study cardiovascular risk factors and incident atherosclerotic cardiovascular disease." [] {IAO:0000119="PMID:37305106", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:34327424", IAO:0000119="PMID:35195259", IAO:0000119="PMID:32433046"}
