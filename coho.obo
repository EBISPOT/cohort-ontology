property_value: coho:numberOfParticipants "1080" xsd:integer {IAO:0000116="pregnant women enrolled 2018-2021", xref="https://projectebisc.org/en/bisc-project/", comment="The enrolment of the BiSC participants (n=1080) was carried out between October 2018 and April 2021 at three tertiary university hospitals in Barcelona, Spain, including Hospital Sant Joan de Déu, Hospital de la Santa Creu i Sant Pau, and Hospital Clínic de Barcelona, and their corresponding primary healthcare centres."}
property_value: IAO:0000112 "PMID:42051041" xsd:string {dcterms:title="Maternal Chrono-Nutrition and Placental DNA Methylation: The BiSC Study.", xref="PMID:42051041", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42051041+AND+SRC%3AMED&format=json&resultType=core", comment="Data came from 389 pregnant women in the Barcelona Life Study Cohort (BiSC)."}

[Instance]
id: coho:COHO_0002636
name: Puberty and metabolic risk in obese children. Epigenetic alterations and pathophysiological and diagnostic implications
def: "A multicentre longitudinal follow-up in Spain (Santiago de Compostela, Córdoba, Zaragoza and Granada) of children who had taken part in the GENOBOX study before puberty and were re-examined after reaching puberty, grouped by obesity and insulin resistance status, to study the progression of metabolic syndrome and cardiometabolic risk factors from prepuberty to puberty and to find biomarkers and epigenetic marks of metabolic complications during puberty." [] {IAO:0000119="PMID:36601007", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://uceens.ugr.es/en/proyecto/puberty-and-metabolic-risk-in-obese-children-epigenetic-alterations-and-pathophysiological-and-diagnostic-implications/"}
subset: coho1:GEC_subset
