property_value: IAO:0000112 "GCST90454283" xsd:string {dcterms:title="Meta-analysis of genome-wide association studies of stable warfarin dose in patients of African ancestry.", xref="PMID:39163621", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11493193/fullTextXML", comment="The African cohorts were obtained through the Warfarin Anticoagulation in Patients in sub-Saharan Africa (War-PATH http://warpath.info/) observational study.16, 17, 18 The War-PATH study enrolled participants receiving warfarin treatment, who were on stable dose, defined as consistent prescribed doses for 2 consecutive clinic visits in the year before recruitment."}

[Instance]
id: coho:COHO_0001434
name: Women's Environmental Cancer and Radiation Epidemiology Study
def: "A population-based case-control study of contralateral breast cancer, designed to examine the joint roles of radiation exposure and genetic susceptibility, in which women diagnosed before age 55 with a first primary invasive breast cancer who later developed contralateral breast cancer were individually matched to women with unilateral breast cancer. Participants were identified through population-based cancer registries in the United States, Canada and Denmark and recruited in two phases, WECARE I (2001–2004) and WECARE II (2009–2012)." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27400983", IAO:0000119="PMID:15084244"}
subset: coho1:GWAS_subset
