property_value: IAO:0000112 "GCST90455659" xsd:string {dcterms:title="Genome-wide association study of 398,238 women unveils seven loci associated with high-grade serous ovarian cancer.", xref="PMID:41266372", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12635163/fullTextXML", comment="We meta-analyzed >22 million variants for 398,238 women from the Ovarian Cancer Association Consortium (OCAC), UK Biobank (UKBB) and Consortium of Investigators of Modifiers of BRCA1/BRCA2 (CIMBA) to identify novel HGSOC susceptibility loci."}

