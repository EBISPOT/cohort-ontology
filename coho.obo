relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10618088/fullTextXML", comment="Healthy control participants, ages 21–50, were recruited by community advertisements in the Los Angeles area and were “White, not Hispanic or Latino;” or “Hispanic or Latino, of any racial group.” The primary language was either English or Spanish (N = 1138; 731 White, 407 Hispanic, of any race)."}
property_value: coho:numberOfParticipants "1138" xsd:integer {IAO:0000116="participants (healthy adults and psychiatric patients) with DNA and task data", xref="PMID:37582857", comment="One sample (n = 1138) comprised healthy participants and some psychiatric patients (53 schizophrenia, 42 bipolar disorder, 47 ADHD); the other (n = 911) excluded for recent treatment of various psychiatric disorders but not ADHD."}
property_value: IAO:0000112 "GCST90336598" xsd:string {dcterms:title="Polygenic contributions to performance on the Balloon Analogue Risk Task.", xref="PMID:37582857", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10618088/fullTextXML", comment="One was the Consortium for Neuropsychiatric Phenomics (CNP), a study performed at the Semel Institute of the University of California Los Angeles (UCLA) to examine underlying genetic and neural factors and their links to three neuropsychiatric illnesses: schizophrenia, bipolar disorder, and attention-deficit hyperactivity disorder (ADHD)."}

[Instance]
id: coho:COHO_0001306
name: Chronic Obstructive Pulmonary Disease in Dusty Areas
def: "A longitudinal observational cohort, begun in 2012 and based at Kangwon National University Hospital, of residents of six districts with cement plants in Gangwon (Kangwon) and Chungbuk provinces, South Korea, comprising people with chronic obstructive pulmonary disease or airflow limitation and volunteers with normal spirometry, examined with questionnaires, spirometry, chest CT and blood and urine sampling, to study the clinical course and outcomes of COPD in people exposed to cement dust." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31172706", IAO:0000119="PMID:29750028", IAO:0000119="PMID:41436567", IAO:0000119="PMID:29117798", IAO:0000119="PMID:41136451"}
subset: coho1:GWAS_subset
