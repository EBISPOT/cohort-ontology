property_value: IAO:0000112 "GCST90704646" xsd:string {dcterms:title="Consensus meta-analysis of genome-wide association studies for Alzheimer's disease and related dementias.", xref="PMID:42237039", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/fullTextXML", comment="Across all studies, we filtered out duplicated variants and those with (1) missing data for effect size, s.e. or P value; (2) an absolute effect size >5 and (3) imputation quality <0.3 (0.8 for the GenADA study)."}

