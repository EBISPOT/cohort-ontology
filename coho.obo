property_value: IAO:0000112 "PMID:23151390" xsd:string {dcterms:title="Neural responses to threat and reward interact to predict stress-related problem drinking: A novel protective role of the amygdala.", xref="PMID:23151390", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23151390+AND+SRC%3AMED&format=json&resultType=core", comment="We used well-established neuroimaging paradigms to probe threat-related amygdala and reward-related ventral striatum reactivity in a sample of 200 young adult students from the ongoing Duke Neurogenetics Study."}

[Instance]
id: coho:COHO_0001610
name: Dubbo Osteoporosis Epidemiology Study
def: "A prospective population-based study of osteoporosis and fracture that in 1989 invited all men and women aged 60 or over living in Dubbo, New South Wales, Australia, a city chosen because its age and sex structure resembled Australia's and its isolation allowed near-complete ascertainment of fractures, and recruited further participants from 2000. Run by investigators of the Garvan Institute of Medical Research, Sydney, it reassessed participants every two to three years with interviews and bone densitometry and recorded fractures from the area's radiology services until 2020." [] {IAO:0000119="PMID:38485241", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:15727686", IAO:0000119="PMID:37701154"}
synonym: "DOES" RELATED OMO:0003000 []
synonym: "Dubbo Osteoporosis Epidemiology study" RELATED []
