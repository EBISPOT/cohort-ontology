property_value: IAO:0000112 "PMID:20801717" xsd:string {dcterms:title="Chromosome 9p21 in sporadic amyotrophic lateral sclerosis in the UK and seven other countries: a genome-wide association study.", xref="PMID:20801717", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20801717+AND+SRC%3AMED&format=json&resultType=core", comment="We collected samples from patients with sporadic ALS from 20 UK hospitals and obtained UK control samples from the control groups of the Depression Case Control study, the Bipolar Affective Case Control Study, and the British 1958 birth cohort DNA collection."}

[Instance]
id: coho:COHO_0001506
name: Arizona Study of Aging and Neurodegenerative Disorders and Brain and Body Donation Program
def: "A brain and body donation programme and clinicopathological study of ageing and neurodegenerative disorders at Banner Sun Health Research Institute in Arizona, United States, started in 1987. Its participants, mostly cognitively normal volunteers from the retirement communities of metropolitan Phoenix together with people recruited because they have Alzheimer's disease, Parkinson's disease or cancer, receive standardized general medical, neurological, neuropsychological and movement-disorder assessments during life and, for most, a full pathological examination after death." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:25619230"}
synonym: "Arizona Study of Aging and Neurodegenerative Disorders" RELATED []
