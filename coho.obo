property_value: coho:numberOfParticipants "1400" xsd:integer {IAO:0000116="participants enrolled in the GpCRC studies (approximate), 2022", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9691520/unicode", comment="We have enrolled approximately 1400 participants to date, with both delayed and normal emptying, in an approximately 3:1 ratio."}
property_value: IAO:0000112 "GCST90295922" xsd:string {dcterms:title="A pilot genome-wide association study meta-analysis of gastroparesis.", xref="PMID:37688361", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10576603/fullTextXML", comment="The Gastroparesis Clinical Research Consortium (GpCRC) is a network of GI tertiary centers in the United States sponsored by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK) that aims to advance knowledge and treatments for GP."}
property_value: IAO:0000116 "NIDDK is the National Institute of Diabetes and Digestive and Kidney Diseases, a funding institute. The GWAS Catalog uses the cohort tag NIDDK for the NIDDK-sponsored Gastroparesis Clinical Research Consortium sample (GCST90295922), which is what this term denotes and which its paper calls the Gastroparesis Clinical Research Consortium cohort; studies that name NIDDK only as a funder (e.g. EGAS00001002937) are not this cohort." xsd:string

