[Instance]
id: coho:COHO_0001479
name: Autism Genome Project
def: "An international consortium of autism genetics research groups at more than 50 centres in North America and Europe, initiated by the National Alliance for Autism Research (later Autism Speaks) and the US National Institutes of Health and formed from four existing consortia (the Autism Genetics Cooperative, the Autism Genetic Resource Exchange, the Collaborative Programs of Excellence in Autism and the International Molecular Genetic Study of Autism Consortium). It pools the families with autism spectrum disorder collected at its sites, diagnosed with the ADI-R and ADOS, for genome-wide linkage, copy number variation and association studies." [] {IAO:0000119="PMID:17322880", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:24768552", IAO:0000119="PMID:16078860"}
synonym: "AGP" RELATED OMO:0003000 []
synonym: "AGP Consortium" RELATED []
synonym: "Autism Genome Project Consortium" RELATED []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:hasCohort coho:COHO_0001480 {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3004528/unicode", comment="As one of many contributors to the AGP, AGRE continues to sit on the cutting edge of research."}
property_value: coho:numberOfParticipants "9050" xsd:integer {IAO:0000116="individuals from 2,845 ASD-affected families in the 2014 CNV analysis (stages 1 and 2)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4067558/fullTextXML", comment="To explore the contribution of CNV to ASD, we expanded our previous study (stage 1)6 with an additional 1,604 families (stage 2), bringing the total to 9,050 individuals from 2,845 ASD-affected families."}
property_value: IAO:0000112 "PMID:30804558" xsd:string {dcterms:title="Identification of common genetic risk variants for autism spectrum disorder.", xref="PMID:30804558", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6454898/unicode", comment="In brief, five cohorts provided genotypes to the sample (N denoting the number of trios for which genotypes were available): The Geschwind Autism Center of Excellence (ACE; N = 391), the Autism Genome Project (AGP; N = 2,272), the Autism Genetic Resource Exchange (AGRE; N = 974), the NIMH Repository, the Montreal/Boston Collection (MONBOS; N = 1,396, and the Simons Simplex Collection(SSC; N = 2,231)."}

[Instance]
id: coho:COHO_0001480
name: Autism Genetic Resource Exchange
def: "A resource of biomaterials (cell lines, DNA and serum) and genetic and phenotypic data from families with autism spectrum disorder recruited from across the United States, mostly multiplex families with two or more affected members, whose diagnostic assessments (ADI-R and ADOS) and blood draws are done in the families' homes. It was established in 1997 by the Cure Autism Now Foundation and the Human Biological Data Interchange, is now managed by Autism Speaks, and makes its samples and data available to qualified researchers." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:11452364", IAO:0000119="PMID:20955925", IAO:0000119="PMID:28702161"}
