relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11141906/fullTextXML", comment="MPAACH, the first US prospective longitudinal early-life cohort of children with AD who complete annual visits with extensive biospecimen collection, has been previously described (12)."}
property_value: coho:numberOfParticipants "557" xsd:integer {IAO:0000116="children with atopic dermatitis recruited by the time of the 2020 design paper (recruitment ongoing)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC7338239/", comment="The MPAACH cohort has many strengths including its size (thus far we have recruited 557 participants), rigorous phenotyping of AD, comprehensive biospecimen collection, extensive biomarker determinations, and its longitudinal design."}
property_value: IAO:0000112 "PMID:38564302" xsd:string {dcterms:title="Filaggrin loss-of-function variants are associated with atopic dermatitis phenotypes in a diverse, early-life prospective cohort.", xref="PMID:38564302", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11141906/fullTextXML", comment="We performed deep sequencing of the FLG gene in 438 individuals from MPAACH, an early-life cohort of children with AD."}

