relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Greece {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5814832/", comment="The LOGOS acquired the same recruitment procedures as the ASPIS, assessing Caucasian healthy male conscripts (N = 690; mean age: 22.3 ± 3.7) on multiple cognitive and psychometric phenotypes, at the Greek Army Training Camp in Heraklion, Crete, Greece."}
property_value: coho:numberOfParticipants "1540" xsd:integer {IAO:0000116="young male Greek Army conscripts recruited June 2008 to July 2011 (2008-2011)", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fmp.2016.244/MediaObjects/41380_2017_BFmp2016244_MOESM471_ESM.docx", comment="The LOGOS project recruited 1540 randomly selected young male conscripts from the Greek Army (mean age 22.13; range 18–44) between June 2008 and July 2011 at the Military Training Camp of Candidate, Supply Army officers (SEAP) in Heraklion, Crete."}
property_value: IAO:0000112 "PMID:29036523" xsd:string {dcterms:title="Stress-Dependent Association Between Polygenic Risk for Schizophrenia and Schizotypal Traits in Young Army Recruits.", xref="PMID:29036523", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29036523+AND+SRC%3AMED&format=json&resultType=core", comment="Here, we sought to investigate the contribution of common genetic risk variation for SZ on self-reported schizotypy in 2 ethnically homogeneous cohorts of healthy young males during compulsory military service, enrolled in the Athens Study of Proneness and Incidence of Schizophrenia (ASPIS, N = 875) and the Learning on Genetics of Schizophrenia Spectrum study (LOGOS, N = 690)."}

[Instance]
id: coho:COHO_0002014
name: LonGenity study
def: "A longitudinal cohort study at the Institute for Aging Research of the Albert Einstein College of Medicine in the Bronx, New York, which from 2008 enrolled Ashkenazi Jewish adults aged 65 or older from the New York City area without significant cognitive, visual or hearing impairment, comparing offspring of parents with exceptional longevity (at least one parent surviving to 95) with offspring of parents with usual survival, and follows them until death with biomarkers, genotyping, proteomics and cognitive and frailty assessments to study healthy ageing." [] {IAO:0000119="PMID:24997018", IAO:0000119="PMID:42646838", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:41529745"}
synonym: "LonGenity" RELATED OMO:0003000 []
