id: coho:COHO_0002242
name: Pathobiological Determinants of Atherosclerosis in Youth
def: "A multi-institutional autopsy study, sponsored by the US National Heart, Lung, and Blood Institute, in which fifteen cooperating centres in eight US communities used standardised procedures to collect arteries, blood and other tissues from black and white males and females aged 15 to 34 who died of external causes (accidents, homicides and suicides) and were autopsied between 1987 and 1994, to relate established coronary heart disease risk factors to the extent of atherosclerotic lesions in youth." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:10052443", IAO:0000119="PMID:22015179", IAO:0000119="PMID:27861582"}
subset: coho1:PGS_subset
synonym: "PDAY" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10052443+AND+SRC%3AMED&format=json&resultType=core", comment="The Pathobiological Determinants of Atherosclerosis in Youth Study, a multi-institutional autopsy study conducted in US medical centers."}
property_value: coho:numberOfParticipants "3013" xsd:integer {IAO:0000116="Individuals in the PDAY autopsy study described in the 2011 profile", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3272499/", comment="The Pathobiological Determinants of Atherosclerosis in Youth (PDAY) study is a bi-racial investigation of the development and progression of atherosclerosis involving 3013 individuals aged 15–34 who underwent autopsy within 48 h following death from external causes including accidents, homicides, and suicide [9]."}
property_value: IAO:0000112 "PGS000667" xsd:string {dcterms:title="Contemporary Polygenic Scores of Low-Density Lipoprotein Cholesterol and Coronary Artery Disease Predict Coronary Atherosclerosis in Adolescents and Young Adults.", xref="PMID:37409455"}
property_value: IAO:0000112 "PMID:37409455" xsd:string {dcterms:title="Contemporary Polygenic Scores of Low-Density Lipoprotein Cholesterol and Coronary Artery Disease Predict Coronary Atherosclerosis in Adolescents and Young Adults.", xref="PMID:37409455", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10581412/unicode", comment="We assessed whether contemporary polygenic scores (PGSs) for coronary artery disease (CAD) or for risk factors of CAD can predict the presence of raised coronary plaque among adolescents and young adults examined in the PDAY study (Pathobiological Determinants of Atherosclerosis in Youth) involving 15 laboratories that conducted autopsies on 2876 people aged 15 to 34 years dying of external causes between 1987 and 1994."}

[Instance]
id: coho:COHO_0002243
name: French Parkinson's Disease Genetics Study Group
def: "A French network for the study of Parkinson's disease genetics, associating university hospitals across France, through which patients with Parkinson's disease of European origin, including early-onset index cases, and some healthy controls are recruited for genetic studies, with samples prepared by the DNA and cell bank of the CRicm in Paris." [] {IAO:0000119="PMID:23408064", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27066548", IAO:0000119="PMID:33841314", IAO:0000119="PMID:20598272"}
