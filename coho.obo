property_value: IAO:0000112 "GCST90319324" xsd:string {dcterms:title="Trans-Ancestral Genetic Risk Factors for Treatment-Related Type 2 Diabetes Mellitus in Survivors of Childhood Cancer.", xref="PMID:38652878", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38652878+AND+SRC%3AMED&format=json&resultType=core", comment="Leveraging whole-genome sequencing data from the St Jude Lifetime Cohort (N = 3,676, 304 clinically ascertained cases), we conducted ancestry-specific genome-wide association studies among survivors of African and European genetic ancestry (AFR and EUR, respectively) followed by trans-ancestry meta-analysis."}

[Instance]
id: coho:COHO_0001121
name: Swedish Low-risk Colorectal Cancer Study
def: "A multicentre study in central Sweden of consecutive patients newly diagnosed with colorectal cancer of any stage, recruited between 2004 and 2009 at 14 hospitals by the Swedish Low-Risk Colorectal Cancer Study Group and interviewed on their family history of cancer, with a lifestyle questionnaire for those recruited in 2004–2006 and cancer-free spouses of participants serving as controls; its cases and controls are used in genetic studies of colorectal cancer risk." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:39543761", IAO:0000119="PMID:20648012", IAO:0000119="PMID:39665592"}
