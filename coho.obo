property_value: IAO:0000112 "PMID:35383826" xsd:string {dcterms:title="Plasma biomarkers and genetics in the diagnosis and prediction of Alzheimer's disease.", xref="PMID:35383826", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9924904/fullTextXML", comment="The Alzheimer’s Disease Cardiff Cohort (ADCC) was collected between 2004 and 2020 using MRC, Moondance Foundation and Health and Care Research Wales (HCRW) funding."}

[Instance]
id: coho:COHO_0001471
name: Analyse des DEterminants génétiques et environnementaux de la Leucoaraiose dans une population de sujets Agés Hypertendus présentant des troubles cognitifs DEbutants
def: "A single-centre cohort study at Nancy University Hospital, France, of older treated hypertensive patients with subjective memory complaints, recruited in the early 2000s through local press advertisements and general practitioners of the Inserm clinical investigation centre network, who had cognitive testing, brain MRI for white matter hyperintensities, measurements of arterial stiffness, carotid structure and endothelial function, and DNA and serum banking, and were re-examined about eight years later (ADELAHYDE-2), to identify genetic, environmental and vascular determinants of leukoaraiosis and cognitive decline." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:25332706", IAO:0000119="PMID:32039844", IAO:0000119="PMID:19246701", IAO:0000119="PMID:29276677", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT01351961"}
