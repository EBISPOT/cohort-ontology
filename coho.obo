property_value: IAO:0000112 "GCST90129578" xsd:string {dcterms:title="Genome-Wide Association Study of Campylobacter-Positive Diarrhea Identifies Genes Involved in Toxin Processing and Inflammatory Response.", xref="PMID:35420468", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9239263/fullTextXML", comment="Here, we aimed to identify genetic variants associated with host susceptibility to Campylobacter infection using two well-characterized birth cohorts: the Performance of Rotavirus and Oral Polio Vaccines in Developing Countries (PROVIDE) Study (19) and the Cryptosporidiosis Birth Cohort (CBC) (20)."}

[Instance]
id: coho:COHO_0001226
name: Queensland Twin Registry
def: "A population-based registry of identical and non-identical twins and triplets of all ages living in Australia, established in 2006 at the QIMR Berghofer Medical Research Institute in Brisbane, whose members are invited into twin research projects on health and disease; genetic studies drawing on QIMR Berghofer's genotyped twin and family samples report them under the registry's name." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:26242864", IAO:0000119="https://www.qimrb.edu.au/studies/queensland-twin-registry-(qtwin)-study", IAO:0000119="PMID:32546850"}
