name: Normative Aging Study
def: "A longitudinal study of health and aging, established by the Veterans Administration in 1963, of healthy men aged 21 to 80 from the greater Boston area, United States, who were free of known chronic medical conditions at enrolment." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01314-0/MediaObjects/41588_2023_1314_MOESM1_ESM.pdf", dcterms:contributor="Claude Sonnet 5 (Anthropic), 2026-09"}
