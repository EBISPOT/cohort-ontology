[Instance]
id: coho:COHO_0001338
name: Genetics of Osteoarthritis Consortium
def: "A global collaboration that aims to bring together all available genetic studies of osteoarthritis, meta-analysing genome-wide association data on osteoarthritis at different joint sites (hip, knee, hand, finger, thumb and spine) and related traits from its contributing cohorts and biobanks in Europe, East Asia, North America and Australia, among them UK Biobank, arcOGEN, deCODE, the HUNT Study, the Estonian Biobank, the Rotterdam Study, FinnGen and the Million Veteran Program." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.genetics-osteoarthritis.com/themenmenue/home/index.html", IAO:0000119="https://www.genetics-osteoarthritis.com/contributing-studies/contributing-studies/index.html", IAO:0000119="PMID:34450027"}
