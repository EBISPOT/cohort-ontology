property_value: IAO:0000112 "PMID:24795349" xsd:string {dcterms:title="Genome-wide association study identifies variants in casein kinase II (CSNK2A2) to be associated with leukocyte telomere length in a Punjabi Sikh diabetic cohort.", xref="PMID:24795349", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC4106467/", comment="Combined AIDHS/SDS and UKCVD meta-analysis revealed rs74019828 (CSNK2A2) and rs112020835 (FER) to be significantly associated with RTL (Figure 6, Supplementary Table 11)."}

