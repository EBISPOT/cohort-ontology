property_value: IAO:0000112 "PMID:31792337" xsd:string {dcterms:title="A Weighted Genetic Risk Score of Adult Glioma Susceptibility Loci Associated with Pediatric Brain Tumor Risk.", xref="PMID:31792337", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31792337+AND+SRC%3AMED&format=json&resultType=core", comment="The GRS was calculated in CEFALO, a population-based case-control study of brain tumors in children and adolescents including saliva DNA of 245 cases and 489 controls."}

[Instance]
id: coho:COHO_0001585
name: Color Genomics
def: "A research cohort of people whose healthcare provider ordered clinical-grade multi-gene panel testing for inherited disease risk, such as hereditary breast and ovarian cancer, from Color Genomics, a commercial genetic testing laboratory in Burlingame, California, and who gave electronic informed consent, under a Western Institutional Review Board protocol, for their de-identified samples, sequence data and health histories, self-reported through an online tool, to be used in research." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31771638", IAO:0000119="PMID:32820175"}
synonym: "CG" RELATED OMO:0003000 []
