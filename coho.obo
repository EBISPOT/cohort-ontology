property_value: IAO:0000112 "PMID:35435501" xsd:string {dcterms:title="Fruit and vegetable intake and risk of prediabetes and type 2 diabetes: results from a 20-year long prospective cohort study in Swedish men and women.", xref="PMID:35435501", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9363331/fullTextXML", comment="The present study is part of the Stockholm Diabetes Prevention Program (SDPP), a prospective cohort study that comprised men and women 35–56 years old at baseline, without previously diagnosed diabetes, from five municipalities in Stockholm County."}

[Instance]
id: coho:COHO_0002361
name: Study of the Effectiveness of Additional Reductions in Cholesterol and Homocysteine
def: "A randomised trial cohort of men and women aged 18–80 years with a history of myocardial infarction, recruited from 1998 through special clinics at 88 UK hospitals and coordinated by the Clinical Trial Service Unit in Oxford, which compared 80 mg with 20 mg simvastatin daily and, in a two-by-two factorial design, folic acid plus vitamin B12 with placebo, and whose participants also served for the identification of an SLCO1B1 variant associated with simvastatin-induced myopathy." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:21067805"}
