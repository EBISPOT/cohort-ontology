relationship: coho:has_data_collection_location http://dbpedia.org/resource/Finland {xref="https://api.datacite.org/dois/10.5281/zenodo.7499101", comment="This improved PEM will be used for longitudinal monitoring of pregnant women from the Finnish Maternity Cohort (FMC), which collects data and samples from all pregnant women in Finland."}
property_value: coho:numberOfParticipants "100" xsd:integer {IAO:0000116="healthy pregnant and non-pregnant women", xref="https://api.datacite.org/dois/10.5281/zenodo.10707225", comment="The wearablesensor cohort in HEAP consists of healthy pregnant and non-pregnant women (N=100)followed up for at least four months with systematic longitudinal sampling using wearablesdevices and urine sampling."}
property_value: IAO:0000112 "PMID:34909561" xsd:string {dcterms:title="Human exposome assessment platform.", xref="PMID:34909561", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8663864/fullTextXML", comment="Some of the pregnant women in the HPV vaccination Cohort (~100 pregnant women) will be followed using an innovative wearable exposure sensors system for the monitoring of multiple exposures and health measurements, to investigate how the exposome influences the health of the mother and the baby."}

[Instance]
id: coho:COHO_0002616
name: Kardiovize Brno 2030
def: "A prospective population-based cohort of a random, sex- and age-stratified 1% sample of residents of Brno, Czech Republic, aged 25–64 years, drawn from health insurance registries in 2013 and examined at St Anne's University Hospital in Brno, to study how biological, psychosocial, environmental, behavioural and economic factors relate to cardiovascular disease and its outcomes in a Central European urban population." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28812915", IAO:0000119="PMID:34631132"}
