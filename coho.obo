property_value: IAO:0000112 "PMID:18599522" xsd:string {dcterms:title="FTO variants are associated with obesity in the Chinese and Malay populations in Singapore.", xref="PMID:18599522", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2551698/fullTextXML", comment="We examined associations between nine previously reported FTO single nucleotide polymorphisms (SNPs) with obesity, type 2 diabetes, and related traits in 4,298 participants (2,919 Chinese, 785 Malays, and 594 Asian Indians) from the 1998 Singapore National Health Survey (NHS98) and 2,996 Malays from the Singapore Malay Eye Study (SiMES)."}

[Instance]
id: coho:COHO_0002144
name: Nurses' Health Study advanced adenoma set
def: "The advanced colorectal adenoma case-control sample of the Nurses' Health Study, United States, genotyped for the Genetics and Epidemiology of Colorectal Cancer Consortium: participants with an advanced adenoma (1 cm or larger, or with tubulovillous or villous histology, high-grade dysplasia or carcinoma in situ) confirmed by medical record review, matched to participants who had a lower endoscopy in the same period without an adenoma on year of birth, date of blood sampling, reason for the endoscopy and timing of any prior endoscopy." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms8138/MediaObjects/41467_2015_BFncomms8138_MOESM787_ESM.pdf", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0286-6/MediaObjects/41588_2018_286_MOESM1_ESM.pdf"}
