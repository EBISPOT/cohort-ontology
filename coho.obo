[Instance]
id: coho:COHO_0001238
name: Sequenced Treatment Alternatives to Relieve Depression
def: "A multisite, prospective, randomised, multistep clinical trial, funded by the US National Institute of Mental Health through the University of Texas Southwestern Medical Center at Dallas, that from 2001 enrolled adult outpatients aged 18 to 75 with nonpsychotic major depressive disorder from primary and specialty (psychiatric) care practices across the United States, to determine which treatments work best for those who do not respond adequately to initial treatment with citalopram." [] {IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT00021528", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27519822", IAO:0000119="PMID:15061154"}
