relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7385160/fullTextXML", comment="Patients were enrolled in 112 participating institutions in nine European countries between February 2007 and September 2011."}
property_value: coho:numberOfParticipants "6693" xsd:integer {IAO:0000116="women with early-stage breast cancer enrolled, February 2007 to September 2011 (2007-2011)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27557300+AND+SRC%3AMED&format=json&resultType=core", comment="In this randomized, phase 3 study, we enrolled 6693 women with early-stage breast cancer and determined their genomic risk (using the 70-gene signature) and their clinical risk (using a modified version of Adjuvant! Online)."}
property_value: IAO:0000112 "PGS000004" xsd:string {dcterms:title="Associations of a Breast Cancer Polygenic Risk Score With Tumor Characteristics and Survival.", xref="PMID:36689693"}
property_value: IAO:0000112 "PMID:36689693" xsd:string {dcterms:title="Associations of a Breast Cancer Polygenic Risk Score With Tumor Characteristics and Survival.", xref="PMID:36689693", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36689693+AND+SRC%3AMED&format=json&resultType=core", comment="Women with invasive breast cancer were included, 98,397 of European ancestry and 12,920 of Asian ancestry, from the Breast Cancer Association Consortium (BCAC), and 683 women from the European MINDACT trial."}

[Instance]
id: coho:COHO_0002071
name: obsolete Malawi-Liverpool Wellcome Clinical Research Programme, Blantyre
comment: Obsoleted 2026-09-24. Checked 2026-09-23: The evidence is a table row (Band et al. 2013 Table S1, https://journals.plos.org/plosgenetics/article/file?type=supplementary&id=10.1371/journal.pgen.1003509.s020, a .docx): 'Malawi | Malawi-Liverpool Wellcome Clinical Research Programme, Blantyre | University of Malawi, college of Medicine | CoM REC | Illumina 1.2M'. The PGS Catalog id has no score or sample set in the Catalog today (it is only in the Catalog's cohort table). MLWCRP is the PGS Catalog's id for the site name that Band et al. 2013 (PMID:23717212) give for their Malawi sample: the Malawi-Liverpool Wellcome Clinical Research Programme in Blantyre, the research programme that runs the Malawi severe malaria case-control study. The sample itself is the MalariaGEN partner study already in COHO as 'Human genetic determinants of severe malaria in Malawi' (COHO:0001536), which was minted from the PGS id 'Blantyre' taken from the same paper. So this placeholder is a duplicate of COHO:0001536: add MLWCRP as an acronym and the catalog name as a synonym there, and retire the placeholder (COHO:0002071). Replaced by COHO:0001536 (Human genetic determinants of severe malaria in Malawi), which now carries this term's names. Found by a check of the placeholder names flagged as institutions or places against their sources, 2026-09-24.
is_obsolete: true
replaced_by: coho:COHO_0001536

