relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0609-2/MediaObjects/41588_2020_609_MOESM3_ESM.xlsx", comment="2SISTER The Two Sister Study USA Case-only study"}
relationship: coho:isCohortOf coho:COHO_0000020
relationship: coho:isSubCohortOf coho:COHO_0000660 {xref="https://sisterstudy.niehs.nih.gov/English/2sis.htm", comment="The Two Sister Study is an offshoot of the Sister Study that focuses on young-onset breast cancer and is based on families."}
property_value: coho:numberOfCases "1422" xsd:integer {IAO:0000116="young-onset breast cancer cases enrolled 2008-2010 and their breast cancer-free control sisters from the Sister Study", xref="PMID:22773825", comment="We conducted the Two Sister Study, a sister-matched case-control study, by enrolling 1422 women between September 2008 and December 2010, who were younger than age 50 years at diagnosis with breast cancer and were enrolled within 4 years of diagnosis, and 1669 breast cancer-free control sisters from the Sister Study."}
property_value: coho:numberOfControls "1669" xsd:integer {IAO:0000116="young-onset breast cancer cases enrolled 2008-2010 and their breast cancer-free control sisters from the Sister Study", xref="PMID:22773825", comment="We conducted the Two Sister Study, a sister-matched case-control study, by enrolling 1422 women between September 2008 and December 2010, who were younger than age 50 years at diagnosis with breast cancer and were enrolled within 4 years of diagnosis, and 1669 breast cancer-free control sisters from the Sister Study."}
property_value: IAO:0000112 "PMID:22773825" xsd:string {dcterms:title="Fertility drugs and young-onset breast cancer: results from the Two Sister Study.", xref="PMID:22773825", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22773825+AND+SRC%3AMED&format=json&resultType=core", comment="We conducted the Two Sister Study, a sister-matched case-control study, by enrolling 1422 women between September 2008 and December 2010, who were younger than age 50 years at diagnosis with breast cancer and were enrolled within 4 years of diagnosis, and 1669 breast cancer-free control sisters from the Sister Study."}

[Instance]
id: coho:COHO_0001454
name: Women's Health Study: From Adolescence to Adulthood
def: "A longitudinal cohort of the Boston Center for Endometriosis (Boston Children's Hospital and Brigham and Women's Hospital, Boston) that in 2012–2018 enrolled adolescent and adult females aged 7–55 with surgically diagnosed endometriosis at the two hospitals, together with participants without endometriosis from their clinics and the local community, collected blood and urine samples at enrolment, and follows participants with annual questionnaires, compliant since 2014 with the World Endometriosis Research Foundation's EPHect standards." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32833998", IAO:0000119="PMID:38495219", IAO:0000119="PMID:38665804"}
synonym: "A2A" RELATED OMO:0003000 []
synonym: "The Women's Health Study: From Adolescence to Adulthood" RELATED []
synonym: "The Women's Health Study: from Adolescence to Adulthood" RELATED []
