property_value: IAO:0000112 "GCST90984764" xsd:string {dcterms:title="A polygenic score for acute vaso-occlusive pain in pediatric sickle cell disease.", xref="PMID:34283174", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34283174+AND+SRC%3AMED&format=json&resultType=core", comment="To investigate this in sickle cell disease (SCD), we performed whole-genome sequencing (WGS) of 722 individuals with hemoglobin HbSS or HbSβ0-thalassemia from Baylor College of Medicine and from the St. Jude Children's Research Hospital Sickle Cell Clinical Research and Intervention Program (SCCRIP) longitudinal cohort study."}

[Instance]
id: coho:COHO_0001116
name: Asian Indian Diabetic Heart Study/Sikh Diabetes Study
def: "A genetic epidemiological study of type 2 diabetes and cardiovascular disease in Punjabi-speaking Sikhs of North Indian origin, begun as a family-based study of Khatri Sikh families with at least two siblings affected by type 2 diabetes and extended as a case-control study, with participants recruited in northern India from 2003, to investigate genetic and environmental risk factors for type 2 diabetes and cardiovascular disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38152657", IAO:0000119="PMID:16900881", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf"}
