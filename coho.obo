property_value: seeAlso https://www.i-med.ac.at/msig/vhmpp.html

[Instance]
id: coho:COHO_0002700
name: 45 and Up Study
def: "A prospective population-based cohort of men and women aged 45 years and over in New South Wales, Australia, randomly sampled from the Medicare enrolment database and recruited by postal questionnaire in 2005–2009 by the Sax Institute, with oversampling of people aged 80 and over and of rural and remote residents, repeated follow-up surveys, biospecimen sub-studies and routine linkage to mortality, hospital, pharmaceutical and other health records, as a resource for research on health and ageing." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35604374"}
subset: coho1:IHCC_subset
synonym: "Sax Institute's 45 and Up Study" RELATED []
