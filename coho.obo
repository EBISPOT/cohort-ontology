[Instance]
id: coho:COHO_0002642
name: New Hampshire Birth Cohort Study
def: "A prospective longitudinal cohort of pregnant women enrolled since 2009 at prenatal clinics in the Concord and Lebanon regions of New Hampshire, USA, by the Geisel School of Medicine at Dartmouth, and of their children, followed from early pregnancy into childhood to study how environmental contaminants, such as arsenic from private well water, affect the health of pregnant women and their children." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27825389", IAO:0000119="https://www.protectkidshealth.com/about"}
