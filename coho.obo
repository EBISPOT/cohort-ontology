[Instance]
id: coho:COHO_0002615
name: Wearable data collection study
def: "A longitudinal cohort of healthy pregnant and non-pregnant women in Finland, enrolled by the University of Oulu from 2022 within the EU Human Exposome Assessment Platform (HEAP) project and followed for at least four months with wearable personal exposome monitors and repeated biological sampling (blood, saliva, sweat, urine), to pilot personal profiling of chemical and biological exposures." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:34909561", IAO:0000119="https://api.datacite.org/dois/10.5281/zenodo.10707225", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/WDC"}
subset: coho1:GEC_subset
