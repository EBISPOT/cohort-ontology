[Instance]
id: coho:COHO_0000402
name: HOLBAEK Study
def: "A Danish cohort of children and adolescents, formerly called The Danish Childhood Obesity Biobank, run since 2009 from the Children's Obesity Clinic at Copenhagen University Hospital Holbæk, that combines an obesity clinic cohort with a BMI above the 90th percentile, included continuously and followed longitudinally during multidisciplinary obesity treatment, with a population-based reference cohort recruited cross-sectionally from schools in 11 municipalities in Zealand; by 2020 it held data on more than 5,250 obesity clinic and more than 4,200 population-based participants, with biosamples, genotyping and cardiometabolic phenotyping, as a platform for research on childhood obesity and its complications." [] {IAO:0000119="PMID:39753034", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:39972214", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT00928473"}
subset: coho1:GWAS_subset
synonym: "HOLBAEK" RELATED OMO:0003000 []
synonym: "TDCOB" RELATED OMO:0003000 []
synonym: "The Danish Childhood Obesity Biobank" RELATED []
synonym: "The Danish Childhood Obesity Data- and Biobank" RELATED []
synonym: "The Holbaek Study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Denmark {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11754075/fullTextXML", comment="The study population consisted of children and adolescents from the HOLBAEK Study (previously known as The Danish Childhood Obesity Biobank),17 including an obesity clinic cohort with a BMI above the 90th percentile for sex and age (BMI standard deviation score [SDS] > 1.28) according to a Danish reference; and a population-based cohort, recruited from schools in 11 municipalities in Zealand, Denmark.18"}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
property_value: IAO:0000112 "GCST90452968" xsd:string {dcterms:title="Plasma proteome variation and its genetic determinants in children and adolescents.", xref="PMID:39972214", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11906355/fullTextXML", comment="Our discovery cohort included 2,147 children and adolescents aged 5–20 years from the HOLBAEK Study, 45% of whom were from the general population and 55% from the Children’s Obesity Clinic in Holbæk, Denmark (Fig. 1a)."}

[Instance]
id: coho:COHO_0000403
name: FinnGen
def: "A public–private partnership research project in Finland that combines genotype data from newly collected and legacy samples of about 500,000 participants of a nationwide network of Finnish biobanks with digital health data from national health registers, to provide genetic insights into disease in an isolated population enriched for low-frequency variants." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:36653562", IAO:0000119="https://www.finngen.fi/en"}
