property_value: IAO:0000112 "PMID:22113997" xsd:string {dcterms:title="The chromosome 2p21 region harbors a complex genetic architecture for association with risk for renal cell carcinoma.", xref="PMID:22113997", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3277315/", comment="We genotyped 59 tagged SNPs in 2278 RCC cases and 3719 controls from two nested case–control studies [the Prostate, Lung, Colorectal and Ovarian (PLCO) Cancer Screening Trial and the Alpha-Tocopherol, Beta-Carotene Cancer Prevention (ATBC) study in Finland], a hospital-based Central and Eastern European RCC (CEERCC) case–control study and Caucasians from the United States Kidney Cancer (USKC) population-based case–control study (see Materials and Methods and Fig. 1)."}

[Instance]
id: coho:COHO_0001584
name: CEFALO
def: "An international population-based case–control study of primary intracranial brain tumours in children and adolescents aged 7–19 in Denmark, Norway, Sweden and Switzerland, whose cases were diagnosed between 2004 and 2008 and identified through hospitals and national cancer registries, and whose controls were drawn at random from population registries and matched by age, sex and region. The children and their parents were interviewed in person, mainly to find out whether mobile phone use and other exposures raise the risk of brain tumours; saliva DNA from part of the participants was genotyped in candidate-gene studies." [] {IAO:0000119="PMID:26014354", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31792337", IAO:0000119="PMID:21795665", IAO:0000119="PMID:23652309"}
synonym: "Cefalo" RELATED []
synonym: "CEFALO study" RELATED []
