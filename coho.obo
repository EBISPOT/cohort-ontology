[Instance]
id: coho:COHO_0001465
name: Action to Control Cardiovascular Risk in Diabetes
def: "A randomised, multicentre, double 2×2 factorial trial cohort of middle-aged and older adults with type 2 diabetes at high risk of cardiovascular events because of existing cardiovascular disease or additional risk factors, recruited in 2001–2005 through seven clinical networks in the United States and Canada with funding from the US National Heart, Lung, and Blood Institute. All participants were randomised to intensive or standard glycaemic control and, in two sub-trials, to intensive or standard blood-pressure control or to fenofibrate or placebo added to simvastatin, to test whether these strategies reduce major cardiovascular events." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:17599422", IAO:0000119="PMID:30262460"}
synonym: "ACCORD" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Canada {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6196830/fullTextXML", comment="A total of 10,251 participants with type 2 diabetes were recruited from seven clinical networks in the U.S. and Canada between 2001 and 2005 and randomized in a 1:1 ratio to receive intensive glucose-lowering treatment, aiming for an HbA1c level below 6%, or to standard treatment, aiming for an HbA1c level between 7.0% and 7.9%."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States
property_value: coho:numberOfParticipants "10251" xsd:integer {IAO:0000116="participants with type 2 diabetes randomised 2001-2005", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6196830/fullTextXML", comment="A total of 10,251 participants with type 2 diabetes were recruited from seven clinical networks in the U.S. and Canada between 2001 and 2005 and randomized in a 1:1 ratio to receive intensive glucose-lowering treatment, aiming for an HbA1c level below 6%, or to standard treatment, aiming for an HbA1c level between 7.0% and 7.9%."}
property_value: IAO:0000112 "PMID:30262460" xsd:string {dcterms:title="Genetic Tools for Coronary Risk Assessment in Type 2 Diabetes: A Cohort Study From the ACCORD Clinical Trial.", xref="PMID:30262460", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6196830/fullTextXML", comment="We also evaluated the extent to which these genetic markers improve the prediction of incident MCE when added to conventional cardiovascular risk factors and assessed whether a genetic risk score (GRS) derived from these SNPs could identify subsets of patients with type 2 diabetes with different responses to intensive glucose, blood pressure, and lipid control in the Action to Control Cardiovascular Risk in Diabetes (ACCORD) trial."}

[Instance]
id: coho:COHO_0001466
name: Anglo-Cardiff Collaborative Trial
def: "A population of adults in East Anglia and Wales, United Kingdom, selected at random from local general practice lists and open-access cardiovascular risk assessment clinics and studied by investigators in Cambridge and Cardiff, comprising healthy people as well as people with cardiovascular risk factors or disease, whose peripheral and central blood pressure, wave reflection and aortic pulse wave velocity were measured, with questionnaires and blood samples, to study vascular ageing, arterial stiffness and central blood pressure across the adult lifespan." [] {IAO:0000119="PMID:16256881", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28247509", IAO:0000119="PMID:18426997", IAO:0000119="PMID:40879028"}
