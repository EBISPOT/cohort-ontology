[Instance]
id: coho:COHO_0002344
name: Saxagliptin Assessment of Vascular Outcomes Recorded in Patients with Diabetes Mellitus-Thrombolysis in Myocardial Infarction 53
def: "A phase 4, multinational, randomised, double-blind, placebo-controlled trial of the TIMI Study Group, conducted in 25 countries, that enrolled people aged 40 and older with type 2 diabetes mellitus and either established cardiovascular disease or multiple cardiovascular risk factors and randomised them to the DPP-4 inhibitor saxagliptin or matching placebo, to evaluate the drug's cardiovascular safety and efficacy with a primary endpoint of cardiovascular death, myocardial infarction or ischaemic stroke." [] {IAO:0000119="PMID:36474045", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22093196", dcterms:contributor="Claude Sonnet 5 (Anthropic), 2026-09"}
subset: coho1:PGS_subset
synonym: "SAVOR-TIMI 53" RELATED OMO:0003000 []
synonym: "SAVOR-TIMI_53" RELATED OMO:0003000 []
synonym: "Saxagliptin Assessment of Vascular Outcomes Recorded in Patients with Diabetes Mellitus" RELATED []
synonym: "The Saxagliptin Assessment of Vascular Outcomes Recorded in Patients with Diabetes Mellitus" RELATED []
instance_of: coho:COHO_0000000 ! cohort
property_value: coho:numberOfParticipants "16492" xsd:integer {IAO:0000116="SAVOR-TIMI 53 randomized patients with type 2 diabetes", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23992601+AND+SRC%3AMED&format=json&resultType=core", comment="We randomly assigned 16,492 patients with type 2 diabetes who had a history of, or were at risk for, cardiovascular events to receive saxagliptin or placebo and followed them for a median of 2.1 years."}
property_value: IAO:0000112 "PGS000016" xsd:string {dcterms:title="A polygenic risk score predicts atrial fibrillation in cardiovascular disease.", xref="PMID:35980763"}
property_value: IAO:0000112 "PMID:33185476" xsd:string {dcterms:title="Clinical Application of a Novel Genetic Risk Score for Ischemic Stroke in Patients With Cardiometabolic Disease.", xref="PMID:33185476", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33185476+AND+SRC%3AMED&format=json&resultType=core", comment="Subjects who had consented for genetic testing and who were of European ancestry from the ENGAGE AF-TIMI 48 (Effective Anticoagulation with Factor Xa Next Generation in Atrial Fibrillation), SOLID-TIMI 52 (Stabilization of Plaques Using Darapladib), SAVOR-TIMI 53 (Saxagliptin Assessment of Vascular Outcomes Recorded in Patients with Diabetes Mellitus), PEGASUS-TIMI 54 (Prevention of Cardiovascular Events in Patients With Prior Heart Attack Using Ticagrelor Compared to Placebo on a Background of Aspirin), and FOURIER (Further Cardiovascular Outcomes Research With PCSK9 Inhibition in Patients With Elevated Risk) trials were included in this analysis."}

[Instance]
id: coho:COHO_0002345
name: South African Zulu
def: "A combined sample of South African Zulu type 2 diabetes cases and controls from Durban, South Africa, formed for genetic studies by aggregating the Durban Diabetes Study, a population-based cross-sectional study of urban Black African adults of Zulu descent, with the Durban Diabetes Case Control study, which added cases of the same ethnic group and locality who had type 2 diabetes and attended a diabetes clinic." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31049640"}
