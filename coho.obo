[Instance]
id: coho:COHO_0000419
name: Gut-and-Liver Axis in Alcoholic Liver Fibrosis
def: "A cohort of the EU Horizon 2020 GALAXY (Gut-and-liver axis in alcoholic liver fibrosis) consortium, recruited between 2013 and 2018 by Odense University Hospital in the Region of Southern Denmark, of about 460 consecutively recruited patients with a history of harmful drinking (more than 36 g of alcohol a day for men and 24 g for women for at least a year) and early, asymptomatic alcohol-related liver disease (GALA-ALD), most with a liver biopsy, and some 140 to 150 healthy participants matched to them by age and sex (GALA-HP), to study the gut–liver axis and non-invasive markers of alcohol-related liver fibrosis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://cordis.europa.eu/project/id/668031", IAO:0000119="PMID:35654907", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13233754/fullTextXML"}
subset: coho1:GWAS_subset
synonym: "GALAXY" RELATED OMO:0003000 []
synonym: "GALAXY cohort" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Denmark {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11906355/fullTextXML", comment="For replication of the genetic effects on plasma protein levels, we included 1,000 additional children and adolescents from the HOLBAEK Study and 558 adults with alcohol-related liver disease aged 19–82 years, matched with healthy controls recruited from the Region of Southern Denmark5."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
property_value: coho:numberOfCases "462" xsd:integer {IAO:0000116="patients with alcohol-related liver disease (GALA-ALD) and matched healthy controls (GALA-HC); no total stated (2018)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13233754/fullTextXML", comment="We investigated BA homeostasis in a cross-sectional ALD cohort (n = 462), alongside matched healthy controls (n = 148), and validated key findings in two independent ALD cohorts (n = 34 and n = 52)."}
property_value: coho:numberOfControls "148" xsd:integer {IAO:0000116="patients with alcohol-related liver disease (GALA-ALD) and matched healthy controls (GALA-HC); no total stated (2018)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13233754/fullTextXML", comment="We investigated BA homeostasis in a cross-sectional ALD cohort (n = 462), alongside matched healthy controls (n = 148), and validated key findings in two independent ALD cohorts (n = 34 and n = 52)."}
property_value: IAO:0000112 "GCST90453794" xsd:string {dcterms:title="Plasma proteome variation and its genetic determinants in children and adolescents.", xref="PMID:39972214", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11906355/fullTextXML", comment="GALA–ALD/HP, gut and liver axis–alcohol-related liver disease/healthy participants."}

