[Instance]
id: coho:COHO_0002565
name: Wuhan-Beijing GWA study
def: "A case-control genome-wide association study sample of Chinese adults that combines participants of the Dongfeng-Tongji cohort study, a cohort of retired employees of a state-owned automobile enterprise in China, with patients with oesophageal squamous-cell carcinoma recruited at the Cancer Hospital of the Chinese Academy of Medical Sciences in Beijing; it was one of the Stage 1 studies of the 2015 meta-analysis of genome-wide association studies of adult height in East Asians." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09", IAO:0000119="https://pmc.ncbi.nlm.nih.gov/articles/instance/4351379/bin/supp_ddu583_ddu583supp.doc", IAO:0000119="PMID:25429064"}
