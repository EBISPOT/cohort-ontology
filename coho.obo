is_a: MONDO:0003847 ! hereditary disease

[Term]
id: MONDO:0012727
name: Kawasaki disease
def: "A rare inflammatory disease characterized by an acute febrile, systemic, self-limiting, medium-vessel vasculitis primarily affecting children. It often causes acute coronary arteritis which is associated with coronary arterial aneurysms (CAA) that may be life threatening when untreated." []
is_a: MONDO:0002052 ! lymphadenitis
is_a: MONDO:0018882 ! vasculitis

[Term]
id: MONDO:0013153
name: inflammatory bowel disease 28
