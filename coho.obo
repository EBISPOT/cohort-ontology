property_value: IAO:0000112 "GCST90454282" xsd:string {dcterms:title="Exploring multi-omics and clinical characteristics linked to accelerated biological aging in Asian women of reproductive age: insights from the S-PRESTO study.", xref="PMID:39516835", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11549770/fullTextXML", comment="The Singapore Preconception Study of Long-Term Maternal and Child Outcomes (S-PRESTO) longitudinal preconception cohort, a deeply-phenotyped, multi-ethnic cohort of Asian women of reproductive age, provides a promising opportunity to address these research gaps."}

[Instance]
id: coho:COHO_0001414
name: Swiss Pediatric Sepsis Study
def: "A nationwide, prospective, multicentre cohort of neonates and children younger than 17 with blood culture-proven bacterial sepsis meeting criteria for systemic inflammatory response syndrome, enrolled from September 2011 to December 2015 at ten tertiary and regional paediatric hospitals in Switzerland, including all five university centres and all paediatric intensive care units, to study the incidence, clinical features and outcomes of paediatric sepsis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:42241732", IAO:0000119="PMID:30169202"}
subset: coho1:GWAS_subset
