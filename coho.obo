property_value: IAO:0000112 "PMID:35995766" xsd:string {dcterms:title="Whole Genome Association Study of the Plasma Metabolome Identifies Metabolites Linked to Cardiometabolic Disease in Black Individuals.", xref="PMID:35995766", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9395431/fullTextXML", comment="To extend prior work, we performed a genome-wide association study integrating whole genome sequencing (WGS) of 2,291 metabolite peaks in 2466 participants from the Jackson Heart Study (JHS), a Black epidemiological cohort in Jackson, Mississippi, and validated findings in the Multi-Ethnic Study of Atherosclerosis (MESA; n = 995) and Health, Risk Factors, Exercise Training and Genetics Family Study (HERITAGE; n = 658)."}

[Instance]
id: coho:COHO_0001857
name: Heart Failure: A Controlled Trial Investigating Outcomes of Exercise Training
def: "A randomized controlled trial, funded by the US National Institutes of Health, that enrolled adult patients with heart failure with reduced ejection fraction (left ventricular ejection fraction ≤35%) and NYHA class II-IV symptoms despite optimal therapy, at 82 centers in the United States, Canada and France from April 2003 to February 2007, comparing usual heart-failure care with usual care plus supervised and then home-based aerobic exercise training, and including a genetic sub-study." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19351941", dcterms:contributor="Claude Sonnet 5 (Anthropic), 2026-09", IAO:0000119="PMID:33012170"}
