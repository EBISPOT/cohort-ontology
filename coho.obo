property_value: coho:numberOfParticipants "7000" xsd:integer {IAO:0000116="participants recruited to date (more than 7000)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7042768/fullTextXML", comment="To date, we have recruited more than 7000 participants, becoming the largest and most integrative Chinese neuroimaging genetics cohort."}
property_value: IAO:0000112 "GCST90428575" xsd:string {dcterms:title="Genome-wide association study of hippocampal blood-oxygen-level-dependent-cerebral blood flow correlation in Chinese Han population.", xref="PMID:37822511", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10562876/fullTextXML", comment="In this study, we conducted the first GWAS on the hippocampal BOLD-CBF correlation in 4,832 Chinese Han participants from the Chinese Imaging Genetics (CHIMGEN) cohort.22 Here, the across-voxel correlation between reginal homogeneity (ReHo) derived from the resting-state fMRI data and CBF measured by the arterial spin labeling (ASL) MRI data within hippocampal voxels was used as a proxy to represent hippocampal NVC."}

[Instance]
id: coho:COHO_0000373
name: African American Study of Kidney Disease and Hypertension
def: "A cohort of African American adults aged 18–70 with hypertensive chronic kidney disease, enrolled at clinical centres across the United States in a randomized trial of antihypertensive drug regimens and blood-pressure goals (1995–2001) and then followed in the AASK Cohort Study to identify risk factors for progressive kidney disease." [] {IAO:0000119="PMID:17591527", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:12819322", IAO:0000119="PMID:18472682"}
subset: coho1:GWAS_subset
