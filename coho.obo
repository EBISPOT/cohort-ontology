property_value: IAO:0000112 "GCST90027030" xsd:string {dcterms:title="Association between genes regulating neural pathways for quantitative traits of speech and language disorders.", xref="PMID:34315907", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8316336/fullTextXML", comment="We conducted a GWAS in the Cleveland Family Speech and Reading Study (CFSRS), a cohort ascertained through a proband with SSD, and replicated findings in a population-based cohort."}
property_value: IAO:0000116 "The acronym CFS also denotes Cleveland Family Study (COHO:0000427); this term is Cleveland Family Speech and Reading Study." xsd:string

[Instance]
id: coho:COHO_0000466
name: Genetics of Opioid Addiction Consortium
def: "A consortium of investigators who attend the National Institute on Drug Abuse Genetics and Epigenetics Cross-cutting Research Team meetings and have genome-wide association data on opioid addiction, pooling previously unpublished genome-wide association studies of opioid addiction from twelve cohort samples, ten with European-ancestry and seven with African-ancestry participants, among them Yale-Penn, the Collaborative Study on the Genetics of Alcoholism and the Urban Health Study in the United States, the Vancouver Injection Drug Users Study in Canada, deCODE in Iceland, the Genetic Epidemiology of Opioid Dependence in Bulgaria study, the Comorbidity and Trauma Study in Australia and the AIDS Linked to the IntraVenous Experience cohort, to study the genetics of opioid addiction." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:36207451", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/supplementaryFiles"}
subset: coho1:GWAS_subset
synonym: "GENOA" RELATED OMO:0003000 []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:hasCohort coho:COHO_0000428 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/fullTextXML", comment="V.R., T.T., G.E., D.F.G., K.S., and T.T. contributed the deCODE cohort to the GENOA analysis."}
relationship: coho:hasCohort coho:COHO_0000628 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/fullTextXML", comment="JG, HRK, and HZ contributed the Yale-Penn cohort to the GENOA analysis."}
relationship: coho:hasCohort coho:COHO_0000772 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9546890/fullTextXML", comment="LW, DL, KB, TF, AA, BP, and HE contributed the COGA cohort to the GENOA analysis."}
property_value: IAO:0000112 "GCST90244554" xsd:string {dcterms:title="Multi-trait genome-wide association study of opioid addiction: OPRM1 and beyond.", xref="PMID:36207451", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36207451+AND+SRC%3AMED&format=json&resultType=core", comment="We applied genomic structural equation modeling to conduct a GWAS of the new Genetics of Opioid Addiction Consortium (GENOA) data together with published studies (Psychiatric Genomics Consortium, Million Veteran Program, and Partners Health), comprising 23,367 cases and effective sample size of 88,114 individuals of European ancestry."}
property_value: IAO:0000116 "The acronym GENOA also denotes Genetic Epidemiology Network of Arteriopathy (COHO:0000434) and Genetics of Opioid Addiction Study (COHO:0000467); this term is Genetics of Opioid Addiction Consortium." xsd:string

[Instance]
id: coho:COHO_0000467
name: Genetics of Opioid Addiction Study
def: "A prospective cohort of adults with opioid use disorder receiving treatment, mainly methadone maintenance treatment, at Canadian Addiction Treatment Centre (formerly Ontario Addiction Treatment Centres) clinics in Ontario, Canada, recruited by McMaster University with the clinics in a pilot at four clinics in 2011–2012 and a main phase in 2013–2016 (about 1,500 participants, interviewed at entry, giving blood for DNA and followed through the urine drug screens in their medical records), to identify factors, including genetic risk factors, associated with opioid use and treatment outcomes." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38102185", IAO:0000119="PMID:37494403", IAO:0000119="PMID:25187714", IAO:0000119="PMID:27103815"}
