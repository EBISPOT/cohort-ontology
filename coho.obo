relationship: coho:has_data_collection_location http://dbpedia.org/resource/Hong_Kong {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9856878/fullTextXML", comment="Participants for this cross-sectional study were recruited from the Hong Kong Children Eye Study, an ongoing population-based cohort study on eye conditions in children aged 6 to 8 years recruited from primary schools in Hong Kong."}
property_value: coho:numberOfParticipants "17124" xsd:integer {IAO:0000116="children and parents examined in 5708 complete child-parent trios (trio subset)", xref="PMID:36542383", comment="A total of 17 124 participants from 5708 trios (2964 boys and 2754 girls) at a mean (SD) age of 7.32 (0.87) years, and 11 416 parents were examined."}
property_value: IAO:0000112 "GCST90566418" xsd:string {dcterms:title="Genome-wide association study identified novel loci and gene-environment interaction for refractive error in children.", xref="PMID:40410244", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40410244+AND+SRC%3AMED&format=json&resultType=core", comment="To identify novel genetic loci for children refractive error, we performed a meta-analysis of two genome-wide association studies (GWASs) of spherical equivalent (SE) in 1,237 children from the population-based Hong Kong Children Eye Study (HKCES) and the Low Concentration Atropine for Myopia Progression (LAMP) study."}

[Instance]
id: coho:COHO_0001353
name: Hong Kong Diabetes Biobank
def: "A multicentre prospective cohort and biobank of adults with diabetes, started in 2014 and coordinated by the Chinese University of Hong Kong, which enrols people attending routine diabetes complication assessment at the diabetes centres of major public hospitals across Hong Kong, with the assessment methods of the Hong Kong Diabetes Register, and follows them for diabetes-related outcomes, to serve as a territory-wide diabetes register and biobank for epidemiological research and for the discovery and replication of genetic, epigenetic and other biomarkers of diabetes and its complications." [] {IAO:0000119="PMID:39508878", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT05282680", IAO:0000119="PMID:32722720"}
