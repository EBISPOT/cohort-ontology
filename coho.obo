property_value: IAO:0000112 "PMID:19377074" xsd:string {dcterms:title="Low thrombin activatable fibrinolysis inhibitor activity levels are associated with an increased risk of a first myocardial infarction in men.", xref="PMID:19377074", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2688572/", comment="We included 554 men under 70 years old with a first myocardial infarction and 643 controls participating in the Study of Myocardial Infarctions Leiden (SMILE), a case-control study."}

[Instance]
id: coho:COHO_0002394
name: Scotland and Newcastle Lymphoma Group
def: "A population-based series of patients with Hodgkin lymphoma in Scotland and northern England, collected through the Scotland and Newcastle Lymphoma Group, a clinical collaborative group that registered lymphoma patients in these regions prospectively on a shared database from 1979; the genetic series comprises the Scotland and Newcastle Epidemiological Study of Hodgkin's Disease, a case–control study conducted in 1993–1997, and a local case series collected prospectively in 1992–2008, and its cases were genotyped in European genome-wide association studies of classical Hodgkin lymphoma." [] {IAO:0000119="PMID:22286212", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:15359994", IAO:0000119="PMID:2069849"}
