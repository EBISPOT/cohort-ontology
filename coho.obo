is_a: MONDO:0016542 ! IL10-related early-onset inflammatory bowel disease

[Term]
id: MONDO:0013209
name: metabolic dysfunction-associated steatotic liver disease
def: "Metabolic dysfunction-associated steatotic liver disease (MASLD, formerly known as nonalcoholic fatty liver disease or NAFLD) is a type of liver disease that is not caused by alcohol. It typically does not cause symptoms in the early stages, but it can cause health problems due to fat accumulation, inflammation, and scarring in the liver." []
synonym: "fatty liver disease, nonalcoholic, susceptibility to, 1" RELATED []
synonym: "NAFLD1" RELATED ABBREVIATION []
is_a: MONDO:0004790 ! fatty liver disease

[Term]
id: MONDO:0013282
name: alpha 1-antitrypsin deficiency
def: "Alpha-1-antitrypsin deficiency is a hereditary disease that develops in adulthood and is characterized by chronic liver disorders (cirrhosis), respiratory disorders (emphysema), and rarely panniculitis." []
synonym: "A1AT deficiency" RELATED []
synonym: "A1ATD" RELATED ABBREVIATION []
