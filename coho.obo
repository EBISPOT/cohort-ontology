property_value: IAO:0000112 "PMID:29574091" xsd:string {dcterms:title="Genetic Risk Score Is Associated With Prevalence of Advanced Neoplasms in a Colorectal Cancer Screening Population.", xref="PMID:29574091", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6035076/unicode", comment="Data for the analyses were drawn from the BLITZ study (Begleitende Evaluierung innovativer Testverfahren zur Darmkrebsfrüherkennung) which has been described in detail before."}

[Instance]
id: coho:COHO_0001538
name: Bloodomics
def: "A European Union Sixth Framework Programme integrated project (June 2004 to November 2008), coordinated by the University of Cambridge with clinical coronary artery disease centres, genomics groups and the Wellcome Trust Sanger Institute, that sought genes and pathways of atherothrombosis in coronary artery disease through platelet transcriptome and proteome analysis and exon resequencing. For genetic association studies it assembled a Dutch case-control collection, with cases from the Academic Medical Center Amsterdam Premature Atherosclerosis Study (AMC-PAS) and the AGNES study of first ST-elevation myocardial infarction and controls from Sanquin blood donors, and a German one, with cases and controls from the Ludwigshafen Risk and Cardiovascular Health (LURIC) study and additional blood-donor controls from Mannheim." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://cordis.europa.eu/project/id/503485", IAO:0000119="PMID:21966275"}
synonym: "BLOODOMICS" RELATED OMO:0003000 []
synonym: "Bloodomics project" RELATED []
synonym: "Identification of risk genes for atherothrombosis in coronary artery disease by transcriptome and proteome analysis and high throughput exon resequencing" RELATED []
synonym: "Integrated Project Bloodomics" RELATED []
