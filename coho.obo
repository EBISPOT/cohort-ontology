property_value: IAO:0000112 "GCST90091013" xsd:string {dcterms:title="Whole-genome association analyses of sleep-disordered breathing phenotypes in the NHLBI TOPMed program.", xref="PMID:34446064", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML", comment="The Starr County Health Studies (Starr) investigates the risk factors for diabetes in Mexican-Americans [31, 32]."}

