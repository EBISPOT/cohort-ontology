[Instance]
id: coho:COHO_0002104
name: Newcastle 85+ Study
def: "A prospective inception cohort study of health and ageing in the very old in North East England, funded by the UK Medical Research Council and the Biotechnology and Biological Sciences Research Council, which invited everyone born in 1921 (turning 85 in 2006) who was registered with a participating general practice in Newcastle upon Tyne or North Tyneside, whether living at home or in an institution and regardless of health, recruited them in 2006–2007, assessed them at home with a multidimensional health assessment, review of general practice records and fasting blood samples, with repeat assessments at 18 and 36 months and follow-up until death, to study health trajectories, their biological, medical and social determinants, and the biology of ageing." [] {IAO:0000119="PMID:17594470", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:20028777"}
synonym: "N85PLUS" RELATED OMO:0003000 []
synonym: "Newcastle 85+ cohort study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2797051/fullTextXML", comment="The sampling frame comprised all people born in 1921 who were permanently registered with a participating general practice in Newcastle upon Tyne or North Tyneside primary care trusts in the UK."}
property_value: coho:numberOfParticipants "1042" xsd:integer {IAO:0000116="people born in 1921 who took part at baseline (851 health assessment plus record review, 188 record review only, 3 health assessment only), 2006-2007", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2797051/fullTextXML", comment="Of the 1453 people eligible to participate—that is, registered with a participating general practice and still alive—1042 (71.7%) participated."}
property_value: IAO:0000112 "PMID:42341622" xsd:string {dcterms:title="Exploring the relationship between cognitive impairment, frailty and mortality in the oldest old: findings from the Newcastle 85+ cohort study.", xref="PMID:42341622", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42341622+AND+SRC%3AMED&format=json&resultType=core", comment="We utilised data from the Newcastle 85+ Study, a prospective longitudinal cohort of individuals aged 85 at baseline (n = 695)."}

