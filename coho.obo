property_value: IAO:0000112 "GCST90672045" xsd:string {dcterms:title="Genome-wide association study reveals two novel genetic loci associated with chronic lung allograft dysfunction.", xref="PMID:41864285", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41864285+AND+SRC%3AMED&format=json&resultType=core", comment="We genotyped 392 donor-recipient pairs from the multicentric Cohort in Lung Transplantation."}

[Instance]
id: coho:COHO_0001308
name: Cooperative Study of Sickle Cell Disease
def: "A multicentre prospective study of the natural history of sickle cell disease, initiated in 1977, that enrolled patients with sickle cell disease of all ages, from newborns to adults and from mild to hospital-based cases, at 23 centres across the United States from 1978 (patients older than six months until 1981, infants until 1988), and followed them with standardised examinations and records of acute and chronic complications and organ damage, later phases following the infant cohort and adult participants until 1998, to identify the factors contributing to the morbidity and mortality of the disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:7114401", IAO:0000119="https://biolincc.nhlbi.nih.gov/studies/csscd/", IAO:0000119="PMID:36138487"}
subset: coho1:GWAS_subset
synonym: "CSSCD" RELATED OMO:0003000 []
