property_value: IAO:0000112 "GCST90104085" xsd:string {dcterms:title="Common X-Chromosome Variants Are Associated with Parkinson Disease Risk.", xref="PMID:33583074", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8601399/unicode", comment="The PD cohorts include the International PD Genomics Consortium (IPDGC) NeuroX dataset, the National Institute of Neurological Disorders and Stroke (NINDS) PD dataset, the Autopsy-Confirmed PD GWAS Consortium (APDGC) dataset genotyped by the Center for Inherited Disease Research, the NeuroGenetics Research Consortium (NGRC) dataset, the UK PD Consortium, and the Wellcome Trust Case Control Consortium 2, referred to here as EBI MERGE."}

[Instance]
id: coho:COHO_0001134
name: CALGB 80303
def: "A double-blind, placebo-controlled, randomised phase III trial of the Cancer and Leukemia Group B that enrolled patients with previously untreated locally advanced or metastatic pancreatic cancer at its participating institutions in the United States between June 2004 and April 2006, comparing gemcitabine plus bevacizumab with gemcitabine plus placebo, with overall survival as the primary end point." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:20606091", IAO:0000119="https://clinicaltrials.gov/api/v2/studies/NCT00088894"}
