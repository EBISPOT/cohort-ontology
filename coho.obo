property_value: IAO:0000112 "GCST90502757" xsd:string {dcterms:title="Trans-ancestry genome-wide association study of childhood body mass index identifies novel loci and age-specific effects.", xref="PMID:39885687", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39885687+AND+SRC%3AMED&format=json&resultType=core", comment="To identify genetic loci associated with early-childhood body mass index (BMI), we performed GWAS of BMI Z scores in eight ancestrally diverse cohorts: ZOE 2.0 cohort, the Santiago Longitudinal Study (SLS), the Vanderbilt University BioVU biobank, the Geisinger MyCode Health Initiative biobank, Study of Latino (SOL) Youth, Pelotas (Brazil) Birth Cohort, Cameron County Hispanic Cohort (CCHC), and Viva La Familia cohort."}

[Instance]
id: coho:COHO_0001253
name: Protection Against Allergy: Study in Rural Environments
def: "A prospective birth cohort, begun in 2002 within an EU-funded project, of children from rural areas of Austria, Finland, France, Germany and Switzerland whose mothers were invited during the third trimester of pregnancy in 2002-2005, children of mothers living on family-run livestock farms forming the farm group and children of mothers from the same rural areas not living on a farm the reference group, followed from birth into school age with questionnaires, biological samples and clinical measurements to evaluate risk and protective factors, particularly farm exposures, for asthma and allergic diseases." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:33986744", IAO:0000119="PMID:36356926", IAO:0000119="https://ars.els-cdn.com/content/image/1-s2.0-S009167492600093X-mmc3.pdf", IAO:0000119="PMID:16512801"}
