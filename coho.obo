[Instance]
id: coho:COHO_0001992
name: Kentucky Lung Cancer Research Initiative
def: "A population-based case-control study of lung cancer in southeastern, Appalachian Kentucky, United States, run by the Markey Cancer Center and the University of Kentucky with Department of Defense funding, which from January 2012 to September 2014 recruited newly diagnosed cases through the Kentucky Cancer Registry and controls from the same region by random-digit dialling, and collected blood, toenail, urine, water, soil and radon samples, residential GPS mapping and an epidemiologic, occupational and health-history questionnaire, to study the region's very high lung cancer rates." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf"}
subset: coho1:PGS_subset
synonym: "KLCRI" RELATED OMO:0003000 []
synonym: "LCRI DoD Lung Cancer Study" RELATED []
synonym: "LCRI-DOD" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf", comment="The Kentucky Lung Cancer Research Initiative is a study conducted by the Markey Cancer Center Cancer Center and the University of Kentucky using a population-based, case- control framework to study the extraordinarily high rates of lung cancer in Southeastern, Appalachian Kentucky."}
property_value: coho:numberOfParticipants "520" xsd:integer {IAO:0000116="subjects recruited in Appalachian Kentucky, January 2012 to September 2014", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf", comment="Study accrual began in January 5, 2012 and completed on September 5, 2014 and 520 subjects were recruited in a 4:1 ratio of controls: cases from Appalachian Kentucky."}
property_value: IAO:0000112 "PGS000740" xsd:string {dcterms:title="Assessing Lung Cancer Absolute Risk Trajectory Based on a Polygenic Risk Model.", xref="PMID:33472890"}
property_value: IAO:0000112 "PMID:28604730" xsd:string {dcterms:title="Large-scale association analysis identifies new lung cancer susceptibility loci and heterogeneity in genetic susceptibility across histological subtypes.", xref="PMID:28604730", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf", comment="The Kentucky Lung Cancer Research Initiative is a study conducted by the Markey Cancer Center Cancer Center and the University of Kentucky using a population-based, case- control framework to study the extraordinarily high rates of lung cancer in Southeastern, Appalachian Kentucky."}

[Instance]
id: coho:COHO_0001993
name: obsolete Lung Cancer Study from Canada
comment: Obsoleted 2026-09-27. LCSC is the lung cancer study from Canada of the Lunenfeld-Tanenbaum Research Institute and the University of Toronto (PMID:26363033), the Toronto lung cancer GWAS COHO holds as COHO:0000936. Replaced by COHO:0000936 (Samuel Lunenfeld Research Institute Study), which now carries this term's names. Found by a check of the placeholders against the papers the PGS Catalog links to them or found by their names, 2026-09-25.
is_obsolete: true
replaced_by: coho:COHO_0000936

[Instance]
id: coho:COHO_0001994
name: Lung Cancer Study from Estonia
def: "A hospital-based case–control study of lung cancer in Estonia, whose cases were lung cancer patients enrolled in Estonian hospitals between 2002 and 2006 and whose controls were randomly selected from the population-based cohort of the Estonian Genome Project; genotyped genome-wide with support from the University of Tartu, it was one of the five case–control studies of the IARC lung cancer genome-wide association study and was pooled in the lung cancer meta-analyses of the TRICL consortium." [] {IAO:0000119="PMID:24880342", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19836008", IAO:0000119="PMID:22899653"}
