relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC6432650/", comment="19416921 [PGC1] | Michigan, USA (Pritzker and NIMH) | bip_mich_eur"}
relationship: coho:isCohortOf coho:COHO_0000146
property_value: coho:numberOfCases "1177" xsd:integer {IAO:0000116="bipolar I cases and NIMH repository controls genotyped for the sample's own GWAS (2009)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2678639/", comment="For the NIMH/Pritzker GWAS, 1,177 BP I cases (473 sibling pairs and 231 unrelated individuals) from the NIMH and Prechter Repositories and 772 controls from the NIMH Repository (Table 1) were genotyped on the Illumina HumanHap 550K chip; 512,844 autosomal SNPs passed QC (see Methods) and had minor allele frequency (MAF)≥1%."}
property_value: coho:numberOfControls "772" xsd:integer {IAO:0000116="bipolar I cases and NIMH repository controls genotyped for the sample's own GWAS (2009)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2678639/", comment="For the NIMH/Pritzker GWAS, 1,177 BP I cases (473 sibling pairs and 231 unrelated individuals) from the NIMH and Prechter Repositories and 772 controls from the NIMH Repository (Table 1) were genotyped on the Illumina HumanHap 550K chip; 512,844 autosomal SNPs passed QC (see Methods) and had minor allele frequency (MAF)≥1%."}
property_value: IAO:0000112 "PMID:19416921" xsd:string {dcterms:title="Genome-wide association and meta-analysis of bipolar disorder in individuals of European ancestry.", xref="PMID:19416921", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2678639/", comment="We analyzed the NIMH/Pritzker and GSK GWAS samples separately and performed a 2-study meta-analysis."}

[Instance]
id: coho:COHO_0002157
name: obsolete Disorders and Stroke and the Alzheimers Disease and Related Disorders Association
comment: Obsoleted 2026-09-27. NINCDS-ADRDA is a set of diagnostic criteria for Alzheimer's disease, which studies cite for how their cases were diagnosed, not a sample. Found by a search for the cohorts behind placeholder names with no known paper, 2026-09-27.
is_obsolete: true

[Instance]
id: coho:COHO_0002158
name: Upper Midwest Health Study
def: "A population-based case-control study of primary intracranial glioma, initiated in 1995 by the US National Institute for Occupational Safety and Health among adults aged 18 to 80 living in non-metropolitan counties of Iowa, Michigan, Minnesota and Wisconsin, to evaluate associations of glioma with farm and rural exposures, pesticides above all. Its cases had histologically confirmed glioma diagnosed from January 1995 to January 1997, and its controls, frequency-matched within state, were drawn from driver's licence and identification records (ages 18–64) and Medicare data (ages 65–80); its participants' DNA was later genotyped in National Cancer Institute genome-wide studies of glioma and of clonal mosaicism." [] {IAO:0000119="PMID:22886559", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:17131948", IAO:0000119="PMID:22691464", IAO:0000119="PMID:15866761", IAO:0000119="PMID:22561519", IAO:0000119="PMID:22715102"}
