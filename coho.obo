property_value: IAO:0000112 "PMID:28053049" xsd:string {dcterms:title="Genome-wide association study with additional genetic and post-transcriptional analyses reveals novel regulators of plasma factor XI levels.", xref="PMID:28053049", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC5703348/", comment="The study consists of a discovery sample of 16,169 individuals of European ancestry from five studies (ARIC, PROCARDIS, GHS-1, GHS-2, and MARTHA) and a replication sample of 2,045 individuals from three studies (F5Leiden Cohort, MEGA, and GAIT2); for details, see Supplementary Material, Table S1."}

[Instance]
id: coho:COHO_0001718
name: Familial Breast Cancer Study
def: "A study coordinated from the Institute of Cancer Research, Sutton, that from 1995 recruited people with breast cancer and a family history of the disease, as the index cases of their families, through cancer genetics clinics throughout the United Kingdom, whose clinicians and counsellors formed the Breast Cancer Susceptibility Collaboration (UK), for research into inherited susceptibility to breast cancer." [] {IAO:0000119="PMID:20512659", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:20453838", IAO:0000119="PMID:25855707"}
