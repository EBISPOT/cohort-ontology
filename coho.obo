relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:isCohortOf coho:COHO_0002701
property_value: coho:numberOfParticipants "2500" xsd:integer {IAO:0000116="initial participants with medical history and saliva samples, as analysed in the 2023 paper", xref="PMID:37117635", comment="The NLGP cohort consists of the initial 2,500 participants for whom medical history and saliva samples were obtained with informed consent under a study protocol approved by the Newfoundland and Labrador Health Research Ethics Board (Ethics Reference #: 2018.243)."}
property_value: IAO:0000112 "PMID:37117635" xsd:string {dcterms:title="The Newfoundland and Labrador mosaic founder population descends from an Irish and British diaspora from 300 years ago.", xref="PMID:37117635", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10147672/fullTextXML", comment="we aimed to explore the non-Indigenous (European) settlement of the present NL population in unprecedented detail, studying a sample of 1807 individuals with NL ancestry from the Newfoundland and Labrador Genome Project (NLGP), together with ancestry source references from Britain and Ireland."}
property_value: seeAlso https://www.sequencebio.com/

[Instance]
id: coho:COHO_0002688
name: UKCTOCS Longitudinal Women's Cohort
def: "A cohort of postmenopausal women aged 50–74 from the general population of England, Wales and Northern Ireland, recruited in 2001–2005 to the United Kingdom Collaborative Trial of Ovarian Cancer Screening (UKCTOCS), a randomised trial of ovarian cancer screening, whose donated serum samples (at recruitment and, in the multimodal screening arm, annually until 2011) and linked national health records are kept by the MRC Clinical Trials Unit at University College London as an open bioresource for studies of common diseases and disease markers." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://uklwc.mrcctu.ucl.ac.uk/overview", IAO:0000119="https://www.innovative-ctu.ucl.ac.uk/studies/all-studies/u/uklwc/"}
