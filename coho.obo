relationship: coho:has_data_collection_location http://dbpedia.org/resource/Norway {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6499508/fullTextXML", comment="We conducted an 8-wk, double-blind, randomized controlled dietary intervention study at the Oslo and Akershus University College of Applied Sciences and the University of Oslo, Norway, from July 2012 until April 2014."}
property_value: coho:numberOfParticipants "115" xsd:integer {IAO:0000116="subjects randomly assigned (2012-2014)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6499508/fullTextXML", comment="In short, 701 subjects were assessed for eligibility, 115 were randomly assigned, 100 completed the study, and 99 were analyzed independent of the compliance (Supplemental Figure 1)."}
property_value: IAO:0000112 "PMID:40510537" xsd:string {dcterms:title="Exposure to fine particulate matter in adults is associated with immune cell gene expression related to inflammation, the electron transport chain, and cell cycle regulation.", xref="PMID:40510537", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12159804/fullTextXML", comment="This study is a part of the LongITools project and includes cross-sectional data from the Rotterdam Study, a population-based cohort study, and NoMa, a randomized controlled trial."}
