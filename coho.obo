property_value: IAO:0000112 "PMID:25349970" xsd:string {dcterms:title="Evidence for a time-dependent association between FOLR1 expression and survival from ovarian carcinoma: implications for clinical testing. An Ovarian Tumour Tissue Analysis consortium study.", xref="PMID:25349970", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4264456/fullTextXML", comment="For the Alberta Ovarian Tumor Types study (AOV), Calgary Serous Carcinoma study (CAL), Nottingham Ovarian Cancer study (NOT), Toronto Ovarian Cancer study (TOC) and British Columbia Cancer Agency study (VAN), the institutional research ethics boards waived the need to obtain consent and all local human research investigations committees approved each study."}

[Instance]
id: coho:COHO_0001491
name: Australian Prostate Cancer BioResource
def: "A national prostate cancer tissue bank in Australia, organised as a network of nodes in several states (among them Queensland, New South Wales and South Australia), that since the mid-2000s has collected radical prostatectomy tissue, blood, and clinical, pathology and follow-up data from men with prostate cancer, recruited through their urologists at diagnosis or before surgery at participating hospitals under common standard operating procedures, and supplies them for research, including genetic association studies of prostate cancer." [] {IAO:0000119="PMID:37370825", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:23846169", IAO:0000119="PMID:29703916", IAO:0000119="PMID:29892016", IAO:0000119="PMID:22970239"}
synonym: "APCB" RELATED OMO:0003000 []
