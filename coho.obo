[Instance]
id: coho:COHO_0000606
name: Starr County Health Studies
def: "A long-running programme of studies of type 2 diabetes and related chronic disease among Mexican Americans in Starr County, Texas, on the Texas-Mexico border, run from the University of Texas Health Science Center at Houston, which include a random sample of 14% of the county's population reported in 1983, type 2 diabetes case-control collections in 1987-2006, and a household survey of randomly selected blocks with examinations in 2002-2006 and re-examinations in 2010-2014, to study the prevalence, risk factors, genetics and complications of diabetes." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4897940/fullTextXML", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML", IAO:0000119="PMID:6637993", IAO:0000119="PMID:21647700", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8990175/supplementaryFiles"}
subset: coho1:GWAS_subset
