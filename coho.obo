[Instance]
id: coho:COHO_0001199
name: LAPC GWAS
def: "A nested case-control genome-wide association study of prostate cancer in Latino men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Latino component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Latinos." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31226226", IAO:0000119="PMID:33398198", IAO:0000119="PMID:22923026", IAO:0000119="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1"}
