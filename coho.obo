relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf", comment="At baseline, 3187 European-ancestry and African American adults aged 45 years or older (35% men; 32% African American; mean age 61±10 years) were recruited from six townships in Johnston County, North Carolina, and completed a clinical examination visit during 1991– 1997."}
property_value: coho:numberOfParticipants "3187" xsd:integer {IAO:0000116="original cohort enrolled 1991-1998 only; the 2003-2004 enrichment cohort (n = 1015) is additional", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9387345/fullTextXML", comment="Civilian, non-institutionalized residents aged 45+ years from six townships in Johnston County were enrolled between 1991 and 1998 (n = 3187, Original Cohort), and additional residents were enrolled from 2003 to 2004 (n = 1015, Enrichment Cohort)."}
property_value: IAO:0000112 "GCST90566795" xsd:string {dcterms:title="Translational genomics of osteoarthritis in 1,962,069 individuals.", xref="PMID:40205036", xref="https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf", comment="JoCo OA began in 1990 as a community-based prospective cohort of European-ancestry and African American men and women with and without osteoarthritis (OA)."}

