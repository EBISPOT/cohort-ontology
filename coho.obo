[Instance]
id: coho:COHO_0000999
name: Continental Origins and Genetic Epidemiology Network
def: "A network of cohorts of African ancestry and of other populations under-represented in genome-wide association studies, whose consortia meta-analyse the cohorts' genome-wide data to find genetic variants for complex traits, such as white blood cell count, blood pressure and hypertension in African-ancestry cohorts (COGENT-BP) and kidney traits across diverse ancestries (COGENT-Kidney, established in 2014)." [] {IAO:0000119="PMID:32571486", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:21738479"}
synonym: "COGENT" RELATED OMO:0003000 []
synonym: "COGENT Network" RELATED []
instance_of: coho:COHO_0000001 ! cohort aggregation
property_value: coho:numberOfParticipants "16388" xsd:integer {IAO:0000116="African-American participants from 7 cohorts in the 2011 WBC count GWAS", xref="PMID:21738479", comment="In order to address this, we performed a large genome-wide association study (GWAS) of total WBC and cell subtype counts in 16,388 African-American participants from 7 population-based cohorts available in the Continental Origins and Genetic Epidemiology Network."}
property_value: IAO:0000112 "PMID:21738479" xsd:string {dcterms:title="Genome-wide association study of white blood cell count in 16,388 African Americans: the continental origins and genetic epidemiology network (COGENT).", xref="PMID:21738479", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3128101/fullTextXML", comment="The subjects participating in the GWAS consisted of a total of 16,388 self-identified African-American individuals from 7 population-based cohorts (ARIC, CARDIA, JHS, WHI, HANDLS, Health ABC, and GeneSTAR) that belong to the Continental Origins and Genetic Epidemiology Network (COGENT)."}

[Instance]
id: coho:COHO_0001000
name: Center for Oral Health Research in Appalachia
def: "The cohort studies of the Center for Oral Health Research in Appalachia, established in 2000 by the University of Pittsburgh in partnership with West Virginia University to find the factors behind poor oral health in northern Appalachia. They are a family-based etiology study (COHRA1), which recruited households in West Virginia and western Pennsylvania, and a longitudinal cohort (COHRA2), which since 2011 has recruited pregnant women in Pennsylvania and West Virginia and followed them and their children." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:18522740", IAO:0000119="PMID:36981009", IAO:0000119="PMID:35172313"}
