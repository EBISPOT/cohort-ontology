property_value: IAO:0000112 "PMID:36522743" xsd:string {dcterms:title="Amyloid-β and APOE genotype predict memory decline in cognitively unimpaired older individuals independently of Alzheimer's disease polygenic risk score.", xref="PMID:36522743", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9753236/fullTextXML", comment="[28] The PreclinAD study recruited participants from two sites: the Manchester and Newcastle Age and Cognitive Performance Research Cohort (ACPRC) in Manchester [29] and the Netherlands Twin Register (NTR) [30] in Amsterdam."}

[Instance]
id: coho:COHO_0001469
name: St. Göran Bipolar Project
def: "A longitudinal naturalistic cohort of outpatients with bipolar disorder, launched in 2005 by the Karolinska Institutet and the St. Göran bipolar outpatient clinic (the Affective Center) of Northern Stockholm Psychiatry in Stockholm, Sweden, with a second centre in Gothenburg from 2009, which consecutively enrols patients treated at these clinics, with age- and sex-matched population controls randomly selected by Statistics Sweden. It combines clinical ratings, cognitive testing, blood and cerebrospinal fluid sampling, brain imaging and genetics, with follow-up planned at 7 and 14 years, to identify predictors of long-term outcome in bipolar disorder." [] {IAO:0000119="PMID:28072414", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28468681", IAO:0000119="PMID:39746340"}
