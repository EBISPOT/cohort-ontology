[Instance]
id: coho:COHO_0001843
name: Harvard Biomarkers Study
def: "A longitudinal biomarker cohort study run jointly by Brigham and Women's Hospital and Massachusetts General Hospital in Boston, following patients with Parkinson's disease, patients with other neurodegenerative diseases and healthy controls at structured in-person study visits with biobanked samples, to accelerate the discovery and validation of molecular diagnostic and progression markers of early-stage Parkinson's disease." [] {IAO:0000119="PMID:32250320", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38480700", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8060834/fullTextXML"}
