property_value: IAO:0000112 "PMID:32414410" xsd:string {dcterms:title="Long-term sickness absence in a working population: development and validation of a risk prediction model in a large Dutch prospective cohort.", xref="PMID:32414410", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7227258/fullTextXML", comment="Data from 11,221 working persons included in the prospective Study on Transitions in Employment, Ability and Motivation (STREAM) conducted in the Netherlands were used to develop a multivariable risk prediction model for LTSA lasting ≥28 accumulated working days in the coming year."}

[Instance]
id: coho:COHO_0002599
name: Swedish Cervical Screening Cohort
def: "A cohort of women screened for human papillomavirus and cervical abnormalities in the capital region of Sweden, in the organised screening programme and in non-organised testing, enrolled from 2011 by the Center for Cervical Cancer Elimination at Karolinska Institutet and Karolinska University Hospital, with biobanked cervical samples and individual screening data updated from the Swedish National Cervical Screening Registry (NKCx), for long-term follow-up studies of cervical cancer and other diseases." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38926412"}
