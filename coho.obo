[Instance]
id: coho:COHO_0001316
name: Endometrial Cancer Association Consortium
def: "An international consortium of population- and hospital-based endometrial cancer studies in Europe, North America and Australia, whose cases of European ancestry were genotyped on the iCOGS and OncoArray arrays and compared with country-matched controls, mainly from the Breast Cancer Association Consortium, in genome-wide association studies of endometrial cancer risk." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:40633141", IAO:0000119="PMID:30093612", IAO:0000119="PMID:27135401"}
subset: coho1:GWAS_subset
synonym: "ECAC" RELATED OMO:0003000 []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Australia {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4907351/fullTextXML", comment="For the iCOGS genotyping stage, 4,330 women with a confirmed diagnosis of endometrial cancer and European ancestry were recruited via 11 studies in Western Europe, North America and Australia, collectively called the Endometrial Cancer Association Consortium (ECAC)."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Belgium {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4907351/supplementaryFiles", comment="Belgium; hospital based cases"}
