[Instance]
id: coho:COHO_0000566
name: Johnston County Osteoarthritis Project
def: "A population-based prospective cohort of African American and white civilian, non-institutionalised adults aged 45 years or older living in six townships of Johnston County, North Carolina, sampled regardless of osteoarthritis status, of whom 3,187 were enrolled in 1991-1997 and a further 1,015 in 2003-2004 to enrich the cohort for Black and younger adults, and followed about every five years to estimate the incidence and progression of knee and hip osteoarthritis and later of hand, spine and foot osteoarthritis." [] {IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8854450/fullTextXML", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19286855", IAO:0000119="https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9387345/fullTextXML"}
subset: coho1:GWAS_subset
