relationship: coho:has_data_collection_location http://dbpedia.org/resource/Japan {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33129280+AND+SRC%3AMED&format=json&resultType=core", comment="The Japan Prospective Studies Collaboration for Aging and Dementia (JPSC-AD) is a multisite, population-based prospective cohort study of dementia, which was designed to enroll approximately 10,000 community-dwelling residents aged 65 years or older from 8 sites in Japan and to follow them up prospectively for at least 5 years."}
property_value: coho:numberOfParticipants "11410" xsd:integer {IAO:0000116="community-dwelling residents aged 65 or over who took part in the 2016-2018 baseline survey at 8 sites", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7603740/fullTextXML", comment="A total of 11,410 individuals aged 65 years or older participated in the study."}
property_value: IAO:0000112 "GCST90809879" xsd:string {dcterms:title="Meta-analyses of genome-wide association studies identify novel loci influencing Japanese white matter hyperintensities.", xref="PMID:41554961", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41554961+AND+SRC%3AMED&format=json&resultType=core", comment="Here, we conducted a GWAS comprising 1001 Japanese individuals from the National Center for Geriatrics and Gerontology (NCGG) Biobank, followed by a meta-analysis with GWAS data from 9479 individuals in the Japan Prospective Studies Collaboration for Aging and Dementia (JPSC-AD), identifying three novel loci significantly associated with WMH volume (P -8)."}

[Instance]
id: coho:COHO_0001198
name: Korean Research Project on the Integrated Exposure Assessment of Hazardous Substances for Food Safety
def: "A nationwide Korean survey population of all ages, set up in 2010 by the National Institute of Food and Drug Safety Evaluation as the first integrated assessment of dietary exposure to hazardous substances from food, herbal medicine and functional food. Adults were drawn by region-, sex- and age-stratified probability sampling from 102 town and township clusters in 15 metropolitan areas and provinces, and children, adolescents and mothers were recruited through schools, kindergartens, health centres and hospitals. All were surveyed in 2010–2011 with food frequency and 24-hour recall questionnaires, blood and urine biomonitoring, and health examinations." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:26184046"}
subset: coho1:GWAS_subset
synonym: "Korean research project on the integrated exposure assessment of hazardous substances for food safety" RELATED []
