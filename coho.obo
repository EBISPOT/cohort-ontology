property_value: IAO:0000112 "GCST90179107" xsd:string {dcterms:title="Exome-Wide Association Study Reveals Host Genetic Variants Likely Associated with the Severity of COVID-19 in Patients of European Ancestry.", xref="PMID:36143338", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9504138/fullTextXML", comment="Accordingly, we conducted a case–control based association study to query an exome dataset of 1,432,135 SNPs in 2692 COVID-19 patients of European ancestry from the GEN-COVID consortium, University of Sienna, Italy."}

[Instance]
id: coho:COHO_0000755
name: Hawaii Colorectal Cancer Studies 2 and 3
def: "A population-based case-control study of colorectal cancer in Hawaii, United States, in which Japanese, Caucasian and Native Hawaiian residents of Oahu newly diagnosed with colorectal adenocarcinoma between January 1994 and August 1998 were identified through the Hawaii SEER registry and matched by sex, ethnicity and age to controls from a population-based health survey of the Hawaii State Department of Health and from Health Care Financing Administration participants, with in-person interviews and blood samples; its genotyped participants take part in consortium studies of genetic and lifestyle risk factors for colorectal cancer." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31875139", IAO:0000119="PMID:38561434"}
