property_value: IAO:0000112 "GCST90399478" xsd:string {dcterms:title="The first genome-wide association study in the Argentinian and Chilean populations identifies shared genetics with Europeans in Alzheimer's disease.", xref="PMID:37985413", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10917041/fullTextXML", comment="Additional AD cases and control individuals (32 AD and 20 controls) from Santiago were recruited from the GERO 17 (Geroscience Center for Brain Health and Metabolism) study at the Memory and Neuropsychiatric Center of the Hospital del Salvador and Faculty of Medicine of the University of Chile."}

[Instance]
id: coho:COHO_0001256
name: Alzheimer's Genetics in Argentina–Alzheimer Argentina consortium
def: "A multisite case-control study of sporadic Alzheimer's disease in Argentina, recruiting since 2013. Older people with Alzheimer's disease and cognitively unimpaired controls are enrolled at outpatient neurology departments of hospitals in the city and province of Buenos Aires and at centres in Jujuy, Córdoba and Mendoza provinces, to identify genes for susceptibility to sporadic Alzheimer's disease and genes that modify its phenotypes." [] {IAO:0000119="PMID:37333771", IAO:0000119="PMID:30705288", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:37985413", IAO:0000119="https://www.gaaindata.org/getPartner?project=AGA"}
