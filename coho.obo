property_value: IAO:0000112 "PMID:18413818" xsd:string {dcterms:title="Ornithine decarboxylase G316A genotype is prognostic for colorectal adenoma recurrence and predicts efficacy of aspirin chemoprevention.", xref="PMID:18413818", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18413818+AND+SRC%3AMED&format=json&resultType=core", comment="We genotyped ODC G316A in 546 individuals in the United Kingdom Colorectal Adenoma Prevention trial of aspirin for CRA recurrence prevention and pooled our findings with data from two other randomized intervention trials."}

[Instance]
id: coho:COHO_0002499
name: UK-CLL
def: "The two UK case-control genome-wide association studies of chronic lymphocytic leukaemia led by the Institute of Cancer Research: UK-CLL-1, whose cases came from the International CLL Linkage Consortium and the Leukaemia Research Fund CLL4 trial, and UK-CLL-2, whose cases came from a UK national study of CLL genetics coordinated by the Institute of Cancer Research and from the Newcastle CLL Consortium; both used publicly available genotypes of UK controls from the Wellcome Trust Case Control Consortium, the 1958 Birth Cohort and the UK Blood Service." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28112199", IAO:0000119="PMID:24292274", IAO:0000119="PMID:28165464"}
