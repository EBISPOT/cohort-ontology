[Instance]
id: coho:COHO_0002493
name: United Kingdom Asian Diabetes Study
def: "A study of patients with type 2 diabetes in general practices in Birmingham and Coventry, United Kingdom, carried out in 2004-2007, made up of a community-based cluster randomised controlled trial of a culturally sensitive enhanced care package for patients of south Asian origin and a parallel cohort study of cardiovascular risk factors in south Asian and white European patients; its south Asian participants have also contributed to genetic association studies of type 2 diabetes." [] {IAO:0000119="PMID:21294771", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:18502301", IAO:0000119="PMID:24902492"}
synonym: "U.K. Asian Diabetes study" RELATED []
synonym: "UK Asian Diabetes Study" RELATED []
synonym: "UKADS" RELATED OMO:0003000 []
