property_value: IAO:0000112 "GCST012442" xsd:string {dcterms:title="The genetic architecture of age-related hearing impairment revealed by genome-wide association analysis.", xref="PMID:34108613", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8190123/fullTextXML", comment="We conducted a GWAS of ARHI in three datasets obtained from the deCODE health study (DHS)24, the National Institute of Hearing and Speech in Iceland (NIHSI) and the UKB (Fig. 1, Supplementary Table 2)."}
