property_value: coho:numberOfControls "5069" xsd:integer {IAO:0000116="familial breast cancer cases and UK population controls of stage 1 of the GWAS, as its design paper states them (no total stated)", xref="https://europepmc.org/api/getPdf?pmcid=PMC3632836", comment="Case genotypes were compared with those from 5,069 controls, drawn from two UK population-based studies."}
property_value: IAO:0000112 "PGS000351" xsd:string {dcterms:title="Polygenic risk scores and breast and epithelial ovarian cancer risks for carriers of BRCA1 and BRCA2 pathogenic variants.", xref="PMID:32665703"}
property_value: IAO:0000112 "PMID:22266113" xsd:string {dcterms:title="Mammographic breast density and breast cancer: evidence of a shared genetic basis.", xref="PMID:22266113", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22266113+AND+SRC%3AMED&format=json&resultType=core", comment="To explore whether PMD and breast cancer have a shared genetic basis, we identified genetic variants most strongly associated with PMD in a published meta-analysis of five genome-wide association studies (GWAS) and used these to construct risk scores for 3,628 breast cancer cases and 5,190 controls from the UK2 GWAS of breast cancer."}

