relationship: coho:has_data_collection_location http://dbpedia.org/resource/Australia {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9908035/fullTextXML", comment="The 45 and Up Study (‘the Study’) recruited 267 357 participants aged ≥45 years from New South Wales, Australia between 2005 and 2009 as a resource for researchers and policy makers to source evidence to support better health and ageing."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Oceania
relationship: coho:hasSubCohort coho:COHO_0000298
relationship: coho:isCohortOf coho:COHO_0002701
property_value: coho:numberOfParticipants "267357" xsd:integer {IAO:0000116="men and women enrolled 2005-2009", xref="PMID:35604374", comment="A total of 1 395 174 invitations were mailed and 267 357 participants enrolled."}
property_value: IAO:0000112 "PMID:24149770" xsd:string {dcterms:title="Body mass index and incident hospitalisation for cardiovascular disease in 158 546 participants from the 45 and Up Study.", xref="PMID:24149770", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4052432/fullTextXML", comment="The Sax Institute's 45 and Up Study is a large-scale Australian cohort study of 267 151 men and women aged 45 years and over, randomly sampled from the general population of New South Wales (NSW), Australia."}
property_value: seeAlso https://www.saxinstitute.org.au/our-work/45-up-study/

[Instance]
id: coho:COHO_0002701
name: International Health Cohorts Consortium
def: "An international consortium of large population cohorts, established in 2018 to work beyond the constraints of individual health and population cohorts, whose members are chosen for size, longitudinal health follow-up, broad participant selection, biological sample collection and a commitment to data sharing, and which maintains the IHCC Cohort Atlas, a directory of the data its member cohorts hold." [] {IAO:0000119="PMID:40841586", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09"}
