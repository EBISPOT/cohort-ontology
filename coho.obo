relationship: coho:has_data_collection_location http://dbpedia.org/resource/Greece {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13423517/fullTextXML", comment="As part of the HYDRIA 2013–2014 National Health and Nutrition study, a cross-sectional survey of a nationally representative sample of adults in Greece, serum ferritin levels (SFL) were measured in participants aged ≥ 55 years, and dietary intake was assessed using two non-consecutive 24-h dietary recalls per participant."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Greece {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8949101/fullTextXML", comment="The HYDRIA survey sampling frame covered all the 51 prefectures of the 13 regions of the country [3]."}
