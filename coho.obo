property_value: IAO:0000112 "PMID:16753056" xsd:string {dcterms:title="The functional \"KL-VS\" variant of KLOTHO is not associated with type 2 diabetes in 5028 UK Caucasians.", xref="PMID:16753056", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1534014/fullTextXML", comment="Cases were recruited from three sources, as described previously [10,11]: a collection of young-onset subjects (YT2D; age at diagnosis 18–45 years; n = 256); probands from type 2 diabetic sibships from the Diabetes UK Warren 2 repository (W2SP; n = 499) [12,13]; and a more recent collection of cases with type 2 diabetes from the Diabetes UK Warren 2 repository (W2C; age at diagnosis 35–65 years; not selected for having a family history of diabetes; n = 1038)."}

[Instance]
id: coho:COHO_0002554
name: Women's Antioxidant Cardiovascular Study
def: "A randomised, double-blind, placebo-controlled 2x2x2 factorial trial of vitamin C, vitamin E and beta carotene for the prevention of cardiovascular events among female health professionals in the United States aged 40 or older with a history of cardiovascular disease or at least three cardiovascular risk factors, randomised from June 1995 to October 1996, to which a folic acid, vitamin B6 and vitamin B12 component was added in 1998; participants were followed up by questionnaire to 2005." [] {IAO:0000119="PMID:17698683", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:15006283"}
