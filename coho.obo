relationship: coho:hasCohort coho:COHO_0001017 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf", comment="Case and control subjects included in the discovery phase were subjects of European ancestry aged >55 years in the Genetics of Cerebral Hemorrhage with Anticoagulation13 (GOCHA) study (multicenter study in the US) and aged >18 years in the Genetic and Environmental Risk Factors for Hemorrhagic Stroke (GERFHS) studies I and II in Cincinnati, OH; Hospital del Mar Intracerebral Hemorrhage study and Vall d’Hebron Hospita lCH study in Barcelona, Spain; Jagiellonian University Hemorrhagic Stroke Study in Krakow, Poland; and the Lund Stroke Register study in Lund, Sweden."}
property_value: coho:numberOfCases "67162" xsd:integer {IAO:0000116="stroke cases and controls from 29 studies in the 2018 multiancestry GWAS meta-analysis", xref="PMID:29531354", comment="We conducted a multiancestry genome-wide-association meta-analysis in 521,612 individuals (67,162 cases and 454,450 controls) and discovered 22 new stroke risk loci, bringing the total to 32."}
property_value: coho:numberOfControls "454450" xsd:integer {IAO:0000116="stroke cases and controls from 29 studies in the 2018 multiancestry GWAS meta-analysis", xref="PMID:29531354", comment="We conducted a multiancestry genome-wide-association meta-analysis in 521,612 individuals (67,162 cases and 454,450 controls) and discovered 22 new stroke risk loci, bringing the total to 32."}
