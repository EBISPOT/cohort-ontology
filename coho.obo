relationship: coho:isCohortOf coho:COHO_0002701
property_value: IAO:0000112 "PMID:35922517" xsd:string {dcterms:title="A first update on mapping the human genetic architecture of COVID-19.", xref="PMID:35922517", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9352569/supplementaryFiles", comment="Coronagenes Cases and Controls 58.42 years West Midlands Research Ethics Commitee Individuals uploaded raw genotype information from direct-to-consumer DNA genotyping companies, including 23andMe, Ancestry, MyHeritage, and FTDNA."}
property_value: seeAlso https://www.ed.ac.uk/coronagenes/about/coronagenes-study

[Instance]
id: coho:COHO_0002683
name: German National Cohort
def: "A multidisciplinary population-based prospective cohort of men and women aged 19 to 74 years drawn at random from the general population and examined between 2014 and 2019 at 18 study centres across Germany, with interviews, questionnaires, biomedical examinations, biosamples and whole-body magnetic resonance imaging in a subsample, followed up by questionnaires, record linkage and re-examination, to investigate the causes, early detection and prevention of common chronic and infectious diseases." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:36260190"}
