relationship: coho:has_data_collection_location http://dbpedia.org/resource/France {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8320036/fullTextXML", comment="GEMO and GENEPSO provide an overview of a well-characterized sample of counseled Hereditary Breast and Ovarian Cancer (HBOC) families in France."}
relationship: coho:isCohortOf coho:COHO_0001889
property_value: coho:numberOfParticipants "4925" xsd:integer {IAO:0000116="Participants enrolled in GENEPSO in the updated database as of December2019 (dataset2 of the record-linkage paper).", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8320036/fullTextXML", comment="This optimal linkage method was then applied on the updated version (dataset 2) of the two studies as of December 2019. The updated version counted 6375 participants for GEMO (i.e. 1687 new participants), and 4925 participants for GENEPSO (i.e. 1586 new participants)."}
property_value: IAO:0000112 "PMID:22762150" xsd:string {dcterms:title="Variation in breast cancer risk associated with factors related to pregnancies according to truncating mutation location, in the French National BRCA1 and BRCA2 mutations carrier cohort (GENEPSO).", xref="PMID:22762150", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3680948/fullTextXML", comment="We assessed variation in BC risk according to factors related to pregnancies by location of mutation in the homogeneous risk region of BRCA1 and BRCA2 in 990 women in the French study GENEPSO by using a weighted Cox regression model."}

[Instance]
id: coho:COHO_0002724
name: National Prostate Cancer Register of Sweden
def: "A nationwide clinical prostate cancer registry in Sweden, originating from a regional register established in 1987 and covering the country since 1998, that records newly diagnosed prostate cancer, diagnostic workup, tumour characteristics and primary treatment to support quality assurance, benchmarking and clinical research on care and outcomes." [] {IAO:0000119="PMID:41078339", dcterms:contributor="GPT-6 (OpenAI), 2026-09", IAO:0000119="PMID:22561842"}
