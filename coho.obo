property_value: IAO:0000112 "PMID:38741014" xsd:string {dcterms:title="Genome-wide association analyses of breast cancer in women of African ancestry identify new susceptibility loci and improve risk prediction.", xref="PMID:38741014", xref="https://europepmc.org/api/getPdf?pmcid=PMC11284829", comment="In this study, we used genetic data from the AABCG, a consortium for a genetic study of breast cancer for females of African ancestry, including genetic data from over 20 studies conducted in the U.S. and Africa."}

[Instance]
id: coho:COHO_0001456
name: Australian Asthma Genetics Consortium
def: "An Australian research consortium, supported by the National Health and Medical Research Council, that pooled genotyped physician-diagnosed asthma cases and controls of European ancestry from several Australian studies, among them studies of the Queensland Institute of Medical Research, the Lung Institute of Western Australia, the Busselton Health Study and the Tasmanian Longitudinal Health Study, into a genome-wide association study of asthma first reported in 2011. Its data have since been used in international meta-analyses of asthma and allergic disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:21907864", IAO:0000119="PMID:24388013", IAO:0000119="PMID:29273806"}
