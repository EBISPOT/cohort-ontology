relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40567118+AND+SRC%3AMED&format=json&resultType=core", comment="The Biologics in Rheumatoid Arthritis Genetics and Genomics Study Syndicate is a nationwide observational cohort study recruiting patients from 53 centers across the United Kingdom before the initiation of biologic treatment and following them up prospectively for 12 months."}
property_value: coho:numberOfParticipants "3584" xsd:integer {IAO:0000116="BRAGGSS participants starting their first TNF inhibitor, data cut-off 30 November 2020 (a subset: other biologics excluded)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10907806/fullTextXML", comment="Of 3584 participants starting TNFi, 3459 had IMD data to allow analysis."}
property_value: IAO:0000112 "PMID:40567118" xsd:string {dcterms:title="Comparative Effectiveness of Abatacept Versus Adalimumab in Shared Epitope Positive and Negative Patients With Rheumatoid Arthritis.", xref="PMID:40567118", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40567118+AND+SRC%3AMED&format=json&resultType=core", comment="The Biologics in Rheumatoid Arthritis Genetics and Genomics Study Syndicate is a nationwide observational cohort study recruiting patients from 53 centers across the United Kingdom before the initiation of biologic treatment and following them up prospectively for 12 months."}

[Instance]
id: coho:COHO_0001546
name: Bangladesh Risk of Acute Vascular Events Study
def: "A case-control study of first-onset acute myocardial infarction in Bangladesh, established in 2011 by the University of Cambridge with the International Centre for Diarrhoeal Disease Research, Bangladesh (icddr,b) and the National Institute of Cardiovascular Disease (NICVD) in Dhaka, whose cases are adults admitted to the NICVD's emergency rooms with a first myocardial infarction and whose controls, frequency-matched by age and sex, are hospital visitors without cardiovascular disease; with questionnaire data, electrocardiograms and stored blood samples, it was set up to study environmental, genetic, lifestyle and biochemical determinants of coronary heart disease in Bangladeshis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:25930055", IAO:0000119="PMID:39811539"}
synonym: "BRAVE" RELATED OMO:0003000 []
