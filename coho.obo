relationship: coho:has_data_collection_location http://dbpedia.org/resource/Luxembourg {xref="https://www.lih.lu/en/oriscav-lux/", comment="ORISCAV-LUX (Observation des Risques et de la Santé Cardio-Vasculaire au Luxembourg = Observation of Cardiovascular Risks and Health in Luxembourg) was the first nationwide epidemiological study aimed at establishing an objective picture of the prevalence of lifestyle-related risk factors for cardiovascular disease in the general population residing in the Grand Duchy of Luxembourg."}
property_value: coho:numberOfParticipants "1558" xsd:integer {IAO:0000116="participants of wave 2 (2016-2018)", xref="https://www.lih.lu/en/oriscav-lux/", comment="The ORISCAV-LUX study was carried out by the Luxembourg Institute of Health (LIH) within the Department of Precision Health in 2007–2009 (Wave 1, 1432 participants) and in 2016-2018 (Wave 2, 1558 participants."}
property_value: IAO:0000112 "PMID:36581944" xsd:string {dcterms:title="Device-measured physical activity and sedentary time in a national sample of Luxembourg residents: the ORISCAV-LUX 2 study.", xref="PMID:36581944", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9798598/fullTextXML", comment="Data were from the ORISCAV-LUX 2 study, a national cross-sectional survey of cardiovascular risk factors in the Luxembourgish adult population"}

[Instance]
id: coho:COHO_0002635
name: Barcelona Life Study Cohort
def: "An exposome birth cohort of pregnant women enrolled between October 2018 and April 2021 at three tertiary university hospitals in Barcelona, Spain (Hospital Sant Joan de Déu, Hospital de la Santa Creu i Sant Pau and Hospital Clínic de Barcelona) and their primary healthcare centres, and of their children, followed from the first trimester of pregnancy through delivery into childhood to study the socio-environmental and genetic determinants of foetal and child health, growth and development and of maternal mental and physical health during and after pregnancy." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://projectebisc.org/en/bisc-project/", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/BiSC"}
