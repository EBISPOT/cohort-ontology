property_value: IAO:0000112 "GCST90833053" xsd:string {dcterms:title="Large-scale exome analyses reveal new rare variant contributions in amyotrophic lateral sclerosis.", xref="PMID:41917433", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13083253/fullTextXML", comment="Case cohorts included the Project MinE ALS sequencing consortium (7,614 cases; 2,605 controls)47, the NYGC ALS Consortium (2,650 cases; 342 controls), the ALS Sequencing Consortium (2,851 cases)5, two cohorts from the FALS consortium (1,277 cases; phs001585), the National Institutes of Health (NIH) Exome Sequencing of FALS Project (194 cases; phs000101), two Australian cohorts described in ref. 48 (125 cases, 18 controls) and ref. 49 (568 cases), and a Chinese motor neurone disease (MND) cohort50 (583 cases, 182 controls)."}

[Instance]
id: coho:COHO_0001386
name: NZ AAA Genetics Study
def: "A case-control study of abdominal aortic aneurysm (AAA) in New Zealand. The Vascular Research Consortium of New Zealand recruited men and women with AAA (infrarenal aortic diameter of at least 30 mm on ultrasound or CT scan, about 80% after surgical repair), nearly all of Anglo-European ancestry, and elderly Anglo-European controls in whom AAA was excluded by abdominal ultrasound and who were also screened for peripheral and carotid artery disease. Its participants were genotyped in two genome-wide case-control sets for genetic studies of AAA." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27899403", IAO:0000119="PMID:37845353"}
subset: coho1:GWAS_subset
