[Instance]
id: coho:COHO_0002481
name: London and the South East Region Alzheimer's Disease Study
def: "A naturalistic, prospective cohort of people with Alzheimer's disease and their carers in London and the South East Region of the UK, run from University College London, recruited in 2002-2003 through community mental health teams, memory clinics, care homes, day hospitals and the voluntary sector to be representative of people with Alzheimer's disease in the community by sex, living setting and severity, and followed for up to 54 months to study the progression, characteristics and costs of the disease and the problems of carers." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4360590/fullTextXML", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.440/MediaObjects/41588_2009_BFng440_MOESM9_ESM.pdf", IAO:0000119="PMID:24423220"}
