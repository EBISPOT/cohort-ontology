property_value: IAO:0000112 "PMID:23349703" xsd:string {dcterms:title="Variants in the 15q24/25 locus associate with lung function decline in active smokers.", xref="PMID:23349703", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3548843/fullTextXML", comment="The rs1051730 and rs8034191 variants were genotyped in a population-based cohort of 1,226 heavy smokers (COPACETIC) and in an independent cohort of 883 heavy smokers, of which 653 with COPD of varying severity (LEUVEN)."}

