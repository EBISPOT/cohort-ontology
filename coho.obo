property_value: IAO:0000112 "GCST90239836" xsd:string {dcterms:title="Pharmacokinetics and pharmacogenomics of clozapine in an ancestrally diverse sample: a longitudinal analysis and genome-wide association study using UK clinical monitoring data.", xref="PMID:36804072", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36804072+AND+SRC%3AMED&format=json&resultType=core", comment="In this GWAS, we analysed data from the UK Zaponex Treatment Access System clozapine monitoring service as part of the CLOZUK study."}

[Instance]
id: coho:COHO_0001069
name: Colorado Longitudinal Twin Study
def: "A prospective longitudinal study of same-sex twin pairs born in 1984–1990 and recruited in Colorado, United States, from the Colorado Twin Registry of the Institute for Behavioral Genetics at the University of Colorado, assessed almost yearly from 14 months to age 16 and again in adulthood to investigate genetic and environmental influences on individual differences in psychological development." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:23092589", IAO:0000119="PMID:42223860"}
