property_value: IAO:0000112 "PMID:42167794" xsd:string {dcterms:title="Risk factors for multimorbidity of cardiovascular diseases in the prospective Million Women Study.", xref="PMID:42167794", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13202100/fullTextXML", comment="The Million Women Study is a population-based cohort study of 1.3 million UK women."}
property_value: seeAlso http://www.millionwomenstudy.org/introduction/

[Instance]
id: coho:COHO_0002675
name: Saudi Biobank
def: "A population-based biobank of Saudi nationals aged 10 years and over, recruited since 2017 by the Saudi Biobank Center of King Abdullah International Medical Research Center in Riyadh, in person at Ministry of National Guard Health Affairs hospitals and clinics and at community sites such as blood donation centres, with questionnaires, biological samples and linked electronic health records, to support genetic and epidemiological research on common and rare diseases in Saudi Arabia." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:33194979", IAO:0000119="https://www.biobanking.org/biobanks/view/462", IAO:0000119="PMID:41721974"}
