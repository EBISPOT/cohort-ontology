property_value: coho:numberOfParticipants "4003" xsd:integer {IAO:0000116="brain donors collected by the NBB from 1989 to 2015", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7098103/fullTextXML", comment="Clinical records of all donors (n = 4003) collected by the NBB in Amsterdam, the Netherlands, from 1989 to 2015 were screened for inclusion in this study."}
property_value: IAO:0000112 "PGS000906" xsd:string {dcterms:title="Polygenic Risk Score of Longevity Predicts Longer Survival Across an Age Continuum.", xref="PMID:33216869"}
property_value: IAO:0000112 "PMID:33216869" xsd:string {dcterms:title="Polygenic Risk Score of Longevity Predicts Longer Survival Across an Age Continuum.", xref="PMID:33216869", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8087277/fullTextXML", comment="As controls, we used (a) a sample of 1779 Dutch older adults from the Longitudinal Aging Study of Amsterdam (24), (b) a sample of 1206 older adults with subjective cognitive decline who visited the memory clinic of the Alzheimer Center Amsterdam and SCIENCe project, who were labeled cognitively normal after the extensive examination (25), (c) a sample of 40 healthy controls from the Netherlands Brain Bank (26), (d) a sample of 201 individuals from the twin study (27), and (e) a sample of 86 older adults from the 100-plus Study (partners of centenarian’s children)."}

[Instance]
id: coho:COHO_0002116
name: Nashville Breast Health Study
def: "A population-based case-control study of breast cancer in the eight-county Nashville metropolitan area, Tennessee, United States, approved through Vanderbilt University Medical Center, which from April 2001 enrolled women aged 25 to 75 with newly diagnosed invasive breast cancer or ductal carcinoma in situ, found through the Tennessee State Cancer Registry and five major Nashville hospitals, and controls found by random-digit dialling and frequency-matched on age, race and county, with telephone interviews, food frequency questionnaires and buccal DNA samples." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.318/MediaObjects/41588_2009_BFng318_MOESM9_ESM.pdf"}
