relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/South_Korea {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf", comment="Health2 cohort recruited a total of 8,500 participants aged 40-69 years from five regional cities in Korea based on the Korean Genome Epidemiologic Study (KoGES) project."}
relationship: coho:isSubCohortOf coho:COHO_0001848 {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf", comment="A total of 1,183 T2D cases were selected from population-based 'Health2 cohort'."}
