relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML", comment="All CRC visits took place at an academic medical center (Massachusetts General Hospital, Brigham and Women’s Hospital, or the Joslin Diabetes Center, all in Boston, MA)."}
property_value: coho:numberOfParticipants "1000" xsd:integer {IAO:0000116="individuals naive to diabetes medication who received the glipizide and metformin challenges", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10790310/unicode", comment="SUGAR-MGH is a pharmacogenetic study in which 1000 individuals who were naive to type 2 diabetes medications received a single-dose glipizide challenge and a short course of metformin."}
property_value: IAO:0000112 "GCST90269867" xsd:string {dcterms:title="Genome-wide association analysis identifies ancestry-specific genetic variation associated with acute response to metformin and glipizide in SUGAR-MGH.", xref="PMID:37233759", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:37233759%20AND%20SRC:MED&resultType=core&format=json", comment="The Study to Understand the Genetics of the Acute Response to Metformin and Glipizide in Humans (SUGAR-MGH) examined the acute response to metformin and glipizide in order to identify new pharmacogenetic associations for the response to common glucose-lowering medications in individuals at risk of type 2 diabetes."}

