[Instance]
id: coho:COHO_0002115
name: Netherlands Brain Bank
def: "A brain bank established at the end of 1985 at the Netherlands Institute for Brain Research, in collaboration with nursing homes in and around Amsterdam, the Netherlands, which performs rapid autopsies of donors who gave informed consent during life for the research use of their brain tissue and medical files, originally to supply post-mortem brain tissue from Alzheimer's disease patients and controls." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29496148", IAO:0000119="PMID:8360654", dcterms:contributor="Claude Sonnet 5 (Anthropic), 2026-09", IAO:0000119="PMID:1480765"}
subset: coho1:PGS_subset
synonym: "NBB" RELATED OMO:0003000 []
