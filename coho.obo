id: coho:COHO_0002733
name: Human Metabolome study
def: "A study in which young healthy male volunteers underwent a highly controlled four-day challenge protocol of 36 hours of fasting, oral glucose and lipid tests, liquid test meals, physical exercise and cold stress, with blood, urine, exhaled air and breath condensate analysed at up to 56 time points, to analyse the dynamics of the human metabolome in response to environmental stimuli." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22426117", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09"}
subset: coho1:MetaboLight_subset
synonym: "HuMet" RELATED OMO:0003000 []
synonym: "HuMet Repository" RELATED []
synonym: "HuMet study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Germany {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_json/PMC11513335/unicode", comment="The present work is based on samples of the Human Metabolome (HuMet) study conducted at the Human Study Center of the Else-Kröner-Fresenius Center of Nutritional Medicine at the Technical University Munich."}
property_value: coho:numberOfParticipants "15" xsd:integer {IAO:0000116="young healthy male participants", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_json/PMC11513335/unicode", comment="Briefly, 15 healthy male participants were recruited for the study. Participants were young (mean age of 27.8 years ±2.9), had normal weight (mean body mass index (BMI) of 23.1 kg/m2 ± 1.8), did not take any medication, and did not show any metabolic abnormalities."}
property_value: IAO:0000112 "MTBLS89" xsd:string {dcterms:title="The HuMet Repository: Watching human metabolism at work.", xref="PMID:39033506", xref="https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS89", comment="We present the HuMet Repository for exploring dynamic metabolic responses to oral glucose/lipid loads, mixed meals, 36-h fasting, exercise, and cold stress in healthy subjects."}

[Instance]
id: coho:COHO_0002734
name: Immunophenotyping Assessment in a COVID-19 Cohort
def: "A prospective longitudinal study of adults hospitalised with COVID-19 in the United States, launched in May 2020 by the National Institute of Allergy and Infectious Diseases, following their clinical course and immune responses through serial sampling." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09", IAO:0000119="PMID:34376480"}
