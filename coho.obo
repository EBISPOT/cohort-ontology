[Instance]
id: coho:COHO_0002317
name: Risk Evaluation of Viral Load Elevation and Associated Liver Disease/Cancer-Hepatitis B Virus
def: "A community-based prospective cohort in Taiwan made up of the participants of the REVEAL study who were seropositive for hepatitis B surface antigen: the REVEAL study enrolled residents aged 30 to 65 years from seven townships in Taiwan in 1991–1992, who gave blood samples, completed questionnaires and had health examinations at enrolment, and its HBsAg-seropositive participants were followed with blood collection and abdominal ultrasonography every 6–12 months and by linkage to the Taiwan National Cancer Registry and death certification, to study the risk factors for hepatocellular carcinoma in chronic hepatitis B virus carriers. Its sister cohort, REVEAL-HCV, followed the participants seropositive for antibodies to hepatitis C virus." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29600553", IAO:0000119="PMID:36878686", IAO:0000119="PMID:32406072"}
synonym: "REVEAL-HBV" RELATED OMO:0003000 []
synonym: "Risk Evaluation of Viral Load Elevation and Associated Liver Disease/Cancer-Hepatitis B Virus study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Asia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Taiwan {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7529994/unicode", comment="Between 1991–1992, 23,820 participants aged 30 to 65 years old from seven townships in Taiwan enrolled in the study, completed questionnaires, and underwent health examinations."}
property_value: coho:numberOfParticipants "4155" xsd:integer {IAO:0000116="HBsAg-seropositive participants of the REVEAL community cohort enrolled 1991-1992 and followed as REVEAL-HBV", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10548479/unicode", comment="Of the study enrollees, 4,155 (17.4%) were hepatitis B virus surface antigen (HBsAg) seropositive and were followed as part of the REVEAL-HBV study."}
property_value: IAO:0000112 "PMID:32406072" xsd:string {dcterms:title="Prediagnostic concentrations of circulating bile acids and hepatocellular carcinoma risk: REVEAL-HBV and HCV studies.", xref="PMID:32406072", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7529994/unicode", comment="Thus, to examine circulating bile acids in relationship to risk of liver cancer, we leveraged the Risk Evaluation of Viral Load Elevation and Associated Liver Disease/Cancer (REVEAL)-HBV and -HCV cohorts from Taiwan."}

[Instance]
id: coho:COHO_0002318
name: Risk Factors for Prostate Cancer Study
def: "A population-based case-control study of prostate cancer run by the Cancer Council Victoria, which in 1994-1997 recruited men resident in Melbourne and Perth, Australia, who were diagnosed with prostate cancer before age 70, through the state cancer registries, together with controls identified from government electoral rolls and frequency-matched to the cases by age." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19767753", IAO:0000119="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.450/MediaObjects/41588_2009_BFng450_MOESM22_ESM.pdf", IAO:0000119="PMID:24386513"}
