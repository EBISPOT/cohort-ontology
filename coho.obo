property_value: IAO:0000112 "PMID:21874001" xsd:string {dcterms:title="Genome-wide association study in individuals of South Asian ancestry identifies six new type 2 diabetes susceptibility loci.", xref="PMID:21874001", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3773920/unicode", comment="Replication testing amongst South Asians was carried out amongst 13,170 T2D cases and 25,398 controls participants from the following studies: the Chennai Urban Rural Epidemiology Study (CURES) the COBRA study the Diabetes Genetics in Pakistan (DGP) and UK Asian Diabetes Study (UKADS), the Mauritius study, the Ragama Health Study (RHS), the Sikh Diabetes Study (SDS), the Singapore Consortium of Cohort Studies (SCCS), the Sri Lankan Diabetes Study (SLDS), and the LOLIPOP and PROMIS studies."}

[Instance]
id: coho:COHO_0002391
name: Systemic Lupus Erythematosus in Gullah Health Study
def: "A longitudinal observational cohort study of systemic lupus erythematosus among the Gullah African Americans of the Sea Island region of South Carolina, United States, run from the Medical University of South Carolina, which enrols self-identified Gullah patients with lupus meeting the American College of Rheumatology classification criteria, their relatives, and unrelated unaffected Gullah controls, to study the genetic and environmental factors that contribute to lupus in this population. It is one of the community-engaged Sea Island Families Project studies." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:30326636", IAO:0000119="PMID:34008864", IAO:0000119="PMID:22031537", IAO:0000119="PMID:18438839"}
