property_value: IAO:0000112 "GCST90134438" xsd:string {dcterms:title="Genome-Wide Association Study of Airway Wall Thickening in a Korean Chronic Obstructive Pulmonary Disease Cohort.", xref="PMID:35886039", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9318537/fullTextXML", comment="Study participants were chosen from two cohorts: 500 subjects (324 COPD patients and 176 controls) from the COPD in dusty areas (CODA) cohort [8] and 474 subjects (235 COPD patients and 239 matched controls) from the KoGES-Ansan cohort [9,10]."}

[Instance]
id: coho:COHO_0001307
name: Cohort in Lung Transplantation
def: "A prospective multicentre cohort of lung transplant candidates enrolled before transplantation at eleven French lung transplant centres and the Erasme Hospital in Brussels between September 2009 and the end of 2018, coordinated by Nantes University Hospital, with clinical data and biological samples from recipients, and samples from their organ donors, followed every six months after transplantation (samples for up to five years, clinical data for up to ten), set up to discover early predictors of chronic lung allograft dysfunction." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:39164465", IAO:0000119="PMID:36968829"}
subset: coho1:GWAS_subset
