property_value: coho:numberOfCases "721" xsd:integer {IAO:0000116="Ashkenazi Jewish schizophrenia probands and Ashkenazi Jewish controls of the program in one replication study (analysed subset)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2901865/", comment="Our analysis sample of 721 AJ SZ probands and 720 AJ controls was collected by the Johns Hopkins Epidemiology-Genetics Program in Psychiatry (http://www.hopkinsmedicine.org/epigen/), and has been described in detail elsewhere (Fallin et al. 2003)."}
