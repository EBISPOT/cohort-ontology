property_value: coho:numberOfParticipants "32175" xsd:integer {IAO:0000116="early adolescents (20,514 girls, 11,661 boys) enrolled in the trial, 2007-2010", xref="PMID:25593103", comment="Recruitment resulted in equal enrolment of four birth cohorts (born 1992-1995) comprising altogether 32,175 (40% response) early adolescents: 20,514 girls (50.5-53.0% response by arm) and 11,661 boys (21.9-31.6%% response by arm)."}
property_value: IAO:0000112 "PMID:40205852" xsd:string {dcterms:title="HPV-KITE: sequence analysis software for rapid HPV genotype detection.", xref="PMID:40205852", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11982018/fullTextXML", comment="from the Finnish HPV vaccination cohort"}
property_value: seeAlso https://projects.tuni.fi/hpv-rokotiitus/

[Instance]
id: coho:COHO_0002605
name: Nascita e INFanzia: gli Effetti dell'Ambiente
def: "An Italian internet-based birth cohort of children born to pregnant women who volunteered through the study website, started as a pilot in Turin in July 2005 and extended to the rest of Italy, with recruitment until 2016 and online questionnaires completed by the mothers during pregnancy and repeatedly through the child's childhood and adolescence, set up to investigate the effects of pre-natal and early post-natal exposures on infant, child and adult health." [] {IAO:0000119="https://www.progettoninfea.it/index_en", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:26071071", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/NINFEA", IAO:0000119="PMID:17955333"}
