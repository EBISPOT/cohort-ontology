property_value: IAO:0000112 "PMID:24068962" xsd:string {dcterms:title="Meta-analysis of genome-wide association studies identifies six new Loci for serum calcium concentrations.", xref="PMID:24068962", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3778004/fullTextXML", comment="We replicated findings using de novo genotyping in the Bus Santé Study and in silico data in all other cohorts."}

[Instance]
id: coho:COHO_0001552
name: Camargo Cohort Study
def: "A prospective community-based cohort of postmenopausal women and men aged 50 years and older who attended a primary care centre in Camargo, Cantabria, in northern Spain, for a regular health examination or for medical reasons, enrolled between February 2006 and February 2011 and re-evaluated in later waves to study the prevalence and incidence of metabolic bone diseases and the risk factors for osteoporosis and fragility fractures." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35906442", IAO:0000119="PMID:37924421", IAO:0000119="PMID:40983397"}
