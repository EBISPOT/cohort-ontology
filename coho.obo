relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Japan {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7938099/fullTextXML", comment="The Japan Multi-Institutional Collaborative Cohort (J-MICC) Study is a large population-based genome cohort study in which about 100,000 participants from 15 study areas of Japan are being followed up for 20 years for cancer incidence."}
property_value: coho:numberOfParticipants "92610" xsd:integer {IAO:0000116="adults aged 35-69 in the baseline survey (2005-2014)", xref="PMID:32963210", comment="After excluding 8,294 respondents under 35 or over 70 years of age and 578 who withdrew consent or became ineligible, the remaining 92,610 participants (40,880 men and 51,730 women with an average age of 55.2 [standard deviation, 9.4] years) in the baseline survey were included in the present analysis (the dataset was fixed on February 2, 2020)."}
