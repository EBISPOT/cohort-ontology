property_value: IAO:0000112 "PMID:19536330" xsd:string {dcterms:title="Complex segregation analysis of pedigrees from the Gilda Radner Familial Ovarian Cancer Registry reveals evidence for mendelian dominant inheritance.", xref="PMID:19536330", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19536330+AND+SRC%3AMED&format=json&resultType=core", comment="The goal of this study was to investigate the inheritance model that best fits the observed transmission pattern of ovarian cancer among 7669 members of 1919 pedigrees ascertained through probands from the Gilda Radner Familial Ovarian Cancer Registry at Roswell Park Cancer Institute, Buffalo, New York."}

[Instance]
id: coho:COHO_0001826
name: Gilda Radner Hereditary Cancer Program
def: "A research program at Cedars-Sinai Medical Center, Los Angeles, launched as the Gilda Radner Hereditary Cancer Early Detection Program, that from 1991 enrolled women at elevated risk of cancer because of their family histories, among them carriers of BRCA1 and BRCA2 mutations, offered them ovarian cancer screening and, once it became clinically available, BRCA genetic testing, and keeps their serum samples and lymphoblastoid cell lines in a biorepository for later studies." [] {IAO:0000119="PMID:34965417", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:23157996", IAO:0000119="PMID:38230704", IAO:0000119="PMID:25256924"}
