relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8118582/fullTextXML", comment="Plasma samples were obtained from participants of the Dallas Heart Study (DHS), a multiracial/multiethnic, population-based probability sample (n = 3557) of Dallas County residents that was collected between 2000 and 2002 (DHS-1) (35)."}
property_value: coho:numberOfParticipants "6101" xsd:integer {IAO:0000116="DHS-1 participants with completed interviews (survey phase), 2000-2002", xref="PMID:15194016", comment="Completed interviews were obtained for 6,101 subjects (54% black), phlebotomy visits for 3,398 (52% black), and clinic visits for 2,971 (50% black)."}
property_value: IAO:0000112 "GCST90093122" xsd:string {dcterms:title="Genetic and Metabolic Determinants of Plasma Levels of ANGPTL8.", xref="PMID:33619548", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33619548+AND+SRC%3AMED&format=json&resultType=core", comment="We studied a population-based sample of Dallas County, comprising individuals in the Dallas Heart Study (DHS-1, n = 3538; DHS-2, n = 3283), including 2131 individuals with repeated measurements 7 to 9 years apart (age 18-85 years; >55% female; 52% Black; 29% White; 17% Hispanic; and 2% other)."}
property_value: IAO:0000116 "The acronym DHS also denotes Dortmund Health Study (COHO:0000054), Diabetes Heart Study (COHO:0000460) and deCODE Health Study (COHO:0000468); this term is Dallas Heart Study." xsd:string

[Instance]
id: coho:COHO_0001310
name: Danish Testicular Cancer Late Treatment Effects Cohort
def: "A nationwide, population-based cohort of long-term testicular cancer survivors treated in Denmark in 1984–2007, identified in the Danish Testicular Cancer (DaTeCa) clinical database and surveyed by questionnaire on late effects in 2014–2016 by the Department of Oncology at Rigshospitalet, Copenhagen University Hospital, with linked hospital, pathology and national registry data and a biobank of blood and sputum samples, set up to analyse late effects of treatment and inform future follow-up programmes." [] {IAO:0000119="PMID:29515973", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:37568739"}
