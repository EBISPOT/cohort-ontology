id: coho:COHO_0001691
name: Eplerenone Post-Acute Myocardial Infarction Heart Failure Efficacy and Survival Study
def: "A double-blind, placebo-controlled randomised trial of eplerenone, a selective aldosterone blocker, added to optimal medical therapy in patients enrolled 3 to 14 days after an acute myocardial infarction complicated by left ventricular dysfunction (ejection fraction of 40% or less) and heart failure or diabetes, followed for death and cardiovascular hospitalisation; a biomarker substudy of its patients has serial blood measurements." [] {IAO:0000119="PMID:31250134", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:12668699", IAO:0000119="PMID:31482613"}
synonym: "EPHESUS" RELATED OMO:0003000 []
synonym: "EPHESUS trial" RELATED []
synonym: "Eplerenone Post-acute myocardial infarction Heart failure Efficacy and SUrvival Study" RELATED []
synonym: "The Eplerenone Post-Acute Myocardial Infarction Heart Failure Efficacy and Survival Study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
property_value: coho:numberOfParticipants "6632" xsd:integer {IAO:0000116="EPHESUS randomized patients with acute MI and left ventricular dysfunction plus heart failure or diabetes", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6837025/fullTextXML", comment="EPHESUS included 6632 patients with an acute MI (3‐14 days after the MI), and a LVEF ≤ 40% plus HF or diabetes to receive either eplerenone (25 mg per day initially, titrated to a maximum of 50 mg per day) or placebo."}
property_value: IAO:0000112 "PMID:40602178" xsd:string {dcterms:title="Interaction Between Aldosterone and Mineralocorticoid Receptor Antagonist: Findings From the EPHESUS Trial.", xref="PMID:40602178", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40602178+AND+SRC%3AMED&format=json&resultType=core", comment="In a subset of the EPHESUS (Eplerenone Post-Acute Myocardial Infarction Heart Failure Efficacy and Survival Study) trial, associations between baseline serum aldosterone concentrations, their changes from baseline to month 1, and outcomes were separately assessed in the eplerenone and placebo groups."}

[Instance]
id: coho:COHO_0001692
name: Epidemiological Study of Prostate Cancer
def: "A population-based case-control study of prostate cancer in the Hérault département in the south of France, whose cases are men under 75 newly diagnosed with prostate cancer in 2012-2013 while living in Hérault, identified in all of its public and private cancer centres, and whose controls are men without prostate cancer randomly selected from Hérault's general population with quotas on age and socioeconomic status, set up to study environmental and genetic risk factors for prostate cancer." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38174802"}
subset: coho1:PGS_subset
synonym: "EPICAP" RELATED OMO:0003000 []
