property_value: coho:numberOfParticipants "2997" xsd:integer {IAO:0000116="men and women born in Hertfordshire in 1931-1939 and still living there, who make up the cohort", xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.287/MediaObjects/41588_2009_BFng287_MOESM14_ESM.pdf", comment="The Hertfordshire Cohort Study comprises 2,997 men and women born in the English county of Hertfordshire during the period 1931-1939 and still resident there today."}
property_value: IAO:0000112 "PMID:42471507" xsd:string {dcterms:title="Biological age-acceleration in relation to muscle mass, strength and function: findings from the Hertfordshire Cohort Study.", xref="PMID:42471507", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42471507+AND+SRC%3AMED&format=json&resultType=core", comment="Overall, 331 participants from the UK community-dwelling Hertfordshire Cohort Study were analysed."}
