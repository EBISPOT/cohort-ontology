property_value: coho:numberOfParticipants "736723" xsd:integer {IAO:0000116="consenting AncestryDNA research participants who answered the 2020 COVID-19 survey (a subset of the Human Diversity Project)", xref="PMID:35410379", comment="In less than 4 months during an early phase of the pandemic, we collected survey data from 736,723 AncestryDNA research participants who consented to research."}
property_value: IAO:0000112 "GCST90432107" xsd:string {dcterms:title="Genetic risk factors for COVID-19 and influenza are largely distinct.", xref="PMID:39103650", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11319199/fullTextXML", comment="To understand the extent to which the same host genetic factors influence the risk of coronavirus disease 2019 (COVID-19) and influenza, we first performed a genome-wide association study (GWAS) of influenza infection based on survey data from 296,313 participants of the AncestryDNA COVID-19 study who consented to the research8."}

