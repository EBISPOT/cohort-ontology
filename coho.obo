[Instance]
id: coho:COHO_0001773
name: Genomics of Kidney Transplantation
def: "A prospective observational cohort of kidney or kidney-pancreas transplant recipients, enrolled within 10 days of transplantation, and kidney donors, recruited from 2012 to 2016 at transplant centres in the United States (University of Alabama in Birmingham, University of Minnesota, Hennepin County Medical Center and Mayo Clinic) and Canada (University of Alberta) in a study sponsored by the National Institute of Allergy and Infectious Diseases with the Genomics of Transplantation Cooperative Research Program, to investigate the relationship between genetic variation and kidney transplant outcomes." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://clinicaltrials.gov/study/NCT01714440", IAO:0000119="PMID:38820342"}
