property_value: coho:numberOfParticipants "1392" xsd:integer {IAO:0000116="children enrolled at age 7 who were followed at least once (2005-2020); not a stated total of the whole open cohort", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12293192/fullTextXML", comment="A total of 1392 children were followed at least once after enrollment at age 7."}
