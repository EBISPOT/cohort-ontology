relationship: coho:has_data_collection_location http://dbpedia.org/resource/Germany {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10627490/fullTextXML", comment="Patients with type 2 diabetes mellitus, aged 18–80 years, who had received maintenance hemodialysis for less than 2 years were included by 178 dialysis centers in Germany into the 4 D study (Die Deutsche Diabetes Dialyse Studie/German Diabetes and Dialysis Study)."}
property_value: coho:numberOfParticipants "1255" xsd:integer {IAO:0000116="patients randomised to atorvastatin or placebo", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10539202/fullTextXML", comment="The 4D Study was a multicentre, randomized, double-blind, prospective study enrolling 1255 participants with T2DM receiving maintenance HD at 178 centres who were randomly assigned to receive 20 mg of atorvastatin or matching placebo daily."}
property_value: IAO:0000112 "GCST90320249" xsd:string {dcterms:title="Lowering of Circulating Sclerostin May Increase Risk of Atherosclerosis and Its Risk Factors: Evidence From a Genome-Wide Association Meta-Analysis Followed by Mendelian Randomization.", xref="PMID:37096546", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10586470/unicode", comment="We found that this variant showed a robust negative effect on sclerostin in all cohorts; however, the genetic effect estimate was particularly large in the 4D cohort, comprising individuals with end‐stage chronic kidney disease (CKD) (Supplementary Table 5B)."}

[Instance]
id: coho:COHO_0001272
name: African Descent and Glaucoma Evaluation Study
def: "A multicentre prospective observational cohort study, which from 2003 enrolled people of African descent and of European descent without glaucoma, with suspected glaucoma or with glaucoma at the University of California San Diego, the New York Eye and Ear Infirmary and the University of Alabama at Birmingham, United States, and followed them with repeated visual function testing and optic nerve imaging to identify why glaucoma onset and progression differ between people of African and European descent. Its third phase (ADAGES III) recruited, in 2014–2016 at five US centres, patients with primary open-angle glaucoma and controls of African or European descent, with DNA, to study the genetics of the disease in people of African descent." [] {IAO:0000119="PMID:30352225", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29361356", IAO:0000119="PMID:19752422"}
subset: coho1:GWAS_subset
synonym: "ADAGES" RELATED OMO:0003000 []
