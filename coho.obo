[Instance]
id: coho:COHO_0000915
name: Heart Failure Molecular Epidemiology for Therapeutic Targets Consortium
def: "A global collaboration of 51 studies from 11 countries with genome-wide genotyping and data on heart failure events and prognosis, including population-based cohorts, hospital-based electronic health record cohorts, case-control studies and clinical trials, formed to conduct large-scale genetic association studies of heart failure risk, prognosis and subtypes." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:34480422"}
subset: coho1:GWAS_subset
synonym: "Heart Failure Molecular Epidemiology for Therapeutic Targets" RELATED []
synonym: "HERMES" RELATED OMO:0003000 []
synonym: "HERMES Consortium" RELATED []
instance_of: coho:COHO_0000001 ! cohort aggregation
relationship: coho:hasCohort coho:COHO_0000176 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13211948/fullTextXML", comment="Twenty-two cohorts participating in the Heart Failure Molecular Epidemiology for Therapeutic Targets (HERMES) Consortium, comprising 50,636 individuals with established HF of European ancestry, were included in the genetic study (Supplemental Table 2).27 Twelve were HF cohorts (trials or prospective research cohorts), 9 were nested HF cohorts within non-HF cardiovascular trials or cohorts, and 1 cohort was derived from individuals in the UK Biobank with genetic data."}
relationship: coho:hasCohort coho:COHO_0000384 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11985341/supplementaryFiles", comment="The Cardiovascular Health Study (CHS) is a population-based cohort study of risk factors for heart disease and stroke in adults ≥65 years conducted across four field centers."}
relationship: coho:hasCohort coho:COHO_0000385 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11985341/supplementaryFiles", comment="The Framingham Heart Study (FHS) is a community-based cohort that enrolled three generations of participants."}
relationship: coho:hasCohort coho:COHO_0000417 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11985341/supplementaryFiles", comment="The BioVU cohort consisted of patients at Vanderbilt University Medical Center who have consented to be a part of the program."}
relationship: coho:hasCohort coho:COHO_0000428 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11985341/supplementaryFiles", comment="The deCODE Icelandic heart failure (HF) sample set included patients diagnosed with HF at Landspitali – The National University Hospital (LUH) in Reykjavik and the Primary Health Care Clinics of the Reykjavik capital region, following ICD-9 and ICD-10 codes for heart failure, as described in this manuscript."}
relationship: coho:hasCohort coho:COHO_0000868 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11985341/supplementaryFiles", comment="The Henry Ford Heart Failure Pharmacogenomic Registry (HFPGR) was approved by the Institutional Review Board at the Henry Ford Health System, and all patients gave written informed consent prior to participation."}
relationship: coho:hasCohort coho:COHO_0000952 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11985341/supplementaryFiles", comment="TRIUMPH (TRanslational Initiative on Unique and novel strategies for Management of Patients with Heart failure, NTR1893), is an observational prospective study of patients admitted with acute HF in 14 hospitals in the Netherlands between September 2009 and December 2013."}
relationship: coho:hasCohort coho:COHO_0001602 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8712846/fullTextXML", comment="Of the nine case collections, seven were primarily focused on HF while two identified HF cases from an at‐risk population (COGEN and LURIC)."}
property_value: coho:numberOfCases "68157" xsd:integer {IAO:0000116="HF cases and controls of European ancestry across the 51 member cohorts (2021 design paper)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8712846/fullTextXML", comment="In aggregate, the 51 HERMES cohorts comprise 68 157 HF cases and 949 888 controls of European ancestry with array‐based genotyping (Supporting Information, Table S1 )."}
property_value: coho:numberOfControls "949888" xsd:integer {IAO:0000116="HF cases and controls of European ancestry across the 51 member cohorts (2021 design paper)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8712846/fullTextXML", comment="In aggregate, the 51 HERMES cohorts comprise 68 157 HF cases and 949 888 controls of European ancestry with array‐based genotyping (Supporting Information, Table S1 )."}
property_value: IAO:0000112 "GCST90827692" xsd:string {dcterms:title="Body Mass Index, Clinical Outcomes, and Mortality in Heart Failure: A Mendelian Randomization Study.", xref="PMID:42017882", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13211948/fullTextXML", comment="Twenty-two cohorts participating in the Heart Failure Molecular Epidemiology for Therapeutic Targets (HERMES) Consortium, comprising 50,636 individuals with established HF of European ancestry, were included in the genetic study (Supplemental Table 2)."}

