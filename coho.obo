[Instance]
id: coho:COHO_0001838
name: Healthy Aging Longitudinal Study in Taiwan
def: "A population-based longitudinal study of ageing, established and funded by the National Health Research Institutes in Taiwan, which in 2009–2013 enrolled community-dwelling adults aged 55 and above, systematically sampled from household registries around a regional hospital in each of seven areas in northern, central, southern and eastern Taiwan, and follows them with home interviews and hospital-based clinical examinations with blood and urine collection every five years and annual telephone contacts, to study physical functioning, chronic and cardiovascular disease, neuropsychiatric health, and genetic and environmental factors in frailty and successful ageing." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:28369534"}
synonym: "HALST" RELATED OMO:0003000 []
synonym: "healthy aging longitudinal study in Taiwan" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Asia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Taiwan {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837206/fullTextXML", comment="The HALST is designed as a longitudinal study recruiting community-dwellers aged 55 and above in seven selected areas in Taiwan: two in the north (Shilin District and Yangmei Township), two in the central region (Miaoli City and Changhua City), two in the south (Puzi Township and Lingya District) and one in the east (Hualien)."}
property_value: coho:numberOfParticipants "5664" xsd:integer {IAO:0000116="community-dwellers aged 55 or above enrolled in the first-wave survey, 2009-2013", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837206/fullTextXML", comment="In the first-wave survey (2009–13), we enrolled 5664 community-dwellers aged 55 or above."}
property_value: IAO:0000112 "PMID:27495061" xsd:string {dcterms:title="Association of depression and psychotropic medication on cardiac-related outcomes in a nationwide community-dwelling elderly population in Taiwan.", xref="PMID:27495061", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4979815/fullTextXML", comment="In this study, we investigated the association of depression and psychotropic medication and mental illness, individually, with cardiovascular disease in an elderly Asian study population from the Healthy Aging Longitudinal Study in Taiwan (HALST), a cross-sectional community-dwelling cohort of older adults in Taiwan."}

[Instance]
id: coho:COHO_0001839
name: Heredity and Phenotype Intervention Heart Study
def: "A study of relatively healthy adults, aged 20 or over and from large families, of the Old Order Amish of Lancaster County, Pennsylvania, initiated in 2002 to measure cardiovascular responses to four short-term interventions (a cold pressor stress test, a high-salt diet, a high-fat challenge and aspirin therapy) and to identify the genetic and environmental determinants of these responses." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.nature.com/articles/s42003-022-03291-2", IAO:0000119="PMID:18440328"}
