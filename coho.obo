synonym: "OMEGAROP" RELATED OMO:0003000 []
synonym: "OmegaROP study" RELATED []
synonym: "Study of the Implication of Omega-3 Polyunsaturated Fatty Acids in Retinopathy of Prematurity in Newborns" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/France {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6538605/fullTextXML", comment="From July 31st, 2015, to January 31st, 2018, all preterm infants born before 29 weeks GA and hospitalized in the neonatal intensive care unit of the Dijon University Hospital, Dijon, France, were included in the study."}
property_value: coho:numberOfParticipants "58" xsd:integer {IAO:0000116="preterm infants born before 29 weeks of gestational age included (2018)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6538605/fullTextXML", comment="Fifty-eight preterm infants born before 29 weeks GA were included. Six infants died and the mortality rate was 11.5%. Blood samples were obtained from 52 infants at a median time of 12 h and a maximum time of 48 h after birth."}
property_value: IAO:0000112 "MTBLS4219" xsd:string {dcterms:title="Modification of erythrocyte membrane phospholipid composition in preterm newborns with retinopathy of prematurity: The omegaROP study.", xref="PMID:36158214", xref="https://www.ebi.ac.uk/metabolights/ws/studies/public/study/MTBLS4219", comment="In the OmegaROP prospective cohort study, we showed that preterm infants who will develop ROP accumulate the n-6 PUFA arachidonic acid (ARA) at the expense of the n-3 PUFA docosahexaenoic acid (DHA) in erythrocytes with advancing gestational age (GA)."}

[Instance]
id: coho:COHO_0002741
name: RA-MAP Consortium
def: "A UK industry-academic precision medicine partnership, funded by the Medical Research Council and the Association of the British Pharmaceutical Industry, that recruited a cohort of patients with early rheumatoid arthritis and a cohort of healthy people receiving the hepatitis B vaccine, followed for up to 18 months with deep clinical and multi-omic phenotyping, to find predictors of disease outcome and treatment response." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35534493", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09"}
