property_value: coho:numberOfParticipants "100" xsd:integer {IAO:0000116="LatDiane participants in the gastrointestinal-symptom and DKD progression substudy", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10604159/fullTextXML", comment="We performed a cross-sectional study with 100 T1D patients; 27 of them had progressive DKD, defined as an estimated glomerular filtration rate (eGFR) decline ≥3 mL/min/year or increased albuminuria stage, over a mean follow-up time of 5.89 ± 1.73 years."}
property_value: IAO:0000112 "PGS004896" xsd:string {dcterms:title="Albuminuria-Related Genetic Biomarkers: Replication and Predictive Evaluation in Individuals with and without Diabetes from the UK Biobank.", xref="PMID:37446387"}
