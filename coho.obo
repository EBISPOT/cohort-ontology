id: coho:COHO_0002429
name: Tulsa 1000 study
def: "A naturalistic, longitudinal observational study run by the Laureate Institute for Brain Research in Tulsa, Oklahoma, United States, that recruited healthy controls and treatment-seeking individuals with mood, anxiety, substance use and eating disorders from the Tulsa metropolitan area from 2015 to 2018 and assessed them at levels from self-report, behaviour and physiology to neuroimaging, cells, molecules and genes, following the NIMH Research Domain Criteria, to predict symptom severity, treatment outcome and prognosis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29371263"}
subset: coho1:PGS_subset
synonym: "T-1000" RELATED OMO:0003000 []
synonym: "T1000" RELATED OMO:0003000 []
synonym: "Tulsa 1000" RELATED []
synonym: "Tulsa-1000 study" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5786129/fullTextXML", comment="The study recruitment aims to generate a representative sample of a local Midwestern community in the USA"}
property_value: coho:numberOfParticipants "1050" xsd:integer {IAO:0000116="individuals recruited 2015-2018 (exploratory sample of the first 500 and confirmatory sample of the latter 550)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10281720/fullTextXML", comment="The T1000 study included a community-based sample of 1050 individuals recruited through radio, electronic media, treatment centre referrals and word of mouth."}
property_value: IAO:0000112 "PGS004608" xsd:string {dcterms:title="Transdiagnostic behavioral and genetic contributors to repetitive negative thinking: A machine learning approach.", xref="PMID:37178517"}
property_value: IAO:0000112 "PMID:37178517" xsd:string {dcterms:title="Transdiagnostic behavioral and genetic contributors to repetitive negative thinking: A machine learning approach.", xref="PMID:37178517", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37178517+AND+SRC%3AMED&format=json&resultType=core", comment="We employed the Tulsa-1000 study, a large database of deeply phenotyped individuals recruited between 2015 and 2018."}

[Instance]
id: coho:COHO_0002430
name: Type 2 Diabetes Global Genomics Initiative
def: "An international initiative that assembled genome-wide association studies of type 2 diabetes from studies in six ancestry groups (African American, East Asian, European, Hispanic, South African and South Asian), among them the DIAMANTE Consortium and the Million Veteran Program, and meta-analysed them to characterise the genetic contribution to type 2 diabetes and its aetiological heterogeneity across populations." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38374256"}
subset: coho1:PGS_subset
synonym: "T2D-GGI" RELATED OMO:0003000 []
synonym: "T2DGGI" RELATED OMO:0003000 []
instance_of: coho:COHO_0000001 ! cohort aggregation
