property_value: IAO:0000112 "GCST90020165" xsd:string {dcterms:title="A genome-wide association study of the longitudinal course of executive functions.", xref="PMID:34247186", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8272719/fullTextXML", comment="In the transdiagnostic PsyCourse Study, comprising patients of the affective-to-psychotic spectrum and controls, we investigated the genetic basis of the time course of two core executive subfunctions: set-shifting (Trail Making Test, part B (TMT-B)) and updating (Verbal Digit Span backwards) in 1338 genotyped individuals."}

[Instance]
id: coho:COHO_0001031
name: Queensland Study of Melanoma: Environmental and Genetic Associations
def: "A population-based study of cutaneous melanoma in Queensland, Australia, that brings together four earlier population-based studies of melanoma patients conducted in 1987–1995: the Queensland Familial Melanoma Project of adult cases and their families, including twins, and studies of melanoma in children, in adolescents and in men over 50. Their participants and some relatives were re-contacted in 2002–2005 for telephone interviews on sun exposure and phenotype and for blood samples, to investigate genetic and environmental factors, and their interaction, in the aetiology of melanoma." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:18361720"}
