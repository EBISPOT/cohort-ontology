property_value: IAO:0000112 "PMID:42473435" xsd:string {dcterms:title="The prospective incidence of treatment-resistant schizophrenia: analysis of the CATIE trial using the TRRIP consensus.", xref="PMID:42473435", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42473435+AND+SRC%3AMED&format=json&resultType=core", comment="We applied TRRIP criteria to 1334 participants with chronic schizophrenia enrolled in the Clinical Antipsychotic Trials of Intervention Effectiveness (CATIE) study."}

[Instance]
id: coho:COHO_0001573
name: Comorbidity and Trauma Study
def: "A retrospective case–control study of genetic and environmental contributions to heroin dependence, funded by the US National Institute on Drug Abuse in 2003 and run by Washington University, the Queensland Institute of Medical Research and the National Drug and Alcohol Research Centre (University of New South Wales), which from 2004 recruited opioid-dependent adults from opioid substitution (maintenance) treatment clinics in the greater Sydney area, Australia, and neighbourhood controls with little or no lifetime opioid use from socially disadvantaged areas served by the same clinics. Participants gave blood for DNA and completed a psychiatric diagnostic interview (SSAGA-OZ) with added assessments of childhood trauma, family history and borderline personality disorder." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v1.p1", IAO:0000119="PMID:26239289", IAO:0000119="PMID:23245376"}
synonym: "CATS" RELATED OMO:0003000 []
