property_value: coho:numberOfParticipants "10366" xsd:integer {IAO:0000116="women enrolled in total (9704 white women 1986-1988 plus 662 African-American women at Year 10), 1998", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5390547/fullTextXML", comment="Subsequently, at the Year 10 SOF examination conducted between 1997 and 1998, 662 African-American women were enrolled in the study increasing the total cohort enrollment to 10,366 women [11]."}
property_value: IAO:0000112 "GCST90281365" xsd:string {dcterms:title="The identification of distinct protective and susceptibility mechanisms for hip osteoarthritis: findings from a genome-wide association study meta-analysis of minimum joint space width and Mendelian randomisation cluster analyses.", xref="PMID:37619450", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10470292/fullTextXML", comment="GWAS cohorts comprised the UKB, The Rotterdam Study (RS) I&II, Osteoporotic Fractures in Men (MrOS) Study and Study of Osteoporotic Fractures (SOF). mJSW was measured automatically in UKB and manually in RS, MrOS and SOF (see Supplementary Methods)."}

