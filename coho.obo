relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0205-x/MediaObjects/41588_2018_205_MOESM3_ESM.xlsx", comment="This family study in which probands were ascertained based on blood pressure, and family members were collected regardless of case or control status. | U.K Oxford cohort"}
relationship: coho:isCohortOf coho:COHO_0000711
property_value: coho:numberOfParticipants "1425" xsd:integer {IAO:0000116="members of 248 families recruited in Oxford, 1993-1997", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6753112/fullTextXML", comment="Between 1993 and 1997, we recruited 248 families with 1425 members from Oxford for quantitative genetic study of hypertension and other cardiovascular risk factors3."}
property_value: IAO:0000112 "PMID:20847302" xsd:string {dcterms:title="Coronary artery disease-related genetic variant on chromosome 10q11 is associated with carotid intima-media thickness and atherosclerosis.", xref="PMID:20847302", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20847302+AND+SRC%3AMED&format=json&resultType=core", comment="We genotyped 3 population cohorts (Bruneck [age range, 45 to 94 years; 50.0% men; n=738], Health2000 [age range, 46 to 76 years; 55.4% men; n=1237], and essential hypertension in families collected in the region of Oxford [HTO] [age range, 19 to 88 years; 47.9% men; n=770]) for single-nucleotide polymorphism rs501120 at the 10q11.21 locus and conducted a meta-analysis in these cohorts to ascertain a relationship between the polymorphism and carotid IMT."}

