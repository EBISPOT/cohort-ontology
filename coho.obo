property_value: IAO:0000112 "PMID:20431428" xsd:string {dcterms:title="Replication of an association of a common variant in the Reelin gene (RELN) with schizophrenia in Ashkenazi Jewish women.", xref="PMID:20431428", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC2901865/", comment="Our analysis sample of 721 AJ SZ probands and 720 AJ controls was collected by the Johns Hopkins Epidemiology-Genetics Program in Psychiatry (http://www.hopkinsmedicine.org/epigen/), and has been described in detail elsewhere (Fallin et al. 2003)."}

[Instance]
id: coho:COHO_0001697
name: EpiHealth
def: "A Swedish population-based cohort study of men and women aged 45 to 75, recruited from 2011 through test centres in Uppsala and Malmö, who answered an internet-based lifestyle questionnaire and gave blood samples and physiological measurements at the test centre, and who are followed for disease outcomes through nationwide medical registers, set up to study interactions between genes and lifestyle in common diseases." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38965493", IAO:0000119="PMID:23435790"}
