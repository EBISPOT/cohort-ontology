property_value: coho:numberOfParticipants "256" xsd:integer {IAO:0000116="men with prostate cancer enrolled in the URWCI study as counted in the 2022 ACE-inhibitor analysis (the only count stated; possibly the analysed subset)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC8986577/", comment="Prostate cancer patients undergoing potentially-curative radiotherapy were enrolled onto two multi-center observational studies, URWCI (N=256) and REQUITE (N=1,437)."}
property_value: IAO:0000112 "PMID:40029246" xsd:string {dcterms:title="A Polygenic Risk Score for Late Bladder Toxicity Following Radiotherapy for Non-Metastatic Prostate Cancer.", xref="PMID:40029246", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC12048210/", comment="We show that it is associated with susceptibility to development of hematuria and other cystitis symptoms in the prospective, multicenter REQUITE and URWCI studies whose primary aim was to validate predictive models and biomarkers of late toxicity in patients treated with curative radiotherapy."}

