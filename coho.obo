property_value: IAO:0000112 "GCST90708782" xsd:string {dcterms:title="Genetic associations with psychosis and affective disturbance in Alzheimer's disease.", xref="PMID:38784964", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11114588/fullTextXML", comment="testing, and in some cases neuropathologic assessment, conducted during participation in one of the following six source programs (see Supplemental Material for details for each source program), as previously described 15 : the Fundació ACE Barcelona Alzheimer Treatment and Research Center (ACE/GR@ACE), a Consortium of National Institute on Aging Alzheimer Disease Centers (ADC), Eli Lilly and Company (LILLY), the Norwegian, Exeter and King's College Consortium for Genetics of Neuropsychiatric Symptoms in Dementia (NEXGENS), the National Institute on Aging's Late Onset Alzheimer's Disease Family Study (NIA‐LOAD), and the University of Pittsburgh Alzheimer Disease Research Center (PITT ADRC)."}

[Instance]
id: coho:COHO_0001108
name: NeuroGenetics Research Consortium
def: "A case-control sample of people with Parkinson's disease, diagnosed by modified UK Brain Bank criteria, and neurologically healthy controls (community volunteers and patients' spouses), recruited by the NeuroGenetics Research Consortium at affiliated neurology and movement disorder clinics in Oregon, Washington, Georgia and New York, United States, with uniform, standardised methods for diagnosis, subject selection, data collection and DNA preparation, for genetic and gene-environment studies of Parkinson's disease, and genotyped genome-wide." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:32566740", IAO:0000119="PMID:20711177"}
