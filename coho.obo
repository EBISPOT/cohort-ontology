property_value: coho:numberOfCases "554" xsd:integer {IAO:0000116="Participants in the original May2002–March2004 hospital case-control recruitment; the own methods explicitly report participation as554/556 eligible cases and572/579 invited control visitors. These are the reported numerators, not calculated values.", xref="https://link.springer.com/article/10.1007/s10549-007-9773-7", comment="Cases were all new incident breast cancer patients histologically diagnosed at the National Cancer Institute in Bangkok and at the hospital in Khon Kaen province of North Eastern of Thailand during the period of May 2002 to March 2004 [21], with a participation rate of 99.6% (554/556)."}
