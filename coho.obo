[Instance]
id: coho:COHO_0000386
name: Rhineland Study
def: "An ongoing population-based cohort of people aged 30 or above living in two geographically defined areas of Bonn, Germany, invited in random order by the German Centre for Neurodegenerative Diseases (DZNE) for deep phenotyping, imaging and omics studies of health and ageing." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13135507/fullTextXML", IAO:0000119="https://www.rheinland-studie.de/en/the-study/background/"}
