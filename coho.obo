property_value: IAO:0000112 "PGS001774" xsd:string {dcterms:title="Prediction of Parkinson's Disease Risk Based on Genetic Profile and Established Risk Factors.", xref="PMID:34440451"}
property_value: IAO:0000112 "PMID:25064009" xsd:string {dcterms:title="Large-scale meta-analysis of genome-wide association data identifies six new risk loci for Parkinson's disease.", xref="PMID:25064009", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4146673/fullTextXML", comment="For each locus identified as genome-wide significant in the discovery phase, we reran cohort level analyses in a subset of 7 datasets with the largest counts of cases (due to primary data availability at the participant level, only IPDGC-NIA, IPDGC-NL, IPDGC-GE, 23&Me, PROGENI-GenePD, NGRC and HIHG were included) testing all SNPs within +/− 1MB from the 26 genome-wide significant SNPs in Table 1, while adjusting for the SNP with the most extreme p-value per locus."}

[Instance]
id: coho:COHO_0002251
name: Pharmacogenetics of Acute Coronary Syndrome
def: "A UK multicentre prospective observational cohort of patients hospitalised with a non-ST elevation acute coronary syndrome (non-ST elevation myocardial infarction or unstable angina), run at 16 hospital sites between 2008 and 2013, whose participants were followed up at one and 12 months, and annually thereafter while the study ran, for further cardiovascular events; its medication, adherence, plasma drug-level and genome-wide genotype data are used in pharmacogenetic studies of secondary-prevention cardiovascular drugs." [] {IAO:0000119="PMID:28391887", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31656041", IAO:0000119="PMID:33234119", IAO:0000119="PMID:30005242"}
synonym: "PhACS" RELATED OMO:0003000 []
synonym: "Pharmacogenetics of Acute Coronary Syndrome study" RELATED []
