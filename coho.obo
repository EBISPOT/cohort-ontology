property_value: coho:numberOfParticipants "7687" xsd:integer {IAO:0000116="subjects who completed enrolment (all three groups), 2009", xref="PMID:21800090", comment="Of this population, 7687 subjects completed enrollment, of which 865 were enrolled as “survey-only” participants, 718 were enrolled in the Framingham-only group, and 6104 were enrolled in the full study group (see Fig. 1)."}
