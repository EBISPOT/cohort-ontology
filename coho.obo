relationship: coho:has_data_collection_location http://dbpedia.org/resource/China {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11101236/fullTextXML", comment="In the 1980s, a Nutritional Intervention Trial (NIT) was initiated in Linxian, Henan province of China."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Eastern_Asia
property_value: coho:numberOfParticipants "29584" xsd:integer {IAO:0000116="adults randomised to supplement combinations or placebo (1986)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8866236/fullTextXML", comment="Finally, a total of 29,584 subjects were randomly assigned to one of eight intervention groups which received daily vitamin/mineral supplement combinations or placebo according to a one-half replicate of a 24 fractional factorial design."}
property_value: IAO:0000112 "GCST90841197" xsd:string {dcterms:title="Genome wide association analysis and association of genetic risk and lifestyle with upper gastrointestinal cancer among an endoscopy-screened cohort in China.", xref="PMID:41963194", xref="https://ars.els-cdn.com/content/image/1-s2.0-S2095927326003270-mmc1.docx", comment="Briefly, participants were drawn from multiple established studies, including the Shanxi Upper Gastrointestinal Cancer Genetics Project and the Linxian Nutrition Intervention Trial, as well as additional prospective cohort studies incorporating in the validation phase."}

[Instance]
id: coho:COHO_0001215
name: Neuro-Ophthalmology Research at Fundació ACE
def: "A cohort of individuals evaluated for cognitive decline at Ace Alzheimer Center Barcelona (Fundació ACE), Spain, recruited from its Memory Clinic, Open House Initiative, the FACEHBI study and the BIOFACE project. Founded in 2014, it studies retinal biomarkers via optical coherence tomography and their relationship to neurodegenerative disorders." [] {dcterms:contributor="Claude Sonnet 5 (Anthropic), 2026-09", IAO:0000119="PMID:38365752"}
subset: coho1:GWAS_subset
synonym: "Neuro-Ophthalmology Research at Fundació ACE Cohort" RELATED []
