[Instance]
id: coho:COHO_0001117
name: Sickle Cell Genome Project
def: "A cohort of individuals with sickle cell disease recruited from Baylor College of Medicine and from the Sickle Cell Clinical Research and Intervention Program (SCCRIP) cohort at St. Jude Children's Research Hospital, whose whole genomes were sequenced to define genotype-phenotype relations in sickle cell disease." [] {IAO:0000119="PMID:34283174", dcterms:contributor="Claude Sonnet 5 (Anthropic), 2026-09"}
