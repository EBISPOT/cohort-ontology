id: coho:COHO_0001829
name: Brain Genomics Superstruct Project
def: "A neuroimaging genetics study of clinically normal participants, mostly young adults aged 18 to 35, recruited from the Boston community, United States, in 2008–2012 through ongoing research studies at Harvard University and Massachusetts General Hospital that shared a common acquisition protocol, who underwent structural and functional magnetic resonance imaging, gave saliva for DNA and completed demographic, health, behavioural, cognitive and personality assessments, to link individual differences in brain structure and function to behaviour and genetic variation." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:26175908"}
synonym: "GSP" RELATED OMO:0003000 []
synonym: "Harvard/MGH Brain Genomics Superstruct Project" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4493828/fullTextXML", comment="Between 2008 and 2012 young adults (ages 18 to 35) with normal or corrected-to-normal vision were recruited from the Boston community to participate in the GSP."}
property_value: coho:numberOfParticipants "3000" xsd:integer {IAO:0000116="participants in the broader GSP control sample (stated as a lower bound, 'over 3,000')", xref="PMID:26175908", comment="The broader GSP control sample, which has over 3,000 participants, includes individuals over the age of 35 and also several hundred datasets acquired using a 32-channel head coil."}
property_value: IAO:0000112 "PMID:27754483" xsd:string {dcterms:title="Association between polygenic risk for schizophrenia, neurocognition and social cognition across development.", xref="PMID:27754483", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27754483+AND+SRC%3AMED&format=json&resultType=core", comment="We then looked at the association between schizophrenia polygenic risk and emotion identification speed in the Harvard/MGH Brain Genomics Superstruct Project sample (695 participants ages 18-35 years), where we replicated the association between schizophrenia polygenic risk and emotion identification speed."}

