relationship: coho:hasCohort coho:COHO_0000790 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7033893/fullTextXML", comment="Through its participation in the eMERGE consortium,15, 16 the NUgene biobank selected 900 participants for WGS."}
relationship: coho:hasCohort coho:COHO_0000873 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10191288/fullTextXML", comment="(b) The structured data-driven phenotyping algorithm was used in two eMERGE sites (Marshfield, Mount Sinai)."}
