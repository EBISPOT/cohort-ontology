[Instance]
id: coho:COHO_0000369
name: Barcelona-1
def: "A longitudinal observational memory-clinic cohort of about 300 people at baseline, diagnosed with Alzheimer disease dementia, other dementias, mild cognitive impairment or subjective memory complaints, assembled at the Memory Disorders Unit of the University Hospital Mútua de Terrassa near Barcelona, Spain, with cerebrospinal fluid and amyloid PET biomarkers collected for selected participants." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35871346"}
subset: coho1:GWAS_subset
synonym: "Barcelona-1, MútuaTerrassa University Hospital" RELATED []
