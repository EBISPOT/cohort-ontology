property_value: IAO:0000112 "GCST90270122" xsd:string {dcterms:title="Genetic Variants Associated with Supernormal Coronary Arteries.", xref="PMID:35793981", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10164599/fullTextXML", comment="All patients who visited the Division of Cardiology at a university hospital, for a health check-up or due to chest symptoms from January 2001 to August 2009 were included in the CGC cohort."}

[Instance]
id: coho:COHO_0001300
name: Cancer Genetic Markers of Susceptibility
def: "A three-year initiative of the US National Cancer Institute, begun in 2006, that ran multi-stage genome-wide association studies of prostate and breast cancer in case-control sets drawn from existing studies (for prostate cancer, men from the Prostate, Lung, Colorectal, and Ovarian Cancer Screening Trial, the American Cancer Society Cancer Prevention Study II, the Alpha-Tocopherol, Beta-Carotene Cancer Prevention Study and the French Prostate Case-Control Study; for breast cancer, postmenopausal women from the Nurses' Health Study, with replication in further cohorts), and shared its genotype data and results with the research community." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22271044", IAO:0000119="PMID:17529973", IAO:0000119="https://www.cancernetwork.com/view/cgems-id-genetic-risks-two-cancers", IAO:0000119="https://pmc.ncbi.nlm.nih.gov/articles/PMC2291937/"}
