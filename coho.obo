relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11875162/fullTextXML", comment="The Viva La Familia study recruited n = 1,030 children from 319 families between November 2000 and August 2004 from a Hispanic population in Houston, Texas, to assess genetic and environmental factors affecting obesity and its related comorbidities.31 A total of n = 656 participants were included in GWAS analyses (mean age = 10.7 for girls and mean age = 11.2 for boys)."}
property_value: coho:numberOfParticipants "1030" xsd:integer {IAO:0000116="children (probands and siblings) in 319 families", xref="PMID:16960181", comment="The Viva la Familia cohort consisted of 1030 children from 319 families selected based on an overweight proband between the ages of 4 and 19 y."}
property_value: IAO:0000112 "GCST90502757" xsd:string {dcterms:title="Trans-ancestry genome-wide association study of childhood body mass index identifies novel loci and age-specific effects.", xref="PMID:39885687", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11875162/fullTextXML", comment="The Viva La Familia study recruited n = 1,030 children from 319 families between November 2000 and August 2004 from a Hispanic population in Houston, Texas, to assess genetic and environmental factors affecting obesity and its related comorbidities.31 A total of n = 656 participants were included in GWAS analyses (mean age = 10.7 for girls and mean age = 11.2 for boys)."}

[Instance]
id: coho:COHO_0001432
name: Western Australian Melanoma Health Study
def: "A population-based collection of adult melanoma cases resident in Western Australia and diagnosed between January 2006 and September 2009, identified through the Western Australian Cancer Registry and invited by mail with their diagnosing doctor's consent, with registry pathology data, a telephone questionnaire on melanoma risk factors such as sun exposure and skin type, and blood samples for DNA, RNA and serum, established to investigate the genetic epidemiology of melanoma." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:21474410", IAO:0000119="PMID:26237428"}
subset: coho1:GWAS_subset
