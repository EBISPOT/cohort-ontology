property_value: IAO:0000112 "GCST90026609" xsd:string {dcterms:title="Bevacizumab-induced hypertension and proteinuria: a genome-wide study of more than 1000 patients.", xref="PMID:34616010", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34616010+AND+SRC%3AMED&format=json&resultType=core", comment="A genome-wide association study (GWAS) meta-analysis was performed in 1039 bevacizumab-treated patients of European ancestry in four clinical trials (CALGB 40502, 40503, 80303, 90401)."}

[Instance]
id: coho:COHO_0001449
name: Asklepios Study
def: "A longitudinal population study by investigators of Ghent University, Belgium, of men and women aged about 35 to 55 and free from overt cardiovascular disease, randomly sampled from the population lists of the twinned communities of Erpe-Mere and Nieuwerkerken (partners and relatives living there were also eligible), examined at a single local study site in 2002–2004 and again in 2011–2016, to study the interplay between ageing, cardiovascular haemodynamics and inflammation in preclinical cardiovascular disease." [] {IAO:0000119="PMID:29695838", IAO:0000119="PMID:17446795", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31357728"}
