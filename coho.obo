property_value: IAO:0000112 "PMID:24123842" xsd:string {dcterms:title="Association study of 83 candidate genes for bipolar disorder in chromosome 6q selected using an evidence-based prioritization algorithm.", xref="PMID:24123842", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC12888025/", comment="Trios, nuclear families—defined as two parents and one or more children, of which at least one child was affected—and phenotypically-discordant sibling pairs were selected from the Portuguese Island Collection (PIC) and the NIMH Genetics Initiative Bipolar Pedigrees on the basis of a proband meeting criteria for bipolar I disorder (BPI), bipolar II disorder (BPII), or schizoaffective disorder, bipolar type."}

[Instance]
id: coho:COHO_0002258
name: Parkinsonism: Incidence, Cognition and Non-motor heterogeneity in Cambridgeshire
def: "A community-based cohort of people newly diagnosed with Parkinson's disease or other parkinsonism in Cambridgeshire, United Kingdom, recruited between 2006 and 2013: incident cases ascertained through general practitioners and hospital specialists between April 2008 and January 2010, in a second incidence study of the same base population as CamPaIGN, supplemented by other newly diagnosed (inception) cases. Participants are followed up every 18 months with motor, cognitive and neuropsychiatric assessments to study the natural history of Parkinson's disease; the study was sponsored by the University of Cambridge and Cambridge University Hospitals NHS Trust." [] {IAO:0000119="PMID:26800710", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:27717005", IAO:0000119="PMID:33958783", IAO:0000119="PMID:41964342", IAO:0000119="PMID:32303560"}
