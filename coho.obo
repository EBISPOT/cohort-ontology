property_value: IAO:0000112 "PMID:39282516" xsd:string {dcterms:title="Dataset: A consolidated and harmonised Verbal Autopsy dataset from Health and Demographic Surveillance Sites in South Africa.", xref="PMID:39282516", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11399759/fullTextXML", comment="The dataset harmonises and links routinely collected VA data from the South African Population Research Infrastructure Network (SAPRIN)."}
property_value: seeAlso http://saprin.mrc.ac.za/

[Instance]
id: coho:COHO_0002698
name: Lifecourse biological pathways underlying social differences in healthy aging
def: "A research consortium funded by the European Commission under Horizon 2020 that pooled and harmonised data from existing adult and child cohort studies in Europe, the USA and Australia, including CoLaus, SKIPOGH, Constances and the Melbourne Collaborative Cohort Study, with biomarker and omics sub-studies, to investigate the biological pathways through which socioeconomic position affects healthy ageing over the life course." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="http://www.lifepathproject.eu/", IAO:0000119="PMID:28557991", IAO:0000119="PMID:32478023"}
