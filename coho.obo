[Instance]
id: coho:COHO_0002140
name: Newfoundland Osteoarthritis Study
def: "A study initiated in 2011 that consecutively recruited, until 2017, patients undergoing total knee or hip replacement, largely for osteoarthritis, at St. Clare's Mercy Hospital and the Health Science Centre General Hospital in St. John's, Newfoundland and Labrador, Canada. It collects blood before surgery and follows the patients up after it, to identify genetic, epigenetic and biochemical markers for osteoarthritis." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:29494586", IAO:0000119="PMID:40608839", IAO:0000119="PMID:31743460"}
synonym: "NFOAS" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Canada {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5849325/fullTextXML", comment="The NFOAS recruited OA patients who underwent a total knee replacement surgery due to primary OA between November 2011 and December 2013 at the St. Clare’s Mercy Hospital and Health Science Centre General Hospital in St. John’s, the capital city of Newfoundland and Labrador (NL), Canada."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
property_value: coho:numberOfParticipants "1086" xsd:integer {IAO:0000116="patients undergoing total knee or hip arthroplasty recruited November 2011 to February 2017 (2011-2017)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12225861/fullTextXML", comment="The study participants were derived from the Newfoundland Osteoarthritis Study (NFOAS) which recruited 1086 patients aged at least 20 years old who underwent total knee or hip arthroplasty largely due to osteoarthritis (OA) with a small number of patients due to other joint diseases between 30/11/2011 and 05/02/2017 in St. Clare’s Mercy Hospital and Health Science Centre General Hospital in St. John’s, Newfoundland and Labrador (NL), Canada [10]."}
property_value: IAO:0000112 "PMID:29494586" xsd:string {dcterms:title="An evolutionary learning and network approach to identifying key metabolites for osteoarthritis.", xref="PMID:29494586", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5849325/fullTextXML", comment="Applied to the Newfoundland Osteoarthritis Study (NFOAS) dataset, our methodology was able to identify nine key metabolites including some known osteoarthritis-associated metabolites and some novel metabolic markers that have never been reported before."}

