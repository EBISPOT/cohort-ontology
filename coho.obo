property_value: IAO:0000112 "GCST90292537" xsd:string {dcterms:title="Automatic landmarking identifies new loci associated with face morphology and implicates Neanderthal introgression in human nasal shape.", xref="PMID:37156940", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10167347/fullTextXML", comment="The 6486 individuals examined here are part of the CANDELA cohort, collected in five Latin American countries21."}

[Instance]
id: coho:COHO_0000520
name: Mexico City Prospective Study
def: "A prospective cohort of more than 150,000 adults aged 35 and over, recruited in 1998-2004 from the contiguous urban districts of Coyoacán and Iztapalapa in Mexico City with the University of Oxford, and followed to investigate known and new risk factors for mortality in people of Mexican descent; its participants have exome and genome-wide genetic data." [] {IAO:0000119="PMID:39948438", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:37308787"}
