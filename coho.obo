relationship: coho:has_data_collection_location http://dbpedia.org/resource/Northern_America
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States {xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7444276/unicode", comment="Any individual living in the United States with a professional diagnosis (by a physician, psychologist, or therapist) of ASD plus their parents and an unaffected sibling are eligible to participate in SPARK."}
property_value: IAO:0000112 "GCST90709872" xsd:string {dcterms:title="Human and bacterial genetic variation shape oral microbiomes and health.", xref="PMID:41606319", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12979206/fullTextXML", comment="To create a dataset suitable for exploring variation in the oral microbiome and the way it is shaped by human genetic variation, we analysed DNA sequencing reads previously generated from whole-genome sequencing (WGS) of saliva samples from 12,519 participants in the Simons Foundation Powering Autism Research (SPARK) cohort25 (Fig. 1a), building on previous work26,27."}

[Instance]
id: coho:COHO_0000397
name: Chronic Renal Insufficiency Cohort Study
def: "A multicentre prospective observational cohort of 5,499 racially and ethnically diverse adults with chronic kidney disease, recruited at seven clinical centres in the United States in two phases, 2003–2008 (adults aged 21 to 74 with an estimated glomerular filtration rate of 20–70 mL/min/1.73 m²) and 2013–2015 (adults aged 45 to 79 with more preserved kidney function, eGFR 45–70), and followed with annual clinic visits, six-monthly telephone contacts and annual blood and urine collection to examine risk factors for the progression of chronic kidney disease and cardiovascular disease." [] {IAO:0000119="PMID:12819321", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:35175342", IAO:0000119="PMID:42318085"}
subset: coho1:GWAS_subset
