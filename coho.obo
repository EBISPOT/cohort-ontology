relationship: coho:has_data_collection_location http://dbpedia.org/resource/Spain {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870444/fullTextXML", comment="Consecutive individuals evaluated due to cognitive decline at Ace Alzheimer Center Barcelona between September 2014 and March 2019 with a diagnosis of CH, MCI, or dementia, and who had available GWAS data from the GR@ACE study [18] were included in the present analysis."}
property_value: coho:numberOfParticipants "3977" xsd:integer {IAO:0000116="Ace cases with clinical information and OCT measurements reviewed for NORFACE analysis", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11568571/fullTextXML", comment="Initially, 3,977 cases from Ace with available clinical information and OCT measurements were reviewed."}
property_value: IAO:0000112 "GCST90554824" xsd:string {dcterms:title="Genome-wide association study and polygenic risk scores of retinal thickness across the cognitive continuum: data from the NORFACE cohort.", xref="PMID:38365752", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870444/fullTextXML", comment="The study population comprised 3170 participants from the Neuro-Ophthalmology Research at Fundació ACE (NORFACE) cohort, which was founded in 2014 to search for retinal biomarkers of AD and examine the relationships between retinal changes and different types of neurodegenerative disorders [12]."}

[Instance]
id: coho:COHO_0001216
name: New York Cancer Project
def: "A prospective cohort and biorepository of racially and ethnically diverse adults aged 30 or older living in the New York tri-state area, enrolled from January 2000 to December 2002 by the Academic Medical Development Company (AMDeC) Foundation, a consortium of New York institutions, at medical centres, community hospitals and community health centres in all five boroughs of New York City and at New York Blood Center donor drives. Participants completed a baseline questionnaire and gave blood for DNA and plasma, to be followed by questionnaires and registry linkage for studies of cancer aetiology and of racial and ethnic disparities in cancer risk, prevention and outcomes." [] {IAO:0000119="PMID:15136663", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09"}
subset: coho1:GWAS_subset
synonym: "New York Control Population" RELATED []
