property_value: coho:numberOfParticipants "3971" xsd:integer {IAO:0000116="individual twins with data in the registry (2026)", xref="PMID:41913940", comment="The registry currently includes data from 3971 individual twins born between 1940 and 1999, as well as an associated biobank containing samples from 1586 participants."}
property_value: IAO:0000112 "GCST90642419" xsd:string {dcterms:title="Genetics of monozygotic twins reveals the impact of environmental sensitivity on psychiatric and neurodevelopmental phenotypes.", xref="PMID:40494901", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12367547/fullTextXML", comment="The Murcia Twin Registry is funded by the Spanish Ministerio de Ciencia, Innovación y Universidades (RTI2018-095185-B-I00), co-funded by the European Regional Development Fund."}
property_value: IAO:0000116 "The acronym MTR also denotes Minnesota Twin Family Registry (COHO:0002098); this term is Murcia Twin Registry." xsd:string

[Instance]
id: coho:COHO_0001107
name: Norwegian, Exeter and King's College Consortium for Genetics of Neuropsychiatric Symptoms in Dementia
def: "A collaboration of the University of Exeter, King's College London, Innlandet Hospital Trust, the University of Oslo and Stavanger University Hospital that undertakes secondary analysis of data on patients with Alzheimer's disease from cohort studies and patient registries, to study the genetics of neuropsychiatric symptoms such as psychosis in dementia. Its sources are the Norwegian registry of persons assessed for cognitive symptoms (NorCog) with the affiliated Progression of Alzheimer's Disease and Resource Use study, the REDIC-NH and Health and Memory Study nursing-home cohorts in Norway, AddNeuroMed, and hospital outpatient clinics in Italy and Greece." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:38784964"}
subset: coho1:GWAS_subset
synonym: "NEXGENS" RELATED OMO:0003000 []
