property_value: coho:numberOfParticipants "6127" xsd:integer {IAO:0000116="people with type 1 diabetes who participated at baseline, Dec 2010-Nov 2013", xref="https://europepmc.org/api/getPdf?pmcid=PMC5582633", comment="There was sufficient research nurse time for 78% (7593/9731) of all attending eligible patients to be invited and of these 80.7% (6127/7593) participated."}
property_value: IAO:0000112 "GCST90662913" xsd:string {dcterms:title="Genetics of C-Peptide and Age at Diagnosis in Type 1 Diabetes.", xref="PMID:39556808", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11755686/fullTextXML", comment="We performed a meta-GWAS of C-peptide that including four T1D studies: the Scottish Diabetes Research Network Type 1 Bioresource (SDRNT1BIO) (4,16), Diabetes Control and Complications Trial (DCCT) (17,18), Coronary Artery Calcification in T1D (CACTI) (19,20), and Wisconsin Epidemiologic Study of Diabetic Retinopathy (WESDR) (21)."}

[Instance]
id: coho:COHO_0001234
name: Shanxi Upper Gastrointestinal Cancer Genetics Project
def: "A case-control study of upper gastrointestinal cancers conducted from 1997 to 2007 by the Shanxi Cancer Hospital and Institute under contract with the US National Cancer Institute in Shanxi Province, China, in the high-risk western Taihang Mountain area, which enrolled adults newly diagnosed with oesophageal squamous cell carcinoma or gastric adenocarcinoma and treated surgically at the Shanxi Cancer Hospital, with neighbourhood controls matched on age and sex, plus a case-only component, and collected questionnaire data and blood to study genetic and environmental risk factors for these cancers." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:20729852", IAO:0000119="PMID:34022824", IAO:0000119="PMID:28680059", IAO:0000119="PMID:21846596"}
