relationship: coho:has_data_collection_location http://dbpedia.org/resource/Oceania
property_value: coho:numberOfParticipants "5762" xsd:integer {IAO:0000116="genotyped melanoma patients analysed for melanoma-specific survival (2022)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9446843/fullTextXML", comment="First, we conducted two GWAS of MSS in the MIA cohort (5762 patients with melanoma and 800 melanoma-specific deaths) and in UKB cohort (5220 melanoma patients and 241 melanoma-specific deaths)."}
property_value: IAO:0000112 "GCST90103971" xsd:string {dcterms:title="Multi-Trait Genetic Analysis Identifies Autoimmune Loci Associated with Cutaneous Melanoma.", xref="PMID:34813871", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34813871+AND+SRC%3AMED&format=json&resultType=core", comment="Of these loci, 55 were replicated (P < 0.05/74, Bonferroni-corrected P-value in two independent cutaneous melanoma replication cohorts from Melanoma Institute Australia and 23andMe, Inc."}

[Instance]
id: coho:COHO_0001104
name: Montrachet Study
def: "A population-based study of people aged 75 years or older in Dijon, France, recruited from 2009 to 2013 among participants of the Three-City (3C) Study, who had eye examinations, including photographs and optical coherence tomography of the macula and optic disc, at Dijon University Hospital, designed to find associations between age-related eye diseases and neurologic and heart diseases in the elderly." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:26466845"}
