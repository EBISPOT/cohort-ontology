[Instance]
id: coho:COHO_0002668
name: PROMESA cohort study
def: "A prospective cohort of children under five years old insured by a single health insurance company in Bogotá and Medellín, Colombia, enrolled from 2021 and followed for one year to study how the external exposome, above all particulate matter air pollution, contributes to acute respiratory infections, asthma and early DNA damage." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PROMESA", IAO:0000119="PMID:36662732"}
subset: coho1:GEC_subset
synonym: "Characterization of the external exposome and its contribution to the clinical respiratory and early biological effects in children: The PROMESA cohort study" RELATED []
synonym: "Origin of particulate matter and its effect on children's health" RELATED []
synonym: "PROMESA" RELATED OMO:0003000 []
synonym: "PROMESA study" RELATED []
xref: https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PROMESA
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Colombia {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9858469/fullTextXML", comment="SettingThe PROMESA study will be conducted in Bogotá and Medellín, the two largest cities in Colombia, as both cities report, in their monitoring network records, that PM2.5 is the pollutant that most deteriorates air quality (Fig 1)."}
relationship: coho:has_data_collection_location http://dbpedia.org/resource/SouthAmerica
property_value: coho:numberOfParticipants "506" xsd:integer {IAO:0000116="children, as the cohort's catalogue entry gives it", xref="https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PROMESA", comment="Number of participants 506"}
