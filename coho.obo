property_value: coho:numberOfParticipants "1340" xsd:integer {IAO:0000116="MS/CIS patients pooled from the Bayer Schering Pharma trials (cases in the 2009 validation set)", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC3099419/", comment="Similarly, details on the first validation set that includes subjects assembled by Bayer Schering Pharma from its therapeutic trials include a total of 1340 cases (Table 1b)."}
property_value: IAO:0000112 "PMID:19879194" xsd:string {dcterms:title="Integration of genetic risk factors into a clinical algorithm for multiple sclerosis susceptibility: a weighted genetic risk score.", xref="PMID:19879194", xref="https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3099419/unicode", comment="This sample collection is therefore referred to as the Therapeutic Trial (TT) collection."}

[Instance]
id: coho:COHO_0001509
name: Berlin Birth Cohort
def: "A birth cohort of mother–child pairs recruited at delivery in the 2000s from women with singleton pregnancies giving birth consecutively at the obstetrics department of the Charité university hospital in Berlin, Germany, with maternal blood, umbilical cord blood, placentas and birth measurements collected at birth. It is used to study maternal and fetal influences, including genetic ones, on birth weight, pregnancy outcomes and maternal physiology in pregnancy." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:31969597", IAO:0000119="PMID:17030683", IAO:0000119="PMID:19696694", IAO:0000119="PMID:29309628", IAO:0000119="PMID:31954177"}
synonym: "BBC" RELATED OMO:0003000 []
synonym: "Berlin Birth Cohort study" RELATED []
