[Instance]
id: coho:COHO_0002743
name: Screening Across the Lifespan Twin Study
def: "A study in which all living twins in the Swedish Twin Registry born in 1958 or earlier were invited, between March 1998 and December 2002, to a computer-assisted telephone interview on demographics and health conditions, and whose participants were then followed for changes in health status." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:36577740", dcterms:contributor="Claude Fable 5.1 (Anthropic), 2026-09"}
synonym: "SALT" RELATED OMO:0003000 []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Sweden {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9925275/fullTextXML", comment="Study participants were drawn from the Swedish Twin Registry (STR), a nationwide database of all twins born in Sweden since the late 1800s and the largest population-based twin registry in the world."}
relationship: coho:isSubCohortOf coho:COHO_0000160 {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10711760/fullTextXML", comment="The SALT study, which is part of the Swedish Twin Registry, assessed 44,919 twin individuals aged between 41 and 97 years in 1998–2002"}
property_value: coho:numberOfParticipants "44919" xsd:integer {IAO:0000116="twin individuals who took part in the baseline telephone interview, 1998-2002", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9925275/fullTextXML", comment="A total of 44 919 twin individuals participated in the SALT baseline assessment, 18 496 of whom were of older age (i.e. ≥ 60 years)."}
property_value: IAO:0000112 "PMID:36577740" xsd:string {dcterms:title="Cardiometabolic multimorbidity and incident dementia: the Swedish twin registry.", xref="PMID:36577740", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9925275/fullTextXML", comment="Between March 1998 and December 2002, all living twins in the registry aged >40 years (i.e. born in 1958 or earlier) were invited to participate in a computer-assisted telephone interview on demographics and health conditions as part of the Screening Across the Lifespan Twin (SALT) study (response rate: 72.6%)."}

