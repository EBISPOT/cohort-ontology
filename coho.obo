[Instance]
id: coho:COHO_0001369
name: Manchester Lung Health Check
def: "A community-based targeted lung cancer screening programme in socioeconomically deprived areas of Manchester, England, run by Manchester University NHS Foundation Trust, which began as a pilot in 2016 and continued in later programmes. It invites ever-smokers registered with local general practices (aged 55–74 in the pilot, 55–80 later) to a nurse-led Lung Health Check on mobile units, with lung cancer risk calculation (PLCOm2012), symptom assessment, spirometry and smoking cessation advice, offers annual low-dose CT screening to those at high risk, and follows attendees for lung cancer outcomes." [] {IAO:0000119="PMID:35430354", dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:30420406", IAO:0000119="PMID:40046247"}
subset: coho1:GWAS_subset
synonym: "LHC" RELATED OMO:0003000 []
synonym: "M-LHC" RELATED OMO:0003000 []
synonym: "Man_LHC" RELATED OMO:0003000 []
synonym: "Manchester Lung Health Check cohort" RELATED []
instance_of: coho:COHO_0000000 ! cohort
relationship: coho:has_data_collection_location http://dbpedia.org/resource/Europe
relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom {xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33046839+AND+SRC%3AMED&format=json&resultType=core", comment="Furthermore, implementation programmes are currently underway in the UK following the success of the UK Lung Cancer Screening (UKLS) trial, which included the Liverpool Health Lung Project, Manchester Lung Health Check, the Lung Screen Uptake Trial, the West London Lung Cancer Screening pilot and the Yorkshire Lung Screening trial."}
property_value: coho:numberOfParticipants "2541" xsd:integer {IAO:0000116="attendees of the 2016 pilot Lung Health Checks", xref="PMID:40046247", comment="Out of 2541 attendees, 56% were high-risk (n=1430/2541) and offered screening; 44% were low-risk (n=1111/2541) and not screened."}
property_value: IAO:0000112 "GCST90315948" xsd:string {dcterms:title="Validation of lung cancer polygenic risk scores in a high-risk case-control cohort.", xref="PMID:37154150", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37154150+AND+SRC%3AMED&format=json&resultType=core", comment="We validated 9 PRSs in a high-risk case-control cohort, comprising genotype data from 652 surgical patients with LC and 550 cancer-free, high-risk (PLCOM2012 score ≥ 1.51%) participants of the Manchester Lung Health Check, a community-based LC screening program (n = 550)."}

[Instance]
id: coho:COHO_0001370
name: Mayo Vascular Disease Biorepository
def: "An electronic medical record-linked biorepository at Mayo Clinic, begun in 2006, that archives DNA, plasma and serum and a questionnaire from consecutive adult patients with known or suspected atherosclerotic vascular disease (such as carotid artery stenosis, abdominal aortic aneurysm or peripheral arterial disease) referred for non-invasive vascular evaluation or exercise stress testing at the Mayo Clinic Gonda Vascular Center, ascertaining disease and comorbidities with electronic phenotyping algorithms, to discover genetic and circulating biomarkers of atherosclerotic vascular disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:26343387", IAO:0000119="PMID:24689004", IAO:0000119="PMID:37845353"}
