relationship: coho:isCohortOf coho:COHO_0002679
property_value: coho:numberOfParticipants "3276" xsd:integer {IAO:0000116="volunteers recruited to the study by January 2018", xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC6294579/", comment="At January 2018, a total of 3,276 volunteers had been recruited to the study, with 3,128 of the recruited 3,276 undergoing baseline assessments and 6,676 follow up assessments undertaken at this census date."}
property_value: IAO:0000112 "PMID:33303219" xsd:string {dcterms:title="Genetic variants in glutamate-, Aβ-, and tau-related pathways determine polygenic risk for Alzheimer's disease.", xref="PMID:33303219", xref="http://irep.ntu.ac.uk/id/eprint/42152/1/1389839_Brookes.pdf", comment="We have determined the predictive capacity of the Synaptic PRS in two datasets of cognitively normal controls (target dataset; n=137, validation dataset; n=80) and pathologically confirmed LOAD patients (target dataset; n=302, validation dataset; n=56) from the Brains for Dementia Research (BDR) resource."}

[Instance]
id: coho:COHO_0001528
name: Scottish Bipolar Family Study
def: "A prospective longitudinal study based at the University of Edinburgh of young people aged 16–25 at entry who were well but at high familial risk of mood disorder, having at least one first-degree or two second-degree relatives with bipolar I disorder (identified through patients with bipolar I disorder referred by psychiatrists across Scotland), and of unrelated controls with no personal or family history of bipolar disorder drawn from their social networks, assessed clinically and with brain MRI on three occasions about two years apart to study changes that precede the onset of mood disorders." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:25229638", IAO:0000119="PMID:23483904", IAO:0000119="PMID:27418025", IAO:0000119="PMID:32954013"}
synonym: "BFS" RELATED OMO:0003000 []
