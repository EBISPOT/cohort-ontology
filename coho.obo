[Instance]
id: coho:COHO_0001297
name: Chicago Cancer Prone Study
def: "A registry of individuals and families at high risk of cancer, established in 1992 at the Cancer Risk Clinic, a hospital-based preventive oncology clinic of the University of Chicago, United States, whose participants receive genetic testing and counselling at enrolment. It is also run as a hospital-based case-control study of the genetics of breast cancer in young patients, enrolling women with histologically confirmed breast cancer through the clinic, with early-onset cases and African Americans oversampled, and cancer-free controls matched on sex and age from patients of the same hospital, with questionnaires adopted from the Breast Cancer Family Registry and blood samples." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:22792352", IAO:0000119="PMID:41373161", IAO:0000119="PMID:20661439"}
subset: coho1:GWAS_subset
