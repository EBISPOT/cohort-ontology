relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_Kingdom
property_value: coho:numberOfParticipants "4209" xsd:integer {IAO:0000116="UKPDS participants randomized to glycaemic-control policies (1991)", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38772405+AND+SRC%3AMED&format=json&resultType=core", comment="5102 patients enrolled between 1977 and 1991, of whom 4209 (82·5%) participants were originally randomly allocated to receive either intensive glycaemic control (sulfonylurea or insulin, or if overweight, metformin) or conventional glycaemic control (primarily diet)."}
property_value: IAO:0000112 "PMID:2097090" xsd:string {dcterms:title="UK Prospective Diabetes Study 6. Complications in newly diagnosed type 2 diabetic patients and their association with different clinical and biochemical risk factors.", xref="PMID:2097090", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2097090+AND+SRC%3AMED&format=json&resultType=core", comment="The patients entered into the UK Prospective Diabetes Study were aged between 25 and 65 (mean age 52 yr) and 33% had either an abnormal ECG or retinopathy."}

[Instance]
id: coho:COHO_0002513
name: United Kingdom Rheumatoid Arthritis Genetics
def: "A collection of adult patients with rheumatoid arthritis fulfilling the 1987 American College of Rheumatology criteria, and of healthy controls, assembled for genetic studies by the UK Rheumatoid Arthritis Genetics consortium, a collaboration of six UK rheumatology research groups. Cases were recruited in Manchester, Aberdeen, Leeds, Sheffield, London and Oxford, mostly from NHS rheumatology clinics but also from the Arthritis Research Campaign National Repository of Family Material and the Norfolk Arthritis Register, and controls in five of these centres; its samples were used to replicate and extend rheumatoid arthritis susceptibility loci from genome-wide association studies." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:19898481", IAO:0000119="PMID:20852893", IAO:0000119="PMID:17982455"}
