relationship: coho:has_data_collection_location http://dbpedia.org/resource/United_States
relationship: coho:hasCohort coho:COHO_0000527 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC4191666/", comment="Controls of ≥80% European ancestry were drawn from ten of the studies included in PanScan III (Alpha-Tocopherol, Beta-Carotene Lung Cancer Prevention Study (ATBC), American Cancer Society Cancer Prevention Study-II Cohort (CPS-II), European Prospective Investigation into Cancer and Nutrition (EPIC), Health Professionals Follow-Up Study (HPFS)"}
relationship: coho:hasCohort coho:COHO_0001663 {xref="https://pmc.ncbi.nlm.nih.gov/articles/PMC8488877/", comment="The 3 PanScan GWAS included participants from 16 cohorts from the National Cancer Institute (NCI) Cohort Consortium, 9 case–control studies, and 1 case series (Gastrointestinal Cancer Clinic of Dana–Farber Cancer Institute)"}
relationship: coho:hasCohort coho:COHO_0002226 {xref="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000206.v5.p3", comment="The studies included in PanScan (PanScan II) from PanC4 are: PACIFIC Study of Group Health and Northern California Kaiser Permanente Johns Hopkins University Mayo Clinic SPORE in Pancreatic Cancer MD Anderson Cancer Center Memorial Sloan Kettering Cancer Center University of California San Francisco University of Toronto Yale University"}
property_value: coho:numberOfCases "5117" xsd:integer {IAO:0000116="PDAC cases and controls of European ancestry in the PanScan I-III association summary statistics", xref="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000206.v5.p3", comment="The dataset includes results from an association study of 5,117 individuals diagnosed with pancreatic ductal adenocarcinoma (PDAC) and 8,845 control individuals, or a total of 13,962 subjects of European ancestry (as compared to the genotype and phenotype information under this project that includes 9,437 individuals (PanScan I and II PDAC case and control individuals and PanScan III PDAC cases only)."}
property_value: coho:numberOfControls "8845" xsd:integer {IAO:0000116="PDAC cases and controls of European ancestry in the PanScan I-III association summary statistics", xref="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000206.v5.p3", comment="The dataset includes results from an association study of 5,117 individuals diagnosed with pancreatic ductal adenocarcinoma (PDAC) and 8,845 control individuals, or a total of 13,962 subjects of European ancestry (as compared to the genotype and phenotype information under this project that includes 9,437 individuals (PanScan I and II PDAC case and control individuals and PanScan III PDAC cases only)."}
property_value: coho:numberOfParticipants "13962" xsd:integer {IAO:0000116="PDAC cases and controls of European ancestry in the PanScan I-III association summary statistics", xref="https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000206.v5.p3", comment="The dataset includes results from an association study of 5,117 individuals diagnosed with pancreatic ductal adenocarcinoma (PDAC) and 8,845 control individuals, or a total of 13,962 subjects of European ancestry (as compared to the genotype and phenotype information under this project that includes 9,437 individuals (PanScan I and II PDAC case and control individuals and PanScan III PDAC cases only)."}
property_value: IAO:0000112 "GCST90100588" xsd:string {dcterms:title="Identification of Recessively Inherited Genetic Variants Potentially Linked to Pancreatic Cancer Risk.", xref="PMID:34926279", xref="https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8678088/fullTextXML", comment="To discover recessively inherited pancreatic cancer risk loci, we performed a re-analysis of the largest pancreatic cancer GWAS, the Pancreatic Cancer Cohort Consortium (PanScan) and the Pancreatic Cancer Case-Control Consortium (PanC4), including 8,769 cases and 7,055 controls of European ancestry."}

[Instance]
id: coho:COHO_0001219
name: Prostate Cancer Genome-wide Association Study of Uncommon Susceptibility Loci
def: "A genome-wide association study of prostate cancer run by the Division of Cancer Epidemiology and Genetics of the US National Cancer Institute as a nested case-control study within the Prostate, Lung, Colorectal, and Ovarian (PLCO) Cancer Screening Trial, in which men of European ancestry with pathologically confirmed prostate cancer detected during screening or reported during the trial, and men of the trial without prostate cancer matched to them on age and year of randomization, were genotyped genome-wide to find prostate cancer susceptibility loci, including loci for aggressive disease." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="PMID:30287866", IAO:0000119="PMID:28139693", IAO:0000119="PMID:25939597"}
