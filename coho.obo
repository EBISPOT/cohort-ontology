[Instance]
id: coho:COHO_0000973
name: Canadian Multicentre Osteoporosis Study
def: "A population-based prospective cohort of men and women aged 25 years and older, recruited in 1995–1997 by random telephone contact from within 50 km of nine regional centres across Canada, and followed with annual mailed questionnaires, repeated interviews and bone density measurements to study osteoporosis and fractures; a youth cohort aged 16–24 was added in 2004–2006." [] {dcterms:contributor="Claude Opus 5.5 (Anthropic), 2026-09", IAO:0000119="https://camos.org/protocol/"}
