    <!-- http://www.ebi.ac.uk/coho/COHO_0001614 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001614">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:27418945</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective Danish study that from September 2004 enrolled consecutive women aged 18 or older admitted for surgery because of a suspected pelvic mass to the Gynaecologic Clinic of Copenhagen University Hospital, Rigshospitalet, collecting their blood and tumour tissue with clinical data to identify factors that distinguish benign from malignant pelvic masses and predict the prognosis of ovarian cancer.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DPMS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Danish Pelvic Mass study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PVD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pelvic Mass Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Danish Pelvic Mass Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001614"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27418945</owl:annotatedTarget>
        <dcterms:title>High-risk HPV is not associated with epithelial ovarian cancer in a Caucasian population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27418945</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27418945+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Formalin-fixed, paraffin-imbedded tumor tissue samples from 198 cases consecutively included in the Danish Pelvic Mass Study were analyzed.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001614"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective Danish study that from September 2004 enrolled consecutive women aged 18 or older admitted for surgery because of a suspected pelvic mass to the Gynaecologic Clinic of Copenhagen University Hospital, Rigshospitalet, collecting their blood and tumour tissue with clinical data to identify factors that distinguish benign from malignant pelvic masses and predict the prognosis of ovarian cancer.</owl:annotatedTarget>
