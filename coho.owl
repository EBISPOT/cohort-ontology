        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>GCST90565136</obo:IAO_0000112>
        <obo:IAO_0000115>A national health examination survey of adults aged 18 or older living in mainland Finland, run by the Finnish Institute for Health and Welfare (THL) at 50 study locations between January and May 2017 in a representative sample drawn from the Population Register by one- and two-stage stratified random sampling, in which participants answered questionnaires on sociodemographic factors, health, quality of life, lifestyle, diseases and medication and attended a health examination with physical measurements and blood sampling, to monitor the health, functional capacity and welfare of the Finnish population and the prevalence and risk factors of common health problems. It combined the protocols of the FINRISK surveys and the Health 2000 and 2011 surveys.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>FinHealth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FinHealth 2017 Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FinHealth 2017 Survey</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FinHealth Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>national FinHealth 2017 study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">National FinHealth 2017 Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001326"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90565136</owl:annotatedTarget>
        <dcterms:title>Nightmares share genetic risk factors with sleep and psychiatric traits.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38413574</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10899618/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The national FinHealth 2017 study comprises a random sample of adults in Finland, and it focuses on objective and perceived health, quality of life, lifestyle, prevalence, and risk factors for common health problems including sleep, insomnia, and alcohol consumption.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
