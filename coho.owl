        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001365"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Hong_Kong"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12102314/supplementaryFiles</oboInOwl:hasDbXref>
