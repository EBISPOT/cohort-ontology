        <dcterms:title>A multi-phenotype analysis reveals 19 susceptibility loci for basal cell carcinoma and 15 for squamous cell carcinoma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36496446</oboInOwl:hasDbXref>
