    <!-- http://www.ebi.ac.uk/coho/COHO_0001060 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001060">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90444478</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective observational study run by the University of Münster, Germany, of three cohorts of adults aged 35–65 examined in parallel with identical methods: patients treated for an acute depressive episode and patients after an acute myocardial infarction or acute coronary syndrome, recruited through psychiatric and cardiological hospitals and clinics in and around Münster, and reference participants randomly sampled from the city&apos;s population register, with a baseline examination in 2010–2013 and repeated follow-ups, to investigate the bidirectional relationship between depression and subclinical arteriosclerosis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BiDirect</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BiDirect study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The BiDirect study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">BiDirect Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90444478</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study meta-analysis of neurofilament light (NfL) levels in blood reveals novel loci related to neurodegeneration.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39251807</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11385583/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The BiDirect Study was initiated in 2009 as a prospective, observational study integrating three cohorts: 1) community-dwelling adults (control diagnostic group), 2) patients with an acute depressive episode (depression diagnostic group), and 3) patients who recently suffered from acute myocardial infarction (MI diagnostic group).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001060"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective observational study run by the University of Münster, Germany, of three cohorts of adults aged 35–65 examined in parallel with identical methods: patients treated for an acute depressive episode and patients after an acute myocardial infarction or acute coronary syndrome, recruited through psychiatric and cardiological hospitals and clinics in and around Münster, and reference participants randomly sampled from the city&apos;s population register, with a baseline examination in 2010–2013 and repeated follow-ups, to investigate the bidirectional relationship between depression and subclinical arteriosclerosis.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22736162</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24924233</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001060"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BiDirect</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001060"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11746137/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>All study participants were recruited in the district of Münster, Germany, and underwent extensive phenotyping during a 10-year period with three follow-ups.</rdfs:comment>
    </owl:Axiom>
    


