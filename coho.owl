    <!-- http://www.ebi.ac.uk/coho/COHO_0001488 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001488">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/New_Zealand"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:22190364</obo:IAO_0000112>
        <obo:IAO_0000115>A multiple sclerosis case-control collection assembled for genome-wide association studies by the Australia and New Zealand Multiple Sclerosis Genetics Consortium (ANZgene), a collaboration of multiple sclerosis research groups in Australia and New Zealand, whose cases are people with multiple sclerosis of European ancestry from Australia and New Zealand; its genome-wide scan compared them with shared genotype data from controls of European ancestry from Australia, the United Kingdom and the United States, and further ANZgene cases and controls were collected for replication and fine-mapping, to identify genetic variants that influence susceptibility to multiple sclerosis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ANZGene</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ANZgene</oboInOwl:hasRelatedSynonym>
