    <!-- http://www.ebi.ac.uk/coho/COHO_0001396 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001396">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>GCST90310293</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of calcific aortic valve stenosis at the Institut universitaire de cardiologie et de pneumologie de Québec – Université Laval, Canada, in which blood and aortic valve tissue are collected from patients undergoing aortic valve replacement for the disease and compared with controls (in its first phase, patients without valve disease undergoing cardiac surgery, mostly coronary artery bypass, at the same institute; in its second, CARTaGENE participants without valvular heart disease), to identify genetic susceptibility to the disease; its valve tissues, collected in 1998–2019, are also used for gene expression studies.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Calcific Aortic Valve Stenosis in Quebec</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>QUEBEC-CAVS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genome-Wide Association Study on Calcific Aortic Valve Stenosis in Quebec</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001396"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90310293</owl:annotatedTarget>
