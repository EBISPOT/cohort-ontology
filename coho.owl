        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001214"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NIT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001214"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11101236/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the 1980s, a Nutritional Intervention Trial (NIT) was initiated in Linxian, Henan province of China.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001215 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001215">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <obo:IAO_0000112>GCST90554824</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of individuals evaluated for cognitive decline at Ace Alzheimer Center Barcelona (Fundació ACE), Spain, recruited from its Memory Clinic, Open House Initiative, the FACEHBI study and the BIOFACE project. Founded in 2014, it studies retinal biomarkers via optical coherence tomography and their relationship to neurodegenerative disorders.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NORFACE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Neuro-Ophthalmology Research at Fundació ACE Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Neuro-Ophthalmology Research at Fundació ACE</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001215"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90554824</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study and polygenic risk scores of retinal thickness across the cognitive continuum: data from the NORFACE cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38365752</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870444/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study population comprised 3170 participants from the Neuro-Ophthalmology Research at Fundació ACE (NORFACE) cohort, which was founded in 2014 to search for retinal biomarkers of AD and examine the relationships between retinal changes and different types of neurodegenerative disorders [12].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001215"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of individuals evaluated for cognitive decline at Ace Alzheimer Center Barcelona (Fundació ACE), Spain, recruited from its Memory Clinic, Open House Initiative, the FACEHBI study and the BIOFACE project. Founded in 2014, it studies retinal biomarkers via optical coherence tomography and their relationship to neurodegenerative disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38365752</obo:IAO_0000119>
        <dcterms:contributor>Claude Sonnet 5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001215"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NORFACE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001215"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870444/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Consecutive individuals evaluated due to cognitive decline at Ace Alzheimer Center Barcelona between September 2014 and March 2019 with a diagnosis of CH, MCI, or dementia, and who had available GWAS data from the GR@ACE study [18] were included in the present analysis.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001216 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001216">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
