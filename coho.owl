        <dcterms:title>Genome-wide association analysis of serum alanine and aspartate aminotransferase, and the modifying effects of BMI in 388k European individuals.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34184762</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8457092/fullTextXML</oboInOwl:hasDbXref>
