        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90992794</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of 1681 adults aged 65 and over living in the Monongahela Valley, Pennsylvania, USA, recruited from voter registration lists in 1987–1989 and followed every other year for up to 12 years to study cognitive decline and dementia.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MoVIES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Monongahela Valley Independent Elders Survey</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000689"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90992794</owl:annotatedTarget>
        <dcterms:title>Sex-stratified genome-wide meta-analysis identifies novel loci for cognitive decline in older adults.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40042063</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11880917/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study included 3021 participants (1476 male and 1545 female) from three cohorts with longitudinal cognitive assessment: the Gingko Evaluation of Memory (GEM) study, the Monongahela‐Youghiogheny Healthy Aging Team (MYHAT), and the Monongahela Valley Independent Elders Survey (MoVIES).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000689"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of 1681 adults aged 65 and over living in the Monongahela Valley, Pennsylvania, USA, recruited from voter registration lists in 1987–1989 and followed every other year for up to 12 years to study cognitive decline and dementia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:40042063</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000689"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MoVIES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
