    <!-- http://www.ebi.ac.uk/coho/COHO_0001289 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001289">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90244057</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of the residents of the city and township of Beaver Dam, Wisconsin, United States, aged 43 to 84 years at a private census begun in 1987. They were examined at baseline in 1988–1990 and re-examined about every five years (up to a 25-year follow-up in 2014–2016) by the University of Wisconsin-Madison, to study the prevalence, incidence and risk factors of age-related eye diseases, such as age-related macular degeneration and cataract, and of visual impairment.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BDES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Beaver Dam Eye Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001289"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244057</owl:annotatedTarget>
        <dcterms:title>Rare variant analyses across multiethnic cohorts identify novel genes for refractive error.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36596879</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>These 14 cohorts were: Singapore Chinese Eye Study (SCES), Singapore Malay Eye Study (SiMES), Singapore Indian Eye Study (SINDI), Age Related Eye Study (AREDS), Rotterdam Study I (RSI), Erasmus Rucphen Family (ERF), Raine Eye Health Study (REHS) of the Raine Study, Beaver Dam Eye Study (BDES), Estonian Genome Center for the University of Tartu (EGCUT), Finnish Twin Study on Aging (FITSA), Ogliastra, Croatia-Korcula, TwinsUK, and EPIC-Norfolk.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001289"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of the residents of the city and township of Beaver Dam, Wisconsin, United States, aged 43 to 84 years at a private census begun in 1987. They were examined at baseline in 1988–1990 and re-examined about every five years (up to a 25-year follow-up in 2014–2016) by the University of Wisconsin-Madison, to study the prevalence, incidence and risk factors of age-related eye diseases, such as age-related macular degeneration and cataract, and of visual impairment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25905023</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29242907</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30208419</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32200810</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001289"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BDES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001289"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The recruitment population consisted of European ancestry individuals ages 43-84 from the town of Beaver Dam, Wisconsin, United States. 4,926 individuals were recruited into the study from 1988- 1990.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001290 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001290">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90239751</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective observational cohort of asymptomatic adults at risk of, but without, clinical atherosclerotic cardiovascular disease (men aged 55–80 and women aged 60–80). They were recruited in 2008–2009 by the High-Risk Plaque Initiative from members of the Humana health plan in Chicago, Illinois, and Fort Lauderdale, Florida, United States, and examined with vascular imaging and blood sampling, to identify imaging and circulating biomarkers that predict near-term atherothrombotic events.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BIOIMAGE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BioImage</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BioImage Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>High Risk Plaque BioImage study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">BioImage Study: A Clinical Study of Burden of Atherosclerotic Disease in an At-Risk Population</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001290"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90239751</owl:annotatedTarget>
        <dcterms:title>Genetic and clinical determinants of abdominal aortic diameter: genome-wide association studies, exome array data and Mendelian randomization study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35234888</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9558840/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The BioImage study (NCT00738725) is a multi-ethnic, observational study aimed at characterizing subclinical atherosclerosis in 6,699 US adults (55-80 years at baseline, 2008- 2009) at risk for, but without, clinical atherosclerotic cardiovascular disease.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001290"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective observational cohort of asymptomatic adults at risk of, but without, clinical atherosclerotic cardiovascular disease (men aged 55–80 and women aged 60–80). They were recruited in 2008–2009 by the High-Risk Plaque Initiative from members of the Humana health plan in Chicago, Illinois, and Fort Lauderdale, Florida, United States, and examined with vascular imaging and blood sampling, to identify imaging and circulating biomarkers that predict near-term atherothrombotic events.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21800090</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35234888</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT00738725</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
