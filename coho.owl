        <obo:IAO_0000112>GCST90267567</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of about 1,500 healthy men and women of European ancestry aged 30 to 60, recruited without diabetes, hypertension or dyslipidaemia at centres in 13-14 European countries by the European Group for the Study of Insulin Resistance, with baseline oral glucose tolerance tests and euglycaemic insulin clamps and follow-up after 3 and 10 years to study how insulin resistance relates to atherosclerosis, cardiovascular disease and type 2 diabetes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>EGIR-RISC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EGIR-RISC Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RISC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Relationship between Insulin Sensitivity and Cardiovascular disease Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Relationship between Insulin Sensitivity and Cardiovascular disease</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000543"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90267567</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study and functional characterization identifies candidate genes for insulin-stimulated glucose uptake.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37291194</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7614755/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the RISC study we assessed the correlation of OGTT derived ISI and IFC with the clamp-based measure of insulin sensitivity M/I</rdfs:comment>
    </owl:Axiom>
