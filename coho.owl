    <!-- http://www.ebi.ac.uk/coho/COHO_0000430 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000430">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Greece"/>
        <obo:IAO_0000112>GCST90179214</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of adults from the Pomak villages of the regional unit of Xanthi, a set of religiously isolated mountainous villages of the Muslim Pomak minority in northern Greece, 1,702 of whom were recruited as volunteers through the local health centre in Echinos between July 2010 and March 2013 within the Hellenic Isolated Cohorts (HELIC) study, with interview-based questionnaires, anthropometric, haematological and biochemical measurements and blood samples for DNA that were genotyped and whole-genome sequenced, to study the genetics of cardiometabolic and other medically relevant complex traits in an isolated population.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HELIC-Pomak</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pomak</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">The Pomak cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000430"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90179214</owl:annotatedTarget>
        <dcterms:title>Identifying causal serum protein-cardiometabolic trait relationships using whole genome sequencing.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36349687</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10077504/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Meta-analyzing whole-genome sequencing (WGS) data from two Greek cohorts, MANOLIS (n = 1356; 22.5× WGS) and Pomak (n = 1537; 18.4× WGS), we detect 301 independently associated pQTL variants for 170 proteins, including 12 rare variants (minor allele frequency &lt; 1%).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000430"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of adults from the Pomak villages of the regional unit of Xanthi, a set of religiously isolated mountainous villages of the Muslim Pomak minority in northern Greece, 1,702 of whom were recruited as volunteers through the local health centre in Echinos between July 2010 and March 2013 within the Hellenic Isolated Cohorts (HELIC) study, with interview-based questionnaires, anthropometric, haematological and biochemical measurements and blood samples for DNA that were genotyped and whole-genome sequenced, to study the genetics of cardiometabolic and other medically relevant complex traits in an isolated population.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25373335</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31847144</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34857772</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000430"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HELIC-Pomak</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000430"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Greece"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8640022/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For MANOLIS, biological samples were collected from the mountainous Mylopomatos villages in Crete, Greece; whereas, Pomak refers to a set of mountainous villages in the North of Greece.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000431 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000431">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
