    <!-- http://www.ebi.ac.uk/coho/COHO_0000822 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000822">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
