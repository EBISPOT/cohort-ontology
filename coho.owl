    <!-- http://www.ebi.ac.uk/coho/COHO_0001107 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001107">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Greece"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Poland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90708782</obo:IAO_0000112>
        <obo:IAO_0000115>A collaboration of the University of Exeter, King&apos;s College London, Innlandet Hospital Trust, the University of Oslo and Stavanger University Hospital that undertakes secondary analysis of data on patients with Alzheimer&apos;s disease from cohort studies and patient registries, to study the genetics of neuropsychiatric symptoms such as psychosis in dementia. Its sources are the Norwegian registry of persons assessed for cognitive symptoms (NorCog) with the affiliated Progression of Alzheimer&apos;s Disease and Resource Use study, the REDIC-NH and Health and Memory Study nursing-home cohorts in Norway, AddNeuroMed, and hospital outpatient clinics in Italy and Greece.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NEXGENS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Norwegian, Exeter and King&apos;s College Consortium for Genetics of Neuropsychiatric Symptoms in Dementia</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90708782</owl:annotatedTarget>
        <dcterms:title>Genetic associations with psychosis and affective disturbance in Alzheimer&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38784964</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11114588/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>testing, and in some cases neuropathologic assessment, conducted during participation in one of the following six source programs (see Supplemental Material for details for each source program), as previously described 15 : the Fundació ACE Barcelona Alzheimer Treatment and Research Center (ACE/GR@ACE), a Consortium of National Institute on Aging Alzheimer Disease Centers (ADC), Eli Lilly and Company (LILLY), the Norwegian, Exeter and King&apos;s College Consortium for Genetics of Neuropsychiatric Symptoms in Dementia (NEXGENS), the National Institute on Aging&apos;s Late Onset Alzheimer&apos;s Disease Family Study (NIA‐LOAD), and the University of Pittsburgh Alzheimer Disease Research Center (PITT ADRC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collaboration of the University of Exeter, King&apos;s College London, Innlandet Hospital Trust, the University of Oslo and Stavanger University Hospital that undertakes secondary analysis of data on patients with Alzheimer&apos;s disease from cohort studies and patient registries, to study the genetics of neuropsychiatric symptoms such as psychosis in dementia. Its sources are the Norwegian registry of persons assessed for cognitive symptoms (NorCog) with the affiliated Progression of Alzheimer&apos;s Disease and Resource Use study, the REDIC-NH and Health and Memory Study nursing-home cohorts in Norway, AddNeuroMed, and hospital outpatient clinics in Italy and Greece.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38784964</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NEXGENS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Greece"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11114588/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>and from the following outpatient clinics in Italy and Greece (Italian and Greek Hospital Outpatients): Centre for Neurodegenerative Disorders, University of Brescia; IRCCS Casa Sollievo della Sofferenza, Neuropsychiatry Clinic of the Eginition Hospital, Athens.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Norway"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11114588/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>NorCog is a national quality- and research registry collecting extensive clinical data and biobank material at outpatient clinics across Norway.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001107"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Poland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11114588/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The AddNeuroMed study involves six cross-European collection study sites; London (United Kingdom), Toulouse (France), Perugia (Italy), Kuopio (Finland), Lodz (Poland), and Thessaloniki (Greece)</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001108 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001108">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
