    <!-- http://www.ebi.ac.uk/coho/COHO_0001452 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001452">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:33216869</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing prospective cohort study, started in 2013 at the Alzheimer Center Amsterdam (Amsterdam UMC), of Dutch-speaking centenarians in the Netherlands who report being cognitively healthy, as confirmed by an informant, and since 2017 also of their first-degree family members and partners, set up to identify characteristics associated with escaping or delaying cognitive decline. Centenarians are visited at home for interviews, neuropsychological testing and blood sampling, followed annually until death, and offered post-mortem brain donation.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>100-plus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>100-plus Study of cognitively healthy centenarians</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The 100-plus Study of cognitively healthy centenarians</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">100-plus Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001452"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33216869</owl:annotatedTarget>
        <dcterms:title>Polygenic Risk Score of Longevity Predicts Longer Survival Across an Age Continuum.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33216869</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8087277/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As cases, we used a sample of 358 participants from the 100-plus Study cohort (20).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001452"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing prospective cohort study, started in 2013 at the Alzheimer Center Amsterdam (Amsterdam UMC), of Dutch-speaking centenarians in the Netherlands who report being cognitively healthy, as confirmed by an informant, and since 2017 also of their first-degree family members and partners, set up to identify characteristics associated with escaping or delaying cognitive decline. Centenarians are visited at home for interviews, neuropsychological testing and blood sampling, followed annually until death, and offered post-mortem brain donation.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30362018</obo:IAO_0000119>
