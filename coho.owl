        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90134661</obo:IAO_0000112>
        <obo:IAO_0000115>A genome-wide association case-control study of lung cancer in the United Kingdom, run at the Institute of Cancer Research, which genotyped lung cancer patients recruited in 1999–2004 through UK oncology centres for the Genetic Lung Cancer Predisposition Study (GELCAPS) and compared them with genotyped controls from the 1958 British Birth Cohort.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym ICR also denotes Icelandic Cancer Registry (COHO:0000096); this term is UK lung cancer GWAS from the Institute for Cancer Research.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>ICR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ICR-GWA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ICR-GWAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ICR_b</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK-GWA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">UK lung cancer GWAS from the Institute for Cancer Research</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001018"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90134661</owl:annotatedTarget>
        <dcterms:title>Cross-ancestry genome-wide meta-analysis of 61,047 cases and 947,237 controls identifies new susceptibility loci contributing to lung cancer.</dcterms:title>
