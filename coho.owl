        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001133"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>EGAS00000000097</obo:IAO_0000112>
        <obo:IAO_0000112>GCST90204200</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of disease-specific case collections and shared controls, coordinated by United Kingdom research groups to identify genetic variants associated with common diseases and evaluate methods for genome-wide association analysis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>WTCCC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Wellcome Trust Case Control Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000182"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS00000000097</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study in multiple human prion diseases suggests genetic risk factors additional to PRNP</dcterms:title>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00000000097</oboInOwl:hasDbXref>
        <rdfs:comment>6015 control individuals (provided by the Wellcome Trust Case Control Consortium and KORA-gen)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000182"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90204200</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of REM sleep behavior disorder identifies polygenic risk and brain expression effects.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36470867</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9722930/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Accordingly, for controls, we used genotype data obtained from (a) French and French-Canadian controls from McGill University (N = 871); (b) the HYPERGENES Project54 (N = 557 Italian samples); (c) the Wellcome Trust Case Control Consortium55 (N = 5516 British samples);</rdfs:comment>
    </owl:Axiom>
