    <!-- http://www.ebi.ac.uk/coho/COHO_0000933 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000933">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>GCST90270288</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based twin registry in China, established in 2001, which includes data on over 61,000 twin pairs from 11 provinces or cities and collects biological specimens from disease-concordant and disease-discordant twin pairs, to analyse genetic and environmental influences on chronic diseases, especially cardiovascular diseases.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CNTR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Chinese National Twin Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000933"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90270288</owl:annotatedTarget>
        <dcterms:title>Exploring the Genetic Association between Obesity and Serum Lipid Levels Using Bivariate Methods.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36606461</oboInOwl:hasDbXref>
