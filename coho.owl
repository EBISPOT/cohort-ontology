    <!-- http://www.ebi.ac.uk/coho/COHO_0001365 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001365">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Hong_Kong"/>
        <obo:IAO_0000112>GCST90566418</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised, double-masked, placebo-controlled trial at the Chinese University of Hong Kong Eye Centre that from 2016 to 2017 enrolled children aged 4 to 12 with myopia in both eyes, limited astigmatism and documented myopic progression in the previous year, assigned them to nightly 0.05%, 0.025% or 0.01% atropine eye drops or placebo, and followed them in later phases (placebo switched to atropine, re-randomisation to continued treatment or washout, and longer-term follow-up), to evaluate the efficacy and safety of low-concentration atropine for slowing myopia progression.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>LAMP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LAMP Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LAMP-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Low-Concentration Atropine for Myopia Progression Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Low Concentration Atropine for Myopia Progression Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001365"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90566418</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identified novel loci and gene-environment interaction for refractive error in children.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40410244</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40410244+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To identify novel genetic loci for children refractive error, we performed a meta-analysis of two genome-wide association studies (GWASs) of spherical equivalent (SE) in 1,237 children from the population-based Hong Kong Children Eye Study (HKCES) and the Low Concentration Atropine for Myopia Progression (LAMP) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001365"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised, double-masked, placebo-controlled trial at the Chinese University of Hong Kong Eye Centre that from 2016 to 2017 enrolled children aged 4 to 12 with myopia in both eyes, limited astigmatism and documented myopic progression in the previous year, assigned them to nightly 0.05%, 0.025% or 0.01% atropine eye drops or placebo, and followed them in later phases (placebo switched to atropine, re-randomisation to continued treatment or washout, and longer-term follow-up), to evaluate the efficacy and safety of low-concentration atropine for slowing myopia progression.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30514630</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40410244</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41732593</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
