    <!-- http://www.ebi.ac.uk/coho/COHO_0000399 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000399">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <obo:IAO_0000112>GCST90651113</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based cohort of patients of China Medical University Hospital, an academic medical centre in Taichung, Taiwan, and its affiliated hospitals, recruited through the hospital&apos;s Precision Medicine Project, begun in 2018 to collect biospecimens from patients attending for medical visits, from densely populated towns and districts across Taiwan. About 413,000 participants enrolled from 2018 to 2021 were genotyped on the custom Taiwan Precision Medicine (TPMv1) array and linked to their electronic medical records from 2003 to 2021 (the HiGenome resource; 323,397 passed ancestry and quality control), for genome-wide, phenome-wide and polygenic risk score studies in the Taiwanese Han population.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CMUH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CMUHPMP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>China Medical University Hospital</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>China Medical University Hospital Precision Medicine Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HiGenome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">China Medical University Hospital Biobank</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000399"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90651113</owl:annotatedTarget>
        <dcterms:title>Diversity and longitudinal records: Genetic architecture of disease associations and polygenic risk in the Taiwanese Han population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40465716</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC12136033/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Data were collected from a single institution—China Medical University Hospital (CMUH) and its affiliated branches—through a unified system encompassing nearly 19 years of EMRs.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000399"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based cohort of patients of China Medical University Hospital, an academic medical centre in Taichung, Taiwan, and its affiliated hospitals, recruited through the hospital&apos;s Precision Medicine Project, begun in 2018 to collect biospecimens from patients attending for medical visits, from densely populated towns and districts across Taiwan. About 413,000 participants enrolled from 2018 to 2021 were genotyped on the custom Taiwan Precision Medicine (TPMv1) array and linked to their electronic medical records from 2003 to 2021 (the HiGenome resource; 323,397 passed ancestry and quality control), for genome-wide, phenome-wide and polygenic risk score studies in the Taiwanese Han population.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36769103</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40465716</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
