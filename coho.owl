        <obo:IAO_0000112>GCST90429799</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based longitudinal cohort of 2,082 Danish adults at different levels of diabetes risk, sampled from the 16,136 high-risk individuals identified by the 2001–2006 stepwise diabetes screening programme in Danish general practice of the Danish arm of ADDITION-Europe, examined in 2009–2011 with detailed cardiometabolic phenotyping and followed for cardiovascular disease and death.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ADDITION-PRO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADDITION-PRO cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
