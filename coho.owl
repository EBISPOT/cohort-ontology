        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001239"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Finnish collection of people with type 1 diabetes, made up of cases only (without family members or controls), that has contributed independent cases to international ImmunoChip genetic studies of type 1 diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28983737</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34127860</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
