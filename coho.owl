    <!-- http://www.ebi.ac.uk/coho/COHO_0000558 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000558">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>GCST90244062</obo:IAO_0000112>
        <obo:IAO_0000115>An international collaboration of investigators from many groups, institutions, countries and studies that meta-analyses genome-wide association and other large-scale genetic data to identify loci modulating human body size and shape, such as height, body mass index and waist-related traits, and releases the summary data.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GAINT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GIANT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GIANT consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Investigation of ANthropometric Traits (GIANT) consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Investigation of Anthropometric Traits Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetic Investigation of ANthropometric Traits consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000558"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244062</owl:annotatedTarget>
        <dcterms:title>Smoking-Interaction Loci Affect Obesity Traits: A Gene-Smoking Stratified Meta-Analysis of 545,131 Europeans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35793639</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:35793639%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>We performed stratified analysis based on the smoking status using both the UK Biobank (UKB) data (N = 334,808) and the Genetic Investigation of ANthropometric Traits (GIANT) data (N = 210,323) to identify gene-smoking interaction for obesity traits.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000558"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international collaboration of investigators from many groups, institutions, countries and studies that meta-analyses genome-wide association and other large-scale genetic data to identify loci modulating human body size and shape, such as height, body mass index and waist-related traits, and releases the summary data.</owl:annotatedTarget>
        <obo:IAO_0000119>https://portals.broadinstitute.org/collaboration/giant/index.php/Main_Page</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
