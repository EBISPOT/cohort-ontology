    <!-- http://www.ebi.ac.uk/coho/COHO_0001070 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001070">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90704646</obo:IAO_0000112>
        <obo:IAO_0000115>A harmonized dataset of the Alzheimer&apos;s Disease Genetics Consortium that merges six separately ascertained datasets or dataset waves of Alzheimer&apos;s disease cases and cognitively normal elders (BIOCARD, CHAP2, EAS, RMAYO, ROSMAP2 and WASHU2), each too small to be analysed on its own, so that they can be analysed together in common-variant association studies.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CSDC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Combined Small Datasets Collection</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001070"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90704646</owl:annotatedTarget>
        <dcterms:title>Consensus meta-analysis of genome-wide association studies for Alzheimer&apos;s disease and related dementias.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42237039</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Here we update descriptions of these studies, where applicable, and provide descriptions for ADC waves 8- 12, as well as the Combined Small Datasets Collection (CSDC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001070"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A harmonized dataset of the Alzheimer&apos;s Disease Genetics Consortium that merges six separately ascertained datasets or dataset waves of Alzheimer&apos;s disease cases and cognitively normal elders (BIOCARD, CHAP2, EAS, RMAYO, ROSMAP2 and WASHU2), each too small to be analysed on its own, so that they can be analysed together in common-variant association studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:42237039</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001070"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CSDC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001070"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>CHAP (part of CSDC): CHAP is an on-going, community-based study of individuals from a geographically defined community of 3 neighborhoods in Chicago, Illinois (Morgan Park, Washington Heights, and Beverly), with 6,158 participants in the first phase of the study (78.7% overall; 80.5% of the blacks, 74.6% of the whites)53 .</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001071 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001071">
