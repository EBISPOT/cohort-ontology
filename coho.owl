        <obo:IAO_0000112>GCST90270122</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based registry cohort of the Cardiovascular Genome Center of Yonsei University College of Medicine, enrolling from November 2000 patients who visited the cardiology division of Severance Hospital in Seoul, South Korea, for chest symptoms, cardiovascular risk-factor control or a health check-up, with clinical data collected by trained nurses, blood samples for DNA and, where symptoms warranted, coronary angiography, for genetic research on coronary artery disease and other cardiovascular and metabolic conditions.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CGC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CGC cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cardiovascular Genome Center</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cardiovascular Genome Center Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cardiovascular Genome Centre</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Cardiovascular Genome Center cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001299"/>
