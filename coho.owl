    <!-- http://www.ebi.ac.uk/coho/COHO_0001192 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001192">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000522"/>
        <obo:IAO_0000112>GCST90270120</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based sleep cohort nested in the CoLaus/PsyCoLaus study of Lausanne, Switzerland: consecutive participants of CoLaus/PsyCoLaus&apos;s first follow-up (2009–12), who also answered sleep questionnaires and had clinical and biological phenotyping, were invited from September 2009 to June 2013 to a full polysomnography at home, organised from the sleep centre of Lausanne University Hospital, to study the prevalence and determinants of sleep disorders such as sleep-disordered breathing and their links with cardiometabolic and mental health. Participants were re-examined at the cohort&apos;s second follow-up in 2014–17.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HypnoLaus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HypnoLaus Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HypnoLaus cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">HypnoLaus Sleep Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001192"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90270120</owl:annotatedTarget>
        <dcterms:title>The genetic etiology of periodic limb movement in sleep.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35670608</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35670608+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Replication in the HypnoLaus and MESA cohorts (1002 cases) preceded joint meta-analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001192"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based sleep cohort nested in the CoLaus/PsyCoLaus study of Lausanne, Switzerland: consecutive participants of CoLaus/PsyCoLaus&apos;s first follow-up (2009–12), who also answered sleep questionnaires and had clinical and biological phenotyping, were invited from September 2009 to June 2013 to a full polysomnography at home, organised from the sleep centre of Lausanne University Hospital, to study the prevalence and determinants of sleep disorders such as sleep-disordered breathing and their links with cardiometabolic and mental health. Participants were re-examined at the cohort&apos;s second follow-up in 2014–17.</owl:annotatedTarget>
