        <obo:IAO_0000112>GCST90565869</obo:IAO_0000112>
        <obo:IAO_0000115>A recontactable cohort of people aged 16 or over living in the United Kingdom, run by the NIHR Mental Health BioResource at King&apos;s College London, which recruits online people with current or past depression or anxiety, and also people with no history of mental disorder, into the NIHR BioResource. Participants complete questionnaires, give saliva samples for genotyping and consent to medical record linkage and recontact, to support research on risk factors for depression and anxiety.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GLAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Links to Anxiety and Depression</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetic Links to Anxiety and Depression Study</rdfs:label>
    </owl:NamedIndividual>
