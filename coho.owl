    <!-- http://www.ebi.ac.uk/coho/COHO_0000754 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000754">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <obo:IAO_0000112>GCST90179107</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre study coordinated by the University of Siena of SARS-CoV-2-positive individuals in Italy, hospitalised and non-hospitalised, whose biospecimens, detailed clinical data and exome and genotype data are collected in the GEN-COVID Biobank, Patient Registry and Genetic Data Repository to find genetic factors for COVID-19 susceptibility and severity.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GEN-COVID</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GEN-COVID Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GEN-COVID cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GEN-COVID consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GENCOVID</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Bases of COVID-19 Clinical Variability</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">GEN-COVID Multicenter Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000754"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90179107</owl:annotatedTarget>
        <dcterms:title>Exome-Wide Association Study Reveals Host Genetic Variants Likely Associated with the Severity of COVID-19 in Patients of European Ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36143338</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9504138/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Accordingly, we conducted a case–control based association study to query an exome dataset of 1,432,135 SNPs in 2692 COVID-19 patients of European ancestry from the GEN-COVID consortium, University of Sienna, Italy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000754"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre study coordinated by the University of Siena of SARS-CoV-2-positive individuals in Italy, hospitalised and non-hospitalised, whose biospecimens, detailed clinical data and exome and genotype data are collected in the GEN-COVID Biobank, Patient Registry and Genetic Data Repository to find genetic factors for COVID-19 susceptibility and severity.</owl:annotatedTarget>
