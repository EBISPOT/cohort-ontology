        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre sample of healthy non-diabetic offspring of patients with type 2 diabetes, recruited in Denmark, Finland, Germany, Italy and Sweden by the European Network on Functional Genomics of Type 2 Diabetes and examined with glucose tolerance tests and hyperinsulinaemic euglycaemic clamps to study the genetics of insulin secretion and insulin sensitivity.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18985156</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19789630</obo:IAO_0000119>
