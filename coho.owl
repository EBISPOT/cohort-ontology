    <!-- http://www.ebi.ac.uk/coho/COHO_0001298 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001298">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90897930</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre observational cohort and database of children and adults with sickle cell disease receiving care at the National Heart, Lung, and Blood Institute&apos;s Comprehensive Sickle Cell Centers in the United States, run from March 2005 to September 2008 at nine of the centres and their satellite sites, which collected clinical data abstracted from medical records, yearly health and lifestyle interviews and quality-of-life questionnaires, and from 2007 blood and DNA samples for a genotype-phenotype repository, to describe the disease&apos;s complications and identify participants for future clinical trials.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>C-DATA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>C-Data</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>C-data</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CSCC C-Data</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Collaborative Data Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Comprehensive Sickle Cell Centers Collaborative Data project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Comprehensive Sickle Cell Centers Collaborative Data Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001298"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90897930</owl:annotatedTarget>
        <dcterms:title>FLT1 and other candidate fetal haemoglobin modifying loci in sickle cell disease in African ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40025045</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11873275/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The cohorts included: Cooperative Study of Sickle Cell Disease (CSSCD: n = 841), Multicenter Study of Hydroxyurea (MSH: n = 178), Pulmonary Hypertension and the Hypoxic Response in Sickle Cell Disease (PUSH) study (n = 73), Comprehensive Sickle Cell Centers Collaborative Data (C-data) project (n = 127), Treatment of Pulmonary Hypertension and Sickle Cell Disease with Sildenafil Treatment (Walk-PHaSST) trial (n = 181), Duke University Outcome Modifying Genes study (n = 152), and Silent Infarct Transfusion (SIT) trial (SITT: n = 488).</rdfs:comment>
    </owl:Axiom>
