        <rdfs:label xml:lang="en">TRoglitazone In the Prevention Of Diabetes</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001036"/>
