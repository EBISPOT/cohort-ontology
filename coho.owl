        <dcterms:title>GWAS meta-analysis of psoriasis identifies new susceptibility alleles impacting disease mechanisms and therapeutic targets.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40021644</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11871359/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Cases: BSTOP study, via UK hospital dermatology centres.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001149"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing prospective observational study and biobank of people aged 16 or over with moderate-to-severe plaque psoriasis starting systemic or biologic therapy, established in 2011 at the St John&apos;s Institute of Dermatology, Guy&apos;s and St Thomas&apos; NHS Foundation Trust, and recruiting at more than 80 dermatology centres across the United Kingdom. It pairs DNA from every participant, and further blood and skin samples from some, with clinical data, captured partly through the British Association of Dermatologists Biologics and Immunomodulators Register, to identify biomarkers of response to psoriasis treatments.</owl:annotatedTarget>
