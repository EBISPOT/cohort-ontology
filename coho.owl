        <owl:annotatedTarget>A sample of healthy controls of European American and African American ancestry recruited at the National Institute on Alcohol Abuse and Alcoholism, National Institutes of Health, USA, who did not meet criteria for alcohol dependence or other major psychiatric disorders on the Structured Clinical Interview for DSM-IV and gave blood samples used for genome-wide DNA methylation analysis and genotyping on Illumina OmniExpress arrays.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34187551</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000620"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NIAAA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000620"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8243879/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The sample consisted of 119 European American (EA) and 82 African American (AA) healthy controls that were recruited at the National Institute on Alcohol Abuse and Alcoholism (NIAAA) at the National Institutes of Health (NIH), USA.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000621 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000621">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90832127</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of about 85,000 English-speaking adults aged 40–79, predominantly Black and low-income, enrolled in 2002–2009 in 12 states of the southeastern United States, designed to study racial disparities in cancer and other chronic disease outcomes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SCCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Southern Community Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Southern Community Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000621"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90832127</owl:annotatedTarget>
        <dcterms:title>A Genome-Wide Association Study of Colorectal Cancer Mortality Outcomes Among Individuals of African and Admixture Ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41609390</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12973162/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To accomplish this aim, we utilize data from the Southern Community Cohort Study (SCCS), a cohort with rich multilevel data designed to help address racial disparities in cancer outcomes.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000621"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of about 85,000 English-speaking adults aged 40–79, predominantly Black and low-income, enrolled in 2002–2009 in 12 states of the southeastern United States, designed to study racial disparities in cancer and other chronic disease outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:41609390</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41909911</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000621"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SCCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
