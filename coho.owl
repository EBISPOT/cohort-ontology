    <!-- http://www.ebi.ac.uk/coho/COHO_0001295 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001295">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90245878</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, prospective, observational cohort of patients presenting with acute non-atherosclerotic spontaneous coronary artery dissection (SCAD), run from the University of British Columbia and enrolled at cardiac centres in Canada and the United States since June 2014, whose precipitating stressors, predisposing conditions and core-laboratory-reviewed angiograms are recorded and who are followed for cardiovascular events, to establish the natural history of SCAD and the outcomes of its treatment. Its first phase, the Canadian SCAD Cohort Study (enrolment 2014 to 2018, three-year follow-up), was extended from December 2018 as the Canadian SCAD Study, with international enrolment, a genetic sub-study and follow-up of up to ten years.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CanSCAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CanSCAD Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CanSCAD Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian SCAD Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian SCAD Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian Spontaneous Coronary Artery Dissection Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian spontaneous coronary artery dissection study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>canSCAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Canadian Spontaneous Coronary Artery Dissection Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001295"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90245878</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of spontaneous coronary artery dissection identifies risk variants and genes related to artery integrity and tissue-mediated coagulation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37248441</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10260398/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The CanSCAD genetic substudy (N=502) included SCAD patients from the prospective Canadian SCAD Cohort Study and the Non-Atherosclerotic Coronary Artery Disease (NACAD) Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001295"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre, prospective, observational cohort of patients presenting with acute non-atherosclerotic spontaneous coronary artery dissection (SCAD), run from the University of British Columbia and enrolled at cardiac centres in Canada and the United States since June 2014, whose precipitating stressors, predisposing conditions and core-laboratory-reviewed angiograms are recorded and who are followed for cardiovascular events, to establish the natural history of SCAD and the outcomes of its treatment. Its first phase, the Canadian SCAD Cohort Study (enrolment 2014 to 2018, three-year follow-up), was extended from December 2018 as the Canadian SCAD Study, with international enrolment, a genetic sub-study and follow-up of up to ten years.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30698711</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32887874</obo:IAO_0000119>
