    <!-- http://www.ebi.ac.uk/coho/COHO_0000451 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000451">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90267412</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of 13,403 racially and ethnically diverse volunteer blood donors aged 18 or older, enrolled from December 2013 to October 2015 at four large blood centres across the United States (in Connecticut, Pennsylvania, Wisconsin and California) by the NHLBI Recipient Epidemiology and Donor Evaluation Study-III (REDS-III), who completed a questionnaire and gave blood for blood counts, ferritin and DNA and a sample of their red cells for haemolysis testing at the end of storage, with donors of extreme haemolysis recalled for a second donation, to study the genetic and biological determinants of donor iron metabolism, pica, restless legs syndrome and red cell storage haemolysis, and to link donors to the outcomes of the patients transfused with their red cells.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>RBC-Omics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REDS RBC Omics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REDS RBC Omics Index cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REDS-III RBC-Omics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REDS-III RBC-Omics study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Red Blood Cell Omics Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Red Blood Cell-Omics Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000451"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90267412</owl:annotatedTarget>
        <dcterms:title>Genome-wide metabolite quantitative trait loci analysis (mQTL) in red blood cells from volunteer blood donors.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36395887</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9763692/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The red blood cell (RBC)-Omics study, part of the larger NHLBI-funded Recipient Epidemiology and Donor Evaluation Study (REDS-III), aims to understand the genetic contribution to blood donor RBC characteristics.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000451"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of 13,403 racially and ethnically diverse volunteer blood donors aged 18 or older, enrolled from December 2013 to October 2015 at four large blood centres across the United States (in Connecticut, Pennsylvania, Wisconsin and California) by the NHLBI Recipient Epidemiology and Donor Evaluation Study-III (REDS-III), who completed a questionnaire and gave blood for blood counts, ferritin and DNA and a sample of their red cells for haemolysis testing at the end of storage, with donors of extreme haemolysis recalled for a second donation, to study the genetic and biological determinants of donor iron metabolism, pica, restless legs syndrome and red cell storage haemolysis, and to link donors to the outcomes of the patients transfused with their red cells.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30267427</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36395887</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
