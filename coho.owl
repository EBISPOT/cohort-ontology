    <!-- http://www.ebi.ac.uk/coho/COHO_0001120 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001120">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90319324</obo:IAO_0000112>
        <obo:IAO_0000115>A retrospective cohort with prospective follow-up, established in 2007 by St. Jude Children&apos;s Research Hospital in Memphis, Tennessee, of survivors of paediatric cancer diagnosed and treated there between 1962 and 2012 who have survived at least five years from diagnosis (until 2015, only adults who had survived ten years), with frequency-matched community controls, who are invited back to the hospital at least every five years for protocol-based medical assessments, patient-reported outcomes and biospecimen collection, to study late health outcomes of childhood cancer and its treatment.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SJLIFE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>St Jude Lifetime Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>St. Jude Lifetime Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>St. Jude Lifetime Cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">St. Jude Lifetime Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001120"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90319324</owl:annotatedTarget>
        <dcterms:title>Trans-Ancestral Genetic Risk Factors for Treatment-Related Type 2 Diabetes Mellitus in Survivors of Childhood Cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38652878</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38652878+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Leveraging whole-genome sequencing data from the St Jude Lifetime Cohort (N = 3,676, 304 clinically ascertained cases), we conducted ancestry-specific genome-wide association studies among survivors of African and European genetic ancestry (AFR and EUR, respectively) followed by trans-ancestry meta-analysis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001120"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A retrospective cohort with prospective follow-up, established in 2007 by St. Jude Children&apos;s Research Hospital in Memphis, Tennessee, of survivors of paediatric cancer diagnosed and treated there between 1962 and 2012 who have survived at least five years from diagnosis (until 2015, only adults who had survived ten years), with frequency-matched community controls, who are invited back to the hospital at least every five years for protocol-based medical assessments, patient-reported outcomes and biospecimen collection, to study late health outcomes of childhood cancer and its treatment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21370418</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33374007</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001120"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SJLIFE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001120"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8453382/</oboInOwl:hasDbXref>
        <rdfs:comment>Childhood cancer survivors were recruited from 8192 survivors diagnosed between 1962 and 2012 with paediatric cancer and treated at St. Jude Children’s Research Hospital in Memphis, TN.</rdfs:comment>
    </owl:Axiom>
    


