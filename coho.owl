        <oboInOwl:hasRelatedSynonym>Genetic Studies in Nuclear Families with Atopic Dermatitis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">GEnetic analysis of NUclear Families with Atopic Dermatitis</rdfs:label>
