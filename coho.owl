    <!-- http://www.ebi.ac.uk/coho/COHO_0001230 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001230">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>GCST90267402</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of the causes of malignant lymphomas (non-Hodgkin lymphoma, including chronic lymphocytic leukaemia, and Hodgkin lymphoma) among residents of Denmark and Sweden aged 18–74, recruited in 1999–2002, with incident cases identified shortly after diagnosis through a rapid case-ascertainment network and controls sampled from the national population registers, and with a telephone interview and blood sampling.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SCALE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Scandinavian Lymphoma Etiology</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Scandinavian Lymphoma Etiology Study</oboInOwl:hasRelatedSynonym>
