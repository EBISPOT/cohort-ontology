        <oboInOwl:hasDbXref>PMID:37945903</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01534-4/MediaObjects/41588_2023_1534_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>PEGASUS was supported by the Intramural Research Program, Division of Cancer Epidemiology and Genetics, National Cancer Institute, National Institutes of Health.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
