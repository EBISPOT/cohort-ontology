        <obo:IAO_0000112>GCST90840420</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of 6,673 men and women aged 45–65 from the greater area of Leiden, the Netherlands, oversampling people with overweight or obesity, recruited in 2008–2012 for extensive phenotyping to investigate the pathways that lead to obesity-related diseases.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NEO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
