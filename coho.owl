    <!-- http://www.ebi.ac.uk/coho/COHO_0001200 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001200">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>GCST90281037</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised, double-blind, placebo-controlled delayed-start trial of patients aged 30 or over whose Parkinson&apos;s disease had been diagnosed within the previous two years and did not yet need medication. They were recruited between August 2011 and May 2016 through academic and community hospitals across the Netherlands, with the Academic Medical Center in Amsterdam as the coordinating centre. Patients received levodopa/carbidopa for 80 weeks, or placebo for 40 weeks followed by levodopa/carbidopa for 40 weeks, with follow-up visits at 3 and 5 years, to test whether starting levodopa early modifies the course of the disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>LEAP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Levodopa in EArly Parkinson&apos;s Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Levodopa in EArly Parkinson&apos;s disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Levodopa in Early Parkinson&apos;s disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Levodopa in Early Parkinson&apos;s Disease</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001200"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90281037</owl:annotatedTarget>
        <dcterms:title>Dopamine Pathway and Parkinson&apos;s Risk Variants Are Associated with Levodopa-Induced Dyskinesia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39132902</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC11490412/</oboInOwl:hasDbXref>
        <rdfs:comment>LEAP: Levodopa in Early Parkinson&apos;s Disease, Netherlands</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001200"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised, double-blind, placebo-controlled delayed-start trial of patients aged 30 or over whose Parkinson&apos;s disease had been diagnosed within the previous two years and did not yet need medication. They were recruited between August 2011 and May 2016 through academic and community hospitals across the Netherlands, with the Academic Medical Center in Amsterdam as the coordinating centre. Patients received levodopa/carbidopa for 80 weeks, or placebo for 40 weeks followed by levodopa/carbidopa for 40 weeks, with follow-up visits at 3 and 5 years, to test whether starting levodopa early modifies the course of the disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26584951</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35164821</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38644623</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
