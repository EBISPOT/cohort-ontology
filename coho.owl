        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001079"/>
        <obo:IAO_0000112>GCST90129535</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium that meta-analyses genome-wide association studies of venous thromboembolism from many case-control and population studies (30,234 cases and 172,122 controls from 18 studies in its 2019 analysis, 29 studies in later case-only analyses) to identify genetic risk factors for venous thromboembolism and its subtypes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>INVENT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>INVENT Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International Network Against Venous Thrombosis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">International Network Against Venous Thrombosis Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90129535</owl:annotatedTarget>
        <dcterms:title>Multi-phenotype analyses of hemostatic traits with cardiovascular events reveal novel genetic associations.</dcterms:title>
