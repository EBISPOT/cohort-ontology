    <!-- http://www.ebi.ac.uk/coho/COHO_0001304 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001304">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90134617</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre prospective observational cohort of children with chronic kidney disease in the United States and Canada, funded since 2003 by the National Institute of Diabetes and Digestive and Kidney Diseases and coordinated from Children&apos;s Mercy Hospital in Kansas City and Johns Hopkins (later the Children&apos;s Hospital of Philadelphia), which since 2005 has enrolled children aged 6 months to 16 years at paediatric nephrology centres and later also young adults. Participants have annual visits with measured glomerular filtration rate, questionnaires on cognition, behaviour and quality of life, cardiovascular assessments and stored biosamples and DNA, to identify risk factors for the decline of kidney function and its effects on cardiovascular risk, neurocognitive function and behaviour, and growth.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CKiD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CKiD Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chronic Kidney Disease in Children</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chronic Kidney Disease in Children Prospective Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Chronic Kidney Disease in Children Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001304"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90134617</owl:annotatedTarget>
        <dcterms:title>Identification of Novel Genetic Risk Factors for Focal Segmental Glomerulosclerosis in Children: Results From the Chronic Kidney Disease in Children (CKiD) Cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36623684</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36623684+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>140 African American children with chronic kidney disease from the Chronic Kidney Disease in Children (CKiD) cohort, including 32 cases with FSGS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001304"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre prospective observational cohort of children with chronic kidney disease in the United States and Canada, funded since 2003 by the National Institute of Diabetes and Digestive and Kidney Diseases and coordinated from Children&apos;s Mercy Hospital in Kansas City and Johns Hopkins (later the Children&apos;s Hospital of Philadelphia), which since 2005 has enrolled children aged 6 months to 16 years at paediatric nephrology centres and later also young adults. Participants have annual visits with measured glomerular filtration rate, questionnaires on cognition, behaviour and quality of life, cardiovascular assessments and stored biosamples and DNA, to identify risk factors for the decline of kidney function and its effects on cardiovascular risk, neurocognitive function and behaviour, and growth.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17699320</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35518833</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT00327860</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001304"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CKiD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001304"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9062328/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The CKiD Study is an ongoing cohort of children, adolescents, and young adults with a diagnosis of CKD in the United States and Canada with participants enrolled between ages 0.5 and 16 years starting in 2005.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001305 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001305">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90336598</obo:IAO_0000112>
        <obo:IAO_0000115>A sample of adults aged 21–50 studied at the University of California, Los Angeles, by the Consortium for Neuropsychiatric Phenomics, one of the NIH Roadmap interdisciplinary research consortia of 2007–2012: mainly healthy White non-Hispanic or Hispanic adults recruited by community advertisement in the Los Angeles area, with smaller groups with schizophrenia, bipolar disorder or ADHD recruited through local clinics and online portals. Participants had diagnostic interviews, neurocognitive testing and blood sampling for genotyping, and a subset had structural, diffusion and functional MRI, to study memory and response-inhibition phenotypes dimensionally from genome to syndrome.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CNP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Consortium for Neuropsychiatric Phenomics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">UCLA Consortium for Neuropsychiatric Phenomics</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001305"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90336598</owl:annotatedTarget>
        <dcterms:title>Polygenic contributions to performance on the Balloon Analogue Risk Task.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37582857</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10618088/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>One was the Consortium for Neuropsychiatric Phenomics (CNP), a study performed at the Semel Institute of the University of California Los Angeles (UCLA) to examine underlying genetic and neural factors and their links to three neuropsychiatric illnesses: schizophrenia, bipolar disorder, and attention-deficit hyperactivity disorder (ADHD).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001305"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sample of adults aged 21–50 studied at the University of California, Los Angeles, by the Consortium for Neuropsychiatric Phenomics, one of the NIH Roadmap interdisciplinary research consortia of 2007–2012: mainly healthy White non-Hispanic or Hispanic adults recruited by community advertisement in the Los Angeles area, with smaller groups with schizophrenia, bipolar disorder or ADHD recruited through local clinics and online portals. Participants had diagnostic interviews, neurocognitive testing and blood sampling for genotyping, and a subset had structural, diffusion and functional MRI, to study memory and response-inhibition phenotypes dimensionally from genome to syndrome.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27922632</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37582857</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001305"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CNP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001305"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10618088/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Healthy control participants, ages 21–50, were recruited by community advertisements in the Los Angeles area and were “White, not Hispanic or Latino;” or “Hispanic or Latino, of any racial group.” The primary language was either English or Spanish (N = 1138; 731 White, 407 Hispanic, of any race).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001306 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001306">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <obo:IAO_0000112>GCST90134438</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal observational cohort, begun in 2012 and based at Kangwon National University Hospital, of residents of six districts with cement plants in Gangwon (Kangwon) and Chungbuk provinces, South Korea, comprising people with chronic obstructive pulmonary disease or airflow limitation and volunteers with normal spirometry, examined with questionnaires, spirometry, chest CT and blood and urine sampling, to study the clinical course and outcomes of COPD in people exposed to cement dust.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CODA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COPD in Dusty Areas</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COPD in dusty areas</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Chronic Obstructive Pulmonary Disease in Dusty Areas</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001306"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90134438</owl:annotatedTarget>
        <dcterms:title>Genome-Wide Association Study of Airway Wall Thickening in a Korean Chronic Obstructive Pulmonary Disease Cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35886039</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9318537/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Study participants were chosen from two cohorts: 500 subjects (324 COPD patients and 176 controls) from the COPD in dusty areas (CODA) cohort [8] and 474 subjects (235 COPD patients and 239 matched controls) from the KoGES-Ansan cohort [9,10].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001306"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal observational cohort, begun in 2012 and based at Kangwon National University Hospital, of residents of six districts with cement plants in Gangwon (Kangwon) and Chungbuk provinces, South Korea, comprising people with chronic obstructive pulmonary disease or airflow limitation and volunteers with normal spirometry, examined with questionnaires, spirometry, chest CT and blood and urine sampling, to study the clinical course and outcomes of COPD in people exposed to cement dust.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29117798</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29750028</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31172706</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41136451</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41436567</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001306"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CODA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001306"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29117798+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To explore the associations of serum and radiological biomarkers with the presence of COPD in never-smokers, we conducted a cross-sectional patient cohort study composed of never-smokers from the COPD in Dusty Areas (CODA) cohort, consisting of subjects living in dusty areas near cement plants in South Korea.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001307 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001307">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>GCST90672045</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective multicentre cohort of lung transplant candidates enrolled before transplantation at eleven French lung transplant centres and the Erasme Hospital in Brussels between September 2009 and the end of 2018, coordinated by Nantes University Hospital, with clinical data and biological samples from recipients, and samples from their organ donors, followed every six months after transplantation (samples for up to five years, clinical data for up to ten), set up to discover early predictors of chronic lung allograft dysfunction.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>COLT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COhort of Lung Transplantation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cohort for Lung Transplantation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cohort of Lung Transplantation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Cohort in Lung Transplantation</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001307"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90672045</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study reveals two novel genetic loci associated with chronic lung allograft dysfunction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41864285</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41864285+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We genotyped 392 donor-recipient pairs from the multicentric Cohort in Lung Transplantation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001307"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective multicentre cohort of lung transplant candidates enrolled before transplantation at eleven French lung transplant centres and the Erasme Hospital in Brussels between September 2009 and the end of 2018, coordinated by Nantes University Hospital, with clinical data and biological samples from recipients, and samples from their organ donors, followed every six months after transplantation (samples for up to five years, clinical data for up to ten), set up to discover early predictors of chronic lung allograft dysfunction.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36968829</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39164465</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001307"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>COLT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001307"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11893754/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>COLT was a prospective study, which included patients from twelve clinical centers between September 2009 to December 2018: CHU Nantes, Hospices Civils de Lyon, Assistance Publique-Hôpitaux de Marseille, Hôpital Foch (Paris), Hôpital Européen Georges Pompidou (Paris), CHU Grenoble, CHRU Strasbourg, CHU Bordeaux, Hôpital Bichat (Paris), Hôpital Marie Lannelongue (Paris area) and CHU Toulouse from France, as well as the Erasme Hospital (Brussels, Belgium).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001308 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001308">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90897930</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre prospective study of the natural history of sickle cell disease, initiated in 1977, that enrolled patients with sickle cell disease of all ages, from newborns to adults and from mild to hospital-based cases, at 23 centres across the United States from 1978 (patients older than six months until 1981, infants until 1988), and followed them with standardised examinations and records of acute and chronic complications and organ damage, later phases following the infant cohort and adult participants until 1998, to identify the factors contributing to the morbidity and mortality of the disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CSSCD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Cooperative Study of Sickle Cell Disease</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001308"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90897930</owl:annotatedTarget>
        <dcterms:title>FLT1 and other candidate fetal haemoglobin modifying loci in sickle cell disease in African ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40025045</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11873275/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Similarly, variants within the genomic region of FLT1 were observed in the Cooperative Study of Sickle Cell Disease (CSSCD) cohort at P = 6.9e-03 (rs61763174, intronic variant, β = −0.24, MAF = 0.06)24, and in the Silent Cerebral Infarct Transfusion Trial (SITT) cohort at P = 2e-04 (rs9578046, 94 kb upstream, β = 0.14, MAF = 0.12)25 (Supplementary Data 2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001308"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre prospective study of the natural history of sickle cell disease, initiated in 1977, that enrolled patients with sickle cell disease of all ages, from newborns to adults and from mild to hospital-based cases, at 23 centres across the United States from 1978 (patients older than six months until 1981, infants until 1988), and followed them with standardised examinations and records of acute and chronic complications and organ damage, later phases following the infant cohort and adult participants until 1998, to identify the factors contributing to the morbidity and mortality of the disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36138487</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:7114401</obo:IAO_0000119>
        <obo:IAO_0000119>https://biolincc.nhlbi.nih.gov/studies/csscd/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001308"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CSSCD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001308"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://biolincc.nhlbi.nih.gov/studies/csscd/</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 4,085 participants, ranging in age from newborns to adults, were enrolled in Phase 1 from 23 centers across the US.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001309 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001309">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90093122</obo:IAO_0000112>
        <obo:IAO_0000115>A single-site, multiethnic, population-based probability sample of residents of Dallas County, Texas, aged 18 to 65, weighted to be about half African American and run by the University of Texas Southwestern Medical Center, surveyed and examined in 2000–2002 (DHS-1) and re-examined in 2007–2009 together with spouses and other new participants (DHS-2), designed to produce unbiased estimates of ethnic differences in cardiovascular health and to support research on their biological and social mechanisms using genetics, imaging, and clinical and social-science methods.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym DHS also denotes Dortmund Health Study (COHO:0000054), Diabetes Heart Study (COHO:0000460) and deCODE Health Study (COHO:0000468); this term is Dallas Heart Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>DHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DaHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Dallas Heart Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001309"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90093122</owl:annotatedTarget>
        <dcterms:title>Genetic and Metabolic Determinants of Plasma Levels of ANGPTL8.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33619548</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33619548+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We studied a population-based sample of Dallas County, comprising individuals in the Dallas Heart Study (DHS-1, n = 3538; DHS-2, n = 3283), including 2131 individuals with repeated measurements 7 to 9 years apart (age 18-85 years; &gt;55% female; 52% Black; 29% White; 17% Hispanic; and 2% other).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001309"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A single-site, multiethnic, population-based probability sample of residents of Dallas County, Texas, aged 18 to 65, weighted to be about half African American and run by the University of Texas Southwestern Medical Center, surveyed and examined in 2000–2002 (DHS-1) and re-examined in 2007–2009 together with spouses and other new participants (DHS-2), designed to produce unbiased estimates of ethnic differences in cardiovascular health and to support research on their biological and social mechanisms using genetics, imaging, and clinical and social-science methods.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15194016</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24531328</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33619548</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001309"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DHS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001309"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DaHS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001309"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8118582/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Plasma samples were obtained from participants of the Dallas Heart Study (DHS), a multiracial/multiethnic, population-based probability sample (n = 3557) of Dallas County residents that was collected between 2000 and 2002 (DHS-1) (35).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001310 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001310">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
