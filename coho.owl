        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001570"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CARE Network</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001570"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CARE_c</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001570"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2742212/</oboInOwl:hasDbXref>
        <rdfs:comment>The CARE Network was next developed in 1999 and consisted of five clinical centers (University of California, San Diego; University of Arizona, Tucson; Washington University, St. Louis; University of Wisconsin, Madison; National Jewish Medical and Research Center, Denver) and one data coordinating center (Penn State University, Hershey).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001571 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001571">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:28604730</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, randomised, double-blind, placebo-controlled trial of daily beta-carotene (30 mg) plus retinyl palmitate (25,000 IU) for the primary prevention of lung cancer in people at high risk of it, namely male and female heavy smokers and former smokers and asbestos-exposed men, recruited at centres in Seattle, Portland, San Francisco, Irvine, Baltimore and New Haven, United States, in a pilot phase from 1985 and an efficacy phase from 1989. The intervention was stopped in January 1996, 21 months early, because it increased lung cancer incidence and mortality; participants were followed through 2005, and the serum, plasma, whole blood and lung tissue collected during the trial form the CARET Biorepository.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Beta Carotene and Retinol Efficacy Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Beta-Carotene and Retinol Efficacy Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CARET</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>β-Carotene and Retinol Efficacy Trial</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Carotene and Retinol Efficacy Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001571"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28604730</owl:annotatedTarget>
        <dcterms:title>Large-scale association analysis identifies new lung cancer susceptibility loci and heterogeneity in genetic susceptibility across histological subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28604730</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>For the OncoArray Project, CARET provided DNA extracted from whole blood of lung cancer cases and controls matched on age at baseline (+/- 4 years), sex, race, baseline smoking status, history of occupational asbestos exposure (asbestos vs heavy smoker), and year of enrollment (2-year intervals).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001571"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre, randomised, double-blind, placebo-controlled trial of daily beta-carotene (30 mg) plus retinyl palmitate (25,000 IU) for the primary prevention of lung cancer in people at high risk of it, namely male and female heavy smokers and former smokers and asbestos-exposed men, recruited at centres in Seattle, Portland, San Francisco, Irvine, Baltimore and New Haven, United States, in a pilot phase from 1985 and an efficacy phase from 1989. The intervention was stopped in January 1996, 21 months early, because it increased lung cancer incidence and mortality; participants were followed through 2005, and the serum, plasma, whole blood and lung tissue collected during the trial form the CARET Biorepository.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15572756</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:1844268</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:8137335</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:8602180</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001571"/>
