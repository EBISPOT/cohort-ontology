        <obo:IAO_0000112>GCST90502757</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium that facilitates joint analysis of genetic data from multiple studies to identify human genomic loci influencing traits related to early growth, from the fetus to young adulthood, such as birth weight and length, gestational duration, head circumference, childhood body mass index and obesity, and pubertal growth.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>EGG</oboInOwl:hasRelatedSynonym>
