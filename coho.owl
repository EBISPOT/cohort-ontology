        <oboInOwl:hasRelatedSynonym>Salvador-SCAALA project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Social Changes, Asthma, and Allergy in Latin America cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Salvador-SCAALA study</rdfs:label>
