    <!-- http://www.ebi.ac.uk/coho/COHO_0000641 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000641">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001313"/>
        <obo:IAO_0000112>GCST90053824</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of genome-wide association studies of type 2 diabetes in people of European descent, whose successive case-control meta-analyses (DIAGRAMv2, DIAGRAMv3 and later) were used to discover and fine-map type 2 diabetes susceptibility loci.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DIAGRAM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DIAbetes Genetics Replication And Meta-analysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European descent in the Diabetes Genetics Replication And Meta-analysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
