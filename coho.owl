        <obo:IAO_0000112>GCST90278200</obo:IAO_0000112>
        <obo:IAO_0000115>An international collaboration of the HIV host genetics community, established to combine all available genome-wide SNP data sets on people living with HIV-1 worldwide, which pools genotype and clinical data from HIV cohorts and studies in North America, Europe, Australia and Africa, many of them natural-history cohorts, to study host genetic influences on HIV-1 acquisition, viral load and spontaneous control.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ICGH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International Consortium for the Genomics of HIV</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">International Collaboration for the Genomics of HIV</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001089"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90278200</owl:annotatedTarget>
        <dcterms:title>Multiancestry sex-stratified genomic associations with HIV viral load and controller status from the ICGH.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37097752</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37097752+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To address this, we performed a sex-stratified genome-wide association study using data from the ICGH.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001089"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international collaboration of the HIV host genetics community, established to combine all available genome-wide SNP data sets on people living with HIV-1 worldwide, which pools genotype and clinical data from HIV cohorts and studies in North America, Europe, Australia and Africa, many of them natural-history cohorts, to study host genetic influences on HIV-1 acquisition, viral load and spontaneous control.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23935489</obo:IAO_0000119>
