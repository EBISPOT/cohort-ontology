        <oboInOwl:hasRelatedSynonym>Indiana University-Purdue University Indianapolis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>US Indiana Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Indiana University-Purdue University Indianapolis cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001360"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90454200</owl:annotatedTarget>
        <dcterms:title>Syndrome-informed phenotyping identifies a polygenic background for achondroplasia-like facial variation in the general population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39622794</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11612227/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The US control dataset (n = 4680) was collected previously and included samples from the 3D Facial Norms cohort and studies at the Pennsylvania State University and Indiana University-Purdue University Indianapolis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001360"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of 3D facial images, self-reported age, height, weight and ancestry, and DNA from volunteers recruited without restriction on ancestry (minors with a parent&apos;s or guardian&apos;s consent) in Indianapolis, Indiana and in Twinsburg, Ohio under one Indiana University-Purdue University Indianapolis ethics protocol, with support from the US National Institute of Justice, and genotyped to study the genetics of facial shape and of other visible traits such as head hair shape.</owl:annotatedTarget>
