        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001004"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9729111/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The EPIC cohort consists of 366,521 women and 153,457 men, aged between 35 and 70years at baseline, recruited from the population at 23 centres across 10 European countries (Denmark, France, Germany, Greece, Italy, The Netherlands, Norway, Spain, Sweden and the UK) between 1992 and 2000.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
