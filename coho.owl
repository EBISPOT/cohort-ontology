        <oboInOwl:hasDbXref>PMID:40537477</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41398-025-03418-z/MediaObjects/41398_2025_3418_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>WHI Genomics and Randomized Trials Network – GARNET, which included all coronary heart disease, stroke, venous thromboembolic events and selected diabetes cases that happened during the active intervention phase in the WHI HT clinical trials and aged matched controls</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000505"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nested case-control genome-wide association sub-study of the Women&apos;s Health Initiative hormone therapy trials, comprising the coronary heart disease, stroke, venous thromboembolism and selected diabetes cases that arose during the active intervention phase and age-matched controls, genotyped under the NHGRI Genomics and Randomized Trials Network (GARNET).</owl:annotatedTarget>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fs41398-025-03418-z/MediaObjects/41398_2025_3418_MOESM1_ESM.pdf</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5714283/fullTextXML</obo:IAO_0000119>
