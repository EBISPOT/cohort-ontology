    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000575"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2841168/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Case samples of GWAS for the Japanese population were obtained from several medical institutes in Japan, as previously described [5], [7].</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000576 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000576">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
