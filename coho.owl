        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4057636/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Erasmus Rucphen Family (ERF) study is a family-based study including over 3 000 individuals from an isolated population in the Southwest region of the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000461"/>
