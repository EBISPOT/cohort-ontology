        <obo:IAO_0000112>EGAS00001000079</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of families from across the United Kingdom with at least two siblings affected by premature coronary artery disease (myocardial infarction, angina verified by exercise testing or angiography, or coronary revascularisation before the 66th birthday, each verified from hospital or general practice records), recruited from April 1998 to November 2003 with British Heart Foundation funding through the media and general practices, after a pilot phase using the coronary disease databases of the lead centres in Leeds and Leicester, to study the genetic basis of premature coronary artery disease; affected siblings, and unaffected siblings where available, were interviewed by telephone and gave blood for DNA.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BHF Family Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BHF-FHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK BHF CAD/MI cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <rdfs:label xml:lang="en">British Heart Foundation Family Heart Study</rdfs:label>
    </owl:NamedIndividual>
