        <owl:annotatedTarget>GCST90129505</owl:annotatedTarget>
        <dcterms:title>Deciphering colorectal cancer genetics through multi-omic analysis of 100,204 cases and 154,587 controls of European and east Asian ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36539618</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01222-9/MediaObjects/41588_2022_1222_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Asia Colorectal Cancer Consortium is primarily funded by R01 CA188214 from US National Institutes of Health.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001049"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium, initiated in 2010, that pools genome-wide genotype data on colorectal cancer cases and cancer-free controls of East Asian ancestry from studies in China, Japan and South Korea, among them the Shanghai Women&apos;s and Men&apos;s Health Studies and colorectal cancer studies from Shanghai, Guangzhou, Aichi, BioBank Japan and several Korean centres, to identify genetic risk factors for colorectal cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30529582</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01222-9/MediaObjects/41588_2022_1222_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
