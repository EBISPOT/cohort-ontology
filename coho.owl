        <obo:IAO_0000112>PMID:31110091</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of 14,465 Singapore citizens and permanent residents of Chinese, Malay and Indian ethnicity aged 21 years and older, recruited in 2004–2010 mainly from the Singapore Prospective Study Program and the Singapore Cardiovascular Cohort Study, with additional recruitment oversampling Malays and Indians, to study chronic disease in a multi-ethnic Asian population.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MEC also denotes Multiethnic Cohort Study of Diet and Health (COHO:0000121); this term is Singapore Multi-Ethnic Cohort.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>MEC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Multi-Ethnic Cohort Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Singapore Multi-Ethnic Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000612"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:31110091</owl:annotatedTarget>
        <dcterms:title>Sociodemographic factors in relation to hypertension prevalence, awareness, treatment and control in a multi-ethnic Asian population: a cross-sectional study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31110091</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6530395/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Multi-Ethnic Cohort (MEC) Study is a population-based study in Singapore (n=14 530) with recruitment conducted between 2004 and 2010.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
