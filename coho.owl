        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90011857</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre case-control study of pancreatic ductal adenocarcinoma carried out at centres in Spain, Italy, Sweden, Germany, the United Kingdom and Ireland in 2009-2014 and 2016-2018, which recruited newly diagnosed patients aged 18 and older and, as controls, sex-, age- and area-matched hospital in-patients without cancer whose primary diagnoses were not associated with known risk factors for the disease (population-based controls in Ireland and Sweden), and collected lifestyle, environmental-exposure and medical-history information by in-person interviews.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>European Study of Digestive Diseases and Genetics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PanGenEU</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PanGenEU Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PanGenEU case-control study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PanGenEU study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">European Study into Digestive Illnesses and Genetics</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000965"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
