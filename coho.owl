    <!-- http://www.ebi.ac.uk/coho/COHO_0000674 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000674">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>GCST90860773</obo:IAO_0000112>
        <obo:IAO_0000115>An international collaborative initiative that pooled individual-level and aggregate genetic data on 12,852 people with irritable bowel syndrome and 139,981 controls from multiple studies for genome-wide association studies of irritable bowel syndrome.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Bellygenes</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bellygenes Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>the Bellygenes initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Bellygenes initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000674"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90860773</owl:annotatedTarget>
        <dcterms:title>Large-scale meta- and cross-trait analyses uncover shared genetic risk factors for IBS and psychiatric disorders.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42221328</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13216503/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This dataset was derived from a prior meta-analysis (12) that integrated two independent cohorts: the UK Biobank (UKB; 40,548 cases and 293,220) and the Bellygenes initiative (12,852 cases and 139,981 controls).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
