        <obo:IAO_0000112>GCST90133314</obo:IAO_0000112>
        <obo:IAO_0000115>A Japanese pharmacogenetic cohort of 219 patients with metastatic renal cell carcinoma treated with sunitinib, recruited from 15 Japanese medical institutes with data collected at the laboratory for pharmacogenomics of the RIKEN Center for Integrative Medical Sciences, to study germline genetic variants related to sunitinib toxicity and efficacy.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym RIKEN also denotes BioBank Japan (COHO:0000377) and RIKEN Study (COHO:0000575); this term is RIKEN cohort.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>RIKEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">RIKEN cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000576"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90133314</owl:annotatedTarget>
        <dcterms:title>Genome-Wide Meta-Analysis Identifies Variants in DSCAM and PDLIM3 That Correlate with Efficacy Outcomes in Metastatic Renal Cell Carcinoma Patients Treated with Sunitinib.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35740506</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35740506+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We included mRCC patients from the European EuroTARGET consortium (n = 550) and the RIKEN cohort in Japan (n = 204) which were analysed separately and in a meta-analysis of genome-wide association studies (GWAS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000576"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Japanese pharmacogenetic cohort of 219 patients with metastatic renal cell carcinoma treated with sunitinib, recruited from 15 Japanese medical institutes with data collected at the laboratory for pharmacogenomics of the RIKEN Center for Integrative Medical Sciences, to study germline genetic variants related to sunitinib toxicity and efficacy.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26914831</obo:IAO_0000119>
