    <!-- http://www.ebi.ac.uk/coho/COHO_0001257 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001257">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <obo:IAO_0000112>GCST90861010</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of healthy pregnant women of Scandinavian heritage with singleton pregnancies who registered for obstetric care and gave birth at Oslo University Hospital, Rikshospitalet, Norway, in 2001–2008. The women had four antenatal visits (weeks 14–16, 22–24, 30–32 and 36–38) with fasting blood samples and ultrasound, and oral glucose tolerance tests at weeks 14–16 and 30–32, to study the determinants of fetal growth and birthweight in healthy pregnancies.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Project STORK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STORK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STORK Rikshospitalet</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>STORK Rikshospitalet study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stork Rikshospitalet</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">STORK study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001257"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90861010</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry, trans-generational GWAS meta-analysis of gestational diabetes and glycaemic traits during pregnancy reveals limited evidence of pregnancy-specific genetic effects.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42225636</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13226718/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The STORK study received additional funding from the Norwegian Diabetes Association, Oslo Diabetes Research Centre, the Norwegian Odd Fellow Research Fund, Johan Selmer Kvanes’ Endowment for Research in Diabetes, University of Oslo, Thematic research: Perinatal nutrition, Oslo University Hospital, Department of Obstetrics, the Norwegian Health Association and the Norwegian Extra Foundation for Health and Rehabilitation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001257"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of healthy pregnant women of Scandinavian heritage with singleton pregnancies who registered for obstetric care and gave birth at Oslo University Hospital, Rikshospitalet, Norway, in 2001–2008. The women had four antenatal visits (weeks 14–16, 22–24, 30–32 and 36–38) with fasting blood samples and ultrasound, and oral glucose tolerance tests at weeks 14–16 and 30–32, to study the determinants of fetal growth and birthweight in healthy pregnancies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22723995</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23460863</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
