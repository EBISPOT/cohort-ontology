    <!-- http://www.ebi.ac.uk/coho/COHO_0001565 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001565">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>PMID:29273806</obo:IAO_0000112>
        <obo:IAO_0000115>A prenatally randomised controlled trial, begun in 1995 at university hospital-based centres in Vancouver and Winnipeg, Canada, of infants at high risk of asthma (with at least one first-degree relative with asthma or two with other IgE-mediated allergic diseases) identified before birth, whose families were assigned either to a multifaceted intervention in the first year of life (avoidance of house dust mite, pet allergens and environmental tobacco smoke, encouragement of breastfeeding with partially hydrolysed formula supplementation, and delayed introduction of solid foods) or to a control group, and whose children were followed as a birth cohort with paediatric allergist assessments to age 15, to test the primary prevention of asthma and allergy.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CAPPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian Childhood Cohorts: Canadian Asthma Primary Prevention Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Canadian Asthma Primary Prevention Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001565"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29273806</owl:annotatedTarget>
        <dcterms:title>Multiancestry association study identifies new asthma risk loci that colocalize with immune-cell enhancer marks.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29273806</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Canadian Asthma Primary Prevention Study (CAPPS4 ) was initiated in 1995 to assess the effectiveness of a multifaceted intervention program on the primary prevention of asthma in high‐risk infants.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001565"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prenatally randomised controlled trial, begun in 1995 at university hospital-based centres in Vancouver and Winnipeg, Canada, of infants at high risk of asthma (with at least one first-degree relative with asthma or two with other IgE-mediated allergic diseases) identified before birth, whose families were assigned either to a multifaceted intervention in the first year of life (avoidance of house dust mite, pet allergens and environmental tobacco smoke, encouragement of breastfeeding with partially hydrolysed formula supplementation, and delayed introduction of solid foods) or to a control group, and whose children were followed as a birth cohort with paediatric allergist assessments to age 15, to test the primary prevention of asthma and allergy.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10891016</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:15100668</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19566956</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35686384</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001565"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CAPPS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001565"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The study had two recruitment centers in Canada, (Vancouver and Winnipeg).</rdfs:comment>
