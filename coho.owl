    <!-- http://www.ebi.ac.uk/coho/COHO_0001296 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001296">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>GCST90027158</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cardiovascular population study of an age-stratified random sample of adults aged 20 years or older living in the Østerbro district and part of Nørrebro around Rigshospitalet in Copenhagen, Denmark, launched in 1975 with a first examination in 1976–1978 and re-examinations in 1981–1983, 1991–1994, 2001–2003 and 2011–2013, whose participants are followed through the Danish national registers. Its original purpose was the prevention of coronary heart disease and stroke; lung disease, dementia, ageing, genetics and other topics were added later.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CCHS also denotes China Cardiovascular Health Study (COHO:0001579); this term is Copenhagen City Heart Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>CCHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Østerbroundersøgelsen</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Copenhagen City Heart Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001296"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90027158</owl:annotatedTarget>
        <dcterms:title>New insights into the genetic etiology of Alzheimer&apos;s disease and related dementias.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35379992</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9005347/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Copenhagen City Heart Study (CCHS) CCHS is a prospective study of the Danish general population initiated in 1976-78 with follow-up examinations in 1981-83, 1991-94, 2001-03, and 2011-13.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001296"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cardiovascular population study of an age-stratified random sample of adults aged 20 years or older living in the Østerbro district and part of Nørrebro around Rigshospitalet in Copenhagen, Denmark, launched in 1975 with a first examination in 1976–1978 and re-examinations in 1981–1983, 1991–1994, 2001–2003 and 2011–2013, whose participants are followed through the Danish national registers. Its original purpose was the prevention of coronary heart disease and stroke; lung disease, dementia, ageing, genetics and other topics were added later.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26779513</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35379992</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001296"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CCHS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001296"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9005347/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Copenhagen City Heart Study (CCHS) CCHS is a prospective study of the Danish general population initiated in 1976-78 with follow-up examinations in 1981-83, 1991-94, 2001-03, and 2011-13.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001297 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001297">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90094651</obo:IAO_0000112>
        <obo:IAO_0000115>A registry of individuals and families at high risk of cancer, established in 1992 at the Cancer Risk Clinic, a hospital-based preventive oncology clinic of the University of Chicago, United States, whose participants receive genetic testing and counselling at enrolment. It is also run as a hospital-based case-control study of the genetics of breast cancer in young patients, enrolling women with histologically confirmed breast cancer through the clinic, with early-onset cases and African Americans oversampled, and cancer-free controls matched on sex and age from patients of the same hospital, with questionnaires adopted from the Breast Cancer Family Registry and blood samples.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CCPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of Chicago Cancer Prone Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of Chicago Cancer Prone Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Chicago Cancer Prone Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001297"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90094651</owl:annotatedTarget>
        <dcterms:title>Associations between age of menarche and genetic variation in women of African descent: genome-wide association study and polygenic score analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34706928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9011920/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Root consortium is comprised of six epidemiologic studies of breast cancer in women of African ancestry: the Nigerian Breast Cancer Study (Ibadan, Nigeria); the Barbados National Cancer Study (Barbados); the Southern Community Cohort (southern United States); the Baltimore Breast Cancer Study (Baltimore, United States); the Racial Variability in Genotypic Determinants of Breast Cancer Risk Study (Detroit and Pennsylvania, United States); and the Chicago Cancer Prone Study (Chicago, United States).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001297"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A registry of individuals and families at high risk of cancer, established in 1992 at the Cancer Risk Clinic, a hospital-based preventive oncology clinic of the University of Chicago, United States, whose participants receive genetic testing and counselling at enrolment. It is also run as a hospital-based case-control study of the genetics of breast cancer in young patients, enrolling women with histologically confirmed breast cancer through the clinic, with early-onset cases and African Americans oversampled, and cancer-free controls matched on sex and age from patients of the same hospital, with questionnaires adopted from the Breast Cancer Family Registry and blood samples.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20661439</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22792352</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41373161</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
