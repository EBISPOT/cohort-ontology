    <!-- http://www.ebi.ac.uk/coho/COHO_0001477 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001477">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:37264683</obo:IAO_0000112>
        <obo:IAO_0000115>An investigator-initiated, multicentre, parallel-group, open, blinded-outcome-assessment randomised trial sponsored by the Atrial Fibrillation Network (AFNET), which from July 2011 to December 2016 randomised patients with atrial fibrillation diagnosed within the previous year and cardiovascular risk factors, at 135 sites in 11 European countries, to early rhythm control therapy or usual care, to test whether early rhythm control prevents cardiovascular complications; its biosample substudy took blood at enrolment from consenting patients.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>AFNET</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET 4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET 4 biosample study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET 4 trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET4</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET4 biosample study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAST-AFNET4 trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Early Therapy of Atrial Fibrillation for Stroke Prevention Trial</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Early Treatment of Atrial Fibrillation for Stroke Prevention Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001477"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:37264683</owl:annotatedTarget>
        <dcterms:title>Association of genetic risk and outcomes in patients with atrial fibrillation: interactions with early rhythm control in the EAST-AFNET4 trial.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37264683</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10405565/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we analysed the interaction between genetic AF and stroke risk and cardiovascular events in the EAST-AFNET4 biosample study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001477"/>
