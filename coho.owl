    <!-- http://www.ebi.ac.uk/coho/COHO_0001165 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001165">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90271557</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study of the residents of the town of Leutkirch in Baden-Württemberg, south-western Germany, designed by the State Health Department of Baden-Württemberg and the University of Ulm, for which inhabitants aged 10 to 65 years were selected at random from the municipal population register and examined in November and December 2002 (EMIL-I) with a questionnaire, anthropometry, abdominal ultrasound and blood sampling. Its original aim, the prevalence of infection with the fox tapeworm Echinococcus multilocularis, was extended to internal diseases and public health, and a subsample was re-examined in 2013 (EMIL-II).</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>EMIL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EMIL study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EMIL-Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EMIL-Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Echinococcus multilocularis in Leutkirch study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ulm-EMIL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Echinococcus Multilocularis and Internal Diseases in Leutkirch</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001165"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90271557</owl:annotatedTarget>
        <dcterms:title>GWAS of random glucose in 476,326 individuals provide insights into diabetes pathophysiology, complications and treatment stratification.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37679419</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01462-3/MediaObjects/41588_2023_1462_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>EMIL-Cohort, a population-based cohort; the study was approved by the ethical committee of the Chamber of Physicians Baden-Württemberg in the year 2002 (Registration Number 133-02; dates 05.09.2002 and 24.09.2002).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001165"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study of the residents of the town of Leutkirch in Baden-Württemberg, south-western Germany, designed by the State Health Department of Baden-Württemberg and the University of Ulm, for which inhabitants aged 10 to 65 years were selected at random from the municipal population register and examined in November and December 2002 (EMIL-I) with a questionnaire, anthropometry, abdominal ultrasound and blood sampling. Its original aim, the prevalence of infection with the fox tapeworm Echinococcus multilocularis, was extended to internal diseases and public health, and a subsample was re-examined in 2013 (EMIL-II).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16981990</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30885181</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001165"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EMIL</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001165"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1586017/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a population-based, cross-sectional health survey in the city of Leutkirch in southwestern Germany.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001166 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001166">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90558259</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, multicentre observational cohort of children with cystic fibrosis aged 12 years or younger who were free of Pseudomonas aeruginosa at enrolment (no earlier positive respiratory culture, or at least two years of negative cultures) or were taking part in the companion Early Pseudomonas Infection Control clinical trial, enrolled in 2004-2006 at 59 cystic fibrosis care centres in the United States and led from the University of Washington and Seattle Children&apos;s Hospital. Participants were followed through encounter-based data collection built on the Cystic Fibrosis Foundation Patient Registry, annual family surveys, respiratory cultures and banked serum, bacterial isolates and DNA, to identify risk factors for early acquisition of P. aeruginosa and to describe its clinical consequences.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>EPIC Obs</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIC Observational Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIC observational cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIC-OBS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIC_Obs</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Early Pseudomonas Infection Control Observational study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Early Pseudomonas Infection Control Observational Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90558259</owl:annotatedTarget>
        <dcterms:title>Genetic modifiers of body mass index in individuals with cystic fibrosis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39260370</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC11480786/</oboInOwl:hasDbXref>
        <rdfs:comment>The Cystic Fibrosis Genome Project (CFGP) is comprised of individuals with CF recruited by the CF Twin and Sibling Study (TSS)15 and Cystic Fibrosis-Related Diabetes (CFRD) Study16 (Johns Hopkins University), Genetic Modifier Study (GMS)17,18,19 and GMS of Severe CF Liver Disease (GMS CFLD)20,21 (University of North Carolina), and Early Pseudomonas Infection Control Observational (EPIC Obs) Study22 (University of Washington and Seattle Children’s Hospital).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, multicentre observational cohort of children with cystic fibrosis aged 12 years or younger who were free of Pseudomonas aeruginosa at enrolment (no earlier positive respiratory culture, or at least two years of negative cultures) or were taking part in the companion Early Pseudomonas Infection Control clinical trial, enrolled in 2004-2006 at 59 cystic fibrosis care centres in the United States and led from the University of Washington and Seattle Children&apos;s Hospital. Participants were followed through encounter-based data collection built on the Cystic Fibrosis Foundation Patient Registry, annual family surveys, respiratory cultures and banked serum, bacterial isolates and DNA, to identify risk factors for early acquisition of P. aeruginosa and to describe its clinical consequences.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19470318</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22554417</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26061914</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39260370</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001166"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
