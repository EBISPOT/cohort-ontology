    <!-- http://www.ebi.ac.uk/coho/COHO_0000377 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000377">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <obo:IAO_0000112>GCST90308750</obo:IAO_0000112>
        <obo:IAO_0000115>A patient-based biobank established in 2003 at the Institute of Medical Science, the University of Tokyo, by the BioBank Japan Project, with a first cohort of about 200,000 patients diagnosed with any of 47 common diseases, enrolled at 12 cooperative medical institutes across Japan from June 2003 to March 2008, whose DNA was collected at baseline and serum and clinical information annually until 2013, and a second cohort of about 67,000 new patients with 38 diseases enrolled in fiscal years 2013–2017, together about 267,000 patients with 51 diseases, built as infrastructure for genomic research and the implementation of personalized medicine.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym RIKEN also denotes RIKEN Study (COHO:0000575) and RIKEN cohort (COHO:0000576); this term is BioBank Japan.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>BBJ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BioBank Japan Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RIKEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">BioBank Japan</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000377"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90308750</owl:annotatedTarget>
        <dcterms:title>Pan-cancer and cross-population genome-wide association studies dissect shared genetic backgrounds underlying carcinogenesis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37340002</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37340002+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we conduct the pan-cancer and cross-population genome-wide association study (GWAS) meta-analysis and replication studies on 13 cancers including 250,015 East Asians (Biobank Japan) and 377,441 Europeans (UK Biobank).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000377"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A patient-based biobank established in 2003 at the Institute of Medical Science, the University of Tokyo, by the BioBank Japan Project, with a first cohort of about 200,000 patients diagnosed with any of 47 common diseases, enrolled at 12 cooperative medical institutes across Japan from June 2003 to March 2008, whose DNA was collected at baseline and serum and clinical information annually until 2013, and a second cohort of about 67,000 new patients with 38 diseases enrolled in fiscal years 2013–2017, together about 267,000 patients with 51 diseases, built as infrastructure for genomic research and the implementation of personalized medicine.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28189464</obo:IAO_0000119>
        <obo:IAO_0000119>https://biobankjp.org/en/about/1990</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
