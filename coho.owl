        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41550966+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
