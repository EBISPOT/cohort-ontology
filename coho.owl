    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000776"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collaboration between the Regeneron Genetics Center and Geisinger Health System in which adult participants of Geisinger&apos;s MyCode Community Health Initiative are exome-sequenced and genotyped and linked to longitudinal electronic health records, for genomics-guided precision medicine and therapeutic discovery.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28008009</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000776"/>
