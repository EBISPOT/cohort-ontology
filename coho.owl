    <!-- http://www.ebi.ac.uk/coho/COHO_0001262 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001262">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Chile"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>GCST90399478</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal study of community-dwelling people aged 60 years and older in Santiago, Chile, designed to study disability and dementia associated with obesity. It follows three cohorts: Santiago participants of the SABE survey, born before 1940 and first recruited in 1999–2000; people born in 1940–1948, recruited from public primary health care centre registries in 2005–2008; and people of high socioeconomic status selected from private health insurance registries.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ALEXANDROS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ALEXANDROS study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Active Life Expectancy, Aging and Disability Related to Obesity Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Active Life Expectancy, Aging and Disorders Related to Obesity Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Alexandros</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Alexandros longitudinal study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Active Life Expectancy, Ageing, and Disability Related to Obesity Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001262"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90399478</owl:annotatedTarget>
        <dcterms:title>The first genome-wide association study in the Argentinian and Chilean populations identifies shared genetics with Europeans in Alzheimer&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37985413</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10917041/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Control individuals (n = 791) were recruited from the Alexandros longitudinal study, 14 of community‐dwelling older adults (≥60 years old) of different demographic origins and socioeconomic levels, mainly in the study of healthy life expectancy, free of disability and dementia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001262"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal study of community-dwelling people aged 60 years and older in Santiago, Chile, designed to study disability and dementia associated with obesity. It follows three cohorts: Santiago participants of the SABE survey, born before 1940 and first recruited in 1999–2000; people born in 1940–1948, recruited from public primary health care centre registries in 2005–2008; and people of high socioeconomic status selected from private health insurance registries.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22286726</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33883888</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35887574</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36013179</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
