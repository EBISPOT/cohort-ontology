        <obo:IAO_0000112>GCST90502911</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective clinical and genetic biorepository at Vanderbilt University Medical Center in Nashville, Tennessee, founded in 2011, that enrols adults scheduled for catheter ablation of atrial fibrillation, recording their medical history, pre-ablation imaging and procedure details, collecting blood for DNA at the time of ablation and following them for arrhythmia recurrence at 3, 6 and 12 months, to identify predictors of response to ablation and to support research on the mechanisms of atrial fibrillation.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>VAFAR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Vanderbilt AF Ablation Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Vanderbilt Atrial Fibrillation Ablation Registry</rdfs:label>
    </owl:NamedIndividual>
