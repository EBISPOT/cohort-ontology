        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Gene-Lifestyle Interactions and Complex Traits Involved in Elevated Disease Risk Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
