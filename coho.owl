        <oboInOwl:hasRelatedSynonym>ChinaMUCA-1998</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">China Multi-Center Collaborative Study of Cardiovascular Epidemiology 1998</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001588"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
