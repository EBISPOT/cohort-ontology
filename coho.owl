    <!-- http://www.ebi.ac.uk/coho/COHO_0001589 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001589">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:32005116</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based cohort of women aged 45–64 registered with a large general practice in Chingford, North-East London, United Kingdom, recruited in 1988–1989 to study osteoarthritis, osteoporosis and other musculoskeletal disease and assessed annually for over 20 years (to 2010) with clinical examinations, nurse-administered questionnaires, hand and knee radiographs and bone density measurements; deaths are traced through the Office for National Statistics.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Chingford</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford 1,000 Women Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford general population cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford general population survey</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chingford study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Chingford 1000 Women Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001589"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32005116</owl:annotatedTarget>
        <dcterms:title>The incidence and characteristics of accelerated knee osteoarthritis among women: the Chingford cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32005116</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32005116+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Hence, we determined the incidence and characteristics of AKOA among women in the Chingford Study, which is a prospective community-based cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001589"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of women aged 45–64 registered with a large general practice in Chingford, North-East London, United Kingdom, recruited in 1988–1989 to study osteoarthritis, osteoporosis and other musculoskeletal disease and assessed annually for over 20 years (to 2010) with clinical examinations, nurse-administered questionnaires, hand and knee radiographs and bone density measurements; deaths are traced through the Office for National Statistics.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32005116</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34288584</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34537387</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38637130</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001589"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Chingford</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001589"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8982643/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Chingford 1,000 women study is a prospective population-based cohort of women 45-64 years old at the study set up (1989), registered in the large general practice in Chingford (North East London, United Kingdom) [12].</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001590 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001590">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>PMID:26881390</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control study of prostate cancer in Han Chinese men run by the CHIPGECS collaborative group of Chinese hospitals and universities with Barts Cancer Institute, Queen Mary University of London, which recruited hospital patients with a pathological diagnosis of primary prostate cancer and cancer-free men of comparable age from the community or from hospital attendees having routine physical examinations, in several regions of China (south, southeast, southwest, central and northeast), and whose samples were genotyped with the PRACTICAL consortium on the iCOGS and OncoArray arrays.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CHIPGECS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Chinese Prostate Cancer Genetic and Environmental Correlation Study</rdfs:label>
    </owl:NamedIndividual>
