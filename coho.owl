        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001337"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10718488/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Stroke cases aged 15–49 years old at the time of ischemic stroke were recruited from the greater Baltimore-Washington area over 4 time periods between 1992 and 2008, along with age and sex matched controls</rdfs:comment>
    </owl:Axiom>
    


