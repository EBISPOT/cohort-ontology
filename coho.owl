    <!-- http://www.ebi.ac.uk/coho/COHO_0000474 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000474">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Ghana"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Kenya"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Nigeria"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Western_Africa"/>
        <obo:IAO_0000112>GCST90091134</obo:IAO_0000112>
        <obo:IAO_0000115>A genetic epidemiology study of type 2 diabetes begun in 1997 as a collaboration of West African and US investigators, enrolling affected sib-pairs with type 2 diabetes and unaffected controls in Ghana and Nigeria and later participants in Eldoret, Kenya, to map type 2 diabetes susceptibility genes in the West African ancestral populations of African Americans.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>AADM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AADM study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Africa America Diabetes Mellitus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Africa America Diabetes Mellitus Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000474"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90091134</owl:annotatedTarget>
        <dcterms:title>Genome-wide analyses of multiple obesity-related cytokines and hormones informs biology of cardiometabolic traits.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34620218</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:34620218%20AND%20SRC:MED&amp;resultType=core&amp;format=json</oboInOwl:hasDbXref>
        <rdfs:comment>We performed genome-wide association studies (GWAS) in 4432 continental Africans, enrolled from Ghana, Kenya, and Nigeria as part of the Africa America Diabetes Mellitus (AADM) study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000474"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genetic epidemiology study of type 2 diabetes begun in 1997 as a collaboration of West African and US investigators, enrolling affected sib-pairs with type 2 diabetes and unaffected controls in Ghana and Nigeria and later participants in Eldoret, Kenya, to map type 2 diabetes susceptibility genes in the West African ancestral populations of African Americans.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11164120</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8499470/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000474"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AADM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000474"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Nigeria"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8499470/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Data were collected in three cities in Nigeria (Ibadan, Enugu, and Lagos), two cities in Ghana (Accra, and Kumasi), and in the city of Eldoret in Kenya.</rdfs:comment>
    </owl:Axiom>
    


