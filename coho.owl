        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000927"/>
        <obo:IAO_0000112>GCST001595</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study sampled from the Northern Sweden Health and Disease Study cohort in the county of Västerbotten, Sweden, whose hip and forearm fracture cases, identified by linking the cohort with medical records and radiographic reports, are compared with controls from the same cohort to identify the genetic and environmental determinants of osteoporotic fractures.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>UFO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Umeå Fracture and Osteoporosis (UFO) study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Umeå Fracture and Osteoporosis study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Umeå Fracture and Osteoporosis Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000986"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST001595</owl:annotatedTarget>
        <dcterms:title>WNT16 influences bone mineral density, cortical bone thickness, bone strength, and osteoporotic fracture risk.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22792071</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3390364/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Umeå Fracture and Osteoporosis (UFO) study is a nested case-cohort, population-based study from Sweden designed to identify the genetic and gene-by-environmental determinants of osteoporotic fracture.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000986"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study sampled from the Northern Sweden Health and Disease Study cohort in the county of Västerbotten, Sweden, whose hip and forearm fracture cases, identified by linking the cohort with medical records and radiographic reports, are compared with controls from the same cohort to identify the genetic and environmental determinants of osteoporotic fractures.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32067027</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
