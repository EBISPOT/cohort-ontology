    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000459"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90012174</owl:annotatedTarget>
        <dcterms:title>Investigation of gene-gene interactions in cardiac traits and serum fatty acid levels in the LURIC Health Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32915819</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7485803/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed interaction analyses using the two filtering methods, adjusting for age, sex, body mass index (BMI), waist-hip ratio, and the first three principal components from genetic data, among 2,824 samples from the Ludwigshafen Risk and Cardiovascular (LURIC) Health Study.</rdfs:comment>
    </owl:Axiom>
