    <!-- http://www.ebi.ac.uk/coho/COHO_0001134 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001134">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90026609</obo:IAO_0000112>
        <obo:IAO_0000115>A double-blind, placebo-controlled, randomised phase III trial of the Cancer and Leukemia Group B that enrolled patients with previously untreated locally advanced or metastatic pancreatic cancer at its participating institutions in the United States between June 2004 and April 2006, comparing gemcitabine plus bevacizumab with gemcitabine plus placebo, with overall survival as the primary end point.</obo:IAO_0000115>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">CALGB 80303</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001134"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90026609</owl:annotatedTarget>
        <dcterms:title>Bevacizumab-induced hypertension and proteinuria: a genome-wide study of more than 1000 patients.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34616010</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8770703/</oboInOwl:hasDbXref>
        <rdfs:comment>Two studies included only female patients (breast cancer, CALGB 40503 and 40502), one study included only male patients (prostate cancer, CALGB 90401), and one study included both female and male patients (pancreatic cancer, CALGB 80303).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001134"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A double-blind, placebo-controlled, randomised phase III trial of the Cancer and Leukemia Group B that enrolled patients with previously untreated locally advanced or metastatic pancreatic cancer at its participating institutions in the United States between June 2004 and April 2006, comparing gemcitabine plus bevacizumab with gemcitabine plus placebo, with overall survival as the primary end point.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20606091</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT00088894</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001134"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2917317/</oboInOwl:hasDbXref>
        <rdfs:comment>The following institutions participated in this study: Delaware Christiana Care Community Clinical Oncology Program (CCOP) and Helen F. Graham Cancer Center, Wilmington, DE</rdfs:comment>
    </owl:Axiom>
    


