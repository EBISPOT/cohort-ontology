        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90446233</obo:IAO_0000112>
        <obo:IAO_0000115>A multi-site US study of African Americans, a sub-study of the Alzheimer&apos;s Disease Sequencing Project run by investigators at North Carolina Agricultural and Technical State University, Wake Forest School of Medicine, the University of Miami, Columbia University and Case Western Reserve University, that ascertains African American families affected by Alzheimer&apos;s disease through community outreach and collects blood or saliva samples, medical and family histories and cognitive assessments, to identify rare variants, genes and pathways associated with Alzheimer&apos;s disease in African Americans.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>REAAADI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Research in African American Alzheimer&apos;s Disease Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Research in African American Alzheimer Disease Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Research in African American Alzheimer Disease Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001227"/>
