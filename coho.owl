        <rdfs:comment>SP2 (Singapore Prospective Study Program): The SP2 is a population-based study of diabetes and cardiovascular disease in Singapore.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000481"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study of diabetes and cardiovascular disease in Singapore that re-visited, between 2003 and 2007, Chinese, Malay and Asian-Indian adults randomly sampled for four earlier cross-sectional studies (the Thyroid and Heart Study, the 1992 and 1998 National Health Surveys and the National University of Singapore Heart Study), with questionnaires and clinical examinations.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29477148</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles</obo:IAO_0000119>
