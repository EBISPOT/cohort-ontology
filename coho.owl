    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000947"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium of epidemiological cohorts from Europe, the United States and Japan with detailed clinical information on dental diseases, within which genome-wide association studies of dental caries and periodontitis are conducted and meta-analysed.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31235808</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
