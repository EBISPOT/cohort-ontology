    <!-- http://www.ebi.ac.uk/coho/COHO_0001367 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001367">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>GCST90711137</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing single-site, case-only cohort of patients who have undergone lung cancer surgery since 1999 at the Quebec Heart and Lung Institute (Institut universitaire de cardiologie et de pneumologie de Québec – Université Laval) in Quebec City, Canada, with diagnoses confirmed by pathology of the resected specimens, clinical data and consent to the institute&apos;s biobank, assembled by a translational research programme towards precision medicine in lung cancer and used for germline genetic and tumour molecular studies.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>LORD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Lung Oncology Research and Discovery</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Lung Oncology Research &amp; Discovery</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001367"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90711137</owl:annotatedTarget>
        <dcterms:title>Polygenic inheritance and its interplay with smoking history in predicting lung cancer diagnosis: a French-Canadian case-control cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38970920</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11282926/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>LORD consists of a single site case-only cohort based on a 20-year data collection (1999–2021) of patients who underwent lung cancer surgery at IUCPQ-UL.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001367"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing single-site, case-only cohort of patients who have undergone lung cancer surgery since 1999 at the Quebec Heart and Lung Institute (Institut universitaire de cardiologie et de pneumologie de Québec – Université Laval) in Quebec City, Canada, with diagnoses confirmed by pathology of the resected specimens, clinical data and consent to the institute&apos;s biobank, assembled by a translational research programme towards precision medicine in lung cancer and used for germline genetic and tumour molecular studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38970920</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40209611</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001367"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LORD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001367"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Canada"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11282926/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Lung Oncology Research &amp; Discovery (LORD) is an ongoing translational research program towards precision medicine in lung cancer diagnosis, management and treatment conducted at the Quebec Heart and Lung Institute (IUCPQ-UL or “Institut universitaire de cardiologie et de pneumologie de Québec—Université Laval”), located in Quebec City, Canada.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001368 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001368">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90269914</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective multicentre cohort study of gay and bisexual men with and without HIV-1 infection, first enrolled in 1984–1985 at sites in Baltimore/Washington DC, Chicago, Pittsburgh and Los Angeles in the United States, with later enrolment waves, and followed with interviews, physical examinations, laboratory testing and specimen banking every six months, to study the natural and treated history of HIV infection and AIDS and its risk factors; in 2019 it was combined with the Women&apos;s Interagency HIV Study into the MACS/WIHS Combined Cohort Study.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MACS also denotes Marburg-Münster Affective Disorders Cohort Study (COHO:0001330); this term is Multicenter AIDS Cohort Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>MACS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Multicenter AIDS Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001368"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90269914</owl:annotatedTarget>
        <dcterms:title>Africa-specific human genetic variation near CHD1L associates with HIV-1 load.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37532928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10848312/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Multicenter AIDS Cohort Study (MACS) DESCRIPTION: The Multicenter AIDS Cohort Study (MACS) is an ongoing prospective study of the natural and treated histories of HIV-1 infection in homosexual and bisexual men conducted by sites located in Baltimore, Chicago, Pittsburgh and Los Angeles.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001368"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective multicentre cohort study of gay and bisexual men with and without HIV-1 infection, first enrolled in 1984–1985 at sites in Baltimore/Washington DC, Chicago, Pittsburgh and Los Angeles in the United States, with later enrolment waves, and followed with interviews, physical examinations, laboratory testing and specimen banking every six months, to study the natural and treated history of HIV infection and AIDS and its risk factors; in 2019 it was combined with the Women&apos;s Interagency HIV Study into the MACS/WIHS Combined Cohort Study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:3300281</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33675224</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37532928</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001368"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MACS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001368"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8484936/</oboInOwl:hasDbXref>
        <rdfs:comment>The MACS targeted enrollment of men who have sex with men (MSM), with initial enrollment during 1984–1985 in 4 cities across the United States (2) and additional enrollment waves in 1987–1990 and 2001–2003, and limited replenishment enrollment from 2010 to 2017.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001369 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001369">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90315948</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based targeted lung cancer screening programme in socioeconomically deprived areas of Manchester, England, run by Manchester University NHS Foundation Trust, which began as a pilot in 2016 and continued in later programmes. It invites ever-smokers registered with local general practices (aged 55–74 in the pilot, 55–80 later) to a nurse-led Lung Health Check on mobile units, with lung cancer risk calculation (PLCOm2012), symptom assessment, spirometry and smoking cessation advice, offers annual low-dose CT screening to those at high risk, and follows attendees for lung cancer outcomes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>LHC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>M-LHC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Man_LHC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Manchester Lung Health Check cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Manchester Lung Health Check</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001369"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90315948</owl:annotatedTarget>
        <dcterms:title>Validation of lung cancer polygenic risk scores in a high-risk case-control cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37154150</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37154150+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We validated 9 PRSs in a high-risk case-control cohort, comprising genotype data from 652 surgical patients with LC and 550 cancer-free, high-risk (PLCOM2012 score ≥ 1.51%) participants of the Manchester Lung Health Check, a community-based LC screening program (n = 550).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001369"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based targeted lung cancer screening programme in socioeconomically deprived areas of Manchester, England, run by Manchester University NHS Foundation Trust, which began as a pilot in 2016 and continued in later programmes. It invites ever-smokers registered with local general practices (aged 55–74 in the pilot, 55–80 later) to a nurse-led Lung Health Check on mobile units, with lung cancer risk calculation (PLCOm2012), symptom assessment, spirometry and smoking cessation advice, offers annual low-dose CT screening to those at high risk, and follows attendees for lung cancer outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30420406</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35430354</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40046247</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001369"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LHC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001369"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>M-LHC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001369"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Man_LHC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001369"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33046839+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Furthermore, implementation programmes are currently underway in the UK following the success of the UK Lung Cancer Screening (UKLS) trial, which included the Liverpool Health Lung Project, Manchester Lung Health Check, the Lung Screen Uptake Trial, the West London Lung Cancer Screening pilot and the Yorkshire Lung Screening trial.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001370 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001370">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90432152</obo:IAO_0000112>
        <obo:IAO_0000115>An electronic medical record-linked biorepository at Mayo Clinic, begun in 2006, that archives DNA, plasma and serum and a questionnaire from consecutive adult patients with known or suspected atherosclerotic vascular disease (such as carotid artery stenosis, abdominal aortic aneurysm or peripheral arterial disease) referred for non-invasive vascular evaluation or exercise stress testing at the Mayo Clinic Gonda Vascular Center, ascertaining disease and comorbidities with electronic phenotyping algorithms, to discover genetic and circulating biomarkers of atherosclerotic vascular disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MAYO-VDB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MAYOVDB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MAYO_VDB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo Clinic Vascular Disease Biorepository</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo VDB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo Vascular diseases Biorepository</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mayo-VDB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>VDB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Vascular Disease Biorepository</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Vascular Diseases Biorepository - Mayo Clinic</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Mayo Vascular Disease Biorepository</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001370"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90432152</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis identifies risk loci for abdominal aortic aneurysm and highlights PCSK9 as a therapeutic target.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37845353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10632148/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Mayo VDB: Mayo Vascular Disease Biorepository (VDB) at the Mayo Clinic was established to archive DNA, plasma, and serum from patients with suspected atherosclerotic cardiovascular disease (ASCVD) referred for noninvasive vascular evaluation and exercise stress testing at the Mayo Clinic Gonda Vascular Center from January 14, 2006 to July 24, 2020.</rdfs:comment>
    </owl:Axiom>
