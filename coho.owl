    <!-- http://www.ebi.ac.uk/coho/COHO_0001251 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001251">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90270120</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based longitudinal cohort study of the University of Wisconsin-Madison in which Wisconsin state employees aged 30 to 60, sampled from state payroll files, answered a mailed sleep and health survey in 1988, after which all respondents at high risk of sleep-disordered breathing by self-reported snoring, with an age- and sex-matched random sample of the others, were invited to overnight in-laboratory polysomnography repeated at about 4-year intervals, to study the natural history and health consequences of sleep-disordered breathing and other sleep disorders.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>University of Wisconsin Sleep Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WSC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WSCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Wisconsin Sleep Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Wisconsin Sleep Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90270120</owl:annotatedTarget>
        <dcterms:title>The genetic etiology of periodic limb movement in sleep.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35670608</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35670608+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a genome-wide association study (GWAS) of periodic limb movements in sleep (PLMS) using a joint analysis (i.e., discovery, replication, and joint meta-analysis) of four cohorts (MrOS, the Wisconsin Sleep Cohort Study, HypnoLaus, and MESA), comprised of 6843 total subjects.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001251"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based longitudinal cohort study of the University of Wisconsin-Madison in which Wisconsin state employees aged 30 to 60, sampled from state payroll files, answered a mailed sleep and health survey in 1988, after which all respondents at high risk of sleep-disordered breathing by self-reported snoring, with an age- and sex-matched random sample of the others, were invited to overnight in-laboratory polysomnography repeated at about 4-year intervals, to study the natural history and health consequences of sleep-disordered breathing and other sleep disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19743755</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35670608</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
