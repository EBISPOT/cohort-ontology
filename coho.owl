    <!-- http://www.ebi.ac.uk/coho/COHO_0001150 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001150">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90461957</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of Black women in the United States, run by the Slone Epidemiology Center at Boston University, who enrolled in 1995 by returning health questionnaires mailed to subscribers of Essence magazine, members of the Black Nurses&apos; Association, participants in its feasibility studies, and friends and relatives of respondents. The women are followed by repeated mailed questionnaires, with medical record and cancer registry review, to study the causes of illnesses common in Black women, such as breast cancer, hypertension, diabetes, lupus and uterine fibroids.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BWHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Black Womens Health Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Black Women&apos;s Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001150"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90461957</owl:annotatedTarget>
        <dcterms:title>Genome-wide meta-analysis identifies novel risk loci for uterine fibroids within and across multiple ancestry groups.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40050615</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11885530/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Black Women’s Health Study (BWHS) is a U.S. prospective cohort study of 59,000 United States Black women who enrolled in the study in 1995 and have been followed by biennial questionnaires since then.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001150"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of Black women in the United States, run by the Slone Epidemiology Center at Boston University, who enrolled in 1995 by returning health questionnaires mailed to subscribers of Essence magazine, members of the Black Nurses&apos; Association, participants in its feasibility studies, and friends and relatives of respondents. The women are followed by repeated mailed questionnaires, with medical record and cancer registry review, to study the causes of illnesses common in Black women, such as breast cancer, hypertension, diabetes, lupus and uterine fibroids.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:40050615</obo:IAO_0000119>
