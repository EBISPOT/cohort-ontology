    <!-- http://www.ebi.ac.uk/coho/COHO_0001058 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001058">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90128530</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of breast cancer based at the University Breast Center for Franconia, Erlangen University Hospital, Bavaria, Germany, which in the 2000s enrolled women aged 18 or older with invasive breast cancer treated there, with tumour tissue for tissue microarrays, and controls recruited in hospital, through a breast cancer screening programme or by newspaper advertisement, to study genetic and non-genetic risk factors and prognostic and predictive factors of breast cancer.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BBCC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bavarian Breast Cancer Cases and Controls</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Bavarian Breast Cancer Cases and Controls Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001058"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90128530</owl:annotatedTarget>
        <dcterms:title>Genome-wide and transcriptome-wide association studies of mammographic density phenotypes reveal novel loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35414113</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Bavarian Breast Cancer Cases and Controls Study (BBCC) is a case control study that aims at the identification of genetic and non-genetic risk factors for breast cancer (Heusinger et al., 2011, Rauh et al., 2012, Schrauder et al., 2008).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001058"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of breast cancer based at the University Breast Center for Franconia, Erlangen University Hospital, Bavaria, Germany, which in the 2000s enrolled women aged 18 or older with invasive breast cancer treated there, with tumour tissue for tissue microarrays, and controls recruited in hospital, through a breast cancer screening programme or by newspaper advertisement, to study genetic and non-genetic risk factors and prognostic and predictive factors of breast cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35414113</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38178900</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39586971</obo:IAO_0000119>
