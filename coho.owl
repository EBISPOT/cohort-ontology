        <dcterms:title>Genetic Modifiers of Cystic Fibrosis Lung Disease Severity: Whole-Genome Analysis of 7,840 Patients.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36921087</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC10595435</oboInOwl:hasDbXref>
        <rdfs:comment>CGS=Canadian CF Gene Modifier Study (population-based); FrGMS=French CF Gene Modifier Consortium (population-based); JHU=Johns Hopkins University (twin-siblings design); UNC=University of North Carolina (extremes of phenotype); UW=University of Washington (longitudinal study for effect of Pseudomonas aeruginosa acquisition on lung disease).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001301"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based study of people with cystic fibrosis and their parents in Canada, led from the Hospital for Sick Children in Toronto, which recruited patients without regard to genotype or lung function through specialised CF clinics across the country, first from 2003 to 2006 and then in a second phase, with clinical data from clinic records and DNA for genome-wide genotyping and sequencing, to identify genetic modifiers of cystic fibrosis lung disease and of complications such as meconium ileus, liver disease and CF-related diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18292811</obo:IAO_0000119>
