    <!-- http://www.ebi.ac.uk/coho/COHO_0001559 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001559">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:20614474</obo:IAO_0000112>
        <obo:IAO_0000115>A five-year randomised, double-blind, placebo-controlled trial of daily calcium carbonate supplementation for fracture prevention in ambulant, community-dwelling women aged 70 years or older, recruited in 1998 from the general population of Western Australia through the electoral roll, whose participants were followed after the trial ended in 2003 in two observational studies to 2013 and through linked Western Australian hospital and death records, the whole study being known as the Perth Longitudinal Study of Ageing Women.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CAIFOS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Calcium Intake Fracture Outcome study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Calcium intake fracture outcome study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LSAW</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Longitudinal Study of Aging in Women</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PLSAW</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Perth Longitudinal Study of Ageing Women</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Perth Longitudinal Study of Aging Women</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Calcium Intake Fracture Outcome Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001559"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20614474</owl:annotatedTarget>
        <dcterms:title>Calcium supplementation and the risks of atherosclerotic vascular disease in older women: results of a 5-year RCT and a 4.5-year follow-up.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20614474</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20614474+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This study used data from a published 5-year randomized, double-blinded, placebo-controlled trial [Calcium Intake Fracture Outcome Study (CAIFOS)].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001559"/>
