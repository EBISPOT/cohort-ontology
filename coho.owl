        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37973980+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>magnetic resonance images of 6772 children from the ABCD study cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000545"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal cohort of about 11,500 children aged 9-10, including about 1,720 twins, recruited largely through schools at 21 data acquisition sites across the United States to reflect the nation&apos;s diversity, and followed for ten years with annual assessments and biennial MRI to study adolescent brain and cognitive development.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29703560</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
