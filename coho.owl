    <!-- http://www.ebi.ac.uk/coho/COHO_0001206 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001206">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>GCST90129576</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based cohort of Swedish-born women aged 25–64 without a history of cancer, randomly selected from the population registry of the southern Swedish healthcare region and recruited in 1990–1992, who answered a baseline questionnaire on sun exposure habits, constitutional characteristics and other risk factors for melanoma and follow-up questionnaires every ten years, with cancer incidence and mortality followed through Swedish national registers. It was set up to study risk factors for melanoma and is also used to study the health effects of sun exposure.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MISS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Melanoma In Southern Sweden</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Melanoma Inquiry in Southern Sweden</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Melanoma Inquiry of Southern Sweden</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Melanoma in Southern Sweden</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90129576</owl:annotatedTarget>
        <dcterms:title>Genome-wide interaction analysis of menopausal hormone therapy use and breast cancer risk among 62,370 women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35418701</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9007944/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The MISS study is supported by funding from ERC-2011-294576 Advanced grant, Swedish Cancer Society, Swedish Research Council, Local hospital funds, Berta Kamprad Foundation, Gunnar Nilsson.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of Swedish-born women aged 25–64 without a history of cancer, randomly selected from the population registry of the southern Swedish healthcare region and recruited in 1990–1992, who answered a baseline questionnaire on sun exposure habits, constitutional characteristics and other risk factors for melanoma and follow-up questionnaires every ten years, with cancer incidence and mortality followed through Swedish national registers. It was set up to study risk factors for melanoma and is also used to study the health effects of sun exposure.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31663602</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37675201</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40102189</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MISS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001206"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9128912/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In short, 41,000 Swedish-born women, with no history of malignancy, were selected randomly from each year of age in the category 25-64 years, from the Population Registry in southern Sweden (Fig. 1).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001207 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001207">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90568440</obo:IAO_0000112>
        <obo:IAO_0000115>A twin registry at Michigan State University, begun as a university-based registry of undergraduate twins and since 2004 recruiting twins identified from birth records by the Michigan Department of Health and Human Services. Its population-based mail-in registry enrols child and adolescent twins aged 3–17 with their families and adult twins aged 18–55 living in lower Michigan, United States, and in-depth in-person twin family studies are drawn from it, to examine developmental differences in genetic, environmental, neural and neurobiological influences on psychopathology and resilience, particularly in childhood and adolescence.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MSUTR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Michigan State University Twin Register</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Michigan State University Twin Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001207"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90568440</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of childhood ADHD symptoms and diagnosis identifies new loci and potential effector genes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40962958</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02295-y/MediaObjects/41588_2025_2295_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Data for this study comes from the Michigan State University Twin Registry (MSUTR)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001207"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A twin registry at Michigan State University, begun as a university-based registry of undergraduate twins and since 2004 recruiting twins identified from birth records by the Michigan Department of Health and Human Services. Its population-based mail-in registry enrols child and adolescent twins aged 3–17 with their families and adult twins aged 18–55 living in lower Michigan, United States, and in-depth in-person twin family studies are drawn from it, to examine developmental differences in genetic, environmental, neural and neurobiological influences on psychopathology and resilience, particularly in childhood and adolescence.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23101567</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31466551</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
