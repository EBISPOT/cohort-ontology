        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Netherlands Study of Cognition, Environment and Genes</rdfs:label>
    </owl:NamedIndividual>
