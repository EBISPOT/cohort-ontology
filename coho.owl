    <!-- http://www.ebi.ac.uk/coho/COHO_0001213 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001213">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>GCST90841457</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective birth cohort of the University of Oulu comprising the children of all mothers in the two northernmost provinces of Finland, Oulu and Lapland, whose expected date of delivery fell in 1966, recruited during pregnancy at the region&apos;s antenatal clinics from 1965. Set up to study the risk factors for and consequences of preterm birth and intrauterine growth retardation, it has followed its members with questionnaires at 1, 14, 31 and 46 years of age, clinical examinations in adulthood and linked national registers to study the life-course origins of health and disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NFBC1966</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NFBC66</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Northern Finland Premature Birth Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Northern Finland birth cohort 1966</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Northern Finland Birth Cohort 1966</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90841457</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry, trans-generational GWAS meta-analysis of gestational diabetes and glycaemic traits during pregnancy reveals limited evidence of pregnancy-specific genetic effects.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42225636</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13226718/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Northern Finland Birth Cohort 1966</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001213"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective birth cohort of the University of Oulu comprising the children of all mothers in the two northernmost provinces of Finland, Oulu and Lapland, whose expected date of delivery fell in 1966, recruited during pregnancy at the region&apos;s antenatal clinics from 1965. Set up to study the risk factors for and consequences of preterm birth and intrauterine growth retardation, it has followed its members with questionnaires at 1, 14, 31 and 46 years of age, clinical examinations in adulthood and linked national registers to study the life-course origins of health and disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34999878</obo:IAO_0000119>
