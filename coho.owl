        <rdfs:comment>Additional clinically confirmed cutaneous melanoma cases and controls were available from two French cohorts contributing to GenoMEL Phase 1 and 2; MELARISK (535 cases)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001335"/>
