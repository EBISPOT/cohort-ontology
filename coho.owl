        <obo:IAO_0000112>GCST90824080</obo:IAO_0000112>
        <obo:IAO_0000115>A healthcare-system-based research biobank of NorthShore University HealthSystem (now Endeavor Health) in Illinois, United States, started in 2014, which enrols patients of the health system who consent to give a blood sample for DNA and to linkage of their electronic health records, for translational and discovery research combining genomic and clinical data.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GHI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genomic Health Initiative at NorthShore University HealthSystem</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genomic Health Initiative of Endeavor Health</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NSGHI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>North Shore University Health systems Genomic Health Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genomic Health Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001025"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
