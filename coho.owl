        <oboInOwl:hasDbXref>PMID:35551307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9179018/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>East Asian studies of Chinese, Japanese and Korean ancestry from those of Malay and Filipino ancestry (SIMES and CLHNS)</rdfs:comment>
    </owl:Axiom>
