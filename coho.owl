        <obo:IAO_0000112>GCST90444478</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal behavioural genetic study of cognitive and brain aging in men, and later of early risk of mild cognitive impairment and Alzheimer&apos;s disease, whose participants are twins randomly selected from the Vietnam Era Twin Registry of male twin pairs who both served in the US military between 1965 and 1975, recruited in their 50s and assessed at two sites, San Diego and Boston, from 2003, with follow-up waves every 5 to 6 years.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>The Vietnam Era Twin Study of Aging</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>VETSA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Vietnam Era Twin Study of Aging</rdfs:label>
