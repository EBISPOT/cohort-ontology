    <!-- http://www.ebi.ac.uk/coho/COHO_0000572 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000572">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>GCST001153</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:25429525</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of urinary bladder cancer run from Radboud University Medical Center in Nijmegen, the Netherlands, in which patients diagnosed from 1995 to 2010 under the age of 76 and living in the catchment area of seven hospitals in the east of the country were identified through the Netherlands Cancer Registry and invited in batches, with controls drawn from the Nijmegen Biomedical Study, to study genetic and lifestyle risk factors and outcomes of bladder cancer.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym NBCS also denotes Norwegian Breast Cancer Study (COHO:0000573) and Nigerian Breast Cancer Study (COHO:0001381); this term is Nijmegen Bladder Cancer Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>NBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Nijmegen Bladder Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000572"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST001153</owl:annotatedTarget>
        <dcterms:title>European genome-wide association study identifies SLC14A1 as a new urinary bladder cancer susceptibility gene.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21750109</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3188988/</oboInOwl:hasDbXref>
        <rdfs:comment>The Dutch patients were recruited for the Nijmegen Bladder Cancer Study (NBCS: http://dceg.cancer.gov/icbc/membership.html).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000572"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25429525</owl:annotatedTarget>
        <dcterms:title>Recurrent urinary tract infection and risk of bladder cancer in the Nijmegen bladder cancer study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25429525</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In this study, we analysed data of the Nijmegen Bladder Cancer Study (NBCS), one of the largest case–control studies for UBC worldwide, as to gain better insights into the role of recurrent infections of the (lower) urinary tract as a risk factor for UBC.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000572"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of urinary bladder cancer run from Radboud University Medical Center in Nijmegen, the Netherlands, in which patients diagnosed from 1995 to 2010 under the age of 76 and living in the catchment area of seven hospitals in the east of the country were identified through the Netherlands Cancer Registry and invited in batches, with controls drawn from the Nijmegen Biomedical Study, to study genetic and lifestyle risk factors and outcomes of bladder cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000572"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NBCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000572"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Within the framework of the NBCS, UBC patients living in the catchment area of seven hospitals in the eastern part of the country were identified through the Netherlands Cancer Registry (NCR) held by the Comprehensive Cancer Centre the Netherlands (IKNL) (Kiemeney et al, 2008).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000573 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000573">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <obo:IAO_0000112>GCST90128530</obo:IAO_0000112>
        <obo:IAO_0000115>A Norwegian breast cancer case-control study in the Breast Cancer Association Consortium, whose cases are incident breast cancers from Ullevål University Hospital (1990–1994), the Norwegian Radium Hospital (1975–1986 and 1995–1998) and Haukeland University Hospital (1992–2001) and whose controls are women from Tromsø and Bergen who attended the Norwegian Breast Cancer Screening Program. It also includes a sub-study of women attending the national mammography screening programme in 2002–2007 who gave blood and breast biopsies with mammographic density measurements, and its normal and tumour breast tissue samples are used in gene expression studies.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym NBCS also denotes Nijmegen Bladder Cancer Study (COHO:0000572) and Nigerian Breast Cancer Study (COHO:0001381); this term is Norwegian Breast Cancer Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>NBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NorBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Norwegian Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000573"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90128530</owl:annotatedTarget>
        <dcterms:title>Genome-wide and transcriptome-wide association studies of mammographic density phenotypes reveal novel loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35414113</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>This NBCS sub-study involves women attending the Norwegian national mammography screening program from 2002 to 2007 and biopsies were taken from breasts with varying mammographic density and newly diagnosed breast cancers (ethical approval S-02036).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000573"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Norwegian breast cancer case-control study in the Breast Cancer Association Consortium, whose cases are incident breast cancers from Ullevål University Hospital (1990–1994), the Norwegian Radium Hospital (1975–1986 and 1995–1998) and Haukeland University Hospital (1992–2001) and whose controls are women from Tromsø and Bergen who attended the Norwegian Breast Cancer Screening Program. It also includes a sub-study of women attending the national mammography screening programme in 2002–2007 who gave blood and breast biopsies with mammographic density measurements, and its normal and tumour breast tissue samples are used in gene expression studies.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/supplementaryFiles</obo:IAO_0000119>
