        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001484"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The AMI Gene Study/Dortmund Health Study13 is a prospective multi-centre registry involving 4 heart centres and 6 cardiologic departments in North-Rhine-Westphalia, Lower Saxony, and Mecklenburg-Western Pomerania.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001485 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001485">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:34237774</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort and biobank, set up by the Amsterdam UMC COVID study group, of adult patients admitted with COVID-19 from 2020 to the COVID-19 wards and intensive care units of the two academic hospitals of Amsterdam UMC (locations University of Amsterdam and Vrije Universiteit Amsterdam) in the Netherlands, which stores their clinical data and left-over and serially collected biological samples. Its genotyped patients, with controls, were contributed to the COVID-19 Host Genetics Initiative&apos;s genome-wide association meta-analyses of COVID-19.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Amsterdam UMC COVID study group</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Amsterdam UMC COVID-19 biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Amsterdam UMC Covid-19 Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Amsterdam_UMC_COVID_study_group</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Amsterdam UMC COVID-19 Biobank</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001485"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34237774</owl:annotatedTarget>
        <dcterms:title>Mapping the human genetic architecture of COVID-19.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34237774</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-021-03767-x/MediaObjects/41586_2021_3767_MOESM6_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>Patients or their legal representatives received written information about the study (Amsterdam UMC Covid-19 biobank) and were asked to give written informed consent for participation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001485"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort and biobank, set up by the Amsterdam UMC COVID study group, of adult patients admitted with COVID-19 from 2020 to the COVID-19 wards and intensive care units of the two academic hospitals of Amsterdam UMC (locations University of Amsterdam and Vrije Universiteit Amsterdam) in the Netherlands, which stores their clinical data and left-over and serially collected biological samples. Its genotyped patients, with controls, were contributed to the COVID-19 Host Genetics Initiative&apos;s genome-wide association meta-analyses of COVID-19.</owl:annotatedTarget>
