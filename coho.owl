    <!-- http://www.ebi.ac.uk/coho/COHO_0001550 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001550">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000744"/>
        <obo:IAO_0000112>PMID:21655089</obo:IAO_0000112>
        <obo:IAO_0000115>A study of the Queensland Institute of Medical Research (QIMR) in Brisbane, Australia, that from 1992 to 2016 examined annual new samples of 12-year-old twins from south-east Queensland, with their siblings nearest in age, counting their naevi and recording their sun behaviour, and re-examined them two years later; set up to investigate genetic factors in naevus development and other risk factors for melanoma, it also includes the twins&apos; parents and is the twin mole study of the Brisbane Longitudinal Twin Study.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BTNS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Brisbane Twin Naevus Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TWin Mole study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Brisbane Twin Nevus Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001550"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21655089</owl:annotatedTarget>
        <dcterms:title>Multiple common susceptibility variants near BMP pathway loci GREM1, BMP4, and BMP2 explain part of the missing heritability of colorectal cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21655089</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3107194/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The 2,353 controls were derived from Queensland or Melbourne: for the former, the controls came from the Brisbane Twin Nevus Study [16]; for the latter, individuals were participants in the Genes in Myopia study [17].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001550"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study of the Queensland Institute of Medical Research (QIMR) in Brisbane, Australia, that from 1992 to 2016 examined annual new samples of 12-year-old twins from south-east Queensland, with their siblings nearest in age, counting their naevi and recording their sun behaviour, and re-examined them two years later; set up to investigate genetic factors in naevus development and other risk factors for melanoma, it also includes the twins&apos; parents and is the twin mole study of the Brisbane Longitudinal Twin Study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24949998</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28764680</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40576277</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41807453</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
