    <!-- http://www.ebi.ac.uk/coho/COHO_0001581 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001581">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:27409342</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of endometrial cancer conducted in Connecticut, United States, from December 2004 to March 2009 by investigators at the Yale School of Public Health and Yale Cancer Center, which enrolled women aged 35–80 newly diagnosed with primary endometrial cancer from October 2004 through September 2008, identified at 28 Connecticut hospitals by the Yale Cancer Center Rapid Case Ascertainment Shared Resource, and controls frequency-matched on age and found by random-digit dialling, who were interviewed at home and gave biological specimens, to study risk factors for endometrial cancer.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CECS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CONN</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Connecticut Endometrial Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001581"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27409342</owl:annotatedTarget>
        <dcterms:title>Meta-dimensional data integration identifies critical pathways for susceptibility, tumorigenesis and progression of endometrial cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27409342</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5342415/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We obtained data from Connecticut Endometrial Cancer Study (CECS) [68], a population-based case-control study on 668 incident cases with type I endometrial cancer and 674 population controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
