    <!-- http://www.ebi.ac.uk/coho/COHO_0000538 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000538">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001398"/>
