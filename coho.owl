        <obo:IAO_0000112>GCST90244787</obo:IAO_0000112>
        <obo:IAO_0000115>A birth cohort of children born in 1990 and recruited in the maternity wards of university hospitals in five German cities (Berlin, Düsseldorf, Freiburg, Mainz and Munich), enriched for newborns at high risk of allergy, with two allergic immediate family members or raised cord-blood IgE, alongside a random sample of low-risk newborns, and followed with repeated examinations and questionnaires from infancy into adulthood to study the course of asthma, allergic rhinitis, eczema and allergic sensitisation.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>G.MAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>German Multicentre Allergy Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>German multicentre atopy study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MAS-90</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Multicenter Allergy Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Multicentre Allergy Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">German Multicenter Allergy Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
