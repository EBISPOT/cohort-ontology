        <owl:annotatedTarget>PMID:34897183</owl:annotatedTarget>
        <dcterms:title>Public Access to Summary Statistics for Genome-wide Association Studies of Body Mass Index, Weight, and Height Among Healthy Japanese Individuals: The Japanese Consortium of Genetic Epidemiology Studies.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34897183</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8761561/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The J-CGE consists of data analyzed among healthy participants from the Tohoku Medical Megabank Community-Based Cohort (TMM) Study, the Japan Public Health Centre-based Prospective (JPHC) Study, the Japan Multi-Institutional Collaborative Cohort (J-MICC) Study, and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center (HERPACC) Study (Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000782"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium of Japanese population-based and hospital-based studies — the Tohoku Medical Megabank Community-Based Cohort Study, the Japan Public Health Center-based Prospective Study, the Japan Multi-Institutional Collaborative Cohort Study and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center — that pools genome-wide genotype data on healthy participants for genetic epidemiology, including genome-wide association studies of body mass index, height and weight.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34897183</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
