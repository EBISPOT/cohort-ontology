    <!-- http://www.ebi.ac.uk/coho/COHO_0001383 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001383">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90565134</obo:IAO_0000112>
        <obo:IAO_0000115>A biobank of biological samples, including DNA, and clinical information from volunteers in the United States with psoriasis or psoriatic arthritis and from unaffected controls. The National Psoriasis Foundation created it in 2006, with the financial backing of the Henschel family, to advance genetic research on psoriatic disease. Its samples were made available to researchers internationally for case-control and family studies until the biobank was retired in 2025.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Henschel Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NPF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Psoriasis Foundation Victor Henschel Tissue Repository</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Psoriasis Victor Henschel Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Victor Henschel Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">National Psoriasis Victor Henschel BioBank</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001383"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90565134</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genome-wide meta-analysis with 472,819 individuals identifies 32 novel risk loci for psoriasis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39885523</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11783861/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>For the PsA GWAS, 1,526 PsA case subjects and 1,508 unaffected control subjects North American (American and Canadian population) were recruited by four collection centers—Michigan, Toronto, Newfoundland, and the National Psoriasis Foundation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001383"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A biobank of biological samples, including DNA, and clinical information from volunteers in the United States with psoriasis or psoriatic arthritis and from unaffected controls. The National Psoriasis Foundation created it in 2006, with the financial backing of the Henschel family, to advance genetic research on psoriatic disease. Its samples were made available to researchers internationally for case-control and family studies until the biobank was retired in 2025.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26626624</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32725812</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.psoriasis.org/victor-henschel-biobank/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
