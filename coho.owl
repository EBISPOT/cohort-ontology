    <!-- http://www.ebi.ac.uk/coho/COHO_0001560 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001560">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>PMID:25279460</obo:IAO_0000112>
        <obo:IAO_0000115>A Finnish three-generation family study run by researchers at the University of Jyväskylä, built on the Calex study, a cohort of girls recruited in school grades 4 to 6 through schools in the city of Jyväskylä and its surroundings in Central Finland (some of whom first took part in a two-year randomised calcium, vitamin D and dairy supplementation trial) and followed through puberty for about 7.5 years; in 2007–2008 the girls, then young women, and their brothers, mothers, fathers, grandmothers and grandfathers were invited to the same bone, body-composition and blood measurements, to study the heritability and determinants of bone mass, body composition and related metabolic traits across generations.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CALEX family study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CALEX-FAM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Calex family study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Calex-family</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Calex-family study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">CALEX-family study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001560"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25279460</owl:annotatedTarget>
        <dcterms:title>The associations of serum serotonin with bone traits are age- and gender-specific.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25279460</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4184839/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects were part of the CALEX-family study and comprised 235 young women, 121 premenopausal women, 124 postmenopausal women, and 168 men.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001560"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Finnish three-generation family study run by researchers at the University of Jyväskylä, built on the Calex study, a cohort of girls recruited in school grades 4 to 6 through schools in the city of Jyväskylä and its surroundings in Central Finland (some of whom first took part in a two-year randomised calcium, vitamin D and dairy supplementation trial) and followed through puberty for about 7.5 years; in 2007–2008 the girls, then young women, and their brothers, mothers, fathers, grandmothers and grandfathers were invited to the same bone, body-composition and blood measurements, to study the heritability and determinants of bone mass, body composition and related metabolic traits across generations.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19171028</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24358145</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25279460</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26439744</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001560"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CALEX-FAM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001560"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4184839/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, 235 Finnish young women (mean age 18.3 yrs, range 16.1–21.4 yrs) participated in the laboratory tests in the year 2007–8.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001561 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001561">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Mexico"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>PMID:31553449</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case–control study of breast cancer in Mexican women aged 35 to 69, carried out from January 2004 to December 2007 in Mexico City, Monterrey and Veracruz by investigators of the Mexican National Institute of Public Health, in which women with newly diagnosed, untreated breast cancer were recruited at twelve public hospitals of the Mexican Social Security Institute, the Institute of Security and Social Services of State Workers and the Ministry of Health, and controls, frequency-matched to the cases by age, health-care institution and region, were chosen by multistage random household sampling; participants were interviewed on health, diet and physical activity, measured and gave blood samples, to study risk factors for breast cancer in Mexico.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CAMA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CAMA-Mexican Breast Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cancer de Mama study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cáncer de Mama</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Cancer de Mama</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001561"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:31553449</owl:annotatedTarget>
        <dcterms:title>A Polygenic Risk Score for Breast Cancer in US Latinas and Latin American Women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31553449</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7301155/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Cancer de Mama (CAMA) study is a population-based case-control study of breast cancer in Mexico City, Monterrey, and Veracruz, Mexico.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001561"/>
