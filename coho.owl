        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ACCT</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001466"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12553408/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects were drawn from the ACCT (Anglo‐Cardiff Collaborative Trial) population, which consists of &gt;12 000 individuals, selected at random from local general practice lists and open‐access Cardiovascular Risk Assessment Clinics across East Anglia and Wales.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001467 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001467">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:33310085</obo:IAO_0000112>
        <obo:IAO_0000115>A genome-wide association study of alcohol-related cirrhosis in people of European descent that meta-analysed two case–control data sets, one from Germany and one from the United Kingdom, comparing patients with alcohol-related cirrhosis with drinking controls to find genetic risk loci for the disease; its discovery results were published in 2015 and its summary statistics have been reused by later studies of cirrhosis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ACG</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Alcoholic Cirrhosis GWAS</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001467"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33310085</owl:annotatedTarget>
        <dcterms:title>Association of Genetic Variation With Cirrhosis: A Multi-Trait Genome-Wide Association and Gene-Environment Interaction Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33310085</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8035329/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Individuals with cirrhosis were identified in two prospective cohorts (UK Biobank and Atherosclerosis Risk in Communities study), a medical center-based cohort (Vanderbilt BioVU) and two case-control studies from previously published genome wide association studies of alcohol-related cirrhosis.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001467"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genome-wide association study of alcohol-related cirrhosis in people of European descent that meta-analysed two case–control data sets, one from Germany and one from the United Kingdom, comparing patients with alcohol-related cirrhosis with drinking controls to find genetic risk loci for the disease; its discovery results were published in 2015 and its summary statistics have been reused by later studies of cirrhosis.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26482880</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33310085</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38727677</obo:IAO_0000119>
        <obo:IAO_0000119>http://gengastro.med.tu-dresden.de/suppl/alc_cirrhosis/</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3417/MediaObjects/41588_2015_BFng3417_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
