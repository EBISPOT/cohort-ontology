    <!-- http://www.ebi.ac.uk/coho/COHO_0001349 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001349">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>GCST002454</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of colorectal cancer in Guangzhou, China. Its cases are patients with histopathologically confirmed colorectal cancer recruited at Sun Yat-sen University Cancer Center between 2002 and 2012, and its controls are cancer-free men and women recruited in the same period from the physical examination centres of several large hospitals in Guangdong. Its four case-control collections (Guangzhou-1 to Guangzhou-4) were genotyped for genome-wide association studies of colorectal cancer in East Asians.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym Guangzhou also denotes Guangzhou cohort (COHO:0001348); this term is Guangzhou Colorectal Cancer Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>Asian Consortium, Colorectal Cancer Guangzhou</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Guangzhou</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Guangzhou CRC Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Guangzhou Colorectal Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001349"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST002454</owl:annotatedTarget>
        <dcterms:title>Large-scale genetic study in East Asians identifies six new loci associated with colorectal cancer risk.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:24836286</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4068797/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Specifically, stage 1 (GWAS discovery) consisted of five studies: Shanghai CRC Study 1 (Shanghai-1, n = 3,102), Shanghai CRC Study 2 (Shanghai-2, n = 908), Guangzhou CRC Study 1 (Guangzhou-1, n = 1,603), Aichi CRC Study 1 (Aichi-1, n =1,346), and Korean Cancer Prevention Study-II CRC (KCPS-II, n = 1,301).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001349"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of colorectal cancer in Guangzhou, China. Its cases are patients with histopathologically confirmed colorectal cancer recruited at Sun Yat-sen University Cancer Center between 2002 and 2012, and its controls are cancer-free men and women recruited in the same period from the physical examination centres of several large hospitals in Guangdong. Its four case-control collections (Guangzhou-1 to Guangzhou-4) were genotyped for genome-wide association studies of colorectal cancer in East Asians.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23263487</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24836286</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001349"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Guangzhou</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001349"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Cases were histopathologically confirmed patients with CRC recruited from Sun Yat-Sen University Cancer Center between January 2002 and January 2012 and controls were cancer-free men and women recruited from the physical examination centers of several large hospitals in Guangdong during the same time period.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001350 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001350">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90269914</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre longitudinal study, established in 1988 at 14 hemophilia treatment centres in the United States, of boys and young men aged 6 to 19 years with moderate to severe hemophilia, HIV-infected through clotting factor concentrates or HIV-uninfected, with their non-hemophiliac, HIV-uninfected male siblings as a comparison group, followed until 1996/97 to study the impact of HIV on physical growth and sexual maturation, immune function, and neurological and neuropsychological functioning.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HGDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hemophilia Growth and Development Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001350"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90269914</owl:annotatedTarget>
        <dcterms:title>Africa-specific human genetic variation near CHD1L associates with HIV-1 load.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37532928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10848312/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The HGDS is a multicenter study of hemophilia and its complications that was established in 1988.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
