    <!-- http://www.ebi.ac.uk/coho/COHO_0001517 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001517">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:12791629</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of children born consecutively from March 1972 to October 1974 in the towns of Barry and Caerphilly, South Wales, whose mothers were recruited early in pregnancy through general practitioners into a randomised controlled trial, set up in 1972 by the Medical Research Council Epidemiology Unit (South Wales) and the Welsh National School of Medicine in Cardiff, of milk tokens for pregnant women and their children up to five years of age, with the children examined by trained nurses at intervals from birth to five years. The children who completed the trial were traced and re-examined at 23–27 years of age in 1997–1999 to study how birth size, infant feeding, early growth and childhood illness relate to adult blood pressure, adiposity, insulin resistance, haemostatic factors and lung function.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BCG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Barry Caerphilly Growth study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Barry-Caerphilly Growth Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Barry Caerphilly Growth Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001517"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:12791629</owl:annotatedTarget>
        <dcterms:title>Infant nutrition and blood pressure in early adulthood: the Barry Caerphilly Growth study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:12791629</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12791629+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a long-term follow-up (1997-1999) of the Barry Caerphilly Growth study cohort (1972-1974) into which mothers and their offspring had originally been randomly assigned to receive a milk supplement or usual care.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001517"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of children born consecutively from March 1972 to October 1974 in the towns of Barry and Caerphilly, South Wales, whose mothers were recruited early in pregnancy through general practitioners into a randomised controlled trial, set up in 1972 by the Medical Research Council Epidemiology Unit (South Wales) and the Welsh National School of Medicine in Cardiff, of milk tokens for pregnant women and their children up to five years of age, with the children examined by trained nurses at intervals from birth to five years. The children who completed the trial were traced and re-examined at 23–27 years of age in 1997–1999 to study how birth size, infant feeding, early growth and childhood illness relate to adult blood pressure, adiposity, insulin resistance, haemostatic factors and lung function.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:12791629</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:17921364</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22479550</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23790346</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:7030223</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001517"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BCG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001517"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17921364+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a longitudinal study of young adults from Barry and Caerphilly, United Kingdom, who had previously taken part between 1972 and 1974 in a randomized controlled trial of milk supplementation.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001518 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001518">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Israel"/>
        <obo:IAO_0000112>PMID:20567021</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of breast cancer in northern Israel, conducted by the Clalit National Cancer Control Center in Haifa with family medicine, surgery, pathology and oncology teams across the region, which since January 2000 has enrolled consecutively diagnosed breast cancer patients living in a defined area of northern Israel and cancer-free controls randomly selected from the Clalit Health Services register of insured people in the same area, matched on age, ethnic group and primary care clinic. Participants are interviewed about their medical history, medication use and health habits and give a blood sample, for studies of breast cancer risk factors, including genetic ones.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BCINIS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Breast Cancer In Northern Israel Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Breast Cancer in Northern Israel Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001518"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20567021</owl:annotatedTarget>
        <dcterms:title>Use of bisphosphonates and risk of postmenopausal breast cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20567021</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20567021+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Breast Cancer in Northern Israel Study is a population-based case-control study in northern Israel of patients with breast cancer and age-, clinic-, and ethnic-group matched controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001518"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of breast cancer in northern Israel, conducted by the Clalit National Cancer Control Center in Haifa with family medicine, surgery, pathology and oncology teams across the region, which since January 2000 has enrolled consecutively diagnosed breast cancer patients living in a defined area of northern Israel and cancer-free controls randomly selected from the Clalit Health Services register of insured people in the same area, matched on age, ethnic group and primary care clinic. Participants are interviewed about their medical history, medication use and health habits and give a blood sample, for studies of breast cancer risk factors, including genetic ones.</owl:annotatedTarget>
