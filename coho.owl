    <!-- http://www.ebi.ac.uk/coho/COHO_0000514 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000514">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90711144</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre observational cohort of about 10,000 non-Hispanic white and African American current and former smokers with and without COPD, aged 45-80, enrolled at 21 clinical centres across the United States and followed longitudinally with chest CT imaging and genome-wide genotyping to identify genetic factors and CT-defined subtypes of COPD.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>COPDGene</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COPDGene study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Chronic Obstructive Pulmonary Disease Gene Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Epidemiology of COPD study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetic Epidemiology of COPD</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000514"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90711144</owl:annotatedTarget>
        <dcterms:title>Association of PHACTR1 with Coronary Artery Calcium Differs by Sex and Cigarette Smoking.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39057616</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11276683/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>we performed GWA analyses of CAC among all participants and stratified by sex in the Genetic Epidemiology of COPD (COPDGene) study, a large cohort of current and former smokers enriched with COPD cases</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000514"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre observational cohort of about 10,000 non-Hispanic white and African American current and former smokers with and without COPD, aged 45-80, enrolled at 21 clinical centres across the United States and followed longitudinally with chest CT imaging and genome-wide genotyping to identify genetic factors and CT-defined subtypes of COPD.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20214461</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37241208</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000514"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>COPDGene</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000514"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10221198/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>COPDGene enrolled 10,198 former and current smokers aged 45–80 years with a history of ≥10 pack-year smoking with and without COPD from initiation in P1 from 21 clinical centers across the United States (Figure 1) [4].</rdfs:comment>
    </owl:Axiom>
    


