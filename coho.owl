    <!-- http://www.ebi.ac.uk/coho/COHO_0001520 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001520">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:40101186</obo:IAO_0000112>
        <obo:IAO_0000115>A single-centre case-control study of endometrial cancer at the University Hospital Erlangen in Bavaria, Germany, conducted between 2002 and 2008 to investigate genetic and epidemiological risk factors for endometrial cancer, whose cases were incident cases referred to the hospital by surrounding practitioners or prevalent cases approached during follow-up care after treatment there for primary endometrial cancer, with epidemiological information from a structured interview questionnaire and clinical data from health records.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BECS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bavarian Endometrial Cancer Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Bavarian Endometrial Cancer Cases and Controls Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001520"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40101186</owl:annotatedTarget>
        <dcterms:title>A Swedish genome-wide haplotype association analysis identifies novel candidate loci associated with endometrial cancer risk.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40101186</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13537468/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Replication analysis in the German population included 221 cases from the Bavarian Endometrial Cancer Study (BECS) and 251 healthy controls aged 55 years and older from the Bavarian Breast Cancer Cases and Controls (BBCC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001520"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A single-centre case-control study of endometrial cancer at the University Hospital Erlangen in Bavaria, Germany, conducted between 2002 and 2008 to investigate genetic and epidemiological risk factors for endometrial cancer, whose cases were incident cases referred to the hospital by surrounding practitioners or prevalent cases approached during follow-up care after treatment there for primary endometrial cancer, with epidemiological information from a structured interview questionnaire and clinical data from health records.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27135401</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
