        <obo:IAO_0000112>GCST90128543</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal study of Dutch twin families recruited from the Netherlands Twin Register, starting with 112 families of 9-year-old twins and an older sibling who were assessed at three-year intervals with IQ and neuropsychological tests, behavioural ratings, pubertal hormones, brain MRI and DNA collection, to study genetic and environmental influences on brain structure and cognition from childhood into adolescence.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Brain SCALE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BrainSCALE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Brainscale Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">BrainSCALE study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000508"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90128543</owl:annotatedTarget>
        <dcterms:title>Genetic variants associated with longitudinal changes in brain structure across the lifespan.</dcterms:title>
