        <obo:IAO_0000112>GCST90654647</obo:IAO_0000112>
        <obo:IAO_0000115>A US consortium that assembles genome-wide genotype data and harmonized phenotypes from many case-control, family-based, population-based and longitudinal Alzheimer disease cohorts, in more than 30 GWAS datasets of several ancestries, for genetic studies of late-onset Alzheimer disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ADGC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Alzheimer Disease Genetic Consortium</oboInOwl:hasRelatedSynonym>
