    <!-- http://www.ebi.ac.uk/coho/COHO_0001468 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001468">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:36522743</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal cohort of healthy community-dwelling volunteers in middle and old age, recruited in Greater Manchester and Newcastle upon Tyne, England, between 1983 and the early 1990s by the University of Manchester&apos;s Age and Cognitive Performance Research Centre to chart trajectories of cognitive function in normal old age; participants took alternating batteries of cognitive tests every two years until 2003, with questionnaires on health and behaviour repeated until 2017. Blood was collected for DNA extraction, a Manchester subsample was physically examined and gave saliva, serum and plasma in 2003, and some participants donated their brains to the Manchester Brain Bank.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ACPRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Age and Cognitive Performance Research Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Manchester Longitudinal Cognitive Ageing Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Manchester and Newcastle Age and Cognitive Performance Research Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Manchester and Newcastle Longitudinal Studies of Cognitive Ageing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Manchester and Newcastle Longitudinal Studies of Cognitive Aging</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UMLCHA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of Manchester Age and Cognitive Performance Research Cohort</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">University of Manchester Longitudinal Study of Cognition in Normal Healthy Old Age</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001468"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:36522743</owl:annotatedTarget>
        <dcterms:title>Amyloid-β and APOE genotype predict memory decline in cognitively unimpaired older individuals independently of Alzheimer&apos;s disease polygenic risk score.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36522743</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9753236/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>[28] The PreclinAD study recruited participants from two sites: the Manchester and Newcastle Age and Cognitive Performance Research Cohort (ACPRC) in Manchester [29] and the Netherlands Twin Register (NTR) [30] in Amsterdam.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001468"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal cohort of healthy community-dwelling volunteers in middle and old age, recruited in Greater Manchester and Newcastle upon Tyne, England, between 1983 and the early 1990s by the University of Manchester&apos;s Age and Cognitive Performance Research Centre to chart trajectories of cognitive function in normal old age; participants took alternating batteries of cognitive tests every two years until 2003, with questionnaires on health and behaviour repeated until 2017. Blood was collected for DNA extraction, a Manchester subsample was physically examined and gave saliva, serum and plasma in 2003, and some participants donated their brains to the Manchester Brain Bank.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21826061</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30075734</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31796669</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34113784</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40908294</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
