        <obo:IAO_0000115>A community-based longitudinal cohort of residents of the town and Shire of Busselton in south-western Western Australia, surveyed since 1966 and including related and unrelated individuals of predominantly European ancestry, whose 1994/95 follow-up provided blood samples for genetic studies of cardiovascular, respiratory and metabolic traits.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym BHS also denotes Bogalusa Heart Study (COHO:0000464) and Baependi Heart Study (COHO:0000623); this term is Busselton Health Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>BHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BSN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Busselton Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000389"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
