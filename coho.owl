        <oboInOwl:hasRelatedSynonym>MIRIAD IBD Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Material and Information Resources for Inflammatory and Digestive Diseases IBD Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
