    <!-- http://www.ebi.ac.uk/coho/COHO_0001402 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001402">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>GCST90319846</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of children from 24 low-income areas of Salvador, Bahia, in north-eastern Brazil, first enrolled aged 0–3 years in 1997, 2001 and 2003 to evaluate the health effects of the city&apos;s sanitation programme and followed from 2005, at ages 4–11, with further surveys (questionnaires, anthropometry, stool, blood and house-dust samples, skin prick tests and, later, genome-wide genotyping), to study social, environmental, infectious, immunological and genetic risk factors for asthma and allergic diseases; it is the Brazilian study of the Social Changes, Asthma and Allergy in Latin America (SCAALA) programme.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SCAALA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SCAALA cohort</oboInOwl:hasRelatedSynonym>
