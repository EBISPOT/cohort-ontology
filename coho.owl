        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-025-02954-w/MediaObjects/41380_2025_2954_MOESM2_ESM.docx</oboInOwl:hasDbXref>
        <rdfs:comment>DIAbetes COhoRtE (DIACORE): is a German prospective cohort study of 3,000 adult European diabetes mellitus type 2 outpatients, with a primary focus on renal events.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000548"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of about 3,000 adult outpatients of self-reported Caucasian ethnicity with prevalent type 2 diabetes, recruited in 2010–2014 at two university-based study centres in Germany and followed with biennial visits, core phenotyping and biobanking for at least 10 years to study diabetes complications, with a primary focus on renal events.</owl:annotatedTarget>
