        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90502911</obo:IAO_0000112>
        <obo:IAO_0000115>A clinical and genetic registry at Vanderbilt University Medical Center in Nashville, Tennessee, United States, founded in 2001, that prospectively enrols patients with atrial fibrillation together with affected and unaffected family members, recording a detailed medical and drug history, an atrial fibrillation symptom severity assessment and a blood sample for DNA, and follows them with serial symptom assessments; its early-onset cases were whole-genome sequenced by the NHLBI TOPMed programme.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>VU_AF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Vanderbilt AF Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Vanderbilt Genetic Basis of Atrial Fibrillation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Vanderbilt Atrial Fibrillation Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001249"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
