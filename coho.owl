    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000618"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90301397</owl:annotatedTarget>
        <dcterms:title>Germline genetic regulation of the colorectal tumor immune microenvironment.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38664626</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11046907/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To evaluate the contribution of germline genetics to regulating the briskness and diversity of T cell responses in CRC, we conducted a genome-wide association study to examine the associations between germline genetic variation and quantitative measures of T cell landscapes in 2,876 colorectal tumors from participants in the Molecular Epidemiology of Colorectal Cancer Study (MECC).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000618"/>
