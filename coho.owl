    <!-- http://www.ebi.ac.uk/coho/COHO_0001441 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001441">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <obo:IAO_0000112>GCST90270268</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal community-based observational study, commissioned by the town and conducted since 2011 by Kanazawa University, of residents of Shika Town on the Noto Peninsula, Ishikawa Prefecture, Japan, which aims to find ways of preventing lifestyle-related diseases: residents aged 40 and over in four model districts of the town complete questionnaires on diet, lifestyle and health and undergo a comprehensive health examination, with blood taken for biochemical tests and DNA.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym SHIP also denotes Study of Health in Pomerania (COHO:0000202); this term is Shikamachi health improvement practice genome cohort study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>SHIKA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SHIP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SHIP genome cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SHIP_Shikamachi</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Shika study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Shika-machi Super Preventive Health Examination</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Shikamachi Health Improvement Practice genome cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Shikamachi health improvement practice genome cohort study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001441"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90270268</owl:annotatedTarget>
        <dcterms:title>Genetic factors associated with serum amylase in a Japanese population: combined analysis of copy-number and single-nucleotide variants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36599956</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10125868/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study was part of the Shikamachi health improvement practice (SHIP) genome cohort study, a longitudinal observational study of the residents of Shika Town, located in Ishikawa Prefecture, Japan, as previously described [25].</rdfs:comment>
    </owl:Axiom>
