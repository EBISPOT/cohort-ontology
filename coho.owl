        <oboInOwl:hasRelatedSynonym>SiDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sikh Diabetes Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
