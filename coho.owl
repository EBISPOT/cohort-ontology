    <!-- http://www.ebi.ac.uk/coho/COHO_0001183 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001183">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90568440</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal, population-based study of children from 11 predominantly rural counties of western North Carolina, United States, recruited in 1993 as three cohorts aged 9, 11 and 13 through a two-phase design that screened a random sample of children for behavioural problems and oversampled those with high scores, together with all age-eligible American Indian children of the area. The participants were interviewed annually to age 16 and then repeatedly into adulthood, to study the development of psychiatric and substance use disorders and the need for and use of mental health services.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GSMS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Great Smoky Mountains Study of Youth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Great Smoky Mountains Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001183"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90568440</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of childhood ADHD symptoms and diagnosis identifies new loci and potential effector genes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40962958</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02295-y/MediaObjects/41588_2025_2295_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Great Smoky Mountains Study is a longitudinal, representative study of 1420 children in 11 210 predominantly rural counties in Southeastern United States 21,22 .</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001183"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal, population-based study of children from 11 predominantly rural counties of western North Carolina, United States, recruited in 1993 as three cohorts aged 9, 11 and 13 through a two-phase design that screened a random sample of children for behavioural problems and oversampled those with high scores, together with all age-eligible American Indian children of the area. The participants were interviewed annually to age 16 and then repeatedly into adulthood, to study the development of psychiatric and substance use disorders and the need for and use of mental health services.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23461817</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24342383</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:8956679</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001183"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GSMS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001183"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:8956679%20AND%20SRC:MED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A multistage, overlapping cohorts design was used, in which 4500 of the 11758 children aged 9, 11, and 13 years in an 11-county area of the southeastern United States were randomly selected for screening for psychiatric symptoms.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001184 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001184">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>GCST90132298</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of patients aged 5 to 85 who presented with acute appendicitis at the emergency department of Jessa Hospital in Hasselt, Belgium, and had an appendectomy, recruited from June 2012 to October 2016 in a study led by Hasselt University with Jessa Hospital and Radboud University Medical Center. Questionnaires on diet, lifestyle and environment were collected together with blood, appendix tissue and stool samples, to study how environmental factors, the innate immune system and its genetic make-up, and the gut microbiota influence the development and severity of acute appendicitis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HAPPIEST</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HAPPIEST cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Hasselt APPendicitis Immunologic and Environmental STudy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Hasselt APPendicitis Immunology and Environmental Cohort STudy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hasselt Appendicitis Immunology and Environmental Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001184"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90132298</owl:annotatedTarget>
        <dcterms:title>Impact of Human Genetic Variation on C-Reactive Protein Concentrations and Acute Appendicitis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35693796</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9174512/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 325 patients were prospectively recruited in the HAPPIEST population at Jessa Hospital, Hasselt, Belgium, between June 2012 and October 2016.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001184"/>
