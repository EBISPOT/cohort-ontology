    <!-- http://www.ebi.ac.uk/coho/COHO_0001606 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001606">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Colombia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Mexico"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>PMID:31553449</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control study of breast cancer in Latin American women, led by investigators at the Universidad del Tolima in Ibagué, Colombia, and the University of California, Davis. From 2011 it recruited women with incident invasive breast cancer, through population cancer registries and large cancer hospitals in Bogotá, Ibagué and Neiva in central Colombia and Pasto in the south, together with cancer-free controls from the same institutions matched on education, socioeconomic status and local origin. A Mexican arm comprises cases diagnosed from 2010 at the Social Security hospital in Mexico City, with blood-donor controls from the same hospital. The study investigates inherited and environmental causes of breast cancer, and its Colombian and Mexican arms, genotyped on different arrays, are analysed as separate datasets.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>COLUMBUS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COLUMBUS Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Colombian Study of Environmental and Heritable Causes of Breast Cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Post Columbian Study of Environmental and Heritable Causes of Breast Cancer</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Post-Columbian Study of Environmental and Heritable Causes of Breast Cancer</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:31553449</owl:annotatedTarget>
        <dcterms:title>A Polygenic Risk Score for Breast Cancer in US Latinas and Latin American Women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:31553449</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7301155/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Post-Columbian Study of Environmental and Heritable Causes of Breast Cancer (COLUMBUS) is a case-control study of breast cancer with individuals recruited throughout large cancer hospitals in central and 3 southern Colombia and Mexico City.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001606"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case–control study of breast cancer in Latin American women, led by investigators at the Universidad del Tolima in Ibagué, Colombia, and the University of California, Davis. From 2011 it recruited women with incident invasive breast cancer, through population cancer registries and large cancer hospitals in Bogotá, Ibagué and Neiva in central Colombia and Pasto in the south, together with cancer-free controls from the same institutions matched on education, socioeconomic status and local origin. A Mexican arm comprises cases diagnosed from 2010 at the Social Security hospital in Mexico City, with blood-donor controls from the same hospital. The study investigates inherited and environmental causes of breast cancer, and its Colombian and Mexican arms, genotyped on different arrays, are analysed as separate datasets.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25327703</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31553449</obo:IAO_0000119>
