        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3374121/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The case–control study was the French Prostate Case–Control Study (CeRePP, Centre de Recherche pour les Pathologies Prostatiques, from France) (Valeri et al. 2003).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001301 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001301">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>GCST90271928</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study of people with cystic fibrosis and their parents in Canada, led from the Hospital for Sick Children in Toronto, which recruited patients without regard to genotype or lung function through specialised CF clinics across the country, first from 2003 to 2006 and then in a second phase, with clinical data from clinic records and DNA for genome-wide genotyping and sequencing, to identify genetic modifiers of cystic fibrosis lung disease and of complications such as meconium ileus, liver disease and CF-related diabetes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CGMS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian CF Gene Modifier Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian CF Modifier Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian Consortium for Genetic Studies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian Cystic fibrosis Gene Modifier Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian Gene Modifier Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Canadian Cystic Fibrosis Gene Modifier Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
