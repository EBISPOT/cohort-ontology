        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The DietBB sample included in this GWAS is a subsample extracted from the AgeCoDe cohort in the context of an ongoing genome-wide methylation analysis for dementia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
