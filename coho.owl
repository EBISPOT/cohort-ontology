        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A network of cohorts of African ancestry and of other populations under-represented in genome-wide association studies, whose consortia meta-analyse the cohorts&apos; genome-wide data to find genetic variants for complex traits, such as white blood cell count, blood pressure and hypertension in African-ancestry cohorts (COGENT-BP) and kidney traits across diverse ancestries (COGENT-Kidney, established in 2014).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21738479</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32571486</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
