        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001010"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90565869</owl:annotatedTarget>
        <dcterms:title>Sex-stratified genome-wide association meta-analysis of major depressive disorder.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40858613</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12381276/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The GLAD+ Study combines two United Kingdom (UK) cohorts: the Genetic Links to Anxiety and Depression (GLAD) Study and the National Institute for Health and Care Research (NIHR) BioResource COVID-19 Psychiatry and Neurological Genetics (COPING) Study.</rdfs:comment>
    </owl:Axiom>
