        <oboInOwl:hasRelatedSynonym>Pelotas Birth Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pelotas birth cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
