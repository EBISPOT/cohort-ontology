        <obo:IAO_0000112>GCST90129576</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of breast cancer in women of the Greater Bonn region, Germany, run by the GENICA network of German research institutions, in which incident cases, enrolled from all hospitals of the region in 2000–2004 within six months of diagnosis, and controls drawn from the population registries of 31 communities of the region and matched in five-year age classes were interviewed and gave blood, to study how genes and environmental exposures interact in breast cancer.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GENICA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gene Environment Interactions and Breast Cancer study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gene-ENvironment Interaction and breast CAncer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>gene environment interaction and breast cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Gene Environment Interaction and Breast Cancer in Germany</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
