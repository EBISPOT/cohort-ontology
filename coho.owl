        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001510"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A UK case-control study of breast cancer, led by investigators at the Institute of Cancer Research and the London School of Hygiene and Tropical Medicine, which in 2001–2008 recruited women with bilateral breast cancer identified through English and Scottish cancer registries and breast cancer clinics, and clinic patients with breast cancer and at least two affected female first-degree relatives, together with controls who were friends or non-blood relatives of the cases. It is one of the studies of the Breast Cancer Association Consortium.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:16257342</obo:IAO_0000119>
