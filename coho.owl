        <owl:annotatedTarget>J-MICC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000571"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7938099/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Japan Multi-Institutional Collaborative Cohort (J-MICC) Study is a large population-based genome cohort study in which about 100,000 participants from 15 study areas of Japan are being followed up for 20 years for cancer incidence.</rdfs:comment>
