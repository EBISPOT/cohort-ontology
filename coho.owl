    <!-- http://www.ebi.ac.uk/coho/COHO_0000749 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000749">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <obo:IAO_0000112>GCST90239710</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of lung cancer in the Lombardy region of Italy, which enrolled 2,101 incident primary lung cancer cases from 13 hospitals and 2,120 matched population controls in 2002–2005, collecting epidemiological, clinical and molecular data and biospecimens to study lung cancer aetiology from smoking addiction to outcome.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym EAGLE also denotes EArly Genetics and Lifecourse Epidemiology consortium (COHO:0000750) and EAGLE BioVU (COHO:0000751); this term is Environment And Genetics in Lung cancer Etiology study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>EAGLE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAGLE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Environment and Genetics in Lung Cancer Etiology Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Environment And Genetics in Lung cancer Etiology study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000749"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90239710</owl:annotatedTarget>
        <dcterms:title>Genome-wide interaction analysis identified low-frequency variants with sex disparity in lung cancer risk.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35138370</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9402242/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The EAGLE study was supported by the intramural program of the Division of Cancer Epidemiology and Genetics, National Cancer Institute, NIH.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000749"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of lung cancer in the Lombardy region of Italy, which enrolled 2,101 incident primary lung cancer cases from 13 hospitals and 2,120 matched population controls in 2002–2005, collecting epidemiological, clinical and molecular data and biospecimens to study lung cancer aetiology from smoking addiction to outcome.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18538025</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000749"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>EAGLE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000749"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18538025+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Between 2002 and 2005, we enrolled 2101 incident primary lung cancer cases and 2120 population controls, with 86.6% and 72.4% participation rate, respectively, from a catchment area including 216 municipalities in the Lombardy region of Italy.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000750 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000750">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>GCST90503108</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of population-based pregnancy and birth cohort studies, set up alongside the Early Growth Genetics consortium, that pools genome-wide data to study the genetic basis of phenotypes from fetal life into adolescence such as asthma, eczema, childhood psychopathology, cognition and neurodevelopment.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym EAGLE also denotes Environment And Genetics in Lung cancer Etiology study (COHO:0000749) and EAGLE BioVU (COHO:0000751); this term is EArly Genetics and Lifecourse Epidemiology consortium.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>EAGLE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EAGLE consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EArly Genetics Lifecourse Epidemiology consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EGLE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">EArly Genetics and Lifecourse Epidemiology consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000750"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90503108</owl:annotatedTarget>
        <dcterms:title>Integration of GWAS, QTLs and keratinocyte functional assays reveals molecular mechanisms of atopic dermatitis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40164604</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The EArly Genetics and Lifecourse Epidemiology (EAGLE) Consortium AD meta-analysis published by Paternoster et al in ref. 12, performed fixed-effect GWAS meta-analysis on ~21,000 cases and 95,000 controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000750"/>
