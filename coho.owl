    <!-- http://www.ebi.ac.uk/coho/COHO_0000852 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000852">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
