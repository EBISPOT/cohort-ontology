    <!-- http://www.ebi.ac.uk/coho/COHO_0001344 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001344">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90091054</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control collection of self-reported African American children and adults with physician-diagnosed asthma and non-asthmatic controls from the Baltimore–Washington, DC metropolitan area, brought together by the Genomic Research on Asthma in the African Diaspora consortium from eight NIH-funded asthma studies and one study of healthy African Americans, to study genetic contributions to asthma and its disparities in people of African descent.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GRAAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genomic Research on Asthma in the African Diaspora study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genomic Research on Asthma in the African Diaspora</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001344"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90091054</owl:annotatedTarget>
        <dcterms:title>Multiethnic genome-wide and HLA association study of total serum IgE level.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34536413</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://ars.els-cdn.com/content/image/1-s2.0-S009167492101397X-mmc1.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>the Genomic Research on Asthma in the African Diaspora (GRAAD) consortium that recruited African American children and adults from the Baltimore-Washington DC metropolitan area [10]</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001344"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control collection of self-reported African American children and adults with physician-diagnosed asthma and non-asthmatic controls from the Baltimore–Washington, DC metropolitan area, brought together by the Genomic Research on Asthma in the African Diaspora consortium from eight NIH-funded asthma studies and one study of healthy African Americans, to study genetic contributions to asthma and its disparities in people of African descent.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19910028</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30787307</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34536413</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001344"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GRAAD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001344"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://ars.els-cdn.com/content/image/1-s2.0-S009167492101397X-mmc1.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>We note that the Amish, FHS, CAG and GRAAD are US-based studies; the Amish is a European descent population isolate [1], the FHS study recruited participants of European descent [5], and the CAG and GRAAD studies recruited African American individuals [2].</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001345 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001345">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90310240</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre observational study in the United States, solicited by the National Heart, Lung, and Blood Institute and run by a genomics and informatics centre with several clinical centres, that enrolled adults with sarcoidosis across defined clinical phenotypes and adults over 35 with the PiZZ or PiMZ alpha-1 antitrypsin genotypes, with questionnaires, chest CT, lung function tests, bronchoalveolar lavage and blood samples, to study the role of the lung microbiome and genome-wide gene expression in the two diseases.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GRADS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genomic Research in Alpha-1 Antitrypsin Deficiency and Sarcoidosis study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genomic Research in Alpha-1 Antitrypsin Deficiency and Sarcoidosis Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001345"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90310240</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies multiple HLA loci for sarcoidosis susceptibility.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37399103</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC10407706/</oboInOwl:hasDbXref>
        <rdfs:comment>DNA samples from sarcoidosis cases and controls were obtained from National Jewish Health (NJH), University of California, San Francisco, Genomic Research in Alpha-1 Antitrypsin Deficiency and Sarcoidosis (GRADS) consortium (17) and Cleveland Clinic Foundation.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001345"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre observational study in the United States, solicited by the National Heart, Lung, and Blood Institute and run by a genomics and informatics centre with several clinical centres, that enrolled adults with sarcoidosis across defined clinical phenotypes and adults over 35 with the PiZZ or PiMZ alpha-1 antitrypsin genotypes, with questionnaires, chest CT, lung function tests, bronchoalveolar lavage and blood samples, to study the role of the lung microbiome and genome-wide gene expression in the two diseases.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26153726</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26193069</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35806883</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001345"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GRADS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001345"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9267453/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>GRADS recruited 368 patients with sarcoidosis from 9 sarcoidosis centers across the United States [27].</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001346 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001346">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>GCST90824165</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of DNA samples, established in France in 1995, from HIV-1-infected people of European descent living in France with extreme courses of infection: long-term non-progressors (infected for more than eight years with CD4 T-cell counts above 500/mm3 and no symptoms) and rapid progressors. It is used to identify host genes associated with slow and rapid progression to AIDS, with genetic analyses comparing its members with seronegative French controls from another study.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GRIV</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Resistance to Immunodeficiency Virus</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genomics of Resistance to Immunodeficiency Virus</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001346"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90824165</owl:annotatedTarget>
        <dcterms:title>Multiancestry Genome-Wide Association Study Identifies Variants in a Zinc Finger Gene Cluster as Novel Regulators of HIV Control.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41640362</oboInOwl:hasDbXref>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001346"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of DNA samples, established in France in 1995, from HIV-1-infected people of European descent living in France with extreme courses of infection: long-term non-progressors (infected for more than eight years with CD4 T-cell counts above 500/mm3 and no symptoms) and rapid progressors. It is used to identify host genes associated with slow and rapid progression to AIDS, with genetic analyses comparing its members with seronegative French controls from another study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21750674</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26367535</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38146367</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001346"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GRIV</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001346"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21811574+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>However, three independent SNPs in the top ten associations between SNP genotypes and time between seroconversion and AIDS-diagnosis, and one from the top ten associations between SNP genotypes and time between seroconversion and AIDS-related death, had P-values smaller than 0.05 in the French Genomics of Resistance to Immunodeficiency Virus cohort on disease progression.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001347 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001347">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>GCST90319888</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal twin study in Guangzhou, China, that from 2006 enrolled twin pairs aged 7 to 15 years from the population-based Guangzhou Twin Registry, living near the Zhongshan Ophthalmic Center, together with some of their parents or siblings. It collected DNA and baseline eye measurements, then examined the twins annually until 2018 for progressive traits such as cycloplegic refraction, axial length, height and weight, to study the genetic and environmental causes of common eye diseases, particularly myopia.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GTES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Guangzhou Twins Eye Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Guangzhou twin eye study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Guangzhou Twin Eye Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001347"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90319888</owl:annotatedTarget>
        <dcterms:title>Novel loci for ocular axial length identified through extreme-phenotype genome-wide association study in Chinese populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37524447</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37524447+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A genome-wide association study meta-analysis was conducted in totalling 2644 Chinese individuals from 3 cohorts: the Guangzhou cohort (GZ, 537 high myopes and 151 hyperopes), Wenzhou cohort (334 high myopes and 6 hyperopes) and Guangzhou Twin Eye Study (1051 participants with normally distributed AL).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001347"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal twin study in Guangzhou, China, that from 2006 enrolled twin pairs aged 7 to 15 years from the population-based Guangzhou Twin Registry, living near the Zhongshan Ophthalmic Center, together with some of their parents or siblings. It collected DNA and baseline eye measurements, then examined the twins annually until 2018 for progressive traits such as cycloplegic refraction, axial length, height and weight, to study the genetic and environmental causes of common eye diseases, particularly myopia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17254403</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23186635</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32014069</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41117591</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001347"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GTES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001347"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/China"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5118713/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Guangzhou Twins Eye Study (GTES) is a longitudinal study including over 1200 pairs of twins and their parents or siblings living in Guangzhou, China</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001348 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001348">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>GCST90319888</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of high myopes and hyperopes recruited in Guangzhou, China, one of three Chinese cohorts combined in a genome-wide association meta-analysis of ocular axial length.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym Guangzhou also denotes Guangzhou Colorectal Cancer Study (COHO:0001349); this term is Guangzhou cohort.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>GZ</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Guangzhou</oboInOwl:hasRelatedSynonym>
