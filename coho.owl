        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST005838</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective registry at the University of Miami that offers enrolment to consecutive patients admitted with stroke or transient ischaemic attack, a predominantly Hispanic and Black multiethnic population, contributing cases to the NINDS Stroke Genetics Network.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MIAMISR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Miami Stroke Registry and Biorepository</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Miami Stroke Registry</rdfs:label>
