    <!-- http://www.ebi.ac.uk/coho/COHO_0001566 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001566">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:12624278</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based prospective cohort study in Germany in which adults aged about 19 to 90, volunteers from among the members of a German primary health-care scheme, had vascular risk factors and carotid intima–media thickness measured by ultrasound at baseline and again after about three years, and were followed for about ten years for myocardial infarction, stroke, transient ischaemic attack and death, to study the progression of early carotid atherosclerosis and its value in predicting vascular events.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CAPS also denotes Cancer Prostate in Sweden (COHO:0000025) and Caerphilly Prospective Study (COHO:0001555); this term is Carotid Atherosclerosis Progression Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>CAPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CAPS_b</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Carotid Atherosclerosis Progression Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001566"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:12624278</owl:annotatedTarget>
        <dcterms:title>Promoter polymorphism in the endotoxin receptor (CD14) is associated with increased carotid atherosclerosis only in smokers: the Carotid Atherosclerosis Progression Study (CAPS).</dcterms:title>
        <oboInOwl:hasDbXref>PMID:12624278</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12624278+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Promoter polymorphism in the endotoxin receptor (CD14) is associated with increased carotid atherosclerosis only in smokers: the Carotid Atherosclerosis Progression Study (CAPS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001566"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based prospective cohort study in Germany in which adults aged about 19 to 90, volunteers from among the members of a German primary health-care scheme, had vascular risk factors and carotid intima–media thickness measured by ultrasound at baseline and again after about three years, and were followed for about ten years for myocardial infarction, stroke, transient ischaemic attack and death, to study the progression of early carotid atherosclerosis and its value in predicting vascular events.</owl:annotatedTarget>
