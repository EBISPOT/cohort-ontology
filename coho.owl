        <obo:IAO_0000119>PMID:18372903</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9614613</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
