        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7610439/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The LOLIPOP study is supported by the National Institute for Health Research (NIHR)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000567"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective population-based cohort of about 28,000 Indian Asian (South Asian) and European men and women aged 35 to 75, recruited in 2003-2008 from the lists of 58 general practitioners in West London, UK, with a structured cardiovascular and metabolic assessment and stored blood, to study the excess cardiometabolic risk of South Asians.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27195708</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33413638</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000567"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LOLIPOP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000567"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7789600/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The London Life Sciences Prospective Population Study (LOLIPOP) is a prospective cohort study of ~ 28000 Indian Asian and European men and women, recruited from the lists of 58 General Practitioners in West London, UK, between 2003 and 2008.</rdfs:comment>
    </owl:Axiom>
    


