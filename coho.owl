    <!-- http://www.ebi.ac.uk/coho/COHO_0001109 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001109">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Nigeria"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Western_Africa"/>
        <obo:IAO_0000112>GCST001263</obo:IAO_0000112>
        <obo:IAO_0000115>A Loyola University Chicago project on the genetics of hypertension in people of West African origin, whose genome-wide association sample consists of unrelated Yoruba-speaking adults with normal or raised blood pressure from Igbo-Ora, a rural town, and Idikan, a low-income neighbourhood of Ibadan, in southwest Nigeria, recruited as part of a long-term study of the environmental and genetic factors underlying hypertension; the Idikan participants were controls of the Africa America Diabetes Mellitus study.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Nigeria</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetics of Hypertension in Blacks</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001109"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST001263</owl:annotatedTarget>
        <dcterms:title>Identification, replication, and fine-mapping of Loci associated with adult height in individuals of african ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21998595</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3188544/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The meta-analysis included results from nine studies: four population-based African-American studies (ARIC (N = 2,740), CARDIA (N = 699), JHS (N = 2,119), and MESA (N = 1,646)), one family-based African-American study (CFS (N = 386)), African-American GWA study consortia of breast (AABC (N = 5,380)) and prostate cancer (AAPC (N = 5,526)) and two case-control studies of obesity (Maywood (N = 743)) and hypertension (Nigeria (N = 1,188)) (Materials and Methods, Text S1 and Table S1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001109"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Loyola University Chicago project on the genetics of hypertension in people of West African origin, whose genome-wide association sample consists of unrelated Yoruba-speaking adults with normal or raised blood pressure from Igbo-Ora, a rural town, and Idikan, a low-income neighbourhood of Ibadan, in southwest Nigeria, recruited as part of a long-term study of the environmental and genetic factors underlying hypertension; the Idikan participants were controls of the Africa America Diabetes Mellitus study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20400458</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21573225</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21998595</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22615923</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001109"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Nigeria</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001109"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Nigeria"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3353888/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Study participants were recruited from Yoruba-speaking communities in southwest Nigeria as part of a long-term study on the environmental and genetic factors underlying hypertension [10].</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001110 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001110">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
