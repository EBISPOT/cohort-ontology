        <obo:IAO_0000112>GCST90132189</obo:IAO_0000112>
        <obo:IAO_0000115>A sub-cohort of the Danish Childhood Diabetes Register (DanDiabKids) made up of individuals newly diagnosed with type 1 diabetes, whose serum was sampled within three months of clinical onset and who had been genotyped on the ImmunoChip array.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Steno</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Steno 2007</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000982"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90132189</owl:annotatedTarget>
        <dcterms:title>Genetic Variants Associated with Neuropeptide Y Autoantibody Levels in Newly Diagnosed Individuals with Type 1 Diabetes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35627254</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9142038/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The first sub-cohort, Steno 2007, consisted of 500 individuals with T1D, of which 77 were excluded due to insufficient material.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000982"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A sub-cohort of the Danish Childhood Diabetes Register (DanDiabKids) made up of individuals newly diagnosed with type 1 diabetes, whose serum was sampled within three months of clinical onset and who had been genotyped on the ImmunoChip array.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35627254</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000982"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>Steno</owl:annotatedTarget>
