    <!-- http://www.ebi.ac.uk/coho/COHO_0000840 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000840">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
