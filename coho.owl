    <!-- http://www.ebi.ac.uk/coho/COHO_0001469 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001469">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>PMID:32066700</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal naturalistic cohort of outpatients with bipolar disorder, launched in 2005 by the Karolinska Institutet and the St. Göran bipolar outpatient clinic (the Affective Center) of Northern Stockholm Psychiatry in Stockholm, Sweden, with a second centre in Gothenburg from 2009, which consecutively enrols patients treated at these clinics, with age- and sex-matched population controls randomly selected by Statistics Sweden. It combines clinical ratings, cognitive testing, blood and cerebrospinal fluid sampling, brain imaging and genetics, with follow-up planned at 7 and 14 years, to identify predictors of long-term outcome in bipolar disorder.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ACSGH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SBP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>St. Göran Project</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">St. Göran Bipolar Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001469"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32066700</owl:annotatedTarget>
        <dcterms:title>Genome-wide study of immune biomarkers in cerebrospinal fluid and serum from patients with bipolar disorder and controls.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32066700</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7026056/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Subjects were recruited from a long-term naturalistic study of bipolar disorder, the St. Göran Bipolar Project, at the bipolar outpatient unit at the Northern Stockholm psychiatric clinic in Stockholm, Sweden.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
