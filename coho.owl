    <!-- http://www.ebi.ac.uk/coho/COHO_0001519 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001519">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>PMID:27346685</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium of cohort studies and biobanks, organised in red blood cell, white blood cell and platelet working groups, that meta-analyses genetic associations with blood-cell counts and indices in participants of European, African, Hispanic/Latino, East Asian and South Asian ancestry, first with exome-array genotypes and later (its second phase, BCX2) with genome-wide imputed data, to identify common and rare variants that influence blood-cell traits.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BCX</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Blood Cell Consortium</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Blood-Cell Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001519"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27346685</owl:annotatedTarget>
        <dcterms:title>Exome Genotyping Identifies Pleiotropic Variants Associated with Red Blood Cell Traits.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27346685</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5005438/</oboInOwl:hasDbXref>
        <rdfs:comment>The Blood-Cell Consortium (BCX) aims to identify novel common and rare variants associated with blood-cell traits using an exome array.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001519"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium of cohort studies and biobanks, organised in red blood cell, white blood cell and platelet working groups, that meta-analyses genetic associations with blood-cell counts and indices in participants of European, African, Hispanic/Latino, East Asian and South Asian ancestry, first with exome-array genotypes and later (its second phase, BCX2) with genome-wide imputed data, to identify common and rare variants that influence blood-cell traits.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27346685</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27346686</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34925446</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
