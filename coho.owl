        <obo:IAO_0000115>A genotype-phenotype resource assembled at Mayo Clinic from participants of multiple Mayo Clinic research studies who gave general research consent to share their high-throughput genotyping data, linked to electronic medical record data for phenotype extraction, to enable cost-effective genome-wide association studies.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MayoGC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
