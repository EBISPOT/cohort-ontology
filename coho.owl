    <!-- http://www.ebi.ac.uk/coho/COHO_0000716 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000716">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90435154</obo:IAO_0000112>
        <obo:IAO_0000115>A biobank of patients with Crohn&apos;s disease or ulcerative colitis and non-IBD controls recruited with informed consent at Cedars-Sinai Medical Center in Los Angeles, United States, holding clinical phenotype, serological and genetic data and specimens for inflammatory bowel disease research.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CSMC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CSMC MIRIAD Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cedars-Sinai IBD Biobank</oboInOwl:hasRelatedSynonym>
