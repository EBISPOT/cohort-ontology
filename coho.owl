    <!-- http://www.ebi.ac.uk/coho/COHO_0001471 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001471">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>PMID:23001564</obo:IAO_0000112>
        <obo:IAO_0000115>A single-centre cohort study at Nancy University Hospital, France, of older treated hypertensive patients with subjective memory complaints, recruited in the early 2000s through local press advertisements and general practitioners of the Inserm clinical investigation centre network, who had cognitive testing, brain MRI for white matter hyperintensities, measurements of arterial stiffness, carotid structure and endothelial function, and DNA and serum banking, and were re-examined about eight years later (ADELAHYDE-2), to identify genetic, environmental and vascular determinants of leukoaraiosis and cognitive decline.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ADELAHYDE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADELAHYDE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADELAHYDE-Nancy study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Analyse des DEterminants génétiques et environnementaux de la Leucoaraïose dans une population à sujets Agés HYpertendus présentant des troubles cognitifs DEbutants</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Analyse des DEterminants génétiques et environnementaux de la Leucoaraiose dans une population de sujets Agés Hypertendus présentant des troubles cognitifs DEbutants</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001471"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23001564</owl:annotatedTarget>
        <dcterms:title>Genome-wide meta-analysis points to CTC1 and ZNF676 as genes regulating telomere homeostasis in humans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23001564</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510758/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Samples from the Jerusalem LRC Longitudinal Study (N = 620) (68), Health ABC study (N = 337) (69), from ADELAHYDE-Nancy study and ERA-France study (N = 316) (70,71) and from a Danish collection (N = 964) (47) were included in the replication stage.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001471"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A single-centre cohort study at Nancy University Hospital, France, of older treated hypertensive patients with subjective memory complaints, recruited in the early 2000s through local press advertisements and general practitioners of the Inserm clinical investigation centre network, who had cognitive testing, brain MRI for white matter hyperintensities, measurements of arterial stiffness, carotid structure and endothelial function, and DNA and serum banking, and were re-examined about eight years later (ADELAHYDE-2), to identify genetic, environmental and vascular determinants of leukoaraiosis and cognitive decline.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19246701</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25332706</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29276677</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32039844</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT01351961</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001471"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ADELAHYDE</owl:annotatedTarget>
