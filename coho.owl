    <!-- http://www.ebi.ac.uk/coho/COHO_0001604 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001604">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:25472670</obo:IAO_0000112>
        <obo:IAO_0000115>An international, multicentre prospective cohort of adults newly diagnosed with invasive colorectal cancer of any stage. It began at the Fred Hutchinson Cancer Research Center in Seattle in 2007 and from 2009 added sites in Tampa, Heidelberg (Germany), Salt Lake City, Los Angeles, St. Louis and Memphis. Patients are enrolled before surgery. They complete questionnaires and give blood, urine and stool at enrolment and repeatedly during five years of follow-up, tumour and adipose tissue are collected at surgery, and treatment and outcome data are abstracted from medical records, so that biomarkers and modifiable lifestyle factors that predict recurrence, survival, treatment toxicity and quality of life can be found.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ColoCare</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ColoCare study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International ColoCare Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">ColoCare Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001604"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25472670</owl:annotatedTarget>
        <dcterms:title>Suitability of circulating miRNAs as potential prognostic markers in colorectal cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25472670</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25472670+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>This pilot study is based on the ColoCare Study, a cohort study of newly diagnosed patients with stage I-IV colorectal cancer.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001604"/>
