    <!-- http://www.ebi.ac.uk/coho/COHO_0000529 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000529">
        <obo:IAO_0100001 rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000530"/>
        <rdfs:comment xml:lang="en">Obsoleted 2026-09-23. KARE, the Korea Association Resource, is another name for the KoGES Ansan and Ansung Study (COHO:0000530), not a separate cohort or a genotyped sub-cohort of it: the KoGES profile calls the study&apos;s genome-wide data KARE, the papers tagged KARE describe the KARE cohort as the Ansan and Anseong cohort, and the KARE, Ansan and Ansung tags all denote that one cohort (src/curation/catalog_cohorts_tier_b_check.csv). Replaced by COHO:0000530, which carries the acronym KARE and the KARE names.</rdfs:comment>
        <rdfs:label xml:lang="en">obsolete Korea Association Resource</rdfs:label>
        <owl:deprecated rdf:datatype="http://www.w3.org/2001/XMLSchema#boolean">true</owl:deprecated>
    </owl:NamedIndividual>
    


