    <!-- http://www.ebi.ac.uk/coho/COHO_0001328 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001328">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>GCST90244057</obo:IAO_0000112>
        <obo:IAO_0000115>A study of the genetic and environmental effects on the disablement process in older women, in which female twin pairs aged 63–76, recruited from the Older Finnish Twin Cohort, took part in laboratory examinations of physical functioning, muscle strength and power, hearing and other health measures, with blood sampling, in Jyväskylä, Finland, in 2000–2001 and again at a 3-year follow-up, and have since been followed for mortality, by researchers of the Gerontology Research Center of the University of Jyväskylä.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>FITSA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Finnish Twin Study on Aging</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001328"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244057</owl:annotatedTarget>
        <dcterms:title>Rare variant analyses across multiethnic cohorts identify novel genes for refractive error.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36596879</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Finnish Twin Study on Aging (FITSA) is a study of genetic and environmental effects on the disablement process in older female twins.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
