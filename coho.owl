    <!-- http://www.ebi.ac.uk/coho/COHO_0000379 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000379">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90454419</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal observational cohort of volunteers followed by the Stanford Alzheimer&apos;s Disease Research Center (the Iqbal Farrukh and Asad Jamal Stanford ADRC) at Stanford University, California, one of the US National Institute on Aging-funded Alzheimer&apos;s Disease Research Centers, comprising people with Alzheimer disease, dementia with Lewy bodies, Parkinson disease or mild cognitive impairment and cognitively unimpaired older adults, who undergo standardized clinical, neurological and neuropsychological assessments following National Alzheimer&apos;s Coordinating Center procedures and give blood and cerebrospinal fluid used in proteomic and genetic studies, in line with the center&apos;s focus on Alzheimer disease and Lewy body disorders.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Iqbal Farrukh and Asad Jamal Stanford Alzheimer&apos;s Disease Research Center</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SADRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stanford ADRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stanford Iqbal Farrukh and Asad Jamal ADRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Stanford_ADRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Stanford Alzheimer&apos;s Disease Research Center</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000379"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90454419</owl:annotatedTarget>
        <dcterms:title>Proteo-genomics of soluble TREM2 in cerebrospinal fluid provides novel insights and identifies novel modulators for Alzheimer&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38172904</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10763080/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Stanford Alzheimer’s Disease Research Center (ADRC) (https://med.stanford.edu/adrc.html), one of thirty-one ADRC, aims to translate research advances into improved diagnosis and care for people with AD and related disorders.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000379"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal observational cohort of volunteers followed by the Stanford Alzheimer&apos;s Disease Research Center (the Iqbal Farrukh and Asad Jamal Stanford ADRC) at Stanford University, California, one of the US National Institute on Aging-funded Alzheimer&apos;s Disease Research Centers, comprising people with Alzheimer disease, dementia with Lewy bodies, Parkinson disease or mild cognitive impairment and cognitively unimpaired older adults, who undergo standardized clinical, neurological and neuropsychological assessments following National Alzheimer&apos;s Coordinating Center procedures and give blood and cerebrospinal fluid used in proteomic and genetic studies, in line with the center&apos;s focus on Alzheimer disease and Lewy body disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38172904</obo:IAO_0000119>
