    <!-- http://www.ebi.ac.uk/coho/COHO_0001567 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001567">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <obo:IAO_0000112>PMID:28604730</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case–control study of lung cancer in Asturias, northern Spain, run by the Molecular Epidemiology of Cancer Unit of the University Institute of Oncology of the University of Oviedo, which from October 2000 used a standard protocol to recruit incident, histologically confirmed lung cancer cases aged 30 to 85 living in the areas of the main hospitals of Asturias (in Gijón, Avilés, Oviedo and Mieres), with controls admitted to the same hospitals for conditions unrelated to the exposures studied and individually matched by ethnicity, sex, age and hospital; participants were interviewed on tobacco, diet, occupation and environmental exposures and gave blood or mouthwash samples, to study lifestyle, occupational and genetic risk factors for lung cancer.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CAPUA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CAncer de PUlmon en Asturias</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cancer de Pulmon en Asturias</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cancer de Pulmon en Asturias study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Lung Cancer in Asturias</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Cancer de Pulmon en Asturias study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Cáncer de Pulmón en Asturias</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001567"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28604730</owl:annotatedTarget>
        <dcterms:title>Large-scale association analysis identifies new lung cancer susceptibility loci and heterogeneity in genetic susceptibility across histological subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28604730</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The CAncer de PUlmon en Asturias (CAPUA study) is a hospital-based case-control study conducted in Asturias, Spain by the University of Oviedo.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001567"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case–control study of lung cancer in Asturias, northern Spain, run by the Molecular Epidemiology of Cancer Unit of the University Institute of Oncology of the University of Oviedo, which from October 2000 used a standard protocol to recruit incident, histologically confirmed lung cancer cases aged 30 to 85 living in the areas of the main hospitals of Asturias (in Gijón, Avilés, Oviedo and Mieres), with controls admitted to the same hospitals for conditions unrelated to the exposures studied and individually matched by ethnicity, sex, age and hospital; participants were interviewed on tobacco, diet, occupation and environmental exposures and gave blood or mouthwash samples, to study lifestyle, occupational and genetic risk factors for lung cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23013535</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28604730</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:28819433</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001567"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CAPUA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001567"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The CAncer de PUlmon en Asturias (CAPUA study) is a hospital-based case-control study conducted in Asturias, Spain by the University of Oviedo.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001568 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001568">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:27174798</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, randomised, double-blind, placebo-controlled trial of atorvastatin 10 mg daily for the primary prevention of cardiovascular disease in men and women aged 40–75 with type 2 diabetes, no history of cardiovascular disease, LDL cholesterol of 4.14 mmol/l or less and at least one further risk factor (retinopathy, albuminuria, current smoking or hypertension), who were randomised between November 1997 and June 2001 at centres in the United Kingdom and Ireland. It was run as a collaboration of Diabetes UK, the NHS Research and Development Directorate and Pfizer UK, and was stopped early when its prespecified efficacy criterion was met.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CARDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Collaborative AtoRvastatin Diabetes Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Collaborative Atorvastatin Diabetes Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Collaborative Atorvastatin in Diabetes Trial</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Collaborative Atorvastatin Diabetes Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001568"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27174798</owl:annotatedTarget>
        <dcterms:title>Development and Validation of a Model to Predict Absolute Vascular Risk Reduction by Moderate-Intensity Statin Therapy in Individual Patients With Type 2 Diabetes Mellitus: The Anglo Scandinavian Cardiac Outcomes Trial, Antihypertensive and Lipid-Lowering Treatment to Prevent Heart Attack Trial, and Collaborative Atorvastatin Diabetes Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27174798</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27174798+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>External validation of the model was performed in data from the Antihypertensive and Lipid-Lowering Treatment to Prevent Heart Attack Trial (ALLHAT-LLT; pravastatin 40 mg versus usual care) and Collaborative Atorvastatin Diabetes Study (CARDS; atorvastatin 10 mg versus placebo) of 3878 and 2838 patients with type 2 diabetes mellitus, respectively.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001568"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre, randomised, double-blind, placebo-controlled trial of atorvastatin 10 mg daily for the primary prevention of cardiovascular disease in men and women aged 40–75 with type 2 diabetes, no history of cardiovascular disease, LDL cholesterol of 4.14 mmol/l or less and at least one further risk factor (retinopathy, albuminuria, current smoking or hypertension), who were randomised between November 1997 and June 2001 at centres in the United Kingdom and Ireland. It was run as a collaboration of Diabetes UK, the NHS Research and Development Directorate and Pfizer UK, and was stopped early when its prespecified efficacy criterion was met.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:11918622</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:15325833</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25899452</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001568"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CARDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001568"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705133/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In brief, CARDS was a multicentre, randomised, placebo-controlled trial in 2,838 patients with type 2 diabetes aged 40–75 years carried out in 132 centres in the UK and Ireland.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001569 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001569">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:25748612</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised, double-blind, placebo-controlled secondary-prevention trial of pravastatin 40 mg daily in men and postmenopausal women aged 21–75 who had had a myocardial infarction 3 to 20 months earlier and had average cholesterol levels (total cholesterol below 240 mg/dl and LDL cholesterol of 115–174 mg/dl), enrolled at 80 hospitals and affiliated centres in the United States and Canada and followed for about five years to test whether lowering cholesterol reduces fatal coronary heart disease and nonfatal myocardial infarction. It was initiated by its investigators and funded by Bristol-Myers Squibb.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CARE also denotes Los Angeles component of The Womens Contraceptive and Reproductive Experiences Study (COHO:0000110), Canadian Airways Research Group (COHO:0000229), Childhood Asthma Research and Education Network (COHO:0001570) and Candidate Gene Association Resource (COHO:0001586); this term is Cholesterol and Recurrent Events.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>CARE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CARE_b</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cholesterol and Recurrent Events study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cholesterol and Recurrent Events trial</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Cholesterol and Recurrent Events</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001569"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:25748612</owl:annotatedTarget>
        <dcterms:title>Genetic risk, coronary heart disease events, and the clinical benefit of statin therapy: an analysis of primary and secondary prevention trials.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:25748612</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4608367/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>CARE was a secondary-prevention trial that investigated the clinical benefit of pravastatin 40 mg daily versus placebo in individuals with prior MI who had total cholesterol ≤240 mg/dL and LDL cholesterol between 115 and 174 mg/dL.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001569"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised, double-blind, placebo-controlled secondary-prevention trial of pravastatin 40 mg daily in men and postmenopausal women aged 21–75 who had had a myocardial infarction 3 to 20 months earlier and had average cholesterol levels (total cholesterol below 240 mg/dl and LDL cholesterol of 115–174 mg/dl), enrolled at 80 hospitals and affiliated centres in the United States and Canada and followed for about five years to test whether lowering cholesterol reduces fatal coronary heart disease and nonfatal myocardial infarction. It was initiated by its investigators and funded by Bristol-Myers Squibb.</owl:annotatedTarget>
