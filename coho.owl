    <!-- http://www.ebi.ac.uk/coho/COHO_0001511 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001511">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <obo:IAO_0000112>PMID:39218908</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of participants drawn from the customer base of Genomelink, a direct-to-consumer genetic-traits testing platform, who provided informed consent and completed surveys online as part of the Biobank of the Americas.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BBofA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BBofA-GL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BbofA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BbofA-GL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Biobank of the Americas – GenomeLink</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Biobank of the Americas-Genomelink</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001511"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39218908</owl:annotatedTarget>
        <dcterms:title>Polygenic risk score portability for common diseases across genetically diverse populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39218908</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39218908+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Finally, we validated the selected PRS models using an independent set of 8,417 individuals from Biobank of the Americas-Genomelink (BbofA-GL); and performed a PRS-Phewas.</rdfs:comment>
    </owl:Axiom>
