    <!-- http://www.ebi.ac.uk/coho/COHO_0000612 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000612">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000481"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
