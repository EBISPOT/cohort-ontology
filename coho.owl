    <!-- http://www.ebi.ac.uk/coho/COHO_0001149 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001149">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90472771</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing prospective observational study and biobank of people aged 16 or over with moderate-to-severe plaque psoriasis starting systemic or biologic therapy, established in 2011 at the St John&apos;s Institute of Dermatology, Guy&apos;s and St Thomas&apos; NHS Foundation Trust, and recruiting at more than 80 dermatology centres across the United Kingdom. It pairs DNA from every participant, and further blood and skin samples from some, with clinical data, captured partly through the British Association of Dermatologists Biologics and Immunomodulators Register, to identify biomarkers of response to psoriasis treatments.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BSTOP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Biomarkers of Systemic Treatment Outcomes in Psoriasis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Biomarkers of Systemic Treatment Outcomes in Psoriasis study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK Biomarkers of Systemic Treatment Outcomes in Psoriasis study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Biomarkers and Stratification To Optimise outcomes in Psoriasis</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001149"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
