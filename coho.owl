     xmlns:subsets="http://purl.obolibrary.org/obo/ro/subsets#"
     xmlns:oboInOwl="http://www.geneontology.org/formats/oboInOwl#">
    <owl:Ontology rdf:about="http://www.ebi.ac.uk/coho.owl">
        <owl:versionIRI rdf:resource="http://www.ebi.ac.uk/coho/releases/2026-09-22.1/coho.owl"/>
        <dcterms:description>None</dcterms:description>
        <dcterms:license rdf:resource="https://creativecommons.org/licenses/unspecified"/>
        <dcterms:title>Cohort Ontology</dcterms:title>
        <owl:versionInfo>2026-09-22.1</owl:versionInfo>
    </owl:Ontology>
    


