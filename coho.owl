    <!-- http://www.ebi.ac.uk/coho/COHO_0001399 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001399">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90094651</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of breast cancer conducted in the Philadelphia and Detroit metropolitan areas of the United States from 1999 to 2003, whose cases, diagnosed with invasive ductal breast cancer within 18 months of recruitment and over-sampled for diagnosis before age 40, were identified in the University of Pennsylvania Health System and the Karmanos Cancer Institute or recruited through local advertisement, with controls without breast cancer recruited in the same way.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>RVGBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RVGDBCR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Racial Variability in Genotypic Determinants of Breast Cancer Risk Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001399"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90094651</owl:annotatedTarget>
        <dcterms:title>Associations between age of menarche and genetic variation in women of African descent: genome-wide association study and polygenic score analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34706928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9011920/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Root consortium is comprised of six epidemiologic studies of breast cancer in women of African ancestry: the Nigerian Breast Cancer Study (Ibadan, Nigeria); the Barbados National Cancer Study (Barbados); the Southern Community Cohort (southern United States); the Baltimore Breast Cancer Study (Baltimore, United States); the Racial Variability in Genotypic Determinants of Breast Cancer Risk Study (Detroit and Pennsylvania, United States); and the Chicago Cancer Prone Study (Chicago, United States).</rdfs:comment>
    </owl:Axiom>
