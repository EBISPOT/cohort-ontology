        <obo:IAO_0000112>GCST001595</obo:IAO_0000112>
        <obo:IAO_0000115>A sample of postmenopausal women aged 55–85 of white European ancestry with extreme high or extreme low hip bone mineral density, recruited from population-based and clinical sources at centres in Australia, New Zealand and the United Kingdom by the Anglo-Australasian Osteoporosis Genetics Consortium and genotyped together for a genome-wide association study of bone mineral density and fracture that used extreme truncate selection.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>AOGC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
