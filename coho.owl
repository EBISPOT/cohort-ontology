        <oboInOwl:hasRelatedSynonym>GARNET</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genome-wide Association Research Network into Effects of Treatment</oboInOwl:hasRelatedSynonym>
