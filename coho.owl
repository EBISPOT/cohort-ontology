        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9314075/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Appendix B contains a list of investigators from the INVENT consortium that contributed to the VTE summary data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000829"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium that meta-analyses genome-wide association studies of venous thromboembolism from many case-control and population studies (30,234 cases and 172,122 controls from 18 studies in its 2019 analysis, 29 studies in later case-only analyses) to identify genetic risk factors for venous thromboembolism and its subtypes.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9412533/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
