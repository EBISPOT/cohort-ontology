        <oboInOwl:hasRelatedSynonym>IRAS-FS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IRASFS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Insulin Resistance Atherosclerosis Family Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000504"/>
