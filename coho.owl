        <obo:IAO_0000112>GCST90255678</obo:IAO_0000112>
        <obo:IAO_0000115>A multiethnic genome-wide association study sample of prostate cancer from Kaiser Permanente health plan members in California, combining prostate cancer cases from three Kaiser Permanente studies (the Research Program on Genes, Environment and Health, the ProHealth Study and the California Men&apos;s Health Study) with men of the Genetic Epidemiology Research on Aging cohort without a prostate cancer diagnosis as controls (7,783 cases and 38,595 controls; 80.3% non-Hispanic white, 4.9% African American, 7.0% East Asian and 7.8% Latino).</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym ProHealth also denotes ProHealth Study (COHO:0000879); this term is ProHealth Kaiser GWAS.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>Kaiser</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ProHealth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">ProHealth Kaiser GWAS</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000945"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90255678</owl:annotatedTarget>
        <dcterms:title>Evidence of Novel Susceptibility Variants for Prostate Cancer and a Multiancestry Polygenic Risk Score Associated with Aggressive Disease in Men of African Ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36872133</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10424812/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The GWAS meta-analysis included 19 378 PCa cases and 61 620 controls of African ancestry from the AAPC Consortium, ELLIPSE/PRACTICAL Onco-Array Consortium (ELLIPSE), Ghana Prostate Study (Ghana), ProHealth Kaiser GWAS (Kaiser), Electronic Medical Records and Genomics (eMERGE) Network, BioVU Biobank, BioMe Biobank, California and Uganda Prostate Cancer Study (CA UG), VA Million Veteran Program (MVP), and Maryland Prostate Cancer Case-Control Study (NCI-MD).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000945"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multiethnic genome-wide association study sample of prostate cancer from Kaiser Permanente health plan members in California, combining prostate cancer cases from three Kaiser Permanente studies (the Research Program on Genes, Environment and Health, the ProHealth Study and the California Men&apos;s Health Study) with men of the Genetic Epidemiology Research on Aging cohort without a prostate cancer diagnosis as controls (7,783 cases and 38,595 controls; 80.3% non-Hispanic white, 4.9% African American, 7.0% East Asian and 7.8% Latino).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26034056</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
