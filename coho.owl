        <obo:IAO_0000119>PMID:29089348</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40973091</obo:IAO_0000119>
        <obo:IAO_0000119>https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001133/phs001133.v1.p1/GapExchange_phs001133.v1.p1.xml</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
