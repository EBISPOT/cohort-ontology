    <!-- http://www.ebi.ac.uk/coho/COHO_0001254 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001254">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90841457</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective pre-birth cohort, run from Harvard Medical School and the Harvard Pilgrim Health Care Institute, of women recruited in early pregnancy at eight obstetric offices of Atrius Harvard Vanguard Medical Associates, a multi-specialty group practice in eastern Massachusetts, United States, from April 1999 to November 2002, and their children, followed with in-person visits during pregnancy, at delivery, in infancy, early and mid-childhood and early adolescence and with annual mailed questionnaires, to examine prenatal diet and other early-life factors in relation to maternal and child health.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym VIVA also denotes Viborg Vascular (COHO:0001129); this term is Project Viva.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>VIVA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Viva</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Project Viva</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001254"/>
