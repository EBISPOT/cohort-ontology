    <!-- http://www.ebi.ac.uk/coho/COHO_0001417 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001417">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <obo:IAO_0000112>GCST90319855</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, biobank-linked registry at Seoul National University Hospital, South Korea, that since March 2016 has enrolled patients clinically diagnosed with renal cell carcinoma who undergo surgical treatment (ablation, or partial, radical or cytoreductive nephrectomy), collecting standardised clinical, pathological, quality-of-life and survival data and blood and tumour samples stored in the hospital&apos;s Human Biobank. It is the nephrectomy sub-cohort of the renal cell carcinoma arm (SUPER-RCC) of the Seoul National University Prospectively Enrolled Registry for Genitourinary Cancer (SUPER-GUC).</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SUPER-RCC-Nephrectomy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SUPER-RCC-Nx</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Seoul National University Prospectively Enrolled Registry for RCC-Nephrectomy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Seoul National University Prospectively Enrolled Registry for Renal Cell Carcinoma-Nephrectomy</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001417"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90319855</owl:annotatedTarget>
        <dcterms:title>Polygenic risk score model for renal cell carcinoma in the Korean population and relationship with lifestyle-associated factors.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38200428</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10777500/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We included the cases of 1,120 patients with RCC who were registered in the Seoul National University Prospectively Enrolled Registry for RCC-Nephrectomy (SUPER-RCC-Nx) and had their blood stored in the human biobank [21].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001417"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, biobank-linked registry at Seoul National University Hospital, South Korea, that since March 2016 has enrolled patients clinically diagnosed with renal cell carcinoma who undergo surgical treatment (ablation, or partial, radical or cytoreductive nephrectomy), collecting standardised clinical, pathological, quality-of-life and survival data and blood and tumour samples stored in the hospital&apos;s Human Biobank. It is the nephrectomy sub-cohort of the renal cell carcinoma arm (SUPER-RCC) of the Seoul National University Prospectively Enrolled Registry for Genitourinary Cancer (SUPER-GUC).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31294132</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38200428</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
