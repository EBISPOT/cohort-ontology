        <obo:IAO_0000112>GCST90132185</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based birth cohort of about 3,000 singletons born in 1983-1984 in Cebu, Philippines, and their mothers, enrolled in pregnancy and followed with bimonthly surveys for two years and repeated follow-up surveys to age 35, run by the Office of Population Studies of the University of San Carlos and the University of North Carolina to study the long-term effects of early nutrition and life conditions on health.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CLHNS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cebu Longitudinal Health and Nutrition Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Cebu Longitudinal Health and Nutrition Survey</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000562"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90132185</owl:annotatedTarget>
