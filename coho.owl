    <!-- http://www.ebi.ac.uk/coho/COHO_0001473 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001473">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <obo:IAO_0000112>PMID:29531354</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control collection of the Psychiatric Genetics Unit of the Vall d&apos;Hebron Research Institute (VHIR) in Barcelona, Spain, of adults of European origin with attention-deficit hyperactivity disorder, recruited and evaluated at the Hospital Universitari Vall d&apos;Hebron, and of unrelated blood donors screened for lifetime ADHD symptoms, genotyped genome-wide to identify loci conferring susceptibility to persistent ADHD.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ADHD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADHD-VHIR</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">ADHD-VHIR study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001473"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29531354</owl:annotatedTarget>
        <dcterms:title>Multiancestry genome-wide association study of 520,000 subjects identifies 32 loci associated with stroke and stroke subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29531354</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Vall d&apos;Hebron Research Institute (VHIR) cohort included 435 blood donors of Caucasian origin recruited from 2004 to 2008 at the Hospital Universitari Vall d&apos;Hebron (Barcelona, Spain) to identify loci conferring susceptibility to Attention-Deficit Hyperactivity Disorder.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
