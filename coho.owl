        <obo:IAO_0000112>GCST90559230</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of adults with symptomatic (stage C) heart failure of different aetiologies, prospectively enrolled from the outpatient clinic of the Heart Institute of the University of São Paulo Medical School in São Paulo, Brazil. Its genotyped participants, with atrial fibrillation ascertained from electrocardiograms and medical records, have contributed to genome-wide association studies of atrial fibrillation.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SPHFC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sao Paolo Heart Failure Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Sao Paulo Heart Failure Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001412"/>
