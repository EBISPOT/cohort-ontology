        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001276"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90269914</owl:annotatedTarget>
        <dcterms:title>Africa-specific human genetic variation near CHD1L associates with HIV-1 load.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37532928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10848312/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The AIDS Linked to the IntraVenous Experience (ALIVE) study is a natural history study following the incidence and progression of HIV infection among intravenous drug users (IDUs) in Baltimore, MD.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001276"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing community-based cohort of current and former people who inject drugs in and around Baltimore, Maryland, United States, established in 1988 as a natural history study of the incidence and progression of HIV infection.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20450418</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37532928</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42461483</obo:IAO_0000119>
        <dcterms:contributor>Claude Sonnet 5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001276"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ALIVE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001276"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42461483+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Nested within the AIDS Linked to the IntraVenous Experience (ALIVE) study, an ongoing community-based cohort of former and current PWID in Baltimore, Maryland, we conducted an ego-centric drug use network survey among n = 237 PWID who reported any injection drug use in the last 12 months from across the metropolitan region in 2018-2019 and examined prospective associations between network geography and injection drug use, sharing, and non-fatal overdose at 6-month follow-up visits.</rdfs:comment>
    </owl:Axiom>
    


