        <rdfs:comment>These phenotypes were collected through the deCODE Health Study and other research projects at deCODE genetics.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000469 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000469">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000394"/>
