        <oboInOwl:hasRelatedSynonym>NJMU GSA project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NJMU Global Screening Array project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nanjing Medical University Global Screening Array Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Nanjing Medical University Global Screening Array project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001110"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
