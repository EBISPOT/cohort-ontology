        <obo:IAO_0000112>GCST90909152</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of 4,549 self-identified American Indian adults aged 45 years or older, recruited in 1989–1991 from tribal communities in Arizona, Oklahoma, North Dakota and South Dakota, United States, and followed through repeated examinations to estimate cardiovascular disease rates and risk factors in American Indians.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
