    <!-- http://www.ebi.ac.uk/coho/COHO_0001236 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001236">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90281365</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective multicentre cohort of community-dwelling women aged 65 or older in the United States, whose original, white members were recruited from population-based listings in four areas (Baltimore, Maryland; Minneapolis, Minnesota; Portland, Oregon; and the Monongahela Valley, Pennsylvania) between September 1986 and October 1988 and were joined by African American women enrolled at the Year 10 examination in 1997–1998, followed by regular contacts and repeat examinations to study risk factors for osteoporotic fractures.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SOF</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Study of Osteoporotic Fractures</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001236"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90281365</owl:annotatedTarget>
        <dcterms:title>The identification of distinct protective and susceptibility mechanisms for hip osteoarthritis: findings from a genome-wide association study meta-analysis of minimum joint space width and Mendelian randomisation cluster analyses.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37619450</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10470292/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>GWAS cohorts comprised the UKB, The Rotterdam Study (RS) I&amp;II, Osteoporotic Fractures in Men (MrOS) Study and Study of Osteoporotic Fractures (SOF). mJSW was measured automatically in UKB and manually in RS, MrOS and SOF (see Supplementary Methods).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001236"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective multicentre cohort of community-dwelling women aged 65 or older in the United States, whose original, white members were recruited from population-based listings in four areas (Baltimore, Maryland; Minneapolis, Minnesota; Portland, Oregon; and the Monongahela Valley, Pennsylvania) between September 1986 and October 1988 and were joined by African American women enrolled at the Year 10 examination in 1997–1998, followed by regular contacts and repeat examinations to study risk factors for osteoporotic fractures.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28465840</obo:IAO_0000119>
