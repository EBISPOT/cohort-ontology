        <oboInOwl:hasRelatedSynonym>Royal Brompton &amp; Harefield Hospital Cardiovascular Research Centre Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Royal Brompton &amp; Harefield Hospitals NHS Trust Cardiovascular Research Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Royal Brompton Hospital Cardiovascular Research Centre Biobank</oboInOwl:hasRelatedSynonym>
