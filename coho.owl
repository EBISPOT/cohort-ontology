        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre observational cohort of current and former smokers aged 40–80 with or without airflow obstruction, and never-smoking controls, recruited at clinical sites across the United States with baseline and annual follow-up visits, to find subgroups of chronic obstructive pulmonary disease and biomarkers usable as intermediate outcomes in therapeutic trials.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24029743</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000652"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SPIROMICS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000652"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8077917/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The SPIROMICS study is a multicenter study that includes current and former smokers (≥ 20 pack years) with or without airflow obstruction and healthy participants who were non-smokers aged 40 to 80 years recruited from 12 clinical sites spread across the United States.</rdfs:comment>
    </owl:Axiom>
    


