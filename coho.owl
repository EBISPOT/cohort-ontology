        <rdfs:comment>All analyses were conducted within the Gene-Lifestyle Interactions and Dental Endpoints (GLIDE) Consortium in 13 studies from Europe and the USA</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000948 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000948">
