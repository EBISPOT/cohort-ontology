        <obo:IAO_0000112>GCST90244788</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing study at Henry Ford Health System of members of the health system aged 12–56, with and without a clinical diagnosis of asthma, from southeast Michigan and the Detroit metropolitan area, United States, enrolled with a staff-administered questionnaire and lung function testing to study asthma phenotypes and pharmacogenomic interactions across racial and ethnic groups.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SAPPHIRE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study of Asthma Phenotypes and Pharmacogenomic Interactions by Race-ethnicity</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Study of Asthma Phenotypes and Pharmacogenomic Interactions by Race-Ethnicity</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000950"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244788</owl:annotatedTarget>
        <dcterms:title>European and multi-ancestry genome-wide association meta-analysis of atopic dermatitis highlights importance of systemic immune regulation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37794016</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10550990/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>SAPPHIRE Recruitment The Study of Asthma Phenotypes and Pharmacogenomic Interactions by Race-ethnicity (SAPPHIRE) is an ongoing study that was approved by the Institutional Review Board of Henry Ford Health System.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000950"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing study at Henry Ford Health System of members of the health system aged 12–56, with and without a clinical diagnosis of asthma, from southeast Michigan and the Detroit metropolitan area, United States, enrolled with a staff-administered questionnaire and lung function testing to study asthma phenotypes and pharmacogenomic interactions across racial and ethnic groups.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37794016</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000950"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SAPPHIRE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000950"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36403896+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>BackgroundAlthough food allergies are considered common, relatively little is known about disparities in food allergy by race in the United States.ObjectiveTo evaluate differences in reported food allergy and food-associated anaphylaxis among individuals enrolled in a longitudinal cohort study from metropolitan Detroit, Michigan.MethodsParticipants in the Study of Asthma Phenotypes and Pharmacogenomic Interactions by Race-Ethnicity (SAPPHIRE) were asked about food allergies, including the inciting food and associated symptoms.</rdfs:comment>
    </owl:Axiom>
    


