        <obo:IAO_0000112>GCST90301368</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective multicentre case–control study, funded by the US National Institute of Neurological Disorders and Stroke, of adults with a first-ever ischaemic stroke confirmed by CT or MRI and enrolled within 30 days of onset at five academic medical centres in the United States, with centrally adjudicated stroke subtypes, and of stroke-free controls matched by age and sex and recruited mainly among the patients&apos; spouses and unrelated friends, to investigate genetic risk factors for ischaemic stroke and its subtypes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ISGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ischemic Stroke Genetic Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Ischemic Stroke Genetics Study</rdfs:label>
