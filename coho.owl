        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium formed under the Slim Initiative in Genomic Medicine for the Americas that pooled type 2 diabetes case-control samples of Mexicans and other Latin Americans from the Diabetes in Mexico Study, the Mexico City Diabetes Study, the Multiethnic Cohort Study and the UNAM/INCMNSZ Diabetes Study to characterise the genetic basis of type 2 diabetes in Mexican and Latin American populations.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24390345</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
