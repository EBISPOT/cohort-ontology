        <obo:IAO_0000112>GCST90128454</obo:IAO_0000112>
        <obo:IAO_0000115>An ancestrally diverse biobank embedded in the UCLA Health medical system in Los Angeles County, run by the UCLA Institute for Precision Health, that links genomic data from blood samples of consenting UCLA Health patients (36,736 genotyped in 2022) to their de-identified electronic health records, for genetic and precision-health research.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ATLAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ATLAS Community Health Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UCLA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">UCLA ATLAS Community Health Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000503"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90128454</owl:annotatedTarget>
        <dcterms:title>Leveraging genomic diversity for discovery in an electronic health record linked biobank: the UCLA ATLAS Community Health Initiative.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36085083</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36085083+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we explore the implications of genetic ancestry within the University of California, Los Angeles (UCLA) ATLAS Community Health Initiative-an ancestrally diverse biobank of genomic data linked with de-identified electronic health records (EHRs) of UCLA Health patients (N=36,736).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000503"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ancestrally diverse biobank embedded in the UCLA Health medical system in Los Angeles County, run by the UCLA Institute for Precision Health, that links genomic data from blood samples of consenting UCLA Health patients (36,736 genotyped in 2022) to their de-identified electronic health records, for genetic and precision-health research.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:36085083</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9461263/fullTextXML</obo:IAO_0000119>
