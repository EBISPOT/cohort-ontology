    <!-- http://www.ebi.ac.uk/coho/COHO_0001024 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001024">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90624093</obo:IAO_0000112>
        <obo:IAO_0000115>A family study of Alzheimer&apos;s disease in the United States in which three academic medical centres (Massachusetts General Hospital, Johns Hopkins University and the University of Alabama at Birmingham) ascertained families with two or more members affected by Alzheimer&apos;s disease (mostly affected sibling pairs), together with unaffected relatives, from 1991 through memory disorder clinics, nursing homes and the community, using uniform procedures. It is the Alzheimer&apos;s disease collection of the NIMH Human Genetics Initiative, whose data and DNA are shared through the NIMH repository for genetic linkage and association studies.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NIMH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIMH AD Genetics Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIMH Alzheimer&apos;s disease Genetics Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Institute of Mental Health Alzheimer Disease Genetic Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Institute of Mental Health Genetics Initiative Alzheimer&apos;s Disease Study Sample</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">NIMH Alzheimer&apos;s Disease Genetics Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001024"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90624093</owl:annotatedTarget>
        <dcterms:title>Identification of 16 novel Alzheimer&apos;s disease loci using multi-ancestry meta-analyses.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39998322</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11852348/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Genetic cohorts of clinical AD used for most GWAS, for example, the Alzheimer&apos;s Disease Sequencing Project (ADSP) from the National Institute on Aging Genetics of Alzheimer&apos;s Disease Data Storage Site (NIAGADS) 5 and the family‐based AD dataset from the National Institute of Mental Health (NIMH), 6 have limited sample size.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001024"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family study of Alzheimer&apos;s disease in the United States in which three academic medical centres (Massachusetts General Hospital, Johns Hopkins University and the University of Alabama at Birmingham) ascertained families with two or more members affected by Alzheimer&apos;s disease (mostly affected sibling pairs), together with unaffected relatives, from 1991 through memory disorder clinics, nursing homes and the community, using uniform procedures. It is the Alzheimer&apos;s disease collection of the NIMH Human Genetics Initiative, whose data and DNA are shared through the NIMH repository for genetic linkage and association studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18189239</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9008509</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.nimh.nih.gov/about/advisory-boards-and-groups/namhc/reports/genetics-and-mental-disorders-report-of-the-national-institute-of-mental-healths-genetics-workgroup</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001024"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NIMH</owl:annotatedTarget>
