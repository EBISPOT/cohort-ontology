    <!-- http://www.ebi.ac.uk/coho/COHO_0001125 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001125">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>GCST90572789</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium of large, well-phenotyped cohort studies, mostly population-based, formed to study the determinants and effects of thyroid diseases and thyroid function with genomic, epigenomic, transcriptomic, proteomic and metabolomic data, which meta-analyses genome-wide association data from its member cohorts on thyroid-stimulating hormone, free thyroxine, triiodothyronine, thyroid dysfunction and related traits and makes the summary statistics available.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>The ThyroidOmics Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ThyroidOmics</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">ThyroidOmics Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001125"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90572789</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study and polygenic risk prediction of hypothyroidism.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41238958</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12695664/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The SumHer heritability estimates seem to be quite heterogeneous, e.g., the heritability of TSH in the ThyroidOmics meta-analysis is less than the TSH variance explained by the independent index SNPs in that study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001125"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium of large, well-phenotyped cohort studies, mostly population-based, formed to study the determinants and effects of thyroid diseases and thyroid function with genomic, epigenomic, transcriptomic, proteomic and metabolomic data, which meta-analyses genome-wide association data from its member cohorts on thyroid-stimulating hormone, free thyroxine, triiodothyronine, thyroid dysfunction and related traits and makes the summary statistics available.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30367059</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38291025</obo:IAO_0000119>
        <obo:IAO_0000119>https://genepi.med.uni-greifswald.de/thyroidomics/</obo:IAO_0000119>
