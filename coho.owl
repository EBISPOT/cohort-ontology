        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of 43,794 men and women aged 40–69 randomly sampled from the population of Queensland, Australia, in 2011, with baseline questionnaires on pigmentation, sun exposure, sun protection and skin cancer history and linkage to national health insurance, cancer registry and pathology records, to study the development of skin cancer and melanoma in the population with the highest reported incidence in the world.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22933644</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
