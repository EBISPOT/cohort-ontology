    <!-- http://www.ebi.ac.uk/coho/COHO_0001327 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001327">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>GCST90054778</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based longitudinal cohort of the twins born in Finland in 1983–1987, the youngest of the three Finnish Twin Cohorts, identified through Finland&apos;s Central Population Registry and enrolled with their biological parents in the year they reached age 11, with twin, parent and teacher questionnaires and ratings at baseline and follow-up surveys at ages 14, 17, about 22 and about 37; a subset was studied intensively with in-school assessments and peer nominations at age 12, psychiatric interviews at ages 14 and 22, and neurocognitive tests and DNA collection in early adulthood. It was designed to identify individual, familial and school and neighbourhood risks for substance use before its onset and to follow trajectories of use, abuse and their consequences into adulthood.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>FT12</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FinnTwin12</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FinnTwin12 Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Younger Finnish Twin Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">FinnTwin12 Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001327"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90054778</owl:annotatedTarget>
        <dcterms:title>Genome-wide Association Meta-analysis of Childhood and Adolescent Internalizing Symptoms.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35378236</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx</oboInOwl:hasDbXref>
        <rdfs:comment>FinnTwin12 is a population-based cohort of Finnish twins born 1983–1987 that was established to follow health and behavioural habits</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001327"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based longitudinal cohort of the twins born in Finland in 1983–1987, the youngest of the three Finnish Twin Cohorts, identified through Finland&apos;s Central Population Registry and enrolled with their biological parents in the year they reached age 11, with twin, parent and teacher questionnaires and ratings at baseline and follow-up surveys at ages 14, 17, about 22 and about 37; a subset was studied intensively with in-school assessments and peer nominations at age 12, psychiatric interviews at ages 14 and 22, and neurocognitive tests and DNA collection in early adulthood. It was designed to identify individual, familial and school and neighbourhood risks for substance use before its onset and to follow trajectories of use, abuse and their consequences into adulthood.</owl:annotatedTarget>
