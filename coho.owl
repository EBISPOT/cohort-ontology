    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000836"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90296729</owl:annotatedTarget>
        <dcterms:title>Genome-wide Association Study of Bladder Cancer Reveals New Biological and Translational Insights.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37210288</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10330197/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Formalin-fixed, paraffin-embedded tumor tissue blocks from the New England Bladder Cancer Study (NEBCS), the Spanish Bladder Cancer EPICURO Study (SBCS), and the UROMOL consortium were used to determine FGFR3 somatic mutations (Supplementary material).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000836"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of bladder cancer among residents of Maine, New Hampshire and Vermont, United States, with cases newly diagnosed in 2001–2004 and population controls frequency-matched on age, sex and state, used to study environmental, dietary and genetic risk factors for bladder cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35536285</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000836"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
