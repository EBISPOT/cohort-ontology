        <rdfs:comment>8 study meta analysis (ELLIPSE OncoArray/BPC3/CAPS1/CAPS2/PRACTICAL iCOGS/Pegasus/UK GWAS1/UK GWAS2)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001148"/>
