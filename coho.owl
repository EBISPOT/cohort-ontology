    <!-- http://www.ebi.ac.uk/coho/COHO_0001384 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001384">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/China"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <obo:IAO_0000112>GCST90671959</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of Han Chinese adults, a sub-project of China&apos;s National Science &amp; Technology Basic Research Project, recruited as volunteers in four sub-cohorts in Taizhou (Jiangsu province; 2015 and 2019), Zhengzhou (Henan province; 2017) and Nanning (Guangxi province; 2018). Participants were photographed and assessed for physical traits such as facial, ear and fingerprint features, and gave blood for genotyping and for DNA methylation, proteomic and metabolomic profiling, to study the genetic and molecular basis of human physical traits and common diseases.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NSPT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Survey of Physical Traits Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Survey of Physical Traits Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">National Survey of Physical Traits</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001384"/>
