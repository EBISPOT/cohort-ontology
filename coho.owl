    <!-- http://www.ebi.ac.uk/coho/COHO_0001330 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001330">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90454271</obo:IAO_0000112>
        <obo:IAO_0000115>The human cohort of the German Research Foundation (DFG) research unit FOR2107 on the neurobiology of the major psychoses, recruited between 2014 and 2018 at the Universities of Marburg and Münster, Germany, through local psychiatric hospitals and newspaper advertisements: adults aged 18–65 with major depressive disorder, bipolar disorder, schizoaffective disorder or schizophrenia, healthy people at genetic and/or environmental risk, and healthy controls, deeply phenotyped with MRI, clinical course, neuropsychology, personality, risk and protective factors and biomaterials (blood, stool, urine, hair, saliva) at baseline and again at a 2-year follow-up, to identify how genetic and environmental factors shape brain structure and function and the course of these disorders.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MACS also denotes Multicenter AIDS Cohort Study (COHO:0001368); this term is Marburg-Münster Affective Disorders Cohort Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>FOR2107</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FOR2107 Marburg-Münster Affective Disorders Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FOR2107 consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MACS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Marburg Münster Affective Disorders Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The FOR2107 consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Marburg-Münster Affective Disorders Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001330"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
