        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Gothenburg H70 Birth Cohort Studies and Clinical AD Sweden</rdfs:label>
    </owl:NamedIndividual>
