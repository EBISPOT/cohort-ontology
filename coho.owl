        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90013445</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort and biorepository of racially and ethnically diverse adults aged 30 or older living in the New York tri-state area, enrolled from January 2000 to December 2002 by the Academic Medical Development Company (AMDeC) Foundation, a consortium of New York institutions, at medical centres, community hospitals and community health centres in all five boroughs of New York City and at New York Blood Center donor drives. Participants completed a baseline questionnaire and gave blood for DNA and plasma, to be followed by questionnaires and registry linkage for studies of cancer aetiology and of racial and ethnic disparities in cancer risk, prevention and outcomes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NYCP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>New York Control Population</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">New York Cancer Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001216"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90013445</owl:annotatedTarget>
        <dcterms:title>Fine-mapping, trans-ancestral and genomic analyses identify causal variants, cells, genes and drug targets for type 1 diabetes.</dcterms:title>
