        <rdfs:label xml:lang="en">Guangzhou cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001348"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90319888</owl:annotatedTarget>
        <dcterms:title>Novel loci for ocular axial length identified through extreme-phenotype genome-wide association study in Chinese populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37524447</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37524447+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A genome-wide association study meta-analysis was conducted in totalling 2644 Chinese individuals from 3 cohorts: the Guangzhou cohort (GZ, 537 high myopes and 151 hyperopes), Wenzhou cohort (334 high myopes and 6 hyperopes) and Guangzhou Twin Eye Study (1051 participants with normally distributed AL).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001348"/>
