        <obo:IAO_0000112>GCST90091212</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control sample for lifetime suicide attempt of people of European ancestry, drawn from participants of six clinical trials conducted by Janssen Research &amp; Development, with clinician-diagnosed major depressive disorder, schizophrenia, schizoaffective disorder or bipolar disorder, and from control samples of the NINDS Human Genetics Repository at the Coriell Institute and of BioIVT, with lifetime suicide-attempt history taken from clinical interview and medical records.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Janssen</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
