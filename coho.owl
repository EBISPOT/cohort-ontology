    <!-- http://www.ebi.ac.uk/coho/COHO_0001255 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001255">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Chile"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>GCST90399478</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort of community-dwelling adults aged 70 or over without dementia but with a subjective cognitive complaint. They were recruited door to door from 2017 in three districts of Santiago, Chile (Macul, Peñalolén and La Reina), by the Geroscience Center for Brain Health and Metabolism (GERO), and are followed at 18 and 36 months with clinical, neuropsychological, neuroimaging, blood and stool assessments to study the rate of functional decline and progression to dementia and their risk factors.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GERO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GERO cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Gero cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">GERO cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001255"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90399478</owl:annotatedTarget>
        <dcterms:title>The first genome-wide association study in the Argentinian and Chilean populations identifies shared genetics with Europeans in Alzheimer&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37985413</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10917041/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Additional AD cases and control individuals (32 AD and 20 controls) from Santiago were recruited from the GERO 17 (Geroscience Center for Brain Health and Metabolism) study at the Memory and Neuropsychiatric Center of the Hospital del Salvador and Faculty of Medicine of the University of Chile.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001255"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort of community-dwelling adults aged 70 or over without dementia but with a subjective cognitive complaint. They were recruited door to door from 2017 in three districts of Santiago, Chile (Macul, Peñalolén and La Reina), by the Geroscience Center for Brain Health and Metabolism (GERO), and are followed at 18 and 36 months with clinical, neuropsychological, neuroimaging, blood and stool assessments to study the rate of functional decline and progression to dementia and their risk factors.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33238908</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001255"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GERO</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001255"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Chile"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7690082/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The sample framework corresponds to the territories assigned to three primary healthcare centers selected by convenience according to their socioeconomic heterogeneity, which belong to three different districts in Santiago (Chile): Macul, Peñalolen and La Reina.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001256 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001256">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Argentina"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>GCST90399478</obo:IAO_0000112>
        <obo:IAO_0000115>A multisite case-control study of sporadic Alzheimer&apos;s disease in Argentina, recruiting since 2013. Older people with Alzheimer&apos;s disease and cognitively unimpaired controls are enrolled at outpatient neurology departments of hospitals in the city and province of Buenos Aires and at centres in Jujuy, Córdoba and Mendoza provinces, to identify genes for susceptibility to sporadic Alzheimer&apos;s disease and genes that modify its phenotypes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>AGA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AGA-ALZAR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AGA-ALZAR study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AGA-ALZAR-PRONADIAL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Alzheimer&apos;s Genetics in Argentina–Alzheimer Argentina consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001256"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90399478</owl:annotatedTarget>
        <dcterms:title>The first genome-wide association study in the Argentinian and Chilean populations identifies shared genetics with Europeans in Alzheimer&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37985413</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10917041/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Argentinian samples were recruited in the context of the Alzheimer&apos;s Genetics in Argentina–Alzheimer Argentina consortium (AGA‐ALZAR, https://www.gaaindata.org/partner/AGA)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001256"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multisite case-control study of sporadic Alzheimer&apos;s disease in Argentina, recruiting since 2013. Older people with Alzheimer&apos;s disease and cognitively unimpaired controls are enrolled at outpatient neurology departments of hospitals in the city and province of Buenos Aires and at centres in Jujuy, Córdoba and Mendoza provinces, to identify genes for susceptibility to sporadic Alzheimer&apos;s disease and genes that modify its phenotypes.</owl:annotatedTarget>
