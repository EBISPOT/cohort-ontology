        <obo:IAO_0000112>GCST90502765</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium coordinated at the Fred Hutchinson Cancer Center in Seattle that pools individual-level genetic and epidemiological data from about 70 colorectal cancer case-control, cohort and trial studies in North America, Australia, Asia and Europe, over 130,000 participants, to identify genetic risk factors and gene-environment interactions for colorectal cancer and study their effects on tumours and survival.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GECCO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
