        <obo:IAO_0000112>GCST90095184</obo:IAO_0000112>
        <obo:IAO_0000115>A multi-ethnic cohort of over 100,000 adult members of the Kaiser Permanente Northern California health plan who consented to the Research Program on Genes, Environment and Health (RPGEH), linking survey data, saliva-derived DNA with genome-wide genotypes and telomere length, and electronic health records for research on the genetic and environmental determinants of common age-related diseases.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym KP also denotes Kaiser Permanente Research Bank (COHO:0000541); this term is Genetic Epidemiology Research on Adult Health and Aging.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>GERA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GERA cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Epidemiology Research in Adult Health and Aging</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Epidemiology Research on Aging</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Kaiser Permanente Genetic Epidemiology Research on Adult Health and Aging cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetic Epidemiology Research on Adult Health and Aging</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000431"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90095184</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of actinic keratosis identifies new susceptibility loci implicated in pigmentation and immune regulation pathways.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35449187</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35449187+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a genome-wide association study of AK in non-Hispanic white participants of the Genetic Epidemiology Research on Adult Health and Aging (GERA) cohort (n = 63,110, discovery cohort), with validation in the Mass-General Brigham (MGB) Biobank cohort (n = 29,130).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000431"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multi-ethnic cohort of over 100,000 adult members of the Kaiser Permanente Northern California health plan who consented to the Research Program on Genes, Environment and Health (RPGEH), linking survey data, saliva-derived DNA with genome-wide genotypes and telomere length, and electronic health records for research on the genetic and environmental determinants of common age-related diseases.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26092718</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33778338</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000431"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
