    <!-- http://www.ebi.ac.uk/coho/COHO_0000383 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000383">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90837428</obo:IAO_0000112>
        <obo:IAO_0000115>A healthcare-based biobank of more than 140,000 consenting patients of the Mass General Brigham network in the Greater Boston area of Massachusetts, enrolled since 2010 at Massachusetts General Hospital, Brigham and Women’s Hospital and local sites, linking biological samples, genomic data and health records to study genetic and environmental influences on disease in clinical practice.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym Harvard also denotes Nurses&apos; Health Study (COHO:0000456), Health Professionals Follow-up Study (COHO:0000527) and Nurses&apos; Health Study II (COHO:0000619); this term is Mass General Brigham Biobank.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>Harvard</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MGB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MGB Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MGBB</oboInOwl:hasRelatedSynonym>
