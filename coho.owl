        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90824163</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of DNA and clinical data for genetic association studies of diabetic nephropathy in type 1 diabetes, assembled with support from the JDRF, NIDDK and CDC by the Joslin Diabetes Center, from patients of its clinic in New England, and by the George Washington University Biostatistics Center, from volunteers across the United States and Canada. Participants aged 18–59 with type 1 diabetes diagnosed before age 31 were enrolled as cases with diabetic nephropathy (persistent proteinuria or end-stage renal disease) or as controls with normoalbuminuria after at least 15 years of diabetes, with both parents enrolled where possible to form family trios.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Genetics of Kidneys in Diabetes US Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Kidneys in Diabetes study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GoKIND</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GoKinD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GoKinD US</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetics of Kidneys in Diabetes Study</rdfs:label>
    </owl:NamedIndividual>
