    <!-- http://www.ebi.ac.uk/coho/COHO_0001106 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001106">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <obo:IAO_0000112>GCST90642419</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based register of adult twins and other multiples from the region of Murcia, southeast Spain, created in 2006 through an agreement between the University of Murcia and the Murcia Health Council, which identifies twins in the computerised databases of the regional health system and collects interview, questionnaire and anthropometric data in successive waves, with a biobank, for research on genetic and environmental influences on health and health-related behaviours; it began with female twins born 1940-1966 and later added male and opposite-sex twins.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MTR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MurciaTR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Murcia Twin Registry</rdfs:label>
