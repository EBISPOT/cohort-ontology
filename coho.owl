    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000878"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90053831</owl:annotatedTarget>
        <dcterms:title>Genetic and demographic predisposing factors associated with pediatric sleepwalking in the Philadelphia Neurodevelopmental Cohort.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34563919</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34563919+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Data from the Philadelphia Neurodevelopmental Cohort (PNC) of 7515 youths aged between 8 and 22 years were used in analyses.</rdfs:comment>
    </owl:Axiom>
