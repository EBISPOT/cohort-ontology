    <!-- http://www.ebi.ac.uk/coho/COHO_0001544 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001544">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>PMID:35368071</obo:IAO_0000112>
        <obo:IAO_0000115>A genetic study of COVID-19 severity in Brazil, based at the University of São Paulo Medical School, which enrolled people infected with SARS-CoV-2 in the São Paulo metropolitan area: patients hospitalised with COVID-19 at the Instituto do Coração (InCor) and the Instituto Central do Hospital das Clínicas, and people with a previous infection who were not hospitalised, found through serological surveys or SARS-CoV-2 PCR testing of health professionals and the general population. DNA came from blood samples already taken for clinical tests or serology, with questionnaire or hospital-record data; it was designed to identify genetic risk factors for COVID-19 severity in the Brazilian population and contributes to the COVID-19 Host Genetics Initiative.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BRACOVID</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BRACOVID Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BRACOVID study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Genetic determinants of COVID-19 complications in the Brazilian population</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001544"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:35368071</owl:annotatedTarget>
        <dcterms:title>Genetic risk factors and COVID-19 severity in Brazil: results from BRACOVID study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35368071</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35368071+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we present the results of the initial analysis in the first 5233 participants of the BRACOVID study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001544"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genetic study of COVID-19 severity in Brazil, based at the University of São Paulo Medical School, which enrolled people infected with SARS-CoV-2 in the São Paulo metropolitan area: patients hospitalised with COVID-19 at the Instituto do Coração (InCor) and the Instituto Central do Hospital das Clínicas, and people with a previous infection who were not hospitalised, found through serological surveys or SARS-CoV-2 PCR testing of health professionals and the general population. DNA came from blood samples already taken for clinical tests or serology, with questionnaire or hospital-record data; it was designed to identify genetic risk factors for COVID-19 severity in the Brazilian population and contributes to the COVID-19 Host Genetics Initiative.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34237774</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35368071</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.medrxiv.org/content/medrxiv/early/2021/10/07/2021.10.06.21264631.full.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
