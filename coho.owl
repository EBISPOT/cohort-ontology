        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90435254</obo:IAO_0000112>
        <obo:IAO_0000115>An international prospective observational registry and natural history study of hypertrophic cardiomyopathy funded by the National Heart, Lung, and Blood Institute, which enrolled patients aged 18 to 65 with hypertrophic cardiomyopathy (unexplained left ventricular hypertrophy) at centres in the United States, Canada, the United Kingdom, Italy, Germany and the Netherlands in 2014–2017. Participants underwent clinical evaluation, cardiac magnetic resonance imaging and blood sampling for genetic and biomarker analysis, and are followed for cardiovascular events to improve risk prediction.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HCMR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Hypertrophic Cardiomyopathy registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NHLBI HCM Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hypertrophic Cardiomyopathy Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001014"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90435254</owl:annotatedTarget>
        <dcterms:title>Large-scale genome-wide association analyses identify novel genetic loci and mechanisms in hypertrophic cardiomyopathy.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39966646</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11906354/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The HCM GWAS included cases and controls from seven strata: the Hypertrophic Cardiomyopathy Registry (HCMR), a Canadian HCM cohort, a Netherlands HCM cohort, the Genomics England 100,000 Genome Project (GEL), the Royal Brompton HCM cohort, an Italian HCM cohort and the BioResource for Rare Disease (BRRD) project.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001014"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international prospective observational registry and natural history study of hypertrophic cardiomyopathy funded by the National Heart, Lung, and Blood Institute, which enrolled patients aged 18 to 65 with hypertrophic cardiomyopathy (unexplained left ventricular hypertrophy) at centres in the United States, Canada, the United Kingdom, Italy, Germany and the Netherlands in 2014–2017. Participants underwent clinical evaluation, cardiac magnetic resonance imaging and blood sampling for genetic and biomarker analysis, and are followed for cardiovascular events to improve risk prediction.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26299218</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31699273</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001014"/>
