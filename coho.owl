        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4057636/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Estonian cohort comes from the population-based biobank of the Estonian Genome Project of University of Tartu (EGCUT).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000461"/>
