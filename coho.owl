        <obo:IAO_0000112>GCST003219</obo:IAO_0000112>
        <obo:IAO_0000115>A clinic-based case-control study of age-related macular degeneration in Scotland, collected by a group in Edinburgh with funding from the Chief Scientist Office (Scotland), whose cases with advanced or intermediate AMD and controls were ascertained by fundus examination or photography; its cases and controls replicated the association of complement C3 with AMD and were contributed to the International AMD Genomics Consortium&apos;s genome-wide association study.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Edinburgh</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Scottish AMD study</rdfs:label>
