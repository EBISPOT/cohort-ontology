        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3247076/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Analyzed in the ANZgene Study</rdfs:comment>
