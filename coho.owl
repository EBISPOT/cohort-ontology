        <obo:IAO_0000112>GCST90939806</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal cohort of people with Parkinson disease and healthy older controls studied by the Campbell Research Lab in the Section of Movement Disorders at Washington University in St. Louis, United States, assessed every two years with MRI, motor, gait and cognitive testing, optional lumbar puncture and clinical interview to understand the role of brain proteins and neurotransmitters in Parkinson disease symptoms compared with healthy aging.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PAND</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Protein Aggregation and Neurotransmitter Deficits</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Protein Aggregation and Neurotransmitter Deficits in Parkinson Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Protein Aggregation and Neurotransmitter Deficits Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000375"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
