    <!-- http://www.ebi.ac.uk/coho/COHO_0001001 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001001">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>GCST90132184</obo:IAO_0000112>
        <obo:IAO_0000115>A genome-wide association study of type 2 diabetes and related quantitative traits by the Broad Institute of Harvard and MIT, Lund University and the Novartis Institutes for BioMedical Research. Its participants were patients with type 2 diabetes and matched non-diabetic controls from Finland and Sweden, genotyped and characterised for glucose metabolism, lipids, obesity and blood pressure.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DGI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Diabetes Genetics Initiative of Broad Institute of Harvard and MIT, Lund University, and Novartis Institutes of BioMedical Research</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Diabetes Genetics Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90132184</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genetic study of type 2 diabetes highlights the power of diverse populations for discovery and translation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35551307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01058-3/MediaObjects/41588_2022_1058_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Diabetes Genetics Initiative (DGI) was supported by the Novartis Institute for BioMedical Research with additional support from The Richard and Susan Smith Family Foundation and American Diabetes Association Pinnacle Program Project Award.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001001"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genome-wide association study of type 2 diabetes and related quantitative traits by the Broad Institute of Harvard and MIT, Lund University and the Novartis Institutes for BioMedical Research. Its participants were patients with type 2 diabetes and matched non-diabetic controls from Finland and Sweden, genotyped and characterised for glucose metabolism, lipids, obesity and blood pressure.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17463246</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:18678614</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001001"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DGI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001001"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2570409/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The DGI Study material consisting of 2,931 individuals from Finland and Sweden (1,464 patients with type 2 diabetes and 1,467 nondiabetic control subjects) was ascertained as previously described (1,11,12).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001002 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001002">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>GCST90132183</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium established to assemble genome-wide association studies of type 2 diabetes across diverse ancestry groups. It meta-analyses them within its European and East Asian ancestry components and, together with African, Hispanic and South Asian ancestry studies, in a multi-ancestry meta-regression, to discover and fine-map type 2 diabetes loci.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DIAMANTE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DIAMANTE Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DIAbetes Meta-ANalysis Trans-Ethnic association studies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Diabetes Meta-Analysis of Trans-Ethnic association studies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">DIAbetes Meta-ANalysis of Trans-Ethnic association studies</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90132183</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genetic study of type 2 diabetes highlights the power of diverse populations for discovery and translation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35551307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9179018/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We assembled an ancestrally diverse collection of genome-wide association studies (GWAS) of type 2 diabetes (T2D) in 180,834 cases and 1,159,055 controls (48.9% non-European descent) through the DIAMANTE (DIAbetes Meta-ANalysis of Trans-Ethnic association studies) Consortium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001002"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium established to assemble genome-wide association studies of type 2 diabetes across diverse ancestry groups. It meta-analyses them within its European and East Asian ancestry components and, together with African, Hispanic and South Asian ancestry studies, in a multi-ancestry meta-regression, to discover and fine-map type 2 diabetes loci.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35551307</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001002"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DIAMANTE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001003 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001003">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001039"/>
        <obo:IAO_0000112>GCST90134421</obo:IAO_0000112>
        <obo:IAO_0000115>A breast cancer genetics consortium, one of the five projects funded in 2010 under the NCI&apos;s Genetic Associations and Mechanisms in Oncology (GAME-ON) post-GWAS initiative. It meta-analysed genome-wide summary data shared by existing breast cancer GWAS and genotyped breast cancer cases and controls on the OncoArray, to replicate known and find new breast cancer susceptibility loci.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DRIVE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Discovery, Biology and Risk of Inherited Variants in Breast Cancer Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Discovery, Biology, and Risk of Inherited Variants in Breast Cancer</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90134421</owl:annotatedTarget>
        <dcterms:title>Investigating the shared genetic architecture of uterine leiomyoma and breast cancer: A genome-wide cross-trait analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35803233</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC9300879/</oboInOwl:hasDbXref>
        <rdfs:comment>This GWAS meta-analyzed data from BCAC and DRIVE (Discovery, Biology and Risk of Inherited Variants in Breast Cancer Consortium), combining 11.8 million variants in 122,977 BC-affected women (of which 69,501 were ER+ cases and 21,468 were ER–) and 105,974 female control subjects (all of European ancestry).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001003"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A breast cancer genetics consortium, one of the five projects funded in 2010 under the NCI&apos;s Genetic Associations and Mechanisms in Oncology (GAME-ON) post-GWAS initiative. It meta-analysed genome-wide summary data shared by existing breast cancer GWAS and genotyped breast cancer cases and controls on the OncoArray, to replicate known and find new breast cancer susceptibility loci.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:27598322</obo:IAO_0000119>
        <obo:IAO_0000119>https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001265/phs001265.v1.p1/GapExchange_phs001265.v1.p1.xml</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001003"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DRIVE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001003"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001039"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11322043/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>OncoArray genotyping and phenotype data harmonization for the Discovery, Biology, and Risk of Inherited Variants in Breast Cancer (DRIVE) breast-cancer case control samples was supported by X01 HG007491 and U19 CA148065 and by Cancer Research UK (C1287/A16563). Genotyping was conducted by the Center for Inherited Disease Research (CIDR), Centre for Cancer Genetic Epidemiology, University of Cambridge, and the National Cancer Institute. The following studies contributed germline DNA from breast cancer cases and controls: the Two Sister Study (2SISTER), Breast Oncology Galicia Network (BREOGAN), Copenhagen General Population Study (CGPS), Cancer Prevention Study 2 (CPSII), The European Prospective Investigation into Cancer and Nutrition (EPIC), Melbourne Collaborative Cohort Study (MCCS), Multiethnic Cohort (MEC), Nashville Breast Health Study (NBHS), Nurses Health Study (NHS), Nurses Health Study 2 (NHS2), Polish Breast Cancer Study (PBCS), Prostate Lung Colorectal and Ovarian Cancer Screening Trial (PLCO), Studies of Epidemiology and Risk Factors in Cancer Heredity (SEARCH), The Sister Study (SISTER), Swedish Mammographic Cohort (SMC), Women of African Ancestry Breast Cancer Study (WAABCS), Women’s Health Initiative (WHI).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001004 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001004">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Greece"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000065"/>
        <obo:IAO_0000112>GCST90132314</obo:IAO_0000112>
        <obo:IAO_0000115>A case-cohort study nested within the European Prospective Investigation into Cancer and Nutrition, designed to investigate the determinants of cardiovascular disease. EPIC participants with incident coronary heart disease or stroke, identified from 1991 to 2010, are compared with a centre-stratified random subcohort of EPIC participants with stored blood samples, in which molecular factors, including genotypes, are measured.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>EPIC CAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIC-CVD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIC-CVD case-cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPIC_CAD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European Prospective Investigation into Cancer and Nutrition – Cardiovascular Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">European Prospective Investigation into Cancer and Nutrition–Cardiovascular Disease Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
