    <!-- http://www.ebi.ac.uk/coho/COHO_0001545 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001545">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:40567118</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre observational study of patients with rheumatoid arthritis treated with biologic drugs at rheumatology centres across the United Kingdom, which collects their blood samples for DNA, RNA and cellular studies together with clinical, laboratory and adherence data, to study genetic and other predictors of response to biologic therapy. Its first patients, starting anti-TNF therapy, were identified through the British Society for Rheumatology Biologics Register; from November 2008 patients were recruited before starting a biologic and followed up prospectively for 12 months.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BRAGGSS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Biologics in Rheumatoid Arthritis Genetics and Genomics Study Syndicate</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001545"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:40567118</owl:annotatedTarget>
        <dcterms:title>Comparative Effectiveness of Abatacept Versus Adalimumab in Shared Epitope Positive and Negative Patients With Rheumatoid Arthritis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40567118</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40567118+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Biologics in Rheumatoid Arthritis Genetics and Genomics Study Syndicate is a nationwide observational cohort study recruiting patients from 53 centers across the United Kingdom before the initiation of biologic treatment and following them up prospectively for 12 months.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001545"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre observational study of patients with rheumatoid arthritis treated with biologic drugs at rheumatology centres across the United Kingdom, which collects their blood samples for DNA, RNA and cellular studies together with clinical, laboratory and adherence data, to study genetic and other predictors of response to biologic therapy. Its first patients, starting anti-TNF therapy, were identified through the British Society for Rheumatology Biologics Register; from November 2008 patients were recruited before starting a biologic and followed up prospectively for 12 months.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23039402</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25213131</obo:IAO_0000119>
