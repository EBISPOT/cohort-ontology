        <obo:IAO_0000112>GCST90704613</obo:IAO_0000112>
        <obo:IAO_0000115>A newly established community-based prospective cohort in Zhejiang Province, China, which since June 2021 has been enrolling participants from urban and rural areas at several project sites, among them people attending routine physical examinations, and collecting blood and serum at enrolment.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HOPE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HOPE Cohort</oboInOwl:hasRelatedSynonym>
