    <!-- http://www.ebi.ac.uk/coho/COHO_0000423 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000423">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90994634</obo:IAO_0000112>
        <obo:IAO_0000115>A national research cohort led by the National Institutes of Health that aims to enrol at least one million diverse adults in the United States, most from groups historically under-represented in biomedical research, through more than 340 recruitment sites, collecting health questionnaires, electronic health records, physical measurements, digital health data and biospecimens to advance precision medicine.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>All of Us</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AllOfUs</oboInOwl:hasRelatedSynonym>
