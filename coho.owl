        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Screening Markers for Colorectal Cancer Study</rdfs:label>
    </owl:NamedIndividual>
