    <!-- http://www.ebi.ac.uk/coho/COHO_0001323 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001323">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>GCST90244658</obo:IAO_0000112>
        <obo:IAO_0000115>A French multicentre case-control study of venous thromboembolism, run in 11 centres from 2003 to 2009, that enrolled consecutive adult inpatients and outpatients treated for a first objectively documented deep vein thrombosis and/or pulmonary embolism, without active cancer or malignancy in the previous 5 years, whose blood was mostly sampled in the week after diagnosis, and hospital controls matched for age, sex and centre with no history of venous or arterial thrombosis; the patients were also followed prospectively, to study risk factors for a first venous thromboembolism and for its recurrence.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Etude des Facteurs de Risque de thrombose Veineuse</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FARIVE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Facteurs de Risques et de Récidives de la Maladie Thromboembolique Veineuse</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">FActeurs de RIsque et de récidives de la maladie thromboembolique Veineuse</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001323"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244658</owl:annotatedTarget>
        <dcterms:title>Elevated plasma complement factor H related 5 protein is associated with venous thromboembolism.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37286573</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10247781/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The FARIVE study is a French multicentre case-control study carried out between 2003–2009, as previously described45.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001323"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
