        <obo:IAO_0000115>A population-based cohort of people with diabetes receiving primary care in an 11-county area of southern Wisconsin, United States, in 1979–1980, followed for decades to study the incidence and progression of diabetic retinopathy and other diabetes complications.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>WESDR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
