    <!-- http://www.ebi.ac.uk/coho/COHO_0000491 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000491">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000383"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000417"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000424"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000448"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000483"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000489"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000790"/>
