    <!-- http://www.ebi.ac.uk/coho/COHO_0001522 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001522">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:24958192</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control cohort for genetic studies of Alzheimer&apos;s disease, drawn from a prospective study of Alzheimer&apos;s disease in Flanders, Belgium, whose genetic studies are run from the University of Antwerp: unrelated patients with early- or late-onset possible or probable Alzheimer&apos;s disease, diagnosed by consensus of at least two neurologists at the memory clinics of the Hospital Network Antwerp (Middelheim and Hoge Beuken) and the University Hospitals Leuven and at other neurology centres of the Belgian Neurology (BELNEU) consortium, and healthy unrelated control individuals from Belgium, patients&apos; partners or community volunteers, with blood samples for DNA, cell lines and plasma and, for some patients, cerebrospinal fluid biomarkers.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Belgium_AD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Flanders-Belgian study cohort</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Flanders-Belgian AD cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001522"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
