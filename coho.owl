        <rdfs:comment>A study of 500 incident colorectal cancer cases and population controls, matched for age, sex and general practitioner, was conducted in the UK to investigate this hypothesis.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000597 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000597">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90504004</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of colorectal cancer in African Americans and whites in 33 counties of central and eastern North Carolina, United States, in which cases aged 40–80 were identified by rapid ascertainment through the North Carolina Central Cancer Registry, African Americans were oversampled, and controls were drawn from motor vehicle and Health Care Financing Administration records. Phase I enrolled colon cancer cases from October 1996 to September 2000 and phase II (NCCCS-II) cases of sigmoid, rectosigmoid and rectal cancer from May 2001 to September 2006, both collecting interview data on diet, medication use and other risk factors.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NC Colorectal Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCCCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCCCS I &amp; II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCCCS-II</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCCCSI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCCCSII</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>North Carolina Case-Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>North Carolina Colon Cancer Studies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">North Carolina Colon Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
