        <oboInOwl:hasRelatedSynonym>Asian Indian Diabetic Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Khatri Sikh Diabetes Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SDS/AIDHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SiDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sikh Diabetes Study</oboInOwl:hasRelatedSynonym>
