    <!-- http://www.ebi.ac.uk/coho/COHO_0001314 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001314">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90399575</obo:IAO_0000112>
        <obo:IAO_0000115>A diverse cohort of adults with type 2 diabetes who are members of the Henry Ford Health System with pharmacy-covered health insurance and live in southeast Michigan and the Detroit metropolitan area, invited on the basis of two or more recorded diagnoses of type 2 diabetes and an HbA1c of at least 6.5%, who at enrolment completed a research survey, clinical examination and specimen collection, and whose genome-wide genotypes are linked to longitudinal electronic records of laboratory results and medication fills to study the genetics of response to diabetes drugs.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DIAMOND</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Diabetes Multi-omic Investigation of Drug Response</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001314"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90399575</owl:annotatedTarget>
        <dcterms:title>Genome-Wide Association Study Identifies Pharmacogenomic Variants Associated With Metformin Glycemic Response in African American Patients With Type 2 Diabetes.</dcterms:title>
