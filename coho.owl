    <!-- http://www.ebi.ac.uk/coho/COHO_0000969 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000969">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>GCST90267908</obo:IAO_0000112>
        <obo:IAO_0000115>An international collaborative network of neuroimaging and genetics researchers at institutions worldwide, organised into working groups, that pools and meta-analyses brain MRI and genetic data from many sites, including patient populations, to find genetic and other factors that affect brain structure and function in health and disease; its first project was a genome-wide association study of hippocampal and intracranial volume.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ENIGMA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ENIGMA Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Enhancing NeuroImaging Genetics through Meta Analysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Enhancing NeuroImaging Genetics through Meta-Analysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Enhancing NeuroImaging Genetics through Meta-Analysis Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000969"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90267908</owl:annotatedTarget>
        <dcterms:title>Cross-ancestry genome-wide association meta-analyses of hippocampal and subfield volumes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37337106</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.nature.com/articles/s41588-023-01425-8</oboInOwl:hasDbXref>
        <rdfs:comment>The GWAS summary statistics used in this work from following two publicly available datasets: the UKBB study (https://open.win.ox.ac.uk/ukbiobank/big40/) and the ENIGMA study (https://enigma.ini.usc.edu/research/download-enigma-gwas-results/data-agreement-for-hippocampal-volume-gwas-download/).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000969"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international collaborative network of neuroimaging and genetics researchers at institutions worldwide, organised into working groups, that pools and meta-analyses brain MRI and genetic data from many sites, including patient populations, to find genetic and other factors that affect brain structure and function in health and disease; its first project was a genome-wide association study of hippocampal and intracranial volume.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24399358</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32198361</obo:IAO_0000119>
        <obo:IAO_0000119>https://enigma.ini.usc.edu/about-2/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000969"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ENIGMA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000970 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000970">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90454541</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based cohort of inhabitants aged 14 or older of the county of Tirschenreuth in north-eastern Bavaria, Germany, one of the German counties hardest hit by SARS-CoV-2 in spring 2020, randomly selected with stratification by sex and municipality, who gave blood samples and questionnaires at a baseline survey in June-July 2020 and at follow-ups in November 2020 and April 2021, to determine SARS-CoV-2 seroprevalence and its course over time, including undetected infections, the durability of antibody responses and new infections.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Prospective Covid-19 Cohort Tirschenreuth</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TiKoCo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TiKoCo-19</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>TiKoCo19</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Tirschenreuth COVID-19 cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Tirschenreuth Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000970"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
