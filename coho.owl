        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90992794</obo:IAO_0000112>
        <obo:IAO_0000115>A randomized, placebo-controlled trial of Ginkgo biloba for preventing incident dementia in 3069 adults aged 75 and over, 2587 cognitively normal and 482 with mild cognitive impairment, conducted from 2000 to 2008 at five academic centers in the United States.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GEM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GEM_Ginkgo</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ginkgo Evaluation of Memory (GEM) study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Ginkgo Evaluation of Memory Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000682"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90992794</owl:annotatedTarget>
        <dcterms:title>Sex-stratified genome-wide meta-analysis identifies novel loci for cognitive decline in older adults.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40042063</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11880917/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study included 3021 participants (1476 male and 1545 female) from three cohorts with longitudinal cognitive assessment: the Gingko Evaluation of Memory (GEM) study, the Monongahela‐Youghiogheny Healthy Aging Team (MYHAT), and the Monongahela Valley Independent Elders Survey (MoVIES).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000682"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomized, placebo-controlled trial of Ginkgo biloba for preventing incident dementia in 3069 adults aged 75 and over, 2587 cognitively normal and 482 with mild cognitive impairment, conducted from 2000 to 2008 at five academic centers in the United States.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:40042063</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000682"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GEM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000682"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GEM_Ginkgo</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000682"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11880917/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, GEM was a randomized, placebo‐controlled trial that was conducted from 2000 to 2008 across five different academic centers in the United States to assess the effectiveness of Ginkgo biloba on incident dementia in 3069 participants aged ≥ 75, including 2587 cognitively normal individuals and 482 individuals with mild cognitive impairment (MCI).</rdfs:comment>
    </owl:Axiom>
    


