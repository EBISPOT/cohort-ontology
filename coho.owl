    <!-- http://www.ebi.ac.uk/coho/COHO_0000992 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000992">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000367"/>
        <obo:IAO_0000112>GCST90841377</obo:IAO_0000112>
        <obo:IAO_0000115>A multi-site extension of the Alzheimer&apos;s Disease Neuroimaging Initiative, funded by the US Department of Defense, that enrolled Vietnam War veterans with a history of traumatic brain injury and/or ongoing post-traumatic stress disorder, with or without mild cognitive impairment, and veteran controls without either, identified mainly through Veterans Affairs records, and studies them with ADNI&apos;s clinical, cognitive, imaging and fluid biomarker methods to find whether these conditions contribute to the development of Alzheimer&apos;s disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ADNI Department of Defense studies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADNI-DOD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADNIDOD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DOD ADNI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DOD-ADNI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DoD-ADNI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Department of Defense Alzheimer&apos;s Disease Neuroimaging Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000992"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90841377</owl:annotatedTarget>
        <dcterms:title>Large multi-ethnic genetic analyses of amyloid imaging identify new genes for Alzheimer disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37101235</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10134547/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>These subjects were recruited from the Memory and Aging Project (MAP) at the Knight Alzheimer Disease Research Center (Knight-ADRC) [16, 17], Alzheimer&apos;s Disease Neuroimaging Initiative (ADNI) [18], the Dominantly Inherited Alzheimer Network (DIAN) [19], Anti-Amyloid Treatment in Asymptomatic Alzheimer&apos;s Disease (A4) [20], ADNI Department of Defense (ADNIDOD) studies, Australian Imaging, Biomarkers and Lifestyle (AIBL) [21], The Harvard Aging Brain Study (HABS) [22], and University of Pittsburgh (UPitt) [23].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000992"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multi-site extension of the Alzheimer&apos;s Disease Neuroimaging Initiative, funded by the US Department of Defense, that enrolled Vietnam War veterans with a history of traumatic brain injury and/or ongoing post-traumatic stress disorder, with or without mild cognitive impairment, and veteran controls without either, identified mainly through Veterans Affairs records, and studies them with ADNI&apos;s clinical, cognitive, imaging and fluid biomarker methods to find whether these conditions contribute to the development of Alzheimer&apos;s disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28758146</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:42316769</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
