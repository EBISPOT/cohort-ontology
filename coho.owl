    <!-- http://www.ebi.ac.uk/coho/COHO_0000127 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000127">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90295922</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of patients with gastroparesis recruited through the Gastroparesis Clinical Research Consortium (GpCRC), a network of gastrointestinal tertiary centres in the United States sponsored by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK), whose registry provided the gastroparesis cases of the GWAS Catalog study tagged NIDDK.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">NIDDK is the National Institute of Diabetes and Digestive and Kidney Diseases, a funding institute. The GWAS Catalog uses the cohort tag NIDDK for the NIDDK-sponsored Gastroparesis Clinical Research Consortium sample (GCST90295922), which is what this term denotes; studies that name NIDDK only as a funder (e.g. EGAS00001002937) are not this cohort.</obo:IAO_0000116>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">NIDDK</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90295922</owl:annotatedTarget>
        <dcterms:title>A pilot genome-wide association study meta-analysis of gastroparesis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37688361</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10576603/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Gastroparesis Clinical Research Consortium (GpCRC) is a network of GI tertiary centers in the United States sponsored by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK) that aims to advance knowledge and treatments for GP.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000127"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of patients with gastroparesis recruited through the Gastroparesis Clinical Research Consortium (GpCRC), a network of gastrointestinal tertiary centres in the United States sponsored by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK), whose registry provided the gastroparesis cases of the GWAS Catalog study tagged NIDDK.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37688361</obo:IAO_0000119>
