        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000485"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5290311/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For PEGASUS, non-cases between ages 55–74 years were selected between 1993 and 2001 from non-Hispanic white men in the Prostate, Lung, Colorectal, and Ovarian (PLCO) Cancer Screening Trial</rdfs:comment>
    </owl:Axiom>
    


