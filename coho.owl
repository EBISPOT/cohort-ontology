        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8273124/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>P.K.G. provided samples for genotyping through the New York Cancer Project (NYCP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001216"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort and biorepository of racially and ethnically diverse adults aged 30 or older living in the New York tri-state area, enrolled from January 2000 to December 2002 by the Academic Medical Development Company (AMDeC) Foundation, a consortium of New York institutions, at medical centres, community hospitals and community health centres in all five boroughs of New York City and at New York Blood Center donor drives. Participants completed a baseline questionnaire and gave blood for DNA and plasma, to be followed by questionnaires and registry linkage for studies of cancer aetiology and of racial and ethnic disparities in cancer risk, prevention and outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15136663</obo:IAO_0000119>
