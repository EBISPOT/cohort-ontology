    <!-- http://www.ebi.ac.uk/coho/COHO_0000448 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000448">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000776"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90244183</obo:IAO_0000112>
        <obo:IAO_0000115>A biobank cohort of patients of Geisinger Health System, an integrated health system in central and eastern Pennsylvania, United States, who since 2007 have given opt-in consent to link their samples to electronic health record data for broad research use, with genotype and exome sequence data generated in collaboration with the Regeneron Genetics Center.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym GHS also denotes Gutenberg Health Study (COHO:0000263); this term is MyCode Community Health Initiative.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>GHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GMC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GeHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Geisinger Medical Center</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Geisinger MyCode</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Geisinger MyCode Community Health Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MyCode</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MyCode Health Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MyCode biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">MyCode Community Health Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000448"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244183</owl:annotatedTarget>
        <dcterms:title>ANGPTL7, a therapeutic target for increased intraocular pressure and glaucoma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36192519</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9529959/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Association with IOP was tested on a total of 101,678 individuals and 27,529 individuals of European ancestry from the United Kingdom Biobank (UKB) and the MyCode Community Health Initiative cohort from Geisinger Health System (GHS), respectively.</rdfs:comment>
