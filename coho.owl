    <!-- http://www.ebi.ac.uk/coho/COHO_0000780 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000780">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
