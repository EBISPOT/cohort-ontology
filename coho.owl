        <obo:IAO_0000112>GCST90837567</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:42509442</obo:IAO_0000112>
        <obo:IAO_0000115>A genome-wide association sub-study of the Women&apos;s Health Initiative hormone therapy trials (dbGaP WHIMS+) of European-ancestry trial participants genotyped on the Illumina HumanOmniExpress array, selected so that together with WHI GARNET they represent the WHI European American hormone trial population. It comprises the participants of the WHI Memory Study (an ancillary trial of hormone therapy and cognition in 7,479 women aged 65–80) who were not in GARNET, and other hormone trial women, aged 65 or over or younger, who were in neither WHIMS nor GARNET.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>WHI Memory Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WHI-MS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WHIMS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WHIMS+</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Womens Health Initiative Memory Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Women&apos;s Health Initiative Memory Study</rdfs:label>
    </owl:NamedIndividual>
