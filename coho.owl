        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>GCST90704646</obo:IAO_0000112>
        <obo:IAO_0000115>A multi-site case-control study run with GlaxoSmithKline that recruited people with Alzheimer&apos;s disease from memory referral clinics in Canada, with cognitively unimpaired controls from their non-biological relatives, friends or spouses, to find genetic variants associated with Alzheimer&apos;s disease risk and age at onset.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GENADA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GenADA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GenADA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic Alzheimer’s Disease Associations</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genotype Phenotype Associations in Alzheimers Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Multi-Site Collaborative Study for Genotype-Phenotype Associations in Alzheimer&apos;s Disease</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000780"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90704646</owl:annotatedTarget>
        <dcterms:title>Consensus meta-analysis of genome-wide association studies for Alzheimer&apos;s disease and related dementias.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42237039</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Across all studies, we filtered out duplicated variants and those with (1) missing data for effect size, s.e. or P value; (2) an absolute effect size &gt;5 and (3) imputation quality &lt;0.3 (0.8 for the GenADA study).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000780"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multi-site case-control study run with GlaxoSmithKline that recruited people with Alzheimer&apos;s disease from memory referral clinics in Canada, with cognitively unimpaired controls from their non-biological relatives, friends or spouses, to find genetic variants associated with Alzheimer&apos;s disease risk and age at onset.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17998437</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
