    <!-- http://www.ebi.ac.uk/coho/COHO_0001613 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001613">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:2951410</obo:IAO_0000112>
        <obo:IAO_0000115>A nationwide Danish register of patients treated in psychiatric departments, with records collected systematically from 1938 and computerised from 1969, covering all admissions to psychiatric hospitals and psychiatric wards of general hospitals in Denmark, the Faroe Islands and Greenland and, since 1995, all psychiatric outpatient contacts, with dates of treatment, diagnoses, referral, place and mode of admission and municipality of residence. Kept within a psychiatric epidemiology research unit and fed since 1995 through the Danish National Patient Register, it is used for national health planning and psychiatric epidemiological research.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DPCR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DPCRR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Danish Psychiatric Central Register</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PCRR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Psychiatric Central Research Register</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Danish Psychiatric Central Research Register</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001613"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:2951410</owl:annotatedTarget>
        <dcterms:title>Excess mortality of bipolar and unipolar manic-depressive patients.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:2951410</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2951410+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To compare mortality in bipolar and unipolar manic-depressive patients, 2168 manic-depressive first admissions reported to the Danish Psychiatric Central Register were divided into a bipolar group (19%), i.e., patients with at least one admission for mania during an average observation period of six years, and a unipolar group.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001613"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nationwide Danish register of patients treated in psychiatric departments, with records collected systematically from 1938 and computerised from 1969, covering all admissions to psychiatric hospitals and psychiatric wards of general hospitals in Denmark, the Faroe Islands and Greenland and, since 1995, all psychiatric outpatient contacts, with dates of treatment, diagnoses, referral, place and mode of admission and municipality of residence. Kept within a psychiatric epidemiology research unit and fed since 1995 through the Danish National Patient Register, it is used for national health planning and psychiatric epidemiological research.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21775352</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26604824</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:9062767</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001613"/>
