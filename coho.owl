    <!-- http://www.ebi.ac.uk/coho/COHO_0001224 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001224">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>GCST90726344</obo:IAO_0000112>
        <obo:IAO_0000115>A Swedish study that between 2013 and 2017 recruited adults who had received electroconvulsive therapy (ECT) recorded in the Swedish National Quality Register for ECT, inviting registered patients by letter to a telephone interview and blood sampling and recruiting others at Swedish psychiatric hospitals before an ECT series, and that links their DNA, stored at the Karolinska Institutet Biobank, to the register&apos;s data on each treatment series, to study predictors of ECT outcome, including genetic ones, and the genetics of severe depressive episodes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PREFECT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PREFECT study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Predictors for ECT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Predictors For ECT</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001224"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
