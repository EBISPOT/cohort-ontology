    <!-- http://www.ebi.ac.uk/coho/COHO_0001320 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001320">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>GCST90295957</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre cohort of active and retired employees aged 35–74 years of six Brazilian universities and research institutions, with study centres in state capitals of north-eastern, south-eastern and southern Brazil, examined at baseline in 2008–2010 and at later visits and followed by annual telephone interviews, to investigate the development of chronic diseases, primarily diabetes and cardiovascular diseases.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym ELSA also denotes The English Longitudinal Study of Ageing (COHO:0000163); this term is Estudo Longitudinal de Saúde do Adulto.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>Brazil Longitudinal Study of Adult Health</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Brazilian Longitudinal Study of Adult Health</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ELSA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ELSA-Brasil</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Estudo Longitudinal de Saude do Adulto</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Estudo Longitudinal de Saude do Adulto cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Longitudinal Study of Adult Health</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Estudo Longitudinal de Saúde do Adulto</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001320"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90295957</owl:annotatedTarget>
        <dcterms:title>Genome-wide study investigating effector genes and polygenic prediction for kidney function in persons with ancestry from Africa and the Americas.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38190104</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10794846/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Brazil Longitudinal Study of Adult Health (ELSA): the authors thank the staff and participants of the Elsa Study for their important contributions.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001320"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre cohort of active and retired employees aged 35–74 years of six Brazilian universities and research institutions, with study centres in state capitals of north-eastern, south-eastern and southern Brazil, examined at baseline in 2008–2010 and at later visits and followed by annual telephone interviews, to investigate the development of chronic diseases, primarily diabetes and cardiovascular diseases.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24585730</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
