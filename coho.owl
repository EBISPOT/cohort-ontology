    <!-- http://www.ebi.ac.uk/coho/COHO_0000414 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000414">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90317902</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal cohort, the Clinical Core study of the Wisconsin Alzheimer&apos;s Disease Research Center, a National Institute on Aging-funded centre established in 2009 at the University of Wisconsin–Madison, United States, in which adults aged 45 and over, recruited into subgroups with mild late-onset Alzheimer disease, mild cognitive impairment, healthy older controls, and middle-aged adults with a positive, negative or indeterminate parental history of Alzheimer disease, attend annual or every-other-year visits with a study partner for memory and thinking evaluations, blood draws and biomarker visits with MRI, lumbar puncture and PET, to study memory, ageing and Alzheimer disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>WADRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Wisconsin ADRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Wisconsin ADRC Clinical Core</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Wisconsin Alzheimer&apos;s Disease Research Center</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000414"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90317902</owl:annotatedTarget>
        <dcterms:title>Genetic architecture of cerebrospinal fluid and brain metabolite levels and the genetic colocalization of metabolites with human traits.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39528826</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-024-01973-7/MediaObjects/41588_2024_1973_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Panyard et al CSF MGWAS study6 included 291 participants together from WADRC and WRAP cohorts.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000414"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
