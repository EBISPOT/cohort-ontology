    <!-- http://www.ebi.ac.uk/coho/COHO_0000972 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000972">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>GCST90559230</obo:IAO_0000112>
        <obo:IAO_0000115>A multi-study case–control collection at the Broad Institute, an extension of the Broad AF study, focused on cardiovascular diseases including atrial fibrillation, mitral valve prolapse, atrioventricular nodal reentrant tachycardia, supraventricular tachycardia and bradyarrhythmia, whose samples&apos; DNA was imported to the Broad and jointly genotyped. It was funded as part of a collaboration between the Broad Institute and Bayer AG.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Broad CVDi</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Broad CardioVascular Disease initiative study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Broad Cardiovascular Disease Initiative Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000972"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90559230</owl:annotatedTarget>
        <dcterms:title>Meta-analysis of genome-wide associations and polygenic risk prediction for atrial fibrillation in more than 180,000 cases.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40050429</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC12094172/</oboInOwl:hasDbXref>
        <rdfs:comment>As an LD reference, the TOPMed imputed genotype data from the European ancestry participants of the Broad Cardiovascular Disease Initiative (Broad CVDi) study was used (n = 32,715).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000972"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multi-study case–control collection at the Broad Institute, an extension of the Broad AF study, focused on cardiovascular diseases including atrial fibrillation, mitral valve prolapse, atrioventricular nodal reentrant tachycardia, supraventricular tachycardia and bradyarrhythmia, whose samples&apos; DNA was imported to the Broad and jointly genotyped. It was funded as part of a collaboration between the Broad Institute and Bayer AG.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:40050429</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
