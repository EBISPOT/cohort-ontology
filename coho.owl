        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Brain Development and Air Pollution Ultrafine Particles in School Children</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001147"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90568440</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of childhood ADHD symptoms and diagnosis identifies new loci and potential effector genes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40962958</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02295-y/MediaObjects/41588_2025_2295_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Participants were drawn from the BREATHE project (European Commission: FP7-ERC-2010-AdG, ID</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001147"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of children aged 7–10 years in grades 2 to 4 at 39 primary schools in Barcelona, Spain, selected as pairs with high and low traffic-related air pollution, whose working memory and attention were tested four times, every three months, from January 2012 to March 2013, with brain MRI in a subsample, to study the effects of traffic-related air pollution on cognitive and brain development.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25734425</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31539824</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001147"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BDAPUSC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001147"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BREATHE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001147"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31539824+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Among the children recruited through a set of representative schools of the city of Barcelona, (Spain) in the Brain Development and Air Pollution Ultrafine Particles in School Children (BREATHE) study, 186 typically developing participants aged 8-12 years underwent brain MRI on the same 1.5 T MR unit over a 1.5-year period (October 2012-April 2014).</rdfs:comment>
    </owl:Axiom>
    


