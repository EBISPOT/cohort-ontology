    <!-- http://www.ebi.ac.uk/coho/COHO_0001026 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001026">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90651078</obo:IAO_0000112>
        <obo:IAO_0000115>A birth cohort of people born in one week in March 1946 in England, Scotland and Wales, selected as a social-class-stratified sample of the singleton births to married mothers that week and followed up repeatedly from birth into old age through home visits, questionnaires and clinic assessments. The oldest of the British national birth cohort studies, it is core-funded by the UK Medical Research Council and has been developed since 2008 by the MRC Unit for Lifelong Health and Ageing at UCL into an interdisciplinary study of ageing.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>1946 National Birth Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MRC NSHD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NSHD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Survey of Health and Development</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">MRC National Survey of Health and Development</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001026"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90651078</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of age at onset of walking in over 70,000 infants of European ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40335706</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12283345/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a GWAS meta-analysis of AOW in 70,560 children including data from four European-ancestry cohorts: the Norwegian Mother, Father and Child Cohort Study20,21 (MoBa, N = 58,302), the Netherlands Twin Register22 (NTR, N = 6,251), the Lifelines multigenerational prospective population-based birth cohort study23 from the North of the Netherlands (N = 3,415) and the United Kingdom Medical Research Council National Study for Health and Development24 (NSHD, N = 2,592).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001026"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A birth cohort of people born in one week in March 1946 in England, Scotland and Wales, selected as a social-class-stratified sample of the singleton births to married mothers that week and followed up repeatedly from birth into old age through home visits, questionnaires and clinic assessments. The oldest of the British national birth cohort studies, it is core-funded by the UK Medical Research Council and has been developed since 2008 by the MRC Unit for Lifelong Health and Ageing at UCL into an interdisciplinary study of ageing.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21345808</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23637643</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27995394</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001026"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MRC NSHD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001026"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NSHD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001026"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12283345/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>NSHD is a population-based prospective birth cohort study whose participants were infants from single births born in England, Scotland and Wales during 1 week in March 1946 (N = 5,362) to women with husbands24.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001027 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001027">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90624115</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of newborns with Down syndrome enrolled at birth in 18 hospitals in the United Kingdom from 2006 to 2017, screened for GATA1 mutations and followed with serial clinical and haematological data from birth to 4 years of age, to study transient abnormal myelopoiesis, preleukaemic GATA1 mutations and the risk of myeloid leukaemia in children with Down syndrome.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ODSCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Oxford DS Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Oxford Down Syndrome Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001027"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90624115</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of somatic GATA1s mutations in newborns with Down syndrome.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40249915</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12391799/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To address the question of why only a subset of DS newborns develop transient leukemia, we performed a comprehensive genetic epidemiology study of GATA1s mutations via whole-genome sequencing (WGS) plus targeted GATA1 sequencing of 434 children with DS in the Oxford Down Syndrome Cohort Study (ODSCS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001027"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of newborns with Down syndrome enrolled at birth in 18 hospitals in the United Kingdom from 2006 to 2017, screened for GATA1 mutations and followed with serial clinical and haematological data from birth to 4 years of age, to study transient abnormal myelopoiesis, preleukaemic GATA1 mutations and the risk of myeloid leukaemia in children with Down syndrome.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24021668</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40249915</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40407036</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001027"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ODSCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001027"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12391799/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The study comprised 434 newborns with DS from the ODSCS, a prospective cohort that enrolled children with DS between 2006 to 2017 from 18 hospitals in the United Kingdom.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001028 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001028">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>GCST90454192</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of patients aged 16 or older receiving methadone or buprenorphine–naloxone treatment for opioid use disorder at outpatient clinics of the Canadian Addiction Treatment Centres across Ontario, Canada, recruited by McMaster University researchers from May 2018 to January 2023 as an extension of the Genetics of Opioid Addiction study with a similar protocol. Participants were interviewed at entry, gave a saliva sample for DNA and were followed for up to 12 months through their medical records and urine drug screens, to study biopsychosocial and genetic factors in treatment outcomes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>POST</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Pharmacogenetics of Opioid Substitution Treatment Response</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001028"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90454192</owl:annotatedTarget>
        <dcterms:title>A genome-wide association, polygenic risk score and sex study on opioid use disorder treatment outcomes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38102185</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10724251/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Data were collected as part of the GENetics of Opioid Addiction (GENOA) and Pharmacogenetics of Opioid Substitution Treatment Response (POST) programs.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001028"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of patients aged 16 or older receiving methadone or buprenorphine–naloxone treatment for opioid use disorder at outpatient clinics of the Canadian Addiction Treatment Centres across Ontario, Canada, recruited by McMaster University researchers from May 2018 to January 2023 as an extension of the Genetics of Opioid Addiction study with a similar protocol. Participants were interviewed at entry, gave a saliva sample for DNA and were followed for up to 12 months through their medical records and urine drug screens, to study biopsychosocial and genetic factors in treatment outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32326982</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:33622351</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38102185</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40527567</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
