    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001438"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90000618</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies 143 loci associated with 25 hydroxyvitamin D concentration.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32242144</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7118120/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The largest GWAS for 25OHD to date, from the SUNLIGHT consortium8, used BMI as a covariate, hence we also generated UKB results including BMI in the model and used those for meta-analysis.</rdfs:comment>
    </owl:Axiom>
