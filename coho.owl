    <!-- http://www.ebi.ac.uk/coho/COHO_0001542 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001542">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:32231276</obo:IAO_0000112>
        <obo:IAO_0000115>A German case-control study of major depressive disorder whose cases were consecutive admissions with a DSM-IV lifetime diagnosis of major depressive disorder to the psychiatric inpatient units of the University of Bonn and of the Central Institute of Mental Health in Mannheim, diagnosed by best-estimate consensus from a structured interview (SCID-I or SADS), medical records and family history and excluding bipolar disorder, non-affective psychosis and substance-related depression, and whose controls came from the German population-based studies PopGen, KORA and Heinz Nixdorf Recall. It is one of the cohorts of the Psychiatric Genomics Consortium&apos;s major depressive disorder working group (cohort code boma).</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym BOMA also denotes BOMA-Bipolar Study (COHO:0001543); this term is Bonn-Mannheim MDD study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>BOMA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BoMa</oboInOwl:hasRelatedSynonym>
