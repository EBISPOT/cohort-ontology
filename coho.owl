    <!-- http://www.ebi.ac.uk/coho/COHO_0001325 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001325">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>GCST90451684</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of whole-blood donors aged 18–70 recruited by the Finnish Red Cross Blood Service alongside standard donation at three fixed donation sites in the Helsinki metropolitan area of Finland (Kivihaka, Sanomatalo and Espoo) from May 2015 to December 2017, with blood samples taken at their donation visits during the study for blood counts, CRP, ferritin and soluble transferrin receptor and for DNA, and health and lifestyle questionnaires at enrolment and again in 2018, to study iron status and the genetic and lifestyle factors affecting iron stores in blood donors.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>FinDonor</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FinDonor 10000</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">FinDonor 10 000 study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001325"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90451684</owl:annotatedTarget>
        <dcterms:title>Novel loci and biomedical consequences of iron homoeostasis variation.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39643614</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11624196/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>FinDonor 10000 (FinDonor) is a prospective study observing blood donor iron stores and genetic and lifestyle factors associated with iron stores.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001325"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of whole-blood donors aged 18–70 recruited by the Finnish Red Cross Blood Service alongside standard donation at three fixed donation sites in the Helsinki metropolitan area of Finland (Kivihaka, Sanomatalo and Espoo) from May 2015 to December 2017, with blood samples taken at their donation visits during the study for blood counts, CRP, ferritin and soluble transferrin receptor and for DNA, and health and lifestyle questionnaires at enrolment and again in 2018, to study iron status and the genetic and lifestyle factors affecting iron stores in blood donors.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31657023</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001325"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FinDonor</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001325"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31657023+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A total of 2584 blood donors (N = 8003 samples) were recruited into the study alongside standard donation at three donation sites in the capital region of Finland between 5/2015 and 12/2017.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001326 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001326">
