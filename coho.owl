        <rdfs:comment>A total of 161,838 women aged 50–79 years old were recruited from 40 clinical centers in the US between 1993 and 1998.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000505"/>
