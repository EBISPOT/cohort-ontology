    <!-- http://www.ebi.ac.uk/coho/COHO_0001523 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001523">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:15539711</obo:IAO_0000112>
        <obo:IAO_0000115>A family study begun in 1994 at Brigham and Women&apos;s Hospital, Boston, to find genetic determinants of chronic obstructive pulmonary disease other than alpha-1 antitrypsin deficiency, which enrols extended pedigrees, mainly in New England, ascertained through probands with severe COPD (FEV1 at most 40% predicted) before age 53 and without severe alpha-1 antitrypsin deficiency, recruited from lung transplant and general pulmonary clinics, together with their first- and second-degree relatives aged 10 years or older.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BECOPD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BEOCOPD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Boston Early-Onset COPD study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Boston Early-Onset Chronic Obstructive Pulmonary Disease study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Boston Early-Onset COPD Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001523"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
