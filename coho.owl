    <!-- http://www.ebi.ac.uk/coho/COHO_0000994 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000994">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90297564</obo:IAO_0000112>
        <obo:IAO_0000115>An unselected birth cohort of children born in 1992–1993 in Ashford, Kent, England, whose mothers were recruited in pregnancy from 1991 as the UK cohort of the Asthma Multicentre Infant Cohort Study, with house-dust allergen measured in infancy and follow-up by questionnaire, lung function and skin prick tests to age 14 years and a questionnaire at about age 20, to study how early-life allergen exposure and other factors relate to the development of atopy, wheeze and asthma.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ASHFORD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ashford</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ashford cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Asthma in Ashford</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Asthma in Ashford study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Ashford study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000994"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90297564</owl:annotatedTarget>
        <dcterms:title>A meta-analysis of genome-wide association studies of childhood wheezing phenotypes identifies ANXA1 as a susceptibility locus for persistent wheezing.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37227431</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10292845/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Ashford study is an unselected birth cohort study established in 1991 in Ashford, UK (Atkinson et al., 1999).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000994"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An unselected birth cohort of children born in 1992–1993 in Ashford, Kent, England, whose mothers were recruited in pregnancy from 1991 as the UK cohort of the Asthma Multicentre Infant Cohort Study, with house-dust allergen measured in infancy and follow-up by questionnaire, lung function and skin prick tests to age 14 years and a questionnaire at about age 20, to study how early-life allergen exposure and other factors relate to the development of atopy, wheeze and asthma.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10232430</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:15454651</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:16950296</obo:IAO_0000119>
