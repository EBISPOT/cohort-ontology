        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90244577</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre randomised controlled trial in primary care in Bristol, Birmingham and Newcastle, United Kingdom, in which adults aged 18–74 with a new episode of depression (an ICD-10 depressive episode and a Beck Depression Inventory score of at least 15), recruited from September 2005, were randomly allocated to citalopram or reboxetine to identify genetic and clinical predictors of response to antidepressant treatment.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GENPOD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GenPOD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GenPod</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">GENetic and clinical Predictors Of treatment response in Depression</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000962"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244577</owl:annotatedTarget>
        <dcterms:title>Identifying the Common Genetic Basis of Antidepressant Response.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35712048</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9117153/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GENPOD (GENetic and clinical Predictors Of treatment response in Depression) trial was funded by the UK Medical Research Council and supported by the UK Mental Health Research Network.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000962"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
