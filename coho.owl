        <obo:IAO_0000112>GCST90013445</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal study of cardiovascular disease risk factors in young people in Northern Ireland, which screened a random sample of 12- and 15-year-olds from post-primary schools in 1989–1990, re-examined the younger group at age 15 in 1992–1993, and invited the whole sample back for examination as young adults in 1997–1999. A second school sample of 12- and 15-year-olds was surveyed in 1999–2001 as Young Hearts 2000.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Northern Ireland Young Hearts Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>YH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Hearts Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Hearts Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Young Hearts-NI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Northern Ireland Young Hearts Project</rdfs:label>
    </owl:NamedIndividual>
