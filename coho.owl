        <obo:IAO_0000112>GCST90271572</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of women admitted for obstetric care at seven hospitals in Lima, Peru, between March 2013 and December 2015, with cases of placental abruption and of preterm birth and controls selected at random from women delivering at the same hospitals, designed to investigate the genetic and environmental determinants of placental abruption and other adverse pregnancy outcomes.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym PAGE also denotes Psoriasis Association Genetics Extension (COHO:0000145); this term is Placental Abruption Genetic Epidemiology study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>PAGE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PAGEPI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Placental Abruption Genetic Epidemiology</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Placental Abruption Genetic Epidemiology study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001268"/>
