        <obo:IAO_0000112>GCST90841377</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal observational study of cognitively normal older adults, designed to distinguish normal ageing from preclinical Alzheimer&apos;s disease, with demographic, clinical, neuropsychological, clinical biomarker and neuroimaging data, including amyloid PET acquired at Massachusetts General Hospital in Boston, United States.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HABS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Harvard aging brain study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Harvard Aging Brain Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000948"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90841377</owl:annotatedTarget>
        <dcterms:title>Large multi-ethnic genetic analyses of amyloid imaging identify new genes for Alzheimer disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37101235</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10134547/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>These subjects were recruited from the Memory and Aging Project (MAP) at the Knight Alzheimer Disease Research Center (Knight-ADRC) [16, 17], Alzheimer&apos;s Disease Neuroimaging Initiative (ADNI) [18], the Dominantly Inherited Alzheimer Network (DIAN) [19], Anti-Amyloid Treatment in Asymptomatic Alzheimer&apos;s Disease (A4) [20], ADNI Department of Defense (ADNIDOD) studies, Australian Imaging, Biomarkers and Lifestyle (AIBL) [21], The Harvard Aging Brain Study (HABS) [22], and University of Pittsburgh (UPitt) [23].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000948"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal observational study of cognitively normal older adults, designed to distinguish normal ageing from preclinical Alzheimer&apos;s disease, with demographic, clinical, neuropsychological, clinical biomarker and neuroimaging data, including amyloid PET acquired at Massachusetts General Hospital in Boston, United States.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25843019</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000948"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HABS</owl:annotatedTarget>
