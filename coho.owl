    <!-- http://www.ebi.ac.uk/coho/COHO_0000917 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000917">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <obo:IAO_0000112>GCST90854196</obo:IAO_0000112>
        <obo:IAO_0000115>A multinational study that recruited HIV-1 controllers, people with HIV whose plasma viral load stays below 2000 RNA copies/ml (at least three measurements over at least 12 months) without antiretroviral therapy, for genome-wide association analysis of host genetic effects on the control of HIV infection.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym IHCS also denotes Intermountain Heart Collaborative Study (COHO:0000565); this term is International HIV Controllers Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>ICSC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IHCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IHIVCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>International HIV controllers Study Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">International HIV Controllers Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000917"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90854196</owl:annotatedTarget>
        <dcterms:title>Multiancestry sex-stratified genomic associations with HIV viral load and controller status from the ICGH.</dcterms:title>
