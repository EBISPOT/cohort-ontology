        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000618"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Israel"/>
