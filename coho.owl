    <!-- http://www.ebi.ac.uk/coho/COHO_0000967 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000967">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90267402</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of non-Hodgkin lymphoma in the San Francisco Bay Area, California, that enrolled residents of six Bay Area counties aged 20-85 with incident non-Hodgkin lymphoma diagnosed from 2001 through 2006, identified through the cancer registry by rapid case ascertainment, and controls found by random-digit dialling and from Medicare lists, frequency-matched to the cases on age, sex and county, with in-person interviews, blood or buccal specimens and expert re-review of the cases&apos; pathology.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SF Bay Area NHL2 study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SF-NHL2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UCSF2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>University of California at San Francisco Molecular Epidemiology of Non-Hodgkin Lymphoma study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Molecular Epidemiology of non-Hodgkin lymphoma</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000967"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90267402</owl:annotatedTarget>
        <dcterms:title>Distinct germline genetic susceptibility profiles identified for common non-Hodgkin lymphoma subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36273105</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10337695/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>For GWAS with multiple NHL subtypes using the same set of controls (e.g., NCI NHL, UCSF2), association testing was conducted for all NHL subtypes combined, adjusting for age, sex, and significant principal components, in a single analysis and then meta-analyzed with the other GWAS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000967"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of non-Hodgkin lymphoma in the San Francisco Bay Area, California, that enrolled residents of six Bay Area counties aged 20-85 with incident non-Hodgkin lymphoma diagnosed from 2001 through 2006, identified through the cancer registry by rapid case ascertainment, and controls found by random-digit dialling and from Medicare lists, frequency-matched to the cases on age, sex and county, with in-person interviews, blood or buccal specimens and expert re-review of the cases&apos; pathology.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18636124</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25133503</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
