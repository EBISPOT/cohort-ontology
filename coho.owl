    <!-- http://www.ebi.ac.uk/coho/COHO_0001103 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001103">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>GCST90103971</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of patients with histopathologically confirmed cutaneous melanoma managed at Melanoma Institute Australia in Sydney, Australia, identified with written informed consent from the institute&apos;s Biospecimen Bank and Research Database, whose germline DNA was genotyped genome-wide in phases from 2014 and who are followed prospectively for outcomes including death from melanoma, ascertained from clinical records and linkage to Australian cancer registries.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MIA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Melanoma Institute Australia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Melanoma Institute Australia cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001103"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90103971</owl:annotatedTarget>
        <dcterms:title>Multi-Trait Genetic Analysis Identifies Autoimmune Loci Associated with Cutaneous Melanoma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34813871</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34813871+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Of these loci, 55 were replicated (P &lt; 0.05/74, Bonferroni-corrected P-value in two independent cutaneous melanoma replication cohorts from Melanoma Institute Australia and 23andMe, Inc.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001103"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of patients with histopathologically confirmed cutaneous melanoma managed at Melanoma Institute Australia in Sydney, Australia, identified with written informed consent from the institute&apos;s Biospecimen Bank and Research Database, whose germline DNA was genotyped genome-wide in phases from 2014 and who are followed prospectively for outcomes including death from melanoma, ascertained from clinical records and linkage to Australian cancer registries.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32716505</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36064556</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001103"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MIA</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001103"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9446843/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>With written, informed consent, patients with histo-pathological confirmed CM cases managed at MIA, Sydney, Australia were identified from this Biospecimen Bank and Database.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001104 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001104">
