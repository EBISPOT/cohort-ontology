        <obo:IAO_0000112>GCST012442</obo:IAO_0000112>
        <obo:IAO_0000115>A general-population sample of Icelanders, enriched for carriers of rare and potentially high-impact mutations, comprehensively phenotyped by deCODE genetics in Iceland (e.g. audiometry, speech recordings, DXA body composition, plasma proteomics) and combined with the Icelandic genotype and sequence data for genetic association studies.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym DHS also denotes Dortmund Health Study (COHO:0000054), Diabetes Heart Study (COHO:0000460) and Dallas Heart Study (COHO:0001309); this term is deCODE Health Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>DHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>dHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>deCODE health study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">deCODE Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000468"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST012442</owl:annotatedTarget>
        <dcterms:title>The genetic architecture of age-related hearing impairment revealed by genome-wide association analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34108613</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8190123/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted a GWAS of ARHI in three datasets obtained from the deCODE health study (DHS)24, the National Institute of Hearing and Speech in Iceland (NIHSI) and the UKB (Fig. 1, Supplementary Table 2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000468"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A general-population sample of Icelanders, enriched for carriers of rare and potentially high-impact mutations, comprehensively phenotyped by deCODE genetics in Iceland (e.g. audiometry, speech recordings, DXA body composition, plasma proteomics) and combined with the Icelandic genotype and sequence data for genetic association studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33982893</obo:IAO_0000119>
