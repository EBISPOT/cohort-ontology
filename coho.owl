    <!-- http://www.ebi.ac.uk/coho/COHO_0000973 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000973">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>GCST001595</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of men and women aged 25 years and older, recruited in 1995–1997 by random telephone contact from within 50 km of nine regional centres across Canada, and followed with annual mailed questionnaires, repeated interviews and bone density measurements to study osteoporosis and fractures; a youth cohort aged 16–24 was added in 2004–2006.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CAMOS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CaMos</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Canadian MultiCentre Osteoporosis study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Canadian Multicentre Osteoporosis Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000973"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST001595</owl:annotatedTarget>
        <dcterms:title>WNT16 influences bone mineral density, cortical bone thickness, bone strength, and osteoporotic fracture risk.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22792071</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3390364/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Canadian MultiCentre Osteoporosis study (CaMos) is a population-based prospective study of 9,423 men and women from across Canada, followed for fourteen years for osteoporotic outcomes and risk factors [55].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000973"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort of men and women aged 25 years and older, recruited in 1995–1997 by random telephone contact from within 50 km of nine regional centres across Canada, and followed with annual mailed questionnaires, repeated interviews and bone density measurements to study osteoporosis and fractures; a youth cohort aged 16–24 was added in 2004–2006.</owl:annotatedTarget>
        <obo:IAO_0000119>https://camos.org/protocol/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
