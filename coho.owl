        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4057636/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>9. KORCULA (Polasek et al. 2009) — Croatia. This study was performed in the eastern part of the island of Korčula, Croatia between March and December 2007.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000461"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
