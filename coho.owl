    <!-- http://www.ebi.ac.uk/coho/COHO_0001600 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001600">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <obo:IAO_0000112>PMID:23143601</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control study of lung cancer based at Chonnam National University Hwasun Hospital in Jeollanam-do, South Korea. From 2000 it enrolled consecutive patients, all ethnic Koreans, with newly diagnosed, histologically confirmed incident lung cancer, excluding secondary or recurrent tumours, and compared them with population-based controls to study genetic susceptibility to lung cancer. Its never-smoking women were genotyped genome-wide as one of the studies of the Female Lung Cancer Consortium in Asia.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CNULCS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Chonnam National University Lung Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001600"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23143601</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analysis identifies new lung cancer susceptibility loci in never-smoking women in Asia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23143601</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4169232/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Internal sets (HKS, SNU, CNULCS, SWHS, YLCS and components of samples from Japan and GELAC) were genotyped at the NCI Cancer Genomic Research (CGR) Laboratory using the Illumina 660W SNP microarray.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001600"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case–control study of lung cancer based at Chonnam National University Hwasun Hospital in Jeollanam-do, South Korea. From 2000 it enrolled consecutive patients, all ethnic Koreans, with newly diagnosed, histologically confirmed incident lung cancer, excluding secondary or recurrent tumours, and compared them with population-based controls to study genetic susceptibility to lung cancer. Its never-smoking women were genotyped genome-wide as one of the studies of the Female Lung Cancer Consortium in Asia.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21316118</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:21342495</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23143601</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
