        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15136663+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Showing the feasibility of constructing a cohort based in New York City, plans proceed for additional recruitment and analyses on the salient questions about cancer.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001217 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001217">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <obo:IAO_0000112>GCST90454537</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based biobank study established in 2016 in Okinawa Prefecture, Japan, through the Okinawa Bioinformation Bank Project promoted by the University of the Ryukyus and Okinawa Prefecture, whose participants, recruited on Okinawa&apos;s islands including the Miyako Islands, give blood or saliva for DNA and genome-wide genotyping together with health check-up results, lifestyle questionnaires and, for some, the birthplaces of their four grandparents. It aims to clarify the population history of the Ryukyu islanders and to find genetic factors in common and rare diseases.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>OBi</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Okinawa Bioinformation Bank Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Okinawa Bioinformation Bank</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001217"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90454537</owl:annotatedTarget>
        <dcterms:title>Genome-wide association studies for pelvic organ prolapse in the Japanese population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39349682</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11443051/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a GWAS for POP in Japanese participants registered in the Okinawa Bioinformation Bank (OBi) and Biobank Japan (BBJ) (Supplementary Fig. 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001217"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based biobank study established in 2016 in Okinawa Prefecture, Japan, through the Okinawa Bioinformation Bank Project promoted by the University of the Ryukyus and Okinawa Prefecture, whose participants, recruited on Okinawa&apos;s islands including the Miyako Islands, give blood or saliva for DNA and genome-wide genotyping together with health check-up results, lifestyle questionnaires and, for some, the birthplaces of their four grandparents. It aims to clarify the population history of the Ryukyu islanders and to find genetic factors in common and rare diseases.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:33432348</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37903429</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39987337</obo:IAO_0000119>
