    <!-- http://www.ebi.ac.uk/coho/COHO_0001315 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001315">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
