        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90267408</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre population-based case-control study of colorectal cancer in the Rhine-Neckar region of south-west Germany, led from the German Cancer Research Center in Heidelberg, which from 2003 recruited patients aged 30 or over with a first colorectal cancer diagnosis from the 22 hospitals treating the disease in the region, and actively follows the cases to study colorectal cancer risk, prevention by screening and survival.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DACHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DACHS study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Darmkrebs: Chancen der Verhütung durch Screening Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Darmkrebs: Chancen der Verhütung durch Screening</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000556"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90267408</owl:annotatedTarget>
        <dcterms:title>Genome-wide study of genetic polymorphisms predictive for outcome from first-line oxaliplatin-based chemotherapy in colorectal cancer patients.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37539667</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37539667+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We used data from two phase III trials, NCCTG N0147 and NCCTG N9741 and a population-based patient cohort, DACHS.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000556"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre population-based case-control study of colorectal cancer in the Rhine-Neckar region of south-west Germany, led from the German Cancer Research Center in Heidelberg, which from 2003 recruited patients aged 30 or over with a first colorectal cancer diagnosis from the 22 hospitals treating the disease in the region, and actively follows the cases to study colorectal cancer risk, prevention by screening and survival.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5946295/fullTextXML</obo:IAO_0000119>
