        <obo:IAO_0000112>GCST90095044</obo:IAO_0000112>
        <obo:IAO_0000115>A multiethnic longitudinal study of healthy children at five clinical centres in the United States, enrolled from 2002–2003 at ages 6 to 16 years (1,554 children), with a later enrolment wave of 5- and 19-year-olds, measured annually by dual-energy X-ray absorptiometry for up to 6 years, established to provide reference curves for bone mineral content and density by age, sex and race.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BMDCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Bone Mineral Density in Childhood Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000898"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90095044</owl:annotatedTarget>
        <dcterms:title>CYP11B1 variants influence skeletal maturation via alternative splicing.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34754074</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8578655/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>A GWAS meta-analysis including 9,806,907 single-nucleotide polymorphisms (SNPs) was performed in 4557 children of multiethnic background participating in the Generation R Study (N = 3510, 49% boys; mean age 9.8, SD = 0.33 years) and the Bone Mineral Density in Childhood Study (BMDCS) (N = 1047, 47% boys; mean age 10.9, SD = 1.39 years) to identify loci associated with SA (assessed in years in both cohorts).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000898"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multiethnic longitudinal study of healthy children at five clinical centres in the United States, enrolled from 2002–2003 at ages 6 to 16 years (1,554 children), with a later enrolment wave of 5- and 19-year-olds, measured annually by dual-energy X-ray absorptiometry for up to 6 years, established to provide reference curves for bone mineral content and density by age, sex and race.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17311856</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34754074</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000898"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BMDCS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000898"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17311856+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The Bone Mineral Density in Childhood Study is an ongoing longitudinal study in which measurements are obtained annually at five clinical centers in the United States.</rdfs:comment>
    </owl:Axiom>
    


