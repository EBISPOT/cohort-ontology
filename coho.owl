    <!-- http://www.ebi.ac.uk/coho/COHO_0000460 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000460">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000990"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90278455</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based, family-based study of European American and African American siblings concordant for type 2 diabetes and their unaffected relatives (1,443 participants from 564 families), recruited from internal medicine and endocrinology clinics in western North Carolina, United States, and examined at Wake Forest Baptist Medical Center to study genetic and epidemiological contributions to diabetic heart disease and subclinical cardiovascular disease; a parallel African American-Diabetes Heart Study (AA-DHS) later enrolled unrelated African Americans with type 2 diabetes to study ethnic differences in calcified atherosclerotic plaque.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym DHS also denotes Dortmund Health Study (COHO:0000054), deCODE Health Study (COHO:0000468) and Dallas Heart Study (COHO:0001309); this term is Diabetes Heart Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>DHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DiabHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Diabetes Heart Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Diabetes Heart Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000460"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90278455</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genome-wide study identifies effector genes and druggable pathways for coronary artery calcification.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37770635</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-023-01518-4/MediaObjects/41588_2023_1518_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Diabetes Heart Study (DHS): This work was supported by R01 HL92301, R01 HL67348, R01 NS058700, R01 AR48797, R01 DK071891, R01 AG058921, the General Clinical Research Center of the Wake Forest University School of Medicine (M01 RR07122, F32 HL085989), the American Diabetes Association, and a pilot grant from the Claude Pepper Older Americans Independence Center of Wake Forest University Health Sciences (P60 AG10484).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000460"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based, family-based study of European American and African American siblings concordant for type 2 diabetes and their unaffected relatives (1,443 participants from 564 families), recruited from internal medicine and endocrinology clinics in western North Carolina, United States, and examined at Wake Forest Baptist Medical Center to study genetic and epidemiological contributions to diabetic heart disease and subclinical cardiovascular disease; a parallel African American-Diabetes Heart Study (AA-DHS) later enrolled unrelated African Americans with type 2 diabetes to study ethnic differences in calcified atherosclerotic plaque.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21409311</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23230101</obo:IAO_0000119>
