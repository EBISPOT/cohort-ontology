        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4451284/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Center for Oral Health Research in Appalachia (COHRA) has been enrolling pregnant women and their babies since 2011 in the COHRA2 study of genetic, microbial, and environmental factors involved in oral health in Northern Appalachia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001000"/>
