    <!-- http://www.ebi.ac.uk/coho/COHO_0000566 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000566">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90566795</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of African American and white civilian, non-institutionalised adults aged 45 years or older living in six townships of Johnston County, North Carolina, sampled regardless of osteoarthritis status, of whom 3,187 were enrolled in 1991-1997 and a further 1,015 in 2003-2004 to enrich the cohort for Black and younger adults, and followed about every five years to estimate the incidence and progression of knee and hip osteoarthritis and later of hand, spine and foot osteoarthritis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>JOCO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>JoCo OA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>JoCoOA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Johnston County Osteoarthritis Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000566"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90566795</owl:annotatedTarget>
        <dcterms:title>Translational genomics of osteoarthritis in 1,962,069 individuals.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40205036</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>JoCo OA began in 1990 as a community-based prospective cohort of European-ancestry and African American men and women with and without osteoarthritis (OA).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000566"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort of African American and white civilian, non-institutionalised adults aged 45 years or older living in six townships of Johnston County, North Carolina, sampled regardless of osteoarthritis status, of whom 3,187 were enrolled in 1991-1997 and a further 1,015 in 2003-2004 to enrich the cohort for Black and younger adults, and followed about every five years to estimate the incidence and progression of knee and hip osteoarthritis and later of hand, spine and foot osteoarthritis.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19286855</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8854450/fullTextXML</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9387345/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000566"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>JOCO</owl:annotatedTarget>
