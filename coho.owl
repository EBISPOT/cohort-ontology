    <!-- http://www.ebi.ac.uk/coho/COHO_0001546 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001546">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Bangladesh"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Asia"/>
        <obo:IAO_0000112>PMID:32762905</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of first-onset acute myocardial infarction in Bangladesh, established in 2011 by the University of Cambridge with the International Centre for Diarrhoeal Disease Research, Bangladesh (icddr,b) and the National Institute of Cardiovascular Disease (NICVD) in Dhaka, whose cases are adults admitted to the NICVD&apos;s emergency rooms with a first myocardial infarction and whose controls, frequency-matched by age and sex, are hospital visitors without cardiovascular disease; with questionnaire data, electrocardiograms and stored blood samples, it was set up to study environmental, genetic, lifestyle and biochemical determinants of coronary heart disease in Bangladeshis.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym BRAVE also denotes Bicuspid aoRtic vAlVe gEnetic research (COHO:0001442); this term is Bangladesh Risk of Acute Vascular Events Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>BRAVE</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Bangladesh Risk of Acute Vascular Events Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32762905</owl:annotatedTarget>
        <dcterms:title>Validation of a Genome-Wide Polygenic Score for Coronary Artery Disease in South Asians.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32762905</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7592606/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>We next performed whole-genome sequencing in 500 individuals recruited in Dhaka, Bangladesh, as part of the Bangladesh Risk of Acute Vascular Events (BRAVE) study, a case-control study of first-onset acute myocardial infarction.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001546"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of first-onset acute myocardial infarction in Bangladesh, established in 2011 by the University of Cambridge with the International Centre for Diarrhoeal Disease Research, Bangladesh (icddr,b) and the National Institute of Cardiovascular Disease (NICVD) in Dhaka, whose cases are adults admitted to the NICVD&apos;s emergency rooms with a first myocardial infarction and whose controls, frequency-matched by age and sex, are hospital visitors without cardiovascular disease; with questionnaire data, electrocardiograms and stored blood samples, it was set up to study environmental, genetic, lifestyle and biochemical determinants of coronary heart disease in Bangladeshis.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25930055</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39811539</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
