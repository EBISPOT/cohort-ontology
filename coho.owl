    <!-- http://www.ebi.ac.uk/coho/COHO_0000980 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000980">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90700332</obo:IAO_0000112>
        <obo:IAO_0000115>A German sepsis research network whose genetic studies draw on the randomised controlled trials VISEP (recruitment 2003–2005) and MAXSEP (recruitment 2007–2010), combining patients with all-cause sepsis from German hospitals who gave separate consent for genetic analyses.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Critical Care Trials Group of the German Sepsis Competence Network</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SepNet</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">German Sepsis Competence Network</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000980"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90700332</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of susceptibility to acute respiratory distress syndrome.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41033104</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12516505/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a GWAS meta-analysis on 5115 critically ill patients, 82.8% with severe infections, comprising 716 ARDS cases and 4399 at-risk controls from three independent studies (Fig. 1, Table S1): the GENetics of SEPsis-induced ARDS Network (GEN-SEP), the Critical Care Trials Group of the German Sepsis Competence Network (SepNet), and UK Biobank (UKBB).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000980"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A German sepsis research network whose genetic studies draw on the randomised controlled trials VISEP (recruitment 2003–2005) and MAXSEP (recruitment 2007–2010), combining patients with all-cause sepsis from German hospitals who gave separate consent for genetic analyses.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18320153</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41033104</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000980"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SepNet</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000980"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12516505/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>SepNet is integrated by the VISEP (recruitment in 2003-2005, registration number: NCT00135473) and MAXSEP (recruitment in 2007-2010, registration number: NCT00534287) randomised controlled trials and includes European ancestry patients with all-cause sepsis from German hospitals (Scherag et al., 2016).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000981 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000981">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <obo:IAO_0000112>GCST90838706</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of patients who met diagnostic criteria for amyotrophic lateral sclerosis (ALS) or had progressive muscular atrophy but then improved substantially and lastingly (the ALS Reversal phenotype), invited from the investigators&apos; database of such patients compiled from published case reports and medical records. Participants, enrolled from June 2018 under a protocol approved by Duke University Health System, gave saliva for whole-genome sequencing to identify genetic correlates of the phenotype.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>StAR2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Study of ALS Reversals 2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Study of ALS Reversals 2: Genetic Analyses</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000981"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90838706</owl:annotatedTarget>
        <dcterms:title>Genetic Associations With an Amyotrophic Lateral Sclerosis Reversal Phenotype.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39079071</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11286288/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All contactable patients with an ALS Reversal phenotype in our database were invited to participate in this genetic study named Study of ALS Reversals 2: Genetic Analyses (StAR2).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000981"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of patients who met diagnostic criteria for amyotrophic lateral sclerosis (ALS) or had progressive muscular atrophy but then improved substantially and lastingly (the ALS Reversal phenotype), invited from the investigators&apos; database of such patients compiled from published case reports and medical records. Participants, enrolled from June 2018 under a protocol approved by Duke University Health System, gave saliva for whole-genome sequencing to identify genetic correlates of the phenotype.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:39079071</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
