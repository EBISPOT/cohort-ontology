    <!-- http://www.ebi.ac.uk/coho/COHO_0001416 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001416">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90244025</obo:IAO_0000112>
        <obo:IAO_0000115>An open-label, multicentre, randomised phase III trial in Germany, sponsored by Ludwig-Maximilians-University Munich, that enrolled adult patients with invasive early breast cancer at high risk of recurrence from 2005 to 2007 and compared, in a 2×2 factorial design, adjuvant FEC–docetaxel chemotherapy with or without gemcitabine and two versus five years of zoledronic acid, with an affiliated translational research programme on circulating tumour cells, serum tumour markers and pharmacogenetics.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SUCCESS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SUCCESS A</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SUCCESS A trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SUCCESS-A</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SUCCESS-A study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SUCCESS-A trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SUCCESSA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Simultaneous Study of Gemcitabine-Docetaxel Combination Adjuvant Treatment, as Well as Extended Bisphosphonate and Surveillance-Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Simultaneous Study of Gemcitabine-Docetaxel Combination adjuvant treatment, as well as Extended Bisphosphonate and Surveillance-Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001416"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244025</owl:annotatedTarget>
        <dcterms:title>Identification of Two Genetic Loci Associated with Leukopenia after Chemotherapy in Patients with Breast Cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35653140</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9357161/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The multicenter SUCCESS-A study included a prospective subprotocol concerned with the influence of germline genetic variants on side effects and efficacy of the chemotherapy.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001416"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An open-label, multicentre, randomised phase III trial in Germany, sponsored by Ludwig-Maximilians-University Munich, that enrolled adult patients with invasive early breast cancer at high risk of recurrence from 2005 to 2007 and compared, in a 2×2 factorial design, adjuvant FEC–docetaxel chemotherapy with or without gemcitabine and two versus five years of zoledronic acid, with an affiliated translational research programme on circulating tumour cells, serum tumour markers and pharmacogenetics.</owl:annotatedTarget>
