    <!-- http://www.ebi.ac.uk/coho/COHO_0000582 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000582">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000494"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90271622</obo:IAO_0000112>
        <obo:IAO_0000112>PMID:18498660</obo:IAO_0000112>
        <obo:IAO_0000115>A family study of the National Heart, Lung, and Blood Institute that recruited families, about half at high risk of coronary heart disease and half selected randomly, from existing study populations at four centres in Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), examining 5,710 participants in 1993–1995, to identify genetic and non-genetic determinants of coronary heart disease, atherosclerosis and their risk factors. Its follow-up, the Family Heart SCAN study, re-examined about a third of the participants with cardiac CT in 2002–2003 and added 622 African Americans from 211 families of hypertensive sibships previously examined by the Hypertension Genetic Epidemiology Network (HyperGEN).</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym FHS also denotes Framingham Heart Study (COHO:0000385); this term is NHLBI Family Heart Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>FAMHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FamHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Family Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Heart, Lung, and Blood Institute Family Heart Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">NHLBI Family Heart Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000582"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90271622</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis identifies 17 loci associated with nonalcoholic fatty liver disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37709864</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC10918428/</oboInOwl:hasDbXref>
        <rdfs:comment>The multi-ethnic GOLD Consortium includes the following nine multi-ethnic cohorts with CT-measured steatosis (n = 23,521): Age, Gene/Environment Susceptibility-Reykjavik Study (AGES)75, COPDGene76, Family Heart Study (FamHS)77, Framingham Heart Study (FHS)78,</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000582"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:18498660</owl:annotatedTarget>
        <dcterms:title>Polymorphisms near EXOC4 and LRGUK on chromosome 7q32 are associated with Type 2 Diabetes and fasting glucose; the NHLBI Family Heart Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:18498660</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2409301/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The National Heart, Lung and Blood Institute (NHLBI) Family Heart Study (FHS) recruited families from four existing study centers located in Forsyth County, NC; Framingham, MA; Minneapolis, MN; and Salt Lake City, UT.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000582"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family study of the National Heart, Lung, and Blood Institute that recruited families, about half at high risk of coronary heart disease and half selected randomly, from existing study populations at four centres in Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), examining 5,710 participants in 1993–1995, to identify genetic and non-genetic determinants of coronary heart disease, atherosclerosis and their risk factors. Its follow-up, the Family Heart SCAN study, re-examined about a third of the participants with cardiac CT in 2002–2003 and added 622 African Americans from 211 families of hypertensive sibships previously examined by the Hypertension Genetic Epidemiology Network (HyperGEN).</owl:annotatedTarget>
