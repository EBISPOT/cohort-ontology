    <!-- http://www.ebi.ac.uk/coho/COHO_0001394 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001394">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90897930</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective multicentre observational study of children and adolescents aged 3–20 years with sickle cell disease, examined at steady state, and of controls without the disease matched by age, sex and ethnicity, recruited at Howard University Hospital and Children&apos;s National Medical Center in Washington, DC, and the University of Michigan in Ann Arbor, with echocardiography, six-minute walk tests and blood markers, designed to identify factors in pre-symptomatic children that predict pulmonary hypertension and other cardiopulmonary complications.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PUSH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pulmonary Hypertension and Hypoxic Response in Sickle Cell Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pulmonary Hypertension and the Hypoxic Response in SCD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Pulmonary Hypertension and the Hypoxic Response in Sickle Cell Disease</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001394"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90897930</owl:annotatedTarget>
        <dcterms:title>FLT1 and other candidate fetal haemoglobin modifying loci in sickle cell disease in African ancestries.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40025045</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11873275/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The cohorts included: Cooperative Study of Sickle Cell Disease (CSSCD: n = 841), Multicenter Study of Hydroxyurea (MSH: n = 178), Pulmonary Hypertension and the Hypoxic Response in Sickle Cell Disease (PUSH) study (n = 73), Comprehensive Sickle Cell Centers Collaborative Data (C-data) project (n = 127), Treatment of Pulmonary Hypertension and Sickle Cell Disease with Sildenafil Treatment (Walk-PHaSST) trial (n = 181), Duke University Outcome Modifying Genes study (n = 152), and Silent Infarct Transfusion (SIT) trial (SITT: n = 488).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001394"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective multicentre observational study of children and adolescents aged 3–20 years with sickle cell disease, examined at steady state, and of controls without the disease matched by age, sex and ethnicity, recruited at Howard University Hospital and Children&apos;s National Medical Center in Washington, DC, and the University of Michigan in Ann Arbor, with echocardiography, six-minute walk tests and blood markers, designed to identify factors in pre-symptomatic children that predict pulmonary hypertension and other cardiopulmonary complications.</owl:annotatedTarget>
