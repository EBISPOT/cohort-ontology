        <obo:IAO_0000112>GCST90451657</obo:IAO_0000112>
        <obo:IAO_0000115>A UK open-label, randomised, phase 3 adaptive-design trial for patients with newly diagnosed multiple myeloma at 110 National Health Service hospitals in England, Wales and Scotland, recruiting from 2010, which assigned patients by age and fitness to intensive (transplantation) or non-intensive pathways and had three randomisation stages, including induction regimens and lenalidomide maintenance against observation.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MRC also denotes MRC Myeloma IX trial (COHO:0001375); this term is Myeloma XI trial.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>MRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MyXI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Myeloma XI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Myeloma-XI trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Myeloma XI trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001374"/>
