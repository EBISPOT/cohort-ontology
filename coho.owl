        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <obo:IAO_0000112>GCST90090980</obo:IAO_0000112>
        <obo:IAO_0000115>The breast cancer arm of the Hwasun Cancer Epidemiology Study, a hospital-based case-control study at Chonnam National University Hwasun Hospital, a cancer hospital in Jeollanam-do province, South Korea, that aims to identify factors in cancer development and clinical progression in a Korean population. Its cases are women newly diagnosed with breast cancer at the hospital from April 2004 to February 2013, excluding secondary or recurrent tumours, and its controls are women with no previous cancer drawn at random from the Namwon Study and the Dong-gu Study, community-based cohorts in South Korea.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HCES-Br</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hwasun Cancer Epidemiology Study-Breast</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90090980</owl:annotatedTarget>
        <dcterms:title>Identification of novel breast cancer susceptibility loci in meta-analyses conducted among Asian and European descendants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32139696</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7057957/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Hwasun Cancer Epidemiology Study (HCES-Br) is a hospital-based case-control 92 study whose goal is to identify factors of the cancer development and clinical 93 progression in a Korean population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001185"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>The breast cancer arm of the Hwasun Cancer Epidemiology Study, a hospital-based case-control study at Chonnam National University Hwasun Hospital, a cancer hospital in Jeollanam-do province, South Korea, that aims to identify factors in cancer development and clinical progression in a Korean population. Its cases are women newly diagnosed with breast cancer at the hospital from April 2004 to February 2013, excluding secondary or recurrent tumours, and its controls are women with no previous cancer drawn at random from the Namwon Study and the Dong-gu Study, community-based cohorts in South Korea.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32139696</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
