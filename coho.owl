    <!-- http://www.ebi.ac.uk/coho/COHO_0001406 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001406">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <obo:IAO_0000112>GCST90027445</obo:IAO_0000112>
        <obo:IAO_0000115>A clinical study of children and young people aged 5–18 of Slovenian origin with a physician diagnosis of mild-to-moderate persistent asthma and hospital records at tertiary health centres in Slovenia, part of them regularly treated with inhaled corticosteroids under medical supervision, with lung function measured after six weeks of inhaled corticosteroid treatment. It is one of the asthma studies enrolled in the Pharmacogenomics in Childhood Asthma (PiCA) consortium, which studies the genetics of response to asthma treatment.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SLOVENIA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Slovenia study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">SLOVENIA study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001406"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90027445</owl:annotatedTarget>
        <dcterms:title>Identification of ROBO2 as a Potential Locus Associated with Inhaled Corticosteroid Response in Childhood Asthma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34442380</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34442380+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A genome-wide association study (GWAS) of the change in lung function after 6 weeks of ICS treatment was performed in 166 asthma patients from the SLOVENIA study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001406"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A clinical study of children and young people aged 5–18 of Slovenian origin with a physician diagnosis of mild-to-moderate persistent asthma and hospital records at tertiary health centres in Slovenia, part of them regularly treated with inhaled corticosteroids under medical supervision, with lung function measured after six weeks of inhaled corticosteroid treatment. It is one of the asthma studies enrolled in the Pharmacogenomics in Childhood Asthma (PiCA) consortium, which studies the genetics of response to asthma treatment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28639505</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34442380</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
