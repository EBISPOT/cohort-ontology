        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4057636/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Finnish twin cohort consisted of 30 654 respondents, of which 28 767 completed the Eysenck Personality Inventory (EPI; an alternative version of the EPQ) at least once.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000461"/>
