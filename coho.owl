    <!-- http://www.ebi.ac.uk/coho/COHO_0000753 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000753">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>GCST005838</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of ischaemic stroke in Finland, in which patients with neuroimaging-confirmed new-onset brain infarction were recruited at Helsinki University Central Hospital, with TOAST subtyping, detailed phenotype data and blood samples, and controls were FINRISK 1992, 1997 and 2002 participants from the Greater Helsinki region frequency-matched by age and sex, to investigate genetic factors underlying ischaemic stroke.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>FINLAND</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Finland</oboInOwl:hasRelatedSynonym>
