        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9117153/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The studies were parallel groups and identically designed, conducted between January 2003 and June 2004 in the United States.</rdfs:comment>
    </owl:Axiom>
    


