        <obo:IAO_0000112>GCST90319844</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of gastric cancer at the National Cancer Center in Goyang, South Korea, that from March 2011 to December 2014 recruited patients recently diagnosed with gastric cancer at its Center for Gastric Cancer as cases and cancer-free people attending health-screening check-ups at its Center for Cancer Prevention and Detection as controls, with lifestyle and food-frequency questionnaires and blood DNA genotyped on an exome array, to study dietary and genetic risk factors for gastric cancer.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym Korea-NCC also denotes Korea-NCC (National Cancer Center) Colorectal Cancer Study (COHO:0001364); this term is Korea National Cancer Center gastric cancer case-control study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>Korea-NCC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Korea National Cancer Center gastric cancer case-control study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001363"/>
