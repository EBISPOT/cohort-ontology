    <!-- http://www.ebi.ac.uk/coho/COHO_0001572 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001572">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:42473435</obo:IAO_0000112>
        <obo:IAO_0000115>A multiphase randomised trial of the effectiveness of antipsychotic drugs in adults aged 18–67 with chronic schizophrenia, run under the US National Institute of Mental Health&apos;s CATIE programme in 2001–2004 at 57 clinical sites across the United States (public mental health, academic, Veterans Affairs and managed care settings), whose double-blind first phase compared the first-generation drug perphenazine with the second-generation drugs olanzapine, quetiapine, risperidone and ziprasidone for up to 18 months, with all-cause treatment discontinuation as the primary outcome. Participants could join an optional genetic sub-study by donating DNA.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CATIE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CATIE schizophrenia trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CATIE-US</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Clinical Antipsychotic Trials of Intervention Effectiveness</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001572"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:42473435</owl:annotatedTarget>
        <dcterms:title>The prospective incidence of treatment-resistant schizophrenia: analysis of the CATIE trial using the TRRIP consensus.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42473435</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42473435+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We applied TRRIP criteria to 1334 participants with chronic schizophrenia enrolled in the Clinical Antipsychotic Trials of Intervention Effectiveness (CATIE) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
