        <owl:annotatedTarget>MELARISK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001372"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5116391/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The MELARISK study comprised of 1,244 European-ancestry melanoma cases who were recruited through a nationwide network of French Dermatology Departments and Oncogenetic clinics between 1992 and 2011.</rdfs:comment>
