        <obo:IAO_0000112>GCST90093191</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study of diabetes and cardiovascular disease in Singapore that re-visited, between 2003 and 2007, Chinese, Malay and Asian-Indian adults randomly sampled for four earlier cross-sectional studies (the Thyroid and Heart Study, the 1992 and 1998 National Health Surveys and the National University of Singapore Heart Study), with questionnaires and clinical examinations.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SP2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Singapore Prospective Study Programme</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Singapore Prospective Study Program</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000481"/>
