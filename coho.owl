        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AusDiane</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001505 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001505">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:20801717</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control genetic association study of bipolar disorder in the United Kingdom, funded by GlaxoSmithKline, whose cases are people with bipolar disorder recruited in London and diagnosed with the Schedules for Clinical Assessment in Neuropsychiatry (SCAN) interview and the Operational Criteria Checklist, and whose controls are ethnically matched subjects recruited in the UK; its control group has also served as UK controls in genome-wide association studies of other disorders.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BACCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BACCs</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BaCCs</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bipolar Affective Disorder Case Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bipolar Association Case-Control Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Bipolar Affective Case Control Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001505"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:20801717</owl:annotatedTarget>
        <dcterms:title>Chromosome 9p21 in sporadic amyotrophic lateral sclerosis in the UK and seven other countries: a genome-wide association study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:20801717</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20801717+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We collected samples from patients with sporadic ALS from 20 UK hospitals and obtained UK control samples from the control groups of the Depression Case Control study, the Bipolar Affective Case Control Study, and the British 1958 birth cohort DNA collection.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001505"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case–control genetic association study of bipolar disorder in the United Kingdom, funded by GlaxoSmithKline, whose cases are people with bipolar disorder recruited in London and diagnosed with the Schedules for Clinical Assessment in Neuropsychiatry (SCAN) interview and the Operational Criteria Checklist, and whose controls are ethnically matched subjects recruited in the UK; its control group has also served as UK controls in genome-wide association studies of other disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19089808</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:20801717</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:24964207</obo:IAO_0000119>
