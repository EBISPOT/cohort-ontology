        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>GCST90104709</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of women recruited in 2011–2013 when attending mammography screening or clinical mammography at four hospitals in Sweden (in Stockholm, Helsingborg, Lund and Landskrona), with questionnaires, mammograms, blood samples and linkage to Swedish health registers, established to determine how mammographic density, genetic factors and lifestyle influence breast cancer risk and to build risk prediction models for individualised prevention and screening.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>KARMA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KARMA study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>KARolinska MAmmography Project for Risk Prediction of Breast Cancer</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Karolinska Mammography Project for Risk Prediction of Breast Cancer – Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Karolinska Mammography Project for Risk Prediction of Breast Cancer</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001093"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90104709</owl:annotatedTarget>
        <dcterms:title>A Swedish Genome-Wide Haplotype Association Analysis Identifies a Novel Breast Cancer Susceptibility Locus in 8p21.2 and Characterizes Three Loci on Chromosomes 10, 11 and 16.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35267517</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8909613/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, the KARMA Cohort consists of 70,877 women performing a screening or clinical mammogram at 4 hospitals in Sweden during the period October 2010–March 2013 [20].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001093"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
