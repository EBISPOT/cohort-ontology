    <!-- http://www.ebi.ac.uk/coho/COHO_0001225 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001225">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Bangladesh"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Asia"/>
        <obo:IAO_0000112>GCST90129578</obo:IAO_0000112>
        <obo:IAO_0000115>A birth cohort of children enrolled with their mothers within seven days of birth in low-income wards of Mirpur, Dhaka, Bangladesh, from May 2011, into a randomized controlled trial with a two-by-two factorial design, conducted by the International Centre for Diarrhoeal Disease Research, Bangladesh (icddr,b) with the University of Vermont and the University of Virginia, that tested a delayed-dose oral rotavirus vaccine and the replacement of one oral polio vaccine dose by an injectable polio vaccine, and followed the children through their first two years of life to study why oral vaccines underperform in children living with poverty, poor sanitation and overcrowding.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PROVIDE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PROVIDE Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PROVIDE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Performance of Rotavirus and Oral Polio Vaccines in Developing Countries</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001225"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90129578</owl:annotatedTarget>
        <dcterms:title>Genome-Wide Association Study of Campylobacter-Positive Diarrhea Identifies Genes Involved in Toxin Processing and Inflammatory Response.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35420468</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9239263/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Here, we aimed to identify genetic variants associated with host susceptibility to Campylobacter infection using two well-characterized birth cohorts: the Performance of Rotavirus and Oral Polio Vaccines in Developing Countries (PROVIDE) Study (19) and the Cryptosporidiosis Birth Cohort (CBC) (20).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001225"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A birth cohort of children enrolled with their mothers within seven days of birth in low-income wards of Mirpur, Dhaka, Bangladesh, from May 2011, into a randomized controlled trial with a two-by-two factorial design, conducted by the International Centre for Diarrhoeal Disease Research, Bangladesh (icddr,b) with the University of Vermont and the University of Virginia, that tested a delayed-dose oral rotavirus vaccine and the replacement of one oral polio vaccine dose by an injectable polio vaccine, and followed the children through their first two years of life to study why oral vaccines underperform in children living with poverty, poor sanitation and overcrowding.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25711607</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35420468</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38524222</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
