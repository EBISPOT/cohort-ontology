    <!-- http://www.ebi.ac.uk/coho/COHO_0000463 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000463">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:hasSubCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000322"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:28245255</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of patients of the Academic Medical Center, Amsterdam, with symptomatic coronary artery disease (myocardial infarction, coronary revascularization or at least 70% stenosis of a major epicardial artery) before the age of 51, used in genetic studies of premature atherosclerosis and coronary artery disease.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym AMC-PAS also denotes Premature Atherosclerosis Study pedigrees (COHO:0000322); this term is Academic Medical Center Amsterdam Premature Atherosclerosis Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>AMC-PAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Premature Atherosclerosis Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Academic Medical Center Amsterdam Premature Atherosclerosis Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000463"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28245255</owl:annotatedTarget>
        <dcterms:title>Extending the use of GWAS data by combining data from different genetic platforms.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28245255</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5330464/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We included a total of 979 unique patients from the previously described prospective cohort AMC-PAS[6], with symptomatic Coronary Artery Disease (CAD) before the age of 51 years, defined as Myocardial Infarction (MI), coronary revascularization, or evidence of at least 70% stenosis in a major epicardial artery.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000463"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective cohort of patients of the Academic Medical Center, Amsterdam, with symptomatic coronary artery disease (myocardial infarction, coronary revascularization or at least 70% stenosis of a major epicardial artery) before the age of 51, used in genetic studies of premature atherosclerosis and coronary artery disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28245255</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000463"/>
