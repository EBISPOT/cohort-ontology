        <obo:IAO_0000112>GCST90909136</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based study of healthy young people aged 14–35, recruited at the University of Michigan in Ann Arbor, United States, between June 2006 and January 2009 from the university&apos;s undergraduate and graduate students together with their biological siblings, with blood samples for measuring plasma haemostatic proteins (such as von Willebrand factor and plasminogen), genome-wide genotyping and a survey of common morphological traits, to identify the genetic factors behind variation in blood clotting in healthy people, using its sibling structure for linkage as well as association analysis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GABC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genes and Blood Clotting Study</rdfs:label>
    </owl:NamedIndividual>
