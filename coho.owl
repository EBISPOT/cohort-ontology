    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001024"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC2661765/</oboInOwl:hasDbXref>
        <rdfs:comment>From 1991 to 1998, the Principal Investigators and Co-Investigators were located at Massachusetts General Hospital, Boston, MA, U01 MH46281; Johns Hopkins University, Baltimore, MD, U01 MH46290; and University of Alabama at Birmingham, Birmingham, AL, U01 MH46373.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001025 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001025">
