        <obo:IAO_0000112>GCST90624167</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of about 3,000 adult outpatients of self-reported Caucasian ethnicity with prevalent type 2 diabetes, recruited in 2010–2014 at two university-based study centres in Germany and followed with biennial visits, core phenotyping and biobanking for at least 10 years to study diabetes complications, with a primary focus on renal events.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DIACORE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DIAbetes COhoRtE study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
