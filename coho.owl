        <obo:IAO_0000112>GCST90000059</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective population-based cohort of about 28,000 Indian Asian (South Asian) and European men and women aged 35 to 75, recruited in 2003-2008 from the lists of 58 general practitioners in West London, UK, with a structured cardiovascular and metabolic assessment and stored blood, to study the excess cardiometabolic risk of South Asians.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>LOLIPOP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>London Life Sciences Population Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">London Life Sciences Prospective Population Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000567"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90000059</owl:annotatedTarget>
        <dcterms:title>Discovery of rare variants associated with blood pressure regulation through meta-analysis of 1.3 million individuals.</dcterms:title>
