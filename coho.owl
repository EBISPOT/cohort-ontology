    <!-- http://www.ebi.ac.uk/coho/COHO_0001019 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001019">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/India"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Asia"/>
        <obo:IAO_0000112>GCST90711139</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional sib-pair study at four factories in Lucknow, Nagpur, Hyderabad and Bangalore in north, central and south India, which in 2005–2007 examined factory workers and their spouses who had migrated from rural areas together with a rural-dwelling sibling of each, and a random sample of urban non-migrant workers and spouses together with an urban-dwelling sibling, to study the effect of rural-to-urban migration on obesity, diabetes and other cardiovascular risk factors.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>IMS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Indian Migration Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90711139</owl:annotatedTarget>
        <dcterms:title>Novel genomic variants related to visceral adiposity index (VAI) and body adiposity index (BAI) in Indian sib-pairs.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38971891</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38971891+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>2265 sib-pairs from Indian Migration Study were used for examining the association of genetic variants from the Cardio-Metabochip array with VAI, and BAI.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001019"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional sib-pair study at four factories in Lucknow, Nagpur, Hyderabad and Bangalore in north, central and south India, which in 2005–2007 examined factory workers and their spouses who had migrated from rural areas together with a rural-dwelling sibling of each, and a random sample of urban non-migrant workers and spouses together with an urban-dwelling sibling, to study the effect of rural-to-urban migration on obesity, diabetes and other cardiovascular risk factors.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20436961</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
