        <obo:IAO_0000112>GCST90320046</obo:IAO_0000112>
        <obo:IAO_0000115>A statewide record-linkage case–control study that links California birth records for 1982–2009, maintained by the California Department of Public Health, to diagnoses of cancer before the age of 15 in the California Cancer Registry for 1988–2011, with cancer-free California-born controls matched on date of birth, sex and maternal race or ethnicity through vital statistics records, and uses archived newborn dried blood spots from the California Biobank Program for genetic studies of childhood cancers such as acute lymphoblastic leukaemia and glioma.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CCRLP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>California Cancer Records Linkage Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">California Childhood Cancer Record Linkage Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001067"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
