        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90833065</obo:IAO_0000112>
        <obo:IAO_0000115>A global collaboration that aims to bring together all available genetic studies of osteoarthritis, meta-analysing genome-wide association data on osteoarthritis at different joint sites (hip, knee, hand, finger, thumb and spine) and related traits from its contributing cohorts and biobanks in Europe, East Asia, North America and Australia, among them UK Biobank, arcOGEN, deCODE, the HUNT Study, the Estonian Biobank, the Rotterdam Study, FinnGen and the Million Veteran Program.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GO Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Osteoarthritis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Osteoarthritis consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetics of Osteoarthritis Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001338"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90833065</owl:annotatedTarget>
        <dcterms:title>Genetic study identifies novel genes in developmental dysplasia of the hip.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41912496</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13035913/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Since DDH is a strong risk factor of hip OA, to maximize statistical power to detect novel signals in hip OA, we used summary statistics of European hip OA in GO,25 international consortium of osteoarthritis, and meta-analyzed with Japanese DDH.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001338"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A global collaboration that aims to bring together all available genetic studies of osteoarthritis, meta-analysing genome-wide association data on osteoarthritis at different joint sites (hip, knee, hand, finger, thumb and spine) and related traits from its contributing cohorts and biobanks in Europe, East Asia, North America and Australia, among them UK Biobank, arcOGEN, deCODE, the HUNT Study, the Estonian Biobank, the Rotterdam Study, FinnGen and the Million Veteran Program.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34450027</obo:IAO_0000119>
