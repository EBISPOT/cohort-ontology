    <!-- http://www.ebi.ac.uk/coho/COHO_0000736 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000736">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000050"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000121"/>
