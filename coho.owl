        <owl:annotatedTarget>A population-based case-control study of incident colorectal cancer cases and healthy controls recruited in northern Israel from 1998 to 2017, used to study genetic and environmental risk factors for colorectal cancer and the tumour immune microenvironment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38664626</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000618"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>MECC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
