    <!-- http://www.ebi.ac.uk/coho/COHO_0001509 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001509">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>PMID:28817493</obo:IAO_0000112>
        <obo:IAO_0000115>A birth cohort of mother–child pairs recruited at delivery in the 2000s from women with singleton pregnancies giving birth consecutively at the obstetrics department of the Charité university hospital in Berlin, Germany, with maternal blood, umbilical cord blood, placentas and birth measurements collected at birth. It is used to study maternal and fetal influences, including genetic ones, on birth weight, pregnancy outcomes and maternal physiology in pregnancy.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Berlin Birth Cohort study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Berlin Birth Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001509"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28817493</owl:annotatedTarget>
        <dcterms:title>DNA methylation of the glucocorticoid receptor gene promoter in the placenta is associated with blood pressure regulation in human pregnancy.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28817493</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28817493+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>The study was performed as a nested case-control study (n = 80) out of 1045 mother/child pairs from the Berlin Birth Cohort.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001509"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A birth cohort of mother–child pairs recruited at delivery in the 2000s from women with singleton pregnancies giving birth consecutively at the obstetrics department of the Charité university hospital in Berlin, Germany, with maternal blood, umbilical cord blood, placentas and birth measurements collected at birth. It is used to study maternal and fetal influences, including genetic ones, on birth weight, pregnancy outcomes and maternal physiology in pregnancy.</owl:annotatedTarget>
