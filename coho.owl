    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000103"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>EGAS00001003216</owl:annotatedTarget>
        <dcterms:title>Multiple Sclerosis Replication Chip data (MS Chip)</dcterms:title>
        <oboInOwl:hasDbXref>https://ega-archive.org/studies/EGAS00001003216</oboInOwl:hasDbXref>
        <rdfs:comment>UK Multiple Sclerosis (MS) cases that were recruited through the University of Cambridge and included in the IMSGC Replicationchip experiment</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000103"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST001505</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of multiple sclerosis confirms a novel locus at 5p13.1.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:22570697</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3343041/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We also analyzed a dataset (named hereafter IMSGC/WT) based on 931 MS cases from the International Multiple Sclerosis Genetic Consortium (IMSGC) [8] and 2938 controls from the Wellcome Trust Case Control Consortium (WTCCC), who had been genotyped using Affymetrix 500K array [9].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000103"/>
