    <!-- http://www.ebi.ac.uk/coho/COHO_0000998 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000998">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90258648</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, randomized, double-masked clinical trial of long-term inhaled treatment for mild to moderate asthma (budesonide, nedocromil or placebo, each with albuterol as needed) in children aged 5–12 years, who were enrolled in 1993–1995 at eight clinical centres in the United States and Canada and followed after the trial into adulthood, with a genetic ancillary study of the children and their parents.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CAMP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Childhood Asthma Management Program</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000998"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90258648</owl:annotatedTarget>
        <dcterms:title>Zinc finger protein 33B demonstrates sex interaction with atopy-related markers in childhood asthma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35953101</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35953101+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a genome-wide gene-by-sex interaction analysis for atopy-related markers using whole-genome sequencing data based on 889 trios from the Genetic Epidemiology of Asthma in Costa Rica Study (GACRS) and 284 trios from the Childhood Asthma Management Program (CAMP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000998"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre, randomized, double-masked clinical trial of long-term inhaled treatment for mild to moderate asthma (budesonide, nedocromil or placebo, each with albuterol as needed) in children aged 5–12 years, who were enrolled in 1993–1995 at eight clinical centres in the United States and Canada and followed after the trial into adulthood, with a genetic ancillary study of the children and their parents.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10027502</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34212545</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001726</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
