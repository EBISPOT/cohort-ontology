    <!-- http://www.ebi.ac.uk/coho/COHO_0001131 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001131">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90301368</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based collection of ischaemic stroke patients admitted from August 2008 to Barnes-Jewish Hospital/Washington University Medical Center in St. Louis, Missouri, identified by screening emergency department and inpatient stroke service admissions regardless of age, race or ethnicity and followed up at 90 days, whose DNA came from an acute tPA pharmacogenomics study, the Recovery Genomics after Ischemic Stroke (ReGenesIS) study and the Cognitive Rehabilitation and Recovery Group (CRRG) stroke registry; one of the genetic research centres of the NINDS Stroke Genetics Network.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>WUSTL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Washington University St. Louis Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Washington University St. Louis Stroke Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001131"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90301368</owl:annotatedTarget>
        <dcterms:title>Evidence of survival bias in the association between APOE-Є4 and age at ischemic stroke onset.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39286457</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11403718/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>WUSTL: Washington University St. Louis Stroke Study (WUSTL): The collection, extraction of DNA from blood, and storage of specimens were supported by 2 NINDS NIH grants (P50 NS055977 and R01 NS8541901).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001131"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based collection of ischaemic stroke patients admitted from August 2008 to Barnes-Jewish Hospital/Washington University Medical Center in St. Louis, Missouri, identified by screening emergency department and inpatient stroke service admissions regardless of age, race or ethnicity and followed up at 90 days, whose DNA came from an acute tPA pharmacogenomics study, the Recovery Genomics after Ischemic Stroke (ReGenesIS) study and the Cognitive Rehabilitation and Recovery Group (CRRG) stroke registry; one of the genetic research centres of the NINDS Stroke Genetics Network.</owl:annotatedTarget>
