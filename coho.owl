        <oboInOwl:hasRelatedSynonym>Australian and New Zealand Multiple Sclerosis Genetics Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Australia and New Zealand Multiple Sclerosis Genetics Conortium</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Australia and New Zealand Multiple Sclerosis Genetics Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001488"/>
