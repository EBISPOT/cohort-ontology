    <!-- http://www.ebi.ac.uk/coho/COHO_0001352 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001352">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Hong_Kong"/>
        <obo:IAO_0000112>GCST90566418</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort study of eye conditions, run by the Chinese University of Hong Kong since 2015, that recruits ethnic Chinese children aged 6 to 8 years from randomly selected primary schools across Hong Kong, together with their parents, and follows the children up, to determine the occurrence and development of refractive errors, strabismus, amblyopia and other eye disorders and their environmental and genetic determinants.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HKCES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hong Kong Children Eye Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001352"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90566418</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identified novel loci and gene-environment interaction for refractive error in children.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40410244</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40410244+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>To identify novel genetic loci for children refractive error, we performed a meta-analysis of two genome-wide association studies (GWASs) of spherical equivalent (SE) in 1,237 children from the population-based Hong Kong Children Eye Study (HKCES) and the Low Concentration Atropine for Myopia Progression (LAMP) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001352"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort study of eye conditions, run by the Chinese University of Hong Kong since 2015, that recruits ethnic Chinese children aged 6 to 8 years from randomly selected primary schools across Hong Kong, together with their parents, and follows the children up, to determine the occurrence and development of refractive errors, strabismus, amblyopia and other eye disorders and their environmental and genetic determinants.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31981300</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34226578</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36542383</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40410244</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001352"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HKCES</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001352"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Hong_Kong"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9856878/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants for this cross-sectional study were recruited from the Hong Kong Children Eye Study, an ongoing population-based cohort study on eye conditions in children aged 6 to 8 years recruited from primary schools in Hong Kong.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001353 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001353">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Hong_Kong"/>
        <obo:IAO_0000112>GCST90281031</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre prospective cohort and biobank of adults with diabetes, started in 2014 and coordinated by the Chinese University of Hong Kong, which enrols people attending routine diabetes complication assessment at the diabetes centres of major public hospitals across Hong Kong, with the assessment methods of the Hong Kong Diabetes Register, and follows them for diabetes-related outcomes, to serve as a territory-wide diabetes register and biobank for epidemiological research and for the discovery and replication of genetic, epigenetic and other biomarkers of diabetes and its complications.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HKDB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hong Kong Diabetes Biobank</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001353"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90281031</owl:annotatedTarget>
        <dcterms:title>Identification of a Common Variant for Coronary Heart Disease at PDE1A Contributes to Individualized Treatment Goals and Risk Stratification of Cardiovascular Complications in Chinese Patients With Type 2 Diabetes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37125963</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10234754/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>In the stage of genome-wide scan, we performed a meta-analysis in two independent case-control cohorts of Chinese patients with T2D: 1) 4,886 patients (1,358 case and 3,528 control subjects) from the Hong Kong Diabetes Register (HKDR) (recruitment period 1995–2014) and 2) 4,055 patients (1,159 case and 2,896 control subjects) recruited in 2013–2019 from the Hong Kong Diabetes Biobank (HKDB) phase 1 study (16).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001353"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre prospective cohort and biobank of adults with diabetes, started in 2014 and coordinated by the Chinese University of Hong Kong, which enrols people attending routine diabetes complication assessment at the diabetes centres of major public hospitals across Hong Kong, with the assessment methods of the Hong Kong Diabetes Register, and follows them for diabetes-related outcomes, to serve as a territory-wide diabetes register and biobank for epidemiological research and for the discovery and replication of genetic, epigenetic and other biomarkers of diabetes and its complications.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32722720</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39508878</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT05282680</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001353"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>HKDB</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001353"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Hong_Kong"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10234754/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All patients in the above three cohorts were southern Han Chinese residing in Hong Kong.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001354 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001354">
