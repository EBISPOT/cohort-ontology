    <!-- http://www.ebi.ac.uk/coho/COHO_0001486 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001486">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:27135401</obo:IAO_0000112>
        <obo:IAO_0000115>A nationwide population-based case-control study of endometrial cancer in Australia, run by a study group at QIMR Berghofer Medical Research Institute in Brisbane, whose cases are women aged 18–79 years newly diagnosed with histologically confirmed primary endometrial cancer between July 2005 and December 2007, identified through major hospitals and state cancer registries, and whose controls are women randomly selected from the Australian Electoral Roll and frequency-matched to the cases by state of residence and five-year age group. Participants gave risk-factor information by telephone interview and blood samples, and the cases were followed for survival, to study the causes and outcomes of endometrial cancer.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ANECS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Australian National Endometrial Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001486"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27135401</owl:annotatedTarget>
        <dcterms:title>Five endometrial cancer risk loci identified through genome-wide association analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27135401</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4907351/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>As described previously, cases with endometrioid histology were selected from two population studies; the UK Studies of Epidemiology and Risk factors in Cancer Heredity (SEARCH, n=681) and the Australian National Endometrial Cancer Study (ANECS, n=606), and genotypes generated using Illumina Infinium 610K arrays 10.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001486"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nationwide population-based case-control study of endometrial cancer in Australia, run by a study group at QIMR Berghofer Medical Research Institute in Brisbane, whose cases are women aged 18–79 years newly diagnosed with histologically confirmed primary endometrial cancer between July 2005 and December 2007, identified through major hospitals and state cancer registries, and whose controls are women randomly selected from the Australian Electoral Roll and frequency-matched to the cases by state of residence and five-year age group. Participants gave risk-factor information by telephone interview and blood samples, and the cases were followed for survival, to study the causes and outcomes of endometrial cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22245995</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27135401</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29533022</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40033780</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001486"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ANECS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001486"/>
