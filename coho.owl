    <!-- http://www.ebi.ac.uk/coho/COHO_0000802 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000802">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>GCST90244175</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort of 1,429 patients with head and neck cancer treated with primary or postoperative radiotherapy, with or without chemotherapy, from 2007 to 2020 at the Department of Radiation Oncology of the University Medical Center Groningen, all enrolled in the UMCG head and neck cancer prospective data registration programme (NCT02435576), with prospective assessment of radiation-induced toxicity and patient-rated outcome measures.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>UMCG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UMCG-HANS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">University Medical Center Groningen Head and Neck cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000802"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244175</owl:annotatedTarget>
        <dcterms:title>Meta-GWAS identifies the heritability of acute radiation-induced toxicities in head and neck cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36191651</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://ars.els-cdn.com/content/image/1-s2.0-S0167814022044863-mmc1.docx</oboInOwl:hasDbXref>
        <rdfs:comment>University Medical Center Groningen Head and Neck cancer Study (UMCG-HANS) cohort consisted of 1,429 HNC patients treated with primary or postoperative RT either or not combined with chemotherapy (CH-RT) from 2007 to 2020 at the department of Radiation Oncology of the UMCG.</rdfs:comment>
