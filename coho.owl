    <!-- http://www.ebi.ac.uk/coho/COHO_0001512 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001512">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>PMID:29674426</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of non-Hodgkin lymphoma in British Columbia, Canada, which invited residents of Greater Vancouver and Greater Victoria aged 20–79 with non-Hodgkin lymphoma diagnosed from March 2000 to February 2004, identified through the BC Cancer Registry (excluding HIV-positive and post-transplant cases), together with population controls from the Client Registry of the British Columbia Ministry of Health frequency-matched to the cases on sex, age and area of residence, to study environmental and genetic risk factors for the disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BCCA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>British Columbia Non-Hodgkin Lymphoma Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">British Columbia Non-Hodgkin Lymphoma study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001512"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:29674426</owl:annotatedTarget>
        <dcterms:title>Association of polygenic risk score with the risk of chronic lymphocytic leukemia and monoclonal B-cell lymphocytosis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29674426</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC5992865/</oboInOwl:hasDbXref>
        <rdfs:comment>BC, British Columbia Non-Hodgkin Lymphoma study; ENGELA, Environmental and Genetic Risks Factors Study in Adult Lymphoma; EPILYMPH, European multi-center case–control study; MAYO, Mayo Clinic; NSW, New South Wales non-Hodgkin Lymphoma study; SCALE, Scandinavian Lymphoma Etiology study; UCSF2, University of California San Diego Molecular Epidemiology of non-Hodgkin Lymphoma study.</rdfs:comment>
