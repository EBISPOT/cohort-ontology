    <!-- http://www.ebi.ac.uk/coho/COHO_0001538 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001538">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:21966275</obo:IAO_0000112>
        <obo:IAO_0000115>A European Union Sixth Framework Programme integrated project (June 2004 to November 2008), coordinated by the University of Cambridge with clinical coronary artery disease centres, genomics groups and the Wellcome Trust Sanger Institute, that sought genes and pathways of atherothrombosis in coronary artery disease through platelet transcriptome and proteome analysis and exon resequencing. For genetic association studies it assembled a Dutch case-control collection, with cases from the Academic Medical Center Amsterdam Premature Atherosclerosis Study (AMC-PAS) and the AGNES study of first ST-elevation myocardial infarction and controls from Sanquin blood donors, and a German one, with cases and controls from the Ludwigshafen Risk and Cardiovascular Health (LURIC) study and additional blood-donor controls from Mannheim.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BLOODOMICS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Bloodomics project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Identification of risk genes for atherothrombosis in coronary artery disease by transcriptome and proteome analysis and high throughput exon resequencing</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Integrated Project Bloodomics</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Bloodomics</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001538"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21966275</owl:annotatedTarget>
        <dcterms:title>Large-scale gene-centric analysis identifies novel variants for coronary artery disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21966275</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3178591/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Dutch component of the BLOODOMICS collaboration comprises of cases drawn from the Academic Medical Centre Amsterdam Premature Atherosclerosis Study (AMC-PAS) and the AGNES study, with controls ascertained from the Sanquin Common Controls (SANQUIN-CC) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001538"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A European Union Sixth Framework Programme integrated project (June 2004 to November 2008), coordinated by the University of Cambridge with clinical coronary artery disease centres, genomics groups and the Wellcome Trust Sanger Institute, that sought genes and pathways of atherothrombosis in coronary artery disease through platelet transcriptome and proteome analysis and exon resequencing. For genetic association studies it assembled a Dutch case-control collection, with cases from the Academic Medical Center Amsterdam Premature Atherosclerosis Study (AMC-PAS) and the AGNES study of first ST-elevation myocardial infarction and controls from Sanquin blood donors, and a German one, with cases and controls from the Ludwigshafen Risk and Cardiovascular Health (LURIC) study and additional blood-donor controls from Mannheim.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21966275</obo:IAO_0000119>
        <obo:IAO_0000119>https://cordis.europa.eu/project/id/503485</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001538"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BLOODOMICS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001538"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3178591/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>LURIC is a prospective study of cardiovascular death in individuals of German ancestry resident in southwest Germany who underwent elective coronary angiography and left ventriculography between June 1997 and January 2000</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001538"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3178591/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>A collection of DNA samples from blood donors from the north-west region of the Netherlands was established as controls for this study.</rdfs:comment>
    </owl:Axiom>
    


