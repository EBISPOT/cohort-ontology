    <!-- http://www.ebi.ac.uk/coho/COHO_0001351 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001351">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Norway"/>
        <obo:IAO_0000112>GCST90832977</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based health study of residents of Hordaland County in Western Norway, begun in 1992-93 as the Hordaland Homocysteine Study by the Norwegian Health Screening Service, the University of Bergen and the Municipal Health Service in Hordaland, which invited residents by year of birth and place of residence, re-examined part of them together with further birth cohorts in 1997-99, and since 2018 has re-examined those born in 1950-51 who took part in both surveys, to study chronic diseases such as cardiovascular disease, cancer, osteoporosis, anxiety and depression and their prevention.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HUSK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Helseundersøkelsen i Hordaland</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Helseundersøkelsene i Hordaland</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Hordaland Health Studies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Hordaland Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001351"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90832977</owl:annotatedTarget>
        <dcterms:title>GWAS meta-analysis reveals key risk loci in essential tremor pathogenesis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38671141</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11053069/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Hordaland Health Study (HUSK) is a community-based study in Western Norway conducted as a collaboration between the University of Bergen, the Norwegian Health Screening Service and the Municipal Health Service in Hordaland (https://husk-en.w.uib.no/)53.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001351"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based health study of residents of Hordaland County in Western Norway, begun in 1992-93 as the Hordaland Homocysteine Study by the Norwegian Health Screening Service, the University of Bergen and the Municipal Health Service in Hordaland, which invited residents by year of birth and place of residence, re-examined part of them together with further birth cohorts in 1997-99, and since 2018 has re-examined those born in 1950-51 who took part in both surveys, to study chronic diseases such as cardiovascular disease, cancer, osteoporosis, anxiety and depression and their prevention.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38671141</obo:IAO_0000119>
