    <!-- http://www.ebi.ac.uk/coho/COHO_0000564 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000564">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90102434</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of risk factors for cardiovascular outcomes among members of Group Health (now Kaiser Permanente Washington), an integrated health care system in western Washington State, with case groups of incident myocardial infarction, stroke, venous thromboembolism and atrial fibrillation and a shared control group frequency-matched to the myocardial infarction cases. Myocardial infarction, stroke and venous thromboembolism cases were identified from diagnosis codes (and, for venous thrombosis, heparin prescriptions) and validated by medical-record review; consenting participants gave blood for genotyping, and venous thromboembolism cases were followed for recurrence.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>HVH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HVH study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Heart and Vascular Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000564"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90102434</owl:annotatedTarget>
        <dcterms:title>The Pharmacogenetics of Statin Therapy on Clinical Events: No Evidence that Genetic Variation Affects Statin Response on Myocardial Infarction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35069183</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8769168/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This Heart and Vascular Health Study research was supported by NHLBI grants HL085251, HL073410, HL085251, and HL068986.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000564"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of risk factors for cardiovascular outcomes among members of Group Health (now Kaiser Permanente Washington), an integrated health care system in western Washington State, with case groups of incident myocardial infarction, stroke, venous thromboembolism and atrial fibrillation and a shared control group frequency-matched to the myocardial infarction cases. Myocardial infarction, stroke and venous thromboembolism cases were identified from diagnosis codes (and, for venous thrombosis, heparin prescriptions) and validated by medical-record review; consenting participants gave blood for genotyping, and venous thromboembolism cases were followed for recurrence.</owl:annotatedTarget>
        <obo:IAO_0000119>https://pmc.ncbi.nlm.nih.gov/articles/instance/10152894/bin/NIHMS1835943-supplement-Supplemental_Publication_Material.pdf</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
