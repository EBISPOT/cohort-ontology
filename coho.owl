    <!-- http://www.ebi.ac.uk/coho/COHO_0001073 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001073">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90704646</obo:IAO_0000112>
        <obo:IAO_0000115>A subsample of the German Study on Ageing, Cognition and Dementia in Primary Care Patients (AgeCoDe), a general-practice registry-based longitudinal study of people aged 75 and over recruited in 2002–2003 in six German cities, made up of participants who were free of dementia at baseline and had DNA available and who either developed Alzheimer-type dementia during follow-up or stayed free of dementia, selected for a genome-wide DNA methylation study of dementia and also genotyped genome-wide.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DBB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DietBB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Diet-Body-Brain cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">DietBB sample</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001073"/>
