        <obo:IAO_0000112>GCST90642411</obo:IAO_0000112>
        <obo:IAO_0000115>An ongoing longitudinal study of all twins born in Sweden since July 1992, whose parents are interviewed about the children&apos;s somatic and mental health and social environment at age 9 or 12, with follow-up questionnaires at ages 15 and 18 and clinical assessments at 15 of screen-positive twin pairs and controls, to study the aetiology of childhood mental health problems and their role in later adjustment.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CATSS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Child and Adolescent Twin Study in Sweden</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000633"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90642411</owl:annotatedTarget>
        <dcterms:title>Genetics of monozygotic twins reveals the impact of environmental sensitivity on psychiatric and neurodevelopmental phenotypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40494901</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12367547/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For the Swedish Twin Registry’s Child and Adolescent Twin Study in Sweden, E.A. performed the data analysis, P.L. was the principal investigator and R.K., M.T., S.L. and H.L. collected and prepared the data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000633"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An ongoing longitudinal study of all twins born in Sweden since July 1992, whose parents are interviewed about the children&apos;s somatic and mental health and social environment at age 9 or 12, with follow-up questionnaires at ages 15 and 18 and clinical assessments at 15 of screen-positive twin pairs and controls, to study the aetiology of childhood mental health problems and their role in later adjustment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22506305</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
