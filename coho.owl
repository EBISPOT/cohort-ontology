        <dcterms:title>Normal vascular aging: differential effects on wave reflection and aortic pulse wave velocity: the Anglo-Cardiff Collaborative Trial (ACCT).</dcterms:title>
        <oboInOwl:hasDbXref>PMID:16256881</oboInOwl:hasDbXref>
