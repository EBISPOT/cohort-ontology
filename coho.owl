    <!-- http://www.ebi.ac.uk/coho/COHO_0000745 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000745">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001053"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001176"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001205"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001220"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001554"/>
        <obo:IAO_0000112>GCST90103427</obo:IAO_0000112>
        <obo:IAO_0000115>A transatlantic consortium that meta-analysed 14 genome-wide association studies of coronary artery disease in individuals of European descent (22,233 cases and 64,762 controls), with replication genotyping in further samples, to identify susceptibility loci for coronary artery disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CARDIoGRAM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CARDIoGRAM consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Coronary ARtery DIsease Genome-wide Replication And Meta-analysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Coronary ARtery DIsease Genome-wide Replication and Meta-analysis Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Coronary ARtery Disease Genome-Wide Replication And Meta-Analysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Coronary Artery Disease Genome-Wide Replication and Meta-Analysis</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Coronary ARtery DIsease Genome wide Replication and Meta-analysis</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000745"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90103427</owl:annotatedTarget>
        <dcterms:title>Shared Genetic Architecture and Causal Relationship Between Asthma and Cardiovascular Diseases: A Large-Scale Cross-Trait Analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35126453</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8811262/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>coronary artery disease (CAD) (N = 22,233), from the Coronary ARtery Disease Genome-Wide Replication And Meta-Analysis (CARDIoGRAM) (Schunkert et al., 2011)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000745"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A transatlantic consortium that meta-analysed 14 genome-wide association studies of coronary artery disease in individuals of European descent (22,233 cases and 64,762 controls), with replication genotyping in further samples, to identify susceptibility loci for coronary artery disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21378990</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000745"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CARDIoGRAM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000745"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001053"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3070269/</oboInOwl:hasDbXref>
        <rdfs:comment>CARDIoGRAM combines data from all published and several unpublished GWAS in individuals with European ancestry; includes &gt;22 000 cases with CAD, MI, or both and &gt;60 000 controls; and unifies samples from the Atherosclerotic Disease VAscular functioN and genetiC Epidemiology study, CADomics, Cohorts for Heart and Aging Research in Genomic Epidemiology, deCODE, the German Myocardial Infarction Family Studies I, II, and III, Ludwigshafen Risk and Cardiovascular Heath Study/AtheroRemo, MedStar, Myocardial Infarction Genetics Consortium, Ottawa Heart Genomics Study, PennCath, and the Wellcome Trust Case Control Consortium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000745"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001176"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC3070269/</oboInOwl:hasDbXref>
        <rdfs:comment>CARDIoGRAM combines data from all published and several unpublished GWAS in individuals with European ancestry; includes &gt;22 000 cases with CAD, MI, or both and &gt;60 000 controls; and unifies samples from the Atherosclerotic Disease VAscular functioN and genetiC Epidemiology study, CADomics, Cohorts for Heart and Aging Research in Genomic Epidemiology, deCODE, the German Myocardial Infarction Family Studies I, II, and III, Ludwigshafen Risk and Cardiovascular Heath Study/AtheroRemo, MedStar, Myocardial Infarction Genetics Consortium, Ottawa Heart Genomics Study, PennCath, and the Wellcome Trust Case Control Consortium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000745"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001205"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4102418/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The remaining CARDIoGRAM cohorts formed the Stage 2 set and included Atherosclerotic Disease VAscular functioN and genetic Epidemiology Study (ADVANCE), CADomics, Cohorts for Heart and Aging Research in Genomic Epidemiology (CHARGE), deCODE CAD, Ludwigshafen Risk and Cardiovascular Health Study (LURIC/AtheroRemo 1, LURIC/AtheroRemo 2), MedStar, Myocardial Infarction Genetics Consortium (MIGen) and the PennCath Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000745"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001220"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5019244/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Notably, PennCATH is one of the core GWA studies nested within the Coronary ARtery DIsease Genome‐wide Replication And Meta‐analysis (CARDIoGRAM) consortium meta‐data</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000745"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001554"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20923989+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>CARDIoGRAM combines data from all published and several unpublished GWAS in individuals with European ancestry; includes &gt;22 000 cases with CAD, MI, or both and &gt;60 000 controls; and unifies samples from the Atherosclerotic Disease VAscular functioN and genetiC Epidemiology study, CADomics, Cohorts for Heart and Aging Research in Genomic Epidemiology, deCODE, the German Myocardial Infarction Family Studies I, II, and III, Ludwigshafen Risk and Cardiovascular Heath Study/AtheroRemo, MedStar, Myocardial Infarction Genetics Consortium, Ottawa Heart Genomics Study, PennCath, and the Wellcome Trust Case Control Consortium.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000746 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000746">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90429690</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal observational cohort of people with HIV who entered care from 1995 onwards at the HIV clinics of US Centers for AIDS Research (ten sites since 2021), whose data repository integrates clinical, laboratory and patient-reported outcome data from electronic health records for research on HIV care and outcomes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CFAR Network of Integrated Clinical Systems</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CNICS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CNICS cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Center for AIDS Research Network of Integrated Clinical Systems</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Centers for AIDS Research (CFAR) Network of Integrated Clinical Systems</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Centers for AIDS Research Network of Integrated Clinical Systems</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000746"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90429690</owl:annotatedTarget>
        <dcterms:title>Assessing the associations between known genetic variants and substance use in people with HIV in the United States.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37796845</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37796845+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We performed genome-wide association studies (GWAS) of alcohol, smoking, and cannabis use phenotypes in a multi-ancestry population of 7,542 PWH from the Center for AIDS Research Network of Integrated Clinical Systems (CNICS).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000746"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A longitudinal observational cohort of people with HIV who entered care from 1995 onwards at the HIV clinics of US Centers for AIDS Research (ten sites since 2021), whose data repository integrates clinical, laboratory and patient-reported outcome data from electronic health records for research on HIV care and outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37796845</obo:IAO_0000119>
        <obo:IAO_0000119>https://sites.uab.edu/cnics/cnics-sites/</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000746"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CNICS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000746"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10553320/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We conducted this study among PWH in the CNICS cohort [12], a well-characterized longitudinal observational cohort of PWH who enrolled in care at eight geographically distinct HIV clinics in the US from January 1995 through June 2020 at which time the data was accessed (http://www.uab.edu/cnics/).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000747 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000747">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90662913</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of 1,441 people aged 13–39 years with type 1 diabetes from 29 centres in the United States and Canada, enrolled in the Diabetes Control and Complications Trial (1983–1993), a randomised trial comparing intensive with conventional therapy to test whether glycaemic control prevents or delays the complications of type 1 diabetes, and followed since 1994 in the observational Epidemiology of Diabetes Interventions and Complications (EDIC) study of the durability of the treatment effects on advanced microvascular complications and cardiovascular disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DCCT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DCCT-EDIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>DCCT/EDIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Diabetes Control and Complication Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Diabetes Control and Complications Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EDIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Epidemiology of Diabetes Interventions and Complications</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Diabetes Control and Complications Trial/Epidemiology of Diabetes Interventions and Complications Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000747"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90662913</owl:annotatedTarget>
        <dcterms:title>Genetics of C-Peptide and Age at Diagnosis in Type 1 Diabetes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39556808</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11755686/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a meta-GWAS of C-peptide that including four T1D studies: the Scottish Diabetes Research Network Type 1 Bioresource (SDRNT1BIO) (4,16), Diabetes Control and Complications Trial (DCCT) (17,18), Coronary Artery Calcification in T1D (CACTI) (19,20), and Wisconsin Epidemiologic Study of Diabetic Retinopathy (WESDR) (21).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000747"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of 1,441 people aged 13–39 years with type 1 diabetes from 29 centres in the United States and Canada, enrolled in the Diabetes Control and Complications Trial (1983–1993), a randomised trial comparing intensive with conventional therapy to test whether glycaemic control prevents or delays the complications of type 1 diabetes, and followed since 1994 in the observational Epidemiology of Diabetes Interventions and Complications (EDIC) study of the durability of the treatment effects on advanced microvascular complications and cardiovascular disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24356592</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9727532/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000747"/>
