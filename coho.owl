        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001198"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>KRIEFS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001198"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4509523/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>KRIEFS was the first survey in Korea to conduct a nationwide integrated dietary exposure assessment on hazardous substances in people of all ages.</rdfs:comment>
    </owl:Axiom>
    


