    <!-- http://www.ebi.ac.uk/coho/COHO_0001238 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001238">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90244577</obo:IAO_0000112>
        <obo:IAO_0000115>A multisite, prospective, randomised, multistep clinical trial, funded by the US National Institute of Mental Health through the University of Texas Southwestern Medical Center at Dallas, that from 2001 enrolled adult outpatients aged 18 to 75 with nonpsychotic major depressive disorder from primary and specialty (psychiatric) care practices across the United States, to determine which treatments work best for those who do not respond adequately to initial treatment with citalopram.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>STAR*D</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Sequenced Treatment Alternatives to Relieve Depression</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001238"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244577</owl:annotatedTarget>
        <dcterms:title>Identifying the Common Genetic Basis of Antidepressant Response.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35712048</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9117153/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To avoid sample overlap between the major depression GWAS and the antidepressant response cohorts in this study, we used major depression GWAS summary statistics excluding overlapping cohorts (STAR∗D [Sequenced Treatment Alternatives to Relieve Depression], GENPOD [GENetic and clinical Predictors Of treatment response in Depression], GENDEP [Genome Based Therapeutic Drugs for Depression], PFZ [Pfizer]).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001238"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multisite, prospective, randomised, multistep clinical trial, funded by the US National Institute of Mental Health through the University of Texas Southwestern Medical Center at Dallas, that from 2001 enrolled adult outpatients aged 18 to 75 with nonpsychotic major depressive disorder from primary and specialty (psychiatric) care practices across the United States, to determine which treatments work best for those who do not respond adequately to initial treatment with citalopram.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15061154</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27519822</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT00021528</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001238"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>STAR*D</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001238"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9117153/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The study included 4,041 treatment-seeking adult outpatients, recruited in 18 primary care and 23 psychiatric clinical sites across the United States.</rdfs:comment>
    </owl:Axiom>
    


