    <!-- http://www.ebi.ac.uk/coho/COHO_0001601 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001601">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:34008864</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional genetic and epidemiological study of periodontal disease and caries in Gullah African Americans with type 2 diabetes from the Sea Islands and coastal low country of South Carolina. The Medical University of South Carolina ran it as the first project funded through its NIH Center of Biomedical Research Excellence (COBRE) for Oral Health. Participants were recruited in 2004–2006 from Project SuGAR, community health fairs and churches, were examined at MUSC in Charleston or at four off-site centres and gave blood for DNA, so that periodontal disease could be related to diabetes control, cytokine genes and inflammation. Their data form one of the studies of the Sea Islands Genetics Network.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>COBRE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COBRE for Oral Health</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COBRE for Oral Health Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Center of Biomedical Research Excellence for Oral Health pilot project</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">An Epidemiological Study of Periodontal Disease and Diabetes: Cytokine Genes and Inflammation Factors</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001601"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34008864</owl:annotatedTarget>
        <dcterms:title>Genetic landscape of Gullah African Americans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34008864</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8286328/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants from three SIFP projects were included in our study: the Sea Island Genetic African American Registry (Project SuGAR) (Divers et al., 2010); the Center of Biomedical Research Excellence (COBRE) for Oral Health pilot project, “An Epidemiological Study of Periodontal Disease and Diabetes: Cytokine Genes and Inflammation Factors” (Fernandes et al., 2009); and the Systemic Lupus Erythematosus in Gullah Health (SLEIGH) Study (Kamen et al., 2008).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001601"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional genetic and epidemiological study of periodontal disease and caries in Gullah African Americans with type 2 diabetes from the Sea Islands and coastal low country of South Carolina. The Medical University of South Carolina ran it as the first project funded through its NIH Center of Biomedical Research Excellence (COBRE) for Oral Health. Participants were recruited in 2004–2006 from Project SuGAR, community health fairs and churches, were examined at MUSC in Charleston or at four off-site centres and gave blood for DNA, so that periodontal disease could be related to diabetes control, cytokine genes and inflammation. Their data form one of the studies of the Sea Islands Genetics Network.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:19563285</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23966867</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25364473</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34008864</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001601"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>COBRE</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001601"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2862011/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>Recruitment was restricted to residents of South Carolina living along the coastal border and 30 miles inland.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001602 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001602">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:34143812</obo:IAO_0000112>
        <obo:IAO_0000115>A biobank of whole blood left over from the clinical care of patients admitted in 2010–2017 to six cardiology departments in the Capital Region of Denmark, around Copenhagen. The samples are linked to Danish clinical registries such as the Eastern Danish Heart Registry, and genotyped subsets of the patients, for example those who underwent coronary angiography in 2010–2014, are used to study the genetics of coronary artery disease, heart failure and other cardiovascular disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>COGEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cogen</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Copenhagen Cardiovascular Genetic study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Copenhagen Cardiovascular Genetic study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001602"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:34143812</owl:annotatedTarget>
        <dcterms:title>Insulin resistance genetic risk score and burden of coronary artery disease in patients referred for coronary angiography.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34143812</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8213191/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Copenhagen Cardiovascular Genetic study (COGEN) is comprised of approximately 80,000 patients admitted to six cardiology departments in the capital region of Copenhagen, Denmark, from 2010–2017.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001602"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A biobank of whole blood left over from the clinical care of patients admitted in 2010–2017 to six cardiology departments in the Capital Region of Denmark, around Copenhagen. The samples are linked to Danish clinical registries such as the Eastern Danish Heart Registry, and genotyped subsets of the patients, for example those who underwent coronary angiography in 2010–2014, are used to study the genetics of coronary artery disease, heart failure and other cardiovascular disease.</owl:annotatedTarget>
