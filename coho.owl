        <oboInOwl:hasRelatedSynonym>Genes Associated with Stroke Risk and Outcomes Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MGH Genes Affecting Stroke Risk and Outcome Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MGH-GASROS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Massachusetts General Hospital – Genes Affecting Stroke Risk and Outcome Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genes Affecting Stroke Risk and Outcome Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001102"/>
