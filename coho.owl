    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000482 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000482">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
