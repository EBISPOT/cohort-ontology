        <obo:IAO_0000112>GCST90011858</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of bladder cancer (the EPICURO study) that enrolled patients newly diagnosed with urothelial carcinoma of the bladder in 1998–2001 at 18 hospitals in five regions of Spain and individually matched hospital controls, to study environmental, occupational and genetic risk factors for bladder cancer.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym SBCS also denotes Shanghai Breast Cancer Study (COHO:0000795); this term is Spanish Bladder Cancer Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>EPICURO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SBC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>SpBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Spanish Bladder Cancer EPICURO Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Spanish Bladder Cancer/EPICURO study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Spanish Bladder Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000797"/>
