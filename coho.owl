        <obo:IAO_0000112>GCST90034520</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of about 190 white Dutch sibling pairs aged 40–70 with symptomatic osteoarthritis at multiple joint sites, recruited from rheumatology, orthopaedic and general practice clinics around Leiden, the Netherlands, by Leiden University Medical Center to identify determinants of osteoarthritis susceptibility and progression.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GARP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GARP study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetic ARthrosis and Progression study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics OsteoArthritis and Progression</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics osteoARthritis and Progression</oboInOwl:hasRelatedSynonym>
