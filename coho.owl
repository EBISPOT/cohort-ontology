        <oboInOwl:hasRelatedSynonym>AfterEU</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">AFTER EU</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001478"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:31152163</owl:annotatedTarget>
