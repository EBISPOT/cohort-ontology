    <!-- http://www.ebi.ac.uk/coho/COHO_0001336 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001336">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <obo:IAO_0000112>GCST90700332</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre observational cohort of adult patients of European ancestry with sepsis of any cause admitted to a network of intensive care units in Spain, recruited through the GEN-SEP Network of Spanish investigators in two periods (2002–2015 and 2016–2019) and followed for the development of acute respiratory distress syndrome and for 28-day survival, whose DNA is used in genetic studies of sepsis-associated ARDS and sepsis outcomes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GEN-SEP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GEN-SEP Network</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Sepsis Network</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Sepsis-induced ARDS Network</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">GENetics of SEPsis-induced ARDS Network</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001336"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90700332</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study of susceptibility to acute respiratory distress syndrome.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41033104</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12516505/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a GWAS meta-analysis on 5115 critically ill patients, 82.8% with severe infections, comprising 716 ARDS cases and 4399 at-risk controls from three independent studies (Fig. 1, Table S1): the GENetics of SEPsis-induced ARDS Network (GEN-SEP), the Critical Care Trials Group of the German Sepsis Competence Network (SepNet), and UK Biobank (UKBB).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001336"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre observational cohort of adult patients of European ancestry with sepsis of any cause admitted to a network of intensive care units in Spain, recruited through the GEN-SEP Network of Spanish investigators in two periods (2002–2015 and 2016–2019) and followed for the development of acute respiratory distress syndrome and for 28-day survival, whose DNA is used in genetic studies of sepsis-associated ARDS and sepsis outcomes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29987654</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:36335405</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41033104</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001336"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GEN-SEP</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001336"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12516505/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>GEN-SEP is a multicentre, observational study conducted in a Spanish network of ICUs comprising adult patients with all-cause sepsis of European ancestry recruited in two periods (in 2002-2015 and in 2016-2019) (Hernandez-Beeftink et al., 2022).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001337 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001337">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90188370</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case–control study of early-onset ischaemic stroke, run from the University of Maryland, Baltimore, that recruited women and men aged 15–49 with a first ischaemic stroke, identified by discharge surveillance at 59 hospitals of the greater Baltimore–Washington area of the United States and by referral from regional neurologists, in four periods between 1992 and 2008, together with controls without stroke found by random-digit dialling and matched on age and region of residence, in a biracial sample of European American and African American participants; it was designed to identify the genetic determinants of early-onset ischaemic stroke and their interactions with environmental risk factors.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GEOS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Early Onset Stroke</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Early Onset Stroke study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Early-Onset Stroke</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genetics of Early-Onset Stroke Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>genetics of early onset stroke study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>genetics of early-onset stroke study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetics of Early Onset Stroke Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001337"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90188370</owl:annotatedTarget>
        <dcterms:title>Contribution of Common Genetic Variants to Risk of Early-Onset Ischemic Stroke.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36240095</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://cdn-links.lww.com/permalink/wnl/c/wnl_2022_08_08_mitchell_1_sdc1.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The GEOS study is a population-based case-control study designed to identify the genetic determinants of early-onset ischemic stroke</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001337"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case–control study of early-onset ischaemic stroke, run from the University of Maryland, Baltimore, that recruited women and men aged 15–49 with a first ischaemic stroke, identified by discharge surveillance at 59 hospitals of the greater Baltimore–Washington area of the United States and by referral from regional neurologists, in four periods between 1992 and 2008, together with controls without stroke found by random-digit dialling and matched on age and region of residence, in a biracial sample of European American and African American participants; it was designed to identify the genetic determinants of early-onset ischaemic stroke and their interactions with environmental risk factors.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23459313</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38094903</obo:IAO_0000119>
        <obo:IAO_0000119>https://cdn-links.lww.com/permalink/wnl/c/wnl_2022_08_08_mitchell_1_sdc1.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001337"/>
