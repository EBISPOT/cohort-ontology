    <!-- http://www.ebi.ac.uk/coho/COHO_0001161 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001161">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90281037</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised, multicentre, double-blind, placebo-controlled phase III trial population of adults with early, treated Parkinson&apos;s disease (within five years of diagnosis and receiving dopaminergic therapy). Participants were enrolled at 45 sites in the United States and Canada from March 2007 to May 2010 by the NINDS Exploratory Trials in Parkinson&apos;s Disease (NET-PD) network, to test whether creatine slows long-term clinical decline, and were followed until September 2013. DNA from the participants who consented to banking is held in the Coriell Institute for Medical Research biorepository.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CORIELL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LS-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Long-term Study 1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Long-term Study-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NET-PD LS-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NET-PD LS1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NET-PD Long term Study-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NINDS Exploratory Trials in PD Long-Term Study 1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NINDS Exploratory Trials in PD Long-term Study-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>National Institute of Neurological Disorders and Stroke Exploratory Trials in Parkinson Disease Long-Term Study-1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">National Institute of Neurological Disorders and Stroke Exploratory Trials in Parkinson&apos;s Disease Long-Term Study-1</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001161"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90281037</owl:annotatedTarget>
        <dcterms:title>Dopamine Pathway and Parkinson&apos;s Risk Variants Are Associated with Levodopa-Induced Dyskinesia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39132902</oboInOwl:hasDbXref>
