    <!-- http://www.ebi.ac.uk/coho/COHO_0001117 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001117">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001115"/>
        <obo:IAO_0000112>GCST90984764</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of individuals with sickle cell disease recruited from Baylor College of Medicine and from the Sickle Cell Clinical Research and Intervention Program (SCCRIP) cohort at St. Jude Children&apos;s Research Hospital, whose whole genomes were sequenced to define genotype-phenotype relations in sickle cell disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SGP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Sickle Cell Genome Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001117"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90984764</owl:annotatedTarget>
        <dcterms:title>A polygenic score for acute vaso-occlusive pain in pediatric sickle cell disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34283174</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC8341359/</oboInOwl:hasDbXref>
        <rdfs:comment>To better define genotype–phenotype relations in SCD, we initiated the Sickle Cell Genome Project (SGP) by performing whole-genome sequencing (WGS) on participants from Baylor College of Medicine (BCM) and from the St. Jude Children’ Research Hospital Sickle Cell Clinical Research and Intervention Program (SCCRIP) longitudinal cohort study (clinicaltrials.gov #NCT02098863).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001117"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of individuals with sickle cell disease recruited from Baylor College of Medicine and from the Sickle Cell Clinical Research and Intervention Program (SCCRIP) cohort at St. Jude Children&apos;s Research Hospital, whose whole genomes were sequenced to define genotype-phenotype relations in sickle cell disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:34283174</obo:IAO_0000119>
        <dcterms:contributor>Claude Sonnet 5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
