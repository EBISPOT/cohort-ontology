    <!-- http://www.ebi.ac.uk/coho/COHO_0001212 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001212">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90274713</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of prostate cancer of the US National Cancer Institute in the Baltimore area of Maryland, which from 2005 to 2015 enrolled African American and European American men diagnosed with prostate cancer at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center, and population controls identified through the Maryland motor vehicle administration and frequency-matched to cases on age and race. Participants were interviewed about their demographics, lifestyle and medical and family history and gave blood or mouthwash samples, to study environmental and genetic factors in prostate cancer among African American men.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Maryland Prostate Cancer Case-Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCI-MD</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCI-Maryland prostate Cancer Case-Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">NCI-Maryland Prostate Cancer Case-Control Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90274713</owl:annotatedTarget>
        <dcterms:title>Characterizing prostate cancer risk through multi-ancestry genome-wide discovery of 187 novel risk variants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37945903</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10841479/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The present study included an additional 49,072 cases and 661,437 controls from the UK Biobank, the FinnGen study, the Electronic Medical Records and Genomics (eMERGE) Network, the BioVU Biobank, the BioMe Biobank, the Prostate, Lung, Colorectal, and Ovarian Cancer Screening Trial (PLCO), the MD Anderson prostate cancer study (MD Anderson), the California and Uganda Prostate Cancer Study (CA UG), the VA Million Veteran Program (MVP), and the Maryland Prostate Cancer Case-Control Study (NCI-MD) (Supplementary Table 1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of prostate cancer of the US National Cancer Institute in the Baltimore area of Maryland, which from 2005 to 2015 enrolled African American and European American men diagnosed with prostate cancer at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center, and population controls identified through the Maryland motor vehicle administration and frequency-matched to cases on age and race. Participants were interviewed about their demographics, lifestyle and medical and family history and gave blood or mouthwash samples, to study environmental and genetic factors in prostate cancer among African American men.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29784730</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35468990</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>NCI-MD</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001212"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
