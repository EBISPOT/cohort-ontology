    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001161"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised, multicentre, double-blind, placebo-controlled phase III trial population of adults with early, treated Parkinson&apos;s disease (within five years of diagnosis and receiving dopaminergic therapy). Participants were enrolled at 45 sites in the United States and Canada from March 2007 to May 2010 by the NINDS Exploratory Trials in Parkinson&apos;s Disease (NET-PD) network, to test whether creatine slows long-term clinical decline, and were followed until September 2013. DNA from the participants who consented to banking is held in the Coriell Institute for Medical Research biorepository.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23079770</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:25486269</obo:IAO_0000119>
