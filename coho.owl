        <oboInOwl:hasRelatedSynonym>Partners Health</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Partners HealthCare Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Partners Healthcare Biorepository</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Partners Healthcare System Biobank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Partners study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Mass General Brigham Biobank</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000383"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90837428</owl:annotatedTarget>
        <dcterms:title>Genetics and context for precision health in Greater Boston.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41298473</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41298473+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We established the Mass General Brigham Biobank (MGBB), currently encompassing 142,238 participants, to unravel the intricate relationships among genomic profiles, environmental context, and disease manifestations within clinical practice.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000383"/>
