    <!-- http://www.ebi.ac.uk/coho/COHO_0000722 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000722">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90435154</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective inception cohort of patients younger than 18 years with suspected inflammatory bowel disease, enrolled at diagnosis between 2008 and 2012 at 28 sites in the United States and Canada (mostly Crohn&apos;s disease, also ulcerative colitis, unclassified IBD and non-inflamed controls), to characterise the natural history of newly diagnosed paediatric Crohn&apos;s disease and predict its complications from clinical, serological, genomic and microbial markers at diagnosis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>RISK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RISK study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Risk Stratification and Identification of Immunogenetic and Microbial Markers of Rapid Disease Progression in Children with Crohn’s Disease</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Risk Stratification and Identification of Immunogenetic and Microbial Markers of Rapid Disease Progression in Children with Crohn&apos;s Disease</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000722"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90435154</owl:annotatedTarget>
        <dcterms:title>Comprehensive Association Analyses of Extraintestinal Manifestations in Inflammatory Bowel Disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38490347</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38490347+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We assembled the largest multicohort data set to date to investigate the clinical, serologic, and genetic factors associated with EIM complications in IBD.MethodsData were available in 12,083 unrelated European ancestry IBD cases with presence or absence of EIMs (eg, ankylosing spondylitis [ankylosing spondylitis and sacroiliitis], primary sclerosing cholangitis [PSC], peripheral arthritis, and skin and ocular manifestations) across 4 cohorts (Cedars-Sinai Medical Center, National Institute for Diabetes and Digestive and Kidney Diseases IBD Genetics Consortium, Sinai Helmsley Alliance for Research Excellence Consortium, and Risk Stratification and Identification of Immunogenetic and Microbial Markers of Rapid Disease Progression in Children with Crohn&apos;s Disease cohort).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000722"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective inception cohort of patients younger than 18 years with suspected inflammatory bowel disease, enrolled at diagnosis between 2008 and 2012 at 28 sites in the United States and Canada (mostly Crohn&apos;s disease, also ulcerative colitis, unclassified IBD and non-inflamed controls), to characterise the natural history of newly diagnosed paediatric Crohn&apos;s disease and predict its complications from clinical, serological, genomic and microbial markers at diagnosis.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28259484</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
