    <!-- http://www.ebi.ac.uk/coho/COHO_0000601 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000601">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>GCST90053837</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based registry of colorectal cancer patients in the Canadian province of Newfoundland and Labrador, run from Memorial University of Newfoundland, that in 1999–2003 recruited about 750 patients diagnosed under the age of 75 to study the genetic and familial factors behind the province&apos;s high colorectal cancer incidence and has followed them for recurrence and survival for up to 19 years. For a population-based case-control study, controls frequency-matched to the cases by age group and sex were selected from the province&apos;s residents by random digit dialling.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NFCCR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Newfoundland Case-Control Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Newfoundland Familial Colon Cancer Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Newfoundland Familial Colorectal Cancer Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Newfoundland Familial Colorectal Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Newfoundland Colorectal Cancer Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000601"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
