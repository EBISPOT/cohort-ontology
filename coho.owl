        <obo:IAO_0000112>GCST90011781</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of DNA samples and lymphoblastoid cell lines from Han Chinese individuals in Beijing, China, that forms one of the four founding population samples of the International HapMap Project and is used as a reference for human genetic variation.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym ASN also denotes Japanese in Tokyo, Japan (COHO:0000809); this term is Han Chinese in Beijing, China.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The acronym CHB also denotes Copenhagen Hospital Biobank (COHO:0000046); this term is Han Chinese in Beijing, China.</obo:IAO_0000116>
