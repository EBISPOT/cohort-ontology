        <obo:IAO_0000112>PMID:27089181</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of about 30 cohorts with genome-wide genotype and personality data, which harmonized personality measures across inventories in more than 63,000 participants for genome-wide association meta-analyses of personality traits such as neuroticism and their relation to major depressive disorder.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym GPC also denotes Uganda General Population Cohort (COHO:0000345); this term is Genetics of Personality Consortium.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>GPC</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Genetics of Personality Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000461"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27089181</owl:annotatedTarget>
        <dcterms:title>Genetic variants associated with subjective well-being, depressive symptoms, and neuroticism identified through genome-wide analyses.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27089181</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4884152/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For neuroticism (N = 170,910), we pooled summary statistics from a published study by the Genetics of Personality Consortium (GPC)4 with results from a new analysis of UKB data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000461"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium of about 30 cohorts with genome-wide genotype and personality data, which harmonized personality measures across inventories in more than 63,000 participants for genome-wide association meta-analyses of personality traits such as neuroticism and their relation to major depressive disorder.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25993607</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
