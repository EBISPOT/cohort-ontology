    <!-- http://www.ebi.ac.uk/coho/COHO_0001455 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001455">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001333"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001483"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Barbados"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Cameroon"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Central_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Ghana"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Latin_America_and_the_Caribbean"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Nigeria"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Uganda"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Western_Africa"/>
        <obo:IAO_0000112>PMID:38741014</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium for genetic studies of breast cancer in women of African ancestry that pools whole-genome sequencing data, new Multi-Ethnic Genotyping Array genotypes and existing genotype data on breast cancer cases and controls from more than 20 studies in the United States, Africa and Barbados, among them the samples of the AMBER, ROOT, AABC and GAME-ON OncoArray consortia, for genome-wide association analyses and polygenic risk prediction.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>AABCG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>African American Breast Cancer Genetic consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>African Ancestry Breast Cancer Genetic consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>African Ancestry Breast Cancer Genetics Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>African-ancestry Breast Cancer Genetic Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>African-ancestry Breast Cancer Genetic consortium</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">African Ancestry Breast Cancer Genetic Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001455"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:38741014</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analyses of breast cancer in women of African ancestry identify new susceptibility loci and improve risk prediction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38741014</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC11284829</oboInOwl:hasDbXref>
        <rdfs:comment>In this study, we used genetic data from the AABCG, a consortium for a genetic study of breast cancer for females of African ancestry, including genetic data from over 20 studies conducted in the U.S. and Africa.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001455"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium for genetic studies of breast cancer in women of African ancestry that pools whole-genome sequencing data, new Multi-Ethnic Genotyping Array genotypes and existing genotype data on breast cancer cases and controls from more than 20 studies in the United States, Africa and Barbados, among them the samples of the AMBER, ROOT, AABC and GAME-ON OncoArray consortia, for genome-wide association analyses and polygenic risk prediction.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38741014</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41629673</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001455"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AABCG</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001455"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001333"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>After quality control, we included 660 cases and 1,496 controls of African ancestry from GBHS genotyping data.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001455"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001483"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The AMBER is a collaboration of four studies: the Women’s Circle of Health Study (WCHS), the Black Women’s Health Study (BWHS), the Carolina Breast Cancer Study (CBCS), and the Multiethnic Cohort Study (MEC) funded by the National Cancer Institute.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001455"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Barbados"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The BNCS is a population-based case-control study of incident breast and prostate cancer in the predominantly African population of Barbados, West Indies</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001455"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Cameroon"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The WAABCS is a hospital-based case-control study originally started in Nigeria in 1998 and was expanded to Uganda and Cameroon in 2011 with the same questionnaires and protocol</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001455"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Ghana"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The GBHS is a population-based case-control study conducted in Accra and Kumasi, Ghana</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001455"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Nigeria"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The NBCS is an ongoing case-control study of breast cancer in Ibadan, Nigeria</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001455"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://europepmc.org/api/getPdf?pmcid=PMC11284829</oboInOwl:hasDbXref>
        <rdfs:comment>In brief, we analyzed whole-genome sequenced and high-density genotyped data from 18,034 female cases with breast cancer and 22,104 female controls of African ancestry from 26 studies participating in the AABCG, with 85.3% of participants from the United States and 14.7% from the African continent and Barbados.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001456 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001456">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:29273806</obo:IAO_0000112>
        <obo:IAO_0000115>An Australian research consortium, supported by the National Health and Medical Research Council, that pooled genotyped physician-diagnosed asthma cases and controls of European ancestry from several Australian studies, among them studies of the Queensland Institute of Medical Research, the Lung Institute of Western Australia, the Busselton Health Study and the Tasmanian Longitudinal Health Study, into a genome-wide association study of asthma first reported in 2011. Its data have since been used in international meta-analyses of asthma and allergic disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>AAGC</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Australian Asthma Genetics Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
