    <!-- http://www.ebi.ac.uk/coho/COHO_0000488 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000488">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Guinea-Bissau"/>
