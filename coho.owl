        <obo:IAO_0000112>GCST90432152</obo:IAO_0000112>
        <obo:IAO_0000115>A UK national prospective cohort of men recruited in 2011–2019 through the NHS abdominal aortic aneurysm screening programmes of England, Wales and Scotland, which invite men in the year of their 65th birthday: men with a small aneurysm detected at screening, together with screened men without an aneurysm as controls, followed with annual postal questionnaires and, for those with an aneurysm, ultrasound surveillance scans, to study the growth of small abdominal aortic aneurysms.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>UKAGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>United Kingdom Aneurysm Growth Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">UK Aneurysm Growth Study</rdfs:label>
    </owl:NamedIndividual>
