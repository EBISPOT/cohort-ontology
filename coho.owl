        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Taiwan"/>
        <obo:IAO_0000112>GCST90502911</obo:IAO_0000112>
        <obo:IAO_0000115>A study of rare variants for hypertension in Taiwan Chinese that combines three cohorts based in Taiwan: families from the SAPPHIRe study, launched in 1995, with at least two hypertensive siblings, and unrelated participants from Tri-Service General Hospital and Taichung Veterans General Hospital matched to SAPPHIRe participants for age, sex and BMI category. All its participants were selected for whole-genome sequencing in the NHLBI TOPMed programme.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>THRV</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Taiwan Study of Hypertension using Rare Variants</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Rare Variants for Hypertension in Taiwan Chinese</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000984"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90502911</owl:annotatedTarget>
        <dcterms:title>Whole genome sequencing analysis of body mass index identifies novel African ancestry-specific risk allele.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40216759</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11992084/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>NHLBI TOPMed: Taiwan Study of Hypertension using Rare Variants (THRV) The Rare Variants for Hypertension in Taiwan Chinese (THRV) is supported by the National Heart, Lung, and Blood Institute (NHLBI) grant (R01HL111249) and its participation in TOPMed is supported by an NHLBI supplement (R01HL111249-04S1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000984"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study of rare variants for hypertension in Taiwan Chinese that combines three cohorts based in Taiwan: families from the SAPPHIRe study, launched in 1995, with at least two hypertensive siblings, and unrelated participants from Tri-Service General Hospital and Taichung Veterans General Hospital matched to SAPPHIRe participants for age, sex and BMI category. All its participants were selected for whole-genome sequencing in the NHLBI TOPMed programme.</owl:annotatedTarget>
        <obo:IAO_0000119>https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
