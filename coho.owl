        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Japan"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11884146/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>All 6,324 genomic DNA samples and the associated clinical data were obtained from the National Center for Geriatrics and Gerontology (NCGG) Biobank, Japan.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000877 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000877">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
