    <!-- http://www.ebi.ac.uk/coho/COHO_0000571 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000571">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <obo:IAO_0000112>GCST90090964</obo:IAO_0000112>
        <obo:IAO_0000115>A Japanese multi-institutional genome cohort, launched in 2005, of 92,610 adults aged 35–69 years from 14 study regions in 12 prefectures (respondents to study announcements, people attending local-government health checkups or health checkup centres, and first-visit patients at a cancer hospital), who gave baseline questionnaire data and blood samples in 2005–2014 and are followed until 2025, to examine gene–environment interactions in lifestyle-related diseases, mainly cancer.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>J-MICC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>J-MICC Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Japan Multi-institutional Collaborative Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Japan Multi-Institutional Collaborative Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000571"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90090964</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study on meat consumption in a Japanese population: the Japan Multi-Institutional Collaborative Cohort study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34733494</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34733494+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We analysed GWAS data using 14 076 participants from the Japan Multi-Institutional Collaborative Cohort (J-MICC) study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000571"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Japanese multi-institutional genome cohort, launched in 2005, of 92,610 adults aged 35–69 years from 14 study regions in 12 prefectures (respondents to study announcements, people attending local-government health checkups or health checkup centres, and first-visit patients at a cancer hospital), who gave baseline questionnaire data and blood samples in 2005–2014 and are followed until 2025, to examine gene–environment interactions in lifestyle-related diseases, mainly cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17696755</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32963210</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
