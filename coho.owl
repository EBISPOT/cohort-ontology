        <obo:IAO_0000112>GCST90103973</obo:IAO_0000112>
        <obo:IAO_0000115>A sub-study of Heart SCORE (Heart Strategies Concentrating on Risk Evaluation), a community-based cohort begun in 2003 of White and African American adults aged 45–75 in the greater Pittsburgh area, Pennsylvania, set up to investigate racial disparities in cardiovascular disease, in which a subgroup of participants had extended dental and periodontal examinations following the COHRA1 protocols and gave blood or saliva for DNA in 2007–2010, run by the University of Pittsburgh.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Dental SCORE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Pittsburgh Dental SCORE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Dental Strategies Concentrating on Risk Evaluation</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001312"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90103973</owl:annotatedTarget>
        <dcterms:title>Genetic Analyses of Enamel Hypoplasia in Multiethnic Cohorts.</dcterms:title>
