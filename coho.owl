        <dcterms:title>Genetic association study of preterm birth and gestational age in a population-based case-control study in Peru.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39302385</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.medrxiv.org/content/medrxiv/early/2023/11/22/2023.11.22.23298891.full.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>This study was conducted among participants of the Placental Abruption Genetic Epidemiology</rdfs:comment>
    </owl:Axiom>
