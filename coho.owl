        <rdfs:comment>The cohort of 139 probands in the Boston Early-Onset COPD Study was recruited from lung transplant and general pulmonary clinics between September 1994 and July 2002.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001523"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family study begun in 1994 at Brigham and Women&apos;s Hospital, Boston, to find genetic determinants of chronic obstructive pulmonary disease other than alpha-1 antitrypsin deficiency, which enrols extended pedigrees, mainly in New England, ascertained through probands with severe COPD (FEV1 at most 40% predicted) before age 53 and without severe alpha-1 antitrypsin deficiency, recruited from lung transplant and general pulmonary clinics, together with their first- and second-degree relatives aged 10 years or older.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15539711</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000946.v1.p1</obo:IAO_0000119>
