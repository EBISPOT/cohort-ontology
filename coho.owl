        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10944835/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The QUEBEC-CAVS study was approved by the ethics committee of the Institut universitaire de cardiologie et de pneumologie de Québec-Université Laval.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
