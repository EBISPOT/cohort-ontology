        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South-Eastern_Asia"/>
        <obo:IAO_0000112>GCST90448709</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective observational cohort of older multi-ethnic Asian patients aged 50 or over with no cognitive impairment, mild cognitive impairment or dementia due to Alzheimer&apos;s disease and/or cerebrovascular disease, recruited from 2010 at the memory clinics of the National University Hospital and St Luke&apos;s Hospital in Singapore and assessed by the Memory Aging and Cognition Centre, National University of Singapore, with annual clinical and neuropsychological follow-up for up to five years and brain MRI, retinal and blood biomarker data, to study vascular cognitive impairment and Alzheimer&apos;s disease.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MCS also denotes UK Millennium Cohort Study (COHO:0000801); this term is HARMONISATION study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>HARMONISATION</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>HARMONIZATION</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Harmonization Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Harmonization study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Memory Clinic in Singapore</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Memory Clinic in Singapore Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Memory Clinic in Singapore study</oboInOwl:hasRelatedSynonym>
