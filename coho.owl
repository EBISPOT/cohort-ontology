    <!-- http://www.ebi.ac.uk/coho/COHO_0001329 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001329">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>GCST90854245</obo:IAO_0000112>
        <obo:IAO_0000115>A post-GWAS research programme on epithelial ovarian cancer, funded by the US National Cancer Institute (U19-CA148112) as the ovarian cancer consortium of the Genetic Associations and Mechanisms in Oncology (GAME-ON) initiative, led from Moffitt Cancer Center and built on the collaboration of the Ovarian Cancer Association Consortium, that pools genome-wide and further genotyping data (including exome-chip and OncoArray genotyping) from the case-control studies of that consortium, to discover and replicate susceptibility variants, including histotype-specific variants and variants associated with survival, to study their biological mechanisms, and to investigate gene–gene and gene–environment interactions and risk prediction.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>FOCI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FOCI-OCAC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Follow-up of Ovarian Cancer Genetic Association and Interaction Studies of the Ovarian Cancer Association Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Follow-up of Ovarian Cancer Genetic Association and Interaction Studies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Follow-up of Ovarian Cancer Genetic Association and Interaction Studies</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001329"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90854245</owl:annotatedTarget>
        <dcterms:title>Boosting the Power of Rare Variant Association Studies by Imputation Using Large-scale Sequencing Population.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40973091</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13005946/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>For EOC, three SNP array datasets were collected from the Follow-up of Ovarian Cancer Genetic Association and Interaction Studies (FOCI)-OncoArray [64], the FOCI-Exome Chip [65], and the Consortium of Investigators of Modifiers of BRCA1/2 (CIMBA) [66] (Table S26).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001329"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A post-GWAS research programme on epithelial ovarian cancer, funded by the US National Cancer Institute (U19-CA148112) as the ovarian cancer consortium of the Genetic Associations and Mechanisms in Oncology (GAME-ON) initiative, led from Moffitt Cancer Center and built on the collaboration of the Ovarian Cancer Association Consortium, that pools genome-wide and further genotyping data (including exome-chip and OncoArray genotyping) from the case-control studies of that consortium, to discover and replicate susceptibility variants, including histotype-specific variants and variants associated with survival, to study their biological mechanisms, and to investigate gene–gene and gene–environment interactions and risk prediction.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23382860</obo:IAO_0000119>
