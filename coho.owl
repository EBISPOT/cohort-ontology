        <oboInOwl:hasRelatedSynonym>Pharma Proteomics Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK Biobank Pharma Plasma Proteome</oboInOwl:hasRelatedSynonym>
