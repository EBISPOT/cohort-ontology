        <obo:IAO_0000112>GCST001505</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of research groups that combines multiple sclerosis case collections from people of European descent across 15 countries with control datasets to investigate genetic susceptibility to multiple sclerosis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>IMSGC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
