    <!-- http://www.ebi.ac.uk/coho/COHO_0001142 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001142">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90244057</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre prospective study sponsored by the US National Eye Institute that recruited people aged 55 to 80, with or without age-related macular degeneration or lens opacities, at 11 retinal specialty clinics in the United States from 1992 to 1998 and followed them to 2005. It studied the clinical course and risk factors of age-related macular degeneration and cataract, and included randomised, placebo-controlled trials of high-dose antioxidant vitamins and zinc for these conditions.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym AREDS also denotes Age-Related Eye Disease Study 2 (COHO:0001143); this term is Age-Related Eye Disease Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>AREDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Age-Related Eye Disease Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001142"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244057</owl:annotatedTarget>
        <dcterms:title>Rare variant analyses across multiethnic cohorts identify novel genes for refractive error.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36596879</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>For the current analysis, 1562 participants aged 60 and older were included from the AREDS 1a, 1b and 1c population.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001142"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre prospective study sponsored by the US National Eye Institute that recruited people aged 55 to 80, with or without age-related macular degeneration or lens opacities, at 11 retinal specialty clinics in the United States from 1992 to 1998 and followed them to 2005. It studied the clinical course and risk factors of age-related macular degeneration and cataract, and included randomised, placebo-controlled trials of high-dose antioxidant vitamins and zinc for these conditions.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:10588299</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:11594942</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39826679</obo:IAO_0000119>
        <obo:IAO_0000119>https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000001.v3.p1</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001142"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>AREDS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001142"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13157973/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Briefly, 4757 participants aged 55 to 80 years were recruited between 1992 and 1998 at 11 retinal specialty clinics in the United States.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001143 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001143">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90559231</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre, randomised, double-masked, placebo-controlled phase 3 trial sponsored by the US National Eye Institute and run from 2006 to 2012 at 82 clinical centres in the United States. It enrolled people aged 50 to 85 at risk of progressing to advanced age-related macular degeneration to test whether adding lutein plus zeaxanthin or omega-3 fatty acids to the AREDS supplement formulation, or removing beta carotene or lowering zinc, changes that risk.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym AREDS also denotes Age-Related Eye Disease Study (COHO:0001142); this term is Age-Related Eye Disease Study 2.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>AREDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>AREDS2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Age-Related Eye Disease Study 2</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001143"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90559231</owl:annotatedTarget>
        <dcterms:title>HTRA1/lncRNA HTRA1-AS1 dominates in age-related macular degeneration reticular pseudodrusen genetic risk with no complement involvement.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41361163</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12685958/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The AREDS2_OCT and NEI_research studies were supported by the intramural program funds and contracts from the National Eye Institute/National Institutes of Health (NEI/NIH), Department of Health and Human Services, Bethesda, MD</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
