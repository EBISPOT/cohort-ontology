    <!-- http://www.ebi.ac.uk/coho/COHO_0000575 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000575">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <obo:IAO_0000112>GCST90566795</obo:IAO_0000112>
        <obo:IAO_0000115>A Japanese knee osteoarthritis case-control collection assembled at the RIKEN Center for Genomic Medicine, of about 900 symptomatic knee osteoarthritis cases diagnosed by orthopaedic surgeons from clinical and radiographic examination at several Japanese medical institutes and about 3,400 controls from BioBank Japan and Osaka volunteers, genotyped genome-wide to find knee osteoarthritis susceptibility loci.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym RIKEN also denotes BioBank Japan (COHO:0000377) and RIKEN cohort (COHO:0000576); this term is RIKEN Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>Japan Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>RIKEN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">RIKEN Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000575"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90566795</owl:annotatedTarget>
        <dcterms:title>Translational genomics of osteoarthritis in 1,962,069 individuals.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:40205036</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12119359/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The sensitivity meta-analysis includes 5 GWASs from the HKDDDPC, RIKEN and Rotterdam studies 1, 2 and 3, totalling a maximum of 6,816 cases and 9,624 controls</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000575"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Japanese knee osteoarthritis case-control collection assembled at the RIKEN Center for Genomic Medicine, of about 900 symptomatic knee osteoarthritis cases diagnosed by orthopaedic surgeons from clinical and radiographic examination at several Japanese medical institutes and about 3,400 controls from BioBank Japan and Osaka volunteers, genotyped genome-wide to find knee osteoarthritis susceptibility loci.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20305777</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
