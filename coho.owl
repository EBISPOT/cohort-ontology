        <obo:IAO_0000112>GCST90670368</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based cohort of the adult children and grandchildren of participants in the Malmö Diet and Cancer Study–Cardiovascular Cohort in Malmö, Sweden, identified from Swedish Tax Agency registers and invited by mail, and examined from 2013 (4,721 participants aged 18–71 by 2020) with genotyping and cardiovascular, respiratory, metabolic, cognitive, dietary and gut and oral microbiota phenotyping, to study family traits of chronic disease across three generations.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MOS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Malmö Offspring Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000392"/>
