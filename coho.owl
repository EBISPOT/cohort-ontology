    <!-- http://www.ebi.ac.uk/coho/COHO_0001075 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001075">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>GCST90002227</obo:IAO_0000112>
        <obo:IAO_0000115>A randomised controlled trial at five centres in Finland (Helsinki, Kuopio, Turku, Tampere and Oulu) that from 1993 to 1998 randomised overweight men and women aged 40–64 with impaired glucose tolerance to intensive individual diet and exercise counselling or to a control group, to test whether lifestyle change prevents type 2 diabetes, and whose participants continued to be followed with yearly visits after the trial.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DPS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Finnish Diabetes Prevention Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001075"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90002227</owl:annotatedTarget>
        <dcterms:title>The trans-ancestral genomic architecture of glycemic traits.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34059833</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7610958/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The DPS has been financially supported by grants from the Academy of Finland (117844 and 40758, 211497, and 118590; The EVO funding of the Kuopio University Hospital from Ministry of Health and Social Affairs</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001075"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A randomised controlled trial at five centres in Finland (Helsinki, Kuopio, Turku, Tampere and Oulu) that from 1993 to 1998 randomised overweight men and women aged 40–64 with impaired glucose tolerance to intensive individual diet and exercise counselling or to a control group, to test whether lifestyle change prevents type 2 diabetes, and whose participants continued to be followed with yearly visits after the trial.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20980412</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23555291</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40583490</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
