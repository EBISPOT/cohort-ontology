        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international registry and cohort, funded by the US National Cancer Institute and begun in 1997, of colorectal cancer cases, their unaffected relatives and population-based controls recruited through six centres in Australasia and North America (the Australasian, Mayo Clinic, Ontario, Seattle, University of Hawaii and USC Consortium registries), as a resource for research on familial and sporadic colorectal cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3616155/fullTextXML</obo:IAO_0000119>
