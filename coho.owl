        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7849104/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We used the resources from the PanGenEU case-control study conducted in Spain, Italy, Sweden, Germany, UK, and Ireland, between 2009 and 2014 [17, 18].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000965"/>
