        <obo:IAO_0000112>GCST90269914</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective cohort study of the US National Cancer Institute of people with hemophilia or related congenital coagulation disorders at hemophilia treatment centres: the first Multicenter Hemophilia Cohort Study (MHCS-I), begun in 1982 at 16 centres in the United States and Europe, followed its participants to study the cause and natural history of HIV infection and AIDS, and the second (MHCS-II) invited all HCV-seropositive patients aged 13 or older at 52 participating centres in 2001–2005, to quantify the impact of hepatitis C, hepatitis B and HIV infections.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MHCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Multicenter Hemophilia Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Multicenter Hemophilia Cohort Studies</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001373"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
