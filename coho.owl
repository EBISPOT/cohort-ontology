        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3583865/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The present work was performed in a subcohort (n = 207) of the STORK study, an observational, prospective study on the determinants of fetal growth and birthweight in healthy pregnancies at Oslo University Hospital, Norway.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001258 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001258">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90449022</obo:IAO_0000112>
        <obo:IAO_0000115>A community-based longitudinal study of the disablement process in older Mexican Americans and European Americans in San Antonio, Texas. Its participants, the oldest members (aged 65 and over) of the San Antonio Heart Study cohort, had been randomly sampled from low-, middle- and high-income (barrio, transitional and suburban) neighbourhoods. They had a baseline examination in 1992–1996, combining a home-based assessment with a performance-based assessment at a clinical research center, and three follow-up examinations 18 months apart in 2000–2005.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SALSA</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The San Antonio Longitudinal Study of Aging</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">San Antonio Longitudinal Study of Aging</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90449022</owl:annotatedTarget>
        <dcterms:title>A genome-wide association meta-analysis of all-cause and vascular dementia.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39046104</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11497727/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The San Antonio Longitudinal Study of Aging (SALSA) is a community-based study of the disablement process in older Mexican Americans (MAs) and European Americans (EAs).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001258"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
