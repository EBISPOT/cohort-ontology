    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001607 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001607">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>PMID:28598434</obo:IAO_0000112>
        <obo:IAO_0000115>A kidney cancer study run by Cancer Council Victoria with QIMR Berghofer, the Victorian and Queensland cancer registries and hospitals and familial cancer clinics across Australia; its Queensland arm is called the CARE Study. Its population-based case–control family component recruited, through the Victorian and Queensland cancer registries, people diagnosed in 2009–2015, at age 18–74, with histologically confirmed renal cell carcinoma, with siblings and partners of cases as controls. The study also enrolled people with a strong family history of kidney cancer or a hereditary kidney cancer syndrome. Participants completed questionnaires on health, lifestyle and family and medical history and gave blood, so that lifestyle, environmental and genetic causes of kidney cancer could be investigated.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CARES</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CONFIRM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CONFIRM Kidney Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ConFIRM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Consortium For the Investigation of Renal Malignancies</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>conFIRM</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Consortium for the Investigation of Renal Malignancies</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001607"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28598434</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies multiple risk loci for renal cell carcinoma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28598434</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5472706/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>ConFIRM/MCCS The ConFIRM study, also known as CARES, was supported by the Victorian Cancer Agency (PTCB08_05), the Australian National Health and Medical Research Council (Project Grant 1011626).</rdfs:comment>
    </owl:Axiom>
