        <oboInOwl:hasDbXref>PMID:36602125</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10155195/unicode</oboInOwl:hasDbXref>
