    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001101"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90448709</owl:annotatedTarget>
        <dcterms:title>Chromosome 10q24.32 Variants Associate With Brain Arterial Diameters in Diverse Populations: A Genome-Wide Association Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38038215</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10727334/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The MCS (Memory Clinic in Singapore) study included patients attending the National University Hospital and St Luke&apos;s Hospital memory clinics between 2009 and 2015.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001101"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective observational cohort of older multi-ethnic Asian patients aged 50 or over with no cognitive impairment, mild cognitive impairment or dementia due to Alzheimer&apos;s disease and/or cerebrovascular disease, recruited from 2010 at the memory clinics of the National University Hospital and St Luke&apos;s Hospital in Singapore and assessed by the Memory Aging and Cognition Centre, National University of Singapore, with annual clinical and neuropsychological follow-up for up to five years and brain MRI, retinal and blood biomarker data, to study vascular cognitive impairment and Alzheimer&apos;s disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38038215</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40796328</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41160443</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:41988974</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001101"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
