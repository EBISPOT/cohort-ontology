    <!-- http://www.ebi.ac.uk/coho/COHO_0001159 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001159">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90446233</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based longitudinal cohort of Black and White adults aged 65 and over living in four adjacent neighbourhoods on the south side of Chicago, Illinois, recruited through a door-to-door census from 1993, with later age groups entered as residents turned 65. Participants were followed until 2012 with in-home interviews every three years and clinical evaluation of stratified random samples, to study common chronic conditions of late life, especially risk factors for Alzheimer&apos;s disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CHAP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Chicago Health and Aging Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90446233</owl:annotatedTarget>
        <dcterms:title>Extended genome-wide association study employing the African genome resources panel identifies novel susceptibility loci for Alzheimer&apos;s disease in individuals of African ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38958117</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11350055/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>When not available, other information was used instead, such as age at diagnosis (Chicago Health and Aging Project [CHAP], Minority Aging Research Study/Clinical Minority Core [MARS/CORE]) or age at ascertainment (Indiana University).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001159"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based longitudinal cohort of Black and White adults aged 65 and over living in four adjacent neighbourhoods on the south side of Chicago, Illinois, recruited through a door-to-door census from 1993, with later age groups entered as residents turned 65. Participants were followed until 2012 with in-home interviews every three years and clinical evaluation of stratified random samples, to study common chronic conditions of late life, especially risk factors for Alzheimer&apos;s disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:14646025</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:39641998</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40575494</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
