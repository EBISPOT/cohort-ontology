        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90455651</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of contralateral breast cancer, designed to examine the joint roles of radiation exposure and genetic susceptibility, in which women diagnosed before age 55 with a first primary invasive breast cancer who later developed contralateral breast cancer were individually matched to women with unilateral breast cancer. Participants were identified through population-based cancer registries in the United States, Canada and Denmark and recruited in two phases, WECARE I (2001–2004) and WECARE II (2009–2012).</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>WECARE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>WECARE Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Women&apos;s Environment, Cancer, and Radiation Epidemiology Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Women&apos;s Environmental Cancer and Radiation Epidemiology Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90455651</owl:annotatedTarget>
        <dcterms:title>A genome-wide association study of contralateral breast cancer in the Women&apos;s Environmental Cancer and Radiation Epidemiology Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38263039</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10807183/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We performed a genome-wide association analysis in the Women’s Environmental Cancer and Radiation Epidemiology (WECARE) Study of women with first breast cancer diagnosed at age &lt; 55 years including 1161 with CBC who served as cases and 1668 with unilateral breast cancer (UBC) who served as controls.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001434"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of contralateral breast cancer, designed to examine the joint roles of radiation exposure and genetic susceptibility, in which women diagnosed before age 55 with a first primary invasive breast cancer who later developed contralateral breast cancer were individually matched to women with unilateral breast cancer. Participants were identified through population-based cancer registries in the United States, Canada and Denmark and recruited in two phases, WECARE I (2001–2004) and WECARE II (2009–2012).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:15084244</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:27400983</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
