    <!-- http://www.ebi.ac.uk/coho/COHO_0001470 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001470">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:35383826</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control cohort of people with sporadic early- or late-onset Alzheimer&apos;s disease and elderly controls screened for dementia, recruited from community and hospital settings in the United Kingdom between the early 2000s and 2020 with funding from the Medical Research Council, the Moondance Foundation and Health and Care Research Wales, and assessed with a standardised clinical and neuropsychological protocol. Its longitudinal clinical and cognitive data and blood samples support genome-wide genotyping, plasma biomarker and induced pluripotent stem cell studies of Alzheimer&apos;s disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>AD Cardiff Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ADCC</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Alzheimer&apos;s Disease Cardiff Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001470"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:35383826</owl:annotatedTarget>
        <dcterms:title>Plasma biomarkers and genetics in the diagnosis and prediction of Alzheimer&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35383826</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9924904/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Alzheimer’s Disease Cardiff Cohort (ADCC) was collected between 2004 and 2020 using MRC, Moondance Foundation and Health and Care Research Wales (HCRW) funding.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001470"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case–control cohort of people with sporadic early- or late-onset Alzheimer&apos;s disease and elderly controls screened for dementia, recruited from community and hospital settings in the United Kingdom between the early 2000s and 2020 with funding from the Medical Research Council, the Moondance Foundation and Health and Care Research Wales, and assessed with a standardised clinical and neuropsychological protocol. Its longitudinal clinical and cognitive data and blood samples support genome-wide genotyping, plasma biomarker and induced pluripotent stem cell studies of Alzheimer&apos;s disease.</owl:annotatedTarget>
