        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90129576</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study of breast cancer among women aged 20–74 in central and eastern North Carolina, United States, run from the University of North Carolina, which identifies newly diagnosed cases through rapid case ascertainment with the North Carolina Central Cancer Registry and oversamples Black and younger women. Phases I (1993–1996) and II (1996–2001) in 24 counties were a case-control study with controls drawn from Department of Motor Vehicles and Medicare enrolment records; phase III (2008–2013) enrolled invasive cases in 44 counties and followed them for recurrence, to study the biology, risk factors and outcomes of breast cancer and their differences by race and age.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CBCS also denotes Canadian Breast Cancer Study (COHO:0000899); this term is Carolina Breast Cancer Study.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The acronym NCBCS also denotes North Carolina Bladder Cancer Study (COHO:0001211); this term is Carolina Breast Cancer Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>CBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NCBRCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>North Carolina Breast Cancer Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Carolina Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001210"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90129576</owl:annotatedTarget>
        <dcterms:title>Genome-wide interaction analysis of menopausal hormone therapy use and breast cancer risk among 62,370 women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35418701</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9007944/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Carolina Breast Cancer Study (NCBCS) was funded by Komen Foundation, the National Cancer Institute (P50 CA058223, U54 CA156733, U01 CA179715), and the North Carolina University Cancer Research Fund.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
