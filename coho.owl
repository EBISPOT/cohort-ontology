    <!-- http://www.ebi.ac.uk/coho/COHO_0001429 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001429">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90270131</obo:IAO_0000112>
        <obo:IAO_0000115>A registry of children and adults aged 6 months to 65 years with biopsy-confirmed eosinophilic esophagitis, enrolled at a single visit in 2011–2016 at the five US sites of the NIAID-funded Consortium of Food Allergy Research (in New York, North Carolina, Denver, Little Rock and Baltimore), with medical history questionnaires and blood or saliva samples genotyped at Cincinnati Children&apos;s Hospital Medical Center, to characterise the disease and establish its genetic basis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CoFAR 5</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CoFAR5</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Eosinophilic Esophagitis (EoE) Databank (CoFAR 5)</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Eosinophilic Esophagitis Databank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIH CoFAR EoE cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NIH Consortium of Food Allergy Research (CoFAR) EoE Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>US NIH CoFAR EoE cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>USNIHFAREE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">CoFAR Eosinophilic Esophagitis Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001429"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90270131</owl:annotatedTarget>
        <dcterms:title>Genome-wide admixture and association analysis identifies African ancestry-specific risk loci of eosinophilic esophagitis in African Americans.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36400179</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC10164699/</oboInOwl:hasDbXref>
        <rdfs:comment>The external cohorts were composed of cases from the National Institutes of Health Consortium of Food Allergy Researchers (CoFAR)13, and the Consortium of Eosinophilic Gastrointestinal Disease Researchers (CEGIR)37.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001429"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A registry of children and adults aged 6 months to 65 years with biopsy-confirmed eosinophilic esophagitis, enrolled at a single visit in 2011–2016 at the five US sites of the NIAID-funded Consortium of Food Allergy Research (in New York, North Carolina, Denver, Little Rock and Baltimore), with medical history questionnaires and blood or saliva samples genotyped at Cincinnati Children&apos;s Hospital Medical Center, to characterise the disease and establish its genetic basis.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:30075341</obo:IAO_0000119>
        <obo:IAO_0000119>https://clinicaltrials.gov/api/v2/studies/NCT01323803</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001429"/>
