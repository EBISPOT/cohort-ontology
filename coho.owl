    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000684"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST005840</owl:annotatedTarget>
        <dcterms:title>Multiancestry genome-wide association study of 520,000 subjects identifies 32 loci associated with stroke and stroke subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29531354</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Stroke ascertainment in the Hisayama-FSR study: Ischemic stroke was defined as a sudden non- convulsive, focal neurologic deficit lasting longer than 24 hours due to brain ischemia.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000684"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of ischaemic stroke in Japan combining 1,113 patients with ischaemic stroke recruited in 2004 from seven hospitals in Fukuoka Prefecture (the Fukuoka Stroke Registry) with 901 controls free of stroke and coronary heart disease drawn from the population-based Hisayama Study, used in genome-wide association studies of ischaemic stroke and its subtypes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29531354</obo:IAO_0000119>
        <obo:IAO_0000119>https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</obo:IAO_0000119>
