    <!-- http://www.ebi.ac.uk/coho/COHO_0001492 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001492">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:28159758</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based osteoporosis screening study and longitudinal cohort of women from the Aberdeen area of north-east Scotland, selected at random from Community Health Index (primary care) records within 25 miles of Aberdeen and invited, when aged 45–54, to a baseline health visit with bone density measurement in 1990–1994, with further visits in 1997–1999, when blood was taken for DNA, and in 2007–2011, to study bone loss, osteoporotic fracture risk and falls and their dietary, medical and genetic determinants.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>APOSS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Aberdeen Prospective Osteoporosis Screening Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001492"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:28159758</owl:annotatedTarget>
        <dcterms:title>Longitudinal study of weight, energy intake and physical activity change across two decades in older Scottish women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28159758</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28159758+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>A longitudinal cohort of 5119 perimenopausal women from the Aberdeen Prospective Osteoporosis Screening Study (APOSS) recruited between 1990 and 1994, with follow-up visits at 1997-1999 and 2009-2011.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001492"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
