    <!-- http://www.ebi.ac.uk/coho/COHO_0000512 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000512">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>GCST90239707</obo:IAO_0000112>
        <obo:IAO_0000115>A Danish population-based case-cohort sample established by the Lundbeck Foundation Initiative for Integrative Psychiatric Research (iPSYCH) to study the genetic and environmental architecture of severe mental disorders, combining persons diagnosed with schizophrenia, autism, ADHD or affective disorder with a random sample of the population, genotyped from neonatal dried blood spots in the Danish Neonatal Screening Biobank and linked to national registers. Its first wave (iPSYCH2012, 86,189 individuals born 1981-2005) was expanded as iPSYCH2015 to 141,265 samples, including 50,615 population controls, nested within the Danish population born 1981-2008 and adding schizophrenia spectrum and post-partum disorder cases.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>IPSYCH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Lundbeck Foundation Initiative for Integrative Psychiatric Research</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>iPSYCH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>iPSYCH Danish case-cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>iPSYCH2012</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>iPSYCH2012 case-cohort sample</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>iPSYCH2015</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>iPSYCH2015 case-cohort sample</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">iPSYCH case-cohort study</rdfs:label>
    </owl:NamedIndividual>
