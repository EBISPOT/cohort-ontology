        <obo:IAO_0000112>GCST90448709</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based study of the prevalence and risk factors of cognitive impairment and dementia in Chinese, Malay and Indian adults in Singapore, which drew participants aged 60 and over from the Singapore Epidemiology of Eye Diseases study (the Singapore Chinese Eye Study, 2009–2011, the Singapore Malay Eye Study, 2010–2013, and the Singapore Indian Eye Study, 2013–2015). Participants were screened with the Abbreviated Mental Test and a history of progressive forgetfulness, and those who screened positive were invited for neuropsychological testing and brain MRI.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>EDIS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Epidemiology of Dementia In Singapore</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Epidemiology of Dementia in Singapore Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Epidemiology of Dementia in Singapore study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Epidemiology of Dementia in Singapore</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001078"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
