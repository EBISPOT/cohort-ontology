        <obo:IAO_0000112>GCST90504004</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of colorectal cancer in the United Kingdom that recruited histologically confirmed incident cases aged 45–80, diagnosed in 1997–2000 at hospitals in Dundee, Leeds and York and in 2000–2013 in Leeds only, with controls matched for age and sex from the cases&apos; general practice lists (supplemented after 2000 by friends or spouses of Leeds cases), all interviewed about diet, smoking and other lifestyle factors.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>LCCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK-CCSG</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK-Colorectal Cancer Study Group</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>UK-Leeds Colorectal Cancer Study Group</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Leeds Colorectal Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000596"/>
