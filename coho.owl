        <obo:IAO_0000112>GCST90328131</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of adults aged 18 or older living in the city of Detroit, Michigan, most of them African American, drawn from a random probability sample of the city&apos;s households and interviewed by telephone in annual waves from 2008 to 2013, with blood specimens collected from a subset, to study how biological variation, stressful and traumatic experiences and environmental factors contribute to post-traumatic stress disorder, depression and other psychopathology.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DNHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Detroit Neighborhood Health Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Detroit Neighborhood Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001315"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90328131</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genome-wide association study of major depression aids locus discovery, fine mapping, gene prioritization and causal inference.</dcterms:title>
