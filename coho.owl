    <!-- http://www.ebi.ac.uk/coho/COHO_0001513 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001513">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <obo:IAO_0000112>PMID:33079599</obo:IAO_0000112>
        <obo:IAO_0000115>A registry of people with clinically diagnosed heterozygous familial hypercholesterolaemia in British Columbia, Canada, based at the Healthy Heart Program Prevention Clinic of St. Paul&apos;s Hospital in Vancouver, which enrols clinic patients meeting the Dutch Lipid Clinic Network criteria, invites their relatives for evaluation and follows adult participants prospectively as an open observational cohort. Set up as the first such registry in Canada to improve the identification and management of the condition, it is also used to study its cardiovascular outcomes and genetic causes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BCFH</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>British Columbia Familial Hypercholesterolemia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>British Columbia Familial Hypercholesterolemia cohort</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">British Columbia Familial Hypercholesterolemia Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001513"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
