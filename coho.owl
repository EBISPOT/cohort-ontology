        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/France"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4197385/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were recruited between 2003 and 2005 by local press advertisements or referred by general practitioners from an investigator network of the Inserm Clinical Investigation Center, France[19].</rdfs:comment>
    </owl:Axiom>
    


