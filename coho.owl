    <!-- http://www.ebi.ac.uk/coho/COHO_0001510 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001510">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:32424353</obo:IAO_0000112>
        <obo:IAO_0000115>A UK case-control study of breast cancer, led by investigators at the Institute of Cancer Research and the London School of Hygiene and Tropical Medicine, which in 2001–2008 recruited women with bilateral breast cancer identified through English and Scottish cancer registries and breast cancer clinics, and clinic patients with breast cancer and at least two affected female first-degree relatives, together with controls who were friends or non-blood relatives of the cases. It is one of the studies of the Breast Cancer Association Consortium.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym BBCS also denotes Brescia Bladder Cancer Study (COHO:0000815) and Baltimore Breast Cancer Study (COHO:0001288); this term is British Breast Cancer Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>BBCS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">British Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001510"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:32424353</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study identifies 32 novel breast cancer susceptibility loci from overall and subtype-specific analyses.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32424353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0609-2/MediaObjects/41588_2020_609_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
        <rdfs:comment>British Breast Cancer Study</rdfs:comment>
    </owl:Axiom>
