        <coho:isSubCohortOf rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000065"/>
        <obo:IAO_0000112>GCST90829960</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of 27,548 adults from Potsdam and the surrounding area in eastern Germany, drawn at random from the population registers and recruited in 1994–1998, when the women were 35–64 and the men 40–64 years old; one of the two German centres of the European Prospective Investigation into Cancer and Nutrition (the other is EPIC-Heidelberg), run by the German Institute of Human Nutrition Potsdam-Rehbruecke to study diet, nutritional status and lifestyle in relation to the incidence of cancer and other chronic diseases such as type 2 diabetes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>EPIC-Potsdam</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>EPICPotsdam</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European Investigation into Cancer and Nutrition, Potsdam study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European Prospective Investigation of Cancer-Potsdam</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">European Prospective Investigation into Cancer and Nutrition-Potsdam</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000387"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90829960</owl:annotatedTarget>
        <dcterms:title>Population-based genome-wide association study of plasma complex lipid species.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:42069741</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42069741+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We validate our findings using corresponding data from two other independent cohorts, including FinnGen (n = 7266) and EPIC-Potsdam (n = 1188).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000387"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort of 27,548 adults from Potsdam and the surrounding area in eastern Germany, drawn at random from the population registers and recruited in 1994–1998, when the women were 35–64 and the men 40–64 years old; one of the two German centres of the European Prospective Investigation into Cancer and Nutrition (the other is EPIC-Heidelberg), run by the German Institute of Human Nutrition Potsdam-Rehbruecke to study diet, nutritional status and lifestyle in relation to the incidence of cancer and other chronic diseases such as type 2 diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23043162</obo:IAO_0000119>
