        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001417"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>SUPER-RCC-Nx</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001418 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001418">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <obo:IAO_0000112>GCST90432152</obo:IAO_0000112>
        <obo:IAO_0000115>A prospective, hospital-based longitudinal registry, started in 2019, of consecutive individuals with abdominal aortic aneurysm seen at the vascular and endovascular surgery units of the Hospital de la Santa Creu i Sant Pau and the Hospital del Mar in Barcelona, Spain, with aortic diameter measurements by CT or ultrasound, clinical data and DNA, RNA and plasma samples collected at follow-up visits, to study aneurysm growth and its predictors and to inform surveillance intervals.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>TABS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Triple-A Barcelona Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Triple A Barcelona Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001418"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90432152</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis identifies risk loci for abdominal aortic aneurysm and highlights PCSK9 as a therapeutic target.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37845353</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10632148/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>TABS: The Triple A Barcelona Study (TABS) is a hospital-based study recruiting individuals with AAA treated in the Hospital de la Santa Creu i Sant Pau in Barcelona, Spain.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001418"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A prospective, hospital-based longitudinal registry, started in 2019, of consecutive individuals with abdominal aortic aneurysm seen at the vascular and endovascular surgery units of the Hospital de la Santa Creu i Sant Pau and the Hospital del Mar in Barcelona, Spain, with aortic diameter measurements by CT or ultrasound, clinical data and DNA, RNA and plasma samples collected at follow-up visits, to study aneurysm growth and its predictors and to inform surveillance intervals.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:37845353</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40649094</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
