    <!-- http://www.ebi.ac.uk/coho/COHO_0001603 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001603">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>PMID:21655089</obo:IAO_0000112>
        <obo:IAO_0000115>A Scotland-wide study run from Edinburgh from 1999 that approached patients newly diagnosed with colorectal cancer at age 55 or younger. Research nurses visited them at home to take a family pedigree, give genetic counselling and take blood for genetic testing, to evaluate a strategy for finding families with hereditary non-polyposis colorectal cancer and to study inherited susceptibility to colorectal cancer. Population controls matched by age, sex and area of residence were recruited through the Scottish NHS. Its early-onset cases and controls formed the Scotland1 genome-wide association study of colorectal cancer.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym COGS also denotes Collaborative Oncological Gene-environment Study (COHO:0000731); this term is Colorectal Cancer Genetic Susceptibility Study.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The name Colorectal Cancer Genetics Study also denotes Colorectal Cancer Genetics &amp; Genomics (COHO:0000585); this term is Colorectal Cancer Genetic Susceptibility Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>COGS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Colorectal Cancer Genetics Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Colorectal Cancer Susceptibility Study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Colorectal Cancer Genetic Susceptibility Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001603"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:21655089</owl:annotatedTarget>
        <dcterms:title>Multiple common susceptibility variants near BMP pathway loci GREM1, BMP4, and BMP2 explain part of the missing heritability of colorectal cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:21655089</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3107194/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Scotland1 (COGS) [1] included 980 CRC cases (51% male; mean age at diagnosis 49.6 years, SD±6.1) and 1,002 cancer-free population controls (51% male; mean age 51.0 years; SD±5.9).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001603"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A Scotland-wide study run from Edinburgh from 1999 that approached patients newly diagnosed with colorectal cancer at age 55 or younger. Research nurses visited them at home to take a family pedigree, give genetic counselling and take blood for genetic testing, to evaluate a strategy for finding families with hereditary non-polyposis colorectal cancer and to study inherited susceptibility to colorectal cancer. Population controls matched by age, sex and area of residence were recruited through the Scottish NHS. Its early-onset cases and controls formed the Scotland1 genome-wide association study of colorectal cancer.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:14562005</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:15931596</obo:IAO_0000119>
