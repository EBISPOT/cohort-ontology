        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8144017/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Rotterdam Study (RS) is an ongoing population-based cohort study of risk factors for chronic diseases in the elderly which includes approximately 8,000 participants who live in Rotterdam.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8144017/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The MrOS Sweden cohort consist of three sub-cohorts from three different Swedish cities (n=1,005 in Malmo, n=1,010 in Göteborg, and n=999 in Uppsala).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001450"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8144017/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>ALSPAC recruited pregnant women resident in Avon, UK with expected dates of delivery 1st April 1991 to 31st December 1992.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001451 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001451">
