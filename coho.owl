        <rdfs:comment>EIRA, a case–control study established in 1996, currently contains &gt;5000 incident RA cases from the middle and southern regions of Sweden [18].</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000459 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000459">
