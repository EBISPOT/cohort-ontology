        <rdfs:comment>Subjects were recruited from Mayo Clinic, Universities of Colorado, Michigan, and Pittsburgh, and Temple University.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001203 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001203">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <obo:IAO_0000112>GCST90129576</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of postmenopausal breast cancer in two regions of Germany, Hamburg and Rhine-Neckar-Karlsruhe, which from 2002 to 2005 enrolled women aged 50–74 with incident invasive or in situ breast cancer and population controls frequency-matched to them, interviewed face to face to investigate risk factors, notably menopausal hormone therapy. Its cases were re-interviewed in 2009 and followed for survival and recurrence until 2015 as the MARIE patient cohort.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MARIE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mammary carcinoma Risk factor Investigation</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Mammary Carcinoma Risk Factor Investigation</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001203"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90129576</owl:annotatedTarget>
        <dcterms:title>Genome-wide interaction analysis of menopausal hormone therapy use and breast cancer risk among 62,370 women.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35418701</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9007944/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The MARIE study was supported by the Deutsche Krebshilfe e.V.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001203"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of postmenopausal breast cancer in two regions of Germany, Hamburg and Rhine-Neckar-Karlsruhe, which from 2002 to 2005 enrolled women aged 50–74 with incident invasive or in situ breast cancer and population controls frequency-matched to them, interviewed face to face to investigate risk factors, notably menopausal hormone therapy. Its cases were re-interviewed in 2009 and followed for survival and recurrence until 2015 as the MARIE patient cohort.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18506692</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:31694687</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:37964298</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
