        <oboInOwl:hasRelatedSynonym>The National Cancer Institute Breast and Prostate Cancer Cohort Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">National Cancer Institute Breast and Prostate Cancer Cohort Consortium</rdfs:label>
    </owl:NamedIndividual>
