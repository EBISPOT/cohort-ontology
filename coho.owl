        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Hungary"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/India"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Lithuania"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Malaysia"/>
