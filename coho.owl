        <obo:IAO_0000112>GCST90270269</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of children and adults with sickle cell disease, randomly sampled from the active patients of six care sites in the Brazilian states of Minas Gerais (Belo Horizonte, Juiz de Fora and Montes Claros), Rio de Janeiro, Pernambuco (Recife) and São Paulo and enrolled in 2013–2015 as the Brazilian component of the NHLBI REDS-III programme, with clinical data, a blood biorepository and genome-wide genotyping, to characterise the clinical and transfusion outcomes of sickle cell disease in Brazil and support genotype–phenotype studies.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym REDS-III also denotes Recipient Epidemiology and Donor Evaluation Study-III (COHO:0000472); this term is REDS-III Brazil Sickle Cell Disease Cohort.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>Brazil SCD Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Brazil Sickle Cell Disease Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REDS-III</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REDS-III Brazil SCD Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>REDS-III Brazil SCD cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Recipient Epidemiology and Donor Evaluation Study III Brazil Cohort Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">REDS-III Brazil Sickle Cell Disease Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001397"/>
