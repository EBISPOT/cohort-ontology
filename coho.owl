    <!-- http://www.ebi.ac.uk/coho/COHO_0001211 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001211">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:19706757</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based case-control study of bladder cancer in North Carolina, United States, which enrolled patients with transitional cell carcinoma of the bladder and control patients without cancer (mainly presenting with benign prostatic hypertrophy or impotence), frequency-matched on race, sex and age, at the urology clinics of Duke University Medical Center and the University of North Carolina Hospitals, to study inherited variation in carcinogen-metabolism and DNA-repair genes, smoking and bladder cancer risk.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym NCBCS also denotes Carolina Breast Cancer Study (COHO:0001210); this term is North Carolina Bladder Cancer Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>NCBCS</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">North Carolina Bladder Cancer Study</rdfs:label>
    </owl:NamedIndividual>
