        <obo:IAO_0000112>GCST90301397</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of incident colorectal cancer cases and healthy controls recruited in northern Israel from 1998 to 2017, used to study genetic and environmental risk factors for colorectal cancer and the tumour immune microenvironment.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MECC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
