        <oboInOwl:hasRelatedSynonym>Swedish BioFinder</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Swedish BioFINDER Study</rdfs:label>
