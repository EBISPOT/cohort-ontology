        <dcterms:title>Discovery and systematic characterization of risk variants and genes for coronary artery disease in over a million participants.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36474045</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9729111/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>EPIC-CVD is a case-cohort study nested within the European Prospective Investigation into Cancer and Nutrition (EPIC) cohort (1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001004"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-cohort study nested within the European Prospective Investigation into Cancer and Nutrition, designed to investigate the determinants of cardiovascular disease. EPIC participants with incident coronary heart disease or stroke, identified from 1991 to 2010, are compared with a centre-stratified random subcohort of EPIC participants with stored blood samples, in which molecular factors, including genotypes, are measured.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:29844013</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:34796724</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40099743</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001004"/>
