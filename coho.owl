    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000209">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <obo:IAO_0000112>EGAS00001006707</obo:IAO_0000112>
        <obo:IAO_0000115>An international registry of the American Association for Cancer Research that aggregates clinical-grade tumour sequencing data and clinical outcomes from patients at participating cancer centres to support precision oncology research.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym GENIE also denotes the Gene-Environmental Interaction and phenotype study (COHO:0000186), a Korean health-examination cohort; this term is the AACR cancer sequencing registry, which is what the EGA study EGAS00001006707 tagged GENIE used.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>GENIE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Genomics Evidence Neoplasia Information Exchange</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#EGA_subset"/>
