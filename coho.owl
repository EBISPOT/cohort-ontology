        <oboInOwl:hasRelatedSynonym>Men of African Descent and Carcinoma of the Prostate Network</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Men of African Descent and Carcinoma of the Prostate</rdfs:label>
    </owl:NamedIndividual>
