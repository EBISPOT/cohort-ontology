    <!-- http://www.ebi.ac.uk/coho/COHO_0001311 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001311">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Southern_Africa"/>
        <obo:IAO_0000112>GCST90328131</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based birth cohort run by the University of Cape Town in the Drakenstein area of Paarl, a poor peri-urban community 60 km from Cape Town, South Africa, which enrolled pregnant women at 20–28 weeks&apos; gestation at two primary health clinics (TC Newman and Mbekweni) between March 2012 and March 2015 and follows the mother–child pairs from pregnancy until the children are at least five years old, to investigate early-life determinants of child health, first among them early lower respiratory tract infection, through environmental, infectious, nutritional, genetic, psychosocial, maternal and immunological measures.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DCHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Drakenstein Child Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001311"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90328131</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genome-wide association study of major depression aids locus discovery, fine mapping, gene prioritization and causal inference.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38177345</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10864182/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We had access to individual-level data for Army STARRS, UKB, Women’s Health Initiative (WHI), Intern Health Study (IHS), GERA, Jackson Heart Study (JHS), Drakenstein Child Health Study and the Detroit Neighborhood Health Study.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001311"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based birth cohort run by the University of Cape Town in the Drakenstein area of Paarl, a poor peri-urban community 60 km from Cape Town, South Africa, which enrolled pregnant women at 20–28 weeks&apos; gestation at two primary health clinics (TC Newman and Mbekweni) between March 2012 and March 2015 and follows the mother–child pairs from pregnancy until the children are at least five years old, to investigate early-life determinants of child health, first among them early lower respiratory tract infection, through environmental, infectious, nutritional, genetic, psychosocial, maternal and immunological measures.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25228292</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38177345</obo:IAO_0000119>
