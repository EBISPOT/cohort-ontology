        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001311"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Africa"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5107608/fullTextXML</oboInOwl:hasDbXref>
