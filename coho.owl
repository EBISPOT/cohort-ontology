    <!-- http://www.ebi.ac.uk/coho/COHO_0000904 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000904">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>GCST90101840</obo:IAO_0000112>
        <obo:IAO_0000115>A cohort of clozapine-treated patients with schizophrenia recruited by the Cooperative Research Centre from inpatient and outpatient clinics around Melbourne, Australia, with symptom severity (PANSS) assessments, contributing to genetic studies of clozapine treatment outcome.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CRC also denotes Cardiometabolic Risk in Chinese Study (COHO:0000903); this term is Cooperative Research Centre Cohort.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>CRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CRC Australia</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cooperative Research Centre (CRC) Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Cooperative Research Centre Cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000904"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90101840</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analyses of symptom severity among clozapine-treated patients with schizophrenia spectrum disorders.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35393395</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8989876/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants (N = 804) came from five independent cohorts: 470 participants were recruited by the Clozapine International (CLOZIN) [38–41] consortium in the Netherlands, Germany, Austria, and Finland; 174 participants by the Genetic Risk and Outcome of Psychosis (GROUP) consortium in the Netherlands; 80 participants by the Cooperative Research Centre (CRC) in Australia; 50 participants by Hacettepe University in Turkey; and 30 participants by Mental Health Services Rivierduinen in the Netherlands.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000904"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cohort of clozapine-treated patients with schizophrenia recruited by the Cooperative Research Centre from inpatient and outpatient clinics around Melbourne, Australia, with symptom severity (PANSS) assessments, contributing to genetic studies of clozapine treatment outcome.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:35393395</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000904"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CRC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000904"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Australia"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8989876/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Participants (N = 804) came from five independent cohorts: 470 participants were recruited by the Clozapine International (CLOZIN) [38–41] consortium in the Netherlands, Germany, Austria, and Finland; 174 participants by the Genetic Risk and Outcome of Psychosis (GROUP) consortium in the Netherlands; 80 participants by the Cooperative Research Centre (CRC) in Australia; 50 participants by Hacettepe University in Turkey; and 30 participants by Mental Health Services Rivierduinen in the Netherlands.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000905 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000905">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001142"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001289"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001489"/>
        <obo:IAO_0000112>GCST90012795</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium of cohorts of European and Asian ancestry that pools cohort-level genome-wide association results to study refractive error, myopia and ocular biometric traits such as axial length and corneal curvature.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>CREAM</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Consortium for Refractive Error and Myopia</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000905"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90012795</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analysis of corneal curvature identifies novel loci and shared genetic influences across axial length and refractive error.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32193507</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7081241/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Thus, we conducted the largest GWAS meta-analysis of CC to date, incorporating both European and Asian cohorts in a single analysis from the Consortium for Refractive Error and Myopia (CREAM) and validated our findings in the United Kingdom (UK) Biobank.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000905"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium of cohorts of European and Asian ancestry that pools cohort-level genome-wide association results to study refractive error, myopia and ocular biometric traits such as axial length and corneal curvature.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32193507</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000905"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>CREAM</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000905"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001142"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Fourteen population-based CREAM cohorts that had exome chip genotypes on individuals with refractive error measurements were used in this study. These 14 cohorts were: Singapore Chinese Eye Study (SCES), Singapore Malay Eye Study (SiMES), Singapore Indian Eye Study (SINDI), Age Related Eye Study (AREDS)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000905"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001289"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Fourteen population-based CREAM cohorts that had exome chip genotypes on individuals with refractive error measurements were used in this study. These 14 cohorts were: Singapore Chinese Eye Study (SCES), Singapore Malay Eye Study (SiMES), Singapore Indian Eye Study (SINDI), Age Related Eye Study (AREDS), Rotterdam Study I (RSI), Erasmus Rucphen Family (ERF), Raine Eye Health Study (REHS) of the Raine Study, Beaver Dam Eye Study (BDES), Estonian Genome Center for the University of Tartu (EGCUT), Finnish Twin Study on Aging (FITSA), Ogliastra, Croatia-Korcula, TwinsUK, and EPIC-Norfolk.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000905"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/hasCohort"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001489"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4551475/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The CREAM meta-analysis included data from 32 studies: 1958 British Birth Cohort, ALSPAC (mothers), ANZRAG, AREDS1a1b, AREDS1c, Beijing Eye Study, BMES, CROATIA-Korcula, CROATIA-Split, CROATIA-Vis, DCCT, EGCUT, ERF, FECD, FITSA, Framingham, GHS 1, GHS 2, KORA, OGP Talana, ORCADES, RS1, RS2, RS3, SCES, SIMES, SINDI, SP2, TEST/BATS, TwinsUK, WESDR, and YFS.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000906 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000906">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>GCST90428625</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based cohort study in Doetinchem, the Netherlands, started by the Dutch National Institute for Public Health and the Environment (RIVM) as a monitoring study of cardiovascular risk factors, in which 12,404 inhabitants aged 20–59, drawn as an age- and sex-stratified sample of the population register, were examined in 1987–1991 and two-thirds of them were re-invited to repeated rounds, to study lifestyle and other determinants of health, functioning and chronic disease over the life course.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym DCS also denotes Hoorn Diabetes Care System (COHO:0000092); this term is Doetinchem Cohort Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>DCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Doetinchem</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Doetinchem Cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Doetinchem Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000906"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90428625</owl:annotatedTarget>
        <dcterms:title>Circulating anti-Müllerian hormone levels in pre-menopausal women: novel genetic insights from a genome-wide association meta-analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38815977</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11759094/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>cardiovascular disease in women: results from the Doetinchem Cohort</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000906"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based cohort study in Doetinchem, the Netherlands, started by the Dutch National Institute for Public Health and the Environment (RIVM) as a monitoring study of cardiovascular risk factors, in which 12,404 inhabitants aged 20–59, drawn as an age- and sex-stratified sample of the population register, were examined in 1987–1991 and two-thirds of them were re-invited to repeated rounds, to study lifestyle and other determinants of health, functioning and chronic disease over the life course.</owl:annotatedTarget>
        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML</obo:IAO_0000119>
