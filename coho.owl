        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001185"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Korea"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7057957/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Included in this project were 3,387 female breast 94 cancer cases, who were newly diagnosed between April 2004 and February 2013 at 95 Chonnam National University Hwasun Hospital, a cancer specified hospital in 96 Jeollanam-do province, South Korea.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001186 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001186">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>GCST90002310</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional population-based study of the Research Centre for Prevention and Health in Glostrup, Denmark, conducted in 2008–2009 on a random sample of men and women aged 30–60, drawn from the Danish Central Personal Register, living in the western part of the Copenhagen area; pregnant women and people with known diabetes, cardiovascular disease, chronic obstructive pulmonary disease, hypertension or a history of blood clots, or unable to do physical activities such as climbing stairs, were excluded. The examination included questionnaires, clinical and biochemical measurements, an oral glucose tolerance test and two tests estimating maximal oxygen uptake.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Health 2008 study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Health2008</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Health2008 cohort</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Health2008 Study</rdfs:label>
    </owl:NamedIndividual>
