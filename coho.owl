        <obo:IAO_0000112>GCST90454541</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control genetic association study of COVID-19 severity in Iran, based at Shariati Hospital, Tehran University of Medical Sciences. It genotyped people of Middle Eastern ancestry hospitalised with COVID-19, and controls, on the Illumina Global Screening Array, and contributed them to the COVID-19 Host Genetics Initiative&apos;s meta-analyses of COVID-19 severity and of long COVID.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>IrCovid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>IranCovid</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genome-wide assessment of the gene variants associated with severe COVID-19 phenotype in Iran</rdfs:label>
    </owl:NamedIndividual>
