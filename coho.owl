    <!-- http://www.ebi.ac.uk/coho/COHO_0001259 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001259">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90013445</obo:IAO_0000112>
        <obo:IAO_0000115>A collection of people with type 1 diabetes from Northern Ireland, most of them diagnosed in childhood. It is analysed separately from the Genetic Resource Investigating Diabetes (GRID) cases of Great Britain, and its DNA was genotyped on the ImmunoChip at the University of Virginia under the Type 1 Diabetes Genetics Consortium grant for genetic studies of type 1 diabetes.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GRID-NI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NI GRID</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Northern Irish GRID</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Northern Ireland GRID Collection</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001259"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90013445</owl:annotatedTarget>
        <dcterms:title>Fine-mapping, trans-ancestral and genomic analyses identify causal variants, cells, genes and drug targets for type 1 diabetes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34127860</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8273124/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>These studies include the Type 1 Diabetes Genetics Consortium (T1DGC), British 1958 Birth Cohort, Genetic Resource Investigating Diabetes (GRID), Consortium for the Longitudinal Evaluation of African-Americans with Early Rheumatoid Arthritis (CLEAR), Epidemiology of Diabetes Interventions and Complications (EDIC), Genetics of Kidneys and Diabetes Study (GoKinD), New York Cancer Project (NYCP), SEARCH for Diabetes in Youth study (SEARCH), Type 1 Diabetes TrialNet study (TrialNet), Tyypin 1 Diabetekseen Sairastuneita Perheenjäsenineen (IDDMGEN), Tyypin 1 Diabeteksen Genetiikka (T1DGEN), Northern Ireland GRID Collection, Northern Ireland Young Hearts Project, Hvidoere Study Group on Childhood Diabetes (HSG), and International HapMap Project.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001259"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A collection of people with type 1 diabetes from Northern Ireland, most of them diagnosed in childhood. It is analysed separately from the Genetic Resource Investigating Diabetes (GRID) cases of Great Britain, and its DNA was genotyped on the ImmunoChip at the University of Virginia under the Type 1 Diabetes Genetics Consortium grant for genetic studies of type 1 diabetes.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28983737</obo:IAO_0000119>
