        <obo:IAO_0000112>PMID:41795035</obo:IAO_0000112>
        <obo:IAO_0000115>A case–control collection of children with type 1 diabetes and controls from multiple paediatric centres in China, used to validate polygenic risk scores for type 1 diabetes in an East Asian population.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym GRACE also denotes Global Registry of Acute Coronary Events (COHO:0000192); this term is Genetic Risk Assessment for Chinese Eaglet-T1D.</obo:IAO_0000116>
        <obo:IAO_0000116 xml:lang="en">The acronym GRACE resembles GR@ACE, which denotes Genome Research at Fundació ACE (COHO:0000258); this term is Genetic Risk Assessment for Chinese Eaglet-T1D.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>GRACE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GRACE-T1D</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Genetic Risk Assessment for Chinese Eaglet-T1D</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000462"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:41795035</owl:annotatedTarget>
        <dcterms:title>Development and validation of a trans-ancestry polygenic risk score for type 1 diabetes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41795035</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13109230/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Ncontrols=427,069) and in a Chinese case–control cohort across multiple paediatric centres named Genetic Risk Assessment for Chinese Eaglet-T1D (GRACE, N=597;</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000462"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
