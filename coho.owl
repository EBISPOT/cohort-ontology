        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000562"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A community-based birth cohort of about 3,000 singletons born in 1983-1984 in Cebu, Philippines, and their mothers, enrolled in pregnancy and followed with bimonthly surveys for two years and repeated follow-up surveys to age 35, run by the Office of Population Studies of the University of San Carlos and the University of North Carolina to study the long-term effects of early nutrition and life conditions on health.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18426866</obo:IAO_0000119>
