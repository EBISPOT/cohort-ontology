        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90504004</owl:annotatedTarget>
        <dcterms:title>Genome-wide interaction study of dietary intake of fibre, fruits, and vegetables with risk of colorectal cancer.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38749303</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11112268/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>ASTERISK: We are very grateful to those without whom this project would not have existed.</rdfs:comment>
