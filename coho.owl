    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001116"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST005843</owl:annotatedTarget>
        <dcterms:title>Multiancestry genome-wide association study of 520,000 subjects identifies 32 loci associated with stroke and stroke subtypes.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:29531354</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Asian Indian Diabetic Heart Study/Sikh Diabetes Study (AIDHS/SDS) is a case-control study designed to investigate the association between genetic and environmental factors and their risk on type 2 diabetes (T2D) and cardiovascular disease in a population of Punjabi ancestry from India.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
