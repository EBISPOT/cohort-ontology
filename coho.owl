        <rdfs:comment>In the nationwide French MEMENTO cohort study, participants were recruited in memory clinics and screened for either isolated subjective cognitive complaints (SCCs) or mild cognitive impairment (MCI;</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000786 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000786">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
