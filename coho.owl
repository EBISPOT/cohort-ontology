    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001017"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A group of six genome-wide association case-control studies of spontaneous intracerebral haemorrhage in people of European ancestry, meta-analysed under the auspices of the International Stroke Genetics Consortium to find susceptibility loci for lobar and nonlobar haemorrhage. It comprises the multicentre Genetics of Cerebral Hemorrhage with Anticoagulation study in the United States, the Genetic and Environmental Risk Factors for Hemorrhagic Stroke studies I and II in Cincinnati, and four European studies in Barcelona, Krakow and Lund.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:24656865</obo:IAO_0000119>
