    <!-- http://www.ebi.ac.uk/coho/COHO_0001144 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001144">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/South_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Southern_Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Uganda"/>
        <obo:IAO_0000112>GCST90399578</obo:IAO_0000112>
        <obo:IAO_0000115>A study of kidney function in adults with and without chronic kidney disease in sub-Saharan Africa, run by the African Research on Kidney Disease collaboration within existing population cohorts in Malawi (Karonga and Lilongwe), South Africa (the Agincourt health and demographic surveillance site) and Uganda (the General Population Cohort). It measured glomerular filtration rate by iohexol plasma clearance to test equations for estimating it, with serial biobanking, cross-sectionally in Malawi and Uganda and longitudinally in South Africa.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ARK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>African Research Kidney Disease study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>African Research into Kidney Diseases</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>African Research on Kidney Disease Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">African Research on Kidney Disease</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001144"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90399578</owl:annotatedTarget>
        <dcterms:title>Genetic association and transferability for urinary albumin-creatinine ratio as a marker of kidney disease in four Sub-Saharan African populations and non-continental individuals of African ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38812969</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11134365/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The African Research Kidney Disease (ARK) study is a well characterised population-based cohort study of 2021 adults (20–80 years) of self-identified black ethnicity from Agincourt, (Mpumalanga, South Africa) with demographic data, health-related questionnaire data, and anthropometric measurements collected at enrolment (Fabian et al., 2022).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001144"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A study of kidney function in adults with and without chronic kidney disease in sub-Saharan Africa, run by the African Research on Kidney Disease collaboration within existing population cohorts in Malawi (Karonga and Lilongwe), South Africa (the Agincourt health and demographic surveillance site) and Uganda (the General Population Cohort). It measured glomerular filtration rate by iohexol plasma clearance to test equations for estimating it, with serial biobanking, cross-sectionally in Malawi and Uganda and longitudinally in South Africa.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31941441</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:35839814</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001144"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>ARK</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001144"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/South_Africa"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11134365/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The African Research Kidney Disease (ARK) study is a well characterised population-based cohort study of 2021 adults (20–80 years) of self-identified black ethnicity from Agincourt, (Mpumalanga, South Africa) with demographic data, health-related questionnaire data, and anthropometric measurements collected at enrolment (Fabian et al., 2022).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001144"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Uganda"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35839814+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>We measured serum creatinine, cystatin C, and glomerular filtration rate (GFR) using the slope-intercept method for iohexol plasma clearance (mGFR) in population cohorts from Malawi, Uganda, and South Africa.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001145 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001145">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
