    <!-- http://www.ebi.ac.uk/coho/COHO_0001235 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001235">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <obo:IAO_0000112>GCST90269914</obo:IAO_0000112>
        <obo:IAO_0000115>A nationwide prospective longitudinal cohort of people with HIV aged 16 or older in Switzerland, established in 1988 as a collaboration of the Swiss university hospitals, large cantonal hospitals, affiliated smaller hospitals and private physicians, who recruit and follow the participants, to improve the health of people with HIV through clinical, translational and basic research.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SHCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Swiss HIV Cohort Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001235"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90269914</owl:annotatedTarget>
        <dcterms:title>Africa-specific human genetic variation near CHD1L associates with HIV-1 load.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37532928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10848312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Swiss HIV Cohort Study (SHCS) is an ongoing multicentre research project dealing with adults infected with HIV aged 16 years or older residing in Switzerland.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001235"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
