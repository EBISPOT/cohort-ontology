        <owl:annotatedTarget>GCST90301252</owl:annotatedTarget>
        <dcterms:title>A genome-wide association meta-analysis implicates Hedgehog and Notch signaling in Dupuytren&apos;s disease.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38172110</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10764787/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>This study (‘The role of genetic variants in Dupuytren disease’) has Lifelines study ID OV18_0461; (3) The British Society for Surgery of the Hand Genetics of Dupuytren’s Disease (BSSH-GODD) study (United Kingdom) was approved by the Oxfordshire Research Ethics Committee, document number B/09/H0605/65; (4) The UK Biobank (United Kingdom) was approved by the North West Multi-Centre Research Ethics Committee, document number 11/NW/0382.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001293"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A UK collection of adults with Dupuytren&apos;s disease who had been treated surgically for it. Saliva samples for DNA, and diseased palmar fascia removed at surgery, were collected by the British Society for Surgery of the Hand Genetics of Dupuytren&apos;s Disease (BSSH-GODD) consortium for genetic studies of the disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28886342</obo:IAO_0000119>
