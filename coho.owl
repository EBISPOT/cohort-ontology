    <!-- http://www.ebi.ac.uk/coho/COHO_0001547 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001547">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:21203820</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case-control study of bladder cancer in the Belgian province of Limburg, whose cases are people with histologically confirmed incident transitional cell carcinoma of the bladder diagnosed between 1999 and 2004, identified through the Limburg Cancer Registry and invited by their urologists and general practitioners, and whose controls are inhabitants of the province aged 50 or over sampled at random through the Crossroads Bank of Social Security, stratified by municipality and socioeconomic status; it was used to study occupational, dietary and genetic risk factors for bladder cancer.</obo:IAO_0000115>
