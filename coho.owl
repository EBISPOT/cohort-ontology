        <obo:IAO_0000115>A registry of stroke patients at the Carlo Besta Neurological Institute (Fondazione IRCCS Istituto Neurologico Carlo Besta), Milan, Italy, including consecutive Italian patients with stroke referred to the institute from 2000 to 2009, funded by the Italian Ministry of Health; its imaging-confirmed ischaemic stroke cases, subtyped by stroke neurologists with the TOAST criteria, were genotyped and studied with Italian PROCARDIS participants as controls in genome-wide association studies of stroke.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Besta Stroke Register</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CEDIR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cerebrovascular Diseases Registry</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Besta Cerebrovascular Diseases Registry</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001582"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:23041239</owl:annotatedTarget>
        <dcterms:title>Genetic risk factors for ischaemic stroke and its subtypes (the METASTROKE collaboration): a meta-analysis of genome-wide association studies.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:23041239</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3490334/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>This study Includes consecutive Italian patients referred to Besta Institute from 2000 to 2009 with stroke and included in the Besta Cerebrovascular Diseases Registry (CEDIR).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001582"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A registry of stroke patients at the Carlo Besta Neurological Institute (Fondazione IRCCS Istituto Neurologico Carlo Besta), Milan, Italy, including consecutive Italian patients with stroke referred to the institute from 2000 to 2009, funded by the Italian Ministry of Health; its imaging-confirmed ischaemic stroke cases, subtyped by stroke neurologists with the TOAST criteria, were genotyped and studied with Italian PROCARDIS participants as controls in genome-wide association studies of stroke.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:23041239</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23381943</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001582"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
