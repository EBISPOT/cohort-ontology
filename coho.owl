    <!-- http://www.ebi.ac.uk/coho/COHO_0001576 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001576">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>PMID:39603580</obo:IAO_0000112>
        <obo:IAO_0000115>A single-centre prospective cohort and sample repository of consecutive adults undergoing elective diagnostic coronary angiography or elective cardiac computed tomographic angiography at the Cleveland Clinic, Cleveland, Ohio, United States, enrolled from 2001 to 2007 with blood samples, extensive clinical and laboratory characterisation and adjudicated follow-up for death, myocardial infarction and stroke, set up to study the genetic and molecular determinants of coronary artery disease.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym CCGB also denotes Cleveland Clinic FMD Biorepository (COHO:0001577); this term is Cleveland Clinic GeneBank Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>CCGB</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>CCGB_2</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cleveland Clinic Gene Bank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cleveland Clinic GeneBank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cleveland Clinic GeneBank study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Cleveland Clinic Genebank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GATC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GeneBank</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GeneBank Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GeneBank at the Cleveland Clinic: Molecular Determinants of Coronary Artery Disease</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Cleveland Clinic GeneBank Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001576"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:39603580</owl:annotatedTarget>
        <dcterms:title>Abbreviated Duke Activity Status Index for Risk Stratification in Heart Failure.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39603580</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39603580+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Leveraging the Cleveland Clinic GeneBank Study, we developed an abbreviated DASI questionnaire (aDASI) with the machine learning XGBoost algorithm, with the goal of maintaining the accuracy and reliability of the original DASI.</rdfs:comment>
    </owl:Axiom>
