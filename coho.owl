        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001329"/>
        <obo:IAO_0000112>PMID:27598322</obo:IAO_0000112>
        <obo:IAO_0000115>A network of cancer genetic epidemiology consortia, the NIH-funded post-cancer-GWAS initiative, that brings together genome-wide association data from colorectal (CORECT), breast (DRIVE), prostate (ELLIPSE), ovarian (FOCI) and lung (TRICL) cancer consortia, mainly of people of European descent.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GAME-ON</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GAME-ON consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Post-Cancer GWAS initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Genetic Associations and Mechanisms in Oncology</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Genetic Associations and Mechanisms in Oncology</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000774"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:27598322</owl:annotatedTarget>
        <dcterms:title>Association between Adult Height and Risk of Colorectal, Lung, and Prostate Cancer: Results from Meta-analyses of Prospective Studies and Mendelian Randomization Analyses.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:27598322</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5012582/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Additionally, we carried out Mendelian randomization analyses utilizing GWAS summary statistics from the Genetic Associations and Mechanisms in Oncology (GAME-ON) and Genetic Investigation of Anthropometric Traits (GIANT) consortia studies of individuals of European descent.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000774"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
