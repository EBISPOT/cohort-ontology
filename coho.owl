    <!-- http://www.ebi.ac.uk/coho/COHO_0001608 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001608">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:3738950</obo:IAO_0000112>
        <obo:IAO_0000115>A nationwide Danish hospital register, established in 1977 from the hospital discharge records that Denmark&apos;s counties were asked to submit and now kept by the Danish Health Data Authority, that records every patient discharged from Danish non-psychiatric hospitals since 1977 and psychiatric inpatients and emergency-department and outpatient specialty-clinic contacts since 1995, with diagnoses, examinations, treatments and surgical procedures. Kept primarily to monitor hospital use for health-care planning, it is also used, through linkage by personal identification number, for disease monitoring, quality assurance and research.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>DNPR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Danish National Hospital Register</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Danish National Patient Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Danish National Registry of Patients</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>LPR</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Landspatientregisteret</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Danish National Patient Register</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001608"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:3738950</owl:annotatedTarget>
        <dcterms:title>Cerebral thromboembolism among young women and men in Denmark 1977-1982.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:3738950</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A3738950+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In the period 1977-1982, the Danish National Patient Register recorded 1000 cases of cerebral thromboembolic attacks among women 15-44 years of age, and 971 cases among men of the same age.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001608"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nationwide Danish hospital register, established in 1977 from the hospital discharge records that Denmark&apos;s counties were asked to submit and now kept by the Danish Health Data Authority, that records every patient discharged from Danish non-psychiatric hospitals since 1977 and psychiatric inpatients and emergency-department and outpatient specialty-clinic contacts since 1995, with diagnoses, examinations, treatments and surgical procedures. Kept primarily to monitor hospital use for health-care planning, it is also used, through linkage by personal identification number, for disease monitoring, quality assurance and research.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:26604824</obo:IAO_0000119>
        <obo:IAO_0000119>https://english.sundhedsdatastyrelsen.dk/health-data-and-registers/national-health-registers</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001608"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>DNPR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001608"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>LPR</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
