        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000440"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90128543</owl:annotatedTarget>
