        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Eastern_Asia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Japan"/>
        <obo:IAO_0000112>PMID:34897183</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium of Japanese population-based and hospital-based studies — the Tohoku Medical Megabank Community-Based Cohort Study, the Japan Public Health Center-based Prospective Study, the Japan Multi-Institutional Collaborative Cohort Study and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center — that pools genome-wide genotype data on healthy participants for genetic epidemiology, including genome-wide association studies of body mass index, height and weight.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>J-CGE</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Japanese Consortium of Genetic Epidemiology</oboInOwl:hasRelatedSynonym>
