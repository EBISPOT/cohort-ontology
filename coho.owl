        <obo:IAO_0000112>GCST90104085</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control sample of people with Parkinson&apos;s disease, diagnosed by modified UK Brain Bank criteria, and neurologically healthy controls (community volunteers and patients&apos; spouses), recruited by the NeuroGenetics Research Consortium at affiliated neurology and movement disorder clinics in Oregon, Washington, Georgia and New York, United States, with uniform, standardised methods for diagnosis, subject selection, data collection and DNA preparation, for genetic and gene-environment studies of Parkinson&apos;s disease, and genotyped genome-wide.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>NGRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">NeuroGenetics Research Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001108"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90104085</owl:annotatedTarget>
        <dcterms:title>Common X-Chromosome Variants Are Associated with Parkinson Disease Risk.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33583074</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8601399/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The PD cohorts include the International PD Genomics Consortium (IPDGC) NeuroX dataset, the National Institute of Neurological Disorders and Stroke (NINDS) PD dataset, the Autopsy-Confirmed PD GWAS Consortium (APDGC) dataset genotyped by the Center for Inherited Disease Research, the NeuroGenetics Research Consortium (NGRC) dataset, the UK PD Consortium, and the Wellcome Trust Case Control Consortium 2, referred to here as EBI MERGE.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001108"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control sample of people with Parkinson&apos;s disease, diagnosed by modified UK Brain Bank criteria, and neurologically healthy controls (community volunteers and patients&apos; spouses), recruited by the NeuroGenetics Research Consortium at affiliated neurology and movement disorder clinics in Oregon, Washington, Georgia and New York, United States, with uniform, standardised methods for diagnosis, subject selection, data collection and DNA preparation, for genetic and gene-environment studies of Parkinson&apos;s disease, and genotyped genome-wide.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20711177</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:32566740</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
