        <obo:IAO_0000112>GCST90840657</obo:IAO_0000112>
        <obo:IAO_0000115>A volunteer-based cohort of about 1,000 adults from the self-contained population of Sorbs in eastern Germany, recruited and extensively metabolically phenotyped by the University of Leipzig in 2005–2007 for genome-wide studies of metabolic, anthropometric and other quantitative traits.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SORBS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sorbs cohort</oboInOwl:hasRelatedSynonym>
