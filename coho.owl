        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90102434</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre randomised controlled trial that recruited hypertensive men and women aged 40–79 with at least three other cardiovascular risk factors, mostly through family practices in the United Kingdom, Ireland and the Nordic countries between February 1998 and May 2000, to compare an amlodipine-based with an atenolol-based antihypertensive regimen for preventing coronary and other cardiovascular events (the Blood Pressure-Lowering Arm), those with total cholesterol of 6.5 mmol/L or less being also randomised to atorvastatin or placebo in a factorial Lipid-Lowering Arm.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>ASCOT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Anglo Scandinavian Cardiac Outcomes Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Anglo-Scandinavian cardiac Outcomes Trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Anglo-Scandinavian Cardiac Outcomes Trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001282"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90102434</owl:annotatedTarget>
        <dcterms:title>The Pharmacogenetics of Statin Therapy on Clinical Events: No Evidence that Genetic Variation Affects Statin Response on Myocardial Infarction.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35069183</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8769168/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Anglo-Scandinavian Cardiac Outcomes Trial (ASCOT) trial was funded by an investigator-initiated grant from Pfizer USA.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001282"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre randomised controlled trial that recruited hypertensive men and women aged 40–79 with at least three other cardiovascular risk factors, mostly through family practices in the United Kingdom, Ireland and the Nordic countries between February 1998 and May 2000, to compare an amlodipine-based with an atenolol-based antihypertensive regimen for preventing coronary and other cardiovascular events (the Blood Pressure-Lowering Arm), those with total cholesterol of 6.5 mmol/L or less being also randomised to atorvastatin or placebo in a factorial Lipid-Lowering Arm.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:38291599</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40139683</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
