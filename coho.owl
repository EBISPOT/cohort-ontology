    <!-- http://www.ebi.ac.uk/coho/COHO_0001457 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001457">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Denmark"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <obo:IAO_0000112>PMID:33623038</obo:IAO_0000112>
        <obo:IAO_0000115>A hospital-based, retrospective case-control study of prostate cancer at Aarhus University Hospital, Denmark, whose cases are men treated for prostate adenocarcinoma at the hospital&apos;s Department of Urology in Skejby and whose controls are age-matched men treated for myocardial infarction or undergoing coronary angioplasty with no prostate cancer diagnosis in the Danish Cancer Register or the Danish Cause of Death Register. It is one of the studies of the PRACTICAL consortium and was genotyped in the consortium&apos;s prostate cancer OncoArray project.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Aarhus</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Aarhus Prostate Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001457"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:33623038</owl:annotatedTarget>
        <dcterms:title>Polygenic hazard score is associated with prostate cancer in multi-ethnic populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:33623038</oboInOwl:hasDbXref>
