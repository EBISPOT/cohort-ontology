    <!-- http://www.ebi.ac.uk/coho/COHO_0000810 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000810">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90012825</obo:IAO_0000112>
        <obo:IAO_0000115>A longitudinal, epidemiologic clinical-pathologic cohort study of common chronic conditions of ageing run by the Rush Alzheimer&apos;s Disease Center, which since 1997 has enrolled older lay persons without dementia, mainly from retirement communities across northeastern Illinois, who agree to annual clinical evaluations and organ donation, with an emphasis on decline in cognitive and motor function and risk of Alzheimer&apos;s disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MAP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Memory and Aging Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Rush Memory and Aging Project</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000810"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90012825</owl:annotatedTarget>
        <dcterms:title>Susceptibility to neurofibrillary tangles: role of the PTPRD locus and limited pleiotropy with other neuropathologies.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:28322283</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5608624/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The subjects consisted of participants from two longitudinal cohort studies operated out of The Rush Alzheimer’s Disease Center in Chicago, the Religious Order Study (ROS) and the Rush Memory and Aging Project (MAP).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
