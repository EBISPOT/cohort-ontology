    <!-- http://www.ebi.ac.uk/coho/COHO_0001324 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001324">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <obo:IAO_0000112>GCST90026612</obo:IAO_0000112>
        <obo:IAO_0000115>A registry of patients with fibromuscular dysplasia, launched in December 2015 at the First Brussels National Meeting on FMD and endorsed by the European Society of Hypertension in 2016, that enrols prevalent and incident adult patients whose multifocal or focal FMD lesions in at least one arterial bed were shown by CT angiography, MR angiography or catheter angiography, at centres in Europe and a few other countries, recording their clinical characteristics, imaging, visits and vascular interventions on an online platform with an associated DNA and RNA biobank, to characterise the clinical profiles, complications and management of the disease. It also takes in data from existing national registries such as the French NOMADE and Polish ARCADIA-POL registries.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>European/International FMD Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European/International FMD Registry and Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>European/International Fibromuscular Dysplasia Registry</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FEIRI</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>FMD European/International Registry and Initiative</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">European/International Fibromuscular Dysplasia Registry and Initiative</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001324"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90026612</owl:annotatedTarget>
        <dcterms:title>Genetic investigation of fibromuscular dysplasia identifies risk loci and shared genetics with common cardiovascular diseases.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34654805</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8521585/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients were enroled through the European/International FMD Registry and Initiative (FEIRI)7.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001324"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A registry of patients with fibromuscular dysplasia, launched in December 2015 at the First Brussels National Meeting on FMD and endorsed by the European Society of Hypertension in 2016, that enrols prevalent and incident adult patients whose multifocal or focal FMD lesions in at least one arterial bed were shown by CT angiography, MR angiography or catheter angiography, at centres in Europe and a few other countries, recording their clinical characteristics, imaging, visits and vascular interventions on an online platform with an associated DNA and RNA biobank, to characterise the clinical profiles, complications and management of the disease. It also takes in data from existing national registries such as the French NOMADE and Polish ARCADIA-POL registries.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:32282921</obo:IAO_0000119>
        <obo:IAO_0000119>https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001324"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>FEIRI</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
