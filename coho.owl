        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetic and Environmental Risk Factors for Alzheimer&apos;s Disease Among African Americans Study</rdfs:label>
    </owl:NamedIndividual>
