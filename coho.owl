    <!-- http://www.ebi.ac.uk/coho/COHO_0001529 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001529">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Brazil"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/SouthAmerica"/>
        <obo:IAO_0000112>PMID:30787307</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based study of asthma and schistosomiasis in five rural communities of the district of Conde, Bahia, north-eastern Brazil, an area endemic for Schistosoma mansoni about 200 km north of Salvador, in which residents aged 5 to 85, most of them members of two large pedigrees, were enrolled by whole-population ascertainment from July to September 2004 by the Federal University of Bahia and Johns Hopkins University, with later follow-up visits, to study the genetic control of total serum IgE, S. mansoni infection intensity and asthma; it is one of the studies of the Consortium on Asthma among African-ancestry Populations in the Americas (CAAPA).</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BIAS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Brazilian Immunogenetics of Asthma &amp; Schistosomiasis study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Brazilian Immunogenetics of Asthma and Schistosomiasis study</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Brazilian Immunogenetics of Asthma and Schistosomiasis</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001529"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>PMID:30787307</owl:annotatedTarget>
        <dcterms:title>Association study in African-admixed populations across the Americas recapitulates asthma risk loci in non-African populations.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:30787307</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>The Brazilian Immunogenetics of Asthma and Schistosomiasis (BIAS) study is a whole-population ascertainment designed study of asthma and schistosomiasis in the rural district of Conde, Bahia, located 200 km north of Salvador, Brazil [14-16].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001529"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A family-based study of asthma and schistosomiasis in five rural communities of the district of Conde, Bahia, north-eastern Brazil, an area endemic for Schistosoma mansoni about 200 km north of Salvador, in which residents aged 5 to 85, most of them members of two large pedigrees, were enrolled by whole-population ascertainment from July to September 2004 by the Federal University of Bahia and Johns Hopkins University, with later follow-up visits, to study the genetic control of total serum IgE, S. mansoni infection intensity and asthma; it is one of the studies of the Consortium on Asthma among African-ancestry Populations in the Americas (CAAPA).</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:18717640</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:22574126</obo:IAO_0000119>
