        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-026-73509-y/MediaObjects/41467_2026_73509_MOESM3_ESM.xlsx</oboInOwl:hasDbXref>
