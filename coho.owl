    <!-- http://www.ebi.ac.uk/coho/COHO_0001332 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001332">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
