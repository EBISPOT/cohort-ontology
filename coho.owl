        <obo:IAO_0000112>GCST90454200</obo:IAO_0000112>
        <obo:IAO_0000115>A normative craniofacial study begun in 2009 as part of the FaceBase Consortium of the US National Institute of Dental and Craniofacial Research, which recruited healthy people aged 3 to 40 of self-reported European ancestry and without craniofacial conditions at four US sites (Pittsburgh, Seattle, Houston and Iowa City), collecting 3D facial surface images, anthropometric measurements, a demographic questionnaire and saliva DNA for genome-wide genotyping, and shares the data through a web-based repository.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>3D Facial Norms</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3D Facial Norms Database</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3D Facial Norms Dataset</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3D Facial Norms Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3D Facial Norms dataset</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>3DFN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">3D Facial Norms cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001139"/>
