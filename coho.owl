    <!-- http://www.ebi.ac.uk/coho/COHO_0001440 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001440">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90255389</obo:IAO_0000112>
        <obo:IAO_0000115>A cross-sectional, family-based study, the first cohort of the Center for Oral Health Research in Appalachia, that from 2003 recruited households with at least one biological parent–child pair (the child aged 1–18 years), together with all other household members, mainly in rural counties of central West Virginia and western Pennsylvania, United States, and assessed them by interviews, questionnaires, oral health and microbiological examinations and DNA collection to study how individual, family and community factors contribute to oral disease in Appalachia.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>COHRA etiology study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COHRA1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Center for Oral Health Research in Appalachia, cohort 1</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Center for Oral Health Research in Appalachia cohort 1</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001440"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90255389</owl:annotatedTarget>
        <dcterms:title>Association of Early Childhood Caries with Bitter Taste Receptors: A Meta-Analysis of Genome-Wide Association Studies and Transcriptome-Wide Association Study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36672800</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9858612/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The first cohort of the Center for Oral Health Research in Appalachia (COHRA1) is a cross-sectional study comprising members of households living in rural West Virginia and Western Pennsylvania—a region with a high prevalence of poor oral health outcomes [4,15].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001440"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A cross-sectional, family-based study, the first cohort of the Center for Oral Health Research in Appalachia, that from 2003 recruited households with at least one biological parent–child pair (the child aged 1–18 years), together with all other household members, mainly in rural counties of central West Virginia and western Pennsylvania, United States, and assessed them by interviews, questionnaires, oral health and microbiological examinations and DNA collection to study how individual, family and community factors contribute to oral disease in Appalachia.</owl:annotatedTarget>
