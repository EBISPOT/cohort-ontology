    <!-- http://www.ebi.ac.uk/coho/COHO_0001033 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001033">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001288"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001291"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001297"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001381"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001399"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Barbados"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Latin_America_and_the_Caribbean"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Nigeria"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Western_Africa"/>
        <obo:IAO_0000112>GCST90244101</obo:IAO_0000112>
        <obo:IAO_0000115>A consortium for a genome-wide association study of breast cancer in women of African ancestry in Nigeria, Barbados and the United States, pooling the cases and controls of six epidemiological studies (the Nigerian Breast Cancer Study, the Barbados National Cancer Study, the Racial Variability in Genotypic Determinants of Breast Cancer Risk Study, the Chicago Cancer Prone Study, the Baltimore Breast Cancer Study and the Southern Community Cohort Study), genotyped together on the Illumina HumanOmni2.5 array.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GWAS in Breast Cancer in the African Diaspora</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GWAS of Breast Cancer in the African Diaspora</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ROOT</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>ROOT consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The GWAS of Breast Cancer in the African Diaspora consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Root consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genome-Wide Association Study of Breast Cancer in the African Diaspora</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001033"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244101</owl:annotatedTarget>
        <dcterms:title>Polygenic risk scores for prediction of breast cancer risk in women of African ancestry: a cross-ancestry approach.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35554533</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC9476624/</oboInOwl:hasDbXref>
        <rdfs:comment>We used data in women of AA from four breast cancer GWAS consortia and the Ghana Breast Health Study (GBHS); the four consortia were: ROOT (The GWAS of Breast Cancer in the African Diaspora consortium), the African American Breast Cancer Epidemiology and Risk (AMBER) consortium, Breast Cancer Association Consortium (BCAC) and African American Breast Cancer consortium (AABC) (see Supplementary Material, Table S1).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001033"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A consortium for a genome-wide association study of breast cancer in women of African ancestry in Nigeria, Barbados and the United States, pooling the cases and controls of six epidemiological studies (the Nigerian Breast Cancer Study, the Barbados National Cancer Study, the Racial Variability in Genotypic Determinants of Breast Cancer Risk Study, the Chicago Cancer Prone Study, the Baltimore Breast Cancer Study and the Southern Community Cohort Study), genotyped together on the Illumina HumanOmni2.5 array.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28171663</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:29302764</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001033"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
