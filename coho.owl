    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001207"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://pmc.ncbi.nlm.nih.gov/articles/PMC7083329/</oboInOwl:hasDbXref>
        <rdfs:comment>The Michigan Department of Health and Human Services (MDHHS; formerly known as the Michigan Department of Community Health) identifies twin pairs residing in lower Michigan who meet our study age criteria (see criteria below)</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001208 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001208">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <obo:IAO_0000112>GCST90568440</obo:IAO_0000112>
        <obo:IAO_0000115>A birth cohort of women recruited at their first antenatal clinic visit at the Mater Hospital in Brisbane, Australia, in 1981–1983, and of their live singleton children, followed up after the birth, at 6 months and at 5, 14 and 21 years, and in adulthood (mothers at 27 years, children at 30 years) with later record linkage. Begun as a study of pregnancy and its outcomes, it has become a longitudinal study of growth, development and ageing that emphasises the transmission across generations of factors affecting adult health.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MUSP</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mater University of Queensland Study of Pregnancy</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Mater-University of Queensland Study of Pregnancy and its outcomes</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Mater-University of Queensland Study of Pregnancy</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001208"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
