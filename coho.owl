    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001512"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case-control study of non-Hodgkin lymphoma in British Columbia, Canada, which invited residents of Greater Vancouver and Greater Victoria aged 20–79 with non-Hodgkin lymphoma diagnosed from March 2000 to February 2004, identified through the BC Cancer Registry (excluding HIV-positive and post-transplant cases), together with population controls from the Client Registry of the British Columbia Ministry of Health frequency-matched to the cases on sex, age and area of residence, to study environmental and genetic risk factors for the disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:17722095</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:19917125</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:26956414</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
