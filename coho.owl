        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>GCST90444478</obo:IAO_0000112>
        <obo:IAO_0000115>A nationwide French cohort of 2323 non-demented adults with isolated subjective cognitive complaints or mild cognitive impairment, recruited in memory clinics from 2011 to 2014 and followed with standardised clinical, neuropsychological, neuroimaging and biomarker assessments to study the natural history of Alzheimer&apos;s disease and related disorders.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MEMENTO</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MEMENTO cohort study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Memento</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">MEMENTO cohort</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000785"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90444478</owl:annotatedTarget>
        <dcterms:title>Genome-wide association study meta-analysis of neurofilament light (NfL) levels in blood reveals novel loci related to neurodegeneration.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39251807</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11385583/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The current study includes 18532 participants of European and 1142 participants of African- American ancestry from 11 different cohorts of the CHARGE consortium including: the Rotterdam Study (RS-I and RS-II, N = 4119), the Rhineland Study (N = 4019), the MEMENTO cohort (N = 2195), the Framingham Heart Study (FHS, N = 2048), the BiDirect study (N = 1899), the CHS (African-American N = 273, European-American N = 1396), the ARIC (African-American N = 823, European American N = 742), the VESTA (N = 828), the ADNI (N = 578), the CARDIA (African-American N = 128, European-American N = 343) Study</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000785"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A nationwide French cohort of 2323 non-demented adults with isolated subjective cognitive complaints or mild cognitive impairment, recruited in memory clinics from 2011 to 2014 and followed with standardised clinical, neuropsychological, neuroimaging and biomarker assessments to study the natural history of Alzheimer&apos;s disease and related disorders.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28851447</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
