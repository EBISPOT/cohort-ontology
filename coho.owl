    <!-- http://www.ebi.ac.uk/coho/COHO_0001119 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001119">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90128530</obo:IAO_0000112>
        <obo:IAO_0000115>A family study in the United Kingdom that from October 2002 recruited women attending the Cambridge and Huntingdon NHS breast screening services who had one or more female blood relatives (sisters, half-sisters, first cousins, aunts or nieces) who had also had screening mammograms, with further families found through newspaper and radio advertisements, to map genes underlying quantitative phenotypes related to breast cancer, in particular mammographic breast density and sex steroid hormone levels.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SIBS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sisters in Breast Screening</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sisters in Breast Screening study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Sisters in Breast Screening Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001119"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90128530</owl:annotatedTarget>
        <dcterms:title>Genome-wide and transcriptome-wide association studies of mammographic density phenotypes reveal novel loci.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35414113</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>The Sisters in Breast Screening Study (SIBS) was designed to study the genetic basis of quantitative phenotypes related to breast cancer, in particular breast density and sex-hormone levels [Varghese et al., 2012; Kataoka et al., 2009].</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
