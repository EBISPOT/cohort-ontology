    <!-- http://www.ebi.ac.uk/coho/COHO_0001377 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001377">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Finland"/>
        <obo:IAO_0000112>GCST90179151</obo:IAO_0000112>
        <obo:IAO_0000115>The Finnish arm of the multisite Nicotine Addiction Genetics consortium (Finland, Australia and the United States), in which twin pairs from the older Finnish Twin Cohort (born 1938–1957) concordant for ever-smoking, with priority to heavier smokers, were recruited in 2001–2005 together with their family members, mainly siblings, and assessed by a structured diagnostic psychiatric interview and DNA sampling to study the genetics of smoking behaviour and nicotine dependence.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Finnish Nicotine Addiction Genetics Project</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NAG-FIN</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>NAG-Fin</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Nicotine Addiction Genetics-Finland study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Nicotine Addiction Genetics Finland study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001377"/>
