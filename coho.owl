    <!-- http://www.ebi.ac.uk/coho/COHO_0001375 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001375">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90451657</obo:IAO_0000112>
        <obo:IAO_0000115>A UK Medical Research Council open-label randomised trial that enrolled adults aged 18 or older with newly diagnosed symptomatic multiple myeloma at 120 UK centres between May 2003 and November 2007, allocating them to an intensive pathway (induction followed by high-dose melphalan and autologous stem-cell transplantation) or a non-intensive pathway, and randomising first-line bisphosphonate (zoledronic versus clodronic acid) with induction chemotherapy and, later, maintenance treatment.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym MRC also denotes Myeloma XI trial (COHO:0001374); this term is MRC Myeloma IX trial.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>MRC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Medical Research Council Myeloma IX trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MyIX</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Myeloma IX</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Myeloma-IX trial</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">MRC Myeloma IX trial</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001375"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90451657</owl:annotatedTarget>
        <dcterms:title>Deciphering the genetics and mechanisms of predisposition to multiple myeloma.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39103364</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11300596/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>for the Myeloma-IX68,69 trial by the Medical Research Council Leukaemia Data Monitoring and Ethics committee (MREC 02/8/95, ISRCTN68454111)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001375"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A UK Medical Research Council open-label randomised trial that enrolled adults aged 18 or older with newly diagnosed symptomatic multiple myeloma at 120 UK centres between May 2003 and November 2007, allocating them to an intensive pathway (induction followed by high-dose melphalan and autologous stem-cell transplantation) or a non-intensive pathway, and randomising first-line bisphosphonate (zoledronic versus clodronic acid) with induction chemotherapy and, later, maintenance treatment.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21131037</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
