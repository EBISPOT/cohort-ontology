    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000714"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90627735</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analyses identify 95 risk loci and provide insights into the neurobiology of post-traumatic stress disorder.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38637617</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC11396662/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>These cohorts consisted of four US-based sites (Vanderbilt University Medical Center’s BioVu, the Mass General Brigham Biobank, Mount Sinai’s BioMe, and Mayo Clinic’s MayoGC) and six non-US sites (iPSYCH from Denmark, FinnGen, HUNT Study from Norway, STR-STAGE from Sweden, UK Biobank, and Estonia Biobank).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000714"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A genotype-phenotype resource assembled at Mayo Clinic from participants of multiple Mayo Clinic research studies who gave general research consent to share their high-throughput genotyping data, linked to electronic medical record data for phenotype extraction, to enable cost-effective genome-wide association studies.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:21646302</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
