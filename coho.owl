        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Italy"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Spain"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <obo:IAO_0000112>GCST90565134</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium of psoriasis genetics research groups in the United Kingdom, Ireland, Austria, Finland, Germany, Italy, the Netherlands, Spain and Sweden, with a management committee chaired from King&apos;s College London, that pools its members&apos; collections of people of European descent with psoriasis vulgaris, together with controls from national control collections, for genetic association studies of psoriasis, including a genome-wide association study with the Wellcome Trust Case Control Consortium 2 and an Immunochip case–control study.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GAP consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GAPC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Genetic Analysis of Psoriasis Consortium</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90565134</owl:annotatedTarget>
        <dcterms:title>Multi-ancestry genome-wide meta-analysis with 472,819 individuals identifies 32 novel risk loci for psoriasis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:39885523</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11783861/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>Samples of the Genetic Analysis of Psoriasis Consortium (GAPC) datasets were collected from subjects of European Caucasian descent at the participating institutions after obtaining informed consent in adherence with the Declaration of Helsinki Principles.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>An international consortium of psoriasis genetics research groups in the United Kingdom, Ireland, Austria, Finland, Germany, Italy, the Netherlands, Spain and Sweden, with a management committee chaired from King&apos;s College London, that pools its members&apos; collections of people of European descent with psoriasis vulgaris, together with controls from national control collections, for genetic association studies of psoriasis, including a genome-wide association study with the Wellcome Trust Case Control Consortium 2 and an Immunochip case–control study.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:20953190</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:23143594</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2467/MediaObjects/41588_2012_BFng2467_MOESM43_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GAPC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Finland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Finland control data were from the DILGOM (Dietary, Lifestyle, and Genetic determinants of Obesity and Metabolic syndrome) collection</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Germany"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The German controls were obtained from the PopGen biobank and genotyped at the Institute of Clinical Molecular Biology, Christian-Albrechts-University of Kiel.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Italy"/>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2467/MediaObjects/41588_2012_BFng2467_MOESM43_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>Groningen group (Italian and Dutch controls)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>We did not include specific controls from Austria or Sweden, but PCA analysis suggested that the cases from these cohorts were well matched to the controls from the Netherlands and Germany.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Republic_of_Ireland"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Irish controls were provided by the Irish Blood Transfusion Service / TCD Biobank and the Irish cases collected with the aid of the Dublin Centre for Clinical Research.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Spain"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GAPC cases and the Irish and Spanish controls were genotyped at the Wellcome Trust Sanger Institute (WTSI)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001332"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The UK controls were the WTCCC common controls that did not overlap with samples included in the original GWA studies (the dataset consisted of 6,740 1958 British Birth cohort and 2,900 UK Blood Service samples genotyped at the WTSI and the University of Virginia).</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001333 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001333">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Africa"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Ghana"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Western_Africa"/>
        <obo:IAO_0000112>GCST90244101</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based case–control study of breast cancer, a collaboration of the US National Cancer Institute with three major hospitals in Accra and Kumasi, Ghana (Korle Bu Teaching Hospital, Komfo Anokye Teaching Hospital and Peace and Love Hospital), that in 2013–2015 enrolled women aged 18–74 recommended for biopsy of a breast lesion suspicious for malignancy, or treated for breast cancer, at these hospitals, and population controls sampled by household enumeration of the surrounding districts and frequency-matched on age and district, collecting interviews and tumour tissue, blood, saliva and faecal samples to study breast cancer risk factors in a West African population.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>GBHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Ghana breast health study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Ghana Breast Health Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001333"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90244101</owl:annotatedTarget>
        <dcterms:title>Polygenic risk scores for prediction of breast cancer risk in women of African ancestry: a cross-ancestry approach.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:35554533</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://academic.oup.com/hmg/article/31/18/3133/6584730</oboInOwl:hasDbXref>
        <rdfs:comment>We used data in women of AA from four breast cancer GWAS consortia and the Ghana Breast Health Study (GBHS)</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001333"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based case–control study of breast cancer, a collaboration of the US National Cancer Institute with three major hospitals in Accra and Kumasi, Ghana (Korle Bu Teaching Hospital, Komfo Anokye Teaching Hospital and Peace and Love Hospital), that in 2013–2015 enrolled women aged 18–74 recommended for biopsy of a breast lesion suspicious for malignancy, or treated for breast cancer, at these hospitals, and population controls sampled by household enumeration of the surrounding districts and frequency-matched on age and district, collecting interviews and tumour tissue, blood, saliva and faecal samples to study breast cancer risk factors in a West African population.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:28295287</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:30990841</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38082317</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001333"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>GBHS</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001333"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Ghana"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29324997+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>In Accra and Kumasi, Ghana, we collected detailed information on usage patterns of both exposures among 1131 invasive breast cancer cases and 2106 population controls.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001334 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001334">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Australia"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Germany"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Oceania"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Switzerland"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_Kingdom"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90428821</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre international case–control study of alcohol-related cirrhosis, run by the GenomALC Consortium of researchers in Australia, France, Germany, Switzerland, the United Kingdom and the United States with funding from the US National Institute on Alcohol Abuse and Alcoholism, that from September 2012 recruited, at liver and alcohol treatment clinics and from existing repositories of the participating centres, people who had drunk heavily (at least 80 g of alcohol a day for men or 50 g for women) for at least ten years, with alcoholic cirrhosis (cases) or without significant liver disease (controls), with interviews, clinical records and blood samples, to find genetic factors that predispose drinkers to cirrhosis. A second sample, GenomALC-2, added DNA and data that research groups in these countries and Belgium had collected for earlier genetic studies of alcohol-related liver disease.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>Genetics of alcoholic liver cirrhosis consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>GenomALC Multinational Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">GenomALC</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001334"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90428821</owl:annotatedTarget>
        <dcterms:title>A polygenic risk score for alcohol-associated cirrhosis among heavy drinkers with European ancestry.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:38727677</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11093576/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GenomALC study participants were recruited at clinical sites in Australia, France, Germany, Switzerland, the United Kingdom, and the United States using our previously published enrollment protocol.16 Briefly, chronic heavy drinkers who reported consuming ≥80 g of alcohol/day (male) or 50 g/d (female) for ≥10 years with cirrhosis (cases) or without significant alcohol-associated liver disease (controls) were recruited.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001334"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A multicentre international case–control study of alcohol-related cirrhosis, run by the GenomALC Consortium of researchers in Australia, France, Germany, Switzerland, the United Kingdom and the United States with funding from the US National Institute on Alcohol Abuse and Alcoholism, that from September 2012 recruited, at liver and alcohol treatment clinics and from existing repositories of the participating centres, people who had drunk heavily (at least 80 g of alcohol a day for men or 50 g for women) for at least ten years, with alcoholic cirrhosis (cases) or without significant liver disease (controls), with interviews, clinical records and blood samples, to find genetic factors that predispose drinkers to cirrhosis. A second sample, GenomALC-2, added DNA and data that research groups in these countries and Belgium had collected for earlier genetic studies of alcohol-related liver disease.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:25872595</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:38727677</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001334"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Belgium"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11093576/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>Patients enrolled in GenomALC-2 were from hospitals and clinics in the countries in GenomALC-1 and from Belgium.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001334"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/United_States"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11093576/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The GenomALC study participants were recruited at clinical sites in Australia, France, Germany, Switzerland, the United Kingdom, and the United States using our previously published enrollment protocol.16 Briefly, chronic heavy drinkers who reported consuming ≥80 g of alcohol/day (male) or 50 g/d (female) for ≥10 years with cirrhosis (cases) or without significant alcohol-associated liver disease (controls) were recruited.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001335 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001335">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000001"/>
        <coho:hasCohort rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001372"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Asia"/>
