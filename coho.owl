    <!-- http://www.ebi.ac.uk/coho/COHO_0001605 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001605">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Netherlands"/>
        <obo:IAO_0000112>PMID:29917119</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre prospective cohort of patients newly diagnosed with colorectal cancer of any stage, recruited in 2010–2020 at 11 hospitals in the Netherlands by investigators at Wageningen University. Participants complete questionnaires on diet, dietary supplements, physical activity, body weight and quality of life and give blood at diagnosis and 6 months, 2 years and 5 years later, while clinical data come from the Netherlands Cancer Registry and hospital records. The aim is to learn how diet and other lifestyle factors influence recurrence, survival and quality of life after colorectal cancer.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>COLON</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COLON study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>COlorectal cancer: Longitudinal, Observational study on Nutritional and lifestyle factors that may influence colorectal tumour recurrence, survival and quality of life</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Colorectal Cancer: Longitudinal Observational study on Nutritional and lifestyle factors that influence colorectal tumor recurrence, survival and quality of life</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Colorectal cancer: Longitudinal, Observational study on Nutritional and lifestyle factors that may influence colorectal tumour recurrence, survival and quality of life</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Longitudinal, observational study on nutritional and lifestyle factors for colorectal cancer and related outcomes</oboInOwl:hasRelatedSynonym>
        <rdfs:label xml:lang="en">Colorectal cancer: Longitudinal, Observational study on Nutritional and lifestyle factors that influence colorectal tumour recurrence, survival and quality of life</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
