        <obo:IAO_0000112>GCST90014287</obo:IAO_0000112>
        <obo:IAO_0000115>A long-term community-based cohort of Black and white children and adolescents in the rural biracial community of Bogalusa, Louisiana, United States, begun in 1972 by an NHLBI-funded research centre to study cardiovascular risk factors from early life and followed into adulthood.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym BHS also denotes Busselton Health Study (COHO:0000389) and Baependi Heart Study (COHO:0000623); this term is Bogalusa Heart Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>BHS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BHS_b</oboInOwl:hasRelatedSynonym>
