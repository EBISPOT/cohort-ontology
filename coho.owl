        <obo:IAO_0000119>PMID:37494057</obo:IAO_0000119>
        <obo:IAO_0000119>PMID:40650879</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
