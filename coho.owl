    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000986"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3390364/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Umeå Fracture and Osteoporosis (UFO) study is a nested case-cohort, population-based study from Sweden designed to identify the genetic and gene-by-environmental determinants of osteoporotic fracture.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000986"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/isSubCohortOf"/>
        <owl:annotatedTarget rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000927"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10583993/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>The Umeå Fracture and Osteoporosis (UFO) study is a population-based, nested case–control study sampled from the Northern Sweden Health and Disease study cohort that started in 1985 and now consists of blood samples, and lifestyle and dietary data from around 135 000 unique subjects from the county of Västerbotten.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0000987 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0000987">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
