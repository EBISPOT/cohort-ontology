        <obo:IAO_0000112>GCST90308762</obo:IAO_0000112>
        <obo:IAO_0000115>An international consortium of prostate cancer study groups, reported in 2008 as a worldwide consortium of 13 groups, that pools genotype and clinical data from prostate cancer case-control and cohort studies in North America, Europe, Asia and Australia to investigate inherited susceptibility to prostate cancer and its clinical course.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PRACTICAL</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PRACTICAL Consortium</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>PRostate cancer AssoCiation group To Investigate Cancer-Associated aLterations in the genome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prostate Cancer Association Group to Investigate Cancer Associated Alterations in the Genome</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Prostate Cancer Association Group to Investigate Cancer-Associated Alterations</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Prostate Cancer Association Group to Investigate Cancer-Associated Alterations in the Genome</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000611"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90308762</owl:annotatedTarget>
        <dcterms:title>Pan-cancer and cross-population genome-wide association studies dissect shared genetic backgrounds underlying carcinogenesis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:37340002</oboInOwl:hasDbXref>
