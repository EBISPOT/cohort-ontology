    <!-- http://www.ebi.ac.uk/coho/COHO_0001372 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001372">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/France"/>
        <obo:IAO_0000112>GCST010304</obo:IAO_0000112>
        <obo:IAO_0000115>A French study of genetic susceptibility to cutaneous melanoma that recruited histologically confirmed melanoma patients of European ancestry, enrolled for a family history of melanoma, multiple primary melanomas or diagnosis before age 40, through a nationwide network of French dermatology departments and oncogenetic clinics between 1992 and 2011, with interview, clinical examination and questionnaire data on melanoma risk factors; in genome-wide association studies its cases were compared with population-based French controls.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>MELARISK</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>MELARISK collection</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">MELARISK study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001372"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST010304</owl:annotatedTarget>
        <dcterms:title>Genome-wide association meta-analyses combining multiple risk phenotypes provide insights into the genetic architecture of cutaneous melanoma susceptibility.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:32341527</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0611-8/MediaObjects/41588_2020_611_MOESM1_ESM.pdf</oboInOwl:hasDbXref>
        <rdfs:comment>We acknowledge that the biological specimens of the French MELARISK study were obtained from the Institut Gustave Roussy and Fondation Jean Dausset–CEPH Biobanks.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001372"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
