        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000446"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90255778</owl:annotatedTarget>
        <dcterms:title>Mapping gene by early life stress interactions on child subcortical brain structures: A genome-wide prospective study.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:36777645</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36777645+AND+SRC%3AMED&amp;format=json&amp;resultType=core</oboInOwl:hasDbXref>
        <rdfs:comment>Genome-wide association and genome-wide-by-environment interaction analyses (GWEIS, run separately for prenatal/postnatal ELS) were conducted for eight brain outcomes (i.e., 24 genome-wide analyses) in the Generation R Study (discovery).</rdfs:comment>
    </owl:Axiom>
