        <obo:IAO_0000119>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4302371/fullTextXML</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
