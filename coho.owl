        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7849104/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>To increase statistical power, we included controls from the Spanish Bladder Cancer (SBC)/EPICURO study, carried out in the same geographical areas where PanGenEU study was conducted.</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000797"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A hospital-based case-control study of bladder cancer (the EPICURO study) that enrolled patients newly diagnosed with urothelial carcinoma of the bladder in 1998–2001 at 18 hospitals in five regions of Spain and individually matched hospital controls, to study environmental, occupational and genetic risk factors for bladder cancer.</owl:annotatedTarget>
