    <!-- http://www.ebi.ac.uk/coho/COHO_0001123 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001123">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Canada"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90301368</obo:IAO_0000112>
        <obo:IAO_0000115>A family-based study of ischaemic stroke that from 1999 to 2011 enrolled, at clinical centres in the United States and Canada, adult probands with radiographically confirmed ischaemic stroke who had at least one living full sibling with stroke, together with their stroke-affected siblings, confirmed by central review of medical records, and where possible a stroke-free sibling, confirmed by structured telephone interview, all contacted through the proband, to search the genome for genetic risk factors for ischaemic stroke by linkage and family-based association analysis.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SWISS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sibling with Ischemic Stroke Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Siblings with Ischemic Stroke Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Siblings With Ischemic Stroke Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001123"/>
