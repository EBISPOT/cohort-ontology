    <!-- http://www.ebi.ac.uk/coho/COHO_0001287 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001287">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Europe"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <obo:IAO_0000112>GCST90726344</obo:IAO_0000112>
        <obo:IAO_0000115>A population-based prospective cohort of pregnant women in Uppsala County, Sweden, invited at their routine ultrasound examination at gestational week 16–18 at Uppsala University Hospital from September 2009 to November 2018 and followed to one year postpartum with web surveys, biological samples and medical-record data, to study the biopsychosocial causes and predictors of perinatal depression.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>BASIC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>The Biology, Affect, Stress, Imaging and Cognition Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Biology, Affect, Stress, Imaging and Cognition study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001287"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90726344</owl:annotatedTarget>
        <dcterms:title>Genome-wide association analyses identify distinct genetic architectures for early-onset and late-onset depression.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:41233554</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12695632/supplementaryFiles</oboInOwl:hasDbXref>
        <rdfs:comment>BASIC: The Biology, Affect, Stress, Imaging and Cognition (BASIC) study recruited 5,492 pregnant women from the Uppsala Hospital University (Uppsala, Sweden) and followed them and their children from pregnancy to one year postpartum between 2012 and 201911 .</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001287"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A population-based prospective cohort of pregnant women in Uppsala County, Sweden, invited at their routine ultrasound examination at gestational week 16–18 at Uppsala University Hospital from September 2009 to November 2018 and followed to one year postpartum with web surveys, biological samples and medical-record data, to study the biopsychosocial causes and predictors of perinatal depression.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:31641004</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001287"/>
        <owl:annotatedProperty rdf:resource="http://www.geneontology.org/formats/oboInOwl#hasRelatedSynonym"/>
        <owl:annotatedTarget>BASIC</owl:annotatedTarget>
        <oboInOwl:hasSynonymType rdf:resource="http://purl.obolibrary.org/obo/OMO_0003000"/>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001287"/>
        <owl:annotatedProperty rdf:resource="http://www.ebi.ac.uk/coho/has_data_collection_location"/>
        <owl:annotatedTarget rdf:resource="http://dbpedia.org/resource/Sweden"/>
        <oboInOwl:hasDbXref>https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6830667/fullTextXML</oboInOwl:hasDbXref>
        <rdfs:comment>From September 2009 to November 2018, the BASIC study at Uppsala University Hospital, Sweden, has enrolled 5492 women, in 6478 pregnancies, of which 46.3% first-time pregnancies and with an average age of 31.5 years.</rdfs:comment>
    </owl:Axiom>
    


    <!-- http://www.ebi.ac.uk/coho/COHO_0001288 -->

    <owl:NamedIndividual rdf:about="http://www.ebi.ac.uk/coho/COHO_0001288">
        <rdf:type rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000000"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/Northern_America"/>
        <coho:has_data_collection_location rdf:resource="http://dbpedia.org/resource/United_States"/>
        <obo:IAO_0000112>GCST90094651</obo:IAO_0000112>
        <obo:IAO_0000115>A case-control study of breast cancer in the greater Baltimore area, Maryland, United States, in which incident breast cancer cases and controls frequency-matched to them on race and age were recruited from February 1993 to August 2003 at six hospitals, including the University of Maryland Medical Center and the Baltimore Veterans Affairs Medical Center, to identify and characterise markers of disease aggressiveness and poor outcome.</obo:IAO_0000115>
        <obo:IAO_0000116 xml:lang="en">The acronym BBCS also denotes Brescia Bladder Cancer Study (COHO:0000815) and British Breast Cancer Study (COHO:0001510); this term is Baltimore Breast Cancer Study.</obo:IAO_0000116>
        <oboInOwl:hasRelatedSynonym>BBCS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>BBCS_c</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Baltimore Breast Cancer Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001288"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000112"/>
        <owl:annotatedTarget>GCST90094651</owl:annotatedTarget>
        <dcterms:title>Associations between age of menarche and genetic variation in women of African descent: genome-wide association study and polygenic score analysis.</dcterms:title>
        <oboInOwl:hasDbXref>PMID:34706928</oboInOwl:hasDbXref>
        <oboInOwl:hasDbXref>https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9011920/unicode</oboInOwl:hasDbXref>
        <rdfs:comment>The Root consortium is comprised of six epidemiologic studies of breast cancer in women of African ancestry: the Nigerian Breast Cancer Study (Ibadan, Nigeria); the Barbados National Cancer Study (Barbados); the Southern Community Cohort (southern United States); the Baltimore Breast Cancer Study (Baltimore, United States); the Racial Variability in Genotypic Determinants of Breast Cancer Risk Study (Detroit and Pennsylvania, United States); and the Chicago Cancer Prone Study (Chicago, United States).</rdfs:comment>
    </owl:Axiom>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0001288"/>
        <owl:annotatedProperty rdf:resource="http://purl.obolibrary.org/obo/IAO_0000115"/>
        <owl:annotatedTarget>A case-control study of breast cancer in the greater Baltimore area, Maryland, United States, in which incident breast cancer cases and controls frequency-matched to them on race and age were recruited from February 1993 to August 2003 at six hospitals, including the University of Maryland Medical Center and the Baltimore Veterans Affairs Medical Center, to identify and characterise markers of disease aggressiveness and poor outcome.</owl:annotatedTarget>
        <obo:IAO_0000119>PMID:22357627</obo:IAO_0000119>
        <obo:IAO_0000119>https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf</obo:IAO_0000119>
        <dcterms:contributor>Claude Opus 5.5 (Anthropic), 2026-09</dcterms:contributor>
    </owl:Axiom>
