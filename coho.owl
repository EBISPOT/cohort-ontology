        <obo:IAO_0000112>GCST90269923</obo:IAO_0000112>
        <obo:IAO_0000115>A multicentre observational cohort of current and former smokers aged 40–80 with or without airflow obstruction, and never-smoking controls, recruited at clinical sites across the United States with baseline and annual follow-up visits, to find subgroups of chronic obstructive pulmonary disease and biomarkers usable as intermediate outcomes in therapeutic trials.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>SPIROMICS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Sub-Populations and InteRmediate Outcome Measures in COPD Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Subpopulations and Intermediate Outcome Measures in COPD Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Subpopulations and Intermediate Outcomes in COPD Study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Subpopulations and intermediate outcome measures in COPD study</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">SubPopulations and InteRmediate Outcome Measures in COPD Study</rdfs:label>
    </owl:NamedIndividual>
    <owl:Axiom>
        <owl:annotatedSource rdf:resource="http://www.ebi.ac.uk/coho/COHO_0000652"/>
