        <obo:IAO_0000115>A population-based study of youths aged 8–21 living in the greater Philadelphia area, United States, recruited through the Children’s Hospital of Philadelphia Center for Applied Genomics from non-psychiatric paediatric clinics and assessed with clinical, neurocognitive and neuroimaging measures to describe how genetics affects brain development and cognitive functioning in adolescence.</obo:IAO_0000115>
        <oboInOwl:hasRelatedSynonym>PNC</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
