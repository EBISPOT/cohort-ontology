        <oboInOwl:hasRelatedSynonym>Amsterdam Cohort Studies on HIV Infection and AIDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:hasRelatedSynonym>Amsterdam cohort studies on HIV infection and AIDS</oboInOwl:hasRelatedSynonym>
        <oboInOwl:inSubset rdf:resource="http://www.ebi.ac.uk/coho#GWAS_subset"/>
        <rdfs:label xml:lang="en">Amsterdam Cohort Studies on HIV infection and AIDS</rdfs:label>
