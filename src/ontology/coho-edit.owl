Import(<http://www.ebi.ac.uk/coho/components/PRIDE.owl>)
Import(<http://www.ebi.ac.uk/coho/components/aggregation_members.owl>)
Import(<http://www.ebi.ac.uk/coho/components/definitions.owl>)
Import(<http://www.ebi.ac.uk/coho/components/example_studies.owl>)
Import(<http://www.ebi.ac.uk/coho/components/gaz_xrefs.owl>)
Import(<http://www.ebi.ac.uk/coho/components/locations.owl>)
