Declaration(AnnotationProperty(<http://www.ebi.ac.uk/coho#EGA_subset>))
Declaration(AnnotationProperty(<http://www.ebi.ac.uk/coho#GWAS_subset>))
Declaration(AnnotationProperty(<http://www.ebi.ac.uk/coho#MetaboLight_subset>))
Declaration(AnnotationProperty(<http://www.ebi.ac.uk/coho#PRIDE_subset>))
Declaration(AnnotationProperty(oboInOwl:hasSynonymType))
############################
#   Annotation Properties
############################

# Annotation Property: <http://www.ebi.ac.uk/coho#EGA_subset> (EGA_subset)

AnnotationAssertion(obo:IAO_0000115 <http://www.ebi.ac.uk/coho#EGA_subset> "The cohorts that studies in the European Genome-phenome Archive (EGA) draw on."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/coho#EGA_subset> "EGA_subset")
SubAnnotationPropertyOf(<http://www.ebi.ac.uk/coho#EGA_subset> oboInOwl:SubsetProperty)

# Annotation Property: <http://www.ebi.ac.uk/coho#GWAS_subset> (GWAS_subset)

AnnotationAssertion(obo:IAO_0000115 <http://www.ebi.ac.uk/coho#GWAS_subset> "The cohorts that studies in the GWAS Catalog draw on."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/coho#GWAS_subset> "GWAS_subset")
SubAnnotationPropertyOf(<http://www.ebi.ac.uk/coho#GWAS_subset> oboInOwl:SubsetProperty)

# Annotation Property: <http://www.ebi.ac.uk/coho#MetaboLight_subset> (MetaboLight_subset)

AnnotationAssertion(obo:IAO_0000115 <http://www.ebi.ac.uk/coho#MetaboLight_subset> "The cohorts that studies in MetaboLights draw on."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/coho#MetaboLight_subset> "MetaboLight_subset")
SubAnnotationPropertyOf(<http://www.ebi.ac.uk/coho#MetaboLight_subset> oboInOwl:SubsetProperty)

# Annotation Property: <http://www.ebi.ac.uk/coho#PRIDE_subset> (PRIDE_subset)

AnnotationAssertion(obo:IAO_0000115 <http://www.ebi.ac.uk/coho#PRIDE_subset> "The cohorts that datasets in the PRIDE proteomics archive draw on."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/coho#PRIDE_subset> "PRIDE_subset")
SubAnnotationPropertyOf(<http://www.ebi.ac.uk/coho#PRIDE_subset> oboInOwl:SubsetProperty)


############################
#   Object Properties
############################

# Object Property: coho:hasCohort (hasCohort)

AnnotationAssertion(obo:IAO_0000115 coho:hasCohort "A relation between a cohort aggregation and a cohort whose participants or data it combines or compares."@en)
AnnotationAssertion(rdfs:label coho:hasCohort "hasCohort"@en)
ObjectPropertyDomain(coho:hasCohort coho:COHO_0000001)
ObjectPropertyRange(coho:hasCohort coho:COHO_0000000)

# Object Property: coho:hasSubCohort (hasSubCohort)

AnnotationAssertion(obo:IAO_0000115 coho:hasSubCohort "A relation between a cohort and a cohort whose participants are drawn from it: a sub-study, a sub-sample or a component trial. The inverse of isSubCohortOf."@en)
AnnotationAssertion(rdfs:label coho:hasSubCohort "hasSubCohort"@en)
InverseObjectProperties(coho:hasSubCohort coho:isSubCohortOf)
ObjectPropertyDomain(coho:hasSubCohort coho:COHO_0000000)
ObjectPropertyRange(coho:hasSubCohort coho:COHO_0000000)

# Object Property: coho:has_data_collection_location (has_data_collection_location)

AnnotationAssertion(obo:IAO_0000115 coho:has_data_collection_location "A relation between a cohort and a geographical area in which its participants were recruited. Where the data were analysed or are stored does not count."@en)
AnnotationAssertion(rdfs:label coho:has_data_collection_location "has_data_collection_location"@en)
TransitiveObjectProperty(coho:has_data_collection_location)
ObjectPropertyRange(coho:has_data_collection_location obo:NCIT_C16632)

# Object Property: coho:isSubCohortOf (isSubCohortOf)

AnnotationAssertion(obo:IAO_0000115 coho:isSubCohortOf "A relation between a cohort and the cohort its participants are drawn from, of which it is a sub-study, a sub-sample or a component trial."@en)
AnnotationAssertion(rdfs:label coho:isSubCohortOf "isSubCohortOf"@en)
ObjectPropertyDomain(coho:isSubCohortOf coho:COHO_0000000)
ObjectPropertyRange(coho:isSubCohortOf coho:COHO_0000000)



############################
#   Classes
############################

# Class: coho:COHO_0000000 (cohort)

AnnotationAssertion(obo:IAO_0000115 coho:COHO_0000000 "A group of individuals grouped together based on a shared characteristic or property of interest.")
AnnotationAssertion(oboInOwl:hasDbXref coho:COHO_0000000 "EFO:0004445")
AnnotationAssertion(oboInOwl:hasDbXref coho:COHO_0000000 "NCIT:C61512")
AnnotationAssertion(rdfs:label coho:COHO_0000000 "cohort"@en)

# Class: coho:COHO_0000001 (cohort aggregation)

AnnotationAssertion(obo:IAO_0000115 coho:COHO_0000001 "A study, project or consortium that compares multiple cohorts.")
AnnotationAssertion(rdfs:label coho:COHO_0000001 "cohort aggregation"@en)
SubClassOf(coho:COHO_0000001 ObjectMinCardinality(2 coho:hasCohort coho:COHO_0000000))

# Class: coho:TEMP_temporary_unclassified (temporary unclassified)

AnnotationAssertion(obo:IAO_0000115 coho:TEMP_temporary_unclassified "A holding class for a cohort individual that has not yet been classified as a cohort or a cohort aggregation. Nothing should remain here."@en)
AnnotationAssertion(rdfs:label coho:TEMP_temporary_unclassified "temporary unclassified"@en)


############################
#   Named Individuals
############################

# Individual: coho:COHO_0000002 (1000 Genomes)

AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0000002 "1000G")
AnnotationAssertion(rdfs:label coho:COHO_0000002 "1000 Genomes"@en)
ClassAssertion(coho:COHO_0000000 coho:COHO_0000002)

# Individual: coho:COHO_0000003 (AddNeuroMed Cohort)

AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0000003 "ANM")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0000003 "AddNeuroMed")
AnnotationAssertion(rdfs:label coho:COHO_0000003 "AddNeuroMed Cohort"@en)
ClassAssertion(coho:COHO_0000000 coho:COHO_0000003)

# Individual: coho:COHO_0000004 (Adenoma Prevention with Celecoxib trial)

AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0000004 "APC")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0000004 "APC Trail")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0000004 "Adenoma Prevention with Celecoxib")
AnnotationAssertion(rdfs:label coho:COHO_0000004 "Adenoma Prevention with Celecoxib trial"@en)
ClassAssertion(coho:COHO_0000000 coho:COHO_0000004)

# Individual: coho:COHO_0000005 (Advanced Study of Aortic Pathology)

AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0000005 "ASAP")
AnnotationAssertion(rdfs:label coho:COHO_0000005 "Advanced Study of Aortic Pathology"@en)
ClassAssertion(coho:COHO_0000000 coho:COHO_0000005)

# Individual: coho:COHO_0000006 (Africa Wits-INDEPTH partnership for Genomics studies)

AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0000006 "AWI-Gen")
AnnotationAssertion(rdfs:label coho:COHO_0000006 "Africa Wits-INDEPTH partnership for Genomics studies"@en)
ClassAssertion(coho:COHO_0000000 coho:COHO_0000006)

# Individual: coho:COHO_0000007 (Arthritis Research UK Osteoarthritis Genetics)

AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0000007 "arcOGEN")
AnnotationAssertion(rdfs:label coho:COHO_0000007 "Arthritis Research UK Osteoarthritis Genetics"@en)
ClassAssertion(coho:COHO_0000000 coho:COHO_0000007)

# Individual: coho:COHO_0000008 (Asian Cancer Project)

AnnotationAssertion(obo:IAO_0000116 coho:COHO_0000008 "The acronym ACP also denotes an Old Order Amish cohort in the GWAS Catalog (e.g. GCST90281184); those studies are not this cohort."@en)
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0000008 "ACP")
AnnotationAssertion(rdfs:label coho:COHO_0000008 "Asian Cancer Project"@en)
ClassAssertion(coho:COHO_0000000 coho:COHO_0000008)

# Individual: coho:COHO_0000009 (Aspirin for Asymptomatic Atherosclerosis Study)

AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0000009 "AAA")
AnnotationAssertion(rdfs:label coho:COHO_0000009 "Aspirin for Asymptomatic Atherosclerosis Study"@en)
