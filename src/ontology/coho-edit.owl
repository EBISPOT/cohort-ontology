AnnotationAssertion(obo:IAO_0000114 coho:COHO_0001958 obo:IAO_0000124)
AnnotationAssertion(rdfs:label coho:COHO_0001958 "Korean Brain Aging Study for the Early Diagnosis and Prediction of AD"@en)
