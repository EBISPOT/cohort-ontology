AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0002521 "UM/CWRU/MSSM")
AnnotationAssertion(oboInOwl:hasRelatedSynonym coho:COHO_0002521 "University of Miami Hussman Institute for Human Genomics/Vanderbilt University Center for Human Genetics Research/Mount Sinai School of Medicine")
AnnotationAssertion(rdfs:label coho:COHO_0002521 "University of Miami/Vanderbilt University/Mt. Sinai School of Medicine"@en)
