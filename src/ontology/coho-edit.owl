ObjectPropertyAssertion(Annotation(rdfs:comment "The Hwasun Cancer Epidemiology Study (HCES-Br) is a hospital-based case-control 92 study whose goal is to identify factors of the cancer development and clinical 93 progression in a Korean population.6,7 Included in this project were 3,387 female breast 94 cancer cases, who were newly diagnosed between April 2004 and February 2013 at 95 Chonnam National University Hwasun Hospital, a cancer specified hospital in 96 Jeollanam-do province, South Korea.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-020-15046-w/MediaObjects/41467_2020_15046_MOESM1_ESM.pdf") coho:isSubCohortOf coho:COHO_0001185 coho:COHO_0002709)
