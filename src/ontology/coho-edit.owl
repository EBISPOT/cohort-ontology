AnnotationAssertion(rdfs:label coho:COHO_0000003 "AddNeuroMed Cohort"@en)
SubClassOf(coho:COHO_0000003 coho:COHO_0000000)
SubClassOf(coho:COHO_0000003 ObjectSomeValuesFrom(coho:has_data_collection_location <http://dbpedia.org/resource/Finland>))
