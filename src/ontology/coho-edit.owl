ObjectPropertyAssertion(Annotation(rdfs:comment "Subjects with prevalent or incident AF were identified from national registers as previously described14 , and cases with DNA were then matched in a 1:1 fashion to controls with DNA from the same cohort by sex, age (±1 year), and date of baseline exam (±1 year).") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf") coho:isSubCohortOf coho:COHO_0002087 coho:COHO_0000787)

# Individual: coho:COHO_0002088 (Malmö Preventive Project echo study)

AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0002088 "MPP-echo")
AnnotationAssertion(Annotation(oboInOwl:hasSynonymType obo:OMO_0003000) oboInOwl:hasRelatedSynonym coho:COHO_0002088 "MPP-RES UCG")
AnnotationAssertion(oboInOwl:hasRelatedSynonym coho:COHO_0002088 "Malmö Preventive Project-Re-examination echocardiography study")
AnnotationAssertion(oboInOwl:hasRelatedSynonym coho:COHO_0002088 "Malmö Preventive Project-Re-examination Study UCG")
AnnotationAssertion(oboInOwl:hasRelatedSynonym coho:COHO_0002088 "MPP Echo")
AnnotationAssertion(oboInOwl:hasRelatedSynonym coho:COHO_0002088 "MPP-Echo")
AnnotationAssertion(rdfs:label coho:COHO_0002088 "Malmö Preventive Project echo study"@en)
ClassAssertion(coho:COHO_0000000 coho:COHO_0002088)
ObjectPropertyAssertion(Annotation(rdfs:comment "Hence, our aim in this observational study was to investigate SNPs with documented association with diabetes and their further association with one of the earliest signs of left ventricular dysfunction (i.e. diastolic dysfunction) in two independent Swedish population UCG cohorts: the population‐based Malmö Preventive Project‐Re‐examination Study UCG (MPP‐RES UCG) and the VARA UCG.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7083427/fullTextXML") coho:isSubCohortOf coho:COHO_0002088 coho:COHO_0000787)

