############################
#   Annotation Properties
############################

# Annotation Property: <http://www.ebi.ac.uk/coho#EGA_subset> (EGA_subset)

AnnotationAssertion(obo:IAO_0000115 <http://www.ebi.ac.uk/coho#EGA_subset> "The cohorts that studies in the European Genome-phenome Archive (EGA) draw on."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/coho#EGA_subset> "EGA_subset")
SubAnnotationPropertyOf(<http://www.ebi.ac.uk/coho#EGA_subset> oboInOwl:SubsetProperty)

# Annotation Property: <http://www.ebi.ac.uk/coho#GWAS_subset> (GWAS_subset)

AnnotationAssertion(obo:IAO_0000115 <http://www.ebi.ac.uk/coho#GWAS_subset> "The cohorts that studies in the GWAS Catalog draw on."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/coho#GWAS_subset> "GWAS_subset")
SubAnnotationPropertyOf(<http://www.ebi.ac.uk/coho#GWAS_subset> oboInOwl:SubsetProperty)

# Annotation Property: <http://www.ebi.ac.uk/coho#PGS_subset> (PGS_subset)

AnnotationAssertion(obo:IAO_0000115 <http://www.ebi.ac.uk/coho#PGS_subset> "The cohorts that scores in the PGS Catalog draw on."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/coho#PGS_subset> "PGS_subset")
SubAnnotationPropertyOf(<http://www.ebi.ac.uk/coho#PGS_subset> oboInOwl:SubsetProperty)

# Annotation Property: <http://www.ebi.ac.uk/coho#MetaboLight_subset> (MetaboLight_subset)

AnnotationAssertion(obo:IAO_0000115 <http://www.ebi.ac.uk/coho#MetaboLight_subset> "The cohorts that studies in MetaboLights draw on."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/coho#MetaboLight_subset> "MetaboLight_subset")
SubAnnotationPropertyOf(<http://www.ebi.ac.uk/coho#MetaboLight_subset> oboInOwl:SubsetProperty)

# Annotation Property: <http://www.ebi.ac.uk/coho#PRIDE_subset> (PRIDE_subset)

AnnotationAssertion(obo:IAO_0000115 <http://www.ebi.ac.uk/coho#PRIDE_subset> "The cohorts that datasets in the PRIDE proteomics archive draw on."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/coho#PRIDE_subset> "PRIDE_subset")
SubAnnotationPropertyOf(<http://www.ebi.ac.uk/coho#PRIDE_subset> oboInOwl:SubsetProperty)

# Annotation Property: <http://www.ebi.ac.uk/coho#GEC_subset> (GEC_subset)

AnnotationAssertion(obo:IAO_0000115 <http://www.ebi.ac.uk/coho#GEC_subset> "The cohorts listed in the Global Exposome Cohort Catalogue, the Global Exposome Cohorts network of the MOLGENIS catalogue."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/coho#GEC_subset> "GEC_subset")
SubAnnotationPropertyOf(<http://www.ebi.ac.uk/coho#GEC_subset> oboInOwl:SubsetProperty)

# Annotation Property: <http://www.ebi.ac.uk/coho#IHCC_subset> (IHCC_subset)

AnnotationAssertion(obo:IAO_0000115 <http://www.ebi.ac.uk/coho#IHCC_subset> "The cohorts listed in the IHCC Cohort Atlas, the International Health Cohorts Consortium's directory of its member cohorts."@en)
AnnotationAssertion(rdfs:label <http://www.ebi.ac.uk/coho#IHCC_subset> "IHCC_subset")
SubAnnotationPropertyOf(<http://www.ebi.ac.uk/coho#IHCC_subset> oboInOwl:SubsetProperty)


# Annotation Property: coho:numberOfCases (numberOfCases)

AnnotationAssertion(obo:IAO_0000115 coho:numberOfCases "The number of cases a cohort reports, as its own design or profile paper or website states it: the participants with the condition under study in a case-control study. It is the number a source states, never one derived; the assertion carries that source, the sentence stating the number and what it counts. Asserted beside numberOfParticipants, or instead of it where no source states a total."@en)
AnnotationAssertion(rdfs:label coho:numberOfCases "numberOfCases"@en)
AnnotationPropertyRange(coho:numberOfCases xsd:integer)

# Annotation Property: coho:numberOfControls (numberOfControls)

AnnotationAssertion(obo:IAO_0000115 coho:numberOfControls "The number of controls a cohort reports, as its own design or profile paper or website states it: the participants without the condition under study in a case-control study. It is the number a source states, never one derived; the assertion carries that source, the sentence stating the number and what it counts. Asserted beside numberOfParticipants, or instead of it where no source states a total."@en)
AnnotationAssertion(rdfs:label coho:numberOfControls "numberOfControls"@en)
AnnotationPropertyRange(coho:numberOfControls xsd:integer)

# Annotation Property: coho:numberOfParticipants (numberOfParticipants)

AnnotationAssertion(obo:IAO_0000115 coho:numberOfParticipants "The number of participants a cohort reports: the people it enrolled or recruited, as its own design or profile paper or website states them, or, for a cohort aggregation, the pooled number of participants in its main analysis. It is the number a source states, never one computed, summed or inferred; the assertion carries that source, the sentence stating the number and what it counts. A definition never gives a size."@en)
AnnotationAssertion(rdfs:label coho:numberOfParticipants "numberOfParticipants"@en)
AnnotationPropertyRange(coho:numberOfParticipants xsd:integer)



############################
#   Object Properties
############################

# Object Property: coho:hasCohort (hasCohort)

AnnotationAssertion(obo:IAO_0000115 coho:hasCohort "A relation between a cohort aggregation and a cohort, or another cohort aggregation, whose participants or data it combines or compares."@en)
AnnotationAssertion(rdfs:label coho:hasCohort "hasCohort"@en)
ObjectPropertyDomain(coho:hasCohort coho:COHO_0000001)
ObjectPropertyRange(coho:hasCohort ObjectUnionOf(coho:COHO_0000000 coho:COHO_0000001))

# Object Property: coho:hasSubCohort (hasSubCohort)

AnnotationAssertion(obo:IAO_0000115 coho:hasSubCohort "A relation between a cohort and a cohort whose participants are drawn from it: a sub-study, a sub-sample or a component trial. The inverse of isSubCohortOf."@en)
AnnotationAssertion(rdfs:label coho:hasSubCohort "hasSubCohort"@en)
InverseObjectProperties(coho:hasSubCohort coho:isSubCohortOf)
ObjectPropertyDomain(coho:hasSubCohort coho:COHO_0000000)
ObjectPropertyRange(coho:hasSubCohort coho:COHO_0000000)

# Object Property: coho:has_data_collection_location (has_data_collection_location)

AnnotationAssertion(obo:IAO_0000115 coho:has_data_collection_location "A relation between a cohort and a geographical area in which its participants were recruited. Where the data were analysed or are stored does not count."@en)
AnnotationAssertion(rdfs:label coho:has_data_collection_location "has_data_collection_location"@en)
TransitiveObjectProperty(coho:has_data_collection_location)
ObjectPropertyRange(coho:has_data_collection_location obo:NCIT_C16632)

# Object Property: coho:has_disease_of_interest (has_disease_of_interest)

AnnotationAssertion(obo:IAO_0000115 coho:has_disease_of_interest "A relation between a cohort and a disease it is about: the disease its participants have, the disease they were selected for their risk of, or the disease a population study was set up to study. Asserted only through its sub-properties, which say which of these it is, as a type of the cohort (has_patients_with some D) carrying the sentence that shows the recruitment basis or purpose, its source and the disease as the source names it. A general population cohort, a biobank of unselected donors or a cohort with a broad purpose has no disease of interest."@en)
AnnotationAssertion(rdfs:label coho:has_disease_of_interest "has_disease_of_interest"@en)
ObjectPropertyDomain(coho:has_disease_of_interest ObjectUnionOf(coho:COHO_0000000 coho:COHO_0000001))

# Object Property: coho:has_exposure_of_interest (has_exposure_of_interest)

AnnotationAssertion(obo:IAO_0000115 coho:has_exposure_of_interest "A relation between a cohort and an environmental exposure it is about: the exposure its participants were selected for, or the exposure the cohort was designed to study. Asserted only through its sub-properties, which say which of these it is, as a type of the cohort (has_participants_with_exposure some E) carrying the sentence that shows the recruitment basis or purpose, its source and the exposure as the source names it. A general population, biobank, disease or trial cohort that measures exposures among many other variables has no exposure of interest, and a genotype, a medication, a medical procedure or socio-economic status by itself is not an exposure here."@en)
AnnotationAssertion(rdfs:label coho:has_exposure_of_interest "has_exposure_of_interest"@en)
ObjectPropertyDomain(coho:has_exposure_of_interest ObjectUnionOf(coho:COHO_0000000 coho:COHO_0000001))

# Object Property: coho:has_participants_at_risk_of (has_participants_at_risk_of)

AnnotationAssertion(obo:IAO_0000115 coho:has_participants_at_risk_of "A relation between a cohort and a disease its participants were selected for their risk of: relatives of patients, carriers of a mutation, people with a pre-disease state, or a group chosen for its high risk of the disease."@en)
AnnotationAssertion(rdfs:label coho:has_participants_at_risk_of "has_participants_at_risk_of"@en)
SubObjectPropertyOf(coho:has_participants_at_risk_of coho:has_disease_of_interest)

# Object Property: coho:has_participants_with_exposure (has_participants_with_exposure)

AnnotationAssertion(obo:IAO_0000115 coho:has_participants_with_exposure "A relation between a cohort and an environmental exposure its participants were selected for, or are followed for: residents of a contaminated or disaster area, survivors of an event, workers in an industry or trade, smokers recruited as smokers, veterans of a deployment, or a birth cohort exposed to a famine."@en)
AnnotationAssertion(rdfs:label coho:has_participants_with_exposure "has_participants_with_exposure"@en)
SubObjectPropertyOf(coho:has_participants_with_exposure coho:has_exposure_of_interest)

# Object Property: coho:has_patients_with (has_patients_with)

AnnotationAssertion(obo:IAO_0000115 coho:has_patients_with "A relation between a cohort and a disease its participants have: a patient series, a disease registry, the cases of a case-control study, the participants of a trial of the condition, or a biobank of patients with the disease."@en)
AnnotationAssertion(rdfs:label coho:has_patients_with "has_patients_with"@en)
SubObjectPropertyOf(coho:has_patients_with coho:has_disease_of_interest)

# Object Property: coho:isCohortOf (isCohortOf)

AnnotationAssertion(obo:IAO_0000115 coho:isCohortOf "A relation between a cohort, or a cohort aggregation, and a cohort aggregation that combines or compares its participants or data. The inverse of hasCohort."@en)
AnnotationAssertion(rdfs:label coho:isCohortOf "isCohortOf"@en)
InverseObjectProperties(coho:hasCohort coho:isCohortOf)
ObjectPropertyDomain(coho:isCohortOf ObjectUnionOf(coho:COHO_0000000 coho:COHO_0000001))
ObjectPropertyRange(coho:isCohortOf coho:COHO_0000001)

# Object Property: coho:isSubCohortOf (isSubCohortOf)

AnnotationAssertion(obo:IAO_0000115 coho:isSubCohortOf "A relation between a cohort and the cohort its participants are drawn from, of which it is a sub-study, a sub-sample or a component trial."@en)
AnnotationAssertion(rdfs:label coho:isSubCohortOf "isSubCohortOf"@en)
ObjectPropertyDomain(coho:isSubCohortOf coho:COHO_0000000)
ObjectPropertyRange(coho:isSubCohortOf coho:COHO_0000000)



# Object Property: coho:is_designed_to_study_exposure (is_designed_to_study_exposure)

AnnotationAssertion(obo:IAO_0000115 coho:is_designed_to_study_exposure "A relation between a cohort and an environmental exposure that its stated purpose or design centres on measuring, with its effects, its participants not being selected for the exposure: an exposome cohort, a birth cohort built around prenatal exposure to a pollutant, an air pollution cohort, a diet and cancer cohort, or an occupational health cohort."@en)
AnnotationAssertion(rdfs:label coho:is_designed_to_study_exposure "is_designed_to_study_exposure"@en)
SubObjectPropertyOf(coho:is_designed_to_study_exposure coho:has_exposure_of_interest)

# Object Property: coho:is_population_study_of (is_population_study_of)

AnnotationAssertion(obo:IAO_0000115 coho:is_population_study_of "A relation between a cohort and a disease, or a family of diseases, that a general population or birth cohort was set up to study, its participants not being selected for having the disease or for their risk of it."@en)
AnnotationAssertion(rdfs:label coho:is_population_study_of "is_population_study_of"@en)
SubObjectPropertyOf(coho:is_population_study_of coho:has_disease_of_interest)



############################
#   Classes
############################

# Class: coho:COHO_0000000 (cohort)

AnnotationAssertion(obo:IAO_0000115 coho:COHO_0000000 "A group of individuals grouped together based on a shared characteristic or property of interest.")
AnnotationAssertion(oboInOwl:hasDbXref coho:COHO_0000000 "EFO:0004445")
AnnotationAssertion(oboInOwl:hasDbXref coho:COHO_0000000 "NCIT:C61512")
AnnotationAssertion(rdfs:label coho:COHO_0000000 "cohort"@en)

# Class: coho:COHO_0000001 (cohort aggregation)

AnnotationAssertion(obo:IAO_0000115 coho:COHO_0000001 "A study, project or consortium that compares multiple cohorts.")
AnnotationAssertion(rdfs:label coho:COHO_0000001 "cohort aggregation"@en)
SubClassOf(coho:COHO_0000001 ObjectMinCardinality(2 coho:hasCohort coho:COHO_0000000))

# Class: coho:TEMP_temporary_unclassified (temporary unclassified)

AnnotationAssertion(obo:IAO_0000115 coho:TEMP_temporary_unclassified "A holding class for a cohort individual that has not yet been classified as a cohort or a cohort aggregation. Nothing should remain here."@en)
AnnotationAssertion(rdfs:label coho:TEMP_temporary_unclassified "temporary unclassified"@en)


