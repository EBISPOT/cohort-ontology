# Individual: <http://www.ebi.ac.uk/coho/COHO_0001179> (<http://www.ebi.ac.uk/coho/COHO_0001179>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000116> "unrelated F508del homozygotes at lung-function extremes genotyped for the first consortium GWAS (extremes arm only)") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2995003/unicode") Annotation(rdfs:comment "The extremes of phenotype study collected and genotyped 1,203 unrelated CF patients who (a) were homozygous for F508del, the most common CFTR mutation and (b) had lung function at the extremes of the population distribution.") <http://www.ebi.ac.uk/coho/numberOfParticipants> <http://www.ebi.ac.uk/coho/COHO_0001179> "1203"^^xsd:integer)

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001180> (<http://www.ebi.ac.uk/coho/COHO_0001180>)

