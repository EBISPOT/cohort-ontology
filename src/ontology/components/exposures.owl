ClassAssertion(Annotation(rdfs:comment "Assessing, understanding and modifying nutritional status, eating habits and physical activity in European adolescents: the HELENA (Healthy Lifestyle in Europe by Nutrition in Adolescence) Study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17617932+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "eating habits") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0001852)
ClassAssertion(Annotation(rdfs:comment "Assessing, understanding and modifying nutritional status, eating habits and physical activity in European adolescents: the HELENA (Healthy Lifestyle in Europe by Nutrition in Adolescence) Study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17617932+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "physical activity") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000039) coho:COHO_0001852)
ClassAssertion(Annotation(rdfs:comment "Assessing, understanding and modifying nutritional status, eating habits and physical activity in European adolescents: the HELENA (Healthy Lifestyle in Europe by Nutrition in Adolescence) Study.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17617932+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "nutritional status") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9001695) coho:COHO_0001852)
ClassAssertion(Annotation(rdfs:comment "The HELIAD is a population-based, multidisciplinary, collaborative study designed to estimate the prevalence and incidence of AD, other dementias, mild cognitive impairment, and other neuropsychiatric conditions of aging in the Greek population and to investigate associations between nutrition and cognitive dysfunction/age-related neuropsychiatric diseases in this Mediterranean population.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24993387+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "nutrition") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9001695) coho:COHO_0001853)
ClassAssertion(Annotation(rdfs:comment "The HERITAGE family study (HEalth, RIsk factors, exercise Training And GEnetics) will document the role of the genotype in the cardiovascular, metabolic, and hormonal responses to aerobic exercise training.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A7674877+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "aerobic exercise training") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000002) coho:COHO_0001856)
ClassAssertion(Annotation(rdfs:comment "Our primary hypothesis was that in patients with stable heart failure, regular structured exercise training, when added to usual, evidence-based care in accordance with published guidelines, would significantly reduce the incidence of a combined end point of all-cause mortality or all-cause hospitalization.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2916661/") Annotation(obo:IAO_0000116 "regular structured exercise training") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000002) coho:COHO_0001857)
ClassAssertion(Annotation(rdfs:comment "All models were fit using data from a lung cancer study of 1275 cases and 1269 controls that has focused on gene-smoking relationships.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC1435718/") Annotation(obo:IAO_0000116 "smoking") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000013) coho:COHO_0001865)
ClassAssertion(Annotation(rdfs:comment "Probands were eligible for study inclusion if they met the current DSM-IV criteria for AD and if all four grandparents had been born in Ireland, Northern Ireland, Scotland, Wales, or England.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2665790/") Annotation(obo:IAO_0000116 "alcohol dependence") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000009) coho:COHO_0001887)
ClassAssertion(Annotation(rdfs:comment "The present study seeks to identify the factors important in the development of depression during medical internship and to utilize internship as a stress model to study subjects before and after the onset of a major stressor and assess the moderating effect of 5-HTTLPR on the development of depression.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4036806/") Annotation(obo:IAO_0000116 "internship stress") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_0001591) coho:COHO_0001910)
ClassAssertion(Annotation(rdfs:comment "This gives us an unprecedented opportunity to probe the correlation, if any, between genetic and epigenetic changes in the genome and rapid changes in lifestyle.") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1007/s11568-011-9157-2") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0001919)
