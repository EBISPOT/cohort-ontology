ClassAssertion(Annotation(rdfs:comment "The NINFEA cohort is an Internet-based birth cohort established in Italy with the aim of investigating the effects of early life exposures on the health of newborns, infants, adolescents and adults.") Annotation(oboInOwl:hasDbXref "https://link.springer.com/article/10.1007/s10654-007-9194-2") Annotation(obo:IAO_0000116 "early life exposures") Annotation(obo:IAO_0000116 "pre-natal and early post-natal exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002605)
