ClassAssertion(Annotation(rdfs:comment "The Lung Health Study is a randomized clinical trial designed to determine whether a smoking intervention program and prescription of an inhaled bronchodilator can reduce the annual rate of decline of FEV1 (FEV1 slope) in cigarette smokers with mild to moderate airflow limitation.") Annotation(oboInOwl:hasDbXref "PMID:2048803") Annotation(obo:IAO_0000116 "cigarette smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0001998)
