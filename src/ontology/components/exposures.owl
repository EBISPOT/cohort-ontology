ClassAssertion(Annotation(rdfs:comment "Inclusion in the study was made at 3-4 months of age. At that time, and before induction of allergic disease/ asthma of the child, a questionnaire focused on exposure, genetics and socio-economic factors was answered. Settled dust was sampled for later analysis of furred animal and mite allergens.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12688617+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "exposure at home and day care") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0600002) coho:COHO_0000037)
ClassAssertion(Annotation(rdfs:comment "Inclusion in the study was made at 3-4 months of age. At that time, and before induction of allergic disease/ asthma of the child, a questionnaire focused on exposure, genetics and socio-economic factors was answered. Settled dust was sampled for later analysis of furred animal and mite allergens.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12688617+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "furred animal and mite allergens") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0900047) coho:COHO_0000037)
ClassAssertion(Annotation(rdfs:comment "Inviting current and former smokers (quit <or= 10 years ago) who smoked >15 cigarettes/day during >25 years or >10 cigarettes/day during >30 years was most optimal.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17131307+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "smoking exposure (years smoked, cigarettes/day, years quit)") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0000058)
ClassAssertion(Annotation(rdfs:comment "The European Prospective Investigation into Cancer and Nutrition (EPIC) is an ongoing multi-centre prospective cohort study designed to investigate the relationship between nutrition and cancer, with the potential for studying other diseases as well.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12639222+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0000065)
ClassAssertion(Annotation(rdfs:comment "The European Prospective Investigation into Cancer and Nutrition (EPIC) is an ongoing multi-centre prospective cohort study designed to investigate the relationship between nutrition and cancer, with the potential for studying other diseases as well.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12639222+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0000065)
