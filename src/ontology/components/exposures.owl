ClassAssertion(Annotation(rdfs:comment "The \"GHRAS\" study is aimed at investigating the interactions among socioeconomic, lifestyle, dietary, psychological, and biochemical factors determining the health status of elderly Greeks.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18376349+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "lifestyle factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0001801)
