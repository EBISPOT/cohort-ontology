ClassAssertion(Annotation(rdfs:comment "With 4,545 cases and 4,173 controls, the GICC Study confers the opportunity to evaluate both environmental exposures and genetic variation while accounting for tumor subtype.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4706682/") Annotation(obo:IAO_0000116 "environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0001803)
ClassAssertion(Annotation(rdfs:comment "The cohort will provide data that will be influential in establishing the role of nutrition in metabolic diseases with multi-omics.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11078596/fullTextXML") Annotation(obo:IAO_0000116 "nutrition") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9001695) coho:COHO_0001817)
ClassAssertion(Annotation(rdfs:comment "The measurements included blood pressure responses to the cold pressor stress test and to a high salt diet, triglyceride excursion in response to a high-fat challenge, and response in platelet aggregation to aspirin therapy.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18440328+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "high salt diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0900473) coho:COHO_0001839)
