ClassAssertion(Annotation(rdfs:comment "The aim of one such study, the Pathways Study, is to examine the effect on recurrence and survival of 1) lifestyle factors such as diet, physical activity, quality of life, and use of complementary and alternative medicine (CAM) and 2) molecular factors such as genetic polymorphisms involved in metabolism of chemotherapeutic agents.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2581640/") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002237)
ClassAssertion(Annotation(rdfs:comment "The aim of one such study, the Pathways Study, is to examine the effect on recurrence and survival of 1) lifestyle factors such as diet, physical activity, quality of life, and use of complementary and alternative medicine (CAM) and 2) molecular factors such as genetic polymorphisms involved in metabolism of chemotherapeutic agents.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2581640/") Annotation(obo:IAO_0000116 "physical activity") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000039) coho:COHO_0002237)
ClassAssertion(Annotation(rdfs:comment "The Proyecto Genes Candidatos en Asma (PGCA) study is a population-based study conducted by the Institute for Immunological Research of The University of Cartagena (Colombia) to identify environmental and genetic risk factors for asthma and allergies [16, 19, 21, 22].") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "environmental risk factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002249)
ClassAssertion(Annotation(rdfs:comment "The second group of subjects came from the Pittsburgh Lung Screening Study (PLuSS), a Pittsburgh-based CT lung cancer screening study that enrolled, between 2002 and 2005, 50-79 year-old current or former cigarette smokers (≥half pack/day for ≥25 years, quit ≤10 years).") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4636453/unicode") Annotation(obo:IAO_0000116 "cigarette smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0002262)
ClassAssertion(Annotation(rdfs:comment "These international multicenter prospective trials aimed to investigate the effect of training load and genotype on the variability of structural, functional, and electrical exercise-induced cardiac remodeling in elite competitive endurance athletes, and the full study protocol has been detailed.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11062611/fullTextXML") Annotation(obo:IAO_0000116 "training load") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000002) coho:COHO_0002280)
ClassAssertion(Annotation(rdfs:comment "These international multicenter prospective trials aimed to investigate the effect of training load and genotype on the variability of structural, functional, and electrical exercise-induced cardiac remodeling in elite competitive endurance athletes, and the full study protocol has been detailed.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11062611/fullTextXML") Annotation(obo:IAO_0000116 "training load") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000002) coho:COHO_0002287)
ClassAssertion(Annotation(rdfs:comment "The Prostate Cancer & Environment Study (PROtEuS), described previously (Blanc-Lapierre et al., 2015), is a population-based case-control study conducted in Montreal, Canada, to assess the role of environmental and lifestyle factors in prostate cancer risk.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6131535/fullTextXML") Annotation(obo:IAO_0000116 "environmental and lifestyle factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002292)
ClassAssertion(Annotation(rdfs:comment "The Pumwani sex worker cohort was established in Nairobi, Kenya, in 1985 (27, 48) and has become well known for a small group of women who remain seronegative and PCR negative to HIV despite repeated exposure through active high-risk sex work.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3486297/") Annotation(obo:IAO_0000116 "repeated exposure to HIV through active high-risk sex work") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_3000289) coho:COHO_0002298)
ClassAssertion(Annotation(rdfs:comment "Eligible participants are non-Hispanic African American or White adults, 18 years of age or older who smoke 3–20 cigarettes per day on 25 days or more during the preceding month, and are interested in quitting smoking, taking varenicline for 3 months, have a functioning telephone, and are willing to complete all study-related requirements.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4818177/unicode") Annotation(obo:IAO_0000116 "cigarette smoking, 3–20 cigarettes per day") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0002301)
ClassAssertion(Annotation(rdfs:comment "The Queensland Familial Melanoma Project was undertaken to investigate (a) the role of genetic susceptibility as indicated by skin type, pigmentation and the prevalence of naevi and (b) exposure to solar ultraviolet radiation, and their interaction in the aetiology of familial melanoma.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8791274+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "solar ultraviolet radiation") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000006) coho:COHO_0002302)
ClassAssertion(Annotation(rdfs:comment "SYNERGIQC originates from the Quebec lung cancer screening program [17], a provincial multicenter pilot-study launched in 2021 for ever-smokers aged 55–74.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13096907/fullTextXML") Annotation(obo:IAO_0000116 "ever-smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000029) coho:COHO_0002304)
ClassAssertion(Annotation(rdfs:comment "Nested within the birth cohort is a case-control study, which was created to collect information on home environmental exposures from detailed surveys and home dust sampling") Annotation(oboInOwl:hasDbXref "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id=19416140&retmode=xml") Annotation(obo:IAO_0000116 "home environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002338)
ClassAssertion(Annotation(rdfs:comment "Our study is the largest population-based study of breast cancer survival to date and was specifically designed to evaluate the influence of soy food intake on breast cancer outcomes.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2874068/") Annotation(obo:IAO_0000116 "soy food intake") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070183) coho:COHO_0002347)
ClassAssertion(Annotation(rdfs:comment "We examined the associations of constitutional risk factors and sun exposure with the risks of three types of skin cancer simultaneously and evaluated the interaction between constitutional susceptibility and sun exposure in a nested case-control study within the Nurses' Health Study [200 melanoma, 275 squamous cell carcinoma (SCC), and 283 basal cell carcinoma (BCC) cases, and 804 controls].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16943234+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "sun exposure") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000061) coho:COHO_0002352)
ClassAssertion(Annotation(rdfs:comment "We investigated the association between lifestyle and prostate cancer risk among Caucasian and African– American men, separately.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5521001/") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0002355)
ClassAssertion(Annotation(rdfs:comment "The SKOT study was funded by the Danish Directorate for Food, Fisheries and Agri Business (grant no. 3304-FSE-06-0503-1) as part of the project “Complementary and young child feeding (CYCF) – impact on short and long term development of health”.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5493126/fullTextXML") Annotation(obo:IAO_0000116 "complementary and young child feeding") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002388)
ClassAssertion(Annotation(rdfs:comment "Our purpose was to evaluate whether saturated fat intake increases the risk of ovarian cancer development.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8072035+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "saturated fat intake") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002400)
ClassAssertion(Annotation(rdfs:comment "The intervention is unique in that it began in infancy and continued for 20 years, with personalized dietary counseling provided to children and their parents in the intervention group.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13092225/fullTextXML") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002415)
