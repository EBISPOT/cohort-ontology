ClassAssertion(Annotation(rdfs:comment "Biomarkers include: organochlorine compounds and brominated compounds, perfluoroalkyl substances and metals in blood, and non-persistent chemicals (phthalate metabolites, phenols, organophosphate pesticide metabolites and cotinine) in urine samples (table 3).") Annotation(oboInOwl:hasDbXref "PMID:30206078") Annotation(obo:IAO_0000116 "phthalate metabolites") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000906) coho:COHO_0000827)
