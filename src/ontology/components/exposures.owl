ClassAssertion(Annotation(rdfs:comment "We inquired into the association between occupational exposure to glyphosate and risk of lymphoma subtypes in a multicenter case-control study conducted in Italy.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8082925/fullTextXML") Annotation(obo:IAO_0000116 "occupational exposure to glyphosate") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9002138) coho:COHO_0001940)
