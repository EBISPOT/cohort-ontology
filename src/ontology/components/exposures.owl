ClassAssertion(Annotation(rdfs:comment "The intervention is unique in that it began in infancy and continued for 20 years, with personalized dietary counseling provided to children and their parents in the intervention group.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13092225/fullTextXML") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002703)
ClassAssertion(Annotation(rdfs:comment "CLIC provides a unique opportunity to fill gaps in knowledge about the role of environmental and genetic risk factors, critical windows of exposure, the effects of gene–environment interactions and associations among specific leukemia subtypes in different ethnic groups.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3652629/") Annotation(obo:IAO_0000116 "environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002711)
ClassAssertion(Annotation(rdfs:comment "Australia, Aus-ALL [13,64,67] Telethon Institute for Child Health Research (Milne E.; Armstrong B.) 2003–2007 Case–control study; Frequency matching Hospitals (nationwide) Age 0–14 yrs; Incident ALL; No previous cancer; Biological mother available and at least one parent speaks English; Resident in Australia RDD Age 0–14 yrs; Biological mother available and at least one parent speaks English; Resident in Australia Questionnaire E, G, GxE") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3652629/") Annotation(obo:IAO_0000116 "environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002712)
ClassAssertion(Annotation(rdfs:comment "The International Consortium of Bladder Cancer (ICBC; http://dceg.cancer.gov/icbc/) was formed in 2005 to facilitate the pooling of comparable data on environmental and genetic risk factors across studies in order to overcome the limited statistical power of individual studies.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2782435/") Annotation(obo:IAO_0000116 "environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002717)
ClassAssertion(Annotation(rdfs:comment "We examined the use of cellular telephones in a case-control study of intracranial tumors of the nervous system conducted between 1994 and 1998.") Annotation(oboInOwl:hasDbXref "https://eutils.ncbi.nlm.nih.gov/entrez/eutils/efetch.fcgi?db=pubmed&id=11150357&retmode=xml") Annotation(obo:IAO_0000116 "use of hand-held cellular telephones") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000054) coho:COHO_0002721)
ClassAssertion(Annotation(rdfs:comment "In the prospective cohort GENEPSO, which aims at assessing environmental and lifestyle risk factors, BRCA1/2 mutation carriers are followed over time to observe characteristics of subjects who are developing either primary or secondary cancer.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8320036/fullTextXML") Annotation(obo:IAO_0000116 "environmental and lifestyle risk factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002723)
ClassAssertion(Annotation(rdfs:comment "Those randomized to nicotinamide arm received daily nicotinamide to the mother (250 mg pills months 0 to 6) and to the child (100 mg sachets months 6 to 18).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34582462+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "nicotinamide") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0900090) coho:COHO_0002730)
ClassAssertion(Annotation(rdfs:comment "To determine the impact of different amounts and types (flavonoid-rich versus flavonoid-poor) of fruit and vegetables on heart disease risk factors in an 'at risk' group.") Annotation(oboInOwl:hasDbXref "https://www.isrctn.com/api/query/format/default?q=FLAVURS") Annotation(obo:IAO_0000116 "flavonoid-rich versus flavonoid-poor fruit and vegetables") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070232) coho:COHO_0002732)
ClassAssertion(Annotation(rdfs:comment "To analyze the dynamics of the human metabolome in response to environmental stimuli, we submitted 15 young healthy male volunteers to a highly controlled 4 d challenge protocol, including 36 h fasting, oral glucose and lipid tests, liquid test meals, physical exercise, and cold stress.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22426117+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cold stress") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0001057) coho:COHO_0002733)
ClassAssertion(Annotation(rdfs:comment "To analyze the dynamics of the human metabolome in response to environmental stimuli, we submitted 15 young healthy male volunteers to a highly controlled 4 d challenge protocol, including 36 h fasting, oral glucose and lipid tests, liquid test meals, physical exercise, and cold stress.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22426117+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "36 h fasting") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000118) coho:COHO_0002733)
ClassAssertion(Annotation(rdfs:comment "To analyze the dynamics of the human metabolome in response to environmental stimuli, we submitted 15 young healthy male volunteers to a highly controlled 4 d challenge protocol, including 36 h fasting, oral glucose and lipid tests, liquid test meals, physical exercise, and cold stress.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22426117+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "physical exercise") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000002) coho:COHO_0002733)
ClassAssertion(Annotation(rdfs:comment "The following core epidemiological and clinical data were required from all participants in the study: (1) demographic details (age, sex, ethnic origin, city and place of residence, and educational status); (2) history of tobacco use, including frequency and intensity; (3) history of alcohol consumption, including frequency and intensity; (4) anthropometric data (height, weight at diagnosis); (5) medical history of diabetes, hypertension, and acid reflux/heartburn for PDAC, RCC, and GEJ, respectively; and (6) consumption of hot drinks (for ESCC) or red and processed meat (for CRC).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10943582/fullTextXML") Annotation(obo:IAO_0000116 "alcohol consumption") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0001082) coho:COHO_0002737)
ClassAssertion(Annotation(rdfs:comment "The following core epidemiological and clinical data were required from all participants in the study: (1) demographic details (age, sex, ethnic origin, city and place of residence, and educational status); (2) history of tobacco use, including frequency and intensity; (3) history of alcohol consumption, including frequency and intensity; (4) anthropometric data (height, weight at diagnosis); (5) medical history of diabetes, hypertension, and acid reflux/heartburn for PDAC, RCC, and GEJ, respectively; and (6) consumption of hot drinks (for ESCC) or red and processed meat (for CRC).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10943582/fullTextXML") Annotation(obo:IAO_0000116 "tobacco use") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000041) coho:COHO_0002737)
ClassAssertion(Annotation(rdfs:comment "Consumption of a diet high in bioactive-rich foods for two weeks will increase gut microbial diversity in healthy participants compared to a 2-week diet low in bioactive-rich foods and will additionally affect markers of metabolic health.") Annotation(oboInOwl:hasDbXref "https://www.isrctn.com/api/query/format/default?q=ISRCTN14510401") Annotation(obo:IAO_0000116 "diet high in bioactive-rich foods") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000068) coho:COHO_0002745)
ClassAssertion(Annotation(rdfs:comment "The primary objective of the study, based on the random assignment, is to compare HIV transmission rates and under-2 year mortality rates in children who abruptly wean at four months of age versus children who are weaned according to local practice.") Annotation(oboInOwl:hasDbXref "https://clinicaltrials.gov/api/v2/studies/NCT00310726") Annotation(obo:IAO_0000116 "abrupt weaning at 4 months versus continued breastfeeding") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070224) coho:COHO_0002748)
)
