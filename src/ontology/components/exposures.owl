ClassAssertion(Annotation(rdfs:comment "A total of 947 adults with dyslipidemia (STRRIDE I, STRRIDE AT/RT) or prediabetes (STRRIDE-PD) were randomized to either inactive control or to 1 of 10 exercise interventions, ranging from doses of 8-23 kcal/kg/week, intensities of 50%-75% V˙O2 peak, and durations of 6-8 months.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37492634+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "caloric restriction") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000065) coho:COHO_0000983)
