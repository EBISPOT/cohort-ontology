ClassAssertion(Annotation(rdfs:comment "The objectives of the Genetic Epidemiology Network of Salt Sensitivity (GenSalt) are to localize and identify genes related to blood pressure (BP) responses to dietary sodium and potassium intervention.") Annotation(oboInOwl:hasDbXref "PMID:17443206") Annotation(obo:IAO_0000116 "dietary sodium") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070218) coho:COHO_0000540)
