ClassAssertion(Annotation(rdfs:comment "Study designs used include surveys and case-control studies making possible the comparison of prevalence and risk factors for asthma and other allergic diseases between urban and rural environments (the Ecuador study) and a longitudinal study of the effects of early life exposures of an urban population on asthma and other allergic diseases (the Salvador study).") Annotation(oboInOwl:hasDbXref "PMID:16796729") Annotation(obo:IAO_0000116 "intestinal helminth and parasitic infections") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_3000000) coho:COHO_0001402)
