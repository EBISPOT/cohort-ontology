ClassAssertion(Annotation(rdfs:comment "Biomarkers include: organochlorine compounds and brominated compounds, perfluoroalkyl substances and metals in blood, and non-persistent chemicals (phthalate metabolites, phenols, organophosphate pesticide metabolites and cotinine) in urine samples (table 3).") Annotation(oboInOwl:hasDbXref "PMID:30206078") Annotation(obo:IAO_0000116 "perfluoroalkyl substances") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9002160) coho:COHO_0000827)
ClassAssertion(Annotation(rdfs:comment "LISA The influence of Life-style factors on the development of the Immune System and Allergies in East and West Germany PLUS the influence of traffic emissions and genetics (LISAplus) Study is a population based birth cohort study.") Annotation(oboInOwl:hasDbXref "PMID:35378236") Annotation(oboInOwl:hasDbXref "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(obo:IAO_0000116 "life-style factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0000831)
ClassAssertion(Annotation(rdfs:comment "LISA The influence of Life-style factors on the development of the Immune System and Allergies in East and West Germany PLUS the influence of traffic emissions and genetics (LISAplus) Study is a population based birth cohort study.") Annotation(oboInOwl:hasDbXref "PMID:35378236") Annotation(oboInOwl:hasDbXref "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(obo:IAO_0000116 "traffic emissions") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_7000156) coho:COHO_0000831)
ClassAssertion(Annotation(rdfs:comment "We present the protocol of a large population-based case-control study of 5 common tumors in Spain (MCC-Spain) that evaluates environmental exposures and genetic factors.") Annotation(oboInOwl:hasDbXref "PMID:25613680") Annotation(obo:IAO_0000116 "environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0000833)
ClassAssertion(Annotation(rdfs:comment "We investigated the extent to which the association between drinking water arsenic exposures and bladder cancer risk is modified by genetic variants using data from the New England Bladder Cancer (NEBC) study, a population-based case–control study conducted in a region known to have elevated risk for bladder cancer from arsenic in drinking water.") Annotation(oboInOwl:hasDbXref "PMID:40570095") Annotation(obo:IAO_0000116 "arsenic in drinking water") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0080000) coho:COHO_0000836)
ClassAssertion(Annotation(rdfs:comment "Index cases from these families, their full siblings and parents were recruited for three coordinated studies: (i) the NAG (Nicotine Addiction Genetics) Study which ascertained heavy smoking index cases; (ii) the OZALC-EDAC study, which ascertained index cases with a history of alcohol dependence or scoring above the 85th centile for heaviness of drinking factor score") Annotation(oboInOwl:hasDbXref "PMID:21529783") Annotation(obo:IAO_0000116 "heaviness of drinking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_0001082) coho:COHO_0000841)
ClassAssertion(Annotation(rdfs:comment "Index cases from these families, their full siblings and parents were recruited for three coordinated studies: (i) the NAG (Nicotine Addiction Genetics) Study which ascertained heavy smoking index cases; (ii) the OZALC-EDAC study, which ascertained index cases with a history of alcohol dependence or scoring above the 85th centile for heaviness of drinking factor score") Annotation(oboInOwl:hasDbXref "PMID:21529783") Annotation(obo:IAO_0000116 "heavy smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000029) coho:COHO_0000841)
ClassAssertion(Annotation(rdfs:comment "PNAT2 participants were eligible adult smokers (report smoking at least 10 CPD) from four clinical sites in North America and were randomized to placebo, nicotine patch, or varenicline based on their NMR at intake.") Annotation(oboInOwl:hasDbXref "PMID:32157176") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41380-020-0702-z/MediaObjects/41380_2020_702_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "cigarette smoking, at least 10 cigarettes per day") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0000844)
ClassAssertion(Annotation(rdfs:comment "using existing data from the US Servicemen's Testicular Tumor Environmental and Endocrine Determinants (STEED) case-control study") Annotation(oboInOwl:hasDbXref "PMID:22343618") Annotation(obo:IAO_0000116 "environmental determinants of testicular germ cell tumours") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0000851)
ClassAssertion(Annotation(rdfs:comment "The European IDEFICS (Identification and prevention of Dietary- and lifestyle-induced health EFfects In Children and infantS)/I.Family cohort is a multi-centre population-based children’s study that aimed to identify risk factors for diet- and lifestyle-related diseases, with a focus on childhood overweight and metabolic disorders [14, 15].") Annotation(oboInOwl:hasDbXref "PMID:37420130") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0000871)
ClassAssertion(Annotation(rdfs:comment "The European IDEFICS (Identification and prevention of Dietary- and lifestyle-induced health EFfects In Children and infantS)/I.Family cohort is a multi-centre population-based children’s study that aimed to identify risk factors for diet- and lifestyle-related diseases, with a focus on childhood overweight and metabolic disorders [14, 15].") Annotation(oboInOwl:hasDbXref "PMID:37420130") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0000871)
ClassAssertion(Annotation(rdfs:comment "It aimed to examine the feasibility, effectiveness and sustainability of a coherent set of intervention modules addressing diet, physical activity and stress.") Annotation(oboInOwl:hasDbXref "PMID:28040744") Annotation(obo:IAO_0000116 "physical activity") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000039) coho:COHO_0000871)
ClassAssertion(Annotation(rdfs:comment "In the discovery phase, we analyzed 315,450 tagging SNPs in 1,154 current and former (ever) smoking cases of European ancestry and 1,137 frequency-matched, ever-smoking controls from Houston, Texas.") Annotation(oboInOwl:hasDbXref "PMID:18385676") Annotation(obo:IAO_0000116 "cigarette smoking (current and former smokers)") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0000874)
ClassAssertion(Annotation(rdfs:comment "Originated from a monitoring study on cardiovascular disease risk factors, the Doetinchem Cohort study has been expanded to a study on lifestyle and other determinants of chronic conditions and ageing, with individual data covering 25 years.") Annotation(oboInOwl:hasDbXref "PMID:29040549") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0000906)
ClassAssertion(Annotation(rdfs:comment "GALA II and SAGE are two clinic-based case-control studies focused on untangling the genetic and environmental basis of childhood-onset asthma disease in minority ethnic groups of the United States of America [22].") Annotation(oboInOwl:hasDbXref "PMID:34834492") Annotation(obo:IAO_0000116 "environmental basis of childhood-onset asthma") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0000907)
ClassAssertion(Annotation(rdfs:comment "GEMS and EIMS are nationwide case-control studies examining the genetic and environmental risk factors for prevalent and incident MS, respectively.") Annotation(oboInOwl:hasDbXref "PMID:38630618") Annotation(obo:IAO_0000116 "environmental exposures and lifestyle factors") Annotation(obo:IAO_0000116 "environmental risk factors for MS") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0000909)
ClassAssertion(Annotation(rdfs:comment "The aim of the KOALA Birth Cohort Study in the Netherlands is to identify factors that influence the clinical expression of atopic disease with a main focus on lifestyle (e.g., anthroposophy, vaccinations, antibiotics, dietary habits, breastfeeding and breast milk composition, intestinal microflora composition, infections during the first year of life, and gene-environment interaction).") Annotation(oboInOwl:hasDbXref "PMID:16343090") Annotation(obo:IAO_0000116 "breastfeeding and breast milk composition") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070224) coho:COHO_0000922)
ClassAssertion(Annotation(rdfs:comment "The aim of the KOALA Birth Cohort Study in the Netherlands is to identify factors that influence the clinical expression of atopic disease with a main focus on lifestyle (e.g., anthroposophy, vaccinations, antibiotics, dietary habits, breastfeeding and breast milk composition, intestinal microflora composition, infections during the first year of life, and gene-environment interaction).") Annotation(oboInOwl:hasDbXref "PMID:16343090") Annotation(obo:IAO_0000116 "infections during the first year of life") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_3000000) coho:COHO_0000922)
ClassAssertion(Annotation(rdfs:comment "The aim of the KOALA Birth Cohort Study in the Netherlands is to identify factors that influence the clinical expression of atopic disease with a main focus on lifestyle (e.g., anthroposophy, vaccinations, antibiotics, dietary habits, breastfeeding and breast milk composition, intestinal microflora composition, infections during the first year of life, and gene-environment interaction).") Annotation(oboInOwl:hasDbXref "PMID:16343090") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0000922)
ClassAssertion(Annotation(rdfs:comment "In addition, pregnant women (n = 491) with 'alternative lifestyles' with regard to child rearing practices, dietary habits (organic, vegetarian), vaccination schemes and/or use of antibiotics, were recruited through organic food shops, anthroposophic doctors and midwives, Steiner schools, and dedicated magazines.") Annotation(oboInOwl:hasDbXref "PMID:16343090") Annotation(obo:IAO_0000116 "dietary habits (organic, vegetarian)") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0000922)
ClassAssertion(Annotation(rdfs:comment "We established a community-based cohort study to assess the long-term impact of the Great East Japan Earthquake on disaster victims and gene-environment interactions on the incidence of major diseases, such as cancer and cardiovascular diseases.") Annotation(oboInOwl:hasDbXref "PMID:31932529") Annotation(obo:IAO_0000116 "Great East Japan Earthquake") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_8000011) coho:COHO_0000938)
ClassAssertion(Annotation(rdfs:comment "The TMM aims to facilitate solutions to medical problems in the aftermath of the GEJE by providing maximal efforts to recover the damaged health care services through the establishment of a system to dispatch physicians to the damaged areas on a rotational basis, monitoring and intervening in the health status of the persons within and around the affected areas, and introducing personalized health care and medicine not only to the damaged areas but also to the world.ToMMo and IMM have conducted the TMM Birth and Three-Generation Cohort Study (TMM BirThree Cohort Study) since July 2013.") Annotation(oboInOwl:hasDbXref "PMID:31504573") Annotation(obo:IAO_0000116 "Great East Japan Earthquake (GEJE) and subsequent tsunami") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000011) coho:COHO_0000939)
ClassAssertion(Annotation(rdfs:comment "in 2008 the US Army and US National Institute of Mental Health funded the Army Study to Assess Risk and Resilience in Servicemembers (Army STARRS), a multicomponent epidemiological and neurobiological study of risk and resilience factors for suicidal thoughts and behaviors, and their psychopathological correlates among Army personnel.") Annotation(oboInOwl:hasDbXref "PMID:30104726") Annotation(obo:IAO_0000116 "Army service") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_0001591) coho:COHO_0000958)
ClassAssertion(Annotation(rdfs:comment "As soon as there was sufficient support from the PHSA’s drug department, it was decided that because of concerns of a looming HIV epidemic in this group, the prospective ACS among PWUD had to be initiated and in 1985 recruitment of the cohort commenced.") Annotation(oboInOwl:hasDbXref "PMID:33407562") Annotation(obo:IAO_0000116 "drug use") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000008) coho:COHO_0000971)
ClassAssertion(Annotation(rdfs:comment "The target sample comprised 1333 male patients with German ancestry having severe AD requiring hospitalization and 1307 population-based controls, previously described in Treutlein et al. (2009) and Frank et al. (2012) [i.e. the German Study on the Genetics of Addiction (Alcoholism), GESGA].") Annotation(oboInOwl:hasDbXref "PMID:29901528") Annotation(obo:IAO_0000116 "alcohol dependence") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000009) coho:COHO_0000977)
ClassAssertion(Annotation(rdfs:comment "A total of 947 adults with dyslipidemia (STRRIDE I, STRRIDE AT/RT) or prediabetes (STRRIDE-PD) were randomized to either inactive control or to 1 of 10 exercise interventions, ranging from doses of 8-23 kcal/kg/week, intensities of 50%-75% V˙O2 peak, and durations of 6-8 months.") Annotation(oboInOwl:hasDbXref "PMID:37492634") Annotation(obo:IAO_0000116 "caloric restriction") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000065) coho:COHO_0000983)
ClassAssertion(Annotation(rdfs:comment "A total of 947 adults with dyslipidemia (STRRIDE I, STRRIDE AT/RT) or prediabetes (STRRIDE-PD) were randomized to either inactive control or to 1 of 10 exercise interventions, ranging from doses of 8-23 kcal/kg/week, intensities of 50%-75% V˙O2 peak, and durations of 6-8 months.") Annotation(oboInOwl:hasDbXref "PMID:37492634") Annotation(obo:IAO_0000116 "exercise interventions of differing amount, intensity and mode") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000002) coho:COHO_0000983)
ClassAssertion(Annotation(rdfs:comment "These studies are collectively termed “DOD ADNI,” and aim to enroll approximately 400 elderly Veterans who served in Vietnam.") Annotation(oboInOwl:hasDbXref "PMID:28758146") Annotation(obo:IAO_0000116 "military service in the Vietnam War") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_0001591) coho:COHO_0000992)
ClassAssertion(Annotation(rdfs:comment "A multicentre, prospective cohort study of childhood asthma was established in three European countries; the purpose of the project is the examination of factors which modify the relationship between allergen exposure in infant life and subsequent atopy and asthma. Dust samples were collected from the homes of 643 infants in a single town in the UK (the first cohort) and assayed for house dust mites (Der p 1) and cat allergen (Fel d 1) concentrations by enzyme-linked immunosorbent assay.") Annotation(oboInOwl:hasDbXref "PMID:10232430") Annotation(obo:IAO_0000116 "domestic aeroallergen exposure in infancy (house dust mite Der p 1 and cat Fel d 1)") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0900047) coho:COHO_0000994)
ClassAssertion(Annotation(rdfs:comment "Enrolment criteria were: 1) self-reported Caucasian; 2) aged > 40 years; 3) current or former smoker with ≥2.5 pack-years of smoking history; and 4) no severe α1-antitrypsin deficiency.") Annotation(oboInOwl:hasDbXref "PMID:25134640") Annotation(obo:IAO_0000116 "current or former smoker with ≥2.5 pack-years of smoking history") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0001009)
ClassAssertion(Annotation(rdfs:comment "The principal aim of Q-MEGA is to provide a large and well-described population-based sample of CMM cases and their families, with blood collection for genetic purposes and detailed information on sun exposure and phenotype to explore the effect that environmental and genetic factors, and their interaction, play in the etiology of CMM.") Annotation(oboInOwl:hasDbXref "PMID:18361720") Annotation(obo:IAO_0000116 "sun exposure") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000061) coho:COHO_0001031)
ClassAssertion(Annotation(rdfs:comment "Two thousand women were recruited for a prospective investigation of the influence of maternal antioxidant intake in pregnancy on the development of asthma and eczema in children.") Annotation(oboInOwl:hasDbXref "PMID:15531754") Annotation(obo:IAO_0000116 "maternal antioxidant intake in pregnancy") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0900200) coho:COHO_0001034)
ClassAssertion(Annotation(rdfs:comment "SEATON is an unselected birth cohort study established in 1997 in Aberdeen, UK, which was designed to explore the relationship between antenatal dietary exposures and asthma outcomes in childhood (Martindale et al., 2005).") Annotation(oboInOwl:hasDbXref "PMID:37227431") Annotation(obo:IAO_0000116 "antenatal dietary exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000076) coho:COHO_0001034)
ClassAssertion(Annotation(rdfs:comment "TESRA subjects were former smokers with COPD who experienced two or fewer exacerbations requiring outpatient treatment with antibiotics or oral steroids or one exacerbation requiring hospitalization within the prior year.") Annotation(oboInOwl:hasDbXref "PMID:25582225") Annotation(obo:IAO_0000116 "former smokers with COPD") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0001035)
ClassAssertion(Annotation(rdfs:comment "The Alienor (Antioxydants, Lipides Essentiels, Nutrition et maladies OculaiRes) Study aims at assessing the associations of eye diseases with nutritional factors, determined from plasma measurements and estimation of dietary intakes.") Annotation(oboInOwl:hasDbXref "PMID:21125205") Annotation(obo:IAO_0000116 "antioxidants") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9001647) coho:COHO_0001054)
ClassAssertion(Annotation(rdfs:comment "The Alienor (Antioxydants, Lipides Essentiels, Nutrition et maladies OculaiRes) Study aims at assessing the associations of eye diseases with nutritional factors, determined from plasma measurements and estimation of dietary intakes.") Annotation(oboInOwl:hasDbXref "PMID:21125205") Annotation(obo:IAO_0000116 "nutritional factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9001695) coho:COHO_0001054)
ClassAssertion(Annotation(rdfs:comment "Mainly three types of nutritional factors are currently investigated for their potential protection against eye ageing: antioxidants, the carotenoids lutein and zeaxanthin and omega 3 polyunsaturated fatty acids (PUFA).") Annotation(oboInOwl:hasDbXref "PMID:21125205") Annotation(obo:IAO_0000116 "lutein and zeaxanthin") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9002364) coho:COHO_0001054)
ClassAssertion(Annotation(rdfs:comment "Mainly three types of nutritional factors are currently investigated for their potential protection against eye ageing: antioxidants, the carotenoids lutein and zeaxanthin and omega 3 polyunsaturated fatty acids (PUFA).") Annotation(oboInOwl:hasDbXref "PMID:21125205") Annotation(obo:IAO_0000116 "omega 3 polyunsaturated fatty acids") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9002766) coho:COHO_0001054)
ClassAssertion(Annotation(rdfs:comment "Moreover, the role of pattern of smoking and drinking, as well as the exact nature of the implicated dietary variables, has not been clarified. To address these issues, the International Agency for Research on Cancer initiated in 2002 the alcohol-related cancers and genetic susceptibility (ARCAGE) in Europe project, with the participation of 15 centers in 11 European countries.") Annotation(oboInOwl:hasDbXref "PMID:18830131") Annotation(obo:IAO_0000116 "consumption of alcoholic beverages") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0001082) coho:COHO_0001056)
ClassAssertion(Annotation(rdfs:comment "Moreover, the role of pattern of smoking and drinking, as well as the exact nature of the implicated dietary variables, has not been clarified. To address these issues, the International Agency for Research on Cancer initiated in 2002 the alcohol-related cancers and genetic susceptibility (ARCAGE) in Europe project, with the participation of 15 centers in 11 European countries.") Annotation(oboInOwl:hasDbXref "PMID:18830131") Annotation(obo:IAO_0000116 "intake of vegetables and fruits") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070232) coho:COHO_0001056)
ClassAssertion(Annotation(rdfs:comment "Moreover, the role of pattern of smoking and drinking, as well as the exact nature of the implicated dietary variables, has not been clarified. To address these issues, the International Agency for Research on Cancer initiated in 2002 the alcohol-related cancers and genetic susceptibility (ARCAGE) in Europe project, with the participation of 15 centers in 11 European countries.") Annotation(oboInOwl:hasDbXref "PMID:18830131") Annotation(obo:IAO_0000116 "tobacco smoking") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000029) coho:COHO_0001056)
ClassAssertion(Annotation(rdfs:comment "Participants were Finnish aged 25-74 years who attended the DIetary, Lifestyle and Genetic determinants of Obesity and Metabolic syndrome study at baseline in 2007 and follow-up in 2014.") Annotation(oboInOwl:hasDbXref "PMID:29158543") Annotation(obo:IAO_0000116 "lifestyle determinants of obesity and metabolic syndrome") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0001074)
ClassAssertion(Annotation(rdfs:comment "Participants were Finnish aged 25-74 years who attended the DIetary, Lifestyle and Genetic determinants of Obesity and Metabolic syndrome study at baseline in 2007 and follow-up in 2014.") Annotation(oboInOwl:hasDbXref "PMID:29158543") Annotation(obo:IAO_0000116 "dietary determinants of obesity and metabolic syndrome") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0001074)
ClassAssertion(Annotation(rdfs:comment "This increase is likely to be due to patterns of alcohol and tobacco consumption. Genetic susceptibility to upper aerodigestive tract cancer in relation to such exposures is an important aspect that should be investigated among populations in this region.") Annotation(oboInOwl:hasDbXref "PMID:16614111") Annotation(obo:IAO_0000116 "alcohol consumption") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0001082) coho:COHO_0001087)
ClassAssertion(Annotation(rdfs:comment "The SYS is a retrospective study of long-term consequences of prenatal exposure to maternal cigarette smoking (PEMCS) in which multiple quantitative phenotypes are acquired over five sessions (telephone interview, home, hospital, laboratory, and school).") Annotation(oboInOwl:hasDbXref "PMID:17469173") Annotation(obo:IAO_0000116 "prenatal exposure to maternal cigarette smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_0300003) coho:COHO_0001124)
ClassAssertion(Annotation(rdfs:comment "We conducted a prospective study of children (n = 2,715, aged 7 to 10 y) from 39 schools in Barcelona (Catalonia, Spain) exposed to high and low traffic-related air pollution, paired by school socioeconomic index; children were tested four times (i.e., to assess the 12-mo developmental trajectories) via computerized tests (n = 10,112).") Annotation(oboInOwl:hasDbXref "PMID:25734425") Annotation(obo:IAO_0000116 "elemental carbon") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_7000068) coho:COHO_0001147)
ClassAssertion(Annotation(rdfs:comment "We aimed to assess the relationship between long-term exposure to traffic-related air pollutants at school and cognitive development measurements in primary school children within the BREATHE (Brain Development and Air Pollution Ultrafine Particles in School Children) project.") Annotation(oboInOwl:hasDbXref "PMID:25734425") Annotation(obo:IAO_0000116 "ultrafine particles") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_7000118) coho:COHO_0001147)
ClassAssertion(Annotation(rdfs:comment "We conducted a prospective study of children (n = 2,715, aged 7 to 10 y) from 39 schools in Barcelona (Catalonia, Spain) exposed to high and low traffic-related air pollution, paired by school socioeconomic index; children were tested four times (i.e., to assess the 12-mo developmental trajectories) via computerized tests (n = 10,112).") Annotation(oboInOwl:hasDbXref "PMID:25734425") Annotation(obo:IAO_0000116 "traffic-related air pollution") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000036) coho:COHO_0001147)
ClassAssertion(Annotation(rdfs:comment "Chronic traffic air pollution (elemental carbon [EC], nitrogen dioxide [NO2], and ultrafine particle number [UFP; 10-700 nm]) was measured twice during 1-wk campaigns both in the courtyard (outdoor) and inside the classroom (indoor) simultaneously in each school pair.") Annotation(oboInOwl:hasDbXref "PMID:25734425") Annotation(obo:IAO_0000116 "nitrogen dioxide") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000252) coho:COHO_0001147)
ClassAssertion(Annotation(rdfs:comment "We have investigated the risk in a German population-based case-control study known as GENICA (gene environment interaction and breast cancer).") Annotation(oboInOwl:hasDbXref "PMID:20039012") Annotation(obo:IAO_0000116 "environmental factors interacting with genes in breast cancer") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0001173)
ClassAssertion(Annotation(rdfs:comment "Established in 2008, the GLACIER Study comprises a cohort suitable for studies on the genetics of complex cardio-metabolic traits and gene-environment interactions, nested within the NSHDS.") Annotation(oboInOwl:hasDbXref "PMID:25396097") Annotation(obo:IAO_0000116 "lifestyle (diet, physical activity, smoking, alcohol)") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0001177)
ClassAssertion(Annotation(rdfs:comment "This study aimed at identifying environmental and lifestyle-related factors contributing to the risk of developing acute appendicitis.") Annotation(oboInOwl:hasDbXref "PMID:37128345") Annotation(obo:IAO_0000116 "lifestyle-related factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0001184)
ClassAssertion(Annotation(rdfs:comment "In a cohort of 300 patients and 300 controls, environmental factors as well as genetic make-up of the innate immune system, focusing mainly on pattern recognition, will be analyzed in order to gain insight in their relative importance in the pathology of appendicitis.") Annotation(oboInOwl:hasDbXref "https://clinicaltrials.gov/study/NCT02391675") Annotation(obo:IAO_0000116 "environmental factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0001184)
