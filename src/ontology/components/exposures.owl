ClassAssertion(Annotation(rdfs:comment "This is compared with the cross-sectional Utrecht cannabis cohort, which is a cohort that has been enriched for PLE and heavy cannabis use; heavy cannabis use being a particularly strong risk factor for development of psychosis and PLE.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10106286/fullTextXML") Annotation(obo:IAO_0000116 "cannabis use") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0100005) coho:COHO_0002477)
ClassAssertion(Annotation(rdfs:comment "We sampled individuals of European ancestry from UK Biobank, from the middle and extremes of the forced expiratory volume in 1 s (FEV1) distribution among heavy smokers (mean 35 pack-years) and never smokers.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4593935/fullTextXML") Annotation(obo:IAO_0000116 "heavy smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000029) coho:COHO_0002495)
ClassAssertion(Annotation(rdfs:comment "Study participants came from the Transdisciplinary Tobacco Use Research Centers (TTURCs) Study (1091 smokers of European descent), and the Genetically Informed Smoking Cessation Trial (GISC) Study (501 smokers of European descent).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35170738+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "cigarette smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0002536)
ClassAssertion(Annotation(rdfs:comment "To date, there are no prediction models based on large Chinese general population data, though the Westlake Precision Birth Cohort study aimed to develop personalized dietary recommendations for Chinese women with gestational diabetes mellitus [17].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12751878/fullTextXML") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002560)
ClassAssertion(Annotation(rdfs:comment "The CT is designed to allow randomized controlled evaluation of three distinct interventions: a low-fat eating pattern, hypothesized to prevent breast cancer and colorectal cancer and, secondarily, coronary heart disease;") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9492970+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "low-fat eating pattern") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000121) coho:COHO_0002566)
ClassAssertion(Annotation(rdfs:comment "In particular, WHISTLER will provide a well-balanced view on the prognostic power of neonatal lung function and genetic and environmental factors (including viral infections and endotoxin exposure) to predict wheezing illnesses from birth to young adulthood and beyond.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15499901+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "endotoxin exposure") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000215) coho:COHO_0002570)
ClassAssertion(Annotation(rdfs:comment "The Wuhan-Zhuhai (WHZH) cohort study, an ongoing community-based cohort study, is designed to investigate the association between long-term particulate air pollution exposure and its components and physiological or pathological reactions or health damages on respiratory and cardiovascular system.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4247123/unicode") Annotation(obo:IAO_0000116 "particulate air pollution") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_7000068) coho:COHO_0002572)
ClassAssertion(Annotation(rdfs:comment "Recruiting individuals from Stockholm County the Cardiovascular Effects of Air pollution and Noise Study (CEANS) cohort was included.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8438896/fullTextXML") Annotation(obo:IAO_0000116 "ambient air pollution") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000036) coho:COHO_0002596)
ClassAssertion(Annotation(rdfs:comment "Recruiting individuals from Stockholm County the Cardiovascular Effects of Air pollution and Noise Study (CEANS) cohort was included.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8438896/fullTextXML") Annotation(obo:IAO_0000116 "noise") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000044) coho:COHO_0002596)
ClassAssertion(Annotation(rdfs:comment "This project aims to investigate how what we buy, and thus our diet, affects health, by analyzing purchase patterns and health information over time.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/CON") Annotation(obo:IAO_0000116 "household chemicals") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000231) coho:COHO_0002597)
ClassAssertion(Annotation(rdfs:comment "This project aims to investigate how what we buy, and thus our diet, affects health, by analyzing purchase patterns and health information over time.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/CON") Annotation(obo:IAO_0000116 "household lifestyle exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0002597)
