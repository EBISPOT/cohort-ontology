ClassAssertion(Annotation(rdfs:comment "From the inception of the cohort in 2010 (T1) onwards, participants completed an online questionnaire on topics such as work characteristics, health, employment status and transitions, work ability, and work productivity.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7227258/fullTextXML") Annotation(obo:IAO_0000116 "work characteristics") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0001591) coho:COHO_0002598)
ClassAssertion(Annotation(rdfs:comment "The cohort was set up to investigate the effects of acute maternal undernutrition during specific stages of gestation on the offspring’s adult health.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/DFBC") Annotation(obo:IAO_0000116 "acute maternal undernutrition during the 1944-1945 Dutch famine") Annotation(obo:IAO_0000116 "prenatal famine exposure") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_0800003) coho:COHO_0002600)
ClassAssertion(Annotation(rdfs:comment "The priority research themes selected for ELFE were:aspects of children's environment that have undergone the most striking changes over recent decades including: modification of nutritional intake; reduction of physical activity; exposure to emerging exogenous pollutants;") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7266552/fullTextXML") Annotation(obo:IAO_0000116 "emerging exogenous pollutants") Annotation(obo:IAO_0000116 "environmental contaminants") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000931) coho:COHO_0002602)
ClassAssertion(Annotation(rdfs:comment "Within the ongoing population-based prospective birth cohort study ENVIRONAGE we explore new dimensions in the current understanding of human ageing and its interaction with the environment") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ENVIRONAGE") Annotation(obo:IAO_0000116 "air pollution") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000036) coho:COHO_0002603)
