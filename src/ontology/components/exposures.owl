ClassAssertion(Annotation(rdfs:comment "In this study, we collected in utero and subsequent exposure and outcome information, including disaster-related information, of newborns and other family members.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7124511/fullTextXML") Annotation(obo:IAO_0000116 "Great East Japan Earthquake (GEJE) and subsequent tsunami") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_8000011) coho:COHO_0000939)
