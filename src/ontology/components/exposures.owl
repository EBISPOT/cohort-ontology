ClassAssertion(Annotation(rdfs:comment "We analyzed the relationship between exposure to chlordecone and the risk of prostate cancer.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20566993+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "chlordecone") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000553) coho:COHO_0001955)
