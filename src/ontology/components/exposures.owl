ClassAssertion(Annotation(rdfs:comment "The INTERGENE research programme was initiated to study the INTERplay between GENEtic and environmental risk factors for chronic disease.") Annotation(oboInOwl:hasDbXref "PMID:38983451") Annotation(obo:IAO_0000116 "environmental risk factors for chronic disease") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0001926)
