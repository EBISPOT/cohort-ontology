ClassAssertion(Annotation(rdfs:comment "More specifically, the population comprised of people born between 1928 and 1956 originating from the Netherlands and Belgium, who: • Smoked > 15 cigarettes/day during > 25 years, • Or smoked > 10 cigarettes/day during > 30 years, • and were current smokers or former smokers who quit smoking ≤ 10 years ago.") Annotation(oboInOwl:hasDbXref "https://umcgresearch.org/w/nelson-dataset") Annotation(obo:IAO_0000116 "smoking exposure (years smoked, cigarettes/day, years quit)") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0000058)
ClassAssertion(Annotation(rdfs:comment "The EPIC-Norfolk study (https://www.epic-norfolk.org.uk) is a population-based prospective cohort study, nested within the European Prospective Investigation of Cancer (EPIC) study, which had the primary aim of exploring the connections between cancer, diet and lifestyle.") Annotation(oboInOwl:hasDbXref "PMID:36357675") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0000065)
ClassAssertion(Annotation(rdfs:comment "The European Prospective Investigation into Cancer and Nutrition (EPIC) is an ongoing multi-centre prospective cohort study designed to investigate the relationship between nutrition and cancer, with the potential for studying other diseases as well.") Annotation(oboInOwl:hasDbXref "PMID:12639222") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0000065)
ClassAssertion(Annotation(rdfs:comment "The European Prospective Investigation into Cancer and Nutrition (EPIC) is an ongoing multi-centre prospective cohort study designed to investigate the relationship between nutrition and cancer, with the potential for studying other diseases as well.") Annotation(oboInOwl:hasDbXref "PMID:12639222") Annotation(obo:IAO_0000116 "nutrition") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9001695) coho:COHO_0000065)
ClassAssertion(Annotation(rdfs:comment "The EPIC-Norfolk study (https://www.epic-norfolk.org.uk) is a population-based prospective cohort study, nested within the European Prospective Investigation of Cancer (EPIC) study, which had the primary aim of exploring the connections between cancer, diet and lifestyle.") Annotation(oboInOwl:hasDbXref "PMID:36357675") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0000066)
ClassAssertion(Annotation(rdfs:comment "The EPIC-Norfolk study (https://www.epic-norfolk.org.uk) is a population-based prospective cohort study, nested within the European Prospective Investigation of Cancer (EPIC) study, which had the primary aim of exploring the connections between cancer, diet and lifestyle.") Annotation(oboInOwl:hasDbXref "PMID:36357675") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0000066)
ClassAssertion(Annotation(rdfs:comment "The EPIC-Norfolk study (https://www.epic-norfolk.org.uk) is a population-based prospective cohort study, nested within the European Prospective Investigation of Cancer (EPIC) study, which had the primary aim of exploring the connections between cancer, diet and lifestyle.") Annotation(oboInOwl:hasDbXref "PMID:36357675") Annotation(obo:IAO_0000116 "nutrition") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9001695) coho:COHO_0000066)
ClassAssertion(Annotation(rdfs:comment "A total of 208 participants of the Fatty Acid Sensor (FAS) Study received 5 g fish oil/d, containing 1.9-2.2 g eicosapentaenoic acid and 1.1 g docosahexanoic acid, for 6 wk.") Annotation(oboInOwl:hasDbXref "PMID:30624603") Annotation(obo:IAO_0000116 "omega-3 fatty acid supplementation (fish oil)") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070171) coho:COHO_0000069)
ClassAssertion(Annotation(rdfs:comment "The GABRIEL Advanced Surveys (GABRIELA) were conducted to determine factors in farming environments which are fundamental to protecting against asthma and atopic disease.") Annotation(oboInOwl:hasDbXref "PMID:21819425") Annotation(obo:IAO_0000116 "exposure to farming environments") Annotation(obo:IAO_0000116 "farming environments") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_1000034) coho:COHO_0000073)
ClassAssertion(Annotation(rdfs:comment "The INMA Project is based on the experience acquired by groups that studied several cohorts with different objectives: the cohort of Riera d’Ebre (n=102), an area with high levels of organochlorine compounds and mercury, evaluated the relationship between these exposures and the neurological development of the children") Annotation(oboInOwl:hasDbXref "https://www.proyectoinma.org/en/inma-project/study-design/") Annotation(obo:IAO_0000116 "organochlorine compounds") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0001152) coho:COHO_0000100)
