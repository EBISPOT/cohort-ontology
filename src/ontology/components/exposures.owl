ClassAssertion(Annotation(rdfs:comment "The INTERGENE research programme was initiated to study the INTERplay between GENEtic and environmental risk factors for chronic disease.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11231701/fullTextXML") Annotation(obo:IAO_0000116 "environmental risk factors for chronic disease") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0001926)
ClassAssertion(Annotation(rdfs:comment "A multinational case-control study, INTERPHONE, was set-up to investigate whether mobile phone use increases the risk of cancer and, more specifically, whether the RF fields emitted by mobile phones are carcinogenic.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17636416+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "radio frequency (RF) fields emitted by mobile phones") Annotation(obo:IAO_0000116 "mobile phone use") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000054) coho:COHO_0001927)
