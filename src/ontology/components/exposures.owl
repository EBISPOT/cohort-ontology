ClassAssertion(Annotation(rdfs:comment "The “Gene-environment interactions in lymphoma etiology” (ItGxE) multicentre case-control study took place in 2011–2017 in six Italian centres, namely Perugia, Florence, Novara, Verona, Cagliari and Nuoro in Sardinia, and Bari and Taranto in Apulia.") Annotation(oboInOwl:hasDbXref "PMID:33910586") Annotation(obo:IAO_0000116 "environment") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0001940)
