ClassAssertion(Annotation(rdfs:comment "1) to prepare a molecular genetic and epidemiological risk assessment model based on environmental exposures and genetic predisposition") Annotation(oboInOwl:hasDbXref "PMID:12212983") Annotation(obo:IAO_0000116 "environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002009)
ClassAssertion(Annotation(rdfs:comment "The intensive lifestyle intervention is designed to achieve and maintain weight loss through decreased caloric intake and increased physical activity.") Annotation(oboInOwl:hasDbXref "PMID:14500058") Annotation(obo:IAO_0000116 "decreased caloric intake") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000065) coho:COHO_0002015)
ClassAssertion(Annotation(rdfs:comment "The intensive lifestyle intervention is designed to achieve and maintain weight loss through decreased caloric intake and increased physical activity.") Annotation(oboInOwl:hasDbXref "PMID:14500058") Annotation(obo:IAO_0000116 "increased physical activity") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000039) coho:COHO_0002015)
ClassAssertion(Annotation(rdfs:comment "Enrollment was restricted to current and former smokers aged 40–74 years with a minimum of 10 pack-years of smoking.") Annotation(oboInOwl:hasDbXref "PMID:29133979") Annotation(obo:IAO_0000116 "smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000013) coho:COHO_0002019)
ClassAssertion(Annotation(rdfs:comment "Proband smokers were required to be at least 21 years old, to have smoked for at least the last five years, and to have consumed at least 20 cigarettes per day for the preceding 12 months.") Annotation(oboInOwl:hasDbXref "PMID:19763258") Annotation(obo:IAO_0000116 "smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000013) coho:COHO_0002096)
ClassAssertion(Annotation(rdfs:comment "The aims of the present study were to evaluate the effect of PNPLA3, TM6SF2, and GCKR genetic variants on a NAFLD case–control Greek cohort, to assess the impact of dietary habits and to further explore the interaction of these three single nucleotide polymorphisms (SNPs) with dietary factors and their effect on NAFLD.") Annotation(oboInOwl:hasDbXref "PMID:29574608") Annotation(obo:IAO_0000116 "dietary habits") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002105)
ClassAssertion(Annotation(rdfs:comment "Twin pairs concordant for smoking history were recruited along with their family members, as part of the multisite Nicotine Addiction Genetics consortium.") Annotation(oboInOwl:hasDbXref "PMID:24927283") Annotation(obo:IAO_0000116 "smoking history") Annotation(obo:IAO_0000116 "heavy smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000029) coho:COHO_0002106)
ClassAssertion(Annotation(rdfs:comment "These multicenter, hospital-based case–control studies of breast cancer were designed to determine lifestyle factors and genetic susceptibility to the risk of breast cancer and to compare potential risk factors among Japanese living in Nagano, Japan, and Japanese Brazilians and non-Japanese Brazilians living in São Paulo, Brazil.") Annotation(oboInOwl:hasDbXref "PMID:18777206") Annotation(obo:IAO_0000116 "lifestyle factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0002107)
ClassAssertion(Annotation(rdfs:comment "The primary objective of the UMHS was to determine if pesticides were associated with an increased risk of glioma, the most common type of brain tumor in adults [13].") Annotation(oboInOwl:hasDbXref "PMID:22691464") Annotation(obo:IAO_0000116 "pesticides") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000530) coho:COHO_0002158)
ClassAssertion(Annotation(rdfs:comment "We conducted a population-based case-control study, the NJ Ovarian Cancer Study, specifically designed to evaluate phytoestrogens and ovarian cancer risk in New Jersey, a population characterized by large ethnic diversity.") Annotation(oboInOwl:hasDbXref "PMID:21943063") Annotation(obo:IAO_0000116 "phytoestrogens") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9002037) coho:COHO_0002160)
ClassAssertion(Annotation(rdfs:comment "Patients who were diagnosed in one of three hospitals (Radboud university medical center and Canisius Wilhelmina Hospital in Nijmegen and Rijnstate Hospital in Arnhem) since 1989 and who were still alive at April 15th, 2008 were recruited for a study on gene-environment interactions in lung cancer.") Annotation(oboInOwl:hasDbXref "PMID:28604730") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "environment") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002165)
ClassAssertion(Annotation(rdfs:comment "The Nottingham Smokers cohort is an ongoing collection in Nottingham using the following criteria; European ancestry, >40 years of age and smoking history of >10 pack years (currently n = 538).") Annotation(oboInOwl:hasDbXref "PMID:24786987") Annotation(obo:IAO_0000116 "smoking history of > 10 pack years") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000029) coho:COHO_0002176)
ClassAssertion(Annotation(rdfs:comment "Therefore, we undertook a large, population-based case-control study of NPC in southern China (the NPC Genes, Environment, and EBV (NPCGEE) study) with the specific aims of understanding the independent and interactive roles of genes, environmental exposures, and infection with the Epstein-Barr virus (EBV) in disease etiology.") Annotation(oboInOwl:hasDbXref "PMID:29152064") Annotation(obo:IAO_0000116 "infection with the Epstein-Barr virus (EBV)") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_3000273) coho:COHO_0002178)
ClassAssertion(Annotation(rdfs:comment "Therefore, we undertook a large, population-based case-control study of NPC in southern China (the NPC Genes, Environment, and EBV (NPCGEE) study) with the specific aims of understanding the independent and interactive roles of genes, environmental exposures, and infection with the Epstein-Barr virus (EBV) in disease etiology.") Annotation(oboInOwl:hasDbXref "PMID:29152064") Annotation(obo:IAO_0000116 "environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002178)
ClassAssertion(Annotation(rdfs:comment "The OPAL Study recruited 960 women newly diagnosed with ovarian cancer between 2012 and 2015 to see whether lifestyle factors, including physical activity, diet and medication use influence cancer relapse and survival.") Annotation(oboInOwl:hasDbXref "http://opalstudy.qimrberghofer.edu.au/") Annotation(obo:IAO_0000116 "lifestyle factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0002210)
ClassAssertion(Annotation(rdfs:comment "Therefore, the present study aimed to investigate the individual and combined effects of these three factors on the survival of patients with PDAC.2.") Annotation(oboInOwl:hasDbXref "PMID:32791343") Annotation(obo:IAO_0000116 "trace elements") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000231) coho:COHO_0002230)
ClassAssertion(Annotation(rdfs:comment "Therefore, the present study aimed to investigate the individual and combined effects of these three factors on the survival of patients with PDAC.2.") Annotation(oboInOwl:hasDbXref "PMID:32791343") Annotation(obo:IAO_0000116 "persistent organic pollutants") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9002053) coho:COHO_0002230)
ClassAssertion(Annotation(rdfs:comment "The aim of one such study, the Pathways Study, is to examine the effect on recurrence and survival of 1) lifestyle factors such as diet, physical activity, quality of life, and use of complementary and alternative medicine (CAM) and 2) molecular factors such as genetic polymorphisms involved in metabolism of chemotherapeutic agents.") Annotation(oboInOwl:hasDbXref "PMID:18478338") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002237)
ClassAssertion(Annotation(rdfs:comment "The aim of one such study, the Pathways Study, is to examine the effect on recurrence and survival of 1) lifestyle factors such as diet, physical activity, quality of life, and use of complementary and alternative medicine (CAM) and 2) molecular factors such as genetic polymorphisms involved in metabolism of chemotherapeutic agents.") Annotation(oboInOwl:hasDbXref "PMID:18478338") Annotation(obo:IAO_0000116 "physical activity") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000039) coho:COHO_0002237)
ClassAssertion(Annotation(rdfs:comment "The Proyecto Genes Candidatos en Asma (PGCA) study is a population-based study conducted by the Institute for Immunological Research of The University of Cartagena (Colombia) to identify environmental and genetic risk factors for asthma and allergies [16, 19, 21, 22].") Annotation(oboInOwl:hasDbXref "PMID:30787307") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "environmental risk factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002249)
ClassAssertion(Annotation(rdfs:comment "The second group of subjects came from the Pittsburgh Lung Screening Study (PLuSS), a Pittsburgh-based CT lung cancer screening study that enrolled, between 2002 and 2005, 50-79 year-old current or former cigarette smokers (≥half pack/day for ≥25 years, quit ≤10 years).") Annotation(oboInOwl:hasDbXref "PMID:26352532") Annotation(obo:IAO_0000116 "cigarette smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0002262)
ClassAssertion(Annotation(rdfs:comment "These international multicenter prospective trials aimed to investigate the effect of training load and genotype on the variability of structural, functional, and electrical exercise-induced cardiac remodeling in elite competitive endurance athletes, and the full study protocol has been detailed.") Annotation(oboInOwl:hasDbXref "PMID:38109351") Annotation(obo:IAO_0000116 "training load") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000002) coho:COHO_0002280)
ClassAssertion(Annotation(rdfs:comment "These international multicenter prospective trials aimed to investigate the effect of training load and genotype on the variability of structural, functional, and electrical exercise-induced cardiac remodeling in elite competitive endurance athletes, and the full study protocol has been detailed.") Annotation(oboInOwl:hasDbXref "PMID:38109351") Annotation(obo:IAO_0000116 "training load") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000002) coho:COHO_0002287)
ClassAssertion(Annotation(rdfs:comment "The Prostate Cancer & Environment Study (PROtEuS), described previously (Blanc-Lapierre et al., 2015), is a population-based case-control study conducted in Montreal, Canada, to assess the role of environmental and lifestyle factors in prostate cancer risk.") Annotation(oboInOwl:hasDbXref "PMID:30233396") Annotation(obo:IAO_0000116 "environmental and lifestyle factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002292)
ClassAssertion(Annotation(rdfs:comment "The Pumwani sex worker cohort was established in Nairobi, Kenya, in 1985 (27, 48) and has become well known for a small group of women who remain seronegative and PCR negative to HIV despite repeated exposure through active high-risk sex work.") Annotation(oboInOwl:hasDbXref "PMID:22915813") Annotation(obo:IAO_0000116 "repeated exposure to HIV through active high-risk sex work") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_3000289) coho:COHO_0002298)
ClassAssertion(Annotation(rdfs:comment "Eligible participants are non-Hispanic African American or White adults, 18 years of age or older who smoke 3–20 cigarettes per day on 25 days or more during the preceding month, and are interested in quitting smoking, taking varenicline for 3 months, have a functioning telephone, and are willing to complete all study-related requirements.") Annotation(oboInOwl:hasDbXref "PMID:26667382") Annotation(obo:IAO_0000116 "cigarette smoking, 3–20 cigarettes per day") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0002301)
ClassAssertion(Annotation(rdfs:comment "The Queensland Familial Melanoma Project was undertaken to investigate (a) the role of genetic susceptibility as indicated by skin type, pigmentation and the prevalence of naevi and (b) exposure to solar ultraviolet radiation, and their interaction in the aetiology of familial melanoma.") Annotation(oboInOwl:hasDbXref "PMID:8791274") Annotation(obo:IAO_0000116 "solar ultraviolet radiation") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000006) coho:COHO_0002302)
ClassAssertion(Annotation(rdfs:comment "SYNERGIQC originates from the Quebec lung cancer screening program [17], a provincial multicenter pilot-study launched in 2021 for ever-smokers aged 55–74.") Annotation(oboInOwl:hasDbXref "PMID:41990546") Annotation(obo:IAO_0000116 "ever-smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000029) coho:COHO_0002304)
ClassAssertion(Annotation(rdfs:comment "The main objectives of the SAGE Study were : to collect information about the home environment of children in Manitoba; to confirm the rate of asthma in Manitoban children and validate the tools used to diagnose asthma; to understand the differences in children's immune system that either predisposes or protects them from getting asthma; to explore genes that may play a role in children developing asthma; and to understand the relationship between genes and the environment in the development of asthma.") Annotation(oboInOwl:hasDbXref "https://www.maelstrom-research.org/study/sage-1") Annotation(obo:IAO_0000116 "home environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002338)
ClassAssertion(Annotation(rdfs:comment "Our study is the largest population-based study of breast cancer survival to date and was specifically designed to evaluate the influence of soy food intake on breast cancer outcomes.") Annotation(oboInOwl:hasDbXref "PMID:19996398") Annotation(obo:IAO_0000116 "soy food intake") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070183) coho:COHO_0002347)
ClassAssertion(Annotation(rdfs:comment "We examined the associations of constitutional risk factors and sun exposure with the risks of three types of skin cancer simultaneously and evaluated the interaction between constitutional susceptibility and sun exposure in a nested case-control study within the Nurses' Health Study [200 melanoma, 275 squamous cell carcinoma (SCC), and 283 basal cell carcinoma (BCC) cases, and 804 controls].") Annotation(oboInOwl:hasDbXref "PMID:16943234") Annotation(obo:IAO_0000116 "sun exposure") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000061) coho:COHO_0002352)
ClassAssertion(Annotation(rdfs:comment "We investigated the association between lifestyle and prostate cancer risk among Caucasian and African– American men, separately.") Annotation(oboInOwl:hasDbXref "PMID:15280622") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0002355)
ClassAssertion(Annotation(rdfs:comment "The SKOT study was funded by the Danish Directorate for Food, Fisheries and Agri Business (grant no. 3304-FSE-06-0503-1) as part of the project “Complementary and young child feeding (CYCF) – impact on short and long term development of health”.") Annotation(oboInOwl:hasDbXref "PMID:28666428") Annotation(obo:IAO_0000116 "complementary and young child feeding") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002388)
ClassAssertion(Annotation(rdfs:comment "Our purpose was to evaluate whether saturated fat intake increases the risk of ovarian cancer development.") Annotation(oboInOwl:hasDbXref "PMID:8072035") Annotation(obo:IAO_0000116 "saturated fat intake") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002400)
ClassAssertion(Annotation(rdfs:comment "The intervention is unique in that it began in infancy and continued for 20 years, with personalized dietary counseling provided to children and their parents in the intervention group.") Annotation(oboInOwl:hasDbXref "PMID:42011282") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002415)
ClassAssertion(Annotation(rdfs:comment "The individualized lifestyle intervention program comprised a two-year standardized and structured telephone intervention aimed at moderate weight loss through dietary changes and physical activity, supported by educational materials and patient diary.") Annotation(oboInOwl:hasDbXref "PMID:38098086") Annotation(obo:IAO_0000116 "dietary changes") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000068) coho:COHO_0002417)
ClassAssertion(Annotation(rdfs:comment "The individualized lifestyle intervention program comprised a two-year standardized and structured telephone intervention aimed at moderate weight loss through dietary changes and physical activity, supported by educational materials and patient diary.") Annotation(oboInOwl:hasDbXref "PMID:38098086") Annotation(obo:IAO_0000116 "physical activity") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000039) coho:COHO_0002417)
ClassAssertion(Annotation(rdfs:comment "The objectives of the Southampton Women’s Survey are: a)to characterise the influence of the mother’s own fetal growth and of her diet, body composition and endocrine profile before and during pregnancy on: 1) the early trajectory of fetal growth; 2) the maintenance of this growth trajectory in late gestation;") Annotation(oboInOwl:hasDbXref "PMID:16195252") Annotation(obo:IAO_0000116 "mother's diet before and during pregnancy") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002427)
ClassAssertion(Annotation(rdfs:comment "All TCGS subjects were over the age of 40 with at least 10 pack-years of cigarette smoking history.") Annotation(oboInOwl:hasDbXref "PMID:29238186") Annotation(obo:IAO_0000116 "cigarette smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0002446)
ClassAssertion(Annotation(rdfs:comment "The primary objective of this multicenter, multinational, epidemiological study is the identification of infectious agents, dietary factors, or other environmental exposures that are associated with increased risk of autoimmunity and type 1 diabetes mellitus (T1DM).") Annotation(oboInOwl:hasDbXref "PMID:17850472") Annotation(obo:IAO_0000116 "infectious agents") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_3000000) coho:COHO_0002448)
ClassAssertion(Annotation(rdfs:comment "The primary objective of this multicenter, multinational, epidemiological study is the identification of infectious agents, dietary factors, or other environmental exposures that are associated with increased risk of autoimmunity and type 1 diabetes mellitus (T1DM).") Annotation(oboInOwl:hasDbXref "PMID:17850472") Annotation(obo:IAO_0000116 "dietary factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002448)
ClassAssertion(Annotation(rdfs:comment "The primary objective of this multicenter, multinational, epidemiological study is the identification of infectious agents, dietary factors, or other environmental exposures that are associated with increased risk of autoimmunity and type 1 diabetes mellitus (T1DM).") Annotation(oboInOwl:hasDbXref "PMID:17850472") Annotation(obo:IAO_0000116 "other environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002448)
ClassAssertion(Annotation(rdfs:comment "Interventional strategies were based on lifestyle modifications in diet, smoking and physical activity through face-to-face education, leaflets & brochures, school program alterations, training volunteers as health team and treating patients with NCD risk factors.") Annotation(oboInOwl:hasDbXref "PMID:19166627") Annotation(obo:IAO_0000116 "smoking") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000013) coho:COHO_0002460)
ClassAssertion(Annotation(rdfs:comment "Interventional strategies were based on lifestyle modifications in diet, smoking and physical activity through face-to-face education, leaflets & brochures, school program alterations, training volunteers as health team and treating patients with NCD risk factors.") Annotation(oboInOwl:hasDbXref "PMID:19166627") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002460)
ClassAssertion(Annotation(rdfs:comment "Interventional strategies were based on lifestyle modifications in diet, smoking and physical activity through face-to-face education, leaflets & brochures, school program alterations, training volunteers as health team and treating patients with NCD risk factors.") Annotation(oboInOwl:hasDbXref "PMID:19166627") Annotation(obo:IAO_0000116 "physical activity") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000039) coho:COHO_0002460)
ClassAssertion(Annotation(rdfs:comment "This is compared with the cross-sectional Utrecht cannabis cohort, which is a cohort that has been enriched for PLE and heavy cannabis use; heavy cannabis use being a particularly strong risk factor for development of psychosis and PLE.") Annotation(oboInOwl:hasDbXref "PMID:37310336") Annotation(obo:IAO_0000116 "cannabis use") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0100005) coho:COHO_0002477)
ClassAssertion(Annotation(rdfs:comment "We sampled individuals of European ancestry from UK Biobank, from the middle and extremes of the forced expiratory volume in 1 s (FEV1) distribution among heavy smokers (mean 35 pack-years) and never smokers.") Annotation(oboInOwl:hasDbXref "PMID:26423011") Annotation(obo:IAO_0000116 "heavy smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000029) coho:COHO_0002495)
ClassAssertion(Annotation(rdfs:comment "Study participants came from the Transdisciplinary Tobacco Use Research Centers (TTURCs) Study (1091 smokers of European descent), and the Genetically Informed Smoking Cessation Trial (GISC) Study (501 smokers of European descent).") Annotation(oboInOwl:hasDbXref "PMID:35170738") Annotation(obo:IAO_0000116 "cigarette smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000038) coho:COHO_0002536)
ClassAssertion(Annotation(rdfs:comment "To date, there are no prediction models based on large Chinese general population data, though the Westlake Precision Birth Cohort study aimed to develop personalized dietary recommendations for Chinese women with gestational diabetes mellitus [17].") Annotation(oboInOwl:hasDbXref "PMID:41466265") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002560)
ClassAssertion(Annotation(rdfs:comment "The CT is designed to allow randomized controlled evaluation of three distinct interventions: a low-fat eating pattern, hypothesized to prevent breast cancer and colorectal cancer and, secondarily, coronary heart disease;") Annotation(oboInOwl:hasDbXref "PMID:9492970") Annotation(obo:IAO_0000116 "low-fat eating pattern") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000121) coho:COHO_0002566)
ClassAssertion(Annotation(rdfs:comment "In particular, WHISTLER will provide a well-balanced view on the prognostic power of neonatal lung function and genetic and environmental factors (including viral infections and endotoxin exposure) to predict wheezing illnesses from birth to young adulthood and beyond.") Annotation(oboInOwl:hasDbXref "PMID:15499901") Annotation(obo:IAO_0000116 "endotoxin exposure") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000215) coho:COHO_0002570)
ClassAssertion(Annotation(rdfs:comment "The Wuhan-Zhuhai (WHZH) cohort study, an ongoing community-based cohort study, is designed to investigate the association between long-term particulate air pollution exposure and its components and physiological or pathological reactions or health damages on respiratory and cardiovascular system.") Annotation(oboInOwl:hasDbXref "PMID:25252923") Annotation(obo:IAO_0000116 "particulate air pollution") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_7000068) coho:COHO_0002572)
ClassAssertion(Annotation(rdfs:comment "Recruiting individuals from Stockholm County the Cardiovascular Effects of Air pollution and Noise Study (CEANS) cohort was included.") Annotation(oboInOwl:hasDbXref "PMID:34497075") Annotation(obo:IAO_0000116 "ambient air pollution") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000036) coho:COHO_0002596)
ClassAssertion(Annotation(rdfs:comment "Recruiting individuals from Stockholm County the Cardiovascular Effects of Air pollution and Noise Study (CEANS) cohort was included.") Annotation(oboInOwl:hasDbXref "PMID:34497075") Annotation(obo:IAO_0000116 "noise") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000044) coho:COHO_0002596)
ClassAssertion(Annotation(rdfs:comment "The various data sources enable broad exposure assessment of otherwise hard to obtain information on consumption of grocery products including, food, tobacco and alcohol, sanitary products, and chemicals.") Annotation(oboInOwl:hasDbXref "PMID:38062070") Annotation(obo:IAO_0000116 "household chemicals") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000231) coho:COHO_0002597)
ClassAssertion(Annotation(rdfs:comment "The various data sources enable broad exposure assessment of otherwise hard to obtain information on consumption of grocery products including, food, tobacco and alcohol, sanitary products, and chemicals.") Annotation(oboInOwl:hasDbXref "PMID:38062070") Annotation(obo:IAO_0000116 "household lifestyle exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0002597)
ClassAssertion(Annotation(rdfs:comment "This project aims to investigate how what we buy, and thus our diet, affects health, by analyzing purchase patterns and health information over time.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/CON") Annotation(obo:IAO_0000116 "diet from consumer purchases") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002597)
ClassAssertion(Annotation(rdfs:comment "The cohort was set up to investigate the effects of acute maternal undernutrition during specific stages of gestation on the offspring’s adult health.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/DFBC") Annotation(obo:IAO_0000116 "acute maternal undernutrition during the 1944-1945 Dutch famine") Annotation(obo:IAO_0000116 "prenatal famine exposure") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_0800003) coho:COHO_0002600)
ClassAssertion(Annotation(rdfs:comment "The priority research themes selected for ELFE were:aspects of children's environment that have undergone the most striking changes over recent decades including: modification of nutritional intake; reduction of physical activity; exposure to emerging exogenous pollutants;") Annotation(oboInOwl:hasDbXref "PMID:31747017") Annotation(obo:IAO_0000116 "emerging exogenous pollutants") Annotation(obo:IAO_0000116 "environmental contaminants") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000931) coho:COHO_0002602)
ClassAssertion(Annotation(rdfs:comment "Omgevingsfactoren, zoals luchtverontreiniging, kunnen al tijdens de zwangerschap de gezondheid van de baby beïnvloeden.") Annotation(oboInOwl:hasDbXref "https://limburgsgeboortecohort.be/") Annotation(obo:IAO_0000116 "air pollution") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000036) coho:COHO_0002603)
ClassAssertion(Annotation(rdfs:comment "Within the ongoing population-based prospective birth cohort study ENVIRONAGE we explore new dimensions in the current understanding of human ageing and its interaction with the environment") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ENVIRONAGE") Annotation(obo:IAO_0000116 "early-life environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002603)
ClassAssertion(Annotation(rdfs:comment "The NINFEA cohort is an Internet-based birth cohort established in Italy with the aim of investigating the effects of early life exposures on the health of newborns, infants, adolescents and adults.") Annotation(oboInOwl:hasDbXref "PMID:17955333") Annotation(obo:IAO_0000116 "early life exposures") Annotation(obo:IAO_0000116 "pre-natal and early post-natal exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002605)
ClassAssertion(Annotation(rdfs:comment "SEPAGES (which stands for: Suivi de l’Exposition à la Pollution Atmosphérique durant la Grossesse et Effets sur la Santé; Assessment of air pollution exposure during pregnancy and effect on health in English) is a research platform in environmental health aiming to: (1) characterize finely exposures to ubiquitous components of the exposome during pregnancy and early life; currently funded projects in this cohort focus on two main large families of pollutants, atmospheric pollutants and non-persistent chemicals, including those with potential endocrine-disrupting properties, with the aim to broaden later on to the whole chemical exposome [54];") Annotation(oboInOwl:hasDbXref "PMID:31615055") Annotation(obo:IAO_0000116 "air pollution exposure during pregnancy") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0800002) coho:COHO_0002608)
ClassAssertion(Annotation(rdfs:comment "The environmental factors of interest include components of the outdoor exposome (particulate matter, nitrogen dioxide, benzene, toluene, ethylbenzene, xylenes, temperature), lifestyle factors such as diet and components of the “internal” exposome assessed from biospecimens (phenols, phthalates, DINCH metabolites, perfluorinated compounds, organophosphate pesticides in a subgroup…).") Annotation(oboInOwl:hasDbXref "PMID:31615055") Annotation(obo:IAO_0000116 "phthalates and DINCH") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000906) coho:COHO_0002608)
ClassAssertion(Annotation(rdfs:comment "We developed a couple-child cohort relying on deep phenotyping and extended personal exposure assessment aiming to better characterize the effects of components of the exposome, including air pollutants and non-persistent endocrine disruptors, on child health and development.") Annotation(oboInOwl:hasDbXref "PMID:31615055") Annotation(obo:IAO_0000116 "non-persistent endocrine disruptors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9001630) coho:COHO_0002608)
ClassAssertion(Annotation(rdfs:comment "We evaluated whether a diet high in fatty fish, bilberries and wholegrain products (Healthy Diet) improves biomarkers reflecting inflammation and endothelial dysfunction in individuals with impaired glucose metabolism.") Annotation(oboInOwl:hasDbXref "PMID:21870174") Annotation(obo:IAO_0000116 "a diet high in fatty fish, bilberries and wholegrain products") Annotation(obo:IAO_0000116 "whole-grain-enriched diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000068) coho:COHO_0002609)
ClassAssertion(Annotation(rdfs:comment "Longitudinal cohort of pregnant and non-pregnant women for exposome estimation from blood, saliva, sweat and personal aerosols.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/WDC") Annotation(obo:IAO_0000116 "exposome estimated from blood, saliva, sweat and personal aerosols") Annotation(obo:IAO_0000116 "multiple exposures monitored with wearable exposure sensors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002615)
ClassAssertion(Annotation(rdfs:comment "We therefore investigated the first step of this pathway namely the influence of long-term exposure to particulate matter and NO2 from traffic and industry on the level of inflammatory markers in exhaled breath condensate (EBC) and in induced sputum (IS) in a cross-sectional analysis including 402 elderly women of the population-based SALIA cohort in 2008/2009.") Annotation(oboInOwl:hasDbXref "PMID:24645673") Annotation(obo:IAO_0000116 "long-term exposure to particulate matter and NO2 from traffic and industry") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_7000068) coho:COHO_0002618)
ClassAssertion(Annotation(rdfs:comment "The SALIA study was initiated in the early 1980s by the State Government of North-Rhine Westphalia to investigate the health effects of air pollution exposure in women.") Annotation(oboInOwl:hasDbXref "PMID:24645673") Annotation(obo:IAO_0000116 "air pollution exposure") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000036) coho:COHO_0002618)
ClassAssertion(Annotation(rdfs:comment "This randomized controlled trial aimed to investigate the health effects of replacing food items with a high content of saturated fatty acids with food items where a large portion of the saturated fat had been replaced with polyunsaturated fat.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/NOMA") Annotation(obo:IAO_0000116 "replacing saturated fat with polyunsaturated fat in commercial food items") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0900053) coho:COHO_0002619)
ClassAssertion(Annotation(rdfs:comment "The study design for the HYDRIA survey followed the recommendations of the European Health Examination Survey (EHES) [18] and the European Food Safety Authority (EFSA) [19] for the collection of health and dietary data at a national level, allowing for intercountry comparisons.") Annotation(oboInOwl:hasDbXref "PMID:35334847") Annotation(obo:IAO_0000116 "dietary intake") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002620)
ClassAssertion(Annotation(rdfs:comment "The aim was to investigate whether the white wheat bread enriched with bioprocessed rye bran (BRB + WW) promotes similar effects to WGR on glucose metabolism and plasma levels of SCFAs in healthy subjects with self-reported gastrointestinal symptoms.") Annotation(oboInOwl:hasDbXref "PMID:25370913") Annotation(obo:IAO_0000116 "wholegrain rye bread") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070112) coho:COHO_0002621)
ClassAssertion(Annotation(rdfs:comment "The aim was to investigate whether the white wheat bread enriched with bioprocessed rye bran (BRB + WW) promotes similar effects to WGR on glucose metabolism and plasma levels of SCFAs in healthy subjects with self-reported gastrointestinal symptoms.") Annotation(oboInOwl:hasDbXref "PMID:25370913") Annotation(obo:IAO_0000116 "wheat bread enriched with bioprocessed rye bran") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000068) coho:COHO_0002621)
ClassAssertion(Annotation(rdfs:comment "This study aimed to investigate factors associated with weight management, especially whether satiety value of food as a part of a weight-maintenance diet would affect self-regulation of food intake and weight management.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ELIPA") Annotation(obo:IAO_0000116 "satiety value of foods in a weight-maintenance diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000068) coho:COHO_0002623)
ClassAssertion(Annotation(rdfs:comment "Concentrations of drinking water disinfection by-products (DBPs) during pregnancy were estimated from water company concentration and distribution data as part of the water contaminants and stillbirth, congenital anomalies, birth weight, preterm delivery (HiWate) project in four of the cohorts (BiB, KANC, INMA, RHEA).") Annotation(oboInOwl:hasDbXref "PMID:30206078") Annotation(obo:IAO_0000116 "drinking water disinfection by-products during pregnancy") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_7000125) coho:COHO_0002626)
ClassAssertion(Annotation(rdfs:comment "The PELAGIE mother-child cohort was set up with the aim to study the effect of prenatal exposure to environmental and occupational chemicals on reproduction and child development.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PELAGIE") Annotation(obo:IAO_0000116 "prenatal exposure to environmental and occupational chemicals") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000231) coho:COHO_0002629)
ClassAssertion(Annotation(rdfs:comment "This study is based on a prospective population-based cohort in the Brittany region—the PELAGIE (Perturbateurs endocriniens: Étude Longitudinale sur les Anomalies de la Grossesse, l’Infertilité et l’Enfance) cohort—that collected urine samples from pregnant women between 2002 and 2006 to assess pesticide exposure biomarkers before the 19th week of gestation.") Annotation(oboInOwl:hasDbXref "PMID:21367690") Annotation(obo:IAO_0000116 "pesticide exposure") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000530) coho:COHO_0002629)
ClassAssertion(Annotation(rdfs:comment "The PELAGIE mother-child cohort was set up with the aim to study the effect of prenatal exposure to environmental and occupational chemicals on reproduction and child development.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PELAGIE") Annotation(obo:IAO_0000116 "endocrine disruptors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9001630) coho:COHO_0002629)
ClassAssertion(Annotation(rdfs:comment "This prospective birth cohort is designed to follow up 7000 children from their prenatal period to adolescence with the aim of assessing EXPOSOME factors potentially affecting children health.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/CELSPAC-TNG") Annotation(obo:IAO_0000116 "exposome factors (environment, lifestyle, nutrition) in pregnancy and early childhood") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002632)
ClassAssertion(Annotation(rdfs:comment "The CHILDREN_FIRST international cohort observatory study aims to investigate how the spatio-temporal evolution of the children’s exposome profiles in the Mediterranean region influences early-life programming of chronic disease risk during the critical window of susceptibility in primary school years (6–11 years of age).") Annotation(oboInOwl:hasDbXref "PMID:42044183") Annotation(obo:IAO_0000116 "children's exposome (molecular biomarkers, sensors and questionnaires across the three exposome domains)") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002633)
ClassAssertion(Annotation(rdfs:comment "The Barcelona Life Study Cohort (BiSC) is an exposome cohort, aiming to comprehensively evaluate the socio-environmental and genetic determinants (i) of foetal and child health, growth, and development towards adult life and (ii) of maternal mental and physical health and wellbeing during pregnancy and afterwards, while shedding light on the underlying biological mechanisms.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/BiSC") Annotation(obo:IAO_0000116 "socio-environmental exposome during pregnancy and childhood") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002635)
ClassAssertion(Annotation(rdfs:comment "The children included in the study met one of the following criteria: A) lived with a floricultural or agricultural worker for at least one year or B) never lived with a floricultural or agricultural worker, never resided in a house where agricultural pesticides were stored, and never had prior contact with pesticides.") Annotation(oboInOwl:hasDbXref "PMID:40777557") Annotation(obo:IAO_0000116 "secondary (take-home and residential) pesticide exposure in a floricultural community") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_0000530) coho:COHO_0002637)
ClassAssertion(Annotation(rdfs:comment "ESPINA is a prospective cohort study established in 2008 aimed at understanding the health effects of agrochemical and pesticide exposures, evaluated from childhood into adulthood.") Annotation(oboInOwl:hasDbXref "https://sites.ucsd.edu/espina/") Annotation(obo:IAO_0000116 "agrochemicals") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9001696) coho:COHO_0002637)
ClassAssertion(Annotation(rdfs:comment "To build a 'data warehouse' to make OHS data available for research and to investigate sector-specific health problems.") Annotation(oboInOwl:hasDbXref "PMID:26503980") Annotation(obo:IAO_0000116 "occupational exposures across employment sectors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0001591) coho:COHO_0002639)
ClassAssertion(Annotation(rdfs:comment "The main hypotheses of the HAPIEE study relate to the role of alcohol, nutrition and psychosocial factors.") Annotation(oboInOwl:hasDbXref "PMID:17049075") Annotation(obo:IAO_0000116 "alcohol") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000026) coho:COHO_0002640)
ClassAssertion(Annotation(rdfs:comment "The main hypotheses of the HAPIEE study relate to the role of alcohol, nutrition and psychosocial factors.") Annotation(oboInOwl:hasDbXref "PMID:17049075") Annotation(obo:IAO_0000116 "nutrition") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9001695) coho:COHO_0002640)
ClassAssertion(Annotation(rdfs:comment "A Research Plan for a Randomised, Single-blind, Parallel Group Controlled Trial in Rural Malawi, Testing the Health Effects of Supplementing Maternal Diet During Pregnancy and Lactation and Infant Diet From 6 to 18 Months of Age With High-energy, Micronutrient Fortified Lipid-based Nutrient Supplements (LNS)") Annotation(oboInOwl:hasDbXref "https://clinicaltrials.gov/study/NCT01239693") Annotation(obo:IAO_0000116 "small-quantity lipid-based nutrient supplements") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070245) coho:COHO_0002641)
ClassAssertion(Annotation(rdfs:comment "Multiple micronutrient supplementation to the mother during pregnancy and six months thereafter (MMN group), 3) Lipid-based nutrient supplements to the mother during pregnancy and six months thereafter and to the child from 6 to 18 months of age (LNS group).") Annotation(oboInOwl:hasDbXref "https://clinicaltrials.gov/study/NCT01239693") Annotation(obo:IAO_0000116 "multiple micronutrients") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0900369) coho:COHO_0002641)
ClassAssertion(Annotation(rdfs:comment "Women during pregnancy: 1 tablet of iron+ folate daily until delivery (60 mg iron + 400 ug folic acid)") Annotation(oboInOwl:hasDbXref "https://clinicaltrials.gov/study/NCT01239693") Annotation(obo:IAO_0000116 "iron-folic acid") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000097) coho:COHO_0002641)
ClassAssertion(Annotation(rdfs:comment "The New Hampshire Birth Cohort Study is a research project that is investigating how various factors such as contaminants in the environment affect the health of pregnant women and their children.") Annotation(oboInOwl:hasDbXref "https://www.protectkidshealth.com/about") Annotation(obo:IAO_0000116 "environmental contaminants") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000931) coho:COHO_0002642)
ClassAssertion(Annotation(rdfs:comment "The New Hampshire Birth Cohort Study is a research project that is investigating how various factors such as contaminants in the environment affect the health of pregnant women and their children.") Annotation(oboInOwl:hasDbXref "https://www.protectkidshealth.com/about") Annotation(obo:IAO_0000116 "arsenic from private well water") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0080000) coho:COHO_0002642)
ClassAssertion(Annotation(rdfs:comment "Our primary objectives are to (1) examine the effects that low-level environmental chemical exposures have on birth outcomes, including birth defects and growth retardation;") Annotation(oboInOwl:hasDbXref "PMID:34022817") Annotation(obo:IAO_0000116 "low-level environmental chemical exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000931) coho:COHO_0002646)
ClassAssertion(Annotation(rdfs:comment "Our primary objectives are to (1) examine the effects that low-level environmental chemical exposures have on birth outcomes, including birth defects and growth retardation; (2) follow the development of allergies, infectious diseases, and neurobehavioral developmental disorders, as well as perform a longitudinal observation of child development; (3) identify high-risk groups based on genetic susceptibility to environmental chemicals; and (4) identify the additive effects of various chemicals, including tobacco.") Annotation(oboInOwl:hasDbXref "PMID:34022817") Annotation(obo:IAO_0000116 "tobacco") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0100013) coho:COHO_0002646)
ClassAssertion(Annotation(rdfs:comment "Since the beginning of the Hokkaido Study, we have observed how maternal exposure to environmental chemicals, such as PCBs, dioxins, OCPs, and PFAS, affect children’s birth size, hormonal disruptions, and gene–environment interactions at birth [9].") Annotation(oboInOwl:hasDbXref "PMID:34022817") Annotation(obo:IAO_0000116 "PFAS") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9002160) coho:COHO_0002646)
ClassAssertion(Annotation(rdfs:comment "The interventional arm of the GINIplus study was a double-blind, randomized, placebo-controlled trial (DBRCT) using hydrolyzed formula nutrition and carried out in children with a family history of allergy during the first 4 months of life.") Annotation(oboInOwl:hasDbXref "PMID:30402607") Annotation(obo:IAO_0000116 "infant nutritional intervention") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000068) coho:COHO_0002647)
ClassAssertion(Annotation(rdfs:comment "We analyzed the natural course of atopic diseases and the role of life-style, environmental, and genetic factors for disease onset, intermediate phenotypes, and genes involved in detoxification and oxidative stress.") Annotation(oboInOwl:hasDbXref "PMID:30402607") Annotation(obo:IAO_0000116 "environmental and lifestyle influences on allergy development") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002647)
ClassAssertion(Annotation(rdfs:comment "a randomized controlled trial aimed to evaluate whether dietary supplementation with four walnuts per day (30 kernel grams) for 6 months improved brain neuropsychological and socio-emotional development compared to a control group (abstention from walnuts) in healthy teenagers (11–16 years old)") Annotation(oboInOwl:hasDbXref "PMID:35960396") Annotation(obo:IAO_0000116 "walnut intake (omega-3 fatty acids)") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070155) coho:COHO_0002648)
ClassAssertion(Annotation(rdfs:comment "Exposure assessment to metals, pesticides and plasticizersThe assessed compound concentrations in the collected biological samples will be determined throughout the study, as described in Table II.") Annotation(oboInOwl:hasDbXref "PMID:32566487") Annotation(obo:IAO_0000116 "pesticides") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000530) coho:COHO_0002650)
ClassAssertion(Annotation(rdfs:comment "The Rio Birth Cohort Study (PIPA project) is a prospective maternal-infant health study, hosted in the city of Rio de Janeiro (Southeastern Brazil), designed to investigate separate and combined effects of environmental chemical pollutants, as well as the interactions between these exposures and sociocultural environment and epigenetic patterns.") Annotation(oboInOwl:hasDbXref "PMID:32566487") Annotation(obo:IAO_0000116 "environmental chemical pollutants") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000931) coho:COHO_0002650)
ClassAssertion(Annotation(rdfs:comment "Exposure assessment to metals, pesticides and plasticizersThe assessed compound concentrations in the collected biological samples will be determined throughout the study, as described in Table II.") Annotation(oboInOwl:hasDbXref "PMID:32566487") Annotation(obo:IAO_0000116 "metals") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000175) coho:COHO_0002650)
ClassAssertion(Annotation(rdfs:comment "The study comprises four major components: gestational endpoints, birth endpoints, childhood developmental endpoints and metal, pesticide and plasticizer exposure assessments.") Annotation(oboInOwl:hasDbXref "PMID:32566487") Annotation(obo:IAO_0000116 "plasticizers") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9002071) coho:COHO_0002650)
ClassAssertion(Annotation(rdfs:comment "PROGRESS is a longitudinal birth cohort study conducted in Mexico that investigates prenatal exposure to mixtures of metals, air pollution, and phthalates.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PROGRESS") Annotation(obo:IAO_0000116 "air pollution") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000036) coho:COHO_0002651)
ClassAssertion(Annotation(rdfs:comment "PROGRESS is a longitudinal birth cohort study conducted in Mexico that investigates prenatal exposure to mixtures of metals, air pollution, and phthalates.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PROGRESS") Annotation(obo:IAO_0000116 "metals") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000175) coho:COHO_0002651)
ClassAssertion(Annotation(rdfs:comment "PROGRESS is a longitudinal birth cohort study conducted in Mexico that investigates prenatal exposure to mixtures of metals, air pollution, and phthalates.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PROGRESS") Annotation(obo:IAO_0000116 "phthalates") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000906) coho:COHO_0002651)
ClassAssertion(Annotation(rdfs:comment "The Infants’ Environmental Health Study [Infantes y Salud Ambiental (ISA)] is a prospective community-based birth cohort study in Matina County, Limón, Costa Rica, aimed at examining possible effects of prenatal pesticide and manganese exposure on children’s growth and neurodevelopment.") Annotation(oboInOwl:hasDbXref "PMID:25198283") Annotation(obo:IAO_0000116 "prenatal pesticide exposure") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000530) coho:COHO_0002652)
ClassAssertion(Annotation(rdfs:comment "The Infants’ Environmental Health Study [Infantes y Salud Ambiental (ISA)] is a prospective community-based birth cohort study in Matina County, Limón, Costa Rica, aimed at examining possible effects of prenatal pesticide and manganese exposure on children’s growth and neurodevelopment.") Annotation(oboInOwl:hasDbXref "PMID:25198283") Annotation(obo:IAO_0000116 "manganese") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000946) coho:COHO_0002652)
ClassAssertion(Annotation(rdfs:comment "Cross-sectional study performed in 2021 to assess differences in exposure of farmers (organic and non-organic practises), neighbours (people living close to agricultural fields) and controls ('consumers' living away from agricultural fields) to pesticides.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SPRINT") Annotation(obo:IAO_0000116 "pesticide mixtures (plant protection products) among farmers, neighbours of agricultural fields and consumers") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_0000530) coho:COHO_0002654)
ClassAssertion(Annotation(rdfs:comment "Su objetivo fue analizar la situación alimentaria y nutricional de la población colombiana enmarcada en el modelo de determinantes sociales, como insumo para la formulación, seguimiento y reorientación de políticas públicas de seguridad alimentaria y nutricional para el país.") Annotation(oboInOwl:hasDbXref "https://www.icbf.gov.co/ensin-encuesta-nacional-de-situacion-nutricional-0") Annotation(obo:IAO_0000116 "dietary intake") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002657)
ClassAssertion(Annotation(rdfs:comment "The ECUAVIDA birth cohort is studying the impact of exposures to soil-transmitted helminth (STH) parasites and early-life microbial exposures on the development of atopy, allergic diseases and immune responses in childhood.") Annotation(oboInOwl:hasDbXref "PMID:24990475") Annotation(obo:IAO_0000116 "soil-transmitted helminth (STH) parasites") Annotation(obo:IAO_0000116 "early-life microbial exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_3000000) coho:COHO_0002659)
ClassAssertion(Annotation(rdfs:comment "The aim of the 3xG study is to follow-up the health and development of growing children as a sentinel population and to study the influence of environmental exposures via biomonitoring.") Annotation(oboInOwl:hasDbXref "PMID:36976969") Annotation(obo:IAO_0000116 "environmental exposures via biomonitoring") Annotation(obo:IAO_0000116 "environmental and lifestyle exposure") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002663)
ClassAssertion(Annotation(rdfs:comment "The COMBAT cohort is a longitudinal, community-based study in Tuvalu examining lifestyle behaviors, environmental exposures, and health outcomes.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/COMBAT") Annotation(obo:IAO_0000116 "lifestyle behaviors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0002665)
ClassAssertion(Annotation(rdfs:comment "The aim of this study was to analyze temporal trends of food consumption patterns, attitudes, and health-related knowledge in Tuvalu, a small Pacific Island country facing the triple threat of obesity, climate change, and food insecurity.") Annotation(oboInOwl:hasDbXref "PMID:38810531") Annotation(obo:IAO_0000116 "food consumption patterns") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002665)
ClassAssertion(Annotation(rdfs:comment "Additionally, this study also integrates individual climate data utilizing satellite-based prediction models, and estimates historical temperature, precipitation, and sea level trends among all islands in Tuvalu.") Annotation(oboInOwl:hasDbXref "PMID:38810531") Annotation(obo:IAO_0000116 "climate change") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_8000008) coho:COHO_0002665)
ClassAssertion(Annotation(rdfs:comment "To estimate i) The toxic effect of particulate matter transcending the approach based on pollutant concentration levels; ii) The risk of developing an upper and lower ARI, based on different exposure windows; iii) A baseline of early biological damage in children under five, and describe its progression after a one-year follow-up; and iv) How physical and chemical PM2.5 characteristics influence toxicity and children’s health.") Annotation(oboInOwl:hasDbXref "PMID:36662732") Annotation(obo:IAO_0000116 "particulate matter (PM2.5)") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_7000117) coho:COHO_0002668)
ClassAssertion(Annotation(rdfs:comment "For environmental exposures PM2.5 will be sampled, and questionnaires, geographic information, dispersion models and Land Use Regression models for PM2.5 and NO2 will be used.") Annotation(oboInOwl:hasDbXref "PMID:36662732") Annotation(obo:IAO_0000116 "NO2") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9000252) coho:COHO_0002668)
ClassAssertion(Annotation(rdfs:comment "This study aims to characterize the external exposome (ambient and indoor exposures) and its contribution to clinical respiratory and early biological effects in children.") Annotation(oboInOwl:hasDbXref "PMID:36662732") Annotation(obo:IAO_0000116 "external exposome (ambient and indoor exposures)") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002668)
ClassAssertion(Annotation(rdfs:comment "Butajira Nutrition, Mental Health, and Pregnancy (BUNMAP) Study, a population-based prospective cohort study aimed at evaluating the role of maternal nutrition, mycotoxin exposure, and mental health on prenatal and postnatal growth and development that was conducted between October 2017 and November 2020 in the Butajira Health and Demographic Surveillance Site under Addis Ababa University, Ethiopia.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/BUNMAP") Annotation(obo:IAO_0000116 "mycotoxin exposure") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000524) coho:COHO_0002669)
ClassAssertion(Annotation(rdfs:comment "Butajira Nutrition, Mental Health, and Pregnancy (BUNMAP) Study, a population-based prospective cohort study aimed at evaluating the role of maternal nutrition, mycotoxin exposure, and mental health on prenatal and postnatal growth and development that was conducted between October 2017 and November 2020 in the Butajira Health and Demographic Surveillance Site under Addis Ababa University, Ethiopia.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/BUNMAP") Annotation(obo:IAO_0000116 "maternal nutrition") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000076) coho:COHO_0002669)
ClassAssertion(Annotation(rdfs:comment "The primary aims of the GCS are: (i) To identify risk factors for OC by a comprehensive assessment of ethnicity, occupational history, socio-economic status, past medical history, family history of cancers, gastrointestinal symp- toms and signs, tobacco, opium and alcohol use, oral health, anthropometric characteristics, physi- cal activity and tea drinking habits, including tea temperature.") Annotation(oboInOwl:hasDbXref "PMID:19332502") Annotation(obo:IAO_0000116 "tea drinking habits, including tea temperature") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0070133) coho:COHO_0002671)
ClassAssertion(Annotation(rdfs:comment "However, they pointed to several factors, including: (i) a diet deficient in fruits and vegetables;4 (ii) low socio-economic status; (iii) thermal injury from consumption of very hot tea;5 and (iv) carcinogen exposure from lifestyle factors including opium consumption.6–8 The high incidence of OC in Golestan was confirmed by a recent screening study.9 Aetiological hypotheses related to diet and life style can be best addressed in prospective cohort studies, in which measurement error can be reduced and recall bias is minimal.") Annotation(oboInOwl:hasDbXref "PMID:19332502") Annotation(obo:IAO_0000116 "opium use") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0100006) coho:COHO_0002671)
ClassAssertion(Annotation(rdfs:comment "Chemical and Metal Exposures at WorkUltraviolet Light ExposureWorkplace CharacteristicsHobby Exposures") Annotation(oboInOwl:hasDbXref "PMID:41927563") Annotation(obo:IAO_0000116 "ultraviolet light exposure") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000006) coho:COHO_0002686)
ClassAssertion(Annotation(rdfs:comment "The External Exposome Survey (Exposome Part A) (N = 3,618) is focused on external exposures, including chemical and environmental exposures at work and home from childhood to the present.") Annotation(oboInOwl:hasDbXref "PMID:41927563") Annotation(obo:IAO_0000116 "chemical and environmental exposures at work and home") Annotation(obo:IAO_0000116 "chemical and metal exposures at work") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000231) coho:COHO_0002686)
ClassAssertion(Annotation(rdfs:comment "External Exposome (Exposome A)Characteristics of Current and Past Residences:• Agricultural Property Use• Garage and Basement• Heating and Cooling• Pesticides and Insecticides") Annotation(oboInOwl:hasDbXref "PMID:41927563") Annotation(obo:IAO_0000116 "pesticides and insecticides") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000530) coho:COHO_0002686)
ClassAssertion(Annotation(rdfs:comment "The goal of PEGS is to integrate these large-scale, multi-dimensional data to enable researchers to dissect the etiology of disease and identify the collective effects of environment, diet, lifestyle, and genetic factors on human health.") Annotation(oboInOwl:hasDbXref "PMID:41927563") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0002686)
ClassAssertion(Annotation(rdfs:comment "While most studies focus on a single disease or environmental exposure, PEGS collects data on multiple diseases and environmental exposures, including diet and lifestyle factors, in concert with genetic data.") Annotation(oboInOwl:hasDbXref "PMID:41927563") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002686)
ClassAssertion(Annotation(rdfs:comment "While most studies focus on a single disease or environmental exposure, PEGS collects data on multiple diseases and environmental exposures, including diet and lifestyle factors, in concert with genetic data.") Annotation(oboInOwl:hasDbXref "PMID:41927563") Annotation(obo:IAO_0000116 "environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002686)
ClassAssertion(Annotation(rdfs:comment "The Cancer Prevention Study II Nutrition Cohort was established in 1992 and was designed to investigate the relation between diet and other lifestyle factors and exposures and the risk of cancer, mortality, and survival.") Annotation(oboInOwl:hasDbXref "PMID:12015775") Annotation(obo:IAO_0000116 "diet and other lifestyle factors and exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0002690)
ClassAssertion(Annotation(rdfs:comment "The goal of the ECHO Program is to understand how the environment, from preconception through early childhood, influences child health and development to identify opportunities to mitigate the risk of disease and optimize health and thriving (4).") Annotation(oboInOwl:hasDbXref "PMID:36963379") Annotation(obo:IAO_0000116 "chemicals") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000231) coho:COHO_0002691)
ClassAssertion(Annotation(rdfs:comment "Exposures include place-, family-, and individual-level factors in the domains of: chemical and physical (e.g., air pollution, phthalates, drinking water source), community (e.g., neighborhood deprivation and opportunity, segregation), psychosocial (e.g., stress, discrimination, parental mental health, socioeconomic status, family dynamics), behaviors (e.g., sleep, physical activity, diet), and biological factors (e.g., genomics, microbiome, metabolomics).") Annotation(oboInOwl:hasDbXref "PMID:36963379") Annotation(obo:IAO_0000116 "diet") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002691)
ClassAssertion(Annotation(rdfs:comment "The goal of the ECHO Program is to understand how the environment, from preconception through early childhood, influences child health and development to identify opportunities to mitigate the risk of disease and optimize health and thriving (4).") Annotation(oboInOwl:hasDbXref "PMID:36963379") Annotation(obo:IAO_0000116 "physical activity") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000039) coho:COHO_0002691)
ClassAssertion(Annotation(rdfs:comment "Exposures include place-, family-, and individual-level factors in the domains of: chemical and physical (e.g., air pollution, phthalates, drinking water source), community (e.g., neighborhood deprivation and opportunity, segregation), psychosocial (e.g., stress, discrimination, parental mental health, socioeconomic status, family dynamics), behaviors (e.g., sleep, physical activity, diet), and biological factors (e.g., genomics, microbiome, metabolomics).") Annotation(oboInOwl:hasDbXref "PMID:36963379") Annotation(obo:IAO_0000116 "drinking water source") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_7000125) coho:COHO_0002691)
