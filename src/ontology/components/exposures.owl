ClassAssertion(Annotation(rdfs:comment "1) to prepare a molecular genetic and epidemiological risk assessment model based on environmental exposures and genetic predisposition") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12212983+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002009)
ClassAssertion(Annotation(rdfs:comment "The intensive lifestyle intervention is designed to achieve and maintain weight loss through decreased caloric intake and increased physical activity.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14500058+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "decreased caloric intake") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_2000065) coho:COHO_0002015)
ClassAssertion(Annotation(rdfs:comment "The intensive lifestyle intervention is designed to achieve and maintain weight loss through decreased caloric intake and increased physical activity.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14500058+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "increased physical activity") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000039) coho:COHO_0002015)
ClassAssertion(Annotation(rdfs:comment "Enrollment was restricted to current and former smokers aged 40–74 years with a minimum of 10 pack-years of smoking.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5669789/fullTextXML") Annotation(obo:IAO_0000116 "smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000013) coho:COHO_0002019)
ClassAssertion(Annotation(rdfs:comment "Proband smokers were required to be at least 21 years old, to have smoked for at least the last five years, and to have consumed at least 20 cigarettes per day for the preceding 12 months.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2739294/fullTextXML") Annotation(obo:IAO_0000116 "smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000013) coho:COHO_0002096)
ClassAssertion(Annotation(rdfs:comment "The aims of the present study were to evaluate the effect of PNPLA3, TM6SF2, and GCKR genetic variants on a NAFLD case–control Greek cohort, to assess the impact of dietary habits and to further explore the interaction of these three single nucleotide polymorphisms (SNPs) with dietary factors and their effect on NAFLD.") Annotation(oboInOwl:hasDbXref "https://link.springer.com/article/10.1007/s00394-018-1675-4") Annotation(obo:IAO_0000116 "dietary habits") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000021) coho:COHO_0002105)
ClassAssertion(Annotation(rdfs:comment "Twin pairs concordant for smoking history were recruited along with their family members, as part of the multisite Nicotine Addiction Genetics consortium.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24927283+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "smoking history") Annotation(obo:IAO_0000116 "heavy smoking") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000029) coho:COHO_0002106)
ClassAssertion(Annotation(rdfs:comment "These multicenter, hospital-based case–control studies of breast cancer were designed to determine lifestyle factors and genetic susceptibility to the risk of breast cancer and to compare potential risk factors among Japanese living in Nagano, Japan, and Japanese Brazilians and non-Japanese Brazilians living in São Paulo, Brazil.") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1007/s10549-008-0168-1") Annotation(obo:IAO_0000116 "lifestyle factors") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0002107)
ClassAssertion(Annotation(rdfs:comment "In this study, we used toenail arsenic concentration as a biomarker of exposure to examine the risk of lung cancer among persons in the U.S. population who had been exposed to low levels of arsenic in drinking water.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2801179/fullTextXML") Annotation(obo:IAO_0000116 "arsenic in drinking water") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0080000) coho:COHO_0002133)
ClassAssertion(Annotation(rdfs:comment "The primary objective of the UMHS was to determine if pesticides were associated with an increased risk of glioma, the most common type of brain tumor in adults [13].") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3406961/") Annotation(obo:IAO_0000116 "pesticides") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_0000530) coho:COHO_0002158)
ClassAssertion(Annotation(rdfs:comment "We conducted a population-based case-control study, the NJ Ovarian Cancer Study, specifically designed to evaluate phytoestrogens and ovarian cancer risk in New Jersey, a population characterized by large ethnic diversity.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3196697/fullTextXML") Annotation(obo:IAO_0000116 "phytoestrogens") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_9002037) coho:COHO_0002160)
ClassAssertion(Annotation(rdfs:comment "The NLBLC sample that participated in the CPD meta analysis is described with the lung cancer and peripheral arterial disease samples.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.573/MediaObjects/41588_2010_BFng573_MOESM34_ESM.pdf") Annotation(obo:IAO_0000116 "cigarettes smoked per day") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000038) coho:COHO_0002164)
ClassAssertion(Annotation(rdfs:comment "Patients who were diagnosed in one of three hospitals (Radboud university medical center and Canisius Wilhelmina Hospital in Nijmegen and Rijnstate Hospital in Arnhem) since 1989 and who were still alive at April 15th, 2008 were recruited for a study on gene-environment interactions in lung cancer.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") Annotation(obo:IAO_0000116 "environment") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002165)
ClassAssertion(Annotation(rdfs:comment "The Nottingham Smokers cohort is an ongoing collection in Nottingham using the following criteria; European ancestry, >40 years of age and smoking history of >10 pack years (currently n = 538).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4006731/fullTextXML") Annotation(obo:IAO_0000116 "smoking history of > 10 pack years") ObjectSomeValuesFrom(coho:has_participants_with_exposure obo:ECTO_6000029) coho:COHO_0002176)
ClassAssertion(Annotation(rdfs:comment "Therefore, we undertook a large, population-based case-control study of NPC in southern China (the NPC Genes, Environment, and EBV (NPCGEE) study) with the specific aims of understanding the independent and interactive roles of genes, environmental exposures, and infection with the Epstein-Barr virus (EBV) in disease etiology.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5675616/fullTextXML") Annotation(obo:IAO_0000116 "infection with the Epstein-Barr virus (EBV)") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_3000273) coho:COHO_0002178)
ClassAssertion(Annotation(rdfs:comment "Therefore, we undertook a large, population-based case-control study of NPC in southern China (the NPC Genes, Environment, and EBV (NPCGEE) study) with the specific aims of understanding the independent and interactive roles of genes, environmental exposures, and infection with the Epstein-Barr virus (EBV) in disease etiology.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5675616/fullTextXML") Annotation(obo:IAO_0000116 "environmental exposures") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ExO_0000002) coho:COHO_0002178)
ClassAssertion(Annotation(rdfs:comment "In the prospective Ovarian cancer Prognosis And Lifestyle (OPAL) study, diet-quality scores were calculated using data from food frequency questionnaires completed pre-diagnosis (n = 650) and 12 months' post-diagnosis (n = 503).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33144284+AND+SRC%3AMED&format=json&resultType=core") Annotation(obo:IAO_0000116 "lifestyle") ObjectSomeValuesFrom(coho:is_designed_to_study_exposure obo:ECTO_6000015) coho:COHO_0002210)
