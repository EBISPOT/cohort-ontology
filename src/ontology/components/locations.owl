ObjectPropertyAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11875162/fullTextXML") Annotation(rdfs:comment "The Santiago Longitudinal Study (SLS) is a cohort of participants recruited from community clinics in Santiago, Chile, at infancy between 1991 and 1996 for participation in a randomized trial of iron supplementation to prevent iron deficiency anemia, as described previously.24 Participants were followed during infancy and at ages 5, 10, 16 or 17, and 21 or 22 years and assessed for a range of outcomes.25 Standardized BMIzs were computed using the 2000 CDC Growth Reference charts.21 A total of n = 861 SLS participants were included in the GWAS of BMIz (mean age = 5.51 years).") <http://www.ebi.ac.uk/coho/has_data_collection_location> <http://www.ebi.ac.uk/coho/COHO_0001407> <http://dbpedia.org/resource/Chile>)

