ObjectPropertyAssertion(Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8898610/fullTextXML") Annotation(rdfs:comment "For access and sharing, biological resources of the BICWALZS were stored in the BICWALZS consortium biobank (www.bicwalzs.com/) as well as the National Biobank of Korea (www.nih.go.kr/biobank) which is a central biobank supporting for the Korea Biobank Project.") <http://www.ebi.ac.uk/coho/hasCohort> <http://www.ebi.ac.uk/coho/COHO_0000926> <http://www.ebi.ac.uk/coho/COHO_0001530>)

