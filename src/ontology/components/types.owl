ClassAssertion(Annotation(rdfs:comment "The study has enrolled serial probands, unaffected and affected family members with atrial fibrillation.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001001") coho:COHO_0000000 coho:COHO_0001023)
