ClassAssertion(Annotation(rdfs:comment "The Korean osteoporosis study at Asan Medical Center (KorAMC) study is a hospital registered, cross-sectional study of postmenopausal Korean women in Seoul [49].") Annotation(oboInOwl:hasDbXref "PMID:24516880") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4102322/") coho:COHO_0000000 coho:COHO_0001976)
