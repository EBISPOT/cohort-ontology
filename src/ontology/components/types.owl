ClassAssertion(Annotation(rdfs:comment "The SHEEP study is a population-based case–control study of risk factors for incident myocardial infarction and has been described in detail elsewhere.") Annotation(oboInOwl:hasDbXref "PMID:17108306") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC2465514") coho:COHO_0000000 coho:COHO_0002375)
