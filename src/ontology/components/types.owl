ClassAssertion(Annotation(rdfs:comment "We examined patient blood samples from a prospective observational trial of 365 individuals examined consecutively at Bispebjerg Hospital in Copenhagen, Denmark (LUCAS cohort) during a seven-month period.") Annotation(oboInOwl:hasDbXref "PMID:34417454") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8379179/fullTextXML") coho:COHO_0000000 coho:COHO_0000291)
ClassAssertion(Annotation(rdfs:comment "We examined the associations of adherence to the DGA with total and cause-specific mortality in the Southern Community Cohort Study, a prospective study that recruited 84,735 American adults, aged 40–79 y, from 12 southeastern US states during 2002–2009, mostly through community health centers that serve low-income populations.") Annotation(oboInOwl:hasDbXref "https://journals.plos.org/plosmedicine/article?id=10.1371/journal.pmed.1001830") coho:COHO_0000000 coho:COHO_0000621)
