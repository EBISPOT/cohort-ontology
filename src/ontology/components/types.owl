ClassAssertion(Annotation(rdfs:comment "The Multicenter AIDS Cohort Study (MACS) is an ongoing prospective study of the natural and treated histories of HIV-1 infection in homosexual and bisexual men conducted by sites located in Baltimore, Chicago, Pittsburgh and Los Angeles.") Annotation(oboInOwl:hasDbXref "PMID:37532928") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-023-06370-4/MediaObjects/41586_2023_6370_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001368)
