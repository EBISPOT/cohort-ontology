ClassAssertion(Annotation(rdfs:comment "The FOURIER trial was a multinational, randomized, double-blind, placebo-controlled trial of the efficacy of evolocumab in patients with clinically evident atherosclerotic cardiovascular disease.") Annotation(oboInOwl:hasDbXref "PMID:31707849") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8058781/unicode") coho:COHO_0000000 coho:COHO_0001739)
ClassAssertion(Annotation(rdfs:comment "The Facteurs de Risques et de Récidives de la Maladie Thromboembolique Veineuse (FARIVE) study is a multicenter case–control study composed of 607 patients with a documented episode DVT and/or PE and 607 healthy individuals.") Annotation(oboInOwl:hasDbXref "PMID:37399490") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10506044/fullTextXML") coho:COHO_0000000 coho:COHO_0001323)
ClassAssertion(Annotation(rdfs:comment "The Family Atherosclerosis Monitoring in Early Life (FAMILY) study is a longitudinal birth cohort study with 857 families (901 newborns) enrolled from 2002 and 2009 from three hospitals in Ontario, Canada.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10613963/fullTextXML") coho:COHO_0000000 coho:COHO_0000680)
ClassAssertion(Annotation(rdfs:comment "The Family Blood Pressure Program (FBPP) consists of 4 independently established multicenter networks of investigators who have complementary approaches to the genetics of blood pressure levels and hypertension.") Annotation(oboInOwl:hasDbXref "PMID:11799070") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11799070+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000001 coho:COHO_0000608)
ClassAssertion(Annotation(rdfs:comment "The Family Investigation of Nephropathy and Diabetes (FIND) is a multicenter study designed to identify genetic determinants of diabetic nephropathy.") Annotation(oboInOwl:hasDbXref "PMID:15642484") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15642484+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000729)
ClassAssertion(Annotation(rdfs:comment "The FinGesture study started in 1999 aimed at collecting consecutive victims of out-of-hospital sudden death from a defined geographical area, Oulu University Hospital District in northern Finland.") Annotation(oboInOwl:hasDbXref "PMID:21738491") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3128111/fullTextXML") coho:COHO_0000000 coho:COHO_0001726)
ClassAssertion(Annotation(rdfs:comment "The Flemish Gut Flora Project (FGFP) is a population-based cohort that comprises individuals from the Flanders region of Belgium.58,59") Annotation(oboInOwl:hasDbXref "PMID:34957435") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8654685/fullTextXML") coho:COHO_0000000 coho:COHO_0000072)
ClassAssertion(Annotation(rdfs:comment "The Flemish Study on Environment, Genes, and Health Outcomes (FLEMENGHO) is an observational, community-based cohort study on cardiovascular risk factors and outcomes in the adult Belgian population.") Annotation(oboInOwl:hasDbXref "PMID:40979826") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12445332/fullTextXML") coho:COHO_0000000 coho:COHO_0001734)
ClassAssertion(Annotation(rdfs:comment "The Follow-up Study was an observational study in the NPCR, with the aim of assessing outcome among patients with localized prostate cancer who were diagnosed after PSA testing had become prevalent in Sweden and for whom curative treatment may have been indicated.") Annotation(oboInOwl:hasDbXref "PMID:20562373") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2897875/") coho:COHO_0000000 coho:COHO_0002725)
ClassAssertion(Annotation(rdfs:comment "The Food Chain Plus (FoCus) cohort was launched in 2011 for population-based research related to metabolic inflammation.") Annotation(oboInOwl:hasDbXref "PMID:36245062") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36245062+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000415)
ClassAssertion(Annotation(rdfs:comment "The French MS Genetics group (REFGENSEP) has been prospectively collecting samples with twenty-three centers covering France.") Annotation(oboInOwl:hasDbXref "PMID:24076602") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2770/MediaObjects/41588_2013_BFng2770_MOESM23_ESM.pdf") coho:COHO_0000000 coho:COHO_0002310)
