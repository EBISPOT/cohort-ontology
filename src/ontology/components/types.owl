ClassAssertion(Annotation(rdfs:comment "The NICCC-LCA study is an ongoing case-control study of newly diagnosed lung cancer cases of any histology and population age/sex/ethnicity-matched \"healthy\" controls.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0002150)
ClassAssertion(Annotation(rdfs:comment "The NIDDM-Atherosclerosis Study was designed as a family study to examine the genetic basis of subclinical atherosclerosis and diabetes (25).") Annotation(oboInOwl:hasDbXref "PMID:24124113") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3968231/") coho:COHO_0000000 coho:COHO_0001045)
ClassAssertion(Annotation(rdfs:comment "The NIHR BioResource is a recallable resource of over 250,000 volunteers, with and without health conditions who have agreed to take part in health-related research.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0000312)
ClassAssertion(Annotation(rdfs:comment "The NINFEA cohort is an Internet-based birth cohort established in Italy with the aim of investigating the effects of early life exposures on the health of newborns, infants, adolescents and adults.") Annotation(oboInOwl:hasDbXref "PMID:17955333") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1007/s10654-007-9194-2") coho:COHO_0000000 coho:COHO_0002605)
ClassAssertion(Annotation(rdfs:comment "The NSHD is based on a social class stratified sample of 5,362 births of all singleton births that occurred within marriage in a week in March 1946 in England, Scotland and Wales.") Annotation(oboInOwl:hasDbXref "PMID:23637643") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3637651/fullTextXML") coho:COHO_0000000 coho:COHO_0001026)
ClassAssertion(Annotation(rdfs:comment "The NSHDS is a population-based prospective longitudinal cohort comprising >140 000 participants in the two northernmost regions in Sweden, Norrbotten and Västerbotten, with >240 000 blood samples and 1.5 million person-years of follow-up.") Annotation(oboInOwl:hasDbXref "PMID:39899988") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") coho:COHO_0000000 coho:COHO_0000927)
ClassAssertion(Annotation(rdfs:comment "The NUgene Project is a genomic biobank sponsored by the Center for Genetic Medicine at Northwestern University in partnership with Northwestern Medicine.") Annotation(oboInOwl:hasDbXref "https://www.cgm.northwestern.edu/cores/nugene/index.html") coho:COHO_0000000 coho:COHO_0000790)
