ClassAssertion(Annotation(rdfs:comment "The MELARISK study comprised of 1,244 European-ancestry melanoma cases who were recruited through a nationwide network of French Dermatology Departments and Oncogenetic clinics between 1992 and 2011.") Annotation(oboInOwl:hasDbXref "PMID:27347659") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5116391/unicode") coho:COHO_0000000 coho:COHO_0001372)
ClassAssertion(Annotation(rdfs:comment "The MEMENTO cohort is a large, clinic-based cohort of participants consulting in French memory clinics and presenting with either isolated cognitive complaints or recently diagnosed mild cognitive impairment (MCI).") Annotation(oboInOwl:hasDbXref "PMID:28851447") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5576287/") coho:COHO_0000000 coho:COHO_0000785)
ClassAssertion(Annotation(rdfs:comment "The METASTROKE collaboration brings together GWAS data from more than 12 000 cases of ischaemic stroke and 60 000 controls from 15 cohorts all of European ancestry.") Annotation(oboInOwl:hasDbXref "PMID:23041239") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3490334/") coho:COHO_0000001 coho:COHO_0000688)
ClassAssertion(Annotation(rdfs:comment "The MGRB is comprised of 4000 healthy, older individuals, mostly of European descent, recruited from two Australian community-based cohorts.") Annotation(oboInOwl:hasDbXref "PMID:30353151") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30353151+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000298)
ClassAssertion(Annotation(rdfs:comment "The MIBS cohort with biobank aims to identify subgroups of IBS according to phenotypical and genotypical characterization.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0000293)
ClassAssertion(Annotation(rdfs:comment "The MICROS study is a population-based survey on three small, isolated villages, characterized by: old settlement; small number of founders; high endogamy rates; slow/null population expansion.") Annotation(oboInOwl:hasDbXref "PMID:17550581") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17550581+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000834)
ClassAssertion(Annotation(rdfs:comment "The MONA LISA (Monitoring National du Risque Artériel; National Monitoring of Arterial Risk) Lille study was a population-based, cross-sectional study of a representative sample of 1578 participants recruited from within the Lille urban area in northern France.") Annotation(oboInOwl:hasDbXref "PMID:24885863") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4035696/fullTextXML") coho:COHO_0000000 coho:COHO_0002081)
ClassAssertion(Annotation(rdfs:comment "The MORGAM project comprises >128,000 men and women from 57 European (mainly white Caucasian) cohorts which were harmonised and prospectively followed up for incident coronary heart disease events [15].") Annotation(oboInOwl:hasDbXref "PMID:22848412") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3405046/fullTextXML") coho:COHO_0000001 coho:COHO_0000117)
