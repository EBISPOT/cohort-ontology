ClassAssertion(Annotation(rdfs:comment "The MS cases have at least one parent born within SO, and anonymous population controls were collected from the Central Hospital of Seinajoki in Southern Ostrobothnia.") Annotation(oboInOwl:hasDbXref "PMID:20159113") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2820168/") coho:COHO_0000000 coho:COHO_0001731)
