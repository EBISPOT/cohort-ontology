ClassAssertion(Annotation(rdfs:comment "Following quality control (see Methods), the DeCOI cohort comprised 1,220 individuals from across the entire phenotypic spectrum of SARS-CoV-2 infections (Figs 1A–1C and S1).") Annotation(oboInOwl:hasDbXref "PMID:39715278") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11706450/fullTextXML") coho:COHO_0000000 coho:COHO_0000861)
ClassAssertion(Annotation(rdfs:comment "For PROCAM-2, 17,312 employees were recruited in more than 50 regional companies and government authorities on a voluntary basis.") Annotation(oboInOwl:hasDbXref "PMID:39112778") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-024-02688-1/MediaObjects/41380_2024_2688_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001029)
