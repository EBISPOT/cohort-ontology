ClassAssertion(Annotation(rdfs:comment "There are 7 principal Taiwan based cohorts that make up the current TaiChi bio-resource with a total of 11,859 subjects in the current study.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") coho:COHO_0000001 coho:COHO_0000765)
ClassAssertion(Annotation(rdfs:comment "There are six groups of participants in the Framingham Heart Study: Original Cohort, Offspring Cohort, Third Generation Cohort, New Offspring Spouse Cohort, Omni Generation 1 Cohort, and Omni Generation 2 Cohort.") Annotation(oboInOwl:hasDbXref "https://www.framinghamheartstudy.org/fhs-about/") coho:COHO_0000000 coho:COHO_0000385)
ClassAssertion(Annotation(rdfs:comment "There thus is a clear rationale for the Dominantly Inherited Alzheimer Network (DIAN), a global ADAD network that uses standard and uniform assessment protocols to obtain longitudinal clinical, cognitive, genetic, neuroimaging, biofluid, and neuropathological data.") Annotation(oboInOwl:hasDbXref "PMID:23139856") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3489185/") coho:COHO_0000000 coho:COHO_0000368)
ClassAssertion(Annotation(rdfs:comment "There were 7 independent cross-sectional surveys for major CV risk factors conducted in the Czech Republic in the same 6 country districts within the WHO MONICA Project (1985, 1988, 1992) and the Czech post-MONICA study (1997/98, 2000/01, 2007/08 and 2016/2017), including a total of 7,606 males and 8,050 females.") Annotation(oboInOwl:hasDbXref "PMID:32392239") Annotation(oboInOwl:hasDbXref "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0232845") coho:COHO_0000000 coho:COHO_0001642)
ClassAssertion(Annotation(rdfs:comment "There were two clinical populations in the PARC study, which has been described in detail previously38 .") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature09270/MediaObjects/41586_2010_BFnature09270_MOESM283_ESM.pdf") coho:COHO_0000001 coho:COHO_0002231)
ClassAssertion(Annotation(rdfs:comment "There were two parts to the study: an online portion consisting of surveys and behavioral measures, and an optional DNA collection via mail-in saliva sampling.") Annotation(oboInOwl:hasDbXref "PMID:36718543") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC10038917/") coho:COHO_0000000 coho:COHO_0001430)
ClassAssertion(Annotation(rdfs:comment "Therefore, we aimed to carry out a GWAS meta-analysis of radiation-induced toxicities across tissues among 19 cohorts totaling 12 042 patients representing 4 cancers (prostate, head and neck, breast, and lung) from the Radiogenomic Consortium (https://epi.grants.cancer.gov/radiogenomics/).") Annotation(oboInOwl:hasDbXref "PMID:37862240") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10653584/fullTextXML") coho:COHO_0000001 coho:COHO_0000880)
ClassAssertion(Annotation(rdfs:comment "Therefore, we designed the Canadian SCAD cohort study, a large, observational, prospective, cohort study, to describe the natural history of SCAD and to provide the justification and foundation for future randomized clinical trials.") Annotation(oboInOwl:hasDbXref "PMID:30698711") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC6462308/") coho:COHO_0000000 coho:COHO_0001295)
ClassAssertion(Annotation(rdfs:comment "Therefore, we undertook a large, population-based case-control study of NPC in southern China (the NPC Genes, Environment, and EBV (NPCGEE) study) with the specific aims of understanding the independent and interactive roles of genes, environmental exposures, and infection with the Epstein-Barr virus (EBV) in disease etiology.") Annotation(oboInOwl:hasDbXref "PMID:29152064") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5675616/fullTextXML") coho:COHO_0000000 coho:COHO_0002178)
ClassAssertion(Annotation(rdfs:comment "These 223 SNPs were further analyzed by combining data from a completely independent cohort of isolated communities (Silk Road cohort, N = 481), resulting in a total sample size of 2636.") Annotation(oboInOwl:hasDbXref "PMID:26188009") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4572074/fullTextXML") coho:COHO_0000000 coho:COHO_0002381)
ClassAssertion(Annotation(rdfs:comment "These analyses were done in two independent breast cancer case-control studies, the Polish Breast Cancer Study (PBCS) and the Study of Epidemiology and Risk Factors in Cancer Heredity (SEARCH).") Annotation(oboInOwl:hasDbXref "PMID:24292867") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4159747/unicode") coho:COHO_0000000 coho:COHO_0000881)
ClassAssertion(Annotation(rdfs:comment "These comprised 40 studies from the ReproGen consortium (N = 179,117), in addition to the 23andMe (N = 76,831) and UK Biobank (N = 73,397) studies (Supplementary Table 1).") Annotation(oboInOwl:hasDbXref "PMID:28436984") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5841952/") coho:COHO_0000001 coho:COHO_0000934)
ClassAssertion(Annotation(rdfs:comment "These data were obtained from the control subjects involved in the GABRIEL ADVANCED SURVEY a cross-sectional population-based survey conducted in rural areas of Austria, Germany, and Switzerland.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature10251/MediaObjects/41586_2011_BFnature10251_MOESM243_ESM.pdf") coho:COHO_0000000 coho:COHO_0000073)
ClassAssertion(Annotation(rdfs:comment "These encouraging data led Cancer and Leukemia Group B (CALGB) to conduct a double-blind, placebo-controlled, randomized phase III trial of gemcitabine/bevacizumab versus gemcitabine/placebo in advanced pancreatic cancer patients.") Annotation(oboInOwl:hasDbXref "PMID:20606091") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2917317/") coho:COHO_0000000 coho:COHO_0001134)
