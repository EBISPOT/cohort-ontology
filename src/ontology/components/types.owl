ClassAssertion(Annotation(rdfs:comment "In a large population-based case-control study in Germany, including 3,464 breast cancer cases aged 50-74 at diagnosis and 6,657 population based and frequency matched controls, we investigated the effects of menopausal hormone therapy (HT) by type, regimen, timing and progestagenic constituent on postmenopausal breast cancer risk overall and according to histological type.") Annotation(oboInOwl:hasDbXref "PMID:18506692") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18506692+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001203)
