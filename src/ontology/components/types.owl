ClassAssertion(Annotation(rdfs:comment "The study base consists of several pooled surveys on occupational asthma from Denmark and The Netherlands.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") coho:COHO_0000001 coho:COHO_0001920)
ClassAssertion(Annotation(rdfs:comment "The study cohort comprised participants with kidney failure treated with PD from 69 centers in six countries (Australia, Belgium, Canada, Sweden, United Kingdom, and United States) enrolled either prospectively for Bio-PD study (NCT02694068; n=1677), or by procuring frozen DNA of participants in other studies (n=1884).") Annotation(oboInOwl:hasDbXref "PMID:34197840") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8545920/unicode") coho:COHO_0000000 coho:COHO_0001534)
ClassAssertion(Annotation(rdfs:comment "The study comprised 434 newborns with DS from the ODSCS, a prospective cohort that enrolled children with DS between 2006 to 2017 from 18 hospitals in the United Kingdom.") Annotation(oboInOwl:hasDbXref "PMID:40249915") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12391799/fullTextXML") coho:COHO_0000000 coho:COHO_0001027)
ClassAssertion(Annotation(rdfs:comment "The study comprised 771 participants from the Danish, population-based cross-sectional 'Health2008' study.") Annotation(oboInOwl:hasDbXref "PMID:22587629") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22587629+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001186)
ClassAssertion(Annotation(rdfs:comment "The study consists of three interrelated cohorts; the birth cohort, the health cohort, and the obesity cohort.") Annotation(oboInOwl:hasDbXref "PMID:28144813") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28144813+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002001)
