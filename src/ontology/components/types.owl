ClassAssertion(Annotation(rdfs:comment "With written, informed consent, patients with histo-pathological confirmed CM cases managed at MIA, Sydney, Australia were identified from this Biospecimen Bank and Database.") Annotation(oboInOwl:hasDbXref "PMID:36064556") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9446843/fullTextXML") coho:COHO_0000000 coho:COHO_0001103)
