ClassAssertion(Annotation(rdfs:comment "A key goal of the TOPMed programme is to understand risk factors for heart, lung, blood and sleep disorders by adding WGS and other ‘omics’ data to existing studies with deep phenotyping (Supplementary Information 1.1 and Supplementary Fig. 1).") Annotation(oboInOwl:hasDbXref "PMID:33568819") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7875770/fullTextXML") coho:COHO_0000001 coho:COHO_0000985)
