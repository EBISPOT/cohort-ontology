ClassAssertion(Annotation(rdfs:comment "The WSC is a longitudinal study of sleep habits and sleep disorders in the general population [30].") Annotation(oboInOwl:hasDbXref "PMID:35670608") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC10091093/") coho:COHO_0000000 coho:COHO_0001251)
