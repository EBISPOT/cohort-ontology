ClassAssertion(Annotation(rdfs:comment "The primary objective of the African American Study of Kidney Disease and Hypertension (AASK) Cohort Study is to identify risk factors for progressive kidney disease in African Americans with hypertensive chronic kidney disease in the setting of recommended antihypertensive therapy.") Annotation(oboInOwl:hasDbXref "PMID:17591527") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17591527+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000373)
ClassAssertion(Annotation(rdfs:comment "The program enrolled women at elevated risk due to their family histories of cancer, and participants underwent regular screenings with CA125 and ultrasound in an attempt to diagnose ovarian cancer before it had spread.1,2") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11047303/fullTextXML") coho:COHO_0000000 coho:COHO_0001826)
ClassAssertion(Annotation(rdfs:comment "The project will study a total of 270 DNA samples: 90 samples (see Supplementary Information, part 1) from a US Utah population with Northern and Western European ancestry (samples collected in 1980 by the Centre d'Etude du Polymorphisme Humain (CEPH)49 and used for other human genetic maps, 30 trios of two parents and an adult child), and new samples collected from 90 Yoruba people in Ibadan, Nigeria (30 trios), 45 unrelated Japanese in Tokyo, Japan, and 45 unrelated Han Chinese in Beijing, China.") Annotation(oboInOwl:hasDbXref "PMID:14685227") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1038/nature02168") coho:COHO_0000000 coho:COHO_0000284)
ClassAssertion(Annotation(rdfs:comment "The prospective MISS cohort study was initiated in 1990; the study methods have been described in detail previously (22–24).") Annotation(oboInOwl:hasDbXref "PMID:31663602") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9128912/fullTextXML") coho:COHO_0000000 coho:COHO_0001206)
ClassAssertion(Annotation(rdfs:comment "The prospective YFS has followed a population-based cohort from childhood to adulthood that were sampled from five cities with university hospitals in Finland (Helsinki, Kuopio, Oulu, Tampere, and Turku) and their rural surrounds.") Annotation(oboInOwl:hasDbXref "PMID:38115890") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10726240/fullTextXML") coho:COHO_0000000 coho:COHO_0000420)
ClassAssertion(Annotation(rdfs:comment "The prospectively collected case-control cohort consists of 1146 pregnant women with GDM and 1066 women without GDM, their children from the index pregnancy and the children’s fathers.") Annotation(oboInOwl:hasDbXref "PMID:32374401") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7394962/fullTextXML") coho:COHO_0000000 coho:COHO_0000891)
ClassAssertion(Annotation(rdfs:comment "The purpose of this study was to describe the associations of aspirin, NA-NSAIDs, or acetaminophen use with ovarian cancer risk, using the data from Hormones and Ovarian Cancer Prediction (HOPE) study, the second-largest population-based case-control study on ovarian cancer.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3454462/") coho:COHO_0000000 coho:COHO_0001872)
ClassAssertion(Annotation(rdfs:comment "The randomized Special Turku Coronary Risk Factor Intervention Project (STRIP) was a 20-year dietary intervention starting at 7 months of age.") Annotation(oboInOwl:hasDbXref "PMID:42011282") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42011282+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002415)
ClassAssertion(Annotation(rdfs:comment "The rationale, design, recruitment and follow-up methods are described for the Breakthrough Generations Study, a UK cohort study started in 2003, targeted at investigation of breast cancer aetiology.") Annotation(oboInOwl:hasDbXref "PMID:21897394") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3185950/fullTextXML") coho:COHO_0000000 coho:COHO_0000942)
ClassAssertion(Annotation(rdfs:comment "The recruitment procedure of the Depression Genes and Networks study (National Institute of Mental Health Grant 5RC2MH089916) was designed to collect samples of individuals with and without major depressive disorder, ages 21–60, from a survey research panel that was broadly representative of the United States population (Supplemental Material).") Annotation(oboInOwl:hasDbXref "PMID:24092820") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3875855/") coho:COHO_0000000 coho:COHO_0001658)
ClassAssertion(Annotation(rdfs:comment "The recruitment took place between September 2005 and February 2010 when these women attended their first ultrasound scan in one of ten hospital maternity clinics participating in the PREDO.") Annotation(oboInOwl:hasDbXref "PMID:26919119") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4769149/fullTextXML") coho:COHO_0000000 coho:COHO_0000690)
ClassAssertion(Annotation(rdfs:comment "The register contains data collected for administrative and scientific purposes from health contractors in primary health care.") Annotation(oboInOwl:hasDbXref "PMID:21775348") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21775348+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001666)
