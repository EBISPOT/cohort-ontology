ClassAssertion(Annotation(rdfs:comment "The 3xG study (Health—Municipalities—Birth, translated from Gezondheid, Gemeenten, Geboorten) is a birth cohort study that monitors and promotes health of the inhabitants of three bordering rural communities (Dessel, Mol, and Retie) in Flanders, Belgium.") Annotation(oboInOwl:hasDbXref "PMID:36976969") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10058482/fullTextXML") coho:COHO_0000000 coho:COHO_0002663)
