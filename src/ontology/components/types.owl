ClassAssertion(Annotation(rdfs:comment "The samples were collected as part of the AGP, an international consortium with over 50 sites in North America and Europe.") Annotation(oboInOwl:hasDbXref "PMID:24768552") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4067558/unicode") coho:COHO_0000001 coho:COHO_0001479)
