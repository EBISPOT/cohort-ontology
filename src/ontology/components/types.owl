ClassAssertion(Annotation(rdfs:comment "The GHS MyCode study is a health system-based cohort of patients from Central and Eastern Pennsylvania (USA) recruited in 2007–2019") Annotation(oboInOwl:hasDbXref "PMID:36192519") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9529959/fullTextXML") coho:COHO_0000000 coho:COHO_0000448)
ClassAssertion(Annotation(rdfs:comment "The GLACIER Study is a prospective, population-based cohort study comprising 19,547 adults from the northern Swedish county of Västerbotten, nested within the Northern Sweden Health and Disease Study (20).") Annotation(oboInOwl:hasDbXref "PMID:20870969") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3012192/fullTextXML") coho:COHO_0000000 coho:COHO_0001177)
ClassAssertion(Annotation(rdfs:comment "The GLAUGEN study contains POAG cases and controls derived from the Genetic Etiologies of Primary Open-Angle Glaucoma (GEP) study, the Nurses’ Health Study (NHS), and the Health Professionals Follow-up Study (HPFS).") Annotation(oboInOwl:hasDbXref "PMID:23869166") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3712669/fullTextXML") coho:COHO_0000001 coho:COHO_0001810)
ClassAssertion(Annotation(rdfs:comment "The GNHS project is a community-based prospective cohort study.") Annotation(oboInOwl:hasDbXref "PMID:37813622") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11078596/fullTextXML") coho:COHO_0000000 coho:COHO_0001817)
