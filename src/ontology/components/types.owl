ClassAssertion(Annotation(rdfs:comment "The stage 2 samples for replication testing of 96 single nucleotide polymorphisms (SNPs) consisted of 13,517 unrelated Chinese Hans (6,570 T2D case and 6,947 nondiabetic control subjects) from the Guizhou-Bijie Type 2 Diabetes Study (GBTDS), the Beijing Type 2 Diabetes Studies (BTDS), and the Hubei Type 2 Diabetes Studies (HTDS).") Annotation(oboInOwl:hasDbXref "PMID:22961080") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526061/fullTextXML") coho:COHO_0000000 coho:COHO_0001875)
ClassAssertion(Annotation(rdfs:comment "The strength of the study is that SALIA is a population-based cohort of elderly women (not a cohort of either highly exposed or diseased and more susceptible subjects) with a detailed exposure assessment and an in-depth characterization of subclinical pulmonary inflammation.") Annotation(oboInOwl:hasDbXref "PMID:24645673") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4000047/fullTextXML") coho:COHO_0000000 coho:COHO_0002618)
