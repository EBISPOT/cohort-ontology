ClassAssertion(Annotation(rdfs:comment "The aims of this large-scale, population-based, long-term prospective, genome-cohort study are to examine gene–environment interactions in lifestyle-related diseases, especially cancers.") Annotation(oboInOwl:hasDbXref "PMID:32963210") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8593573/fullTextXML") coho:COHO_0000000 coho:COHO_0000571)
ClassAssertion(Annotation(rdfs:comment "The analyses were conducted using a newly recruited cohort of former German-military radar operators, their wives, and offspring (Radar cohort), as well as WGS data accessed from Yeager et al. 2021 (CRU cohort), and from a previously reported cohort of individuals with no history of exposure to IR (Inova cohort).") Annotation(oboInOwl:hasDbXref "PMID:40550869") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12185716/fullTextXML") coho:COHO_0000000 coho:COHO_0000326)
ClassAssertion(Annotation(rdfs:comment "The article describes the objectives and design of a prospective study of the prevalence, incidence and course of psychiatric disorders in a representative sample of non-institutionalized Dutch adults.") Annotation(oboInOwl:hasDbXref "PMID:9857790") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9857790+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002134)
ClassAssertion(Annotation(rdfs:comment "The association between circulating levels of the main lignan enterolactone and breast cancer risk was assessed in a case–control study nested within the New York University (NYU) Women's Health Study, a prospective cohort study of cancer, hormones, and environmental factors.") Annotation(oboInOwl:hasDbXref "PMID:15226762") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2364735/fullTextXML") coho:COHO_0000000 coho:COHO_0002192)
ClassAssertion(Annotation(rdfs:comment "The atherosclerotic vascular samples used in this study were obtained from patients subjected to carotid (N = 29) and femoral (N = 24) endarterectomy or an abdominal aortic bypass (N = 15) procedure (i.e., aortobifemoral bypass) due to occlusive atherosclerosis.") Annotation(oboInOwl:hasDbXref "PMID:28128285") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5270243/fullTextXML") coho:COHO_0000000 coho:COHO_0002473)
ClassAssertion(Annotation(rdfs:comment "The baseline examination (T0) between September 2007 and June 2008 included 16 228 children aged 2 to 9.9 years from eight European countries: Belgium, Cyprus, Estonia, Germany, Hungary, Italy, Spain and Sweden.") Annotation(oboInOwl:hasDbXref "PMID:28040744") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837508/fullTextXML") coho:COHO_0000000 coho:COHO_0000871)
ClassAssertion(Annotation(rdfs:comment "The baseline population consists of all twins from the Swedish Twin Registry (STR) who had been reared apart (TRA), i.e. separated before age of 11 and reared apart, and a control sample of twins reared together (TRT) matched on sex, date of birth, and county of birth.") Annotation(oboInOwl:hasDbXref "https://researchdata.se/en/catalogue/dataset/ext0044-1") coho:COHO_0000000 coho:COHO_0000650)
ClassAssertion(Annotation(rdfs:comment "The basic unit of the study is the nonagenarian sib pair, i.e., two or more siblings aged 90 years or older, together with a younger control person who is unrelated to the sibling pair but from the same geographical area (Fig. 1).") Annotation(oboInOwl:hasDbXref "PMID:21871552") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3622890/") coho:COHO_0000000 coho:COHO_0000083)
ClassAssertion(Annotation(rdfs:comment "The biobank cohort includes participants aged ≥18 years from the Sanford Health system who elected to provide a specimen to the Sanford Biobank for research purposes, starting in 2011.") Annotation(oboInOwl:hasDbXref "PMID:41669951") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13055487/fullTextXML") coho:COHO_0000000 coho:COHO_0001401)
ClassAssertion(Annotation(rdfs:comment "The biospecimens of the GUB, including blood samples for DNA extraction, were obtained from the patients attending clinics for the suspicion, diagnosis and/or treatment of a genito-urinary tumor (prostate, kidney, bladder, testis, penis) within the Genito-Urinary Oncology division of The Princess Margaret’s Hospital.") Annotation(oboInOwl:hasDbXref "https://ars.els-cdn.com/content/image/1-s2.0-S2210776226000724-mmc1.docx") coho:COHO_0000000 coho:COHO_0000683)
ClassAssertion(Annotation(rdfs:comment "The birth cohort consists of children born in the Brno and Znojmo regions (South Moravia, Czech Republic) in 1991 and 1992.") Annotation(oboInOwl:hasDbXref "PMID:27380795") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837270/fullTextXML") coho:COHO_0000000 coho:COHO_0002628)
ClassAssertion(Annotation(rdfs:comment "The cancer-free controls (46% males) were selected from participants of the “Nijmegen Biomedical Study” (NBS;), an age- and sex-stratified random sample of the general population of the municipality of Nijmegen, The Netherlands.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0002165)
ClassAssertion(Annotation(rdfs:comment "The case subjects in the replication data were comprised of participants recruited through the UCLA Autism Evaluation Clinic, parent groups and organizations for families of children with autism, and a database maintained by the MIND (Medical Investigation of Neurodevelopmental Disorders) Institute at University of California Davis.") Annotation(oboInOwl:hasDbXref "PMID:19404256") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature07999/MediaObjects/41586_2009_BFnature07999_MOESM226_ESM.pdf") coho:COHO_0000000 coho:COHO_0000032)
ClassAssertion(Annotation(rdfs:comment "The cases (n = 190) were probands of type 2 diabetic pedigrees with fasting plasma glucose ≥ 7.0 mmol/L and/or 2-h post plasma glucose ≥ 11.1 mmol/L and diagnosed before 40 years old.") Annotation(oboInOwl:hasDbXref "PMID:22158537") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") coho:COHO_0000000 coho:COHO_0002385)
ClassAssertion(Annotation(rdfs:comment "The cases in this cohort are SCC and BCC for a methylation study.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001008193") coho:COHO_0000000 coho:COHO_0000240)
ClassAssertion(Annotation(rdfs:comment "The case–control series consists of 197 patients with a confirmed bladder cancer from the Department of Urology, St.-Josefs-Hospital Dortmund-Hörde, located in the Ruhr area, an area of former coal, iron and steel industries and 240 controls from the same Department of Urology, admitted for treatment of benign urological diseases, enrolled from July 2009 to July 2010.") Annotation(oboInOwl:hasDbXref "PMID:21750109") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3188988/") coho:COHO_0000000 coho:COHO_0001648)
ClassAssertion(Annotation(rdfs:comment "The clinical cohort consists of individuals who have been referred to a child psychiatric outpatient clinic in the Northern Netherlands any time before the age of 11.") Annotation(oboInOwl:hasDbXref "PMID:25431468") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4339762/fullTextXML") coho:COHO_0000000 coho:COHO_0000940)
ClassAssertion(Annotation(rdfs:comment "The clinical trial is a randomized, multi-center, open-label study to compare the safety and efficacy of HAD-B1 combined with afatinib therapy for patients with locally advanced or metastatic EGFR-mutation-positive NSCLC.") Annotation(oboInOwl:hasDbXref "PMID:39103991") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11301725/fullTextXML") coho:COHO_0000000 coho:COHO_0001836)
ClassAssertion(Annotation(rdfs:comment "The cohort comprises of breast cancer patients aged 21 years and above from six public hospitals which diagnose and treat nearly 76% breast cancer cases in Singapore.") Annotation(oboInOwl:hasDbXref "PMID:33901219") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33901219+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002369)
ClassAssertion(Annotation(rdfs:comment "The cohort consists of 215,251 adult men and women (age 45-75 years at baseline) living in Hawaii and in California (primarily Los Angeles County) with the following ethnic distribution: African-American (16.3%), Latino (22.0%), Japanese-American (26.4%), Native Hawaiian (6.5%), White (22.9%), and other ancestry (5.8%).") Annotation(oboInOwl:hasDbXref "PMID:10695593") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10695593+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000121)
ClassAssertion(Annotation(rdfs:comment "The cohort from the Center for Applied Genomics is composed of approximately 85,000 juvenile subjects below 18 years of age and of a diverse set of ancestries.") Annotation(oboInOwl:hasDbXref "PMID:40164604") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML") coho:COHO_0000000 coho:COHO_0000489)
ClassAssertion(Annotation(rdfs:comment "The cohort is a community-based prospective study that includes 4812 individuals aged 18–80 years.") Annotation(oboInOwl:hasDbXref "PMID:25252923") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4247123/fullTextXML") coho:COHO_0000000 coho:COHO_0002572)
ClassAssertion(Annotation(rdfs:comment "The cohort is family based (481 families), including only adolescents who have one or more siblings of similar age (12 to 18 years) and both biological parents of the French-Canadian origin born in the region.") Annotation(oboInOwl:hasDbXref "PMID:27018016") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5837575/") coho:COHO_0000000 coho:COHO_0001124)
ClassAssertion(Annotation(rdfs:comment "The cohort is open, and women and children enter the cohort, when they move into the selected clusters, and leave the cohort, when they move out or die, or when children reach 5 years of age.") Annotation(oboInOwl:hasDbXref "PMID:31189684") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31189684+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000488)
ClassAssertion(Annotation(rdfs:comment "The cohort was analysed as a pooled dataset of 1183 patients from DAHANCA10, DAHANCA19 and the DAHANCA Prospective biobank protocol as they were eligible by the criteria set.") Annotation(oboInOwl:hasDbXref "PMID:35039627") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8980077/fullTextXML") coho:COHO_0000000 coho:COHO_0000775)
ClassAssertion(Annotation(rdfs:comment "The cohort was established by re-inviting a two-thirds sample (n = 7768) of those who were measured during Wave 1 for a second measurement in 1993–7, followed by a third in 1998–2002 [1], a fourth in 2003–7, a fifth in 2008–12, and a sixth in 2013–17 [2], including 3438 participants (Fig. 1).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML") coho:COHO_0000000 coho:COHO_0000906)
ClassAssertion(Annotation(rdfs:comment "The cohort will be assessed every two years, with in-depth assessments being repeated.") Annotation(oboInOwl:hasDbXref "PMID:19943720") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19943720+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000500)
ClassAssertion(Annotation(rdfs:comment "The cohorts include IBD cohorts from the Cedars-Sinai IBD Biobank (MIRIAD, size = 9231),") Annotation(oboInOwl:hasDbXref "PMID:41748696") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13046806/fullTextXML") coho:COHO_0000000 coho:COHO_0000716)
ClassAssertion(Annotation(rdfs:comment "The collaborative work of the consortium has led to a repository of samples (DNA, plasma, and serum) of more than 17,000 subjects from two major ethnic groups in India (Indo-European and Dravidians) that have been well-characterized for anthropometric and clinical markers (Fig. 1).") Annotation(oboInOwl:hasDbXref "PMID:23205164") Annotation(oboInOwl:hasDbXref "https://link.springer.com/article/10.1007/s11568-011-9157-2") coho:COHO_0000000 coho:COHO_0001919)
ClassAssertion(Annotation(rdfs:comment "The combined type 2 diabetes cases and controls from DDS and DCC were aggregated into a single Zulu study.") Annotation(oboInOwl:hasDbXref "PMID:31049640") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6560001/fullTextXML") coho:COHO_0000001 coho:COHO_0002345)
ClassAssertion(Annotation(rdfs:comment "The consortium has recruitment centres in Cambridge, Edinburgh, Newcastle, Exeter, Manchester, Oxford, London, Dundee and Nottingham.") Annotation(oboInOwl:hasDbXref "https://www.ibdresearch.co.uk/") coho:COHO_0000001 coho:COHO_0000180)
ClassAssertion(Annotation(rdfs:comment "The control individuals came from two sources: 1,500 individuals from the 1958 British Birth Cohort (58C) and 1,500 individuals selected from blood donors recruited as part of this project (UK Blood Services (UKBS) controls).") Annotation(oboInOwl:hasDbXref "PMID:17554300") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC2719288") coho:COHO_0000001 coho:COHO_0000182)
ClassAssertion(Annotation(rdfs:comment "The control population used in this study consisted of a cohort of 1081 individuals, part of the PopGen cohort, a population-based biobank in Germany.") Annotation(oboInOwl:hasDbXref "PMID:35348614") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC9976967") coho:COHO_0000000 coho:COHO_0000406)
ClassAssertion(Annotation(rdfs:comment "The coronary artery disease genome-wide replication and meta-analysis (CARDIoGRAM) and the coronary artery disease genetics (C4D) consortium (CARDIoGRAMplusC4D) collaborated and combined genetic data from diverse large-scale studies to determine risk loci for CAD and myocardial infarction (MI) in the human genome.") Annotation(oboInOwl:hasDbXref "PMID:38060277") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10703441/fullTextXML") coho:COHO_0000001 coho:COHO_0000029)
ClassAssertion(Annotation(rdfs:comment "The criteria utilized for inclusion/exclusion ensures the HABS cohort is comprised of cognitively normal, healthy older individuals at study enrollment.") Annotation(oboInOwl:hasDbXref "PMID:25843019") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4592689/unicode") coho:COHO_0000000 coho:COHO_0000948)
ClassAssertion(Annotation(rdfs:comment "The cross-sectional Metabolic Syndrome Berlin Potsdam (MeSyBePo) study was approved by the ethics commissions of Berlin and Brandenburg, Germany.") Annotation(oboInOwl:hasDbXref "PMID:28835639") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5569105/fullTextXML") coho:COHO_0000000 coho:COHO_0002055)
ClassAssertion(Annotation(rdfs:comment "The current paper presents the study protocol of a Chilean cohort in brain aging and dementia: the GERO cohort study.") Annotation(oboInOwl:hasDbXref "PMID:33238908") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC7690082/") coho:COHO_0000000 coho:COHO_0001255)
ClassAssertion(Annotation(rdfs:comment "The current paper uses a prospective cohort of men in Wales, with in-depth cognitive assessments and data spanning over three decades, to examine the prevalence of sSCD, prospective associations from potential causal factors, and objective cognitive change.") Annotation(oboInOwl:hasDbXref "PMID:37844990") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10582873/fullTextXML") coho:COHO_0000000 coho:COHO_0001555)
ClassAssertion(Annotation(rdfs:comment "The current participants were subjects from the North of Scotland Osteoporosis Study (NOSOS), which is a population-based screening programme for osteoporotic fracture that involved 1,847 women aged 60–82 years at baseline (2001–2003).") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1007/s00198-008-0681-4") coho:COHO_0000000 coho:COHO_0002175)
ClassAssertion(Annotation(rdfs:comment "The current report represents a subanalysis of the Women's Insights and Shared Experiences Study, a pair of case-control studies examining associations between exogenous hormone use, parity, estrogen-related genes, and endometrial or breast cancer.") Annotation(oboInOwl:hasDbXref "PMID:18757329") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2654370/") coho:COHO_0000000 coho:COHO_0002574)
ClassAssertion(Annotation(rdfs:comment "The current study investigates survey responses from 1,000 women with surgically confirmed endometriosis who are participating in the Oxford Endometriosis Gene (OXEGENE) study (16).") Annotation(oboInOwl:hasDbXref "PMID:17498711") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2939902/") coho:COHO_0000000 coho:COHO_0002224)
ClassAssertion(Annotation(rdfs:comment "The current version of NordicDB pools together high-density genome-wide SNP information from ∼5000 controls originating from Finnish, Swedish and Danish studies and shows country-specific allele frequencies for SNP markers.") Annotation(oboInOwl:hasDbXref "PMID:20664631") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3002853/") coho:COHO_0000001 coho:COHO_0002172)
ClassAssertion(Annotation(rdfs:comment "The data for the second USA cohort (USA2_AD, n = 1480), UK (UK_AD, n = 6925), and Germany (Germany_AD, n = 1376) cohorts (USA2_AD, UK_AD, and Germany_AD, respectively) were provided by the Genetic and Environmental Risk for Alzheimer's disease Consortium (Harold et al., 2009).") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4370231/") coho:COHO_0000001 coho:COHO_0000646)
ClassAssertion(Annotation(rdfs:comment "The data sets that make up the consortium have the following characteristics in common: (1) general population samples; (2) multiple waves of data collection across childhood, adolescence, and young adulthood;") Annotation(oboInOwl:hasDbXref "PMID:23461817") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3609892/") coho:COHO_0000001 coho:COHO_0001766)
ClassAssertion(Annotation(rdfs:comment "The database contains the genotypes of 2.5 million single-nucleotide polymorphisms (SNPs) and 5 human leukocyte antigen loci from 2994 Japanese healthy volunteers, as well as 121 kinds of clinical information, including self-reports, physiological data, hematological data and biochemical data.") Annotation(oboInOwl:hasDbXref "PMID:25855068") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25855068+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000920)
ClassAssertion(Annotation(rdfs:comment "The design is a multicenter, two-armed, randomized trial with 37,000 females and 37,000 males in each of the two arms.") Annotation(oboInOwl:hasDbXref "PMID:11189684") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11189684+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000485)
ClassAssertion(Annotation(rdfs:comment "The design of the Cohorts for Heart and Aging Research in Genomic Epidemiology Consortium includes 5 prospective cohort studies from the United States and Europe: the Age, Gene/Environment Susceptibility-Reykjavik Study, the Atherosclerosis Risk in Communities Study, the Cardiovascular Health Study, the Framingham Heart Study, and the Rotterdam Study.") Annotation(oboInOwl:hasDbXref "PMID:20031568") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20031568+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000001 coho:COHO_0000444)
ClassAssertion(Annotation(rdfs:comment "The discovery sample included 607 ADHD cases and 584 controls.") Annotation(oboInOwl:hasDbXref "PMID:25284319") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4330505/") coho:COHO_0000000 coho:COHO_0001473)
ClassAssertion(Annotation(rdfs:comment "The discovery sample was derived from the Yale-Penn sample, a cohort of 11,439 participants (5758 AAs and 5681 EAs) recruited through treatment centers and advertisements for genetic studies of cocaine, opioid or alcohol dependence11.") Annotation(oboInOwl:hasDbXref "PMID:34226506") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8257618/fullTextXML") coho:COHO_0000000 coho:COHO_0000628)
ClassAssertion(Annotation(rdfs:comment "The discovery stage included 1,019 T2D cases, 886 incident T2D cases from the Shanghai Women's Health Study (SWHS), an ongoing, population-based, prospective cohort study of women living in Shanghai, and 133 prevalent T2D cases identified among controls of the Shanghai Breast Cancer Study (SBCS), who were recruited in Shanghai during approximately the same period as the SWHS [11].") Annotation(oboInOwl:hasDbXref "PMID:20862305") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2940731/fullTextXML") coho:COHO_0000000 coho:COHO_0002356)
ClassAssertion(Annotation(rdfs:comment "The discovery study population, also referred to as the Danish Longevity Study (DKLS), consisted of participants drawn from the Longitudinal Study of Danish Centenarians (LSDC), the 1905 Birth Cohort Study, the 1911–12 Birth Cohort Study, the Study of Danish Old Sibs (DOS), and the Longitudinal Study of Ageing Danish Twins (LSADT).") Annotation(oboInOwl:hasDbXref "PMID:26446717") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4717275/") coho:COHO_0000000 coho:COHO_0001670)
ClassAssertion(Annotation(rdfs:comment "The eMERGE Network comprises nine geographically distinct groups (Figure 1), each with its own biorepository where DNA specimens are linked to phenotypic data contained within EMRs.") Annotation(oboInOwl:hasDbXref "PMID:23743551") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3795928/fullTextXML") coho:COHO_0000001 coho:COHO_0000491)
ClassAssertion(Annotation(rdfs:comment "The eligibility criteria for inclusion were that the family had to have at least two pathologically confirmed intracranial primary gliomas, in 1st/2nd/3rd-degree relatives.") Annotation(oboInOwl:hasDbXref "PMID:23290425") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3615132/") coho:COHO_0000000 coho:COHO_0001812)
ClassAssertion(Annotation(rdfs:comment "The experiment will use the early onset patients from the German MI cohort and the UK BHF CAD/MI cohort both of which have strong family history.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001000079") coho:COHO_0000000 coho:COHO_0000261)
ClassAssertion(Annotation(rdfs:comment "The family high-risk design was used to recruit proband fathers with and without substance use disorder and track their sons longitudinally from late childhood to adulthood.") Annotation(oboInOwl:hasDbXref "PMID:21320228") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21320228+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001618)
ClassAssertion(Annotation(rdfs:comment "The family study involves both a family based design with affected off- spring and family members and also a larger case control component that is the subject of this report.") Annotation(oboInOwl:hasDbXref "PMID:16163567") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC7096091") coho:COHO_0000000 coho:COHO_0001712)
ClassAssertion(Annotation(rdfs:comment "The family study is composed of five extended French-Canadian pedigrees, totaling 255 relatives, ascertained at the Thrombosis Clinic of the Ottawa Hospital through single probands with idiopathic VT and heterozygote for the Factor V Leiden mutation.") Annotation(oboInOwl:hasDbXref "PMID:25265411") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4179266/fullTextXML") coho:COHO_0000000 coho:COHO_0001717)
ClassAssertion(Annotation(rdfs:comment "The first EGEA survey (EGEA1) included cases with asthma, recruited in five chest clinics, their first-degree relatives and population-based controls, recruited in the early 90’s in 5 French cities (total: n = 2047).") Annotation(oboInOwl:hasDbXref "https://openbioresources.metajnl.com/articles/10.5334/ojb.24") coho:COHO_0000000 coho:COHO_0000664)
ClassAssertion(Annotation(rdfs:comment "The first GWAS (EU-RLS-GENE) was conducted in affected individuals recruited by expert clinicians of the International EU-RLS-GENE consortium and ancestry-matched controls.") Annotation(oboInOwl:hasDbXref "PMID:38839884") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11176086/fullTextXML") coho:COHO_0000001 coho:COHO_0000862)
ClassAssertion(Annotation(rdfs:comment "The first Multicenter Hemophilia Cohort Study (MHCS-I) evaluated and prospectively followed patients with hemophilia or a related coagulation disorder.") Annotation(oboInOwl:hasDbXref "PMID:37532928") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10848312/supplementaryFiles") coho:COHO_0000000 coho:COHO_0001373)
ClassAssertion(Annotation(rdfs:comment "The first cohort (RS-I) started in 1990 and included 7,983 inhabitants, aged ≥55 years from Ommoord, a suburb of Rotterdam in the Netherlands.") Annotation(oboInOwl:hasDbXref "PMID:33717105") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7944992/fullTextXML") coho:COHO_0000000 coho:COHO_0000544)
ClassAssertion(Annotation(rdfs:comment "The first cohort of the Center for Oral Health Research in Appalachia (COHRA1) is a cross-sectional study comprising members of households living in rural West Virginia and Western Pennsylvania—a region with a high prevalence of poor oral health outcomes [4,15].") Annotation(oboInOwl:hasDbXref "PMID:36672800") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9858612/fullTextXML") coho:COHO_0000000 coho:COHO_0001440)
ClassAssertion(Annotation(rdfs:comment "The first project was a genetic/epidemiologic cross-sectional study that investigated the prevalence of caries and periodontal disease in the T2DM Gullah population.") Annotation(oboInOwl:hasDbXref "PMID:25364473") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4212267/unicode") coho:COHO_0000000 coho:COHO_0001601)
ClassAssertion(Annotation(rdfs:comment "The first sub-cohort, Steno 2007, consisted of 500 individuals with T1D, of which 77 were excluded due to insufficient material.") Annotation(oboInOwl:hasDbXref "PMID:35627254") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9142038/fullTextXML") coho:COHO_0000000 coho:COHO_0000982)
ClassAssertion(Annotation(rdfs:comment "The followMAGICS study is the follow-up study of the observational Multicenter Asthma Genetics in Childhood Study (MAGICS), which includes physician-diagnosed asthmatic children and young adults (age: 7–25 years)15 recruited from secondary and tertiary centers in Germany and Austria.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC8503671/") coho:COHO_0000000 coho:COHO_0002029)
ClassAssertion(Annotation(rdfs:comment "The four cohorts (RAPPER, RADIOGEN, Gene-PARE, and CCI) comprised individuals with adenocarcinoma of the prostate treated with radiotherapy with curative intent.") Annotation(oboInOwl:hasDbXref "PMID:27515689") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5036513/fullTextXML") coho:COHO_0000000 coho:COHO_0000791)
ClassAssertion(Annotation(rdfs:comment "The four studies include RISC (n = 957), Botnia (n = 341), EUGENE2 consortium (European network on Functional Genomics of type 2 diabetes; n = 577) and the Stanford Insulin Suppression Test (IST) Cohort (n = 263).") Annotation(oboInOwl:hasDbXref "PMID:23378610") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3661655/fullTextXML") coho:COHO_0000000 coho:COHO_0001939)
ClassAssertion(Annotation(rdfs:comment "The fourth cohort (Dental SCORE, n = 548) is a subset of a larger project, Heart SCORE, which is an ongoing cardiovascular disease study of 2,000 middle aged White and African Americans in the Pittsburgh region of Pennsylvania [17].") Annotation(oboInOwl:hasDbXref "PMID:35172313") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9378791/fullTextXML") coho:COHO_0000000 coho:COHO_0001312)
ClassAssertion(Annotation(rdfs:comment "The fourth, called KARUPROSTATE and carried out between 2004 and 2007, is a case–control study (n = 623/671).") Annotation(oboInOwl:hasDbXref "PMID:27406382") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4942950/fullTextXML") coho:COHO_0000000 coho:COHO_0001955)
ClassAssertion(Annotation(rdfs:comment "The genetic and phenotypic determinants of blood pressure and other cardiovascular risk factors (GAPP) study is a population-based prospective cohort study involving a representative sample of healthy adults aged 25-41 years in the Principality of Liechtenstein.") Annotation(oboInOwl:hasDbXref "PMID:23299990") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23299990+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000515)
ClassAssertion(Annotation(rdfs:comment "The hospitalized COVID-19 cases/cohort was approved by the Ethics Committee of the University of Ioannina Hospital (number 5/11-03-2021).") Annotation(oboInOwl:hasDbXref "PMID:40399555") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02100-w/MediaObjects/41588_2025_2100_MOESM3_ESM.xlsx") coho:COHO_0000000 coho:COHO_0001047)
ClassAssertion(Annotation(rdfs:comment "The hypothesis-generating data set consisted of 753 individuals with AD by National Institute of Neurological and Communicative Diseases and Stroke/Alzheimer's Disease and Related Disorders Association criteria recruited from 9 memory referral clinics in Canada and 736 ethnically matched control subjects; control subjects were recruited from nonbiological relatives, friends, or spouses of the patients and did not exhibit cognitive impairment by history or cognitive testing.") Annotation(oboInOwl:hasDbXref "PMID:17998437") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17998437+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000780)
ClassAssertion(Annotation(rdfs:comment "The idea of the KHDSS was conceived in 2000 to create a longitudinal community-based study linked, at inception, to hospital morbidity surveillance by integrating the existing clinical and field-based research infrastructure.") Annotation(oboInOwl:hasDbXref "PMID:22544844") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3396317/fullTextXML") coho:COHO_0000000 coho:COHO_0002689)
ClassAssertion(Annotation(rdfs:comment "The identification of a risk profile to guide atrial fibrillation therapy (AF-RISK) study was a Dutch prospective, observational multicenter cohort study conducted at the University Medical Centre Groningen and the Maastricht University Medical Centre + between May 2011 and March 2016.") Annotation(oboInOwl:hasDbXref "PMID:41756112") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12933449/fullTextXML") coho:COHO_0000000 coho:COHO_0002704)
ClassAssertion(Annotation(rdfs:comment "The influence of Life-style factors on the development of the Immune System and Allergies in East and West Germany PLUS the influence of traffic emissions and genetics (LISAplus) Study is a population based birth cohort study.") Annotation(oboInOwl:hasDbXref "PMID:35378236") Annotation(oboInOwl:hasDbXref "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") coho:COHO_0000000 coho:COHO_0000831)
ClassAssertion(Annotation(rdfs:comment "The initial 10,000 GPC participants drawn from earlier studies include our Portuguese Island Collection (PIC) of individuals and multiplex families with schizophrenia and/or bipolar disorder.") Annotation(oboInOwl:hasDbXref "PMID:23650244") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3729260/") coho:COHO_0000000 coho:COHO_0002257)
ClassAssertion(Annotation(rdfs:comment "The initial HRS cohort, recruited in 1992, consisted of persons born 1931–41 (then aged 51–61) and their spouses of any age.") Annotation(oboInOwl:hasDbXref "PMID:24671021") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3997380/") coho:COHO_0000000 coho:COHO_0000089)
ClassAssertion(Annotation(rdfs:comment "The interventions were carried out in 868 relatively healthy Amish adults from large families.") Annotation(oboInOwl:hasDbXref "PMID:18440328") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2443415/") coho:COHO_0000000 coho:COHO_0001839)
ClassAssertion(Annotation(rdfs:comment "The landmark Beaver Dam Eye Study (BDES) of 5000 participants 43 years of age or older residing in Beaver Dam, Wisconsin, provided seminal information on age-related macular degeneration (AMD).") Annotation(oboInOwl:hasDbXref "PMID:32200810") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC8344102/") coho:COHO_0000000 coho:COHO_0001289)
ClassAssertion(Annotation(rdfs:comment "The largest trial that collected full-transcriptome expression data is the MINDACT trial2,3, an international, multi-center, prospective, phase III randomized trial whose main objective was to prospectively validate the 70-gene MammaPrint signature as a prognostic tool for the clinical evaluation of patients to help avoid chemotherapy4.") Annotation(oboInOwl:hasDbXref "PMID:32719399") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7385160/fullTextXML") coho:COHO_0000000 coho:COHO_0002070)
ClassAssertion(Annotation(rdfs:comment "The latter collection was established specifically for this study and is a UK national repository of anonymized DNA samples from 3,622 consenting blood donors.") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC2719288") coho:COHO_0000000 coho:COHO_0000347)
ClassAssertion(Annotation(rdfs:comment "The longitudinal APOSS is a population-based screening programme for osteoporotic fracture risk in females.40") Annotation(oboInOwl:hasDbXref "PMID:22234152") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3330223/fullTextXML") coho:COHO_0000000 coho:COHO_0001492)
ClassAssertion(Annotation(rdfs:comment "The lungNENomics series is a multicentre, international, retrospective cohort of 259 patients diagnosed with an LNET, whose clinical data are summarised in Table 1.") Annotation(oboInOwl:hasDbXref "PMID:38878324") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11233924/fullTextXML") coho:COHO_0000000 coho:COHO_0000292)
ClassAssertion(Annotation(rdfs:comment "The main strength of the Research on Obesity and Diabetes among African Migrants prospective (RODAM-Pros) cohort study is the longitudinal cohort design, including representative samples of Ghanaian migrants and their non-migrant compatriots of predominantly Akan ethnicity living in their country of origin, alongside a sample of the host European population, which is unique.") Annotation(oboInOwl:hasDbXref "PMID:36521887") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9756160/fullTextXML") coho:COHO_0000000 coho:COHO_0000327)
ClassAssertion(Annotation(rdfs:comment "The majority of the participating cohorts are longitudinal population-based samples, but other cohorts with data on early childhood phenotypes are also involved.") Annotation(oboInOwl:hasDbXref "PMID:30887376") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30887376+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000001 coho:COHO_0000750)
ClassAssertion(Annotation(rdfs:comment "The majority of the participating cohorts are longitudinal population-based samples, but other cohorts with data on early childhood phenotypes are also involved.") Annotation(oboInOwl:hasDbXref "https://link.springer.com/article/10.1007/s10654-019-00502-9") coho:COHO_0000001 coho:COHO_0000954)
ClassAssertion(Annotation(rdfs:comment "The methods of the M.D. Anderson population-based case-control study have been previously described in detail49 .") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.723/MediaObjects/41588_2011_BFng723_MOESM3_ESM.pdf") coho:COHO_0000000 coho:COHO_0002048)
ClassAssertion(Annotation(rdfs:comment "The nationwide Icelandic Cancer Registry (ICR) was established in 1954 and has been extensively used for research from the outset although formal quality assessment of the registry database has not previously been undertaken.") Annotation(oboInOwl:hasDbXref "PMID:22974093") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22974093+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000096)
ClassAssertion(Annotation(rdfs:comment "The nested case-control study consisted of 218 incident melanoma cases, 285 incident SCC cases, a sample of 300 BCC cases from the large number of incident cases, and 870 age-matched controls.") Annotation(oboInOwl:hasDbXref "PMID:19500394") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2699349/fullTextXML") coho:COHO_0000000 coho:COHO_0002352)
ClassAssertion(Annotation(rdfs:comment "The neuromuscular disorder samples are part of the “rare disease” group, and will undergo exome sequencing.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001000101") coho:COHO_0000000 coho:COHO_0000349)
ClassAssertion(Annotation(rdfs:comment "The objectives of these clinical research networks are to conduct multiple, well designed clinical trials for rapid evaluation of new and existing therapeutic approaches to asthma and to disseminate laboratory and clinical findings to the health care community.") Annotation(oboInOwl:hasDbXref "PMID:17141853") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2742212/") coho:COHO_0000001 coho:COHO_0001570)
