ClassAssertion(Annotation(rdfs:comment "The ASPREE (ASPirin in Reducing Events in the Elderly) cohort offers the opportunity to measure these effects, as recruited participants had no history of cardiovascular disease, dementia or significant physical disability at enrolment.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8208779/fullTextXML") coho:COHO_0000000 coho:COHO_0000856)
