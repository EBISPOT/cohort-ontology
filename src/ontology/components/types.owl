ClassAssertion(Annotation(rdfs:comment "Whole blood samples from SARS-CoV-2 RT-PCR negative (101) and positive lab tested individuals (473) were obtained from two clinical centers (Hospital Clínico Universitario de Valladolid, discovery cohort and Hospital Regional Universitario de Málaga, replication cohort).") Annotation(oboInOwl:hasDbXref "PMID:35933486") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9357033/fullTextXML") coho:COHO_0000000 coho:COHO_0002404)
