ClassAssertion(Annotation(rdfs:comment "The MuTHER study includes 856 female European-descent individuals recruited from the TwinsUK Adult Twin Registry,24 as previously described.10 In brief, 8 mm punch biopsies were taken from a relatively photo-protected area adjacent and inferior to the umbilicus.") Annotation(oboInOwl:hasDbXref "PMID:24183450") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3824131/") coho:COHO_0000000 coho:COHO_0000307)
