ClassAssertion(Annotation(rdfs:comment "The second GWAS of African American samples (n = 6,597) (Supplementary Table 2) were identified from the MEC, CCFR, the Southern Community Cohort Study (SCCS), the MD Anderson Cancer Center, the University of North Carolina CanCORS study (UNCCanCORS) and Rectal Cancer Study (UNC-Rectal), and from the Prostate, Lung, Colorectal and Ovarian Cancer Screening (PLCO) Trial.") Annotation(oboInOwl:hasDbXref "PMID:25105248") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4180879/fullTextXML") coho:COHO_0000001 coho:COHO_0002059)
ClassAssertion(Annotation(rdfs:comment "The second group of subjects came from the Pittsburgh Lung Screening Study (PLuSS), a Pittsburgh-based CT lung cancer screening study that enrolled, between 2002 and 2005, 50-79 year-old current or former cigarette smokers (≥half pack/day for ≥25 years, quit ≤10 years).") Annotation(oboInOwl:hasDbXref "PMID:26352532") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4636453/unicode") coho:COHO_0000000 coho:COHO_0002262)
ClassAssertion(Annotation(rdfs:comment "The second sample (MRCE) of 950 individuals from 320 families of British descent was genotyped using the Illumina Sentrix HumanHap300 Genotyping BeadChip.") Annotation(oboInOwl:hasDbXref "PMID:23345460") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3613588/fullTextXML") coho:COHO_0000000 coho:COHO_0000305)
