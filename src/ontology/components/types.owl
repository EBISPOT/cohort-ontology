ClassAssertion(Annotation(rdfs:comment "The aim of the population-based Dortmund health study (DHS) is the assessment of the prevalence and incidence of different headache types as well as other chronic conditions and to analyse their consequences on daily activities of those affected.") Annotation(oboInOwl:hasDbXref "PMID:22736161") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22736161+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000054)
