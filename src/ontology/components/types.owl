ClassAssertion(Annotation(rdfs:comment "The LBC is a cross-sectional study of individuals of European descent who underwent liver biopsy for suspected NASH or severe obesity, consecutively enrolled in three European centres13,24.") Annotation(oboInOwl:hasDbXref "PMID:35102341") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8803605/fullTextXML") coho:COHO_0000000 coho:COHO_0002007)
