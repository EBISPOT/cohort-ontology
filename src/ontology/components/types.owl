ClassAssertion(Annotation(rdfs:comment "The original Lothian Birth Cohorts of 1921 (LBC1921) and 1936 (LBC1936) were designed as follow-up studies to the Scottish Mental Surveys of 1932 (SMS1932) and 1947 (SMS1947), respectively.") Annotation(oboInOwl:hasDbXref "PMID:29546429") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC6124629/") coho:COHO_0000001 coho:COHO_0000111)
ClassAssertion(Annotation(rdfs:comment "The overarching goal is to identify novel genetic factors that contribute to the genetic architecture of smoking through large-scale genome-wide association studies of two well-characterized cohorts.") Annotation(oboInOwl:hasDbXref "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs000404/phs000404.v1.p1/GapExchange_phs000404.v1.p1.xml") coho:COHO_0000001 coho:COHO_0001756)
ClassAssertion(Annotation(rdfs:comment "The parent study was the Seoul Breast Cancer Study (SeBCS), which is a multicenter case-control study of incident breast cancer patients and controls recruited from hospitals or the community that has been conducted beginning in 1995.") Annotation(oboInOwl:hasDbXref "PMID:24349656") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3859856/fullTextXML") coho:COHO_0000000 coho:COHO_0000966)
ClassAssertion(Annotation(rdfs:comment "The participants (Caucasian elderly subjects; 346 women and 149 men) included in the current report were aged 80 years or older, had blood pressure measurements available and were drawn from a longitudinal study of ageing—the Belfast Elderly Longitudinal Free-living Ageing STudy (BELFAST)") Annotation(oboInOwl:hasDbXref "PMID:19496022") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2813048/fullTextXML") coho:COHO_0000000 coho:COHO_0001521)
ClassAssertion(Annotation(rdfs:comment "The participants for this study included individuals aged 7 years and older recruited through four studies: the Pittsburgh Orofacial Cleft Study (POFC, n = 3,579); the Center for Oral Health Research in Appalachia (COHRA1, n = 1,837; COHRA2, n = 1,195), a joint study of the University of Pittsburgh and West Virginia University; and the Pittsburgh Dental SCORE project (n = 548).") Annotation(oboInOwl:hasDbXref "PMID:35172313") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9378791/fullTextXML") coho:COHO_0000001 coho:COHO_0001000)
ClassAssertion(Annotation(rdfs:comment "The participants of the analysis were enrolled in the nuMoM2b cohort (https://www.nichd.nih.gov/research/supported/nuMoM2b), a longitudinal, multiethnic cohort study of nulliparous individuals.") Annotation(oboInOwl:hasDbXref "PMID:38714721") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11076516/fullTextXML") coho:COHO_0000000 coho:COHO_0000877)
ClassAssertion(Annotation(rdfs:comment "The participants of this study were from the older Finnish Twin Cohort study, which is a longitudinal population-based study of twins from same-sex pairs born in Finland before 1958 (N=13,888) [24, 25].") Annotation(oboInOwl:hasDbXref "PMID:38671483") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC11046842/") coho:COHO_0000000 coho:COHO_0001728)
ClassAssertion(Annotation(rdfs:comment "The participants were from a population-based cohort entitled the Nutrition and Health of Aging People in China (NHAPC) study, which was designed to investigate environmental and genetic factors and their interactions on cardiometabolic diseases [21,22].") Annotation(oboInOwl:hasDbXref "PMID:34208976") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8308381/fullTextXML") coho:COHO_0000000 coho:COHO_0000789)
ClassAssertion(Annotation(rdfs:comment "The participants were recruited from The Netherlands Twin Register (NTR) and at baseline consisted of 112 families, with 9-year-old twins and an older sibling.") Annotation(oboInOwl:hasDbXref "PMID:22856378") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22856378+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000508)
ClassAssertion(Annotation(rdfs:comment "The participants were recruited from two groups: the Children’s Obesity Clinic, Centre of Obesity Management offering the multidisciplinary childhood obesity management program at Copenhagen University Hospital Holbæk69, and a population-based cohort from schools across 11 municipalities in Zealand, Denmark70, as part of a cross-sectional study conducted between January 2009 and April 2019.") Annotation(oboInOwl:hasDbXref "PMID:39972214") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11906355/fullTextXML") coho:COHO_0000000 coho:COHO_0000402)
