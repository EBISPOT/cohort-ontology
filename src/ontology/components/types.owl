ClassAssertion(Annotation(rdfs:comment "The Mayo Clinic Study of Aging is a prospective population-based cohort study of normal cognitive aging, MCI and dementia.") Annotation(oboInOwl:hasDbXref "PMID:18259084") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2821441/") coho:COHO_0000000 coho:COHO_0001204)
