ClassAssertion(Annotation(rdfs:comment "The Lung Health Study is a randomized clinical trial designed to determine whether a smoking intervention program and prescription of an inhaled bronchodilator can reduce the annual rate of decline of FEV1 (FEV1 slope) in cigarette smokers with mild to moderate airflow limitation.") Annotation(oboInOwl:hasDbXref "PMID:2048803") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2048803+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001998)
ClassAssertion(Annotation(rdfs:comment "The Luxembourg Parkinson’s study is a monocentric, observational cohort of individuals with neurodegenerative parkinsonism (PS) and controls without manifested clinical evidence for a neurodegenerative disorder (17).") Annotation(oboInOwl:hasDbXref "PMID:38174101") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10763250/fullTextXML") coho:COHO_0000000 coho:COHO_0001201)
ClassAssertion(Annotation(rdfs:comment "The Lübeck Registry of Structural Heart Disease /KORA (Kooperative Gesundheitsforschung in der Region Augsburg) survey S3/F3 datasets included cases selected from consecutive patients referred for coronary angiography, which were classified as CAD/MI based on the coronary angiogram; cases were < 65 y in males or < 70 y in females.") Annotation(oboInOwl:hasDbXref "PMID:23202125") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf") coho:COHO_0000000 coho:COHO_0001487)
ClassAssertion(Annotation(rdfs:comment "The M-LHC was a pilot of community-based targeted lung cancer screening for ever-smokers aged 55–74 invited by letter from 14 primary care practices in socioeconomically deprived parts of Manchester, commencing in 2016.") Annotation(oboInOwl:hasDbXref "PMID:40046247") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11880782/fullTextXML") coho:COHO_0000000 coho:COHO_0001369)
