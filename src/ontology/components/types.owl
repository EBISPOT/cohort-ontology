ClassAssertion(Annotation(rdfs:comment "We used data from the Hong Kong Osteoporosis Study (HKOS), which was the first prospective cohort study of osteoporosis and fracture in Asia [28].") Annotation(oboInOwl:hasDbXref "PMID:39458530") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11509949/fullTextXML") coho:COHO_0000000 coho:COHO_0000949)
