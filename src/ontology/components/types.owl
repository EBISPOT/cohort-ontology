ClassAssertion(Annotation(rdfs:comment "2,954 samples from 14 countries were collected through the Myositis Genetics Consortium (MYOGEN), and written informed consent was obtained from all cases with approval from research ethics boards at each participating centre.") Annotation(oboInOwl:hasDbXref "PMID:26362759") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5300750/") coho:COHO_0000001 coho:COHO_0001209)
ClassAssertion(Annotation(rdfs:comment "2183 patients were recruited to the Leeds Melanoma Cohort (LMC) between 2000 and 2012 (Newton-Bishop et al., 2015).") Annotation(oboInOwl:hasDbXref "PMID:31425707") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC6983339/") coho:COHO_0000000 coho:COHO_0000106)
ClassAssertion(Annotation(rdfs:comment "3,006 participants from KORA S3 were reexamined in a 10-year follow- up (KORA F3) in the years 2004/05.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-022-32821-z/MediaObjects/41467_2022_32821_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001974)
ClassAssertion(Annotation(rdfs:comment "3,402 kidney or simultaneous kidney-pancreas transplant (SPK) recipients in 5 U.S. and 2 Canadian transplant centers were consented and enrolled at the time of transplantation in the DeKAF Genomics, a prospective observational, study between 2006 and 2011.") Annotation(oboInOwl:hasDbXref "PMID:23879408") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3787982/") coho:COHO_0000000 coho:COHO_0001655)
ClassAssertion(Annotation(rdfs:comment "300OB is an obese cohort of 302 individuals aged 54–81 years old, who were enrolled in the study at the Radboud University Medical Center, Nijmegen, the Netherlands.") Annotation(oboInOwl:hasDbXref "PMID:36522747") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9753387/fullTextXML") coho:COHO_0000000 coho:COHO_0000631)
ClassAssertion(Annotation(rdfs:comment "3353 Chinese adults who participated in the baseline SCES-1 (2009-2011) were invited for the 6-year follow-up SCES-2 (2015-2017).") Annotation(oboInOwl:hasDbXref "PMID:31401553") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31401553+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000762)
ClassAssertion(Annotation(rdfs:comment "450 patients with different systemic autoinflammatory disorders (SAID) and healthy controls were enrolled from 30 clinical centers throughout Europe and Turkey, to assure a broad inclusion of SAID subtypes and a sufficient number of individuals for rare diseases.") Annotation(oboInOwl:hasDbXref "PMID:41917006") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13201634/fullTextXML") coho:COHO_0000000 coho:COHO_0000280)
ClassAssertion(Annotation(rdfs:comment "50 AYAs aged 12-29 with newly diagnosed or recurrent HGG and other high risk central nervous system (CNS) tumours were prospectively recruited to the EORTC SPECTA platform study and underwent whole exome sequencing, RNA sequencing and methylation profiling, with central pathological review.") Annotation(oboInOwl:hasDbXref "PMID:40393126") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:40393126%20AND%20SRC:MED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000249)
ClassAssertion(Annotation(rdfs:comment "A baseline cohort of 11,500 nine and ten year old children (and their parents/guardians) are being recruited and will be followed for ten years with annual lab-based assessments including biennial Magnetic Resonance Imaging (MRI).") Annotation(oboInOwl:hasDbXref "PMID:29703560") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6314286/fullTextXML") coho:COHO_0000000 coho:COHO_0000545)
ClassAssertion(Annotation(rdfs:comment "A bioresource (UKCTOCS Longitudinal Women's Cohort) of longitudinal outcome data and over 0.5 million serum samples including serial annual samples in women in the MMS group was established and to date has been used in many new studies, mainly focused on early detection of cancer.") Annotation(oboInOwl:hasDbXref "PMID:37183782") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37183782+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002688)
ClassAssertion(Annotation(rdfs:comment "A case-control study of reproductive factors and cancer of the ovary was conducted during 1989-1992 in metropolitan Toronto and nearby areas of Southern Ontario, Canada.") Annotation(oboInOwl:hasDbXref "PMID:7942759") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A7942759+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002400)
ClassAssertion(Annotation(rdfs:comment "A case-control study was designed to elucidate roles of dietary and other behavioral influences, in combination with genetic susceptibility factors (genetic polymorphisms), in colorectal carcinogenesis.") Annotation(oboInOwl:hasDbXref "PMID:15546244") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15546244+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001720)
ClassAssertion(Annotation(rdfs:comment "A cohort of 1189 healthy individuals representing 507 sibships between 14 and 35 years old was collected between June 26, 2006 and January 30, 2009 at the University of Michigan, Ann Arbor.") Annotation(oboInOwl:hasDbXref "PMID:25208887") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC4231423") coho:COHO_0000000 coho:COHO_0001331)
ClassAssertion(Annotation(rdfs:comment "A cohort of 1538 individuals diagnosed with bipolar I or II disorder (DSM-IV) and 2271 healthy controls were recruited from seven academic institutions and their affiliated hospitals in South Korea through the Korean Psychiatric Genome-Wide Association Study (GWAS) Project.") Annotation(oboInOwl:hasDbXref "PMID:42229218") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42229218+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000978)
ClassAssertion(Annotation(rdfs:comment "A cohort of 66 806 men and women aged 50–76 years at baseline who participated in the VITamins And Lifestyle (VITAL) study was followed from 2000 to 2008.") Annotation(oboInOwl:hasDbXref "PMID:26554653") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") coho:COHO_0000000 coho:COHO_0000579)
ClassAssertion(Annotation(rdfs:comment "A cohort of Caribbean Hispanics with familial LOAD was recruited in a different study at the Taub Institute for Research on Alzheimer's Disease and the Aging Brain in New York and from clinics in the Dominican Republic as part of the EFIGA study.") Annotation(oboInOwl:hasDbXref "PMID:24425039") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24425039+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001683)
ClassAssertion(Annotation(rdfs:comment "A cohort was assembled comprising 161 Barrett, 777 OACs and 59 metastatic samples that had been collected through a multicentre UK wide study called OCCAMS (Oesophageal Cancer Classification And Molecular Stratification) and undergone whole genome sequencing (WGS) as part of the ICGC-International Cancer Genome Consortium.") Annotation(oboInOwl:hasDbXref "PMID:37454136") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10349863/fullTextXML") coho:COHO_0000000 coho:COHO_0000272)
