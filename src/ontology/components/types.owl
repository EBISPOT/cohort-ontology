ClassAssertion(Annotation(rdfs:comment "We have summarized the evolution of the Nurses' Health Study (NHS), a prospective cohort study of 121 700 married registered nurses launched in 1976; NHS II, which began in 1989 and enrolled 116 430 nurses; and NHS3, which began in 2010 and has ongoing enrollment.") Annotation(oboInOwl:hasDbXref "PMID:27459450") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27459450+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000001 coho:COHO_0002594)
