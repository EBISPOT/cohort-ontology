ClassAssertion(Annotation(rdfs:comment "We report our comprehensive genome-wide association study as part of the International FTLD-TDP Whole-Genome Sequencing Consortium, including 985 patients and 3,153 controls compiled from 26 institutions/brain banks in North America, Europe and Australia, and meta-analysis with the Dementia-seq cohort.") Annotation(oboInOwl:hasDbXref "PMID:40280976") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40280976+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000001 coho:COHO_0001006)
ClassAssertion(Annotation(rdfs:comment "We selected samples for previously-studied individuals from 2 sources: 1,130 Bipolar I (BP I) cases and 772 controls from the NIMH Human Genetics Initiative Repository (http://zork.wustl.edu/nimh/) and 47 BP I cases from the University of Michigan Prechter Repository.") Annotation(oboInOwl:hasDbXref "PMID:19416921") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2678639/") coho:COHO_0000000 coho:COHO_0002156)
