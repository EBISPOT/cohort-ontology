ClassAssertion(Annotation(rdfs:comment "The Wisconsin Longitudinal Study (WLS) is a longitudinal study of men and women who graduated from Wisconsin high schools in 1957 and one of their randomly selected siblings.") Annotation(oboInOwl:hasDbXref "PMID:24585852") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3937969/") coho:COHO_0000000 coho:COHO_0000696)
