ClassAssertion(Annotation(rdfs:comment "The MCRC Biobank brings together organised tissue, blood and other sample collection across four NHS Trusts under one centralised infrastructure and governance framework, to facilitate the provision of samples of highest quality as efficiently as possible.") Annotation(oboInOwl:hasDbXref "https://www.mcrc.manchester.ac.uk/research/mcrc-biobank/about-the-mcrc-biobank/") coho:COHO_0000000 coho:COHO_0001371)
