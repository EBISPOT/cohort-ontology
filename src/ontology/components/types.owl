ClassAssertion(Annotation(rdfs:comment "The samples included in this cohort were evaluated at memory disorder unit at Skåne University Hospital.") Annotation(oboInOwl:hasDbXref "PMID:42014397") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-026-71682-8/MediaObjects/41467_2026_71682_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0000885)
ClassAssertion(Annotation(rdfs:comment "The samples included in this study were from two Dutch breast cancer case-control studies: RBCS and ABCS-F.") Annotation(oboInOwl:hasDbXref "PMID:27424772") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4948019/fullTextXML") coho:COHO_0000000 coho:COHO_0001459)
