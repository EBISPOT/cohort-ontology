ClassAssertion(Annotation(rdfs:comment "The Salzburg Atherosclerosis Prevention Program in subjects at High Individual Risk (the SAPHIR study) has been initiated in 1999 as a prospective study that investigates genetic and environmental factors contributing to atherosclerotic vascular diseases [20].") Annotation(oboInOwl:hasDbXref "PMID:25273948") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4411770/fullTextXML") coho:COHO_0000000 coho:COHO_0002341)
