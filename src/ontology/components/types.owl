ClassAssertion(Annotation(rdfs:comment "The ZOE 2.0 cohort is a sizable, community-based, multi-ethnic, genetic epidemiologic study of early childhood oral health.") Annotation(oboInOwl:hasDbXref "PMID:33139633") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC7663650/") coho:COHO_0000000 coho:COHO_0001252)
ClassAssertion(Annotation(rdfs:comment "The aim of ICGC GCS program is to genomically characterize C and S components of 20 tumors, from endometrium or ovary, through an integrative analysis of whole genome sequencing, RNA sequencing and methylome array.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001002271") coho:COHO_0000000 coho:COHO_0000268)
