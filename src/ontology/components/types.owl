ClassAssertion(Annotation(rdfs:comment "(f) Forest plot depicting odds ratio estimates at rs75493593 from the four SIGMA cohorts, the SIGMA pooled mega-analysis, the replication cohorts, replication-only meta-analysis, and the overall meta-analysis (including all replication cohorts and the SIGMA mega-analysis).") Annotation(oboInOwl:hasDbXref "PMID:24390345") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4127086/") coho:COHO_0000001 coho:COHO_0000736)
