ClassAssertion(Annotation(rdfs:comment "The study sample consisted of 3302 women enrolled in the SWAN, a multiethnic, longitudinal, community-based study of women’s midlife aging.") Annotation(oboInOwl:hasDbXref "PMID:42076794") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML") coho:COHO_0000000 coho:COHO_0000495)
