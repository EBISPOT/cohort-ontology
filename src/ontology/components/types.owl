ClassAssertion(Annotation(rdfs:comment "A genome-wide association study meta-analysis was conducted in totalling 2644 Chinese individuals from 3 cohorts: the Guangzhou cohort (GZ, 537 high myopes and 151 hyperopes), Wenzhou cohort (334 high myopes and 6 hyperopes) and Guangzhou Twin Eye Study (1051 participants with normally distributed AL).") Annotation(oboInOwl:hasDbXref "PMID:37524447") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37524447+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001348)
