ClassAssertion(Annotation(rdfs:comment "The International Warfarin Pharmacogenetics Consortium comprises 21 research groups from 9 countries and 4 continents.") Annotation(oboInOwl:hasDbXref "PMID:19228618") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC2722908") coho:COHO_0000001 coho:COHO_0001361)
