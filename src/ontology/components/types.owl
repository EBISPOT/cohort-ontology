ClassAssertion(Annotation(rdfs:comment "The ASPS-Fam is a prospective single-center community-based study on the cerebral effects of vascular risk factors in residents of the city of Graz, Austria, without clinical signs and symptoms of stroke and dementia and a normal neurological examination [7, 25].") Annotation(oboInOwl:hasDbXref "PMID:35951362") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9467397/fullTextXML") coho:COHO_0000000 coho:COHO_0000858)
ClassAssertion(Annotation(rdfs:comment "The Accelerating Medicines Partnership Parkinson's Disease program has developed a research platform for Parkinson's disease (PD) that integrates the storage and analysis of whole-genome sequencing data, RNA expression data, and clinical data, harmonized across multiple cohort studies.") Annotation(oboInOwl:hasDbXref "PMID:33960523") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33960523+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000001 coho:COHO_0000894)
ClassAssertion(Annotation(rdfs:comment "The Action to Control Cardiovascular Risk in Diabetes (ACCORD) trial is a randomized, multicenter, double 2 x 2 factorial design study involving 10,251 middle-aged and older participants with type 2 diabetes who are at high risk for CVD events because of existing CVD or additional risk factors.") Annotation(oboInOwl:hasDbXref "PMID:17599422") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17599422+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001465)
ClassAssertion(Annotation(rdfs:comment "The African Genome Resource encompasses approximately 3000 whole genome sequences, 600 transcriptomes and an infrastructure for computation and capacity development in the form of a new informatics centre in Uganda.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001001917") coho:COHO_0000001 coho:COHO_0000213)
ClassAssertion(Annotation(rdfs:comment "The African Research on Kidney Disease (ARK) study is a three-country study embedded within existing cohorts.") Annotation(oboInOwl:hasDbXref "PMID:31941441") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6964098/fullTextXML") coho:COHO_0000000 coho:COHO_0001144)
ClassAssertion(Annotation(rdfs:comment "The African cohorts were obtained through the Warfarin Anticoagulation in Patients in sub-Saharan Africa (War-PATH http://warpath.info/) observational study.16, 17, 18") Annotation(oboInOwl:hasDbXref "PMID:39163621") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11493193/fullTextXML") coho:COHO_0000000 coho:COHO_0001433)
ClassAssertion(Annotation(rdfs:comment "The Age-Related Eye Disease Study (AREDS) was initially conceived as a long-term multicenter, prospective study of the clinical course of age-related macular degeneration (AMD) and age-related cataract.") Annotation(oboInOwl:hasDbXref "PMID:10588299") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC1473211/") coho:COHO_0000000 coho:COHO_0001142)
ClassAssertion(Annotation(rdfs:comment "The Age-Related Eye Disease Study 2 (AREDS2), a multicenter, randomized, double-masked, placebo-controlled phase 3 study with a 2 × 2 factorial design, conducted in 2006-2012 and enrolling 4203 participants aged 50 to 85 years at risk for progression to advanced AMD") Annotation(oboInOwl:hasDbXref "PMID:23644932") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23644932+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001143)
ClassAssertion(Annotation(rdfs:comment "The Aichi CRC Study: This study had two case-control collections (Aichi-1 and Aichi-2) with a total of 640 cases and 1,414 controls 1 .") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") coho:COHO_0000000 coho:COHO_0001482)
ClassAssertion(Annotation(rdfs:comment "The All of Us Research Program plans to enroll a diverse group of at least 1 million persons in the United States in order to accelerate biomedical research and improve health.") Annotation(oboInOwl:hasDbXref "PMID:31412182") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31412182+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000423)
ClassAssertion(Annotation(rdfs:comment "The Alzheimer's Disease Neuroimaging Initiative has successfully recruited cohorts of cognitively normal subjects, subjects with mild cognitive impairment (MCI), and subjects with Alzheimer disease with anticipated baseline characteristics.") Annotation(oboInOwl:hasDbXref "PMID:20042704") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20042704+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000367)
ClassAssertion(Annotation(rdfs:comment "The Amagasaki Study is an ongoing population-based cohort study of 5,743 individuals (3,435 males and 2,310 females), aged >18 years and recruited for a baseline examination between September 2002 to August 200329.") Annotation(oboInOwl:hasDbXref "PMID:26648100") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4673465/fullTextXML") coho:COHO_0000000 coho:COHO_0001556)
ClassAssertion(Annotation(rdfs:comment "The American Cancer Society Cancer Prevention Study-3 (CPS-3) is a prospective cohort study of over 300,000 US adults with the primary goal of investigating cancer incidence and mortality [9].") Annotation(oboInOwl:hasDbXref "PMID:39150951") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11329134/fullTextXML") coho:COHO_0000000 coho:COHO_0002685)
ClassAssertion(Annotation(rdfs:comment "The Amish Family Osteoporosis Study (AFOS) study was designed to identify genetic determinants of osteoporosis in the Old Order Amish (OOA) population from Lancaster County, PA USA.") Annotation(oboInOwl:hasDbXref "PMID:22792071") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3390364/unicode") coho:COHO_0000000 coho:COHO_0001274)
ClassAssertion(Annotation(rdfs:comment "The Amsterdam Cohort Studies (ACS) on HIV was initiated in 1984, and is an open, prospective cohort study among MSM [10].") Annotation(oboInOwl:hasDbXref "PMID:30312336") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6185853/fullTextXML") coho:COHO_0000000 coho:COHO_0000971)
ClassAssertion(Annotation(rdfs:comment "The Amsterdam Dementia Cohort is the ongoing study attached to the memory clinic of the VUmc Alzheimer center.") Annotation(oboInOwl:hasDbXref "PMID:29562540") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5870023/fullTextXML") coho:COHO_0000000 coho:COHO_0000374)
ClassAssertion(Annotation(rdfs:comment "The Amsterdam UMC COVID-19 biobank is a prospective cohort study containing clinical data and archive material from adult patients admitted with COVID-19 in two academic hospitals of Amsterdam UMC.") Annotation(oboInOwl:hasDbXref "PMID:34000622") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8118723/fullTextXML") coho:COHO_0000000 coho:COHO_0001485)
ClassAssertion(Annotation(rdfs:comment "The Aneurysm-Express study (which is a derivative of the previously mentioned Athero-Express study) is a longitudinal biobank study that includes aneurysm tissue from all patients undergoing open surgical abdominal aortic aneurysm (AAA) repair in two Dutch hospitals.") Annotation(oboInOwl:hasDbXref "PMID:25372389") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4220929/fullTextXML") coho:COHO_0000000 coho:COHO_0001475)
ClassAssertion(Annotation(rdfs:comment "The Anglo-Australasian Osteoporosis Genetics Consortium (AOGC) study collected unrelated individuals with extreme BMD phenotypes as a powerful strategy for gene discovery in quantitative traits [11], [52].") Annotation(oboInOwl:hasDbXref "PMID:22792071") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3390364/fullTextXML") coho:COHO_0000000 coho:COHO_0001279)
ClassAssertion(Annotation(rdfs:comment "The Anti-Amyloid Treatment in Asymptomatic AD (A4) study was a phase 3 clinical prevention trial (ClinicalTrials.gov Number: NCT02008357) to determine if solanezumab, a monoclonal antibody against monomeric forms of Aβ, could slow the progression of cognitive decline in people with preclinical AD.") Annotation(oboInOwl:hasDbXref "PMID:41569280") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12825300/fullTextXML") coho:COHO_0000000 coho:COHO_0000632)
ClassAssertion(Annotation(rdfs:comment "The Arsenic Health Risk Assessment and Molecular Epidemiology (ASHRAM) study, a case–control study, was conducted in areas of Hungary, Romania, and Slovakia with reported presence of iAs in groundwater.") Annotation(oboInOwl:hasDbXref "PMID:22436128") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3346769/fullTextXML") coho:COHO_0000000 coho:COHO_0001497)
ClassAssertion(Annotation(rdfs:comment "The Ashford study is an unselected birth cohort study established in 1991 in Ashford, UK (Atkinson et al., 1999).") Annotation(oboInOwl:hasDbXref "PMID:37227431") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10292845/fullTextXML") coho:COHO_0000000 coho:COHO_0000994)
ClassAssertion(Annotation(rdfs:comment "The Asian Genetic Epidemiology Network (AGEN) is a consortium of genetic epidemiology studies of cardiovascular disease related phenotypes, such as BP (or hypertension), diabetes, and obesity, conducted among Asian populations.") Annotation(oboInOwl:hasDbXref "PMID:21572416") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3158568/") coho:COHO_0000001 coho:COHO_0001275)
ClassAssertion(Annotation(rdfs:comment "The Asklepios Study is a longitudinal population study focusing on the interplay between ageing, cardiovascular haemodynamics and inflammation in (preclinical) cardiovascular disease.") Annotation(oboInOwl:hasDbXref "PMID:17446795") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17446795+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001449)
ClassAssertion(Annotation(rdfs:comment "The Aspirin for Asymptomatic Atherosclerosis trial was an intention-to-treat double-blind randomized controlled trial conducted from April 1998 to October 2008, involving 28,980 men and women aged 50 to 75 years living in central Scotland, free of clinical cardiovascular disease, recruited from a community health registry, and had an ABI screening test.") Annotation(oboInOwl:hasDbXref "PMID:20197530") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20197530+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000009)
ClassAssertion(Annotation(rdfs:comment "The Aston Dyslexia cohort includes 105 unrelated individuals, recruited through the Aston Dyslexia and Developmental Assessment Unit in Birmingham, UK (age range 7–16 years).") Annotation(oboInOwl:hasDbXref "PMID:28742079") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5538127/fullTextXML") coho:COHO_0000000 coho:COHO_0000814)
ClassAssertion(Annotation(rdfs:comment "The AtheroGene study is a prospective, multicenter, clinical cohort study including patients with known CAD (at least one stenosis over 30%) as diagnosed by coronary angiography.") Annotation(oboInOwl:hasDbXref "PMID:26154343") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4496051/fullTextXML") coho:COHO_0000000 coho:COHO_0001500)
ClassAssertion(Annotation(rdfs:comment "The Atherosclerotic Disease, VAscular FunctioN and GenetiC Epidemiology (ADVANCE) study was originally designed as a case-control investigation of genetic and non-genetic determinants of coronary artery disease (CAD) and mode of CAD presentation.") Annotation(oboInOwl:hasDbXref "PMID:27030599") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1136/heartjnl-2015-309136") coho:COHO_0000000 coho:COHO_0001053)
ClassAssertion(Annotation(rdfs:comment "The Atopic Dermatitis Research Network (ADRN) is a consortium of academic medical centers that will conduct clinical research studies in an attempt to learn more about skin infections associated with atopic dermatitis (AD).") Annotation(oboInOwl:hasDbXref "https://www.nationaljewish.org/research-science/clinical-translational-research/atopic-dermatitis-research-network-adrn/overview") coho:COHO_0000001 coho:COHO_0000012)
ClassAssertion(Annotation(rdfs:comment "The Atrial Fibrillation Genetics Consortium (AFGen) is a collaboration between multiple studies with the aim of investigating the genetic causes of atrial fibrillation.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5585859/") coho:COHO_0000001 coho:COHO_0000855)
ClassAssertion(Annotation(rdfs:comment "The Australian Breast Cancer Family Registry (ABCFR) is a population-based, case control family study of breast cancer with an emphasis on early-onset breast cancer that is being carried out in Melbourne and Sydney, Australia [9-11], and is part of the Breast Cancer Family Registry [12].") Annotation(oboInOwl:hasDbXref "PMID:21182766") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3046454/fullTextXML") coho:COHO_0000000 coho:COHO_0001048)
ClassAssertion(Annotation(rdfs:comment "The Australian Genetics of Bipolar Disorder Study is a nation-wide cohort of adults living with bipolar disorder.") Annotation(oboInOwl:hasDbXref "PMID:37655588") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10619176/fullTextXML") coho:COHO_0000000 coho:COHO_0001757)
ClassAssertion(Annotation(rdfs:comment "The Australian Genetics of Depression study was established to recruit a large cohort of individuals who have been diagnosed with depression at some point in their lifetime.") Annotation(oboInOwl:hasDbXref "PMID:32461290") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7259831/fullTextXML") coho:COHO_0000000 coho:COHO_0000672)
ClassAssertion(Annotation(rdfs:comment "The Australian Imaging, Biomarkers and Lifestyle (AIBL) Study commenced in 2006 as a prospective study of 1,112 individuals (768 cognitively normal (CN), 133 with mild cognitive impairment (MCI), and 211 with Alzheimer’s disease dementia (AD)) as an ‘Inception cohort’ who underwent detailed ssessments every 18 months.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8293663/fullTextXML") coho:COHO_0000000 coho:COHO_0000405)
ClassAssertion(Annotation(rdfs:comment "The Australian National Endometrial Cancer Study (ANECS) is an Australia-wide, population-based case–control study.") Annotation(oboInOwl:hasDbXref "PMID:22245995") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1007/s10552-011-9894-5") coho:COHO_0000000 coho:COHO_0001486)
ClassAssertion(Annotation(rdfs:comment "The Australian Prostate Cancer BioResource (APCB) collected biological samples and clinical data from men undergoing RP at the Royal Adelaide Hospital (RAH) and St Vincent's Hospital (SVH), Sydney.") Annotation(oboInOwl:hasDbXref "PMID:23846169") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3738112/fullTextXML") coho:COHO_0000000 coho:COHO_0001491)
ClassAssertion(Annotation(rdfs:comment "The Australian Twin Eye Study comprises participants examined as part of the Twins Eye Study in Tasmania (TEST) or the Brisbane Adolescent Twins Study (BATS).") Annotation(oboInOwl:hasDbXref "PMID:23599335") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4141707/") coho:COHO_0000001 coho:COHO_0001499)
ClassAssertion(Annotation(rdfs:comment "The Australian Twin Migraine GWA study (N = 6350) included 2825 migraine cases and 3525 controls, 805 of whom met the diagnostic criteria for MDD.") Annotation(oboInOwl:hasDbXref "PMID:24081561") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3947136/unicode") coho:COHO_0000000 coho:COHO_0001501)
ClassAssertion(Annotation(rdfs:comment "The Australian and New Zealand Registry of Advanced Glaucoma is a prospective study that aims to develop a large cohort of glaucoma cases with severe visual field loss to identify novel genetic risk factors for glaucoma blindness.") Annotation(oboInOwl:hasDbXref "PMID:22171965") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22171965+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001489)
ClassAssertion(Annotation(rdfs:comment "The Austrian Diabetic Nephropathy Study (AusDiane) was initiated in 2012 in the state of Salzburg in Austria, and is part of the InterDiane Consortium (please see also the InterDiane cohort description).") Annotation(oboInOwl:hasDbXref "https://cdn-links.lww.com/permalink/jsn/c/jsn_30_10_2022_12_07_salem_2019030218_sdc1.pdf") coho:COHO_0000000 coho:COHO_0001504)
ClassAssertion(Annotation(rdfs:comment "The Avon Longitudinal Study of Parents and their Children (ALSPAC) is a population-based birth cohort study consisting initially of over 13 000 women and their children recruited in the county of Avon, UK in the early 1990s") Annotation(oboInOwl:hasDbXref "PMID:21946350") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.941/MediaObjects/41588_2011_BFng941_MOESM4_ESM.pdf") coho:COHO_0000000 coho:COHO_0000016)
ClassAssertion(Annotation(rdfs:comment "The B-PROOF (B-Vitamins for the PRevention Of Osteoporotic Fractures) study is a randomized double-blind placebo-controlled trial.") Annotation(oboInOwl:hasDbXref "PMID:22136481") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3266639/fullTextXML") coho:COHO_0000000 coho:COHO_0000859)
ClassAssertion(Annotation(rdfs:comment "The BAMSE project: presentation of a prospective longitudinal birth cohort study.") Annotation(oboInOwl:hasDbXref "PMID:12688617") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12688617+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000037)
ClassAssertion(Annotation(rdfs:comment "The BARCODE1 study (NCT03857477) is enrolling men of European ancestry from the community via their GPs to undergo a germline genetic profile test utilising 130 PCa risk SNPs.") Annotation(oboInOwl:hasDbXref "PMID:34214236") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9292247/fullTextXML") coho:COHO_0000000 coho:COHO_0001507)
ClassAssertion(Annotation(rdfs:comment "The BASICMAR database (18) is an ongoing prospective register of patients with acute stroke at University Hospital del Mar, a tertiary public hospital serving a population of 330,000 in three districts of the city of Barcelona.") Annotation(oboInOwl:hasDbXref "PMID:29706931") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5908882/fullTextXML") coho:COHO_0000000 coho:COHO_0001057)
ClassAssertion(Annotation(rdfs:comment "The BBDP is a longitudinal clinicopathological study of AD, PD and normal aging.") Annotation(oboInOwl:hasDbXref "PMID:25619230") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4593391/") coho:COHO_0000000 coho:COHO_0001506)
ClassAssertion(Annotation(rdfs:comment "The BBJ is a registry of patients diagnosed with any of 47 target common diseases.") Annotation(oboInOwl:hasDbXref "PMID:28189464") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28189464+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000377)
ClassAssertion(Annotation(rdfs:comment "The BCPP is a prospective longitudinal cohort study of all patients with newly diagnosed bladder cancer within the West Midlands (UK), investigating the influence of lifestyle factors on recurrence and progression, health-related quality of life, the predictive effect of a panel of molecular markers on recurrence or progression, and the establishment of Europe's largest comprehensive bladder cancer bio-repository.") Annotation(oboInOwl:hasDbXref "PMID:19751260") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19751260+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000018)
ClassAssertion(Annotation(rdfs:comment "The BHF Family Heart Study was conceived primarily to provide a major resource of affected sib pairs for mapping genes involved in the pathogenesis of premature CAD through a linkage-based approach.") Annotation(oboInOwl:hasDbXref "PMID:16380912") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC1285159") coho:COHO_0000000 coho:COHO_0000346)
ClassAssertion(Annotation(rdfs:comment "The BICWALZS is a prospective and longitudinal study assessing various clinical and biomarker characteristics in older adults with cognitive complaints.") Annotation(oboInOwl:hasDbXref "PMID:35042283") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8898610/fullTextXML") coho:COHO_0000000 coho:COHO_0001530)
ClassAssertion(Annotation(rdfs:comment "The BLSA trial is a cohort of volunteers continually recruited since 1958, primarily from the Baltimore-Washington, DC, area.") Annotation(oboInOwl:hasDbXref "PMID:17481443") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2646088/") coho:COHO_0000000 coho:COHO_0000195)
ClassAssertion(Annotation(rdfs:comment "The BNCS is a population-based case-control study of breast and prostate cancer in Barbados-born residents.") Annotation(oboInOwl:hasDbXref "PMID:18814239") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2659620/") coho:COHO_0000000 coho:COHO_0001291)
ClassAssertion(Annotation(rdfs:comment "The BQC19 has been designed as a cohort that includes SARS-CoV-2 PCR negative controls to prospectively study the clinical and biological determinants of COVID-19 clinical trajectories.") Annotation(oboInOwl:hasDbXref "PMID:34010280") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8133500/fullTextXML") coho:COHO_0000000 coho:COHO_0000997)
ClassAssertion(Annotation(rdfs:comment "The BRAINS project, which includes three large multicentre prospective recruitment studies BRAINS-UK, BRAINS-South Asia and BRAINS-Middle East, aims to gain a much better understanding of the genetics of stroke by investigating the influence of genetic factors on stroke risk in European, South Asian and Qatari populations.") Annotation(oboInOwl:hasDbXref "PMID:24175068") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3738328/fullTextXML") coho:COHO_0000000 coho:COHO_0001063)
ClassAssertion(Annotation(rdfs:comment "The BRASS registry is a single-center, prospective observational cohort that enrolled participants from the Brigham and Women’s Hospital Arthritis Center in Boston, MA from March 2003 – May 2019.") Annotation(oboInOwl:hasDbXref "PMID:40977501") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC12904143/") coho:COHO_0000000 coho:COHO_0001292)
ClassAssertion(Annotation(rdfs:comment "The Baependi Heart Study was set up in 2005 to develop a longitudinal family-based cohort study that reflects on some of the genetic and lifestyle-related peculiarities of the Brazilian populations, in order to evaluate genetic and environmental influences on CVD risk factor traits.") Annotation(oboInOwl:hasDbXref "PMID:27797990") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27797990+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000623)
ClassAssertion(Annotation(rdfs:comment "The Baltimore Breast Cancer Study is a case–control study of breast cancer designed to identify and characterize markers of disease aggressiveness and poor outcome (29).") Annotation(oboInOwl:hasDbXref "PMID:22357627") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC3324445") coho:COHO_0000000 coho:COHO_0001288)
ClassAssertion(Annotation(rdfs:comment "The Barcelona cohort is a subset of Caucasian Ischemic stroke subjects that were enrolled as a part of the Genetic contribution to functional Outcome and Disability after Stroke (GODs) project.") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001247)
ClassAssertion(Annotation(rdfs:comment "The Barry Caerphilly Growth (BCG) cohort study is a long-term follow-up of a randomized controlled trial of 1,163 infants born consecutively between March 1972 and October 1974 in two populations from the towns of Barry and Caerphilly in South Wales [15].") Annotation(oboInOwl:hasDbXref "PMID:22479550") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3313975/fullTextXML") coho:COHO_0000000 coho:COHO_0001517)
ClassAssertion(Annotation(rdfs:comment "The Bavarian Breast Cancer Cases and Controls (BBCC) study is a case–control study aimed at investigating molecular and epidemiological breast cancer risk, prognostic, and predictive factors 17 21 22 23 24 25 26 .") Annotation(oboInOwl:hasDbXref "PMID:38178900") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10764119/fullTextXML") coho:COHO_0000000 coho:COHO_0001058)
ClassAssertion(Annotation(rdfs:comment "The Bavarian Endometrial Cancer Cases and Controls Study (BECS) is a single-center case-control study, conducted between 2002 and 2008, with the aim of investigating genetic and epidemiological risk factors for endometrial cancer.") Annotation(oboInOwl:hasDbXref "PMID:27135401") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM301_ESM.pdf") coho:COHO_0000000 coho:COHO_0001520)
ClassAssertion(Annotation(rdfs:comment "The BbofA-GL cohort includes participants drawn from the customer base of Genomelink (genomelink.io), which offers a direct-to-consumer genetic traits platform with more than 500,000 users globally.") Annotation(oboInOwl:hasDbXref "PMID:39218908") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11367857/fullTextXML") coho:COHO_0000000 coho:COHO_0001511)
ClassAssertion(Annotation(rdfs:comment "The Beijing Eye Study is a population-based prospective cohort study in Greater Beijing that started in 2001 at baseline.") Annotation(oboInOwl:hasDbXref "PMID:25347072") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4210166/fullTextXML") coho:COHO_0000000 coho:COHO_0000816)
ClassAssertion(Annotation(rdfs:comment "The BioImage Study (NCT00738725) is a prospective, observational study designed to evaluate associations among imaging and circulating biomarkers (cross-sectional) and their ability to predict atherothrombotic events (longitudinal) in asymptomatic at-risk subjects in the primary prevention of myocardial infarction and stroke [33].") Annotation(oboInOwl:hasDbXref "PMID:21800090") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3165130/fullTextXML") coho:COHO_0000000 coho:COHO_0001290)
ClassAssertion(Annotation(rdfs:comment "The Biobank is an initiative of the Menzies Institute for Medical Research, University of Tasmania, and associated clinics that aims to collect DNA samples and clinical information from Tasmanian residents diagnosed with a variety of ocular conditions.") Annotation(oboInOwl:hasDbXref "PMID:34013049") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC8098929/") coho:COHO_0000000 coho:COHO_0001422)
ClassAssertion(Annotation(rdfs:comment "The Biologics in Rheumatoid Arthritis Genetics and Genomics Study Syndicate is a nationwide observational cohort study recruiting patients from 53 centers across the United Kingdom before the initiation of biologic treatment and following them up prospectively for 12 months.") Annotation(oboInOwl:hasDbXref "PMID:40567118") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40567118+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001545)
ClassAssertion(Annotation(rdfs:comment "The Biomarker AF study (ClinicalTrials.gov Identifier: NCT01510197) is an observational hospital-based cohort (n=500; in GGAF 458) to identify a risk profile to guide AF therapy in all-comers with AF.") Annotation(oboInOwl:hasDbXref "PMID:29892015") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0002706)
ClassAssertion(Annotation(rdfs:comment "The Bio‐SHiFT (Serial Biomarker Measurements and New Echocardiographic Techniques in Chronic Heart Failure Patients Result in Tailored Prediction of Prognosis) study is a prospective cohort study of stable patients with CHF, conducted in Erasmus MC, Rotterdam, and Northwest Clinics, Alkmaar, The Netherlands.") Annotation(oboInOwl:hasDbXref "PMID:30760105") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6405680/fullTextXML") coho:COHO_0000000 coho:COHO_0000995)
ClassAssertion(Annotation(rdfs:comment "The Bipolar Family Study (BFS) is a prospective longitudinal study that has examined individuals at familial risk of mood disorder and healthy controls on three occasions, 2 years apart.") Annotation(oboInOwl:hasDbXref "PMID:25229638") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25229638+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001528)
ClassAssertion(Annotation(rdfs:comment "The Blood First Assay Screening Trial is a global, open-label, multicohort trial that evaluates the efficacy and safety of multiple therapies in patients with advanced/metastatic NSCLC and targetable alterations identified by liquid biopsy.") Annotation(oboInOwl:hasDbXref "PMID:38898120") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38898120+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000225)
ClassAssertion(Annotation(rdfs:comment "The Blue Mountains Eye Study (BMES) is a population-based cohort study of common eye diseases and other health outcomes.") Annotation(oboInOwl:hasDbXref "PMID:16623958") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1524813/fullTextXML") coho:COHO_0000000 coho:COHO_0001061)
ClassAssertion(Annotation(rdfs:comment "The BoSCO study continuously recruits individuals from the general population through public announcements.") Annotation(oboInOwl:hasDbXref "PMID:40399555") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02100-w/MediaObjects/41588_2025_2100_MOESM3_ESM.xlsx") coho:COHO_0000000 coho:COHO_0000996)
ClassAssertion(Annotation(rdfs:comment "The Bogalusa Heart Study, a long-term population study with a continued relationship with a community, addresses the problem of capacity building in minority health research.") Annotation(oboInOwl:hasDbXref "PMID:11876192") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11876192+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000464)
ClassAssertion(Annotation(rdfs:comment "The Bone Mineral Density in Childhood Study is an ongoing longitudinal study in which measurements are obtained annually at five clinical centers in the United States.") Annotation(oboInOwl:hasDbXref "PMID:17311856") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17311856+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000898)
ClassAssertion(Annotation(rdfs:comment "The Born in Guangzhou Cohort Study (BIGCS) is a large-scale prospective observational study investigating the role of social, biological and environmental influences on pregnancy and child health and development in an urban setting in southern China.") Annotation(oboInOwl:hasDbXref "PMID:28321694") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28321694+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000624)
ClassAssertion(Annotation(rdfs:comment "The Botnia study is a family-based, observational familial study started in 1990 on the West coast of Finland aiming at identifying diabetes susceptibility genes (11).") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3636608/") coho:COHO_0000000 coho:COHO_0000703)
ClassAssertion(Annotation(rdfs:comment "The Brain Imaging Genetics (BIG) study was initiated in 2007 and comprises healthy volunteer subjects, including many university students, who participate in diverse imaging studies at the Donders Centre for Cognitive Neuroimaging (DCCN), Nijmegen, The Netherlands") Annotation(oboInOwl:hasDbXref "PMID:24734025") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3975119/") coho:COHO_0000000 coho:COHO_0000507)
ClassAssertion(Annotation(rdfs:comment "The Brains for Dementia Research (BDR) cohort and program was for planned brain donation across five UK brain banks and one donation point, with standardized operating procedures, following longitudinal clinical and psychometric assessments for people with no cognitive impairment as well as those with dementia.") Annotation(oboInOwl:hasDbXref "PMID:30452415") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6294579/fullTextXML") coho:COHO_0000000 coho:COHO_0001527)
ClassAssertion(Annotation(rdfs:comment "The Brazilian Immunogenetics of Asthma and Schistosomiasis (BIAS) study is a whole-population ascertainment designed study of asthma and schistosomiasis in the rural district of Conde, Bahia, located 200 km north of Salvador, Brazil [14-16].") Annotation(oboInOwl:hasDbXref "PMID:30787307") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001529)
ClassAssertion(Annotation(rdfs:comment "The Breast Cancer Collaborative Registry (BCCR) is a multicenter web-based system that efficiently collects and manages a variety of data on breast cancer (BC) patients and BC survivors.") Annotation(oboInOwl:hasDbXref "PMID:21918596") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3169352/fullTextXML") coho:COHO_0000000 coho:COHO_0001616)
ClassAssertion(Annotation(rdfs:comment "The Breast Cancer Environment and Employment Study (BCEES) is a large, population-based case–control study of women aged between 18 and 80 years") Annotation(oboInOwl:hasDbXref "PMID:35414113") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") coho:COHO_0000000 coho:COHO_0001059)
ClassAssertion(Annotation(rdfs:comment "The Breast Cancer in Northern Israel Study is a population-based case-control study in northern Israel of patients with breast cancer and age-, clinic-, and ethnic-group matched controls.") Annotation(oboInOwl:hasDbXref "PMID:20567021") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20567021+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001518)
ClassAssertion(Annotation(rdfs:comment "The Brisbane Twin Nevus Study recorded sun behaviours and counted naevi on annual new samples of 12-year-old twins (and siblings nearest in age) from 1992 to 2016.") Annotation(oboInOwl:hasDbXref "PMID:40576277") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40576277+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001550)
ClassAssertion(Annotation(rdfs:comment "The British Columbia Familial Hypercholesterolemia (BCFH) cohort is a prospective, longitudinal, open observational study of adults (≥18 years) with clinically diagnosed heterozygous familial hypercholesterolemia (FH) in the Canadian province of British Columbia, Canada.") Annotation(oboInOwl:hasDbXref "PMID:33079599") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7889287/supplementaryFiles") coho:COHO_0000000 coho:COHO_0001513)
ClassAssertion(Annotation(rdfs:comment "The Bruneck Study is a prospective, population‐based cohort study with a main focus on the epidemiology, pathophysiology, and prevention of atherosclerosis and CVD.") Annotation(oboInOwl:hasDbXref "PMID:32172649") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC7335516/") coho:COHO_0000000 coho:COHO_0000021)
ClassAssertion(Annotation(rdfs:comment "The Busselton Health Study (BHS) is the flagship program of BPMRI and one of the longest‑running population health research programs in the world.") Annotation(oboInOwl:hasDbXref "https://bpmri.org.au/about-us.html") coho:COHO_0000000 coho:COHO_0000389)
ClassAssertion(Annotation(rdfs:comment "The CAPUA (Lung Cancer in Asturias [Cáncer de Pulmón en Asturias], Spain) study is a hospital-based, case–control study conducted by the Molecular Epidemiology Cancer Unit at the University Institute of Oncology (University of Oviedo).") Annotation(oboInOwl:hasDbXref "PMID:23013535") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3518149/fullTextXML") coho:COHO_0000000 coho:COHO_0001567)
ClassAssertion(Annotation(rdfs:comment "The CARDIA study is a prospective, multi-center investigation of the natural history and etiology of cardiovascular disease in African Americans and whites 18-30 years of age at the time of initial examination.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5419579/supplementaryFiles") coho:COHO_0000000 coho:COHO_0000425)
ClassAssertion(Annotation(rdfs:comment "The CARTaGENE (CaG) study is both a population-based biobank and the largest ongoing prospective health study of men and women in Quebec.") Annotation(oboInOwl:hasDbXref "PMID:23071140") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23071140+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000031)
ClassAssertion(Annotation(rdfs:comment "The CATHeterization GENetics (CATHGEN) biorepository collected biospecimens and clinical data on individuals age ≥18 undergoing cardiac catheterization for concern of ischemic heart disease at a single center (Duke University Medical Center) from 2000-2010; a total of N=9334 individuals were collected.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") coho:COHO_0000000 coho:COHO_0000584)
ClassAssertion(Annotation(rdfs:comment "The CCPM Biobank is a dual-purpose research and clinical resource to accelerate genetic discovery and translation into clinical practice.") Annotation(oboInOwl:hasDbXref "PMID:38181729") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") coho:COHO_0000000 coho:COHO_0000482)
ClassAssertion(Annotation(rdfs:comment "The CHNS was designed as a prospective household-based study that includes multiple ages and cohorts across nine diverse provinces and eight rounds of surveys between 1989 and 2009.") Annotation(oboInOwl:hasDbXref "PMID:24341753") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3869031/") coho:COHO_0000000 coho:COHO_0000630)
ClassAssertion(Annotation(rdfs:comment "The CIMIC is a large community-based study, which recruited 86,428 participants aged ≥18 years by a 3-stage cluster random sampling method in 2007–2008.") Annotation(oboInOwl:hasDbXref "PMID:34327424") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8315380/fullTextXML") coho:COHO_0000000 coho:COHO_0001594)
ClassAssertion(Annotation(rdfs:comment "The CKC cohort is hospital-based and dynamic and was established in Zhengzhou, China; KC patients (n = 1114) from a large geographical area were enrolled from January 2019 to June 2023, with a mean age of 22.23 years (6‒57 years).") Annotation(oboInOwl:hasDbXref "PMID:38703249") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38703249+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001303)
ClassAssertion(Annotation(rdfs:comment "The CKiD Study is an ongoing cohort of children, adolescents, and young adults with a diagnosis of CKD in the United States and Canada with participants enrolled between ages 0.5 and 16 years starting in 2005.") Annotation(oboInOwl:hasDbXref "PMID:35518833") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC9062328/") coho:COHO_0000000 coho:COHO_0001304)
ClassAssertion(Annotation(rdfs:comment "The CLEAR Registry is a National Institute of Arthritis and Musculoskeletal and Skin Diseases-funded program which enrolls self-defined African Americans with RA as defined by the revised American Rheumatism Association (now the American College of Rheumatology [ACR]) criteria (19).") Annotation(oboInOwl:hasDbXref "PMID:20461784") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3052790/") coho:COHO_0000001 coho:COHO_0000043)
ClassAssertion(Annotation(rdfs:comment "The CLSA cohort is a national stratified sample of 51 338 women and men aged 45–85 years at the time of recruitment.") Annotation(oboInOwl:hasDbXref "PMID:31633757") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6929533/fullTextXML") coho:COHO_0000000 coho:COHO_0000380)
ClassAssertion(Annotation(rdfs:comment "The COLON study is a multi-centre prospective cohort study among at least 1,000 incident colorectal cancer patients recruited from 11 hospitals in the Netherlands.") Annotation(oboInOwl:hasDbXref "PMID:24886284") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4046039/fullTextXML") coho:COHO_0000000 coho:COHO_0001605)
ClassAssertion(Annotation(rdfs:comment "The COMBAT cohort is a longitudinal, community-based study in Tuvalu examining lifestyle behaviors, environmental exposures, and health outcomes.") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/COMBAT") coho:COHO_0000000 coho:COHO_0002665)
ClassAssertion(Annotation(rdfs:comment "The CONVERGE (China, Oxford and Virginia Commonwealth University Experimental Research on Genetic Epidemiology) consortium recruited 11,670 Han Chinese women through a collaboration involving 58 hospitals in China.") Annotation(oboInOwl:hasDbXref "PMID:26176920") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC4522619") coho:COHO_0000000 coho:COHO_0000185)
ClassAssertion(Annotation(rdfs:comment "The COPACETIC cohort included 1,226 Dutch participants from the NELSON lung cancer screening trial recruited by the University Medical Centers of Groningen and Utrecht [17].") Annotation(oboInOwl:hasDbXref "PMID:23349703") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3548843/fullTextXML") coho:COHO_0000000 coho:COHO_0001622)
ClassAssertion(Annotation(rdfs:comment "The CORNET consortium extended its genome-wide association meta-analysis for morning plasma cortisol from 12,597 to 25,314 subjects and from ~2.2M to ~7M SNPs, in 17 population-based cohorts of European ancestries.") Annotation(oboInOwl:hasDbXref "PMID:33469137") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8144017/fullTextXML") coho:COHO_0000001 coho:COHO_0001450)
ClassAssertion(Annotation(rdfs:comment "The CORSA trial (NCT04345315) enrolled 77 hematological patients from April to June 2021 who received at least one dose of vaccine (73 patients received Comirnaty and 4 received Spikevax).") Annotation(oboInOwl:hasDbXref "PMID:42245663") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13230124/fullTextXML") coho:COHO_0000000 coho:COHO_0000329)
ClassAssertion(Annotation(rdfs:comment "The CRCbiome study is a prospective cohort study nested within the BCSN trial, which is a pilot for a national screening program, organized by the Cancer Registry of Norway.") Annotation(oboInOwl:hasDbXref "PMID:34407780") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8371800/fullTextXML") coho:COHO_0000000 coho:COHO_0000239)
ClassAssertion(Annotation(rdfs:comment "The CROATIA-Korcula study, Croatia, is a family-based, cross-sectional study in the isolated island of Korcula that included 965 examinees aged 18-95.") Annotation(oboInOwl:hasDbXref "PMID:25010111") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4091794/supplementaryFiles") coho:COHO_0000000 coho:COHO_0000047)
ClassAssertion(Annotation(rdfs:comment "The CROATIA-Split study, Croatia, is a population-based, cross-sectional study in the Dalmatian City of Split that includes 1000 examinees aged 18-95.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs42003-020-0802-y/MediaObjects/42003_2020_802_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0000663)
ClassAssertion(Annotation(rdfs:comment "The CROATIA-Vis study, Croatia, is a population-based, cross-sectional study in the island of Vis including adult participants, aged 18–93 years (mean = 56)") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0000479)
ClassAssertion(Annotation(rdfs:comment "The CSDC is a harmonized collection of merged small datasets (comprising the existing datasets of BIOCARD, CHAP2, EAS, RMAYO, ROSMAP2, and WASHU2) used in common variant analyses to deal with small case and control counts within the individual studies.") Annotation(oboInOwl:hasDbXref "PMID:42237039") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-026-02583-1/MediaObjects/41588_2026_2583_MOESM1_ESM.pdf") coho:COHO_0000001 coho:COHO_0001070)
ClassAssertion(Annotation(rdfs:comment "The CTS is a prospective study of 133,479 California female teachers and administrators, established in 1995-1996 with members of the California State Teachers Retirement System completing a detailed mailed questionnaire regarding possible risk factors for breast and other cancers.") Annotation(oboInOwl:hasDbXref "PMID:12296510") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12296510+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001636)
ClassAssertion(Annotation(rdfs:comment "The CURES is an ongoing large prospective multicenter registry, which was originally initiated in January 2009 via enrolling suspected or confirmed PE or PE with DVT (deep venous thrombosis) patients and assessed their in-hospital outcomes.") Annotation(oboInOwl:hasDbXref "PMID:32522676") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32522676+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001639)
ClassAssertion(Annotation(rdfs:comment "The Cambridgeshire Parkinson’s Incidence from GP to Neurologist (CamPaIGN) study is an observational, longitudinal study of incident PD patients in the county of Cambridgeshire, UK55,56.") Annotation(oboInOwl:hasDbXref "PMID:38849413") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11161485/fullTextXML") coho:COHO_0000000 coho:COHO_0001294)
ClassAssertion(Annotation(rdfs:comment "The Cambridgeshire case-control study is a population-based study of T2D cases, aged 45–76 y, and age- and sex-matched controls.") Annotation(oboInOwl:hasDbXref "PMID:22039354") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3201934/fullTextXML") coho:COHO_0000000 coho:COHO_0001575)
ClassAssertion(Annotation(rdfs:comment "The Cameron County Hispanic Cohort (CCHC) is a community-based cohort study initiated in 2004 of Mexican Americans in Brownsville, Texas.") Annotation(oboInOwl:hasDbXref "PMID:39885687") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11875162/fullTextXML") coho:COHO_0000000 coho:COHO_0000517)
ClassAssertion(Annotation(rdfs:comment "The Canadian Airways Research (CARE) group is an ongoing Canada-wide prospective cohort study of clinical, molecular, cellular, and genetic factors underlying the factors determining the pathogenesis and treatment response of subglottic stenosis (SGS).") Annotation(oboInOwl:hasDbXref "PMID:40048847") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11924928/fullTextXML") coho:COHO_0000000 coho:COHO_0000229)
ClassAssertion(Annotation(rdfs:comment "The Canadian CF Modifier Study population consists of 2,441 patients diagnosed with CF between 1951 and 2006 and 3,092 parents.") Annotation(oboInOwl:hasDbXref "PMID:18292811") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2248329/") coho:COHO_0000000 coho:COHO_0001301)
ClassAssertion(Annotation(rdfs:comment "The Canadian Healthy Infant Longitudinal Development (CHILD) birth cohort study recruited 3624 pregnant women, most partners and 3542 eligible offspring.") Annotation(oboInOwl:hasDbXref "PMID:26069286") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26069286+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000234)
ClassAssertion(Annotation(rdfs:comment "The Canadian Multicentre Osteoporosis Study (CaMos) is a prospective cohort study which will measure the incidence and prevalence of osteoporosis and fractures, and the effect of putative risk factors, in a random sample of 10,061 women and men aged > or = 25 years recruited in approximately equal numbers in nine centers across Canada.") Annotation(oboInOwl:hasDbXref "PMID:11199195") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11199195+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000973)
ClassAssertion(Annotation(rdfs:comment "The Canadian population sample used for panel D consisted of 762 psoriasis patients and 994 controls, sampled from the Québec founder population (QFP).") Annotation(oboInOwl:hasDbXref "PMID:20953188") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3136364/unicode") coho:COHO_0000000 coho:COHO_0001174)
ClassAssertion(Annotation(rdfs:comment "The Cancer Prevention Study II (CPS-II), which began in 1982, is a prospective mortality study of approximately 1.2 million American men and women.") Annotation(oboInOwl:hasDbXref "https://www.cancer.org/research/population-science/pop-sci/prevention-studies/cps-2.html") coho:COHO_0000000 coho:COHO_0000024)
ClassAssertion(Annotation(rdfs:comment "The Cancer de Mama (CAMA) study is a population-based case-control study of breast cancer in Mexico City, Monterrey, and Veracruz, Mexico.") Annotation(oboInOwl:hasDbXref "PMID:31553449") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7301155/supplementaryFiles") coho:COHO_0000000 coho:COHO_0001561)
ClassAssertion(Annotation(rdfs:comment "The Cardiogenics Study is a European collaboration on genetics of coronary artery disease.14 This initiative recruited 918 participants (459 patients with myocardial infarction and 459 normal controls) in five centres: Cambridge (UK), Leicester (UK), Lübeck (Germany), Regensburg (Germany), and Paris (France).14") Annotation(oboInOwl:hasDbXref "PMID:22325189") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3314981/fullTextXML") coho:COHO_0000000 coho:COHO_0000028)
ClassAssertion(Annotation(rdfs:comment "The Cardiovascular Health Study (CHS) is a population-based, longitudinal study of coronary heart disease and stroke in adults aged 65 years and older.") Annotation(oboInOwl:hasDbXref "PMID:1669507") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1669507+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000384)
ClassAssertion(Annotation(rdfs:comment "The Cardiovascular Research Centre Biobank collects samples and associated clinical data from adult and paediatric patients attending Royal Brompton & Harefield NHS Trust for investigation or treatment of cardiovascular conditions.") Annotation(oboInOwl:hasDbXref "https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/royal-brompton-harefield-cardiovascular-research-centre-biobank/") coho:COHO_0000000 coho:COHO_0001032)
ClassAssertion(Annotation(rdfs:comment "The Cardiovascular and Metabolic Patient (CAMP) cohort is composed of 3,756 individuals who underwent assessment of demographic data, past medical history, including medications, and a single resting ECG measurement.") Annotation(oboInOwl:hasDbXref "PMID:28986454") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5679734/unicode") coho:COHO_0000000 coho:COHO_0002061)
ClassAssertion(Annotation(rdfs:comment "The Carolina Head and Neck Cancer Epidemiology (CHANCE) Study is a population-based case-control study of head and neck SCC carried out among 46 counties in central and eastern North Carolina (15).") Annotation(oboInOwl:hasDbXref "PMID:22575416") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3372316/") coho:COHO_0000000 coho:COHO_0000030)
ClassAssertion(Annotation(rdfs:comment "The Carotene and Retinol Efficacy Trial (CARET) was a randomized, double-blind, placebo-controlled trial of the cancer prevention efficacy and safety of a daily combination of 30 mg of beta-carotene and 25,000 IU of retinyl palmitate in 18,314 persons at high risk for lung cancer.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001571)
ClassAssertion(Annotation(rdfs:comment "The Case-Control and Enriched Case Study spans 24 cohorts provided by the Alzheimer’s Disease Genetics Consortium (ADGC) and the Cohorts for Heart and Aging Research in Genomic Epidemiology (CHARGE) Consortium.") Annotation(oboInOwl:hasDbXref "https://dss.niagads.org/studies/sa000001/") coho:COHO_0000001 coho:COHO_0000561)
ClassAssertion(Annotation(rdfs:comment "The Celiac Disease Northern Netherlands cohort (CeDNN, currently unpublished) comprises 128 CeD patients and 106 controls who provided fecal samples at project onset, with complete metadata including age and sex.") Annotation(oboInOwl:hasDbXref "PMID:40289251") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12036492/fullTextXML") coho:COHO_0000000 coho:COHO_0000232)
ClassAssertion(Annotation(rdfs:comment "The Center for HIV/AIDS Vaccine Immunology (CHAVI) is a consortium of universities and academic medical centers that was established by the National Institute of Allergy and Infectious Diseases (NIAID) from 2005-2012.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-023-06370-4/MediaObjects/41586_2023_6370_MOESM1_ESM.pdf") coho:COHO_0000001 coho:COHO_0001302)
ClassAssertion(Annotation(rdfs:comment "The Central European Longitudinal Studies of Parents and Children: The Next Generation (CELSPAC: TNG) study is designed as a new prospective birth cohort which will follow up on 2,000 children from their prenatal period to adolescence with the aim of assessing exposome factors affecting children’s health32.") Annotation(oboInOwl:hasDbXref "PMID:39107353") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11303690/fullTextXML") coho:COHO_0000000 coho:COHO_0002632)
ClassAssertion(Annotation(rdfs:comment "The Cervical Screening Cohort enrols women screened for human papillomavirus (HPV) and cervical abnormalities within the capital region of Sweden from the organised screening program and the non-organised testing of cervical samples.") Annotation(oboInOwl:hasDbXref "PMID:38926412") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11208431/fullTextXML") coho:COHO_0000000 coho:COHO_0002599)
ClassAssertion(Annotation(rdfs:comment "The Child and Adolescent Twin Study in Sweden (CATSS) is an ongoing longitudinal twin study targeting all twins born in Sweden since July 1, 1992.") Annotation(oboInOwl:hasDbXref "PMID:22506305") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22506305+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000633)
ClassAssertion(Annotation(rdfs:comment "The Childhood Asthma Management Program (CAMP) is a multicenter, randomized, double-masked clinical trial designed to determine the long-term effects of three inhaled treatments for mild to moderate childhood asthma:") Annotation(oboInOwl:hasDbXref "PMID:10027502") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10027502+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000998)
ClassAssertion(Annotation(rdfs:comment "The Childhood Cancer Survivor Study is a multi-institutional retrospective cohort study with longitudinal follow-up of five year survivors of the most common childhood cancers") Annotation(oboInOwl:hasDbXref "PMID:31941657") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7190022/fullTextXML") coho:COHO_0000000 coho:COHO_0001155)
ClassAssertion(Annotation(rdfs:comment "The Children’s Health Study (CHS) is a continuing series of longitudinal studies that first began in 1993 and has focused on demonstrating the chronic impacts of air pollution on respiratory illnesses from early childhood through adolescence.") Annotation(oboInOwl:hasDbXref "PMID:25694817") Annotation(oboInOwl:hasDbXref "https://jtd.amegroups.org/article/view/3694/4220") coho:COHO_0000000 coho:COHO_0001592)
ClassAssertion(Annotation(rdfs:comment "The China Health and Retirement Longitudinal Study (CHARLS) is a nationally representative longitudinal survey of persons in China 45 years of age or older and their spouses, including assessments of social, economic, and health circumstances of community-residents.") Annotation(oboInOwl:hasDbXref "PMID:23243115") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23243115+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002661)
ClassAssertion(Annotation(rdfs:comment "The China Kadoorie Biobank (CKB) is a population-based prospective cohort of >512,000 adults recruited from 2004 to 2008 from 10 geographically diverse regions across China.") Annotation(oboInOwl:hasDbXref "PMID:37601966") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37601966+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000422)
ClassAssertion(Annotation(rdfs:comment "The China MUCA 1998 cohort was established in 1998 with cluster random sampling and included about 500 men and 500 women aged 35 to 59 years in each of the 15 clusters.[17]") Annotation(oboInOwl:hasDbXref "PMID:32433046") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7249710/fullTextXML") coho:COHO_0000000 coho:COHO_0001588)
ClassAssertion(Annotation(rdfs:comment "The Chinese Imaging Genetics (CHIMGEN) study establishes the largest Chinese neuroimaging genetics cohort and aims to identify genetic and environmental factors and their interactions that are associated with neuroimaging and behavioral phenotypes.") Annotation(oboInOwl:hasDbXref "PMID:31827248") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31827248+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000372)
ClassAssertion(Annotation(rdfs:comment "The Chinese National Twin Registry is the first and largest population-based twin registry in China.") Annotation(oboInOwl:hasDbXref "PMID:17254402") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17254402+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000933)
ClassAssertion(Annotation(rdfs:comment "The Chingford study was a population-based prospective cohort study that aimed to assess musculoskeletal disease in the female population.") Annotation(oboInOwl:hasDbXref "PMID:38637130") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11029301/fullTextXML") coho:COHO_0000000 coho:COHO_0001589)
ClassAssertion(Annotation(rdfs:comment "The Chronic Lymphocytic Leukemia (CLL) Genome Project aims to identify genetic alterations involved in the development and progression of the CLL, which are still unknown, with the objective of generating a comprehensive catalogue of genetic alterations in 500 independent tumours.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00000000092") coho:COHO_0000000 coho:COHO_0000101)
ClassAssertion(Annotation(rdfs:comment "The Chronic Renal Insufficiency Cohort (CRIC) Study is a multicenter observational cohort study that enrolled 5499 adults from 7 clinical centers across the US.") Annotation(oboInOwl:hasDbXref "PMID:35175342") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8855239/fullTextXML") coho:COHO_0000000 coho:COHO_0000397)
ClassAssertion(Annotation(rdfs:comment "The Cleveland Clinic Atrial Fibrillation Study consists of clinical and genetic data of patients with atrial fibrillation and control cohorts from the Cleveland Clinic CV/Arrhythmia Biobank, including the Cleveland Clinic Lone Atrial Fibrillation GeneBank.") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001189.v5.p1") coho:COHO_0000000 coho:COHO_0001066)
ClassAssertion(Annotation(rdfs:comment "The Cleveland Clinic GeneBank study is a single site sample repository generated from consecutive patients undergoing elective diagnostic coronary angiography or elective cardiac computed tomographic angiography with extensive clinical and laboratory characterization and longitudinal observation.") Annotation(oboInOwl:hasDbXref "PMID:26822151") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4740183/fullTextXML") coho:COHO_0000000 coho:COHO_0001576)
ClassAssertion(Annotation(rdfs:comment "The Cleveland Clinic cases were enroled among consecutive patients seen at a dedicated FMD referral clinic.") Annotation(oboInOwl:hasDbXref "PMID:34654805") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8521585/fullTextXML") coho:COHO_0000000 coho:COHO_0001577)
ClassAssertion(Annotation(rdfs:comment "The Collaborative AtoRvastatin Diabetes Study (CARDS) is a multicentre, randomized, placebo-controlled, double-blind clinical trial of primary prevention of cardiovascular disease in patients with Type 2 diabetes.") Annotation(oboInOwl:hasDbXref "PMID:11918622") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11918622+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001568)
ClassAssertion(Annotation(rdfs:comment "The Collaborative European NeuroTrauma Effectiveness Research in TBI (CENTER-TBI, registered at clinicaltrials.gov NCT02210221) study is a prospective cohort study conducted in 63 centers from 18 countries across Europe and Israel between December 2014 and December 2017.") Annotation(oboInOwl:hasDbXref "PMID:34351445") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8486724/fullTextXML") coho:COHO_0000000 coho:COHO_0001156)
ClassAssertion(Annotation(rdfs:comment "The Colorado Learning Disabilities Research Center (CLDRC) or Colorado RD cohort consists of 1,188 individuals within 292 families of twin pairs and their siblings.") Annotation(oboInOwl:hasDbXref "PMID:24509779") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4053598/fullTextXML") coho:COHO_0000000 coho:COHO_0000704)
ClassAssertion(Annotation(rdfs:comment "The Colorectal cancer Study of Austria (CORSA), an ongoing multicenter prospective case‒control study, was initiated to discover prognostic as well as diagnostic biomarkers for colorectal cancer (CRC) risk prediction") Annotation(oboInOwl:hasDbXref "PMID:34439954") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC8389216/") coho:COHO_0000000 coho:COHO_0000042)
ClassAssertion(Annotation(rdfs:comment "The Columbia COVID-19 Biobank recruited consecutive COVID-19 cases (positive result from nasopharyngeal SARS-CoV-2 polymerase chain reaction test), regardless of age, sex, or race/ethnicity who received care at the Columbia University Irving Medical Center.") Annotation(oboInOwl:hasDbXref "PMID:34642645") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8497954/fullTextXML") coho:COHO_0000000 coho:COHO_0001071)
ClassAssertion(Annotation(rdfs:comment "The Cooperative Health Research In South Tyrol (CHRIS) study is a population-based study with a longitudinal lookout to investigate the genetic and molecular basis of age-related common chronic conditions and their interaction with life style and environment in the general population.") Annotation(oboInOwl:hasDbXref "PMID:26541195") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26541195+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000203)
ClassAssertion(Annotation(rdfs:comment "The Copenhagen Cardiovascular Genetic study (COGEN) is a biobank that has collected superfluous whole blood from patients admitted to six cardiology departments in the Capital region of Copenhagen from 2010–2017.") Annotation(oboInOwl:hasDbXref "PMID:30726294") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6364925/fullTextXML") coho:COHO_0000000 coho:COHO_0001602)
ClassAssertion(Annotation(rdfs:comment "The Copenhagen General Population Study is a contemporary population-based cohort study initiated in 2003 with ongoing enrolment [10].") Annotation(oboInOwl:hasDbXref "PMID:36891075") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9986766/fullTextXML") coho:COHO_0000000 coho:COHO_0001587)
ClassAssertion(Annotation(rdfs:comment "The Copenhagen Hospital Biobank is a research biobank, which started in 2009 at Copenhagen University Hospital (Rigshospitalet) and expanded in 2012 to include all hospitals in the Capital Region of Denmark.") Annotation(oboInOwl:hasDbXref "PMID:36852012") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9960719/fullTextXML") coho:COHO_0000000 coho:COHO_0000046)
ClassAssertion(Annotation(rdfs:comment "The Copenhagen Prospective Study on Asthma in Childhood is a single-center, birth cohort study of children of asthmatic mothers.") Annotation(oboInOwl:hasDbXref "PMID:15521375") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15521375+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000639)
ClassAssertion(Annotation(rdfs:comment "The Copenhagen Prostate Cancer Study 1 included 872 unselected patients recruited with prostate cancer between 2008-2011 from Herlev Hospital, Copenhagen University Hospital, Herlev, Denmark.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2560/MediaObjects/41588_2013_BFng2560_MOESM4_ESM.pdf") coho:COHO_0000000 coho:COHO_0001628)
ClassAssertion(Annotation(rdfs:comment "The Cystic Fibrosis Twin and Sibling Study (CF TSS) is based at Johns Hopkins and began enrolling subjects with CF who had at least one affected living sibling in 2000.14") Annotation(oboInOwl:hasDbXref "PMID:35647563") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9136666/supplementaryFiles") coho:COHO_0000000 coho:COHO_0001158)
ClassAssertion(Annotation(rdfs:comment "The Czech cohort comprised 718 CRC cases and 646 controls collected at several oncology departments in the Czech Republic between September 2003 and December 2016.") Annotation(oboInOwl:hasDbXref "PMID:35807897") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9268344/fullTextXML") coho:COHO_0000000 coho:COHO_0000821)
ClassAssertion(Annotation(rdfs:comment "The DB Cohort study, started in 2011, is a multicenter case–control study in the Netherlands, investigating genetic and phenotypic information of patients with BD type I, first-degree relatives, and controls.") Annotation(oboInOwl:hasDbXref "PMID:31748521") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6868237/fullTextXML") coho:COHO_0000000 coho:COHO_0002480)
ClassAssertion(Annotation(rdfs:comment "The DBBR is a state-of-the-art blood collection, processing, and banking laboratory which procures bio specimens from Roswell Park patients and nonpatients as healthy controls and collects extensive sample and clinical annotation data, as well as epidemiological survey information.") Annotation(oboInOwl:hasDbXref "PMID:22969801") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3433139/fullTextXML") coho:COHO_0000000 coho:COHO_0002330)
ClassAssertion(Annotation(rdfs:comment "The DBDS is an ongoing, national prospective cohort of blood donors.") Annotation(oboInOwl:hasDbXref "PMID:36194120") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10244044/fullTextXML") coho:COHO_0000000 coho:COHO_0000475)
ClassAssertion(Annotation(rdfs:comment "The DCHS is a population-based birth cohort study in the Drakenstein area in Paarl, a peri-urban area, 60 km outside Cape Town, South Africa.") Annotation(oboInOwl:hasDbXref "PMID:25228292") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5107608/fullTextXML") coho:COHO_0000000 coho:COHO_0001311)
ClassAssertion(Annotation(rdfs:comment "The DGI Study material consisting of 2,931 individuals from Finland and Sweden (1,464 patients with type 2 diabetes and 1,467 nondiabetic control subjects) was ascertained as previously described (1,11,12).") Annotation(oboInOwl:hasDbXref "PMID:18678614") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2570409/fullTextXML") coho:COHO_0000000 coho:COHO_0001001)
ClassAssertion(Annotation(rdfs:comment "The DIAMANTE (DIAbetes Meta-ANalysis of Trans-Ethnic association studies) Consortium was established to assemble T2D GWAS across diverse ancestry groups.") Annotation(oboInOwl:hasDbXref "PMID:35551307") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9179018/fullTextXML") coho:COHO_0000001 coho:COHO_0001002)
ClassAssertion(Annotation(rdfs:comment "The DISCOVeRY-BMT study population was contributed by 151 centers in the United States to the Center for International Blood and Marrow Transplant Research (CIBMTR) and consists of two cohorts of ALL, AML and MDS patients and their healthy ≥8/8 HLA-matched URDs described previously [5], [6], [7], [8], [9], [10], [11].") Annotation(oboInOwl:hasDbXref "PMID:34746714") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8548922/fullTextXML") coho:COHO_0000000 coho:COHO_0000642)
ClassAssertion(Annotation(rdfs:comment "The DNBC is a collection of data on 92,274 pregnant women recruited between 1996 and 2002, from their first antenatal visit to their general practitioner.") Annotation(oboInOwl:hasDbXref "PMID:37012456") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01343-9/MediaObjects/41588_2023_1343_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0000748)
ClassAssertion(Annotation(rdfs:comment "The DPP has successfully randomized a large cohort of participants with a wide distribution of age, obesity, and ethnic and racial backgrounds who are at high risk for developing type 2 diabetes.") Annotation(oboInOwl:hasDbXref "PMID:11092283") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC1360735/") coho:COHO_0000000 coho:COHO_0000051)
ClassAssertion(Annotation(rdfs:comment "The DPS is a clinical trial with five participating centers (Helsinki, Kuopio, Turku, Tampere, and Oulu) in Finland (NCT00518167).") Annotation(oboInOwl:hasDbXref "PMID:20980412") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3024360/fullTextXML") coho:COHO_0000000 coho:COHO_0001075)
ClassAssertion(Annotation(rdfs:comment "The DPUK collection of independent cohorts can facilitate research in neurodegeneration by combining their genetic and phenotypic data.") Annotation(oboInOwl:hasDbXref "PMID:38506636") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38506636+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000001 coho:COHO_0002679)
ClassAssertion(Annotation(rdfs:comment "The DREAM (Diabetes Reduction Assessment with Ramipril and Rosiglitazone Medication) trial is a large, international, multi-centre, randomised and double-blind controlled trial designed to determine whether treatment with ramipril and/or rosiglitazone prevents diabetes or reduces the number of new cases of diabetes in 5269 individuals with IGT or IFG.") Annotation(oboInOwl:hasDbXref "PMID:15322749") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1007/s00125-004-1485-5") coho:COHO_0000000 coho:COHO_0000052)
ClassAssertion(Annotation(rdfs:comment "The Dallas Heart Study (DHS) is a multiethnic population-based probability sample of Dallas County residents, weighted to include 50% African-American and 50% non-African-American participants.") Annotation(oboInOwl:hasDbXref "PMID:24531328") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3969786/unicode") coho:COHO_0000000 coho:COHO_0001309)
ClassAssertion(Annotation(rdfs:comment "The DanFunD cohort is anchored at the Research Centre for Prevention and Health (RCPH), Glostrup, Denmark and is a random sample of the general adult population.") Annotation(oboInOwl:hasDbXref "PMID:28275316") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5333638/fullTextXML") coho:COHO_0000000 coho:COHO_0001645)
ClassAssertion(Annotation(rdfs:comment "The Danish General Suburban Population Study was a cross-sectional study of subjects aged > 20 years living in Næstved municipality, Denmark, which recruited 21,205 adults between 2010 and 2013.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02410-z/MediaObjects/41588_2025_2410_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001798)
ClassAssertion(Annotation(rdfs:comment "The Danish National Patient Registry (DNPR) is one of the world’s oldest nationwide hospital registries and is used extensively for research.") Annotation(oboInOwl:hasDbXref "PMID:26604824") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4655913/fullTextXML") coho:COHO_0000000 coho:COHO_0001608)
ClassAssertion(Annotation(rdfs:comment "The Danish Osteoporosis Prevention Study is a prospective investigator initiated multicentre trial evaluating the effect of hormone replacement therapy as primary prevention of osteoporotic fractures.") Annotation(oboInOwl:hasDbXref "PMID:23048011") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1136/bmj.e6409") coho:COHO_0000000 coho:COHO_0001611)
ClassAssertion(Annotation(rdfs:comment "The Danish Testicular Cancer Late Treatment Effects Cohort is a nationwide and population-based cohort and is located at the Department of Oncology, Rigshospitalet, Copenhagen University Hospital, Denmark.") Annotation(oboInOwl:hasDbXref "PMID:29515973") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5826343/fullTextXML") coho:COHO_0000000 coho:COHO_0001310)
ClassAssertion(Annotation(rdfs:comment "The DeCC is a case–control study that recruited individuals from three UK sites (London, Cardiff and Birmingham).") Annotation(oboInOwl:hasDbXref "PMID:28642257") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5537566/") coho:COHO_0000000 coho:COHO_0001653)
ClassAssertion(Annotation(rdfs:comment "The Dementia Genetic Spanish Consortium (DEGESCO) is a national consortium comprising 23 research centers and hospitals across the country, that holds the institutional coverage of The Network Center for Biomedical Research in Neurodegenerative Diseases (CIBERNED).") Annotation(oboInOwl:hasDbXref "PMID:42237039") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/supplementaryFiles") coho:COHO_0000001 coho:COHO_0001046)
ClassAssertion(Annotation(rdfs:comment "The DiaGene study is a multi-centre, prospective, extensively phenotyped type 2 diabetes cohort study with concurrent inclusion of diabetes-free individuals at baseline as controls in the city of Eindhoven, The Netherlands.") Annotation(oboInOwl:hasDbXref "PMID:28649285") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5477157/fullTextXML") coho:COHO_0000000 coho:COHO_0000943)
ClassAssertion(Annotation(rdfs:comment "The Diabetes Case Control study is a study of individuals with diabetes recruited from a tertiary hospital in Durban (n = 1,542).") Annotation(oboInOwl:hasDbXref "PMID:31675503") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7202134/unicode") coho:COHO_0000000 coho:COHO_0000218)
ClassAssertion(Annotation(rdfs:comment "The Diabetes Heart Study (DHS) is a community-based study of the genetic and epidemiological contributions to diabetic heart disease in which siblings concordant for type 2 diabetes mellitus (T2DM), as well as unaffected family members, were recruited from internal medicine and endocrinology clinics in western North Carolina.") Annotation(oboInOwl:hasDbXref "PMID:23230101") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3609509/fullTextXML") coho:COHO_0000000 coho:COHO_0000460)
ClassAssertion(Annotation(rdfs:comment "The DietBB sample included in this GWAS is a subsample extracted from the AgeCoDe cohort in the context of an ongoing genome-wide methylation analysis for dementia.") Annotation(oboInOwl:hasDbXref "PMID:42237039") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-026-02583-1/MediaObjects/41588_2026_2583_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001073)
ClassAssertion(Annotation(rdfs:comment "The DoD-ADNI is a multi-site extension of ADNI designed to investigate the effects of TBI and PTSD on AD-related pathology in Vietnam-era Veterans") Annotation(oboInOwl:hasDbXref "PMID:42316769") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13311454/fullTextXML") coho:COHO_0000000 coho:COHO_0000992)
ClassAssertion(Annotation(rdfs:comment "The Dongfeng-Tongji (DFTJ) cohort study is an ongoing prospective cohort, and detailed information has been described elsewhere [14].") Annotation(oboInOwl:hasDbXref "PMID:37960242") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC10650607/") coho:COHO_0000000 coho:COHO_0001664)
ClassAssertion(Annotation(rdfs:comment "The Donor InSight-III (DIS-III, 2015-2016) is the second follow-up of an observational cohort study conducted among blood and plasma donors in the Netherlands aimed to gain insight into characteristics, health and behavior of donors3 .") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs42003-020-01430-1/MediaObjects/42003_2020_1430_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0000243)
ClassAssertion(Annotation(rdfs:comment "The Dose-Responses to Exercise Training (DR's EXTRA) study is a 4-y RCT on the health effects of regular physical exercise and a healthy diet in a population-based random sample of Finnish men and women aged 55–74 y living in the city of Kuopio in 2002 (see Supplemental Figure 1).") Annotation(oboInOwl:hasDbXref "PMID:33742194") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML") coho:COHO_0000000 coho:COHO_0000493)
ClassAssertion(Annotation(rdfs:comment "The Drug Interaction With Genes in Parkinson's Disease (DIGPD) study is an ongoing longitudinal cohort study of patients with PD consecutively recruited from May 2009 to July 2013 in 4 French university hospitals and 4 general hospitals.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC6059034/") coho:COHO_0000000 coho:COHO_0000677)
ClassAssertion(Annotation(rdfs:comment "The Dunedin Multidisciplinary Health and Development Study (hereafter the Dunedin Study) is an ongoing longitudinal investigation of health and behaviour of a complete birth cohort") Annotation(oboInOwl:hasDbXref "PMID:25835958") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4412685/fullTextXML") coho:COHO_0000000 coho:COHO_0001162)
ClassAssertion(Annotation(rdfs:comment "The Durban Diabetes Study (DDS) is a population-based cross-sectional survey of an urban black population in the eThekwini Municipality (city of Durban) in South Africa.") Annotation(oboInOwl:hasDbXref "PMID:29276614") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC5732575") coho:COHO_0000000 coho:COHO_0000057)
ClassAssertion(Annotation(rdfs:comment "The Dutch Asthma GWAS (DAG) cohort consists of in total 915 asthma cases and 986 controls, allfromthenorthernoftheNetherlands.TheDAGcohortwasgenotypedintwophasesandmeta‐analysed afterwards.") Annotation(oboInOwl:hasDbXref "PMID:29273806") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001643)
ClassAssertion(Annotation(rdfs:comment "The Dutch RCC series (N=748) consists of a population-based series (N=417) and a hospital-based series (N=331)50 .") Annotation(oboInOwl:hasDbXref "PMID:21131975") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.723/MediaObjects/41588_2011_BFng723_MOESM3_ESM.pdf") coho:COHO_0000000 coho:COHO_0001673)
ClassAssertion(Annotation(rdfs:comment "The Dutch component of the BLOODOMICS collaboration comprises of cases drawn from the Academic Medical Centre Amsterdam Premature Atherosclerosis Study (AMC-PAS) and the AGNES study, with controls ascertained from the Sanquin Common Controls (SANQUIN-CC) study.") Annotation(oboInOwl:hasDbXref "PMID:21966275") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3178591/supplementaryFiles") coho:COHO_0000001 coho:COHO_0001538)
ClassAssertion(Annotation(rdfs:comment "The Dutch famine birth cohort study is a historical birth cohort of men and women born around the time of the 1944–1945 Dutch famine in the Wilhelmina Gasthuis (WG) in Amsterdam, the Netherlands.") Annotation(oboInOwl:hasDbXref "PMID:33664071") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7934722/fullTextXML") coho:COHO_0000000 coho:COHO_0002600)
ClassAssertion(Annotation(rdfs:comment "The Dutch series consists of 3 groups: population controls, patients with urinary bladder cancer, and patients with lung cancer.") Annotation(oboInOwl:hasDbXref "PMID:20418888") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.573/MediaObjects/41588_2010_BFng573_MOESM34_ESM.pdf") coho:COHO_0000001 coho:COHO_0002164)
ClassAssertion(Annotation(rdfs:comment "The EAST-AFNET4 trial was a multi-centre investigator-initiated, parallel-group, open, blinded-outcome-assessment trial.") Annotation(oboInOwl:hasDbXref "PMID:37264683") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10405565/fullTextXML") coho:COHO_0000000 coho:COHO_0001477)
ClassAssertion(Annotation(rdfs:comment "The ECUAVIDA cohort is a prospective cohort study from birth, designed to investigate the effects of pre- and postnatal exposures to STH parasites on the development of atopy and allergic diseases to 8 years of age.") Annotation(oboInOwl:hasDbXref "PMID:24990475") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4681103/fullTextXML") coho:COHO_0000000 coho:COHO_0002659)
ClassAssertion(Annotation(rdfs:comment "The EDC study is a prospective cohort study of 933 participants with childhood-onset (aged <17 years) type 1 diabetes diagnosed at Children’s Hospital of Pittsburgh from 1950 to 1980.") Annotation(oboInOwl:hasDbXref "PMID:22851572") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3478551/fullTextXML") coho:COHO_0000000 coho:COHO_0001318)
ClassAssertion(Annotation(rdfs:comment "The EDEN study is a French bicentric generalist cohort study (Heude et al. IJE 2016).") Annotation(oboInOwl:hasDbXref "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/EDEN") coho:COHO_0000000 coho:COHO_0000252)
ClassAssertion(Annotation(rdfs:comment "The ENGELA study is a French multicenter hospital-based case-control study that was conducted in the main hospitals of Bordeaux, Brest, Caen, Nantes, Lille and Toulouse from September 2000 to December 2004 in order to investigate for environmental, infectious and genetics risk factors for LN.") Annotation(oboInOwl:hasDbXref "PMID:19058175") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2760125/") coho:COHO_0000000 coho:COHO_0001689)
ClassAssertion(Annotation(rdfs:comment "The EPIC Obesity study comprises a representative sample (n = 2,566) nested within the EPIC-Norfolk Study, a population-based cohort study of 25,663 men and women of European descent aged 39–79 y recruited in Norfolk, UK between 1993 and 1997.") Annotation(oboInOwl:hasDbXref "PMID:18454148") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2669167/unicode") coho:COHO_0000000 coho:COHO_0001693)
ClassAssertion(Annotation(rdfs:comment "The EPIC-InterAct study is a prospective case-cohort study, nested within the European EPIC study.") Annotation(oboInOwl:hasDbXref "PMID:32641421") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7341350/fullTextXML") coho:COHO_0000000 coho:COHO_0000587)
ClassAssertion(Annotation(rdfs:comment "The EPIC-OBS is an ongoing prospective, observational cohort study.") Annotation(oboInOwl:hasDbXref "PMID:19470318") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2783320/") coho:COHO_0000000 coho:COHO_0001166)
ClassAssertion(Annotation(rdfs:comment "The EPICOLON Consortium comprises a prospective, multicentre and population-based epidemiology survey of the incidence and features of CRC in the Spanish population23 .") Annotation(oboInOwl:hasDbXref "PMID:30510241") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0286-6/MediaObjects/41588_2018_286_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001694)
ClassAssertion(Annotation(rdfs:comment "The EPIDG cohort has a total of 230 Mediterranean (South European) pregnant women who attended the Unit of Diabetes and Pregnancy at University Hospital Virgen de la Victoria, Málaga, Spain.") Annotation(oboInOwl:hasDbXref "PMID:38350951") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10865541/fullTextXML") coho:COHO_0000000 coho:COHO_0000728)
ClassAssertion(Annotation(rdfs:comment "The ERSPC is a multi-center, randomized screening trial with the main goal to compare PCa mortality between an intervention arm invited to screening and a control arm with no intervention offered.") Annotation(oboInOwl:hasDbXref "PMID:25108889") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4427906/") coho:COHO_0000000 coho:COHO_0001705)
ClassAssertion(Annotation(rdfs:comment "The Early Language in Victoria Study (ELVS) recruited 1910 8-month-olds in Melbourne in 2003-2004.") Annotation(oboInOwl:hasDbXref "PMID:41237490") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41237490+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000707)
ClassAssertion(Annotation(rdfs:comment "The Early Onset Venous Thrombosis (EOVT) study was a case-control sample of 339 patients with VTE and 1327 healthy French persons from the Suvimax study.28") Annotation(oboInOwl:hasDbXref "PMID:37399490") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10506044/fullTextXML") coho:COHO_0000000 coho:COHO_0001079)
ClassAssertion(Annotation(rdfs:comment "The Edinburgh Artery Study (EAS) is an age-stratified random sample of men and women, aged 55-74 years, which was selected between August 1987 and September 1988 from the age-sex registers of ten general practices with a geographical and socio-economical catchment population spread throughout the city of Edinburgh, UK.") Annotation(oboInOwl:hasDbXref "PMID:25979724") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5841831/supplementaryFiles") coho:COHO_0000000 coho:COHO_0001677)
ClassAssertion(Annotation(rdfs:comment "The Edinburgh Osteoporosis Study (EDOS) consists of a clinical referral population of patients assessed for evaluation of osteoporosis in Edinburgh, United Kingdom.") Annotation(oboInOwl:hasDbXref "PMID:24516880") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4102322/") coho:COHO_0000000 coho:COHO_0001680)
ClassAssertion(Annotation(rdfs:comment "The Edinburgh Type 2 Diabetes Study is a large prospective cohort study that has the potential to identify factors that are important for the development and progression of less well-characterised complications of type 2 diabetes.") Annotation(oboInOwl:hasDbXref "PMID:19077235") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2621220/fullTextXML") coho:COHO_0000000 coho:COHO_0001710)
ClassAssertion(Annotation(rdfs:comment "The Ely study, established in 1990, is a prospective study of the etiology of type 2 diabetes, as described in detail elsewhere (18, 19).") Annotation(oboInOwl:hasDbXref "PMID:36658456") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC10348471/") coho:COHO_0000000 coho:COHO_0000198)
ClassAssertion(Annotation(rdfs:comment "The Emory Genebank Study was designed to investigate the relationship between biochemical and genetic factors with CAD in subjects undergoing cardiac catheterization.") Annotation(oboInOwl:hasDbXref "PMID:21270820") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3079521/") coho:COHO_0000000 coho:COHO_0001684)
ClassAssertion(Annotation(rdfs:comment "The English Longitudinal Study of Ageing (ELSA) is a panel study of a representative cohort of men and women living in England aged ≥50 years.") Annotation(oboInOwl:hasDbXref "PMID:23143611") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23143611+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000163)
ClassAssertion(Annotation(rdfs:comment "The Environmental Determinants of Diabetes in the Young (TEDDY) is an observational cohort study in which newborns who are younger than 4 months and have high-risk human leukocyte antigen alleles in the general population or are first-degree relatives (FDRs) of patients affected with T1DM will be enrolled.") Annotation(oboInOwl:hasDbXref "PMID:17850472") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17850472+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002448)
ClassAssertion(Annotation(rdfs:comment "The Environmental Influences on Child Health Outcomes (ECHO)-Wide Cohort Study (EWC), a collaborative research design comprising 69 cohorts in 31 consortia, was funded by the National Institutes of Health (NIH) in 2016 to improve children’s health in the United States.") Annotation(oboInOwl:hasDbXref "PMID:36963379") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10403303/fullTextXML") coho:COHO_0000001 coho:COHO_0002691)
ClassAssertion(Annotation(rdfs:comment "The Epidemiological Prevention study Of Zoetermeer (EPOZ) is a population-based follow-up study that was initiated in 1975 [28].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4879491/fullTextXML") coho:COHO_0000000 coho:COHO_0001702)
ClassAssertion(Annotation(rdfs:comment "The Epidemiological Study of Familial Breast Cancer (EMBRACE) study is a prospective cohort study in the United Kingdom and Republic of Ireland, aiming to characterize cancer risks in BRCA1/BRCA2 mutation carriers and their relatives.") Annotation(oboInOwl:hasDbXref "PMID:29565421") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6033314/fullTextXML") coho:COHO_0000000 coho:COHO_0001688)
ClassAssertion(Annotation(rdfs:comment "The Epidemiology and Natural History of Asthma: Outcomes and Treatment Regimens (TENOR) study was a large, 3-year, multicenter, observational cohort study of 4756 patients (n = 3489 adults ≥18 years of age, n = 497 adolescents 13-17 years of age, and n = 770 children 6-12 years of age) with severe or difficult-to-treat asthma.") Annotation(oboInOwl:hasDbXref "PMID:22694932") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3622643/") coho:COHO_0000000 coho:COHO_0002449)
ClassAssertion(Annotation(rdfs:comment "The Epidemiology of Dementia in Singapore (EDIS) study is a subsample of a population-based study focusing on the risk factors and prevalence of dementia and cognitive impairment in the three major Asian ethnicities.") Annotation(oboInOwl:hasDbXref "PMID:32060376") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7021682/fullTextXML") coho:COHO_0000000 coho:COHO_0001078)
ClassAssertion(Annotation(rdfs:comment "The Erasmus Rucphen Family (ERF) Study is a family-based cohort in a genetically isolated population in the southwest of the Netherlands with over 3,000 participants aged between 18 and 86 years.") Annotation(oboInOwl:hasDbXref "PMID:20548946") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC2883590") coho:COHO_0000000 coho:COHO_0000063)
ClassAssertion(Annotation(rdfs:comment "The Erasmus Rucphen Family study is comprised of a family-based cohort embedded in the Genetic Research in Isolated Populations (GRIP) program in the southwest of the Netherlands.") Annotation(oboInOwl:hasDbXref "PMID:36050321") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-022-32821-z/MediaObjects/41467_2022_32821_MOESM1_ESM.pdf") coho:COHO_0000001 coho:COHO_0000081)
ClassAssertion(Annotation(rdfs:comment "The Essen Obesity Study (Essen Obesity Trios) is a nuclear family study with 705 obese offspring (54.9% female; mean age 13.4 ± 3.0 years; age range 3-24 years; mean BMI 32.0 ± 5.8 kg/m2 ; mean BMI-SDS 4.2 ± 2.0) who were ascertained like the cases in the case-control study; in addition the 2x705 biological parents of the offspring were ascertained15 .") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2247/MediaObjects/41588_2012_BFng2247_MOESM24_ESM.pdf") coho:COHO_0000000 coho:COHO_0001708)
ClassAssertion(Annotation(rdfs:comment "The Estonian Biobank cohort is a volunteer-based sample of the Estonian resident adult population (aged ≥18 years).") Annotation(oboInOwl:hasDbXref "PMID:24518929") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24518929+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000064)
ClassAssertion(Annotation(rdfs:comment "The European Alzheimer & Dementia Biobank (EADB) consortium brings together the various European GWAS consortia already working on AD.") Annotation(oboInOwl:hasDbXref "PMID:35379992") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9005347/fullTextXML") coho:COHO_0000001 coho:COHO_0000551)
ClassAssertion(Annotation(rdfs:comment "The European Alzheimer's Disease Initiative (EADI) is composed of several case-control studies and 1 population-based cohort, 3C.27 The case-control studies are composed of AD cases and cognitively normal controls across France.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9421597/fullTextXML") coho:COHO_0000001 coho:COHO_0000643)
ClassAssertion(Annotation(rdfs:comment "The European Collaborative Study, presented elsewhere, included 1,241 HL cases aged 13–80 (median age = 33 years) from five European-based HL studies and 5,726 generic controls aged 17–94 (mean age = 62) used in the initial GWAS scan.") Annotation(oboInOwl:hasDbXref "PMID:24920014") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4055950/unicode") coho:COHO_0000001 coho:COHO_0001678)
ClassAssertion(Annotation(rdfs:comment "The European Community Respiratory Health Survey (ECRHS) is a multicentre population-based cohort study that began in 1990–1994.") Annotation(oboInOwl:hasDbXref "PMID:30764884") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6376659/fullTextXML") coho:COHO_0000000 coho:COHO_0001163)
ClassAssertion(Annotation(rdfs:comment "The European Male Ageing Study (EMAS) is a multicentre prospective cohort designed to examine the prevalence, incidence and geographical distribution of gender-specific and general symptoms of ageing in men, including their endocrine, genetic and psychosocial predictors.") Annotation(oboInOwl:hasDbXref "PMID:18328041") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18328041+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001687)
ClassAssertion(Annotation(rdfs:comment "The European Prospective Investigation into Cancer and Nutrition (EPIC) is an ongoing multi-centre prospective cohort study designed to investigate the relationship between nutrition and cancer, with the potential for studying other diseases as well.") Annotation(oboInOwl:hasDbXref "PMID:12639222") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12639222+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000065)
ClassAssertion(Annotation(rdfs:comment "The European Prospective Investigation into Cancer and Nutrition (EPIC)-Potsdam Study is a population-based prospective cohort study.") Annotation(oboInOwl:hasDbXref "https://www.dife.de/en/research/cooperations/epic-study/") coho:COHO_0000000 coho:COHO_0000387)
ClassAssertion(Annotation(rdfs:comment "The European Special Populations Network (EUROSPAN) consortium consists of five population samples: (i) the Erasmus Ruchpen Family (ERF) study conducted in The Netherlands, (ii) the MICROS study conducted in Italy, (iii) the Northern Swedish Population (NSP), (iv) the Orkney Complex Disease Study (ORCADES; Scotland) and (v) the Vis study conducted in Croatia.") Annotation(oboInOwl:hasDbXref "PMID:19060911") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2687074/") coho:COHO_0000001 coho:COHO_0001713)
ClassAssertion(Annotation(rdfs:comment "The European Youth Heart Study (EYHS) is a cross-sectional, school-based population study on risk factors for future cardiovascular disease in children, with an overall participation rate in Sweden of about 50%.") Annotation(oboInOwl:hasDbXref "PMID:12740078") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12740078+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001716)
ClassAssertion(Annotation(rdfs:comment "The Exeter Family Study of Childhood Health is a prospective study, set up to test the fetal insulin hypothesis, and to identify genetic polymorphisms that play a role in determining birthweight and early postnatal growth.") Annotation(oboInOwl:hasDbXref "PMID:16466435") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16466435+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000616)
ClassAssertion(Annotation(rdfs:comment "The FANCM c.5791C>T and c.5101C>T mutations were screened among 1323 breast cancer cases (1147 unselected, 153 familial, and 56 young breast cancer patients) and 510 healthy female controls from the Oulu area.") Annotation(oboInOwl:hasDbXref "PMID:28702895") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5645429/fullTextXML") coho:COHO_0000000 coho:COHO_0002195)
ClassAssertion(Annotation(rdfs:comment "The FIN-D2D survey was carried out in the hospital districts of Pirkanmaa, the Southern Ostrobothnia, and Central Finland between October and December 2007.") Annotation(oboInOwl:hasDbXref "PMID:20459722") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2873937/fullTextXML") coho:COHO_0000000 coho:COHO_0001072)
ClassAssertion(Annotation(rdfs:comment "The FINRISK studies were cross‐sectional population surveys carried out in Finland in a systematic and standardized fashion every 5 years since 1972 by the Finnish Institute for Health and Welfare (previously National Public Health Institute).") Annotation(oboInOwl:hasDbXref "PMID:34141987") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8183175/fullTextXML") coho:COHO_0000001 coho:COHO_0000071)
ClassAssertion(Annotation(rdfs:comment "The FINRISK97 study is a population-based cross-sectional survey which consists of 8,191 people aged 25–74 years from five geographical areas of Finland (the Helsinki, southwestern Finland, North Karelia, Oulu, and Kuopio regions) (21).") Annotation(oboInOwl:hasDbXref "PMID:18678614") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2570409/fullTextXML") coho:COHO_0000000 coho:COHO_0001729)
ClassAssertion(Annotation(rdfs:comment "The FISSIC program is a community-based and hospital-centered genetic epidemiological study of ischemic stroke.") Annotation(oboInOwl:hasDbXref "PMID:17825112") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1997110/fullTextXML") coho:COHO_0000000 coho:COHO_0001005)
