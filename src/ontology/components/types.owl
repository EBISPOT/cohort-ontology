ClassAssertion(Annotation(rdfs:comment "In 2005, we established a large-scale population-based OA cohort study called the Research on Osteoarthritis/Osteoporosis Against Disability (ROAD) with the goal of establishing epidemiologic indices to evaluate clinical evidence for the development of a disease-modifying treatment for skeletal diseases [6,7].") Annotation(oboInOwl:hasDbXref "PMID:39968102") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11834036/fullTextXML") coho:COHO_0000000 coho:COHO_0002325)
