ClassAssertion(Annotation(rdfs:comment "The stage 1 samples for the GWA scan included 1,999 T2D case subjects and 1,976 nondiabetic control subjects drawn from the Nutrition and Health of Aging Population in China (NHAPC) study (312 case and 815 control subjects), the Gut Microbiota and Obesity Study (GMOS) (82 case and 163 control subjects), the Fudan-Huashan Study (807 case and 339 control subjects), and the Beijing Diabetes Survey (798 case and 659 control subjects).") Annotation(oboInOwl:hasDbXref "PMID:22961080") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526061/fullTextXML") coho:COHO_0000000 coho:COHO_0001746)
