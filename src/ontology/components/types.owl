ClassAssertion(Annotation(rdfs:comment "The National Emphysema Treatment Trial is a multicenter, randomized clinical trial of medical therapy vs medical therapy plus lung volume reduction surgery (LVRS) for the treatment of patients with severe bilateral emphysema.") Annotation(oboInOwl:hasDbXref "PMID:10593802") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10593802+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002137)
ClassAssertion(Annotation(rdfs:comment "The National Heart, Lung, and Blood Institute’s Candidate Gene Association Resource (CARe), a planned cross-cohort analysis of genetic variation in cardiovascular, pulmonary, hematological, and sleep-related traits, comprises more than 40,000 participants representing four ethnic groups in nine community-based cohorts.") Annotation(oboInOwl:hasDbXref "PMID:20400780") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3048024/unicode") coho:COHO_0000001 coho:COHO_0001586)
ClassAssertion(Annotation(rdfs:comment "The National Institute on Aging Late‐Onset Alzheimer's Disease Family Based Study (NIA‐LOAD FBS) is the largest collection of multiplex AD families recruited and longitudinally assessed worldwide.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9250549/fullTextXML") coho:COHO_0000000 coho:COHO_0000669)
ClassAssertion(Annotation(rdfs:comment "The National Joint Registry for England, Wales, Northern Ireland, and the Isle of Man (NJR, http://www.njrcentre.org.uk/) was established in 2003 to collect audit data on all hip and knee replacement surgery in these regions") Annotation(oboInOwl:hasDbXref "PMID:30273415") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6123669/fullTextXML") coho:COHO_0000000 coho:COHO_0001382)
ClassAssertion(Annotation(rdfs:comment "The National Norwegian Addison Registry (ROAS) collates clinical information, demographics, and biological samples from patients with PAI.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8052519/fullTextXML") coho:COHO_0000000 coho:COHO_0002110)
ClassAssertion(Annotation(rdfs:comment "The National Study of Endometrial Cancer Genetics (NSECG) consisted of 925 histologically confirmed endometrial cancer cases from the UK; 86% with endometrioid-only histology.") Annotation(oboInOwl:hasDbXref "PMID:27135401") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4907351/fullTextXML") coho:COHO_0000000 coho:COHO_0002183)
ClassAssertion(Annotation(rdfs:comment "The National Survey of Physical Traits (NSPT) cohort is a population-based prospective cohort that recruited Han Chinese participants in 2015–2018 from three cities: Nanning, Guangxi province, Taizhou, Jiangsu Province and Zhengzhou, Henan province.") Annotation(oboInOwl:hasDbXref "PMID:40118068") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC12008806/unicode") coho:COHO_0000000 coho:COHO_0001384)
ClassAssertion(Annotation(rdfs:comment "The NeoALTTO phase III trial randomized 455 HER2-positive early-stage BC patients to receive neoadjuvant trastuzumab (T), lapatinib (L) or T + L1,3,4.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10624889/fullTextXML") coho:COHO_0000000 coho:COHO_0000311)
ClassAssertion(Annotation(rdfs:comment "The Netherlands AAA GWAS dataset: The AAA sample set from Utrecht was recruited in 2007-2009 from 8 centres in The Netherlands") Annotation(oboInOwl:hasDbXref "PMID:27899403") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5253231/supplementaryFiles") coho:COHO_0000000 coho:COHO_0000167)
ClassAssertion(Annotation(rdfs:comment "The Netherlands Brain Bank (NBB) performs rapid autopsies of donors who gave written informed consent during life for the use of their brain tissue and medical files for research.") Annotation(oboInOwl:hasDbXref "PMID:29496148") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29496148+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002115)
ClassAssertion(Annotation(rdfs:comment "The Netherlands Study of Depression and Anxiety (NESDA, www.nesda.nl) is a longitudinal, multi-site, naturalistic, case-control cohort study set up to examine the etiology, course and consequences of depressive and anxiety disorders.") Annotation(oboInOwl:hasDbXref "PMID:33773360") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33773360+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000440)
ClassAssertion(Annotation(rdfs:comment "The New South Wales (NSW) study is a population-based case-control study of NHL cases (20-74 years old) identified in NSW or the Australian Capital Territory (ACT) between 2000 and 2001 and matched controls randomly selected from the NSW and ACT electoral rolls [24].") Annotation(oboInOwl:hasDbXref "PMID:24069324") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3775730/fullTextXML") coho:COHO_0000000 coho:COHO_0002187)
ClassAssertion(Annotation(rdfs:comment "The Newcastle 85+ Study aims to determine the full spectrum of health within an inception cohort of 85 year olds, selected without regard to health status, and to examine health trajectories and outcomes as the cohort ages and the association between these outcomes and a complex array of clinical, biological, and psychosocial factors.") Annotation(oboInOwl:hasDbXref "PMID:20028777") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2797051/fullTextXML") coho:COHO_0000000 coho:COHO_0002104)
ClassAssertion(Annotation(rdfs:comment "The Newcastle Endometrial Cancer Study (NECS) includes histologically confirmed endometrial cancer cases consecutively recruited from 1992 up to 2005 at the Hunter Centre for Gynaecological Cancer, John Hunter Hospital, Newcastle, New South Wales, Australia15 .") Annotation(oboInOwl:hasDbXref "PMID:27135401") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM301_ESM.pdf") coho:COHO_0000000 coho:COHO_0002130)
ClassAssertion(Annotation(rdfs:comment "The Newfoundland and Labrador Genome Project (NLGP) is a general population cohort focused on the characterization of Newfoundland and Labrador’s population (Sequence Bio Inc., 2021).") Annotation(oboInOwl:hasDbXref "PMID:37117635") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10147672/fullTextXML") coho:COHO_0000000 coho:COHO_0002687)
ClassAssertion(Annotation(rdfs:comment "The Nigerian Breast Cancer Study is a case-control study of breast cancer conducted in Ibadan, Nigeria.") Annotation(oboInOwl:hasDbXref "PMID:20716701") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2950817/") coho:COHO_0000000 coho:COHO_0001381)
ClassAssertion(Annotation(rdfs:comment "The Nijmegen Biomedical Study (NBS) is a population-based study that was initiated (by L.K. and A.V.) in 2000 in the municipality of Nijmegen (∼ 150 000 inhabitants) in the eastern part of The Netherlands.") Annotation(oboInOwl:hasDbXref "PMID:28082374") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837647/fullTextXML") coho:COHO_0000000 coho:COHO_0000128)
ClassAssertion(Annotation(rdfs:comment "The Norfolk Diabetes case-control study is a study of men and women with T2D in Norfolk, UK.") Annotation(oboInOwl:hasDbXref "PMID:22039354") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3201934/fullTextXML") coho:COHO_0000000 coho:COHO_0002128)
ClassAssertion(Annotation(rdfs:comment "The Norfolk Island Health Study (NIHS) is a population-based cohort study supported by Australian NHMRC and NHF funding.") Annotation(oboInOwl:hasDbXref "PMID:41751589") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12940796/fullTextXML") coho:COHO_0000000 coho:COHO_0002153)
ClassAssertion(Annotation(rdfs:comment "The Northeastern Taiwan Community Medicine Research Cohort (NTCMRC; ClinicalTrials.gov identifier NCT04839796) was a community cohort study launched in 2012 by the Community Medicine Research Center of Chang Gung Memorial Hospital in Keelung and enrolled adult participants in Northeastern Taiwan.") Annotation(oboInOwl:hasDbXref "PMID:35820405") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9677874/fullTextXML") coho:COHO_0000000 coho:COHO_0002189)
ClassAssertion(Annotation(rdfs:comment "The Northern California Breast Cancer Family Registry (NC-BCFR) was initiated in 1995 and enrolled ~4000 women with incident breast cancer and family members") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") coho:COHO_0000000 coho:COHO_0000667)
ClassAssertion(Annotation(rdfs:comment "The Northern Sweden Population Health Study (NSPHS) was conducted to provide a health survey of the communities of Karesuando and Soppero, County of Norrbotten, Sweden.") Annotation(oboInOwl:hasDbXref "PMID:23986895") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3754550/fullTextXML") coho:COHO_0000000 coho:COHO_0000130)
ClassAssertion(Annotation(rdfs:comment "The Norwegian MoBa (Mother, Father and Child Cohort Study) is a longitudinal study of over 110,000 pregnant women, their children and partners, recruited between 1999 and 2008 from maternity units throughout Norway, and has been described previously44.") Annotation(oboInOwl:hasDbXref "PMID:33239696") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7688949/fullTextXML") coho:COHO_0000000 coho:COHO_0000131)
ClassAssertion(Annotation(rdfs:comment "The Nottingham Smokers cohort is an ongoing collection in Nottingham using the following criteria; European ancestry, >40 years of age and smoking history of >10 pack years (currently n = 538).") Annotation(oboInOwl:hasDbXref "PMID:24786987") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4006731/fullTextXML") coho:COHO_0000000 coho:COHO_0002176)
ClassAssertion(Annotation(rdfs:comment "The OBB is a random, population-based recruitment of healthy participants between the ages of 30 and 50 years from the Oxfordshire general population (approximately 800 000 inhabitants).") Annotation(oboInOwl:hasDbXref "PMID:29040543") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837504/fullTextXML") coho:COHO_0000000 coho:COHO_0000136)
ClassAssertion(Annotation(rdfs:comment "The OHSU dataset includes 132 autopsy-confirmed AD cases and 153 deceased controls that were evaluated for dementia within 12 months prior to death (age at death >65 years), which are a subset of the 193 cases and 451 controls examined in our previous study [1] meeting more stringent QC criteria in this study.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2802/MediaObjects/41588_2013_BFng2802_MOESM27_ESM.pdf") coho:COHO_0000000 coho:COHO_0000719)
ClassAssertion(Annotation(rdfs:comment "The OPPERA project comprises: (i) a prospective cohort study of first-onset TMD, (ii) a baseline case-control study of chronic TMD, (iii) a matched case-control study of incident TMD, and (iv) a prospective case-cohort study of the course of TMD (Figure 1).") Annotation(oboInOwl:hasDbXref "PMID:22074749") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3666856/") coho:COHO_0000000 coho:COHO_0002211)
ClassAssertion(Annotation(rdfs:comment "The Ontario Familial Colon Cancer Registry (OFCCR) is a novel registry that collects family history information, epidemiologic data, blood samples and tumour specimens from a population-based sample of colorectal cancer patients and their families.") Annotation(oboInOwl:hasDbXref "PMID:11007659") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11007659+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002200)
ClassAssertion(Annotation(rdfs:comment "The Oregon Sudden Unexpected Death Study (Oregon-SUDS) is an ongoing, prospective, community-based evaluation of approximately one million residents of the Portland, Oregon metropolitan area [10].") Annotation(oboInOwl:hasDbXref "PMID:20360844") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2845611/fullTextXML") coho:COHO_0000000 coho:COHO_0002213)
ClassAssertion(Annotation(rdfs:comment "The Orkney Complex Disease Study (ORCADES) is a family-based study of 2078 individuals aged 16–100 years recruited between 2005 and 2011 in the isolated Scottish archipelago of Orkney26.") Annotation(oboInOwl:hasDbXref "PMID:28878392") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5587582/fullTextXML") coho:COHO_0000000 coho:COHO_0000132)
ClassAssertion(Annotation(rdfs:comment "The Osaka Acute Coronary Insufficiency Study (OACIS) is a prospective, multicenter, observational study in which 25 collaborating hospitals in the Osaka region of Japan record demographic, procedural, and outcome data and collect blood samples from patients with AMI.") Annotation(oboInOwl:hasDbXref "PMID:33693242") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7925312/fullTextXML") coho:COHO_0000000 coho:COHO_0002194)
ClassAssertion(Annotation(rdfs:comment "The Osteoporosis and Ultrasound Study (OPUS) is a multicenter prospective study of risk factors for fractures in post menopausal women.") Annotation(oboInOwl:hasDbXref "PMID:24386199") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3875449/fullTextXML") coho:COHO_0000000 coho:COHO_0002220)
ClassAssertion(Annotation(rdfs:comment "The Osteoporotic Fractures in Men Study (MrOS) is a prospective cohort study examining the risk factors for fractures, osteoporosis, and prostate cancer [94,95] in males age 65 or older from six U.S. communities.") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC6467367") coho:COHO_0000000 coho:COHO_0000549)
ClassAssertion(Annotation(rdfs:comment "The Ovarian Cancer Association Consortium is comprised of ovarian cancer case–control and cohort studies conducted around the world (Gayther et al, 2007; Pearce et al, 2008; Ramus et al, 2008).") Annotation(oboInOwl:hasDbXref "PMID:19127255") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2634713/fullTextXML") coho:COHO_0000001 coho:COHO_0000134)
ClassAssertion(Annotation(rdfs:comment "The Ovarian cancer Prognosis And Lifestyle (OPAL) study is a national prospective cohort of Australian women aged 21-79 years diagnosed with histologically confirmed invasive epithelial ovarian, primary peritoneal, or fallopian tube cancer from 2012 to 2015.") Annotation(oboInOwl:hasDbXref "PMID:36744914") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10165482/fullTextXML") coho:COHO_0000000 coho:COHO_0002210)
ClassAssertion(Annotation(rdfs:comment "The Oxford regional prospective study is a population based inception cohort of children with type 1 diabetes designed to determine prospectively the natural course of microalbuminuria during childhood and adolescence.") Annotation(oboInOwl:hasDbXref "PMID:18349042") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2276285/") coho:COHO_0000000 coho:COHO_0001437)
ClassAssertion(Annotation(rdfs:comment "The PAGES study recruited children and adolescents (age: 2-16 years) with physician-diagnosed asthma through 15 secondary care asthma clinics across Scotland from 2008 to 2011.") Annotation(oboInOwl:hasDbXref "PMID:25616159") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4461653/unicode") coho:COHO_0000000 coho:COHO_0000721)
ClassAssertion(Annotation(rdfs:comment "The PANIC Study is a long-term lifestyle intervention and follow-up study in a population-based cohort from Kuopio, Finland (ClinicalTrials.gov NCT01803776).") Annotation(oboInOwl:hasDbXref "https://www.panicstudy.fi/front-page/about-the-panic-study/") coho:COHO_0000000 coho:COHO_0000140)
ClassAssertion(Annotation(rdfs:comment "The PANcreatic Disease ReseArch (PANDoRA) consortium was established to unite the efforts of different research groups; its aim is to create a large bio-database to uncover new genetic factors for pancreatic cancer risk, response to treatment, and patient survival.") Annotation(oboInOwl:hasDbXref "PMID:23206934") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23206934+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000001 coho:COHO_0002229)
ClassAssertion(Annotation(rdfs:comment "The PARTAGE is an observational cohort study of 1130 individuals aged 80 years or older [6,18].") Annotation(oboInOwl:hasDbXref "PMID:41307346") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12746773/fullTextXML") coho:COHO_0000000 coho:COHO_0002235)
ClassAssertion(Annotation(rdfs:comment "The PASTURE study is a prospective birth cohort study started in 2002 and is conducted in children from rural areas of 5 European countries (Austria, Finland, France, Germany, and Switzerland) (58).") Annotation(oboInOwl:hasDbXref "https://ars.els-cdn.com/content/image/1-s2.0-S009167492600093X-mmc3.pdf") coho:COHO_0000000 coho:COHO_0001253)
ClassAssertion(Annotation(rdfs:comment "The PEACE study is a pan-cancer, UK-wide research autopsy program (NCT03004755) designed to comprehensively evaluate the biology of metastatic disease and drug resistance.") Annotation(oboInOwl:hasDbXref "PMID:36977461") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC10236155/") coho:COHO_0000000 coho:COHO_0000319)
ClassAssertion(Annotation(rdfs:comment "The PEAK-25 cohort is a longitudinal, prospective, population-based study of young-adult women with the main purpose of exploring the relationship between genetic, clinical, and lifestyle factors associated with attainment of peak bone mass12 and subsequent changes in bone mass over time.") Annotation(oboInOwl:hasDbXref "PMID:40581742") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12685719/fullTextXML") coho:COHO_0000000 coho:COHO_0002244)
ClassAssertion(Annotation(rdfs:comment "The PERSIAN project is an ongoing, nationwide, population-based prospective cohort that began enrolment in 2014 to characterise environmental, lifestyle, and genetic determinants of non-communicable diseases across Iran’s diverse populations.") Annotation(oboInOwl:hasDbXref "PMID:41286709") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12645788/fullTextXML") coho:COHO_0000000 coho:COHO_0002676)
ClassAssertion(Annotation(rdfs:comment "The PETAL trial (ClinicalTrials.gov NCT00554164; EudraCT 2006-001641-33) was a multicenter study for newly diagnosed aggressive non-Hodgkin lymphomas [2].") Annotation(oboInOwl:hasDbXref "PMID:34523055") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC8440745") coho:COHO_0000000 coho:COHO_0000316)
ClassAssertion(Annotation(rdfs:comment "The PHArmacogenetic study of Statins in the Elderly at risk (PHASE) is a genome wide association study in the PROspective Study of Pravastatin in the Elderly at risk for vascular disease (PROSPER) that investigates the genetic variation responsible for the individual variation in drug response to pravastatin.") Annotation(oboInOwl:hasDbXref "PMID:21977987") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3207930/fullTextXML") coho:COHO_0000000 coho:COHO_0002252)
ClassAssertion(Annotation(rdfs:comment "The PIPA Project is a prospective birth cohort study based in Rio de Janeiro, Brazil, whose pilot study was carried out between October 2017 and August 2018.") Annotation(oboInOwl:hasDbXref "PMID:35409976") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8998578/fullTextXML") coho:COHO_0000000 coho:COHO_0002650)
ClassAssertion(Annotation(rdfs:comment "The PMCC AML RNAseq dataset consists of 81 AML patient samples (clinical data in Supplemental Table 11 of manuscript), processed in two batches.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001004792") coho:COHO_0000000 coho:COHO_0000325)
ClassAssertion(Annotation(rdfs:comment "The POFC project recruits individuals with clefts, their family members, and population-based controls for extensive phenotypic and genomic analyses.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7937973/fullTextXML") coho:COHO_0000000 coho:COHO_0000671)
ClassAssertion(Annotation(rdfs:comment "The PRECISESADS study is a European multi center, non-randomized, and observational clinical study with recruitment performed between December 2014 and December 2018 at 19 institutions in 9 countries (Austria, Belgium, France, Germany, Hungary, Italy, Portugal, Spain and Switzerland).") Annotation(oboInOwl:hasDbXref "PMID:32665668") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7360585/fullTextXML") coho:COHO_0000000 coho:COHO_0002276)
ClassAssertion(Annotation(rdfs:comment "The PREMIER consortium (May 2019 and December 2022) recruited a research cohort to establish an R&BD platform for the development of early diagnosis and precision medicine-based treatment of mild cognitive impairment (MCI) and dementia.") Annotation(oboInOwl:hasDbXref "PMID:39512701") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11538854/fullTextXML") coho:COHO_0000000 coho:COHO_0002278)
ClassAssertion(Annotation(rdfs:comment "The PROGRESSA study is a longitudinal, prospective, multicenter observational cohort study of patients with early glaucoma and patients with suspected glaucoma in Australia.") Annotation(oboInOwl:hasDbXref "PMID:36246177") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9559075/fullTextXML") coho:COHO_0000000 coho:COHO_0002285)
ClassAssertion(Annotation(rdfs:comment "The PROVIDE study was a randomized controlled clinical trial with two vaccine interventions, which enrolled a birth cohort of 700 children and their mothers, and followed the children for their first 2 years of life.") Annotation(oboInOwl:hasDbXref "PMID:25711607") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4385767/") coho:COHO_0000000 coho:COHO_0001225)
ClassAssertion(Annotation(rdfs:comment "The PROspective Study of Pravastatin in the Elderly at Risk (PROSPER) is a randomised, double blind, placebo-controlled trial to test the hypothesis that treatment with pravastatin will diminish the risk of subsequent major vascular events in a cohort of high-risk elderly individuals with a wide range of cholesterol levels.") Annotation(oboInOwl:hasDbXref "PMID:12097148") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC134480/fullTextXML") coho:COHO_0000000 coho:COHO_0000539)
ClassAssertion(Annotation(rdfs:comment "The PUBMEP is a longitudinal study based on the follow-up of a cohort of children who had previously participated in the GENOBOX study (22–29).") Annotation(oboInOwl:hasDbXref "PMID:36601007") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9806164/fullTextXML") coho:COHO_0000000 coho:COHO_0002636)
ClassAssertion(Annotation(rdfs:comment "The PUUMA study is a prospective observational cohort study of 9,540 participants age ≥40 years at enrollment between December 2011 and April 2012.") Annotation(oboInOwl:hasDbXref "PMID:34488438") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8516734/unicode") coho:COHO_0000000 coho:COHO_0000658)
ClassAssertion(Annotation(rdfs:comment "The Pancreatic Cancer Case-Control Consortium (PanC4) (http://www.panc4.org), is an international group of researchers organized to pool data from individual case-control studies of pancreatic cancer.") Annotation(oboInOwl:hasDbXref "PMID:26646264") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4710562/unicode") coho:COHO_0000001 coho:COHO_0001387)
ClassAssertion(Annotation(rdfs:comment "The Parkinson Disease Biomarkers Program (PDBP) is a consortium of laboratory and clinical biomarker discovery projects funded by the National Institute of Neurological Diseases and Stroke (NINDS, National Institutes of Health (NIH), United States).") Annotation(oboInOwl:hasDbXref "PMID:26442452") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4824671/") coho:COHO_0000000 coho:COHO_0000842)
ClassAssertion(Annotation(rdfs:comment "The Parkinson Environment and Genes (PEG) study is a population-based case-control study conducted in central California.") Annotation(oboInOwl:hasDbXref "PMID:40094665") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11915066/fullTextXML") coho:COHO_0000000 coho:COHO_0000138)
ClassAssertion(Annotation(rdfs:comment "The Parkinson’s, Genes, and Environment (PAGE) study is a case-control study within the large prospective NIH-AARP Diet and Health Study cohort (Schatzkin, et al., 2001).") Annotation(oboInOwl:hasDbXref "PMID:21741729") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3172377/") coho:COHO_0000000 coho:COHO_0002232)
ClassAssertion(Annotation(rdfs:comment "The Pathobiological Determinants of Atherosclerosis in Youth (PDAY) is a unique NHLBI repository that includes of a total of 2876 study subjects, between 15 and 34 years old, black and white, men and women, who died of external, non-atherosclerosis related causes and underwent autopsy between June 1, 1987, and August 31, 1994.") Annotation(oboInOwl:hasDbXref "PMID:27861582") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5115850/fullTextXML") coho:COHO_0000000 coho:COHO_0002242)
ClassAssertion(Annotation(rdfs:comment "The Pathways Study is a prospective cohort study, with recruitment of women from the Kaiser Permanente Northern California (KPNC) patient population as soon after diagnosis of invasive breast cancer as possible.") Annotation(oboInOwl:hasDbXref "PMID:18478338") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2581640/") coho:COHO_0000000 coho:COHO_0002237)
ClassAssertion(Annotation(rdfs:comment "The Pelvic Mass study is a Danish prospective study of ovarian cancer, covering biochemistry and molecular biology with the purpose of identifying prognostic factors as well as factors that differentiate benign and malignant conditions.") Annotation(oboInOwl:hasDbXref "PMID:22363532") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3281903/fullTextXML") coho:COHO_0000000 coho:COHO_0001614)
ClassAssertion(Annotation(rdfs:comment "The Penn Medicine Biobank (PMBB) is a large academic medical biobank in which participants are agnostically recruited from the outpatient setting and consented for access to their EHR data and permission to generate genomic and biomarker data [12].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10941505/fullTextXML") coho:COHO_0000000 coho:COHO_0000457)
ClassAssertion(Annotation(rdfs:comment "The Personalized Medicine Research Project is a population based cohort of approximately 20,000 individuals ages 18 and up residing within one of 19 zip codes surrounding Marshfield Wisconsin, USA, who have agreed to provide DNA, serum, and plasma samples to be linked with a dynamic medical record for research [26].") Annotation(oboInOwl:hasDbXref "PMID:20565774") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2908055/fullTextXML") coho:COHO_0000000 coho:COHO_0000873)
ClassAssertion(Annotation(rdfs:comment "The Peruvian Genetics and Genomics of Breast Cancer Study (PEGEN-BC) is a hospital-based cohort including patients from the Instituto Nacional de Enfermedades Neoplásicas (INEN) in Lima, Peru.") Annotation(oboInOwl:hasDbXref "PMID:36925912") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10013058/fullTextXML") coho:COHO_0000000 coho:COHO_0002248)
ClassAssertion(Annotation(rdfs:comment "The Phenotype-Genotype and Biomarker Study of the CReATe Consortium will prospectively and systematically study approximately 700 patients with amyotrophic lateral sclerosis (ALS) or a related neurodegenerative disorder (listed further below).") Annotation(oboInOwl:hasDbXref "https://create.rarediseasesnetwork.org/research-study/8001") coho:COHO_0000000 coho:COHO_0001389)
ClassAssertion(Annotation(rdfs:comment "The Philadelphia Neurodevelopmental Cohort (PNC) is a population-based study of youth living in the greater Philadelphia (United States) area (Calkins et al., 2015) that aims to describe how genetics impacts brain development and cognitive functioning in adolescents (Satterthwaite et al., 2014).") Annotation(oboInOwl:hasDbXref "PMID:41287920") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12671915/fullTextXML") coho:COHO_0000000 coho:COHO_0000878)
ClassAssertion(Annotation(rdfs:comment "The Physicians’ Health Study (PHS) cohort comprises two groups: PHS I and II [11].") Annotation(oboInOwl:hasDbXref "PMID:38893188") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11171146/fullTextXML") coho:COHO_0000000 coho:COHO_0000626)
ClassAssertion(Annotation(rdfs:comment "The Piccolipiù birth cohort is a relatively large cohort combining detailed information from questionnaires and repeated follow-up contacts, with a biobank that stores samples from participating mother-newborn pairs.") Annotation(oboInOwl:hasDbXref "PMID:24506846") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3926689/fullTextXML") coho:COHO_0000000 coho:COHO_0002622)
ClassAssertion(Annotation(rdfs:comment "The Polish Norwegian Study (PONS) is a prospective community-based investigation of risk factors for chronic diseases, conducted in the Kielce region of south-east Poland (Manczuk et al., 2015).") Annotation(oboInOwl:hasDbXref "PMID:28626626") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5466582/fullTextXML") coho:COHO_0000000 coho:COHO_0002611)
ClassAssertion(Annotation(rdfs:comment "The Polish Women’s Breast Cancer Study (PBCS) is a population-based case-control study conducted in two major cities in Poland (Warsaw and Łódź) during 2000-2003 (Garcia-Closas et al., 2006).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") coho:COHO_0000000 coho:COHO_0000930)
ClassAssertion(Annotation(rdfs:comment "The Population Architecture Using Genomics and Epidemiology (PAGE) study is a consortium of multi-ancestry, population-based studies formed with the objective of refining our understanding of the genetic architecture of common traits emerging from GWAS.") Annotation(oboInOwl:hasDbXref "PMID:24068893") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3775722/fullTextXML") coho:COHO_0000001 coho:COHO_0002752)
ClassAssertion(Annotation(rdfs:comment "The Population-based Colonoscopy (PopCol) study is a cohort of Swedish-born individuals from Stockholm, Sweden, which includes an omics-rich set of participants with available data from bowel symptoms questionnaires, gastroenterology visits, and biospecimens.") Annotation(oboInOwl:hasDbXref "PMID:34957435") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8654685/fullTextXML") coho:COHO_0000000 coho:COHO_0000141)
ClassAssertion(Annotation(rdfs:comment "The Post-Columbian Study of Environmental and Heritable Causes of Breast Cancer (COLUMBUS) is a case–control study of breast cancer with individuals recruited throughout large cancer hospitals in central and southern Colombia and Mexico City.") Annotation(oboInOwl:hasDbXref "PMID:39625644") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11799839/fullTextXML") coho:COHO_0000000 coho:COHO_0001606)
ClassAssertion(Annotation(rdfs:comment "The PreFace Study (Evaluation of PREdictive FACtors Regarding the Effectivity of Aromatase Inhibitor Therapy, NCT01908556) was a prospective open label phase IV clinical trial in patients with HRpos early-stage breast cancer.") Annotation(oboInOwl:hasDbXref "PMID:38344045") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10853028/fullTextXML") coho:COHO_0000000 coho:COHO_0002277)
ClassAssertion(Annotation(rdfs:comment "The Pregnancy Outcome Prediction (POP) study is a prospective cohort study of nulliparous women attending the Rosie Hospital (Cambridge, UK) for their dating ultrasound scan.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001002205") coho:COHO_0000000 coho:COHO_0000321)
ClassAssertion(Annotation(rdfs:comment "The PrevANZ trial, a phase IIb randomized placebo-controlled trial of oral vitamin D3 supplementation in people with a first demyelinating event (FDE), was conducted to determine if supplementation can prevent recurrent disease activity in this cohort at high risk of developing definite MS.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001007346") coho:COHO_0000000 coho:COHO_0000323)
ClassAssertion(Annotation(rdfs:comment "The Prevalence, Prediction and Prevention of Diabetes (PPP)-Botnia study is a population-based study in Western Finland, which includes a random sample of 5,208 individuals aged 18 to 75 years identified through the national Finnish Population Registry.") Annotation(oboInOwl:hasDbXref "PMID:20454776") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20454776+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000769)
ClassAssertion(Annotation(rdfs:comment "The Prevention of Ovarian Cancer in Quebec (PROVAQ) study is a population-based case-control study of female Canadian citizens aged 18-79 years conducted in Montreal, Canada, from 2011 to 2016.") Annotation(oboInOwl:hasDbXref "PMID:38754871") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11369219/fullTextXML") coho:COHO_0000000 coho:COHO_0002293)
ClassAssertion(Annotation(rdfs:comment "The Primary Open-Angle African American Glaucoma Genetics (POAAGG) study recruited 10,255 individuals of African descent from the Philadelphia area, representing the largest single-city study of POAG nationwide.") Annotation(oboInOwl:hasDbXref "PMID:40782885") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12969997/fullTextXML") coho:COHO_0000000 coho:COHO_0001392)
ClassAssertion(Annotation(rdfs:comment "The Pro@Heart study is a multicentre prospective cohort trial.") Annotation(oboInOwl:hasDbXref "PMID:35368514") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8935177/fullTextXML") coho:COHO_0000000 coho:COHO_0002287)
ClassAssertion(Annotation(rdfs:comment "The ProAFHeart study is a multicentre prospective trial aiming to determine the prevalence and 2-year incidence of arrhythmias and athletic remodeling in endurance athletes 16–80 years of age.") Annotation(oboInOwl:hasDbXref "PMID:40273982") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12305178/fullTextXML") coho:COHO_0000000 coho:COHO_0002280)
ClassAssertion(Annotation(rdfs:comment "The Prospective Investigation of the Vasculature in Uppsala Seniors [26] (PIVUS; http://www.medsci.uu.se/pivus/) is a population-based study of 70-year old individuals living in Uppsala.") Annotation(oboInOwl:hasDbXref "PMID:25502724") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4263376/fullTextXML") coho:COHO_0000000 coho:COHO_0000144)
ClassAssertion(Annotation(rdfs:comment "The Prospective study of Outcomes in Sporadic versus Hereditary breast cancer (POSH) is a large, prospective cohort study.") Annotation(oboInOwl:hasDbXref "PMID:17697367") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1995215/fullTextXML") coho:COHO_0000000 coho:COHO_0002271)
ClassAssertion(Annotation(rdfs:comment "The Prostate Cancer & Environment Study (PROtEuS), described previously (Blanc-Lapierre et al., 2015), is a population-based case-control study conducted in Montreal, Canada, to assess the role of environmental and lifestyle factors in prostate cancer risk.") Annotation(oboInOwl:hasDbXref "PMID:30233396") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6131535/fullTextXML") coho:COHO_0000000 coho:COHO_0002292)
ClassAssertion(Annotation(rdfs:comment "The Prostate Cancer Prevention Trial (PCPT) was a phase III randomized, double-blind, placebo-controlled clinical trial of finasteride in 18,882 men.") Annotation(oboInOwl:hasDbXref "PMID:21149329") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3058741/") coho:COHO_0000000 coho:COHO_0002241)
ClassAssertion(Annotation(rdfs:comment "The Prostate Cancer in a Black Population (PCBP) study was a large, population-based case-control study designed to evaluate genetic and epidemiologic contributors to PC in Barbados, West Indies, an Afro-Caribbean nation with relatively low admixture (7).") Annotation(oboInOwl:hasDbXref "PMID:24399209") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4087101/") coho:COHO_0000000 coho:COHO_0002239)
ClassAssertion(Annotation(rdfs:comment "The Proyecto Genes Candidatos en Asma (PGCA) study is a population-based study conducted by the Institute for Immunological Research of The University of Cartagena (Colombia) to identify environmental and genetic risk factors for asthma and allergies [16, 19, 21, 22].") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-019-08469-7/MediaObjects/41467_2019_8469_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0002249)
ClassAssertion(Annotation(rdfs:comment "The Psychiatric Central Research Register (PCRR) has continued since 1970 with electronic registration of patients treated at psychiatric departments in Denmark.") Annotation(oboInOwl:hasDbXref "PMID:21775352") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21775352+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001613)
ClassAssertion(Annotation(rdfs:comment "The Puerto Rican and Mexican populations consisted of mother, father, child trios enrolled in the GALA Study.") Annotation(oboInOwl:hasDbXref "PMID:21912604") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3166061/fullTextXML") coho:COHO_0000000 coho:COHO_0001753)
ClassAssertion(Annotation(rdfs:comment "The Pulmonary Hypertension and Hypoxic Response in Sickle Cell Disease (PUSH) Study is an on-going multicenter observational study that was designed to identify factors in pre-symptomatic children with sickle cell disease that are predictors of cardiopulmonary complications and that therefore are potential mechanistic targets for early preventive intervention.") Annotation(oboInOwl:hasDbXref "PMID:19956689") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2776981/fullTextXML") coho:COHO_0000000 coho:COHO_0001394)
ClassAssertion(Annotation(rdfs:comment "The QFMP was a large family and twin study initiated in 1987 to study the influence of genetic susceptibility, sunlight exposure, and their interaction in CMM etiology (Aitken et al., 1996).") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3677021/") coho:COHO_0000000 coho:COHO_0002302)
ClassAssertion(Annotation(rdfs:comment "The QGP is a population-based study designed to perform whole genome sequencing of the Qatar Biobank (QBB) participants9 with the aim to gain insights into the population structure and the genetic architecture of clinically relevant phenotypes in the Middle Eastern Qatari population.") Annotation(oboInOwl:hasDbXref "PMID:33623009") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7902658/fullTextXML") coho:COHO_0000000 coho:COHO_0000394)
ClassAssertion(Annotation(rdfs:comment "The QSkin Sun and Health Study comprises a cohort of 43 794 men and women aged 40-69 years randomly sampled from the population of Queensland, Australia in 2011.") Annotation(oboInOwl:hasDbXref "PMID:22933644") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22933644+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000574)
ClassAssertion(Annotation(rdfs:comment "The Qatar Biobank was set up by the Qatar Foundation and the Supreme Council of Health in collaboration with Imperial College London, as the first Qatar national population based prospective cohort study, and includes the collection of biological samples, with long-term storage of data and samples for future research (biobank).") Annotation(oboInOwl:hasDbXref "PMID:26635005") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4669623/fullTextXML") coho:COHO_0000000 coho:COHO_0000469)
ClassAssertion(Annotation(rdfs:comment "The Qingdao Twin Registry (QTR), established by Qingdao Centers for Disease Control and Prevention (QDCDC) in 1998, is part of the Chinese National Twin Registry") Annotation(oboInOwl:hasDbXref "PMID:23182450") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1017/thg.2012.113") coho:COHO_0000000 coho:COHO_0000932)
ClassAssertion(Annotation(rdfs:comment "The Quebec Family Study (QFS) was an observational study with three cycles of data collection between 1979 and 2002 in Quebec City, Canada.") Annotation(oboInOwl:hasDbXref "PMID:24533236") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3920031/fullTextXML") coho:COHO_0000000 coho:COHO_0002303)
ClassAssertion(Annotation(rdfs:comment "The Queen Square Brain Bank for Neurological Disorders (QSBB) is an archive of brains and tissue from individuals with neurodegenerative disease and neurologically normal controls.") Annotation(oboInOwl:hasDbXref "PMID:38849413") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11161485/fullTextXML") coho:COHO_0000000 coho:COHO_0001395)
ClassAssertion(Annotation(rdfs:comment "The RA-MAP Consortium is a UK industry-academic precision medicine partnership funded by the Medical Research Council and the Association of the British Pharmaceutical Industry (ABPI).") Annotation(oboInOwl:hasDbXref "PMID:35534493") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML") coho:COHO_0000001 coho:COHO_0002741)
ClassAssertion(Annotation(rdfs:comment "The RAPPER study (UKCRN1471) is a large UK sample collection study, opened in 2005, which recruits patients from clinical trials and other well-designed studies.") Annotation(oboInOwl:hasDbXref "PMID:22767148") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3419947/fullTextXML") coho:COHO_0000000 coho:COHO_0002308)
ClassAssertion(Annotation(rdfs:comment "The RBC-Omics cohort was recruited from four large blood centers across the United States: the American Red Cross (ARC, Farmington, CT), the Institute for Transfusion Medicine (ITxM, Pittsburgh, PA), BloodCenter of Wisconsin (BCW, Milwaukee, WI), and the Blood Centers of the Pacific (BCP, San Francisco, CA).") Annotation(oboInOwl:hasDbXref "PMID:30267427") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6361628/unicode") coho:COHO_0000000 coho:COHO_0000451)
ClassAssertion(Annotation(rdfs:comment "The REGARDS study is one of the largest ongoing prospective population-based studies in the U.S. and was designed to measure stroke incidence and associated risk factors in AA and European-Americans adults ≥45 years of age (8).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9554233/fullTextXML") coho:COHO_0000000 coho:COHO_0000692)
ClassAssertion(Annotation(rdfs:comment "The REGICOR cohort integrates the participants of four population-based surveys conducted in 1995, 2000, 2005, and 2018 in the Girona province (North-Eastern Spain), with a current reference population of approximately 790 000 inhabitants.") Annotation(oboInOwl:hasDbXref "PMID:40611603") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12231538/fullTextXML") coho:COHO_0000000 coho:COHO_0002311)
ClassAssertion(Annotation(rdfs:comment "The ROOT (GWAS in Breast Cancer in the African Diaspora) consortium consists of six epidemiologic studies and the AABC (African American Breast Cancer) consortium consists of nine epidemiological studies (34).") Annotation(oboInOwl:hasDbXref "PMID:28171663") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5975608/") coho:COHO_0000001 coho:COHO_0001033)
ClassAssertion(Annotation(rdfs:comment "The RPGEH was developed by the KPNC Division of Research as a resource that links together surveys, biospecimens and electronic health record data for research on the genetic and environmental determinants of common, age-related complex health conditions.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7939422/fullTextXML") coho:COHO_0000000 coho:COHO_0000473)
ClassAssertion(Annotation(rdfs:comment "The Raine Study is a well-characterised pregnancy cohort located in Western Australia.31–33 In brief, the recruitment of 2900 mothers during pregnancy began in 1989 from the King Edward Memorial Hospital and surrounding clinics.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12873190/fullTextXML") coho:COHO_0000000 coho:COHO_0000538)
ClassAssertion(Annotation(rdfs:comment "The Registry of Endometrial Cancer in Sweden (RENDOCAS) is a hospital based case- control study.") Annotation(oboInOwl:hasDbXref "PMID:27135401") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM301_ESM.pdf") coho:COHO_0000000 coho:COHO_0002312)
ClassAssertion(Annotation(rdfs:comment "The Religious Orders Study and Rush Memory and Aging Project are both ongoing longitudinal clinical-pathologic cohort studies of aging and Alzheimer's disease (AD).") Annotation(oboInOwl:hasDbXref "PMID:29865057") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29865057+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000001 coho:COHO_0000400)
ClassAssertion(Annotation(rdfs:comment "The Religious Orders Study is a longitudinal clinical-pathologic cohort study of aging and Alzheimer's disease (AD).") Annotation(oboInOwl:hasDbXref "PMID:22471860") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22471860+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000792)
ClassAssertion(Annotation(rdfs:comment "The Riesgo de Enfermedad TROmboembólica VEnosa (RETROVE) study is a prospective case–control study of 400 consecutive patients with VTE (cancer associated thrombosis excluded) and 400 healthy control volunteers.") Annotation(oboInOwl:hasDbXref "PMID:37286573") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10247781/fullTextXML") coho:COHO_0000000 coho:COHO_0000845)
ClassAssertion(Annotation(rdfs:comment "The Risk Assessment of Cerebrovascular Events (RACE) Study is a retrospective case-control study designed to identify and evaluate genetic, lifestyle and biomarker determinants of stroke and its subtype in Pakistan.") Annotation(oboInOwl:hasDbXref "PMID:36240095") Annotation(oboInOwl:hasDbXref "https://cdn-links.lww.com/permalink/wnl/c/wnl_2022_08_08_mitchell_1_sdc1.pdf") coho:COHO_0000000 coho:COHO_0000691)
ClassAssertion(Annotation(rdfs:comment "The Risk Factors for Prostate Cancer Study (RFPCS) is a population based case- control study that in the period 1994-1997 recruited through State Cancer Registries men resident in Perth and Melbourne diagnosed with prostate cancer at age less than 70 years.") Annotation(oboInOwl:hasDbXref "PMID:19767753") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.450/MediaObjects/41588_2009_BFng450_MOESM22_ESM.pdf") coho:COHO_0000000 coho:COHO_0002318)
ClassAssertion(Annotation(rdfs:comment "The Rotterdam Study is an ongoing prospective cohort study that started in 1990 in the city of Rotterdam, The Netherlands.") Annotation(oboInOwl:hasDbXref "PMID:32367290") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7250962/fullTextXML") coho:COHO_0000000 coho:COHO_0000148)
ClassAssertion(Annotation(rdfs:comment "The SABE Colombia is a population-based cross-sectional study on health, aging, and well-being of elderly individuals aged at least 60 years focusing attention on social determinants of health inequities.") Annotation(oboInOwl:hasDbXref "PMID:27956896") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5124445/fullTextXML") coho:COHO_0000000 coho:COHO_0002656)
ClassAssertion(Annotation(rdfs:comment "The SADRC cohort is a longitudinal observational study of clinical dementia subjects and age-sex-matched non-demented subjects.") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-024-01972-8/MediaObjects/41588_2024_1972_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0000379)
ClassAssertion(Annotation(rdfs:comment "The SAFS began in 1991, and included 1,431 individuals in 42 extended families at baseline.") Annotation(oboInOwl:hasDbXref "PMID:36220816") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-022-33510-7/MediaObjects/41467_2022_33510_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0000649)
ClassAssertion(Annotation(rdfs:comment "The SAGE aggregated data containing common measures from three large scale studies in the substance abuse field: the Collaborative Study on the Genetics of Alcoholism (COGA), the Family Study of Cocaine Dependence (FSCD), and the Collaborative Genetic Study of Nicotine Dependence (COGEND).") Annotation(oboInOwl:hasDbXref "PMID:35012447") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8744290/fullTextXML") coho:COHO_0000001 coho:COHO_0000793)
ClassAssertion(Annotation(rdfs:comment "The SAHLSIS is a case–control study on ischemic stroke before 70 years of age, the design of which has been described in detail before.25 Briefly, white patients who presented with first-ever or recurrent acute ischemic stroke before reaching the age of 70 years (n=844) were consecutively recruited between 1998 and 2008 at four stroke units in Western Sweden.") Annotation(oboInOwl:hasDbXref "PMID:25293721") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4351890/") coho:COHO_0000000 coho:COHO_0000150)
ClassAssertion(Annotation(rdfs:comment "The SCOT study was an international, randomised, phase 3, non-inferiority trial done at 244 centres.") Annotation(oboInOwl:hasDbXref "PMID:29611518") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29611518+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000154)
ClassAssertion(Annotation(rdfs:comment "The SFBCS is a population-based multiethnic case–control study of breast cancer.") Annotation(oboInOwl:hasDbXref "PMID:25327703") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4204111/unicode") coho:COHO_0000000 coho:COHO_0000735)
