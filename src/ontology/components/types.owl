ClassAssertion(Annotation(rdfs:comment "The study was based on the Northern Finland Birth Cohort 1986 (NFBC1986) [20], which is an unselected, general population sample based on 9432 live-born children with an expected date of birth between July 1 st, 1985 – June 30th, 1986, in the provinces of Oulu and Lapland [21].") Annotation(oboInOwl:hasDbXref "PMID:40858910") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13585820/fullTextXML") coho:COHO_0000000 coho:COHO_0000760)
