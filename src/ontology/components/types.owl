ClassAssertion(Annotation(rdfs:comment "Families from two ethnic groups (African American and Hispanic) have been recruited from three clinical sites.") Annotation(oboInOwl:hasDbXref "PMID:12684185") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12684185+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000504)
ClassAssertion(Annotation(rdfs:comment "Feasibility Case Study 1: Cambridge Biorepository for Translational Medicine (CBTM) CBTM (www.CBTM.group.cam.ac.uk) was founded in Cambridge, U.K., in April 2015 to support translational research projects that require access to fresh or biochemically viable tissue.") Annotation(oboInOwl:hasDbXref "https://arxiv.org/pdf/1810.05192") coho:COHO_0000000 coho:COHO_0000228)
ClassAssertion(Annotation(rdfs:comment "Finally, the PIAMA (Prevention and Incidence of Asthma and Mite Allergy) study is a population based prospective birth cohort, with an intervention component, of children born during 1996–1997 in cities and small towns across the Netherlands (Brunekreef et al. 2002).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3888562/fullTextXML") coho:COHO_0000000 coho:COHO_0000324)
