ClassAssertion(Annotation(rdfs:comment "The SKLCS study of lung cancer in Korea consists of several studies conducted at multiple study centers, which have been previously described6-8 , as follows:") Annotation(oboInOwl:hasDbXref "PMID:23143601") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf") coho:COHO_0000001 coho:COHO_0002387)
ClassAssertion(Annotation(rdfs:comment "The SLESS is a prospective study that recruited 1200 consecutive black patients with stroke from a contiguous geographical area in South London in the UK, covered by three acute hospitals (Guy’s and St Thomas’ Hospitals, King’s College Hospital, and St George’s Hospital).") Annotation(oboInOwl:hasDbXref "PMID:27197724") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4873985/fullTextXML") coho:COHO_0000000 coho:COHO_0000849)
