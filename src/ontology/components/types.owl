ClassAssertion(Annotation(rdfs:comment "The Stand Up 2 Cancer/Prostate Cancer Foundation-funded West Coast Dream Team project is a prospective multi-institutional study focused on acquiring metastatic castration-resistant prostate cancer (mCRPC) biopsy tissue at the time of resistance to abiraterone or enzalutamide.") Annotation(oboInOwl:hasDbXref "PMID:28723508") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28723508+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000353)
ClassAssertion(Annotation(rdfs:comment "The Starr County Health Studies (Starr) investigates the risk factors for diabetes in Mexican-Americans [31, 32].") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML") coho:COHO_0000000 coho:COHO_0000606)
ClassAssertion(Annotation(rdfs:comment "The Stockholm Diabetes Prevention Programme (SDPP) was designed as a population- based prospective cohort, and includes 3 128 men recruited between the years 1992 and 1994 and 4821women recruited between the years 1996 and 1998.") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC8438896") coho:COHO_0000000 coho:COHO_0002360)
ClassAssertion(Annotation(rdfs:comment "The Stockholm-1 cohort (n = 5241) consisted of men who underwent a prostate biopsy during 2005 to 2007.") Annotation(oboInOwl:hasDbXref "PMID:21295399") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4417350/") coho:COHO_0000000 coho:COHO_0002710)
ClassAssertion(Annotation(rdfs:comment "The Stroke Investigative Research and Educational Network (SIREN) study is a multicentre, case-control study done at 15 sites in Nigeria and Ghana.") Annotation(oboInOwl:hasDbXref "PMID:29496511") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29496511+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000335)
ClassAssertion(Annotation(rdfs:comment "The Strong Heart Study (SHS) is a large American Indian cohort recruited from 1989 to 1991, with ongoing follow-up (phase VII).") Annotation(oboInOwl:hasDbXref "PMID:40072435") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11904716/fullTextXML") coho:COHO_0000000 coho:COHO_0000848)
ClassAssertion(Annotation(rdfs:comment "The Study of Asthma Genes and Environment Study (SAGE5 ) is a population‐based sample of 16,320 children, born in the province of Manitoba, Canada in the year of 1995.") Annotation(oboInOwl:hasDbXref "PMID:29273806") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0002338)
ClassAssertion(Annotation(rdfs:comment "The Study of Asthma-related Phenotypes and Pharmacogenomic Interactions by Race-ethnicity (SAPPHIRE) is a longitudinal cohort study of individuals with and without asthma from southeast Michigan and the Detroit metropolitan area.") Annotation(oboInOwl:hasDbXref "PMID:36403896") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC10085828/") coho:COHO_0000000 coho:COHO_0000950)
ClassAssertion(Annotation(rdfs:comment "The Study of Osteoporotic Fractures (SOF) is a prospective multicenter study of risk factors for vertebral and non-vertebral fractures 21 .") Annotation(oboInOwl:hasDbXref "PMID:37402774") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs42003-023-04869-0/MediaObjects/42003_2023_4869_MOESM2_ESM.pdf") coho:COHO_0000000 coho:COHO_0001236)
ClassAssertion(Annotation(rdfs:comment "The Study to Understand the Genetics of the Acute Response to Metformin and Glipizide in Humans (SUGAR-MGH, NCT01762046) is a novel resource of genetic and biochemical data following glipizide and metformin administration.") Annotation(oboInOwl:hasDbXref "PMID:25812009") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") coho:COHO_0000000 coho:COHO_0000546)
ClassAssertion(Annotation(rdfs:comment "The Subjective Cognitive Impairment Cohort (SCIENCe) is a prospective cohort study including consecutive patients with SCD presenting at the Alzheimer Center of the VU University Medical Center Amsterdam.") Annotation(oboInOwl:hasDbXref "PMID:30081935") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6080529/fullTextXML") coho:COHO_0000000 coho:COHO_0002351)
ClassAssertion(Annotation(rdfs:comment "The Swedish National Inpatient Register (IPR), also called the Hospital Discharge Register, is a principal source of data for numerous research projects.") Annotation(oboInOwl:hasDbXref "PMID:21658213") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21658213+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000093)
ClassAssertion(Annotation(rdfs:comment "The Swedish Twin Registry (STR), which today has developed into a unique resource, was first established in the late 1950s to study the importance of smoking and alcohol consumption on cancer and cardiovascular diseases whilst controlling for genetic propensity to disease.") Annotation(oboInOwl:hasDbXref "PMID:12270000") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12270000+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000160)
ClassAssertion(Annotation(rdfs:comment "The Swiss HIV Cohort Study (SHCS), established in 1988, is a nationwide prospective longitudinal cohort study enrolling persons with HIV in Switzerland.") Annotation(oboInOwl:hasDbXref "https://www.shcs.ch/about-shcs/study-design/") coho:COHO_0000000 coho:COHO_0001235)
ClassAssertion(Annotation(rdfs:comment "The Swiss Pediatric Sepsis Study was a nationwide, prospective, multicentre cohort conducted from September 1, 2011, to December 31, 2015, across 10 tertiary and regional paediatric hospitals in Switzerland, including all five university centres and all paediatric intensive care units.") Annotation(oboInOwl:hasDbXref "PMID:42241732") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC13266212") coho:COHO_0000000 coho:COHO_0001414)
ClassAssertion(Annotation(rdfs:comment "The T-1000 is a naturalistic study that will recruit, assess and longitudinally follow 1000 participants, including healthy controls and treatment-seeking individuals with mood, anxiety, substance use and eating disorders.") Annotation(oboInOwl:hasDbXref "PMID:29371263") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5786129/fullTextXML") coho:COHO_0000000 coho:COHO_0002429)
ClassAssertion(Annotation(rdfs:comment "The T2D cases were selected from UK Caucasian subjects who form part of the Diabetes UK Warren 2 repository.") Annotation(oboInOwl:hasDbXref "PMID:17554300") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2719288/") coho:COHO_0000000 coho:COHO_0000365)
ClassAssertion(Annotation(rdfs:comment "The T2D-nominated component of Metabochip comprises 21,774 variants, including 5,057 “replication” SNPs that capture the strongest, independent (CEU r2< 0.2) autosomal association signals from the GWAS meta-analysis conducted by the DIAbetes Genetics Replication and Meta-analysis (DIAGRAM) Consortium.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3442244/fullTextXML") coho:COHO_0000001 coho:COHO_0000641)
ClassAssertion(Annotation(rdfs:comment "The TARGET-C study (Comparative Evaluation of Novel Screening Strategies for Colorectal Cancer Screening) is a multicenter randomized controlled trial conducted in six study centers across five provinces in China (Jiangsu, Zhejiang, Anhui, Hunan, and Yunnan).") Annotation(oboInOwl:hasDbXref "PMID:41851747") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13123215/fullTextXML") coho:COHO_0000000 coho:COHO_0002437)
ClassAssertion(Annotation(rdfs:comment "The TEENAGE study is a cross-sectional study comprising healthy Greek adolescents.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001000996") coho:COHO_0000000 coho:COHO_0000162)
ClassAssertion(Annotation(rdfs:comment "The THRV-TOPMed study consists of three participating cohorts: The SAPPHIRe Family Cohort, TSGH (Tri-Service General Hospital, a hospital-based cohort), and TCVGH (Taichung Veterans General Hospital, another hospital-based cohort), all based in Taiwan.") Annotation(oboInOwl:hasDbXref "PMID:35183128") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8858539/supplementaryFiles") coho:COHO_0000001 coho:COHO_0000984)
ClassAssertion(Annotation(rdfs:comment "The TLCS enrolled patients with newly diagnosed and histologically confirmed primary non- small cell lung cancer from Tianjin Medical University Cancer Hospital in Tianjin, China.") Annotation(oboInOwl:hasDbXref "PMID:23143601") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf") coho:COHO_0000000 coho:COHO_0002459)
ClassAssertion(Annotation(rdfs:comment "The TRoglitazone In the Prevention Of Diabetes (TRIPOD) trial is a single-center, randomized, placebo-controlled, double-masked study.") Annotation(oboInOwl:hasDbXref "PMID:9551285") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9551285+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001036)
ClassAssertion(Annotation(rdfs:comment "The TTURC study is a randomized, placebo-controlled smoking cessation clinical trial at the University of Wisconsin Center for Tobacco Research and Intervention focusing on the genetic association of time to relapse after quitting.13") Annotation(oboInOwl:hasDbXref "PMID:35170738") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC9575976/") coho:COHO_0000000 coho:COHO_0002536)
ClassAssertion(Annotation(rdfs:comment "The Taiwan Biobank (TWB) is an ongoing prospective study of >150,000 individuals aged 20-70 in Taiwan.") Annotation(oboInOwl:hasDbXref "PMID:36776991") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36776991+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000436)
ClassAssertion(Annotation(rdfs:comment "The Taizhou Longitudinal Study (TZL) is a population-based prospective cohort initiated in 2007, recruiting over 201,000 adults aged 20-80 from urban and rural areas of Taizhou, Jiangsu Province, China.") Annotation(oboInOwl:hasDbXref "PMID:41663009") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41663009+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001426)
ClassAssertion(Annotation(rdfs:comment "The Tampere Sudden Death Study (TSDS) consists of cross-sectional population autopsy samples of deaths occurring out of hospital for any reason.") Annotation(oboInOwl:hasDbXref "PMID:39483246") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11525111/fullTextXML") coho:COHO_0000000 coho:COHO_0002471)
ClassAssertion(Annotation(rdfs:comment "The Tasmanian Longitudinal Health Study (TAHS) is a population-based cohort (n=8583) study of respiratory disease.") Annotation(oboInOwl:hasDbXref "PMID:19187325") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19187325+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002461)
ClassAssertion(Annotation(rdfs:comment "The Tasmanian Study of Cognition and Gait (TASCOG) is a population-based longitudinal cohort study of community-dwelling older individuals aged between 60 and 85 years who were randomly recruited from the Southern Tasmanian Electoral Roll, Australia between 2005 and 2012.") Annotation(oboInOwl:hasDbXref "PMID:35363862") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9434440/fullTextXML") coho:COHO_0000000 coho:COHO_0002438)
ClassAssertion(Annotation(rdfs:comment "The Tehran Lipid and Glucose Study (TLGS) is a large scale community based prospective study performed on a representative sample of residents of district-13 of Tehran, capital of Iran.") Annotation(oboInOwl:hasDbXref "PMID:19166627") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2656492/fullTextXML") coho:COHO_0000000 coho:COHO_0002460)
ClassAssertion(Annotation(rdfs:comment "The Tehran cardiometabolic genetic study (TCGS) is a large population-based cohort study that conducts periodic follow-ups.") Annotation(oboInOwl:hasDbXref "PMID:37169991") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10175059/fullTextXML") coho:COHO_0000000 coho:COHO_0002445)
ClassAssertion(Annotation(rdfs:comment "The Three-City Study (3C Study) is a population-based longitudinal study of the relation between vascular diseases and dementia in persons aged 65 years and older") Annotation(oboInOwl:hasDbXref "PMID:34654805") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8521585/fullTextXML") coho:COHO_0000000 coho:COHO_0000812)
ClassAssertion(Annotation(rdfs:comment "The ThyroidOmics Consortium was formed to study the determinants and effects of thyroid diseases and thyroid function, using various omics technologies in multiple large and well-phenotyped cohort studies.") Annotation(oboInOwl:hasDbXref "https://genepi.med.uni-greifswald.de/thyroidomics/") coho:COHO_0000001 coho:COHO_0001125)
ClassAssertion(Annotation(rdfs:comment "The Treating to New Targets (TNT) study followed 10,001 patients with clinically evident CHD and with LDLC 130 to 250 mg/dL at screen and ≤130 mg/dL following 4 weeks on treatment [21].") Annotation(oboInOwl:hasDbXref "PMID:20339536") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2842298/fullTextXML") coho:COHO_0000000 coho:COHO_0000172)
ClassAssertion(Annotation(rdfs:comment "The Treatment Options for Type 2 Diabetes in Adolescents and Youth (TODAY) study was a multicenter, randomized clinical trial funded by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK)") Annotation(oboInOwl:hasDbXref "PMID:22540912") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3478667/unicode") coho:COHO_0000000 coho:COHO_0001126)
ClassAssertion(Annotation(rdfs:comment "The Tromsø Study is a population-based prospective study with repeated health surveys in the municipality of Tromsø, Norway") Annotation(oboInOwl:hasDbXref "PMID:30271950") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC6123807/") coho:COHO_0000000 coho:COHO_0000852)
ClassAssertion(Annotation(rdfs:comment "The Trondheim PD cohort is a prospective longitudinal study of PD patients at the Department of Neurology at St. Olav’s Hospital in Trondheim, Norway") Annotation(oboInOwl:hasDbXref "PMID:38849413") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11161485/fullTextXML") coho:COHO_0000000 coho:COHO_0001424)
ClassAssertion(Annotation(rdfs:comment "The Trøndelag Health Study (the HUNT Study) is a population-based cohort study of the adult population in Trøndelag County, Norway.") Annotation(oboInOwl:hasDbXref "PMID:35578897") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9908054/fullTextXML") coho:COHO_0000000 coho:COHO_0000395)
ClassAssertion(Annotation(rdfs:comment "The Twins Early Development Study (TEDS), one of the largest twin cohorts in the world, investigates how genetic and environmental factors shape individual differences in cognitive abilities, educational achievement, behaviour and emotions in the context of typical development.") Annotation(oboInOwl:hasDbXref "PMID:31544730") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC7056571/") coho:COHO_0000000 coho:COHO_0000173)
ClassAssertion(Annotation(rdfs:comment "The Two Sister Study is a family-based retrospective study of environmental and genetic factors related to young-onset breast cancer, which was developed from the Sister Study (http://www.sisterstudy.org/2Sisters_English/2Sisters.htm).") Annotation(oboInOwl:hasDbXref "PMID:22773825") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3634553/") coho:COHO_0000000 coho:COHO_0001453)
ClassAssertion(Annotation(rdfs:comment "The UCSF adult glioma case–control study (SFAGS–GWAS) included participants of the San Francisco Bay Area Adult Glioma Study (AGS).") Annotation(oboInOwl:hasDbXref "PMID:28346443") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5558246/") coho:COHO_0000000 coho:COHO_0001481)
ClassAssertion(Annotation(rdfs:comment "The UK Adult Twin Registry (or TwinsUK Registry) is a cohort of volunteer adult twins from all over the United Kingdom.") Annotation(oboInOwl:hasDbXref "PMID:22253318") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC3600616") coho:COHO_0000000 coho:COHO_0000175)
ClassAssertion(Annotation(rdfs:comment "The UK Genetic Prostate Cancer Study is a longitudinal, multi-institutional, observational study collecting baseline and follow-up clinical data since 1992.") Annotation(oboInOwl:hasDbXref "PMID:36528478") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36528478+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002506)
ClassAssertion(Annotation(rdfs:comment "The UK Genomic Advances in Sepsis (GAinS) study has recruited a cohort of >1,400 patients with sepsis due to community-acquired pneumonia (CAP) and fecal peritonitis (FP), admitted to adult intensive care units (ICUs) across the United Kingdom.") Annotation(oboInOwl:hasDbXref "PMID:38897207") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11293594/fullTextXML") coho:COHO_0000000 coho:COHO_0000259)
ClassAssertion(Annotation(rdfs:comment "The UK Household Longitudinal Study is an infrastructure resource, in which data have been collected annually since 2009 from a sample of about 30 000 households selected to be representative of the four UK nations.") Annotation(oboInOwl:hasDbXref "PMID:42781046") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13599898/fullTextXML") coho:COHO_0000000 coho:COHO_0000179)
ClassAssertion(Annotation(rdfs:comment "The UK Millennium Cohort Study (MCS) is an observational, multidisciplinary cohort study that was set up to follow the lives of children born at the turn of the new century.") Annotation(oboInOwl:hasDbXref "PMID:24550246") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24550246+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000801)
ClassAssertion(Annotation(rdfs:comment "The UK Prospective Diabetes Study (UKPDS) is a multi-centre, prospective, randomised, intervention trial of 5100 newly-diagnosed patients with Type 2 (non-insulin-dependent) diabetes mellitus which aims to determine whether improved blood glucose control will prevent complications and reduce the associated morbidity and mortality.") Annotation(oboInOwl:hasDbXref "PMID:1778353") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1778353+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002512)
ClassAssertion(Annotation(rdfs:comment "The UK cohort consisted of a total of 5,408 case subjects from the BSSH-GODD Study and 9,961 population-based control subjects from the United Kingdom Household Longitudinal Study (UKHLS), which were divided into 4,891 control subjects for the discovery phase and 5,070 control subjects for the replication phase.") Annotation(oboInOwl:hasDbXref "PMID:28886342") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5591021/fullTextXML") coho:COHO_0000000 coho:COHO_0001293)
ClassAssertion(Annotation(rdfs:comment "The UK-BCN-MBCS is a national population-based case-control study of male breast cancer in England and Wales that was established at the Institute of Cancer Research (ICR), London, in 2007 to investigate the aetiology of breast cancer in men and to illuminate, from a novel angle, aetiology in women.") Annotation(oboInOwl:hasDbXref "PMID:32785646") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8023850/supplementaryFiles") coho:COHO_0000000 coho:COHO_0002494)
ClassAssertion(Annotation(rdfs:comment "The UK10K-cohorts arm aimed to assess the contribution of genome-wide genetic variation to a range of quantitative traits in 3,781 healthy individuals from two intensively studied British cohorts of European ancestry, namely the Avon Longitudinal Study of Parents and Children (ALSPAC)13 and TwinsUK14.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4773891/fullTextXML") coho:COHO_0000001 coho:COHO_0000348)
ClassAssertion(Annotation(rdfs:comment "The UKB Pharma Plasma Proteome (UKB-PPP) cohort comprises plasma samples from 54,219 individuals, including 46,595 randomly selected participants, 6,376 consortium-chosen individuals and 1,268 participants from a COVID-19 repeat imaging study.") Annotation(oboInOwl:hasDbXref "PMID:37794183") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10567546/fullTextXML") coho:COHO_0000000 coho:COHO_0000382)
ClassAssertion(Annotation(rdfs:comment "The UKDYS cohort includes nuclear families and singletons recruited to study the genetics of dyslexia") Annotation(oboInOwl:hasDbXref "PMID:36780127") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10330064/unicode") coho:COHO_0000000 coho:COHO_0000767)
ClassAssertion(Annotation(rdfs:comment "The UKS cohort is a thoroughly diagnosed case-control cohort from Universitatsklinikum Saarlandes, consisting of individuals clinically diagnosed with sporadic Alzheimer’s disease (N = 596; age-at-onset [mean ± SD]: 72.2 ± 6.6 years) and cognitively healthy, age-, gender-, and ethnicity-matched population-based controls (N = 170; age-at-exam: 64.1 ± 3.0 years).") Annotation(oboInOwl:hasDbXref "PMID:42237039") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-026-02583-1/MediaObjects/41588_2026_2583_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001128)
ClassAssertion(Annotation(rdfs:comment "The UM/CWRU/TARCC2 sample included 256 cases and 189 controls from the University of Miami, Case Western Reserve University, and the Texas Alzheimer’s Research Care Consortium (wave 2).") Annotation(oboInOwl:hasDbXref "PMID:39633006") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-024-02838-5/MediaObjects/41380_2024_2838_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001041)
ClassAssertion(Annotation(rdfs:comment "The UM/VU/MSSM dataset contains 1,186 cases and 1,135 CNEs (new and previously published) [15, 16, 17, 18] ascertained at the University of Miami, Vanderbilt University and Mt. Sinai School of Medicine, including 409 autopsy-confirmed cases and 136 controls, primarily from the Mt. Sinai School of Medicine [19].") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2802/MediaObjects/41588_2013_BFng2802_MOESM27_ESM.pdf") coho:COHO_0000000 coho:COHO_0002521)
ClassAssertion(Annotation(rdfs:comment "The Umeå Fracture and Osteoporosis (UFO) study is a population-based study designed to identify the genetic and environmental determinants of osteoporotic fractures.") Annotation(oboInOwl:hasDbXref "PMID:32067027") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7069346/fullTextXML") coho:COHO_0000000 coho:COHO_0000986)
ClassAssertion(Annotation(rdfs:comment "The United Kingdom Aneurysm Growth Study (UKAGS) is a prospective observational cohort study currently recruiting men with AAA identified through the English NHS AAA screening programme (NAAASP) and the Welsh AAA screening programme (WAAASP), with the aim of investigating the growth rates of small AAAs.") Annotation(oboInOwl:hasDbXref "PMID:29405273") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5817237/") coho:COHO_0000000 coho:COHO_0001427)
ClassAssertion(Annotation(rdfs:comment "The United Kingdom MAGIC study cohort was a retrospective cohort of platinum-treated pediatric cancer patients recruited between January 2012 and March 2018 at eight United Kingdom sites") Annotation(oboInOwl:hasDbXref "PMID:36699085") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9870026/fullTextXML") coho:COHO_0000000 coho:COHO_0000537)
ClassAssertion(Annotation(rdfs:comment "The United States Radiologic Technologists (USRT) study is a prospective occupational cohort composed of radiologic technologists who were certified by the American Registry of Radiologic Technologists for at least two years between 1926 and 1982.") Annotation(oboInOwl:hasDbXref "PMID:27544330") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC5071147/") coho:COHO_0000000 coho:COHO_0001244)
ClassAssertion(Annotation(rdfs:comment "The University of Manchester Longitudinal Study of Cognition in Normal Healthy Old Age (UMLCHA) recruited 6375 individuals aged 42–94 years old from Newcastle and Manchester, UK, starting in 1983 through 199324.") Annotation(oboInOwl:hasDbXref "PMID:40908294") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12411609/fullTextXML") coho:COHO_0000000 coho:COHO_0001468)
ClassAssertion(Annotation(rdfs:comment "The UroLife study (N=1,212) is a prospective multicenter cohort study conducted in 22 hospitals in the east, south and central parts of The Netherlands.") Annotation(oboInOwl:hasDbXref "https://ars.els-cdn.com/content/image/1-s2.0-S2210776226000724-mmc1.docx") coho:COHO_0000000 coho:COHO_0000661)
ClassAssertion(Annotation(rdfs:comment "The Utrecht Cannabis Cohort (UCC) consists of 1262 Dutch young adults of European ancestry aged from 18 to 25 years, recruited using a project website launched in 2006 [25].") Annotation(oboInOwl:hasDbXref "PMID:35650188") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9160238/fullTextXML") coho:COHO_0000000 coho:COHO_0002477)
