ClassAssertion(Annotation(rdfs:comment "The GALA–ALD cohort is a diagnostic-test cohort of consecutively recruited patients with a history of harmful drinking.") Annotation(oboInOwl:hasDbXref "PMID:35654907") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9205783/fullTextXML") coho:COHO_0000000 coho:COHO_0000419)
ClassAssertion(Annotation(rdfs:comment "The GAME-ON initiative is a network of five cancer specific consortiums: CORECT (ColoRectal Transdisciplinary Study); DRIVE (Discovery, Biology, and Risk of Inherited Variants in Breast Cancer); ELLIPSE (Elucidating Loci Involved in Prostate Cancer Susceptibility); FOCI-OCAC (Follow-up of Ovarian Cancer Genetic Association and Interaction Studies of the Ovarian Cancer Association Consortium)") Annotation(oboInOwl:hasDbXref "PMID:29089348") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5666592/fullTextXML") coho:COHO_0000001 coho:COHO_0001329)
ClassAssertion(Annotation(rdfs:comment "The GAPC cases and the Irish and Spanish controls were genotyped at the Wellcome Trust Sanger Institute (WTSI) and all samples were provided by the relevant groups given in Supplementary Table 2 and listed in the GAP consortium members list (Supplementary Note 2).") Annotation(oboInOwl:hasDbXref "PMID:23143594") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3510312/fullTextXML") coho:COHO_0000001 coho:COHO_0001332)
ClassAssertion(Annotation(rdfs:comment "The GARD cohort was established in 2013 as a large‐scale, community‐based prospective study to investigate early risk and protective factors across the AD spectrum.") Annotation(oboInOwl:hasDbXref "PMID:41537461") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12805525/fullTextXML") coho:COHO_0000000 coho:COHO_0001755)
ClassAssertion(Annotation(rdfs:comment "The GDS enrolled cases and controls from the Guangdong area of China.") Annotation(oboInOwl:hasDbXref "PMID:23143601") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf") coho:COHO_0000000 coho:COHO_0001764)
ClassAssertion(Annotation(rdfs:comment "The GECCO coordinating center manages individual level genetic and epidemiological data of over 130,000 participants from 70 studies from North America, Australia, Asia, and Europe.") Annotation(oboInOwl:hasDbXref "https://www.fredhutch.org/en/research/divisions/public-health-sciences-division/research/cancer-prevention/genetics-epidemiology-colorectal-cancer-consortium-gecco.html") coho:COHO_0000001 coho:COHO_0000610)
ClassAssertion(Annotation(rdfs:comment "The GECKO (Groningen Expert Center for Kids with Obesity) Drenthe study is a population-based birth cohort with a focus on early risk factors for overweight and obesity.") Annotation(oboInOwl:hasDbXref "PMID:35778749") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9250228/fullTextXML") coho:COHO_0000000 coho:COHO_0000908)
ClassAssertion(Annotation(rdfs:comment "The GEL-S study is a case-control study carried out in the 5 major public-sector hospitals in Singapore5 (Changi General Hospital, National Cancer Centre, National University Hospital, Singapore General Hospital and Tan Tock Seng Hospital).") Annotation(oboInOwl:hasDbXref "PMID:23143601") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf") coho:COHO_0000000 coho:COHO_0001769)
ClassAssertion(Annotation(rdfs:comment "The GENOA and POST studies are prospective cohort studies conducted in collaboration with the Canadian Addiction Treatment Centre (CATC) and McMaster University.") Annotation(oboInOwl:hasDbXref "PMID:38102185") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10724251/fullTextXML") coho:COHO_0000000 coho:COHO_0000467)
