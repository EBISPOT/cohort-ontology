ClassAssertion(Annotation(rdfs:comment "The IEGC is a collaborative effort that aggregates data from multiple international studies to investigate the genetic factors of endometriosis4.") Annotation(oboInOwl:hasDbXref "PMID:42056605") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC13195585/") coho:COHO_0000001 coho:COHO_0001090)
ClassAssertion(Annotation(rdfs:comment "The IGGC is a large international consortium established to identify glaucoma genetic risk genes through large-scale meta-analysis43,44.") Annotation(oboInOwl:hasDbXref "PMID:37386247") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10335935/fullTextXML") coho:COHO_0000001 coho:COHO_0000916)
