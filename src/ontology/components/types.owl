ClassAssertion(Annotation(rdfs:comment "The National Alzheimer’s Coordinating Center (NACC) functions as the centralized data repository, and collaboration and communication hub, for the National Institute on Aging’s (NIA) Alzheimer’s Disease Research Centers (ADRC) Program.") Annotation(oboInOwl:hasDbXref "https://naccdata.org/") coho:COHO_0000001 coho:COHO_0000480)
