ClassAssertion(Annotation(rdfs:comment "The study included two population-based prospective cohorts: the Cohort of Swedish Men (COSM) and the Swedish Mammography Cohort (SMC).") Annotation(oboInOwl:hasDbXref "PMID:40783417") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12335436/fullTextXML") coho:COHO_0000000 coho:COHO_0000820)
ClassAssertion(Annotation(rdfs:comment "The study is a consortium project consisting of six prospective cohort studies that would be categorized into population-based and gene-environment model studies (Figure 1).") Annotation(oboInOwl:hasDbXref "PMID:27085081") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837648/fullTextXML") coho:COHO_0000001 coho:COHO_0000411)
ClassAssertion(Annotation(rdfs:comment "The study is a multi-centred randomised controlled trial (shown in figure 1) in which patients with depression, recruited in primary care, were randomly allocated to either an NaRI (Reboxetine) or an SSRI (Citalopram).") Annotation(oboInOwl:hasDbXref "PMID:18498636") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2426669/fullTextXML") coho:COHO_0000000 coho:COHO_0000962)
ClassAssertion(Annotation(rdfs:comment "The study participants for the discovery analysis were from a hospital-based case–control study of CM, for which cases were recruited from non-Hispanic white patients and controls at MD Anderson between March 1998 and August 2008.") Annotation(oboInOwl:hasDbXref "PMID:21926416") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3298855/") coho:COHO_0000000 coho:COHO_0000875)
