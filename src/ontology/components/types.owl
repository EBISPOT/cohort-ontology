ClassAssertion(Annotation(rdfs:comment "We set up 140,420 cohort subjects (68,722 men and 71,698 women) (61,595 in 1990 as Cohort I and 78,825 in 1993 as Cohort II) based on resident registry of 29 districts under 11 Public Health Center areas and baseline survey were submitted for them.") Annotation(oboInOwl:hasDbXref "PMID:11763136") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11763136+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000783)
ClassAssertion(Annotation(rdfs:comment "We started two prospective cohort studies in Miyagi and Iwate Prefectures: a population-based adult cohort study, the TMM Community-Based Cohort Study (TMM CommCohort Study), which will recruit 80 000 participants, and a birth and three-generation cohort study, the TMM Birth and Three-Generation Cohort Study (TMM BirThree Cohort Study)") Annotation(oboInOwl:hasDbXref "PMID:27374138") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5008970/fullTextXML") coho:COHO_0000001 coho:COHO_0000533)
