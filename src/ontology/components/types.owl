ClassAssertion(Annotation(rdfs:comment "The sample consisted of a cohort of community adults (n = 1388) who completed a one-time in-person assessment as part of enrollment in a health research registry at St. Joseph's Healthcare Hamilton.") Annotation(oboInOwl:hasDbXref "PMID:35080193") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10009385/fullTextXML") coho:COHO_0000000 coho:COHO_0000657)
