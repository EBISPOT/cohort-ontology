ClassAssertion(Annotation(rdfs:comment "The Walk-PHaSST study was designed to assemble a large cohort of patients with SCD and to screen their eligibility for a randomized clinical trial of sildenafil via echocardiographic and laboratory screening for pulmonary hypertension.") Annotation(oboInOwl:hasDbXref "PMID:32776978") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7416942/fullTextXML") coho:COHO_0000000 coho:COHO_0000805)
ClassAssertion(Annotation(rdfs:comment "The Weiss Laboratory Autism Collections are a combination of Californian cohorts including the UCSF/Weiss (42 trios, 13 cases), UCSF/Hendren") Annotation(oboInOwl:hasDbXref "PMID:28540026") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1186%2Fs13229-017-0137-9/MediaObjects/13229_2017_137_MOESM1_ESM.docx") coho:COHO_0000001 coho:COHO_0002575)
ClassAssertion(Annotation(rdfs:comment "The Western Australia Sleep Health Study (WASHS) is a prospective cohort study of patients referred to the sole public sleep clinic in Western Australia.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3498243/") coho:COHO_0000000 coho:COHO_0000580)
