ClassAssertion(Annotation(rdfs:comment "The specific samples examined are: (1) 90 individuals (30 parent–offspring trios) from the Yoruba in Ibadan, Nigeria (abbreviation YRI); (2) 90 individuals (30 trios) in Utah, USA, from the Centre d’Etude du Polymorphisme Humain collection (abbreviation CEU); (3) 45 Han Chinese in Beijing, China (abbreviation CHB); (4) 44 Japanese in Tokyo, Japan (abbreviation JPT).") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC1880871/") coho:COHO_0000000 coho:COHO_0000637)
ClassAssertion(Annotation(rdfs:comment "The specific samples examined are: (1) 90 individuals (30 parent–offspring trios) from the Yoruba in Ibadan, Nigeria (abbreviation YRI); (2) 90 individuals (30 trios) in Utah, USA, from the Centre d’Etude du Polymorphisme Humain collection (abbreviation CEU); (3) 45 Han Chinese in Beijing, China (abbreviation CHB); (4) 44 Japanese in Tokyo, Japan (abbreviation JPT).") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC1880871/") coho:COHO_0000000 coho:COHO_0000638)
ClassAssertion(Annotation(rdfs:comment "The specificities of this sample, such as its well-defined job hierarchy, make it a particularly valuable occupational cohort.") Annotation(oboInOwl:hasDbXref "PMID:25194498") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25194498+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000521)
