ClassAssertion(Annotation(rdfs:comment "The NCRCC study includes the Colorectal Cancer Screening Cohort (CRCSC), which recruited individuals who were at high risk of CRC between 2016 and 2020 and Colorectal Cancer Patients Cohort (CRCPC), which recruited newly diagnosed patients with CRC between 2015 and 2020.") Annotation(oboInOwl:hasDbXref "PMID:34903541") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8672005/fullTextXML") coho:COHO_0000000 coho:COHO_0002127)
