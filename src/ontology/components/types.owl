ClassAssertion(Annotation(rdfs:comment "We randomly assigned 500 patients with asthma that was well controlled by inhaled fluticasone (100 microg twice daily) to receive continued fluticasone (100 microg twice daily) (169 patients), montelukast (5 or 10 mg each night) (166 patients), or fluticasone (100 microg) plus salmeterol (50 microg) each night (165 patients).") Annotation(oboInOwl:hasDbXref "PMID:17507702") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17507702+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002011)
