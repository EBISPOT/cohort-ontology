ClassAssertion(Annotation(rdfs:comment "The LifeLines Cohort Study is a large population-based cohort study and biobank that was established as a resource for research on complex interactions between environmental, phenotypic and genomic factors in the development of chronic diseases and healthy ageing.") Annotation(oboInOwl:hasDbXref "PMID:25502107") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25502107+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000108)
