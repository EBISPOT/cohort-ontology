ClassAssertion(Annotation(rdfs:comment "We conducted the largest severe asthma GWAS to date in a cohort of 933 cases defined by GINA steps three or above for severity and 3346 clean controls to determine if there are common genetic polymorphisms contributing to susceptibility to severe asthma.") Annotation(oboInOwl:hasDbXref "PMID:22561531") Annotation(oboInOwl:hasDbXref "https://thorax.bmj.com/content/67/9/762") coho:COHO_0000000 coho:COHO_0001502)
ClassAssertion(Annotation(rdfs:comment "We conducted this study among PWH in the CNICS cohort [12], a well-characterized longitudinal observational cohort of PWH who enrolled in care at eight geographically distinct HIV clinics in the US from January 1995 through June 2020 at which time the data was accessed (http://www.uab.edu/cnics/).") Annotation(oboInOwl:hasDbXref "PMID:37796845") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10553320/fullTextXML") coho:COHO_0000000 coho:COHO_0000746)
