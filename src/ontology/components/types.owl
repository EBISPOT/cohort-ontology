ClassAssertion(Annotation(rdfs:comment "The APCDR cohort comprises four studies: the Ugandan Genome Resource (UGR), the Durban Diabetes Study (DDS), the Durban Case–Control Study (DCC), and the Africa America Diabetes Mellitus Study (AADM).") Annotation(oboInOwl:hasDbXref "PMID:34925446") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8674726/fullTextXML") coho:COHO_0000001 coho:COHO_0000215)
