ClassAssertion(Annotation(rdfs:comment "These populations belong to the INGI (Italian Network of Genetic Isolates) network.") Annotation(oboInOwl:hasDbXref "PMID:31784700") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7080768/fullTextXML") coho:COHO_0000001 coho:COHO_0000105)
