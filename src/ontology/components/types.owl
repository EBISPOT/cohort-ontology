ClassAssertion(Annotation(rdfs:comment "The Shanghai Men's Health Study (SMHS) is a population-based cohort study of 61,480 men aged 40-74 years, launched in 2002 in urban Shanghai to investigate the contribution of lifestyle/environmental factors and genetic susceptibility to cancer and other non-communicable diseases (NCDs).") Annotation(oboInOwl:hasDbXref "PMID:25733578") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25733578+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000578)
