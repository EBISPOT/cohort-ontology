ClassAssertion(Annotation(rdfs:comment "The VHM&PP is a population-based risk factor surveillance programme in Vorarlberg, the westernmost province in Austria.12") Annotation(oboInOwl:hasDbXref "PMID:19380371") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2878454/fullTextXML") coho:COHO_0000000 coho:COHO_0002699)
ClassAssertion(Annotation(rdfs:comment "The VHS is an ongoing survey that uses cross‐sectional and prospective designs aimed to search for new risk factors for CAD in patients using objective, angiographic documentation of their coronary vessels.") Annotation(oboInOwl:hasDbXref "PMID:30646800") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6497332/fullTextXML") coho:COHO_0000000 coho:COHO_0002546)
ClassAssertion(Annotation(rdfs:comment "The VHSMC cohort is a hospital-based elderly cohort that includes many patients with various diseases.") Annotation(oboInOwl:hasDbXref "PMID:35241739") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8894365/fullTextXML") coho:COHO_0000000 coho:COHO_0000653)
ClassAssertion(Annotation(rdfs:comment "The VIP is an ongoing population-based cohort study initiated in 1985 in which all residents of Västerbotten County, Sweden, are invited to receive a health examination at ages 40, 50, and 60 with blood drawn for cryopreservation.") Annotation(oboInOwl:hasDbXref "PMID:35396534") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8993880/fullTextXML") coho:COHO_0000000 coho:COHO_0002549)
ClassAssertion(Annotation(rdfs:comment "The Vanderbilt Memory & Aging Project is a case-control longitudinal study investigating vascular health and brain aging launched in September 2012 at Vanderbilt University Medical Center in Nashville, TN.") Annotation(oboInOwl:hasDbXref "PMID:26967211") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4866875/unicode") coho:COHO_0000000 coho:COHO_0000804)
ClassAssertion(Annotation(rdfs:comment "The Vantaa 85+ study includes all 601 persons aged 85 years or over who were living in the city of Vantaa (Southern Finland), on 1 April 1991.") Annotation(oboInOwl:hasDbXref "PMID:26401513") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4574809/fullTextXML") coho:COHO_0000000 coho:COHO_0002538)
ClassAssertion(Annotation(rdfs:comment "The Vascular Disease Biorepository at Mayo Clinic was established to archive DNA, plasma, and serum from patients with suspected AVD.") Annotation(oboInOwl:hasDbXref "PMID:24689004") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24689004+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001370)
ClassAssertion(Annotation(rdfs:comment "The Vascular Research Consortium of New Zealand recruited New Zealand men and women with a proven history of AAA (infra-renal aortic diameter ≥ 30 mm proven on ultrasound or CT scan).") Annotation(oboInOwl:hasDbXref "PMID:37845353") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10632148/supplementaryFiles") coho:COHO_0000000 coho:COHO_0001386)
ClassAssertion(Annotation(rdfs:comment "The Vejle Diabetes Biobank represents one of the largest open diabetes case-control cohorts in Denmark.") Annotation(oboInOwl:hasDbXref "PMID:27799821") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5085288/fullTextXML") coho:COHO_0000000 coho:COHO_0002542)
ClassAssertion(Annotation(rdfs:comment "The Viborg Vascular (VIVA) screening trial is a randomized, clinically controlled study designed to evaluate the benefits of vascular screening and modern vascular prophylaxis in a population of 50,000 men aged 65-74 years.") Annotation(oboInOwl:hasDbXref "PMID:20507582") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2891736/fullTextXML") coho:COHO_0000000 coho:COHO_0001129)
ClassAssertion(Annotation(rdfs:comment "The Vietnam Era Twin Study of Aging (VETSA) is a longitudinal behavioral genetic study with a primary focus on cognitive and brain aging in men, particularly early identification of risk for mild cognitive impairment (MCI) and Alzheimer's disease (AD).") Annotation(oboInOwl:hasDbXref "PMID:31933447") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31933447+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001246)
ClassAssertion(Annotation(rdfs:comment "The Viking Health Study Shetland is a population-based research cohort of 2,122 volunteer participants with ancestry from the Shetland Isles in northern Scotland.") Annotation(oboInOwl:hasDbXref "PMID:31358886") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31358886+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000181)
ClassAssertion(Annotation(rdfs:comment "The Virginia Twin Study of Adolescent Behavioral Development is a cohort-longitudinal epidemiological study that uses the genetic twin design to study the development and maintenance of child psychiatric disorders.") Annotation(oboInOwl:hasDbXref "PMID:9294370") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9294370+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001248)
ClassAssertion(Annotation(rdfs:comment "The Vitamin Intervention for Stroke Prevention (VISP) study is a double-masked, randomized, multicenter clinical trial designed to determine if, in addition to best medical/surgical management, high-dose folic acid, vitamin B6, and vitamin B12 supplements will reduce recurrent stroke compared to lower doses of these vitamins.") Annotation(oboInOwl:hasDbXref "PMID:11174041") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11174041+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001038)
ClassAssertion(Annotation(rdfs:comment "The Viva la Familia cohort consisted of 1030 children from 319 families selected based on an overweight proband between the ages of 4 and 19 y.") Annotation(oboInOwl:hasDbXref "PMID:16960181") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16960181+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001431)
ClassAssertion(Annotation(rdfs:comment "The Vlagtwedde-Vlaardingen study is a general population based study on the epidemiology of pulmonary diseases in a general population of exclusively white individuals of Dutch descent [18,19].") Annotation(oboInOwl:hasDbXref "PMID:27055053") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4824471/fullTextXML") coho:COHO_0000000 coho:COHO_0002552)
ClassAssertion(Annotation(rdfs:comment "The Vobarno Study represents the first observational study aimed to assess in a general population sample the relationship between parameters of cardiac and vascular structure (and function) and blood pressure values, measured in the clinic and during the 24 hours.") Annotation(oboInOwl:hasDbXref "PMID:33988330") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33988330+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002551)
ClassAssertion(Annotation(rdfs:comment "The WAABCS is a hospital-based case-control study originally started in Nigeria in 1998 and was expanded to Uganda and Cameroon in 2011 with the same questionnaires and protocol31,32 .") Annotation(oboInOwl:hasDbXref "PMID:38741014") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001039)
ClassAssertion(Annotation(rdfs:comment "The WADRC, previously described92, is a longitudinal cohort study of memory, aging, and AD in middle and older-aged adults who were recruited into one of six subgroups: (1) mild late-onset AD; (2) mild cognitive impairment (MCI); (3) age-matched healthy older controls (age > 65);") Annotation(oboInOwl:hasDbXref "PMID:33437055") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7803963/fullTextXML") coho:COHO_0000000 coho:COHO_0000414)
ClassAssertion(Annotation(rdfs:comment "The WECARE Study is a multi-center, population-based case–control study of CBC conducted in two phases: the WECARE I Study (2001–2004) and WECARE II Study (2009–2012) [12, 13].") Annotation(oboInOwl:hasDbXref "PMID:38263039") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10807183/fullTextXML") coho:COHO_0000000 coho:COHO_0001434)
