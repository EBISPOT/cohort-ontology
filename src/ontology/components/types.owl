ClassAssertion(Annotation(rdfs:comment "In this final phase, individuals were sampled from 26 populations in Africa (AFR), East Asia (EAS), Europe (EUR), South Asia (SAS), and the Americas (AMR) (Fig. 1a; see Supplementary Table 1 for population descriptions and abbreviations).") Annotation(oboInOwl:hasDbXref "PMID:26432245") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC4750478") coho:COHO_0000000 coho:COHO_0000002)
