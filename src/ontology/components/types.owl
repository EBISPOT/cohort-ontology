ClassAssertion(Annotation(rdfs:comment "We conducted a randomized, double-masked, placebo-controlled trial in 489 participants with poorly controlled asthma randomly assigned to placebo, theophylline (300 mg/d), or montelukast (10 mg/d).") Annotation(oboInOwl:hasDbXref "PMID:16998094") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16998094+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002012)
