ClassAssertion(Annotation(rdfs:comment "We used data from the Melbourne Collaborative Cohort Study (MCCS), a prospective study that recruited 41,513 middle-aged and older Australians (99 % aged between 40 and 69 years, 59 % females) of white European origin between 1990 and 1994 (baseline)") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12490524/fullTextXML") coho:COHO_0000000 coho:COHO_0000523)
ClassAssertion(Annotation(rdfs:comment "We used data from the Rhineland Study, an ongoing population-based cohort study in Bonn, Germany, to perform a GWAS on circulating complex lipid levels and composition measured using the Metabolon Complex Lipids Platform.") Annotation(oboInOwl:hasDbXref "PMID:42069741") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13135507/fullTextXML") coho:COHO_0000000 coho:COHO_0000386)
ClassAssertion(Annotation(rdfs:comment "We used data from two general population birth cohort studies, Northern Finland Birth Cohorts 1966 and 1986 (NFBC1966 and NFBC1986).") Annotation(oboInOwl:hasDbXref "PMID:39820013") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12095082/fullTextXML") coho:COHO_0000001 coho:COHO_0000435)
ClassAssertion(Annotation(rdfs:comment "We used data from two timepoints from the Koala Birth Cohort Study, a prospective cohort study in the Netherlands [29].") Annotation(oboInOwl:hasDbXref "PMID:42116128") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13335302/fullTextXML") coho:COHO_0000000 coho:COHO_0000922)
ClassAssertion(Annotation(rdfs:comment "We used optimized VBM to evaluate structural MRI data from the CBDB/NIMH Genetic Study of Schizophrenia, an ongoing family study aimed at identifying biologic intermediate phenotypes and ultimately risk genes for the illness (24).") Annotation(oboInOwl:hasDbXref "PMID:17689500") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2390785/") coho:COHO_0000000 coho:COHO_0001760)
ClassAssertion(Annotation(rdfs:comment "We used the Rome Longitudinal Study, the administrative cohort of residents in Rome who filled in the 2001 population census.") Annotation(oboInOwl:hasDbXref "PMID:35641005") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9157355/fullTextXML") coho:COHO_0000000 coho:COHO_0002638)
ClassAssertion(Annotation(rdfs:comment "We used three T2D case-control studies (Cambridgeshire, ADDITION-Ely, and Norfolk Diabetes) and the population-based EPIC-Norfolk cohort for genetic analysis, and the EPIC-Norfolk cohort for blood-based analysis.") Annotation(oboInOwl:hasDbXref "PMID:22039354") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3201934/fullTextXML") coho:COHO_0000000 coho:COHO_0001686)
ClassAssertion(Annotation(rdfs:comment "We used whole genome sequencing (WGS) data from the Canadian Epilepsy Network (CENet) cohort to investigate deleterious rare functional variants in epileptic patients [23].") Annotation(oboInOwl:hasDbXref "PMID:37756314") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC10529579") coho:COHO_0000000 coho:COHO_0000233)
ClassAssertion(Annotation(rdfs:comment "We utilized control subjects who were part of a larger study on the genetics of Fuchs‟ Endothelial Corneal Dystrophy (FECD)10 .") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0127-7/MediaObjects/41588_2018_127_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001722)
ClassAssertion(Annotation(rdfs:comment "We utilized data from the Moli-sani Study, a population-based cohort established between 2005 and 2010, comprising 24,325 men and women aged ≥35 years residing in the Southern Italian region of Molise.") Annotation(oboInOwl:hasDbXref "PMID:39010980") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11247150/fullTextXML") coho:COHO_0000000 coho:COHO_0002631)
ClassAssertion(Annotation(rdfs:comment "We utilized data from the Osteoarthritis Initiative (OAI), a publicly available, multicentre, observational cohort study of risk factors for knee OA.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8487312/fullTextXML") coho:COHO_0000000 coho:COHO_0000594)
ClassAssertion(Annotation(rdfs:comment "We were able to take advantage of the UK National Health Service (NHS) research infrastructure to recruit from primary care (Methods) using body mass index (BMI: weight in kg/height in metres2) criteria and personal review of individual case files to identify a cohort of approximately 2000 UK European descent thin adults (Study Into Lean and Thin Subjects, STILTS cohort; mean BMI = 17.6 kg/m2) who are well, without medical conditions or eating disorders (Methods).") Annotation(oboInOwl:hasDbXref "PMID:30677029") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6345421/fullTextXML") coho:COHO_0000000 coho:COHO_0000336)
