ClassAssertion(Annotation(rdfs:comment "The study employs a longitudinal cohort design with baseline data assessment and follow-up 1 year later.") Annotation(oboInOwl:hasDbXref "PMID:35041012") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8960581/fullTextXML") coho:COHO_0000000 coho:COHO_0001533)
