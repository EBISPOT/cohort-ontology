ClassAssertion(Annotation(rdfs:comment "The MS subjects were recruited from three clinical sites: 453 cases from the UK (IMSGC UK) and 342 cases from the US (IMSGC US); the remaining 860 MS patients were recruited at Partners MS Center in Boston, MA (BWH).") Annotation(oboInOwl:hasDbXref "PMID:21654844") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3640650/unicode") coho:COHO_0000000 coho:COHO_0001916)
