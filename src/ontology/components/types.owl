ClassAssertion(Annotation(rdfs:comment "The study participants were part of the China Medical University Hospital (CMUH) Precision Medicine Project, a systemic effort initiated in 2018 to recruit subjects and collect biospecimens from all patients who come to CMUH for medical visits [69,70].") Annotation(oboInOwl:hasDbXref "PMID:36769103") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9917812/fullTextXML") coho:COHO_0000000 coho:COHO_0000399)
ClassAssertion(Annotation(rdfs:comment "The study population comprised 3170 participants from the Neuro-Ophthalmology Research at Fundació ACE (NORFACE) cohort, which was founded in 2014 to search for retinal biomarkers of AD and examine the relationships between retinal changes and different types of neurodegenerative disorders [12].") Annotation(oboInOwl:hasDbXref "PMID:38365752") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10870444/fullTextXML") coho:COHO_0000000 coho:COHO_0001215)
ClassAssertion(Annotation(rdfs:comment "The study population comprised 6,034 cases and 6,585 controls derived from 12 epidemiological studies, the majority of case-control design and part of the International Head and Neck Cancer Epidemiology Consortium (INHANCE).") Annotation(oboInOwl:hasDbXref "PMID:27749845") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5131845/fullTextXML") coho:COHO_0000001 coho:COHO_0001922)
ClassAssertion(Annotation(rdfs:comment "The study population consisted of 1,232 participants in the Oxford Regional Prospective Study (ORPS, n = 418) and Nephropathy Family Study (NFS, n = 814) with more than one A1C assessment, representing 84% of the whole cohorts.") Annotation(oboInOwl:hasDbXref "PMID:21335371") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3064014/fullTextXML") coho:COHO_0000001 coho:COHO_0001379)
ClassAssertion(Annotation(rdfs:comment "The study population consisted of 3938 patients with newly diagnosed lung cancer and 1700 population-based controls.") Annotation(oboInOwl:hasDbXref "PMID:21342495") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3048494/fullTextXML") coho:COHO_0000000 coho:COHO_0001600)
ClassAssertion(Annotation(rdfs:comment "The study population consists of female participants from the Swedish Mammography Cohort (SMC) and male participants from the Cohort of Swedish Men (COSM), both of which are population–based prospective cohort studies in Central Sweden and part of the national research infrastructure SIMPLER (Swedish Infrastructure for Medical Population-based Life-course Environmental Research).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11663681/fullTextXML") coho:COHO_0000000 coho:COHO_0000577)
ClassAssertion(Annotation(rdfs:comment "The study population for this analysis included patients diagnosed with CRC and recruited in the DACHS study (Darmkrebs: Chancen der Verhütung durch Screening), an ongoing multi-center population-based case-control study with additional active follow-up of cases conducted in the Rhine-Neckar region in the South of Germany.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5946295/fullTextXML") coho:COHO_0000000 coho:COHO_0000556)
ClassAssertion(Annotation(rdfs:comment "The study population included two groups: 451 patients with type 1 diabetes and diabetic nephropathy and 440 control subjects with type 1 diabetes for >15 years and persistent normoalbuminuria.") Annotation(oboInOwl:hasDbXref "PMID:20357380") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2890360/fullTextXML") coho:COHO_0000000 coho:COHO_0001478)
ClassAssertion(Annotation(rdfs:comment "The study population represents a cross-sectional analysis from the cohorts SHIP-START (recruited 1997-2001) and SHIP-TREND (recruited 2008-2012), sampled for baseline investigations (SHIP-START-0 and SHIP-TREND-0) at the age of 20-79 years.") Annotation(oboInOwl:hasDbXref "PMID:39085387") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39085387+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000410)
ClassAssertion(Annotation(rdfs:comment "The study population was composed of young people with type 1 diabetes and their parents recruited in the Nephropathy Family Study (NFS).") Annotation(oboInOwl:hasDbXref "PMID:19918004") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2809284/fullTextXML") coho:COHO_0000000 coho:COHO_0001380)
ClassAssertion(Annotation(rdfs:comment "The study population was derived from the Black Women with Breast Cancer: Etiology, Survival, and Treatment Outcomes (BEST) study, a population-based longitudinal cohort of self-identified Black women diagnosed with invasive breast cancer at or below age 50 between 2005 and 2018.") Annotation(oboInOwl:hasDbXref "PMID:41360000") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12686358/fullTextXML") coho:COHO_0000000 coho:COHO_0001525)
