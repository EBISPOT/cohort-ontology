ClassAssertion(Annotation(rdfs:comment "The Memory and Aging Project is a longitudinal, epidemiologic clinical-pathologic cohort study of common chronic conditions of aging with an emphasis on decline in cognitive and motor function and risk of Alzheimer's disease (AD).") Annotation(oboInOwl:hasDbXref "PMID:22471867") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22471867+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000810)
ClassAssertion(Annotation(rdfs:comment "The Mental Illness and Neuroscience Discovery Institute, now the Mind Research Network (MRN, www.mrn.org), comprised of investigators at the University of New Mexico, the University of Minnesota, Massachusetts General Hospital, and the University of Iowa, conducted a cross-sectional study to identify quantitative neuroimaging biomarkers of schizophrenia.") Annotation(oboInOwl:hasDbXref "PMID:23760817") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3727653/unicode") coho:COHO_0000000 coho:COHO_0002042)
ClassAssertion(Annotation(rdfs:comment "The Metabolic Syndrome in Men (METSIM) study is a population-based study including 10,197 Finnish men examined in 2005-2010.") Annotation(oboInOwl:hasDbXref "PMID:28119442") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28119442+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000393)
ClassAssertion(Annotation(rdfs:comment "The Mexican-American Coronary Artery Disease (MACAD) Study was designed as a family study to examine the genetic basis of coronary artery disease and insulin resistance.") Annotation(oboInOwl:hasDbXref "PMID:24124113") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3968231/unicode") coho:COHO_0000000 coho:COHO_0000686)
ClassAssertion(Annotation(rdfs:comment "The Miami Stroke Registry is a prospective registry which offers enrollment to consecutive patients admitted with a diagnosis of stroke/transient ischemic attack.") Annotation(oboInOwl:hasDbXref "PMID:25041610") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25041610+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000786)
ClassAssertion(Annotation(rdfs:comment "The Mid-Atlantic Twin Registry (MATR) is a population-based registry of twins and their families that was formed through the convergence of the Virginia Twin Registry (est. circa 1975) and the North Carolina Twin Registry in 1997 and the addition of South Carolina in 1998.") Annotation(oboInOwl:hasDbXref "PMID:31608855") Annotation(oboInOwl:hasDbXref "https://www.cambridge.org/core/journals/twin-research-and-human-genetics/article/midatlantic-twin-registry-of-virginia-commonwealth-university/D6A17F0CECC43803BF9437EDDC2061EB") coho:COHO_0000000 coho:COHO_0002034)
ClassAssertion(Annotation(rdfs:comment "The Midspan Family Study is a general population survey of 1477 Caucasian families in Renfrew and Paisley (Scotland), which included 15 402 participants in the first, parental, generation (aged 45–64 years) surveyed between 1972 and 1976.") Annotation(oboInOwl:hasDbXref "PMID:26525718") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4636631/fullTextXML") coho:COHO_0000000 coho:COHO_0002068)
