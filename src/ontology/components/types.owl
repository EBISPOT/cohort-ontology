ClassAssertion(Annotation(rdfs:comment "In the Monitoring Project on Chronic Disease Risk Factors (MORGEN-project), baseline cardiovascular risk factor data were collected in 1993–1997 in 22 769 men and women aged 20–65 years [23], [24].") Annotation(oboInOwl:hasDbXref "PMID:22194890") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3241680/fullTextXML") coho:COHO_0000000 coho:COHO_0002612)
ClassAssertion(Annotation(rdfs:comment "In the South Stockholm Ischemic Stroke Study, 928 ICVD patients and 602 controls were genotyped for 100 different gene polymorphisms.") Annotation(oboInOwl:hasDbXref "PMID:22784820") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22784820+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002409)
ClassAssertion(Annotation(rdfs:comment "In the UK Biobank Lung Exome Variant Evaluation (UK BiLEVE) study, we undertook nested case-control studies in individuals of European ancestry from UK Biobank") Annotation(oboInOwl:hasDbXref "PMID:26423011") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4593935/fullTextXML") coho:COHO_0000000 coho:COHO_0002495)
ClassAssertion(Annotation(rdfs:comment "In the Uppsala Longitudinal Study of Adult Men study, 2322 men, all aged 50 years, were assessed for CVD risk factors and then followed for four decades regarding incident CVDs.") Annotation(oboInOwl:hasDbXref "PMID:34518286") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8438838/fullTextXML") coho:COHO_0000000 coho:COHO_0000194)
ClassAssertion(Annotation(rdfs:comment "In the cardiometabolic risk in Chinese (CRC) study, we performed a community-based health examination survey for 6,431 individuals (18-93y) who were randomly selected from residents living in the urban area of Xuzhou, China, in 2009.") Annotation(oboInOwl:hasDbXref "PMID:25001365") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4100564/fullTextXML") coho:COHO_0000000 coho:COHO_0000903)
ClassAssertion(Annotation(rdfs:comment "In the context of the MESOMICS project, we have performed the most comprehensive molecular characterization of MPM to date, with the underlying dataset made of the largest whole-genome sequencing series yet reported, together with transcriptome sequencing and methylation arrays for 120 MPM patients.") Annotation(oboInOwl:hasDbXref "PMID:36705549") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9881451/fullTextXML") coho:COHO_0000000 coho:COHO_0000299)
ClassAssertion(Annotation(rdfs:comment "In the current study, we used the GenMets sample, which includes individuals with metabolic syndrome and matched control subjects drawn from the Health 2000 study.") Annotation(oboInOwl:hasDbXref "PMID:24969107") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4237993/fullTextXML") coho:COHO_0000000 coho:COHO_0000453)
ClassAssertion(Annotation(rdfs:comment "In the discovery phase, we analyzed 315,450 tagging SNPs in 1,154 current and former (ever) smoking cases of European ancestry and 1,137 frequency-matched, ever-smoking controls from Houston, Texas.") Annotation(oboInOwl:hasDbXref "PMID:18385676") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18385676+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000874)
ClassAssertion(Annotation(rdfs:comment "In the discovery stage 1 of AAAGC, 17 GWAS of up to 42,752 AA individuals (16,559 men and 26,193 women; 41,696 African Americans and 1,056 Africans) were included for the BMI analyses.") Annotation(oboInOwl:hasDbXref "PMID:28430825") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5419579/fullTextXML") coho:COHO_0000001 coho:COHO_0000893)
ClassAssertion(Annotation(rdfs:comment "In the first GWAS stage, 1,049 colorectal cancer cases were enrolled from the Cancer Center of Nanjing Medical University and 1,315 controls were from the same districts of Nanjing beginning in September 2010 (Nanjing-1).") Annotation(oboInOwl:hasDbXref "PMID:27145994") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4858728/fullTextXML") coho:COHO_0000000 coho:COHO_0002162)
ClassAssertion(Annotation(rdfs:comment "In the first GWAS, Japanese samples (n = 6,424) were identified from the Multiethnic Cohort study (MEC), the Colorectal Cancer Family Registry (CCFR), the Japan Public Health Center cohort study (JPHC) and three case-control studies in Hawaii (CR2&3) and in Fukuoka and Nagano, Japan (Supplementary Table 1).") Annotation(oboInOwl:hasDbXref "PMID:25105248") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4180879/fullTextXML") coho:COHO_0000001 coho:COHO_0002064)
