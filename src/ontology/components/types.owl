ClassAssertion(Annotation(rdfs:comment "The KARMA project is a prospective cohort study comprising women attending mammography screening or clinical mammography at four hospitals in Sweden.") Annotation(oboInOwl:hasDbXref "PMID:28180256") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837703/fullTextXML") coho:COHO_0000000 coho:COHO_0001093)
ClassAssertion(Annotation(rdfs:comment "The KCOS is a cross-sectional study of osteoporosis with 2,286 unrelated European ancestry participants living in and around Kansas City, Missouri, USA.") Annotation(oboInOwl:hasDbXref "PMID:32152362") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7062907/fullTextXML") coho:COHO_0000000 coho:COHO_0001961)
ClassAssertion(Annotation(rdfs:comment "The KSCS is a prospective cohort study to evaluate the natural history, prognosis and genetic and environmental determinants of a wide range of health traits and diseases among Korean adults.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001980)
ClassAssertion(Annotation(rdfs:comment "The Kaiser Permanente Research Bank (KPRB) is collecting biospecimens and surveys linked to electronic health records (EHR) from approximately 400,000 adult KP members.") Annotation(oboInOwl:hasDbXref "PMID:35216576") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") coho:COHO_0000000 coho:COHO_0000541)
ClassAssertion(Annotation(rdfs:comment "The Kardiovize Brno 2030 study was designed as a prospective cohort study to investigate the complex relationships of cardiovascular disease and outcomes with a range of biological, psychosocial, environmental, behavioral, and economic factors in an urban population of the Czech Republic.") Annotation(oboInOwl:hasDbXref "PMID:28812915") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28812915+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002616)
ClassAssertion(Annotation(rdfs:comment "The Kawasaki Aging and Wellbeing Project (KAWP) is a longitudinal cohort study of older adults aged between 85 and 89 with no physical disability at baseline.") Annotation(oboInOwl:hasDbXref "PMID:33627073") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7903371/fullTextXML") coho:COHO_0000000 coho:COHO_0001956)
ClassAssertion(Annotation(rdfs:comment "The Kentucky Lung Cancer Research Initiative is a study conducted by the Markey Cancer Center Cancer Center and the University of Kentucky using a population-based, case- control framework to study the extraordinarily high rates of lung cancer in Southeastern, Appalachian Kentucky.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001992)
ClassAssertion(Annotation(rdfs:comment "The King Faisal Specialist Hospital and Research Center (KFSH&RC) cohort consists of indigenous Arabs from Saudi Arabia referred for cardiology care at KFSH&RC, a tertiary care hospital recognized throughout Saudi Arabia and the Middle East, for work-up of cardiac disease from all over the country.") Annotation(oboInOwl:hasDbXref "PMID:41844147") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC13092120/") coho:COHO_0000000 coho:COHO_0001964)
ClassAssertion(Annotation(rdfs:comment "The Kita-Nagoya Genomic Epidemiology (KING) Study (ClinicalTrials.gov identifier NCT00262691) is an ongoing community-based prospective observational study of the genetic basis of cardiovascular disease and its risk factors31,32.") Annotation(oboInOwl:hasDbXref "PMID:30993211") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6453927/fullTextXML") coho:COHO_0000000 coho:COHO_0001065)
