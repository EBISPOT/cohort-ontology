ClassAssertion(Annotation(rdfs:comment "The WHI-LLS was a single in-person visit conducted in 2012–2013 to collect phlebotomy, anthropometry, and objective physical function measures in WHI Extension Study Participants.") Annotation(oboInOwl:hasDbXref "PMID:32680817") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC7566285/") coho:COHO_0000000 coho:COHO_0002569)
ClassAssertion(Annotation(rdfs:comment "The WHICAP (Washington Heights–Inwood Columbia Aging Project) study is a prospective, population‐based study of aging and dementia.") Annotation(oboInOwl:hasDbXref "PMID:38038215") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10727334/fullTextXML") coho:COHO_0000000 coho:COHO_0000807)
ClassAssertion(Annotation(rdfs:comment "The WHIMS sub-study consisted of WHI Hormone Trial women of European ancestry from the following sources: 1) WHI Memory Study (WHIMS) participants40 who were not in WHI-GARNET, 2) women from the WHI-HT at least 65 years old at enrollment who were neither in WHIMS nor GARNET, and 3) women from the WHI-HT younger than age 65 at enrollment who were neither in WHIMS nor GARNET.") Annotation(oboInOwl:hasDbXref "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-019-0519-3/MediaObjects/41588_2019_519_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0000603)
