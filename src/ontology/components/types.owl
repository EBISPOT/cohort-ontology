ClassAssertion(Annotation(rdfs:comment "The Infants’ Environmental Health Study [Infantes y Salud Ambiental (ISA)] is a prospective community-based birth cohort study in Matina County, Limón, Costa Rica, aimed at examining possible effects of prenatal pesticide and manganese exposure on children’s growth and neurodevelopment.") Annotation(oboInOwl:hasDbXref "PMID:25198283") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4256696/fullTextXML") coho:COHO_0000000 coho:COHO_0002652)
