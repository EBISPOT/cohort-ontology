ClassAssertion(Annotation(rdfs:comment "The GENUFAD study (Genetic Analysis of Nuclear Families with Atopic Dermatitis) recruited complete nuclear families with at least two children affected with early-onset (<2 years of age) and moderate to severe AD as previously described [20].") Annotation(oboInOwl:hasDbXref "PMID:25757221") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4355615/fullTextXML") coho:COHO_0000000 coho:COHO_0001175)
ClassAssertion(Annotation(rdfs:comment "The GEOS study is a population-based case-control study designed to identify the genetic determinants of early-onset ischemic stroke and to characterize interactions of stroke- associated genes with environmental risk factors.") Annotation(oboInOwl:hasDbXref "https://cdn-links.lww.com/permalink/wnl/c/wnl_2022_08_08_mitchell_1_sdc1.pdf") coho:COHO_0000000 coho:COHO_0001337)
ClassAssertion(Annotation(rdfs:comment "The GEP is a clinic-based case-control set, and the NHS and HPFS are case-control sets nested within population-based studies.") Annotation(oboInOwl:hasDbXref "PMID:22570617") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3343074/fullTextXML") coho:COHO_0000000 coho:COHO_0001793)
