ClassAssertion(Annotation(rdfs:comment "The GOLDN sample consisted of 1048 Caucasian individuals belonging to 184 pedigrees (average family size 6.2).") Annotation(oboInOwl:hasDbXref "PMID:34836252") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8617762/fullTextXML") coho:COHO_0000000 coho:COHO_0000494)
ClassAssertion(Annotation(rdfs:comment "The GOLDR study is a family-based study assessing diabetes and diabetic complications in families (siblings and/or parents) of a proband, defined as having type 2 diabetes and either known DR or a diabetes duration of ≥10 years.") Annotation(oboInOwl:hasDbXref "PMID:25452868") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC4212555/") coho:COHO_0000000 coho:COHO_0001342)
ClassAssertion(Annotation(rdfs:comment "The GOMAP (Genetic Overlap between Metabolic and Psychiatric disorders) study comprises a collection of 2,747 DNA samples from four different patient categories: T2D patients, SCZ patients, individuals with both SCZ and T2D (referred to from here on as SCZplusT2D), and individuals with a different psychiatric diagnosis (this last group is not used in further analyses reported here) (Table 1).") Annotation(oboInOwl:hasDbXref "PMID:30470734") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6251918/fullTextXML") coho:COHO_0000000 coho:COHO_0000079)
ClassAssertion(Annotation(rdfs:comment "The GPC is a population-based open cohort study established in 1989 by the Medical Research Council (MRC), UK in collaboration with the Uganda Virus Research Institute (UVRI) to examine trends in prevalence and incidence of HIV infection and their determinants.") Annotation(oboInOwl:hasDbXref "PMID:31675503") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7202134/unicode") coho:COHO_0000000 coho:COHO_0000345)
ClassAssertion(Annotation(rdfs:comment "The GR@ACE study comprises 7,409 unrelated individuals.") Annotation(oboInOwl:hasDbXref "https://ega-archive.org/studies/EGAS00001003424") coho:COHO_0000000 coho:COHO_0000258)
ClassAssertion(Annotation(rdfs:comment "The GRECO program hosts and harmonizes studies on renal hemodynamics at the renal function unit of the University Medical Center Groningen, by standardization of methodology, including harmonization of study protocols and calibration over time.") Annotation(oboInOwl:hasDbXref "PMID:26149279") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4552520/fullTextXML") coho:COHO_0000001 coho:COHO_0001824)
ClassAssertion(Annotation(rdfs:comment "The GRIV cohort, established in 1995 in France, is a collection of DNA samples used to identify host genes associated with slow progression and with rapid progression to AIDS [7,10,52].") Annotation(oboInOwl:hasDbXref "PMID:26367535") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4569262/fullTextXML") coho:COHO_0000000 coho:COHO_0001346)
ClassAssertion(Annotation(rdfs:comment "The GRaD study is a multisite, case–control study of RD in minority youth across the USA, Canada and Puerto Rico.") Annotation(oboInOwl:hasDbXref "PMID:30995994") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6678051/fullTextXML") coho:COHO_0000000 coho:COHO_0001012)
ClassAssertion(Annotation(rdfs:comment "The GWAS genotyped 998 T2D patients recruited from outpatient departments of Ruijin Hospital, and 1002 healthy controls obtained from one glucose survey in Youyi community, Baoshan district, Shanghai [29].") Annotation(oboInOwl:hasDbXref "PMID:21799836") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3142153/fullTextXML") coho:COHO_0000000 coho:COHO_0002319)
ClassAssertion(Annotation(rdfs:comment "The GWAS meta-analysis includes the following cases and controls from studies of European ancestry: UK GWAS stage 1 (Illumina Infinium HumanHap 550 Array: 1854 cases and 1894 controls), UK GWAS stage 2 (Illumina iSELECT: 3706 cases and 3884 controls), CAPS1 (Affymetrix GeneChip 500K: 474 cases and 482 controls),") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001120.v1.p1") coho:COHO_0000001 coho:COHO_0000752)
ClassAssertion(Annotation(rdfs:comment "The Gambian WTCCC GWA study included 1,316 cases and 1,382 controls who were genotyped using the Affymetrix GeneChip 500K array with 354,607 autosomal SNPs (Supplementary Methods) (WTCCC, unpublished).") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4975513/fullTextXML") coho:COHO_0000000 coho:COHO_0000363)
ClassAssertion(Annotation(rdfs:comment "The Geelong Osteoporosis Study (GOS) is a prospective, population-based cohort study of adults in Australia.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11234898/fullTextXML") coho:COHO_0000000 coho:COHO_0001819)
ClassAssertion(Annotation(rdfs:comment "The Generation R Study is a population-based prospective cohort study from fetal life until adulthood.") Annotation(oboInOwl:hasDbXref "PMID:28070760") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28070760+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000446)
ClassAssertion(Annotation(rdfs:comment "The Genes Affecting Stroke Risk and Outcome Study (GASROS) is a single-center prospective cohort that enrolled cases with acute ischemic stroke, aged more than 18 years who presented to MGH from 2003 to 2011.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001102)
ClassAssertion(Annotation(rdfs:comment "The Genes for Good study (GFG, https://genesforgood.sph.umich.edu/) is a population-based cohort initiated by the University of Michigan in 2015, which includes participants across the US who provided a saliva sample for DNA genotyping") Annotation(oboInOwl:hasDbXref "PMID:34957435") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8654685/fullTextXML") coho:COHO_0000000 coho:COHO_0000647)
ClassAssertion(Annotation(rdfs:comment "The Genes in Myopia (GEM) Study aims to recruit probands with myopia and their family members to allow genetic analysis of myopia to be undertaken.") Annotation(oboInOwl:hasDbXref "PMID:16283990") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16283990+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001806)
ClassAssertion(Annotation(rdfs:comment "The Genetic Association Information Network (GAIN) is a public-private partnership established to investigate the genetic basis of common diseases through a series of collaborative genome-wide association studies.") Annotation(oboInOwl:hasDbXref "PMID:17728769") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17728769+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000001 coho:COHO_0001749)
ClassAssertion(Annotation(rdfs:comment "The Genetic Epidemiology Network of Arteriopathy (GENOA) study is a community-based study of hypertensive sibships that was designed to investigate the genetics of hypertension and target organ damage.") Annotation(oboInOwl:hasDbXref "PMID:37169753") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10175543/fullTextXML") coho:COHO_0000000 coho:COHO_0000434)
ClassAssertion(Annotation(rdfs:comment "The Genetic Epidemiology Network of Salt Sensitivity (GenSalt) utilizes a family feeding study design to examine gene-diet (sodium and potassium) interactions on BP.") Annotation(oboInOwl:hasDbXref "PMID:17443206") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2377400/") coho:COHO_0000000 coho:COHO_0000540)
ClassAssertion(Annotation(rdfs:comment "The Genetic Epidemiology of Lung Cancer Consortium (GELCC) has conducted the only family-based lung cancer linkage study to identify rare, highly penetrant lung cancer susceptibility genes, providing evidence of linkage on chromosomal regions 6q23-25, 18p11.23, 2p22.2, 14q13.1, 16p13 and 20q13.11 (4,5,10–13).") Annotation(oboInOwl:hasDbXref "PMID:29924316") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC6148967/") coho:COHO_0000000 coho:COHO_0001007)
ClassAssertion(Annotation(rdfs:comment "The Genetic Modifier Study (GMS) consists of unrelated patients homozygous for the common CF allele F508del (HGVS nomenclature: p.Phe508del), recruited from extremes of lung function9.") Annotation(oboInOwl:hasDbXref "PMID:21602797") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3296486/fullTextXML") coho:COHO_0000000 coho:COHO_0001179)
ClassAssertion(Annotation(rdfs:comment "The Genetic Modifiers of CF-Related Diabetes Study (CFRD Study) is based at Johns Hopkins and enrolls subjects with CF who do and do not have CFRD.15") Annotation(oboInOwl:hasDbXref "PMID:35647563") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9136666/supplementaryFiles") coho:COHO_0000000 coho:COHO_0001157)
ClassAssertion(Annotation(rdfs:comment "The Genetic Regulation of Arterial Pressure in Humans in the Community (GRAPHIC) Study is a family based population study comprising of 510 nuclear families (two parents aged 40-60 years at recruitment and two adult offspring aged 18-40 years) recruited through primary care in Leicestershire between 2003 and 200552 .") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3978/MediaObjects/41588_2017_BFng3978_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0000635)
ClassAssertion(Annotation(rdfs:comment "The Genetics in AF (GENAF) study enrolled individuals with early-onset lone AF before age 50 in Norway between 2009 and 20168 .") Annotation(oboInOwl:hasDbXref "PMID:29892015") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001747)
ClassAssertion(Annotation(rdfs:comment "The Genome Diversity in Africa Project (GDAP) is an international collaboration that aims to produce a comprehensive catalogue of human genetic variation in Africa in order to provide a global resource to help design, implement and interpret genomic studies in Africa and studies comprising globally diverse populations.") Annotation(oboInOwl:hasDbXref "https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/the-genome-diversity-in-africa-project-gdap/") coho:COHO_0000000 coho:COHO_0000257)
ClassAssertion(Annotation(rdfs:comment "The Genomes for Life (GCAT) project is a long-term prospective cohort study that was designed to integrate and assess the role of epidemiological, genomic and epigenomic factors in the development of major chronic diseases in Catalonia, a north-east region of Spain.") Annotation(oboInOwl:hasDbXref "PMID:29593016") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29593016+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000074)
ClassAssertion(Annotation(rdfs:comment "The Genomic Research in Alpha-1 Antitrypsin Deficiency and Sarcoidosis (GRADS) study is an observational cohort study designed to explore the role of the lung microbiome and genome in these two diseases.") Annotation(oboInOwl:hasDbXref "PMID:26193069") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26193069+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001345)
ClassAssertion(Annotation(rdfs:comment "The Genotek clients included in our analyses provided informed consent for their data to be used for research purposes and responded to online questionnaire.") Annotation(oboInOwl:hasDbXref "PMID:40399555") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12165857/supplementaryFiles") coho:COHO_0000000 coho:COHO_0001083)
ClassAssertion(Annotation(rdfs:comment "The Georgia Stress and Heart Study, a prospective cohort study with repeated measures of PWV in youth and young adults, provides an excellent opportunity to examine the pattern and the rate of longitudinal change in PWV within and among individuals.") Annotation(oboInOwl:hasDbXref "PMID:30234784") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6355367/unicode") coho:COHO_0000000 coho:COHO_0000910)
ClassAssertion(Annotation(rdfs:comment "The German Aortic Stenosis Cohort recruited patients from the German Heart Center Munich and from the University of Bonn/Marburg and contains approximately 5732 participants with aortic valve stenosis recruited.") Annotation(oboInOwl:hasDbXref "PMID:41419686") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-025-02417-6/MediaObjects/41588_2025_2417_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001081)
ClassAssertion(Annotation(rdfs:comment "The German Cancer Consortium ('Deutsches Konsortium für Translationale Krebsforschung', DKTK) is a long-term cancer consortium, bringing together the German Cancer Research Center (DKFZ), Germany's largest life science research center, and the leading University Medical Center-based Comprehensive Cancer Centers (CCCs) at seven sites across Germany.") Annotation(oboInOwl:hasDbXref "PMID:30561127") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30561127+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000001 coho:COHO_0000260)
ClassAssertion(Annotation(rdfs:comment "The German Chronic Kidney Disease (GCKD) study is a prospective observational national cohort study.") Annotation(oboInOwl:hasDbXref "PMID:21862458") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21862458+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000190)
ClassAssertion(Annotation(rdfs:comment "The German MI Family Studies (GerMIFS I-IV) were initially supported by the Deutsche Forschungsgemeinschaft and the German Federal Ministry of Education and Research (BMBF)") Annotation(oboInOwl:hasDbXref "PMID:26343387") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4589895/supplementaryFiles") coho:COHO_0000001 coho:COHO_0001176)
ClassAssertion(Annotation(rdfs:comment "The German Multicentre Allergy Study began with the recruitment of 1314 newborns between January and December 1990 in maternity wards from university hospitals in 5 German cities – Berlin, Düsseldorf, Freiburg, Mainz and Munich – and has been described in detail elsewhere 19 including follow‐up methods 7.") Annotation(oboInOwl:hasDbXref "PMID:26011739") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4744942/fullTextXML") coho:COHO_0000000 coho:COHO_0001178)
ClassAssertion(Annotation(rdfs:comment "The German National Cohort (NAKO) is a multidisciplinary, population-based prospective cohort study that aims to investigate the causes of widespread diseases, identify risk factors and improve early detection and prevention of disease.") Annotation(oboInOwl:hasDbXref "PMID:36260190") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36260190+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002683)
ClassAssertion(Annotation(rdfs:comment "The German cohort consisted of 768 case subjects from the German Dupuytren Study and 1,353 control subjects from the PopGen and KORA studies.") Annotation(oboInOwl:hasDbXref "PMID:28886342") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5591021/fullTextXML") coho:COHO_0000000 coho:COHO_0000976)
ClassAssertion(Annotation(rdfs:comment "The German longevity sample comprised 1351 unrelated LLI (mean age: 99 years, age range: 94–110 years), including 643 centenarians (≥100 years).") Annotation(oboInOwl:hasDbXref "PMID:36142858") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC9504529/") coho:COHO_0000000 coho:COHO_0000191)
ClassAssertion(Annotation(rdfs:comment "The German sib-pair study consisted of two hundred and one families of at least two children with confirmed clinical asthma.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fejhg.2010.38/MediaObjects/41431_2010_BFejhg201038_MOESM31_ESM.pdf") coho:COHO_0000000 coho:COHO_0001796)
ClassAssertion(Annotation(rdfs:comment "The Gilda Radner Familial Ovarian Cancer Registry (GRFOCR) is a self-referred Registry of families with two or more ovarian cancer cases in blood relatives.") Annotation(oboInOwl:hasDbXref "PMID:19536330") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2694280/fullTextXML") coho:COHO_0000000 coho:COHO_0001825)
ClassAssertion(Annotation(rdfs:comment "The Global Lipids Genetics Consortium aggregated GWAS results from 1,654,960 individuals from 201 primary studies representing five genetic ancestry groups") Annotation(oboInOwl:hasDbXref "PMID:34887591") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8730582/unicode") coho:COHO_0000001 coho:COHO_0000617)
ClassAssertion(Annotation(rdfs:comment "The Glycometabolic Intervention as adjunct to Primary percutaneous intervention in ST elevation myocardial infarction (GIPS)-III trial is a prospective, single center, double blind, randomized, placebo-controlled trial.") Annotation(oboInOwl:hasDbXref "PMID:22968678") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3464381/") coho:COHO_0000000 coho:COHO_0002707)
ClassAssertion(Annotation(rdfs:comment "The Golestan Cohort Study is the only population-based prospective study that includes a large group of opium users with validated opium use data,13 who have been followed for over a decade with a minimum (around 1%) loss to follow-up.") Annotation(oboInOwl:hasDbXref "PMID:37781157") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10541463/fullTextXML") coho:COHO_0000000 coho:COHO_0002671)
ClassAssertion(Annotation(rdfs:comment "The Gothenburg H70 Birth Cohort Studies and Clinical AD from Sweden (Gothenburg) AD cases originate from Sweden and were either collected in memory clinics (in different parts of Sweden) or as a part of two population-based epidemiological studies in Gothenburg; the Prospective Population Study of Women (PPSW) and the Gothenburg Birth Cohort Studies (H70, H85 and 95+)") Annotation(oboInOwl:hasDbXref "PMID:42237039") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13263136/supplementaryFiles") coho:COHO_0000001 coho:COHO_0000666)
ClassAssertion(Annotation(rdfs:comment "The GpCRC cohort consists of tertiary care patients who have often added psychosocial comorbidities, limiting the generalization to the broader spectrum of GP patients.") Annotation(oboInOwl:hasDbXref "PMID:37688361") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10576603/fullTextXML") coho:COHO_0000000 coho:COHO_0000127)
ClassAssertion(Annotation(rdfs:comment "The Great Smoky Mountains Study (GSMS) was originally designed to examine the prevalence of common childhood psychiatric disorders, their development over time and use of mental health services in a predominantly rural area of the southeastern United States.") Annotation(oboInOwl:hasDbXref "PMID:24342383") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3939681/") coho:COHO_0000000 coho:COHO_0001183)
ClassAssertion(Annotation(rdfs:comment "The Guangzhou CRC Study: This study consisted of four case-control collections, Guangzhou- 1, Guangzhou-2, Guangzhou-3 and Guangzhou-4.") Annotation(oboInOwl:hasDbXref "PMID:24836286") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") coho:COHO_0000000 coho:COHO_0001349)
ClassAssertion(Annotation(rdfs:comment "The Gut Microbiota and Obesity Study was a population-based case-control study among noninstitutionalized residents aged 35–54 years in Shanghai, China.") Annotation(oboInOwl:hasDbXref "PMID:20530747") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2928335/fullTextXML") coho:COHO_0000000 coho:COHO_0001815)
ClassAssertion(Annotation(rdfs:comment "The Gutenberg Health Study (GHS) is a population-based, prospective, observational cohort study in Germany that includes 15,010 participants between 35 and 74 years of age.") Annotation(oboInOwl:hasDbXref "PMID:34424371") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34424371+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000263)
ClassAssertion(Annotation(rdfs:comment "The HALST is designed as a longitudinal study recruiting community-dwellers aged 55 and above in seven selected areas in Taiwan: two in the north (Shilin District and Yangmei Township), two in the central region (Miaoli City and Changhua City), two in the south (Puzi Township and Lingya District) and one in the east (Hualien).") Annotation(oboInOwl:hasDbXref "PMID:28369534") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837206/fullTextXML") coho:COHO_0000000 coho:COHO_0001838)
ClassAssertion(Annotation(rdfs:comment "The HAPIEE (Health, Alcohol and Psychosocial factors In Eastern Europe) study consists of three cohorts in Novosibirsk (Russia), Krakow (Poland) and six centres in the Czech Republic (Havirov/Karvina, Hradec Kralove, Jihlava, Kromeriz, Liberec and Usti nad Labem).") Annotation(oboInOwl:hasDbXref "PMID:17049075") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1626086/fullTextXML") coho:COHO_0000000 coho:COHO_0002640)
ClassAssertion(Annotation(rdfs:comment "The HAPIEE (Health, Alcohol and Psychosocial factors In Eastern Europe) study is a prospective cohort study designed to investigate the effect of classical and non-conventional risk factors and social and psychosocial factors on cardiovascular and other non-communicable diseases in eastern Europe and the FSU.") Annotation(oboInOwl:hasDbXref "PMID:17049075") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1626086/fullTextXML") coho:COHO_0000000 coho:COHO_0000265)
ClassAssertion(Annotation(rdfs:comment "The HAPO Study was an observational study designed to investigate the association between maternal glycemia during pregnancy, less severe than overt diabetes, and adverse pregnancy outcomes [34].") Annotation(oboInOwl:hasDbXref "PMID:39849370") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11755808/fullTextXML") coho:COHO_0000000 coho:COHO_0000583)
ClassAssertion(Annotation(rdfs:comment "The HCES is a hospital-based case-control study conducted in South Korea that includes multiple cancers 13, 14 .") Annotation(oboInOwl:hasDbXref "PMID:24836286") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") coho:COHO_0000000 coho:COHO_0002709)
ClassAssertion(Annotation(rdfs:comment "The HCES-CRC consisted of 3,378 cases and 4,552 controls who were included in stage 4 of this project.") Annotation(oboInOwl:hasDbXref "PMID:24836286") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") coho:COHO_0000000 coho:COHO_0001845)
ClassAssertion(Annotation(rdfs:comment "The HEBON study (initiated in 1999) is an ongoing nationwide retrospective cohort study among members of BRCA1/2 mutation families with prospective follow-up.21") Annotation(oboInOwl:hasDbXref "PMID:29937543") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6068188/fullTextXML") coho:COHO_0000000 coho:COHO_0001850)
ClassAssertion(Annotation(rdfs:comment "The HELENA-CSS is a multi-centre collaborative study conducted in European adolescents located in urban settings.") Annotation(oboInOwl:hasDbXref "PMID:19011652") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19011652+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001852)
ClassAssertion(Annotation(rdfs:comment "The HELIAD is a population-based, multidisciplinary, collaborative study designed to estimate the prevalence and incidence of AD, other dementias, mild cognitive impairment, and other neuropsychiatric conditions of aging in the Greek population") Annotation(oboInOwl:hasDbXref "PMID:24993387") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24993387+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001853)
ClassAssertion(Annotation(rdfs:comment "The HELIOS Study is a prospective population-based cohort, comprising men and women aged 30 to 84 years, living in Singapore") Annotation(oboInOwl:hasDbXref "PMID:41469377") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12764833/fullTextXML") coho:COHO_0000000 coho:COHO_0000426)
ClassAssertion(Annotation(rdfs:comment "The HELIUS study is designed as a prospective cohort study, including six ethnic groups (including the Dutch as a reference) living in Amsterdam, the Netherlands.") Annotation(oboInOwl:hasDbXref "PMID:29247091") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5736025/fullTextXML") coho:COHO_0000000 coho:COHO_0000266)
ClassAssertion(Annotation(rdfs:comment "The HELIX project has constructed a unique large exposome cohort, which included the prospective collection of objective data from different sources (biomonitoring data, geospatial data, sensor data, child health outcomes and omics signatures).") Annotation(oboInOwl:hasDbXref "PMID:30206078") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6144482/fullTextXML") coho:COHO_0000000 coho:COHO_0000827)
ClassAssertion(Annotation(rdfs:comment "The HGDS is a multicenter study of the growth and development, neurological, neuropsychological, and immune functioning of a cohort of children and adolescents, 62% of whom were infected with HIV through the use of clotting factor concentrates, and their non-hemophiliac, non-HIV infected male siblings.") Annotation(oboInOwl:hasDbXref "PMID:11075607") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11075607+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001350)
ClassAssertion(Annotation(rdfs:comment "The HKDB is a multicentre prospective cohort study co-ordinated by the Chinese University of Hong Kong (NCT05282680).") Annotation(oboInOwl:hasDbXref "PMID:39508878") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC11732878/") coho:COHO_0000000 coho:COHO_0001353)
ClassAssertion(Annotation(rdfs:comment "The HKDR consecutively enrolled patients referred to the Diabetes Mellitus and Endocrine Centre for comprehensive assessment of complications and metabolic control.") Annotation(oboInOwl:hasDbXref "PMID:32722720") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7386560/fullTextXML") coho:COHO_0000000 coho:COHO_0001188)
ClassAssertion(Annotation(rdfs:comment "The HKS enrolled cases and controls from the Queen Mary Hospital and the Grantham Hospital in Hong Kong.") Annotation(oboInOwl:hasDbXref "PMID:23143601") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf") coho:COHO_0000000 coho:COHO_0001864)
ClassAssertion(Annotation(rdfs:comment "The HNP is a population health study of Nevadans, with specific targeted recruitment in rural and socioeconomically depressed Northern Nevada areas.") Annotation(oboInOwl:hasDbXref "PMID:33763119") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7982958/fullTextXML") coho:COHO_0000000 coho:COHO_0000828)
ClassAssertion(Annotation(rdfs:comment "The HOPE Cohort is a newly established community-based prospective cohort enrolling participants from both urban and rural areas in Zhejiang Province, China.") Annotation(oboInOwl:hasDbXref "PMID:40728933") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12561000/fullTextXML") coho:COHO_0000000 coho:COHO_0001354)
ClassAssertion(Annotation(rdfs:comment "The HVH study is a population-based case-control study that includes individuals who experienced cardiovascular events, including a first VTE, and also included genetic analyses and performed a follow-up of the VTE cases for VTE recurrence.") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") coho:COHO_0000000 coho:COHO_0000564)
ClassAssertion(Annotation(rdfs:comment "The HYPERGENES Project investigated associations between genetic variants and essential hypertension pursuing a two-stage study by recruiting cases and controls from extensively characterized cohorts recruited over many years in different European regions.") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3272453/") coho:COHO_0000001 coho:COHO_0001882)
ClassAssertion(Annotation(rdfs:comment "The Han-Chinese Cell and Genome Bank in Taiwan21 includes more than 3,300 healthy controls who were recruited via a stratified, 3-staged probability clustering sampling scheme through a registry of all the 329 non-aboriginal townships or city districts in Taiwan.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1087/MediaObjects/41588_2012_BFng1087_MOESM24_ESM.pdf") coho:COHO_0000000 coho:COHO_0002455)
ClassAssertion(Annotation(rdfs:comment "The Hannover-Jena Endometrial Cancer Study (HJECS), a hospital-based case-control study, included 250 German women, aged 31-89 years, who were recruited either at the Friedrich Schiller University of Jena or at Hannover Medical School after having been diagnosed with histologically confirmed primary incident endometrial carcinoma between 2004 and 2010.") Annotation(oboInOwl:hasDbXref "PMID:27135401") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3562/MediaObjects/41588_2016_BFng3562_MOESM301_ESM.pdf") coho:COHO_0000000 coho:COHO_0001861)
ClassAssertion(Annotation(rdfs:comment "The Harmonized Diagnostic Assessment of Dementia for the Longitudinal Aging Study in India (LASI-DAD) is an in-depth study of late-life cognition and dementia, drawing on a subsample of the Longitudinal Aging Study in India (LASI).") Annotation(oboInOwl:hasDbXref "https://lasi-dad.org/about/overview") coho:COHO_0000000 coho:COHO_0002645)
ClassAssertion(Annotation(rdfs:comment "The Harvard Biomarkers Study (HBS) is a longitudinal case-control registry that aims to accelerate the development of molecular diagnostics that track or predict the progression of early-stage PD10,40–42.") Annotation(oboInOwl:hasDbXref "PMID:38480700") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10937726/fullTextXML") coho:COHO_0000000 coho:COHO_0001843)
ClassAssertion(Annotation(rdfs:comment "The Health Professionals Follow-up Study is a prospective study of US male health professionals who enrolled in 1986 by completing a mailed questionnaire.") Annotation(oboInOwl:hasDbXref "PMID:33185675") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7666422/fullTextXML") coho:COHO_0000000 coho:COHO_0000527)
ClassAssertion(Annotation(rdfs:comment "The Health, Aging, and Body Composition (Health ABC) study11 was a prospective longitudinal observational study designed to assess the association of body composition with physical function and disability in older adults.") Annotation(oboInOwl:hasDbXref "PMID:32396194") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7218493/fullTextXML") coho:COHO_0000000 coho:COHO_0000441)
ClassAssertion(Annotation(rdfs:comment "The Healthy Nevada Project (HNP), a population health study developed in collaboration between Renown Health and the Desert Research Institute in Reno, Nevada, was established in 2016 to examine the effects genetics may have on Nevadan health outcomes.") Annotation(oboInOwl:hasDbXref "PMID:33763119") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7982958/fullTextXML") coho:COHO_0000000 coho:COHO_0001869)
ClassAssertion(Annotation(rdfs:comment "The Heart Protection Study is large, it has included a wide range of patients at high risk of vascular events") Annotation(oboInOwl:hasDbXref "PMID:10329064") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10329064+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000091)
ClassAssertion(Annotation(rdfs:comment "The Hellenic study of Interactions between Single nucleotide polymorphisms and Eating in Atherosclerosis Susceptibility (THISEAS), a medical centre-based case-control study conducted in Greek adults.") Annotation(oboInOwl:hasDbXref "PMID:26223368") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26223368+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000171)
ClassAssertion(Annotation(rdfs:comment "The Helsinki Sudden Death Study (HSDS) and Tampere Coronary Study (TCS) are a series of consecutive forensic autopsies of men aged 35-69 who died out of hospital in Helsinki between 1991 and 1992 (HSDS) or in Tampere between 2001 and 2004 (TCS).") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3396/MediaObjects/41588_2015_BFng3396_MOESM57_ESM.pdf") coho:COHO_0000000 coho:COHO_0001874)
ClassAssertion(Annotation(rdfs:comment "The HerediGene Population Study (HGPS) is an observational, non-randomized study of diseased and non-diseased adults and children.") Annotation(oboInOwl:hasDbXref "PMID:38222332") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC10785925") coho:COHO_0000000 coho:COHO_0000563)
ClassAssertion(Annotation(rdfs:comment "The Hertfordshire Cohort Study (HCS) is a population-based sample of men and women born between 1931 and 1939 in Hertfordshire, UK who still lived there at the time of the study [24].") Annotation(oboInOwl:hasDbXref "PMID:39751886") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11698837/fullTextXML") coho:COHO_0000000 coho:COHO_0001855)
ClassAssertion(Annotation(rdfs:comment "The Hispanic Colorectal Cancer Study (HCCS) is a population-based study of individuals self-identified as Hispanic with a diagnosis of CRC.") Annotation(oboInOwl:hasDbXref "PMID:37783704") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-023-41819-0/MediaObjects/41467_2023_41819_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001844)
ClassAssertion(Annotation(rdfs:comment "The Hispanic Community Children’s Health Study/Study of Latino Youth (SOL Youth) cohort is an ancillary study of the Hispanic Community Health Study/Study of Latinos (HCHS/SOL) that recruited n = 1,466 children aged 8–16 years between 2012 and 2014 whose parents/legal guardians participated in the HCHS/SOL at one of four field centers (Chicago, Bronx, San Diego, and Miami).") Annotation(oboInOwl:hasDbXref "PMID:39885687") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC11875162/") coho:COHO_0000000 coho:COHO_0001411)
ClassAssertion(Annotation(rdfs:comment "The Hispanic Community Health Study (HCHS)/Study of Latinos (SOL) is a comprehensive multicenter community based cohort study of Hispanics/Latinos in the United States.") Annotation(oboInOwl:hasDbXref "PMID:20609343") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20609343+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000388)
ClassAssertion(Annotation(rdfs:comment "The Hispanic/Latino Anthropometry (HISLA) Consortium is comprised of 27 studies/consortia of adult participants.") Annotation(oboInOwl:hasDbXref "PMID:35399580") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8990175/fullTextXML") coho:COHO_0000001 coho:COHO_0001860)
ClassAssertion(Annotation(rdfs:comment "The Hoorn Diabetes Care System cohort (DCS) is a prospective cohort representing a comprehensive dataset on the natural course of T2D, with repeated clinical measures and outcomes.") Annotation(oboInOwl:hasDbXref "PMID:28588112") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A28588112+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0000092)
ClassAssertion(Annotation(rdfs:comment "The Hoorn study is a population-based cohort study on glucose metabolism and vascular disease initiated in 1989, with follow-up examinations in 1996-1998, 2000-2001 and 2005-2007.") Annotation(oboInOwl:hasDbXref "PMID:19768735") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19768735+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001871)
ClassAssertion(Annotation(rdfs:comment "The Hordaland Health Study (HUSK) is a community-based study in Western Norway conducted as a collaboration between the University of Bergen, the Norwegian Health Screening Service and the Municipal Health Service in Hordaland (https://husk-en.w.uib.no/)53.") Annotation(oboInOwl:hasDbXref "PMID:38671141") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC11053069/") coho:COHO_0000000 coho:COHO_0001351)
ClassAssertion(Annotation(rdfs:comment "The Hunter Community Study (HCS) is a longitudinal cohort study of men and women aged 55-85 years of age who reside in Newcastle, New South Wales on the east coast of Australia.") Annotation(oboInOwl:hasDbXref "https://researchdata.edu.au/health-ageing-hunter-nsw-australia/11563") coho:COHO_0000000 coho:COHO_0000095)
ClassAssertion(Annotation(rdfs:comment "The Hwasun Cancer Epidemiology Study (HCES-Br) is a hospital-based case-control 92 study whose goal is to identify factors of the cancer development and clinical 93 progression in a Korean population.6,7") Annotation(oboInOwl:hasDbXref "PMID:32139696") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-020-15046-w/MediaObjects/41467_2020_15046_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001185)
ClassAssertion(Annotation(rdfs:comment "The Hypertension-Insulin Resistance Family Study (HTN-IR) was designed as a family study to examine the genetic basis of hypertension and insulin resistance.") Annotation(oboInOwl:hasDbXref "PMID:24124113") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3968231/unicode") coho:COHO_0000000 coho:COHO_0001015)
ClassAssertion(Annotation(rdfs:comment "The Hypertrophic Cardiomyopathy Registry (HCMR) is a NHLBI-funded, prospective registry of 2755 patients with HCM recruited from 44 sites in 6 countries.") Annotation(oboInOwl:hasDbXref "PMID:31699273") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC6905038/") coho:COHO_0000000 coho:COHO_0001014)
ClassAssertion(Annotation(rdfs:comment "The I-SPY2 (Investigation of Serial Studies to Predict Your Therapeutic Response With Imaging and Molecular Analysis 2) is an ongoing randomized clinical platform trial being conducted at multiple US clinical sites including patients with early-stage (II or III) ERBB2-negative, high-risk breast cancer.") Annotation(oboInOwl:hasDbXref "PMID:42530945") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42530945+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001937)
ClassAssertion(Annotation(rdfs:comment "The IARC study of lung cancer in central Europe was conducted with cancer institutes in 6 countries including Czech Republic (Prague, Olomouc, Brno), Hungary (Borsod, Heves, Szabolcs, Szolnok, Budapest), Poland (Warsaw, Lodz), Romania (Bucharest), Russia (Moscow) and Slovakia (Banska Bystrica, Bratislava, Nitra) between 1998 and 2002.") Annotation(oboInOwl:hasDbXref "PMID:18385738") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature06885/MediaObjects/41586_2008_BFnature06885_MOESM257_ESM.pdf") coho:COHO_0000000 coho:COHO_0000870)
ClassAssertion(Annotation(rdfs:comment "The IBCCS study includes data both from large parallel studies being conducted in the UK, Netherlands, and France, and from small individual centers in which the IBCCS is providing the impetus and some resources to collect the necessary data.") Annotation(oboInOwl:hasDbXref "https://doi.org/10.1186/bcr93") coho:COHO_0000001 coho:COHO_0001889)
ClassAssertion(Annotation(rdfs:comment "The IBDGC cohort was established in 2003, when 6 genetic research centers (GRCs) in the United States and Canada began recruiting patients with confirmed CD, UC, or IBD-U, for IBD gene discovery.") Annotation(oboInOwl:hasDbXref "PMID:36686985") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9851382/fullTextXML") coho:COHO_0000000 coho:COHO_0000718)
