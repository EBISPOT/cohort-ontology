ClassAssertion(Annotation(rdfs:comment "The Scotland and Newcastle Lymphoma Group includes the Scotland and Newcastle Epidemiological Study of Hodgkin's Disease, which is a case–control study conducted in Scotland and Northern England between January 1993 and July 1997 (6), and the “local case series,” a prospectively collected series of patients within those regions between January 1992 and March 2008 (9).") Annotation(oboInOwl:hasDbXref "PMID:22286212") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC3274508/") coho:COHO_0000000 coho:COHO_0002394)
