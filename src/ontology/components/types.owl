ClassAssertion(Annotation(rdfs:comment "For further replication of the results for the Gleason score, we genotyped five of the most significant SNPs (P<2 × 10−6) in the Cancer of the Prostate in Sweden, a population-based case–control study of 2,618 cases and 1,728 controls using Sequenom (Supplementary Fig. 7).") Annotation(oboInOwl:hasDbXref "PMID:25939597") Annotation(oboInOwl:hasDbXref "https://www.nature.com/articles/ncomms7889") coho:COHO_0000000 coho:COHO_0000025)
ClassAssertion(Annotation(rdfs:comment "For identifying CR/IDC-associated events, the TCGA cohort was used as discovery set and the CPC-GENE cohort was used for validation.") Annotation(oboInOwl:hasDbXref "PMID:29295717") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5751811/fullTextXML") coho:COHO_0000000 coho:COHO_0000230)
ClassAssertion(Annotation(rdfs:comment "For men of African ancestry, GRS replication was conducted among 1,586 cases and 1,086 controls from California and Uganda (CA UG Study) genotyped with the Illumina H3 Africa array and imputed using Phase 3 of the 1000 Genomes Project15 as the reference panel and Minimac4 on the Michigan Imputation Server27 (Supplementary Table 1 and 2).") Annotation(oboInOwl:hasDbXref "PMID:33398198") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8148035/fullTextXML") coho:COHO_0000000 coho:COHO_0001153)
ClassAssertion(Annotation(rdfs:comment "For replication we made use of DNA from 1,490 glioma cases recruited to an ongoing UK study of primary brain tumours (National Brain Tumour Study).") Annotation(oboInOwl:hasDbXref "PMID:26424050") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4600760/fullTextXML") coho:COHO_0000000 coho:COHO_0002119)
ClassAssertion(Annotation(rdfs:comment "For stage 1 (discovery) we meta-analyzed summary data from 8 independent datasets (3,853 cases and 33,480 controls; Supplementary Table 1) with European ancestry from the United States collectively referred to as the National Eye Institute Glaucoma Human Genetics Collaboration Heritable Overall Operational Database (NEIGHBORHOOD).") Annotation(oboInOwl:hasDbXref "PMID:26752265") Annotation(oboInOwl:hasDbXref "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4731307/unicode") coho:COHO_0000001 coho:COHO_0002132)
ClassAssertion(Annotation(rdfs:comment "For the FinHealth 2017 Study, a representative sample of adults aged 18 years and above (n = 10,247) was drawn from the Population Register using one- and two-stage stratified, random sampling.") Annotation(oboInOwl:hasDbXref "PMID:35405960") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9002951/fullTextXML") coho:COHO_0000000 coho:COHO_0001326)
ClassAssertion(Annotation(rdfs:comment "For the Graves' disease analyses, cases were recruited from the United Kingdom Graves' disease cohort and controls from the British 1958 Birth Cohort.") Annotation(oboInOwl:hasDbXref "PMID:24586183") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3937134/fullTextXML") coho:COHO_0000000 coho:COHO_0002505)
ClassAssertion(Annotation(rdfs:comment "For the Myopia Genomics Study of Hong Kong, unrelated individuals of Chinese descent aged between 18 and 45 years were recruited via the Optometry Clinic at the Hong Kong Polytechnic University with details as described previously23-25 .") Annotation(oboInOwl:hasDbXref "PMID:32193507") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs42003-020-0802-y/MediaObjects/42003_2020_802_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0002102)
ClassAssertion(Annotation(rdfs:comment "For the RIKEN cohort, a total of 219 mRCC patients treated with sunitinib were recruited from 15 Japanese medical institutes.") Annotation(oboInOwl:hasDbXref "PMID:35740506") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9220885/fullTextXML") coho:COHO_0000000 coho:COHO_0000576)
ClassAssertion(Annotation(rdfs:comment "For the Swedish-Norwegian discovery sample set, we obtained 1,668 and 157 samples from the Swedish National Myeloma Biobank (Skåne University Hospital, Lund, Sweden) and the Norwegian Biobank for Myeloma (Trondheim, Norway), respectively.") Annotation(oboInOwl:hasDbXref "PMID:26007630") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4455110/fullTextXML") coho:COHO_0000000 coho:COHO_0001409)
ClassAssertion(Annotation(rdfs:comment "For the iCOGS genotyping stage, 4,330 women with a confirmed diagnosis of endometrial cancer and European ancestry were recruited via 11 studies in Western Europe, North America and Australia, collectively called the Endometrial Cancer Association Consortium (ECAC).") Annotation(oboInOwl:hasDbXref "PMID:27135401") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4907351/fullTextXML") coho:COHO_0000001 coho:COHO_0001316)
ClassAssertion(Annotation(rdfs:comment "For the initial genome-wide scan, cases and controls were Caucasian men and women from Ottawa, Canada who participated in the Ottawa Heart Study (OHS).") Annotation(oboInOwl:hasDbXref "PMID:17478681") Annotation(oboInOwl:hasDbXref "https://pmc.ncbi.nlm.nih.gov/articles/PMC2711874/") coho:COHO_0000000 coho:COHO_0002202)
ClassAssertion(Annotation(rdfs:comment "For the open-label, randomised, controlled QUASAR 2 trial, which was done at 170 hospitals in seven countries, we recruited patients aged 18 years or older with WHO performance status scores of 0 or 1 who had undergone potentially curative surgery for histologically proven stage III or high-risk stage II colorectal cancer.") Annotation(oboInOwl:hasDbXref "PMID:27660192") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27660192+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0002306)
ClassAssertion(Annotation(rdfs:comment "For the present study, we newly performed genome-wide scan for 19,546 samples (NJMU GSA project: 10,248 cases and 9,298 controls) using Illumina Global Screening Array (GSA), which included three studies") Annotation(oboInOwl:hasDbXref "PMID:31326317") Annotation(oboInOwl:hasDbXref "https://europepmc.org/api/getPdf?pmcid=PMC7015703") coho:COHO_0000000 coho:COHO_0001110)
ClassAssertion(Annotation(rdfs:comment "For the purpose of this study, the Stage 1 genome-wide association study (GWAS) dataset included 2024 subjects (1008 AD cases and 1016 controls) and the Stage 2 dataset included 1870 subjects (885 AD cases and 985 controls).") Annotation(oboInOwl:hasDbXref "PMID:23565137") Annotation(oboInOwl:hasDbXref "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0058618") coho:COHO_0000000 coho:COHO_0001944)
ClassAssertion(Annotation(rdfs:comment "For this National Institutes of Health/National Institute on Alcohol Abuse and Alcoholism funded study, we are recruiting high-risk drinkers who are either cases (with alcoholic cirrhosis) or controls (drinking comparable amounts over similar time, but free of significant liver disease).") Annotation(oboInOwl:hasDbXref "PMID:25872595") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25872595+AND+SRC%3AMED&format=json&resultType=core") coho:COHO_0000000 coho:COHO_0001334)
ClassAssertion(Annotation(rdfs:comment "For this on-going, prospective single-center, hospital-based study participants with first ever or recurrent strokes were recruited from January 22, 2002 to September 9, 2010.") Annotation(oboInOwl:hasDbXref "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") coho:COHO_0000000 coho:COHO_0001095)
ClassAssertion(Annotation(rdfs:comment "For this purpose, 1085 patients were recruited between 2005 and 2010 by an invariable team of traveling investigators in a cross-sectional field study that comprised 23 German psychiatric hospitals.") Annotation(oboInOwl:hasDbXref "PMID:21067598") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3002316/fullTextXML") coho:COHO_0000000 coho:COHO_0001822)
