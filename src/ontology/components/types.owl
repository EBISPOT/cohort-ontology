ClassAssertion(Annotation(rdfs:comment "The present study is part of the “Rhea” project, a pregnancy cohort which examines prospectively a population-based cohort of pregnant women and their children at the prefecture of Heraklion, Crete, Greece [25].") Annotation(oboInOwl:hasDbXref "PMID:25970502") Annotation(oboInOwl:hasDbXref "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4430416/fullTextXML") coho:COHO_0000000 coho:COHO_0002606)
