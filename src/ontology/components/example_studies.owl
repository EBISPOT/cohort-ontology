# Individual: <http://www.ebi.ac.uk/coho/COHO_0000002> (<http://www.ebi.ac.uk/coho/COHO_0000002>)

AnnotationAssertion(Annotation(<http://purl.org/dc/terms/title> "DNA copy number analysis of fresh and formalin-fixed specimens by shallow whole-genome sequencing with identification and exclusion of problematic regions in the genome assembly.") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25236618") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000642") Annotation(rdfs:comment "sequence data from the 1000 Genomes Project") <http://purl.obolibrary.org/obo/IAO_0000112> <http://www.ebi.ac.uk/coho/COHO_0000002> "EGAS00001000642")
AnnotationAssertion(Annotation(<http://purl.org/dc/terms/title> "Exome sequencing and genome-wide association analyses unveils the genetic predisposition in hydroxychloroquine retinopathy.") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38548946") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:38548946%20AND%20SRC:MED&resultType=core&format=json") Annotation(rdfs:comment "The Chinese Han Southern database from 1000 genomes was used as control group to compare the affected percentage.") <http://purl.obolibrary.org/obo/IAO_0000112> <http://www.ebi.ac.uk/coho/COHO_0000002> "GCST90624364")

