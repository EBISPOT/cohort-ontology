# Individual: <http://www.ebi.ac.uk/coho/COHO_0000004> (<http://www.ebi.ac.uk/coho/COHO_0000004>)

AnnotationAssertion(Annotation(<http://purl.org/dc/terms/title> "Germline variants and advanced colorectal adenomas: adenoma prevention with celecoxib trial genome-wide association study.") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24084763") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID:24084763%20AND%20SRC:MED&resultType=core&format=json") Annotation(rdfs:comment "1,406 Caucasian patients (139 advanced adenoma cases and 1,267 controls) from the Adenoma Prevention with Celecoxib (APC) trial were included in a genome-wide association study (GWAS) to identify variants associated with postpolypectomy disease recurrence.") <http://purl.obolibrary.org/obo/IAO_0000112> <http://www.ebi.ac.uk/coho/COHO_0000004> "GCST002212")
