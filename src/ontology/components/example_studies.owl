# Individual: <http://www.ebi.ac.uk/coho/COHO_0001109> (<http://www.ebi.ac.uk/coho/COHO_0001109>)

AnnotationAssertion(Annotation(<http://purl.org/dc/terms/title> "Identification, replication, and fine-mapping of Loci associated with adult height in individuals of african ancestry.") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21998595") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3188544/fullTextXML") Annotation(rdfs:comment "The meta-analysis included results from nine studies: four population-based African-American studies (ARIC (N = 2,740), CARDIA (N = 699), JHS (N = 2,119), and MESA (N = 1,646)), one family-based African-American study (CFS (N = 386)), African-American GWA study consortia of breast (AABC (N = 5,380)) and prostate cancer (AAPC (N = 5,526)) and two case-control studies of obesity (Maywood (N = 743)) and hypertension (Nigeria (N = 1,188)) (Materials and Methods, Text S1 and Table S1).") <http://purl.obolibrary.org/obo/IAO_0000112> <http://www.ebi.ac.uk/coho/COHO_0001109> "GCST001263")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001110> (<http://www.ebi.ac.uk/coho/COHO_0001110>)

AnnotationAssertion(Annotation(<http://purl.org/dc/terms/title> "Genome-wide meta-analysis across East Asian and European populations provides insights into the molecular basis of lung cancer.") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42152146") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13348699/fullTextXML") Annotation(rdfs:comment "Specifically, these included the NJMU Global Screening Array project (10,248 cases and 9,298 controls), with participants recruited from five major cities in China (Nanjing, Shanghai, Beijing, Tianjin, and Guangzhou); the NJMU GWAS dataset (2,126 cases and 3,077 controls) [17]; and the NJMU OncoArray dataset (953 cases and 953 controls).") <http://purl.obolibrary.org/obo/IAO_0000112> <http://www.ebi.ac.uk/coho/COHO_0001110> "GCST90482691")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001111> (<http://www.ebi.ac.uk/coho/COHO_0001111>)

AnnotationAssertion(Annotation(<http://purl.org/dc/terms/title> "Common X-Chromosome Variants Are Associated with Parkinson Disease Risk.") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33583074") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8601399/unicode") Annotation(rdfs:comment "In the replication, we meta-analyzed 2 PD datasets (Table 2): the first composed of the Parkinson’s Disease Cognitive Genetics Consortium (PDCGC) and healthy individuals from the Adult Change in Thought (ACT) longitudinal cohort, referred to here as PDCGC & ACT; and the second from McGill University (McGill), including samples from the Quebec Parkinson Network.") <http://purl.obolibrary.org/obo/IAO_0000112> <http://www.ebi.ac.uk/coho/COHO_0001111> "GCST90104085")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001112> (<http://www.ebi.ac.uk/coho/COHO_0001112>)

