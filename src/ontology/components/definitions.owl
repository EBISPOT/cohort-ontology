AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35410379") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103650") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35410379") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1038/s41588-022-01042-x") Annotation(rdfs:comment "In less than 4 months during an early phase of the pandemic, we collected survey data from 736,723 AncestryDNA research participants who consented to research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000742> "A research cohort of customers of the AncestryDNA consumer genetic testing service who consented to AncestryDNA's Human Diversity Project and contribute genotype data and survey responses to genetic studies, including a COVID-19 survey of US-based adult customers used in genome-wide association studies of COVID-19 and influenza outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35410379") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103650") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35410379") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1038/s41588-022-01042-x") Annotation(rdfs:comment "This is a cross-sectional genetic association study using extant genetic data from AncestryDNA customers and disease data collected via survey over an approximately 3.5-month period early in the COVID-19 pandemic.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000742> "A research cohort of customers of the AncestryDNA consumer genetic testing service who consented to AncestryDNA's Human Diversity Project and contribute genotype data and survey responses to genetic studies, including a COVID-19 survey of US-based adult customers used in genome-wide association studies of COVID-19 and influenza outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35410379") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103650") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39103650") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11319199/fullTextXML") Annotation(rdfs:comment "All data for this research project was from participants who provided previous informed consent to participate in AncestryDNA’s Human Diversity Project, as reviewed and approved by their external IRB, Advarra.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000742> "A research cohort of customers of the AncestryDNA consumer genetic testing service who consented to AncestryDNA's Human Diversity Project and contribute genotype data and survey responses to genetic studies, including a COVID-19 survey of US-based adult customers used in genome-wide association studies of COVID-19 and influenza outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35410379") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103650") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39103650") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11319199/fullTextXML") Annotation(rdfs:comment "Association between reported influenza infection in the AncestryDNA cohort and 24 variants previously reported to be associated with COVID-19 outcomes by the HGI.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000742> "A research cohort of customers of the AncestryDNA consumer genetic testing service who consented to AncestryDNA's Human Diversity Project and contribute genotype data and survey responses to genetic studies, including a COVID-19 survey of US-based adult customers used in genome-wide association studies of COVID-19 and influenza outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35410379") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103650") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39103650") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11319199/fullTextXML") Annotation(rdfs:comment "US-based AncestryDNA customers over the age of 18 who had consented to the research, were invited to complete five surveys assessing COVID-19 outcomes, as well as providing other demographic information and comorbidities, as described previously8.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000742> "A research cohort of customers of the AncestryDNA consumer genetic testing service who consented to AncestryDNA's Human Diversity Project and contribute genotype data and survey responses to genetic studies, including a COVID-19 survey of US-based adult customers used in genome-wide association studies of COVID-19 and influenza outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000743> (<http://www.ebi.ac.uk/coho/COHO_0000743>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29503172") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29503172+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Cox regression and logistic regression were used to compare time to medication, time to reaching the treatment goal, and risk of diabetic complications and genetic associations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000743> "An ongoing study that aims to include all individuals with newly diagnosed diabetes in the Scania region of southern Sweden, used to classify diabetes into subgroups and to study their genetics and complications.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29503172") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29503172+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We did data-driven cluster analysis (k-means and hierarchical clustering) in patients with newly diagnosed diabetes (n=8980) from the Swedish All New Diabetics in Scania cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000743> "An ongoing study that aims to include all individuals with newly diagnosed diabetes in the Scania region of southern Sweden, used to classify diabetes into subgroups and to study their genetics and complications.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(rdfs:comment "ANDIS is an ongoing study that aims to include all individuals with newly diagnosed diabetes mellitus in the south of Sweden (the Scania region).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000743> "An ongoing study that aims to include all individuals with newly diagnosed diabetes in the Scania region of southern Sweden, used to classify diabetes into subgroups and to study their genetics and complications.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(rdfs:comment "Using this study, it was recently suggested that diabetes mellitus can be clustered into five subgroups.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000743> "An ongoing study that aims to include all individuals with newly diagnosed diabetes in the Scania region of southern Sweden, used to classify diabetes into subgroups and to study their genetics and complications.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000744> (<http://www.ebi.ac.uk/coho/COHO_0000744>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29550775") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29550775") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5875659/fullTextXML") Annotation(rdfs:comment "A key strength of 19Up is the ability to link twin data with a phenotypically rich, longitudinal collection of environmental and psychological risk factors including personality, psychiatric phenotypes and diagnostic outcomes, neurobiological correlates such as brain imaging and genome-wide association data (figure 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000744> "A longitudinal study of twins and their non-twin siblings from Queensland, Australia, begun in 1992 with twins recruited through primary and secondary schools in the greater Brisbane area and assessed repeatedly in adolescence and young adulthood (including the 19Up study), with genotyping, brain imaging and psychological assessments, to study genetic and environmental pathways to traits such as mental health and substance use.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29550775") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29550775") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5875659/fullTextXML") Annotation(rdfs:comment "As such, 19Up enables detailed investigation of genetic and environmental pathways to mental illness and substance misuse within the Brisbane Longitudinal Twin Sample (BLTS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000744> "A longitudinal study of twins and their non-twin siblings from Queensland, Australia, begun in 1992 with twins recruited through primary and secondary schools in the greater Brisbane area and assessed repeatedly in adolescence and young adulthood (including the 19Up study), with genotyping, brain imaging and psychological assessments, to study genetic and environmental pathways to traits such as mental health and substance use.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29550775") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29550775") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5875659/fullTextXML") Annotation(rdfs:comment "The 19Up study complements and extends earlier BLTS and BATS studies conducted during adolescence (figure 1)3–12 by providing a detailed assessment of mental health and substance use and misuse at a young adult age.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000744> "A longitudinal study of twins and their non-twin siblings from Queensland, Australia, begun in 1992 with twins recruited through primary and secondary schools in the greater Brisbane area and assessed repeatedly in adolescence and young adulthood (including the 19Up study), with genotyping, brain imaging and psychological assessments, to study genetic and environmental pathways to traits such as mental health and substance use.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29550775") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29550775") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5875659/fullTextXML") Annotation(rdfs:comment "These individuals are part of the ongoing Brisbane Longitudinal Twin Study (BLTS, or Brisbane Adolescent Twin Study: BATS,1 2 which began in 1992 when twins were recruited from primary and secondary schools in the greater Brisbane area via media appeals and by word of mouth.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000744> "A longitudinal study of twins and their non-twin siblings from Queensland, Australia, begun in 1992 with twins recruited through primary and secondary schools in the greater Brisbane area and assessed repeatedly in adolescence and young adulthood (including the 19Up study), with genotyping, brain imaging and psychological assessments, to study genetic and environmental pathways to traits such as mental health and substance use.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29550775") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29550775") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5875659/fullTextXML") Annotation(rdfs:comment "Twins and their non-twin siblings from Queensland, Australia; mostly from European ancestry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000744> "A longitudinal study of twins and their non-twin siblings from Queensland, Australia, begun in 1992 with twins recruited through primary and secondary schools in the greater Brisbane area and assessed repeatedly in adolescence and young adulthood (including the 19Up study), with genotyping, brain imaging and psychological assessments, to study genetic and environmental pathways to traits such as mental health and substance use.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000745> (<http://www.ebi.ac.uk/coho/COHO_0000745>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20923989") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3070269/") Annotation(rdfs:comment "Therefore, to maximize the chance of finding novel susceptibility loci for CAD and MI, the Coronary ARtery DIsease Genome-wide Replication And Meta-analysis (CARDIoGRAM) consortium was formed.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000745> "A transatlantic consortium that meta-analysed 14 genome-wide association studies of coronary artery disease in individuals of European descent (22,233 cases and 64,762 controls), with replication genotyping in further samples, to identify susceptibility loci for coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21378990") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21378990+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We performed a meta-analysis of 14 genome-wide association studies of coronary artery disease (CAD) comprising 22,233 individuals with CAD (cases) and 64,762 controls of European descent followed by genotyping of top association signals in 56,682 additional individuals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000745> "A transatlantic consortium that meta-analysed 14 genome-wide association studies of coronary artery disease in individuals of European descent (22,233 cases and 64,762 controls), with replication genotyping in further samples, to identify susceptibility loci for coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21378990") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3119261/unicode") Annotation(rdfs:comment "Recognizing the need for larger studies, we formed the transatlantic Coronary ARtery DIsease Genome wide Replication and Meta-analysis (CARDIoGRAM) consortium .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000745> "A transatlantic consortium that meta-analysed 14 genome-wide association studies of coronary artery disease in individuals of European descent (22,233 cases and 64,762 controls), with replication genotyping in further samples, to identify susceptibility loci for coronary artery disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000746> (<http://www.ebi.ac.uk/coho/COHO_0000746>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37796845") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://sites.uab.edu/cnics/cnics-sites/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18263650") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2597168/") Annotation(rdfs:comment "The potential to build a comprehensive clinical data repository for HIV disease was greatly advanced by the work of CFAR investigators at the participating CNICS sites who had instituted point-of-care electronic medical record systems (EMRs) with the dual purpose of providing real-time clinical information to facilitate the delivery of HIV care and capturing standardized clinical data to support population-based HIV research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000746> "A longitudinal observational cohort of people with HIV who entered care from 1995 onwards at the HIV clinics of US Centers for AIDS Research (ten sites since 2021), whose data repository integrates clinical, laboratory and patient-reported outcome data from electronic health records for research on HIV care and outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37796845") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://sites.uab.edu/cnics/cnics-sites/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37796845") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10553320/fullTextXML") Annotation(rdfs:comment "Invited participants complete the CNICS clinical assessment of PROs on touch-screen tablets at routine clinic visits every ~4–6 months [13, 14].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000746> "A longitudinal observational cohort of people with HIV who entered care from 1995 onwards at the HIV clinics of US Centers for AIDS Research (ten sites since 2021), whose data repository integrates clinical, laboratory and patient-reported outcome data from electronic health records for research on HIV care and outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37796845") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://sites.uab.edu/cnics/cnics-sites/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37796845") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10553320/fullTextXML") Annotation(rdfs:comment "The CNICS data repository integrates comprehensive longitudinal data from outpatient and inpatient encounters [12].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000746> "A longitudinal observational cohort of people with HIV who entered care from 1995 onwards at the HIV clinics of US Centers for AIDS Research (ten sites since 2021), whose data repository integrates clinical, laboratory and patient-reported outcome data from electronic health records for research on HIV care and outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37796845") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://sites.uab.edu/cnics/cnics-sites/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37796845") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10553320/fullTextXML") Annotation(rdfs:comment "We conducted this study among PWH in the CNICS cohort [12], a well-characterized longitudinal observational cohort of PWH who enrolled in care at eight geographically distinct HIV clinics in the US from January 1995 through June 2020 at which time the data was accessed (http://www.uab.edu/cnics/).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000746> "A longitudinal observational cohort of people with HIV who entered care from 1995 onwards at the HIV clinics of US Centers for AIDS Research (ten sites since 2021), whose data repository integrates clinical, laboratory and patient-reported outcome data from electronic health records for research on HIV care and outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37796845") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://sites.uab.edu/cnics/cnics-sites/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sites.uab.edu/cnics/cnics-sites/") Annotation(rdfs:comment "The ten CNICS sites include CFARs with HIV clinics that have implemented point of care electronic data collection systems.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000746> "A longitudinal observational cohort of people with HIV who entered care from 1995 onwards at the HIV clinics of US Centers for AIDS Research (ten sites since 2021), whose data repository integrates clinical, laboratory and patient-reported outcome data from electronic health records for research on HIV care and outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37796845") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://sites.uab.edu/cnics/cnics-sites/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sites.uab.edu/cnics/cnics-sites/") Annotation(rdfs:comment "Vanderbilt University and University of Miami were added to the cohort in 2021.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000746> "A longitudinal observational cohort of people with HIV who entered care from 1995 onwards at the HIV clinics of US Centers for AIDS Research (ten sites since 2021), whose data repository integrates clinical, laboratory and patient-reported outcome data from electronic health records for research on HIV care and outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000747> (<http://www.ebi.ac.uk/coho/COHO_0000747>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24356592") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9727532/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24356592") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24356592+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "EDIC (1994-present) is an observational study of the DCCT cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000747> "A cohort of 1,441 people aged 13–39 years with type 1 diabetes from 29 centres in the United States and Canada, enrolled in the Diabetes Control and Complications Trial (1983–1993), a randomised trial comparing intensive with conventional therapy to test whether glycaemic control prevents or delays the complications of type 1 diabetes, and followed since 1994 in the observational Epidemiology of Diabetes Interventions and Complications (EDIC) study of the durability of the treatment effects on advanced microvascular complications and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24356592") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9727532/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24356592") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24356592+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The DCCT (1982-1993) was a controlled clinical trial in 1,441 subjects with T1DM comparing intensive therapy (INT), aimed at achieving levels of glycemia as close to the nondiabetic range as safely possible, with conventional therapy (CON), which aimed to maintain safe asymptomatic glucose control.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000747> "A cohort of 1,441 people aged 13–39 years with type 1 diabetes from 29 centres in the United States and Canada, enrolled in the Diabetes Control and Complications Trial (1983–1993), a randomised trial comparing intensive with conventional therapy to test whether glycaemic control prevents or delays the complications of type 1 diabetes, and followed since 1994 in the observational Epidemiology of Diabetes Interventions and Complications (EDIC) study of the durability of the treatment effects on advanced microvascular complications and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24356592") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9727532/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24356592") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24356592+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Diabetes Control and Complications Trial (DCCT) was designed to test the glucose hypothesis and determine whether the complications of type 1 diabetes (T1DM) could be prevented or delayed.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000747> "A cohort of 1,441 people aged 13–39 years with type 1 diabetes from 29 centres in the United States and Canada, enrolled in the Diabetes Control and Complications Trial (1983–1993), a randomised trial comparing intensive with conventional therapy to test whether glycaemic control prevents or delays the complications of type 1 diabetes, and followed since 1994 in the observational Epidemiology of Diabetes Interventions and Complications (EDIC) study of the durability of the treatment effects on advanced microvascular complications and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24356592") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9727532/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24356592") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24356592+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Epidemiology of Diabetes Interventions and Complications (EDIC) observational follow-up determined the durability of the DCCT effects on the more-advanced stages of diabetes complications including cardiovascular disease (CVD).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000747> "A cohort of 1,441 people aged 13–39 years with type 1 diabetes from 29 centres in the United States and Canada, enrolled in the Diabetes Control and Complications Trial (1983–1993), a randomised trial comparing intensive with conventional therapy to test whether glycaemic control prevents or delays the complications of type 1 diabetes, and followed since 1994 in the observational Epidemiology of Diabetes Interventions and Complications (EDIC) study of the durability of the treatment effects on advanced microvascular complications and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24356592") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9727532/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9727532/fullTextXML") Annotation(rdfs:comment "The DCCT was a multicenter randomized clinical trial, including 1441 volunteers (96%–97% Caucasian), aged 13 years to 39 years, with T1D of 1 year to 15 years duration from 29 medical centers in the United States and Canada conducted from 1983 to 1993, and aimed to compare conventional versus intensive therapy on blood glucose control and complications of diabetes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000747> "A cohort of 1,441 people aged 13–39 years with type 1 diabetes from 29 centres in the United States and Canada, enrolled in the Diabetes Control and Complications Trial (1983–1993), a randomised trial comparing intensive with conventional therapy to test whether glycaemic control prevents or delays the complications of type 1 diabetes, and followed since 1994 in the observational Epidemiology of Diabetes Interventions and Complications (EDIC) study of the durability of the treatment effects on advanced microvascular complications and cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000748> (<http://www.ebi.ac.uk/coho/COHO_0000748>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.dnbc.dk/about-the-dnbc") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31697338") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7266555/fullTextXML") Annotation(rdfs:comment "Statens Serum Institut, Denmark, is responsible for the data in the DNBC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000748> "A nationwide Danish cohort of 92,274 pregnant women recruited early in pregnancy between 1996 and 2002, run by Statens Serum Institut, with telephone interviews during pregnancy and after birth, biological samples from mother and umbilical cord, and long-term follow-up of the children through questionnaires and national registry linkage, established to study the causal links between early-life exposures and later disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.dnbc.dk/about-the-dnbc") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01343-9/MediaObjects/41588_2023_1343_MOESM1_ESM.pdf") Annotation(rdfs:comment "The DNBC is a collection of data on 92,274 pregnant women recruited between 1996 and 2002, from their first antenatal visit to their general practitioner.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000748> "A nationwide Danish cohort of 92,274 pregnant women recruited early in pregnancy between 1996 and 2002, run by Statens Serum Institut, with telephone interviews during pregnancy and after birth, biological samples from mother and umbilical cord, and long-term follow-up of the children through questionnaires and national registry linkage, established to study the causal links between early-life exposures and later disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.dnbc.dk/about-the-dnbc") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.dnbc.dk/about-the-dnbc") Annotation(rdfs:comment "Furthermore, a biological bank was set up with blood taken from the mother twice during pregnancy and blood from the umbilical cord taken shortly after birth.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000748> "A nationwide Danish cohort of 92,274 pregnant women recruited early in pregnancy between 1996 and 2002, run by Statens Serum Institut, with telephone interviews during pregnancy and after birth, biological samples from mother and umbilical cord, and long-term follow-up of the children through questionnaires and national registry linkage, established to study the causal links between early-life exposures and later disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.dnbc.dk/about-the-dnbc") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.dnbc.dk/about-the-dnbc") Annotation(rdfs:comment "In the DNBC initial data collection, data was collected by computer-assisted telephone interviews (CATI) with the women twice during pregnancy and when their children were six and 18 months old.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000748> "A nationwide Danish cohort of 92,274 pregnant women recruited early in pregnancy between 1996 and 2002, run by Statens Serum Institut, with telephone interviews during pregnancy and after birth, biological samples from mother and umbilical cord, and long-term follow-up of the children through questionnaires and national registry linkage, established to study the causal links between early-life exposures and later disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.dnbc.dk/about-the-dnbc") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.dnbc.dk/about-the-dnbc") Annotation(rdfs:comment "Prospectively collected exposure data and biological samples, an exceptionally large sample size and the possibility to follow all participants through linkages to national health registries - these are the main strengths of the Danish National Birth cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000748> "A nationwide Danish cohort of 92,274 pregnant women recruited early in pregnancy between 1996 and 2002, run by Statens Serum Institut, with telephone interviews during pregnancy and after birth, biological samples from mother and umbilical cord, and long-term follow-up of the children through questionnaires and national registry linkage, established to study the causal links between early-life exposures and later disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.dnbc.dk/about-the-dnbc") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.dnbc.dk/about-the-dnbc") Annotation(rdfs:comment "The Danish National Birth Cohort (DNBC) was established to investigate the causal link between exposures in early life and disease later on and the possibilities for disease prevention.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000748> "A nationwide Danish cohort of 92,274 pregnant women recruited early in pregnancy between 1996 and 2002, run by Statens Serum Institut, with telephone interviews during pregnancy and after birth, biological samples from mother and umbilical cord, and long-term follow-up of the children through questionnaires and national registry linkage, established to study the causal links between early-life exposures and later disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000749> (<http://www.ebi.ac.uk/coho/COHO_0000749>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18538025") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18538025") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2464602/fullTextXML") Annotation(rdfs:comment "Epidemiological data and DNA specimens were collected from 98.4% and 97.3% of cases, respectively (Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000749> "A population-based case-control study of lung cancer in the Lombardy region of Italy, which enrolled 2,101 incident primary lung cancer cases from 13 hospitals and 2,120 matched population controls in 2002–2005, collecting epidemiological, clinical and molecular data and biospecimens to study lung cancer aetiology from smoking addiction to outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18538025") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18538025") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2464602/fullTextXML") Annotation(rdfs:comment "The Environment And Genetics in Lung cancer Etiology (EAGLE) study is an integrative population-based study of lung cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000749> "A population-based case-control study of lung cancer in the Lombardy region of Italy, which enrolled 2,101 incident primary lung cancer cases from 13 hospitals and 2,120 matched population controls in 2002–2005, collecting epidemiological, clinical and molecular data and biospecimens to study lung cancer aetiology from smoking addiction to outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18538025") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18538025") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18538025+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Between 2002 and 2005, we enrolled 2101 incident primary lung cancer cases and 2120 population controls, with 86.6% and 72.4% participation rate, respectively, from a catchment area including 216 municipalities in the Lombardy region of Italy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000749> "A population-based case-control study of lung cancer in the Lombardy region of Italy, which enrolled 2,101 incident primary lung cancer cases from 13 hospitals and 2,120 matched population controls in 2002–2005, collecting epidemiological, clinical and molecular data and biospecimens to study lung cancer aetiology from smoking addiction to outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18538025") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18538025") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18538025+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "EAGLE is a new population-based case-control study that explores the full spectrum of lung cancer etiology, from smoking addiction to lung cancer outcome, through examination of epidemiological, molecular, and clinical data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000749> "A population-based case-control study of lung cancer in the Lombardy region of Italy, which enrolled 2,101 incident primary lung cancer cases from 13 hospitals and 2,120 matched population controls in 2002–2005, collecting epidemiological, clinical and molecular data and biospecimens to study lung cancer aetiology from smoking addiction to outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18538025") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18538025") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18538025+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Lung cancer cases were enrolled in 13 hospitals and population controls were randomly sampled from the area to match the cases by age, gender and residence.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000749> "A population-based case-control study of lung cancer in the Lombardy region of Italy, which enrolled 2,101 incident primary lung cancer cases from 13 hospitals and 2,120 matched population controls in 2002–2005, collecting epidemiological, clinical and molecular data and biospecimens to study lung cancer aetiology from smoking addiction to outcome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000750> (<http://www.ebi.ac.uk/coho/COHO_0000750>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30887376") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30887376") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6447695/fullTextXML") Annotation(rdfs:comment "Both consortia arose in 2009 out of the EU-funded European Network for Genetic And Genomic Epidemiology (ENGAGE).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000750> "A consortium of population-based pregnancy and birth cohort studies, set up alongside the Early Growth Genetics consortium, that pools genome-wide data to study the genetic basis of phenotypes from fetal life into adolescence such as asthma, eczema, childhood psychopathology, cognition and neurodevelopment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30887376") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30887376") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6447695/fullTextXML") Annotation(rdfs:comment "EAGLE was established to investigate the genetic basis of the wide range of further phenotypes collected by these cohorts from fetal life into adolescence, such as those relevant to asthma and eczema, childhood psychopathology, cognition, and neurodevelopment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000750> "A consortium of population-based pregnancy and birth cohort studies, set up alongside the Early Growth Genetics consortium, that pools genome-wide data to study the genetic basis of phenotypes from fetal life into adolescence such as asthma, eczema, childhood psychopathology, cognition and neurodevelopment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30887376") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30887376") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6447695/fullTextXML") Annotation(rdfs:comment "The aggregation of data in consortia such as EGG and EAGLE provides vastly improved sample sizes and a powerful way to overcome the major weakness of many of the early GWAS, which were, in hindsight, underpowered to detect the generally small genome-wide significant associations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000750> "A consortium of population-based pregnancy and birth cohort studies, set up alongside the Early Growth Genetics consortium, that pools genome-wide data to study the genetic basis of phenotypes from fetal life into adolescence such as asthma, eczema, childhood psychopathology, cognition and neurodevelopment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30887376") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30887376") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6447695/fullTextXML") Annotation(rdfs:comment "The collective objectives of EGG and EAGLE are:to characterize the genetic background of traits and diseases in fetal life, childhood and adolescence by facilitating collaboration between pregnancy, birth, childhood and adolescent cohort studies, as well as adult biobanks (such as UK Biobank) with relevant information;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000750> "A consortium of population-based pregnancy and birth cohort studies, set up alongside the Early Growth Genetics consortium, that pools genome-wide data to study the genetic basis of phenotypes from fetal life into adolescence such as asthma, eczema, childhood psychopathology, cognition and neurodevelopment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30887376") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30887376") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30887376+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The majority of the participating cohorts are longitudinal population-based samples, but other cohorts with data on early childhood phenotypes are also involved.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000750> "A consortium of population-based pregnancy and birth cohort studies, set up alongside the Early Growth Genetics consortium, that pools genome-wide data to study the genetic basis of phenotypes from fetal life into adolescence such as asthma, eczema, childhood psychopathology, cognition and neurodevelopment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30887376") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30887376") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30887376+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To achieve the sample sizes required for genetic research, the Early Growth Genetics (EGG) and EArly Genetics and Lifecourse Epidemiology (EAGLE) consortia were established.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000750> "A consortium of population-based pregnancy and birth cohort studies, set up alongside the Early Growth Genetics consortium, that pools genome-wide data to study the genetic basis of phenotypes from fetal life into adolescence such as asthma, eczema, childhood psychopathology, cognition and neurodevelopment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000751> (<http://www.ebi.ac.uk/coho/COHO_0000751>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30044860") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28815105") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5543359/fullTextXML") Annotation(rdfs:comment "All non-European American samples in BioVU as of 2011 were genotyped on the Illumina Metabochip14, 15 by the Vanderbilt University DNA Resources Core for the EAGLE group, a study site of the PAGE I study11.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000751> "The participants of BioVU, the Vanderbilt University Medical Center biorepository, studied by the Epidemiologic Architecture for Genes Linked to Environment (EAGLE) site of the NHGRI Population Architecture using Genomics and Epidemiology (PAGE) program in trans-ethnic genetic studies of complex traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30044860") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28815105") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5543359/fullTextXML") Annotation(rdfs:comment "The study population consists of 15,863 mostly non-European American subjects from BioVU, the Vanderbilt University Medical Center (VUMC) biorepository linked to de-identified EHRs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000751> "The participants of BioVU, the Vanderbilt University Medical Center biorepository, studied by the Epidemiologic Architecture for Genes Linked to Environment (EAGLE) site of the NHGRI Population Architecture using Genomics and Epidemiology (PAGE) program in trans-ethnic genetic studies of complex traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30044860") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28815105") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5543359/fullTextXML") Annotation(rdfs:comment "This subset of BioVU genotyped on Metabochip14, a custom array of 200,000 variants chosen from GWAS-index associations and fine-mapped regions based on the first iteration of the 1000 Genomes Project16, is hereto referred as “EAGLE BioVU.”") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000751> "The participants of BioVU, the Vanderbilt University Medical Center biorepository, studied by the Epidemiologic Architecture for Genes Linked to Environment (EAGLE) site of the NHGRI Population Architecture using Genomics and Epidemiology (PAGE) program in trans-ethnic genetic studies of complex traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30044860") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30044860") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6059436/fullTextXML") Annotation(rdfs:comment "The \"Epidemiologic Architecture for Genes Linked to Environment (EAGLE)\" was funded through the NHGRI PAGE program (U01HG004798 and its NHGRI ARRA supplement).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000751> "The participants of BioVU, the Vanderbilt University Medical Center biorepository, studied by the Epidemiologic Architecture for Genes Linked to Environment (EAGLE) site of the NHGRI Population Architecture using Genomics and Epidemiology (PAGE) program in trans-ethnic genetic studies of complex traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30044860") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30044860") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6059436/fullTextXML") Annotation(rdfs:comment "We investigated 32 AAM and 14 ANM previously-identified loci and sought to identify novel loci in a trans-ethnic array-wide study of 196,483 SNPs on the MetaboChip (Illumina, Inc.).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000751> "The participants of BioVU, the Vanderbilt University Medical Center biorepository, studied by the Epidemiologic Architecture for Genes Linked to Environment (EAGLE) site of the NHGRI Population Architecture using Genomics and Epidemiology (PAGE) program in trans-ethnic genetic studies of complex traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000752> (<http://www.ebi.ac.uk/coho/COHO_0000752>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001120.v1.p1") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33398198") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8148035/fullTextXML") Annotation(rdfs:comment "the Elucidating Loci Involved in Prostate Cancer Susceptibility OncoArray Consortium (ELLIPSE OncoArray), the United Kingdom GWAS (UK GWAS1 and UK GWAS2),") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000752> "An international prostate cancer genetics consortium, linked to the PRACTICAL consortium, that meta-analyses existing genome-wide association data and generates new GWAS, exome-array, iCOGS and OncoArray genotype data from prostate cancer case-control studies to discover prostate cancer risk loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001120.v1.p1") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001120.v1.p1") Annotation(rdfs:comment "It includes the meta-analysis of existing GWAS data as well as novel GWAS, exome, and iCOGS genotyping.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000752> "An international prostate cancer genetics consortium, linked to the PRACTICAL consortium, that meta-analyses existing genome-wide association data and generates new GWAS, exome-array, iCOGS and OncoArray genotype data from prostate cancer case-control studies to discover prostate cancer risk loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001120.v1.p1") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001120.v1.p1") Annotation(rdfs:comment "The ELLIPSE Consortium is an international effort to discover risk loci for prostate cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000752> "An international prostate cancer genetics consortium, linked to the PRACTICAL consortium, that meta-analyses existing genome-wide association data and generates new GWAS, exome-array, iCOGS and OncoArray genotype data from prostate cancer case-control studies to discover prostate cancer risk loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001120.v1.p1") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001120.v1.p1") Annotation(rdfs:comment "The GWAS meta-analysis includes the following cases and controls from studies of European ancestry: UK GWAS stage 1 (Illumina Infinium HumanHap 550 Array: 1854 cases and 1894 controls), UK GWAS stage 2 (Illumina iSELECT: 3706 cases and 3884 controls), CAPS1 (Affymetrix GeneChip 500K: 474 cases and 482 controls),") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000752> "An international prostate cancer genetics consortium, linked to the PRACTICAL consortium, that meta-analyses existing genome-wide association data and generates new GWAS, exome-array, iCOGS and OncoArray genotype data from prostate cancer case-control studies to discover prostate cancer risk loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001120.v1.p1") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(rdfs:comment "From ELLIPSE (linked to the PRACTICAL consortium), we contributed ~78,000 SNPs to the OncoArray.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000752> "An international prostate cancer genetics consortium, linked to the PRACTICAL consortium, that meta-analyses existing genome-wide association data and generates new GWAS, exome-array, iCOGS and OncoArray genotype data from prostate cancer case-control studies to discover prostate cancer risk loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000753> (<http://www.ebi.ac.uk/coho/COHO_0000753>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29531354") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(rdfs:comment "All ischemic stroke cases in this study were recruited from the Helsinki University Central Hospital, which is the only neurological emergency unit for a population of 1.5 million inhabitants73 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000753> "A hospital-based case-control study of ischaemic stroke in Finland, in which patients with neuroimaging-confirmed new-onset brain infarction were recruited at Helsinki University Central Hospital, with TOAST subtyping, detailed phenotype data and blood samples, and controls were FINRISK 1992, 1997 and 2002 participants from the Greater Helsinki region frequency-matched by age and sex, to investigate genetic factors underlying ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29531354") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(rdfs:comment "Detailed phenotype data were collected and recorded along with venous blood samples stored at -80° C freezer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000753> "A hospital-based case-control study of ischaemic stroke in Finland, in which patients with neuroimaging-confirmed new-onset brain infarction were recruited at Helsinki University Central Hospital, with TOAST subtyping, detailed phenotype data and blood samples, and controls were FINRISK 1992, 1997 and 2002 participants from the Greater Helsinki region frequency-matched by age and sex, to investigate genetic factors underlying ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29531354") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(rdfs:comment "Helsinki 2000 Ischemic Stroke Genetics Study was designed for investigating genetic factors underlying ischemic stroke in a Finnish population and in the long-term to be incorporated to multicenter multinational similar datasets.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000753> "A hospital-based case-control study of ischaemic stroke in Finland, in which patients with neuroimaging-confirmed new-onset brain infarction were recruited at Helsinki University Central Hospital, with TOAST subtyping, detailed phenotype data and blood samples, and controls were FINRISK 1992, 1997 and 2002 participants from the Greater Helsinki region frequency-matched by age and sex, to investigate genetic factors underlying ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29531354") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(rdfs:comment "Only patients with positive neuroimaging findings for a new- onset brain infarction were recruited following written informed consent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000753> "A hospital-based case-control study of ischaemic stroke in Finland, in which patients with neuroimaging-confirmed new-onset brain infarction were recruited at Helsinki University Central Hospital, with TOAST subtyping, detailed phenotype data and blood samples, and controls were FINRISK 1992, 1997 and 2002 participants from the Greater Helsinki region frequency-matched by age and sex, to investigate genetic factors underlying ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29531354") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(rdfs:comment "The controls were obtained from the FINRISK 1992, 1997, and 2002 study74 participants residing in the same geographic area (Greater Helsinki region).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000753> "A hospital-based case-control study of ischaemic stroke in Finland, in which patients with neuroimaging-confirmed new-onset brain infarction were recruited at Helsinki University Central Hospital, with TOAST subtyping, detailed phenotype data and blood samples, and controls were FINRISK 1992, 1997 and 2002 participants from the Greater Helsinki region frequency-matched by age and sex, to investigate genetic factors underlying ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29531354") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(rdfs:comment "The controls were obtained from the FINRISK 1992, 1997, and 2002 study74 participants residing in the same geographic area (Greater Helsinki region). They were frequency- matched to cases by age and sex, and were free of major adverse cardiovascular events.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000753> "A hospital-based case-control study of ischaemic stroke in Finland, in which patients with neuroimaging-confirmed new-onset brain infarction were recruited at Helsinki University Central Hospital, with TOAST subtyping, detailed phenotype data and blood samples, and controls were FINRISK 1992, 1997 and 2002 participants from the Greater Helsinki region frequency-matched by age and sex, to investigate genetic factors underlying ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34300314") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8305811/supplementaryFiles") Annotation(rdfs:comment "Stroke etiologic subtypes were classified according to the Trial of ORG 10172 in Acute Stroke Treatment (TOAST) [5]:") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000753> "A hospital-based case-control study of ischaemic stroke in Finland, in which patients with neuroimaging-confirmed new-onset brain infarction were recruited at Helsinki University Central Hospital, with TOAST subtyping, detailed phenotype data and blood samples, and controls were FINRISK 1992, 1997 and 2002 participants from the Greater Helsinki region frequency-matched by age and sex, to investigate genetic factors underlying ischaemic stroke.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000754> (<http://www.ebi.ac.uk/coho/COHO_0000754>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33456056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33456056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7811682/fullTextXML") Annotation(rdfs:comment "It started its activity on March 16, 2020, following approval by the Ethical Review Board of the Promoter Center, University of Siena (Protocol n. 16929, approval dated March 16, 2020).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000754> "A multicentre study coordinated by the University of Siena of SARS-CoV-2-positive individuals in Italy, hospitalised and non-hospitalised, whose biospecimens, detailed clinical data and exome and genotype data are collected in the GEN-COVID Biobank, Patient Registry and Genetic Data Repository to find genetic factors for COVID-19 susceptibility and severity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33456056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33456056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7811682/fullTextXML") Annotation(rdfs:comment "The GEN-COVID Multicenter Study includes a network of 22 Italian hospitals, 13 from Northern Italy, 5 from Central Italy, and 4 from Southern Italy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000754> "A multicentre study coordinated by the University of Siena of SARS-CoV-2-positive individuals in Italy, hospitalised and non-hospitalised, whose biospecimens, detailed clinical data and exome and genotype data are collected in the GEN-COVID Biobank, Patient Registry and Genetic Data Repository to find genetic factors for COVID-19 susceptibility and severity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33456056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33456056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33456056+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "GCB and GCPR are further linked to the GCGDR, which includes data from whole-exome sequencing and high-density SNP genotyping.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000754> "A multicentre study coordinated by the University of Siena of SARS-CoV-2-positive individuals in Italy, hospitalised and non-hospitalised, whose biospecimens, detailed clinical data and exome and genotype data are collected in the GEN-COVID Biobank, Patient Registry and Genetic Data Repository to find genetic factors for COVID-19 susceptibility and severity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33456056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33456056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33456056+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "It includes hospitalized patients (74.25%), broken down into intubated, treated by CPAP-biPAP, treated with O2 supplementation, and without respiratory support (9.5%, 18.4%, 31.55% and 14.8, respectively); and non-hospitalized subjects (25.75%), either pauci- or asymptomatic.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000754> "A multicentre study coordinated by the University of Siena of SARS-CoV-2-positive individuals in Italy, hospitalised and non-hospitalised, whose biospecimens, detailed clinical data and exome and genotype data are collected in the GEN-COVID Biobank, Patient Registry and Genetic Data Repository to find genetic factors for COVID-19 susceptibility and severity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33456056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33456056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33456056+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The GCB links samples to detailed clinical data available in the GEN-COVID Patient Registry (GCPR).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000754> "A multicentre study coordinated by the University of Siena of SARS-CoV-2-positive individuals in Italy, hospitalised and non-hospitalised, whose biospecimens, detailed clinical data and exome and genotype data are collected in the GEN-COVID Biobank, Patient Registry and Genetic Data Repository to find genetic factors for COVID-19 susceptibility and severity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33456056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33456056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33456056+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Within the GEN-COVID Multicenter Study, biospecimens from more than 1000 SARS-CoV-2 positive individuals have thus far been collected in the GEN-COVID Biobank (GCB).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000754> "A multicentre study coordinated by the University of Siena of SARS-CoV-2-positive individuals in Italy, hospitalised and non-hospitalised, whose biospecimens, detailed clinical data and exome and genotype data are collected in the GEN-COVID Biobank, Patient Registry and Genetic Data Repository to find genetic factors for COVID-19 susceptibility and severity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000755> (<http://www.ebi.ac.uk/coho/COHO_0000755>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31875139") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38561434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31875139") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6904202/fullTextXML") Annotation(rdfs:comment "We included 16 838 participants (7945 cases and 8893 controls) from seven nested case–control studies in prospective US cohorts and four case–control studies from the USA and Europe, from the Genetics and Epidemiology of Colorectal Cancer Consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000755> "A population-based case-control study of colorectal cancer in Hawaii, United States, in which Japanese, Caucasian and Native Hawaiian residents of Oahu newly diagnosed with colorectal adenocarcinoma between January 1994 and August 1998 were identified through the Hawaii SEER registry and matched by sex, ethnicity and age to controls from a population-based health survey of the Hawaii State Department of Health and from Health Care Financing Administration participants, with in-person interviews and blood samples; its genotyped participants take part in consortium studies of genetic and lifestyle risk factors for colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31875139") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38561434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38561434") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41416-024-02638-2/MediaObjects/41416_2024_2638_MOESM2_ESM.docx") Annotation(rdfs:comment "A blood sample was obtained from 548 (71%) of interviewed cases and 662 (86%) of interviewed controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000755> "A population-based case-control study of colorectal cancer in Hawaii, United States, in which Japanese, Caucasian and Native Hawaiian residents of Oahu newly diagnosed with colorectal adenocarcinoma between January 1994 and August 1998 were identified through the Hawaii SEER registry and matched by sex, ethnicity and age to controls from a population-based health survey of the Hawaii State Department of Health and from Health Care Financing Administration participants, with in-person interviews and blood samples; its genotyped participants take part in consortium studies of genetic and lifestyle risk factors for colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31875139") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38561434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38561434") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41416-024-02638-2/MediaObjects/41416_2024_2638_MOESM2_ESM.docx") Annotation(rdfs:comment "A questionnaire, administered during an in-person interview, included questions about demographics, lifetime history of tobacco, alcohol use, aspirin use, physical activity, personal medical history, family history of colorectal cancer, height and weight, diet (FFQ), and postmenopausal hormone use.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000755> "A population-based case-control study of colorectal cancer in Hawaii, United States, in which Japanese, Caucasian and Native Hawaiian residents of Oahu newly diagnosed with colorectal adenocarcinoma between January 1994 and August 1998 were identified through the Hawaii SEER registry and matched by sex, ethnicity and age to controls from a population-based health survey of the Hawaii State Department of Health and from Health Care Financing Administration participants, with in-person interviews and blood samples; its genotyped participants take part in consortium studies of genetic and lifestyle risk factors for colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31875139") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38561434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38561434") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41416-024-02638-2/MediaObjects/41416_2024_2638_MOESM2_ESM.docx") Annotation(rdfs:comment "Control subjects were selected from participants in an on-going population-based health survey conducted by the Hawaii State Department of Health and from Health Care Financing Administration participants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000755> "A population-based case-control study of colorectal cancer in Hawaii, United States, in which Japanese, Caucasian and Native Hawaiian residents of Oahu newly diagnosed with colorectal adenocarcinoma between January 1994 and August 1998 were identified through the Hawaii SEER registry and matched by sex, ethnicity and age to controls from a population-based health survey of the Hawaii State Department of Health and from Health Care Financing Administration participants, with in-person interviews and blood samples; its genotyped participants take part in consortium studies of genetic and lifestyle risk factors for colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31875139") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38561434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38561434") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41416-024-02638-2/MediaObjects/41416_2024_2638_MOESM2_ESM.docx") Annotation(rdfs:comment "Controls were matched to cases by sex, ethnicity, and age (within two years).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000755> "A population-based case-control study of colorectal cancer in Hawaii, United States, in which Japanese, Caucasian and Native Hawaiian residents of Oahu newly diagnosed with colorectal adenocarcinoma between January 1994 and August 1998 were identified through the Hawaii SEER registry and matched by sex, ethnicity and age to controls from a population-based health survey of the Hawaii State Department of Health and from Health Care Financing Administration participants, with in-person interviews and blood samples; its genotyped participants take part in consortium studies of genetic and lifestyle risk factors for colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31875139") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38561434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38561434") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41416-024-02638-2/MediaObjects/41416_2024_2638_MOESM2_ESM.docx") Annotation(rdfs:comment "Patients with colorectal cancer were identified through the rapid reporting system of the Hawaii SEER registry and consisted of all Japanese, Caucasian, and Native Hawaiian residents of Oahu who were newly diagnosed with an adenocarcinoma of the colon or rectum between January 1994 and August 1998.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000755> "A population-based case-control study of colorectal cancer in Hawaii, United States, in which Japanese, Caucasian and Native Hawaiian residents of Oahu newly diagnosed with colorectal adenocarcinoma between January 1994 and August 1998 were identified through the Hawaii SEER registry and matched by sex, ethnicity and age to controls from a population-based health survey of the Hawaii State Department of Health and from Health Care Financing Administration participants, with in-person interviews and blood samples; its genotyped participants take part in consortium studies of genetic and lifestyle risk factors for colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000756> (<http://www.ebi.ac.uk/coho/COHO_0000756>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40992798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(rdfs:comment "Briefly, the study participants, aged 45–75, were randomly selected from the residents’ registration offices of the cities of Bochum, Essen and Mülheim an der Ruhr, Germany.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000756> "A population-based cohort of 4,814 adults aged 45–75 randomly selected from the resident registries of Bochum, Essen and Mülheim an der Ruhr in the Ruhr area of Germany, examined in 2000–2003 and followed up repeatedly, set up to evaluate coronary artery calcification measured by electron-beam CT for predicting myocardial infarction and cardiac death beyond traditional risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40992798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(rdfs:comment "N=4814 participants aged 45–75 years were included in the baseline examination (T0) between 2000 and 2003 (recruitment rate: 55.8%).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000756> "A population-based cohort of 4,814 adults aged 45–75 randomly selected from the resident registries of Bochum, Essen and Mülheim an der Ruhr in the Ruhr area of Germany, examined in 2000–2003 and followed up repeatedly, set up to evaluate coronary artery calcification measured by electron-beam CT for predicting myocardial infarction and cardiac death beyond traditional risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40992798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(rdfs:comment "Our study aim is to evaluate the AF prevalence and incidence in the population-based Heinz Nixdorf Recall (HNR) study over 20 years and to quantify undetected or probably insufficiently treated AF.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000756> "A population-based cohort of 4,814 adults aged 45–75 randomly selected from the resident registries of Bochum, Essen and Mülheim an der Ruhr in the Ruhr area of Germany, examined in 2000–2003 and followed up repeatedly, set up to evaluate coronary artery calcification measured by electron-beam CT for predicting myocardial infarction and cardiac death beyond traditional risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40992798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(rdfs:comment "The initial aim of the HNR study was to evaluate the predictive value of coronary artery calcification using electron beam CT for myocardial infarction and cardiac death besides traditional cardiovascular risk factors (see Schmermund et al16).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000756> "A population-based cohort of 4,814 adults aged 45–75 randomly selected from the resident registries of Bochum, Essen and Mülheim an der Ruhr in the Ruhr area of Germany, examined in 2000–2003 and followed up repeatedly, set up to evaluate coronary artery calcification measured by electron-beam CT for predicting myocardial infarction and cardiac death beyond traditional risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40992798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(rdfs:comment "These cities belong to the Ruhr area, a conglomerate of large industrial cities.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000756> "A population-based cohort of 4,814 adults aged 45–75 randomly selected from the resident registries of Bochum, Essen and Mülheim an der Ruhr in the Ruhr area of Germany, examined in 2000–2003 and followed up repeatedly, set up to evaluate coronary artery calcification measured by electron-beam CT for predicting myocardial infarction and cardiac death beyond traditional risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40992798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(rdfs:comment "We analysed data from 4814 participants at baseline 2000–2003 (T0, 50.2% women, 45–75 years), first and second follow-up examination (T1: n=4157, 2005–2008; T2: n=3087, 2010–2015) and yearly postal questionnaires for the AF occurrence until 29 November 2023.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000756> "A population-based cohort of 4,814 adults aged 45–75 randomly selected from the resident registries of Bochum, Essen and Mülheim an der Ruhr in the Ruhr area of Germany, examined in 2000–2003 and followed up repeatedly, set up to evaluate coronary artery calcification measured by electron-beam CT for predicting myocardial infarction and cardiac death beyond traditional risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000757> (<http://www.ebi.ac.uk/coho/COHO_0000757>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35024781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39854657") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9307937/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35024781") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8759029/") Annotation(rdfs:comment "In brief, patients with lung cancer were enrolled at the Karmanos Cancer Institute or Henry Ford Health System within 12 months of diagnosis, between May 15, 2012, and March 31, 2018, at Karmanos Cancer Institute and between May 15, 2012, and November 26, 2014, at Henry Ford Health System.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000757> "A case-control study of lung cancer in African American and non-Hispanic White adults from the Detroit metropolitan area, in which patients were enrolled within 12 months of diagnosis at the Karmanos Cancer Institute or Henry Ford Health System between 2012 and 2018, together with controls without lung cancer, to study inflammation, ancestry and other risk factors for lung cancer and racial disparities in the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35024781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39854657") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9307937/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35024781") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35024781+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Patients with lung cancer and controls were 21 to 89 years of age; patients with lung cancer who were never smokers and controls who were never smokers were not included in these analyses.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000757> "A case-control study of lung cancer in African American and non-Hispanic White adults from the Detroit metropolitan area, in which patients were enrolled within 12 months of diagnosis at the Karmanos Cancer Institute or Henry Ford Health System between 2012 and 2018, together with controls without lung cancer, to study inflammation, ancestry and other risk factors for lung cancer and racial disparities in the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35024781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39854657") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9307937/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35024781") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35024781+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This study included 912 patients with lung cancer and 1457 controls without lung cancer enrolled in an epidemiology study (INHALE [Inflammation, Health, Ancestry, and Lung Epidemiology]) in the Detroit metropolitan area between May 15, 2012, and March 31, 2018.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000757> "A case-control study of lung cancer in African American and non-Hispanic White adults from the Detroit metropolitan area, in which patients were enrolled within 12 months of diagnosis at the Karmanos Cancer Institute or Henry Ford Health System between 2012 and 2018, together with controls without lung cancer, to study inflammation, ancestry and other risk factors for lung cancer and racial disparities in the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35024781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39854657") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9307937/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39854657") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC11771983") Annotation(rdfs:comment "These P/LP variants were genotyped in a sample of 3,040 lung cancer cases and controls from the INHALE study (non-Hispanic White: n=1,915; African American: n=1,125) and were tested for their association with lung cancer using multivariate logistic regression adjusting for age, sex, pack-years, and race.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000757> "A case-control study of lung cancer in African American and non-Hispanic White adults from the Detroit metropolitan area, in which patients were enrolled within 12 months of diagnosis at the Karmanos Cancer Institute or Henry Ford Health System between 2012 and 2018, together with controls without lung cancer, to study inflammation, ancestry and other risk factors for lung cancer and racial disparities in the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000758> (<http://www.ebi.ac.uk/coho/COHO_0000758>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11109115/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11109115/fullTextXML") Annotation(rdfs:comment "Between October 1991 and February 1994 a randomly selected subgroup of 6103 MDC participants was included into a study focusing on carotid artery disease epidemiology (MDC-CV)12.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000758> "A randomly selected subgroup of about 6,100 participants of the Malmö Diet and Cancer Study in Malmö, Sweden, enrolled between 1991 and 1994 into a sub-study of carotid artery disease and cardiovascular risk, with fasting blood samples used in studies of cardiovascular and metabolic disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11109115/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11109115/fullTextXML") Annotation(rdfs:comment "The MDC study included a random sample of individuals from Malmö, Sweden, born between 1926 and 1945 and included between March 1991 and September 199611.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000758> "A randomly selected subgroup of about 6,100 participants of the Malmö Diet and Cancer Study in Malmö, Sweden, enrolled between 1991 and 1994 into a sub-study of carotid artery disease and cardiovascular risk, with fasting blood samples used in studies of cardiovascular and metabolic disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11109115/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11109115/fullTextXML") Annotation(rdfs:comment "We performed a genome-wide association study to identify genetic determinants of plasma sRAGE in 4338 individuals from the cardiovascular arm of the Malmö Diet and Cancer study (MDC-CV).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000758> "A randomly selected subgroup of about 6,100 participants of the Malmö Diet and Cancer Study in Malmö, Sweden, enrolled between 1991 and 1994 into a sub-study of carotid artery disease and cardiovascular risk, with fasting blood samples used in studies of cardiovascular and metabolic disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11109115/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(rdfs:comment "Between October 1991 and February 1994, every other MDCS participant was invited to join a sub-study on cardiovascular disease risk (MDCS-CC; N = 6103) [19].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000758> "A randomly selected subgroup of about 6,100 participants of the Malmö Diet and Cancer Study in Malmö, Sweden, enrolled between 1991 and 1994 into a sub-study of carotid artery disease and cardiovascular risk, with fasting blood samples used in studies of cardiovascular and metabolic disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11109115/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(rdfs:comment "Blood samples were donated at baseline after an overnight fast.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000758> "A randomly selected subgroup of about 6,100 participants of the Malmö Diet and Cancer Study in Malmö, Sweden, enrolled between 1991 and 1994 into a sub-study of carotid artery disease and cardiovascular risk, with fasting blood samples used in studies of cardiovascular and metabolic disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11109115/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(rdfs:comment "Using the large, population-based Malmö Diet and Cancer Study–Cardiovascular Cohort (MDCS-CC), we aimed to examine whether circulating galectin-1 levels associate with incident CKD and type 2 diabetes, independently of established risk factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000758> "A randomly selected subgroup of about 6,100 participants of the Malmö Diet and Cancer Study in Malmö, Sweden, enrolled between 1991 and 1994 into a sub-study of carotid artery disease and cardiovascular risk, with fasting blood samples used in studies of cardiovascular and metabolic disease.")

