# Individual: <http://www.ebi.ac.uk/coho/COHO_0002096> (<http://www.ebi.ac.uk/coho/COHO_0002096>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16960812") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17164261") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17579606") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19763258") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16960812") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC1592559") Annotation(rdfs:comment "Participants were of AA origin from the Mid-South To- bacco Family (MSTF) cohort, recruited primarily from the states of Tennessee, Mississippi, and Arkansas during1999– 2004.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002096> "A family-based genetic study of nicotine dependence in which African American and European American smoker probands (aged at least 21, smoking at least 20 cigarettes a day for the preceding year and for at least five years) were recruited in the Mid-South states of the United States, primarily Tennessee, Mississippi and Arkansas, in 1999–2004, together with their biological parents and full siblings, with nicotine dependence assessed by smoking quantity, the Heaviness of Smoking Index and the Fagerström Test for Nicotine Dependence, for linkage and association studies of nicotine dependence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16960812") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17164261") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17579606") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19763258") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19763258") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2739294/fullTextXML") Annotation(rdfs:comment "After a smoker proband was identified, we attempted to recruit the biological parents and all full siblings.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002096> "A family-based genetic study of nicotine dependence in which African American and European American smoker probands (aged at least 21, smoking at least 20 cigarettes a day for the preceding year and for at least five years) were recruited in the Mid-South states of the United States, primarily Tennessee, Mississippi and Arkansas, in 1999–2004, together with their biological parents and full siblings, with nicotine dependence assessed by smoking quantity, the Heaviness of Smoking Index and the Fagerström Test for Nicotine Dependence, for linkage and association studies of nicotine dependence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16960812") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17164261") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17579606") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19763258") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19763258") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2739294/fullTextXML") Annotation(rdfs:comment "In this study, we genotyped 5 and 33 single nucleotide polymorphisms (SNPs) for GABAB receptor subunit 1 and 2 genes (GABBR1, GABBR2), respectively, in a sample of 2037 individuals from 602 nuclear families of African- American (AA) or European-American (EA) origin.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002096> "A family-based genetic study of nicotine dependence in which African American and European American smoker probands (aged at least 21, smoking at least 20 cigarettes a day for the preceding year and for at least five years) were recruited in the Mid-South states of the United States, primarily Tennessee, Mississippi and Arkansas, in 1999–2004, together with their biological parents and full siblings, with nicotine dependence assessed by smoking quantity, the Heaviness of Smoking Index and the Fagerström Test for Nicotine Dependence, for linkage and association studies of nicotine dependence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16960812") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17164261") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17579606") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19763258") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19763258") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2739294/fullTextXML") Annotation(rdfs:comment "Proband smokers were required to be at least 21 years old, to have smoked for at least the last five years, and to have consumed at least 20 cigarettes per day for the preceding 12 months.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002096> "A family-based genetic study of nicotine dependence in which African American and European American smoker probands (aged at least 21, smoking at least 20 cigarettes a day for the preceding year and for at least five years) were recruited in the Mid-South states of the United States, primarily Tennessee, Mississippi and Arkansas, in 1999–2004, together with their biological parents and full siblings, with nicotine dependence assessed by smoking quantity, the Heaviness of Smoking Index and the Fagerström Test for Nicotine Dependence, for linkage and association studies of nicotine dependence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16960812") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17164261") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17579606") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19763258") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19763258") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2739294/fullTextXML") Annotation(rdfs:comment "The AA and EA participants were recruited from the US Mid-South States during 1999–2004 [10], [12], [18].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002096> "A family-based genetic study of nicotine dependence in which African American and European American smoker probands (aged at least 21, smoking at least 20 cigarettes a day for the preceding year and for at least five years) were recruited in the Mid-South states of the United States, primarily Tennessee, Mississippi and Arkansas, in 1999–2004, together with their biological parents and full siblings, with nicotine dependence assessed by smoking quantity, the Heaviness of Smoking Index and the Fagerström Test for Nicotine Dependence, for linkage and association studies of nicotine dependence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16960812") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17164261") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17579606") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19763258") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19763258") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2739294/fullTextXML") Annotation(rdfs:comment "The ND of probands and other smoker participants was assessed with the three measures commonly used in the tobacco research field: Smoking Quantity (SQ; number of cigarettes smoked per day), the Heaviness of Smoking Index (HSI; 0–6 scale), and the Fagerström Test for Nicotine Dependence score (FTND; 0–10 scale) as a continuous variable.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002096> "A family-based genetic study of nicotine dependence in which African American and European American smoker probands (aged at least 21, smoking at least 20 cigarettes a day for the preceding year and for at least five years) were recruited in the Mid-South states of the United States, primarily Tennessee, Mississippi and Arkansas, in 1999–2004, together with their biological parents and full siblings, with nicotine dependence assessed by smoking quantity, the Heaviness of Smoking Index and the Fagerström Test for Nicotine Dependence, for linkage and association studies of nicotine dependence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002097> (<http://www.ebi.ac.uk/coho/COHO_0002097>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29059683") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23535729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2563/MediaObjects/41588_2013_BFng2563_MOESM7_ESM.pdf") Annotation(rdfs:comment "All cases are postmenopausal women (47-75 years) living in Montreal with a primary invasive") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002097> "A population-based case-control study of breast cancer in Montreal, Canada, whose cases were postmenopausal women aged 47 to 75 years living in Montreal with a first primary invasive breast cancer, identified from 2007 to 2010 in 15 of the 16 Montreal hospitals that treat breast cancer, and whose controls were a random sample of women living in Montreal from the provincial voter registration list, frequency-matched to cases on age; a member study of the Breast Cancer Association Consortium.")
