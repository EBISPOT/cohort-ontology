AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18326421") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24149084") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18326421") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18326421+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "On the basis of these experiences, a birth cohort study should be implemented in Italy at a national level.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002625> "A prospective birth cohort of children born between June 2003 and October 2004 in two hospitals in Rome, Italy, to mothers resident in the district of the Local Health Unit RME, followed up through childhood as a pilot for a national Italian birth cohort, to study genetic and environmental influences on child health.")
