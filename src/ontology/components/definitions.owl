AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35627254") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35627254") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9142038/fullTextXML") Annotation(rdfs:comment "The first sub-cohort, Steno 2007, consisted of 500 individuals with T1D, of which 77 were excluded due to insufficient material.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000982> "A sub-cohort of the Danish Childhood Diabetes Register (DanDiabKids) made up of individuals newly diagnosed with type 1 diabetes, whose serum was sampled within three months of clinical onset and who had been genotyped on the ImmunoChip array.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000983> (<http://www.ebi.ac.uk/coho/COHO_0000983>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37492634") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37492634") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10364164/fullTextXML") Annotation(rdfs:comment "Participants were enrolled at either Duke University Medical Center or East Carolina University (ECU).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000983> "A group of three randomised trials of supervised exercise training, STRRIDE I (1999–2003), STRRIDE AT/RT (2004–2008) and STRRIDE-PD (2009–2012), that enrolled previously sedentary adults with overweight or obesity and mild-to-moderate dyslipidaemia or prediabetes at Duke University Medical Center and East Carolina University, to study the effects of exercise amount, mode and intensity, and of weight loss by caloric restriction, on cardiometabolic health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37492634") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37492634") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10364164/fullTextXML") Annotation(rdfs:comment "STRRIDE I (1999–2003) and STRRIDE AT/RT (2004–2008) enrolled previously sedentary adults with overweight or obesity and mild-to-moderate dyslipidemia (classified by LDL-cholesterol 130–190 mg/dl or HDL-cholesterol ≤40 mg/dl for men and ≤45 mg/dl for women).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000983> "A group of three randomised trials of supervised exercise training, STRRIDE I (1999–2003), STRRIDE AT/RT (2004–2008) and STRRIDE-PD (2009–2012), that enrolled previously sedentary adults with overweight or obesity and mild-to-moderate dyslipidaemia or prediabetes at Duke University Medical Center and East Carolina University, to study the effects of exercise amount, mode and intensity, and of weight loss by caloric restriction, on cardiometabolic health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37492634") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37492634") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10364164/fullTextXML") Annotation(rdfs:comment "STRRIDE-PD (2009–2012) enrolled previously sedentary adults with overweight or obesity and prediabetes (defined as two consecutive fasting glucose concentrations ≥95 to <126 mg/dl taken 1 week apart).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000983> "A group of three randomised trials of supervised exercise training, STRRIDE I (1999–2003), STRRIDE AT/RT (2004–2008) and STRRIDE-PD (2009–2012), that enrolled previously sedentary adults with overweight or obesity and mild-to-moderate dyslipidaemia or prediabetes at Duke University Medical Center and East Carolina University, to study the effects of exercise amount, mode and intensity, and of weight loss by caloric restriction, on cardiometabolic health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37492634") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37492634") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10364164/fullTextXML") Annotation(rdfs:comment "The STRRIDE trials reflect supervised lifestyle intervention conditions, thus may not be as generalizable or representative of real-world situations surrounding exercise and diet program dropout.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000983> "A group of three randomised trials of supervised exercise training, STRRIDE I (1999–2003), STRRIDE AT/RT (2004–2008) and STRRIDE-PD (2009–2012), that enrolled previously sedentary adults with overweight or obesity and mild-to-moderate dyslipidaemia or prediabetes at Duke University Medical Center and East Carolina University, to study the effects of exercise amount, mode and intensity, and of weight loss by caloric restriction, on cardiometabolic health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37492634") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37492634") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10364164/fullTextXML") Annotation(rdfs:comment "The three STRRIDE (Studies of a Targeted Risk Reduction Intervention through Defined Exercise) randomized trials investigated the effects of exercise amount, mode, intensity, and weight loss (via caloric restriction) on cardiometabolic health among adults with overweight or obesity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000983> "A group of three randomised trials of supervised exercise training, STRRIDE I (1999–2003), STRRIDE AT/RT (2004–2008) and STRRIDE-PD (2009–2012), that enrolled previously sedentary adults with overweight or obesity and mild-to-moderate dyslipidaemia or prediabetes at Duke University Medical Center and East Carolina University, to study the effects of exercise amount, mode and intensity, and of weight loss by caloric restriction, on cardiometabolic health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000984> (<http://www.ebi.ac.uk/coho/COHO_0000984>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33418499") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7804602/fullTextXML") Annotation(rdfs:comment "For East Asian SNVs, we used data from the Rare Variants for Hypertension in Taiwan Chinese (THRV) study, which was sequenced in the TOPMed freeze 8 using methods described above.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000984> "A study of rare variants for hypertension in Taiwan Chinese that combines three cohorts based in Taiwan: families from the SAPPHIRe study, launched in 1995, with at least two hypertensive siblings, and unrelated participants from Tri-Service General Hospital and Taichung Veterans General Hospital matched to SAPPHIRe participants for age, sex and BMI category. All its participants were selected for whole-genome sequencing in the NHLBI TOPMed programme.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35183128") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8858539/supplementaryFiles") Annotation(rdfs:comment "The THRV-TOPMed study consists of three participating cohorts: The SAPPHIRe Family Cohort, TSGH (Tri-Service General Hospital, a hospital-based cohort), and TCVGH (Taichung Veterans General Hospital, another hospital-based cohort), all based in Taiwan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000984> "A study of rare variants for hypertension in Taiwan Chinese that combines three cohorts based in Taiwan: families from the SAPPHIRe study, launched in 1995, with at least two hypertensive siblings, and unrelated participants from Tri-Service General Hospital and Taichung Veterans General Hospital matched to SAPPHIRe participants for age, sex and BMI category. All its participants were selected for whole-genome sequencing in the NHLBI TOPMed programme.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38816422") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11139858/supplementaryFiles") Annotation(rdfs:comment "The SAPPHIRe families were recruited to have two or more hypertensive sibs, with some families having one normotensive/hypotensive sib.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000984> "A study of rare variants for hypertension in Taiwan Chinese that combines three cohorts based in Taiwan: families from the SAPPHIRe study, launched in 1995, with at least two hypertensive siblings, and unrelated participants from Tri-Service General Hospital and Taichung Veterans General Hospital matched to SAPPHIRe participants for age, sex and BMI category. All its participants were selected for whole-genome sequencing in the NHLBI TOPMed programme.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml") Annotation(rdfs:comment "All 2,353 THRV subjects were selected for whole genome sequencing through the NHLBI TOPMed WGS program.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000984> "A study of rare variants for hypertension in Taiwan Chinese that combines three cohorts based in Taiwan: families from the SAPPHIRe study, launched in 1995, with at least two hypertensive siblings, and unrelated participants from Tri-Service General Hospital and Taichung Veterans General Hospital matched to SAPPHIRe participants for age, sex and BMI category. All its participants were selected for whole-genome sequencing in the NHLBI TOPMed programme.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml") Annotation(rdfs:comment "The parent SAPPHIRe study, launched in 1995, includes sibships that include at least 2 HTN cases and a normotensive/hypotensive sib when available.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000984> "A study of rare variants for hypertension in Taiwan Chinese that combines three cohorts based in Taiwan: families from the SAPPHIRe study, launched in 1995, with at least two hypertensive siblings, and unrelated participants from Tri-Service General Hospital and Taichung Veterans General Hospital matched to SAPPHIRe participants for age, sex and BMI category. All its participants were selected for whole-genome sequencing in the NHLBI TOPMed programme.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml") Annotation(rdfs:comment "The two Hospital-based cohorts (TSGH and TCVGH) both recruited unrelated subjects with different recruitment criteria (matched with SAPPHIRe subjects for age, sex, and BMI category).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000984> "A study of rare variants for hypertension in Taiwan Chinese that combines three cohorts based in Taiwan: families from the SAPPHIRe study, launched in 1995, with at least two hypertensive siblings, and unrelated participants from Tri-Service General Hospital and Taichung Veterans General Hospital matched to SAPPHIRe participants for age, sex and BMI category. All its participants were selected for whole-genome sequencing in the NHLBI TOPMed programme.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000985> (<http://www.ebi.ac.uk/coho/COHO_0000985>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33568819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30535219") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6436530/") Annotation(rdfs:comment "The Trans-Omics for Precision Medicine (TOPMed) Program is an National Heart Lung and Blood Institute funded initiative to perform whole genome sequencing to facilitate genetic discovery in complex human diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000985> "A programme of the National Heart, Lung, and Blood Institute (NHLBI) that adds whole-genome sequencing and other omics data to existing, deeply phenotyped studies of ethnically and ancestrally diverse participants, to elucidate the genetic architecture and biology of heart, lung, blood and sleep disorders and improve their diagnosis, treatment and prevention.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33568819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33568819") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7875770/fullTextXML") Annotation(rdfs:comment "A key goal of the TOPMed programme is to understand risk factors for heart, lung, blood and sleep disorders by adding WGS and other ‘omics’ data to existing studies with deep phenotyping (Supplementary Information 1.1 and Supplementary Fig. 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000985> "A programme of the National Heart, Lung, and Blood Institute (NHLBI) that adds whole-genome sequencing and other omics data to existing, deeply phenotyped studies of ethnically and ancestrally diverse participants, to elucidate the genetic architecture and biology of heart, lung, blood and sleep disorders and improve their diagnosis, treatment and prevention.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33568819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33568819") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7875770/fullTextXML") Annotation(rdfs:comment "TOPMed participants are ethnically and ancestrally diverse (Extended Data Fig. 1, Supplementary Information 1.1.4 and Supplementary Fig. 2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000985> "A programme of the National Heart, Lung, and Blood Institute (NHLBI) that adds whole-genome sequencing and other omics data to existing, deeply phenotyped studies of ethnically and ancestrally diverse participants, to elucidate the genetic architecture and biology of heart, lung, blood and sleep disorders and improve their diagnosis, treatment and prevention.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33568819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33568819") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7875770/fullTextXML") Annotation(rdfs:comment "The Trans-Omics for Precision Medicine (TOPMed) programme seeks to elucidate the genetic architecture and biology of heart, lung, blood and sleep disorders, with the ultimate goal of improving diagnosis, treatment and prevention of these diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000985> "A programme of the National Heart, Lung, and Blood Institute (NHLBI) that adds whole-genome sequencing and other omics data to existing, deeply phenotyped studies of ethnically and ancestrally diverse participants, to elucidate the genetic architecture and biology of heart, lung, blood and sleep disorders and improve their diagnosis, treatment and prevention.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000986> (<http://www.ebi.ac.uk/coho/COHO_0000986>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32067027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32067027") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7069346/fullTextXML") Annotation(rdfs:comment "Hip and forearm fracture cases were identified by merging the NSHDS cohort with medical records and radiographic reports.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000986> "A population-based study sampled from the Northern Sweden Health and Disease Study cohort in the county of Västerbotten, Sweden, whose hip and forearm fracture cases, identified by linking the cohort with medical records and radiographic reports, are compared with controls from the same cohort to identify the genetic and environmental determinants of osteoporotic fractures.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32067027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32067027") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7069346/fullTextXML") Annotation(rdfs:comment "The UFO-forearm fracture study is a nested case-control study in which each fracture case is compared with 1 control selected from the NSHDS cohort, matched for gender and age at recruitment, comprising a total of 2172 subjects of whom 2115 passed the quality check for genotyping.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000986> "A population-based study sampled from the Northern Sweden Health and Disease Study cohort in the county of Västerbotten, Sweden, whose hip and forearm fracture cases, identified by linking the cohort with medical records and radiographic reports, are compared with controls from the same cohort to identify the genetic and environmental determinants of osteoporotic fractures.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32067027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32067027") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7069346/fullTextXML") Annotation(rdfs:comment "The Umeå Fracture and Osteoporosis (UFO) study is a population-based study designed to identify the genetic and environmental determinants of osteoporotic fractures.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000986> "A population-based study sampled from the Northern Sweden Health and Disease Study cohort in the county of Västerbotten, Sweden, whose hip and forearm fracture cases, identified by linking the cohort with medical records and radiographic reports, are compared with controls from the same cohort to identify the genetic and environmental determinants of osteoporotic fractures.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32067027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32067027") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7069346/fullTextXML") Annotation(rdfs:comment "This cohort is sampled from the Northern Sweden Health and Disease Study (NSHDS), a longitudinal, population-based cohort study from Northern Sweden, consisting of blood samples, and lifestyle and dietary data from approximately 100 000 unique individuals from the county of Västerbotten (approximately 255 000 inhabitants as of Dec 31, 2007) (30, 31).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000986> "A population-based study sampled from the Northern Sweden Health and Disease Study cohort in the county of Västerbotten, Sweden, whose hip and forearm fracture cases, identified by linking the cohort with medical records and radiographic reports, are compared with controls from the same cohort to identify the genetic and environmental determinants of osteoporotic fractures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000987> (<http://www.ebi.ac.uk/coho/COHO_0000987>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12672732") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12672732") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12672732+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In the MSH Patients' Follow-up, conducted in 1996-2001, patients could continue, stop, or start hydroxyurea.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000987> "A randomised, double-blind, placebo-controlled trial, conducted in 1992–1995 at 21 sickle cell referral centres in the United States and Canada, of whether hydroxyurea reduces vaso-occlusive events in adults with sickle cell anaemia and frequent painful episodes, whose participants were then followed observationally in 1996–2001.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12672732") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12672732") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12672732+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Inpatients and outpatients in 21 sickle cell referral centers in the United States and Canada.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000987> "A randomised, double-blind, placebo-controlled trial, conducted in 1992–1995 at 21 sickle cell referral centres in the United States and Canada, of whether hydroxyurea reduces vaso-occlusive events in adults with sickle cell anaemia and frequent painful episodes, whose participants were then followed observationally in 1996–2001.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12672732") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12672732") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12672732+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Long-term observational follow-up study of mortality in patients with SCA who originally participated in the randomized, double-blind, placebo-controlled Multicenter Study of Hydroxyurea in Sickle Cell Anemia (MSH), conducted in 1992-1995, to determine if hydroxyurea reduces vaso-occlusive events.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000987> "A randomised, double-blind, placebo-controlled trial, conducted in 1992–1995 at 21 sickle cell referral centres in the United States and Canada, of whether hydroxyurea reduces vaso-occlusive events in adults with sickle cell anaemia and frequent painful episodes, whose participants were then followed observationally in 1996–2001.")
