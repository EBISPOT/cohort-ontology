AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16887023") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20732625") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21473745") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21473745") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3082291/fullTextXML") Annotation(rdfs:comment "Further entry criteria for assessment were: white Caucasian ethnicity of all participants, availability of one or more sibling, children between the ages of 5 and 17 years, participation of a minimum of four family members including one parent, and consent of all persons to give blood samples or buccal swabs for DNA extraction.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000607> "A European multi-site family sample of children aged 5 to 17 with DSM-IV combined-type ADHD, their siblings and parents, all of white European Caucasian descent, recruited in 2003-2007 at specialist ADHD clinics in eight countries for molecular genetic studies of ADHD, including candidate-gene, linkage and genome-wide association analyses; a second phase (IMAGE II) combined ADHD cases from the original project and from further clinics in Germany, the Netherlands and the UK with population controls for genome-wide association.")
