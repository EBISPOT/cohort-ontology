# Individual: <http://www.ebi.ac.uk/coho/COHO_0001034> (<http://www.ebi.ac.uk/coho/COHO_0001034>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15531754") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37227431") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15531754") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15531754+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Postal questionnaires were used to follow up the 1,924 singleton children born to the cohort at 6, 12, and 24 months of age.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001034> "An unselected birth cohort established in 1997 in Aberdeen, United Kingdom, recruiting pregnant women through an antenatal clinic and following their children prospectively from birth, to investigate how antenatal dietary exposures relate to asthma, wheeze and eczema in childhood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15531754") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37227431") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15531754") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15531754+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Two thousand women were recruited for a prospective investigation of the influence of maternal antioxidant intake in pregnancy on the development of asthma and eczema in children.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001034> "An unselected birth cohort established in 1997 in Aberdeen, United Kingdom, recruiting pregnant women through an antenatal clinic and following their children prospectively from birth, to investigate how antenatal dietary exposures relate to asthma, wheeze and eczema in childhood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15531754") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37227431") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37227431") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10292845/fullTextXML") Annotation(rdfs:comment "SEATON is an unselected birth cohort study established in 1997 in Aberdeen, UK, which was designed to explore the relationship between antenatal dietary exposures and asthma outcomes in childhood (Martindale et al., 2005).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001034> "An unselected birth cohort established in 1997 in Aberdeen, United Kingdom, recruiting pregnant women through an antenatal clinic and following their children prospectively from birth, to investigate how antenatal dietary exposures relate to asthma, wheeze and eczema in childhood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15531754") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37227431") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37227431") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10292845/fullTextXML") Annotation(rdfs:comment "Two-thousand healthy pregnant women attending an antenatal clinic, at median 12 weeks gestation, were recruited.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001034> "An unselected birth cohort established in 1997 in Aberdeen, United Kingdom, recruiting pregnant women through an antenatal clinic and following their children prospectively from birth, to investigate how antenatal dietary exposures relate to asthma, wheeze and eczema in childhood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001035> (<http://www.ebi.ac.uk/coho/COHO_0001035>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25306249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25582225") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00413205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19056711") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2720107/") Annotation(rdfs:comment "In fact, a large Phase II study of a γ-selective retinoid agonist (TESRA) includes longitudinal assessment of lung density as a pre-specified secondary endpoint (http://www.clinicaltrials.gov/ct2/show/NCT00413205?term=retinoic+acid+AND+emphysemaandrank=2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001035> "A multicentre, double-blind, randomised, placebo-controlled phase II trial sponsored by Hoffmann-La Roche and run from 2007 to 2010 at sites in Europe, Israel, South Africa and the United States, in which ex-smokers over 44 years old with smoking-related moderate to severe COPD with emphysema, on optimised COPD therapy, were assigned to the gamma-selective retinoid agonist palovarotene or placebo.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25306249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25582225") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00413205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25306249") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4198701/fullTextXML") Annotation(rdfs:comment "TESRA was a multi-centered randomized controlled trial assessing the safety and efficacy of palovarotene in ex-smokers with COPD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001035> "A multicentre, double-blind, randomised, placebo-controlled phase II trial sponsored by Hoffmann-La Roche and run from 2007 to 2010 at sites in Europe, Israel, South Africa and the United States, in which ex-smokers over 44 years old with smoking-related moderate to severe COPD with emphysema, on optimised COPD therapy, were assigned to the gamma-selective retinoid agonist palovarotene or placebo.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25306249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25582225") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00413205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28790817") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC5531723") Annotation(rdfs:comment "RARγ agonist (2 year treatment) was tested for ability to improve lung function in patients with emphysema in DBPCRT (NCT00413205); in patients with lower lobe emphysema, palovarotene significantly reduced the decline in lung function (from conference report).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001035> "A multicentre, double-blind, randomised, placebo-controlled phase II trial sponsored by Hoffmann-La Roche and run from 2007 to 2010 at sites in Europe, Israel, South Africa and the United States, in which ex-smokers over 44 years old with smoking-related moderate to severe COPD with emphysema, on optimised COPD therapy, were assigned to the gamma-selective retinoid agonist palovarotene or placebo.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25306249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25582225") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00413205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28848918") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC5559108") Annotation(rdfs:comment "The Treatment of Emphysema with a Selective Retinoid Agonist (TESRA) trial was a multicenter randomized, placebo-controlled clinical trial of palovarotene in COPD (clinicaltrials.gov identifier NCT00413205).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001035> "A multicentre, double-blind, randomised, placebo-controlled phase II trial sponsored by Hoffmann-La Roche and run from 2007 to 2010 at sites in Europe, Israel, South Africa and the United States, in which ex-smokers over 44 years old with smoking-related moderate to severe COPD with emphysema, on optimised COPD therapy, were assigned to the gamma-selective retinoid agonist palovarotene or placebo.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25306249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25582225") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00413205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28848918") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5559108/") Annotation(rdfs:comment "Based on enrollment criteria in the TESRA trial, which included moderate-to-severe COPD with emphysema, study participants tended to be more homogeneous than the general COPD patient population, which may limit the ability to identify subgroups (as demonstrated in Supplemental Figure 2 (160.2KB, pdf) ) and may also limit generalizability.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001035> "A multicentre, double-blind, randomised, placebo-controlled phase II trial sponsored by Hoffmann-La Roche and run from 2007 to 2010 at sites in Europe, Israel, South Africa and the United States, in which ex-smokers over 44 years old with smoking-related moderate to severe COPD with emphysema, on optimised COPD therapy, were assigned to the gamma-selective retinoid agonist palovarotene or placebo.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25306249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25582225") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00413205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30694715") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6503619/") Annotation(rdfs:comment "The TESRA study (Treatment of Emphysema with a Gamma-Selective Retinoid Agonist) was funded by Hoffmann-La Roche.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001035> "A multicentre, double-blind, randomised, placebo-controlled phase II trial sponsored by Hoffmann-La Roche and run from 2007 to 2010 at sites in Europe, Israel, South Africa and the United States, in which ex-smokers over 44 years old with smoking-related moderate to severe COPD with emphysema, on optimised COPD therapy, were assigned to the gamma-selective retinoid agonist palovarotene or placebo.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001036> (<http://www.ebi.ac.uk/coho/COHO_0001036>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37594959") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9551285") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24124113") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3968231/") Annotation(rdfs:comment "TRIPOD recruited non-diabetic women with history of GDM in the Los Angeles area; family members were not recruited.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001036> "A single-centre, randomised, double-masked, placebo-controlled trial in which nondiabetic Hispanic women with prior gestational diabetes mellitus, recruited in the Los Angeles area, United States, were assigned to troglitazone or placebo to test whether treating insulin resistance improves insulin sensitivity, preserves pancreatic beta-cell function and prevents type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37594959") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9551285") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37594959") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10020015/fullTextXML") Annotation(rdfs:comment "Based on the results of our longitudinal studies of glucose regulation described above, we hypothesized that amelioration of chronic insulin resistance would preserve β-cell function and delay or prevent the onset of T2D in high-risk Hispanic women with prior GDM.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001036> "A single-centre, randomised, double-masked, placebo-controlled trial in which nondiabetic Hispanic women with prior gestational diabetes mellitus, recruited in the Los Angeles area, United States, were assigned to troglitazone or placebo to test whether treating insulin resistance improves insulin sensitivity, preserves pancreatic beta-cell function and prevents type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37594959") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9551285") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37594959") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10020015/fullTextXML") Annotation(rdfs:comment "We randomized 266 Hispanic women with history of GDM to placebo or the insulin-sensitizing thiazolidinedione medication troglitazone in a 1:1 ratio (TRIPOD [Troglitazone in the Prevention of Diabetes] study) (25).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001036> "A single-centre, randomised, double-masked, placebo-controlled trial in which nondiabetic Hispanic women with prior gestational diabetes mellitus, recruited in the Los Angeles area, United States, were assigned to troglitazone or placebo to test whether treating insulin resistance improves insulin sensitivity, preserves pancreatic beta-cell function and prevents type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37594959") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9551285") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9551285") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9551285+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The TRoglitazone In the Prevention Of Diabetes (TRIPOD) trial is a single-center, randomized, placebo-controlled, double-masked study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001036> "A single-centre, randomised, double-masked, placebo-controlled trial in which nondiabetic Hispanic women with prior gestational diabetes mellitus, recruited in the Los Angeles area, United States, were assigned to troglitazone or placebo to test whether treating insulin resistance improves insulin sensitivity, preserves pancreatic beta-cell function and prevents type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37594959") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9551285") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9551285") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9551285+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The primary aim of the TRIPOD trial is to test the hypothesis that chronic administration of troglitazone to nondiabetic women with prior gestational diabetes mellitus (GDM) will improve whole-body insulin sensitivity and reduce the incidence of non-insulin-dependent diabetes (NIDDM).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001036> "A single-centre, randomised, double-masked, placebo-controlled trial in which nondiabetic Hispanic women with prior gestational diabetes mellitus, recruited in the Los Angeles area, United States, were assigned to troglitazone or placebo to test whether treating insulin resistance improves insulin sensitivity, preserves pancreatic beta-cell function and prevents type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001037> (<http://www.ebi.ac.uk/coho/COHO_0001037>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27502059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27869827") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5032181/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27502059") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4991346/fullTextXML") Annotation(rdfs:comment "One thousand one hundred fifty-eight healthy adult volunteers (54% female; median age 39.2 years; range 18–97 years) were prospectively recruited by newspaper advertisement as part of the UK Digital Heart Project (www.digital-heart.org) between March 2011 and January 2015.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001037> "A cohort of healthy adult volunteers without known cardiovascular disease, recruited prospectively by advertisement from 2011 at the MRC Clinical Sciences Centre, Imperial College London, United Kingdom, who underwent standard and high-resolution three-dimensional cardiac magnetic resonance imaging and genotyping, to study the genetic determinants of cardiac structure and function.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27502059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27869827") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5032181/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27502059") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4991346/fullTextXML") Annotation(rdfs:comment "We excluded participants at screening who had known cardiovascular disease or were being treated for hypertension, diabetes mellitus, or hypercholesterolemia, or had a first degree relative with cardiomyopathy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001037> "A cohort of healthy adult volunteers without known cardiovascular disease, recruited prospectively by advertisement from 2011 at the MRC Clinical Sciences Centre, Imperial College London, United Kingdom, who underwent standard and high-resolution three-dimensional cardiac magnetic resonance imaging and genotyping, to study the genetic determinants of cardiac structure and function.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27502059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27869827") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5032181/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5032181/fullTextXML") Annotation(rdfs:comment "Healthy volunteers (n = 1850; 55% females, mean age 41 ± 13 years) were recruited prospectively to the Digital Heart Project and underwent both standard CMR and high-spatial resolution 3D-CMR (Philips 1.5T Achieva, Best, Netherlands).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001037> "A cohort of healthy adult volunteers without known cardiovascular disease, recruited prospectively by advertisement from 2011 at the MRC Clinical Sciences Centre, Imperial College London, United Kingdom, who underwent standard and high-resolution three-dimensional cardiac magnetic resonance imaging and genotyping, to study the genetic determinants of cardiac structure and function.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27502059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27869827") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5032181/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5032181/fullTextXML") Annotation(rdfs:comment "In an attempt to overcome the limitations of human heart GWASs to date, we developed high-resolution 3D-cardiac MRI (3D-CMR) techniques combined with computational image analysis and dense genotyping to examine the common genetic determinants of cardiac structure and function.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001037> "A cohort of healthy adult volunteers without known cardiovascular disease, recruited prospectively by advertisement from 2011 at the MRC Clinical Sciences Centre, Imperial College London, United Kingdom, who underwent standard and high-resolution three-dimensional cardiac magnetic resonance imaging and genotyping, to study the genetic determinants of cardiac structure and function.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27502059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27869827") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5032181/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5032181/fullTextXML") Annotation(rdfs:comment "Subjects were genotyped using a standard SNP array and genotypes were imputed against a combined UK10K / 1000 Genomes reference panel, after which 9.4 million variants were available for the GWAS.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001037> "A cohort of healthy adult volunteers without known cardiovascular disease, recruited prospectively by advertisement from 2011 at the MRC Clinical Sciences Centre, Imperial College London, United Kingdom, who underwent standard and high-resolution three-dimensional cardiac magnetic resonance imaging and genotyping, to study the genetic determinants of cardiac structure and function.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001038> (<http://www.ebi.ac.uk/coho/COHO_0001038>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11174041") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14762035") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11174041") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11174041+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Patients at least 35 years old with a nondisabling ischemic stroke within 120 days, and screening plasma H(e) > the 25th percentile of benchmark population data are eligible.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001038> "A double-blind, randomised, multicentre trial run from 1996 to 2003 at 56 hospitals and neurology practices in the United States, Canada and Scotland, in which adults aged 35 or older with a recent nondisabling ischaemic stroke and a screening plasma homocysteine above the 25th percentile received high-dose or low-dose folic acid, vitamin B6 and vitamin B12, to test whether lowering homocysteine prevents recurrent stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11174041") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14762035") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11174041") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11174041+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Vitamin Intervention for Stroke Prevention (VISP) study is a double-masked, randomized, multicenter clinical trial designed to determine if, in addition to best medical/surgical management, high-dose folic acid, vitamin B6, and vitamin B12 supplements will reduce recurrent stroke compared to lower doses of these vitamins.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001038> "A double-blind, randomised, multicentre trial run from 1996 to 2003 at 56 hospitals and neurology practices in the United States, Canada and Scotland, in which adults aged 35 or older with a recent nondisabling ischaemic stroke and a screening plasma homocysteine above the 25th percentile received high-dose or low-dose folic acid, vitamin B6 and vitamin B12, to test whether lowering homocysteine prevents recurrent stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11174041") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14762035") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14762035") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14762035+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "3680 adults with nondisabling cerebral infarction at 56 university-affiliated hospitals, community hospitals, private neurology practices, and Veterans Affairs medical centers across the United States, Canada, and Scotland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001038> "A double-blind, randomised, multicentre trial run from 1996 to 2003 at 56 hospitals and neurology practices in the United States, Canada and Scotland, in which adults aged 35 or older with a recent nondisabling ischaemic stroke and a screening plasma homocysteine above the 25th percentile received high-dose or low-dose folic acid, vitamin B6 and vitamin B12, to test whether lowering homocysteine prevents recurrent stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11174041") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14762035") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14762035") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14762035+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Double-blind randomized controlled trial (September 1996-May 2003).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001038> "A double-blind, randomised, multicentre trial run from 1996 to 2003 at 56 hospitals and neurology practices in the United States, Canada and Scotland, in which adults aged 35 or older with a recent nondisabling ischaemic stroke and a screening plasma homocysteine above the 25th percentile received high-dose or low-dose folic acid, vitamin B6 and vitamin B12, to test whether lowering homocysteine prevents recurrent stroke.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001039> (<http://www.ebi.ac.uk/coho/COHO_0001039>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38741014") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38741014") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf") Annotation(rdfs:comment "After quality control, we included 308 cases and 292 controls of African ancestry from WAABCS in the OncoArray consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001039> "A hospital-based case-control study of breast cancer in women of African ancestry, established in Nigeria in 1998 and expanded to Uganda and Cameroon in 2011 using the same questionnaires and protocol.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38741014") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38741014") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf") Annotation(rdfs:comment "The WAABCS is a hospital-based case-control study originally started in Nigeria in 1998 and was expanded to Uganda and Cameroon in 2011 with the same questionnaires and protocol31,32 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001039> "A hospital-based case-control study of breast cancer in women of African ancestry, established in Nigeria in 1998 and expanded to Uganda and Cameroon in 2011 using the same questionnaires and protocol.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001040> (<http://www.ebi.ac.uk/coho/COHO_0001040>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22238593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31092297") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2608/MediaObjects/41588_2013_BFng2608_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22238593") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3251563/fullTextXML") Annotation(rdfs:comment "Unrelated African-American controls without a current diagnosis of diabetes or renal disease were recruited from the community and internal medicine clinics (controls).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001040> "A case-control study of African Americans in North Carolina, South Carolina, Georgia, Tennessee and Virginia, United States, recruited by Wake Forest School of Medicine for genetic studies of type 2 diabetes and nephropathy. Cases with type 2 diabetes and end-stage kidney disease were recruited from dialysis facilities and controls without diabetes or kidney disease from the community and internal medicine clinics, later joined by people with type 2 diabetes but no nephropathy and people with non-diabetic end-stage kidney disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22238593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31092297") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2608/MediaObjects/41588_2013_BFng2608_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31092297") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1186%2Fs40246-019-0205-7/MediaObjects/40246_2019_205_MOESM1_ESM.zip") Annotation(rdfs:comment "In addition, 1910 subjects with non-diabetic ESKD lacked diabetes (or had T2D for <5 years) at initiation of renal replacement therapy, and ESKD was attributed to chronic glomerular disease (e.g., focal segmental glomerulosclerosis), HIV-associated nephropathy, hypertension or unknown cause were included.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001040> "A case-control study of African Americans in North Carolina, South Carolina, Georgia, Tennessee and Virginia, United States, recruited by Wake Forest School of Medicine for genetic studies of type 2 diabetes and nephropathy. Cases with type 2 diabetes and end-stage kidney disease were recruited from dialysis facilities and controls without diabetes or kidney disease from the community and internal medicine clinics, later joined by people with type 2 diabetes but no nephropathy and people with non-diabetic end-stage kidney disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22238593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31092297") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2608/MediaObjects/41588_2013_BFng2608_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31092297") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1186%2Fs40246-019-0205-7/MediaObjects/40246_2019_205_MOESM1_ESM.zip") Annotation(rdfs:comment "The WFSM is a cross-sectional case-control study designed to examine the genetics of T2D and end-stage renal disease (ESRD) in African Americans.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001040> "A case-control study of African Americans in North Carolina, South Carolina, Georgia, Tennessee and Virginia, United States, recruited by Wake Forest School of Medicine for genetic studies of type 2 diabetes and nephropathy. Cases with type 2 diabetes and end-stage kidney disease were recruited from dialysis facilities and controls without diabetes or kidney disease from the community and internal medicine clinics, later joined by people with type 2 diabetes but no nephropathy and people with non-diabetic end-stage kidney disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22238593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31092297") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2608/MediaObjects/41588_2013_BFng2608_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2608/MediaObjects/41588_2013_BFng2608_MOESM1_ESM.pdf") Annotation(rdfs:comment "All subjects were recruited in North Carolina, South Carolina, Georgia, Tennessee, or Virginia.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001040> "A case-control study of African Americans in North Carolina, South Carolina, Georgia, Tennessee and Virginia, United States, recruited by Wake Forest School of Medicine for genetic studies of type 2 diabetes and nephropathy. Cases with type 2 diabetes and end-stage kidney disease were recruited from dialysis facilities and controls without diabetes or kidney disease from the community and internal medicine clinics, later joined by people with type 2 diabetes but no nephropathy and people with non-diabetic end-stage kidney disease.")
