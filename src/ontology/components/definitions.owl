AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12189166") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20372189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20372189") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fejhg.2010.38/MediaObjects/41431_2010_BFejhg201038_MOESM31_ESM.pdf") Annotation(rdfs:comment "Asthmatic subjects and controls were selected from the Nottingham area from 3 study cohorts recruited over the period 1995-2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002185> "A family-based study of the genetics of asthma in Nottingham, United Kingdom, whose families were recruited on the basis of pairs of siblings affected by asthma and were used in association studies of candidate genes with atopy; its index cases, children with asthma of European ancestry, later served as childhood asthma cases in a genetic study of the 17q21 asthma locus.")
