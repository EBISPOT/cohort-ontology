AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23668689") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27565998") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3132306/unicode") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5669824/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3132306/unicode") Annotation(rdfs:comment "We included women aged 18 years or older undergoing screening mammography between January 7, 2004, and April 8, 2006 at the California Pacific Medical Center Breast Health Center, a participant in the San Francisco Mammography Registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001630> "A cohort of women having screening mammography at the Breast Health Center of California Pacific Medical Center in San Francisco, California, United States, an imaging facility of the San Francisco Mammography Registry (part of the NCI Breast Cancer Surveillance Consortium), who completed the registry's demographic and risk-factor questionnaire and, from 2004 to 2011, were asked to give blood for research and consent to genotyping; breast cancers are ascertained by linkage to the California Cancer Registry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001631> (<http://www.ebi.ac.uk/coho/COHO_0001631>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19507171") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20578893") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30452777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31083486") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4610716/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19507171") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19507171+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Surveillance clinicians identified, enrolled, and collected clinical data and biological samples from ADR cases and controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001631> "A pan-Canadian collection of children and adults treated with drugs of interest who have been enrolled since 2005 by trained surveillance clinicians at major Canadian hospitals (first paediatric hospitals, as the Genotype-specific Approaches to Therapy in Childhood network), either as cases of serious adverse drug reactions, such as anthracycline-induced cardiotoxicity or cisplatin-induced hearing loss, or as drug-tolerant controls, and whose clinical data and biological samples are collected for genetic association studies to find genomic predictors of adverse drug reactions. The network is based at the University of British Columbia in Vancouver.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19507171") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20578893") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30452777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31083486") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4610716/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19507171") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19507171+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Surveillance was targeted to three ADRs: anthracycline-induced cardiotoxicity, cisplatin-induced hearing impairment, and codeine-induced mortality in breastfed infants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001631> "A pan-Canadian collection of children and adults treated with drugs of interest who have been enrolled since 2005 by trained surveillance clinicians at major Canadian hospitals (first paediatric hospitals, as the Genotype-specific Approaches to Therapy in Childhood network), either as cases of serious adverse drug reactions, such as anthracycline-induced cardiotoxicity or cisplatin-induced hearing loss, or as drug-tolerant controls, and whose clinical data and biological samples are collected for genetic association studies to find genomic predictors of adverse drug reactions. The network is based at the University of British Columbia in Vancouver.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19507171") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20578893") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30452777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31083486") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4610716/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19507171") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19507171+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The initial surveillance site was established in September 2005, with 10 sites fully operational by 2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001631> "A pan-Canadian collection of children and adults treated with drugs of interest who have been enrolled since 2005 by trained surveillance clinicians at major Canadian hospitals (first paediatric hospitals, as the Genotype-specific Approaches to Therapy in Childhood network), either as cases of serious adverse drug reactions, such as anthracycline-induced cardiotoxicity or cisplatin-induced hearing loss, or as drug-tolerant controls, and whose clinical data and biological samples are collected for genetic association studies to find genomic predictors of adverse drug reactions. The network is based at the University of British Columbia in Vancouver.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19507171") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20578893") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30452777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31083486") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4610716/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20578893") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20578893+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A surveillance network has been established in 17 of Canada's major hospitals to identify patients experiencing specific ADRs and to collect biological samples and relevant clinical history for genetic association studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001631> "A pan-Canadian collection of children and adults treated with drugs of interest who have been enrolled since 2005 by trained surveillance clinicians at major Canadian hospitals (first paediatric hospitals, as the Genotype-specific Approaches to Therapy in Childhood network), either as cases of serious adverse drug reactions, such as anthracycline-induced cardiotoxicity or cisplatin-induced hearing loss, or as drug-tolerant controls, and whose clinical data and biological samples are collected for genetic association studies to find genomic predictors of adverse drug reactions. The network is based at the University of British Columbia in Vancouver.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19507171") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20578893") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30452777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31083486") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4610716/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20578893") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20578893+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Canadian Pharmacogenomics Network for Drug Safety is a nation-wide effort established in Canada to identify novel predictive genomic markers of severe ADRs in children and adults.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001631> "A pan-Canadian collection of children and adults treated with drugs of interest who have been enrolled since 2005 by trained surveillance clinicians at major Canadian hospitals (first paediatric hospitals, as the Genotype-specific Approaches to Therapy in Childhood network), either as cases of serious adverse drug reactions, such as anthracycline-induced cardiotoxicity or cisplatin-induced hearing loss, or as drug-tolerant controls, and whose clinical data and biological samples are collected for genetic association studies to find genomic predictors of adverse drug reactions. The network is based at the University of British Columbia in Vancouver.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19507171") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20578893") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30452777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31083486") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4610716/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6562793/") Annotation(rdfs:comment "at the Canadian Pharmacogenomics Network for Drug Safety at the University of British Columbia.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001631> "A pan-Canadian collection of children and adults treated with drugs of interest who have been enrolled since 2005 by trained surveillance clinicians at major Canadian hospitals (first paediatric hospitals, as the Genotype-specific Approaches to Therapy in Childhood network), either as cases of serious adverse drug reactions, such as anthracycline-induced cardiotoxicity or cisplatin-induced hearing loss, or as drug-tolerant controls, and whose clinical data and biological samples are collected for genetic association studies to find genomic predictors of adverse drug reactions. The network is based at the University of British Columbia in Vancouver.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19507171") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20578893") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30452777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31083486") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4610716/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4610716/unicode") Annotation(rdfs:comment "Originally funded by Genome Canada as the ‘Genotype-specific Approaches to Therapy in Children (GATC)’ network, the program has evolved into the CPNDS with CAD$20M of additional funding (2009–2013) from the Canadian Institutes of Health Research and the Canada Foundation for Innovation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001631> "A pan-Canadian collection of children and adults treated with drugs of interest who have been enrolled since 2005 by trained surveillance clinicians at major Canadian hospitals (first paediatric hospitals, as the Genotype-specific Approaches to Therapy in Childhood network), either as cases of serious adverse drug reactions, such as anthracycline-induced cardiotoxicity or cisplatin-induced hearing loss, or as drug-tolerant controls, and whose clinical data and biological samples are collected for genetic association studies to find genomic predictors of adverse drug reactions. The network is based at the University of British Columbia in Vancouver.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001632> (<http://www.ebi.ac.uk/coho/COHO_0001632>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36335348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38030128") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41662368") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9406673") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36335348") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9637304/fullTextXML") Annotation(rdfs:comment "Briefly, in 1995–1996 (CRISPS-1), 2895 Hong Kong Chinese, aged 25–74, were randomly recruited from the general population of Hong Kong to undergo a comprehensive assessment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001632> "A prospective population-based cohort of Hong Kong Chinese adults aged 25–74, recruited in 1995–1996 through randomly generated telephone numbers from the general population of Hong Kong for a baseline survey of the prevalence of cardiovascular risk factors (CRISPS-1), with a comprehensive assessment including a 75-g oral glucose tolerance test, and re-examined with similar protocols in 2000–2004, 2005–2008, 2010–2012 and 2016–2018 (CRISPS-2 to CRISPS-5) to study the development of cardiovascular risk factors such as diabetes and hypertension.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36335348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38030128") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41662368") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9406673") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36335348") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9637304/fullTextXML") Annotation(rdfs:comment "CRISPS is a prospective, population-based longitudinal cohort designed to study the development of cardiovascular risk factors, including diabetes, in Hong Kong from 1995 to 2018.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001632> "A prospective population-based cohort of Hong Kong Chinese adults aged 25–74, recruited in 1995–1996 through randomly generated telephone numbers from the general population of Hong Kong for a baseline survey of the prevalence of cardiovascular risk factors (CRISPS-1), with a comprehensive assessment including a 75-g oral glucose tolerance test, and re-examined with similar protocols in 2000–2004, 2005–2008, 2010–2012 and 2016–2018 (CRISPS-2 to CRISPS-5) to study the development of cardiovascular risk factors such as diabetes and hypertension.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36335348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38030128") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41662368") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9406673") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36335348") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9637304/fullTextXML") Annotation(rdfs:comment "Subjects were followed up in CRISPS-2 (2000–2004), CRISPS-3 (2005–2008), CRISPS-4 (2010–2012) and CRISPS-5 (2016–2018).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001632> "A prospective population-based cohort of Hong Kong Chinese adults aged 25–74, recruited in 1995–1996 through randomly generated telephone numbers from the general population of Hong Kong for a baseline survey of the prevalence of cardiovascular risk factors (CRISPS-1), with a comprehensive assessment including a 75-g oral glucose tolerance test, and re-examined with similar protocols in 2000–2004, 2005–2008, 2010–2012 and 2016–2018 (CRISPS-2 to CRISPS-5) to study the development of cardiovascular risk factors such as diabetes and hypertension.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36335348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38030128") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41662368") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9406673") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41662368") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12904575/fullTextXML") Annotation(rdfs:comment "Participants of CRISPS were invited to attend subsequent visits every 4–5 years (CRISPS-2 to -5; the last visit in CRISPS-5 was in 2016–2018) with similar assessment protocols including 75-g oral glucose tolerance tests.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001632> "A prospective population-based cohort of Hong Kong Chinese adults aged 25–74, recruited in 1995–1996 through randomly generated telephone numbers from the general population of Hong Kong for a baseline survey of the prevalence of cardiovascular risk factors (CRISPS-1), with a comprehensive assessment including a 75-g oral glucose tolerance test, and re-examined with similar protocols in 2000–2004, 2005–2008, 2010–2012 and 2016–2018 (CRISPS-2 to CRISPS-5) to study the development of cardiovascular risk factors such as diabetes and hypertension.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36335348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38030128") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41662368") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9406673") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41662368") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12904575/fullTextXML") Annotation(rdfs:comment "The recruitment for CRISPS was done through randomly generated telephone numbers providing a random sample of the population, while the recruitment for N-CRISPS was done through mail invitations to residents of randomly selected households with addresses registered at the Census and Statistics Department.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001632> "A prospective population-based cohort of Hong Kong Chinese adults aged 25–74, recruited in 1995–1996 through randomly generated telephone numbers from the general population of Hong Kong for a baseline survey of the prevalence of cardiovascular risk factors (CRISPS-1), with a comprehensive assessment including a 75-g oral glucose tolerance test, and re-examined with similar protocols in 2000–2004, 2005–2008, 2010–2012 and 2016–2018 (CRISPS-2 to CRISPS-5) to study the development of cardiovascular risk factors such as diabetes and hypertension.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001634> (<http://www.ebi.ac.uk/coho/COHO_0001634>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11349227") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11793707") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11349227") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC1226130/") Annotation(rdfs:comment "Because it is possible that different genes, as well as environmental exposures, influence asthma and asthma-associated phenotypes in individuals of different ethnic backgrounds, three ethnic groups (African Americans, European Americans, and Hispanics) were ascertained in this study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001634> "A multicentre family study of the genetics of asthma supported by the US National Heart, Lung, and Blood Institute, in which African American, European American and Hispanic families were ascertained through two siblings with asthma at centres at Johns Hopkins University, the University of Chicago, the University of Minnesota and the University of Maryland, to identify loci contributing to asthma and asthma-associated phenotypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11349227") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11793707") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11349227") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC1226130/") Annotation(rdfs:comment "Families were ascertained through two siblings with asthma and then were expanded to include other affected relatives, by extending the family either through relatives with asthma or through one unaffected relative.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001634> "A multicentre family study of the genetics of asthma supported by the US National Heart, Lung, and Blood Institute, in which African American, European American and Hispanic families were ascertained through two siblings with asthma at centres at Johns Hopkins University, the University of Chicago, the University of Minnesota and the University of Maryland, to identify loci contributing to asthma and asthma-associated phenotypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11349227") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11793707") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11349227") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC1226130/") Annotation(rdfs:comment "In brief, families were ascertained at the four CSGA centers: (1) Johns Hopkins University (Baltimore), with additional recruitment of families at Howard University (Washington, D.C.); (2) The University of Chicago; (3) the University of Minnesota; and (4) the University of Maryland, with additional recruitment of families at the University of New Mexico.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001634> "A multicentre family study of the genetics of asthma supported by the US National Heart, Lung, and Blood Institute, in which African American, European American and Hispanic families were ascertained through two siblings with asthma at centres at Johns Hopkins University, the University of Chicago, the University of Minnesota and the University of Maryland, to identify loci contributing to asthma and asthma-associated phenotypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11349227") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11793707") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11349227") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC1226130/") Annotation(rdfs:comment "The Collaborative Study on the Genetics of Asthma (CSGA) is a multicenter collaborative study supported by the National Heart, Lung and Blood Institute of the NIH (NHLBI/NIH), whose purpose is to identify important loci that contribute to the development of asthma and asthma-associated phenotypes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001634> "A multicentre family study of the genetics of asthma supported by the US National Heart, Lung, and Blood Institute, in which African American, European American and Hispanic families were ascertained through two siblings with asthma at centres at Johns Hopkins University, the University of Chicago, the University of Minnesota and the University of Maryland, to identify loci contributing to asthma and asthma-associated phenotypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001635> (<http://www.ebi.ac.uk/coho/COHO_0001635>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23975238") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28593492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29203885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23975238") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://link.springer.com/article/10.1007/s00392-013-0607-9") Annotation(rdfs:comment "Blood cell fractions (monocytes, T-lymphocytes, platelets, granulocytes, PBMC) of all individual patients were isolated and stored for analysis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001635> "A multicentre prospective cohort of patients with stable or unstable angina pectoris undergoing coronary angiography at four medical centres in the Netherlands, recruited from March 2009 to September 2011 in the CIRCULATING CELLS project of the Center for Translational Molecular Medicine, whose blood cell fractions were isolated and characterised to find cellular biomarkers that predict adverse cardiovascular events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23975238") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28593492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29203885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23975238") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://link.springer.com/article/10.1007/s00392-013-0607-9") Annotation(rdfs:comment "The CIRCULATING CELLS study is a prospective discovery and verification study, executed in four medical centers in the Netherlands: the Catharina Hospital in Eindhoven, the Leiden University Medical Center, the Maastricht University Medical Center and the University Medical Center Utrecht.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001635> "A multicentre prospective cohort of patients with stable or unstable angina pectoris undergoing coronary angiography at four medical centres in the Netherlands, recruited from March 2009 to September 2011 in the CIRCULATING CELLS project of the Center for Translational Molecular Medicine, whose blood cell fractions were isolated and characterised to find cellular biomarkers that predict adverse cardiovascular events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23975238") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28593492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29203885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29203885") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5714995/fullTextXML") Annotation(rdfs:comment "CTMM Circulating Cells is a multi-center cohort of four Dutch medical centers that enrolled patients with stable or unstable angina pectoris undergoing coronary angiography, with the aim of identifying cellular biomarkers for the prediction of adverse cardiovascular events.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001635> "A multicentre prospective cohort of patients with stable or unstable angina pectoris undergoing coronary angiography at four medical centres in the Netherlands, recruited from March 2009 to September 2011 in the CIRCULATING CELLS project of the Center for Translational Molecular Medicine, whose blood cell fractions were isolated and characterised to find cellular biomarkers that predict adverse cardiovascular events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23975238") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28593492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29203885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29203885") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5714995/fullTextXML") Annotation(rdfs:comment "Patients were recruited between March 2009 and September 2011.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001635> "A multicentre prospective cohort of patients with stable or unstable angina pectoris undergoing coronary angiography at four medical centres in the Netherlands, recruited from March 2009 to September 2011 in the CIRCULATING CELLS project of the Center for Translational Molecular Medicine, whose blood cell fractions were isolated and characterised to find cellular biomarkers that predict adverse cardiovascular events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23975238") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28593492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29203885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29203885") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5714995/fullTextXML") Annotation(rdfs:comment "This research was performed within the framework of the Center for Translational Molecular Medicine (CTMM; www.ctmm.nl), project Circulating Cells (grant 01C-102), and supported by the Dutch Heart Foundation, the UMC Utrecht Vascular Prevention Project and the Wilhelmina Children’s Hospital Research Fund.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001635> "A multicentre prospective cohort of patients with stable or unstable angina pectoris undergoing coronary angiography at four medical centres in the Netherlands, recruited from March 2009 to September 2011 in the CIRCULATING CELLS project of the Center for Translational Molecular Medicine, whose blood cell fractions were isolated and characterised to find cellular biomarkers that predict adverse cardiovascular events.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001636> (<http://www.ebi.ac.uk/coho/COHO_0001636>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12296510") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12296510") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12296510+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Cancer outcomes were identified by linkage with the California Cancer Registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001636> "A prospective cohort of female California teachers and administrators, established in 1995-1996 among members of the California State Teachers Retirement System who completed a detailed mailed questionnaire on possible risk factors for breast and other cancers, with cancer outcomes identified by linkage to the California Cancer Registry.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12296510") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12296510") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12296510+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The CTS is a prospective study of 133,479 California female teachers and administrators, established in 1995-1996 with members of the California State Teachers Retirement System completing a detailed mailed questionnaire regarding possible risk factors for breast and other cancers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001636> "A prospective cohort of female California teachers and administrators, established in 1995-1996 among members of the California State Teachers Retirement System who completed a detailed mailed questionnaire on possible risk factors for breast and other cancers, with cancer outcomes identified by linkage to the California Cancer Registry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001637> (<http://www.ebi.ac.uk/coho/COHO_0001637>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25187374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "A total of 608 of these subjects was recruited either from the general population participating in a community-based screening program for cardiovascular risk or from hospital staff; an additional 976 subjects were recruited from a population-based cardiovascular risk-screening program for adolescents13 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001637> "A case–control study of type 2 diabetes in southern Han Chinese residents of Hong Kong, conducted by the Chinese University of Hong Kong. Its cases are patients with type 2 diabetes selected from the Prince of Wales Hospital Diabetes Registry (the Hong Kong Diabetes Register), either with early-onset diabetes and a positive family history or selected at random, excluding classic type 1 diabetes, and its controls, with normal glucose tolerance, were recruited from hospital staff, a community-based cardiovascular risk screening programme and a population-based cardiovascular risk screening programme for adolescents.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25187374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "A total of 726 of these individuals had early-onset diabetes (age at diagnosis of <40 years) and a positive family history; an additional 751 patients were randomly selected from the same registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001637> "A case–control study of type 2 diabetes in southern Han Chinese residents of Hong Kong, conducted by the Chinese University of Hong Kong. Its cases are patients with type 2 diabetes selected from the Prince of Wales Hospital Diabetes Registry (the Hong Kong Diabetes Register), either with early-onset diabetes and a positive family history or selected at random, excluding classic type 1 diabetes, and its controls, with normal glucose tolerance, were recruited from hospital staff, a community-based cardiovascular risk screening programme and a population-based cardiovascular risk screening programme for adolescents.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25187374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "Patients with classic type 1 diabetes with acute ketotic presentation or continuous requirement of insulin within 1 year of diagnosis were excluded.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001637> "A case–control study of type 2 diabetes in southern Han Chinese residents of Hong Kong, conducted by the Chinese University of Hong Kong. Its cases are patients with type 2 diabetes selected from the Prince of Wales Hospital Diabetes Registry (the Hong Kong Diabetes Register), either with early-onset diabetes and a positive family history or selected at random, excluding classic type 1 diabetes, and its controls, with normal glucose tolerance, were recruited from hospital staff, a community-based cardiovascular risk screening programme and a population-based cardiovascular risk screening programme for adolescents.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25187374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "The cases consisted of 1,477 subjects with T2D selected from the Prince of Wales Hospital Diabetes Registry12 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001637> "A case–control study of type 2 diabetes in southern Han Chinese residents of Hong Kong, conducted by the Chinese University of Hong Kong. Its cases are patients with type 2 diabetes selected from the Prince of Wales Hospital Diabetes Registry (the Hong Kong Diabetes Register), either with early-onset diabetes and a positive family history or selected at random, excluding classic type 1 diabetes, and its controls, with normal glucose tolerance, were recruited from hospital staff, a community-based cardiovascular risk screening programme and a population-based cardiovascular risk screening programme for adolescents.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25187374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "The controls consisted of 1584 subjects with normal glucose tolerance (FPG of <6.1 mmol/L).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001637> "A case–control study of type 2 diabetes in southern Han Chinese residents of Hong Kong, conducted by the Chinese University of Hong Kong. Its cases are patients with type 2 diabetes selected from the Prince of Wales Hospital Diabetes Registry (the Hong Kong Diabetes Register), either with early-onset diabetes and a positive family history or selected at random, excluding classic type 1 diabetes, and its controls, with normal glucose tolerance, were recruited from hospital staff, a community-based cardiovascular risk screening programme and a population-based cardiovascular risk screening programme for adolescents.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25187374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22158537") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "The subjects in the Hong Kong case-control study were of southern Han Chinese ancestry and resided in Hong Kong, as described previously11 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001637> "A case–control study of type 2 diabetes in southern Han Chinese residents of Hong Kong, conducted by the Chinese University of Hong Kong. Its cases are patients with type 2 diabetes selected from the Prince of Wales Hospital Diabetes Registry (the Hong Kong Diabetes Register), either with early-onset diabetes and a positive family history or selected at random, excluding classic type 1 diabetes, and its controls, with normal glucose tolerance, were recruited from hospital staff, a community-based cardiovascular risk screening programme and a population-based cardiovascular risk screening programme for adolescents.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001638> (<http://www.ebi.ac.uk/coho/COHO_0001638>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710970") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29985959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14710970") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14710970+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "CURES is perhaps one of the largest systematic population based studies to be done in India in the field of diabetes and its complications like retinopathy, nephropathy and neuropathy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001638> "A population-based epidemiological study of diabetes and its complications in adults aged 20 years or more in Chennai, southern India, run by the Madras Diabetes Research Foundation. A representative sample of the city's residents, from wards chosen by systematic random sampling, was screened for diabetes in a door-to-door survey in 2001–2003; everyone found to have diabetes and every tenth participant then underwent detailed anthropometric, biochemical and complication studies, and they were followed up in 2012–2014.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710970") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29985959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14710970") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14710970+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Chennai (formerly Madras), the largest city in Southern India and the fourth largest in India has been divided into 10 zones and 155 wards. 46 wards were selected by a systematic random sampling method to represent the whole of Chennai.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001638> "A population-based epidemiological study of diabetes and its complications in adults aged 20 years or more in Chennai, southern India, run by the Madras Diabetes Research Foundation. A representative sample of the city's residents, from wards chosen by systematic random sampling, was screened for diabetes in a door-to-door survey in 2001–2003; everyone found to have diabetes and every tenth participant then underwent detailed anthropometric, biochemical and complication studies, and they were followed up in 2012–2014.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710970") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29985959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29985959") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0197376") Annotation(rdfs:comment "In brief, CURES was done on a representative sample of 26001 adults from Chennai city, aged ≥20 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001638> "A population-based epidemiological study of diabetes and its complications in adults aged 20 years or more in Chennai, southern India, run by the Madras Diabetes Research Foundation. A representative sample of the city's residents, from wards chosen by systematic random sampling, was screened for diabetes in a door-to-door survey in 2001–2003; everyone found to have diabetes and every tenth participant then underwent detailed anthropometric, biochemical and complication studies, and they were followed up in 2012–2014.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710970") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29985959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29985959") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0197376") Annotation(rdfs:comment "In the baseline survey carried out between 2001 and 2003, all 26001 individuals were screened for diabetes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001638> "A population-based epidemiological study of diabetes and its complications in adults aged 20 years or more in Chennai, southern India, run by the Madras Diabetes Research Foundation. A representative sample of the city's residents, from wards chosen by systematic random sampling, was screened for diabetes in a door-to-door survey in 2001–2003; everyone found to have diabetes and every tenth participant then underwent detailed anthropometric, biochemical and complication studies, and they were followed up in 2012–2014.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710970") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29985959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29985959") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0197376") Annotation(rdfs:comment "Of these, all individuals who had diabetes (n = 1382) and one in every tenth individual (n = 2207) underwent further detailed anthropometric and biochemical investigations and these constituted the cohort for this follow-up study (n = 3589) [8] [Fig 1].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001638> "A population-based epidemiological study of diabetes and its complications in adults aged 20 years or more in Chennai, southern India, run by the Madras Diabetes Research Foundation. A representative sample of the city's residents, from wards chosen by systematic random sampling, was screened for diabetes in a door-to-door survey in 2001–2003; everyone found to have diabetes and every tenth participant then underwent detailed anthropometric, biochemical and complication studies, and they were followed up in 2012–2014.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710970") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29985959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29985959") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0197376") Annotation(rdfs:comment "The follow-up survey was done in 2012–2014 after a median of 10.3years (27,850 person-years of follow-up).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001638> "A population-based epidemiological study of diabetes and its complications in adults aged 20 years or more in Chennai, southern India, run by the Madras Diabetes Research Foundation. A representative sample of the city's residents, from wards chosen by systematic random sampling, was screened for diabetes in a door-to-door survey in 2001–2003; everyone found to have diabetes and every tenth participant then underwent detailed anthropometric, biochemical and complication studies, and they were followed up in 2012–2014.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001639> (<http://www.ebi.ac.uk/coho/COHO_0001639>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32522676") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35242828") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32522676") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32522676+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "As of July 2011, in order to determine the PE-relevant short-term outcomes, enrolled participants were followed-up for at least three months in a longitudinal manner.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001639> "An ongoing national, prospective, multicentre registry of patients with suspected or confirmed acute pulmonary embolism, with or without deep vein thrombosis, enrolled at medical centres of the China PE-DVT network across China and led from the China-Japan Friendship Hospital in Beijing, to describe the spectrum, trends, causes and outcomes of pulmonary embolism in China. Started in January 2009 with in-hospital outcomes, it has followed patients for at least three months since July 2011 and, since August 2016, has collected their blood samples and followed them for at least two years.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32522676") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35242828") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32522676") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32522676+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Since August 2016, with the launch and development of precision medicine research scheme in China, the main principle investigators of CURES decided to collect enrolled patients' blood samples with regular follow-ups every three or six months for at least two years (for long-term outcomes).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001639> "An ongoing national, prospective, multicentre registry of patients with suspected or confirmed acute pulmonary embolism, with or without deep vein thrombosis, enrolled at medical centres of the China PE-DVT network across China and led from the China-Japan Friendship Hospital in Beijing, to describe the spectrum, trends, causes and outcomes of pulmonary embolism in China. Started in January 2009 with in-hospital outcomes, it has followed patients for at least three months since July 2011 and, since August 2016, has collected their blood samples and followed them for at least two years.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32522676") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35242828") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32522676") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32522676+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The CURES is an ongoing large prospective multicenter registry, which was originally initiated in January 2009 via enrolling suspected or confirmed PE or PE with DVT (deep venous thrombosis) patients and assessed their in-hospital outcomes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001639> "An ongoing national, prospective, multicentre registry of patients with suspected or confirmed acute pulmonary embolism, with or without deep vein thrombosis, enrolled at medical centres of the China PE-DVT network across China and led from the China-Japan Friendship Hospital in Beijing, to describe the spectrum, trends, causes and outcomes of pulmonary embolism in China. Started in January 2009 with in-hospital outcomes, it has followed patients for at least three months since July 2011 and, since August 2016, has collected their blood samples and followed them for at least two years.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32522676") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35242828") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32522676") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32522676+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The China Pulmonary Thromboembolism Registry Study (CURES) is designed to provide the cross-sectional spectrum and chronological trends of PE in China, as well as to reveal the intrinsic etiology and pathogenesis of the disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001639> "An ongoing national, prospective, multicentre registry of patients with suspected or confirmed acute pulmonary embolism, with or without deep vein thrombosis, enrolled at medical centres of the China PE-DVT network across China and led from the China-Japan Friendship Hospital in Beijing, to describe the spectrum, trends, causes and outcomes of pulmonary embolism in China. Started in January 2009 with in-hospital outcomes, it has followed patients for at least three months since July 2011 and, since August 2016, has collected their blood samples and followed them for at least two years.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32522676") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35242828") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32522676") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32522676+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Up to 31 December 2019, the CURES has enrolled 14,937 eligible patients and collected 1500 blood samples of patients from 100 medical centers in the China PE-DVT network.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001639> "An ongoing national, prospective, multicentre registry of patients with suspected or confirmed acute pulmonary embolism, with or without deep vein thrombosis, enrolled at medical centres of the China PE-DVT network across China and led from the China-Japan Friendship Hospital in Beijing, to describe the spectrum, trends, causes and outcomes of pulmonary embolism in China. Started in January 2009 with in-hospital outcomes, it has followed patients for at least three months since July 2011 and, since August 2016, has collected their blood samples and followed them for at least two years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001640> (<http://www.ebi.ac.uk/coho/COHO_0001640>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34039022") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34076677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37916415") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34039022") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8651054/unicode") Annotation(rdfs:comment "The CVPath Institute Sudden Cardiac Death registry heart samples are received through an ongoing joint consultation service provided to the Maryland Office of the Chief Medical Examiner.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001640> "An autopsy registry of people who died suddenly and unexpectedly, whose hearts have been referred since the mid-1990s to CVPath Institute in Gaithersburg, Maryland, by the Office of the Chief Medical Examiner of the State of Maryland through an ongoing cardiovascular pathology consultation service. The cause of death is determined by detailed histopathological examination of the heart and coronary arteries, and DNA extracted from the archived tissue is used to study the genetics of sudden cardiac death and of coronary plaque.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34039022") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34076677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37916415") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34039022") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8651054/unicode") Annotation(rdfs:comment "We sought to explore associations of APOL1 risk variants with cause of sudden death using the CVPath Sudden Death Autopsy Registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001640> "An autopsy registry of people who died suddenly and unexpectedly, whose hearts have been referred since the mid-1990s to CVPath Institute in Gaithersburg, Maryland, by the Office of the Chief Medical Examiner of the State of Maryland through an ongoing cardiovascular pathology consultation service. The cause of death is determined by detailed histopathological examination of the heart and coronary arteries, and DNA extracted from the archived tissue is used to study the genetics of sudden cardiac death and of coronary plaque.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34039022") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34076677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37916415") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34076677") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8173469/") Annotation(rdfs:comment "Between January 1995 and December 2015, CVPath Institute was referred 5262 hearts from cases of unexpected sudden death from the Office of the Chief Medical Examiner of the State of Maryland (OCME-MD).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001640> "An autopsy registry of people who died suddenly and unexpectedly, whose hearts have been referred since the mid-1990s to CVPath Institute in Gaithersburg, Maryland, by the Office of the Chief Medical Examiner of the State of Maryland through an ongoing cardiovascular pathology consultation service. The cause of death is determined by detailed histopathological examination of the heart and coronary arteries, and DNA extracted from the archived tissue is used to study the genetics of sudden cardiac death and of coronary plaque.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34039022") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34076677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37916415") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34076677") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8173469/") Annotation(rdfs:comment "For every case, the heart was systematically evaluated with detailed histopathological analyses performed by an experienced cardiac pathologist at CVPath Institute.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001640> "An autopsy registry of people who died suddenly and unexpectedly, whose hearts have been referred since the mid-1990s to CVPath Institute in Gaithersburg, Maryland, by the Office of the Chief Medical Examiner of the State of Maryland through an ongoing cardiovascular pathology consultation service. The cause of death is determined by detailed histopathological examination of the heart and coronary arteries, and DNA extracted from the archived tissue is used to study the genetics of sudden cardiac death and of coronary plaque.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34039022") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34076677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37916415") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37916415") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37916415+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "From 4327 subjects referred to CVPath by the State of Maryland Office Chief Medical Examiner for sudden death between 1994 and 2015, 2455 cases were randomly selected for genotyping.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001640> "An autopsy registry of people who died suddenly and unexpectedly, whose hearts have been referred since the mid-1990s to CVPath Institute in Gaithersburg, Maryland, by the Office of the Chief Medical Examiner of the State of Maryland through an ongoing cardiovascular pathology consultation service. The cause of death is determined by detailed histopathological examination of the heart and coronary arteries, and DNA extracted from the archived tissue is used to study the genetics of sudden cardiac death and of coronary plaque.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001641> (<http://www.ebi.ac.uk/coho/COHO_0001641>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20042177") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23455636") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20042177") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3026437/unicode") Annotation(rdfs:comment "Blood samples were collected at the Cole Eye Institute (CEI), Cleveland Clinic and the VA Eye Clinic.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001641> "A clinic-based case–control collection for genetic studies of age-related macular degeneration in Cleveland, Ohio, whose cases, graded by the Age-Related Eye Disease Study criteria, and controls without signs of macular degeneration or a family history of retinal disease, mostly of European descent, gave blood samples at the Cole Eye Institute of the Cleveland Clinic and at the Veterans Affairs eye clinic.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20042177") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23455636") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20042177") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3026437/unicode") Annotation(rdfs:comment "Participants were primarily Caucasian of European descent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001641> "A clinic-based case–control collection for genetic studies of age-related macular degeneration in Cleveland, Ohio, whose cases, graded by the Age-Related Eye Disease Study criteria, and controls without signs of macular degeneration or a family history of retinal disease, mostly of European descent, gave blood samples at the Cole Eye Institute of the Cleveland Clinic and at the Veterans Affairs eye clinic.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20042177") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23455636") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20042177") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3026437/unicode") Annotation(rdfs:comment "We believe that selection bias in our case-control association study was avoided since cases and controls derived from the same source populations, and no significant deviations from Hardy-Weinberg equilibrium were noted.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001641> "A clinic-based case–control collection for genetic studies of age-related macular degeneration in Cleveland, Ohio, whose cases, graded by the Age-Related Eye Disease Study criteria, and controls without signs of macular degeneration or a family history of retinal disease, mostly of European descent, gave blood samples at the Cole Eye Institute of the Cleveland Clinic and at the Veterans Affairs eye clinic.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20042177") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23455636") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23455636") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2578/MediaObjects/41588_2013_BFng2578_MOESM22_ESM.pdf") Annotation(rdfs:comment "Controls: Subjects with at most, small, hard drusen and no signs of AMD (AREDS group 1) and no family history of retinal disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001641> "A clinic-based case–control collection for genetic studies of age-related macular degeneration in Cleveland, Ohio, whose cases, graded by the Age-Related Eye Disease Study criteria, and controls without signs of macular degeneration or a family history of retinal disease, mostly of European descent, gave blood samples at the Cole Eye Institute of the Cleveland Clinic and at the Veterans Affairs eye clinic.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20042177") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23455636") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23455636") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2578/MediaObjects/41588_2013_BFng2578_MOESM22_ESM.pdf") Annotation(rdfs:comment "Subjects with large or extensive intermediate drusen, CNV or GA in at least one eye (AREDS severity groups 3, 4, 5).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001641> "A clinic-based case–control collection for genetic studies of age-related macular degeneration in Cleveland, Ohio, whose cases, graded by the Age-Related Eye Disease Study criteria, and controls without signs of macular degeneration or a family history of retinal disease, mostly of European descent, gave blood samples at the Cole Eye Institute of the Cleveland Clinic and at the Veterans Affairs eye clinic.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20042177") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23455636") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26691988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3448/MediaObjects/41588_2016_BFng3448_MOESM1_ESM.pdf") Annotation(rdfs:comment "CWRU Clinic Clinic Clinic Yes Yes Yes No AREDS") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001641> "A clinic-based case–control collection for genetic studies of age-related macular degeneration in Cleveland, Ohio, whose cases, graded by the Age-Related Eye Disease Study criteria, and controls without signs of macular degeneration or a family history of retinal disease, mostly of European descent, gave blood samples at the Cole Eye Institute of the Cleveland Clinic and at the Veterans Affairs eye clinic.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001642> (<http://www.ebi.ac.uk/coho/COHO_0001642>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32392239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34226943") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38252350") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32392239") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0232845") Annotation(rdfs:comment "In the last survey, conducted in 2016/17, the random selection was performed from registers of five major health insurance companies operating in the Czech Republic and covering 85% of the total population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001642> "A series of independent cross-sectional surveys of cardiovascular risk factors in the Czech Republic that continued the country's WHO MONICA Project surveys: random 1% samples of residents aged 25–64 years, stratified by age and sex and drawn from health insurance registers, were examined in the same districts in 1997/98, 2000/01, 2007/08 and 2016/17 by investigators in Prague (the Institute for Clinical and Experimental Medicine, and Charles University and Thomayer Hospital). DNA from its participants has also served as general-population controls in genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32392239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34226943") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38252350") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32392239") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0232845") Annotation(rdfs:comment "The Czech MONICA and Czech post-MONICA studies were approved by the Ethics Committee of the Institute for Clinical and Experimental Medicine and Thomayer Hospital, Prague, Czech Republic.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001642> "A series of independent cross-sectional surveys of cardiovascular risk factors in the Czech Republic that continued the country's WHO MONICA Project surveys: random 1% samples of residents aged 25–64 years, stratified by age and sex and drawn from health insurance registers, were examined in the same districts in 1997/98, 2000/01, 2007/08 and 2016/17 by investigators in Prague (the Institute for Clinical and Experimental Medicine, and Charles University and Thomayer Hospital). DNA from its participants has also served as general-population controls in genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32392239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34226943") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38252350") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32392239") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0232845") Annotation(rdfs:comment "The study population was always randomly selected as a 1% population sample within each district, stratified by age and sex, within an age range of 25 to 64 years,") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001642> "A series of independent cross-sectional surveys of cardiovascular risk factors in the Czech Republic that continued the country's WHO MONICA Project surveys: random 1% samples of residents aged 25–64 years, stratified by age and sex and drawn from health insurance registers, were examined in the same districts in 1997/98, 2000/01, 2007/08 and 2016/17 by investigators in Prague (the Institute for Clinical and Experimental Medicine, and Charles University and Thomayer Hospital). DNA from its participants has also served as general-population controls in genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32392239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34226943") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38252350") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32392239") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0232845") Annotation(rdfs:comment "There were 7 independent cross-sectional surveys for major CV risk factors conducted in the Czech Republic in the same 6 country districts within the WHO MONICA Project (1985, 1988, 1992) and the Czech post-MONICA study (1997/98, 2000/01, 2007/08 and 2016/2017), including a total of 7,606 males and 8,050 females.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001642> "A series of independent cross-sectional surveys of cardiovascular risk factors in the Czech Republic that continued the country's WHO MONICA Project surveys: random 1% samples of residents aged 25–64 years, stratified by age and sex and drawn from health insurance registers, were examined in the same districts in 1997/98, 2000/01, 2007/08 and 2016/17 by investigators in Prague (the Institute for Clinical and Experimental Medicine, and Charles University and Thomayer Hospital). DNA from its participants has also served as general-population controls in genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32392239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34226943") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38252350") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32392239") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://journals.plos.org/plosone/article?id=10.1371/journal.pone.0232845") Annotation(rdfs:comment "the General Health Insurance Company registry (1997/98, 2000/01, and 2007/08; the Czech post-MONICA Study) keeping, by law, a list of all the insured individuals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001642> "A series of independent cross-sectional surveys of cardiovascular risk factors in the Czech Republic that continued the country's WHO MONICA Project surveys: random 1% samples of residents aged 25–64 years, stratified by age and sex and drawn from health insurance registers, were examined in the same districts in 1997/98, 2000/01, 2007/08 and 2016/17 by investigators in Prague (the Institute for Clinical and Experimental Medicine, and Charles University and Thomayer Hospital). DNA from its participants has also served as general-population controls in genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32392239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34226943") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38252350") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38252350") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10803395/fullTextXML") Annotation(rdfs:comment "For the control group, 1 191 males aged 25–64 years, all of whom participated in the Czech branch of the post-MONICA study [25]), were selected according to the WHO protocol [26], representing a 1% general population sample from 9 different Czech districts.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001642> "A series of independent cross-sectional surveys of cardiovascular risk factors in the Czech Republic that continued the country's WHO MONICA Project surveys: random 1% samples of residents aged 25–64 years, stratified by age and sex and drawn from health insurance registers, were examined in the same districts in 1997/98, 2000/01, 2007/08 and 2016/17 by investigators in Prague (the Institute for Clinical and Experimental Medicine, and Charles University and Thomayer Hospital). DNA from its participants has also served as general-population controls in genetic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001643> (<http://www.ebi.ac.uk/coho/COHO_0001643>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "All asthmatics had a physician’s diagnosis of asthma, asthma symptoms, and BHR to either histamine or methacholine.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001643> "A genome-wide association sample of asthma from the north of the Netherlands, assembled by the Dutch Asthma Genetics Consortium in two phases that were genotyped separately and meta-analysed: a family-based phase whose asthmatic cases came from a trio and family study, with non-asthmatic spouses or the untransmitted alleles of the trios as controls, and a case–control phase whose asthmatics came from earlier clinical and genetic studies of the investigators' research institute, with controls from COPACETIC, a population-based lung cancer screening study of male smokers. Cases had a physician's diagnosis of asthma, asthma symptoms and bronchial hyperresponsiveness; controls had no asthma, COPD or significant airway obstruction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "For the first phase, 463 cases were selected from a trio and family study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001643> "A genome-wide association sample of asthma from the north of the Netherlands, assembled by the Dutch Asthma Genetics Consortium in two phases that were genotyped separately and meta-analysed: a family-based phase whose asthmatic cases came from a trio and family study, with non-asthmatic spouses or the untransmitted alleles of the trios as controls, and a case–control phase whose asthmatics came from earlier clinical and genetic studies of the investigators' research institute, with controls from COPACETIC, a population-based lung cancer screening study of male smokers. Cases had a physician's diagnosis of asthma, asthma symptoms and bronchial hyperresponsiveness; controls had no asthma, COPD or significant airway obstruction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "For the second phase (GWAS II), 452 asthmatics were selected from previous clinical and genetic studies 79 performed by our research institute.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001643> "A genome-wide association sample of asthma from the north of the Netherlands, assembled by the Dutch Asthma Genetics Consortium in two phases that were genotyped separately and meta-analysed: a family-based phase whose asthmatic cases came from a trio and family study, with non-asthmatic spouses or the untransmitted alleles of the trios as controls, and a case–control phase whose asthmatics came from earlier clinical and genetic studies of the investigators' research institute, with controls from COPACETIC, a population-based lung cancer screening study of male smokers. Cases had a physician's diagnosis of asthma, asthma symptoms and bronchial hyperresponsiveness; controls had no asthma, COPD or significant airway obstruction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "The 469 controls were non‐asthmatic spouses or pseudo‐controls of untransmitted alleles in our trio design (GWAS I).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001643> "A genome-wide association sample of asthma from the north of the Netherlands, assembled by the Dutch Asthma Genetics Consortium in two phases that were genotyped separately and meta-analysed: a family-based phase whose asthmatic cases came from a trio and family study, with non-asthmatic spouses or the untransmitted alleles of the trios as controls, and a case–control phase whose asthmatics came from earlier clinical and genetic studies of the investigators' research institute, with controls from COPACETIC, a population-based lung cancer screening study of male smokers. Cases had a physician's diagnosis of asthma, asthma symptoms and bronchial hyperresponsiveness; controls had no asthma, COPD or significant airway obstruction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "The 517 controls were selected from the COPACETIC study, a geographically matched population‐based study on lung cancer screening in male smokers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001643> "A genome-wide association sample of asthma from the north of the Netherlands, assembled by the Dutch Asthma Genetics Consortium in two phases that were genotyped separately and meta-analysed: a family-based phase whose asthmatic cases came from a trio and family study, with non-asthmatic spouses or the untransmitted alleles of the trios as controls, and a case–control phase whose asthmatics came from earlier clinical and genetic studies of the investigators' research institute, with controls from COPACETIC, a population-based lung cancer screening study of male smokers. Cases had a physician's diagnosis of asthma, asthma symptoms and bronchial hyperresponsiveness; controls had no asthma, COPD or significant airway obstruction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29273806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "The Dutch Asthma GWAS (DAG) cohort consists of in total 915 asthma cases and 986 controls, allfromthenorthernoftheNetherlands.TheDAGcohortwasgenotypedintwophasesandmeta‐analysed afterwards.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001643> "A genome-wide association sample of asthma from the north of the Netherlands, assembled by the Dutch Asthma Genetics Consortium in two phases that were genotyped separately and meta-analysed: a family-based phase whose asthmatic cases came from a trio and family study, with non-asthmatic spouses or the untransmitted alleles of the trios as controls, and a case–control phase whose asthmatics came from earlier clinical and genetic studies of the investigators' research institute, with controls from COPACETIC, a population-based lung cancer screening study of male smokers. Cases had a physician's diagnosis of asthma, asthma symptoms and bronchial hyperresponsiveness; controls had no asthma, COPD or significant airway obstruction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001644> (<http://www.ebi.ac.uk/coho/COHO_0001644>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25611558") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31617229") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34165262") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24768677") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24768677+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We performed a genome-wide association study of 649 adults in The Netherlands with AIH type 1 and 13,436 controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001644> "A national registry of patients with autoimmune hepatitis in the Netherlands kept by the Dutch Autoimmune Hepatitis Study Group, a collaboration of Dutch tertiary referral and general hospitals supported by the Netherlands Association for the Study of the Liver, which includes known patients retrospectively and new patients prospectively. Its patients have been studied for the treatment and outcome of the disease, and its adult patients with type 1 autoimmune hepatitis were genotyped for a genome-wide association study of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25611558") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31617229") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34165262") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25611558") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1038/gene.2014.82") Annotation(rdfs:comment "The Dutch AIH Study Group is supported by the Netherlands Association for the Study of the Liver (NASL/NVH).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001644> "A national registry of patients with autoimmune hepatitis in the Netherlands kept by the Dutch Autoimmune Hepatitis Study Group, a collaboration of Dutch tertiary referral and general hospitals supported by the Netherlands Association for the Study of the Liver, which includes known patients retrospectively and new patients prospectively. Its patients have been studied for the treatment and outcome of the disease, and its adult patients with type 1 autoimmune hepatitis were genotyped for a genome-wide association study of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25611558") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31617229") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34165262") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25611558") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25611558+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To study the immune-modifying effect of these alleles, we imputed the genotypes from genome-wide association data in 649 Dutch AIH type-1 patients.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001644> "A national registry of patients with autoimmune hepatitis in the Netherlands kept by the Dutch Autoimmune Hepatitis Study Group, a collaboration of Dutch tertiary referral and general hospitals supported by the Netherlands Association for the Study of the Liver, which includes known patients retrospectively and new patients prospectively. Its patients have been studied for the treatment and outcome of the disease, and its adult patients with type 1 autoimmune hepatitis were genotyped for a genome-wide association study of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25611558") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31617229") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34165262") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31617229") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6899908/fullTextXML") Annotation(rdfs:comment "The study protocol (number 2008.84) was approved by the institutional review boards of all participating tertiary referral (n = 6) and general hospitals (n = 10) in the Netherlands.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001644> "A national registry of patients with autoimmune hepatitis in the Netherlands kept by the Dutch Autoimmune Hepatitis Study Group, a collaboration of Dutch tertiary referral and general hospitals supported by the Netherlands Association for the Study of the Liver, which includes known patients retrospectively and new patients prospectively. Its patients have been studied for the treatment and outcome of the disease, and its adult patients with type 1 autoimmune hepatitis were genotyped for a genome-wide association study of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25611558") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31617229") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34165262") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31617229") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6899908/fullTextXML") Annotation(rdfs:comment "We aimed to assess the incidence of cataract, diabetes and osteoporotic fractures in relation to corticosteroid doses in the long‐term maintenance treatment of patients with autoimmune hepatitis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001644> "A national registry of patients with autoimmune hepatitis in the Netherlands kept by the Dutch Autoimmune Hepatitis Study Group, a collaboration of Dutch tertiary referral and general hospitals supported by the Netherlands Association for the Study of the Liver, which includes known patients retrospectively and new patients prospectively. Its patients have been studied for the treatment and outcome of the disease, and its adult patients with type 1 autoimmune hepatitis were genotyped for a genome-wide association study of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25611558") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31617229") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34165262") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34165262") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8281048/fullTextXML") Annotation(rdfs:comment "Since August 2006 all previously known patients were retrospectively and new patients are prospectively included in the national database of the Dutch Autoimmune Hepatitis Study Group.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001644> "A national registry of patients with autoimmune hepatitis in the Netherlands kept by the Dutch Autoimmune Hepatitis Study Group, a collaboration of Dutch tertiary referral and general hospitals supported by the Netherlands Association for the Study of the Liver, which includes known patients retrospectively and new patients prospectively. Its patients have been studied for the treatment and outcome of the disease, and its adult patients with type 1 autoimmune hepatitis were genotyped for a genome-wide association study of the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001645> (<http://www.ebi.ac.uk/coho/COHO_0001645>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28275316") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28275316") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5333638/fullTextXML") Annotation(rdfs:comment "DanFunD part one was carried out at RCPH in 2011–2012 as a follow-up examination of the Health2006 study, which is a population-based cohort randomly obtained from the nationwide Danish registries and examined at the RCPH in the period 2006–2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001645> "A Danish population-based cohort of men and women aged 18 to 76, drawn at random from the national registers among people born in Denmark and living in the western part of greater Copenhagen and examined at the Research Centre for Prevention and Health, Glostrup, from 2011 to 2015, set up to study the epidemiology of functional somatic syndromes (such as fibromyalgia, irritable bowel syndrome and chronic fatigue syndrome) and bodily distress syndrome. It merges a follow-up examination of the Health2006 cohort (DanFunD part one, 2011-2012) with a new random sample examined from 2012 to 2015 (DanFunD part two).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28275316") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28275316") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5333638/fullTextXML") Annotation(rdfs:comment "For this new cohort, a total of 25,368 men and women aged 18–72 years with the same background population characteristics as those of DanFunD part one were randomly obtained from the nationwide Danish registries and invited to participate.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001645> "A Danish population-based cohort of men and women aged 18 to 76, drawn at random from the national registers among people born in Denmark and living in the western part of greater Copenhagen and examined at the Research Centre for Prevention and Health, Glostrup, from 2011 to 2015, set up to study the epidemiology of functional somatic syndromes (such as fibromyalgia, irritable bowel syndrome and chronic fatigue syndrome) and bodily distress syndrome. It merges a follow-up examination of the Health2006 cohort (DanFunD part one, 2011-2012) with a new random sample examined from 2012 to 2015 (DanFunD part two).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28275316") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28275316") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5333638/fullTextXML") Annotation(rdfs:comment "The DanFunD cohort is anchored at the Research Centre for Prevention and Health (RCPH), Glostrup, Denmark and is a random sample of the general adult population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001645> "A Danish population-based cohort of men and women aged 18 to 76, drawn at random from the national registers among people born in Denmark and living in the western part of greater Copenhagen and examined at the Research Centre for Prevention and Health, Glostrup, from 2011 to 2015, set up to study the epidemiology of functional somatic syndromes (such as fibromyalgia, irritable bowel syndrome and chronic fatigue syndrome) and bodily distress syndrome. It merges a follow-up examination of the Health2006 cohort (DanFunD part one, 2011-2012) with a new random sample examined from 2012 to 2015 (DanFunD part two).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28275316") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28275316") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5333638/fullTextXML") Annotation(rdfs:comment "The Danish study of Functional Disorders (DanFunD) cohort was initiated to outline the epidemiology of functional somatic syndromes (FSS) and is the first larger coordinated epidemiological study focusing exclusively on FSS.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001645> "A Danish population-based cohort of men and women aged 18 to 76, drawn at random from the national registers among people born in Denmark and living in the western part of greater Copenhagen and examined at the Research Centre for Prevention and Health, Glostrup, from 2011 to 2015, set up to study the epidemiology of functional somatic syndromes (such as fibromyalgia, irritable bowel syndrome and chronic fatigue syndrome) and bodily distress syndrome. It merges a follow-up examination of the Health2006 cohort (DanFunD part one, 2011-2012) with a new random sample examined from 2012 to 2015 (DanFunD part two).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28275316") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28275316") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5333638/fullTextXML") Annotation(rdfs:comment "The cohort comprises a total of 9,656 men and women aged 18–76 years, born in Denmark and living in the western part of the greater Copenhagen.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001645> "A Danish population-based cohort of men and women aged 18 to 76, drawn at random from the national registers among people born in Denmark and living in the western part of greater Copenhagen and examined at the Research Centre for Prevention and Health, Glostrup, from 2011 to 2015, set up to study the epidemiology of functional somatic syndromes (such as fibromyalgia, irritable bowel syndrome and chronic fatigue syndrome) and bodily distress syndrome. It merges a follow-up examination of the Health2006 cohort (DanFunD part one, 2011-2012) with a new random sample examined from 2012 to 2015 (DanFunD part two).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28275316") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28275316") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5333638/fullTextXML") Annotation(rdfs:comment "The survey comprises screening questionnaires for five types of FSS, ie, fibromyalgia, whiplash-associated disorder, multiple chemical sensitivity, irritable bowel syndrome, and chronic fatigue syndrome, and for the unifying diagnostic category of bodily distress syndrome.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001645> "A Danish population-based cohort of men and women aged 18 to 76, drawn at random from the national registers among people born in Denmark and living in the western part of greater Copenhagen and examined at the Research Centre for Prevention and Health, Glostrup, from 2011 to 2015, set up to study the epidemiology of functional somatic syndromes (such as fibromyalgia, irritable bowel syndrome and chronic fatigue syndrome) and bodily distress syndrome. It merges a follow-up examination of the Health2006 cohort (DanFunD part one, 2011-2012) with a new random sample examined from 2012 to 2015 (DanFunD part two).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001647> (<http://www.ebi.ac.uk/coho/COHO_0001647>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2508608") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2515723") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:2508608") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2508608+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "At 28 US and Canadian sites, 800 eligible patients in the early stages of untreated Parkinson's disease were enrolled in DATATOP and randomized to (1) active deprenyl, (2) active tocopherol, (3) active deprenyl and tocopherol, or (4) placebo treatments.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001647> "A double-blind, multicentre, placebo-controlled clinical trial of the Parkinson Study Group that enrolled patients with early, otherwise untreated Parkinson's disease at sites in the United States and Canada and randomised them, in a 2 x 2 factorial design, to deprenyl, tocopherol (vitamin E), both or placebo, to test whether long-term treatment extends the time until disability requires levodopa therapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2508608") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2515723") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:2508608") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2508608+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "DATATOP (Deprenyl and tocopherol antioxidative therapy of parkinsonism) is a placebo-controlled clinical trial designed to test the hypothesis that long-term treatment of patients with early Parkinson's disease with deprenyl 10 mg/d and/or tocopherol (vitamin E) 2000 IU/d will extend the time until disability requires therapy with levodopa (primary end point).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001647> "A double-blind, multicentre, placebo-controlled clinical trial of the Parkinson Study Group that enrolled patients with early, otherwise untreated Parkinson's disease at sites in the United States and Canada and randomised them, in a 2 x 2 factorial design, to deprenyl, tocopherol (vitamin E), both or placebo, to test whether long-term treatment extends the time until disability requires levodopa therapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2508608") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2515723") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:2515723") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2515723+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A 2 X 2 factorial design allocates eligible subjects to one of four treatment groups: 1) deprenyl alone, 2) tocopherol alone, 3) deprenyl plus tocopherol, or 4) placebo.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001647> "A double-blind, multicentre, placebo-controlled clinical trial of the Parkinson Study Group that enrolled patients with early, otherwise untreated Parkinson's disease at sites in the United States and Canada and randomised them, in a 2 x 2 factorial design, to deprenyl, tocopherol (vitamin E), both or placebo, to test whether long-term treatment extends the time until disability requires levodopa therapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2508608") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2515723") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:2515723") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A2515723+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "DATATOP is a double-blind, multi-center, placebo-controlled clinical trial aimed at slowing the decline of patients who are in the early stages of Parkinson's disease (PD).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001647> "A double-blind, multicentre, placebo-controlled clinical trial of the Parkinson Study Group that enrolled patients with early, otherwise untreated Parkinson's disease at sites in the United States and Canada and randomised them, in a 2 x 2 factorial design, to deprenyl, tocopherol (vitamin E), both or placebo, to test whether long-term treatment extends the time until disability requires levodopa therapy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001648> (<http://www.ebi.ac.uk/coho/COHO_0001648>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21750109") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21750109") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3188988/") Annotation(rdfs:comment "Germany—Dortmund 1.42 0.95–2.13 0.08 1.03 0.70–1.52 0.89") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001648> "A German hospital-based case-control study of urinary bladder cancer at the Department of Urology of St.-Josefs-Hospital Dortmund-Hörde, in the Ruhr area (a former coal, iron and steel industry region), whose cases have confirmed bladder cancer and whose controls are cancer-free patients of the same department admitted for benign urological diseases, enrolled from July 2009 to July 2010; it has contributed to genome-wide association studies of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21750109") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21750109") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3188988/") Annotation(rdfs:comment "The 240 control individuals (77% males) were cancer-free and frequency-matched for age with the cases (median age 70.7, range 21.7–100).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001648> "A German hospital-based case-control study of urinary bladder cancer at the Department of Urology of St.-Josefs-Hospital Dortmund-Hörde, in the Ruhr area (a former coal, iron and steel industry region), whose cases have confirmed bladder cancer and whose controls are cancer-free patients of the same department admitted for benign urological diseases, enrolled from July 2009 to July 2010; it has contributed to genome-wide association studies of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21750109") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21750109") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3188988/") Annotation(rdfs:comment "The case–control series consists of 197 patients with a confirmed bladder cancer from the Department of Urology, St.-Josefs-Hospital Dortmund-Hörde, located in the Ruhr area, an area of former coal, iron and steel industries and 240 controls from the same Department of Urology, admitted for treatment of benign urological diseases, enrolled from July 2009 to July 2010.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001648> "A German hospital-based case-control study of urinary bladder cancer at the Department of Urology of St.-Josefs-Hospital Dortmund-Hörde, in the Ruhr area (a former coal, iron and steel industry region), whose cases have confirmed bladder cancer and whose controls are cancer-free patients of the same department admitted for benign urological diseases, enrolled from July 2009 to July 2010; it has contributed to genome-wide association studies of bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001650> (<http://www.ebi.ac.uk/coho/COHO_0001650>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36852012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38016806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36852012") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9960719/fullTextXML") Annotation(rdfs:comment "As example Diet, Cancer, and Health is an associated cohort of the European Prospective Investigation into Cancer and Nutrition (EPIC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001650> "A Danish prospective cohort of the Danish Cancer Society that recruited men and women aged 50 to 64, born in Denmark, living in Aarhus or Copenhagen and without a cancer diagnosis, between 1993 and 1997, collecting questionnaires, a clinical examination and biological samples to investigate how diet and lifestyle relate to the risk of cancer and other chronic diseases. It is an associated cohort of the European Prospective Investigation into Cancer and Nutrition.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36852012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38016806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36852012") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9960719/fullTextXML") Annotation(rdfs:comment "Diet, Cancer, and Health is a cohort and research biobank consisting of 57,053 participants, recruited between 1993 and 1997, including questionnaires, clinical examination data, and biological material (Table 4).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001650> "A Danish prospective cohort of the Danish Cancer Society that recruited men and women aged 50 to 64, born in Denmark, living in Aarhus or Copenhagen and without a cancer diagnosis, between 1993 and 1997, collecting questionnaires, a clinical examination and biological samples to investigate how diet and lifestyle relate to the risk of cancer and other chronic diseases. It is an associated cohort of the European Prospective Investigation into Cancer and Nutrition.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36852012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38016806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36852012") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9960719/fullTextXML") Annotation(rdfs:comment "Examples of external biobank-managed collections are the two Danish Cancer Society cohorts Diet, Cancer, and Health and “Diet, Cancer and Health – next generations”.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001650> "A Danish prospective cohort of the Danish Cancer Society that recruited men and women aged 50 to 64, born in Denmark, living in Aarhus or Copenhagen and without a cancer diagnosis, between 1993 and 1997, collecting questionnaires, a clinical examination and biological samples to investigate how diet and lifestyle relate to the risk of cancer and other chronic diseases. It is an associated cohort of the European Prospective Investigation into Cancer and Nutrition.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36852012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38016806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36852012") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9960719/fullTextXML") Annotation(rdfs:comment "From 1993 to 1997, 160,725 individuals aged 50 to 64 years from the Copenhagen and Aarhus areas were invited to participate (19% of the total Danish population in that age group).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001650> "A Danish prospective cohort of the Danish Cancer Society that recruited men and women aged 50 to 64, born in Denmark, living in Aarhus or Copenhagen and without a cancer diagnosis, between 1993 and 1997, collecting questionnaires, a clinical examination and biological samples to investigate how diet and lifestyle relate to the risk of cancer and other chronic diseases. It is an associated cohort of the European Prospective Investigation into Cancer and Nutrition.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36852012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38016806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36852012") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9960719/fullTextXML") Annotation(rdfs:comment "The primary aim of the cohort is to investigate associations of diet and lifestyle with the risk of cancer and other chronic diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001650> "A Danish prospective cohort of the Danish Cancer Society that recruited men and women aged 50 to 64, born in Denmark, living in Aarhus or Copenhagen and without a cancer diagnosis, between 1993 and 1997, collecting questionnaires, a clinical examination and biological samples to investigate how diet and lifestyle relate to the risk of cancer and other chronic diseases. It is an associated cohort of the European Prospective Investigation into Cancer and Nutrition.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36852012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38016806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38016806") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11041579/fullTextXML") Annotation(rdfs:comment "Briefly, between 1993 and 1997, a total of 160 725 women and men born in Denmark, aged 50–64 years, with no diagnosis of cancer, were invited.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001650> "A Danish prospective cohort of the Danish Cancer Society that recruited men and women aged 50 to 64, born in Denmark, living in Aarhus or Copenhagen and without a cancer diagnosis, between 1993 and 1997, collecting questionnaires, a clinical examination and biological samples to investigate how diet and lifestyle relate to the risk of cancer and other chronic diseases. It is an associated cohort of the European Prospective Investigation into Cancer and Nutrition.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001652> (<http://www.ebi.ac.uk/coho/COHO_0001652>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21637779") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21637779") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3102736/") Annotation(rdfs:comment "Control subjects unrelated to the cases and matched for age (±5 years) were also ascertained from the prostate cancer screening population of the Division of Urology at HUH [24].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001652> "A set of case-control studies of genetic risk factors for prostate cancer in which unrelated self-described African American men were recruited between 2001 and 2005 from the Division of Urology at Howard University Hospital in Washington, DC, United States, with age-matched controls ascertained from the prostate cancer screening population of the same division.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21637779") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21637779") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3102736/") Annotation(rdfs:comment "Unrelated men self-described as African American were recruited for several case-control studies on genetic risk factors for prostate cancer between the years 2001 and 2005 from the Division of Urology at Howard University Hospital (HUH) in Washington, DC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001652> "A set of case-control studies of genetic risk factors for prostate cancer in which unrelated self-described African American men were recruited between 2001 and 2005 from the Division of Urology at Howard University Hospital in Washington, DC, United States, with age-matched controls ascertained from the prostate cancer screening population of the same division.")

