AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19127255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20852632") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23552324") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23552324") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3672269/unicode") Annotation(rdfs:comment "All cases had histologically confirmed epithelial ovarian tumor (borderline or invasive) and most of them were enrolled in the study within 1 year of date of initial diagnosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002073> "A clinic-based case-control study of ovarian cancer run at the Mayo Clinic in the United States, whose cases are women with ovarian cancer diagnosed from 2000 onwards who attended the Mayo Clinic from a six-state surrounding region, and whose controls are healthy women seeking a general medical examination at the Mayo Clinic, frequency-matched to cases on age and region of residence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19127255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20852632") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23552324") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23552324") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3672269/unicode") Annotation(rdfs:comment "Cases lived in the six-state region that defines the primary service population of Mayo Clinic (Minnesota, Iowa, Wisconsin, Illinois, North Dakota, and South Dakota).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002073> "A clinic-based case-control study of ovarian cancer run at the Mayo Clinic in the United States, whose cases are women with ovarian cancer diagnosed from 2000 onwards who attended the Mayo Clinic from a six-state surrounding region, and whose controls are healthy women seeking a general medical examination at the Mayo Clinic, frequency-matched to cases on age and region of residence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19127255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20852632") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23552324") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23552324") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3672269/unicode") Annotation(rdfs:comment "Controls were selected from women without ovarian tumors, and with at least one ovary intact, who had presented to the clinic for general medical examination.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002073> "A clinic-based case-control study of ovarian cancer run at the Mayo Clinic in the United States, whose cases are women with ovarian cancer diagnosed from 2000 onwards who attended the Mayo Clinic from a six-state surrounding region, and whose controls are healthy women seeking a general medical examination at the Mayo Clinic, frequency-matched to cases on age and region of residence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19127255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20852632") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23552324") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23552324") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3672269/unicode") Annotation(rdfs:comment "These women were frequency matched on age (5-year age categories), and region of residence to cases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002073> "A clinic-based case-control study of ovarian cancer run at the Mayo Clinic in the United States, whose cases are women with ovarian cancer diagnosed from 2000 onwards who attended the Mayo Clinic from a six-state surrounding region, and whose controls are healthy women seeking a general medical examination at the Mayo Clinic, frequency-matched to cases on age and region of residence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19127255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20852632") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23552324") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23552324") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3672269/unicode") Annotation(rdfs:comment "We used data from an ongoing case-control study of prevalent and incident epithelial ovarian tumors initiated in December 1999 at Mayo Clinic (Rochester, MN).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002073> "A clinic-based case-control study of ovarian cancer run at the Mayo Clinic in the United States, whose cases are women with ovarian cancer diagnosed from 2000 onwards who attended the Mayo Clinic from a six-state surrounding region, and whose controls are healthy women seeking a general medical examination at the Mayo Clinic, frequency-matched to cases on age and region of residence.")

