AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37494057") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40650879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37494057") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC10372759/") Annotation(rdfs:comment "patients with HS presenting to UNC Dermatology outpatient clinics provided written informed consent and were enrolled in HS ProCARE from August 2018 to July 2021.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000869> "A cohort of patients with hidradenitis suppurativa recruited at the University of North Carolina Department of Dermatology in the United States from August 2018 and later expanded to 986 patients, providing clinical data and DNA for genetic association studies of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37494057") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40650879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40650879") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12279254/fullTextXML") Annotation(rdfs:comment "We expanded the HS ProCARE study to 986 patients and used METAL to conduct a GWAS meta-analysis across six studies (Table S1; see Supporting Information).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000869> "A cohort of patients with hidradenitis suppurativa recruited at the University of North Carolina Department of Dermatology in the United States from August 2018 and later expanded to 986 patients, providing clinical data and DNA for genetic association studies of the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000870> (<http://www.ebi.ac.uk/coho/COHO_0000870>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18385738") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature06885/MediaObjects/41586_2008_BFnature06885_MOESM257_ESM.pdf") Annotation(rdfs:comment "The IARC study of lung cancer in central Europe was conducted with cancer institutes in 6 countries including Czech Republic (Prague, Olomouc, Brno), Hungary (Borsod, Heves, Szabolcs, Szolnok, Budapest), Poland (Warsaw, Lodz), Romania (Bucharest), Russia (Moscow) and Slovakia (Banska Bystrica, Bratislava, Nitra) between 1998 and 2002.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000870> "A multicentre hospital-based case–control study of lung cancer coordinated by the International Agency for Research on Cancer in Romania, Hungary, Slovakia, Poland, Russia and the Czech Republic, whose genome-wide genotyped cases and controls contribute to the IARC lung cancer GWAS used by international lung cancer consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18385738") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.nature.com/articles/nature06885") Annotation(rdfs:comment "To identify genetic factors that modify disease risk, we conducted a genome-wide association study by analysing 317,139 single-nucleotide polymorphisms in 1,989 lung cancer cases and 2,625 controls from six central European countries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000870> "A multicentre hospital-based case–control study of lung cancer coordinated by the International Agency for Research on Cancer in Romania, Hungary, Slovakia, Poland, Russia and the Czech Republic, whose genome-wide genotyped cases and controls contribute to the IARC lung cancer GWAS used by international lung cancer consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22899653") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3607485/") Annotation(rdfs:comment "Central Europe 1854 2453 Romania, Hungary, Slovakia, Poland, Russia, Czech Republic Multicenter hospital-based case–control 317 K, 370Duo") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000870> "A multicentre hospital-based case–control study of lung cancer coordinated by the International Agency for Research on Cancer in Romania, Hungary, Slovakia, Poland, Russia and the Czech Republic, whose genome-wide genotyped cases and controls contribute to the IARC lung cancer GWAS used by international lung cancer consortia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41598-017-00850-0/MediaObjects/41598_2017_850_MOESM1_ESM.doc") Annotation(rdfs:comment "The IARC GWAS comprised 3,062 lung cancer cases and 4,455 controls derived from five case-control studies: (i) the Carotene and Retinol Efficacy Trial (CARET) cohort; (ii) the Central Europe multicenter hospital-based case-control study;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000870> "A multicentre hospital-based case–control study of lung cancer coordinated by the International Agency for Research on Cancer in Romania, Hungary, Slovakia, Poland, Russia and the Czech Republic, whose genome-wide genotyped cases and controls contribute to the IARC lung cancer GWAS used by international lung cancer consortia.")
