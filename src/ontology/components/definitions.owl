AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16758424") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19690614") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22498169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24171102") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7802978") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9586648") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16758424") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16758424+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In this prospective study, involving 260 abacavir-naive individuals (7.7% of whom were positive for HLA-B*5701), we confirm the usefulness of genetic risk stratification, with no cases of abacavir hypersensitivity among 148 HLA-B*5701-negative recipients.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002555> "A prospective, single-centre, population-based observational study of the natural history of HIV disease among people with HIV attending the tertiary HIV service in Perth, Western Australia, whose clinical data, HIV sequences and host HLA and genome-wide genotypes have been used to study HIV immune escape, host genetic control of the virus, and prospective HLA-B*5701 screening to prevent abacavir hypersensitivity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16758424") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19690614") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22498169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24171102") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7802978") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9586648") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19690614") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2723923/fullTextXML") Annotation(rdfs:comment "We merged HLA class I and HIV-1 Gag, Pol and Nef sequence data from three existing cohorts of chronically-HIV-infected, antiretroviral naïve individuals previously featured in population-level investigations of HIV immune escape:") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002555> "A prospective, single-centre, population-based observational study of the natural history of HIV disease among people with HIV attending the tertiary HIV service in Perth, Western Australia, whose clinical data, HIV sequences and host HLA and genome-wide genotypes have been used to study HIV immune escape, host genetic control of the virus, and prospective HLA-B*5701 screening to prevent abacavir hypersensitivity.")
