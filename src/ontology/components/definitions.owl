AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25187374") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25187374") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4274808/supplementaryFiles") Annotation(rdfs:comment "All subjects (n = 3,412) were Chinese Hans with normal glucose tolerance as assessed by a standard 75 g oral glucose tolerant tests (OGTTs), and negative family history of diabetes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002385> "A study of type 2 diabetes and glucose metabolism in Han Chinese run from the Shanghai Diabetes Institute of Shanghai Jiao Tong University. Its participants, probands of type 2 diabetes pedigrees diagnosed before age 40 with normoglycaemic controls over 50 without a family history of diabetes recruited at the institute, and people with normal glucose tolerance drawn from the community-based Shanghai Diabetes Study I and II, were genotyped for East Asian genome-wide association studies of type 2 diabetes and fasting glucose.")
