# Individual: <http://www.ebi.ac.uk/coho/COHO_0001836> (<http://www.ebi.ac.uk/coho/COHO_0001836>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38469817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103991") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38469817") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10935759/fullTextXML") Annotation(rdfs:comment "Ninety patients were enrolled in the HangAmDan-B1-Investigator Initiated Trial (HAD-B1-IIT) study, which was a randomized, multicenter, open-label study for the comparison of the safety and efficacy of afatinib monotherapy and that of the combination therapy of afatinib and HAD-B1 for patients with locally advanced NSCLC and EGFR mutations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001836> "A randomized, multi-center, open-label clinical trial in the Republic of Korea, registered as KCT0005414, that compared the safety and efficacy of afatinib alone with afatinib combined with HAD-B1 (HangAmDan-B1), a traditional Korean medicine herbal formulation, in patients with locally advanced or metastatic EGFR-mutation-positive non-small cell lung cancer enrolled at six centres, and ran from February 2021 to April 2023.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38469817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103991") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39103991") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11301725/fullTextXML") Annotation(rdfs:comment "HAD-B1, comprising 4 herbal medicines, has shown promise in lung cancer treatment in both preclinical and clinical settings.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001836> "A randomized, multi-center, open-label clinical trial in the Republic of Korea, registered as KCT0005414, that compared the safety and efficacy of afatinib alone with afatinib combined with HAD-B1 (HangAmDan-B1), a traditional Korean medicine herbal formulation, in patients with locally advanced or metastatic EGFR-mutation-positive non-small cell lung cancer enrolled at six centres, and ran from February 2021 to April 2023.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38469817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103991") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39103991") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11301725/fullTextXML") Annotation(rdfs:comment "The 90 patients with EGFR-mutation-positive locally advanced or metastatic NSCLC requiring afatinib therapy were enrolled from 6 centers") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001836> "A randomized, multi-center, open-label clinical trial in the Republic of Korea, registered as KCT0005414, that compared the safety and efficacy of afatinib alone with afatinib combined with HAD-B1 (HangAmDan-B1), a traditional Korean medicine herbal formulation, in patients with locally advanced or metastatic EGFR-mutation-positive non-small cell lung cancer enrolled at six centres, and ran from February 2021 to April 2023.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38469817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103991") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39103991") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11301725/fullTextXML") Annotation(rdfs:comment "The clinical trial began on February 8, 2021 and completed on April 27, 2023.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001836> "A randomized, multi-center, open-label clinical trial in the Republic of Korea, registered as KCT0005414, that compared the safety and efficacy of afatinib alone with afatinib combined with HAD-B1 (HangAmDan-B1), a traditional Korean medicine herbal formulation, in patients with locally advanced or metastatic EGFR-mutation-positive non-small cell lung cancer enrolled at six centres, and ran from February 2021 to April 2023.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38469817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103991") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39103991") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11301725/fullTextXML") Annotation(rdfs:comment "The clinical trial is a randomized, multi-center, open-label study to compare the safety and efficacy of HAD-B1 combined with afatinib therapy for patients with locally advanced or metastatic EGFR-mutation-positive NSCLC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001836> "A randomized, multi-center, open-label clinical trial in the Republic of Korea, registered as KCT0005414, that compared the safety and efficacy of afatinib alone with afatinib combined with HAD-B1 (HangAmDan-B1), a traditional Korean medicine herbal formulation, in patients with locally advanced or metastatic EGFR-mutation-positive non-small cell lung cancer enrolled at six centres, and ran from February 2021 to April 2023.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38469817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103991") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39103991") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11301725/fullTextXML") Annotation(rdfs:comment "The protocol was approved by Daejeon Korean Medicine Hospital IRB (IRB number: DJDSKH-20-DR-09) and was registered in the Clinical Research Information Service (CRIS) of Republic of Korea (ID: KCT0005414) on September 23, 2020.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001836> "A randomized, multi-center, open-label clinical trial in the Republic of Korea, registered as KCT0005414, that compared the safety and efficacy of afatinib alone with afatinib combined with HAD-B1 (HangAmDan-B1), a traditional Korean medicine herbal formulation, in patients with locally advanced or metastatic EGFR-mutation-positive non-small cell lung cancer enrolled at six centres, and ran from February 2021 to April 2023.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001837> (<http://www.ebi.ac.uk/coho/COHO_0001837>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22426144") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23221126") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22426144") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3372671/") Annotation(rdfs:comment "TaqMan genotyping assay reagents were provided to investigators of 3 studies, HAECS, HJCES, and SEARCH.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001837> "A hospital-based case-control study of endometrial cancer in Kazakhstan, whose own investigators genotyped its samples with TaqMan assays for the final replication stage of a 2012 genome-wide association study of endometrial cancer, and whose data were used again in a 2013 study of inflammation pathway genes and endometrial cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22426144") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23221126") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22426144") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3372671/") Annotation(rdfs:comment "The final replication stage (Stage 3b) included 5,936 cases and 8,166 controls from the Bavarian Endometrial Cancer Study (BECS), Connecticut Endometrial Cancer Study (CECS), Hannover-Almaty Endometrial Cancer Study (HAECS)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001837> "A hospital-based case-control study of endometrial cancer in Kazakhstan, whose own investigators genotyped its samples with TaqMan assays for the final replication stage of a 2012 genome-wide association study of endometrial cancer, and whose data were used again in a 2013 study of inflammation pathway genes and endometrial cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22426144") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23221126") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23221126") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3677562/") Annotation(rdfs:comment "Given that inflammatory process are influenced by inflammation-related genes, we hypothesized that common genetic polymorphisms in inflammatory pathway genes may also influence the risk of endometrial cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001837> "A hospital-based case-control study of endometrial cancer in Kazakhstan, whose own investigators genotyped its samples with TaqMan assays for the final replication stage of a 2012 genome-wide association study of endometrial cancer, and whose data were used again in a 2013 study of inflammation pathway genes and endometrial cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22426144") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23221126") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23221126") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3677562/") Annotation(rdfs:comment "Hannover-AlmatyEndometrial CancerStudy HAECS Kazakhstan; Hospital-based, case-controlstudy 218 232 Taqman") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001837> "A hospital-based case-control study of endometrial cancer in Kazakhstan, whose own investigators genotyped its samples with TaqMan assays for the final replication stage of a 2012 genome-wide association study of endometrial cancer, and whose data were used again in a 2013 study of inflammation pathway genes and endometrial cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001838> (<http://www.ebi.ac.uk/coho/COHO_0001838>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28369534") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28369534") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837206/fullTextXML") Annotation(rdfs:comment "By using a systemic sampling method, beginning with around 3000–3500 residents aged 55 and above in each catchment area, we created a recruitment roster within the target population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001838> "A population-based longitudinal study of ageing, established and funded by the National Health Research Institutes in Taiwan, which in 2009–2013 enrolled community-dwelling adults aged 55 and above, systematically sampled from household registries around a regional hospital in each of seven areas in northern, central, southern and eastern Taiwan, and follows them with home interviews and hospital-based clinical examinations with blood and urine collection every five years and annual telephone contacts, to study physical functioning, chronic and cardiovascular disease, neuropsychiatric health, and genetic and environmental factors in frailty and successful ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28369534") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28369534") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837206/fullTextXML") Annotation(rdfs:comment "In each catchment area, a regional hospital was selected to be the medical facility for clinical examinations, and all eligible residents living within about a 2-km radius of this local hospital were ascertained from the household registry archives.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001838> "A population-based longitudinal study of ageing, established and funded by the National Health Research Institutes in Taiwan, which in 2009–2013 enrolled community-dwelling adults aged 55 and above, systematically sampled from household registries around a regional hospital in each of seven areas in northern, central, southern and eastern Taiwan, and follows them with home interviews and hospital-based clinical examinations with blood and urine collection every five years and annual telephone contacts, to study physical functioning, chronic and cardiovascular disease, neuropsychiatric health, and genetic and environmental factors in frailty and successful ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28369534") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28369534") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837206/fullTextXML") Annotation(rdfs:comment "The HALST is designed as a longitudinal study recruiting community-dwellers aged 55 and above in seven selected areas in Taiwan: two in the north (Shilin District and Yangmei Township), two in the central region (Miaoli City and Changhua City), two in the south (Puzi Township and Lingya District) and one in the east (Hualien).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001838> "A population-based longitudinal study of ageing, established and funded by the National Health Research Institutes in Taiwan, which in 2009–2013 enrolled community-dwelling adults aged 55 and above, systematically sampled from household registries around a regional hospital in each of seven areas in northern, central, southern and eastern Taiwan, and follows them with home interviews and hospital-based clinical examinations with blood and urine collection every five years and annual telephone contacts, to study physical functioning, chronic and cardiovascular disease, neuropsychiatric health, and genetic and environmental factors in frailty and successful ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28369534") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28369534") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837206/fullTextXML") Annotation(rdfs:comment "The first-wave survey (recruitment and baseline survey) was carried out in 2009–13.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001838> "A population-based longitudinal study of ageing, established and funded by the National Health Research Institutes in Taiwan, which in 2009–2013 enrolled community-dwelling adults aged 55 and above, systematically sampled from household registries around a regional hospital in each of seven areas in northern, central, southern and eastern Taiwan, and follows them with home interviews and hospital-based clinical examinations with blood and urine collection every five years and annual telephone contacts, to study physical functioning, chronic and cardiovascular disease, neuropsychiatric health, and genetic and environmental factors in frailty and successful ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28369534") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28369534") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837206/fullTextXML") Annotation(rdfs:comment "To overcome the common barriers in geriatric cohort research, the Healthy Aging Longitudinal Study in Taiwan (HALST) was therefore established and funded by the National Health Research Institutes in Taiwan to address issues related to healthy ageing (ClinicalTrials.gov: NCT02677831).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001838> "A population-based longitudinal study of ageing, established and funded by the National Health Research Institutes in Taiwan, which in 2009–2013 enrolled community-dwelling adults aged 55 and above, systematically sampled from household registries around a regional hospital in each of seven areas in northern, central, southern and eastern Taiwan, and follows them with home interviews and hospital-based clinical examinations with blood and urine collection every five years and annual telephone contacts, to study physical functioning, chronic and cardiovascular disease, neuropsychiatric health, and genetic and environmental factors in frailty and successful ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28369534") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28369534") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837206/fullTextXML") Annotation(rdfs:comment "‘Home visit’ and ‘clinical examination’, including blood and urine samples collection, constitute the formal investigation conducted every 5 years; ‘follow-up telephone survey’ is the annual survey of vital status and new health events occurring between formal home visit and clinical examination.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001838> "A population-based longitudinal study of ageing, established and funded by the National Health Research Institutes in Taiwan, which in 2009–2013 enrolled community-dwelling adults aged 55 and above, systematically sampled from household registries around a regional hospital in each of seven areas in northern, central, southern and eastern Taiwan, and follows them with home interviews and hospital-based clinical examinations with blood and urine collection every five years and annual telephone contacts, to study physical functioning, chronic and cardiovascular disease, neuropsychiatric health, and genetic and environmental factors in frailty and successful ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001839> (<http://www.ebi.ac.uk/coho/COHO_0001839>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18440328") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/s42003-022-03291-2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18440328") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2443415/") Annotation(rdfs:comment "Only subjects aged 20 years and older were eligible to participate and age-eligible family members of all participating subjects were encouraged to enroll.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001839> "A study of relatively healthy adults, aged 20 or over and from large families, of the Old Order Amish of Lancaster County, Pennsylvania, initiated in 2002 to measure cardiovascular responses to four short-term interventions (a cold pressor stress test, a high-salt diet, a high-fat challenge and aspirin therapy) and to identify the genetic and environmental determinants of these responses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18440328") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/s42003-022-03291-2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18440328") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2443415/") Annotation(rdfs:comment "Participants for the HAPI Heart Study were recruited from the Amish community of Lancaster County, PA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001839> "A study of relatively healthy adults, aged 20 or over and from large families, of the Old Order Amish of Lancaster County, Pennsylvania, initiated in 2002 to measure cardiovascular responses to four short-term interventions (a cold pressor stress test, a high-salt diet, a high-fat challenge and aspirin therapy) and to identify the genetic and environmental determinants of these responses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18440328") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/s42003-022-03291-2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18440328") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2443415/") Annotation(rdfs:comment "The Heredity and Phenotype Intervention (HAPI) Heart Study was initiated in 2002 to measure the cardiovascular response to four short-term interventions affecting cardiovascular risk factors and to identify the genetic and environmental determinants of these responses.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001839> "A study of relatively healthy adults, aged 20 or over and from large families, of the Old Order Amish of Lancaster County, Pennsylvania, initiated in 2002 to measure cardiovascular responses to four short-term interventions (a cold pressor stress test, a high-salt diet, a high-fat challenge and aspirin therapy) and to identify the genetic and environmental determinants of these responses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18440328") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/s42003-022-03291-2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18440328") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2443415/") Annotation(rdfs:comment "The interventions were carried out in 868 relatively healthy Amish adults from large families.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001839> "A study of relatively healthy adults, aged 20 or over and from large families, of the Old Order Amish of Lancaster County, Pennsylvania, initiated in 2002 to measure cardiovascular responses to four short-term interventions (a cold pressor stress test, a high-salt diet, a high-fat challenge and aspirin therapy) and to identify the genetic and environmental determinants of these responses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18440328") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/s42003-022-03291-2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18440328") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2443415/") Annotation(rdfs:comment "The measurements included blood pressure responses to the cold pressor stress test and to a high salt diet, triglyceride excursion in response to a high fat challenge, and response in platelet aggregation to aspirin therapy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001839> "A study of relatively healthy adults, aged 20 or over and from large families, of the Old Order Amish of Lancaster County, Pennsylvania, initiated in 2002 to measure cardiovascular responses to four short-term interventions (a cold pressor stress test, a high-salt diet, a high-fat challenge and aspirin therapy) and to identify the genetic and environmental determinants of these responses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18440328") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/s42003-022-03291-2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.nature.com/articles/s42003-022-03291-2") Annotation(rdfs:comment "HAPI recruited 1003 OOA, and the interventions were carried out in 868 relatively healthy OOA adults (>=20 years of age).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001839> "A study of relatively healthy adults, aged 20 or over and from large families, of the Old Order Amish of Lancaster County, Pennsylvania, initiated in 2002 to measure cardiovascular responses to four short-term interventions (a cold pressor stress test, a high-salt diet, a high-fat challenge and aspirin therapy) and to identify the genetic and environmental determinants of these responses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001840> (<http://www.ebi.ac.uk/coho/COHO_0001840>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198609") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198609") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(rdfs:comment "Cases were ascertained through medical record review at all acute care facilities in King, Pierce, and Snohomish counties, Washington, US.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001840> "A population-based case-control study of early-onset myocardial infarction in King, Pierce and Snohomish counties, Washington, United States, whose cases were men under 50 and women under 60 with a first myocardial infarction diagnosed between 1991 and 2002, ascertained through medical record review at all acute care facilities in those counties, and whose controls, matched on age and sex and free of cardiovascular disease, were identified by random digit dialling in the same counties; it is one of the six studies of the Myocardial Infarction Genetics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198609") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198609") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(rdfs:comment "Controls were identified using random digit dialing from these counties (1991-2002) and had no history of cardiovascular disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001840> "A population-based case-control study of early-onset myocardial infarction in King, Pierce and Snohomish counties, Washington, United States, whose cases were men under 50 and women under 60 with a first myocardial infarction diagnosed between 1991 and 2002, ascertained through medical record review at all acute care facilities in those counties, and whose controls, matched on age and sex and free of cardiovascular disease, were identified by random digit dialling in the same counties; it is one of the six studies of the Myocardial Infarction Genetics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198609") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198609") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(rdfs:comment "Eligible case patients were men aged <50 and women <60 diagnosed with a first MI between 1991 to 2002.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001840> "A population-based case-control study of early-onset myocardial infarction in King, Pierce and Snohomish counties, Washington, United States, whose cases were men under 50 and women under 60 with a first myocardial infarction diagnosed between 1991 and 2002, ascertained through medical record review at all acute care facilities in those counties, and whose controls, matched on age and sex and free of cardiovascular disease, were identified by random digit dialling in the same counties; it is one of the six studies of the Myocardial Infarction Genetics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198609") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198609") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(rdfs:comment "HARPS2 is a population-based case-control study of cases of early-onset MI and controls matched on age and sex.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001840> "A population-based case-control study of early-onset myocardial infarction in King, Pierce and Snohomish counties, Washington, United States, whose cases were men under 50 and women under 60 with a first myocardial infarction diagnosed between 1991 and 2002, ascertained through medical record review at all acute care facilities in those counties, and whose controls, matched on age and sex and free of cardiovascular disease, were identified by random digit dialling in the same counties; it is one of the six studies of the Myocardial Infarction Genetics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198609") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198609") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(rdfs:comment "The six studies were: i) Italian Atherosclerosis Thrombosis and Vascular Biology (IATVB); ii) Heart Attack Risk in Puget Sound (HARPS); iii) Registre Gironi del COR (Gerona Heart Registry or REGICOR); iv) Massachusetts General Hospital Premature Coronary Artery Disease (MGH PCAD); v) FINRISK; and vi) Malmo Diet and Cancer Study (MDC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001840> "A population-based case-control study of early-onset myocardial infarction in King, Pierce and Snohomish counties, Washington, United States, whose cases were men under 50 and women under 60 with a first myocardial infarction diagnosed between 1991 and 2002, ascertained through medical record review at all acute care facilities in those counties, and whose controls, matched on age and sex and free of cardiovascular disease, were identified by random digit dialling in the same counties; it is one of the six studies of the Myocardial Infarction Genetics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198609") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198609") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2681011/") Annotation(rdfs:comment "Stage 1 consisted of the Myocardial Infarction Genetics Consortium (MIGen), a collection of 2,967 cases of early-onset MI (in men ≤50 years old or women ≤60 years old) and 3,075 age- and sex-matched controls free of MI from six international sites: Boston and Seattle in the United States as well as Sweden, Finland, Spain, and Italy (Table 1 and Supplementary Methods).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001840> "A population-based case-control study of early-onset myocardial infarction in King, Pierce and Snohomish counties, Washington, United States, whose cases were men under 50 and women under 60 with a first myocardial infarction diagnosed between 1991 and 2002, ascertained through medical record review at all acute care facilities in those counties, and whose controls, matched on age and sex and free of cardiovascular disease, were identified by random digit dialling in the same counties; it is one of the six studies of the Myocardial Infarction Genetics Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001842> (<http://www.ebi.ac.uk/coho/COHO_0001842>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11507694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20595243") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2239968") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9326346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11507694") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC1226067/") Annotation(rdfs:comment "Two collections of DNA samples from families with T1D are publicly available for genetic linkage studies, the Diabetes UK Warren 1 repository of samples from the United Kingdom and the HBDI collection of samples largely from the United States.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001842> "A publicly available collection of DNA samples and immortalized cell lines from families with type 1 diabetes, chiefly multiplex families and largely from the United States, built up from 1990 by the Human Biological Data Interchange in Philadelphia from pedigrees obtained through questionnaires sent to members of the Juvenile Diabetes Foundation, and used in genetic linkage and association studies of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11507694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20595243") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2239968") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9326346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20595243") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2917849/fullTextXML") Annotation(rdfs:comment "HBDI (Human Biological Data Interchange, Philadelphia, PA, USA)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001842> "A publicly available collection of DNA samples and immortalized cell lines from families with type 1 diabetes, chiefly multiplex families and largely from the United States, built up from 1990 by the Human Biological Data Interchange in Philadelphia from pedigrees obtained through questionnaires sent to members of the Juvenile Diabetes Foundation, and used in genetic linkage and association studies of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11507694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20595243") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2239968") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9326346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:2239968") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC1683890") Annotation(rdfs:comment "As of May 1990 more than 10,000 questionnaires have been screened, and a family assessment committee of the HBDI has evaluated the pedigrees to recommend Epstein-Barr virus (EBV) transformations to prepare cell lines.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001842> "A publicly available collection of DNA samples and immortalized cell lines from families with type 1 diabetes, chiefly multiplex families and largely from the United States, built up from 1990 by the Human Biological Data Interchange in Philadelphia from pedigrees obtained through questionnaires sent to members of the Juvenile Diabetes Foundation, and used in genetic linkage and association studies of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11507694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20595243") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2239968") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9326346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:2239968") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC1683890") Annotation(rdfs:comment "The first catalog of immortalized cell lines has now been made available, in collaboration with Coriell Institute in Camden, NJ.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001842> "A publicly available collection of DNA samples and immortalized cell lines from families with type 1 diabetes, chiefly multiplex families and largely from the United States, built up from 1990 by the Human Biological Data Interchange in Philadelphia from pedigrees obtained through questionnaires sent to members of the Juvenile Diabetes Foundation, and used in genetic linkage and association studies of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11507694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20595243") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2239968") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9326346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9326346") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC1715934") Annotation(rdfs:comment "By selection of multiplex families from these questionnaires, it was possible for HBDIinitiallyto offeracollection of 100 type 1 diabe- tes multiplex families having an affected sib pair and two healthy parents.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001842> "A publicly available collection of DNA samples and immortalized cell lines from families with type 1 diabetes, chiefly multiplex families and largely from the United States, built up from 1990 by the Human Biological Data Interchange in Philadelphia from pedigrees obtained through questionnaires sent to members of the Juvenile Diabetes Foundation, and used in genetic linkage and association studies of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11507694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20595243") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2239968") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9326346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9326346") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC1715934") Annotation(rdfs:comment "In cooperation with the Juvenile Diabetes Foundation International, a questionnaire was distributed to 10,000 families that were members ofthe Juvenile Diabetes Foundation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001842> "A publicly available collection of DNA samples and immortalized cell lines from families with type 1 diabetes, chiefly multiplex families and largely from the United States, built up from 1990 by the Human Biological Data Interchange in Philadelphia from pedigrees obtained through questionnaires sent to members of the Juvenile Diabetes Foundation, and used in genetic linkage and association studies of type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001843> (<http://www.ebi.ac.uk/coho/COHO_0001843>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32250320") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38480700") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8060834/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32250320") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32250320+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Harvard Biomarkers Study (HBS) is a longitudinal study designed to accelerate the discovery and validation of molecular diagnostic and progression markers of early-stage PD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001843> "A longitudinal biomarker cohort study run jointly by Brigham and Women's Hospital and Massachusetts General Hospital in Boston, following patients with Parkinson's disease, patients with other neurodegenerative diseases and healthy controls at structured in-person study visits with biobanked samples, to accelerate the discovery and validation of molecular diagnostic and progression markers of early-stage Parkinson's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32250320") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38480700") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8060834/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38480700") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10937726/fullTextXML") Annotation(rdfs:comment "As it is based at a single site in Boston, it also may not be representative of the diversity of PD across the nation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001843> "A longitudinal biomarker cohort study run jointly by Brigham and Women's Hospital and Massachusetts General Hospital in Boston, following patients with Parkinson's disease, patients with other neurodegenerative diseases and healthy controls at structured in-person study visits with biobanked samples, to accelerate the discovery and validation of molecular diagnostic and progression markers of early-stage Parkinson's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32250320") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38480700") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8060834/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38480700") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10937726/fullTextXML") Annotation(rdfs:comment "The biobank includes genotyping (e.g., 42 with GBA mutations), medical record data, as well as repeat clinical scores, and survey measurements.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001843> "A longitudinal biomarker cohort study run jointly by Brigham and Women's Hospital and Massachusetts General Hospital in Boston, following patients with Parkinson's disease, patients with other neurodegenerative diseases and healthy controls at structured in-person study visits with biobanked samples, to accelerate the discovery and validation of molecular diagnostic and progression markers of early-stage Parkinson's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32250320") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38480700") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8060834/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38480700") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10937726/fullTextXML") Annotation(rdfs:comment "The research populations are the Harvard Biomarkers Study (HBS, N = 935), a longitudinal biomarkers cohort study with in-person structured study visits") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001843> "A longitudinal biomarker cohort study run jointly by Brigham and Women's Hospital and Massachusetts General Hospital in Boston, following patients with Parkinson's disease, patients with other neurodegenerative diseases and healthy controls at structured in-person study visits with biobanked samples, to accelerate the discovery and validation of molecular diagnostic and progression markers of early-stage Parkinson's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32250320") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38480700") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8060834/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38480700") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10937726/fullTextXML") Annotation(rdfs:comment "The study includes participants with PD, mild cognitive impairment, and Alzheimer’s disease in addition to healthy controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001843> "A longitudinal biomarker cohort study run jointly by Brigham and Women's Hospital and Massachusetts General Hospital in Boston, following patients with Parkinson's disease, patients with other neurodegenerative diseases and healthy controls at structured in-person study visits with biobanked samples, to accelerate the discovery and validation of molecular diagnostic and progression markers of early-stage Parkinson's disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32250320") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38480700") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8060834/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8060834/fullTextXML") Annotation(rdfs:comment "The Harvard Biomarkers Study (HBS) is a collaborative initiative of Brigham and Women’s Hospital and Massachusetts General Hospital") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001843> "A longitudinal biomarker cohort study run jointly by Brigham and Women's Hospital and Massachusetts General Hospital in Boston, following patients with Parkinson's disease, patients with other neurodegenerative diseases and healthy controls at structured in-person study visits with biobanked samples, to accelerate the discovery and validation of molecular diagnostic and progression markers of early-stage Parkinson's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001844> (<http://www.ebi.ac.uk/coho/COHO_0001844>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37783704") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37783704") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-023-41819-0/MediaObjects/41467_2023_41819_MOESM1_ESM.pdf") Annotation(rdfs:comment "All men and women over 21 years of age with a first-time diagnosis of CRC (ICD-O-3 codes: C18–C21) after January 1, 2008, were eligible for participation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001844> "A population-based study of men and women over 21 years of age who self-identified as Hispanic and had a first diagnosis of colorectal cancer after 1 January 2008, identified through the California Cancer Registry or directly from hospitals in the Los Angeles region (LAC + USC County Hospital and the USC Norris Comprehensive Cancer Center), from whom risk-factor and dietary questionnaires, pathology reports and saliva samples for genotyping were collected.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37783704") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37783704") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-023-41819-0/MediaObjects/41467_2023_41819_MOESM1_ESM.pdf") Annotation(rdfs:comment "Cases were identified from the California Cancer Registry or directly from local hospitals in the Los Angeles region [LAC + USC County Hospital and University of Southern California (USC) Norris Comprehensive Cancer Center].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001844> "A population-based study of men and women over 21 years of age who self-identified as Hispanic and had a first diagnosis of colorectal cancer after 1 January 2008, identified through the California Cancer Registry or directly from hospitals in the Los Angeles region (LAC + USC County Hospital and the USC Norris Comprehensive Cancer Center), from whom risk-factor and dietary questionnaires, pathology reports and saliva samples for genotyping were collected.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37783704") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37783704") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-023-41819-0/MediaObjects/41467_2023_41819_MOESM1_ESM.pdf") Annotation(rdfs:comment "Risk factor/dietary questionnaires, pathology reports and saliva samples (for genotyping) were collected using methodologies developed in the Colon Cancer Family Registry and the Multiethnic Cohort (MEC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001844> "A population-based study of men and women over 21 years of age who self-identified as Hispanic and had a first diagnosis of colorectal cancer after 1 January 2008, identified through the California Cancer Registry or directly from hospitals in the Los Angeles region (LAC + USC County Hospital and the USC Norris Comprehensive Cancer Center), from whom risk-factor and dietary questionnaires, pathology reports and saliva samples for genotyping were collected.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37783704") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37783704") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-023-41819-0/MediaObjects/41467_2023_41819_MOESM1_ESM.pdf") Annotation(rdfs:comment "The Hispanic Colorectal Cancer Study (HCCS) is a population-based study of individuals self-identified as Hispanic with a diagnosis of CRC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001844> "A population-based study of men and women over 21 years of age who self-identified as Hispanic and had a first diagnosis of colorectal cancer after 1 January 2008, identified through the California Cancer Registry or directly from hospitals in the Los Angeles region (LAC + USC County Hospital and the USC Norris Comprehensive Cancer Center), from whom risk-factor and dietary questionnaires, pathology reports and saliva samples for genotyping were collected.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001845> (<http://www.ebi.ac.uk/coho/COHO_0001845>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24836286") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24836286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "Cases were newly diagnosed patients with CRC at Chonnam National University Hwasun Hospital, a cancer-specific hospital in Jeollanam-do province, South Korea, between April 2004 and February 2013.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001845> "The colorectal cancer arm of the Hwasun Cancer Epidemiology Study, a hospital-based case-control study of multiple cancers in South Korea. Its cases are patients newly diagnosed with colorectal cancer at Chonnam National University Hwasun Hospital, a cancer hospital in Jeollanam-do province, between April 2004 and February 2013, excluding secondary or recurrent cancers, and its controls are participants in the Korean Community Health Survey in Jindo and Bosung counties of Jeollanam-do in 2010 to 2012.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24836286") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24836286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "Controls (n=4,552) were participants in the Korean Community Health Survey, an annual nationwide health interview survey, conducted from 2010 to 2012 in the Jindo and Bosung counties of Jeollanam-do province, Korea.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001845> "The colorectal cancer arm of the Hwasun Cancer Epidemiology Study, a hospital-based case-control study of multiple cancers in South Korea. Its cases are patients newly diagnosed with colorectal cancer at Chonnam National University Hwasun Hospital, a cancer hospital in Jeollanam-do province, between April 2004 and February 2013, excluding secondary or recurrent cancers, and its controls are participants in the Korean Community Health Survey in Jindo and Bosung counties of Jeollanam-do in 2010 to 2012.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24836286") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24836286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "Excluded from this study were patients with secondary or recurrent cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001845> "The colorectal cancer arm of the Hwasun Cancer Epidemiology Study, a hospital-based case-control study of multiple cancers in South Korea. Its cases are patients newly diagnosed with colorectal cancer at Chonnam National University Hwasun Hospital, a cancer hospital in Jeollanam-do province, between April 2004 and February 2013, excluding secondary or recurrent cancers, and its controls are participants in the Korean Community Health Survey in Jindo and Bosung counties of Jeollanam-do in 2010 to 2012.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24836286") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24836286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "The HCES is a hospital-based case-control study conducted in South Korea that includes multiple cancers 13, 14 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001845> "The colorectal cancer arm of the Hwasun Cancer Epidemiology Study, a hospital-based case-control study of multiple cancers in South Korea. Its cases are patients newly diagnosed with colorectal cancer at Chonnam National University Hwasun Hospital, a cancer hospital in Jeollanam-do province, between April 2004 and February 2013, excluding secondary or recurrent cancers, and its controls are participants in the Korean Community Health Survey in Jindo and Bosung counties of Jeollanam-do in 2010 to 2012.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24836286") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24836286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "The HCES-CRC consisted of 3,378 cases and 4,552 controls who were included in stage 4 of this project.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001845> "The colorectal cancer arm of the Hwasun Cancer Epidemiology Study, a hospital-based case-control study of multiple cancers in South Korea. Its cases are patients newly diagnosed with colorectal cancer at Chonnam National University Hwasun Hospital, a cancer hospital in Jeollanam-do province, between April 2004 and February 2013, excluding secondary or recurrent cancers, and its controls are participants in the Korean Community Health Survey in Jindo and Bosung counties of Jeollanam-do in 2010 to 2012.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001848> (<http://www.ebi.ac.uk/coho/COHO_0001848>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25349825") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25705162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28154504") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33374401") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39050255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25349825") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4209352/fullTextXML") Annotation(rdfs:comment "We were able to genotype 21 of 24 selected SNPs in our stage 2 samples of 1,216 patients and 1,352 controls recruited to the Health2 study cohort from five different regions of the country; we analyzed their association with T2DM and performed a meta-analysis of the stage 1 and stage 2 results (Appendix 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001848> "A population-based cohort of the Korean Genome and Epidemiology Study (KoGES), set up by the Center for Genome Science of the Korea National Institute of Health, made up of community-based cohorts of adults aged 40–69 in five rural areas of South Korea (Wonju, Pyeongchang, Gangneung, Geumsan and Naju), and later counted as part of the KoGES Cardiovascular Disease Association Study (CAVAS). It served as a replication and case-control sample in Korean genetic association studies of type 2 diabetes, blood pressure, lipids and blood cell traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25349825") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25705162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28154504") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33374401") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39050255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25705162") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4330258/fullTextXML") Annotation(rdfs:comment "Subjects for the replication study were recruited from the Health2 cohorts, another population-based cohort comprising the Wonju, Pyeongchang, Gangneung, Geumsan, and Naju regions in Korea.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001848> "A population-based cohort of the Korean Genome and Epidemiology Study (KoGES), set up by the Center for Genome Science of the Korea National Institute of Health, made up of community-based cohorts of adults aged 40–69 in five rural areas of South Korea (Wonju, Pyeongchang, Gangneung, Geumsan and Naju), and later counted as part of the KoGES Cardiovascular Disease Association Study (CAVAS). It served as a replication and case-control sample in Korean genetic association studies of type 2 diabetes, blood pressure, lipids and blood cell traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25349825") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25705162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28154504") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33374401") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39050255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28154504") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5287117/fullTextXML") Annotation(rdfs:comment "The Health2 study consists of community-based cohorts from 5 rural areas (i.e., Wonju, Pyeongchang, Gangneung, Geumsan, and Naju), and the HEXA study is a cohort from 14 urban areas.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001848> "A population-based cohort of the Korean Genome and Epidemiology Study (KoGES), set up by the Center for Genome Science of the Korea National Institute of Health, made up of community-based cohorts of adults aged 40–69 in five rural areas of South Korea (Wonju, Pyeongchang, Gangneung, Geumsan and Naju), and later counted as part of the KoGES Cardiovascular Disease Association Study (CAVAS). It served as a replication and case-control sample in Korean genetic association studies of type 2 diabetes, blood pressure, lipids and blood cell traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25349825") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25705162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28154504") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33374401") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39050255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33374401") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7824099/fullTextXML") Annotation(rdfs:comment "four population-based Korean cohort studies established by the Center for Genome Science at the Korean National Institute of Health: the Korea Association Resource Study (KARE), Health Examinees (HEXA) Study, Korean Healthy Twin Study (HT), and Health2 Study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001848> "A population-based cohort of the Korean Genome and Epidemiology Study (KoGES), set up by the Center for Genome Science of the Korea National Institute of Health, made up of community-based cohorts of adults aged 40–69 in five rural areas of South Korea (Wonju, Pyeongchang, Gangneung, Geumsan and Naju), and later counted as part of the KoGES Cardiovascular Disease Association Study (CAVAS). It served as a replication and case-control sample in Korean genetic association studies of type 2 diabetes, blood pressure, lipids and blood cell traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25349825") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25705162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28154504") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33374401") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39050255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39050255") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11266026/fullTextXML") Annotation(rdfs:comment "CArdioVascular disease Association Study (CAVAS) cohort (formerly Health2 or RURAL cohort)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001848> "A population-based cohort of the Korean Genome and Epidemiology Study (KoGES), set up by the Center for Genome Science of the Korea National Institute of Health, made up of community-based cohorts of adults aged 40–69 in five rural areas of South Korea (Wonju, Pyeongchang, Gangneung, Geumsan and Naju), and later counted as part of the KoGES Cardiovascular Disease Association Study (CAVAS). It served as a replication and case-control sample in Korean genetic association studies of type 2 diabetes, blood pressure, lipids and blood cell traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25349825") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25705162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28154504") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33374401") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39050255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(rdfs:comment "Health2 cohort recruited a total of 8,500 participants aged 40-69 years from five regional cities in Korea based on the Korean Genome Epidemiologic Study (KoGES) project.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001848> "A population-based cohort of the Korean Genome and Epidemiology Study (KoGES), set up by the Center for Genome Science of the Korea National Institute of Health, made up of community-based cohorts of adults aged 40–69 in five rural areas of South Korea (Wonju, Pyeongchang, Gangneung, Geumsan and Naju), and later counted as part of the KoGES Cardiovascular Disease Association Study (CAVAS). It served as a replication and case-control sample in Korean genetic association studies of type 2 diabetes, blood pressure, lipids and blood cell traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001849> (<http://www.ebi.ac.uk/coho/COHO_0001849>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22267197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature24284/MediaObjects/41586_2017_BFnature24284_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22267197") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf") Annotation(rdfs:comment "Consecutive cases (883) from the Department of Oncology, Helsinki University Central Hospital 1997-8 and 2000") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001849> "A hospital-based breast cancer case-control study at Helsinki University Central Hospital in southern Finland, whose cases are consecutive, unselected breast cancer patients from the hospital's Departments of Oncology (1997-1998 and 2000) and Surgery (2001-2004) together with familial breast cancer patients from its Departments of Oncology and Clinical Genetics (from 1995), and whose controls are healthy women from the same region.")
