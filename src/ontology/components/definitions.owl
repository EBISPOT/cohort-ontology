# Individual: <http://www.ebi.ac.uk/coho/COHO_0000878> (<http://www.ebi.ac.uk/coho/COHO_0000878>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41287920") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000878> "A population-based study of youths aged 8–21 living in the greater Philadelphia area, United States, recruited through the Children’s Hospital of Philadelphia Center for Applied Genomics from non-psychiatric paediatric clinics and assessed with clinical, neurocognitive and neuroimaging measures to describe how genetics affects brain development and cognitive functioning in adolescence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000879> (<http://www.ebi.ac.uk/coho/COHO_0000879>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26034056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000879> "A study within Kaiser Permanente Northern California that ascertained African-American prostate cancer cases, genotyped together with the Research Program on Genes, Environment and Health cohort and the California Men's Health Study for genome-wide association studies of prostate cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000880> (<http://www.ebi.ac.uk/coho/COHO_0000880>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31095341") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37862240") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000880> "An international consortium, established in 2009, of cohorts of cancer patients treated with radiotherapy (for prostate, head and neck, breast and lung cancer, among others) that shares genotype and normal-tissue toxicity data and develops meta-analysis methods to identify genetic variants associated with radiation-induced toxicity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000881> (<http://www.ebi.ac.uk/coho/COHO_0000881>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000881> "A population-based case-control study in East Anglia, UK, run from Cambridge with Cancer Research UK funding, in which people with cancer registered with the Eastern Cancer Registration and Information Centre and controls attending general practice in East Anglia provide data and DNA to study genetic susceptibility to cancers including breast and prostate cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000882> (<http://www.ebi.ac.uk/coho/COHO_0000882>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15465616") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000882> "An observational multicentre study in the United States of physician-diagnosed diabetes in people under 20 years old, ascertaining prevalent and incident cases in geographically defined populations and health plans, with interviews, examinations and laboratory measurements, to estimate the prevalence, incidence and classification of diabetes in youth.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000883> (<http://www.ebi.ac.uk/coho/COHO_0000883>)

