AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature09270/MediaObjects/41586_2010_BFnature09270_MOESM283_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2797/MediaObjects/41588_2013_BFng2797_MOESM43_ESM.pdf") Annotation(rdfs:comment "Samples for analysis were from the Cholesterol and Atherosclerosis Pharmacogenetics (CAP) Study49 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002231> "A pharmacogenomic study of the response to statins that combines two clinical populations of white adults in the United States given a statin for a fixed period: participants of the Cholesterol and Atherosclerosis Pharmacogenetics (CAP) study, recruited at two clinical sites in Los Angeles and San Francisco and treated with simvastatin for six weeks, and participants of the Pravastatin Inflammation CRP Evaluation (PRINCE) trial, enrolled at sites across the country and treated with pravastatin for twelve weeks.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002232> (<http://www.ebi.ac.uk/coho/COHO_0002232>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21741729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21912625") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21741729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3172377/") Annotation(rdfs:comment "DNA was extracted from saliva samples and genotyped by BioServe Biotechnologies, Ltd.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002232> "A case-control study of Parkinson's disease nested in the NIH-AARP Diet and Health Study, the prospective cohort established by the National Cancer Institute in 1995–1996, whose cases are cohort members who reported Parkinson's disease in the cohort's 2004–2006 follow-up survey and were confirmed by their treating physicians or by medical record review, and whose controls are randomly selected cohort members who did not report Parkinson's disease, frequency-matched to the cases on year of birth, sex and ethnicity, with DNA collected from saliva.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21741729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21912625") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21741729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3172377/") Annotation(rdfs:comment "Potential PD patients in this cohort were first identified from self-reports in its follow-up survey in 2004–2006, and then were confirmed either by their treating physicians or by medical record review (Chen, et al., 2010).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002232> "A case-control study of Parkinson's disease nested in the NIH-AARP Diet and Health Study, the prospective cohort established by the National Cancer Institute in 1995–1996, whose cases are cohort members who reported Parkinson's disease in the cohort's 2004–2006 follow-up survey and were confirmed by their treating physicians or by medical record review, and whose controls are randomly selected cohort members who did not report Parkinson's disease, frequency-matched to the cases on year of birth, sex and ethnicity, with DNA collected from saliva.")
