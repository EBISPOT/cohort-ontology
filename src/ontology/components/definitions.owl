AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.epic-norfolk.org.uk/about-epic-norfolk/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23771720") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4121549/fullTextXML") Annotation(rdfs:comment "EPIC-Norfolk examined 25 639 men and women resident in East Anglia (aged 40–79 years), between 1993 and 1997.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000066> "A cohort of men and women aged 39–79 recruited in Norwich and surrounding Norfolk communities in 1993–1997, followed through questionnaires and examinations to investigate diet, lifestyle and health as part of the European Prospective Investigation of Cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.epic-norfolk.org.uk/about-epic-norfolk/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.epic-norfolk.org.uk/about-epic-norfolk/") Annotation(rdfs:comment "Over 30,000 people living in Norwich and surrounding towns and rural areas were recruited into the EPIC-Norfolk study between 1993 and 1997. The participants are men and women who were aged between 39 and 79 at recruitment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000066> "A cohort of men and women aged 39–79 recruited in Norwich and surrounding Norfolk communities in 1993–1997, followed through questionnaires and examinations to investigate diet, lifestyle and health as part of the European Prospective Investigation of Cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.epic-norfolk.org.uk/about-epic-norfolk/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.epic-norfolk.org.uk/about-epic-norfolk/") Annotation(rdfs:comment "The primary aim of the international EPIC study, and therefore EPIC-Norfolk, was to examine the relationships between what people have reported as their dietary intake and incident cancers; that is, cancers which have developed after they joined the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000066> "A cohort of men and women aged 39–79 recruited in Norwich and surrounding Norfolk communities in 1993–1997, followed through questionnaires and examinations to investigate diet, lifestyle and health as part of the European Prospective Investigation of Cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.epic-norfolk.org.uk/about-epic-norfolk/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.epic-norfolk.org.uk/about-epic-norfolk/") Annotation(rdfs:comment "They have continued to contribute information about their diet, lifestyle and health through questionnaires and health checks for over 25 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000066> "A cohort of men and women aged 39–79 recruited in Norwich and surrounding Norfolk communities in 1993–1997, followed through questionnaires and examinations to investigate diet, lifestyle and health as part of the European Prospective Investigation of Cancer.")

