AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12826435") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16754790") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19304780") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-022-32821-z/MediaObjects/41467_2022_32821_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19304780") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2685752/fullTextXML") Annotation(rdfs:comment "Healthy normotensive controls (n = 2000; BP <140/90 mmHg, no antihypertensive medication and no diagnosed diseases) were recruited by matching age, sex and geographical distribution across UK.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000557> "A UK resource of white European families with severe essential hypertension, collected by the Medical Research Council British Genetics of Hypertension (BRIGHT) study through the MRC General Practice Framework and other primary care practices, including affected sibling pairs and parent-offspring trios, with normotensive controls matched by age, sex and geography across the UK, for linkage and association studies of the genetics of hypertension.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12826435") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16754790") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19304780") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-022-32821-z/MediaObjects/41467_2022_32821_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-022-32821-z/MediaObjects/41467_2022_32821_MOESM1_ESM.pdf") Annotation(rdfs:comment "Participants of the BRIGHT Study were recruited from the Medical Research Council General Practice Framework and other primary care practices in the UK.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000557> "A UK resource of white European families with severe essential hypertension, collected by the Medical Research Council British Genetics of Hypertension (BRIGHT) study through the MRC General Practice Framework and other primary care practices, including affected sibling pairs and parent-offspring trios, with normotensive controls matched by age, sex and geography across the UK, for linkage and association studies of the genetics of hypertension.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000558> (<http://www.ebi.ac.uk/coho/COHO_0000558>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://portals.broadinstitute.org/collaboration/giant/index.php/Main_Page") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26426971") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26426971+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To systematically screen for age- and/or sex-specific effects of genetic variants on BMI and WHRadjBMI, we performed meta-analyses of 114 studies (up to 320,485 individuals of European descent) with genome-wide chip and/or Metabochip data by the Genetic Investigation of Anthropometric Traits (GIANT) Consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000558> "An international collaboration of investigators from many groups, institutions, countries and studies that meta-analyses genome-wide association and other large-scale genetic data to identify loci modulating human body size and shape, such as height, body mass index and waist-related traits, and releases the summary data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://portals.broadinstitute.org/collaboration/giant/index.php/Main_Page") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://portals.broadinstitute.org/collaboration/giant/index.php/Main_Page") Annotation(rdfs:comment "Anthropometric traits that have been studied by GIANT include body mass index (BMI), height, and traits related to waist circumference (such as waist-hip ratio adjusted for BMI, or WHRadjBMI).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000558> "An international collaboration of investigators from many groups, institutions, countries and studies that meta-analyses genome-wide association and other large-scale genetic data to identify loci modulating human body size and shape, such as height, body mass index and waist-related traits, and releases the summary data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://portals.broadinstitute.org/collaboration/giant/index.php/Main_Page") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://portals.broadinstitute.org/collaboration/giant/index.php/Main_Page") Annotation(rdfs:comment "The GIANT consortium is a collaboration between investigators from many different groups, institutions, countries, and studies, and the results represent their combined efforts.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000558> "An international collaboration of investigators from many groups, institutions, countries and studies that meta-analyses genome-wide association and other large-scale genetic data to identify loci modulating human body size and shape, such as height, body mass index and waist-related traits, and releases the summary data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://portals.broadinstitute.org/collaboration/giant/index.php/Main_Page") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://portals.broadinstitute.org/collaboration/giant/index.php/Main_Page") Annotation(rdfs:comment "The Genetic Investigation of ANthropometric Traits (GIANT) consortium is an international collaboration that seeks to identify genetic loci that modulate human body size and shape, including height and measures of obesity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000558> "An international collaboration of investigators from many groups, institutions, countries and studies that meta-analyses genome-wide association and other large-scale genetic data to identify loci modulating human body size and shape, such as height, body mass index and waist-related traits, and releases the summary data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://portals.broadinstitute.org/collaboration/giant/index.php/Main_Page") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://portals.broadinstitute.org/collaboration/giant/index.php/Main_Page") Annotation(rdfs:comment "We are releasing the summary data from our meta-analyses of GWAS data, in order to enable other researchers to examine particular variants or loci for their evidence of association with anthropometric traits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000558> "An international collaboration of investigators from many groups, institutions, countries and studies that meta-analyses genome-wide association and other large-scale genetic data to identify loci modulating human body size and shape, such as height, body mass index and waist-related traits, and releases the summary data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000559> (<http://www.ebi.ac.uk/coho/COHO_0000559>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27157501") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34450027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27157501") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27157501+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A cross-sectional study was conducted consisting of 2,943 volunteers of Southern Chinese origin (mean age: 41.1 years; range: 15-55 years; 59.6% women).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000559> "A population-based cohort of about 2,900 volunteers of Southern Chinese origin aged 15–55 in Hong Kong, openly recruited through newspaper advertisements, posters and e-mails regardless of back symptoms, who underwent lumbar spine MRI, questionnaires and genome-wide genotyping, to study the genetic and environmental determinants of intervertebral disc degeneration.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27157501") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34450027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27157501") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27157501+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Blood samples were taken for genotyping using the HumanOmni-ZhongHua-8 BeadChip.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000559> "A population-based cohort of about 2,900 volunteers of Southern Chinese origin aged 15–55 in Hong Kong, openly recruited through newspaper advertisements, posters and e-mails regardless of back symptoms, who underwent lumbar spine MRI, questionnaires and genome-wide genotyping, to study the genetic and environmental determinants of intervertebral disc degeneration.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27157501") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34450027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27157501") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27157501+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Subject demographics, environmental, and lifestyle factors were assessed by questionnaires.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000559> "A population-based cohort of about 2,900 volunteers of Southern Chinese origin aged 15–55 in Hong Kong, openly recruited through newspaper advertisements, posters and e-mails regardless of back symptoms, who underwent lumbar spine MRI, questionnaires and genome-wide genotyping, to study the genetic and environmental determinants of intervertebral disc degeneration.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27157501") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34450027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27157501") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27157501+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The MRI features of lumbar intervertebral disc changes, such as disc signal intensity loss and disc bulges or extrusions, as well as additional imaging phenotypes of end plate changes, high-intensity zones, and bone marrow changes, were evaluated.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000559> "A population-based cohort of about 2,900 volunteers of Southern Chinese origin aged 15–55 in Hong Kong, openly recruited through newspaper advertisements, posters and e-mails regardless of back symptoms, who underwent lumbar spine MRI, questionnaires and genome-wide genotyping, to study the genetic and environmental determinants of intervertebral disc degeneration.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27157501") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34450027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(rdfs:comment "Hong Kong Degenerative Disc Disease Population Cohort (HKDDDPC) is a population-based cohort with subjects openly recruited via newspapers advertisement, posters and e-mails, regardless of their social and economic status.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000559> "A population-based cohort of about 2,900 volunteers of Southern Chinese origin aged 15–55 in Hong Kong, openly recruited through newspaper advertisements, posters and e-mails regardless of back symptoms, who underwent lumbar spine MRI, questionnaires and genome-wide genotyping, to study the genetic and environmental determinants of intervertebral disc degeneration.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27157501") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34450027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(rdfs:comment "Subjects selected were not based on the presence or absence of clinical symptoms.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000559> "A population-based cohort of about 2,900 volunteers of Southern Chinese origin aged 15–55 in Hong Kong, openly recruited through newspaper advertisements, posters and e-mails regardless of back symptoms, who underwent lumbar spine MRI, questionnaires and genome-wide genotyping, to study the genetic and environmental determinants of intervertebral disc degeneration.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000560> (<http://www.ebi.ac.uk/coho/COHO_0000560>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3002160/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5619832/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5619832/fullTextXML") Annotation(rdfs:comment "In this study, we analyzed OncoArray genotypic data of 36,000 subjects of European descent in ILCCO; among them, 17,037 provided individual epidemiological data and were of European descent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000560> "An international consortium established in 2004 by research groups leading large molecular epidemiology studies of lung cancer, which pools data from its member case-control and cohort studies to study lung cancer risk and prognosis; its OncoArray project genotyped participants of European descent.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3002160/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5619832/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5619832/fullTextXML") Annotation(rdfs:comment "The International Lung Cancer Consortium (ILCCO) was established in 2004 with the goal of sharing comparable research data and maximizing research efficiency (http://ilcco.iarc.fr).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000560> "An international consortium established in 2004 by research groups leading large molecular epidemiology studies of lung cancer, which pools data from its member case-control and cohort studies to study lung cancer risk and prognosis; its OncoArray project genotyped participants of European descent.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000561> (<http://www.ebi.ac.uk/coho/COHO_0000561>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40407102") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://adsp.niagads.org/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dss.niagads.org/studies/sa000001/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40407102") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12100500/fullTextXML") Annotation(rdfs:comment "The ADSP FUS is a National Institute on Aging (NIA) initiative focused on identifying genetic risk and protective variants for AD by expanding the ADSP cohorts beyond primarily participants with non‐Hispanic Whites of European Ancestry") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000561> "A US National Institutes of Health initiative, started in 2012, that sequences the exomes and whole genomes of well-characterized participants of many Alzheimer disease cohorts, first from the Alzheimer's Disease Genetics Consortium and CHARGE consortium and later from ancestrally diverse cohorts, and integrates them with harmonized phenotypes to identify genetic risk and protective variants for Alzheimer disease and related dementias, with a fourth whole-genome release from 17 cohorts in 14 countries, 45% of its unique participants of non-European ancestry, and a fifth whole-genome release from 57 cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40407102") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://adsp.niagads.org/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dss.niagads.org/studies/sa000001/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40407102") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12100500/fullTextXML") Annotation(rdfs:comment "The Alzheimer's Disease Sequencing Project (ADSP) is a national initiative to understand the genetic architecture of Alzheimer's disease and related dementias (ADRD) by integrating whole genome sequencing (WGS) with other genetic, phenotypic, and harmonized datasets from diverse populations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000561> "A US National Institutes of Health initiative, started in 2012, that sequences the exomes and whole genomes of well-characterized participants of many Alzheimer disease cohorts, first from the Alzheimer's Disease Genetics Consortium and CHARGE consortium and later from ancestrally diverse cohorts, and integrates them with harmonized phenotypes to identify genetic risk and protective variants for Alzheimer disease and related dementias, with a fourth whole-genome release from 17 cohorts in 14 countries, 45% of its unique participants of non-European ancestry, and a fifth whole-genome release from 57 cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40407102") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://adsp.niagads.org/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dss.niagads.org/studies/sa000001/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40407102") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12100500/fullTextXML") Annotation(rdfs:comment "The Genome Center for Alzheimer's Disease (GCAD) uniformly processed WGS from 36,361 ADSP samples, including 35,014 genetically unique participants of which 45% are from non‐European ancestry, across 17 cohorts in 14 countries in this fourth release (R4).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000561> "A US National Institutes of Health initiative, started in 2012, that sequences the exomes and whole genomes of well-characterized participants of many Alzheimer disease cohorts, first from the Alzheimer's Disease Genetics Consortium and CHARGE consortium and later from ancestrally diverse cohorts, and integrates them with harmonized phenotypes to identify genetic risk and protective variants for Alzheimer disease and related dementias, with a fourth whole-genome release from 17 cohorts in 14 countries, 45% of its unique participants of non-European ancestry, and a fifth whole-genome release from 57 cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40407102") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://adsp.niagads.org/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dss.niagads.org/studies/sa000001/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://adsp.niagads.org/data/data-summary/") Annotation(rdfs:comment "Release 5 WGS: 58,507 genomes from 57 cohorts Population breakdown for 57,302 unique subjects:") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000561> "A US National Institutes of Health initiative, started in 2012, that sequences the exomes and whole genomes of well-characterized participants of many Alzheimer disease cohorts, first from the Alzheimer's Disease Genetics Consortium and CHARGE consortium and later from ancestrally diverse cohorts, and integrates them with harmonized phenotypes to identify genetic risk and protective variants for Alzheimer disease and related dementias, with a fourth whole-genome release from 17 cohorts in 14 countries, 45% of its unique participants of non-European ancestry, and a fifth whole-genome release from 57 cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40407102") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://adsp.niagads.org/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dss.niagads.org/studies/sa000001/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://dss.niagads.org/studies/sa000001/") Annotation(rdfs:comment "An initiative in response to the National Alzheimer’s Project Act (NAPA) has been working towards new biological insights and cures for Alzheimer’s Disease (AD) since its introduction by NIH on February 7, 2012.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000561> "A US National Institutes of Health initiative, started in 2012, that sequences the exomes and whole genomes of well-characterized participants of many Alzheimer disease cohorts, first from the Alzheimer's Disease Genetics Consortium and CHARGE consortium and later from ancestrally diverse cohorts, and integrates them with harmonized phenotypes to identify genetic risk and protective variants for Alzheimer disease and related dementias, with a fourth whole-genome release from 17 cohorts in 14 countries, 45% of its unique participants of non-European ancestry, and a fifth whole-genome release from 57 cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40407102") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://adsp.niagads.org/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dss.niagads.org/studies/sa000001/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://dss.niagads.org/studies/sa000001/") Annotation(rdfs:comment "The Case-Control and Enriched Case Study spans 24 cohorts provided by the Alzheimer’s Disease Genetics Consortium (ADGC) and the Cohorts for Heart and Aging Research in Genomic Epidemiology (CHARGE) Consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000561> "A US National Institutes of Health initiative, started in 2012, that sequences the exomes and whole genomes of well-characterized participants of many Alzheimer disease cohorts, first from the Alzheimer's Disease Genetics Consortium and CHARGE consortium and later from ancestrally diverse cohorts, and integrates them with harmonized phenotypes to identify genetic risk and protective variants for Alzheimer disease and related dementias, with a fourth whole-genome release from 17 cohorts in 14 countries, 45% of its unique participants of non-European ancestry, and a fifth whole-genome release from 57 cohorts.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000562> (<http://www.ebi.ac.uk/coho/COHO_0000562>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18426866") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33865193") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20507864") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3147061") Annotation(rdfs:comment "Surveys were conducted in the second to third tri- mester of pregnancy, immediately after birth and then every 2 months for 24 months.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000562> "A community-based birth cohort of about 3,000 singletons born in 1983-1984 in Cebu, Philippines, and their mothers, enrolled in pregnancy and followed with bimonthly surveys for two years and repeated follow-up surveys to age 35, run by the Office of Population Studies of the University of San Carlos and the University of North Carolina to study the long-term effects of early nutrition and life conditions on health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18426866") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33865193") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20507864") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3147061") Annotation(rdfs:comment "The idea was to study these topics within as natural a setting as possible and to analyse how infant-feeding decisions interacted with social, economic and environmental factors to affect health, nutritional, demographic and economic outcomes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000562> "A community-based birth cohort of about 3,000 singletons born in 1983-1984 in Cebu, Philippines, and their mothers, enrolled in pregnancy and followed with bimonthly surveys for two years and repeated follow-up surveys to age 35, run by the Office of Population Studies of the University of San Carlos and the University of North Carolina to study the long-term effects of early nutrition and life conditions on health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18426866") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33865193") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33865193") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8222184/fullTextXML") Annotation(rdfs:comment "Singletons born in a one-year (1983−84) period (n = 3080) form the cohort of index children followed to age 35 years, with surveys every 2 months for the first 2 years, and follow-up surveys in 1991, 1994, 1998, 2002, 2005, 2009 and 2018.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000562> "A community-based birth cohort of about 3,000 singletons born in 1983-1984 in Cebu, Philippines, and their mothers, enrolled in pregnancy and followed with bimonthly surveys for two years and repeated follow-up surveys to age 35, run by the Office of Population Studies of the University of San Carlos and the University of North Carolina to study the long-term effects of early nutrition and life conditions on health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18426866") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33865193") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33865193") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8222184/fullTextXML") Annotation(rdfs:comment "The CLHNS is a community-based study that recruited 3327 women from 33 randomly selected barangays (administrative units) from the 252 barangays that comprised Metro Cebu in 1982.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000562> "A community-based birth cohort of about 3,000 singletons born in 1983-1984 in Cebu, Philippines, and their mothers, enrolled in pregnancy and followed with bimonthly surveys for two years and repeated follow-up surveys to age 35, run by the Office of Population Studies of the University of San Carlos and the University of North Carolina to study the long-term effects of early nutrition and life conditions on health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18426866") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33865193") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33865193") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33865193+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Using data from a Philippine birth cohort followed for 35 years, we model 6 continuation decisions: Did not complete elementary school, elementary graduate only (completed grade 6), some secondary schooling, high school graduate, some postsecondary schooling, and college graduate, as well as total years of schooling.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000562> "A community-based birth cohort of about 3,000 singletons born in 1983-1984 in Cebu, Philippines, and their mothers, enrolled in pregnancy and followed with bimonthly surveys for two years and repeated follow-up surveys to age 35, run by the Office of Population Studies of the University of San Carlos and the University of North Carolina to study the long-term effects of early nutrition and life conditions on health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18426866") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33865193") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3582398/") Annotation(rdfs:comment "We thank the Office of Population Studies Foundation research and data collection teams for the Cebu Longitudinal Health and Nutrition Survey.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000562> "A community-based birth cohort of about 3,000 singletons born in 1983-1984 in Cebu, Philippines, and their mothers, enrolled in pregnancy and followed with bimonthly surveys for two years and repeated follow-up surveys to age 35, run by the Office of Population Studies of the University of San Carlos and the University of North Carolina to study the long-term effects of early nutrition and life conditions on health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18426866") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33865193") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000523.v1.p1") Annotation(rdfs:comment "Current research is focused on the long-term effects of prenatal and early childhood nutrition and health on later adult outcomes, including development of chronic disease risk factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000562> "A community-based birth cohort of about 3,000 singletons born in 1983-1984 in Cebu, Philippines, and their mothers, enrolled in pregnancy and followed with bimonthly surveys for two years and repeated follow-up surveys to age 35, run by the Office of Population Studies of the University of San Carlos and the University of North Carolina to study the long-term effects of early nutrition and life conditions on health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000563> (<http://www.ebi.ac.uk/coho/COHO_0000563>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38222332") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9693138/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38222332") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC10785925") Annotation(rdfs:comment "As of March 20, 2023, 174,595 participants have enrolled in the study (from all 50 US states) and 165,119 samples have been shipped to deCODE or to IPG for analysis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000563> "A population genomics study launched in 2019 by Intermountain Healthcare (Utah) in partnership with deCODE genetics and Amgen, enrolling adults and children (more than 170,000 by 2023) whose whole-genome sequence or genotype data are linked to health records, to discover genetic biomarkers of disease and return actionable findings to participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38222332") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9693138/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38222332") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC10785925") Annotation(rdfs:comment "It was announced in 2019 as a collaboration between Intermountain Health (IH) and deCODE genetics, a subsidiary of Amgen Inc., and aims to analyze the genes of up to 500,000 individuals to better predict and prevent disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000563> "A population genomics study launched in 2019 by Intermountain Healthcare (Utah) in partnership with deCODE genetics and Amgen, enrolling adults and children (more than 170,000 by 2023) whose whole-genome sequence or genotype data are linked to health records, to discover genetic biomarkers of disease and return actionable findings to participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38222332") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9693138/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38222332") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC10785925") Annotation(rdfs:comment "Participants receive actionable variant results and genetic counseling, which may extend to family members via cascade testing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000563> "A population genomics study launched in 2019 by Intermountain Healthcare (Utah) in partnership with deCODE genetics and Amgen, enrolling adults and children (more than 170,000 by 2023) whose whole-genome sequence or genotype data are linked to health records, to discover genetic biomarkers of disease and return actionable findings to participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38222332") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9693138/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38222332") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC10785925") Annotation(rdfs:comment "The HerediGene Population Study (HGPS) is an observational, non-randomized study of diseased and non-diseased adults and children.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000563> "A population genomics study launched in 2019 by Intermountain Healthcare (Utah) in partnership with deCODE genetics and Amgen, enrolling adults and children (more than 170,000 by 2023) whose whole-genome sequence or genotype data are linked to health records, to discover genetic biomarkers of disease and return actionable findings to participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38222332") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9693138/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38222332") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC10785925") Annotation(rdfs:comment "The study merges genotyping and whole genome sequencing data with longitudinal health records to discover new biomarkers with preventive, prognostic, or diagnostic potential and to develop new therapeutics.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000563> "A population genomics study launched in 2019 by Intermountain Healthcare (Utah) in partnership with deCODE genetics and Amgen, enrolling adults and children (more than 170,000 by 2023) whose whole-genome sequence or genotype data are linked to health records, to discover genetic biomarkers of disease and return actionable findings to participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38222332") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9693138/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38222332") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC10785925") Annotation(rdfs:comment "The study started enrolling participants in June 2019, at the IH Cancer Center, in St. George, Utah and the Intermountain Medical Center Eccles Outpatient Lab in Murray, Utah.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000563> "A population genomics study launched in 2019 by Intermountain Healthcare (Utah) in partnership with deCODE genetics and Amgen, enrolling adults and children (more than 170,000 by 2023) whose whole-genome sequence or genotype data are linked to health records, to discover genetic biomarkers of disease and return actionable findings to participants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000564> (<http://www.ebi.ac.uk/coho/COHO_0000564>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/instance/10152894/bin/NIHMS1835943-supplement-Supplemental_Publication_Material.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(rdfs:comment "Controls were a random sample of GH members frequency matched to MI cases on age (within decade), sex, treated hypertension, and calendar year of identification.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000564> "A population-based case-control study of risk factors for cardiovascular outcomes among members of Group Health (now Kaiser Permanente Washington), an integrated health care system in western Washington State, with case groups of incident myocardial infarction, stroke, venous thromboembolism and atrial fibrillation and a shared control group frequency-matched to the myocardial infarction cases. Myocardial infarction, stroke and venous thromboembolism cases were identified from diagnosis codes (and, for venous thrombosis, heparin prescriptions) and validated by medical-record review; consenting participants gave blood for genotyping, and venous thromboembolism cases were followed for recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/instance/10152894/bin/NIHMS1835943-supplement-Supplemental_Publication_Material.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(rdfs:comment "The setting for this study was Group Health (GH), a large integrated health care system in western Washington State (Kaiser Permanente Washington, as of February 2017).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000564> "A population-based case-control study of risk factors for cardiovascular outcomes among members of Group Health (now Kaiser Permanente Washington), an integrated health care system in western Washington State, with case groups of incident myocardial infarction, stroke, venous thromboembolism and atrial fibrillation and a shared control group frequency-matched to the myocardial infarction cases. Myocardial infarction, stroke and venous thromboembolism cases were identified from diagnosis codes (and, for venous thrombosis, heparin prescriptions) and validated by medical-record review; consenting participants gave blood for genotyping, and venous thromboembolism cases were followed for recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/instance/10152894/bin/NIHMS1835943-supplement-Supplemental_Publication_Material.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(rdfs:comment "Eligible participants known to be alive and capable of completing a telephone interview were contacted by phone within 1 to 2 years after the index event and asked to provide a blood sample.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000564> "A population-based case-control study of risk factors for cardiovascular outcomes among members of Group Health (now Kaiser Permanente Washington), an integrated health care system in western Washington State, with case groups of incident myocardial infarction, stroke, venous thromboembolism and atrial fibrillation and a shared control group frequency-matched to the myocardial infarction cases. Myocardial infarction, stroke and venous thromboembolism cases were identified from diagnosis codes (and, for venous thrombosis, heparin prescriptions) and validated by medical-record review; consenting participants gave blood for genotyping, and venous thromboembolism cases were followed for recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/instance/10152894/bin/NIHMS1835943-supplement-Supplemental_Publication_Material.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(rdfs:comment "In short, potential VTE participants were identified from Group Health Cooperative, now Kaiser Permanente Washington, a community-based health care cooperative, using International Classification of Diseases codes and prescriptions for low molecular weight heparin.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000564> "A population-based case-control study of risk factors for cardiovascular outcomes among members of Group Health (now Kaiser Permanente Washington), an integrated health care system in western Washington State, with case groups of incident myocardial infarction, stroke, venous thromboembolism and atrial fibrillation and a shared control group frequency-matched to the myocardial infarction cases. Myocardial infarction, stroke and venous thromboembolism cases were identified from diagnosis codes (and, for venous thrombosis, heparin prescriptions) and validated by medical-record review; consenting participants gave blood for genotyping, and venous thromboembolism cases were followed for recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/instance/10152894/bin/NIHMS1835943-supplement-Supplemental_Publication_Material.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(rdfs:comment "The HVH study is a population-based case-control study that includes individuals who experienced cardiovascular events, including a first VTE, and also included genetic analyses and performed a follow-up of the VTE cases for VTE recurrence.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000564> "A population-based case-control study of risk factors for cardiovascular outcomes among members of Group Health (now Kaiser Permanente Washington), an integrated health care system in western Washington State, with case groups of incident myocardial infarction, stroke, venous thromboembolism and atrial fibrillation and a shared control group frequency-matched to the myocardial infarction cases. Myocardial infarction, stroke and venous thromboembolism cases were identified from diagnosis codes (and, for venous thrombosis, heparin prescriptions) and validated by medical-record review; consenting participants gave blood for genotyping, and venous thromboembolism cases were followed for recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/instance/10152894/bin/NIHMS1835943-supplement-Supplemental_Publication_Material.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001013.v3.p2") Annotation(rdfs:comment "As part of the HVH study, case subjects were identified by searching for ICD-9 codes consistent with MI, stroke, VT, or AF, and medical records were reviewed to confirm the diagnosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000564> "A population-based case-control study of risk factors for cardiovascular outcomes among members of Group Health (now Kaiser Permanente Washington), an integrated health care system in western Washington State, with case groups of incident myocardial infarction, stroke, venous thromboembolism and atrial fibrillation and a shared control group frequency-matched to the myocardial infarction cases. Myocardial infarction, stroke and venous thromboembolism cases were identified from diagnosis codes (and, for venous thrombosis, heparin prescriptions) and validated by medical-record review; consenting participants gave blood for genotyping, and venous thromboembolism cases were followed for recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/instance/10152894/bin/NIHMS1835943-supplement-Supplemental_Publication_Material.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001013.v3.p2") Annotation(rdfs:comment "The Heart and Vascular Health Study (HVH) is a case-control study of risk factors for the development of myocardial infarction (MI), stroke, venous thrombosis (VT), and atrial fibrillation (AF).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000564> "A population-based case-control study of risk factors for cardiovascular outcomes among members of Group Health (now Kaiser Permanente Washington), an integrated health care system in western Washington State, with case groups of incident myocardial infarction, stroke, venous thromboembolism and atrial fibrillation and a shared control group frequency-matched to the myocardial infarction cases. Myocardial infarction, stroke and venous thromboembolism cases were identified from diagnosis codes (and, for venous thrombosis, heparin prescriptions) and validated by medical-record review; consenting participants gave blood for genotyping, and venous thromboembolism cases were followed for recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/instance/10152894/bin/NIHMS1835943-supplement-Supplemental_Publication_Material.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2871387/unicode") Annotation(rdfs:comment "The Heart and Vascular Health Atrial Fibrillation Study (HVH) identified all enrollees of Group Health, a large health plan in Washington State, with a new International Classification of Diseases, 9th revision (ICD-9) code for AF between October 1, 2001 and December 31, 2004.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000564> "A population-based case-control study of risk factors for cardiovascular outcomes among members of Group Health (now Kaiser Permanente Washington), an integrated health care system in western Washington State, with case groups of incident myocardial infarction, stroke, venous thromboembolism and atrial fibrillation and a shared control group frequency-matched to the myocardial infarction cases. Myocardial infarction, stroke and venous thromboembolism cases were identified from diagnosis codes (and, for venous thrombosis, heparin prescriptions) and validated by medical-record review; consenting participants gave blood for genotyping, and venous thromboembolism cases were followed for recurrence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000565> (<http://www.ebi.ac.uk/coho/COHO_0000565>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29803983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12807872/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4302371/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37680562") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(rdfs:comment "Intermountain Health uses one electronic medical record (EMR) system consolidated into a single electronic data warehouse, which allows the capturing and tracking of patient outcomes across outpatient, emergency, and inpatient visits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000565> "A prospective registry and biorepository of Intermountain Healthcare, Utah, begun in 1993, that enrols consenting patients at the cardiac catheterisation laboratories of Intermountain hospitals in Salt Lake City and Ogden, with a blood sample taken at angiography and electronic follow-up for cardiovascular outcomes such as death, myocardial infarction, heart failure and stroke. It was later renamed the INSPIRE biobank registry and now collects samples and data from consenting Intermountain patients with any health condition.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29803983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12807872/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4302371/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(rdfs:comment "Being part of the INSPIRE biobank registry, subjects consented to have a blood sample taken at the time of their angiography.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000565> "A prospective registry and biorepository of Intermountain Healthcare, Utah, begun in 1993, that enrols consenting patients at the cardiac catheterisation laboratories of Intermountain hospitals in Salt Lake City and Ogden, with a blood sample taken at angiography and electronic follow-up for cardiovascular outcomes such as death, myocardial infarction, heart failure and stroke. It was later renamed the INSPIRE biobank registry and now collects samples and data from consenting Intermountain patients with any health condition.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29803983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12807872/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4302371/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(rdfs:comment "Intermountain Health uses one electronic medical record (EMR) system consolidated into a single electronic data warehouse, which allows the capturing and tracking of patient outcomes across outpatient, emergency, and inpatient visits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000565> "A prospective registry and biorepository of Intermountain Healthcare, Utah, begun in 1993, that enrols consenting patients at the cardiac catheterisation laboratories of Intermountain hospitals in Salt Lake City and Ogden, with a blood sample taken at angiography and electronic follow-up for cardiovascular outcomes such as death, myocardial infarction, heart failure and stroke. It was later renamed the INSPIRE biobank registry and now collects samples and data from consenting Intermountain patients with any health condition.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29803983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12807872/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4302371/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(rdfs:comment "The INSPIRE biobank registry began in 1993 (19) and had a total of 19,000 unique subjects enrolled from 1994 to 2012.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000565> "A prospective registry and biorepository of Intermountain Healthcare, Utah, begun in 1993, that enrols consenting patients at the cardiac catheterisation laboratories of Intermountain hospitals in Salt Lake City and Ogden, with a blood sample taken at angiography and electronic follow-up for cardiovascular outcomes such as death, myocardial infarction, heart failure and stroke. It was later renamed the INSPIRE biobank registry and now collects samples and data from consenting Intermountain patients with any health condition.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29803983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12807872/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4302371/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(rdfs:comment "The Intermountain Healthcare subjects enrolled in the INSPIRE biobank registry (formerly known as the Intermountain Heart Collaborative Study) (19) were examined for the impact of EPA and DHA circulating levels unadjusted, adjusted for one another, and fully adjusted for comorbidities, EPA + DHA, and the EPA/DHA ratio on long-term (10-year) MACE.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000565> "A prospective registry and biorepository of Intermountain Healthcare, Utah, begun in 1993, that enrols consenting patients at the cardiac catheterisation laboratories of Intermountain hospitals in Salt Lake City and Ogden, with a blood sample taken at angiography and electronic follow-up for cardiovascular outcomes such as death, myocardial infarction, heart failure and stroke. It was later renamed the INSPIRE biobank registry and now collects samples and data from consenting Intermountain patients with any health condition.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29803983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12807872/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4302371/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12807872/fullTextXML") Annotation(rdfs:comment "Inspire is Intermountain’s active registry for the collection of biological samples, clinical information, laboratory data and genetic information, from consenting patients diagnosed with any healthcare-related conditions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000565> "A prospective registry and biorepository of Intermountain Healthcare, Utah, begun in 1993, that enrols consenting patients at the cardiac catheterisation laboratories of Intermountain hospitals in Salt Lake City and Ogden, with a blood sample taken at angiography and electronic follow-up for cardiovascular outcomes such as death, myocardial infarction, heart failure and stroke. It was later renamed the INSPIRE biobank registry and now collects samples and data from consenting Intermountain patients with any health condition.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29803983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482040/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12807872/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4302371/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4302371/fullTextXML") Annotation(rdfs:comment "IHCS enrolls patients admitted to Intermountain catheterization labs (Intermountain Medical Center: Salt Lake City, UT; LDS Hospital: Salt Lake City, UT; and McKay Dee Hospital, Ogden, UT) [24].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000565> "A prospective registry and biorepository of Intermountain Healthcare, Utah, begun in 1993, that enrols consenting patients at the cardiac catheterisation laboratories of Intermountain hospitals in Salt Lake City and Ogden, with a blood sample taken at angiography and electronic follow-up for cardiovascular outcomes such as death, myocardial infarction, heart failure and stroke. It was later renamed the INSPIRE biobank registry and now collects samples and data from consenting Intermountain patients with any health condition.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000566> (<http://www.ebi.ac.uk/coho/COHO_0000566>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19286855") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8854450/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9387345/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(rdfs:comment "At baseline, 3187 European-ancestry and African American adults aged 45 years or older (35% men; 32% African American; mean age 61±10 years) were recruited from six townships in Johnston County, North Carolina, and completed a clinical examination visit during 1991– 1997.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000566> "A population-based prospective cohort of African American and white civilian, non-institutionalised adults aged 45 years or older living in six townships of Johnston County, North Carolina, sampled regardless of osteoarthritis status, of whom 3,187 were enrolled in 1991-1997 and a further 1,015 in 2003-2004 to enrich the cohort for Black and younger adults, and followed about every five years to estimate the incidence and progression of knee and hip osteoarthritis and later of hand, spine and foot osteoarthritis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19286855") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8854450/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9387345/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(rdfs:comment "JoCo OA was designed to estimate the incidence and progression of knee and hip osteoarthritis among Europeans and African Americans, and the study has expanded to study the hand, lumbar spine, ankles and feet during successive follow-up visits (occurring approximately every 5 years).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000566> "A population-based prospective cohort of African American and white civilian, non-institutionalised adults aged 45 years or older living in six townships of Johnston County, North Carolina, sampled regardless of osteoarthritis status, of whom 3,187 were enrolled in 1991-1997 and a further 1,015 in 2003-2004 to enrich the cohort for Black and younger adults, and followed about every five years to estimate the incidence and progression of knee and hip osteoarthritis and later of hand, spine and foot osteoarthritis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19286855") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8854450/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9387345/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11029301/fullTextXML") Annotation(rdfs:comment "The JoCoOA was a population-based cohort study with up to 30 years of follow-up.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000566> "A population-based prospective cohort of African American and white civilian, non-institutionalised adults aged 45 years or older living in six townships of Johnston County, North Carolina, sampled regardless of osteoarthritis status, of whom 3,187 were enrolled in 1991-1997 and a further 1,015 in 2003-2004 to enrich the cohort for Black and younger adults, and followed about every five years to estimate the incidence and progression of knee and hip osteoarthritis and later of hand, spine and foot osteoarthritis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19286855") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8854450/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9387345/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8854450/fullTextXML") Annotation(rdfs:comment "which were designed to be representative of the Black and White civilian, non-institutionalized adults aged ≥ 45 years residing in Johnston County, regardless of osteoarthritis status (n = 3187); additional participants were enrolled during 2003–2004 (T1*; n = 1015) to enrich the cohort for Black and younger adults.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000566> "A population-based prospective cohort of African American and white civilian, non-institutionalised adults aged 45 years or older living in six townships of Johnston County, North Carolina, sampled regardless of osteoarthritis status, of whom 3,187 were enrolled in 1991-1997 and a further 1,015 in 2003-2004 to enrich the cohort for Black and younger adults, and followed about every five years to estimate the incidence and progression of knee and hip osteoarthritis and later of hand, spine and foot osteoarthritis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000567> (<http://www.ebi.ac.uk/coho/COHO_0000567>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27195708") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33413638") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27195708") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4873263/fullTextXML") Annotation(rdfs:comment "Samples for the discovery analyses were selected from the London Life Sciences Population (LOLIPOP) study, an ongoing population-based cohort of 17,606 South Asian and 7,766 Northern European men and women, aged 35–75 years, recruited from the lists of 58 general practitioners in West London.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000567> "A prospective population-based cohort of about 28,000 Indian Asian (South Asian) and European men and women aged 35 to 75, recruited in 2003-2008 from the lists of 58 general practitioners in West London, UK, with a structured cardiovascular and metabolic assessment and stored blood, to study the excess cardiometabolic risk of South Asians.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27195708") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33413638") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27195708") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4873263/fullTextXML") Annotation(rdfs:comment "The contribution of known genetic variants to the excess in WHR among South Asians compared to Europeans in the LOLIPOP study was quantified by multivariate linear regression.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000567> "A prospective population-based cohort of about 28,000 Indian Asian (South Asian) and European men and women aged 35 to 75, recruited in 2003-2008 from the lists of 58 general practitioners in West London, UK, with a structured cardiovascular and metabolic assessment and stored blood, to study the excess cardiometabolic risk of South Asians.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27195708") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33413638") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33413638") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7789600/") Annotation(rdfs:comment "In 4060 samples of Indian-Asian subjects, anthropometric and serum measures were measured concurrently, and aliquots of whole blood were stored at − 80 °C for extraction of genomic DNA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000567> "A prospective population-based cohort of about 28,000 Indian Asian (South Asian) and European men and women aged 35 to 75, recruited in 2003-2008 from the lists of 58 general practitioners in West London, UK, with a structured cardiovascular and metabolic assessment and stored blood, to study the excess cardiometabolic risk of South Asians.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27195708") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33413638") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33413638") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7789600/fullTextXML") Annotation(rdfs:comment "The London Life Sciences Prospective Population Study (LOLIPOP) is a prospective cohort study of ~ 28000 Indian Asian and European men and women, recruited from the lists of 58 General Practitioners in West London, UK, between 2003 and 2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000567> "A prospective population-based cohort of about 28,000 Indian Asian (South Asian) and European men and women aged 35 to 75, recruited in 2003-2008 from the lists of 58 general practitioners in West London, UK, with a structured cardiovascular and metabolic assessment and stored blood, to study the excess cardiometabolic risk of South Asians.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27195708") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33413638") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4310399/fullTextXML") Annotation(rdfs:comment "Participants are primarily Indian Asians and European whites aged 35 to 75 years, who have been characterized for cardiovascular phenotypes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000567> "A prospective population-based cohort of about 28,000 Indian Asian (South Asian) and European men and women aged 35 to 75, recruited in 2003-2008 from the lists of 58 general practitioners in West London, UK, with a structured cardiovascular and metabolic assessment and stored blood, to study the excess cardiometabolic risk of South Asians.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000568> (<http://www.ebi.ac.uk/coho/COHO_0000568>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40010489") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40010489") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40010489+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Comprehensive Profiling of Genetic and Nongenetic Factors that Influence Skin Traits in Asian Women from 4 Countries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000568> "A cohort of 2,762 women from Korea, Vietnam, Thailand and Indonesia, established by Korean researchers with measurements of 26 skin traits, skin-related surveys and whole-genome sequencing-based genotyping, to study the genetic and non-genetic determinants of skin traits and their variation across Asian countries.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40010489") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40010489") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40010489+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Estimation of the quantitative contribution from whole-genome sequencing-based genotyping, combined with the survey findings, led to a comprehensive documentation of skin trait determination and its variation by country.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000568> "A cohort of 2,762 women from Korea, Vietnam, Thailand and Indonesia, established by Korean researchers with measurements of 26 skin traits, skin-related surveys and whole-genome sequencing-based genotyping, to study the genetic and non-genetic determinants of skin traits and their variation across Asian countries.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40010489") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40010489") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40010489+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In this study, we established the ASTAGR (Asian Skin Traits and Genetics Research) cohort, comprising 2762 female participants from 4 Asian countries (Korea, Vietnam, Thailand, and Indonesia).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000568> "A cohort of 2,762 women from Korea, Vietnam, Thailand and Indonesia, established by Korean researchers with measurements of 26 skin traits, skin-related surveys and whole-genome sequencing-based genotyping, to study the genetic and non-genetic determinants of skin traits and their variation across Asian countries.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40010489") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40010489") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40010489+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We documented 26 skin traits and conducted extensive skin-related surveys among the participants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000568> "A cohort of 2,762 women from Korea, Vietnam, Thailand and Indonesia, established by Korean researchers with measurements of 26 skin traits, skin-related surveys and whole-genome sequencing-based genotyping, to study the genetic and non-genetic determinants of skin traits and their variation across Asian countries.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000569> (<http://www.ebi.ac.uk/coho/COHO_0000569>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3005543/unicode") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3913564/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3017062/fullTextXML") Annotation(rdfs:comment "During the in-person interview, information was collected on dietary intake, physical activity, medical history and drug use, demographic factors, smoking, reproductive history (for women), and family history of cancer and colorectal polyps.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000569> "A population-based case-control study of colon cancer, with cases diagnosed in 1991–1994 and age- and sex-matched controls recruited from the Kaiser Permanente Medical Care Program of Northern California, Utah and the Twin Cities of Minnesota, extended in 1997–2001 by a parallel study of rectal cancer in Utah and Kaiser Permanente, collecting diet, physical activity and other lifestyle data to study their relation to colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3005543/unicode") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3913564/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3005543/unicode") Annotation(rdfs:comment "Cases and controls were recruited from the Kaiser Permanente Medical Care Program of Northern California, an eight-county area in Utah, and the metropolitan Twin Cities of Minnesota.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000569> "A population-based case-control study of colon cancer, with cases diagnosed in 1991–1994 and age- and sex-matched controls recruited from the Kaiser Permanente Medical Care Program of Northern California, Utah and the Twin Cities of Minnesota, extended in 1997–2001 by a parallel study of rectal cancer in Utah and Kaiser Permanente, collecting diet, physical activity and other lifestyle data to study their relation to colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3005543/unicode") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3913564/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3005543/unicode") Annotation(rdfs:comment "Controls were matched to cases by 5-year age groups and sex, and came from membership lists (Kaiser), driver license lists (Utah up to age 65, Minnesota), Health Care Financing Administration lists (Utah over age 65), or state identification lists (Minnesota).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000569> "A population-based case-control study of colon cancer, with cases diagnosed in 1991–1994 and age- and sex-matched controls recruited from the Kaiser Permanente Medical Care Program of Northern California, Utah and the Twin Cities of Minnesota, extended in 1997–2001 by a parallel study of rectal cancer in Utah and Kaiser Permanente, collecting diet, physical activity and other lifestyle data to study their relation to colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3005543/unicode") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3913564/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3913564/unicode") Annotation(rdfs:comment "Colon cancer cases were diagnosed between 1991 and 1994, and rectal cancer cases between 1997 and 2001, respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000569> "A population-based case-control study of colon cancer, with cases diagnosed in 1991–1994 and age- and sex-matched controls recruited from the Kaiser Permanente Medical Care Program of Northern California, Utah and the Twin Cities of Minnesota, extended in 1997–2001 by a parallel study of rectal cancer in Utah and Kaiser Permanente, collecting diet, physical activity and other lifestyle data to study their relation to colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3005543/unicode") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3913564/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3913564/unicode") Annotation(rdfs:comment "The colon and rectal cancer populations were recruited separately at different time periods, but are collectively referred to in this manuscript as the DALS study as they were parallel study designs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000569> "A population-based case-control study of colon cancer, with cases diagnosed in 1991–1994 and age- and sex-matched controls recruited from the Kaiser Permanente Medical Care Program of Northern California, Utah and the Twin Cities of Minnesota, extended in 1997–2001 by a parallel study of rectal cancer in Utah and Kaiser Permanente, collecting diet, physical activity and other lifestyle data to study their relation to colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3005543/unicode") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3913564/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3913564/unicode") Annotation(rdfs:comment "We genotyped candidate polymorphisms and tagSNPs in PTGS1 (COX-1) and PTGS2 (COX-2) in a population-based case-control study (Diet, Activity and Lifestyle Study, DALS) of colon cancer (n=1470 cases/1837 controls) and rectal cancer (n=583/775), and independently among cases and controls from the Colon Cancer Family Registry (CCFR; colon n= 959/1535, rectal n= 505/839).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000569> "A population-based case-control study of colon cancer, with cases diagnosed in 1991–1994 and age- and sex-matched controls recruited from the Kaiser Permanente Medical Care Program of Northern California, Utah and the Twin Cities of Minnesota, extended in 1997–2001 by a parallel study of rectal cancer in Utah and Kaiser Permanente, collecting diet, physical activity and other lifestyle data to study their relation to colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000570> (<http://www.ebi.ac.uk/coho/COHO_0000570>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11129752") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40981293") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11129752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11129752+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "1,453 persons (age-range 20-102 years; 91.6% of the eligible) selected from city registry of Greve in Chianti and Bagno a Ripoli (Tuscany, Italy), using a multistage sampling method.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000570> "A prospective population-based study of aging of 1,453 residents aged 20 to 102, mostly older people, selected by multistage sampling from the registries of Greve in Chianti and Bagno a Ripoli in Tuscany, Italy, examined at baseline in 1998-2000 and followed up to identify risk factors for the loss of walking ability and other age-related decline.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11129752") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40981293") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11129752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11129752+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A population-based study of persons living in the Chianti geographic area (Tuscany, Italy).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000570> "A prospective population-based study of aging of 1,453 residents aged 20 to 102, mostly older people, selected by multistage sampling from the registries of Greve in Chianti and Bagno a Ripoli in Tuscany, Italy, examined at baseline in 1998-2000 and followed up to identify risk factors for the loss of walking ability and other age-related decline.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11129752") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40981293") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11129752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A11129752+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Data collected in InCHIANTI will be used to identify the main risk factors that influence loss of the ability to walk in older persons, to define physiologic subsystems that are critical for walking, to select the best measures of their integrity, and to establish critical ranges in these measures that are compatible with \"normal\" walking ability.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000570> "A prospective population-based study of aging of 1,453 residents aged 20 to 102, mostly older people, selected by multistage sampling from the registries of Greve in Chianti and Bagno a Ripoli in Tuscany, Italy, examined at baseline in 1998-2000 and followed up to identify risk factors for the loss of walking ability and other age-related decline.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11129752") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40981293") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40981293") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12452345/fullTextXML") Annotation(rdfs:comment "In brief, a total of 1453 participants spanning various age groups were recruited at baseline in 1998–2000 via two-stage sampling methods and then followed longitudinally.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000570> "A prospective population-based study of aging of 1,453 residents aged 20 to 102, mostly older people, selected by multistage sampling from the registries of Greve in Chianti and Bagno a Ripoli in Tuscany, Italy, examined at baseline in 1998-2000 and followed up to identify risk factors for the loss of walking ability and other age-related decline.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11129752") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40981293") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40981293") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12452345/fullTextXML") Annotation(rdfs:comment "The InCHIANTI (“Invecchiare in Chianti”) study is a prospective study of aging conducted in two municipalities (Bagno a Ripoli and Greve in Chianti) in Tuscany, Italy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000570> "A prospective population-based study of aging of 1,453 residents aged 20 to 102, mostly older people, selected by multistage sampling from the registries of Greve in Chianti and Bagno a Ripoli in Tuscany, Italy, examined at baseline in 1998-2000 and followed up to identify risk factors for the loss of walking ability and other age-related decline.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11129752") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40981293") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3991146/fullTextXML") Annotation(rdfs:comment "In 1998–1999, 1,154 men and women aged 65 and older were recruited from population-based registries in two Italian towns (Bagno a Ripoli in Tuscany and Greve in Chianti) to study subsystems affecting walking ability (27).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000570> "A prospective population-based study of aging of 1,453 residents aged 20 to 102, mostly older people, selected by multistage sampling from the registries of Greve in Chianti and Bagno a Ripoli in Tuscany, Italy, examined at baseline in 1998-2000 and followed up to identify risk factors for the loss of walking ability and other age-related decline.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000571> (<http://www.ebi.ac.uk/coho/COHO_0000571>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17696755") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32963210") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32963210") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8593573/fullTextXML") Annotation(rdfs:comment "At the time of the baseline survey, from 2005–2014, the participants completed questionnaires and provided peripheral blood samples.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000571> "A Japanese multi-institutional genome cohort, launched in 2005, of 92,610 adults aged 35–69 years from 14 study regions in 12 prefectures (respondents to study announcements, people attending local-government health checkups or health checkup centres, and first-visit patients at a cancer hospital), who gave baseline questionnaire data and blood samples in 2005–2014 and are followed until 2025, to examine gene–environment interactions in lifestyle-related diseases, mainly cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17696755") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32963210") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32963210") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8593573/fullTextXML") Annotation(rdfs:comment "The aims of this large-scale, population-based, long-term prospective, genome-cohort study are to examine gene–environment interactions in lifestyle-related diseases, especially cancers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000571> "A Japanese multi-institutional genome cohort, launched in 2005, of 92,610 adults aged 35–69 years from 14 study regions in 12 prefectures (respondents to study announcements, people attending local-government health checkups or health checkup centres, and first-visit patients at a cancer hospital), who gave baseline questionnaire data and blood samples in 2005–2014 and are followed until 2025, to examine gene–environment interactions in lifestyle-related diseases, mainly cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17696755") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32963210") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32963210") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8593573/fullTextXML") Annotation(rdfs:comment "The secondary survey, which is the same as the baseline survey, is scheduled for approximately 5 years after baseline enrollment, and participants will be followed until 2025.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000571> "A Japanese multi-institutional genome cohort, launched in 2005, of 92,610 adults aged 35–69 years from 14 study regions in 12 prefectures (respondents to study announcements, people attending local-government health checkups or health checkup centres, and first-visit patients at a cancer hospital), who gave baseline questionnaire data and blood samples in 2005–2014 and are followed until 2025, to examine gene–environment interactions in lifestyle-related diseases, mainly cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17696755") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32963210") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32963210") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32963210+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Japan Multi-institutional Collaborative Cohort (J-MICC) study was launched in 2005 to examine gene-environment interactions in lifestyle-related diseases, including cancers, among the Japanese.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000571> "A Japanese multi-institutional genome cohort, launched in 2005, of 92,610 adults aged 35–69 years from 14 study regions in 12 prefectures (respondents to study announcements, people attending local-government health checkups or health checkup centres, and first-visit patients at a cancer hospital), who gave baseline questionnaire data and blood samples in 2005–2014 and are followed until 2025, to examine gene–environment interactions in lifestyle-related diseases, mainly cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17696755") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32963210") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32963210") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32963210+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The baseline survey included 92,610 adults (mean age: 55.2 [standard deviation, 9.4] years, 44.1% men) from 14 study regions in 12 prefectures.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000571> "A Japanese multi-institutional genome cohort, launched in 2005, of 92,610 adults aged 35–69 years from 14 study regions in 12 prefectures (respondents to study announcements, people attending local-government health checkups or health checkup centres, and first-visit patients at a cancer hospital), who gave baseline questionnaire data and blood samples in 2005–2014 and are followed until 2025, to examine gene–environment interactions in lifestyle-related diseases, mainly cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17696755") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32963210") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32963210") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32963210+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The participants of the J-MICC Study were individuals aged 35 to 69 years enrolled from respondents to study announcements in specified regions, inhabitants attending health checkup examinations provided by local governments, visitors at health checkup centers, and first-visit patients at a cancer hospital in Japan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000571> "A Japanese multi-institutional genome cohort, launched in 2005, of 92,610 adults aged 35–69 years from 14 study regions in 12 prefectures (respondents to study announcements, people attending local-government health checkups or health checkup centres, and first-visit patients at a cancer hospital), who gave baseline questionnaire data and blood samples in 2005–2014 and are followed until 2025, to examine gene–environment interactions in lifestyle-related diseases, mainly cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000572> (<http://www.ebi.ac.uk/coho/COHO_0000572>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25429525") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(rdfs:comment "By means of the NBCS and NBS questionnaire(s), information on, among others, lifestyle, ethnicity, medical history, and family history, was collected from the patients and controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000572> "A case-control study of urinary bladder cancer run from Radboud University Medical Center in Nijmegen, the Netherlands, in which patients diagnosed from 1995 to 2010 under the age of 76 and living in the catchment area of seven hospitals in the east of the country were identified through the Netherlands Cancer Registry and invited in batches, with controls drawn from the Nijmegen Biomedical Study, to study genetic and lifestyle risk factors and outcomes of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25429525") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(rdfs:comment "Controls in the NBCS were individuals recruited for the Nijmegen Biomedical Study (NBS), a population-based survey that aimed to provide a generic reference group for case–control studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000572> "A case-control study of urinary bladder cancer run from Radboud University Medical Center in Nijmegen, the Netherlands, in which patients diagnosed from 1995 to 2010 under the age of 76 and living in the catchment area of seven hospitals in the east of the country were identified through the Netherlands Cancer Registry and invited in batches, with controls drawn from the Nijmegen Biomedical Study, to study genetic and lifestyle risk factors and outcomes of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25429525") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(rdfs:comment "In this study, we analysed data of the Nijmegen Bladder Cancer Study (NBCS), one of the largest case–control studies for UBC worldwide, as to gain better insights into the role of recurrent infections of the (lower) urinary tract as a risk factor for UBC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000572> "A case-control study of urinary bladder cancer run from Radboud University Medical Center in Nijmegen, the Netherlands, in which patients diagnosed from 1995 to 2010 under the age of 76 and living in the catchment area of seven hospitals in the east of the country were identified through the Netherlands Cancer Registry and invited in batches, with controls drawn from the Nijmegen Biomedical Study, to study genetic and lifestyle risk factors and outcomes of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25429525") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(rdfs:comment "Patients diagnosed in the periods 1995–2006, 2006–2007, 2007–2009, and 2009–2010 under the age of 76 years were batch-wise invited for participation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000572> "A case-control study of urinary bladder cancer run from Radboud University Medical Center in Nijmegen, the Netherlands, in which patients diagnosed from 1995 to 2010 under the age of 76 and living in the catchment area of seven hospitals in the east of the country were identified through the Netherlands Cancer Registry and invited in batches, with controls drawn from the Nijmegen Biomedical Study, to study genetic and lifestyle risk factors and outcomes of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25429525") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(rdfs:comment "Within the framework of the NBCS, UBC patients living in the catchment area of seven hospitals in the eastern part of the country were identified through the Netherlands Cancer Registry (NCR) held by the Comprehensive Cancer Centre the Netherlands (IKNL) (Kiemeney et al, 2008).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000572> "A case-control study of urinary bladder cancer run from Radboud University Medical Center in Nijmegen, the Netherlands, in which patients diagnosed from 1995 to 2010 under the age of 76 and living in the catchment area of seven hospitals in the east of the country were identified through the Netherlands Cancer Registry and invited in batches, with controls drawn from the Nijmegen Biomedical Study, to study genetic and lifestyle risk factors and outcomes of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11181778/fullTextXML") Annotation(rdfs:comment "performing analyses in the NBCS cohort, the currently largest prognostic cohort on NMIBC outcome") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000572> "A case-control study of urinary bladder cancer run from Radboud University Medical Center in Nijmegen, the Netherlands, in which patients diagnosed from 1995 to 2010 under the age of 76 and living in the catchment area of seven hospitals in the east of the country were identified through the Netherlands Cancer Registry and invited in batches, with controls drawn from the Nijmegen Biomedical Study, to study genetic and lifestyle risk factors and outcomes of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5862341/fullTextXML") Annotation(rdfs:comment "The combined NBS-NBCS served as the Dutch discovery population in previous UBC genome-wide association studies (14–18).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000572> "A case-control study of urinary bladder cancer run from Radboud University Medical Center in Nijmegen, the Netherlands, in which patients diagnosed from 1995 to 2010 under the age of 76 and living in the catchment area of seven hospitals in the east of the country were identified through the Netherlands Cancer Registry and invited in batches, with controls drawn from the Nijmegen Biomedical Study, to study genetic and lifestyle risk factors and outcomes of bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000573> (<http://www.ebi.ac.uk/coho/COHO_0000573>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/supplementaryFiles") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5065698/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC4204770") Annotation(rdfs:comment "Norwegian Breast Cancer Study (NBCS) Norway 70 22 0 22") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000573> "A Norwegian breast cancer case-control study in the Breast Cancer Association Consortium, whose cases are incident breast cancers from Ullevål University Hospital (1990–1994), the Norwegian Radium Hospital (1975–1986 and 1995–1998) and Haukeland University Hospital (1992–2001) and whose controls are women from Tromsø and Bergen who attended the Norwegian Breast Cancer Screening Program. It also includes a sub-study of women attending the national mammography screening programme in 2002–2007 who gave blood and breast biopsies with mammographic density measurements, and its normal and tumour breast tissue samples are used in gene expression studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/supplementaryFiles") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5065698/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/supplementaryFiles") Annotation(rdfs:comment "Incidence cases from three different hospitals: Ullevål Univ. Hospital 1990-94, Norwegian Radium Hospital 1975-1986 and 1995-1998, Haukeland Univ. Hospital 1992-2001.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000573> "A Norwegian breast cancer case-control study in the Breast Cancer Association Consortium, whose cases are incident breast cancers from Ullevål University Hospital (1990–1994), the Norwegian Radium Hospital (1975–1986 and 1995–1998) and Haukeland University Hospital (1992–2001) and whose controls are women from Tromsø and Bergen who attended the Norwegian Breast Cancer Screening Program. It also includes a sub-study of women attending the national mammography screening programme in 2002–2007 who gave blood and breast biopsies with mammographic density measurements, and its normal and tumour breast tissue samples are used in gene expression studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/supplementaryFiles") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5065698/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/supplementaryFiles") Annotation(rdfs:comment "Women residing in Tromsø and Bergen who attended the Norwegian Breast Cancer Screening Program.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000573> "A Norwegian breast cancer case-control study in the Breast Cancer Association Consortium, whose cases are incident breast cancers from Ullevål University Hospital (1990–1994), the Norwegian Radium Hospital (1975–1986 and 1995–1998) and Haukeland University Hospital (1992–2001) and whose controls are women from Tromsø and Bergen who attended the Norwegian Breast Cancer Screening Program. It also includes a sub-study of women attending the national mammography screening programme in 2002–2007 who gave blood and breast biopsies with mammographic density measurements, and its normal and tumour breast tissue samples are used in gene expression studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/supplementaryFiles") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5065698/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5065698/fullTextXML") Annotation(rdfs:comment "To identify potential target gene(s), we examined the associations of the three lead SNPs with expression levels of genes located within 1 Mb in three different studies: (1) 116 normal breast samples and 241 breast tumors from the Norwegian Breast Cancer Study (NBCS),8 (2) 93 normal and 765 breast cancer tissues from the TCGA study (germline genotype data from Affymetrix SNP 6 array were obtained from TCGA dbGAP data portal9), and (3) 183 normal breast samples from the Genotype-Tissue Expression (GTEx) project.10") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000573> "A Norwegian breast cancer case-control study in the Breast Cancer Association Consortium, whose cases are incident breast cancers from Ullevål University Hospital (1990–1994), the Norwegian Radium Hospital (1975–1986 and 1995–1998) and Haukeland University Hospital (1992–2001) and whose controls are women from Tromsø and Bergen who attended the Norwegian Breast Cancer Screening Program. It also includes a sub-study of women attending the national mammography screening programme in 2002–2007 who gave blood and breast biopsies with mammographic density measurements, and its normal and tumour breast tissue samples are used in gene expression studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/supplementaryFiles") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5065698/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "Blood was drawn from 121 healthy individuals (age 22-75) and 65 breast cancer patients (age 38-84) at the time of inclusion and information about mammographic density, pathological parameters of the tumors, hormone use and parity are available.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000573> "A Norwegian breast cancer case-control study in the Breast Cancer Association Consortium, whose cases are incident breast cancers from Ullevål University Hospital (1990–1994), the Norwegian Radium Hospital (1975–1986 and 1995–1998) and Haukeland University Hospital (1992–2001) and whose controls are women from Tromsø and Bergen who attended the Norwegian Breast Cancer Screening Program. It also includes a sub-study of women attending the national mammography screening programme in 2002–2007 who gave blood and breast biopsies with mammographic density measurements, and its normal and tumour breast tissue samples are used in gene expression studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/supplementaryFiles") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5065698/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "This NBCS sub-study involves women attending the Norwegian national mammography screening program from 2002 to 2007 and biopsies were taken from breasts with varying mammographic density and newly diagnosed breast cancers (ethical approval S-02036).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000573> "A Norwegian breast cancer case-control study in the Breast Cancer Association Consortium, whose cases are incident breast cancers from Ullevål University Hospital (1990–1994), the Norwegian Radium Hospital (1975–1986 and 1995–1998) and Haukeland University Hospital (1992–2001) and whose controls are women from Tromsø and Bergen who attended the Norwegian Breast Cancer Screening Program. It also includes a sub-study of women attending the national mammography screening programme in 2002–2007 who gave blood and breast biopsies with mammographic density measurements, and its normal and tumour breast tissue samples are used in gene expression studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000574> (<http://www.ebi.ac.uk/coho/COHO_0000574>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22933644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22933644") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22933644+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "At baseline, besides demographic items and general medical history, information about standard pigmentary characteristics (including hair and eye colour, freckling tendency, tanning ability and propensity to sunburn), past and recent history of sun exposure and sunburns, sun protection behaviours, use of tanning beds and history of skin cancer was collected by self-completed questionnaire.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000574> "A population-based cohort of 43,794 men and women aged 40–69 randomly sampled from the population of Queensland, Australia, in 2011, with baseline questionnaires on pigmentation, sun exposure, sun protection and skin cancer history and linkage to national health insurance, cancer registry and pathology records, to study the development of skin cancer and melanoma in the population with the highest reported incidence in the world.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22933644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22933644") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22933644+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Participants have given their consent for data linkage to the universal national health insurance scheme and for linkage to cancer registries and pathology databases, thus ensuring complete ascertainment of all future skin cancer and melanoma occurrences and medical treatments and other cancer events.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000574> "A population-based cohort of 43,794 men and women aged 40–69 randomly sampled from the population of Queensland, Australia, in 2011, with baseline questionnaires on pigmentation, sun exposure, sun protection and skin cancer history and linkage to national health insurance, cancer registry and pathology records, to study the development of skin cancer and melanoma in the population with the highest reported incidence in the world.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22933644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22933644") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22933644+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The QSkin Sun and Health Study comprises a cohort of 43 794 men and women aged 40-69 years randomly sampled from the population of Queensland, Australia in 2011.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000574> "A population-based cohort of 43,794 men and women aged 40–69 randomly sampled from the population of Queensland, Australia, in 2011, with baseline questionnaires on pigmentation, sun exposure, sun protection and skin cancer history and linkage to national health insurance, cancer registry and pathology records, to study the development of skin cancer and melanoma in the population with the highest reported incidence in the world.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22933644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22933644") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22933644+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The cohort was established to study the development of skin cancer and melanoma in the population with the highest reported incidence of these diseases in the world.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000574> "A population-based cohort of 43,794 men and women aged 40–69 randomly sampled from the population of Queensland, Australia, in 2011, with baseline questionnaires on pigmentation, sun exposure, sun protection and skin cancer history and linkage to national health insurance, cancer registry and pathology records, to study the development of skin cancer and melanoma in the population with the highest reported incidence in the world.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000575> (<http://www.ebi.ac.uk/coho/COHO_0000575>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20305777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20305777") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2841168/fullTextXML") Annotation(rdfs:comment "Case samples of GWAS for the Japanese population were obtained from several medical institutes in Japan, as previously described [5], [7].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000575> "A Japanese knee osteoarthritis case-control collection assembled at the RIKEN Center for Genomic Medicine, of about 900 symptomatic knee osteoarthritis cases diagnosed by orthopaedic surgeons from clinical and radiographic examination at several Japanese medical institutes and about 3,400 controls from BioBank Japan and Osaka volunteers, genotyped genome-wide to find knee osteoarthritis susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20305777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20305777") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2841168/fullTextXML") Annotation(rdfs:comment "Knee OA was diagnosed on the basis of clinical and radiographic findings using previously described criteria [5], [7].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000575> "A Japanese knee osteoarthritis case-control collection assembled at the RIKEN Center for Genomic Medicine, of about 900 symptomatic knee osteoarthritis cases diagnosed by orthopaedic surgeons from clinical and radiographic examination at several Japanese medical institutes and about 3,400 controls from BioBank Japan and Osaka volunteers, genotyped genome-wide to find knee osteoarthritis susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20305777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20305777") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2841168/fullTextXML") Annotation(rdfs:comment "The control groups consisted of 3,396 individuals that were registered in the Leading Project for Personalized Medicine in the Ministry of Education, Culture, Sports, Science and Technology, Japan as the subjects with diseases unrelated to OA and the volunteers in the Osaka-Midosuji Rotary Club, Osaka, Japan [8].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000575> "A Japanese knee osteoarthritis case-control collection assembled at the RIKEN Center for Genomic Medicine, of about 900 symptomatic knee osteoarthritis cases diagnosed by orthopaedic surgeons from clinical and radiographic examination at several Japanese medical institutes and about 3,400 controls from BioBank Japan and Osaka volunteers, genotyped genome-wide to find knee osteoarthritis susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20305777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20305777") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2841168/fullTextXML") Annotation(rdfs:comment "This research project was approved by the ethical committees at Center for Genomic Medicine (formerly, SNP Research Center), RIKEN and the participating institutions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000575> "A Japanese knee osteoarthritis case-control collection assembled at the RIKEN Center for Genomic Medicine, of about 900 symptomatic knee osteoarthritis cases diagnosed by orthopaedic surgeons from clinical and radiographic examination at several Japanese medical institutes and about 3,400 controls from BioBank Japan and Osaka volunteers, genotyped genome-wide to find knee osteoarthritis susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20305777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20305777") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2841168/fullTextXML") Annotation(rdfs:comment "Through a genome-wide association study and a replication using a total of ∼4,800 Japanese subjects, we identified two single nucleotide polymorphisms (SNPs) (rs7775228 and rs10947262) associated with susceptibility to knee OA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000575> "A Japanese knee osteoarthritis case-control collection assembled at the RIKEN Center for Genomic Medicine, of about 900 symptomatic knee osteoarthritis cases diagnosed by orthopaedic surgeons from clinical and radiographic examination at several Japanese medical institutes and about 3,400 controls from BioBank Japan and Osaka volunteers, genotyped genome-wide to find knee osteoarthritis susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20305777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(rdfs:comment "The Japanese cohort of knee osteoarthritis GWAS (disease cohort) consists of 900 cases and 3,400 controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000575> "A Japanese knee osteoarthritis case-control collection assembled at the RIKEN Center for Genomic Medicine, of about 900 symptomatic knee osteoarthritis cases diagnosed by orthopaedic surgeons from clinical and radiographic examination at several Japanese medical institutes and about 3,400 controls from BioBank Japan and Osaka volunteers, genotyped genome-wide to find knee osteoarthritis susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20305777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(rdfs:comment "The cases were all symptomatic osteoarthritis. They were diagnosed and recruited by expert orthopedic surgeons based on clinical and radiographic examination.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000575> "A Japanese knee osteoarthritis case-control collection assembled at the RIKEN Center for Genomic Medicine, of about 900 symptomatic knee osteoarthritis cases diagnosed by orthopaedic surgeons from clinical and radiographic examination at several Japanese medical institutes and about 3,400 controls from BioBank Japan and Osaka volunteers, genotyped genome-wide to find knee osteoarthritis susceptibility loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000576> (<http://www.ebi.ac.uk/coho/COHO_0000576>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26914831") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35740506") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26914831") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26914831+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A total of 219 RCC patients were recruited to this pharmacogenetic study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000576> "A Japanese pharmacogenetic cohort of 219 patients with metastatic renal cell carcinoma treated with sunitinib, recruited from 15 Japanese medical institutes with data collected at the laboratory for pharmacogenomics of the RIKEN Center for Integrative Medical Sciences, to study germline genetic variants related to sunitinib toxicity and efficacy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26914831") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35740506") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26914831") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26914831+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This study is to investigate the association of a functional germline variant on ABCG2 that affects the pharmacokinetics of sunitinib with sunitinib-induced toxicity of RCC patients in the Japanese population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000576> "A Japanese pharmacogenetic cohort of 219 patients with metastatic renal cell carcinoma treated with sunitinib, recruited from 15 Japanese medical institutes with data collected at the laboratory for pharmacogenomics of the RIKEN Center for Integrative Medical Sciences, to study germline genetic variants related to sunitinib toxicity and efficacy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26914831") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35740506") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35740506") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9220885/fullTextXML") Annotation(rdfs:comment "All patient data were collected at the Centre for Integrative Medical Sciences at the laboratory for pharmacogenomics of the research institution RIKEN, in Tokyo [23].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000576> "A Japanese pharmacogenetic cohort of 219 patients with metastatic renal cell carcinoma treated with sunitinib, recruited from 15 Japanese medical institutes with data collected at the laboratory for pharmacogenomics of the RIKEN Center for Integrative Medical Sciences, to study germline genetic variants related to sunitinib toxicity and efficacy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26914831") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35740506") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35740506") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9220885/fullTextXML") Annotation(rdfs:comment "For the RIKEN cohort, a total of 219 mRCC patients treated with sunitinib were recruited from 15 Japanese medical institutes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000576> "A Japanese pharmacogenetic cohort of 219 patients with metastatic renal cell carcinoma treated with sunitinib, recruited from 15 Japanese medical institutes with data collected at the laboratory for pharmacogenomics of the RIKEN Center for Integrative Medical Sciences, to study germline genetic variants related to sunitinib toxicity and efficacy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26914831") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35740506") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35740506") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9220885/fullTextXML") Annotation(rdfs:comment "Here, we report the results of the largest meta-GWAS for sunitinib with the aim to identify germline genetic variants that associate with sunitinib efficacy in a cohort of mRCC patients as recruited by the EuroTARGET consortium, and a cohort available from the RIKEN Centre in Japan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000576> "A Japanese pharmacogenetic cohort of 219 patients with metastatic renal cell carcinoma treated with sunitinib, recruited from 15 Japanese medical institutes with data collected at the laboratory for pharmacogenomics of the RIKEN Center for Integrative Medical Sciences, to study germline genetic variants related to sunitinib toxicity and efficacy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000577> (<http://www.ebi.ac.uk/coho/COHO_0000577>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42319504") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42319504") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13282369/fullTextXML") Annotation(rdfs:comment "Date of death was obtained through linkage of SMC to the Swedish Registry of Causes of Death.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000577> "A population-based prospective cohort of women born 1914–1948 living in Uppsala and Västmanland counties in central Sweden, established in 1987–1990 among the 90,303 women invited to mammography screening who completed a food frequency questionnaire, re-surveyed in 1997 and followed through linkage to Swedish national registers to study diet, lifestyle and chronic disease, notably cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42319504") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42319504") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13282369/fullTextXML") Annotation(rdfs:comment "In the late autumn of 1997, 56,030 participants still alive and residing in the area were sent an extended questionnaire on sociodemographic and lifestyle factors, including a 96-item FFQ.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000577> "A population-based prospective cohort of women born 1914–1948 living in Uppsala and Västmanland counties in central Sweden, established in 1987–1990 among the 90,303 women invited to mammography screening who completed a food frequency questionnaire, re-surveyed in 1997 and followed through linkage to Swedish national registers to study diet, lifestyle and chronic disease, notably cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42319504") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42319504") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13282369/fullTextXML") Annotation(rdfs:comment "Information about histologically confirmed incident breast cancer cases was obtained through linkage of SMC to the Swedish Cancer Register, with essentially complete case ascertainment [23].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000577> "A population-based prospective cohort of women born 1914–1948 living in Uppsala and Västmanland counties in central Sweden, established in 1987–1990 among the 90,303 women invited to mammography screening who completed a food frequency questionnaire, re-surveyed in 1997 and followed through linkage to Swedish national registers to study diet, lifestyle and chronic disease, notably cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42319504") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42319504") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13282369/fullTextXML") Annotation(rdfs:comment "The Swedish Mammography Cohort (SMC) [17] was established in 1987–1990 when 90,303 women born between 1914–48 and living in central Sweden (Uppsala or Västmanland counties) were invited to participate in a mammography screening program and to complete a food frequency questionnaire (FFQ) (74% response rate).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000577> "A population-based prospective cohort of women born 1914–1948 living in Uppsala and Västmanland counties in central Sweden, established in 1987–1990 among the 90,303 women invited to mammography screening who completed a food frequency questionnaire, re-surveyed in 1997 and followed through linkage to Swedish national registers to study diet, lifestyle and chronic disease, notably cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42319504") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11663681/fullTextXML") Annotation(rdfs:comment "The study population consists of female participants from the Swedish Mammography Cohort (SMC) and male participants from the Cohort of Swedish Men (COSM), both of which are population–based prospective cohort studies in Central Sweden and part of the national research infrastructure SIMPLER (Swedish Infrastructure for Medical Population-based Life-course Environmental Research).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000577> "A population-based prospective cohort of women born 1914–1948 living in Uppsala and Västmanland counties in central Sweden, established in 1987–1990 among the 90,303 women invited to mammography screening who completed a food frequency questionnaire, re-surveyed in 1997 and followed through linkage to Swedish national registers to study diet, lifestyle and chronic disease, notably cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42319504") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.maelstrom-research.org/study/smc") Annotation(rdfs:comment "Extensive questionnaire-based data on diet and other lifestyle factors enables studies of relevance for primary and secondary prevention of cancer (common and rare types), cardiovascular diseases, type 2 diabetes, osteoporosis, neurodegenerative diseases, age-related cataract, rheumatoid arthritis, lower urinary tract symptoms, chronic obstructive pulmonary disease, obesity etc.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000577> "A population-based prospective cohort of women born 1914–1948 living in Uppsala and Västmanland counties in central Sweden, established in 1987–1990 among the 90,303 women invited to mammography screening who completed a food frequency questionnaire, re-surveyed in 1997 and followed through linkage to Swedish national registers to study diet, lifestyle and chronic disease, notably cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42319504") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.maelstrom-research.org/study/smc") Annotation(rdfs:comment "The general aim of the study is to assess a wide range of modifiable lifestyle factors (diet, dietary supplements, physical activity, smoking, alcohol, body weight and other anthropometric measures, etc.) and genetic factors in a large population-based longitudinal cohort of Swedish middle-aged and elderly women.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000577> "A population-based prospective cohort of women born 1914–1948 living in Uppsala and Västmanland counties in central Sweden, established in 1987–1990 among the 90,303 women invited to mammography screening who completed a food frequency questionnaire, re-surveyed in 1997 and followed through linkage to Swedish national registers to study diet, lifestyle and chronic disease, notably cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000578> (<http://www.ebi.ac.uk/coho/COHO_0000578>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25733578") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25733578") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC4521127") Annotation(rdfs:comment "Supported by the National Cancer Institute, we launched the Shanghai Men’s Health Study (SMHS), a population-based cohort study, in 2002 for a comprehen- sive and long-term investigation of NCD aetiology and progression.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000578> "A population-based prospective cohort of 61,480 men aged 40–74 living in urban Shanghai, recruited from 2002 with detailed lifestyle, dietary and medical data and blood, urine and DNA samples, and followed by in-person surveys every 3–4 years and linkage with cancer and vital statistics registries, to study lifestyle, environmental and genetic contributions to cancer and other non-communicable diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25733578") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25733578") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25733578+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "At baseline, trained interviewers collected detailed information on personal and dietary habits, occupational/medical history and physical activity, and took anthropometric measurements (response rate: 74%).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000578> "A population-based prospective cohort of 61,480 men aged 40–74 living in urban Shanghai, recruited from 2002 with detailed lifestyle, dietary and medical data and blood, urine and DNA samples, and followed by in-person surveys every 3–4 years and linkage with cancer and vital statistics registries, to study lifestyle, environmental and genetic contributions to cancer and other non-communicable diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25733578") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25733578") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25733578+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Blood, urine and DNA were collected from 75%, 89% and 89% of participants, respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000578> "A population-based prospective cohort of 61,480 men aged 40–74 living in urban Shanghai, recruited from 2002 with detailed lifestyle, dietary and medical data and blood, urine and DNA samples, and followed by in-person surveys every 3–4 years and linkage with cancer and vital statistics registries, to study lifestyle, environmental and genetic contributions to cancer and other non-communicable diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25733578") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25733578") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25733578+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Shanghai Men's Health Study (SMHS) is a population-based cohort study of 61,480 men aged 40-74 years, launched in 2002 in urban Shanghai to investigate the contribution of lifestyle/environmental factors and genetic susceptibility to cancer and other non-communicable diseases (NCDs).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000578> "A population-based prospective cohort of 61,480 men aged 40–74 living in urban Shanghai, recruited from 2002 with detailed lifestyle, dietary and medical data and blood, urine and DNA samples, and followed by in-person surveys every 3–4 years and linkage with cancer and vital statistics registries, to study lifestyle, environmental and genetic contributions to cancer and other non-communicable diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25733578") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25733578") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25733578+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The cohort has been followed up through a combination of in-person surveys every 3-4 years and annual record linkage with cancer and vital statistics registries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000578> "A population-based prospective cohort of 61,480 men aged 40–74 living in urban Shanghai, recruited from 2002 with detailed lifestyle, dietary and medical data and blood, urine and DNA samples, and followed by in-person surveys every 3–4 years and linkage with cancer and vital statistics registries, to study lifestyle, environmental and genetic contributions to cancer and other non-communicable diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000579> (<http://www.ebi.ac.uk/coho/COHO_0000579>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26554653") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(rdfs:comment "A cohort of 66 806 men and women aged 50–76 years at baseline who participated in the VITamins And Lifestyle (VITAL) study was followed from 2000 to 2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000579> "A prospective cohort of men and women aged 50–76 living in the 13-county area of western Washington State covered by the SEER cancer registry, recruited by mailed questionnaire from October 2000 to December 2002, with about 77,700 valid baseline questionnaires, to study the use of vitamins and other dietary supplements, and lifestyle, in relation to cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26554653") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(rdfs:comment "Baseline recruitment was conducted from Oct 2000 to Dec 2002.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000579> "A prospective cohort of men and women aged 50–76 living in the 13-county area of western Washington State covered by the SEER cancer registry, recruited by mailed questionnaire from October 2000 to December 2002, with about 77,700 valid baseline questionnaires, to study the use of vitamins and other dietary supplements, and lifestyle, in relation to cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26554653") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(rdfs:comment "During this period, a total of 364 418 questionnaires were mailed for the VITAL study to residents in the covered counties, out of which 79 300 (21.8%) mail recipients responded.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000579> "A prospective cohort of men and women aged 50–76 living in the 13-county area of western Washington State covered by the SEER cancer registry, recruited by mailed questionnaire from October 2000 to December 2002, with about 77,700 valid baseline questionnaires, to study the use of vitamins and other dietary supplements, and lifestyle, in relation to cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26554653") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(rdfs:comment "In brief, the participants in the VITAL study cohort were recruited from men and women aged above 50 years and living in the 13-county area in Western Washington State covered by the Surveillance, Epidemiology, and End Results (SEER) program cancer registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000579> "A prospective cohort of men and women aged 50–76 living in the 13-county area of western Washington State covered by the SEER cancer registry, recruited by mailed questionnaire from October 2000 to December 2002, with about 77,700 valid baseline questionnaires, to study the use of vitamins and other dietary supplements, and lifestyle, in relation to cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26554653") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(rdfs:comment "Of these, 77 719 questionnaires passed quality control checks in the VITAL study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000579> "A prospective cohort of men and women aged 50–76 living in the 13-county area of western Washington State covered by the SEER cancer registry, recruited by mailed questionnaire from October 2000 to December 2002, with about 77,700 valid baseline questionnaires, to study the use of vitamins and other dietary supplements, and lifestyle, in relation to cancer risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11091089/supplementaryFiles") Annotation(rdfs:comment "The VITamins And Lifestyle (VITAL) cohort comprises of 77,721 Washington State men and women aged 50 to 76 years, recruited from 2000 to 2002 to investigate the association of supplement use and lifestyle factors with cancer risk.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000579> "A prospective cohort of men and women aged 50–76 living in the 13-county area of western Washington State covered by the SEER cancer registry, recruited by mailed questionnaire from October 2000 to December 2002, with about 77,700 valid baseline questionnaires, to study the use of vitamins and other dietary supplements, and lifestyle, in relation to cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000580> (<http://www.ebi.ac.uk/coho/COHO_0000580>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21318257") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30990817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34446064") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21318257") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://link.springer.com/article/10.1007/s11325-011-0491-3") Annotation(rdfs:comment "Both WASHS databases contain data from patients referred to the sole public sleep clinic in Western Australia (located at the Sir Charles Gairdner tertiary hospital) for a presumed sleep disorder, the majority for snoring and/or OSA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000580> "A clinic-based cohort of patients, predominantly of European origin, attending the only public sleep clinic in Western Australia, in Perth, most of them referred for sleep-disordered breathing, with questionnaires, biochemistry, DNA and in-laboratory polysomnography and linkage to Western Australian health data, to study the epidemiology and genetics of obstructive sleep apnoea and its comorbidities.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21318257") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30990817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34446064") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21318257") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://link.springer.com/article/10.1007/s11325-011-0491-3") Annotation(rdfs:comment "Currently complete data (questionnaire, biochemistry, DNA, and PSG) has been obtained") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000580> "A clinic-based cohort of patients, predominantly of European origin, attending the only public sleep clinic in Western Australia, in Perth, most of them referred for sleep-disordered breathing, with questionnaires, biochemistry, DNA and in-laboratory polysomnography and linkage to Western Australian health data, to study the epidemiology and genetics of obstructive sleep apnoea and its comorbidities.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21318257") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30990817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34446064") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21318257") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://link.springer.com/article/10.1007/s11325-011-0491-3") Annotation(rdfs:comment "In addition, data from both cohorts have been linked prospectively to statutory health data collected by the WA Department of Health.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000580> "A clinic-based cohort of patients, predominantly of European origin, attending the only public sleep clinic in Western Australia, in Perth, most of them referred for sleep-disordered breathing, with questionnaires, biochemistry, DNA and in-laboratory polysomnography and linkage to Western Australian health data, to study the epidemiology and genetics of obstructive sleep apnoea and its comorbidities.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21318257") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30990817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34446064") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21318257") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://link.springer.com/article/10.1007/s11325-011-0491-3") Annotation(rdfs:comment "The WASHS Prospective Sleep Clinic Cohort study recruited all new consenting patients referred to the public sleep clinic in Perth, Western Australia from 2006 until 2010.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000580> "A clinic-based cohort of patients, predominantly of European origin, attending the only public sleep clinic in Western Australia, in Perth, most of them referred for sleep-disordered breathing, with questionnaires, biochemistry, DNA and in-laboratory polysomnography and linkage to Western Australian health data, to study the epidemiology and genetics of obstructive sleep apnoea and its comorbidities.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21318257") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30990817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34446064") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21318257") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://link.springer.com/article/10.1007/s11325-011-0491-3") Annotation(rdfs:comment "The majority of participants (>80%) are of Caucasian European ancestry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000580> "A clinic-based cohort of patients, predominantly of European origin, attending the only public sleep clinic in Western Australia, in Perth, most of them referred for sleep-disordered breathing, with questionnaires, biochemistry, DNA and in-laboratory polysomnography and linkage to Western Australian health data, to study the epidemiology and genetics of obstructive sleep apnoea and its comorbidities.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21318257") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30990817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34446064") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21318257") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://link.springer.com/article/10.1007/s11325-011-0491-3") Annotation(rdfs:comment "we have developed an extensively characterized clinic-based cohort to investigate the clinical and genetic epidemiology of OSA and its consequences in Western Australia (WA); the West Australian Sleep Health Study (WASHS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000580> "A clinic-based cohort of patients, predominantly of European origin, attending the only public sleep clinic in Western Australia, in Perth, most of them referred for sleep-disordered breathing, with questionnaires, biochemistry, DNA and in-laboratory polysomnography and linkage to Western Australian health data, to study the epidemiology and genetics of obstructive sleep apnoea and its comorbidities.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000581> (<http://www.ebi.ac.uk/coho/COHO_0000581>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29980228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29980228") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6035398/fullTextXML") Annotation(rdfs:comment "Funded through the Innovative Medicines Initiative (IMI), the EMIF project was established to facilitate the process of reusing and combining existing healthcare data with a focus on two therapeutic areas in the first instance: metabolic diseases and AD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000581> "A European multimodal biomarker dataset of 1,221 people aged over 50 with normal cognition, mild cognitive impairment or Alzheimer-type dementia and known amyloid status, whose existing clinical data, samples and scans were retrospectively combined from 11 prospective European cohort studies (three multicenter and eight single-center studies) within the Innovative Medicines Initiative-funded European Medical Information Framework, with plasma, cerebrospinal fluid, DNA and MRI data for discovery of diagnostic and prognostic Alzheimer disease biomarkers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29980228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29980228") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6035398/fullTextXML") Annotation(rdfs:comment "In the EMIF-AD MBD study we retrospectively combined and reused clinical data, samples and scans that had already been collected as part of existing prospective cohort studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000581> "A European multimodal biomarker dataset of 1,221 people aged over 50 with normal cognition, mild cognitive impairment or Alzheimer-type dementia and known amyloid status, whose existing clinical data, samples and scans were retrospectively combined from 11 prospective European cohort studies (three multicenter and eight single-center studies) within the Innovative Medicines Initiative-funded European Medical Information Framework, with plasma, cerebrospinal fluid, DNA and MRI data for discovery of diagnostic and prognostic Alzheimer disease biomarkers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29980228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29980228") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6035398/fullTextXML") Annotation(rdfs:comment "One of the main aims of the EMIF-AD project is to accelerate the discovery of novel diagnostic and prognostic biomarkers for AD and to unravel the underlying pathophysiological mechanisms, using existing data and existing samples, that would otherwise be inaccessible to research beyond the project teams responsible for the collection.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000581> "A European multimodal biomarker dataset of 1,221 people aged over 50 with normal cognition, mild cognitive impairment or Alzheimer-type dementia and known amyloid status, whose existing clinical data, samples and scans were retrospectively combined from 11 prospective European cohort studies (three multicenter and eight single-center studies) within the Innovative Medicines Initiative-funded European Medical Information Framework, with plasma, cerebrospinal fluid, DNA and MRI data for discovery of diagnostic and prognostic Alzheimer disease biomarkers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29980228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29980228") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6035398/fullTextXML") Annotation(rdfs:comment "The 11 selected cohorts included three multicenter studies—EDAR (n = 204) [14], PharmaCog (n = 147) [15] and DESCRIPA (n = 29) [16]—and eight single centers: Antwerp (n = 149) [17], Amsterdam (n = 172) [18], Barcelona Sant Pau (n = 45) [19], Barcelona IDIBAPS (n = 120) [20], Leuven (n = 180) [21], San Sebastian GAP (n = 40) [22], Gothenburg (n = 95) [23] and Lausanne (n = 40) [24].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000581> "A European multimodal biomarker dataset of 1,221 people aged over 50 with normal cognition, mild cognitive impairment or Alzheimer-type dementia and known amyloid status, whose existing clinical data, samples and scans were retrospectively combined from 11 prospective European cohort studies (three multicenter and eight single-center studies) within the Innovative Medicines Initiative-funded European Medical Information Framework, with plasma, cerebrospinal fluid, DNA and MRI data for discovery of diagnostic and prognostic Alzheimer disease biomarkers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29980228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29980228") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29980228+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Inclusion criteria were having normal cognition (NC) or a diagnosis of mild cognitive impairment (MCI) or AD-type dementia at baseline, age above 50 years, known amyloid-beta (Aβ) status, availability of cognitive test results and at least two of the following materials: plasma, DNA, magnetic resonance imaging (MRI) or cerebrospinal fluid (CSF).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000581> "A European multimodal biomarker dataset of 1,221 people aged over 50 with normal cognition, mild cognitive impairment or Alzheimer-type dementia and known amyloid status, whose existing clinical data, samples and scans were retrospectively combined from 11 prospective European cohort studies (three multicenter and eight single-center studies) within the Innovative Medicines Initiative-funded European Medical Information Framework, with plasma, cerebrospinal fluid, DNA and MRI data for discovery of diagnostic and prognostic Alzheimer disease biomarkers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29980228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29980228") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29980228+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We included 1221 individuals (NC n = 492, MCI n = 527, AD-type dementia n = 202) with a mean age of 67.9 (SD 8.3) years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000581> "A European multimodal biomarker dataset of 1,221 people aged over 50 with normal cognition, mild cognitive impairment or Alzheimer-type dementia and known amyloid status, whose existing clinical data, samples and scans were retrospectively combined from 11 prospective European cohort studies (three multicenter and eight single-center studies) within the Innovative Medicines Initiative-funded European Medical Information Framework, with plasma, cerebrospinal fluid, DNA and MRI data for discovery of diagnostic and prognostic Alzheimer disease biomarkers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000582> (<http://www.ebi.ac.uk/coho/COHO_0000582>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8651220") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2409301/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4417236/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8224703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8651220") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8651220+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A total of 657 families with the highest risk scores and early-onset CHD and 588 randomly sampled families had clinic examinations that included electrocardiograms, carotid artery ultrasound scans, spirometry, measurements of body size, blood pressure, lipids, lipoproteins, hemostatic factors, insulin, glucose, and routine chemistries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000582> "A family study of the National Heart, Lung, and Blood Institute that recruited families, about half at high risk of coronary heart disease and half selected randomly, from existing study populations at four centres in Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), examining 5,710 participants in 1993–1995, to identify genetic and non-genetic determinants of coronary heart disease, atherosclerosis and their risk factors. Its follow-up, the Family Heart SCAN study, re-examined about a third of the participants with cardiac CT in 2002–2003 and added 622 African Americans from 211 families of hypertensive sibships previously examined by the Hypertension Genetic Epidemiology Network (HyperGEN).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8651220") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2409301/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4417236/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8224703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:8651220") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A8651220+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The NHLBI Family Heart Study is a multicenter, population-based study of genetic and nongenetic determinants of coronary heart disease (CHD), atherosclerosis, and cardiovascular risk factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000582> "A family study of the National Heart, Lung, and Blood Institute that recruited families, about half at high risk of coronary heart disease and half selected randomly, from existing study populations at four centres in Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), examining 5,710 participants in 1993–1995, to identify genetic and non-genetic determinants of coronary heart disease, atherosclerosis and their risk factors. Its follow-up, the Family Heart SCAN study, re-examined about a third of the participants with cardiac CT in 2002–2003 and added 622 African Americans from 211 families of hypertensive sibships previously examined by the Hypertension Genetic Epidemiology Network (HyperGEN).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8651220") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2409301/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4417236/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8224703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2409301/fullTextXML") Annotation(rdfs:comment "The National Heart, Lung and Blood Institute (NHLBI) Family Heart Study (FHS) recruited families from four existing study centers located in Forsyth County, NC; Framingham, MA; Minneapolis, MN; and Salt Lake City, UT.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000582> "A family study of the National Heart, Lung, and Blood Institute that recruited families, about half at high risk of coronary heart disease and half selected randomly, from existing study populations at four centres in Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), examining 5,710 participants in 1993–1995, to identify genetic and non-genetic determinants of coronary heart disease, atherosclerosis and their risk factors. Its follow-up, the Family Heart SCAN study, re-examined about a third of the participants with cardiac CT in 2002–2003 and added 622 African Americans from 211 families of hypertensive sibships previously examined by the Hypertension Genetic Epidemiology Network (HyperGEN).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8651220") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2409301/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4417236/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8224703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4417236/fullTextXML") Annotation(rdfs:comment "Six hundred and twenty-two African Americans from 211 families were recruited for this study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000582> "A family study of the National Heart, Lung, and Blood Institute that recruited families, about half at high risk of coronary heart disease and half selected randomly, from existing study populations at four centres in Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), examining 5,710 participants in 1993–1995, to identify genetic and non-genetic determinants of coronary heart disease, atherosclerosis and their risk factors. Its follow-up, the Family Heart SCAN study, re-examined about a third of the participants with cardiac CT in 2002–2003 and added 622 African Americans from 211 families of hypertensive sibships previously examined by the Hypertension Genetic Epidemiology Network (HyperGEN).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8651220") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2409301/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4417236/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8224703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8224703/fullTextXML") Annotation(rdfs:comment "CAC measurements were done with Cardiac CT between 2002 and 2003 in one-third of subjects who were invited to participate in a clinical examination.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000582> "A family study of the National Heart, Lung, and Blood Institute that recruited families, about half at high risk of coronary heart disease and half selected randomly, from existing study populations at four centres in Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), examining 5,710 participants in 1993–1995, to identify genetic and non-genetic determinants of coronary heart disease, atherosclerosis and their risk factors. Its follow-up, the Family Heart SCAN study, re-examined about a third of the participants with cardiac CT in 2002–2003 and added 622 African Americans from 211 families of hypertensive sibships previously examined by the Hypertension Genetic Epidemiology Network (HyperGEN).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8651220") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2409301/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4417236/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8224703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8224703/fullTextXML") Annotation(rdfs:comment "In short, a total of 5710 subjects participated in baseline clinical examinations from 1993 to 1995.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000582> "A family study of the National Heart, Lung, and Blood Institute that recruited families, about half at high risk of coronary heart disease and half selected randomly, from existing study populations at four centres in Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), examining 5,710 participants in 1993–1995, to identify genetic and non-genetic determinants of coronary heart disease, atherosclerosis and their risk factors. Its follow-up, the Family Heart SCAN study, re-examined about a third of the participants with cardiac CT in 2002–2003 and added 622 African Americans from 211 families of hypertensive sibships previously examined by the Hypertension Genetic Epidemiology Network (HyperGEN).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000583> (<http://www.ebi.ac.uk/coho/COHO_0000583>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37110162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39849370") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37110162") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10145069/fullTextXML") Annotation(rdfs:comment "The HAPO Study was a large, multinational, racially and ethnically diverse population-based study [15,16].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000583> "A multinational, multi-ancestry observational cohort of more than 25,000 pregnant women enrolled in 2000-2006 at 15 field centres in Asia, Australia, the Caribbean, Europe, North America and the Middle East, who had a standardised 75 g oral glucose tolerance test at 24-32 weeks of gestation, to study the association of maternal glycaemia with adverse pregnancy and newborn outcomes; mothers were later genotyped and their children followed up.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37110162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39849370") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39849370") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11755808/fullTextXML") Annotation(rdfs:comment "A total of 5,621 samples were genotyped for 665,608 variants using the Multi-Ethnic Genotyping Array (MEGA), including 2,884 samples from HAPO mothers, 2,679 samples from HAPO offspring, and 58 HapMap control samples.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000583> "A multinational, multi-ancestry observational cohort of more than 25,000 pregnant women enrolled in 2000-2006 at 15 field centres in Asia, Australia, the Caribbean, Europe, North America and the Middle East, who had a standardised 75 g oral glucose tolerance test at 24-32 weeks of gestation, to study the association of maternal glycaemia with adverse pregnancy and newborn outcomes; mothers were later genotyped and their children followed up.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37110162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39849370") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39849370") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11755808/fullTextXML") Annotation(rdfs:comment "HAPO enrolled > 25,000 pregnant individuals at 15 international field centers between 2000 and 2006 and used a central, standardized protocol for all study procedures that included a 75 g oral glucose tolerance test (OGTT) between 24 and 32 weeks’ gestation in all participants with plasma glucose measurements made at fasting, 1-hr and 2-hrs following glucose consumption [35].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000583> "A multinational, multi-ancestry observational cohort of more than 25,000 pregnant women enrolled in 2000-2006 at 15 field centres in Asia, Australia, the Caribbean, Europe, North America and the Middle East, who had a standardised 75 g oral glucose tolerance test at 24-32 weeks of gestation, to study the association of maternal glycaemia with adverse pregnancy and newborn outcomes; mothers were later genotyped and their children followed up.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37110162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39849370") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39849370") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11755808/fullTextXML") Annotation(rdfs:comment "The HAPO Study was an observational study designed to investigate the association between maternal glycemia during pregnancy, less severe than overt diabetes, and adverse pregnancy outcomes [34].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000583> "A multinational, multi-ancestry observational cohort of more than 25,000 pregnant women enrolled in 2000-2006 at 15 field centres in Asia, Australia, the Caribbean, Europe, North America and the Middle East, who had a standardised 75 g oral glucose tolerance test at 24-32 weeks of gestation, to study the association of maternal glycaemia with adverse pregnancy and newborn outcomes; mothers were later genotyped and their children followed up.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37110162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39849370") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12590762/fullTextXML") Annotation(rdfs:comment "Of the eligible women across 15 centers in nine countries, 28,562 agreed to participate, 25,505 of whom completed the OGTT, leaving 23,316 available for analysis following further filtering [19].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000583> "A multinational, multi-ancestry observational cohort of more than 25,000 pregnant women enrolled in 2000-2006 at 15 field centres in Asia, Australia, the Caribbean, Europe, North America and the Middle East, who had a standardised 75 g oral glucose tolerance test at 24-32 weeks of gestation, to study the association of maternal glycaemia with adverse pregnancy and newborn outcomes; mothers were later genotyped and their children followed up.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37110162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39849370") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9169452/fullTextXML") Annotation(rdfs:comment "The Hyperglycemia and Adverse Pregnancy Outcome (HAPO) cohort recruited 28 562 pregnant women between 1 July 2000 and 30 April 2006 from 15 clinical study centers in 10 countries (United States, Canada, Barbados, United Kingdom, the Netherlands, Thailand, Israel, Australia, Hong Kong and Singapore), four of the centers being in the United States, for their oral glucose tolerance test (OGTT) between 24 and 32 weeks (43).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000583> "A multinational, multi-ancestry observational cohort of more than 25,000 pregnant women enrolled in 2000-2006 at 15 field centres in Asia, Australia, the Caribbean, Europe, North America and the Middle East, who had a standardised 75 g oral glucose tolerance test at 24-32 weeks of gestation, to study the association of maternal glycaemia with adverse pregnancy and newborn outcomes; mothers were later genotyped and their children followed up.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000584> (<http://www.ebi.ac.uk/coho/COHO_0000584>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4634848/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9365120/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26540294") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4634848/fullTextXML") Annotation(rdfs:comment "Individuals were fasting for a minimum of six hours prior to collection.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000584> "A biorepository cohort of 9,334 adults recruited sequentially at the cardiac catheterisation laboratories of Duke University, Durham, North Carolina, while undergoing evaluation for ischaemic heart disease, with fasting blood samples, genotype data and clinical data from medical records, followed for cardiovascular events and survival.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4634848/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9365120/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26540294") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4634848/fullTextXML") Annotation(rdfs:comment "Individuals were selected from the CATHGEN biorepository of patients referred for evaluation of ischemic heart disease recruited sequentially through the cardiac catheterization laboratories at Duke University (Durham, NC) [30].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000584> "A biorepository cohort of 9,334 adults recruited sequentially at the cardiac catheterisation laboratories of Duke University, Durham, North Carolina, while undergoing evaluation for ischaemic heart disease, with fasting blood samples, genotype data and clinical data from medical records, followed for cardiovascular events and survival.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4634848/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9365120/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(rdfs:comment "The CATHeterization GENetics (CATHGEN) biorepository collected biospecimens and clinical data on individuals age ≥18 undergoing cardiac catheterization for concern of ischemic heart disease at a single center (Duke University Medical Center) from 2000-2010; a total of N=9334 individuals were collected.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000584> "A biorepository cohort of 9,334 adults recruited sequentially at the cardiac catheterisation laboratories of Duke University, Durham, North Carolina, while undergoing evaluation for ischaemic heart disease, with fasting blood samples, genotype data and clinical data from medical records, followed for cardiovascular events and survival.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4634848/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9365120/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9365120/fullTextXML") Annotation(rdfs:comment "Data available in the biorepository include genome-wide genotype data, demographic and clinical data abstracted from medical records, and follow-up data of mortality events at 6 months and then annually.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000584> "A biorepository cohort of 9,334 adults recruited sequentially at the cardiac catheterisation laboratories of Duke University, Durham, North Carolina, while undergoing evaluation for ischaemic heart disease, with fasting blood samples, genotype data and clinical data from medical records, followed for cardiovascular events and survival.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4634848/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9365120/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9365120/fullTextXML") Annotation(rdfs:comment "The Institutional Review Board for an academic medical center in the southeastern U.S. approved the primary CATHGEN cohort biorepository (N = 9334) [19], the GWAS substudy of the first 2203 participants >18 years of age enrolled in CATHGEN [20], [21], and the present") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000584> "A biorepository cohort of 9,334 adults recruited sequentially at the cardiac catheterisation laboratories of Duke University, Durham, North Carolina, while undergoing evaluation for ischaemic heart disease, with fasting blood samples, genotype data and clinical data from medical records, followed for cardiovascular events and survival.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4634848/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9365120/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000703.v1.p1") Annotation(rdfs:comment "Follow-up includes mortality information gleaned from the National Death Index and Social Security Death Index plus follow-up phone calls and written questionnaires regarding MI, stroke, re-hospitalization, coronary re-vascularization procedures, smoking, exercise, and medication use.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000584> "A biorepository cohort of 9,334 adults recruited sequentially at the cardiac catheterisation laboratories of Duke University, Durham, North Carolina, while undergoing evaluation for ischaemic heart disease, with fasting blood samples, genotype data and clinical data from medical records, followed for cardiovascular events and survival.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000585> (<http://www.ebi.ac.uk/coho/COHO_0000585>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8574048/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8574048/fullTextXML") Annotation(rdfs:comment "CRCGEN combines data of two Spanish case-control studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000585> "A Spanish colorectal cancer study combining two case-control studies: incident colorectal cancer cases and hospital controls recruited at the University Hospital of Bellvitge, L'Hospitalet de Llobregat (Barcelona), in 1996–1998, and cases and population controls recruited at Bellvitge and the Hospital of León in 2007–2015, genotyped to study the genetics and genomics of colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8574048/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8574048/fullTextXML") Annotation(rdfs:comment "Genotyping within the CRCGEN study was conducted in 2016 from blood DNA using the Infinium OncoArray-500 K BeadChip (Illumina, San Diego, CA) which contains 500,000 SNPs, whereas the genotyping within the COLSCREEN study was performed in 2019 using the Infinium Global Screening Array v2.0 (Illumina, San Diego, CA) which includes near 800,000 SNPs markers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000585> "A Spanish colorectal cancer study combining two case-control studies: incident colorectal cancer cases and hospital controls recruited at the University Hospital of Bellvitge, L'Hospitalet de Llobregat (Barcelona), in 1996–1998, and cases and population controls recruited at Bellvitge and the Hospital of León in 2007–2015, genotyped to study the genetics and genomics of colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8574048/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8574048/fullTextXML") Annotation(rdfs:comment "The first one, conducted in the University Hospital of Bellvitge, L’Hospitalet del Llobregat, (Barcelona), recruited incident pathology-confirmed CRC cases (n = 304) and age and sex frequency-matched hospital controls (n = 293) during the period 1996–1998.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000585> "A Spanish colorectal cancer study combining two case-control studies: incident colorectal cancer cases and hospital controls recruited at the University Hospital of Bellvitge, L'Hospitalet de Llobregat (Barcelona), in 1996–1998, and cases and population controls recruited at Bellvitge and the Hospital of León in 2007–2015, genotyped to study the genetics and genomics of colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8574048/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8574048/fullTextXML") Annotation(rdfs:comment "The second study was conducted in parallel in the University Hospital of Bellvitge and in the Hospital of León, León, during 2007–2015 and recruited a total of 633 incident CRC cases (313 Bellvitge and 320 León) and 571 population controls (free of CRC, 164 Bellvitge and 407 León).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000585> "A Spanish colorectal cancer study combining two case-control studies: incident colorectal cancer cases and hospital controls recruited at the University Hospital of Bellvitge, L'Hospitalet de Llobregat (Barcelona), in 1996–1998, and cases and population controls recruited at Bellvitge and the Hospital of León in 2007–2015, genotyped to study the genetics and genomics of colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000586> (<http://www.ebi.ac.uk/coho/COHO_0000586>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10178705/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4997959/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394865/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9436946/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10178705/fullTextXML") Annotation(rdfs:comment "All three populations belong to the Italian Network of Genetic Isolates (INGI), a project aimed at studying the genetic basis of complex diseases and phenotypes (including eating habits) [41].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000586> "A population-based cohort of about 1,000 people from Carlantino, a small isolated village in Apulia (Foggia province), southern Italy, who underwent clinical and instrumental evaluations between 1998 and 2005; one of the isolated populations of the Italian Network of Genetic Isolates, which studies the genetic basis of complex diseases and phenotypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10178705/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4997959/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394865/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9436946/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4997959/fullTextXML") Annotation(rdfs:comment "In particular, our study used 370 individuals from INGI-CARL, a population coming from Carlantino, a small village located in Puglia (Southern Italy), and 843 defined as INGI-FVG, making reference to 6 villages situated in the Friuli Venezia Region in North-Eastern Italy for a total of 1207 samples.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000586> "A population-based cohort of about 1,000 people from Carlantino, a small isolated village in Apulia (Foggia province), southern Italy, who underwent clinical and instrumental evaluations between 1998 and 2005; one of the isolated populations of the Italian Network of Genetic Isolates, which studies the genetic basis of complex diseases and phenotypes.")
