# Individual: <http://www.ebi.ac.uk/coho/COHO_0001979> (<http://www.ebi.ac.uk/coho/COHO_0001979>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/ng.2985") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "Cases were CRC patients who were admitted to two university hospitals and one general cancer hospital in the Seoul Metropolitan Area between 1995 and 2004 12 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001979> "A multicentre hospital-based case-control study of colorectal cancer in South Korea, whose cases were colorectal cancer patients admitted to two university hospitals and one general cancer hospital in the Seoul Metropolitan Area between 1995 and 2004, and whose controls were inpatients with non-neoplastic conditions at the same hospitals in the same period; it contributes to the genetic studies of the Asia Colorectal Cancer Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/ng.2985") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "Controls were selected from the same hospitals during the same time period from among a wide spectrum of inpatients with non-neoplastic conditions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001979> "A multicentre hospital-based case-control study of colorectal cancer in South Korea, whose cases were colorectal cancer patients admitted to two university hospitals and one general cancer hospital in the Seoul Metropolitan Area between 1995 and 2004, and whose controls were inpatients with non-neoplastic conditions at the same hospitals in the same period; it contributes to the genetic studies of the Asia Colorectal Cancer Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/ng.2985") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "This study (Korea-Seoul) is a multicenter case-control study conducted in South Korea 12 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001979> "A multicentre hospital-based case-control study of colorectal cancer in South Korea, whose cases were colorectal cancer patients admitted to two university hospitals and one general cancer hospital in the Seoul Metropolitan Area between 1995 and 2004, and whose controls were inpatients with non-neoplastic conditions at the same hospitals in the same period; it contributes to the genetic studies of the Asia Colorectal Cancer Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/ng.2985") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3679924/fullTextXML") Annotation(rdfs:comment "In 2009, we initiated the Asia Colorectal Cancer Consortium (ACCC), a GWAS in East Asians, to search for novel genetic risk factors for CRC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001979> "A multicentre hospital-based case-control study of colorectal cancer in South Korea, whose cases were colorectal cancer patients admitted to two university hospitals and one general cancer hospital in the Seoul Metropolitan Area between 1995 and 2004, and whose controls were inpatients with non-neoplastic conditions at the same hospitals in the same period; it contributes to the genetic studies of the Asia Colorectal Cancer Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/ng.2985") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3679924/fullTextXML") Annotation(rdfs:comment "Korea-Seoul Colorectal Cancer Study (None reported) and KCPS-II colorectal cancer study") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001979> "A multicentre hospital-based case-control study of colorectal cancer in South Korea, whose cases were colorectal cancer patients admitted to two university hospitals and one general cancer hospital in the Seoul Metropolitan Area between 1995 and 2004, and whose controls were inpatients with non-neoplastic conditions at the same hospitals in the same period; it contributes to the genetic studies of the Asia Colorectal Cancer Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001980> (<http://www.ebi.ac.uk/coho/COHO_0001980>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38320993") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40348730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40348730") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40348730+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This prospective cohort study used data from the Kangbuk Samsung Cohort Study, which involved 357,322 Korean adults who underwent health screenings from 2011 to 2021.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001980> "A prospective cohort study of Korean adults attending health screening examinations at Kangbuk Samsung Hospital, South Korea, set up to study the natural history, prognosis and genetic and environmental determinants of a wide range of health traits and diseases, whose participants have consented since 2011 to linkage with national registries of death, cancer and medical use, and some of whom have been genotyped. It is distinct from the hospital's retrospective Kangbuk Samsung Health Study of routinely collected screening data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38320993") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40348730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf") Annotation(rdfs:comment "The KSCS is a prospective cohort study to evaluate the natural history, prognosis and genetic and environmental determinants of a wide range of health traits and diseases among Korean adults.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001980> "A prospective cohort study of Korean adults attending health screening examinations at Kangbuk Samsung Hospital, South Korea, set up to study the natural history, prognosis and genetic and environmental determinants of a wide range of health traits and diseases, whose participants have consented since 2011 to linkage with national registries of death, cancer and medical use, and some of whom have been genotyped. It is distinct from the hospital's retrospective Kangbuk Samsung Health Study of routinely collected screening data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38320993") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40348730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf") Annotation(rdfs:comment "The KSHS is a retrospective cohort study using de- identified data routinely collected during health screening visits from 2002 to present") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001980> "A prospective cohort study of Korean adults attending health screening examinations at Kangbuk Samsung Hospital, South Korea, set up to study the natural history, prognosis and genetic and environmental determinants of a wide range of health traits and diseases, whose participants have consented since 2011 to linkage with national registries of death, cancer and medical use, and some of whom have been genotyped. It is distinct from the hospital's retrospective Kangbuk Samsung Health Study of routinely collected screening data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38320993") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40348730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf") Annotation(rdfs:comment "There are two major cohort studies in Kangbuk Samsung Hospital: the KSCS and the Kangbuk Samsung Health Study (KSHS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001980> "A prospective cohort study of Korean adults attending health screening examinations at Kangbuk Samsung Hospital, South Korea, set up to study the natural history, prognosis and genetic and environmental determinants of a wide range of health traits and diseases, whose participants have consented since 2011 to linkage with national registries of death, cancer and medical use, and some of whom have been genotyped. It is distinct from the hospital's retrospective Kangbuk Samsung Health Study of routinely collected screening data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38320993") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40348730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-00763-1/MediaObjects/41588_2020_763_MOESM1_ESM.pdf") Annotation(rdfs:comment "They obtained informed consent for data linkage to national registries for death, cancer and medical utilization since 2011.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001980> "A prospective cohort study of Korean adults attending health screening examinations at Kangbuk Samsung Hospital, South Korea, set up to study the natural history, prognosis and genetic and environmental determinants of a wide range of health traits and diseases, whose participants have consented since 2011 to linkage with national registries of death, cancer and medical use, and some of whom have been genotyped. It is distinct from the hospital's retrospective Kangbuk Samsung Health Study of routinely collected screening data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001981> (<http://www.ebi.ac.uk/coho/COHO_0001981>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nature.com/articles/s41588-017-0014-7") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-017-0014-7/MediaObjects/41588_2017_14_MOESM1_ESM.pdf") Annotation(rdfs:comment "Additionaladult patients with asthma and healthy subjects (>200 samples) from the same population were recruited between2007and 2008specially in order toincreasefinal sample size fortheGWASinitiative.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001981> "A case-control study of asthma in adults of Russian origin from Central Russia, run by Kursk State Medical University, whose patients with asthma were recruited at the Department of Pulmonology of Kursk Regional Clinical Hospital in 2003–2004 and compared with controls matched for age and sex; further adult patients with asthma and healthy subjects from the same population were recruited in 2007–2008 for genome-wide association studies of asthma.")
