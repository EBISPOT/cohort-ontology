AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ludc.lu.se/resources/human-tissue-laboratory") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ludc.lu.se/resources/human-tissue-laboratory") Annotation(rdfs:comment "The main tissue handled is human pancreatic islets.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002731> "A collection of pancreatic islets and of liver, muscle, fat and other tissues, with donor information and disease history, from organ donors, established in 2007 by Lund University and Uppsala University within the Excellence of Diabetes Research in Sweden (EXODIAB) collaboration.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ludc.lu.se/resources/human-tissue-laboratory") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ludc.lu.se/resources/human-tissue-laboratory") Annotation(rdfs:comment "The resource receives and handles donor materials in the form of human insulin-producing cells as well as tissues from liver, muscle, fat, blood vessels, lymph nodes and spleen.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002731> "A collection of pancreatic islets and of liver, muscle, fat and other tissues, with donor information and disease history, from organ donors, established in 2007 by Lund University and Uppsala University within the Excellence of Diabetes Research in Sweden (EXODIAB) collaboration.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002732> (<http://www.ebi.ac.uk/coho/COHO_0002732>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24452238") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24452238") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24452238+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A single-blind, dose-dependent, parallel randomized controlled dietary intervention study was conducted.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002732> "A single-blind, parallel, randomised controlled dietary intervention trial in which men and women with low fruit and vegetable intake and at least a 1.5-fold increased risk of cardiovascular disease were assigned to high-flavonoid or low-flavonoid fruit and vegetables or to their habitual diet, to measure the dose-response relation with vascular function and other cardiovascular risk indicators.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24452238") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24452238") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24452238+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Male and female low-F&V consumers who had a ≥ 1.5-fold increased risk of CVD (n = 174) were randomly assigned to receive an HF F&V, an LF F&V, or a habitual diet, with HF and LF F&V amounts sequentially increasing by 2, 4, and 6 (+2, +4, and +6) portions/d every 6 wk over habitual intakes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002732> "A single-blind, parallel, randomised controlled dietary intervention trial in which men and women with low fruit and vegetable intake and at least a 1.5-fold increased risk of cardiovascular disease were assigned to high-flavonoid or low-flavonoid fruit and vegetables or to their habitual diet, to measure the dose-response relation with vascular function and other cardiovascular risk indicators.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24452238") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24452238") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24452238+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This study was designed to measure the dose-response relation between high-flavonoid (HF), low-flavonoid (LF), and habitual F&V intakes and vascular function and other cardiovascular disease (CVD) risk indicators.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002732> "A single-blind, parallel, randomised controlled dietary intervention trial in which men and women with low fruit and vegetable intake and at least a 1.5-fold increased risk of cardiovascular disease were assigned to high-flavonoid or low-flavonoid fruit and vegetables or to their habitual diet, to measure the dose-response relation with vascular function and other cardiovascular risk indicators.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24452238") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25332486") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25332486+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Data from a randomized controlled dietary intervention study [FLAVURS (Flavonoids University of Reading Study); n = 154] in which the test groups observed sequential increases of 2.3, 3.2, and 4.2 portions of F&Vs every 6 wk across an 18-wk period were used in this study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002732> "A single-blind, parallel, randomised controlled dietary intervention trial in which men and women with low fruit and vegetable intake and at least a 1.5-fold increased risk of cardiovascular disease were assigned to high-flavonoid or low-flavonoid fruit and vegetables or to their habitual diet, to measure the dose-response relation with vascular function and other cardiovascular risk indicators.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002733> (<http://www.ebi.ac.uk/coho/COHO_0002733>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22426117") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39033506") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC11513335/") Annotation(rdfs:comment "A standard liquid diet (SLD) drink was ingested at three occasions: SLDr – for “breakfast” on day two to recover from extended fasting, SLD1 – for “lunch” on day two, and SLD2 – for “lunch” on day three in the second block.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002733> "A study in which young healthy male volunteers underwent a highly controlled four-day challenge protocol of 36 hours of fasting, oral glucose and lipid tests, liquid test meals, physical exercise and cold stress, with blood, urine, exhaled air and breath condensate analysed at up to 56 time points, to analyse the dynamics of the human metabolome in response to environmental stimuli.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22426117") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39033506") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC11513335/") Annotation(rdfs:comment "All participants underwent a series of six metabolic challenges within two 2-day test blocks (Figure 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002733> "A study in which young healthy male volunteers underwent a highly controlled four-day challenge protocol of 36 hours of fasting, oral glucose and lipid tests, liquid test meals, physical exercise and cold stress, with blood, urine, exhaled air and breath condensate analysed at up to 56 time points, to analyse the dynamics of the human metabolome in response to environmental stimuli.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22426117") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39033506") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC11513335/") Annotation(rdfs:comment "Briefly, 15 healthy male participants were recruited for the study. Participants were young (mean age of 27.8 years ±2.9), had normal weight (mean body mass index (BMI) of 23.1 kg/m2 ± 1.8), did not take any medication, and did not show any metabolic abnormalities.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002733> "A study in which young healthy male volunteers underwent a highly controlled four-day challenge protocol of 36 hours of fasting, oral glucose and lipid tests, liquid test meals, physical exercise and cold stress, with blood, urine, exhaled air and breath condensate analysed at up to 56 time points, to analyse the dynamics of the human metabolome in response to environmental stimuli.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22426117") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39033506") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC11513335/") Annotation(rdfs:comment "Samples were collected at up to 56 time points in different intervals (every 15–240 min) over the study days depending on the collected biofluid (plasma, spot urine, exhaled breath condensate samples, breath air) and the particular challenge (Table S7).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002733> "A study in which young healthy male volunteers underwent a highly controlled four-day challenge protocol of 36 hours of fasting, oral glucose and lipid tests, liquid test meals, physical exercise and cold stress, with blood, urine, exhaled air and breath condensate analysed at up to 56 time points, to analyse the dynamics of the human metabolome in response to environmental stimuli.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22426117") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39033506") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC11513335/") Annotation(rdfs:comment "The HuMet study7 was specifically designed to capture the dynamics of metabolism in a homogeneous, healthy group (n = 15) across multiple challenges, including four highly standardized (i.e., reproducible) nutritional challenges, physical exercise, and a stress test.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002733> "A study in which young healthy male volunteers underwent a highly controlled four-day challenge protocol of 36 hours of fasting, oral glucose and lipid tests, liquid test meals, physical exercise and cold stress, with blood, urine, exhaled air and breath condensate analysed at up to 56 time points, to analyse the dynamics of the human metabolome in response to environmental stimuli.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22426117") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39033506") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC11513335/") Annotation(rdfs:comment "We present the HuMet Repository for exploring dynamic metabolic responses to oral glucose/lipid loads, mixed meals, 36-h fasting, exercise, and cold stress in healthy subjects.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002733> "A study in which young healthy male volunteers underwent a highly controlled four-day challenge protocol of 36 hours of fasting, oral glucose and lipid tests, liquid test meals, physical exercise and cold stress, with blood, urine, exhaled air and breath condensate analysed at up to 56 time points, to analyse the dynamics of the human metabolome in response to environmental stimuli.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002734> (<http://www.ebi.ac.uk/coho/COHO_0002734>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34376480") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34376480") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8713959/") Annotation(rdfs:comment "Participants undergo extensive serial assessments to capture clinical data as shown in Box 1 (including clinical laboratory values, radiographic findings, medication use, oxygen and ventilatory support requirements, and complications) and biologic samples [blood, mid-turbinate nasal swabs, and, for intubated patients, endotracheal aspirates (EAs)].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002734> "A prospective longitudinal study of adults hospitalised with COVID-19 in the United States, launched in May 2020 by the National Institute of Allergy and Infectious Diseases, following their clinical course and immune responses through serial sampling.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34376480") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34376480") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8713959/") Annotation(rdfs:comment "The IMPACC network brings together expert clinicians, geneticists, and immunologists to assess the relationship between the clinical course and immune response to SARS-CoV-2 in racially, ethnically, and geographically diverse adult patient populations across the United States.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002734> "A prospective longitudinal study of adults hospitalised with COVID-19 in the United States, launched in May 2020 by the National Institute of Allergy and Infectious Diseases, following their clinical course and immune responses through serial sampling.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34376480") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34376480") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8713959/") Annotation(rdfs:comment "The Immunophenotyping Assessment in a COVID-19 Cohort (IMPACC) is a prospective longitudinal study designed to enroll 1000 hospitalized patients with COVID-19 (NCT04378777).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002734> "A prospective longitudinal study of adults hospitalised with COVID-19 in the United States, launched in May 2020 by the National Institute of Allergy and Infectious Diseases, following their clinical course and immune responses through serial sampling.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34376480") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34376480") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8713959/") Annotation(rdfs:comment "The National Institute of Allergy and Infectious Diseases (NIAID), National Institutes of Health (NIH), launched a prospective longitudinal cohort study [Immunophenotyping Assessment in a COVID-19 Cohort (IMPACC)] in May 2020.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002734> "A prospective longitudinal study of adults hospitalised with COVID-19 in the United States, launched in May 2020 by the National Institute of Allergy and Infectious Diseases, following their clinical course and immune responses through serial sampling.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002735> (<http://www.ebi.ac.uk/coho/COHO_0002735>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32819883") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32819883") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32819883+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "From January through September 2012, 1,110 adult members of AARP, 50 to 74 years of age, were recruited from the Pittsburgh, PA, area to participate in the Interactive Diet and Activity Tracking in AARP (IDATA) study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002735> "A study of adult AARP members aged 50 to 74 years recruited from the Pittsburgh area, Pennsylvania, United States, in 2012 and followed for 12 months with repeated dietary, physical activity and biomarker measurements.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32819883") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32819883") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32819883+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Over 12 months, participants completed up to 6 ASA24 recalls, 2 web-based FFQs, and 2 unweighed paper-and-pencil 4DFRs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002735> "A study of adult AARP members aged 50 to 74 years recruited from the Pittsburgh area, Pennsylvania, United States, in 2012 and followed for 12 months with repeated dietary, physical activity and biomarker measurements.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32819883") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32819883") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32819883+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Participants were administered doubly-labeled water to provide a measure of total energy expenditure and collected two 24-hour urine samples to assess concentrations of nitrogen, sodium, and potassium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002735> "A study of adult AARP members aged 50 to 74 years recruited from the Pittsburgh area, Pennsylvania, United States, in 2012 and followed for 12 months with repeated dietary, physical activity and biomarker measurements.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32819883") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40392756") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12091781/fullTextXML") Annotation(rdfs:comment "Our analytic sample included the 718 IDATA participants with dietary data, including at least one ASA-24, and available serum, 24-h urine, and first morning void (FMV) urine, collected at two time points, 6 months apart, for metabolomics analysis (Fig 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002735> "A study of adult AARP members aged 50 to 74 years recruited from the Pittsburgh area, Pennsylvania, United States, in 2012 and followed for 12 months with repeated dietary, physical activity and biomarker measurements.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002736> (<http://www.ebi.ac.uk/coho/COHO_0002736>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37884815") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37884815") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10627828/fullTextXML") Annotation(rdfs:comment "Here we established the Isala citizen-science project to analyse the vaginal microbiomes of 3,345 women in Belgium (18–98 years) through self-sampling, 16S amplicon sequencing and extensive questionnaires.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002736> "A citizen-science cohort of women in Belgium who provided self-collected vaginal samples and completed extensive questionnaires, to characterise the vaginal microbiome and its associations with health, lifestyle and life-course events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37884815") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37884815") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10627828/fullTextXML") Annotation(rdfs:comment "We aimed to jointly break taboos on women’s and vaginal health and provide insights in how the occurrence of lactobacilli and other vaginal bacteria is associated with lifestyle and life-course events.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002736> "A citizen-science cohort of women in Belgium who provided self-collected vaginal samples and completed extensive questionnaires, to characterise the vaginal microbiome and its associations with health, lifestyle and life-course events.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002737> (<http://www.ebi.ac.uk/coho/COHO_0002737>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38325367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38325367") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10943582/fullTextXML") Annotation(rdfs:comment "Non-tumor adjacent tissue was available for 53% of the cases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002737> "A biorepository of 7,808 people with cancer at one of eight anatomical sites, from 30 countries, whose tumour and optional non-tumour tissues, blood and harmonised demographic, lifestyle, environmental and clinical data were assembled between 2018 and 2022 under one protocol, to explain geographical and temporal differences in cancer incidence through mutational signature analysis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38325367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38325367") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10943582/fullTextXML") Annotation(rdfs:comment "The Mutographs project has created a large genomic dataset and biorepository of over 7,800 cancer cases from 30 countries across five continents with extensive demographic, lifestyle, environmental, and clinical information.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002737> "A biorepository of 7,808 people with cancer at one of eight anatomical sites, from 30 countries, whose tumour and optional non-tumour tissues, blood and harmonised demographic, lifestyle, environmental and clinical data were assembled between 2018 and 2022 under one protocol, to explain geographical and temporal differences in cancer incidence through mutational signature analysis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38325367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38325367") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10943582/fullTextXML") Annotation(rdfs:comment "The eight cancer sites included in the Mutographs study are also covered in the PCAWG study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002737> "A biorepository of 7,808 people with cancer at one of eight anatomical sites, from 30 countries, whose tumour and optional non-tumour tissues, blood and harmonised demographic, lifestyle, environmental and clinical data were assembled between 2018 and 2022 under one protocol, to explain geographical and temporal differences in cancer incidence through mutational signature analysis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38325367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38325367") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10943582/fullTextXML") Annotation(rdfs:comment "Through this international network of 50 institutional collaborators in 30 countries, between 2018 and 2022, the Mutographs team harmonized biospecimen and epidemiologic data on 7,808 cancer cases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002737> "A biorepository of 7,808 people with cancer at one of eight anatomical sites, from 30 countries, whose tumour and optional non-tumour tissues, blood and harmonised demographic, lifestyle, environmental and clinical data were assembled between 2018 and 2022 under one protocol, to explain geographical and temporal differences in cancer incidence through mutational signature analysis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38325367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38325367") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10943582/fullTextXML") Annotation(rdfs:comment "had an availability of fresh frozen tumor and, if possible, non-tumor fresh frozen tissue (FFT) and blood samples;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002737> "A biorepository of 7,808 people with cancer at one of eight anatomical sites, from 30 countries, whose tumour and optional non-tumour tissues, blood and harmonised demographic, lifestyle, environmental and clinical data were assembled between 2018 and 2022 under one protocol, to explain geographical and temporal differences in cancer incidence through mutational signature analysis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38325367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38325367") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10943582/fullTextXML") Annotation(rdfs:comment "with the primary objective of elucidating the causes of major global geographical and temporal differences in cancer incidence through mutational signature analysis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002737> "A biorepository of 7,808 people with cancer at one of eight anatomical sites, from 30 countries, whose tumour and optional non-tumour tissues, blood and harmonised demographic, lifestyle, environmental and clinical data were assembled between 2018 and 2022 under one protocol, to explain geographical and temporal differences in cancer incidence through mutational signature analysis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002738> (<http://www.ebi.ac.uk/coho/COHO_0002738>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37980563") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37980563") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10842852/fullTextXML") Annotation(rdfs:comment "Pancreatic tumor tissues from resected PDAC patients were collected at the University of Maryland Medical System (UMMS) in Baltimore, MD, through an NCI-UMD resource contract and at the University Medical Center Göttingen, Germany.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002738> "A cohort of patients with resected pancreatic ductal adenocarcinoma whose tumour tissues and clinical information were collected at the University of Maryland Medical System, Baltimore, United States, through a National Cancer Institute resource contract, and at the University Medical Center Göttingen, Germany.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37980563") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37980563") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10842852/fullTextXML") Annotation(rdfs:comment "Subsequently, we validated these candidate genes in our NCI-UMD-German cohort for their association with patient survival.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002738> "A cohort of patients with resected pancreatic ductal adenocarcinoma whose tumour tissues and clinical information were collected at the University of Maryland Medical System, Baltimore, United States, through a National Cancer Institute resource contract, and at the University Medical Center Göttingen, Germany.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002739> (<http://www.ebi.ac.uk/coho/COHO_0002739>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38016950") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38016950") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10684646/fullTextXML") Annotation(rdfs:comment "The trial was conducted at the Department of Neurology, Haukeland University Hospital, Bergen, Norway.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002739> "A single-centre, randomised, placebo-controlled, double-blind phase I trial at Haukeland University Hospital, Bergen, Norway, in which people with Parkinson's disease received 1,500 mg of nicotinamide riboside twice daily or placebo for four weeks, to evaluate the safety of high-dose nicotinamide riboside.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38016950") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38016950") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10684646/fullTextXML") Annotation(rdfs:comment "To evaluate the safety of high-dose NR therapy, we conducted a single-center, randomized, placebo-controlled, double-blind, phase I trial on 20 individuals with PD, randomized 1:1 on NR 1500 mg twice daily (n = 10) or placebo (n = 10) for four weeks.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002739> "A single-centre, randomised, placebo-controlled, double-blind phase I trial at Haukeland University Hospital, Bergen, Norway, in which people with Parkinson's disease received 1,500 mg of nicotinamide riboside twice daily or placebo for four weeks, to evaluate the safety of high-dose nicotinamide riboside.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002740> (<http://www.ebi.ac.uk/coho/COHO_0002740>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31138879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31138879") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6538605/fullTextXML") Annotation(rdfs:comment "From July 31st, 2015, to January 31st, 2018, all preterm infants born before 29 weeks GA and hospitalized in the neonatal intensive care unit of the Dijon University Hospital, Dijon, France, were included in the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002740> "A prospective cohort of all preterm infants born before 29 weeks of gestational age and admitted to the neonatal intensive care unit of Dijon University Hospital, France, between July 2015 and January 2018, whose erythrocyte polyunsaturated fatty acids were measured shortly after birth to evaluate their value in predicting retinopathy of prematurity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31138879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31138879") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6538605/fullTextXML") Annotation(rdfs:comment "In the OmegaROP prospective cohort study, we characterized the erythrocyte concentrations of PUFAs in preterm infants aged less than 29 weeks gestational age (GA) without any nutritional influence.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002740> "A prospective cohort of all preterm infants born before 29 weeks of gestational age and admitted to the neonatal intensive care unit of Dijon University Hospital, France, between July 2015 and January 2018, whose erythrocyte polyunsaturated fatty acids were measured shortly after birth to evaluate their value in predicting retinopathy of prematurity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31138879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31138879") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6538605/fullTextXML") Annotation(rdfs:comment "In the OmegaROP study, we wished to evaluate the prospective value of erythrocyte concentrations of n-3 and n-6 PUFAs for the development of ROP in preterm infants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002740> "A prospective cohort of all preterm infants born before 29 weeks of gestational age and admitted to the neonatal intensive care unit of Dijon University Hospital, France, between July 2015 and January 2018, whose erythrocyte polyunsaturated fatty acids were measured shortly after birth to evaluate their value in predicting retinopathy of prematurity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31138879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31138879") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6538605/fullTextXML") Annotation(rdfs:comment "The novelty of this study is that blood was sampled early in life in order to avoid any modification of the erythrocyte lipid status by the diet.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002740> "A prospective cohort of all preterm infants born before 29 weeks of gestational age and admitted to the neonatal intensive care unit of Dijon University Hospital, France, between July 2015 and January 2018, whose erythrocyte polyunsaturated fatty acids were measured shortly after birth to evaluate their value in predicting retinopathy of prematurity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002741> (<http://www.ebi.ac.uk/coho/COHO_0002741>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35534493") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35534493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML") Annotation(rdfs:comment "Biosamples, including blood, serum, plasma and urine were obtained from patients every 3 months for 18 months in the TACERA and Vaccine studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002741> "A UK industry-academic precision medicine partnership, funded by the Medical Research Council and the Association of the British Pharmaceutical Industry, that recruited a cohort of patients with early rheumatoid arthritis and a cohort of healthy people receiving the hepatitis B vaccine, followed for up to 18 months with deep clinical and multi-omic phenotyping, to find predictors of disease outcome and treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35534493") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35534493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML") Annotation(rdfs:comment "RA-MAP’s goals are to investigate clinical and biological predictors of disease outcome and treatment response in RA, using deep clinical and multi-omic phenotyping (Fig. 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002741> "A UK industry-academic precision medicine partnership, funded by the Medical Research Council and the Association of the British Pharmaceutical Industry, that recruited a cohort of patients with early rheumatoid arthritis and a cohort of healthy people receiving the hepatitis B vaccine, followed for up to 18 months with deep clinical and multi-omic phenotyping, to find predictors of disease outcome and treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35534493") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35534493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML") Annotation(rdfs:comment "The RA-MAP Consortium is a UK industry-academic precision medicine partnership funded by the Medical Research Council and the Association of the British Pharmaceutical Industry (ABPI).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002741> "A UK industry-academic precision medicine partnership, funded by the Medical Research Council and the Association of the British Pharmaceutical Industry, that recruited a cohort of patients with early rheumatoid arthritis and a cohort of healthy people receiving the hepatitis B vaccine, followed for up to 18 months with deep clinical and multi-omic phenotyping, to find predictors of disease outcome and treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35534493") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35534493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML") Annotation(rdfs:comment "To this end, we recruited a cohort of 267 early RA patients, and 52 healthy subjects receiving the hepatitis B vaccine.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002741> "A UK industry-academic precision medicine partnership, funded by the Medical Research Council and the Association of the British Pharmaceutical Industry, that recruited a cohort of patients with early rheumatoid arthritis and a cohort of healthy people receiving the hepatitis B vaccine, followed for up to 18 months with deep clinical and multi-omic phenotyping, to find predictors of disease outcome and treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35534493") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35534493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML") Annotation(rdfs:comment "We ultimately followed these patients longitudinally for up to 18 months, collecting rich bio-samples and a range of clinical and omic data on the genome, transcriptome, proteome, metabolome and autoantibodies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002741> "A UK industry-academic precision medicine partnership, funded by the Medical Research Council and the Association of the British Pharmaceutical Industry, that recruited a cohort of patients with early rheumatoid arthritis and a cohort of healthy people receiving the hepatitis B vaccine, followed for up to 18 months with deep clinical and multi-omic phenotyping, to find predictors of disease outcome and treatment response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002742> (<http://www.ebi.ac.uk/coho/COHO_0002742>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34707695") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35534493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML") Annotation(rdfs:comment "Patients were followed up for 18 months and seen every 3 months.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002742> "An inception cohort of newly diagnosed, initially treatment-naive patients with seropositive rheumatoid arthritis, recruited from 28 centres in the United Kingdom and assessed every three months for up to 18 months, established by the RA-MAP Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34707695") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35534493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML") Annotation(rdfs:comment "Subjects were recruited from 28 participating centres across the UK.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002742> "An inception cohort of newly diagnosed, initially treatment-naive patients with seropositive rheumatoid arthritis, recruited from 28 centres in the United Kingdom and assessed every three months for up to 18 months, established by the RA-MAP Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34707695") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35534493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML") Annotation(rdfs:comment "The “Towards A Cure for Early Rheumatoid Arthritis” (TACERA) study12 was designed to detect distinct disease subtypes and the immunological correlates of disease activity and autoimmunity in patients with early, seropositive RA, with a secondary objective to investigate biomarkers of initial drug response to methotrexate.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002742> "An inception cohort of newly diagnosed, initially treatment-naive patients with seropositive rheumatoid arthritis, recruited from 28 centres in the United Kingdom and assessed every three months for up to 18 months, established by the RA-MAP Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34707695") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35534493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9085807/fullTextXML") Annotation(rdfs:comment "newly diagnosed patients of at least 18 years of age with symptom duration less than 12 months, untreated with DMARDs or corticosteroids and who fulfilled either the 1987 American College of Rheumatology (ACR) or 2010 ACR/European League Against Rheumatism (EULAR) classification criteria for RA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002742> "An inception cohort of newly diagnosed, initially treatment-naive patients with seropositive rheumatoid arthritis, recruited from 28 centres in the United Kingdom and assessed every three months for up to 18 months, established by the RA-MAP Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002743> (<http://www.ebi.ac.uk/coho/COHO_0002743>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36577740") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36577740") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9925275/fullTextXML") Annotation(rdfs:comment "Between March 1998 and December 2002, all living twins in the registry aged >40 years (i.e. born in 1958 or earlier) were invited to participate in a computer-assisted telephone interview on demographics and health conditions as part of the Screening Across the Lifespan Twin (SALT) study (response rate: 72.6%).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002743> "A study in which all living twins in the Swedish Twin Registry born in 1958 or earlier were invited, between March 1998 and December 2002, to a computer-assisted telephone interview on demographics and health conditions, and whose participants were then followed for changes in health status.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36577740") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.cambridge.org/core/journals/twin-research-and-human-genetics/article/swedish-twin-registry-content-and-management-as-a-research-infrastructure/C22D50E7162D4A9F63706B2B4B84C75B") Annotation(rdfs:comment "A large nationwide effort to contact all available twins, including for the first time, opposite-sex pairs, was conducted between 1998 and 2002") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002743> "A study in which all living twins in the Swedish Twin Registry born in 1958 or earlier were invited, between March 1998 and December 2002, to a computer-assisted telephone interview on demographics and health conditions, and whose participants were then followed for changes in health status.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36577740") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.cambridge.org/core/journals/twin-research-and-human-genetics/article/swedish-twin-registry-content-and-management-as-a-research-infrastructure/C22D50E7162D4A9F63706B2B4B84C75B") Annotation(rdfs:comment "The project involved extensive data collection conducted over the telephone by trained interviewers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002743> "A study in which all living twins in the Swedish Twin Registry born in 1958 or earlier were invited, between March 1998 and December 2002, to a computer-assisted telephone interview on demographics and health conditions, and whose participants were then followed for changes in health status.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36577740") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8909720/fullTextXML") Annotation(rdfs:comment "An individual invitation was sent, between 1998 and 2002, to twins born before 1958 registered in the Swedish Twin Registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002743> "A study in which all living twins in the Swedish Twin Registry born in 1958 or earlier were invited, between March 1998 and December 2002, to a computer-assisted telephone interview on demographics and health conditions, and whose participants were then followed for changes in health status.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36577740") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8909720/fullTextXML") Annotation(rdfs:comment "Hospitalization due to IHD and stroke was determined by linking the personal identification number to the national in-patient and cause of death registers from the Swedish National Board of Health and Welfare") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002743> "A study in which all living twins in the Swedish Twin Registry born in 1958 or earlier were invited, between March 1998 and December 2002, to a computer-assisted telephone interview on demographics and health conditions, and whose participants were then followed for changes in health status.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36577740") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8909720/fullTextXML") Annotation(rdfs:comment "The SALT cohort is part of the Swedish Twin Registry managed by Karolinska Institutet and financially supported by the Swedish Research Council under grant 2017-00641.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002743> "A study in which all living twins in the Swedish Twin Registry born in 1958 or earlier were invited, between March 1998 and December 2002, to a computer-assisted telephone interview on demographics and health conditions, and whose participants were then followed for changes in health status.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002744> (<http://www.ebi.ac.uk/coho/COHO_0002744>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33292338") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33292338") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7667766/fullTextXML") Annotation(rdfs:comment "In total, 199 Asian Chinese and 158 European Caucasian participants were enrolled in the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002744> "A cross-sectional study at the Human Nutrition Unit of the University of Auckland, New Zealand, of Asian Chinese and European Caucasian adults aged 20 to 70 years across a wide range of body mass index, normoglycaemic or prediabetic, studying the greater susceptibility of Asian Chinese to visceral adiposity and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33292338") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33292338") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7667766/fullTextXML") Annotation(rdfs:comment "Our aims were: (i) characterise the ethnicity-specific metabolomic signature of visceral adiposity measured by dual energy X-ray absorptiometry (DXA) and fasting plasma glucose (FPG), and (ii) identify individuals susceptible to worse metabolic health outcomes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002744> "A cross-sectional study at the Human Nutrition Unit of the University of Auckland, New Zealand, of Asian Chinese and European Caucasian adults aged 20 to 70 years across a wide range of body mass index, normoglycaemic or prediabetic, studying the greater susceptibility of Asian Chinese to visceral adiposity and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33292338") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33292338") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7667766/fullTextXML") Annotation(rdfs:comment "Participants were recruited for both genders across a wide range of ages (20–70 years) and BMI (20–45 kg/m2), and were either normoglycaemic or prediabetic based on ADA criteria [36].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002744> "A cross-sectional study at the Human Nutrition Unit of the University of Auckland, New Zealand, of Asian Chinese and European Caucasian adults aged 20 to 70 years across a wide range of body mass index, normoglycaemic or prediabetic, studying the greater susceptibility of Asian Chinese to visceral adiposity and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33292338") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33292338") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7667766/fullTextXML") Annotation(rdfs:comment "The TOFI-Asia study is a cross-sectional study conducted at the Human Nutrition Unit (HNU), University of Auckland, New Zealand.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002744> "A cross-sectional study at the Human Nutrition Unit of the University of Auckland, New Zealand, of Asian Chinese and European Caucasian adults aged 20 to 70 years across a wide range of body mass index, normoglycaemic or prediabetic, studying the greater susceptibility of Asian Chinese to visceral adiposity and type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002745> (<http://www.ebi.ac.uk/coho/COHO_0002745>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://doi.org/10.1101/2025.10.16.25338140") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.medrxiv.org/content/early/2025/10/17/2025.10.16.25338140.source.xml") Annotation(rdfs:comment "Eligible participants were 18–65 years old with a body mass index (BMI) between 18.5 and 35 kg/m2, HbA1c < 42 mmoL/L, had access to a smart mobile phone with near field communication (NFC) technology, and resided in an area where online food deliveries could be made.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002745> "A randomised crossover pilot trial in which healthy adults ate two-week diets high or low in plant bioactives, with matched total fibre and separated by a four-week washout, to assess changes in the gut microbiome and in urinary and faecal metabolites.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://doi.org/10.1101/2025.10.16.25338140") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.medrxiv.org/content/early/2025/10/17/2025.10.16.25338140.source.xml") Annotation(rdfs:comment "In the Dietary BIoactives and Microbiome DivErsity (DIME) study we investigated the impact of a diet rich in a wide range of plant bioactives compared to a low bioactive diet with matched total fibre intake.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002745> "A randomised crossover pilot trial in which healthy adults ate two-week diets high or low in plant bioactives, with matched total fibre and separated by a four-week washout, to assess changes in the gut microbiome and in urinary and faecal metabolites.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://doi.org/10.1101/2025.10.16.25338140") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.medrxiv.org/content/early/2025/10/17/2025.10.16.25338140.source.xml") Annotation(rdfs:comment "This was a nine-week randomised, cross-over, pilot study where all visits were conducted remotely due to the national lockdown that was imposed because of the COVID-19 pandemic in 2020 (Figure 8).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002745> "A randomised crossover pilot trial in which healthy adults ate two-week diets high or low in plant bioactives, with matched total fibre and separated by a four-week washout, to assess changes in the gut microbiome and in urinary and faecal metabolites.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://doi.org/10.1101/2025.10.16.25338140") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.medrxiv.org/content/early/2025/10/17/2025.10.16.25338140.source.xml") Annotation(rdfs:comment "We conducted a randomised crossover intervention trial to assess alterations to the gut microbiome, urinary and faecal metabolites in 20 healthy subjects receiving two-week high- or low-bioactive diets, separated by a 4-week washout period.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002745> "A randomised crossover pilot trial in which healthy adults ate two-week diets high or low in plant bioactives, with matched total fibre and separated by a four-week washout, to assess changes in the gut microbiome and in urinary and faecal metabolites.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002746> (<http://www.ebi.ac.uk/coho/COHO_0002746>)

