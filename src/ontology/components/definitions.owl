AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001533") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41870278") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13320198/fullTextXML") Annotation(rdfs:comment "Using the IMMUcan multimodal-omics workflow, we analyzed 253 patients with R/M SCCHN, integrating genomic, transcriptomic, and immune profiling.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000279> "A cohort of patients with locally recurrent or metastatic squamous cell carcinoma of the head and neck receiving first-line immune checkpoint inhibitors, with or without chemotherapy, profiled by the IMMUcan consortium with multiplex imaging, mass cytometry and sequencing alongside longitudinal clinical data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001533") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000001533") Annotation(rdfs:comment "Cellular profiling of the same tumor samples was performed using multiplex immunofluorescence imaging, imaging mass cytometry, and H&E staining.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000279> "A cohort of patients with locally recurrent or metastatic squamous cell carcinoma of the head and neck receiving first-line immune checkpoint inhibitors, with or without chemotherapy, profiled by the IMMUcan consortium with multiplex imaging, mass cytometry and sequencing alongside longitudinal clinical data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001533") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000001533") Annotation(rdfs:comment "Comprehensive profiling data are integrated with longitudinally collected clinical information.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000279> "A cohort of patients with locally recurrent or metastatic squamous cell carcinoma of the head and neck receiving first-line immune checkpoint inhibitors, with or without chemotherapy, profiled by the IMMUcan consortium with multiplex imaging, mass cytometry and sequencing alongside longitudinal clinical data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001533") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000001533") Annotation(rdfs:comment "This cohort includes patients with confirmed locally recurrent and/or metastatic squamous cell carcinoma of the head and neck (SCCHN) who receive first-line treatment with immune checkpoint inhibitors (ICI) or ICI combined with chemotherapy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000279> "A cohort of patients with locally recurrent or metastatic squamous cell carcinoma of the head and neck receiving first-line immune checkpoint inhibitors, with or without chemotherapy, profiled by the IMMUcan consortium with multiplex imaging, mass cytometry and sequencing alongside longitudinal clinical data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000280> (<http://www.ebi.ac.uk/coho/COHO_0000280>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001393") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41917006") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13201634/fullTextXML") Annotation(rdfs:comment "450 patients with different systemic autoinflammatory disorders (SAID) and healthy controls were enrolled from 30 clinical centers throughout Europe and Turkey, to assure a broad inclusion of SAID subtypes and a sufficient number of individuals for rare diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000280> "A multicentre cohort of patients with systemic autoinflammatory diseases recruited across several European cohorts by the ImmunAID Horizon 2020 project, with integrated immunological and molecular data to identify diagnostic biomarkers and disease pathways.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001393") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000001393") Annotation(rdfs:comment "Its objective is to identify biomarkers and biological pathways that characterize disease mechanisms and help differentiate between inflammatory conditions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000280> "A multicentre cohort of patients with systemic autoinflammatory diseases recruited across several European cohorts by the ImmunAID Horizon 2020 project, with integrated immunological and molecular data to identify diagnostic biomarkers and disease pathways.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001393") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000001393") Annotation(rdfs:comment "The ImmunAID study is a multi-center research program aimed at improving the diagnosis and understanding of systemic autoinflammatory diseases. The study integrates immunological, and molecular data from patients across several European cohorts.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000280> "A multicentre cohort of patients with systemic autoinflammatory diseases recruited across several European cohorts by the ImmunAID Horizon 2020 project, with integrated immunological and molecular data to identify diagnostic biomarkers and disease pathways.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001393") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000001393") Annotation(rdfs:comment "This project has received funding from the European Union’s Horizon 2020 research and innovation programme under grant agreement No 779295.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000280> "A multicentre cohort of patients with systemic autoinflammatory diseases recruited across several European cohorts by the ImmunAID Horizon 2020 project, with integrated immunological and molecular data to identify diagnostic biomarkers and disease pathways.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000281> (<http://www.ebi.ac.uk/coho/COHO_0000281>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004964") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33742104") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33742104+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Herein, we report an interim analysis of IMPACT2, an ongoing randomized study evaluating genomic profiling and targeted agents in metastatic cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000281> "A cohort of patients with metastatic cancer who underwent tumour genomic profiling in IMPACT2, a randomised study at MD Anderson Cancer Center evaluating genomic profiling and matched targeted therapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004964") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33742104") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33742104+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Patients with metastatic cancer underwent tumor genomic profiling (ClinialTrials.gov: NCT02152254), and 69 patients met the criteria for randomization.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000281> "A cohort of patients with metastatic cancer who underwent tumour genomic profiling in IMPACT2, a randomised study at MD Anderson Cancer Center evaluating genomic profiling and matched targeted therapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004964") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41963611") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13265806/fullTextXML") Annotation(rdfs:comment "The applicable study protocol with assigned number PA12-1161 was approved by the Institutional Review Board at The University of Texas MD Anderson Cancer Center on May 13, 2014 (Registration Number: IRB 1 IRB00000121) and was registered on ClinicalTrials.gov (NCT02152254).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000281> "A cohort of patients with metastatic cancer who underwent tumour genomic profiling in IMPACT2, a randomised study at MD Anderson Cancer Center evaluating genomic profiling and matched targeted therapy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000282> (<http://www.ebi.ac.uk/coho/COHO_0000282>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001651") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32025007") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC7025898") Annotation(rdfs:comment "Data and metadata were collected from International Cancer Genome Consortium (ICGC) consortium members using custom software packages designed by the ICGC Data Coordinating Centre.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000282> "An international consortium of cancer genome projects, each characterising the somatic and germline genomes of a tumour type in a defined population, that coordinates the projects' data and analyses, including the Pan-Cancer Analysis of Whole Genomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001651") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32025007") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7025898/fullTextXML") Annotation(rdfs:comment "A Technical Working Group implemented the informatics analyses by aggregating the raw sequencing data from different working groups that studied individual tumour types, aligning the sequences to the human genome and delivering a set of high-quality somatic mutation calls for downstream analysis (Extended Data Fig. 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000282> "An international consortium of cancer genome projects, each characterising the somatic and germline genomes of a tumour type in a defined population, that coordinates the projects' data and analyses, including the Pan-Cancer Analysis of Whole Genomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001651") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32025007") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7025898/fullTextXML") Annotation(rdfs:comment "In 2008, recognizing the opportunity that this advance in technology provided, the global cancer genomics community established the ICGC with the goal of systematically documenting the somatic mutations that drive common tumour types") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000282> "An international consortium of cancer genome projects, each characterising the somatic and germline genomes of a tumour type in a defined population, that coordinates the projects' data and analyses, including the Pan-Cancer Analysis of Whole Genomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001651") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32025007") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32025007+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Here we report the integrative analysis of 2,658 whole-cancer genomes and their matching normal tissues across 38 tumour types from the Pan-Cancer Analysis of Whole Genomes (PCAWG) Consortium of the International Cancer Genome Consortium (ICGC) and The Cancer Genome Atlas (TCGA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000282> "An international consortium of cancer genome projects, each characterising the somatic and germline genomes of a tumour type in a defined population, that coordinates the projects' data and analyses, including the Pan-Cancer Analysis of Whole Genomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000283> (<http://www.ebi.ac.uk/coho/COHO_0000283>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005110") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33958783") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8459648/") Annotation(rdfs:comment "To avoid overfitting, we tested the performance of the pre-specified polygenic hazard score (PHS) score in 520 patients from three, independent cohorts with detailed longitudinal clinical phenotyping, De Novo Parkinson Cohort (DeNoPa)73, EPIPARK74, and HBS2 (Supplementary Table 1), from Germany and the US.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000283> "A consortium of longitudinal Parkinson's disease cohorts, including EPIPARK and the Harvard Biomarkers Study, that pools prospectively followed patients for genome-wide survival studies of progression to dementia and other outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005110") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001005110") Annotation(rdfs:comment "11.2 million deeply imputed variants in 3,821 PD patients who were prospectively tracked with 36,123 visits over a median of 6.7 years from disease onset (inter-quartile range, 4.2 years) were analyzed.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000283> "A consortium of longitudinal Parkinson's disease cohorts, including EPIPARK and the Harvard Biomarkers Study, that pools prospectively followed patients for genome-wide survival studies of progression to dementia and other outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005110") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001005110") Annotation(rdfs:comment "To characterize how genetic variation influences the progression of Parkinson’s disease to dementia, which is a major determinant for quality of life, we performed a longitudinal genome-wide survival study (GWSS). Risk profile analysis was performed with a novel polygenic hazard score in longitudinal cohorts in the International Genetics of Parkinson Disease Progression (IGPP) Consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000283> "A consortium of longitudinal Parkinson's disease cohorts, including EPIPARK and the Harvard Biomarkers Study, that pools prospectively followed patients for genome-wide survival studies of progression to dementia and other outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005110") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5244667/fullTextXML") Annotation(rdfs:comment "The study names are Harvard Biomarkers Study (HBS)10, 21, 22; Deprenyl and Tocopherol Antioxidative Therapy of Parkinsonism (DATATOP)15, 23;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000283> "A consortium of longitudinal Parkinson's disease cohorts, including EPIPARK and the Harvard Biomarkers Study, that pools prospectively followed patients for genome-wide survival studies of progression to dementia and other outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000284> (<http://www.ebi.ac.uk/coho/COHO_0000284>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002548") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14685227") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1038/nature02168") Annotation(rdfs:comment "The CEPH samples are available from the non-profit Coriell Institute of Medical Research (http://locus.umdnj.edu/nigms/); cell lines and DNA from the new samples will be available from Coriell in early 2004 for future studies with research protocols approved by appropriate ethics committees.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000284> "A collection of DNA samples and cell lines from populations of African, Asian and European ancestry assembled by the International HapMap Project to map common patterns of human genetic variation, which serves as a reference panel and control set for genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002548") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14685227") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1038/nature02168") Annotation(rdfs:comment "The project will study a total of 270 DNA samples: 90 samples (see Supplementary Information, part 1) from a US Utah population with Northern and Western European ancestry (samples collected in 1980 by the Centre d'Etude du Polymorphisme Humain (CEPH)49 and used for other human genetic maps, 30 trios of two parents and an adult child), and new samples collected from 90 Yoruba people in Ibadan, Nigeria (30 trios), 45 unrelated Japanese in Tokyo, Japan, and 45 unrelated Han Chinese in Beijing, China.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000284> "A collection of DNA samples and cell lines from populations of African, Asian and European ancestry assembled by the International HapMap Project to map common patterns of human genetic variation, which serves as a reference panel and control set for genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002548") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14685227") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14685227+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The goal of the International HapMap Project is to determine the common patterns of DNA sequence variation in the human genome and to make this information freely available in the public domain.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000284> "A collection of DNA samples and cell lines from populations of African, Asian and European ancestry assembled by the International HapMap Project to map common patterns of human genetic variation, which serves as a reference panel and control set for genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002548") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20811451") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3173859") Annotation(rdfs:comment "For common SNPs (MAF ≥5%), the larger HapMap 3 reference panel made only a slight difference to the already excellent performance (mean r2 increased from 0.946 to 0.961).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000284> "A collection of DNA samples and cell lines from populations of African, Asian and European ancestry assembled by the International HapMap Project to map common patterns of human genetic variation, which serves as a reference panel and control set for genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002548") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-019-1310-4/MediaObjects/41586_2019_1310_MOESM1_ESM.pdf") Annotation(rdfs:comment "There were 548 HapMap genotyping control samples, and 342 1,001 blind study duplicate samples.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000284> "A collection of DNA samples and cell lines from populations of African, Asian and European ancestry assembled by the International HapMap Project to map common patterns of human genetic variation, which serves as a reference panel and control set for genetic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000285> (<http://www.ebi.ac.uk/coho/COHO_0000285>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001266") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33239696") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC7688949") Annotation(rdfs:comment "Research leading to these results was conducted as part of the InterPregGen study, which received funding from the European Union Seventh Framework Programme under grant agreement no. 282540 and was supported by Wellcome Trust grant 098051.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000285> "A consortium funded under the European Seventh Framework Programme that grew out of the WTCCC3 pre-eclampsia GWAS and combines maternal and fetal pre-eclampsia case-control collections from Europe and Central Asia for genome-wide meta-analyses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001266") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001001266") Annotation(rdfs:comment "(a) GWAS case-control meta-analysis of maternal PE cases from Europe (UK, Iceland, Norway, Denmark, Finland) and Central Asia (Kazakhstan, Uzbekistan); (b) GWAS case-control meta-analysis of PE fetal (baby) cases from Europe (UK, Iceland, Norway, Denmark) and Central Asia (Kazakhstan, Uzbekistan)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000285> "A consortium funded under the European Seventh Framework Programme that grew out of the WTCCC3 pre-eclampsia GWAS and combines maternal and fetal pre-eclampsia case-control collections from Europe and Central Asia for genome-wide meta-analyses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001266") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001001266") Annotation(rdfs:comment "The InterPregGen Consortium was funded by a European Framework 7 (FP7) grant and grew out of the WTCCC3 GWAS comparing ~2000 UK PE mothers with ~6000 common UK controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000285> "A consortium funded under the European Seventh Framework Programme that grew out of the WTCCC3 pre-eclampsia GWAS and combines maternal and fetal pre-eclampsia case-control collections from Europe and Central Asia for genome-wide meta-analyses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000286> (<http://www.ebi.ac.uk/coho/COHO_0000286>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007580") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38626723") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11020240/fullTextXML") Annotation(rdfs:comment "Here, we present the second phase of the Korean Genome Project (KGP) with 4,157 sets of whole genome data, Korea4K.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000286> "A cohort of Koreans whose whole genomes are sequenced by the Korean Genome Project, 4,157 of whom form the Korea4K resource, with 107 health check-up parameters available for 2,685 of them for genome-phenome association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007580") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38626723") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11020240/fullTextXML") Annotation(rdfs:comment "Korea4K contains 4,157 Korean genomes from East Asian ancestry, and 2,685 of them are accompanied by 107 types of clinical information such as height, waist circumference, weight, albumin/globulin ratio, basophil, direct bilirubin, low-density lipoprotein, high-density lipoprotein, mean corpuscular volume, and total cholesterol.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000286> "A cohort of Koreans whose whole genomes are sequenced by the Korean Genome Project, 4,157 of whom form the Korea4K resource, with 107 health check-up parameters available for 2,685 of them for genome-phenome association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007580") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38626723") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11020240/fullTextXML") Annotation(rdfs:comment "One of the main objectives of the Korea4K project was to build a genomic and phenomic reference dataset to discover unknown whole genome-to-phenome associations that can be detected from samples of healthy people.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000286> "A cohort of Koreans whose whole genomes are sequenced by the Korean Genome Project, 4,157 of whom form the Korea4K resource, with 107 health check-up parameters available for 2,685 of them for genome-phenome association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000287> (<http://www.ebi.ac.uk/coho/COHO_0000287>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001704") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26319774") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4554905/fullTextXML") Annotation(rdfs:comment "A subset of approximately 1500 LifeLines participants also take part in LifeLines DEEP.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000287> "A sub-cohort of approximately 1,500 LifeLines participants from the northern Netherlands who provided additional biological materials, including gut microbiome samples, for multi-omic investigation of the factors that contribute to health and disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001704") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26319774") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4554905/fullTextXML") Annotation(rdfs:comment "From these participants, we collected additional blood for genetics, methylation and transcriptomics analyses (n=1387); exhaled air for analysis of volatile organic compounds (n=1425); and faecal samples for microbiome and biomarker assessment (n=1248; table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000287> "A sub-cohort of approximately 1,500 LifeLines participants from the northern Netherlands who provided additional biological materials, including gut microbiome samples, for multi-omic investigation of the factors that contribute to health and disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001704") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26319774") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4554905/fullTextXML") Annotation(rdfs:comment "These multiple data levels will provide rich opportunities for future research into the molecular underpinnings of human health and disease, as well as for research into the interaction between molecular and environmental components including behaviour, sociodemographic factors and analysis of specific subgroups.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000287> "A sub-cohort of approximately 1,500 LifeLines participants from the northern Netherlands who provided additional biological materials, including gut microbiome samples, for multi-omic investigation of the factors that contribute to health and disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001704") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26319774") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4554905/fullTextXML") Annotation(rdfs:comment "This paper describes the design and baseline characteristics of an intensively examined subpopulation of the LifeLines cohort in the Netherlands.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000287> "A sub-cohort of approximately 1,500 LifeLines participants from the northern Netherlands who provided additional biological materials, including gut microbiome samples, for multi-omic investigation of the factors that contribute to health and disease.")

