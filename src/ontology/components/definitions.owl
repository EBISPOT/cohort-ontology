AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24069324") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25261932") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26340796") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24069324") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3775730/fullTextXML") Annotation(rdfs:comment "The New South Wales (NSW) study is a population-based case-control study of NHL cases (20-74 years old) identified in NSW or the Australian Capital Territory (ACT) between 2000 and 2001 and matched controls randomly selected from the NSW and ACT electoral rolls [24].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002187> "A population-based case-control study of non-Hodgkin lymphoma in adults aged 20–74 years in New South Wales and the Australian Capital Territory, Australia, whose cases were diagnosed in 2000–2001 and identified through the New South Wales or Australian Capital Territory cancer registries (excluding people with HIV infection and transplant recipients), and whose controls were randomly selected from the electoral rolls and frequency-matched on age, sex and state or territory of residence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24069324") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25261932") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26340796") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25261932") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3105/MediaObjects/41588_2014_BFng3105_MOESM22_ESM.pdf") Annotation(rdfs:comment "Incident NHL diagnosis identified through NSW or ACT cancer registry (excluding HIV-infected cases and transplant recipients) Controls randomly selected from electoral rolls, matched on age, sex and State of residence at diagnosis") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002187> "A population-based case-control study of non-Hodgkin lymphoma in adults aged 20–74 years in New South Wales and the Australian Capital Territory, Australia, whose cases were diagnosed in 2000–2001 and identified through the New South Wales or Australian Capital Territory cancer registries (excluding people with HIV infection and transplant recipients), and whose controls were randomly selected from the electoral rolls and frequency-matched on age, sex and state or territory of residence.")
