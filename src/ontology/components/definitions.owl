AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24722645") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24722645") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3983188/fullTextXML") Annotation(rdfs:comment "Briefly, the design was a hospital-based case-control study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000815> "A hospital-based case-control study of bladder cancer among men resident in the province of Brescia, northern Italy, with newly diagnosed cases admitted to the urology departments of the two main Brescia hospitals in 1997–2000 and controls with non-neoplastic urological diseases, used to study occupational, environmental and genetic risk factors for bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24722645") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24722645") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3983188/fullTextXML") Annotation(rdfs:comment "The cases were 201 newly diagnosed, histologically confirmed BC patients, admitted in the Urology Departments of the two main hospitals of Brescia from July 1997 to December 2000.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000815> "A hospital-based case-control study of bladder cancer among men resident in the province of Brescia, northern Italy, with newly diagnosed cases admitted to the urology departments of the two main Brescia hospitals in 1997–2000 and controls with non-neoplastic urological diseases, used to study occupational, environmental and genetic risk factors for bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24722645") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24722645") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3983188/fullTextXML") Annotation(rdfs:comment "The controls were 214 patients affected by various urological non-neoplastic diseases, frequency matched to cases by age (±5 years), period and hospital of admission.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000815> "A hospital-based case-control study of bladder cancer among men resident in the province of Brescia, northern Italy, with newly diagnosed cases admitted to the urology departments of the two main Brescia hospitals in 1997–2000 and controls with non-neoplastic urological diseases, used to study occupational, environmental and genetic risk factors for bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24722645") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24722645") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3983188/fullTextXML") Annotation(rdfs:comment "The inclusion criteria were being male, aged between 20 and 80, resident in the Brescia province (Northern Italy).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000815> "A hospital-based case-control study of bladder cancer among men resident in the province of Brescia, northern Italy, with newly diagnosed cases admitted to the urology departments of the two main Brescia hospitals in 1997–2000 and controls with non-neoplastic urological diseases, used to study occupational, environmental and genetic risk factors for bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24722645") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24722645") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3983188/fullTextXML") Annotation(rdfs:comment "We previously assessed the interaction between occupational and environmental exposures with metabolic and DNA-repair polymorphisms on the risk of BC in retrospective hospital based case-control study [18]–[22].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000815> "A hospital-based case-control study of bladder cancer among men resident in the province of Brescia, northern Italy, with newly diagnosed cases admitted to the urology departments of the two main Brescia hospitals in 1997–2000 and controls with non-neoplastic urological diseases, used to study occupational, environmental and genetic risk factors for bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000816> (<http://www.ebi.ac.uk/coho/COHO_0000816>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19426355") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25347072") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19426355") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19426355+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Participants underwent a series of examinations including: refractometry; pneumotonometry; biomicroscopy assisted by slit-lamp; optical coherence tomography of the anterior segment; photography of the cornea, lens, optic disc, macula and fundus; blood sampling for laboratory tests; blood pressure measurements, and determinations of anthropomorphic parameters.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000816> "A population-based study of 4439 adults aged 40 years or over living in Greater Beijing, China, first examined in 2001 and re-examined in 2006 and 2011 with detailed ophthalmic and general examinations, to measure the frequency of eye diseases and visual impairment and their associated and risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19426355") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25347072") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19426355") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19426355+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Beijing Eye Study is a population-based study which included 4439 of 5324 subjects (aged > or = 40 years) who were initially examined in 2001.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000816> "A population-based study of 4439 adults aged 40 years or over living in Greater Beijing, China, first examined in 2001 and re-examined in 2006 and 2011 with detailed ophthalmic and general examinations, to measure the frequency of eye diseases and visual impairment and their associated and risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19426355") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25347072") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19426355") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19426355+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We present normative data for refractive error, anterior segment measurements, intraocular pressure and optic disc structures and their associations, frequency and causes of visual impairment, blindness and visual field defects, prevalences of trachoma, pterygia, open-angle glaucoma and angle-closure glaucoma") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000816> "A population-based study of 4439 adults aged 40 years or over living in Greater Beijing, China, first examined in 2001 and re-examined in 2006 and 2011 with detailed ophthalmic and general examinations, to measure the frequency of eye diseases and visual impairment and their associated and risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19426355") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25347072") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25347072") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4210166/fullTextXML") Annotation(rdfs:comment "In 2006 and 2011, the study was repeated by inviting all participants from the survey of 2001.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000816> "A population-based study of 4439 adults aged 40 years or over living in Greater Beijing, China, first examined in 2001 and re-examined in 2006 and 2011 with detailed ophthalmic and general examinations, to measure the frequency of eye diseases and visual impairment and their associated and risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19426355") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25347072") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25347072") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4210166/fullTextXML") Annotation(rdfs:comment "The Beijing Eye Study is a population-based prospective cohort study in Greater Beijing that started in 2001 at baseline.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000816> "A population-based study of 4439 adults aged 40 years or over living in Greater Beijing, China, first examined in 2001 and re-examined in 2006 and 2011 with detailed ophthalmic and general examinations, to measure the frequency of eye diseases and visual impairment and their associated and risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19426355") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25347072") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25347072") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25347072+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To assess the cumulative 10-year incidence of diabetic retinopathy (DR) and its associated factors in a population living in Greater Beijing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000816> "A population-based study of 4439 adults aged 40 years or over living in Greater Beijing, China, first examined in 2001 and re-examined in 2006 and 2011 with detailed ophthalmic and general examinations, to measure the frequency of eye diseases and visual impairment and their associated and risk factors.")

