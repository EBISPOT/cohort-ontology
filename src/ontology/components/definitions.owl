AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30158200") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2249/MediaObjects/41588_2012_BFng2249_MOESM26_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30158200") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6113773/fullTextXML") Annotation(rdfs:comment "Prevalence of osteoporosis in Slovenia (Slo-preval): was created as part of projects financially supported by the Slovenian research agency:") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002392> "A cross-sectional, population-based study of osteoporosis in Ljubljana, Slovenia, created within projects funded by the Slovenian Research Agency, that included premenopausal women aged 35 to 50 years and postmenopausal women and men aged over 50 years in order to carry out genotype-phenotype association studies; it was one of the studies de novo genotyped for the replication stage of the 2012 GEFOS genome-wide meta-analysis of bone mineral density and fracture.")

