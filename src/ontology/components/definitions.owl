AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000048") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25262651") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4185114/") Annotation(rdfs:comment "Probands recruited through the EuroEPINOMICS-RES consortium for the project on nonlesional epileptic spasms (NLES) were enrolled by clinical sites in 18 different European countries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000253> "A European Science Foundation research networking programme of epilepsy genetics groups whose member sites contribute patients with epilepsy and related paroxysmal neurological disorders, mostly with a strong family history, to joint sequencing studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000048") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25262651") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4185114/") Annotation(rdfs:comment "Through a collaboration between two consortia (EuroEPINOMICS and Epi4K/EPGP), we analyzed exome-sequencing data of 356 trios with the “classical” epileptic encephalopathies, infantile spasms and Lennox Gastaut syndrome, including 264 trios previously analyzed by the Epi4K/EPGP consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000253> "A European Science Foundation research networking programme of epilepsy genetics groups whose member sites contribute patients with epilepsy and related paroxysmal neurological disorders, mostly with a strong family history, to joint sequencing studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000048") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26613940") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4693503/") Annotation(rdfs:comment "the Eurocores program EuroEPINOMICS of the European Science Foundation (ESF)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000253> "A European Science Foundation research networking programme of epilepsy genetics groups whose member sites contribute patients with epilepsy and related paroxysmal neurological disorders, mostly with a strong family history, to joint sequencing studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000048") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000048") Annotation(rdfs:comment "We are sequencing the exomes of patients with paroxysmal neurological disorders mainly focusing on migraine and epilepsy. Cases are collected from performance sites of members of the International Headache Genetics consortium and EuroEPINOMICS. Most cases have a strong family history.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000253> "A European Science Foundation research networking programme of epilepsy genetics groups whose member sites contribute patients with epilepsy and related paroxysmal neurological disorders, mostly with a strong family history, to joint sequencing studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000254> (<http://www.ebi.ac.uk/coho/COHO_0000254>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41310616") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12670801/fullTextXML") Annotation(rdfs:comment "Five milliliters of peripheral blood was collected and frozen according to a standardized protocol in two PAXgene Blood RNA tubes (BD Biosciences, USA) for each participant.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000254> "A multicentre European cohort of 1,209 patients with acute coronary syndrome, chronic coronary artery disease, dilated cardiomyopathy or ischaemic cardiomyopathy and 848 controls, whose circulating microRNA profiles were measured to evaluate disease classification and prognosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41310616") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12670801/fullTextXML") Annotation(rdfs:comment "Two thousand fifty seven participants were enrolled from 11 major centers across Europe from 2013 to 2017.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000254> "A multicentre European cohort of 1,209 patients with acute coronary syndrome, chronic coronary artery disease, dilated cardiomyopathy or ischaemic cardiomyopathy and 848 controls, whose circulating microRNA profiles were measured to evaluate disease classification and prognosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001008346") Annotation(rdfs:comment "This study evaluates the potential of miRNA expression profiles to inform disease classification and risk stratification across major CVD phenotypes, including acute coronary syndrome (ACS), chronic coronary artery disease (CAD), dilated cardiomyopathy (DCM), and ischemic cardiomyopathy (ICM), in a large, multicenter European cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000254> "A multicentre European cohort of 1,209 patients with acute coronary syndrome, chronic coronary artery disease, dilated cardiomyopathy or ischaemic cardiomyopathy and 848 controls, whose circulating microRNA profiles were measured to evaluate disease classification and prognosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001008346") Annotation(rdfs:comment "We assessed genome-wide miRNA expression profiles in a total of 1,209 cardiovascular patients and 848 controls in a uniform, standardized fashion, which renders this study one of the largest prospective miRNA studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000254> "A multicentre European cohort of 1,209 patients with acute coronary syndrome, chronic coronary artery disease, dilated cardiomyopathy or ischaemic cardiomyopathy and 848 controls, whose circulating microRNA profiles were measured to evaluate disease classification and prognosis.")

