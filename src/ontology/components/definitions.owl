AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22968678") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24687169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22968678") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3464381/") Annotation(rdfs:comment "The Glycometabolic Intervention as adjunct to Primary percutaneous intervention in ST elevation myocardial infarction (GIPS)-III trial is a prospective, single center, double blind, randomized, placebo-controlled trial.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002707> "A single-centre, double-blind, randomized, placebo-controlled trial at the University Medical Center Groningen, the Netherlands, that recruited patients without diabetes undergoing primary percutaneous coronary intervention for ST-segment elevation myocardial infarction in 2011–2013, to test whether four months of metformin treatment preserved left ventricular function.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22968678") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24687169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24687169") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24687169+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Double-blind, placebo-controlled study conducted among 380 patients who underwent primary percutaneous coronary intervention (PCI) for STEMI at the University Medical Center Groningen, The Netherlands, between January 1, 2011, and May 26, 2013.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002707> "A single-centre, double-blind, randomized, placebo-controlled trial at the University Medical Center Groningen, the Netherlands, that recruited patients without diabetes undergoing primary percutaneous coronary intervention for ST-segment elevation myocardial infarction in 2011–2013, to test whether four months of metformin treatment preserved left ventricular function.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002708> (<http://www.ebi.ac.uk/coho/COHO_0002708>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23263487") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24836286") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35765848") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24836286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "Briefly, 728 cases and 728 matched controls in these two studies were identified from among participants of the Shanghai Women’s Health Study (SWHS) 2 and the Shanghai Men’s Health Study (SMHS) 3 , two population-based cohort studies conducted in Shanghai, China, with a combined sample size of 136,631 participants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002708> "A population-based colorectal cancer case-control collection in Shanghai, China, assembled for genetic studies in the Asia Colorectal Cancer Consortium from the Shanghai-1, Shanghai-2 and Shanghai-3 sample series. The early series include colorectal cancer cases and cancer-free controls from the Shanghai Women’s Health Study and Shanghai Men’s Health Study, with additional controls from Shanghai breast cancer studies; Shanghai-3 includes colorectal cancer cases newly recruited through the Shanghai Cancer Registry in 2009–2011, with controls from the health cohorts and breast cancer studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23263487") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24836286") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35765848") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24836286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "Controls in Shanghai-3 were cancer-free men and women identified from among SWHS and SMHS participants (n = 1,277).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002708> "A population-based colorectal cancer case-control collection in Shanghai, China, assembled for genetic studies in the Asia Colorectal Cancer Consortium from the Shanghai-1, Shanghai-2 and Shanghai-3 sample series. The early series include colorectal cancer cases and cancer-free controls from the Shanghai Women’s Health Study and Shanghai Men’s Health Study, with additional controls from Shanghai breast cancer studies; Shanghai-3 includes colorectal cancer cases newly recruited through the Shanghai Cancer Registry in 2009–2011, with controls from the health cohorts and breast cancer studies.")
