AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19404752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19404752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19404752+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Measurements in progress include profiling of candidate biochemical factors, assay of 45,000 variants in 2,100 candidate genes, and a genomewide association scan of over 650,000 genetic markers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000169> "A case-control collection of adults aged 30–80 in Pakistan with a first confirmed acute myocardial infarction and matched controls, assembled to investigate genetic, lifestyle and biochemical determinants of coronary heart disease in South Asia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19404752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19404752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19404752+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Pakistan Risk of Myocardial Infarction Study (PROMIS) is an epidemiological resource to enable reliable study of genetic, lifestyle and other determinants of CHD in South Asia.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000169> "A case-control collection of adults aged 30–80 in Pakistan with a first confirmed acute myocardial infarction and matched controls, assembled to investigate genetic, lifestyle and biochemical determinants of coronary heart disease in South Asia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19404752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2480/MediaObjects/41588_2013_BFng2480_MOESM9_ESM.pdf") Annotation(rdfs:comment "PROMIS (The Pakistan Risk Of Myocardial Infarction Study) is an ongoing case‐control study of acute myocardial infarction (MI) in urban Pakistan, which by mid‐2009 included 5,500 MI cases and 5,500 controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000169> "A case-control collection of adults aged 30–80 in Pakistan with a first confirmed acute myocardial infarction and matched controls, assembled to investigate genetic, lifestyle and biochemical determinants of coronary heart disease in South Asia.")

