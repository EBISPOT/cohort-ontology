AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35080193") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37060189") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pbcar.healthsci.mcmaster.ca/research/projects/population-assessment-for-tomorrows-health-study-path/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37060189") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10242187/fullTextXML") Annotation(rdfs:comment "Participants were from an existing research registry at St. Joseph's Healthcare Hamilton in which community adults were invited to participate in an in‐person assessment including DNA collection.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000657> "A research registry of community volunteers aged 18 to 65 living in the Greater Hamilton area, with or without addiction problems, run by the Peter Boris Centre for Addictions Research at St. Joseph's Healthcare Hamilton, whose participants completed questionnaires, simple physical measurements and an in-person assessment and gave saliva for DNA genotyping through 23andMe, to build a cohort for research on the causes, consequences and treatment of addiction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35080193") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37060189") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pbcar.healthsci.mcmaster.ca/research/projects/population-assessment-for-tomorrows-health-study-path/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37060189") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10242187/fullTextXML") Annotation(rdfs:comment "Two thousand and ninety‐eight participants were genotyped on Illumina Infinium® Global Screening Array as a membership service from 23andMe Inc; imputation was performed using the Michigan Imputation Server.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000657> "A research registry of community volunteers aged 18 to 65 living in the Greater Hamilton area, with or without addiction problems, run by the Peter Boris Centre for Addictions Research at St. Joseph's Healthcare Hamilton, whose participants completed questionnaires, simple physical measurements and an in-person assessment and gave saliva for DNA genotyping through 23andMe, to build a cohort for research on the causes, consequences and treatment of addiction.")
