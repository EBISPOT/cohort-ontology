AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16801592") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21646370") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2798726/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16801592") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16801592+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A total of 550 subjects with increased risk of type 2 diabetes were investigated; they underwent a 75-g oral glucose tolerance test, repeated after 3 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000705> "A German study run from the Technical University of Dresden, with participants from Saxony, of people at increased risk of type 2 diabetes who had a 75-g oral glucose tolerance test at baseline and again after about three years, which also contributed patients with type 2 diabetes and controls to consortium genetic studies of type 2 diabetes and glycaemic traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16801592") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21646370") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2798726/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21646370") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A21646370+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Each subject received a 75-g oral glucose tolerance test at baseline and 624 received a repeat oral glucose tolerance test after 3.5 ± 0.1 yr of follow-up.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000705> "A German study run from the Technical University of Dresden, with participants from Saxony, of people at increased risk of type 2 diabetes who had a 75-g oral glucose tolerance test at baseline and again after about three years, which also contributed patients with type 2 diabetes and controls to consortium genetic studies of type 2 diabetes and glycaemic traits.")
