# Individual: <http://www.ebi.ac.uk/coho/COHO_0000873> (<http://www.ebi.ac.uk/coho/COHO_0000873>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20565774") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000873> "A population-based biobank cohort of about 20,000 adults living in 19 zip codes around Marshfield, Wisconsin, United States, recruited by the Marshfield Clinic from 2002, who provided DNA, serum and plasma samples linked to their electronic medical records for genetic and gene–environment research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000874> (<http://www.ebi.ac.uk/coho/COHO_0000874>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18385676") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000874> "A hospital-based case–control study of lung cancer at The University of Texas MD Anderson Cancer Center in Houston, Texas, of ever-smoking patients of European ancestry and frequency-matched ever-smoking controls, genotyped genome-wide to find lung cancer susceptibility loci and later pooled in international lung cancer consortia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000875> (<http://www.ebi.ac.uk/coho/COHO_0000875>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21926416") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000875> "A hospital-based case–control study of cutaneous melanoma at The University of Texas MD Anderson Cancer Center, with non-Hispanic white patients and cancer-free controls (friends or acquaintances accompanying patients) recruited between 1998 and 2008, genotyped genome-wide to find melanoma susceptibility loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000876> (<http://www.ebi.ac.uk/coho/COHO_0000876>)

