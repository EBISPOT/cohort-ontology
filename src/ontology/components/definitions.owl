AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32469308") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33408146") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39528825") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32469308") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7259949/fullTextXML") Annotation(rdfs:comment "We recruited widely in the bay area through ads in newspapers, newsletters, and online (e.g., Facebook), with the following inclusion criteria: native English speaking, right-handed, and MRI compatible.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002339> "A longitudinal study of healthy ageing at Stanford University in which cognitively unimpaired older adults, recruited through advertisements in the Bay Area, undergo neuropsychological assessment, brain imaging and fluid biomarker sampling, with a focus on medial temporal lobe function and episodic memory.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32469308") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33408146") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39528825") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33408146") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8055319/") Annotation(rdfs:comment "All participants were deemed cognitively unimpaired during a clinical consensus meeting consisting of neurologists and neuropsychologists.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002339> "A longitudinal study of healthy ageing at Stanford University in which cognitively unimpaired older adults, recruited through advertisements in the Bay Area, undergo neuropsychological assessment, brain imaging and fluid biomarker sampling, with a focus on medial temporal lobe function and episodic memory.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32469308") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33408146") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39528825") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33408146") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8055319/") Annotation(rdfs:comment "SAMS eligibility included normal or corrected-to-normal vision/hearing, right-handedness, native English speaking, no history of neurologic or psychiatric disease, a Clinical Dementia Rating28 global score of zero, and performance within the normal range on a standardized neuropsychological test battery.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002339> "A longitudinal study of healthy ageing at Stanford University in which cognitively unimpaired older adults, recruited through advertisements in the Bay Area, undergo neuropsychological assessment, brain imaging and fluid biomarker sampling, with a focus on medial temporal lobe function and episodic memory.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32469308") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33408146") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39528825") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33408146") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8055319/") Annotation(rdfs:comment "SAMS is a fluid and neuroimaging biomarker study focused on neuronal and behavioral measures of the MTL.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002339> "A longitudinal study of healthy ageing at Stanford University in which cognitively unimpaired older adults, recruited through advertisements in the Bay Area, undergo neuropsychological assessment, brain imaging and fluid biomarker sampling, with a focus on medial temporal lobe function and episodic memory.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32469308") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33408146") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39528825") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33408146") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33408146+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Episodic memory was assayed using a standardized delayed recall composite, paired associate (word-picture) cued recall, and a mnemonic discrimination task that involves discrimination between studied \"target\" objects, novel \"foil\" objects, and perceptually similar \"lure\" objects.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002339> "A longitudinal study of healthy ageing at Stanford University in which cognitively unimpaired older adults, recruited through advertisements in the Bay Area, undergo neuropsychological assessment, brain imaging and fluid biomarker sampling, with a focus on medial temporal lobe function and episodic memory.")
