# Individual: <http://www.ebi.ac.uk/coho/COHO_0001865> (<http://www.ebi.ac.uk/coho/COHO_0001865>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26590902") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") Annotation(rdfs:comment "Briefly, eligible cases included any person over the age of 18 years with a diagnosis of primary lung cancer that was further confirmed by an MGH lung pathologist.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001865> "A hospital-based case-control study of lung cancer at Massachusetts General Hospital in Boston, begun in 1992, whose cases are adults with primary lung cancer confirmed by a hospital lung pathologist and whose controls are friends or spouses of cancer or surgery patients at the same hospital, without a diagnosis of cancer other than non-melanoma skin cancer, with interviewer-administered questionnaires on smoking, occupational and family history.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26590902") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") Annotation(rdfs:comment "Controls were recruited from the friends or spouses of cancer patients or the friends or spouses of other surgery patients in the same hospital.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001865> "A hospital-based case-control study of lung cancer at Massachusetts General Hospital in Boston, begun in 1992, whose cases are adults with primary lung cancer confirmed by a hospital lung pathologist and whose controls are friends or spouses of cancer or surgery patients at the same hospital, without a diagnosis of cancer other than non-melanoma skin cancer, with interviewer-administered questionnaires on smoking, occupational and family history.")
