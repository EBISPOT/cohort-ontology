AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.shcs.ch/about-shcs/study-design/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.shcs.ch/about-shcs/study-design/") Annotation(rdfs:comment "It is a collaboration of all Swiss university hospitals, large cantonal hospitals with affiliated laboratories, and affiliated smaller hospitals and private physicians caring for persons with HIV.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001235> "A nationwide prospective longitudinal cohort of people with HIV aged 16 or older in Switzerland, established in 1988 as a collaboration of the Swiss university hospitals, large cantonal hospitals, affiliated smaller hospitals and private physicians, who recruit and follow the participants, to improve the health of people with HIV through clinical, translational and basic research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.shcs.ch/about-shcs/study-design/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.shcs.ch/about-shcs/study-design/") Annotation(rdfs:comment "The Swiss HIV Cohort Study (SHCS), established in 1988, is a nationwide prospective longitudinal cohort study enrolling persons with HIV in Switzerland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001235> "A nationwide prospective longitudinal cohort of people with HIV aged 16 or older in Switzerland, established in 1988 as a collaboration of the Swiss university hospitals, large cantonal hospitals, affiliated smaller hospitals and private physicians, who recruit and follow the participants, to improve the health of people with HIV through clinical, translational and basic research.")
