AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19589173") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41663009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41663009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41663009+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Taizhou Longitudinal Study (TZL) is a population-based prospective cohort initiated in 2007, recruiting over 201,000 adults aged 20-80 from urban and rural areas of Taizhou, Jiangsu Province, China.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001426> "A population-based prospective cohort of adults from urban and rural areas of Taizhou, Jiangsu Province, China, initiated in 2007 by Fudan University and the Taizhou government, with baseline interviews, physical examinations, biochemical assays and collection of blood and other biospecimens, and follow-up through health records and repeated assessments, to study environmental and genetic risk factors for common non-communicable diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19589173") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41663009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41663009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41663009+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The cohort is extensively phenotyped through baseline questionnaire-based interviews, physical examinations, biochemical assays, and longitudinal follow-up using health records and repeated assessments.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001426> "A population-based prospective cohort of adults from urban and rural areas of Taizhou, Jiangsu Province, China, initiated in 2007 by Fudan University and the Taizhou government, with baseline interviews, physical examinations, biochemical assays and collection of blood and other biospecimens, and follow-up through health records and repeated assessments, to study environmental and genetic risk factors for common non-communicable diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001427> (<http://www.ebi.ac.uk/coho/COHO_0001427>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29405273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38055889") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29405273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5817237/") Annotation(rdfs:comment "All recruited men (those with an AAA and controls without) are sent an annual self-completed postal questionnaire to obtain longitudinal clinical and QoL data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001427> "A UK national prospective cohort of men recruited in 2011–2019 through the NHS abdominal aortic aneurysm screening programmes of England, Wales and Scotland, which invite men in the year of their 65th birthday: men with a small aneurysm detected at screening, together with screened men without an aneurysm as controls, followed with annual postal questionnaires and, for those with an aneurysm, ultrasound surveillance scans, to study the growth of small abdominal aortic aneurysms.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29405273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38055889") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29405273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5817237/") Annotation(rdfs:comment "The United Kingdom Aneurysm Growth Study (UKAGS) is a prospective observational cohort study currently recruiting men with AAA identified through the English NHS AAA screening programme (NAAASP) and the Welsh AAA screening programme (WAAASP), with the aim of investigating the growth rates of small AAAs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001427> "A UK national prospective cohort of men recruited in 2011–2019 through the NHS abdominal aortic aneurysm screening programmes of England, Wales and Scotland, which invite men in the year of their 65th birthday: men with a small aneurysm detected at screening, together with screened men without an aneurysm as controls, followed with annual postal questionnaires and, for those with an aneurysm, ultrasound surveillance scans, to study the growth of small abdominal aortic aneurysms.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29405273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38055889") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29405273") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5817237/") Annotation(rdfs:comment "UKAGS is a prospective observational cohort study that recruits men with an AAA, as well as individuals without AAA (controls) who have attended AAA screening, from NAAASP or WAAASP15.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001427> "A UK national prospective cohort of men recruited in 2011–2019 through the NHS abdominal aortic aneurysm screening programmes of England, Wales and Scotland, which invite men in the year of their 65th birthday: men with a small aneurysm detected at screening, together with screened men without an aneurysm as controls, followed with annual postal questionnaires and, for those with an aneurysm, ultrasound surveillance scans, to study the growth of small abdominal aortic aneurysms.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29405273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38055889") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38055889") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC10763526/") Annotation(rdfs:comment "In the UK, men are invited to attend for AAA screening in the year of their 65th birthday.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001427> "A UK national prospective cohort of men recruited in 2011–2019 through the NHS abdominal aortic aneurysm screening programmes of England, Wales and Scotland, which invite men in the year of their 65th birthday: men with a small aneurysm detected at screening, together with screened men without an aneurysm as controls, followed with annual postal questionnaires and, for those with an aneurysm, ultrasound surveillance scans, to study the growth of small abdominal aortic aneurysms.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29405273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38055889") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38055889") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC10763526/") Annotation(rdfs:comment "Men attending the AAA screening programmes in England, Wales, and Scotland were invited to join UKAGS, between 2011 and 2019.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001427> "A UK national prospective cohort of men recruited in 2011–2019 through the NHS abdominal aortic aneurysm screening programmes of England, Wales and Scotland, which invite men in the year of their 65th birthday: men with a small aneurysm detected at screening, together with screened men without an aneurysm as controls, followed with annual postal questionnaires and, for those with an aneurysm, ultrasound surveillance scans, to study the growth of small abdominal aortic aneurysms.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29405273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38055889") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38055889") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC10763526/") Annotation(rdfs:comment "UKAGS is a UK national prospective cohort study, which has been conducted alongside the National Health Service (NHS) AAA Screening Programme (NAAASP) in England") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001427> "A UK national prospective cohort of men recruited in 2011–2019 through the NHS abdominal aortic aneurysm screening programmes of England, Wales and Scotland, which invite men in the year of their 65th birthday: men with a small aneurysm detected at screening, together with screened men without an aneurysm as controls, followed with annual postal questionnaires and, for those with an aneurysm, ultrasound surveillance scans, to study the growth of small abdominal aortic aneurysms.")

