AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22271044") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24163127") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms15724/MediaObjects/41467_2017_BFncomms15724_MOESM23_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(rdfs:comment "Source of controls: Controls were recruited as participating in a systematic health screening program and found unaffected (normal digital rectal examination and total PSA 4 ng/ml).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000818> "A hospital-based case-control collection of urological cancers in France, run by the Centre de Recherche pour les Pathologies Prostatiques (CeRePP) at Hôpital Tenon, Paris, whose prostate cancer cases are patients with histologically confirmed prostate cancer treated in French urology departments and whose controls are men found unaffected in a systematic health screening programme, and which has also supplied pathologically confirmed bladder cancer and renal cell carcinoma cases to genome-wide association studies of those cancers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000819> (<http://www.ebi.ac.uk/coho/COHO_0000819>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24118234") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24118234") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4158856/fullTextXML") Annotation(rdfs:comment "Pregnant women from eastern Denmark were invited during 2008–2010 to a novel unselected ‘COPSAC2010’ cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000819> "An unselected Danish mother-child birth cohort of 733 pregnant women from eastern Denmark recruited in 2008–2010 at week 24 of pregnancy and their 700 children, deeply phenotyped at the COPSAC clinic with nested randomised trials of vitamin D and fish oil in pregnancy, to study how perinatal exposures such as the microbiome and maternal nutrition interact with genetics in the development of asthma and other chronic inflammatory diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24118234") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24118234") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4158856/fullTextXML") Annotation(rdfs:comment "Randomized controlled trials of high‐dose vitamin D and fish oil supplements were conducted during pregnancy") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000819> "An unselected Danish mother-child birth cohort of 733 pregnant women from eastern Denmark recruited in 2008–2010 at week 24 of pregnancy and their 700 children, deeply phenotyped at the COPSAC clinic with nested randomised trials of vitamin D and fish oil in pregnancy, to study how perinatal exposures such as the microbiome and maternal nutrition interact with genetics in the development of asthma and other chronic inflammatory diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24118234") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24118234") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4158856/fullTextXML") Annotation(rdfs:comment "Seven hundred and thirty‐eight mothers were recruited from week 24 of gestation, and 700 of their children were included in the birth cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000819> "An unselected Danish mother-child birth cohort of 733 pregnant women from eastern Denmark recruited in 2008–2010 at week 24 of pregnancy and their 700 children, deeply phenotyped at the COPSAC clinic with nested randomised trials of vitamin D and fish oil in pregnancy, to study how perinatal exposures such as the microbiome and maternal nutrition interact with genetics in the development of asthma and other chronic inflammatory diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24118234") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24118234") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4158856/fullTextXML") Annotation(rdfs:comment "The 733 women participated during a total of 738 pregnancies as five women participated during two pregnancies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000819> "An unselected Danish mother-child birth cohort of 733 pregnant women from eastern Denmark recruited in 2008–2010 at week 24 of pregnancy and their 700 children, deeply phenotyped at the COPSAC clinic with nested randomised trials of vitamin D and fish oil in pregnancy, to study how perinatal exposures such as the microbiome and maternal nutrition interact with genetics in the development of asthma and other chronic inflammatory diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24118234") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24118234") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4158856/fullTextXML") Annotation(rdfs:comment "The aim of this study is to explore these interactions by conducting a longitudinal study in an unselected cohort of pregnant women and their offspring with emphasis on deep clinical phenotyping, exposure assessment, and biobanking.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000819> "An unselected Danish mother-child birth cohort of 733 pregnant women from eastern Denmark recruited in 2008–2010 at week 24 of pregnancy and their 700 children, deeply phenotyped at the COPSAC clinic with nested randomised trials of vitamin D and fish oil in pregnancy, to study how perinatal exposures such as the microbiome and maternal nutrition interact with genetics in the development of asthma and other chronic inflammatory diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24118234") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24118234") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4158856/fullTextXML") Annotation(rdfs:comment "We hypothesize that perinatal exposures, in particular the human microbiome and maternal nutrition during pregnancy, interact with the genetic predisposition to cause an abnormal immune modulation in early life towards a trajectory to chronic inflammatory diseases such as asthma and others.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000819> "An unselected Danish mother-child birth cohort of 733 pregnant women from eastern Denmark recruited in 2008–2010 at week 24 of pregnancy and their 700 children, deeply phenotyped at the COPSAC clinic with nested randomised trials of vitamin D and fish oil in pregnancy, to study how perinatal exposures such as the microbiome and maternal nutrition interact with genetics in the development of asthma and other chronic inflammatory diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000820> (<http://www.ebi.ac.uk/coho/COHO_0000820>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40783417") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40783417") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12335436/fullTextXML") Annotation(rdfs:comment "In late fall 1997, 48,850 men (49% response rate) and 39,227 women (70% response rate) completed a 96-item food frequency questionnaire (FFQ) and answered questions about lifestyle factors (the questionnaires are available: https://www.simpler4health.se/researchers/questionnaires/).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000820> "A population-based prospective cohort of men born in 1918–1952 living in Västmanland and Örebro counties in central Sweden, established in 1997 and used, with the Swedish Mammography Cohort, to study diet, lifestyle and chronic disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40783417") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40783417") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12335436/fullTextXML") Annotation(rdfs:comment "The COSM was established in 1997 when all men born in 1918–1952 residing in central Swedish counties (Västmanland and Örebro) were invited to join the cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000820> "A population-based prospective cohort of men born in 1918–1952 living in Västmanland and Örebro counties in central Sweden, established in 1997 and used, with the Swedish Mammography Cohort, to study diet, lifestyle and chronic disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40783417") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40783417") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12335436/fullTextXML") Annotation(rdfs:comment "The study included two population-based prospective cohorts: the Cohort of Swedish Men (COSM) and the Swedish Mammography Cohort (SMC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000820> "A population-based prospective cohort of men born in 1918–1952 living in Västmanland and Örebro counties in central Sweden, established in 1997 and used, with the Swedish Mammography Cohort, to study diet, lifestyle and chronic disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40783417") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40783417") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12335436/fullTextXML") Annotation(rdfs:comment "Therefore, to fill the gap in knowledge on coffee consumption in relation to AAA incidence, we aimed to examine the association between coffee consumption and the risk of AAA in two large population-based cohorts of Swedish adults.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000820> "A population-based prospective cohort of men born in 1918–1952 living in Västmanland and Örebro counties in central Sweden, established in 1997 and used, with the Swedish Mammography Cohort, to study diet, lifestyle and chronic disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000821> (<http://www.ebi.ac.uk/coho/COHO_0000821>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35807897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35807897") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9268344/fullTextXML") Annotation(rdfs:comment "Controls were those requiring colonoscopy for various gastrointestinal complaints but who showed no evidence of malignant or idiopathic bowel disease and had no history of chronic illness requiring repeated hospitalization [20].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000821> "A hospital-based case-control study of colorectal cancer in the Czech Republic, with cases and controls collected at oncology departments of several Czech hospitals from 2003 onwards, used to study genetic and lifestyle risk factors for colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35807897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35807897") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9268344/fullTextXML") Annotation(rdfs:comment "However, all Czech cohort study participants completed demographic/lifestyle questionnaires to provide information regarding their education, lifestyle habits, body mass index, diabetes, family/personal history of cancer, and long-term (at least six consecutive months) drug use.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000821> "A hospital-based case-control study of colorectal cancer in the Czech Republic, with cases and controls collected at oncology departments of several Czech hospitals from 2003 onwards, used to study genetic and lifestyle risk factors for colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35807897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35807897") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9268344/fullTextXML") Annotation(rdfs:comment "The Czech cohort comprised 718 CRC cases and 646 controls collected at several oncology departments in the Czech Republic between September 2003 and December 2016.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000821> "A hospital-based case-control study of colorectal cancer in the Czech Republic, with cases and controls collected at oncology departments of several Czech hospitals from 2003 onwards, used to study genetic and lifestyle risk factors for colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000822> (<http://www.ebi.ac.uk/coho/COHO_0000822>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29775482") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29775482") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5959061/fullTextXML") Annotation(rdfs:comment "Between May 2000 and November 2011, all consecutive objectively proven VTE cases diagnosed in Brest University Hospital were included in a registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000822> "A hospital-based study at Brest University Hospital, France, launched in 2000, that enrols consecutive patients with objectively confirmed venous thromboembolism (more than 5,000 so far), with matched hospital controls, to study genetic and environmental risk factors for venous thromboembolism and their interactions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29775482") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29775482") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5959061/fullTextXML") Annotation(rdfs:comment "The EDITH hospital-based case-control study enrolled 182 patients with cancer and VTE as well as 182 control patients with cancer, matched for gender, age and cancer location, between 2000 and 2012, in the University Hospital of Brest.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000822> "A hospital-based study at Brest University Hospital, France, launched in 2000, that enrols consecutive patients with objectively confirmed venous thromboembolism (more than 5,000 so far), with matched hospital controls, to study genetic and environmental risk factors for venous thromboembolism and their interactions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29775482") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29775482") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5959061/fullTextXML") Annotation(rdfs:comment "The observational EDITH case-control study was designed to assess interactions between genetic and environmental risk factors for VTE.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000822> "A hospital-based study at Brest University Hospital, France, launched in 2000, that enrols consecutive patients with objectively confirmed venous thromboembolism (more than 5,000 so far), with matched hospital controls, to study genetic and environmental risk factors for venous thromboembolism and their interactions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29775482") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML") Annotation(rdfs:comment "EDITH is a prospective observational cohort study launched in 2000 aimed at improving the understanding of VTE risk factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000822> "A hospital-based study at Brest University Hospital, France, launched in 2000, that enrols consecutive patients with objectively confirmed venous thromboembolism (more than 5,000 so far), with matched hospital controls, to study genetic and environmental risk factors for venous thromboembolism and their interactions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29775482") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML") Annotation(rdfs:comment "Since its inception, it has enrolled >5000 patients with VTE.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000822> "A hospital-based study at Brest University Hospital, France, launched in 2000, that enrols consecutive patients with objectively confirmed venous thromboembolism (more than 5,000 so far), with matched hospital controls, to study genetic and environmental risk factors for venous thromboembolism and their interactions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29775482") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13240746/fullTextXML") Annotation(rdfs:comment "This work builds upon 2 French studies, EDITH (Etude des Déterminants/Interaction de la Thrombose veineuse)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000822> "A hospital-based study at Brest University Hospital, France, launched in 2000, that enrols consecutive patients with objectively confirmed venous thromboembolism (more than 5,000 so far), with matched hospital controls, to study genetic and environmental risk factors for venous thromboembolism and their interactions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000823> (<http://www.ebi.ac.uk/coho/COHO_0000823>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32169796") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.samrc.ac.za/intramural-research-units/evolving-risk-factors-cancers-african-populations-erica-sa") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32169796") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32169796+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A total of 24 971 black patients with an incident histologically proven (>95%) cancer of any type were enrolled between 1995-2016.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000823> "A cancer case-control study that enrolled 24,971 Black patients with incident, mostly histologically proven cancers of any type in Johannesburg, South Africa, between 1995 and 2016, collecting questionnaire data and serum and whole-blood samples and using patients with cancers unrelated to the exposure of interest as controls, to study lifestyle and infection (particularly HIV) risk factors for cancer; the ERICA-SA project uses its data and samples to study lifestyle, infection and genetic susceptibility to cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32169796") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.samrc.ac.za/intramural-research-units/evolving-risk-factors-cancers-african-populations-erica-sa") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32169796") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32169796+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "JCS uses a cancer case-control method; controls being cancer types unrelated to exposures of interest.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000823> "A cancer case-control study that enrolled 24,971 Black patients with incident, mostly histologically proven cancers of any type in Johannesburg, South Africa, between 1995 and 2016, collecting questionnaire data and serum and whole-blood samples and using patients with cancers unrelated to the exposure of interest as controls, to study lifestyle and infection (particularly HIV) risk factors for cancer; the ERICA-SA project uses its data and samples to study lifestyle, infection and genetic susceptibility to cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32169796") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.samrc.ac.za/intramural-research-units/evolving-risk-factors-cancers-african-populations-erica-sa") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32169796") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32169796+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Patients provided informed consent, lifestyle and demographic information using a structured questionnaire; 19 351 provided a serum sample and 18 972 a whole blood sample for genomic analyses.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000823> "A cancer case-control study that enrolled 24,971 Black patients with incident, mostly histologically proven cancers of any type in Johannesburg, South Africa, between 1995 and 2016, collecting questionnaire data and serum and whole-blood samples and using patients with cancers unrelated to the exposure of interest as controls, to study lifestyle and infection (particularly HIV) risk factors for cancer; the ERICA-SA project uses its data and samples to study lifestyle, infection and genetic susceptibility to cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32169796") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.samrc.ac.za/intramural-research-units/evolving-risk-factors-cancers-african-populations-erica-sa") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32169796") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32169796+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Johannesburg Cancer Study (JCS) aims were to examine whether cancer risk factors identified in Western countries applied to black patients in Johannesburg, South Africa and to understand the impact of HIV on cancer risk, with a view to identifying previously unrecognised HIV associated cancers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000823> "A cancer case-control study that enrolled 24,971 Black patients with incident, mostly histologically proven cancers of any type in Johannesburg, South Africa, between 1995 and 2016, collecting questionnaire data and serum and whole-blood samples and using patients with cancers unrelated to the exposure of interest as controls, to study lifestyle and infection (particularly HIV) risk factors for cancer; the ERICA-SA project uses its data and samples to study lifestyle, infection and genetic susceptibility to cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32169796") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.samrc.ac.za/intramural-research-units/evolving-risk-factors-cancers-african-populations-erica-sa") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40229280") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11997036/fullTextXML") Annotation(rdfs:comment "The JCS samples formed part of a larger study, Evolving Risk Factors for Cancer in African Populations (ERICA-SA) (https://www.samrc.ac.za/intramural-research-units/evolving-risk-factors-cancers-african-populations-erica-sa) which is investigating the contributions of lifestyle, infection and genetics to cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000823> "A cancer case-control study that enrolled 24,971 Black patients with incident, mostly histologically proven cancers of any type in Johannesburg, South Africa, between 1995 and 2016, collecting questionnaire data and serum and whole-blood samples and using patients with cancers unrelated to the exposure of interest as controls, to study lifestyle and infection (particularly HIV) risk factors for cancer; the ERICA-SA project uses its data and samples to study lifestyle, infection and genetic susceptibility to cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32169796") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.samrc.ac.za/intramural-research-units/evolving-risk-factors-cancers-african-populations-erica-sa") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.samrc.ac.za/intramural-research-units/evolving-risk-factors-cancers-african-populations-erica-sa") Annotation(rdfs:comment "the ERICA-SA project will utilise lifestyle data and biological samples collected by the Johannesburg Cancer Study (JCS) from 20,000 African cancer patients to investigate the causes of cancer and to enhance scientific research capacity in South Africa.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000823> "A cancer case-control study that enrolled 24,971 Black patients with incident, mostly histologically proven cancers of any type in Johannesburg, South Africa, between 1995 and 2016, collecting questionnaire data and serum and whole-blood samples and using patients with cancers unrelated to the exposure of interest as controls, to study lifestyle and infection (particularly HIV) risk factors for cancer; the ERICA-SA project uses its data and samples to study lifestyle, infection and genetic susceptibility to cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000824> (<http://www.ebi.ac.uk/coho/COHO_0000824>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19706757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24163127") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19706757") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2782435/") Annotation(rdfs:comment "FBCS French Bladder Cancer Study 316 190 84 France: hospital-based NA") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000824> "A hospital-based case-control study of bladder cancer in France, whose cases were also genotyped for the NCI bladder cancer genome-wide association study.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19706757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24163127") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24163127") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3919005/") Annotation(rdfs:comment "To search for such loci, we performed a new scan of 2422 cases and 5751 controls (National Cancer Institute, NCI-GWAS2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000824> "A hospital-based case-control study of bladder cancer in France, whose cases were also genotyped for the NCI bladder cancer genome-wide association study.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19706757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24163127") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24163127") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3919005/") Annotation(rdfs:comment "We genotyped cases for four case–control studies, the Los Angeles Bladder Cancer Study (LABCS), the French Center for Research on Prostate Diseases (CeRePP), the French Bladder Study (FBCS) and the Brescia Bladder Cancer Study (BBCS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000824> "A hospital-based case-control study of bladder cancer in France, whose cases were also genotyped for the NCI bladder cancer genome-wide association study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000825> (<http://www.ebi.ac.uk/coho/COHO_0000825>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25882629") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18657195") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2874631/unicode") Annotation(rdfs:comment "The focus of the family-based FTC study is the identification of TGCT susceptibility genes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000825> "A National Cancer Institute Clinical Genetics Branch study (protocol 02-C-0178) that enrolls families with at least two cases of testicular germ cell tumour, identified through physician and self-referral, together with controls, to study the genetic and clinical features of familial testicular cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25882629") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25882629") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4529345/fullTextXML") Annotation(rdfs:comment "Families with at least two histopathologically confirmed cases of TGCT, or a combination of TGCT and extragonadal germ cell tumor, and with DNA from at least one affected case were enrolled.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000825> "A National Cancer Institute Clinical Genetics Branch study (protocol 02-C-0178) that enrolls families with at least two cases of testicular germ cell tumour, identified through physician and self-referral, together with controls, to study the genetic and clinical features of familial testicular cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25882629") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25882629") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4529345/fullTextXML") Annotation(rdfs:comment "Norwegian and U.S. participants were identified through physician- and self-referral, and were enrolled in protocols approved by the ethical and Institutional Review Boards of the Norwegian Radium Hospital (Registration Number 2011/625) and the National Cancer Institute (NCI) Clinical Genetics Branch (NCI protocol 02-C-0178, NCT-00039598), respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000825> "A National Cancer Institute Clinical Genetics Branch study (protocol 02-C-0178) that enrolls families with at least two cases of testicular germ cell tumour, identified through physician and self-referral, together with controls, to study the genetic and clinical features of familial testicular cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25882629") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25882629") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4529345/fullTextXML") Annotation(rdfs:comment "To improve the phenotypic definition of familial TGCT (FTGCT), we studied an international cohort of multiple-case TGCT families to determine whether first-degree relatives of FTGCT cases are at increased risk of other types of cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000825> "A National Cancer Institute Clinical Genetics Branch study (protocol 02-C-0178) that enrolls families with at least two cases of testicular germ cell tumour, identified through physician and self-referral, together with controls, to study the genetic and clinical features of familial testicular cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25882629") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28275244") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5444985/unicode") Annotation(rdfs:comment "We obtained blood and buccal-derived DNA from two case-control studies: the NCI Familial Testicular Cancer Study (FTC; cases=172, controls=163) and the NCI US Servicemen's Testicular Tumor Environmental and Endocrine Determinants Study (STEED; cases=506, controls=611).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000825> "A National Cancer Institute Clinical Genetics Branch study (protocol 02-C-0178) that enrolls families with at least two cases of testicular germ cell tumour, identified through physician and self-referral, together with controls, to study the genetic and clinical features of familial testicular cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000826> (<http://www.ebi.ac.uk/coho/COHO_0000826>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.gefos.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.gefos.org/") Annotation(rdfs:comment "GEFOS is a European Union Seventh Framework Package funded project, registered under grant agreement number: FP7-HEALTH- F2-2008-201865-GEFOS") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000826> "A large international collaboration of research groups, funded by the European Union Seventh Framework Programme as a successor to GENOMOS, that brings together osteoporosis study populations with DNA and genome-wide association data to identify common genetic variants for osteoporosis and bone traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.gefos.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.gefos.org/") Annotation(rdfs:comment "In a previous EU FP5 funded project, named GENOMOS, we have improved on this situation by bringing together several of Europe's largest collections of osteoporosic study populations with DNA available, and analysing the most commonly studied.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000826> "A large international collaboration of research groups, funded by the European Union Seventh Framework Programme as a successor to GENOMOS, that brings together osteoporosis study populations with DNA and genome-wide association data to identify common genetic variants for osteoporosis and bone traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.gefos.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.gefos.org/") Annotation(rdfs:comment "It is a large international collaboration involving various prominent research groups.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000826> "A large international collaboration of research groups, funded by the European Union Seventh Framework Programme as a successor to GENOMOS, that brings together osteoporosis study populations with DNA and genome-wide association data to identify common genetic variants for osteoporosis and bone traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.gefos.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.gefos.org/") Annotation(rdfs:comment "With the GEFOS project we here propose to capitalize on the success of GENOMOS by using the most advanced gene discovery tools that have become recently available, i.e., Genome Wide Association (GWA) analysis with high density SNP arrays, to identify common risk gene variants for osteoporosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000826> "A large international collaboration of research groups, funded by the European Union Seventh Framework Programme as a successor to GENOMOS, that brings together osteoporosis study populations with DNA and genome-wide association data to identify common genetic variants for osteoporosis and bone traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.gefos.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3338864/fullTextXML") Annotation(rdfs:comment "This study is part of the GEnetic Factors for OSteoporosis consortium (GEFOS), a coalition of teams of investigators dedicated to identify the genetic determinants of osteoporosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000826> "A large international collaboration of research groups, funded by the European Union Seventh Framework Programme as a successor to GENOMOS, that brings together osteoporosis study populations with DNA and genome-wide association data to identify common genetic variants for osteoporosis and bone traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.gefos.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3338864/fullTextXML") Annotation(rdfs:comment "We performed the largest meta-analysis to date on lumbar spine and femoral neck BMD, including 17 genome-wide association studies and 32,961 individuals of European and East Asian ancestry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000826> "A large international collaboration of research groups, funded by the European Union Seventh Framework Programme as a successor to GENOMOS, that brings together osteoporosis study populations with DNA and genome-wide association data to identify common genetic variants for osteoporosis and bone traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000827> (<http://www.ebi.ac.uk/coho/COHO_0000827>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30206078") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30206078") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6144482/fullTextXML") Annotation(rdfs:comment "HELIX used a multilevel study design with the entire study population totalling 31 472 mother-child pairs, recruited during pregnancy, in the six existing cohorts (first level); a subcohort of 1301 mother-child pairs where biomarkers, omics signatures and child health outcomes were measured at age 6–11 years (second level)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000827> "A European population-based exposome cohort of 31,472 mother-child pairs recruited during pregnancy in six existing longitudinal birth cohorts in France, Greece, Lithuania, Norway, Spain and the UK, with a subcohort of 1,301 mother-child pairs in which biomarkers, omics signatures and child health outcomes were measured at age 6–11 years, to relate multiple early-life environmental exposures to molecular signatures and child health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30206078") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30206078") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6144482/fullTextXML") Annotation(rdfs:comment "The HELIX study represents a collaborative project across six established and ongoing longitudinal population-based birth cohort studies in six European countries (France, Greece, Lithuania, Norway, Spain and the UK).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000827> "A European population-based exposome cohort of 31,472 mother-child pairs recruited during pregnancy in six existing longitudinal birth cohorts in France, Greece, Lithuania, Norway, Spain and the UK, with a subcohort of 1,301 mother-child pairs in which biomarkers, omics signatures and child health outcomes were measured at age 6–11 years, to relate multiple early-life environmental exposures to molecular signatures and child health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30206078") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30206078") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6144482/fullTextXML") Annotation(rdfs:comment "The aim of the Human Early Life Exposome (HELIX) study was to measure and describe multiple environmental exposures during early life (pregnancy and childhood) in a prospective cohort and associate these exposures with molecular omics signatures and child health outcomes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000827> "A European population-based exposome cohort of 31,472 mother-child pairs recruited during pregnancy in six existing longitudinal birth cohorts in France, Greece, Lithuania, Norway, Spain and the UK, with a subcohort of 1,301 mother-child pairs in which biomarkers, omics signatures and child health outcomes were measured at age 6–11 years, to relate multiple early-life environmental exposures to molecular signatures and child health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000828> (<http://www.ebi.ac.uk/coho/COHO_0000828>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33763119") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36327219") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33763119") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7982958/fullTextXML") Annotation(rdfs:comment "Specifically, Healthy Nevada Project participants sequenced by the Helix Exome+ platform were cross-referenced to their electronic medical records to identify") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000828> "A collection of COVID-19 phenotypes from participants sequenced with the Helix Exome+ assay, including those of the Healthy Nevada Project, a population health study established in 2016 by Renown Health and the Desert Research Institute in Reno, Nevada, contributed to COVID-19 host genetics studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33763119") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36327219") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33763119") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7982958/fullTextXML") Annotation(rdfs:comment "The Healthy Nevada Project (HNP), a population health study developed in collaboration between Renown Health and the Desert Research Institute in Reno, Nevada, was established in 2016 to examine the effects genetics may have on Nevadan health outcomes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000828> "A collection of COVID-19 phenotypes from participants sequenced with the Helix Exome+ assay, including those of the Healthy Nevada Project, a population health study established in 2016 by Renown Health and the Desert Research Institute in Reno, Nevada, contributed to COVID-19 host genetics studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33763119") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36327219") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40399555") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12165857/fullTextXML") Annotation(rdfs:comment "Data for initial discovery GWASs (Long COVID HGI data freeze 4) was collected by DBDS, EstBB, FinnGen, GEN-COVID, GENCOV, MexGen-COVID (Supplementary Tables 1, 3–8 and 12), ALSPAC, BoSCO, BQC19, EXCEED, GCAT (COVICAT), Genotek, GOLD, Helix, Ioannina, IrCovid, JapanTaskForce, Lifelines, MoBa, MSCIC, PMBB, SweCovid, COMRI, TiKoCo, TwinsUK, UKB and Understanding Society (Supplementary Tables 11 and 12).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000828> "A collection of COVID-19 phenotypes from participants sequenced with the Helix Exome+ assay, including those of the Healthy Nevada Project, a population health study established in 2016 by Renown Health and the Desert Research Institute in Reno, Nevada, contributed to COVID-19 host genetics studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33763119") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36327219") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10482689/supplementaryFiles") Annotation(rdfs:comment "Helix Exome+ COVID-19 Phenotypes | United States | Helix | EUR | - | - | - | - | 1055 | 10960 | Cases & Controls 58 years (median)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000828> "A collection of COVID-19 phenotypes from participants sequenced with the Helix Exome+ assay, including those of the Healthy Nevada Project, a population health study established in 2016 by Renown Health and the Desert Research Institute in Reno, Nevada, contributed to COVID-19 host genetics studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000829> (<http://www.ebi.ac.uk/coho/COHO_0000829>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9412533/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31420334") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6871304/") Annotation(rdfs:comment "The setting for this multi-ancestry GWAS meta-analysis of VTE is the International Network Against Venous Thrombosis (INVENT) Consortium.7 The meta-analysis is based on prospective cohort and case-control data from 18 studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000829> "An international consortium that meta-analyses genome-wide association studies of venous thromboembolism from many case-control and population studies (30,234 cases and 172,122 controls from 18 studies in its 2019 analysis, 29 studies in later case-only analyses) to identify genetic risk factors for venous thromboembolism and its subtypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9412533/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31420334") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31420334+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We meta-analyzed GWAS data from 18 studies for 30 234 VTE cases and 172 122 controls and assessed the association between 12 923 718 genetic variants and VTE.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000829> "An international consortium that meta-analyses genome-wide association studies of venous thromboembolism from many case-control and population studies (30,234 cases and 172,122 controls from 18 studies in its 2019 analysis, 29 studies in later case-only analyses) to identify genetic risk factors for venous thromboembolism and its subtypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9412533/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36014859") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9412533/fullTextXML") Annotation(rdfs:comment "Genetic associations for VTE and its subtypes were obtained from the International Network Against Venous Thrombosis Consortium (30,234 cases and 172,122 controls) and the FinnGen study (11,288 VTE cases and 254,771 controls).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000829> "An international consortium that meta-analyses genome-wide association studies of venous thromboembolism from many case-control and population studies (30,234 cases and 172,122 controls from 18 studies in its 2019 analysis, 29 studies in later case-only analyses) to identify genetic risk factors for venous thromboembolism and its subtypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9412533/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36014859") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9412533/fullTextXML") Annotation(rdfs:comment "The INVENT Consortium included 30,234 VTE cases and 172,122 controls from 18 studies with varying diagnostic approaches, which were detailly described in the genome-wide association study [25].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000829> "An international consortium that meta-analyses genome-wide association studies of venous thromboembolism from many case-control and population studies (30,234 cases and 172,122 controls from 18 studies in its 2019 analysis, 29 studies in later case-only analyses) to identify genetic risk factors for venous thromboembolism and its subtypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000830> (<http://www.ebi.ac.uk/coho/COHO_0000830>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19174821") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19174821") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2653778") Annotation(rdfs:comment "Cases were identified through the Los Angeles County Cancer Surveillance Program – the largest of the National Cancer Institute’s Surveillance, Epidemiology and End Results (SEER) cancer registries (Bernstein and Ross, 1991).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000830> "A population-based case-control study of bladder cancer in Los Angeles County, United States, with cases aged 25–64 diagnosed in 1987–1996 identified through the Los Angeles County Cancer Surveillance Program and matched neighbourhood controls, used to study lifestyle and genetic risk factors for bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19174821") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19174821") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2653778/fullTextXML") Annotation(rdfs:comment "Eligibility criteria included histologically confirmed bladder cancers diagnosed between January 1, 1987 and April 30, 1996 among non-Asians between the ages of 25 and 64 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000830> "A population-based case-control study of bladder cancer in Los Angeles County, United States, with cases aged 25–64 diagnosed in 1987–1996 identified through the Los Angeles County Cancer Surveillance Program and matched neighbourhood controls, used to study lifestyle and genetic risk factors for bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19174821") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19174821") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2653778/fullTextXML") Annotation(rdfs:comment "For each enrolled case, a standard procedure was followed to recruit a control subject from the neighbourhood of the residence of the case at the time of cancer diagnosis, with the control matched to the case by age (within 5 years), sex, and race (non-Hispanic white, Hispanic white, or African American/others).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000830> "A population-based case-control study of bladder cancer in Los Angeles County, United States, with cases aged 25–64 diagnosed in 1987–1996 identified through the Los Angeles County Cancer Surveillance Program and matched neighbourhood controls, used to study lifestyle and genetic risk factors for bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19174821") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19174821") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2653778/fullTextXML") Annotation(rdfs:comment "We collected detailed information on UTIs in a large population-based case–control study of bladder cancer in Los Angeles County, where we have identified risk factors including cigarette smoking (Castelao et al, 2001) and use of permanent hair dyes among women") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000830> "A population-based case-control study of bladder cancer in Los Angeles County, United States, with cases aged 25–64 diagnosed in 1987–1996 identified through the Los Angeles County Cancer Surveillance Program and matched neighbourhood controls, used to study lifestyle and genetic risk factors for bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19174821") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3919005") Annotation(rdfs:comment "We genotyped cases for four case–control studies, the Los Angeles Bladder Cancer Study (LABCS), the French Center for Research on Prostate Diseases (CeRePP), the French Bladder Study (FBCS) and the Brescia Bladder Cancer Study (BBCS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000830> "A population-based case-control study of bladder cancer in Los Angeles County, United States, with cases aged 25–64 diagnosed in 1987–1996 identified through the Los Angeles County Cancer Surveillance Program and matched neighbourhood controls, used to study lifestyle and genetic risk factors for bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000831> (<http://www.ebi.ac.uk/coho/COHO_0000831>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30402607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30402607") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6040001/fullTextXML") Annotation(rdfs:comment "3,097 healthy, mature newborns with German parents and a birth weight > 2,500g who were born between November 11, 1997 (Munich, Leipzig, Bad Honnef) or July 1, 1998 (Wesel) and January 31, 1999 were included in the LISAplus study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000831> "A prospective population-based German birth cohort of 3,097 healthy term newborns born between 1997 and 1999 and recruited in obstetric hospitals in Munich, Leipzig, Wesel and Bad Honnef, followed through childhood and adolescence to study the influence of lifestyle, environmental exposures such as air pollution, and genetics on the development of the immune system and allergic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30402607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30402607") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6040001/fullTextXML") Annotation(rdfs:comment "Even in a prospective cohort (as in GINIplus and LISAplus), it is very difficult from a methodological point of view to evaluate the exact role of breast-feeding in atopic diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000831> "A prospective population-based German birth cohort of 3,097 healthy term newborns born between 1997 and 1999 and recruited in obstetric hospitals in Munich, Leipzig, Wesel and Bad Honnef, followed through childhood and adolescence to study the influence of lifestyle, environmental exposures such as air pollution, and genetics on the development of the immune system and allergic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30402607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30402607") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6040001/fullTextXML") Annotation(rdfs:comment "The subjects were recruited in 4 obstetric hospitals in Leipzig (976 children), in 6 hospitals in Munich (1,467), in 3 hospitals in Wesel (348), and 1 in Bad Honnef (306) by asking the mothers of the eligible newborns after they had given birth.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000831> "A prospective population-based German birth cohort of 3,097 healthy term newborns born between 1997 and 1999 and recruited in obstetric hospitals in Munich, Leipzig, Wesel and Bad Honnef, followed through childhood and adolescence to study the influence of lifestyle, environmental exposures such as air pollution, and genetics on the development of the immune system and allergic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30402607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30402607") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6040001/fullTextXML") Annotation(rdfs:comment "The two large German birth cohorts, GINIplus and LISAplus, recruited 5,991 and 3,097 children, respectively, in Munich (West), Leipzig (East), Wesel (West), and Bad Honnef (West) to investigate various influences on the development of the immune system and the etiology of allergic diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000831> "A prospective population-based German birth cohort of 3,097 healthy term newborns born between 1997 and 1999 and recruited in obstetric hospitals in Munich, Leipzig, Wesel and Bad Honnef, followed through childhood and adolescence to study the influence of lifestyle, environmental exposures such as air pollution, and genetics on the development of the immune system and allergic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30402607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35378236") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(rdfs:comment "The 4 year, 6 year, 10 year and 15 year follow-up examinations of the LISA study were covered from the respective budgets of the involved partners") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000831> "A prospective population-based German birth cohort of 3,097 healthy term newborns born between 1997 and 1999 and recruited in obstetric hospitals in Munich, Leipzig, Wesel and Bad Honnef, followed through childhood and adolescence to study the influence of lifestyle, environmental exposures such as air pollution, and genetics on the development of the immune system and allergic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30402607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35378236") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(rdfs:comment "The influence of Life-style factors on the development of the Immune System and Allergies in East and West Germany PLUS the influence of traffic emissions and genetics (LISAplus) Study is a population based birth cohort study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000831> "A prospective population-based German birth cohort of 3,097 healthy term newborns born between 1997 and 1999 and recruited in obstetric hospitals in Munich, Leipzig, Wesel and Bad Honnef, followed through childhood and adolescence to study the influence of lifestyle, environmental exposures such as air pollution, and genetics on the development of the immune system and allergic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000832> (<http://www.ebi.ac.uk/coho/COHO_0000832>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22672568") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22672568") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3419811/") Annotation(rdfs:comment "The discovery study population consisted 1503 VTE cases and 1459 controls (Supplementary Table 1) from a candidate gene (CG) study, as previously described.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000832> "A case-control study at the Mayo Clinic, Rochester, Minnesota, of adults with objectively diagnosed venous thromboembolism and age- and sex-matched controls, supplemented by Olmsted County residents with incident venous thromboembolism and matched controls, used for candidate-gene, genome-wide and whole-genome sequencing studies of venous thromboembolism risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22672568") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22672568") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22672568+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We performed in silico genome wide association scan (GWAS) analyses using genotype data imputed to approximately 2.5 million single-nucleotide polymorphisms (SNPs) from adults with objectively-diagnosed VTE (n=1503), and controls frequency matched on age and gender (n=1459; discovery population).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000832> "A case-control study at the Mayo Clinic, Rochester, Minnesota, of adults with objectively diagnosed venous thromboembolism and age- and sex-matched controls, supplemented by Olmsted County residents with incident venous thromboembolism and matched controls, used for candidate-gene, genome-wide and whole-genome sequencing studies of venous thromboembolism risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22672568") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22672568") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3419811/unicode") Annotation(rdfs:comment "Replication study leukocyte genomic DNA samples were largely from Olmsted County, MN, USA residents with objectively-diagnosed incident VTE over the 45-year period, 1966-2010, and previously-matched Olmsted County resident controls, as previously described.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000832> "A case-control study at the Mayo Clinic, Rochester, Minnesota, of adults with objectively diagnosed venous thromboembolism and age- and sex-matched controls, supplemented by Olmsted County residents with incident venous thromboembolism and matched controls, used for candidate-gene, genome-wide and whole-genome sequencing studies of venous thromboembolism risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22672568") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35414113") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(rdfs:comment "The Mayo Venous Thromboembolism Study (Mayo VTE) is a case-control study of venous thromboembolism (VTE) conducted at the Mayo Clinic (Rochester, MN)).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000832> "A case-control study at the Mayo Clinic, Rochester, Minnesota, of adults with objectively diagnosed venous thromboembolism and age- and sex-matched controls, supplemented by Olmsted County residents with incident venous thromboembolism and matched controls, used for candidate-gene, genome-wide and whole-genome sequencing studies of venous thromboembolism risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22672568") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-021-03205-y/MediaObjects/41586_2021_3205_MOESM1_ESM.pdf") Annotation(rdfs:comment "NHLBI TOPMed: Mayo Clinic Venous Thromboembolism Study (Mayo_VTE) Funded, in part, by grants from the National Institutes of Health, National Heart, Lung and Blood Institute (HL66216 and HL83141).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000832> "A case-control study at the Mayo Clinic, Rochester, Minnesota, of adults with objectively diagnosed venous thromboembolism and age- and sex-matched controls, supplemented by Olmsted County residents with incident venous thromboembolism and matched controls, used for candidate-gene, genome-wide and whole-genome sequencing studies of venous thromboembolism risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000833> (<http://www.ebi.ac.uk/coho/COHO_0000833>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41183009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41183009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12631987/fullTextXML") Annotation(rdfs:comment "Cancer cases were identified in hospitals from different Spanish regions through active searches in regular visits to hospital departments (i.e., gastroenterology, oncology, general surgery, radiotherapy, and pathology), and participants were interviewed as soon as possible after diagnosis (median 58 days) in 2008–2013.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000833> "A multicase-control study in Spain that recruited hospital-based cases of several common cancers, including breast, colorectal and prostate cancer, and population-based controls in 2008–2013, to study environmental, lifestyle and genetic risk factors for these cancers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41183009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41183009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12631987/fullTextXML") Annotation(rdfs:comment "Controls were population-based and frequency-matched to cases by sex, age (±5 years), and region, identified from the lists of randomly selected family practitioners in primary health centers in the catchment area of participating hospitals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000833> "A multicase-control study in Spain that recruited hospital-based cases of several common cancers, including breast, colorectal and prostate cancer, and population-based controls in 2008–2013, to study environmental, lifestyle and genetic risk factors for these cancers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41183009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41183009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12631987/fullTextXML") Annotation(rdfs:comment "We evaluated the association between lifetime pool attendance and the risk of breast, colorectal, and prostate cancer in a multicase-control study that recruited 4,941 hospital-based cancer cases (1,724 breast, 2,111 colorectal, 1,106 prostate) and 4,039 population-based controls in Spain (2008–2013).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000833> "A multicase-control study in Spain that recruited hospital-based cases of several common cancers, including breast, colorectal and prostate cancer, and population-based controls in 2008–2013, to study environmental, lifestyle and genetic risk factors for these cancers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41183009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41544563") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41544563+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Genome-wide interaction analysis of long-term trihalomethane exposure in drinking water and colorectal cancer risk in a Spanish Multicenter Case-Control Study (MCC-Spain).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000833> "A multicase-control study in Spain that recruited hospital-based cases of several common cancers, including breast, colorectal and prostate cancer, and population-based controls in 2008–2013, to study environmental, lifestyle and genetic risk factors for these cancers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41183009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.nature.com/articles/srep43263") Annotation(rdfs:comment "Risk Model for Colorectal Cancer in Spanish Population Using Environmental and Genetic Factors: Results from the MCC-Spain study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000833> "A multicase-control study in Spain that recruited hospital-based cases of several common cancers, including breast, colorectal and prostate cancer, and population-based controls in 2008–2013, to study environmental, lifestyle and genetic risk factors for these cancers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000834> (<http://www.ebi.ac.uk/coho/COHO_0000834>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17550581") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12119133/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17550581") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1913911/fullTextXML") Annotation(rdfs:comment "As a part of a larger, ongoing genetic healthcare research program on the South Tyrolean population (the GenNova project), in 2002–2003, an extensive survey (the MICROS study) was carried out on the populations of Stelvio, Vallelunga and Martello, three villages of the Val Venosta.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000834> "A population-based family study of about 1,300 adults from Stelvio, Vallelunga and Martello, three small, historically isolated villages of the Val Venosta (Vinschgau) in South Tyrol, Italy, surveyed by the European Academy of Bozen/Bolzano (EURAC) in 2002–2003 and 2007, with reconstructed genealogies, to study the genetic epidemiology of Mendelian and complex diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17550581") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12119133/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17550581") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1913911/fullTextXML") Annotation(rdfs:comment "Starting from participants, genealogies were reconstructed for 50,037 subjects, going back to the early 1600s.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000834> "A population-based family study of about 1,300 adults from Stelvio, Vallelunga and Martello, three small, historically isolated villages of the Val Venosta (Vinschgau) in South Tyrol, Italy, surveyed by the European Academy of Bozen/Bolzano (EURAC) in 2002–2003 and 2007, with reconstructed genealogies, to study the genetic epidemiology of Mendelian and complex diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17550581") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12119133/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17550581") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1913911/fullTextXML") Annotation(rdfs:comment "The MICROS study is an extensive, ongoing, two-stage survey aimed at characterizing the genetic epidemiology of Mendelian and complex diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000834> "A population-based family study of about 1,300 adults from Stelvio, Vallelunga and Martello, three small, historically isolated villages of the Val Venosta (Vinschgau) in South Tyrol, Italy, surveyed by the European Academy of Bozen/Bolzano (EURAC) in 2002–2003 and 2007, with reconstructed genealogies, to study the genetic epidemiology of Mendelian and complex diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17550581") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12119133/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17550581") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17550581+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "For historical and political reasons, South Tyrol, the northern most Italian region, includes several villages of small dimensions which remained isolated over the centuries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000834> "A population-based family study of about 1,300 adults from Stelvio, Vallelunga and Martello, three small, historically isolated villages of the Val Venosta (Vinschgau) in South Tyrol, Italy, surveyed by the European Academy of Bozen/Bolzano (EURAC) in 2002–2003 and 2007, with reconstructed genealogies, to study the genetic epidemiology of Mendelian and complex diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17550581") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12119133/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17550581") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17550581+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The MICROS study is a population-based survey on three small, isolated villages, characterized by: old settlement; small number of founders; high endogamy rates; slow/null population expansion.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000834> "A population-based family study of about 1,300 adults from Stelvio, Vallelunga and Martello, three small, historically isolated villages of the Val Venosta (Vinschgau) in South Tyrol, Italy, surveyed by the European Academy of Bozen/Bolzano (EURAC) in 2002–2003 and 2007, with reconstructed genealogies, to study the genetic epidemiology of Mendelian and complex diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17550581") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12119133/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12119133/fullTextXML") Annotation(rdfs:comment "The prior MICROS study enrolled 1314 residents of three Vinschgau municipalities 18 years or older in 2002–3 and 2007 [8].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000834> "A population-based family study of about 1,300 adults from Stelvio, Vallelunga and Martello, three small, historically isolated villages of the Val Venosta (Vinschgau) in South Tyrol, Italy, surveyed by the European Academy of Bozen/Bolzano (EURAC) in 2002–2003 and 2007, with reconstructed genealogies, to study the genetic epidemiology of Mendelian and complex diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000835> (<http://www.ebi.ac.uk/coho/COHO_0000835>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30902044") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30902044") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6431016/fullTextXML") Annotation(rdfs:comment "In summary, participants were randomly selected from the Swedish national population register and invited by mail.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000835> "A prospective population-based multicentre study of 3,014 men aged 69–81, randomly selected from the Swedish national population register and examined at hospitals in Malmö, Gothenburg and Uppsala in 2001–2004, the Swedish part of the Osteoporotic Fractures in Men study, set up to identify risk factors for osteoporosis and fracture.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30902044") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30902044") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6431016/fullTextXML") Annotation(rdfs:comment "The Osteoporotic Fractures in Men (MrOs) Sweden study is a prospective population-based multicenter observational study consisting of 3014 older men aged between 69 and 81 years at inclusion (mean age 75.4 ± (SD) 3.2 years), with the main aim to identify risk factors for osteoporosis and fracture.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000835> "A prospective population-based multicentre study of 3,014 men aged 69–81, randomly selected from the Swedish national population register and examined at hospitals in Malmö, Gothenburg and Uppsala in 2001–2004, the Swedish part of the Osteoporotic Fractures in Men study, set up to identify risk factors for osteoporosis and fracture.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30902044") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30902044") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6431016/fullTextXML") Annotation(rdfs:comment "The participants were recruited and measured at hospitals in the three cities of Malmö (n = 1005), Gothenburg (n = 1010) and Uppsala (n = 999) between October 2001 and December 2004 with an attendance rate of 45% [16].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000835> "A prospective population-based multicentre study of 3,014 men aged 69–81, randomly selected from the Swedish national population register and examined at hospitals in Malmö, Gothenburg and Uppsala in 2001–2004, the Swedish part of the Osteoporotic Fractures in Men study, set up to identify risk factors for osteoporosis and fracture.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30902044") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32067027") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7069346/fullTextXML") Annotation(rdfs:comment "The Osteoporotic Fractures in Men (MrOS) study is a multicenter, prospective study including older men in Sweden, Hong Kong, and the United States.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000835> "A prospective population-based multicentre study of 3,014 men aged 69–81, randomly selected from the Swedish national population register and examined at hospitals in Malmö, Gothenburg and Uppsala in 2001–2004, the Swedish part of the Osteoporotic Fractures in Men study, set up to identify risk factors for osteoporosis and fracture.")

