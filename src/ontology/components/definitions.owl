AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42862790") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42862790+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To better understand the disease biology, we employed whole transcriptome RNA sequencing to study the gene expression profiles of RDD as part of the Atlas of Blood Cancer Genomes (ABCG) initiative.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000219> "A project that assembles and sequences cohorts of patients with distinct blood cancers, including blastic plasmacytoid dendritic cell neoplasm, high-grade B-cell lymphoma and T lymphoblastic leukaemia/lymphoma, to build a genomic atlas of haematological malignancies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000001346") Annotation(rdfs:comment "Blastic Plasmacytoid Dendritic Cell Neoplasm: Atlas of Blood Cancer Genomes") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000219> "A project that assembles and sequences cohorts of patients with distinct blood cancers, including blastic plasmacytoid dendritic cell neoplasm, high-grade B-cell lymphoma and T lymphoblastic leukaemia/lymphoma, to build a genomic atlas of haematological malignancies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000001346") Annotation(rdfs:comment "To address this gap, we performed integrated DNA and RNA sequencing on 88 BPDCN patients representing the largest and most ancestrally diverse cohort described to date (~77% European, ~16% Asian, ~7% African).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000219> "A project that assembles and sequences cohorts of patients with distinct blood cancers, including blastic plasmacytoid dendritic cell neoplasm, high-grade B-cell lymphoma and T lymphoblastic leukaemia/lymphoma, to build a genomic atlas of haematological malignancies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000220> (<http://www.ebi.ac.uk/coho/COHO_0000220>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006276") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001006276") Annotation(rdfs:comment "Analysis of rare germline variants in childhood AML in a large panel of cancer predisposition genes (n=216) compiled from literature review, and including genes involved in familial hematological malignancies (HM) and bone marrow failure (BMF) syndromes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000220> "A cohort of Australian children with acute myeloid leukaemia whose exomes were analysed for rare germline variants in cancer predisposition genes, compared with the Medical Genome Reference Bank and the TARGET cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006276") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001006276") Annotation(rdfs:comment "Overall, 21% of the Australian cohort and 25% of the TARGET cohort presented germline variants predicted to be damaging predisposition variants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000220> "A cohort of Australian children with acute myeloid leukaemia whose exomes were analysed for rare germline variants in cancer predisposition genes, compared with the Medical Genome Reference Bank and the TARGET cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006276") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001006276") Annotation(rdfs:comment "The prevalence of extremely rare variants in the combined childhood AML cohort (n=72) was compared to that in the Medical Genome Reference Bank (MGRB; n=2570) comprising individuals aged at least 70 years with no history of cardiovascular disease, dementia or cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000220> "A cohort of Australian children with acute myeloid leukaemia whose exomes were analysed for rare germline variants in cancer predisposition genes, compared with the Medical Genome Reference Bank and the TARGET cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006276") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001006276") Annotation(rdfs:comment "This dataset contains one vcf file with variants from whole exome sequencing of 24 paediatric AML samples at diagnosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000220> "A cohort of Australian children with acute myeloid leukaemia whose exomes were analysed for rare germline variants in cancer predisposition genes, compared with the Medical Genome Reference Bank and the TARGET cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000221> (<http://www.ebi.ac.uk/coho/COHO_0000221>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007976") Annotation(rdfs:comment "HCA_Blood_Disease_Atopic_Dermatitis_BEACONomics_DNA_Managed_Access Defining the spatial transcriptome and cell-cell interactions in atopic dermatitis skin") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000221> "A cohort of patients with atopic dermatitis enrolled in the BEACON eczema drug trial, whose skin and blood samples were profiled by spatial and single-cell transcriptomics and genome sequencing to define cell-cell interactions in atopic dermatitis skin.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sangerinstitute.blog/2026/07/01/5-questions-on-eczema-with-anna-vathrakokoili-pournara/") Annotation(rdfs:comment "We are collecting blood and skin biopsies at different time points: before treatment, three days after treatment, 14 days after treatment and 12 weeks after treatment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000221> "A cohort of patients with atopic dermatitis enrolled in the BEACON eczema drug trial, whose skin and blood samples were profiled by spatial and single-cell transcriptomics and genome sequencing to define cell-cell interactions in atopic dermatitis skin.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://sangerinstitute.blog/2026/07/01/5-questions-on-eczema-with-anna-vathrakokoili-pournara/") Annotation(rdfs:comment "What makes BEACON different from most clinical trials is that, alongside standard clinical assessments, we are also using single-cell and spatial technologies to understand what is happening at a cellular and tissue level in much greater detail.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000221> "A cohort of patients with atopic dermatitis enrolled in the BEACON eczema drug trial, whose skin and blood samples were profiled by spatial and single-cell transcriptomics and genome sequencing to define cell-cell interactions in atopic dermatitis skin.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.beacontrial.org/") Annotation(rdfs:comment "BEACON is a UK-wide randomised, controlled, 12-month assessor-blind trial in 536 adults who require systemic treatment for their eczema.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000221> "A cohort of patients with atopic dermatitis enrolled in the BEACON eczema drug trial, whose skin and blood samples were profiled by spatial and single-cell transcriptomics and genome sequencing to define cell-cell interactions in atopic dermatitis skin.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000222> (<http://www.ebi.ac.uk/coho/COHO_0000222>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30333627") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30333627") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6280667/fullTextXML") Annotation(rdfs:comment "All patients gave informed consent to participate in this study, which had the approval and guidance of the institutional review boards at Oregon Health & Science University (OHSU), University of Utah, University of Texas Medical Center (UT Southwestern), Stanford University, University of Miami, University of Colorado") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000222> "A cohort of patients with acute myeloid leukaemia enrolled by the Beat AML programme in the United States, whose tumour specimens were characterised by exome and RNA sequencing and ex vivo drug sensitivity testing to guide precision therapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30333627") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30333627") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6280667/fullTextXML") Annotation(rdfs:comment "To better understand genetic or transcriptional markers and mechanisms of drug sensitivity and resistance in AML, we developed a cohort of 672 primary specimens from 562 unique AML patients on which extensive functional and genomic interrogations were undertaken.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000222> "A cohort of patients with acute myeloid leukaemia enrolled by the Beat AML programme in the United States, whose tumour specimens were characterised by exome and RNA sequencing and ex vivo drug sensitivity testing to guide precision therapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30333627") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30333627") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30333627+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Here we report initial findings from the Beat AML programme on a cohort of 672 tumour specimens collected from 562 patients.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000222> "A cohort of patients with acute myeloid leukaemia enrolled by the Beat AML programme in the United States, whose tumour specimens were characterised by exome and RNA sequencing and ex vivo drug sensitivity testing to guide precision therapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30333627") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30333627") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30333627+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We assessed these specimens using whole-exome sequencing, RNA sequencing and analyses of ex vivo drug sensitivity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000222> "A cohort of patients with acute myeloid leukaemia enrolled by the Beat AML programme in the United States, whose tumour specimens were characterised by exome and RNA sequencing and ex vivo drug sensitivity testing to guide precision therapy.")

