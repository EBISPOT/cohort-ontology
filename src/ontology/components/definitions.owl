AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22267197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature24284/MediaObjects/41586_2017_BFnature24284_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22267197") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1049/MediaObjects/41588_2012_BFng1049_MOESM2_ESM.pdf") Annotation(rdfs:comment "MBCSG Milan Breast Cancer Study Group 27 Italy Familial and/or early onset breast cancer patients (aged 22-87) negative for mutations in BRCA1 and BRCA2, ascertained at two large cancer centers in Milan from 2000-present Female blood donors recruited at two centres in Milan from 2004-present and 2007-present") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002038> "A case-control study of breast cancer in Milan, Italy, whose cases are patients with familial or early-onset breast cancer who test negative for BRCA1 and BRCA2 mutations, ascertained from 2000 at two large cancer centres in Milan, and whose controls are female blood donors recruited at two Milan centres from 2004 and 2007; it is one of the studies of the Breast Cancer Association Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22267197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature24284/MediaObjects/41586_2017_BFnature24284_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature24284/MediaObjects/41586_2017_BFnature24284_MOESM1_ESM.pdf") Annotation(rdfs:comment "MBCSG Milan Breast Cancer Study Group129,130 Clinic-based recruitment of familial/early onset breast cancer cases ; population-based controls Italy") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002038> "A case-control study of breast cancer in Milan, Italy, whose cases are patients with familial or early-onset breast cancer who test negative for BRCA1 and BRCA2 mutations, ascertained from 2000 at two large cancer centres in Milan, and whose controls are female blood donors recruited at two Milan centres from 2004 and 2007; it is one of the studies of the Breast Cancer Association Consortium.")

