# Individual: <http://www.ebi.ac.uk/coho/COHO_0000877> (<http://www.ebi.ac.uk/coho/COHO_0000877>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42557812") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000877> "A prospective multicentre US cohort of 10,038 nulliparous women with singleton pregnancies recruited in the first trimester at eight clinical sites between 2010 and 2013 and followed through pregnancy, to study the factors that contribute to adverse pregnancy outcomes such as preterm birth, preeclampsia and gestational diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000878> (<http://www.ebi.ac.uk/coho/COHO_0000878>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41287920") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000878> "A population-based study of youths aged 8–21 living in the greater Philadelphia area, United States, recruited through the Children’s Hospital of Philadelphia Center for Applied Genomics from non-psychiatric paediatric clinics and assessed with clinical, neurocognitive and neuroimaging measures to describe how genetics affects brain development and cognitive functioning in adolescence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000879> (<http://www.ebi.ac.uk/coho/COHO_0000879>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26034056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000879> "A study within Kaiser Permanente Northern California that ascertained African-American prostate cancer cases, genotyped together with the Research Program on Genes, Environment and Health cohort and the California Men's Health Study for genome-wide association studies of prostate cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000880> (<http://www.ebi.ac.uk/coho/COHO_0000880>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31095341") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37862240") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000880> "An international consortium, established in 2009, of cohorts of cancer patients treated with radiotherapy (for prostate, head and neck, breast and lung cancer, among others) that shares genotype and normal-tissue toxicity data and develops meta-analysis methods to identify genetic variants associated with radiation-induced toxicity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000881> (<http://www.ebi.ac.uk/coho/COHO_0000881>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000881> "A population-based case-control study in East Anglia, UK, run from Cambridge with Cancer Research UK funding, in which people with cancer registered with the Eastern Cancer Registration and Information Centre and controls attending general practice in East Anglia provide data and DNA to study genetic susceptibility to cancers including breast and prostate cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000882> (<http://www.ebi.ac.uk/coho/COHO_0000882>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15465616") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000882> "An observational multicentre study in the United States of physician-diagnosed diabetes in people under 20 years old, ascertaining prevalent and incident cases in geographically defined populations and health plans, with interviews, examinations and laboratory measurements, to estimate the prevalence, incidence and classification of diabetes in youth.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000883> (<http://www.ebi.ac.uk/coho/COHO_0000883>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37326842") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000883> "A biobank of the Swedish Rheumatology Quality Register holding blood samples, linked to register data, from more than 5500 patients with rheumatoid arthritis in Sweden who have early disease or are starting a biological disease-modifying drug, used for genetic and treatment-response research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000884> (<http://www.ebi.ac.uk/coho/COHO_0000884>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37326842") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000884> "A nationwide quality register of patients with rheumatic diseases, established in Sweden in the mid-1990s and used by most Swedish rheumatologists to monitor the disease course of patients as part of standard care.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000885> (<http://www.ebi.ac.uk/coho/COHO_0000885>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42014397") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000885> "A clinical sample of patients with Alzheimer's disease evaluated at the memory disorder unit of Skåne University Hospital, Sweden, with physical, neurological and psychiatric examination, a clinical interview, cognitive testing, APOE genotyping and brain imaging, whose cerebrospinal fluid Alzheimer's biomarker data were used in a genome-wide association meta-analysis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000886> (<http://www.ebi.ac.uk/coho/COHO_0000886>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22159772") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000886> "A population-based study of 2,488 people aged 65 and older in the province of Toledo, Spain, selected by two-stage random sampling from the municipal census and covering institutionalised and community-dwelling persons in rural and urban settings, with data collected from 2006 to study frailty and healthy ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000887> (<http://www.ebi.ac.uk/coho/COHO_0000887>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23505255") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000887> "A multidisciplinary, multi-institutional cohort of about 1,600 older adults aged 60–80 and 600 younger adults aged 20–35 recruited as volunteers in the Berlin metropolitan area, Germany, with baseline assessments completed in 2014 across geriatrics, internal medicine, immunology, genetics, psychology, sociology and economics, to identify factors associated with healthy versus unhealthy ageing; a subsample of the older group was re-examined in 2018–2020 in the GendAge study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000888> (<http://www.ebi.ac.uk/coho/COHO_0000888>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40563098") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000888> "The second cohort of the Rotterdam Study, a prospective population-based cohort of 3,011 inhabitants of Ommoord, a suburb of Rotterdam in the Netherlands, who had moved to the district or turned 55 since the first cohort began, enrolled from 2000 and re-examined about every 5 years to study determinants of chronic diseases in older adults.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000889> (<http://www.ebi.ac.uk/coho/COHO_0000889>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30902044") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000889> "The Malmö sub-cohort of MrOS Sweden: 1,005 men aged 69–81, randomly selected from the Swedish national population register and examined at hospital in Malmö, Sweden, in 2001–2004, to identify risk factors for osteoporosis and fracture.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000890> (<http://www.ebi.ac.uk/coho/COHO_0000890>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40366610") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000890> "An ongoing prospective cohort study of older adults in the Netherlands, started in 1992 with a nationally representative sample aged 55–84 and refreshed with further cohorts in 2002, 2012 and 2024, to describe determinants, trajectories and consequences of changes in physical, cognitive, emotional and social functioning.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000891> (<http://www.ebi.ac.uk/coho/COHO_0000891>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32374401") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000891> "A multicentre Finnish study of women who gave birth in 2009–2012, with a prospective genetic case-control arm of 1,146 pregnant women with gestational diabetes and 1,066 without, their children and the children’s fathers, recruited at seven hospitals, and a national register-based arm, to study the causes and consequences of gestational diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000892> (<http://www.ebi.ac.uk/coho/COHO_0000892>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30902044") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000892> "The Gothenburg sub-cohort of MrOS Sweden: 1,010 men aged 69–81, randomly selected from the Swedish national population register and examined at hospital in Gothenburg, Sweden, in 2001–2004, to identify risk factors for osteoporosis and fracture.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000893> (<http://www.ebi.ac.uk/coho/COHO_0000893>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28430825") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000893> "A consortium of genome-wide association studies of individuals of African ancestry that meta-analyses results from participating studies (up to about 53,000 individuals for body mass index) to discover and fine-map genetic loci for adiposity and other anthropometric traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000894> (<http://www.ebi.ac.uk/coho/COHO_0000894>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33960523") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000894> "A public–private research programme managed by the Foundation for the National Institutes of Health that harmonizes whole-genome sequencing, RNA expression and clinical data from multiple Parkinson's disease cohort studies, including PPMI, PDBP, the Harvard Biomarkers Study and BioFIND, on a shared platform for Parkinson's disease research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000895> (<http://www.ebi.ac.uk/coho/COHO_0000895>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9313038/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000895> "A population-based cohort of older adults aged 65 and over, recruited from the electoral rolls of Castellana Grotte, Bari, in Apulia, southern Italy, by the National Institute of Gastroenterology 'Saverio de Bellis' Research Hospital as a public health initiative funded by the Italian Ministry of Health and the Apulia Regional Government, to study ageing, frailty, cognitive decline and related conditions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000896> (<http://www.ebi.ac.uk/coho/COHO_0000896>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22751097") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000896> "A case-control collection of Han Chinese participants from Beijing, China, with myocardial infarction cases verified by hospital records and cardiologists and controls randomly selected from a community-based survey of cardiovascular risk factors in Beijing, assembled to study genetic susceptibility to coronary artery disease and atherosclerosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000897> (<http://www.ebi.ac.uk/coho/COHO_0000897>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13569458/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000897> "A nation-wide Dutch collaborative project that combines genotype data from sixteen population and clinical cohorts in the Netherlands with uniform, DSM-based phenotyping of major depressive disorder, pooled centrally for genetic mega-analysis of depression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000898> (<http://www.ebi.ac.uk/coho/COHO_0000898>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17311856") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34754074") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000898> "A multiethnic longitudinal study of healthy children at five clinical centres in the United States, enrolled from 2002–2003 at ages 6 to 16 years (1,554 children), with a later enrolment wave of 5- and 19-year-olds, measured annually by dual-energy X-ray absorptiometry for up to 6 years, established to provide reference curves for bone mineral content and density by age, sex and race.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000899> (<http://www.ebi.ac.uk/coho/COHO_0000899>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30601841") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000899> "A population-based case-control study of women aged 20–80 with in situ or invasive breast cancer diagnosed from April 2005 to May 2009 in Metro Vancouver, British Columbia, and Kingston, Ontario, Canada, with cases from the BC Cancer Registry and controls from the Screening Mammography Program of BC in Vancouver, and cases and controls from the Hotel Dieu Breast Assessment Program in Kingston.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000900> (<http://www.ebi.ac.uk/coho/COHO_0000900>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34581777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41194662") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000900> "A panel of volunteers in Cambridge, England, including blood donors registered with NHS Blood and Transplant, who have consented to be recalled for research studies by genotype or phenotype; the Cambridge centre of the NIHR BioResource, funded by the NIHR Cambridge Biomedical Research Centre and NHS Blood and Transplant.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000901> (<http://www.ebi.ac.uk/coho/COHO_0000901>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17466083") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41266372") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000901> "An international consortium of research groups that collect DNA and clinical data from carriers of BRCA1 and BRCA2 mutations, established to identify genetic modifiers of breast and ovarian cancer risk in mutation carriers; it began with about 30 affiliated groups and later brought together more than 60 studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000902> (<http://www.ebi.ac.uk/coho/COHO_0000902>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33863885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000902> "A European multicentre prospective study of patients with non-muscle-invasive bladder cancer, with tumour multi-omics and germline genotype data and clinical follow-up for recurrence and progression, used to define molecular subtypes of the disease and in genetic studies of bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000903> (<http://www.ebi.ac.uk/coho/COHO_0000903>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25001365") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25400699") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000903> "A community-based health examination survey cohort of 6,431 adults aged 18–93 years randomly selected in 2009 from residents of the urban area of Xuzhou, Jiangsu, China, by Xuzhou Central Hospital, to study cardiometabolic risk factors such as insulin resistance, prediabetes, hypertension and early atherosclerosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000904> (<http://www.ebi.ac.uk/coho/COHO_0000904>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35393395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000904> "A cohort of clozapine-treated patients with schizophrenia recruited by the Cooperative Research Centre from inpatient and outpatient clinics around Melbourne, Australia, with symptom severity (PANSS) assessments, contributing to genetic studies of clozapine treatment outcome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000905> (<http://www.ebi.ac.uk/coho/COHO_0000905>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32193507") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000905> "An international consortium of cohorts of European and Asian ancestry that pools cohort-level genome-wide association results to study refractive error, myopia and ocular biometric traits such as axial length and corneal curvature.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000906> (<http://www.ebi.ac.uk/coho/COHO_0000906>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000906> "A population-based cohort study in Doetinchem, the Netherlands, started by the Dutch National Institute for Public Health and the Environment (RIVM) as a monitoring study of cardiovascular risk factors, in which 12,404 inhabitants aged 20–59, drawn as an age- and sex-stratified sample of the population register, were examined in 1987–1991 and two-thirds of them were re-invited to repeated rounds, to study lifestyle and other determinants of health, functioning and chronic disease over the life course.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000907> (<http://www.ebi.ac.uk/coho/COHO_0000907>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34834492") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000907> "A clinic-based case-control study of self-identified Latino children and young adults aged 8–22 years with and without asthma, recruited at centres in the mainland United States and Puerto Rico under the University of California, San Francisco, to study the genetic and environmental basis of childhood-onset asthma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000908> (<http://www.ebi.ac.uk/coho/COHO_0000908>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35778749") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000908> "A population-based Dutch birth cohort of children of almost 3,000 pregnant women living in the province of Drenthe in the northern Netherlands, recruited in 2006, followed to study early risk factors for overweight and obesity in childhood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000909> (<http://www.ebi.ac.uk/coho/COHO_0000909>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36629499") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000909> "A Swedish population-based case-control study of multiple sclerosis in which prevalent cases fulfilling the McDonald criteria were identified from the Swedish MS registry and controls were randomly selected from the national population register, with lifestyle and environmental questionnaires and blood samples for genetic analyses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000910> (<http://www.ebi.ac.uk/coho/COHO_0000910>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30234784") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000910> "A prospective cohort of normotensive children of African or European ancestry aged 5–16 years in 1989, recruited through a county-wide public school screening in Richmond County, Georgia, United States, and re-evaluated repeatedly into adulthood to study the development of cardiovascular risk factors from childhood to adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000911> (<http://www.ebi.ac.uk/coho/COHO_0000911>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36973338") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000911> "A longitudinal population study of more than 5000 adults aged 40 and older in Bushbuckridge, rural Mpumalanga, South Africa, recruited in 2014–2015 within the Agincourt Health and Demographic Surveillance System, collecting socio-demographic, infection history and cognitive data to study health and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000912> (<http://www.ebi.ac.uk/coho/COHO_0000912>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22933647") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000912> "A health and socio-demographic surveillance system of about 90,000 people in rural northeast South Africa close to the Mozambique border, established in 1992, which updates resident status and vital events annually and hosts observational cohorts and trials across the life course on health, population and social transitions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000913> (<http://www.ebi.ac.uk/coho/COHO_0000913>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3674994/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5300151/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000913> "A population-based cohort of 3,471 adults aged 18–69, randomly sampled from the Danish Central Personal Register in the southern part of Copenhagen and examined in 2006–2008 at the Research Centre for Prevention and Health in Glostrup, Denmark, to study general health, allergy, diabetes and cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000914> (<http://www.ebi.ac.uk/coho/COHO_0000914>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33590662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8503053/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000914> "A longitudinal population-based study of 5,133 adults from the German city of Heidelberg and its surroundings, started in the 1990s with a baseline battery of health-related personality questionnaires to characterise associations between personality and somatic disease, and later followed up and genotyped.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000915> (<http://www.ebi.ac.uk/coho/COHO_0000915>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34480422") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000915> "A global collaboration of 51 studies from 11 countries with genome-wide genotyping and data on heart failure events and prognosis, including population-based cohorts, hospital-based electronic health record cohorts, case-control studies and clinical trials, formed to conduct large-scale genetic association studies of heart failure risk, prognosis and subtypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000916> (<http://www.ebi.ac.uk/coho/COHO_0000916>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35446358") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37386247") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000916> "A large international consortium established to identify glaucoma risk genes through large-scale genome-wide meta-analysis of primary open-angle glaucoma and related traits such as intraocular pressure, vertical cup-to-disc ratio and central corneal thickness, across populations of European, Asian and African ancestry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000917> (<http://www.ebi.ac.uk/coho/COHO_0000917>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21051598") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000917> "A multinational study that recruited HIV-1 controllers, people with HIV whose plasma viral load stays below 2000 RNA copies/ml (at least three measurements over at least 12 months) without antiretroviral therapy, for genome-wide association analysis of host genetic effects on the control of HIV infection.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000918> (<http://www.ebi.ac.uk/coho/COHO_0000918>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000918> "A set of Swedish post-marketing (phase IV) cohorts of patients with multiple sclerosis treated with novel disease-modifying drugs, followed through the Swedish MS registry to monitor the long-term safety and risks of immunomodulatory treatments.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000919> (<http://www.ebi.ac.uk/coho/COHO_0000919>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31815703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000919> "An international research alliance founded in 2009 of more than 100 scientists who pool genetic, clinical and functional data from Parkinson's disease case-control cohorts worldwide for collaborative genetics research on Parkinson's disease, with recent efforts in East Asia and Africa.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000920> (<http://www.ebi.ac.uk/coho/COHO_0000920>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855068") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000920> "A collection of 2994 healthy Japanese volunteers assembled by the Japan Pharmacogenomics Data Science Consortium, with genotypes of 2.5 million SNPs and 5 HLA loci and 121 kinds of clinical information, as control data for pharmacogenomics studies of drug safety and efficacy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000921> (<http://www.ebi.ac.uk/coho/COHO_0000921>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32799709") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000921> "A randomized, double-blind, placebo-controlled trial of rosuvastatin 20 mg daily for the primary prevention of cardiovascular disease in 17,802 apparently healthy men aged 50 or over and women aged 60 or over with low LDL cholesterol but elevated high-sensitivity C-reactive protein, funded by AstraZeneca and stopped early for efficacy after a median follow-up of 1.9 years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000922> (<http://www.ebi.ac.uk/coho/COHO_0000922>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16343090") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42116128") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000922> "A prospective Dutch birth cohort of healthy pregnant women enrolled from October 2000 to 2002, recruited from a cohort study on pregnancy-related pelvic girdle pain ('conventional lifestyles') and, for contrast, through organic food shops, anthroposophic doctors and midwives, Steiner schools and dedicated magazines ('alternative lifestyles'), and their children, set up to identify lifestyle and other early-life factors that influence atopic disease and followed into young adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000923> (<http://www.ebi.ac.uk/coho/COHO_0000923>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22226020") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000923> "A clinic-based case-control study of breast cancer begun in February 2001 at Mayo Clinic, Rochester, Minnesota, enrolling women aged 18 or over with invasive breast cancer who lived in the six-state region of Mayo Clinic's primary service population, and cancer-free controls frequency-matched on age, race and region from Mayo Clinic's general internal medicine practice.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000924> (<http://www.ebi.ac.uk/coho/COHO_0000924>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23152984") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000924> "A prospective breast screening cohort of 19,924 women aged 35 or over, resident in Minnesota, Iowa or Wisconsin and without a history of breast cancer, enrolled when having a screening mammogram at Mayo Clinic, Rochester, from October 2003 to September 2006, to study mammographic density and breast cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000925> (<http://www.ebi.ac.uk/coho/COHO_0000925>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11254450") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000925> "A collection of families with multiple siblings affected by rheumatoid arthritis, gathered in the United States by the North American Rheumatoid Arthritis Consortium using well-defined clinical criteria and a severe-phenotype selection of probands, later extended with case-control collections (NARAC-II, NARAC-III), for linkage and association studies of rheumatoid arthritis genetics.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000926> (<http://www.ebi.ac.uk/coho/COHO_0000926>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159511") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000926> "The central national biobank of South Korea, opened by the Korea National Institute of Health as the hub of the Korea Biobank Network with regional hospital biobanks, which holds and distributes biospecimens and data from general-population cohort studies such as the Korean Genome and Epidemiology Study and from hospital patients for biomedical and public health research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000927> (<http://www.ebi.ac.uk/coho/COHO_0000927>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000927> "A population-based prospective cohort of more than 140,000 participants in Norrbotten and Västerbotten, the two northernmost regions of Sweden, initiated in the mid-1980s and managed by Umeå University, combining three sub-cohorts (the Västerbotten Intervention Programme, the expanded Northern Sweden MONICA study and the Mammography Screening Project) with over 240,000 stored blood samples, for research on the aetiology, prevention and early detection of cancer, cardiovascular and other diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000928> (<http://www.ebi.ac.uk/coho/COHO_0000928>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000928> "The Ontario site of the Breast Cancer Family Registry, which enrolled women with invasive breast cancer diagnosed in 1996–1998 identified through the Ontario Cancer Registry (all those aged 20–54 at high genetic risk and random samples of others, with high-risk cases diagnosed in 2001–2002 added), together with their relatives and population controls, to study the genetic epidemiology of breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000929> (<http://www.ebi.ac.uk/coho/COHO_0000929>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26151264") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000929> "A randomised, double-blind trial in which 371 adults with a first unprovoked pulmonary embolism, after six months of vitamin K antagonist treatment, were randomised to a further 18 months of warfarin or placebo and followed between 2007 and 2014 at 14 French centres, comparing recurrent venous thromboembolism and major bleeding.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000930> (<http://www.ebi.ac.uk/coho/COHO_0000930>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000930> "A population-based case-control study of breast cancer in Warsaw and Łódź, Poland, in 2000–2003, funded by the intramural programme of the US National Cancer Institute, in which cases were women aged 20–74 with newly diagnosed in situ or invasive breast cancer identified through a rapid identification system at participating hospitals and through cancer registries.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000931> (<http://www.ebi.ac.uk/coho/COHO_0000931>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32203222") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000931> "A cohort of women aged 47–73 recruited from 2009 at routine NHS Breast Screening Programme appointments in Manchester, UK, who completed risk-factor questionnaires and had breast density measured, a subset also giving DNA, to study breast cancer risk prediction at screening.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000932> (<http://www.ebi.ac.uk/coho/COHO_0000932>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17254404") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000932> "A registry of twins and multiples of all ages in Qingdao, China, initiated in 1998 as part of the Chinese National Twin Registry, with more than 11,000 twin pairs recruited and adolescent, adult and elderly twin cohorts sampled for studies of chronic disease, metabolic disorders, health behaviours and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000933> (<http://www.ebi.ac.uk/coho/COHO_0000933>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31270876") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000933> "A population-based twin registry in China, established in 2001, which includes data on over 61,000 twin pairs from 11 provinces or cities and collects biological specimens from disease-concordant and disease-discordant twin pairs, to analyse genetic and environmental influences on chronic diseases, especially cardiovascular diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000934> (<http://www.ebi.ac.uk/coho/COHO_0000934>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.reprogen.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000934> "An international network of investigators that meta-analyses genome-wide association study data from many cohorts to identify genetic variants and genes affecting reproductive ageing and reproductive timing, such as age at menarche and age at natural menopause.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000935> (<http://www.ebi.ac.uk/coho/COHO_0000935>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22226020") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000935> "A population-based case-control study of postmenopausal breast cancer in women aged 50–74 born in Sweden, with incident cases identified through the Swedish regional cancer registries and controls randomly selected from the Swedish population register, enrolled in 1993–1995, with ethical approval at Karolinska Institutet and funding from Singapore (A*STAR) and the US.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000936> (<http://www.ebi.ac.uk/coho/COHO_0000936>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000936> "A hospital-based case–control study of lung cancer in Toronto, Canada, run by the University of Toronto and the Samuel Lunenfeld Research Institute of Mount Sinai Hospital, whose genome-wide genotyped cases and controls contribute to international lung cancer consortia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000937> (<http://www.ebi.ac.uk/coho/COHO_0000937>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39862296") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000937> "A hospital-based case–control cohort of patients with gastric cancer and non-cancer controls aged 26–80 recruited at the Digestive Disease Center of Seoul National University Bundang Hospital, South Korea, with genome-wide genotypes, Helicobacter pylori status and lifestyle data, used to study genetic risk of gastric cancer by histological type and sex.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000938> (<http://www.ebi.ac.uk/coho/COHO_0000938>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31932529") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000938> "A community-based cohort of adults aged 20 years or over living in Miyagi or Iwate Prefecture, Japan, of whom 87,865 consented to join through health check-ups and assessment centres of the Tohoku Medical Megabank Project, to assess the long-term impact of the Great East Japan Earthquake and gene–environment interactions in major diseases such as cancer and cardiovascular disease, with genome and metabolome information.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000939> (<http://www.ebi.ac.uk/coho/COHO_0000939>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31504573") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000939> "A birth and three-generation cohort in Japan conducted since July 2013 by the Tohoku Medical Megabank Organization of Tohoku University and the Iwate Tohoku Medical Megabank Organization, recruiting pregnant women and their fetuses as probands together with the fathers, grandparents, siblings and extended family members, with genome and omics information, to study disease risk across generations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000940> (<http://www.ebi.ac.uk/coho/COHO_0000940>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25431468") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000940> "A Dutch clinical cohort of 543 children who had been referred to a child psychiatric outpatient clinic in the Northern Netherlands before the age of 11, enrolled from 2004 alongside the TRAILS population cohort and followed from about age 11 with repeated assessments of mental health and development into young adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000941> (<http://www.ebi.ac.uk/coho/COHO_0000941>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5697951/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000941> "A collection of Chinese people with type 2 diabetes in Taiwan, with and without proliferative diabetic retinopathy, assembled from 1996 to 2011 by Taiwanese and US investigators for genetic studies of diabetic retinopathy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000942> (<http://www.ebi.ac.uk/coho/COHO_0000942>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21897394") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000942> "A UK general-population cohort started in 2003 that recruited 112,049 participants aged 16–102 by 2011 through a generational referral method, in which women recruited directly nominated female friends and relatives, collecting detailed questionnaires and blood samples repeatedly over decades to investigate breast cancer aetiology.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000943> (<http://www.ebi.ac.uk/coho/COHO_0000943>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28649285") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000943> "A multicentre prospective cohort of people with type 2 diabetes, with diabetes-free controls included at baseline, in the city of Eindhoven, the Netherlands, extensively phenotyped to study the aetiology of type 2 diabetes and its micro- and macrovascular complications.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000944> (<http://www.ebi.ac.uk/coho/COHO_0000944>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37402774") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000944> "A Danish clinical research programme, the Copenhagen Prospective Studies on Asthma in Childhood, made up of mother-child birth cohorts: COPSAC2000, a high-risk cohort of 411 children of mothers with a doctor's diagnosis of asthma, enrolled in the first month of life, and COPSAC2010, a cohort of 700 children born to unselected mothers from Denmark.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000945> (<http://www.ebi.ac.uk/coho/COHO_0000945>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26034056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000945> "A multiethnic genome-wide association study sample of prostate cancer from Kaiser Permanente health plan members in California, combining prostate cancer cases from three Kaiser Permanente studies (the Research Program on Genes, Environment and Health, the ProHealth Study and the California Men's Health Study) with men of the Genetic Epidemiology Research on Aging cohort without a prostate cancer diagnosis as controls (7,783 cases and 38,595 controls; 80.3% non-Hispanic white, 4.9% African American, 7.0% East Asian and 7.8% Latino).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000946> (<http://www.ebi.ac.uk/coho/COHO_0000946>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000946> "A family study of Mexican Americans in the Los Angeles area, United States, designed to identify genetic determinants of pancreatic β-cell function, which recruited non-diabetic women with a history of gestational diabetes mellitus, their adult family members, and women without a history of gestational diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000947> (<http://www.ebi.ac.uk/coho/COHO_0000947>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31235808") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000947> "An international consortium of epidemiological cohorts from Europe, the United States and Japan with detailed clinical information on dental diseases, within which genome-wide association studies of dental caries and periodontitis are conducted and meta-analysed.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000948> (<http://www.ebi.ac.uk/coho/COHO_0000948>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25843019") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000948> "A longitudinal observational study of cognitively normal older adults, designed to distinguish normal ageing from preclinical Alzheimer's disease, with demographic, clinical, neuropsychological, clinical biomarker and neuroimaging data, including amyloid PET acquired at Massachusetts General Hospital in Boston, United States.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000949> (<http://www.ebi.ac.uk/coho/COHO_0000949>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39458530") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000949> "A prospective cohort study of osteoporosis and fracture in Southern Chinese women and men recruited from the community in Hong Kong between 1995 and 2010, with questionnaire, anthropometric and clinical assessments at baseline and long-term follow-up through linkage to the Hong Kong Hospital Authority's territory-wide electronic health records.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000950> (<http://www.ebi.ac.uk/coho/COHO_0000950>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37794016") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000950> "An ongoing study at Henry Ford Health System of members of the health system aged 12–56, with and without a clinical diagnosis of asthma, from southeast Michigan and the Detroit metropolitan area, United States, enrolled with a staff-administered questionnaire and lung function testing to study asthma phenotypes and pharmacogenomic interactions across racial and ethnic groups.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000951> (<http://www.ebi.ac.uk/coho/COHO_0000951>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23356884") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000951> "A prospective birth cohort of pregnant South Asian women aged 18–40 and their offspring, recruited in urban Bangalore and rural Solur in Karnataka, India, and in the Peel region of Ontario, Canada, with questionnaires, anthropometry, a glucose tolerance test, and blood and DNA samples in pregnancy, newborn measurements and follow-up of the children to age 3, to study the environmental and genetic determinants of adiposity among South Asians.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000952> (<http://www.ebi.ac.uk/coho/COHO_0000952>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29187387") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000952> "The clinical cohort of the TRIUMPH biomarker programme: an observational prospective study of adults admitted with acute heart failure, newly diagnosed or decompensated chronic, to 14 hospitals in the Netherlands between September 2009 and December 2013, with repeated blood sampling during one year of follow-up to validate prognostic biomarkers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000953> (<http://www.ebi.ac.uk/coho/COHO_0000953>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22941190") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000953> "A case-control sample for genome-wide association studies of ischaemic stroke and its subtypes, comprising stroke patients of European ancestry admitted to four clinical centres in Australia (Gosford Hospital, John Hunter Hospital in Newcastle, The Queen Elizabeth Hospital in Adelaide and Royal Perth Hospital) between 2003 and 2008, and population controls from the Hunter Community Study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000954> (<http://www.ebi.ac.uk/coho/COHO_0000954>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://egg-consortium.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000954> "A consortium that facilitates joint analysis of genetic data from multiple studies to identify human genomic loci influencing traits related to early growth, from the fetus to young adulthood, such as birth weight and length, gestational duration, head circumference, childhood body mass index and obesity, and pubertal growth.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000955> (<http://www.ebi.ac.uk/coho/COHO_0000955>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30784556") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000955> "A population-based incidence study of all acute vascular events in a defined population covered by nine primary care practices in Oxfordshire, United Kingdom, in which patients presenting with such events, including transient ischaemic attack and stroke, have been ascertained prospectively since 2002 and followed up.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000956> (<http://www.ebi.ac.uk/coho/COHO_0000956>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38155185") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000956> "A prospective observational cohort of postmenopausal Danish women enrolled in 1999–2001, all of whom had previously taken part in randomised placebo-controlled trials or been screened for earlier studies at the Center for Clinical and Basic Research in Copenhagen or Aalborg, established to identify risk factors for age-related diseases and linked to the Danish health registries.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000957> (<http://www.ebi.ac.uk/coho/COHO_0000957>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000957> "A nested case-control genome-wide association study of prostate cancer within the Multiethnic Cohort Study, in which men of African American, Japanese American and Latino ancestry living in Hawaii and California with incident invasive prostate cancer, found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age at cohort entry were genotyped under the Gene Environment Association Studies (GENEVA) initiative.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000958> (<http://www.ebi.ac.uk/coho/COHO_0000958>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30104726") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000958> "A multicomponent epidemiological and neurobiological study of United States Army soldiers, funded by the US Army and the National Institute of Mental Health and carried out in 2009–2014. Its component studies combined Army administrative records with representative surveys of new soldiers, of active-duty soldiers and of brigade combat teams deploying to Afghanistan, some with neurocognitive tests and blood samples, and case-control studies of suicide attempts and deaths, to identify risk and resilience factors for suicidal behaviour and related mental disorders; its survey respondents are followed up in the Army STARRS Longitudinal Study (STARRS-LS).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000959> (<http://www.ebi.ac.uk/coho/COHO_0000959>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15940135") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000959> "A family-based asthma genetics study initiated in Barbados in 1993 on nuclear and extended families, self-reported as African Caribbean, of paediatric asthmatic probands referred from local polyclinics or the Accident and Emergency Department of the Queen Elizabeth Hospital, with recruitment continuing through the Chronic Disease Research Centre in Barbados.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000960> (<http://www.ebi.ac.uk/coho/COHO_0000960>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30669331") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000960> "A population-based case-control study of breast cancer in two French départements, Côte d'Or and Ille-et-Vilaine, in which women under 75 years of age with invasive or in situ breast carcinoma diagnosed from April 2005 to March 2007 and population controls frequency-matched to them by age, recruited over the same period, were interviewed in person by trained nurses, most also giving a blood sample; it has been used to study occupational, environmental and genetic risk factors for breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000961> (<http://www.ebi.ac.uk/coho/COHO_0000961>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33648514") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000961> "A longitudinal cardiovascular biobank of patients treated at the Frankel Cardiovascular Center of Michigan Medicine, the University of Michigan health system, which has recruited since 2013, mainly patients with aortic disease, and links their genotype data to electronic health records and family history data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000962> (<http://www.ebi.ac.uk/coho/COHO_0000962>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18498636") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000962> "A multicentre randomised controlled trial in primary care in Bristol, Birmingham and Newcastle, United Kingdom, in which adults aged 18–74 with a new episode of depression (an ICD-10 depressive episode and a Beck Depression Inventory score of at least 15), recruited from September 2005, were randomly allocated to citalopram or reboxetine to identify genetic and clinical predictors of response to antidepressant treatment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000963> (<http://www.ebi.ac.uk/coho/COHO_0000963>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28983737") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000963> "A Finnish collection of people with type 1 diabetes, most of them diagnosed in childhood, together with members of their families, which has contributed cases, controls and parent–offspring trios to international genetic studies of type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000964> (<http://www.ebi.ac.uk/coho/COHO_0000964>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11176911") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26218444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000964> "A longitudinal, prospective, population-based study of two elderly community-dwelling populations, African Americans in Indianapolis, Indiana, and Yoruba in Ibadan, Nigeria, aged 65 years or older and free of dementia when enrolled in 1992 and 2001, who were re-evaluated every 2-3 years by in-home screening followed by clinical diagnostic assessment, to compare the incidence of dementia and Alzheimer disease between the two sites using identical methods.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000965> (<http://www.ebi.ac.uk/coho/COHO_0000965>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33517887") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41315260") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000965> "A multicentre case-control study of pancreatic ductal adenocarcinoma carried out at centres in Spain, Italy, Sweden, Germany, the United Kingdom and Ireland in 2009-2014 and 2016-2018, which recruited newly diagnosed patients aged 18 and older and, as controls, sex-, age- and area-matched hospital in-patients without cancer whose primary diagnoses were not associated with known risk factors for the disease (population-based controls in Ireland and Sweden), and collected lifestyle, environmental-exposure and medical-history information by in-person interviews.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000966> (<http://www.ebi.ac.uk/coho/COHO_0000966>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22452962") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24349656") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27057831") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000966> "A multicentre case-control study of female breast cancer conducted in Seoul, South Korea, since 1995, which recruited women with histologically confirmed incident breast cancer at university hospitals in Seoul, among them Seoul National University Hospital and Asan Medical Center, and cancer-free controls from health examinees at the same hospitals or in community health screening programmes, collecting risk-factor information by face-to-face interviews with a structured questionnaire.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000967> (<http://www.ebi.ac.uk/coho/COHO_0000967>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18636124") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25133503") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000967> "A population-based case-control study of non-Hodgkin lymphoma in the San Francisco Bay Area, California, that enrolled residents of six Bay Area counties aged 20-85 with incident non-Hodgkin lymphoma diagnosed from 2001 through 2006, identified through the cancer registry by rapid case ascertainment, and controls found by random-digit dialling and from Medicare lists, frequency-matched to the cases on age, sex and county, with in-person interviews, blood or buccal specimens and expert re-review of the cases' pathology.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000968> (<http://www.ebi.ac.uk/coho/COHO_0000968>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34861974") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000968> "A case-control sample for lifetime suicide attempt of people of European ancestry, drawn from participants of six clinical trials conducted by Janssen Research & Development, with clinician-diagnosed major depressive disorder, schizophrenia, schizoaffective disorder or bipolar disorder, and from control samples of the NINDS Human Genetics Repository at the Coriell Institute and of BioIVT, with lifetime suicide-attempt history taken from clinical interview and medical records.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000969> (<http://www.ebi.ac.uk/coho/COHO_0000969>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24399358") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32198361") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://enigma.ini.usc.edu/about-2/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000969> "An international collaborative network of neuroimaging and genetics researchers at institutions worldwide, organised into working groups, that pools and meta-analyses brain MRI and genetic data from many sites, including patient populations, to find genetic and other factors that affect brain structure and function in health and disease; its first project was a genome-wide association study of hippocampal and intracranial volume.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000970> (<http://www.ebi.ac.uk/coho/COHO_0000970>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34200766") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35746640") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000970> "A prospective population-based cohort of inhabitants aged 14 or older of the county of Tirschenreuth in north-eastern Bavaria, Germany, one of the German counties hardest hit by SARS-CoV-2 in spring 2020, randomly selected with stratification by sex and municipality, who gave blood samples and questionnaires at a baseline survey in June-July 2020 and at follow-ups in November 2020 and April 2021, to determine SARS-CoV-2 seroprevalence and its course over time, including undetected infections, the durability of antibody responses and new infections.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000971> (<http://www.ebi.ac.uk/coho/COHO_0000971>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30312336") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33407562") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9586643") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000971> "A prospective cohort study of HIV infection and AIDS in Amsterdam, the Netherlands, a collaboration of the Public Health Service of Amsterdam, Amsterdam University Medical Centers, Sanquin Blood Supply and other partners, which since 1984 has followed an open cohort of men who have sex with men and from 1985 until 2016 followed a cohort of people who use drugs, to study the prevalence, incidence and risk factors of HIV infection and AIDS and the natural history of HIV-1 infection, and to carry out intervention studies and evaluate prevention programmes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000972> (<http://www.ebi.ac.uk/coho/COHO_0000972>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40050429") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000972> "A multi-study case–control collection at the Broad Institute, an extension of the Broad AF study, focused on cardiovascular diseases including atrial fibrillation, mitral valve prolapse, atrioventricular nodal reentrant tachycardia, supraventricular tachycardia and bradyarrhythmia, whose samples' DNA was imported to the Broad and jointly genotyped. It was funded as part of a collaboration between the Broad Institute and Bayer AG.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000973> (<http://www.ebi.ac.uk/coho/COHO_0000973>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://camos.org/protocol/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000973> "A population-based prospective cohort of men and women aged 25 years and older, recruited in 1995–1997 by random telephone contact from within 50 km of nine regional centres across Canada, and followed with annual mailed questionnaires, repeated interviews and bone density measurements to study osteoporosis and fractures; a youth cohort aged 16–24 was added in 2004–2006.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000974> (<http://www.ebi.ac.uk/coho/COHO_0000974>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28740058") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000974> "A prospective cohort of adults at high risk of cardiovascular disease, enrolled from November 2013 at Severance Hospital in Seoul, South Korea, to develop preventive strategies for high-risk patients. Participants qualify through high-risk hypertension, diabetes with albuminuria, end-stage renal disease on dialysis, asymptomatic atherosclerotic disease, rheumatoid arthritis treated with methotrexate and steroids, atrial fibrillation, a kidney transplant, or being a relative of a patient with early acute myocardial infarction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000975> (<http://www.ebi.ac.uk/coho/COHO_0000975>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30058245") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000975> "A cohort of patients with cystic fibrosis enrolled from January 2004 at participating CF centres across France to study modifier genes of the disease, with longitudinal clinical data abstracted from medical records retrospectively before 2004 and collected prospectively since.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000976> (<http://www.ebi.ac.uk/coho/COHO_0000976>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28886342") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000976> "A case collection of people with Dupuytren's disease from Germany and Switzerland who had undergone surgical treatment for it, whose blood samples were collected by the German Dupuytren Study Group for genetic studies of the disease, with population controls taken from the PopGen and KORA studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000977> (<http://www.ebi.ac.uk/coho/COHO_0000977>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29901528") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000977> "A case–control sample of men of German ancestry with severe alcohol dependence requiring hospitalisation, recruited from consecutive admissions to psychiatry and addiction medicine departments of psychiatric hospitals in the German addiction research network, together with population-based controls, assembled for genetic studies of alcohol dependence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000978> (<http://www.ebi.ac.uk/coho/COHO_0000978>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42229218") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000978> "A multicentre case–control sample recruited through seven academic institutions and their affiliated hospitals in South Korea for genome-wide association studies of psychiatric disorders, with patients with DSM-IV schizophrenia or bipolar I or II disorder and a shared group of healthy controls.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000979> (<http://www.ebi.ac.uk/coho/COHO_0000979>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21390209") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000979> "A case–control sample for Alzheimer's disease from the Quebec founder population, assembled by Genizon BioSciences, of people aged 65 or older with probable (DSM-IV) or autopsy-confirmed Alzheimer's disease and sex-matched cognitively normal controls aged 75 or older, whose blood DNA is used in genetic studies of the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000980> (<http://www.ebi.ac.uk/coho/COHO_0000980>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18320153") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41033104") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000980> "A German sepsis research network whose genetic studies draw on the randomised controlled trials VISEP (recruitment 2003–2005) and MAXSEP (recruitment 2007–2010), combining patients with all-cause sepsis from German hospitals who gave separate consent for genetic analyses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000981> (<http://www.ebi.ac.uk/coho/COHO_0000981>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39079071") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000981> "A cohort of patients who met diagnostic criteria for amyotrophic lateral sclerosis (ALS) or had progressive muscular atrophy but then improved substantially and lastingly (the ALS Reversal phenotype), invited from the investigators' database of such patients compiled from published case reports and medical records. Participants, enrolled from June 2018 under a protocol approved by Duke University Health System, gave saliva for whole-genome sequencing to identify genetic correlates of the phenotype.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000982> (<http://www.ebi.ac.uk/coho/COHO_0000982>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35627254") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000982> "A sub-cohort of the Danish Childhood Diabetes Register (DanDiabKids) made up of individuals newly diagnosed with type 1 diabetes, whose serum was sampled within three months of clinical onset and who had been genotyped on the ImmunoChip array.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000983> (<http://www.ebi.ac.uk/coho/COHO_0000983>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37492634") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000983> "A group of three randomised trials of supervised exercise training, STRRIDE I (1999–2003), STRRIDE AT/RT (2004–2008) and STRRIDE-PD (2009–2012), that enrolled previously sedentary adults with overweight or obesity and mild-to-moderate dyslipidaemia or prediabetes at Duke University Medical Center and East Carolina University, to study the effects of exercise amount, mode and intensity, and of weight loss by caloric restriction, on cardiometabolic health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000984> (<http://www.ebi.ac.uk/coho/COHO_0000984>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001387/phs001387.v3.p1/GapExchange_phs001387.v3.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000984> "A study of rare variants for hypertension in Taiwan Chinese that combines three cohorts based in Taiwan: families from the SAPPHIRe study, launched in 1995, with at least two hypertensive siblings, and unrelated participants from Tri-Service General Hospital and Taichung Veterans General Hospital matched to SAPPHIRe participants for age, sex and BMI category. All its participants were selected for whole-genome sequencing in the NHLBI TOPMed programme.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000985> (<http://www.ebi.ac.uk/coho/COHO_0000985>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33568819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000985> "A programme of the National Heart, Lung, and Blood Institute (NHLBI) that adds whole-genome sequencing and other omics data to existing, deeply phenotyped studies of ethnically and ancestrally diverse participants, to elucidate the genetic architecture and biology of heart, lung, blood and sleep disorders and improve their diagnosis, treatment and prevention.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000986> (<http://www.ebi.ac.uk/coho/COHO_0000986>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32067027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000986> "A population-based study sampled from the Northern Sweden Health and Disease Study cohort in the county of Västerbotten, Sweden, whose hip and forearm fracture cases, identified by linking the cohort with medical records and radiographic reports, are compared with controls from the same cohort to identify the genetic and environmental determinants of osteoporotic fractures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000987> (<http://www.ebi.ac.uk/coho/COHO_0000987>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12672732") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000987> "A randomised, double-blind, placebo-controlled trial, conducted in 1992–1995 at 21 sickle cell referral centres in the United States and Canada, of whether hydroxyurea reduces vaso-occlusive events in adults with sickle cell anaemia and frequent painful episodes, whose participants were then followed observationally in 1996–2001.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000988> (<http://www.ebi.ac.uk/coho/COHO_0000988>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30888333") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000988> "A subgroup of the PanCareLIFE ototoxicity genetics study made up of patients diagnosed with cancer before age 18 who were treated with upfront cisplatin and had no radiotherapy to the brain or inner ear, recruited in 2015–2017 through data providers in Switzerland, Italy, the Czech Republic, Denmark, Germany, Austria and the Netherlands for a genome-wide association study of cisplatin-induced hearing loss.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000989> (<http://www.ebi.ac.uk/coho/COHO_0000989>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21852243") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923054") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000989> "A consortium of nine epidemiological studies of breast cancer in the United States, mostly population-based case-control studies, whose African American cases and controls were genotyped together for a genome-wide association study of breast cancer in women of African ancestry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000990> (<http://www.ebi.ac.uk/coho/COHO_0000990>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19825824") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21409311") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34014961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000990> "A study at Wake Forest School of Medicine that, after the family-based Diabetes Heart Study and in parallel with it, enrolled unrelated African Americans with type 2 diabetes under the same inclusion criteria and analyses them together with that study's African American participants, to investigate ethnic differences in and inherited contributions to calcified atherosclerotic plaque and related traits such as bone density, vitamin D and, in its MIND extension, brain structure and cognition.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000991> (<http://www.ebi.ac.uk/coho/COHO_0000991>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28371474") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28406166") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29491417") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38280978") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000991> "A cohort of middle-aged and older residents of Ehime Prefecture, Japan, who since 2006 have attended the health check-up programme of the Anti-aging Center at Ehime University Hospital, designed to evaluate ageing-related disorders such as atherosclerosis, cardiovascular disease, physical function and mild cognitive impairment, and who are followed in the Japan Shimanami Health Promoting Program (J-SHIPP), a longitudinal study of factors related to cardiovascular disease, dementia and death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000992> (<http://www.ebi.ac.uk/coho/COHO_0000992>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28758146") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42316769") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000992> "A multi-site extension of the Alzheimer's Disease Neuroimaging Initiative, funded by the US Department of Defense, that enrolled Vietnam War veterans with a history of traumatic brain injury and/or ongoing post-traumatic stress disorder, with or without mild cognitive impairment, and veteran controls without either, identified mainly through Veterans Affairs records, and studies them with ADNI's clinical, cognitive, imaging and fluid biomarker methods to find whether these conditions contribute to the development of Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000993> (<http://www.ebi.ac.uk/coho/COHO_0000993>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30287268") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000993> "An international collaboration, sponsored by the Klarman Family Foundation and the US National Institute of Mental Health, that recruited individuals with a lifetime history of anorexia nervosa and controls in the United States, Australia, New Zealand, Sweden and Denmark, through treatment centres, national registers and traditional and social media, with blood samples and an online eating-disorder questionnaire, to rapidly expand the samples available for genome-wide association studies of anorexia nervosa.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000994> (<http://www.ebi.ac.uk/coho/COHO_0000994>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10232430") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15454651") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16950296") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37227431") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000994> "An unselected birth cohort of children born in 1992–1993 in Ashford, Kent, England, whose mothers were recruited in pregnancy from 1991 as the UK cohort of the Asthma Multicentre Infant Cohort Study, with house-dust allergen measured in infancy and follow-up by questionnaire, lung function and skin prick tests to age 14 years and a questionnaire at about age 20, to study how early-life allergen exposure and other factors relate to the development of atopy, wheeze and asthma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000995> (<http://www.ebi.ac.uk/coho/COHO_0000995>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30760105") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01851538?fields=protocolSection.identificationModule,protocolSection.statusModule,protocolSection.descriptionModule,protocolSection.designModule,protocolSection.contactsLocationsModule") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000995> "A prospective multicentre cohort of clinically stable adult outpatients with chronic heart failure, enrolled from 2011 at Erasmus MC, Rotterdam, and Northwest Clinics, Alkmaar, the Netherlands, and seen every three months for blood sampling and clinical assessment, with echocardiography in a subset, to assess whether serial measurements of biomarkers can track disease progression and predict prognosis in individual patients.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000996> (<http://www.ebi.ac.uk/coho/COHO_0000996>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40399555") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000996> "A study run by the Institute of Human Genetics, University of Bonn, Germany, that continuously recruits adults with SARS-CoV-2 infection confirmed by PCR or antibody testing from the general population through public announcements, collecting questionnaires on demographics, pre-existing conditions and the course of infection (and, from September 2021, on long COVID) and DNA for genotyping, to study host genetic factors in COVID-19.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000997> (<http://www.ebi.ac.uk/coho/COHO_0000997>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34010280") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000997> "A province-wide biobank and prospective cohort in Québec, Canada, launched in March 2020 by the Fonds de recherche du Québec–Santé and Génome Québec, which recruits through a network of Québec hospitals adults and children with PCR-confirmed SARS-CoV-2 infection, both hospitalised and non-hospitalised, and PCR-negative controls, with longitudinal biosamples and clinical data, to study the clinical and biological determinants of COVID-19 clinical trajectories.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000998> (<http://www.ebi.ac.uk/coho/COHO_0000998>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10027502") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34212545") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001726") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000998> "A multicentre, randomized, double-masked clinical trial of long-term inhaled treatment for mild to moderate asthma (budesonide, nedocromil or placebo, each with albuterol as needed) in children aged 5–12 years, who were enrolled in 1993–1995 at eight clinical centres in the United States and Canada and followed after the trial into adulthood, with a genetic ancillary study of the children and their parents.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000999> (<http://www.ebi.ac.uk/coho/COHO_0000999>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21738479") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32571486") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000999> "A network of cohorts of African ancestry and of other populations under-represented in genome-wide association studies, whose consortia meta-analyse the cohorts' genome-wide data to find genetic variants for complex traits, such as white blood cell count, blood pressure and hypertension in African-ancestry cohorts (COGENT-BP) and kidney traits across diverse ancestries (COGENT-Kidney, established in 2014).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001000> (<http://www.ebi.ac.uk/coho/COHO_0001000>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18522740") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35172313") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36981009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001000> "The cohort studies of the Center for Oral Health Research in Appalachia, established in 2000 by the University of Pittsburgh in partnership with West Virginia University to find the factors behind poor oral health in northern Appalachia. They are a family-based etiology study (COHRA1), which recruited households in West Virginia and western Pennsylvania, and a longitudinal cohort (COHRA2), which since 2011 has recruited pregnant women in Pennsylvania and West Virginia and followed them and their children.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001001> (<http://www.ebi.ac.uk/coho/COHO_0001001>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17463246") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18678614") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001001> "A genome-wide association study of type 2 diabetes and related quantitative traits by the Broad Institute of Harvard and MIT, Lund University and the Novartis Institutes for BioMedical Research. Its participants were patients with type 2 diabetes and matched non-diabetic controls from Finland and Sweden, genotyped and characterised for glucose metabolism, lipids, obesity and blood pressure.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001002> (<http://www.ebi.ac.uk/coho/COHO_0001002>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35551307") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001002> "A consortium established to assemble genome-wide association studies of type 2 diabetes across diverse ancestry groups. It meta-analyses them within its European and East Asian ancestry components and, together with African, Hispanic and South Asian ancestry studies, in a multi-ancestry meta-regression, to discover and fine-map type 2 diabetes loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001003> (<http://www.ebi.ac.uk/coho/COHO_0001003>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27598322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001265/phs001265.v1.p1/GapExchange_phs001265.v1.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001003> "A breast cancer genetics consortium, one of the five projects funded in 2010 under the NCI's Genetic Associations and Mechanisms in Oncology (GAME-ON) post-GWAS initiative. It meta-analysed genome-wide summary data shared by existing breast cancer GWAS and genotyped breast cancer cases and controls on the OncoArray, to replicate known and find new breast cancer susceptibility loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001004> (<http://www.ebi.ac.uk/coho/COHO_0001004>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29844013") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34796724") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40099743") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001004> "A case-cohort study nested within the European Prospective Investigation into Cancer and Nutrition, designed to investigate the determinants of cardiovascular disease. EPIC participants with incident coronary heart disease or stroke, identified from 1991 to 2010, are compared with a centre-stratified random subcohort of EPIC participants with stored blood samples, in which molecular factors, including genotypes, are measured.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001005> (<http://www.ebi.ac.uk/coho/COHO_0001005>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17825112") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31823830") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36551856") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42259975") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001005> "A family-based study of the genetic and environmental causes of ischaemic stroke, begun in June 2005 in the Fangshan District, a rural area southwest of Beijing, China. It recruited people with ischaemic stroke as probands, with their parents and siblings, through hospital and community stroke registries, and in a second phase in 2011–2012 enrolled participants aged 40 or over through posters and community health centre records. The families enrolled between 2005 and 2012 are followed up every two years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001006> (<http://www.ebi.ac.uk/coho/COHO_0001006>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30739198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40280976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001006> "An international consortium, established to characterise the known genetic causes of frontotemporal lobar degeneration with TDP-43 inclusions (FTLD-TDP) and to find new genetic risk factors for it and its pathological subtypes. It whole-genome sequences people with pathologically confirmed FTLD-TDP (and, from its second phase, clinically diagnosed FTLD subtypes enriched for FTLD-TDP) and neurologically normal controls, compiled from institutions and brain banks in North America, Europe and Australia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001007> (<http://www.ebi.ac.uk/coho/COHO_0001007>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15272417") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29924316") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41390056") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.gelcc.org/node/3") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001007> "A family study of lung cancer in the United States in which the recruitment sites of the Genetic Epidemiology of Lung Cancer Consortium enrolled lung cancer patients with a family history of the disease, relatives in families with several affected members, and unaffected controls frequency-matched to the cases on age and sex, collecting pedigrees, smoking histories and biospecimens to identify inherited factors that confer a high risk of lung cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001008> (<http://www.ebi.ac.uk/coho/COHO_0001008>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12439737") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21887284") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26791477") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35886043") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001008> "An ancillary pharmacogenetic study of the Antihypertensive and Lipid-Lowering Treatment to Prevent Heart Attack Trial (ALLHAT), a double-blind randomised trial of antihypertensive drugs in people aged 55 or older with hypertension and at least one other cardiovascular risk factor, conducted in 1994–2002 at centres in the United States and Canada. GenHAT genotyped the ALLHAT participants with available DNA to test whether variants in hypertension genes modify the effect of the randomised treatment on coronary heart disease and other cardiovascular outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001009> (<http://www.ebi.ac.uk/coho/COHO_0001009>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19300482") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25134640") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25241909") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31413559") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32944202") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001009> "A genetic case-control study of chronic obstructive pulmonary disease conducted in Bergen, Norway, in 2003–2005 and sponsored by GlaxoSmithKline, which enrolled current and former smokers aged 40 or older: patients with at least moderate COPD, recruited from a hospital patient registry and from the general population, and smokers with normal lung function as controls.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001010> (<http://www.ebi.ac.uk/coho/COHO_0001010>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31715324") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://gladstudy.org.uk/about/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001010> "A recontactable cohort of people aged 16 or over living in the United Kingdom, run by the NIHR Mental Health BioResource at King's College London, which recruits online people with current or past depression or anxiety, and also people with no history of mental disorder, into the NIHR BioResource. Participants complete questionnaires, give saliva samples for genotyping and consent to medical record linkage and recontact, to support research on risk factors for depression and anxiety.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001011> (<http://www.ebi.ac.uk/coho/COHO_0001011>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28148535") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29025058") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37308106") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39792440") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001011> "A biobank sub-study of SHARE, the Scottish Health Research Register, in NHS Tayside and NHS Fife, Scotland, which collects, with consent, blood left over from registrants' routine clinical tests at hospital or GP clinics for genotyping linked to their anonymised electronic health records; it began as a Wellcome Trust-funded pilot in NHS Tayside.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001012> (<http://www.ebi.ac.uk/coho/COHO_0001012>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30631481") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30995994") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38702345") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001012> "A multisite case-control study of reading disability (developmental dyslexia) in Hispanic American and African American children aged 8 to 15, led by Yale University at sites in the United States, Puerto Rico and Canada, in which the children were assessed with reading and reading-related measures and gave DNA for genetic studies of reading ability and dyslexia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001013> (<http://www.ebi.ac.uk/coho/COHO_0001013>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17554300") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22025780") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35499624") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001013> "A collection of people with type 1 diabetes diagnosed before the age of 17, assembled by the JDRF/Wellcome Trust Diabetes and Inflammation Laboratory from paediatric and adult diabetes clinics at National Health Service hospitals across mainland United Kingdom, whose DNA and plasma samples are used in genetic and other studies of type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001014> (<http://www.ebi.ac.uk/coho/COHO_0001014>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26299218") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31699273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001014> "An international prospective observational registry and natural history study of hypertrophic cardiomyopathy funded by the National Heart, Lung, and Blood Institute, which enrolled patients aged 18 to 65 with hypertrophic cardiomyopathy (unexplained left ventricular hypertrophy) at centres in the United States, Canada, the United Kingdom, Italy, Germany and the Netherlands in 2014–2017. Participants underwent clinical evaluation, cardiac magnetic resonance imaging and blood sampling for genetic and biomarker analysis, and are followed for cardiovascular events to improve risk prediction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001015> (<http://www.ebi.ac.uk/coho/COHO_0001015>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001015> "A family study of Mexican Americans in the Los Angeles area, United States, which recruited the family members of probands with documented hypertension and measured insulin sensitivity by euglycaemic clamp, to examine the genetic basis of hypertension and insulin resistance.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001016> (<http://www.ebi.ac.uk/coho/COHO_0001016>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001016> "An international consortium of 26 studies of age-related macular degeneration, mainly in the United States, Europe, Israel and Australia, which gathered DNA from advanced and intermediate AMD cases, mostly recruited from ophthalmology clinics, and from controls, predominantly of European ancestry. The samples were genotyped centrally at the Center for Inherited Disease Research on a custom-modified HumanCoreExome array to examine common and rare genetic variants in AMD.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001017> (<http://www.ebi.ac.uk/coho/COHO_0001017>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24656865") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001017> "A group of six genome-wide association case-control studies of spontaneous intracerebral haemorrhage in people of European ancestry, meta-analysed under the auspices of the International Stroke Genetics Consortium to find susceptibility loci for lobar and nonlobar haemorrhage. It comprises the multicentre Genetics of Cerebral Hemorrhage with Anticoagulation study in the United States, the Genetic and Environmental Risk Factors for Hemorrhagic Stroke studies I and II in Cincinnati, and four European studies in Barcelona, Krakow and Lund.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001018> (<http://www.ebi.ac.uk/coho/COHO_0001018>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18715499") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18978787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001018> "A genome-wide association case-control study of lung cancer in the United Kingdom, run at the Institute of Cancer Research, which genotyped lung cancer patients recruited in 1999–2004 through UK oncology centres for the Genetic Lung Cancer Predisposition Study (GELCAPS) and compared them with genotyped controls from the 1958 British Birth Cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001019> (<http://www.ebi.ac.uk/coho/COHO_0001019>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20436961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001019> "A cross-sectional sib-pair study at four factories in Lucknow, Nagpur, Hyderabad and Bangalore in north, central and south India, which in 2005–2007 examined factory workers and their spouses who had migrated from rural areas together with a rural-dwelling sibling of each, and a random sample of urban non-migrant workers and spouses together with an urban-dwelling sibling, to study the effect of rural-to-urban migration on obesity, diabetes and other cardiovascular risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001020> (<http://www.ebi.ac.uk/coho/COHO_0001020>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30188930") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39017907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42050091") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001020> "A single-centre prospective observational cohort of Japanese patients with rheumatoid arthritis, established in October 2000 at the Institute of Rheumatology, Tokyo Women's Medical University, Tokyo, which registers consenting patients with rheumatoid arthritis treated at the institute and collects patient questionnaires, physician assessments of disease activity and laboratory data twice a year, in April and October.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001021> (<http://www.ebi.ac.uk/coho/COHO_0001021>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34861974") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001021> "An international consortium that meta-analyses genome-wide association data on suicide attempt and suicide death from cohorts worldwide, including cohorts ascertained for psychiatric disorders or substance use, studies of suicide or suicide attempt, and population-based biobanks, to identify genetic risk loci for suicidal behaviour and separate them from those of psychiatric disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001022> (<http://www.ebi.ac.uk/coho/COHO_0001022>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31235787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36376295") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40038546") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001022> "A multicentre biorepository for genomic studies of human myocardial disease, led by investigators at the Perelman School of Medicine, University of Pennsylvania, which collects left ventricular tissue from failing hearts at cardiac transplantation and from donor hearts not used for transplantation, at sites including the University of Pennsylvania, the Cleveland Clinic and Stanford, together with genotyped patients with prevalent heart failure referred to a heart failure specialty centre for case-control studies of heart failure.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001023> (<http://www.ebi.ac.uk/coho/COHO_0001023>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001001") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001062.v6.p2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001023> "A case series of patients with atrial fibrillation enrolled at Massachusetts General Hospital, Boston, United States, since 2001, together with affected and unaffected family members of probands with an extensive family history of atrial fibrillation, each assessed at enrolment by a structured interview on medical history, treatment and family history, an electrocardiogram, echocardiogram results and a blood sample; its early-onset cases (onset before age 66) were whole-genome sequenced in the NHLBI TOPMed programme.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001024> (<http://www.ebi.ac.uk/coho/COHO_0001024>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18189239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9008509") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.nimh.nih.gov/about/advisory-boards-and-groups/namhc/reports/genetics-and-mental-disorders-report-of-the-national-institute-of-mental-healths-genetics-workgroup") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001024> "A family study of Alzheimer's disease in the United States in which three academic medical centres (Massachusetts General Hospital, Johns Hopkins University and the University of Alabama at Birmingham) ascertained families with two or more members affected by Alzheimer's disease (mostly affected sibling pairs), together with unaffected relatives, from 1991 through memory disorder clinics, nursing homes and the community, using uniform procedures. It is the Alzheimer's disease collection of the NIMH Human Genetics Initiative, whose data and DNA are shared through the NIMH repository for genetic linkage and association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001025> (<http://www.ebi.ac.uk/coho/COHO_0001025>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38090148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40496845") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41585861") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001025> "A healthcare-system-based research biobank of NorthShore University HealthSystem (now Endeavor Health) in Illinois, United States, started in 2014, which enrols patients of the health system who consent to give a blood sample for DNA and to linkage of their electronic health records, for translational and discovery research combining genomic and clinical data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001026> (<http://www.ebi.ac.uk/coho/COHO_0001026>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21345808") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23637643") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27995394") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001026> "A birth cohort of people born in one week in March 1946 in England, Scotland and Wales, selected as a social-class-stratified sample of the singleton births to married mothers that week and followed up repeatedly from birth into old age through home visits, questionnaires and clinic assessments. The oldest of the British national birth cohort studies, it is core-funded by the UK Medical Research Council and has been developed since 2008 by the MRC Unit for Lifelong Health and Ageing at UCL into an interdisciplinary study of ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001027> (<http://www.ebi.ac.uk/coho/COHO_0001027>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021668") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40249915") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40407036") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001027> "A prospective cohort of newborns with Down syndrome enrolled at birth in 18 hospitals in the United Kingdom from 2006 to 2017, screened for GATA1 mutations and followed with serial clinical and haematological data from birth to 4 years of age, to study transient abnormal myelopoiesis, preleukaemic GATA1 mutations and the risk of myeloid leukaemia in children with Down syndrome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001028> (<http://www.ebi.ac.uk/coho/COHO_0001028>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32326982") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33622351") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38102185") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40527567") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001028> "A prospective cohort of patients aged 16 or older receiving methadone or buprenorphine–naloxone treatment for opioid use disorder at outpatient clinics of the Canadian Addiction Treatment Centres across Ontario, Canada, recruited by McMaster University researchers from May 2018 to January 2023 as an extension of the Genetics of Opioid Addiction study with a similar protocol. Participants were interviewed at entry, gave a saliva sample for DNA and were followed for up to 12 months through their medical records and urine drug screens, to study biopsychosocial and genetic factors in treatment outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001029> (<http://www.ebi.ac.uk/coho/COHO_0001029>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38839884") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39112778") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001029> "An occupational cohort of employees of regional companies and government authorities in and around Münster, Germany, who volunteered and underwent a cardiovascular examination in 2000–2007, forming the second part of the Prospective Cardiovascular Münster (PROCAM) Study of cardiovascular risk factors and disease, initiated and conducted by the Leibniz Institute for Arteriosclerosis Research at the University of Münster. Follow-up lapsed until 2018, when the cohort was revived for genotyping, followed by a postal follow-up questionnaire in 2021.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001030> (<http://www.ebi.ac.uk/coho/COHO_0001030>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30070057") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39721961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001030> "A multicentre, naturalistic longitudinal study of adults with schizophrenia-spectrum, bipolar or recurrent depressive disorders and of healthy controls, recruited at clinical centres in Germany and Austria from 2011 to 2019 and assessed four times at six-month intervals over 18 months with deep phenotyping, dimensional ratings of psychopathology, cognitive tests and blood sampling, to identify clinical, neurobiological and genetic signatures of the course of major psychiatric disorders across the affective-to-psychotic continuum.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001031> (<http://www.ebi.ac.uk/coho/COHO_0001031>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18361720") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001031> "A population-based study of cutaneous melanoma in Queensland, Australia, that brings together four earlier population-based studies of melanoma patients conducted in 1987–1995: the Queensland Familial Melanoma Project of adult cases and their families, including twins, and studies of melanoma in children, in adolescents and in men over 50. Their participants and some relatives were re-contacted in 2002–2005 for telephone interviews on sun exposure and phenotype and for blood samples, to investigate genetic and environmental factors, and their interaction, in the aetiology of melanoma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001032> (<http://www.ebi.ac.uk/coho/COHO_0001032>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35086919") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38032570") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/royal-brompton-harefield-cardiovascular-research-centre-biobank/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001032> "A research biobank of the Royal Brompton and Harefield hospitals in London, United Kingdom, which since 2009 has collected blood and other samples, including cardiac tissue, with clinical, imaging and follow-up data from adult and paediatric patients attending the hospitals for the investigation or treatment of cardiovascular conditions, and from their relatives, to find genes and biomarkers for the diagnosis and prognosis of cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001033> (<http://www.ebi.ac.uk/coho/COHO_0001033>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28171663") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29302764") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001033> "A consortium for a genome-wide association study of breast cancer in women of African ancestry in Nigeria, Barbados and the United States, pooling the cases and controls of six epidemiological studies (the Nigerian Breast Cancer Study, the Barbados National Cancer Study, the Racial Variability in Genotypic Determinants of Breast Cancer Risk Study, the Chicago Cancer Prone Study, the Baltimore Breast Cancer Study and the Southern Community Cohort Study), genotyped together on the Illumina HumanOmni2.5 array.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001034> (<http://www.ebi.ac.uk/coho/COHO_0001034>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15531754") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37227431") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001034> "An unselected birth cohort established in 1997 in Aberdeen, United Kingdom, recruiting pregnant women through an antenatal clinic and following their children prospectively from birth, to investigate how antenatal dietary exposures relate to asthma, wheeze and eczema in childhood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001035> (<http://www.ebi.ac.uk/coho/COHO_0001035>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25306249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25582225") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00413205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001035> "A multicentre, double-blind, randomised, placebo-controlled phase II trial sponsored by Hoffmann-La Roche and run from 2007 to 2010 at sites in Europe, Israel, South Africa and the United States, in which ex-smokers over 44 years old with smoking-related moderate to severe COPD with emphysema, on optimised COPD therapy, were assigned to the gamma-selective retinoid agonist palovarotene or placebo.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001036> (<http://www.ebi.ac.uk/coho/COHO_0001036>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37594959") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9551285") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001036> "A single-centre, randomised, double-masked, placebo-controlled trial in which nondiabetic Hispanic women with prior gestational diabetes mellitus, recruited in the Los Angeles area, United States, were assigned to troglitazone or placebo to test whether treating insulin resistance improves insulin sensitivity, preserves pancreatic beta-cell function and prevents type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001037> (<http://www.ebi.ac.uk/coho/COHO_0001037>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27502059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27869827") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5032181/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001037> "A cohort of healthy adult volunteers without known cardiovascular disease, recruited prospectively by advertisement from 2011 at the MRC Clinical Sciences Centre, Imperial College London, United Kingdom, who underwent standard and high-resolution three-dimensional cardiac magnetic resonance imaging and genotyping, to study the genetic determinants of cardiac structure and function.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001038> (<http://www.ebi.ac.uk/coho/COHO_0001038>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11174041") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14762035") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001038> "A double-blind, randomised, multicentre trial run from 1996 to 2003 at 56 hospitals and neurology practices in the United States, Canada and Scotland, in which adults aged 35 or older with a recent nondisabling ischaemic stroke and a screening plasma homocysteine above the 25th percentile received high-dose or low-dose folic acid, vitamin B6 and vitamin B12, to test whether lowering homocysteine prevents recurrent stroke.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001039> (<http://www.ebi.ac.uk/coho/COHO_0001039>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38741014") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001039> "A hospital-based case-control study of breast cancer in women of African ancestry, established in Nigeria in 1998 and expanded to Uganda and Cameroon in 2011 using the same questionnaires and protocol.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001040> (<http://www.ebi.ac.uk/coho/COHO_0001040>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22238593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31092297") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2608/MediaObjects/41588_2013_BFng2608_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001040> "A case-control study of African Americans in North Carolina, South Carolina, Georgia, Tennessee and Virginia, United States, recruited by Wake Forest School of Medicine for genetic studies of type 2 diabetes and nephropathy. Cases with type 2 diabetes and end-stage kidney disease were recruited from dialysis facilities and controls without diabetes or kidney disease from the community and internal medicine clinics, later joined by people with type 2 diabetes but no nephropathy and people with non-diabetic end-stage kidney disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001041> (<http://www.ebi.ac.uk/coho/COHO_0001041>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39633006") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-019-0358-2/MediaObjects/41588_2019_358_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001041> "A case-control dataset of the Alzheimer's Disease Genetics Consortium made up of people with late-onset Alzheimer's disease and cognitively normal controls from the University of Miami, Case Western Reserve University and the second wave of the Texas Alzheimer's Research and Care Consortium in the United States.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001042> (<http://www.ebi.ac.uk/coho/COHO_0001042>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37674002") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40399555") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001042> "A host genetics study of COVID-19 in Mexico, run under the ethics approval of the Instituto Nacional de Ciencias Médicas y Nutrición Salvador Zubirán (INCMNSZ) in Mexico City, of genotyped COVID-19 cases and controls of admixed American ancestry who were also asked about long COVID symptoms by telephone questionnaire.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001043> (<http://www.ebi.ac.uk/coho/COHO_0001043>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37915075") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40340717") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40399555") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001043> "A study run by Sano Genetics in the United Kingdom in which participants recruited between 2020 and 2022 gave saliva samples for an at-home DNA test and completed a questionnaire on the Sano Genetics platform about their acute COVID-19 and long COVID symptoms, demographics and other chronic conditions, to study genetic factors influencing long COVID risk and severity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001044> (<http://www.ebi.ac.uk/coho/COHO_0001044>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34601141") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35940203") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001044> "A nationwide multicentre consortium of hospitals across Japan led by core academic institutes, established in early 2020, that collects DNA, RNA and plasma with detailed clinical information from patients hospitalised with COVID-19 to study the host genetics of the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001045> (<http://www.ebi.ac.uk/coho/COHO_0001045>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34059833") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001045> "A family study in the Los Angeles area, United States, in which Hispanic family members of probands with type 2 diabetes were recruited to examine the genetic basis of subclinical atherosclerosis and diabetes, with insulin sensitivity measured by euglycaemic clamp.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001046> (<http://www.ebi.ac.uk/coho/COHO_0001046>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34099642") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42237039") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001046> "A Spanish national consortium of research centres and hospitals, created in 2013 under the institutional coverage of the Network Center for Biomedical Research in Neurodegenerative Diseases (CIBERNED), that brings together dementia cohorts to study the genetic architecture of neurodegenerative dementias in the Spanish population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001047> (<http://www.ebi.ac.uk/coho/COHO_0001047>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37674002") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40399555") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001047> "A biobank of patients hospitalised with COVID-19 at the University Hospital of Ioannina, Greece, genotyped for host genetic studies of COVID-19 and long COVID, with population controls drawn from the Epirus Health Study cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001048> (<http://www.ebi.ac.uk/coho/COHO_0001048>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21182766") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30771221") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34887416") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35414113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001048> "A population-based case-control-family study of breast cancer with an emphasis on early-onset disease, carried out in Melbourne and Sydney, Australia, which enrolled women with a first primary breast cancer identified through cancer registries in 1992-1999, with controls selected from the electoral roll; it is the Australian site of the Breast Cancer Family Registry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001049> (<http://www.ebi.ac.uk/coho/COHO_0001049>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30529582") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01222-9/MediaObjects/41588_2022_1222_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001049> "A consortium, initiated in 2010, that pools genome-wide genotype data on colorectal cancer cases and cancer-free controls of East Asian ancestry from studies in China, Japan and South Korea, among them the Shanghai Women's and Men's Health Studies and colorectal cancer studies from Shanghai, Guangzhou, Aichi, BioBank Japan and several Korean centres, to identify genetic risk factors for colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001050> (<http://www.ebi.ac.uk/coho/COHO_0001050>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14583845") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21051598") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2671281") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://actgnetwork.org/about/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001050> "A clinical trials network founded in 1987 as a cooperative group of the US National Institute of Allergy and Infectious Diseases, the largest and longest-running network of trials in HIV and other infectious diseases, now with sites on four continents. Participants of its trials may give DNA to its DNA bank (protocol A5128) for genetic studies, and treatment-naive participants with advanced HIV disease from its antiviral treatment trials were the progressors of the International HIV Controllers Study genome-wide association study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001051> (<http://www.ebi.ac.uk/coho/COHO_0001051>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37197821") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001051> "A UK genetic cohort study, run by the Preventive Neurology Unit of Queen Mary University of London and recruiting since November 2021, of adults with multiple sclerosis from diverse, mostly non-European, ancestral backgrounds, enrolled online, at clinical sites and through the UK MS Register, who give saliva DNA for genotyping, questionnaire data and consent to health-record linkage, to study the genetics of multiple sclerosis susceptibility and severity; it has no controls of its own.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001052> (<http://www.ebi.ac.uk/coho/COHO_0001052>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31339677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT03122262") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001052> "A randomised, open-label, investigator-led phase 3 non-inferiority trial of first-line antiretroviral therapy, run by the University of the Witwatersrand (study WRHI 060) at sites in Johannesburg, South Africa, which from February 2017 randomised people aged 12 years or older with HIV-1 who had not received antiretroviral therapy in the previous 6 months to dolutegravir and emtricitabine with either tenofovir alafenamide or tenofovir disoproxil fumarate, or to efavirenz, tenofovir disoproxil fumarate and emtricitabine, and followed them for 96 weeks, later extended to 192 weeks.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001053> (<http://www.ebi.ac.uk/coho/COHO_0001053>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18413559") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18443000") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21917174") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27030599") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001053> "A multi-ethnic case-control genetic association study of coronary artery disease by Stanford University and Kaiser Permanente Northern California, which from October 2001 to December 2003 enrolled Kaiser Permanente members in the San Francisco Bay area into three case groups (early-onset coronary artery disease, and incident stable exertional angina or myocardial infarction at an older age) and two control groups free of clinical cardiovascular disease (younger adults, including some CARDIA participants, and adults aged 60 to 69), with questionnaires, stored blood samples, cardiac computed tomography in older controls and later follow-up through health plan records.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001054> (<http://www.ebi.ac.uk/coho/COHO_0001054>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21125205") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26084364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34203817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40808916") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001054> "A population-based cohort of elderly residents of Bordeaux, France, recruited from 2006 as an ophthalmological follow-up nested within the Three-City Study, assessing associations between eye diseases such as age-related macular degeneration and nutritional factors through plasma measurements, dietary-intake estimation and repeated eye examinations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001055> (<http://www.ebi.ac.uk/coho/COHO_0001055>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25663231") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000394.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001055> "A case-control sample assembled by a consortium of twelve US autopsy centres, several of them Morris K. Udall Centers of Excellence in Parkinson's Disease Research, of people clinically diagnosed with Parkinson's disease whose diagnosis was confirmed at autopsy (nigral neuronal loss and Lewy bodies, with little Alzheimer pathology) and of neuropathologically normal controls, often patients' spouses, genotyped genome-wide at the Center for Inherited Disease Research to find genetic risk factors for Parkinson's disease with less diagnostic misclassification.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001056> (<http://www.ebi.ac.uk/coho/COHO_0001056>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18830131") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20506380") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001056> "A multicentre case-control study of upper aerodigestive tract cancers (oral cavity, pharynx, larynx and oesophagus), initiated by the International Agency for Research on Cancer in 2002, that recruited newly diagnosed cases and hospital controls (population controls in the United Kingdom) at centres in about ten European countries, mostly in 2002-2005, with interviews on smoking, drinking and diet and biological samples, to study genetic susceptibility to these cancers and its interplay with lifestyle factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001057> (<http://www.ebi.ac.uk/coho/COHO_0001057>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26708676") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29310044") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29706931") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39286457") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001057> "A prospective hospital-based register of patients admitted with acute stroke to Hospital del Mar, a tertiary public university hospital serving about 330,000 people in three districts of Barcelona, Spain, with records from 2005 onwards, standardised clinical and imaging assessment and outcome follow-up; its patients who gave DNA form the BASICMAR genetic study, a contributing site of the NINDS Stroke Genetics Network.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001058> (<http://www.ebi.ac.uk/coho/COHO_0001058>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35414113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38178900") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39586971") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001058> "A case-control study of breast cancer based at the University Breast Center for Franconia, Erlangen University Hospital, Bavaria, Germany, which in the 2000s enrolled women aged 18 or older with invasive breast cancer treated there, with tumour tissue for tissue microarrays, and controls recruited in hospital, through a breast cancer screening programme or by newspaper advertisement, to study genetic and non-genetic risk factors and prognostic and predictive factors of breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001059> (<http://www.ebi.ac.uk/coho/COHO_0001059>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24270294") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35414113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001059> "A population-based case-control study of women aged 18-80 recruited in Western Australia between May 2009 and January 2011 to investigate occupational and environmental risk factors for breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001060> (<http://www.ebi.ac.uk/coho/COHO_0001060>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22736162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24924233") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001060> "A prospective observational study run by the University of Münster, Germany, of three cohorts of adults aged 35–65 examined in parallel with identical methods: patients treated for an acute depressive episode and patients after an acute myocardial infarction or acute coronary syndrome, recruited through psychiatric and cardiological hospitals and clinics in and around Münster, and reference participants randomly sampled from the city's population register, with a baseline examination in 2010–2013 and repeated follow-ups, to investigate the bidirectional relationship between depression and subclinical arteriosclerosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001061> (<http://www.ebi.ac.uk/coho/COHO_0001061>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16623958") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33732727") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001061> "A population-based cohort study of common eye diseases and other health outcomes among permanent residents aged 49 years or older of two postcode areas in the Blue Mountains, west of Sydney, Australia, identified through a census and examined at baseline in 1992–1994 and then every five years to 2007–2009, with newly eligible residents added in an extension study in 1999–2000.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001062> (<http://www.ebi.ac.uk/coho/COHO_0001062>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42237039") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001062> "A cohort of Alzheimer's disease cases and controls in Germany, drawn from a larger German GWAS sample recruited through the German Dementia Competence Network, the AgeCoDe study of ageing, cognition and dementia in primary care patients, and the Memory Clinic at the University Hospital of Bonn. Controls were drawn from the population-based Heinz Nixdorf Recall study cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001063> (<http://www.ebi.ac.uk/coho/COHO_0001063>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24175068") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37706299") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001063> "An ongoing international hospital-based DNA repository, run from Imperial College London, of adults with ischaemic or haemorrhagic stroke recruited at stroke centres in the United Kingdom (patients of European ancestry and British South Asians), India and Qatar, together with controls, to compare genetic risk factors for stroke between European, South Asian and Middle Eastern populations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001064> (<http://www.ebi.ac.uk/coho/COHO_0001064>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35414113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001064> "A population-based case-control study of breast cancer conducted since 1997 in Vigo and Santiago de Compostela, Galicia, Spain, recruiting incident breast cancer cases from Galician hospitals with blood and tumour tissue samples and risk-factor questionnaires, and controls frequency-matched by age, public health registry inclusion and place of residence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001065> (<http://www.ebi.ac.uk/coho/COHO_0001065>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30993211") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00262691") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001065> "An ongoing community-based prospective observational study of the genetic basis of cardiovascular disease and its risk factors, begun in 2005 by Nagoya University with Aichi Gakuin University, of local residents of Kitanagoya, Aichi Prefecture, Japan, aged 50 or older, enrolled at community-based annual health check-ups.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001066> (<http://www.ebi.ac.uk/coho/COHO_0001066>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000820.v1.p1") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001189.v5.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001066> "A collection of clinical and genetic data from patients with atrial fibrillation and controls enrolled at the Cleveland Clinic in its CV/Arrhythmia Biobank, including the Cleveland Clinic Lone Atrial Fibrillation GeneBank of patients with atrial fibrillation without significant structural heart disease, for genetic studies of atrial fibrillation; its early-onset cases were whole-genome sequenced in the NHLBI TOPMed programme.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001067> (<http://www.ebi.ac.uk/coho/COHO_0001067>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29348612") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36810956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001067> "A statewide record-linkage case–control study that links California birth records for 1982–2009, maintained by the California Department of Public Health, to diagnoses of cancer before the age of 15 in the California Cancer Registry for 1988–2011, with cancer-free California-born controls matched on date of birth, sex and maternal race or ethnicity through vital statistics records, and uses archived newborn dried blood spots from the California Biobank Program for genetic studies of childhood cancers such as acute lymphoblastic leukaemia and glioma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001068> (<http://www.ebi.ac.uk/coho/COHO_0001068>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22614287") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36804072") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001068> "A sample of people in the United Kingdom with treatment-resistant schizophrenia who were prescribed clozapine, whose anonymised blood samples and clinical monitoring data were obtained through the clozapine monitoring services, first in collaboration with Novartis and later through the Zaponex Treatment Access System (second wave 2013–15, third wave 2019–21), for Cardiff University's genetic studies of schizophrenia and clozapine metabolism.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001069> (<http://www.ebi.ac.uk/coho/COHO_0001069>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23092589") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42223860") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001069> "A prospective longitudinal study of same-sex twin pairs born in 1984–1990 and recruited in Colorado, United States, from the Colorado Twin Registry of the Institute for Behavioral Genetics at the University of Colorado, assessed almost yearly from 14 months to age 16 and again in adulthood to investigate genetic and environmental influences on individual differences in psychological development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001070> (<http://www.ebi.ac.uk/coho/COHO_0001070>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42237039") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001070> "A harmonized dataset of the Alzheimer's Disease Genetics Consortium that merges six separately ascertained datasets or dataset waves of Alzheimer's disease cases and cognitively normal elders (BIOCARD, CHAP2, EAS, RMAYO, ROSMAP2 and WASHU2), each too small to be analysed on its own, so that they can be analysed together in common-variant association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001071> (<http://www.ebi.ac.uk/coho/COHO_0001071>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34642645") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36062073") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001071> "A biobank set up at Columbia University Irving Medical Center in New York City, United States, in response to the city's COVID-19 surge in March 2020, which kept residual blood and urine samples left over from clinical testing of consecutive patients with PCR-confirmed COVID-19, of any age, sex or ancestry, treated at the medical center.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001072> (<http://www.ebi.ac.uk/coho/COHO_0001072>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20459722") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21595955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23555291") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001072> "A population-based health examination survey of a random sample of people aged 45–74, drawn from the National Population Register and stratified by sex, age group and area, in the hospital districts of Pirkanmaa, South Ostrobothnia and Central Finland, Finland, examined in October–December 2007 at the end of FIN-D2D, the implementation project of Finland's national type 2 diabetes prevention programme, to measure the prevalence of diabetes, cardiovascular disease and their risk factors and to evaluate the programme.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001073> (<http://www.ebi.ac.uk/coho/COHO_0001073>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42237039") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001073> "A subsample of the German Study on Ageing, Cognition and Dementia in Primary Care Patients (AgeCoDe), a general-practice registry-based longitudinal study of people aged 75 and over recruited in 2002–2003 in six German cities, made up of participants who were free of dementia at baseline and had DNA available and who either developed Alzheimer-type dementia during follow-up or stayed free of dementia, selected for a genome-wide DNA methylation study of dementia and also genotyped genome-wide.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001074> (<http://www.ebi.ac.uk/coho/COHO_0001074>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29158543") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35289444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001074> "A population-based cohort of Finnish adults aged 25–74, recruited at baseline in 2007 as a sub-study of the FINRISK2007 survey to investigate the factors leading to obesity and metabolic syndrome, with follow-up in 2014.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001075> (<http://www.ebi.ac.uk/coho/COHO_0001075>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20980412") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23555291") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40583490") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001075> "A randomised controlled trial at five centres in Finland (Helsinki, Kuopio, Turku, Tampere and Oulu) that from 1993 to 1998 randomised overweight men and women aged 40–64 with impaired glucose tolerance to intensive individual diet and exercise counselling or to a control group, to test whether lifestyle change prevents type 2 diabetes, and whose participants continued to be followed with yearly visits after the trial.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001076> (<http://www.ebi.ac.uk/coho/COHO_0001076>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36245764") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42560005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01822873") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001076> "A single-centre, prospective, longitudinal observational natural-history study at the Duke Eye Center in Durham, North Carolina, United States, which from 2013 enrolled people aged 50 or over with early or intermediate (dry) age-related macular degeneration from the centre's patients, together with controls from Duke optometry and comprehensive eye clinics or the patients' family and friends, and assessed them with retinal imaging and with visual function tests repeated about every six months over 24 months, to find functional end points for clinical trials.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001077> (<http://www.ebi.ac.uk/coho/COHO_0001077>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24096698") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://epi.grants.cancer.gov/eecc/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001077> "An NCI-supported consortium, begun in 2006, of case-control and cohort studies in North America, Europe, Asia and Australia that combines data across its member studies, including in a genome-wide association study, to investigate the etiology of endometrial cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001078> (<http://www.ebi.ac.uk/coho/COHO_0001078>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26061305") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32060376") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39179981") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001078> "A population-based study of the prevalence and risk factors of cognitive impairment and dementia in Chinese, Malay and Indian adults in Singapore, which drew participants aged 60 and over from the Singapore Epidemiology of Eye Diseases study (the Singapore Chinese Eye Study, 2009–2011, the Singapore Malay Eye Study, 2010–2013, and the Singapore Indian Eye Study, 2013–2015). Participants were screened with the Abbreviated Mental Test and a history of progressive forgetfulness, and those who screened positive were invited for neuropsychological testing and brain MRI.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001079> (<http://www.ebi.ac.uk/coho/COHO_0001079>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21980494") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23509962") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37399490") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001079> "A French case-control study of venous thrombosis whose cases, from medical centres in Grenoble, Marseille, Montpellier and Paris, had a documented idiopathic deep vein thrombosis or pulmonary embolism before the age of 50 without acquired risk factors or major thrombophilia defects, and whose controls were healthy French participants of the SU.VI.MAX study. It was genotyped genome-wide for genetic association studies of venous thrombosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001080> (<http://www.ebi.ac.uk/coho/COHO_0001080>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27559559") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39356295") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39516339") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001080> "A study of women aged 20–79 attending the Family History Risk and Prevention Clinic in Manchester, United Kingdom, recruited in 2010–2012, who completed risk-factor questionnaires and consented to DNA testing for SNP analysis and to breast density measurement, set up to validate and improve the breast cancer risk prediction models used in family history clinics.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001081> (<http://www.ebi.ac.uk/coho/COHO_0001081>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41419686") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001081> "A cohort of patients with aortic valve stenosis, diagnosed by echocardiography or by a history of valve replacement for severe stenosis, recruited from the German Heart Center Munich and the University of Bonn/Marburg, Germany, and genotyped for studies of the genetics of aortic stenosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001082> (<http://www.ebi.ac.uk/coho/COHO_0001082>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28645938") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38533959") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38700029") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9472883") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001082> "A population-based study of stroke incidence, risk factors, treatment and outcomes in the biracial population of a five-county region of southwestern Ohio and northern Kentucky, United States, around Cincinnati, which ascertains all hospitalized and autopsied strokes and transient ischaemic attacks among residents during one-year study periods held since 1993 (July 1993 to June 1994, 1999, 2005, 2010 and 2015), to measure temporal trends in stroke incidence and outcome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001083> (<http://www.ebi.ac.uk/coho/COHO_0001083>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39364016") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40399555") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001083> "Participants of the COVID-19 genetic studies of the Russian genetic testing company Genotek: its customers who consented to research use of their data and answered online questionnaires about COVID-19, studied for long COVID and, when aged 40 or over with non-severe COVID-19, as controls in a genome-wide association study of severe COVID-19 whose cases were patients hospitalised in Moscow and Ufa.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001084> (<http://www.ebi.ac.uk/coho/COHO_0001084>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16775037") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19252134") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001084> "A collection of DNA and clinical data for genetic association studies of diabetic nephropathy in type 1 diabetes, assembled with support from the JDRF, NIDDK and CDC by the Joslin Diabetes Center, from patients of its clinic in New England, and by the George Washington University Biostatistics Center, from volunteers across the United States and Canada. Participants aged 18–59 with type 1 diabetes diagnosed before age 31 were enrolled as cases with diabetic nephropathy (persistent proteinuria or end-stage renal disease) or as controls with normoalbuminuria after at least 15 years of diabetes, with both parents enrolled where possible to form family trios.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001085> (<http://www.ebi.ac.uk/coho/COHO_0001085>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23041239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021684") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001085> "A hospital-based series of patients with ischaemic stroke admitted to the stroke unit of the Department of Neurology of the Medical University of Graz, Austria, investigated with brain imaging and a standardised diagnostic protocol and subtyped by stroke neurologists, whose cases are compared in genetic studies of ischaemic stroke with participants of the Austrian Stroke Prevention Study from the same catchment area as controls.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001086> (<http://www.ebi.ac.uk/coho/COHO_0001086>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25519023") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001086> "A prospective clinical cohort of people newly diagnosed with head and neck cancer, recruited before treatment at NHS centres across the United Kingdom and coordinated from Bristol, with health, lifestyle, quality-of-life and sexual-history questionnaires, clinical data, blood, saliva and tumour tissue samples and follow-up, set up to evaluate the centralisation of head and neck cancer care and as a biomedical resource for translational and prognostic research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001087> (<http://www.ebi.ac.uk/coho/COHO_0001087>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16614111") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21437268") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22655231") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001087> "A multicentre hospital-based case–control study of cancers of the upper aerodigestive tract (oral cavity, pharynx, larynx and oesophagus), coordinated by the International Agency for Research on Cancer in Bucharest (Romania), Lodz (Poland), Moscow (Russia), Banská Bystrica (Slovakia), and Olomouc and Prague (Czech Republic) to investigate genetic susceptibility to these cancers and its interaction with alcohol and tobacco use. It is the upper aerodigestive tract arm of IARC's central European multicentre case–control study of lung, head and neck and kidney cancers, and part of its controls are shared with the lung cancer arm.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001088> (<http://www.ebi.ac.uk/coho/COHO_0001088>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23092589") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23158098") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35378236") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001088> "A combined sample of two longitudinal family studies of the Institute for Behavioral Genetics at the University of Colorado Boulder, United States: the Colorado Adoption Project, a prospective adoption study of behavioural development begun in 1975, and the Colorado Twin Registry, a population-based registry of twins born since 1968 that has recruited since 1982. Their genotyped participants are analysed together in genome-wide association meta-analyses of childhood and adolescent psychiatric traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001089> (<http://www.ebi.ac.uk/coho/COHO_0001089>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23935489") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37097752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001089> "An international collaboration of the HIV host genetics community, established to combine all available genome-wide SNP data sets on people living with HIV-1 worldwide, which pools genotype and clinical data from HIV cohorts and studies in North America, Europe, Australia and Africa, many of them natural-history cohorts, to study host genetic influences on HIV-1 acquisition, viral load and spontaneous control.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001090> (<http://www.ebi.ac.uk/coho/COHO_0001090>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32423502") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36914876") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42056605") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001090> "An international consortium of research groups studying the genetics of endometriosis, which pools genome-wide association data from studies in Europe, the United States, Australia and Japan, with cases identified by surgical confirmation, medical records or self-report, in meta-analyses of endometriosis risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001091> (<http://www.ebi.ac.uk/coho/COHO_0001091>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19847309") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37174278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001091> "A population-based cohort of adults descended from the inhabitants of the upper Val Borbera, a genetically isolated valley in the Apennine mountains of Piedmont, north-west Italy, recruited on the basis of their ancestry in the valley's villages and nearby areas, with clinical and anthropometric data collected by physicians of San Raffaele Hospital, Milan, to identify genes and variants underlying common disorders and quantitative traits; one of the isolated populations of the Italian Network of Genetic Isolates.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001092> (<http://www.ebi.ac.uk/coho/COHO_0001092>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12848902") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17845914") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001092> "A prospective multicentre case–control study, funded by the US National Institute of Neurological Disorders and Stroke, of adults with a first-ever ischaemic stroke confirmed by CT or MRI and enrolled within 30 days of onset at five academic medical centres in the United States, with centrally adjudicated stroke subtypes, and of stroke-free controls matched by age and sex and recruited mainly among the patients' spouses and unrelated friends, to investigate genetic risk factors for ischaemic stroke and its subtypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001093> (<http://www.ebi.ac.uk/coho/COHO_0001093>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28180256") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001093> "A prospective cohort of women recruited in 2011–2013 when attending mammography screening or clinical mammography at four hospitals in Sweden (in Stockholm, Helsingborg, Lund and Landskrona), with questionnaires, mammograms, blood samples and linkage to Swedish health registers, established to determine how mammographic density, genetic factors and lifestyle influence breast cancer risk and to build risk prediction models for individualised prevention and screening.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001094> (<http://www.ebi.ac.uk/coho/COHO_0001094>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16507150") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.kconfab.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001094> "A research resource of epidemiological, family-history, lifestyle and clinical data and biospecimens collected since 1997 from affected and unaffected members of families with multiple cases of breast and/or ovarian cancer, recruited by research nurses through family cancer clinics in Australia and New Zealand, and made available to researchers anywhere in the world for studies of familial breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001095> (<http://www.ebi.ac.uk/coho/COHO_0001095>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001095> "An ongoing, prospective, single-centre, hospital-based study of consecutive consenting patients of European origin with first-ever or recurrent ischaemic stroke admitted since 2002 to the Stroke Unit of the Jagiellonian University in Krakow, Poland, with stroke subtypes assigned by TOAST and CCS criteria, together with unrelated stroke-free controls from the population of southern Poland; one of the genetic research centres of the Stroke Genetics Network.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001096> (<http://www.ebi.ac.uk/coho/COHO_0001096>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29867722") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001096> "A prospective hospital-based study of patients of European descent with cerebral ischaemia (a clinical stroke with imaging confirmation, or a transient ischaemic attack with a new ischaemic lesion on diffusion-weighted imaging) admitted to the Stroke Unit of the University Hospitals Leuven, Belgium, from 2005 to 2009, with standardised diagnostic work-up and TOAST subtyping, together with controls recruited from the same population; one of the genetic research centres of the Stroke Genetics Network.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001097> (<http://www.ebi.ac.uk/coho/COHO_0001097>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30260755") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001097> "A multicentre, clinic-based case-control study of prostate cancer run since 2016 by the Men of African Descent and Carcinoma of the Prostate (MADCaP) Network at seven accrual centres in Ghana, Nigeria, Senegal and South Africa, with partner institutions in the United States, which under common eligibility criteria, instruments and biosample protocols enrols men over 30 who self-identify as black African: incident, histologically confirmed prostate cancer cases from urology and oncology clinics, and cancer-free controls frequency-matched by age from other clinics in the same catchment areas, to study the genetics and epidemiology of prostate cancer in sub-Saharan Africa.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001098> (<http://www.ebi.ac.uk/coho/COHO_0001098>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18433493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20400458") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28430825") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001098> "A cohort of African-American families in Maywood, Illinois, United States, recruited from 1995 by Loyola University Chicago Stritch School of Medicine from a representative random sample of residents aged 18 to 74 for its family studies of blood pressure and the genetics of hypertension in populations of West African origin, in which Maywood was the United States site alongside Nigeria and Jamaica.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001099> (<http://www.ebi.ac.uk/coho/COHO_0001099>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10613336") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35414113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001099> "A historical cohort of multigenerational families in Minnesota, United States, ascertained through a consecutive, family-history-unselected series of breast cancer probands diagnosed from 1944 to 1952 at the University of Minnesota, followed up by telephone interview and mailed questionnaire to measure cancer incidence and risk factors in their relatives (sisters, daughters, granddaughters, nieces and marry-ins).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001100> (<http://www.ebi.ac.uk/coho/COHO_0001100>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001100> "A prospective hospital-based registry of adults with ischaemic stroke, of any ethnic or racial group, admitted through the emergency room to the dedicated stroke unit of the New Jersey Neuroscience Institute at JFK Medical Center in Edison, New Jersey, United States, which enrolled first-ever and recurrent strokes of any severity from 2000 to 2009 with standardised investigations and TOAST subtyping; one of the genetic research centres of the Stroke Genetics Network.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001101> (<http://www.ebi.ac.uk/coho/COHO_0001101>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38038215") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40796328") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41160443") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41988974") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001101> "A prospective observational cohort of older multi-ethnic Asian patients aged 50 or over with no cognitive impairment, mild cognitive impairment or dementia due to Alzheimer's disease and/or cerebrovascular disease, recruited from 2010 at the memory clinics of the National University Hospital and St Luke's Hospital in Singapore and assessed by the Memory Aging and Cognition Centre, National University of Singapore, with annual clinical and neuropsychological follow-up for up to five years and brain MRI, retinal and blood biomarker data, to study vascular cognitive impairment and Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001102> (<http://www.ebi.ac.uk/coho/COHO_0001102>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31551913") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001102> "A hospital-based study at the Massachusetts General Hospital in Boston, United States, that from 2003 enrolled adults with acute ischaemic stroke (consecutive patients admitted to its stroke unit through the emergency department, or seen in its neurology clinics or on other inpatient services), with stroke-free controls from the hospital's outpatient clinics matched on age, sex and ancestry, to study genetic influences on the risk and outcome of ischaemic stroke; one of the genetic research centres of the Stroke Genetics Network.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001103> (<http://www.ebi.ac.uk/coho/COHO_0001103>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32716505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36064556") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001103> "A cohort of patients with histopathologically confirmed cutaneous melanoma managed at Melanoma Institute Australia in Sydney, Australia, identified with written informed consent from the institute's Biospecimen Bank and Research Database, whose germline DNA was genotyped genome-wide in phases from 2014 and who are followed prospectively for outcomes including death from melanoma, ascertained from clinical records and linkage to Australian cancer registries.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001104> (<http://www.ebi.ac.uk/coho/COHO_0001104>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26466845") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001104> "A population-based study of people aged 75 years or older in Dijon, France, recruited from 2009 to 2013 among participants of the Three-City (3C) Study, who had eye examinations, including photographs and optical coherence tomography of the macula and optic disc, at Dijon University Hospital, designed to find associations between age-related eye diseases and neurologic and heart diseases in the elderly.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001105> (<http://www.ebi.ac.uk/coho/COHO_0001105>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22306652") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23041239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001105> "A hospital-based collection of consecutive patients of European ancestry with ischaemic stroke, recruited from 2002 to 2009 at the dedicated stroke unit of the Department of Neurology, Klinikum Großhadern, Ludwig-Maximilians-University, Munich, Germany, with stroke subtypes assigned by TOAST criteria; the cases were genotyped genome-wide in the Wellcome Trust Case Control Consortium 2 ischaemic stroke study and contribute to METASTROKE, the Stroke Genetics Network (SiGN) and MEGASTROKE.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001106> (<http://www.ebi.ac.uk/coho/COHO_0001106>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23046559") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41913940") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001106> "A population-based register of adult twins and other multiples from the region of Murcia, southeast Spain, created in 2006 through an agreement between the University of Murcia and the Murcia Health Council, which identifies twins in the computerised databases of the regional health system and collects interview, questionnaire and anthropometric data in successive waves, with a biobank, for research on genetic and environmental influences on health and health-related behaviours; it began with female twins born 1940-1966 and later added male and opposite-sex twins.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001107> (<http://www.ebi.ac.uk/coho/COHO_0001107>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38784964") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001107> "A collaboration of the University of Exeter, King's College London, Innlandet Hospital Trust, the University of Oslo and Stavanger University Hospital that undertakes secondary analysis of data on patients with Alzheimer's disease from cohort studies and patient registries, to study the genetics of neuropsychiatric symptoms such as psychosis in dementia. Its sources are the Norwegian registry of persons assessed for cognitive symptoms (NorCog) with the affiliated Progression of Alzheimer's Disease and Resource Use study, the REDIC-NH and Health and Memory Study nursing-home cohorts in Norway, AddNeuroMed, and hospital outpatient clinics in Italy and Greece.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001108> (<http://www.ebi.ac.uk/coho/COHO_0001108>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20711177") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32566740") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001108> "A case-control sample of people with Parkinson's disease, diagnosed by modified UK Brain Bank criteria, and neurologically healthy controls (community volunteers and patients' spouses), recruited by the NeuroGenetics Research Consortium at affiliated neurology and movement disorder clinics in Oregon, Washington, Georgia and New York, United States, with uniform, standardised methods for diagnosis, subject selection, data collection and DNA preparation, for genetic and gene-environment studies of Parkinson's disease, and genotyped genome-wide.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001109> (<http://www.ebi.ac.uk/coho/COHO_0001109>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20400458") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21573225") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21998595") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22615923") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001109> "A Loyola University Chicago project on the genetics of hypertension in people of West African origin, whose genome-wide association sample consists of unrelated Yoruba-speaking adults with normal or raised blood pressure from Igbo-Ora, a rural town, and Idikan, a low-income neighbourhood of Ibadan, in southwest Nigeria, recruited as part of a long-term study of the environmental and genetic factors underlying hypertension; the Idikan participants were controls of the Africa America Diabetes Mellitus study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001110> (<http://www.ebi.ac.uk/coho/COHO_0001110>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31326317") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42152146") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001110> "A case-control sample of Chinese patients with histologically confirmed incident non-small cell lung cancer, untreated by chemotherapy or radiotherapy before diagnosis, and cancer-free controls from community screening for non-communicable diseases, frequency-matched on age, sex and region, genotyped on the Illumina Global Screening Array by Nanjing Medical University, China; it combines three regional case-control studies, from Nanjing and Shanghai, from Beijing and Tianjin, and from Guangdong.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001111> (<http://www.ebi.ac.uk/coho/COHO_0001111>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26296077") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27571329") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38870440") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001664.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001111> "A consortium of academic Parkinson's disease research centres in the United States, several of them Morris K. Udall Centers of Excellence for Parkinson's Disease Research, that pools patients with Parkinson's disease enrolled in the centres' studies, each given a detailed neurological evaluation and a shared core battery of cognitive tests, with a coordinating centre at the University of Washington and VA Puget Sound Health Care System in Seattle, to identify genetic risk factors for cognitive impairment in Parkinson's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001112> (<http://www.ebi.ac.uk/coho/COHO_0001112>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21673961") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23513043") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001112> "A case-control study of ovarian cancer in Poland, with participants from Szczecin, Poznań, Opole and Rzeszów, that is one of the studies of the Ovarian Cancer Association Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001113> (<http://www.ebi.ac.uk/coho/COHO_0001113>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31747977") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38412344") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001113> "A study of the younger part of the Screening Across the Lifespan Twin study (SALT) cohort of the Swedish Twin Registry, twins born 1943–1958, who in 2008–2010 were sent an extensive self-report questionnaire, a request for saliva for DNA and an invitation to a web-based investigation, carried out by the registry with researchers in epidemiology, medicine, political science and economics.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001114> (<http://www.ebi.ac.uk/coho/COHO_0001114>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17208583") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28866107") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34536413") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001114> "A research programme of the US National Heart, Lung, and Blood Institute, established in 2001 (also called the Severe Asthma Network), in which a network of investigators at academic health centres in the United States recruits adults and children with severe and non-severe asthma for detailed phenotypic characterization, in the SARP I and II cohorts (2001–2012) and the longitudinal SARP III cohort (from 2012), to study the mechanisms that distinguish severe from non-severe asthma; the genomes of some of its participants were sequenced in NHLBI's Trans-Omics for Precision Medicine programme.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001115> (<http://www.ebi.ac.uk/coho/COHO_0001115>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29797644") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39373640") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41870384") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001115> "A lifespan cohort study of people with sickle cell disease in the United States, established in 2014 by St. Jude Children's Research Hospital, that prospectively enrols patients at St. Jude (the coordinating site), two other sickle cell centres and St. Jude affiliate sites, collects retrospective and longitudinal clinical, neurocognitive, geospatial, psychosocial and health-outcome data and banks biological samples, to study disease progression from childhood into adulthood and the long-term effects of therapies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001116> (<http://www.ebi.ac.uk/coho/COHO_0001116>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16900881") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38152657") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001116> "A genetic epidemiological study of type 2 diabetes and cardiovascular disease in Punjabi-speaking Sikhs of North Indian origin, begun as a family-based study of Khatri Sikh families with at least two siblings affected by type 2 diabetes and extended as a case-control study, with participants recruited in northern India from 2003, to investigate genetic and environmental risk factors for type 2 diabetes and cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001117> (<http://www.ebi.ac.uk/coho/COHO_0001117>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34283174") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001117> "A cohort of individuals with sickle cell disease recruited from Baylor College of Medicine and from the Sickle Cell Clinical Research and Intervention Program (SCCRIP) cohort at St. Jude Children's Research Hospital, whose whole genomes were sequenced to define genotype-phenotype relations in sickle cell disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001118> (<http://www.ebi.ac.uk/coho/COHO_0001118>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23381943") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021684") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001118> "A hospital-based collection of patients with ischaemic stroke, including some with transient ischaemic attack and recent brain infarction, recruited at St George's in London, United Kingdom, from 1995 to 2008, genotyped in the Wellcome Trust Case Control Consortium 2 ischaemic stroke study and one of the genetic research centres of the NINDS Stroke Genetics Network.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001119> (<http://www.ebi.ac.uk/coho/COHO_0001119>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20570912") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22266113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35414113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001119> "A family study in the United Kingdom that from October 2002 recruited women attending the Cambridge and Huntingdon NHS breast screening services who had one or more female blood relatives (sisters, half-sisters, first cousins, aunts or nieces) who had also had screening mammograms, with further families found through newspaper and radio advertisements, to map genes underlying quantitative phenotypes related to breast cancer, in particular mammographic breast density and sex steroid hormone levels.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001120> (<http://www.ebi.ac.uk/coho/COHO_0001120>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21370418") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33374007") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001120> "A retrospective cohort with prospective follow-up, established in 2007 by St. Jude Children's Research Hospital in Memphis, Tennessee, of survivors of paediatric cancer diagnosed and treated there between 1962 and 2012 who have survived at least five years from diagnosis (until 2015, only adults who had survived ten years), with frequency-matched community controls, who are invited back to the hospital at least every five years for protocol-based medical assessments, patient-reported outcomes and biospecimen collection, to study late health outcomes of childhood cancer and its treatment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001121> (<http://www.ebi.ac.uk/coho/COHO_0001121>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20648012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39543761") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39665592") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001121> "A multicentre study in central Sweden of consecutive patients newly diagnosed with colorectal cancer of any stage, recruited between 2004 and 2009 at 14 hospitals by the Swedish Low-Risk Colorectal Cancer Study Group and interviewed on their family history of cancer, with a lifestyle questionnaire for those recruited in 2004–2006 and cancer-free spouses of participants serving as controls; its cases and controls are used in genetic studies of colorectal cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001122> (<http://www.ebi.ac.uk/coho/COHO_0001122>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24875374") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30510241") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001122> "A two-phase case-control study of colorectal polyps among enrollees of Group Health Cooperative (now Kaiser Permanente Washington), an integrated health-care delivery system in western Washington State, United States, aged 24–79 years who had an index colonoscopy for any indication in 1998–2003 or 2004–2007, comprising patients diagnosed with adenomas or serrated polyps and polyp-free controls who gave buccal-cell or blood samples and completed a structured questionnaire; its advanced-adenoma cases and matched polyp-free controls were genotyped for consortium genome-wide studies of colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001123> (<http://www.ebi.ac.uk/coho/COHO_0001123>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11882254") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21940970") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021684") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001123> "A family-based study of ischaemic stroke that from 1999 to 2011 enrolled, at clinical centres in the United States and Canada, adult probands with radiographically confirmed ischaemic stroke who had at least one living full sibling with stroke, together with their stroke-affected siblings, confirmed by central review of medical records, and where possible a stroke-free sibling, confirmed by structured telephone interview, all contacted through the proband, to search the genome for genetic risk factors for ischaemic stroke by linkage and family-based association analysis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001124> (<http://www.ebi.ac.uk/coho/COHO_0001124>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17469173") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27018016") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001124> "A two-generation, family-based study in the Saguenay–Lac-Saint-Jean region of Quebec, Canada, a genetic founder population, of adolescent sibships aged 12–18 of French-Canadian origin recruited through high schools in 2003–2012, half of them exposed prenatally to maternal cigarette smoking and matched with non-exposed adolescents for maternal education and school, and of their parents (partly assessed in 2003–2012 and fully in 2012–2015), with extensive phenotyping including brain and abdominal MRI, cardiometabolic assessments and genome-wide genotyping, to investigate the aetiology, early stages and trans-generational trajectories of common cardiometabolic and brain diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001125> (<http://www.ebi.ac.uk/coho/COHO_0001125>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30367059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38291025") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://genepi.med.uni-greifswald.de/thyroidomics/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001125> "An international consortium of large, well-phenotyped cohort studies, mostly population-based, formed to study the determinants and effects of thyroid diseases and thyroid function with genomic, epigenomic, transcriptomic, proteomic and metabolomic data, which meta-analyses genome-wide association data from its member cohorts on thyroid-stimulating hormone, free thyroxine, triiodothyronine, thyroid dysfunction and related traits and makes the summary statistics available.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001126> (<http://www.ebi.ac.uk/coho/COHO_0001126>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17448130") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22540912") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38815053") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001126> "A multicentre randomized clinical trial funded by the US National Institute of Diabetes and Digestive and Kidney Diseases that from 2004 to 2009 enrolled children and adolescents aged 10–17 years with type 2 diabetes of less than two years' duration, a body-mass index at or above the 85th percentile and no diabetes autoantibodies at 15 clinical centres in the United States, and compared metformin alone with metformin plus rosiglitazone or plus an intensive lifestyle intervention for durable glycaemic control until 2011; its participants were then followed into adulthood in the observational TODAY2 study (2011–2020).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001127> (<http://www.ebi.ac.uk/coho/COHO_0001127>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26485428") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38849413") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001127> "A prospective, multicentre, longitudinal epidemiological and biomarker study of Parkinson's disease in the United Kingdom, funded by Parkinson's UK, that recruited patients aged 18–90 with a clinical diagnosis of Parkinson's disease of recent onset (diagnosed within the preceding 3.5 years) or young onset (diagnosed at or before age 50) at 72 National Health Service secondary-care sites, together with unaffected siblings of patients, and follows them with repeated motor, non-motor and quality-of-life assessments, genotyping and biosamples, to explain variation in the clinical phenotype of Parkinson's disease, including its relation to genetic variation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001128> (<http://www.ebi.ac.uk/coho/COHO_0001128>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42237039") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001128> "A case-control cohort from Universitatsklinikum Saarlandes, Germany, consisting of individuals clinically diagnosed with sporadic Alzheimer's disease together with cognitively healthy, age-, gender- and ethnicity-matched population-based controls.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001129> (<http://www.ebi.ac.uk/coho/COHO_0001129>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20507582") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001129> "A randomised controlled screening trial of Viborg Hospital in which the men aged 65-74 living in the Central Denmark Region were randomised, from October 2008, either to an invitation to combined screening for abdominal aortic aneurysm, peripheral arterial disease and hypertension, with preventive treatment for those found to have disease, or to no invitation, to assess the effect of screening on all-cause mortality and its cost-effectiveness.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001130> (<http://www.ebi.ac.uk/coho/COHO_0001130>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41969536") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.un.org/unispal/document/auto-insert-204882/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001130> "The cancer registry of the West Bank, kept by the Palestinian Ministry of Health, which records incident cancer cases among West Bank residents; it continues the West Bank part of the population-based Palestinian Cancer Registry, established in 1996 and working regularly from 1998, which was split into separate West Bank and Gaza registries in 2007.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001131> (<http://www.ebi.ac.uk/coho/COHO_0001131>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001131> "A hospital-based collection of ischaemic stroke patients admitted from August 2008 to Barnes-Jewish Hospital/Washington University Medical Center in St. Louis, Missouri, identified by screening emergency department and inpatient stroke service admissions regardless of age, race or ethnicity and followed up at 90 days, whose DNA came from an acute tPA pharmacogenomics study, the Recovery Genomics after Ischemic Stroke (ReGenesIS) study and the Cognitive Rehabilitation and Recovery Group (CRRG) stroke registry; one of the genetic research centres of the NINDS Stroke Genetics Network.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001132> (<http://www.ebi.ac.uk/coho/COHO_0001132>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25102180") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28430825") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001132> "The subset of the African American participants of the REGARDS cohort that the Sea Islands Genetics Network (SIGNET) project genotyped on the Affymetrix 6.0 array: all African American REGARDS participants with type 2 diabetes recruited in South Carolina, Georgia, North Carolina and Alabama, an equal number of diabetes-free controls matched by sex and age strata, and all other participants living in the 15-county Low Country region of South Carolina and Georgia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001133> (<http://www.ebi.ac.uk/coho/COHO_0001133>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21044948") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001133> "The Parkinson's disease genome-wide case-control study of the Wellcome Trust Case Control Consortium 2 and the UK Parkinson's Disease Consortium: UK patients with idiopathic Parkinson's disease meeting UK Brain Bank criteria, randomly selected from population- and hospital-based clinics through five UK centres and genotyped at the Wellcome Trust Sanger Institute, compared with the WTCCC2 controls from the 1958 British Birth Cohort and the UK Blood Services.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001134> (<http://www.ebi.ac.uk/coho/COHO_0001134>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20606091") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00088894") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001134> "A double-blind, placebo-controlled, randomised phase III trial of the Cancer and Leukemia Group B that enrolled patients with previously untreated locally advanced or metastatic pancreatic cancer at its participating institutions in the United States between June 2004 and April 2006, comparing gemcitabine plus bevacizumab with gemcitabine plus placebo, with overall survival as the primary end point.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001135> (<http://www.ebi.ac.uk/coho/COHO_0001135>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22454414") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00110214") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001135> "A randomised, double-blind, placebo-controlled phase III trial designed by the Cancer and Leukemia Group B and endorsed by the Eastern Cooperative Oncology Group that enrolled men with chemotherapy-naive progressive metastatic castration-resistant prostate cancer at participating institutions in the United States between May 2005 and December 2007, comparing docetaxel and prednisone with or without bevacizumab, with overall survival as the primary end point.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001136> (<http://www.ebi.ac.uk/coho/COHO_0001136>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36182938") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.colonomics.org/home/team/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001136> "A multi-omics colon cancer study run by the Catalan Institute of Oncology of patients with microsatellite-stable stage II colon adenocarcinoma who had radical surgery without adjuvant therapy at Bellvitge University Hospital (Barcelona, Spain) in 1996-2000 and were selected in 2012; their tumour and paired adjacent normal mucosa, with colon mucosa from healthy donors undergoing colonoscopy as reference, were profiled for gene expression, DNA methylation, SNPs, copy number and miRNAs to find diagnostic and prognostic biomarkers of colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001137> (<http://www.ebi.ac.uk/coho/COHO_0001137>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27138575") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00601900") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001137> "A randomised, multicentre trial of the Cancer and Leukemia Group B (now the Alliance for Clinical Trials in Oncology), begun in the United States in 2008, of first-line endocrine therapy alone or with bevacizumab for women with hormone receptor-positive advanced-stage breast cancer who were postmenopausal or receiving ovarian suppression: a phase III comparison with letrozole, run in parallel with a phase II comparison with tamoxifen.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001138> (<http://www.ebi.ac.uk/coho/COHO_0001138>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30899065") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42009823") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001138> "A research cohort of customers of 23Mofang (Chengdu 23Mofang Biotechnology Co., Ltd.), a Chinese direct-to-consumer genetic testing company, who were genotyped through its personal genome service and consented to the research use of their genotypes and of traits they self-reported in the company's web-based surveys.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001139> (<http://www.ebi.ac.uk/coho/COHO_0001139>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26492185") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27110347") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001139> "A normative craniofacial study begun in 2009 as part of the FaceBase Consortium of the US National Institute of Dental and Craniofacial Research, which recruited healthy people aged 3 to 40 of self-reported European ancestry and without craniofacial conditions at four US sites (Pittsburgh, Seattle, Houston and Iowa City), collecting 3D facial surface images, anthropometric measurements, a demographic questionnaire and saliva DNA for genome-wide genotyping, and shares the data through a web-based repository.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001140> (<http://www.ebi.ac.uk/coho/COHO_0001140>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33563976") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34118463") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34873157") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001140> "A multi-omics cohort of adult Chinese volunteers in Shenzhen, China, run by BGI-Shenzhen and recruited largely at annual physical examinations from 2017 (some gave samples from 2015), with sampling repeated over time. It combines whole-genome sequencing, metagenomes of the gut, mouth and other body sites, plasma metabolites, medical tests and questionnaires on diet and lifestyle, to study how host genetics and environment shape the microbiome and health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001142> (<http://www.ebi.ac.uk/coho/COHO_0001142>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10588299") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11594942") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39826679") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000001.v3.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001142> "A multicentre prospective study sponsored by the US National Eye Institute that recruited people aged 55 to 80, with or without age-related macular degeneration or lens opacities, at 11 retinal specialty clinics in the United States from 1992 to 1998 and followed them to 2005. It studied the clinical course and risk factors of age-related macular degeneration and cataract, and included randomised, placebo-controlled trials of high-dose antioxidant vitamins and zinc for these conditions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001143> (<http://www.ebi.ac.uk/coho/COHO_0001143>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22840421") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23644932") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001143> "A multicentre, randomised, double-masked, placebo-controlled phase 3 trial sponsored by the US National Eye Institute and run from 2006 to 2012 at 82 clinical centres in the United States. It enrolled people aged 50 to 85 at risk of progressing to advanced age-related macular degeneration to test whether adding lutein plus zeaxanthin or omega-3 fatty acids to the AREDS supplement formulation, or removing beta carotene or lowering zinc, changes that risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001144> (<http://www.ebi.ac.uk/coho/COHO_0001144>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31941441") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35839814") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001144> "A study of kidney function in adults with and without chronic kidney disease in sub-Saharan Africa, run by the African Research on Kidney Disease collaboration within existing population cohorts in Malawi (Karonga and Lilongwe), South Africa (the Agincourt health and demographic surveillance site) and Uganda (the General Population Cohort). It measured glomerular filtration rate by iohexol plasma clearance to test equations for estimating it, with serial biobanking, cross-sectionally in Malawi and Uganda and longitudinally in South Africa.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001145> (<http://www.ebi.ac.uk/coho/COHO_0001145>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29527500") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37502020") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38334195") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40441049") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001145> "A longitudinal study of typical cognitive aging at the University of California, Berkeley, and Lawrence Berkeley National Laboratory. It recruits cognitively normal older adults (and some young adults) living in the community in the San Francisco Bay Area through advertisements and word of mouth, and follows them with repeated neuropsychological testing, MRI, and PET imaging of amyloid and tau, to study brain changes in normal aging and early Alzheimer's disease pathology.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001146> (<http://www.ebi.ac.uk/coho/COHO_0001146>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11507694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15049939") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16470599") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20595243") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001146> "A repository of DNA samples from British families of European ancestry with at least two siblings affected by type 1 diabetes, and their parents, recruited in the United Kingdom between 1989 and 1996 for the British Diabetic Association (now Diabetes UK) and made publicly available for genetic linkage and association studies of type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001147> (<http://www.ebi.ac.uk/coho/COHO_0001147>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25734425") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31539824") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001147> "A prospective cohort of children aged 7–10 years in grades 2 to 4 at 39 primary schools in Barcelona, Spain, selected as pairs with high and low traffic-related air pollution, whose working memory and attention were tested four times, every three months, from January 2012 to March 2013, with brain MRI in a subsample, to study the effects of traffic-related air pollution on cognitive and brain development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001148> (<http://www.ebi.ac.uk/coho/COHO_0001148>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16341085") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18596909") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21390317") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23255287") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24523857") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001148> "A consortium of large prospective cohorts in the United States, Europe and Australia, among them ATBC, CPS-II, EPIC, HPFS, the Multiethnic Cohort, NHS, PHS, PLCO and WHS, which pools nested case–control studies of breast and prostate cancer with DNA and prospectively collected questionnaire data, first to relate variation in genes of the steroid-hormone metabolism and insulin-like growth factor pathways to cancer risk, and later for genome-wide association studies of aggressive prostate cancer and oestrogen receptor-negative breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001149> (<http://www.ebi.ac.uk/coho/COHO_0001149>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40021644") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41408349") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.kcl.ac.uk/research/bstop") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001149> "An ongoing prospective observational study and biobank of people aged 16 or over with moderate-to-severe plaque psoriasis starting systemic or biologic therapy, established in 2011 at the St John's Institute of Dermatology, Guy's and St Thomas' NHS Foundation Trust, and recruiting at more than 80 dermatology centres across the United Kingdom. It pairs DNA from every participant, and further blood and skin samples from some, with clinical data, captured partly through the British Association of Dermatologists Biologics and Immunomodulators Register, to identify biomarkers of response to psoriasis treatments.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001150> (<http://www.ebi.ac.uk/coho/COHO_0001150>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40050615") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.bu.edu/bwhs/history/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001150> "A prospective cohort of Black women in the United States, run by the Slone Epidemiology Center at Boston University, who enrolled in 1995 by returning health questionnaires mailed to subscribers of Essence magazine, members of the Black Nurses' Association, participants in its feasibility studies, and friends and relatives of respondents. The women are followed by repeated mailed questionnaires, with medical record and cancer registry review, to study the causes of illnesses common in Black women, such as breast cancer, hypertension, diabetes, lupus and uterine fibroids.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001151> (<http://www.ebi.ac.uk/coho/COHO_0001151>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14578303") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23340891") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24130360") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30943964") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001151> "A prospective cohort of adults aged 19–56 years without known coronary heart disease, with long-standing type 1 diabetes or without diabetes (controls, mostly spouses, friends and neighbours of those with diabetes), examined from March 2000 to April 2002 at the Barbara Davis Center for Childhood Diabetes and the University of Colorado in Denver, United States, and re-examined about six years later. Coronary artery calcification was measured by electron-beam computed tomography, to study the prevalence and progression of subclinical coronary atherosclerosis in type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001152> (<http://www.ebi.ac.uk/coho/COHO_0001152>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19169254") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000019.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001152> "A case–control collection of people of white European ancestry, with psoriasis diagnosed by dermatologists and controls without psoriasis, that pooled the long-standing psoriasis genetics collections of three United States groups, at the University of Michigan, the University of Utah and Washington University in St. Louis. It was genotyped genome-wide on the Perlegen platform through the Genetic Association Information Network (GAIN) to identify psoriasis susceptibility loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001153> (<http://www.ebi.ac.uk/coho/COHO_0001153>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29580111") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37945903") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001153> "A case–control study of prostate cancer in men of African ancestry, genotyped on the Illumina H3Africa array. It combines African American cases from Los Angeles, California, identified through the SEER cancer registry, and cancer-free controls from the African American Eye Disease Study in Inglewood, California, with incident cases and controls from other clinics at Mulago Hospital in Kampala, Uganda.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001154> (<http://www.ebi.ac.uk/coho/COHO_0001154>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29897482") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32019797") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40488529") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001154> "A prospective birth cohort of children enrolled within a week of birth between June 2014 and March 2016 in Mirpur, an urban neighbourhood of Dhaka, and Mirzapur, a rural subdistrict north-west of Dhaka, Bangladesh, whose mothers were identified in the second trimester of pregnancy. The children were followed with twice-weekly home visits for diarrhoea, monthly stool samples and three-monthly growth measurements, to study the incidence of cryptosporidiosis, the immune response to it, host genetic susceptibility and its effect on child growth.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001155> (<http://www.ebi.ac.uk/coho/COHO_0001155>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19364948") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31941657") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001155> "A multi-institutional retrospective cohort, with longitudinal follow-up, of five-year survivors of the most common childhood cancers diagnosed before age 21 at participating paediatric centres in the United States and Canada, with a comparison cohort of their siblings. It was funded by the US National Cancer Institute in 1994 for survivors diagnosed in 1970-1986 and later expanded to those diagnosed in 1987-1999, as a resource for research on the long-term effects of childhood cancer and its treatment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001156> (<http://www.ebi.ac.uk/coho/COHO_0001156>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25525693") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31526754") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34351445") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001156> "A prospective, multicentre, longitudinal observational cohort of patients with traumatic brain injury who presented to hospital within 24 hours of injury with an indication for CT, recruited between December 2014 and December 2017 at centres in 18 countries across Europe and in Israel. Funded by the European Union's Seventh Framework Programme, it comprises a core study, with neuroimaging, biospecimens and outcome assessment, and a broader registry, and aims to improve the characterisation and classification of TBI and to identify best clinical care through comparative effectiveness research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001157> (<http://www.ebi.ac.uk/coho/COHO_0001157>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35647563") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36206743") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38536042") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001157> "A Johns Hopkins University study that enrolled people with cystic fibrosis both with and without cystic fibrosis-related diabetes; its participants are among those whose genomes were sequenced by the Cystic Fibrosis Genome Project.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001158> (<http://www.ebi.ac.uk/coho/COHO_0001158>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23670970") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25287419") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31697830") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36206743") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001158> "A family-based cohort of living twins, triplets and siblings who all have cystic fibrosis, and their parents, recruited from 2000 by Johns Hopkins University through CF care centres mostly in the United States and also in Australia, Israel and Scotland, to assess genetic and environmental modifiers of clinical outcomes in CF.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001159> (<http://www.ebi.ac.uk/coho/COHO_0001159>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14646025") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39641998") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40575494") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001159> "A population-based longitudinal cohort of Black and White adults aged 65 and over living in four adjacent neighbourhoods on the south side of Chicago, Illinois, recruited through a door-to-door census from 1993, with later age groups entered as residents turned 65. Participants were followed until 2012 with in-home interviews every three years and clinical evaluation of stratified random samples, to study common chronic conditions of late life, especially risk factors for Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001160> (<http://www.ebi.ac.uk/coho/COHO_0001160>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33096046") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40212739") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41321066") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001160> "A population-based longitudinal birth cohort of the children born in the Christchurch urban region of New Zealand during a four-month period from April to August 1977, studied by the University of Otago, Christchurch, at birth, 4 months, 1 year, annually to age 16 and at intervals into adulthood (to age 40), on their health, development, social circumstances and wellbeing across the life course.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001161> (<http://www.ebi.ac.uk/coho/COHO_0001161>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23079770") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25486269") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25668262") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33215284") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001161> "A randomised, multicentre, double-blind, placebo-controlled phase III trial population of adults with early, treated Parkinson's disease (within five years of diagnosis and receiving dopaminergic therapy). Participants were enrolled at 45 sites in the United States and Canada from March 2007 to May 2010 by the NINDS Exploratory Trials in Parkinson's Disease (NET-PD) network, to test whether creatine slows long-term clinical decline, and were followed until September 2013. DNA from the participants who consented to banking is held in the Coriell Institute for Medical Research biorepository.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001162> (<http://www.ebi.ac.uk/coho/COHO_0001162>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25835958") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42101744") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001162> "A longitudinal study of the health and behaviour of a complete birth cohort: children born at Queen Mary Maternity Hospital, Dunedin, New Zealand, between April 1972 and March 1973 and still living in the greater Dunedin area at age 3. They were assessed in day-long multidisciplinary phases from age 3 through childhood and adolescence into midlife, by the Dunedin Multidisciplinary Health and Development Research Unit of the University of Otago.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001163> (<http://www.ebi.ac.uk/coho/COHO_0001163>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28974648") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30723731") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30764884") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ecrhs.org/ecrhs-i") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ecrhs.org/ecrhs-ii") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ecrhs.org/ecrhs-iii") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ecrhs.org/ecrhs-iv") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001163> "A multicentre, population-based cohort of adults aged 20 to 44 years who were selected at random from population registers in 1990-1994 in centres mainly in Western Europe, and also in Australia, New Zealand, the United States and elsewhere, and surveyed with a standardised protocol (a screening questionnaire, then a clinical examination of a random subsample and of those reporting asthma symptoms) to compare the prevalence of asthma and allergic disease, their risk factors and their treatment across countries. Those examined were followed up in ECRHS II (1998-2002), ECRHS III (2008-2014) and ECRHS IV (from 2021) to study the incidence and prognosis of asthma and allergy, lung function decline and COPD.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001164> (<http://www.ebi.ac.uk/coho/COHO_0001164>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21031013") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001164> "A University of Pittsburgh biorepository, funded by the National Cancer Institute in 2001 as an Early Detection Research Network resource, of clinically annotated biospecimens and data from adults with, or suspected of having, digestive diseases who were managed in University of Pittsburgh Medical Center hospitals for colorectal cancer screening or for gastrointestinal malignancies, premalignant conditions, inflammatory bowel disease, pancreatic diseases or pancreatic and colorectal cancers. Patients followed from 1990 to 2000 were gathered retrospectively and new patients have been enrolled prospectively since 2001 and followed continuously, to support translational research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001165> (<http://www.ebi.ac.uk/coho/COHO_0001165>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16981990") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30885181") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001165> "A population-based study of the residents of the town of Leutkirch in Baden-Württemberg, south-western Germany, designed by the State Health Department of Baden-Württemberg and the University of Ulm, for which inhabitants aged 10 to 65 years were selected at random from the municipal population register and examined in November and December 2002 (EMIL-I) with a questionnaire, anthropometry, abdominal ultrasound and blood sampling. Its original aim, the prevalence of infection with the fox tapeworm Echinococcus multilocularis, was extended to internal diseases and public health, and a subsample was re-examined in 2013 (EMIL-II).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001166> (<http://www.ebi.ac.uk/coho/COHO_0001166>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19470318") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22554417") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26061914") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39260370") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001166> "A prospective, multicentre observational cohort of children with cystic fibrosis aged 12 years or younger who were free of Pseudomonas aeruginosa at enrolment (no earlier positive respiratory culture, or at least two years of negative cultures) or were taking part in the companion Early Pseudomonas Infection Control clinical trial, enrolled in 2004-2006 at 59 cystic fibrosis care centres in the United States and led from the University of Washington and Seattle Children's Hospital. Participants were followed through encounter-based data collection built on the Cystic Fibrosis Foundation Patient Registry, annual family surveys, respiratory cultures and banked serum, bacterial isolates and DNA, to identify risk factors for early acquisition of P. aeruginosa and to describe its clinical consequences.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001167> (<http://www.ebi.ac.uk/coho/COHO_0001167>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40350583") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.eriskstudy.com/about-the-e-risk-study/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001167> "A nationally representative birth cohort of same-sex twins born in England and Wales in 1994-1995, drawn from a birth register of twins and recruited to represent UK families with newborns in the 1990s (ensuring enough children in disadvantaged homes and avoiding an excess of twins born to well-educated women after assisted reproduction). Proposed in 1997, funded by the Medical Research Council from 1998 and based at King's College London, it assessed the families at home when the twins were 5 (1999-2000), 7, 10, 12 and 18 years old, surveyed them online in their mid-twenties and planned a further assessment at age 30 for 2024-2025, to study how environmental and genetic factors contribute to behaviour, health and mental health problems from childhood into adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001168> (<http://www.ebi.ac.uk/coho/COHO_0001168>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32979978") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39258169") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001168> "The participants of a multicentre, randomised, double-blind, placebo-controlled trial at 39 UK hospital centres, funded by the Medical Research Council and National Institute for Health Research Efficacy and Mechanism Evaluation programme, in which women aged 18-50 years with chronic pelvic pain of at least three months and no obvious pelvic pathology at laparoscopy, screened between November 2015 and March 2019, were randomly assigned to gabapentin or matching placebo for 16 weeks to measure the efficacy and safety of gabapentin. Participants could give a saliva sample for genetic study at trial entry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001169> (<http://www.ebi.ac.uk/coho/COHO_0001169>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30770926") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37492417") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39030058") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001169> "A single-centre prospective pregnancy cohort at Gurugram Civil Hospital, a secondary-care hospital in Gurugram district, Haryana, north India, that from May 2015 enrolled pregnant women before 20 weeks' gestation (dated by ultrasound) and followed them through pregnancy to delivery and once within six months after delivery, building repositories of clinical data, biospecimens and ultrasound images. Coordinated by the Translational Health Science and Technology Institute and funded by India's Department of Biotechnology, it aims to identify clinical, epidemiological, genomic, epigenomic, proteomic and microbial correlates of preterm birth and to develop risk-prediction tools for it.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001170> (<http://www.ebi.ac.uk/coho/COHO_0001170>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36777996") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.globalbiobankmeta.org/parcipating-biobanks") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001170> "A collaborative network of biobanks and genomics initiatives, formed in 2019 by 23 biobanks from four continents (North America, Europe, East and West Asia, and Australia) and since joined by others, whose participants have genotypes linked to electronic health records or other health data. Member biobanks run genome-wide association studies with harmonised phenotype definitions and methods, stratified by ancestry and sex, and GBMI meta-analyses the summary statistics across biobanks and ancestries, beginning with 14 diseases and endpoints, and releases them publicly, to increase the power and ancestral diversity of genetic studies of human disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001171> (<http://www.ebi.ac.uk/coho/COHO_0001171>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21482186") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21546499") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22118442") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23235801") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23578722") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25261932") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36273105") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001171> "Patients with diffuse large B-cell lymphoma (DLBCL) enrolled in the LNH03 (LNH 2003) programme of treatment trials of the Groupe d'Etude des Lymphomes de l'Adulte (GELA, later the Lymphoma Study Association, LYSA), who consented to DNA analysis. The programme's trials, opened from December 2003 at centres mainly in France and Belgium for patients of different ages and prognostic risk, were the randomised trials LNH03-1B, LNH03-2B and LNH03-6B, the phase 2 trial LNH03-3B, LNH03-39B and a phase 2 trial of R-miniCHOP in patients over 80. The patients' germline DNA was genotyped as the case series of GELA's genome-wide association study of DLBCL, with controls drawn from the French component of EPIC.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001172> (<http://www.ebi.ac.uk/coho/COHO_0001172>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20697030") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22159054") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dss.niagads.org/cohorts/genetic-and-environmental-risk-factors-for-alzheimers-disease-among-african-americans-generaations/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001172> "A case-control study of Alzheimer's disease in community-dwelling African Americans aged 65 or older, led from Johns Hopkins University, whose participants were identified through the electronic claims database of the Henry Ford Health System in Detroit, Michigan, and had a proxy informant; cases met NINCDS-ADRDA criteria for possible or probable Alzheimer's disease at a consensus conference, and controls were cognitively normal.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001173> (<http://www.ebi.ac.uk/coho/COHO_0001173>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20039012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23781229") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25229211") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001173> "A population-based case-control study of breast cancer in women of the Greater Bonn region, Germany, run by the GENICA network of German research institutions, in which incident cases, enrolled from all hospitals of the region in 2000–2004 within six months of diagnosis, and controls drawn from the population registries of 31 communities of the region and matched in five-year age classes were interviewed and gave blood, to study how genes and environmental exposures interact in breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001174> (<http://www.ebi.ac.uk/coho/COHO_0001174>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20953188") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25903422") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40021644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001174> "A case-control sample of people with psoriasis, ascertained through dermatologists or other secondary-care specialists, and controls, all drawn from the Québec founder population (people whose four grandparents had French-Canadian family names and were born in Québec or neighbouring areas), assembled by Genizon BioSciences of Saint-Laurent, Québec, and genotyped genome-wide on the Illumina Human 1M BeadChip; it is one of the European-ancestry GWAS datasets of the international psoriasis genetics meta-analyses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001175> (<http://www.ebi.ac.uk/coho/COHO_0001175>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25757221") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29083406") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37794016") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001175> "A family-based genetic study of atopic dermatitis run from Charité Universitätsmedizin Berlin, which recruited complete nuclear families, mostly German and a few Swedish, through at least two children with physician-diagnosed, moderate to severe atopic dermatitis that began before the age of two, and in its extended phase also unrelated children with such early-onset disease, recording asthma and hay fever at recruitment, for genetic studies of atopic dermatitis and allergic disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001176> (<http://www.ebi.ac.uk/coho/COHO_0001176>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17634449") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18398472") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20923989") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26343387") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36474045") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001176> "A series of German case collections for genetic studies of myocardial infarction and coronary artery disease, numbered GerMIFS I to VII, that began as a family study recruiting, from all parts of Germany, people with myocardial infarction before the age of 60 and relatives with premature coronary artery disease. Later collections added patients with early-onset myocardial infarction, non-fatal myocardial infarction cases from the KORA registry of the Augsburg region, and patients with coronary artery disease or myocardial infarction referred for coronary angiography, mostly compared with population controls from other German studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001177> (<http://www.ebi.ac.uk/coho/COHO_0001177>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20870969") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25396097") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26625858") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001177> "A prospective population-based cohort of adults from the county of Västerbotten in northern Sweden, nested within the Northern Sweden Health and Disease Study, whose members had baseline health and lifestyle examinations in the Västerbotten Intervention Programme between 1985 and 2004, in the years of their 40th, 50th or 60th birthdays, with a repeat examination about ten years later. It was established in 2008 to study the genetics of cardiometabolic traits and interactions between genes and lifestyle.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001178> (<http://www.ebi.ac.uk/coho/COHO_0001178>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25757221") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26011739") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29664587") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001178> "A birth cohort of children born in 1990 and recruited in the maternity wards of university hospitals in five German cities (Berlin, Düsseldorf, Freiburg, Mainz and Munich), enriched for newborns at high risk of allergy, with two allergic immediate family members or raised cord-blood IgE, alongside a random sample of low-risk newborns, and followed with repeated examinations and questionnaires from infancy into adulthood to study the course of asthma, allergic rhinitis, eczema and allergic sensitisation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001179> (<http://www.ebi.ac.uk/coho/COHO_0001179>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16207846") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20681990") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21602797") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26417704") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001179> "A case-control study of genetic modifiers of cystic fibrosis lung disease, led by the University of North Carolina at Chapel Hill and Case Western Reserve University, that enrolled unrelated patients homozygous for F508del whose lung function for age was at either extreme (severe or mild disease) from cystic fibrosis centres across the United States, together with a smaller population-based sample from children's hospitals in Denver, Wisconsin and Boston.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001180> (<http://www.ebi.ac.uk/coho/COHO_0001180>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19738092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27062904") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30307979") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001180> "A two-stage case-control study of genetic modifiers of severe liver disease in cystic fibrosis, coordinated by the University of North Carolina at Chapel Hill, which from January 1999 enrolled people with cystic fibrosis and cirrhosis with portal hypertension from cystic fibrosis centres in the United States, Canada and other countries of Europe, Australia, South America and the Middle East, and compared them with people with cystic fibrosis aged 15 or over without liver disease, many of them from the Genetic Modifier Study of lung disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001181> (<http://www.ebi.ac.uk/coho/COHO_0001181>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16841623") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23091423") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35712048") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001181> "A pharmacogenetic sample of adult outpatients of white European ancestry with moderate to severe major depressive disorder who completed escitalopram treatment in two identically designed randomised, double-blind, placebo-controlled GlaxoSmithKline trials run in the United States in 2003–2004 to compare bupropion XL with escitalopram for antidepressant efficacy and effects on sexual functioning; GlaxoSmithKline contributed their DNA to the NEWMEDS consortium for genetic studies of antidepressant response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001182> (<http://www.ebi.ac.uk/coho/COHO_0001182>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16822851") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19107115") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fmp.2012.21/MediaObjects/41380_2013_BFmp201221_MOESM194_ESM.doc") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001182> "A case-control sample for recurrent major depressive disorder, collected with GlaxoSmithKline, of German patients with recurrent moderate or severe major depression recruited at the Max Planck Institute of Psychiatry in Munich and two satellite hospitals in the Munich area (BKH Augsburg and Klinikum Ingolstadt), and age- and sex-matched controls from a Munich community sample screened free of lifetime mood and anxiety disorders, genotyped genome-wide for studies of the genetics of depression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001183> (<http://www.ebi.ac.uk/coho/COHO_0001183>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23461817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24342383") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8956679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001183> "A longitudinal, population-based study of children from 11 predominantly rural counties of western North Carolina, United States, recruited in 1993 as three cohorts aged 9, 11 and 13 through a two-phase design that screened a random sample of children for behavioural problems and oversampled those with high scores, together with all age-eligible American Indian children of the area. The participants were interviewed annually to age 16 and then repeatedly into adulthood, to study the development of psychiatric and substance use disorders and the need for and use of mental health services.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001184> (<http://www.ebi.ac.uk/coho/COHO_0001184>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33060696") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35693796") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02391675") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001184> "A prospective cohort of patients aged 5 to 85 who presented with acute appendicitis at the emergency department of Jessa Hospital in Hasselt, Belgium, and had an appendectomy, recruited from June 2012 to October 2016 in a study led by Hasselt University with Jessa Hospital and Radboud University Medical Center. Questionnaires on diet, lifestyle and environment were collected together with blood, appendix tissue and stool samples, to study how environmental factors, the innate immune system and its genetic make-up, and the gut microbiota influence the development and severity of acute appendicitis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001185> (<http://www.ebi.ac.uk/coho/COHO_0001185>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32139696") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001185> "The breast cancer arm of the Hwasun Cancer Epidemiology Study, a hospital-based case-control study at Chonnam National University Hwasun Hospital, a cancer hospital in Jeollanam-do province, South Korea, that aims to identify factors in cancer development and clinical progression in a Korean population. Its cases are women newly diagnosed with breast cancer at the hospital from April 2004 to February 2013, excluding secondary or recurrent tumours, and its controls are women with no previous cancer drawn at random from the Namwon Study and the Dong-gu Study, community-based cohorts in South Korea.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001186> (<http://www.ebi.ac.uk/coho/COHO_0001186>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22587629") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23022702") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26372449") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001186> "A cross-sectional population-based study of the Research Centre for Prevention and Health in Glostrup, Denmark, conducted in 2008–2009 on a random sample of men and women aged 30–60, drawn from the Danish Central Personal Register, living in the western part of the Copenhagen area; pregnant women and people with known diabetes, cardiovascular disease, chronic obstructive pulmonary disease, hypertension or a history of blood clots, or unable to do physical activities such as climbing stairs, were excluded. The examination included questionnaires, clinical and biochemical measurements, an oral glucose tolerance test and two tests estimating maximal oxygen uptake.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001187> (<http://www.ebi.ac.uk/coho/COHO_0001187>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26372449") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40490135") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001187> "A population-based study of the Research Centre for Prevention and Health in Glostrup, Denmark, begun in 2010, which examined a random sample of adults aged 18–69, drawn from the Danish Central Personal Register, living in the western part of the Capital Region of Denmark, with questionnaires, a clinical examination and blood samples, focusing on cardiovascular disease, diabetes, asthma and allergy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001188> (<http://www.ebi.ac.uk/coho/COHO_0001188>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32722720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40171472") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001188> "A prospective register of patients with diabetes, with a biobank, established in 1995 by the Chinese University of Hong Kong at its teaching hospital, the Prince of Wales Hospital, as a research-driven quality-improvement programme. Patients referred by hospital specialty clinics, community clinics and general practitioners to the hospital's Diabetes Mellitus and Endocrine Centre were enrolled consecutively for a structured assessment of complications and metabolic control and then followed until death, to study the risk factors, complications and outcomes of diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001189> (<http://www.ebi.ac.uk/coho/COHO_0001189>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37131148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38517939") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001189> "A pan-Canadian databank set up in 2020 by CGEn, Canada's national platform for genome sequencing and analysis, within Genome Canada's Canadian COVID-19 Genomics Network, that brings together independent clinical and epidemiological studies enrolling people of any age infected with SARS-CoV-2 across Canada. Each partner study contributes blood (rarely saliva) samples for whole-genome sequencing at the CGEn centres and clinical information on a standard case report form, creating a resource for research on host genetic factors in SARS-CoV-2 infection and COVID-19 outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001190> (<http://www.ebi.ac.uk/coho/COHO_0001190>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19435955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19708904") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21429197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33203694") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001190> "A multinational longitudinal cohort of children and adolescents under 16 with newly diagnosed type 1 diabetes, recruited from August 1999 to December 2000 at 18 paediatric departments in 15 countries of Europe and Japan by the Hvidoere Study Group on Childhood Diabetes, an international group of paediatric diabetes centres, and followed through the first 12 months after diagnosis with meal-stimulated C-peptide tests, HbA1c, insulin doses, islet autoantibodies and HLA typing, to study residual beta-cell function and the partial remission period.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001191> (<http://www.ebi.ac.uk/coho/COHO_0001191>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35578897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001191> "The second survey of the HUNT Study, conducted in 1995–97, to which all residents of Nord-Trøndelag, Norway, aged 20 or over were invited for questionnaires, interviews, a clinical examination and biological sampling. Its participants have consented to linkage with Norwegian health and administrative registries, and many of them have been genotyped.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001192> (<http://www.ebi.ac.uk/coho/COHO_0001192>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25682233") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30898062") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35861817") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001192> "A population-based sleep cohort nested in the CoLaus/PsyCoLaus study of Lausanne, Switzerland: consecutive participants of CoLaus/PsyCoLaus's first follow-up (2009–12), who also answered sleep questionnaires and had clinical and biological phenotyping, were invited from September 2009 to June 2013 to a full polysomnography at home, organised from the sleep centre of Lausanne University Hospital, to study the prevalence and determinants of sleep disorders such as sleep-disordered breathing and their links with cardiometabolic and mental health. Participants were re-examined at the cohort's second follow-up in 2014–17.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001193> (<http://www.ebi.ac.uk/coho/COHO_0001193>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33932643") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38555957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01648816") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001193> "A French prospective multicentre cohort, sponsored by Assistance Publique – Hôpitaux de Paris, of women of European ancestry aged over 18 who gave birth in eight maternity departments of the Paris metropolitan area and were included two to five days after delivery between November 2011 and June 2016. The women gave a blood sample for DNA and were assessed for depression by trained clinicians with DSM-5 criteria at inclusion, at 8 weeks and at 1 year postpartum, to study how genetic factors and maternal stressors interact in the risk of postpartum depression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001194> (<http://www.ebi.ac.uk/coho/COHO_0001194>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38783053") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40962958") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41554769") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001194> "A school-based cohort of children and adolescents aged 5–17 from primary and secondary general-education schools across Catalonia, Spain, set up to study neurodevelopmental disorders, school performance and their genetic and environmental factors. Since the 2011–2012 school year, parents and teachers complete screening questionnaires for mental health problems and learning difficulties, children who screen positive are assessed by psychiatrists and neuropsychologists for DSM diagnoses, academic marks are taken from school records, and DNA is collected from saliva or buccal swabs.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001195> (<http://www.ebi.ac.uk/coho/COHO_0001195>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31722307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41350806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001195> "A multicentre patient registry established in Japan in 2006 to register and follow up patients with amyotrophic lateral sclerosis across many participating institutions, collecting DNA samples and clinical data with periodic telephone follow-up to study the natural history, genetic background and prognosis of ALS.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001196> (<http://www.ebi.ac.uk/coho/COHO_0001196>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001196> "A nested case-control genome-wide association study of prostate cancer in Japanese American men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Japanese component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Japanese men.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001197> (<http://www.ebi.ac.uk/coho/COHO_0001197>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33129280") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001197> "A multisite, population-based prospective cohort study of dementia, coordinated from Kyushu University. Community-dwelling residents aged 65 years or older at eight research sites across Japan (Hirosaki, Yahaba, Nakajima, Arakawa, Ama, Nakayama, Hisayama and Arao) were examined in 2016–2018 under a common standardized protocol, including questionnaires, cognitive assessment, blood tests, brain MRI and DNA samples, and are followed up for incident dementia, to study environmental and genetic risk factors for dementia and their interaction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001198> (<http://www.ebi.ac.uk/coho/COHO_0001198>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26184046") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001198> "A nationwide Korean survey population of all ages, set up in 2010 by the National Institute of Food and Drug Safety Evaluation as the first integrated assessment of dietary exposure to hazardous substances from food, herbal medicine and functional food. Adults were drawn by region-, sex- and age-stratified probability sampling from 102 town and township clusters in 15 metropolitan areas and provinces, and children, adolescents and mothers were recruited through schools, kindergartens, health centres and hospitals. All were surveyed in 2010–2011 with food frequency and 24-hour recall questionnaires, blood and urine biomonitoring, and health examinations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001199> (<http://www.ebi.ac.uk/coho/COHO_0001199>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22923026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31226226") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000306.v4.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001199> "A nested case-control genome-wide association study of prostate cancer in Latino men of the Multiethnic Cohort Study in Hawaii and California. Incident cases found by linkage to the SEER cancer registries, and controls matched on ethnicity, area of residence and age, were genotyped on the Illumina Human660W array at the Broad Institute as the Latino component of the Multiethnic Genome-wide Scan of Prostate Cancer (GENEVA), to search for prostate cancer risk variants in Latinos.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001200> (<http://www.ebi.ac.uk/coho/COHO_0001200>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26584951") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35164821") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38644623") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001200> "A randomised, double-blind, placebo-controlled delayed-start trial of patients aged 30 or over whose Parkinson's disease had been diagnosed within the previous two years and did not yet need medication. They were recruited between August 2011 and May 2016 through academic and community hospitals across the Netherlands, with the Academic Medical Center in Amsterdam as the coordinating centre. Patients received levodopa/carbidopa for 80 weeks, or placebo for 40 weeks followed by levodopa/carbidopa for 40 weeks, with follow-up visits at 3 and 5 years, to test whether starting levodopa early modifies the course of the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001201> (<http://www.ebi.ac.uk/coho/COHO_0001201>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30420802") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38174101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001201> "A nation-wide, monocentric, observational, longitudinal-prospective cohort of people with Parkinson's disease or atypical parkinsonism at any disease stage, and of control subjects without a neurodegenerative disorder, recruited since 2015 in Luxembourg and the surrounding Greater Region of Germany, France and Belgium within the National Centre of Excellence in Research on Parkinson's Disease (NCER-PD). Patients are followed up annually with deep clinical phenotyping and biosampling, to find markers for early diagnosis and progression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001202> (<http://www.ebi.ac.uk/coho/COHO_0001202>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biolincc.nhlbi.nih.gov/studies/ltrc/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001662.v4.p2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001202> "A biobank cohort set up by the US National Heart, Lung, and Blood Institute (NHLBI) in 2004 that, from 2005 to 2019, enrolled adults undergoing clinically indicated thoracic surgery (resection of lung nodules or masses, diagnostic biopsy for interstitial lung disease, lung volume reduction surgery or lung transplantation) at Mayo Clinic, Temple University and the Universities of Colorado, Michigan and Pittsburgh, and banked their excess lung tissue and blood together with questionnaire, lung function and chest CT data. Participants with and without lung disease were included, to support research on the pathobiology of chronic obstructive pulmonary disease, interstitial lung diseases such as idiopathic pulmonary fibrosis, and related lung diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001203> (<http://www.ebi.ac.uk/coho/COHO_0001203>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18506692") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31694687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37964298") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001203> "A population-based case-control study of postmenopausal breast cancer in two regions of Germany, Hamburg and Rhine-Neckar-Karlsruhe, which from 2002 to 2005 enrolled women aged 50–74 with incident invasive or in situ breast cancer and population controls frequency-matched to them, interviewed face to face to investigate risk factors, notably menopausal hormone therapy. Its cases were re-interviewed in 2009 and followed for survival and recurrence until 2015 as the MARIE patient cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001204> (<http://www.ebi.ac.uk/coho/COHO_0001204>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18259084") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40830522") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41001249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42690834") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001204> "A prospective population-based cohort of residents of Olmsted County, Minnesota, United States, randomly sampled with age and sex stratification from the population enumerated by the Rochester Epidemiology Project medical records-linkage system: people aged 70–89 from 2004, extended in 2012 to ages 50–69 and later to younger adults. Participants have in-person clinical, neurological and neuropsychological evaluations with a consensus diagnosis of normal cognition, mild cognitive impairment or dementia, repeated about every 15 months together with neuroimaging and biomarkers, to study the prevalence, incidence, risk factors and biomarkers of mild cognitive impairment and dementia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001205> (<http://www.ebi.ac.uk/coho/COHO_0001205>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001205> "A hospital-based case-control study designed for biomarker and genetic studies of coronary artery disease, which from August 2004 to March 2007 recruited patients with and without angiographic coronary artery disease undergoing cardiac catheterisation at the Washington Hospital Center, Washington, DC, United States, with support from the MedStar Research Institute.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001206> (<http://www.ebi.ac.uk/coho/COHO_0001206>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31663602") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37675201") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40102189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001206> "A prospective population-based cohort of Swedish-born women aged 25–64 without a history of cancer, randomly selected from the population registry of the southern Swedish healthcare region and recruited in 1990–1992, who answered a baseline questionnaire on sun exposure habits, constitutional characteristics and other risk factors for melanoma and follow-up questionnaires every ten years, with cancer incidence and mortality followed through Swedish national registers. It was set up to study risk factors for melanoma and is also used to study the health effects of sun exposure.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001207> (<http://www.ebi.ac.uk/coho/COHO_0001207>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23101567") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31466551") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001207> "A twin registry at Michigan State University, begun as a university-based registry of undergraduate twins and since 2004 recruiting twins identified from birth records by the Michigan Department of Health and Human Services. Its population-based mail-in registry enrols child and adolescent twins aged 3–17 with their families and adult twins aged 18–55 living in lower Michigan, United States, and in-depth in-person twin family studies are drawn from it, to examine developmental differences in genetic, environmental, neural and neurobiological influences on psychopathology and resilience, particularly in childhood and adolescence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001208> (<http://www.ebi.ac.uk/coho/COHO_0001208>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19774750") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25519422") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40889875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001208> "A birth cohort of women recruited at their first antenatal clinic visit at the Mater Hospital in Brisbane, Australia, in 1981–1983, and of their live singleton children, followed up after the birth, at 6 months and at 5, 14 and 21 years, and in adulthood (mothers at 27 years, children at 30 years) with later record linkage. Begun as a study of pregnancy and its outcomes, it has become a longitudinal study of growth, development and ageing that emphasises the transmission across generations of factors affecting adult health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001209> (<http://www.ebi.ac.uk/coho/COHO_0001209>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26362759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29884237") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36580032") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001209> "An international consortium of myositis research centres through which DNA samples with clinical and autoantibody data from patients of European ancestry with idiopathic inflammatory myopathies (adult and juvenile polymyositis and dermatomyositis, and inclusion body myositis) were collected at participating centres in Europe, the United States and Australia, including national collections such as the UK Adult Onset Myositis Immunogenetic Collaboration, for genome-wide and Immunochip association studies of myositis and its clinical and serological subgroups, analysed against controls supplied by other disease consortia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001210> (<http://www.ebi.ac.uk/coho/COHO_0001210>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27492244") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33479248") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36968228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001210> "A population-based study of breast cancer among women aged 20–74 in central and eastern North Carolina, United States, run from the University of North Carolina, which identifies newly diagnosed cases through rapid case ascertainment with the North Carolina Central Cancer Registry and oversamples Black and younger women. Phases I (1993–1996) and II (1996–2001) in 24 counties were a case-control study with controls drawn from Department of Motor Vehicles and Medicare enrolment records; phase III (2008–2013) enrolled invasive cases in 44 counties and followed them for recurrence, to study the biology, risk factors and outcomes of breast cancer and their differences by race and age.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001211> (<http://www.ebi.ac.uk/coho/COHO_0001211>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11219769") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19706757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8320745") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001211> "A hospital-based case-control study of bladder cancer in North Carolina, United States, which enrolled patients with transitional cell carcinoma of the bladder and control patients without cancer (mainly presenting with benign prostatic hypertrophy or impotence), frequency-matched on race, sex and age, at the urology clinics of Duke University Medical Center and the University of North Carolina Hospitals, to study inherited variation in carcinogen-metabolism and DNA-repair genes, smoking and bladder cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001212> (<http://www.ebi.ac.uk/coho/COHO_0001212>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29784730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35468990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001212> "A case-control study of prostate cancer of the US National Cancer Institute in the Baltimore area of Maryland, which from 2005 to 2015 enrolled African American and European American men diagnosed with prostate cancer at the Baltimore Veterans Affairs Medical Center and the University of Maryland Medical Center, and population controls identified through the Maryland motor vehicle administration and frequency-matched to cases on age and race. Participants were interviewed about their demographics, lifestyle and medical and family history and gave blood or mouthwash samples, to study environmental and genetic factors in prostate cancer among African American men.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001213> (<http://www.ebi.ac.uk/coho/COHO_0001213>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34999878") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001213> "A prospective birth cohort of the University of Oulu comprising the children of all mothers in the two northernmost provinces of Finland, Oulu and Lapland, whose expected date of delivery fell in 1966, recruited during pregnancy at the region's antenatal clinics from 1965. Set up to study the risk factors for and consequences of preterm birth and intrauterine growth retardation, it has followed its members with questionnaires at 1, 14, 31 and 46 years of age, clinical examinations in adulthood and linked national registers to study the life-course origins of health and disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001214> (<http://www.ebi.ac.uk/coho/COHO_0001214>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35224031") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38282387") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7960367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001214> "A randomized, double-blind primary prevention trial of the Cancer Institute of the Chinese Academy of Medical Sciences and the US National Cancer Institute in Linxian, Henan province, China, a rural county with some of the world's highest rates of oesophageal and gastric cardia cancer, which in 1985 enrolled healthy adults aged 40–69 from four communes in northern Linxian and gave them daily combinations of vitamins and minerals or placebo in a fractional factorial design from March 1986 to May 1991. Its participants have since been followed as a prospective cohort for cancer incidence and cause-specific mortality.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001215> (<http://www.ebi.ac.uk/coho/COHO_0001215>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38365752") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001215> "A cohort of individuals evaluated for cognitive decline at Ace Alzheimer Center Barcelona (Fundació ACE), Spain, recruited from its Memory Clinic, Open House Initiative, the FACEHBI study and the BIOFACE project. Founded in 2014, it studies retinal biomarkers via optical coherence tomography and their relationship to neurodegenerative disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001216> (<http://www.ebi.ac.uk/coho/COHO_0001216>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15136663") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001216> "A prospective cohort and biorepository of racially and ethnically diverse adults aged 30 or older living in the New York tri-state area, enrolled from January 2000 to December 2002 by the Academic Medical Development Company (AMDeC) Foundation, a consortium of New York institutions, at medical centres, community hospitals and community health centres in all five boroughs of New York City and at New York Blood Center donor drives. Participants completed a baseline questionnaire and gave blood for DNA and plasma, to be followed by questionnaires and registry linkage for studies of cancer aetiology and of racial and ethnic disparities in cancer risk, prevention and outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001217> (<http://www.ebi.ac.uk/coho/COHO_0001217>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33432348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37903429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39987337") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001217> "A population-based biobank study established in 2016 in Okinawa Prefecture, Japan, through the Okinawa Bioinformation Bank Project promoted by the University of the Ryukyus and Okinawa Prefecture, whose participants, recruited on Okinawa's islands including the Miyako Islands, give blood or saliva for DNA and genome-wide genotyping together with health check-up results, lifestyle questionnaires and, for some, the birthplaces of their four grandparents. It aims to clarify the population history of the Ryukyu islanders and to find genetic factors in common and rare diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001218> (<http://www.ebi.ac.uk/coho/COHO_0001218>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25086665") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dceg.cancer.gov/research/cancer-types/pancreas/panscan") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000206.v5.p3") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001218> "A consortium formed in 2006 within the US National Cancer Institute's Cohort Consortium by investigators of 12 prospective cohort studies to run PanScan, a multi-stage genome-wide association study of pancreatic cancer funded by the NCI. PanScan I genotyped cases and controls from the cohorts and one case-control study, PanScan II (from 2007) those of eight case-control studies, and PanScan III new incident cases from 14 cohorts and from case series and case-control studies, mostly people of European ancestry from the United States and Europe.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001219> (<http://www.ebi.ac.uk/coho/COHO_0001219>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25939597") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28139693") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30287866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001219> "A genome-wide association study of prostate cancer run by the Division of Cancer Epidemiology and Genetics of the US National Cancer Institute as a nested case-control study within the Prostate, Lung, Colorectal, and Ovarian (PLCO) Cancer Screening Trial, in which men of European ancestry with pathologically confirmed prostate cancer detected during screening or reported during the trial, and men of the trial without prostate cancer matched to them on age and year of randomization, were genotyped genome-wide to find prostate cancer susceptibility loci, including loci for aggressive disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001220> (<http://www.ebi.ac.uk/coho/COHO_0001220>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19287092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21239051") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26343929") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001220> "A hospital-based study of genes and biomarkers for coronary artery disease at the University of Pennsylvania Medical Center, United States, which from July 1998 to March 2003 recruited consecutive patients undergoing cardiac catheterisation and coronary angiography. A nested case-control genome-wide association study of angiographic coronary artery disease in its white patients is one of the core studies of the CARDIoGRAM consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001221> (<http://www.ebi.ac.uk/coho/COHO_0001221>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25937488") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35998220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001221> "A multi-site cross-sectional study of typically developing children, adolescents and young adults aged 3 to 20 years, recruited through local postings and outreach in eight metropolitan areas of the United States and assessed at ten US sites, with its coordinating centre at the University of California, San Diego, that collected developmental histories, cognitive assessments, multimodal brain imaging and genome-wide genotypes to create a shared repository for studying brain and cognitive development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001222> (<http://www.ebi.ac.uk/coho/COHO_0001222>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24943594") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28725034") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38366028") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001222> "A Swedish breast cancer case-control study, known as prevalent KARMA, that combines women diagnosed with primary breast cancer in Stockholm between 2001 and 2008, identified through the regional cancer register for the LIBRO-1 study, with breast-cancer-free women from the Karolinska Mammography Project for Risk Prediction of Breast Cancer (KARMA) cohort as controls, all of whom gave blood samples, and whose genotypes contribute to the Breast Cancer Association Consortium's studies of breast cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001223> (<http://www.ebi.ac.uk/coho/COHO_0001223>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17881719") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18413464") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27717005") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001223> "A randomized, double-blind, placebo-controlled trial run by the Parkinson Study Group, which enrolled people with early Parkinson's disease not yet requiring dopaminergic therapy at 65 sites in the United States and Canada between April 2002 and April 2004 to test whether the mixed lineage kinase inhibitor CEP-1347 could slow disease progression; the trial was stopped early for futility in 2005, and its participants were then followed in the observational PostCEPT study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001224> (<http://www.ebi.ac.uk/coho/COHO_0001224>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33483693") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36069021") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001224> "A Swedish study that between 2013 and 2017 recruited adults who had received electroconvulsive therapy (ECT) recorded in the Swedish National Quality Register for ECT, inviting registered patients by letter to a telephone interview and blood sampling and recruiting others at Swedish psychiatric hospitals before an ECT series, and that links their DNA, stored at the Karolinska Institutet Biobank, to the register's data on each treatment series, to study predictors of ECT outcome, including genetic ones, and the genetics of severe depressive episodes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001225> (<http://www.ebi.ac.uk/coho/COHO_0001225>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25711607") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35420468") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38524222") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001225> "A birth cohort of children enrolled with their mothers within seven days of birth in low-income wards of Mirpur, Dhaka, Bangladesh, from May 2011, into a randomized controlled trial with a two-by-two factorial design, conducted by the International Centre for Diarrhoeal Disease Research, Bangladesh (icddr,b) with the University of Vermont and the University of Virginia, that tested a delayed-dose oral rotavirus vaccine and the replacement of one oral polio vaccine dose by an injectable polio vaccine, and followed the children through their first two years of life to study why oral vaccines underperform in children living with poverty, poor sanitation and overcrowding.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001226> (<http://www.ebi.ac.uk/coho/COHO_0001226>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26242864") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32546850") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.qimrb.edu.au/studies/queensland-twin-registry-(qtwin)-study") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001226> "A population-based registry of identical and non-identical twins and triplets of all ages living in Australia, established in 2006 at the QIMR Berghofer Medical Research Institute in Brisbane, whose members are invited into twin research projects on health and disease; genetic studies drawing on QIMR Berghofer's genotyped twin and family samples report them under the registry's name.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001227> (<http://www.ebi.ac.uk/coho/COHO_0001227>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37212603") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37952397") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38958117") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001227> "A multi-site US study of African Americans, a sub-study of the Alzheimer's Disease Sequencing Project run by investigators at North Carolina Agricultural and Technical State University, Wake Forest School of Medicine, the University of Miami, Columbia University and Case Western Reserve University, that ascertains African American families affected by Alzheimer's disease through community outreach and collects blood or saliva samples, medical and family histories and cognitive assessments, to identify rare variants, genes and pathways associated with Alzheimer's disease in African Americans.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001228> (<http://www.ebi.ac.uk/coho/COHO_0001228>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24861484") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42225636") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00836524") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001228> "A prospective cohort of unselected pregnant women enrolled from 2009 at the nuchal translucency scan in the obstetrics and gynaecology department of Roskilde Hospital, Region Zealand, Denmark, with ultrasound, uterine artery Doppler and blood samples at about 12, 20, 25 and 32 weeks of gestation and outcomes taken from medical records, set up to study whether serum YKL-40 predicts preeclampsia and fetal growth restriction, and later used in genetic studies of gestational diabetes and glucose levels in pregnancy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001229> (<http://www.ebi.ac.uk/coho/COHO_0001229>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32139696") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35395775") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000799.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001229> "A breast cancer case-control genetics study, led from Vanderbilt University, that genotyped Chinese women with breast cancer and controls drawn from four population-based studies in urban Shanghai, China: the Shanghai Breast Cancer Study, the Shanghai Breast Cancer Survival Study, the Shanghai Women's Health Study and, for controls only, the Shanghai Endometrial Cancer Study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001230> (<http://www.ebi.ac.uk/coho/COHO_0001230>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15687363") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21037568") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25294155") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001230> "A population-based case-control study of the causes of malignant lymphomas (non-Hodgkin lymphoma, including chronic lymphocytic leukaemia, and Hodgkin lymphoma) among residents of Denmark and Sweden aged 18–74, recruited in 1999–2002, with incident cases identified shortly after diagnosis through a rapid case-ascertainment network and controls sampled from the national population registers, and with a telephone interview and blood sampling.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001231> (<http://www.ebi.ac.uk/coho/COHO_0001231>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35708486") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39361370") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001231> "A cohort of COVID-19 patients with detailed clinical information, recruited from hospitals across Spain from March to December 2020 and in Latin America from March 2020 to July 2021 by a Spanish research consortium launched in May 2020 to study host genetic factors in COVID-19 and find biomarkers of its course and prognosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001232> (<http://www.ebi.ac.uk/coho/COHO_0001232>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23160641") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1007%2Fs00125-012-2756-1/MediaObjects/125_2012_2756_MOESM2_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001232> "A sample of patients with clinical-onset type 2 diabetes and of non-diabetic control individuals (screened by oral glucose tolerance test) ascertained at the outpatient clinic of Steno Diabetes Center in Copenhagen, Denmark, used in genetic association studies of type 2 diabetes and metabolic traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001233> (<http://www.ebi.ac.uk/coho/COHO_0001233>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28338705") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42274395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001233> "A cohort of adults aged 16 or older with a clinical diagnosis of type 1 diabetes, latent autoimmune diabetes of adulthood or monogenic diabetes, recruited mainly at diabetes outpatient clinics across Scotland between December 2010 and November 2013, whose biosamples were banked and genotyped and who are followed through linkage to national electronic health records, set up to study the genetic determinants, biomarkers and complications of type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001234> (<http://www.ebi.ac.uk/coho/COHO_0001234>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20729852") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21846596") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28680059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001234> "A case-control study of upper gastrointestinal cancers conducted from 1997 to 2007 by the Shanxi Cancer Hospital and Institute under contract with the US National Cancer Institute in Shanxi Province, China, in the high-risk western Taihang Mountain area, which enrolled adults newly diagnosed with oesophageal squamous cell carcinoma or gastric adenocarcinoma and treated surgically at the Shanxi Cancer Hospital, with neighbourhood controls matched on age and sex, plus a case-only component, and collected questionnaire data and blood to study genetic and environmental risk factors for these cancers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001235> (<http://www.ebi.ac.uk/coho/COHO_0001235>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.shcs.ch/about-shcs/study-design/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001235> "A nationwide prospective longitudinal cohort of people with HIV aged 16 or older in Switzerland, established in 1988 as a collaboration of the Swiss university hospitals, large cantonal hospitals, affiliated smaller hospitals and private physicians, who recruit and follow the participants, to improve the health of people with HIV through clinical, translational and basic research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001236> (<http://www.ebi.ac.uk/coho/COHO_0001236>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28465840") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37402774") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37619450") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001236> "A prospective multicentre cohort of community-dwelling women aged 65 or older in the United States, whose original, white members were recruited from population-based listings in four areas (Baltimore, Maryland; Minneapolis, Minnesota; Portland, Oregon; and the Monongahela Valley, Pennsylvania) between September 1986 and October 1988 and were joined by African American women enrolled at the Year 10 examination in 1997–1998, followed by regular contacts and repeat examinations to study risk factors for osteoporotic fractures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001237> (<http://www.ebi.ac.uk/coho/COHO_0001237>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35580588") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38446452") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40425723") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41624966") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001237> "A cohort of the Swedish Twin Registry made up of twins born in Sweden between 1959 and 1985, who were invited to a web-based health screening survey in 2005–2006 and have since been followed through linkage to national health registers and further web surveys.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001238> (<http://www.ebi.ac.uk/coho/COHO_0001238>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15061154") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27519822") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00021528") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001238> "A multisite, prospective, randomised, multistep clinical trial, funded by the US National Institute of Mental Health through the University of Texas Southwestern Medical Center at Dallas, that from 2001 enrolled adult outpatients aged 18 to 75 with nonpsychotic major depressive disorder from primary and specialty (psychiatric) care practices across the United States, to determine which treatments work best for those who do not respond adequately to initial treatment with citalopram.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001239> (<http://www.ebi.ac.uk/coho/COHO_0001239>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28983737") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34127860") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001239> "A Finnish collection of people with type 1 diabetes, made up of cases only (without family members or controls), that has contributed independent cases to international ImmunoChip genetic studies of type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001240> (<http://www.ebi.ac.uk/coho/COHO_0001240>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17539366") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28638965") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29845340") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37289452") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ki.se/en/meb/twin-study-of-child-and-adolescent-development-tchad") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001240> "A population-based longitudinal study, run from Karolinska Institutet, of all twins born in Sweden between May 1985 and December 1986, identified through the Swedish Twin Registry, in which the twins and their parents completed questionnaires in four waves from 1994 to 2005, when the twins were aged 8–9, 13–14, 16–17 and 19–20, with a further follow-up at age 26, to study how genes and environments contribute to the development of health and behavioural problems from childhood to adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001241> (<http://www.ebi.ac.uk/coho/COHO_0001241>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35301180") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36939699") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02119182") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001241> "A prospective, multicentre, longitudinal observational cohort study, led from the University of California, San Francisco, with funding from the US National Institute of Neurological Disorders and Stroke, that from February 2014 to July 2018 enrolled patients presenting within 24 hours of a traumatic brain injury who received a clinically indicated head CT scan, together with orthopaedic trauma controls, at 18 level I trauma centres in the United States, and collected clinical, neuroimaging, blood biomarker, genetic and outcome data to improve the characterisation, diagnosis and prognosis of traumatic brain injury.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001242> (<http://www.ebi.ac.uk/coho/COHO_0001242>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40272284") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001242> "A cohort of people with or at risk of type 1 diabetes recruited since 2001 by Type 1 Diabetes TrialNet, an international network of clinical research centres established by the US National Institute of Diabetes and Digestive and Kidney Diseases: chiefly relatives of people with type 1 diabetes who are screened for islet autoantibodies and followed for progression in its Pathway to Prevention natural-history study, and people at risk of or newly diagnosed with type 1 diabetes enrolled in its trials aimed at delaying or preventing the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001243> (<http://www.ebi.ac.uk/coho/COHO_0001243>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10667470") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10882857") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21194473") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22267197") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001243> "A population-based breast cancer case-control study run from the University of California, Irvine, whose cases were breast cancer patients diagnosed in Orange County, California, in the year from March 1994, ascertained through the population-based Cancer Surveillance Program of Orange County and enrolled as probands in the UCI population-based breast and ovarian cancer family registry, and whose controls were Orange County residents recruited in 1998–2003 by random digit dialling and frequency-matched to cases by age and race/ethnicity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001244> (<http://www.ebi.ac.uk/coho/COHO_0001244>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29992993") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://dceg.cancer.gov/research/who-we-study/cohorts/us-radiologic-technologists") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001244> "A cohort of current and former radiologic technologists in the United States, women and men certified by the American Registry of Radiologic Technologists for at least two years between 1926 and 1982, assembled in 1982 by the US National Cancer Institute with the University of Minnesota and the Registry and followed through four mailed questionnaires (1983–1989, 1994–1998, 2003–2005 and 2012–2014), to assess risks of cancer and other diseases from protracted low-dose occupational and personal medical ionising radiation and other exposures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001245> (<http://www.ebi.ac.uk/coho/COHO_0001245>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28880943") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02404415") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000997.v6.p3") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001245> "A prospective clinical and genetic biorepository at Vanderbilt University Medical Center in Nashville, Tennessee, founded in 2011, that enrols adults scheduled for catheter ablation of atrial fibrillation, recording their medical history, pre-ablation imaging and procedure details, collecting blood for DNA at the time of ablation and following them for arrhythmia recurrence at 3, 6 and 12 months, to identify predictors of response to ablation and to support research on the mechanisms of atrial fibrillation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001246> (<http://www.ebi.ac.uk/coho/COHO_0001246>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23110957") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31933447") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39036434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001246> "A longitudinal behavioural genetic study of cognitive and brain aging in men, and later of early risk of mild cognitive impairment and Alzheimer's disease, whose participants are twins randomly selected from the Vietnam Era Twin Registry of male twin pairs who both served in the US military between 1965 and 1975, recruited in their 50s and assessed at two sites, San Diego and Boston, from 2003, with follow-up waves every 5 to 6 years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001247> (<http://www.ebi.ac.uk/coho/COHO_0001247>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26708676") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001247> "A case-control collection from Barcelona, Spain, of European-ancestry patients with non-lacunar ischaemic stroke confirmed by neuroimaging within 7 days, a subset of those enrolled in the Genetic contribution to functional Outcome and Disability after Stroke (GODS) project, and of controls over 40 years old without ischaemic stroke, collected in Barcelona primary care centres and Spanish network hospitals for the ISSYS and GRECOS studies, genotyped together and used as a case-control set in ischaemic stroke genome-wide association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001248> (<http://www.ebi.ac.uk/coho/COHO_0001248>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23461817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9294370") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9413795") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001248> "A population-based, cohort-sequential longitudinal study of European-ancestry twin pairs born in 1974-1983, ascertained at ages 8 to 16 through the state and participating private schools of Virginia, United States, who with their parents were assessed by psychiatric interviews and questionnaires in four waves about 18 months apart and again in their mid-20s, to study genetic and environmental influences on the development of child and adolescent psychopathology and substance use.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001249> (<http://www.ebi.ac.uk/coho/COHO_0001249>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30271950") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001032.v7.p2") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001249> "A clinical and genetic registry at Vanderbilt University Medical Center in Nashville, Tennessee, United States, founded in 2001, that prospectively enrols patients with atrial fibrillation together with affected and unaffected family members, recording a detailed medical and drug history, an atrial fibrillation symptom severity assessment and a blood sample for DNA, and follows them with serial symptom assessments; its early-onset cases were whole-genome sequenced by the NHLBI TOPMed programme.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001250> (<http://www.ebi.ac.uk/coho/COHO_0001250>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28442769") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34457340") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39359028") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42009823") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001250> "A research cohort of customers of WeGene, a direct-to-consumer genetic testing company based in Shenzhen, China, who were genotyped from saliva on microarrays through the WeGene Personal Genome Services and consented to take part in research online, answering surveys posted on WeGene's online platform, website and WeChat channels.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001251> (<http://www.ebi.ac.uk/coho/COHO_0001251>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19743755") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35670608") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001251> "A population-based longitudinal cohort study of the University of Wisconsin-Madison in which Wisconsin state employees aged 30 to 60, sampled from state payroll files, answered a mailed sleep and health survey in 1988, after which all respondents at high risk of sleep-disordered breathing by self-reported snoring, with an age- and sex-matched random sample of the others, were invited to overnight in-laboratory polysomnography repeated at about 4-year intervals, to study the natural history and health consequences of sleep-disordered breathing and other sleep disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001252> (<http://www.ebi.ac.uk/coho/COHO_0001252>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33139633") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001252> "A community-based, multi-ethnic, cross-sectional genetic epidemiologic study of early childhood oral health, run by the University of North Carolina at Chapel Hill, that enrolled children aged 3 to 5 attending public preschools (Head Start programmes) across North Carolina, United States, from August 2016 to February 2019, examining their teeth in the preschools and collecting guardian questionnaires, saliva for genotyping and dental plaque, to study the genomics of early childhood caries.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001253> (<http://www.ebi.ac.uk/coho/COHO_0001253>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16512801") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33986744") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36356926") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S009167492600093X-mmc3.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001253> "A prospective birth cohort, begun in 2002 within an EU-funded project, of children from rural areas of Austria, Finland, France, Germany and Switzerland whose mothers were invited during the third trimester of pregnancy in 2002-2005, children of mothers living on family-run livestock farms forming the farm group and children of mothers from the same rural areas not living on a farm the reference group, followed from birth into school age with questionnaires, biological samples and clinical measurements to evaluate risk and protective factors, particularly farm exposures, for asthma and allergic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001254> (<http://www.ebi.ac.uk/coho/COHO_0001254>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24639442") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37012456") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001254> "A prospective pre-birth cohort, run from Harvard Medical School and the Harvard Pilgrim Health Care Institute, of women recruited in early pregnancy at eight obstetric offices of Atrius Harvard Vanguard Medical Associates, a multi-specialty group practice in eastern Massachusetts, United States, from April 1999 to November 2002, and their children, followed with in-person visits during pregnancy, at delivery, in infancy, early and mid-childhood and early adolescence and with annual mailed questionnaires, to examine prenatal diet and other early-life factors in relation to maternal and child health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001255> (<http://www.ebi.ac.uk/coho/COHO_0001255>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33238908") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001255> "A population-based cohort of community-dwelling adults aged 70 or over without dementia but with a subjective cognitive complaint. They were recruited door to door from 2017 in three districts of Santiago, Chile (Macul, Peñalolén and La Reina), by the Geroscience Center for Brain Health and Metabolism (GERO), and are followed at 18 and 36 months with clinical, neuropsychological, neuroimaging, blood and stool assessments to study the rate of functional decline and progression to dementia and their risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001256> (<http://www.ebi.ac.uk/coho/COHO_0001256>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30705288") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37333771") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37985413") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.gaaindata.org/getPartner?project=AGA") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001256> "A multisite case-control study of sporadic Alzheimer's disease in Argentina, recruiting since 2013. Older people with Alzheimer's disease and cognitively unimpaired controls are enrolled at outpatient neurology departments of hospitals in the city and province of Buenos Aires and at centres in Jujuy, Córdoba and Mendoza provinces, to identify genes for susceptibility to sporadic Alzheimer's disease and genes that modify its phenotypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001257> (<http://www.ebi.ac.uk/coho/COHO_0001257>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22723995") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23460863") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001257> "A prospective cohort of healthy pregnant women of Scandinavian heritage with singleton pregnancies who registered for obstetric care and gave birth at Oslo University Hospital, Rikshospitalet, Norway, in 2001–2008. The women had four antenatal visits (weeks 14–16, 22–24, 30–32 and 36–38) with fasting blood samples and ultrasound, and oral glucose tolerance tests at weeks 14–16 and 30–32, to study the determinants of fetal growth and birthweight in healthy pregnancies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001258> (<http://www.ebi.ac.uk/coho/COHO_0001258>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21054295") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21216857") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25597562") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001258> "A community-based longitudinal study of the disablement process in older Mexican Americans and European Americans in San Antonio, Texas. Its participants, the oldest members (aged 65 and over) of the San Antonio Heart Study cohort, had been randomly sampled from low-, middle- and high-income (barrio, transitional and suburban) neighbourhoods. They had a baseline examination in 1992–1996, combining a home-based assessment with a performance-based assessment at a clinical research center, and three follow-up examinations 18 months apart in 2000–2005.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001259> (<http://www.ebi.ac.uk/coho/COHO_0001259>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28983737") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34127860") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001259> "A collection of people with type 1 diabetes from Northern Ireland, most of them diagnosed in childhood. It is analysed separately from the Genetic Resource Investigating Diabetes (GRID) cases of Great Britain, and its DNA was genotyped on the ImmunoChip at the University of Virginia under the Type 1 Diabetes Genetics Consortium grant for genetic studies of type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001260> (<http://www.ebi.ac.uk/coho/COHO_0001260>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35922517") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40399555") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001260> "A case-control genetic association study of COVID-19 severity in Iran, based at Shariati Hospital, Tehran University of Medical Sciences. It genotyped people of Middle Eastern ancestry hospitalised with COVID-19, and controls, on the Illumina Global Screening Array, and contributed them to the COVID-19 Host Genetics Initiative's meta-analyses of COVID-19 severity and of long COVID.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001261> (<http://www.ebi.ac.uk/coho/COHO_0001261>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15462676") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20864003") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001261> "A longitudinal study of cardiovascular disease risk factors in young people in Northern Ireland, which screened a random sample of 12- and 15-year-olds from post-primary schools in 1989–1990, re-examined the younger group at age 15 in 1992–1993, and invited the whole sample back for examination as young adults in 1997–1999. A second school sample of 12- and 15-year-olds was surveyed in 1999–2001 as Young Hearts 2000.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001262> (<http://www.ebi.ac.uk/coho/COHO_0001262>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22286726") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33883888") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35887574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36013179") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001262> "A longitudinal study of community-dwelling people aged 60 years and older in Santiago, Chile, designed to study disability and dementia associated with obesity. It follows three cohorts: Santiago participants of the SABE survey, born before 1940 and first recruited in 1999–2000; people born in 1940–1948, recruited from public primary health care centre registries in 2005–2008; and people of high socioeconomic status selected from private health insurance registries.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001263> (<http://www.ebi.ac.uk/coho/COHO_0001263>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31688885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001263> "A multicentre research consortium formed to carry out genome-wide association studies of primary open-angle glaucoma in people of African ancestry, which brought together case-control collections recruited in 2003–2018 through clinics and population-based studies in Ghana, Nigeria, South Africa, the United States, Tanzania, Britain, Cameroon, Saudi Arabia, Brazil, the Democratic Republic of the Congo, Morocco, Peru and Mali. Besides its own site collections, it included participants of African ancestry from existing studies such as the Women's Health Initiative, the Genetic Epidemiology Research on Adult Health and Aging cohort and the African Descent and Glaucoma Evaluation Study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001264> (<http://www.ebi.ac.uk/coho/COHO_0001264>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23333117") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26115797") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001264> "An international, open-label, randomised phase 3 trial of the Gynecologic Cancer InterGroup, led by the UK Medical Research Council, in which women with newly diagnosed high-risk early-stage or advanced epithelial ovarian, fallopian tube or primary peritoneal cancer were recruited in 2006–2009 at centres in Europe, Canada, Australia and New Zealand and randomised to carboplatin and paclitaxel chemotherapy with or without concurrent and maintenance bevacizumab.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001265> (<http://www.ebi.ac.uk/coho/COHO_0001265>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33685545") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.mdsabstracts.org/abstract/genetics-of-parkinsons-in-india-young-onset-parkinsons-disease-gopi-yopd-genetics-of-juvenile-young-and-early-onset-parkinsons-disease/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.medrxiv.org/content/medrxiv/early/2023/06/22/2023.06.18.23291407.full.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001265> "A prospective, pan-India, multicentre study of people with juvenile-, young- and early-onset Parkinson's disease (onset by about 50 years of age), started by the Parkinson Research Alliance of India, which over two years recruited patients under the care of movement disorder specialists at ten specialty movement disorder centres and neurology clinics across India, to study the clinical and genetic patterns of early-onset Parkinson's disease in India.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001266> (<http://www.ebi.ac.uk/coho/COHO_0001266>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34597274") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35052684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36271419") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.scilifelab.se/news/uppsala-researchers-contributes-to-the-global-covid-19-host-genetics-initiative/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001266> "A study of patients with critical COVID-19 admitted from March 2020 to the intensive care unit of Uppsala University Hospital, Sweden, who were enrolled in the prospective observational PronMed cohort and invited to follow-up three to six months after discharge, in which researchers at Uppsala University and Karolinska Institutet investigate the mechanisms of acute and long-term organ dysfunction in critical COVID-19, including its host genetics.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001267> (<http://www.ebi.ac.uk/coho/COHO_0001267>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34235400") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34597274") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35174781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35613127") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001267> "A prospective cohort study and registry of patients who tested positive for SARS-CoV-2 at the Klinikum rechts der Isar, the university hospital of the Technical University of Munich, Germany, from 2020, in which hospitalised patients' clinical and laboratory data were collected prospectively for research on COVID-19.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001268> (<http://www.ebi.ac.uk/coho/COHO_0001268>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29884306") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.medrxiv.org/content/medrxiv/early/2023/11/22/2023.11.22.23298891.full.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001268> "A population-based case-control study of women admitted for obstetric care at seven hospitals in Lima, Peru, between March 2013 and December 2015, with cases of placental abruption and of preterm birth and controls selected at random from women delivering at the same hospitals, designed to investigate the genetic and environmental determinants of placental abruption and other adverse pregnancy outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001269> (<http://www.ebi.ac.uk/coho/COHO_0001269>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21062840") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22108914") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34388220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001269> "A population-based cohort of pregnant women of diverse ethnic origin attending three public Child Health Clinics for antenatal care in Groruddalen, a multi-ethnic area of Oslo, Norway, recruited in 2008–2010 and followed with their offspring through pregnancy and after birth, to study gestational diabetes, physical activity and obesity in pregnancy and to identify predictors of gestational diabetes and fetal growth.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001270> (<http://www.ebi.ac.uk/coho/COHO_0001270>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32719485") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36482101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001270> "A research biobank of patients hospitalised with COVID-19 in the Mount Sinai Health System in New York City, enrolled from April to June 2020 through daily review of new admissions together with a smaller group of healthy and hospitalised controls, whose blood was sampled repeatedly alongside routine clinical draws during their hospital stay for multi-omic study of the host response to SARS-CoV-2, and whose survivors were later surveyed for post-acute sequelae of COVID-19.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001271> (<http://www.ebi.ac.uk/coho/COHO_0001271>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10412782") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37779851") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37806305") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001271> "A multicentre, randomised, double-blind, placebo-controlled trial, begun in 1998 at dialysis centres throughout Germany, of adults aged 18–80 with type 2 diabetes who had been on maintenance haemodialysis for less than two years, which tested whether atorvastatin lowers the risk of cardiovascular death, non-fatal myocardial infarction and stroke, and followed its participants for a median of four years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001272> (<http://www.ebi.ac.uk/coho/COHO_0001272>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19752422") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29361356") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30352225") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001272> "A multicentre prospective observational cohort study, which from 2003 enrolled people of African descent and of European descent without glaucoma, with suspected glaucoma or with glaucoma at the University of California San Diego, the New York Eye and Ear Infirmary and the University of Alabama at Birmingham, United States, and followed them with repeated visual function testing and optic nerve imaging to identify why glaucoma onset and progression differ between people of African and European descent. Its third phase (ADAGES III) recruited, in 2014–2016 at five US centres, patients with primary open-angle glaucoma and controls of African or European descent, with DNA, to study the genetics of the disease in people of African descent.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001273> (<http://www.ebi.ac.uk/coho/COHO_0001273>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41125582") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001273> "A case-control study of B-cell acute lymphoblastic leukaemia in Black or African American children and young adults diagnosed at ages 0–25 in the United States, run from the University of Minnesota, which gathered germline DNA of cases from Children's Oncology Group frontline trials, from newborn dried blood spots held by the Michigan BioTrust for Health and linked to the state cancer registry, and from hospital leukaemia biobanks, with controls matched on sex and ancestry from Michigan newborn blood spots and paediatric well-child visits. It investigates African ancestry-specific genetic susceptibility to B-cell acute lymphoblastic leukaemia and its relation to disease subtype and survival.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001274> (<http://www.ebi.ac.uk/coho/COHO_0001274>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15899951") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16939402") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29739999") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001274> "A family study of the Old Order Amish of Lancaster County, Pennsylvania, United States, begun by the University of Maryland in 1997, which identified Amish adults with osteoporosis by bone mineral density screening and recruited their first-degree relatives aged 20 and over and their spouses, measuring bone density by dual-energy X-ray absorptiometry, to find genetic and clinical determinants of osteoporosis and bone health in large multigenerational families.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001275> (<http://www.ebi.ac.uk/coho/COHO_0001275>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22797727") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23105927") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24647736") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32499647") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37859345") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001275> "A consortium of genetic epidemiology studies of type 2 diabetes and related traits in people of East Asian ancestry, mostly population-, hospital- or family-based cohorts in East and South-East Asia, which meta-analyses its member studies' genome-wide association results in trait-specific groups (such as AGEN-T2D and AGEN-BP) for type 2 diabetes, glycaemic traits, adiposity, adiponectin, blood pressure and kidney function.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001276> (<http://www.ebi.ac.uk/coho/COHO_0001276>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20450418") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42461483") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001276> "An ongoing community-based cohort of current and former people who inject drugs in and around Baltimore, Maryland, United States, established in 1988 as a natural history study of the incidence and progression of HIV infection.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001277> (<http://www.ebi.ac.uk/coho/COHO_0001277>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19887461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001277> "A multicentre, population-based case-control-family study in Australia, recruiting people with early-onset first-primary cutaneous melanoma, population-based and spouse or friend controls, and their relatives, between 2001 and 2005, to investigate genetic and environmental influences on melanoma risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001278> (<http://www.ebi.ac.uk/coho/COHO_0001278>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26754954") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001278> "A consortium of seven independent studies of people of European ancestry in the United States, Switzerland, the Netherlands, Germany and Australia (the Molecular Genetics of Schizophrenia control sample, PsyCoLaus, the Rotterdam Study, the Study of Health in Pomerania, the QIMR twin sample, TRAILS and NESDA/NTR), with interview-based DSM diagnoses of anxiety disorders, formed to meta-analyse genome-wide association studies of generalized anxiety disorder, panic disorder, social phobia, agoraphobia and specific phobia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001279> (<http://www.ebi.ac.uk/coho/COHO_0001279>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21533022") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22792071") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001279> "A sample of postmenopausal women aged 55–85 of white European ancestry with extreme high or extreme low hip bone mineral density, recruited from population-based and clinical sources at centres in Australia, New Zealand and the United Kingdom by the Anglo-Australasian Osteoporosis Genetics Consortium and genotyped together for a genome-wide association study of bone mineral density and fracture that used extreme truncate selection.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001280> (<http://www.ebi.ac.uk/coho/COHO_0001280>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30157880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34411292") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001280> "A randomised, double-blind, placebo-controlled, two-stage adaptive trial, funded by the NIHR Efficacy and Mechanism Evaluation programme, that enrolled adults with palmoplantar pustulosis severe enough to need systemic therapy at 16 sites in England, Scotland and Wales between October 2016 and January 2020, to test whether 8 weeks of the interleukin-1 receptor antagonist anakinra reduces disease severity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001281> (<http://www.ebi.ac.uk/coho/COHO_0001281>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33998257") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34654805") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02884141") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001281> "A prospective national registry, sponsored by Assistance Publique–Hôpitaux de Paris and coordinated at the Hôpital Européen Georges Pompidou in Paris, of adults with renal, cervical or intracranial artery fibromuscular dysplasia recruited from 2009 to 2014 at 16 university hospitals in France and Belgium, with standardised clinical and imaging data and leukocyte DNA collected to study multisite disease and to search for susceptibility genes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001282> (<http://www.ebi.ac.uk/coho/COHO_0001282>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38291599") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40139683") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001282> "A multicentre randomised controlled trial that recruited hypertensive men and women aged 40–79 with at least three other cardiovascular risk factors, mostly through family practices in the United Kingdom, Ireland and the Nordic countries between February 1998 and May 2000, to compare an amlodipine-based with an atenolol-based antihypertensive regimen for preventing coronary and other cardiovascular events (the Blood Pressure-Lowering Arm), those with total cholesterol of 6.5 mmol/L or less being also randomised to atorvastatin or placebo in a factorial Lipid-Lowering Arm.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001283> (<http://www.ebi.ac.uk/coho/COHO_0001283>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21812969") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001283> "A case-control sample of people of Ashkenazi Jewish ancestry from the New York area, with Parkinson's disease cases recruited at the Center for Parkinson's Disease and Other Movement Disorders at Columbia University and controls evaluated in the same way, assembled from two Columbia University studies, the Genetic Epidemiology of PD study (PD EPI) and the AJ Study, for a genome-wide association study of Parkinson's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001284> (<http://www.ebi.ac.uk/coho/COHO_0001284>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20799966") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32707221") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001284> "A prospective, matched cohort study, funded by the US National Institute of Diabetes and Digestive and Kidney Diseases, that enrolled hospitalised adults with and without acute kidney injury (AKI), matched on clinical research centre, pre-admission chronic kidney disease and other risk factors, at centres in the United States and Canada between December 2009 and February 2015, together with children undergoing cardiac surgery, and followed them after discharge to examine how an episode of AKI affects the development and progression of chronic kidney disease, cardiovascular events and death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001285> (<http://www.ebi.ac.uk/coho/COHO_0001285>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26489512") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37721739") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001285> "A population-based cohort of mobile people aged 70 and over from the city and county of Regensburg in eastern Bavaria, Germany, invited from random samples of the local residents' registries and examined at the University Hospital Regensburg in two baseline surveys (2013–2015 and 2017–2019), with interviews, medical and eye examinations, biobanking and genotyping and later follow-up, set up by the University of Regensburg as a research platform for late-onset chronic diseases and their genetic and non-genetic causes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001286> (<http://www.ebi.ac.uk/coho/COHO_0001286>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23251690") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33633342") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001286> "A population-based cohort of the residents aged 60 and over of the town of Bambuí, in Minas Gerais, south-eastern Brazil, identified by a complete census on 1 January 1997 and examined at baseline in February–May 1997 with interviews, blood tests, blood pressure measurements and electrocardiograms, then followed with annual interviews, repeated examinations and death ascertainment to study health and mortality in older adults.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001287> (<http://www.ebi.ac.uk/coho/COHO_0001287>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31641004") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001287> "A population-based prospective cohort of pregnant women in Uppsala County, Sweden, invited at their routine ultrasound examination at gestational week 16–18 at Uppsala University Hospital from September 2009 to November 2018 and followed to one year postpartum with web surveys, biological samples and medical-record data, to study the biopsychosocial causes and predictors of perinatal depression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001288> (<http://www.ebi.ac.uk/coho/COHO_0001288>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22357627") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001288> "A case-control study of breast cancer in the greater Baltimore area, Maryland, United States, in which incident breast cancer cases and controls frequency-matched to them on race and age were recruited from February 1993 to August 2003 at six hospitals, including the University of Maryland Medical Center and the Baltimore Veterans Affairs Medical Center, to identify and characterise markers of disease aggressiveness and poor outcome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001289> (<http://www.ebi.ac.uk/coho/COHO_0001289>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25905023") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29242907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30208419") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32200810") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001289> "A population-based cohort of the residents of the city and township of Beaver Dam, Wisconsin, United States, aged 43 to 84 years at a private census begun in 1987. They were examined at baseline in 1988–1990 and re-examined about every five years (up to a 25-year follow-up in 2014–2016) by the University of Wisconsin-Madison, to study the prevalence, incidence and risk factors of age-related eye diseases, such as age-related macular degeneration and cataract, and of visual impairment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001290> (<http://www.ebi.ac.uk/coho/COHO_0001290>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21800090") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35234888") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00738725") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001290> "A prospective observational cohort of asymptomatic adults at risk of, but without, clinical atherosclerotic cardiovascular disease (men aged 55–80 and women aged 60–80). They were recruited in 2008–2009 by the High-Risk Plaque Initiative from members of the Humana health plan in Chicago, Illinois, and Fort Lauderdale, Florida, United States, and examined with vascular imaging and blood sampling, to identify imaging and circulating biomarkers that predict near-term atherothrombotic events.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001291> (<http://www.ebi.ac.uk/coho/COHO_0001291>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18814239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22357627") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001291> "A nationwide population-based case-control study of breast and prostate cancer in Barbados-born residents of Barbados. It was run by Stony Brook University with the Barbados Ministry of Health and the University of the West Indies and funded by the US National Human Genome Research Institute. Its breast cancer arm enrolled every histologically confirmed incident breast cancer identified by the island's only pathology department, at the Queen Elizabeth Hospital, from July 2002 to March 2006, with controls randomly selected from a national database and frequency-matched by age. The aim was to study environmental and genetic risk factors in this predominantly African-origin population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001292> (<http://www.ebi.ac.uk/coho/COHO_0001292>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31002669") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33002337") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01793103") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001292> "A single-centre prospective observational registry cohort of adults with rheumatoid arthritis diagnosed by a rheumatologist, enrolled from March 2003 at the Brigham and Women's Hospital Arthritis Center in Boston, Massachusetts, United States. Participants are followed with annual visits, semi-annual questionnaires and stored blood samples, to find biomarkers that predict drug response, toxicity, disease activity and prognosis and to describe the natural history of treated rheumatoid arthritis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001293> (<http://www.ebi.ac.uk/coho/COHO_0001293>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28886342") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://metadata.ega-archive.org/studies/EGAS00001001206") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001293> "A UK collection of adults with Dupuytren's disease who had been treated surgically for it. Saliva samples for DNA, and diseased palmar fascia removed at surgery, were collected by the British Society for Surgery of the Hand Genetics of Dupuytren's Disease (BSSH-GODD) consortium for genetic studies of the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001294> (<http://www.ebi.ac.uk/coho/COHO_0001294>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14691062") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23781007") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31965629") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38849413") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001294> "An observational, longitudinal, population-representative incident cohort of people newly diagnosed with parkinsonism or Parkinson's disease in the county of Cambridgeshire, United Kingdom, between December 2000 and December 2002. Cases were referred through general practitioners, neurologists, geriatricians, Parkinson's disease specialist nurses and hospital discharge coding, and were followed from diagnosis by the University of Cambridge with clinical, neuropsychological and genetic assessments, to describe the natural history of Parkinson's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001295> (<http://www.ebi.ac.uk/coho/COHO_0001295>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30698711") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32887874") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02188069") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT04906356") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001295> "A multicentre, prospective, observational cohort of patients presenting with acute non-atherosclerotic spontaneous coronary artery dissection (SCAD), run from the University of British Columbia and enrolled at cardiac centres in Canada and the United States since June 2014, whose precipitating stressors, predisposing conditions and core-laboratory-reviewed angiograms are recorded and who are followed for cardiovascular events, to establish the natural history of SCAD and the outcomes of its treatment. Its first phase, the Canadian SCAD Cohort Study (enrolment 2014 to 2018, three-year follow-up), was extended from December 2018 as the Canadian SCAD Study, with international enrolment, a genetic sub-study and follow-up of up to ten years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001296> (<http://www.ebi.ac.uk/coho/COHO_0001296>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26779513") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35379992") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001296> "A prospective cardiovascular population study of an age-stratified random sample of adults aged 20 years or older living in the Østerbro district and part of Nørrebro around Rigshospitalet in Copenhagen, Denmark, launched in 1975 with a first examination in 1976–1978 and re-examinations in 1981–1983, 1991–1994, 2001–2003 and 2011–2013, whose participants are followed through the Danish national registers. Its original purpose was the prevention of coronary heart disease and stroke; lung disease, dementia, ageing, genetics and other topics were added later.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001297> (<http://www.ebi.ac.uk/coho/COHO_0001297>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20661439") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22792352") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41373161") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001297> "A registry of individuals and families at high risk of cancer, established in 1992 at the Cancer Risk Clinic, a hospital-based preventive oncology clinic of the University of Chicago, United States, whose participants receive genetic testing and counselling at enrolment. It is also run as a hospital-based case-control study of the genetics of breast cancer in young patients, enrolling women with histologically confirmed breast cancer through the clinic, with early-onset cases and African Americans oversampled, and cancer-free controls matched on sex and age from patients of the same hospital, with questionnaires adopted from the Breast Cancer Family Registry and blood samples.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001298> (<http://www.ebi.ac.uk/coho/COHO_0001298>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19902523") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20658620") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biolincc.nhlbi.nih.gov/studies/cscc_c_data/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00528203") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00529061") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001298> "A multicentre observational cohort and database of children and adults with sickle cell disease receiving care at the National Heart, Lung, and Blood Institute's Comprehensive Sickle Cell Centers in the United States, run from March 2005 to September 2008 at nine of the centres and their satellite sites, which collected clinical data abstracted from medical records, yearly health and lifestyle interviews and quality-of-life questionnaires, and from 2007 blood and DNA samples for a genotype-phenotype repository, to describe the disease's complications and identify participants for future clinical trials.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001299> (<http://www.ebi.ac.uk/coho/COHO_0001299>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24142632") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27736948") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35352885") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35793981") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001299> "A hospital-based registry cohort of the Cardiovascular Genome Center of Yonsei University College of Medicine, enrolling from November 2000 patients who visited the cardiology division of Severance Hospital in Seoul, South Korea, for chest symptoms, cardiovascular risk-factor control or a health check-up, with clinical data collected by trained nurses, blood samples for DNA and, where symptoms warranted, coronary angiography, for genetic research on coronary artery disease and other cardiovascular and metabolic conditions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001300> (<http://www.ebi.ac.uk/coho/COHO_0001300>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17529973") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22271044") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2291937/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.cancernetwork.com/view/cgems-id-genetic-risks-two-cancers") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001300> "A three-year initiative of the US National Cancer Institute, begun in 2006, that ran multi-stage genome-wide association studies of prostate and breast cancer in case-control sets drawn from existing studies (for prostate cancer, men from the Prostate, Lung, Colorectal, and Ovarian Cancer Screening Trial, the American Cancer Society Cancer Prevention Study II, the Alpha-Tocopherol, Beta-Carotene Cancer Prevention Study and the French Prostate Case-Control Study; for breast cancer, postmenopausal women from the Nurses' Health Study, with replication in further cohorts), and shared its genotype data and results with the research community.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001301> (<http://www.ebi.ac.uk/coho/COHO_0001301>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18292811") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23670970") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26417704") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30807572") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31697830") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001301> "A population-based study of people with cystic fibrosis and their parents in Canada, led from the Hospital for Sick Children in Toronto, which recruited patients without regard to genotype or lung function through specialised CF clinics across the country, first from 2003 to 2006 and then in a second phase, with clinical data from clinic records and DNA for genome-wide genotyping and sequencing, to identify genetic modifiers of cystic fibrosis lung disease and of complications such as meconium ileus, liver disease and CF-related diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001302> (<http://www.ebi.ac.uk/coho/COHO_0001302>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20041166") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20205591") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21160409") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23935489") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24910414") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001302> "A consortium of universities and academic medical centres established by the US National Institute of Allergy and Infectious Diseases from 2005 to 2012 and led from Duke University, to determine the host and virus factors associated with HIV transmission, infection and control and so advance HIV vaccine development. Its clinical studies enrolled participants at sites in Africa and the United States, and its Host Genetics Core assembled genome-wide genotyped samples of people with HIV-1 from existing cohorts, including the European and Australian cohorts of the Euro-CHAVI consortium and participants of the US Military HIV Natural History Study and the Multicenter AIDS Cohort Study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001303> (<http://www.ebi.ac.uk/coho/COHO_0001303>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38703249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39186261") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40642536") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001303> "A hospital-based, dynamic, longitudinal prospective cohort of patients with keratoconus, established at Henan Eye Hospital in Zhengzhou, China, which since January 2019 has enrolled patients from a large geographical area, collecting questionnaire data on demographics, lifestyle, eye rubbing, medical, surgical and family history and visual function, eye and general examinations, biological specimens and data on patients' first-degree relatives, with follow-up at 3, 6 and 12 months and yearly thereafter, to study genes, environment and their interaction in keratoconus progression and its prevention.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001304> (<http://www.ebi.ac.uk/coho/COHO_0001304>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17699320") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35518833") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00327860") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001304> "A multicentre prospective observational cohort of children with chronic kidney disease in the United States and Canada, funded since 2003 by the National Institute of Diabetes and Digestive and Kidney Diseases and coordinated from Children's Mercy Hospital in Kansas City and Johns Hopkins (later the Children's Hospital of Philadelphia), which since 2005 has enrolled children aged 6 months to 16 years at paediatric nephrology centres and later also young adults. Participants have annual visits with measured glomerular filtration rate, questionnaires on cognition, behaviour and quality of life, cardiovascular assessments and stored biosamples and DNA, to identify risk factors for the decline of kidney function and its effects on cardiovascular risk, neurocognitive function and behaviour, and growth.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001305> (<http://www.ebi.ac.uk/coho/COHO_0001305>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27922632") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37582857") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001305> "A sample of adults aged 21–50 studied at the University of California, Los Angeles, by the Consortium for Neuropsychiatric Phenomics, one of the NIH Roadmap interdisciplinary research consortia of 2007–2012: mainly healthy White non-Hispanic or Hispanic adults recruited by community advertisement in the Los Angeles area, with smaller groups with schizophrenia, bipolar disorder or ADHD recruited through local clinics and online portals. Participants had diagnostic interviews, neurocognitive testing and blood sampling for genotyping, and a subset had structural, diffusion and functional MRI, to study memory and response-inhibition phenotypes dimensionally from genome to syndrome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001306> (<http://www.ebi.ac.uk/coho/COHO_0001306>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29117798") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29750028") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31172706") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41136451") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41436567") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001306> "A longitudinal observational cohort, begun in 2012 and based at Kangwon National University Hospital, of residents of six districts with cement plants in Gangwon (Kangwon) and Chungbuk provinces, South Korea, comprising people with chronic obstructive pulmonary disease or airflow limitation and volunteers with normal spirometry, examined with questionnaires, spirometry, chest CT and blood and urine sampling, to study the clinical course and outcomes of COPD in people exposed to cement dust.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001307> (<http://www.ebi.ac.uk/coho/COHO_0001307>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36968829") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39164465") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001307> "A prospective multicentre cohort of lung transplant candidates enrolled before transplantation at eleven French lung transplant centres and the Erasme Hospital in Brussels between September 2009 and the end of 2018, coordinated by Nantes University Hospital, with clinical data and biological samples from recipients, and samples from their organ donors, followed every six months after transplantation (samples for up to five years, clinical data for up to ten), set up to discover early predictors of chronic lung allograft dysfunction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001308> (<http://www.ebi.ac.uk/coho/COHO_0001308>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36138487") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7114401") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://biolincc.nhlbi.nih.gov/studies/csscd/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001308> "A multicentre prospective study of the natural history of sickle cell disease, initiated in 1977, that enrolled patients with sickle cell disease of all ages, from newborns to adults and from mild to hospital-based cases, at 23 centres across the United States from 1978 (patients older than six months until 1981, infants until 1988), and followed them with standardised examinations and records of acute and chronic complications and organ damage, later phases following the infant cohort and adult participants until 1998, to identify the factors contributing to the morbidity and mortality of the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001309> (<http://www.ebi.ac.uk/coho/COHO_0001309>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15194016") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24531328") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33619548") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001309> "A single-site, multiethnic, population-based probability sample of residents of Dallas County, Texas, aged 18 to 65, weighted to be about half African American and run by the University of Texas Southwestern Medical Center, surveyed and examined in 2000–2002 (DHS-1) and re-examined in 2007–2009 together with spouses and other new participants (DHS-2), designed to produce unbiased estimates of ethnic differences in cardiovascular health and to support research on their biological and social mechanisms using genetics, imaging, and clinical and social-science methods.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001310> (<http://www.ebi.ac.uk/coho/COHO_0001310>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29515973") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37568739") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001310> "A nationwide, population-based cohort of long-term testicular cancer survivors treated in Denmark in 1984–2007, identified in the Danish Testicular Cancer (DaTeCa) clinical database and surveyed by questionnaire on late effects in 2014–2016 by the Department of Oncology at Rigshospitalet, Copenhagen University Hospital, with linked hospital, pathology and national registry data and a biobank of blood and sputum samples, set up to analyse late effects of treatment and inform future follow-up programmes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001311> (<http://www.ebi.ac.uk/coho/COHO_0001311>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25228292") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38177345") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001311> "A population-based birth cohort run by the University of Cape Town in the Drakenstein area of Paarl, a poor peri-urban community 60 km from Cape Town, South Africa, which enrolled pregnant women at 20–28 weeks' gestation at two primary health clinics (TC Newman and Mbekweni) between March 2012 and March 2015 and follows the mother–child pairs from pregnancy until the children are at least five years old, to investigate early-life determinants of child health, first among them early lower respiratory tract infection, through environmental, infectious, nutritional, genetic, psychosocial, maternal and immunological measures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001312> (<http://www.ebi.ac.uk/coho/COHO_0001312>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35172313") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41006734") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001312> "A sub-study of Heart SCORE (Heart Strategies Concentrating on Risk Evaluation), a community-based cohort begun in 2003 of White and African American adults aged 45–75 in the greater Pittsburgh area, Pennsylvania, set up to investigate racial disparities in cardiovascular disease, in which a subgroup of participants had extended dental and periodontal examinations following the COHRA1 protocols and gave blood or saliva for DNA in 2007–2010, run by the University of Pittsburgh.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001313> (<http://www.ebi.ac.uk/coho/COHO_0001313>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17293876") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35551307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature05616/MediaObjects/41586_2007_BFnature05616_MOESM286_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001313> "A French case–control sample of people of European ancestry assembled for a genome-wide association study of type 2 diabetes: people with type 2 diabetes, a family history of diabetes in first-degree relatives and a BMI below 30, recruited at the CNRS UMR8090 unit in Lille and the Endocrinology-Diabetology Department of the Corbeil-Essonnes Hospital, and normoglycaemic controls drawn mostly from the D.E.S.I.R. cohort of volunteers attending French health examination centres.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001314> (<http://www.ebi.ac.uk/coho/COHO_0001314>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37639712") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001314> "A diverse cohort of adults with type 2 diabetes who are members of the Henry Ford Health System with pharmacy-covered health insurance and live in southeast Michigan and the Detroit metropolitan area, invited on the basis of two or more recorded diagnoses of type 2 diabetes and an HbA1c of at least 6.5%, who at enrolment completed a research survey, clinical examination and specimen collection, and whose genome-wide genotypes are linked to longitudinal electronic records of laboratory results and medication fills to study the genetics of response to diabetes drugs.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001315> (<http://www.ebi.ac.uk/coho/COHO_0001315>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22745713") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38177345") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41821625") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001315> "A population-based prospective cohort of adults aged 18 or older living in the city of Detroit, Michigan, most of them African American, drawn from a random probability sample of the city's households and interviewed by telephone in annual waves from 2008 to 2013, with blood specimens collected from a subset, to study how biological variation, stressful and traumatic experiences and environmental factors contribute to post-traumatic stress disorder, depression and other psychopathology.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001316> (<http://www.ebi.ac.uk/coho/COHO_0001316>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27135401") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30093612") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40633141") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001316> "An international consortium of population- and hospital-based endometrial cancer studies in Europe, North America and Australia, whose cases of European ancestry were genotyped on the iCOGS and OncoArray arrays and compared with country-matched controls, mainly from the Breast Cancer Association Consortium, in genome-wide association studies of endometrial cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001317> (<http://www.ebi.ac.uk/coho/COHO_0001317>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16870633") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17989723") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20584770") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42176242") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001317> "A European family study of longevity that recruited people aged 90 or older, many of them centenarians, in Southern Denmark, Languedoc-Roussillon in France and Calabria in Italy, together with one of their children and, in a cousin-pair design, a child of a sibling who was or was not also long-lived, to investigate genetic and environmental factors in longevity and healthy ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001318> (<http://www.ebi.ac.uk/coho/COHO_0001318>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22851572") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37533055") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39932735") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001318> "A prospective cohort study of people with childhood-onset type 1 diabetes (onset before age 17) who were diagnosed, or seen within a year of diagnosis, at Children's Hospital of Pittsburgh between 1950 and 1980, followed since a baseline examination in 1986–1988 with biennial examinations and questionnaires for ten years and later questionnaires and examinations, to ascertain the incidence of and risk factors for complications of type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001319> (<http://www.ebi.ac.uk/coho/COHO_0001319>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17634448") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001319> "A clinic-based case-control study of age-related macular degeneration in Scotland, collected by a group in Edinburgh with funding from the Chief Scientist Office (Scotland), whose cases with advanced or intermediate AMD and controls were ascertained by fundus examination or photography; its cases and controls replicated the association of complement C3 with AMD and were contributed to the International AMD Genomics Consortium's genome-wide association study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001320> (<http://www.ebi.ac.uk/coho/COHO_0001320>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24585730") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001320> "A multicentre cohort of active and retired employees aged 35–74 years of six Brazilian universities and research institutions, with study centres in state capitals of north-eastern, south-eastern and southern Brazil, examined at baseline in 2008–2010 and at later visits and followed by annual telephone interviews, to investigate the development of chronic diseases, primarily diabetes and cardiovascular diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001321> (<http://www.ebi.ac.uk/coho/COHO_0001321>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40646133") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://emblem.cancer.gov/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001321> "A case-control study of childhood Burkitt lymphoma in malaria-endemic East Africa, sponsored by the US National Cancer Institute's intramural research program, that in 2010–2016 enrolled population-based cases and controls aged 0–15 years from six rural regions, two each in Uganda, Kenya and Tanzania, and used questionnaires, blood samples and genetic data to investigate infectious, immunological and genetic risk factors for Burkitt lymphoma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001322> (<http://www.ebi.ac.uk/coho/COHO_0001322>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26237428") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32341527") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001322> "A German case-control study of cutaneous melanoma, of patients with histologically confirmed cutaneous melanoma and healthy controls from Germany genotyped genome-wide, approved by the ethics committee of University Hospital Essen and funded by the Deutsche Forschungsgemeinschaft, whose data were contributed to international meta-analyses of melanoma genome-wide association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001323> (<http://www.ebi.ac.uk/coho/COHO_0001323>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19967159") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35463779") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36002395") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37286573") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37399490") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001323> "A French multicentre case-control study of venous thromboembolism, run in 11 centres from 2003 to 2009, that enrolled consecutive adult inpatients and outpatients treated for a first objectively documented deep vein thrombosis and/or pulmonary embolism, without active cancer or malignancy in the previous 5 years, whose blood was mostly sampled in the week after diagnosis, and hospital controls matched for age, sex and centre with no history of venous or arterial thrombosis; the patients were also followed prospectively, to study risk factors for a first venous thromboembolism and for its recurrence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001324> (<http://www.ebi.ac.uk/coho/COHO_0001324>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32282921") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001324> "A registry of patients with fibromuscular dysplasia, launched in December 2015 at the First Brussels National Meeting on FMD and endorsed by the European Society of Hypertension in 2016, that enrols prevalent and incident adult patients whose multifocal or focal FMD lesions in at least one arterial bed were shown by CT angiography, MR angiography or catheter angiography, at centres in Europe and a few other countries, recording their clinical characteristics, imaging, visits and vascular interventions on an online platform with an associated DNA and RNA biobank, to characterise the clinical profiles, complications and management of the disease. It also takes in data from existing national registries such as the French NOMADE and Polish ARCADIA-POL registries.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001325> (<http://www.ebi.ac.uk/coho/COHO_0001325>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31657023") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001325> "A prospective cohort of whole-blood donors aged 18–70 recruited by the Finnish Red Cross Blood Service alongside standard donation at three fixed donation sites in the Helsinki metropolitan area of Finland (Kivihaka, Sanomatalo and Espoo) from May 2015 to December 2017, with blood samples taken at their donation visits during the study for blood counts, CRP, ferritin and soluble transferrin receptor and for DNA, and health and lifestyle questionnaires at enrolment and again in 2018, to study iron status and the genetic and lifestyle factors affecting iron stores in blood donors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001326> (<http://www.ebi.ac.uk/coho/COHO_0001326>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32499541") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34706593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34784307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35405960") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38413574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001326> "A national health examination survey of adults aged 18 or older living in mainland Finland, run by the Finnish Institute for Health and Welfare (THL) at 50 study locations between January and May 2017 in a representative sample drawn from the Population Register by one- and two-stage stratified random sampling, in which participants answered questionnaires on sociodemographic factors, health, quality of life, lifestyle, diseases and medication and attended a health examination with physical measurements and blood sampling, to monitor the health, functional capacity and welfare of the Finnish population and the prevalence and risk factors of common health problems. It combined the protocols of the FINRISK surveys and the Health 2000 and 2011 surveys.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001327> (<http://www.ebi.ac.uk/coho/COHO_0001327>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31640839") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39920525") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001327> "A population-based longitudinal cohort of the twins born in Finland in 1983–1987, the youngest of the three Finnish Twin Cohorts, identified through Finland's Central Population Registry and enrolled with their biological parents in the year they reached age 11, with twin, parent and teacher questionnaires and ratings at baseline and follow-up surveys at ages 14, 17, about 22 and about 37; a subset was studied intensively with in-school assessments and peer nominations at age 12, psychiatric interviews at ages 14 and 22, and neurocognitive tests and DNA collection in early adulthood. It was designed to identify individual, familial and school and neighbourhood risks for substance use before its onset and to follow trajectories of use, abuse and their consequences into adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001328> (<http://www.ebi.ac.uk/coho/COHO_0001328>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17452741") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18350156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34543398") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36682031") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001328> "A study of the genetic and environmental effects on the disablement process in older women, in which female twin pairs aged 63–76, recruited from the Older Finnish Twin Cohort, took part in laboratory examinations of physical functioning, muscle strength and power, hearing and other health measures, with blood sampling, in Jyväskylä, Finland, in 2000–2001 and again at a 3-year follow-up, and have since been followed for mortality, by researchers of the Gerontology Research Center of the University of Jyväskylä.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001329> (<http://www.ebi.ac.uk/coho/COHO_0001329>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23382860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27598322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29089348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40973091") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001133/phs001133.v1.p1/GapExchange_phs001133.v1.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001329> "A post-GWAS research programme on epithelial ovarian cancer, funded by the US National Cancer Institute (U19-CA148112) as the ovarian cancer consortium of the Genetic Associations and Mechanisms in Oncology (GAME-ON) initiative, led from Moffitt Cancer Center and built on the collaboration of the Ovarian Cancer Association Consortium, that pools genome-wide and further genotyping data (including exome-chip and OncoArray genotyping) from the case-control studies of that consortium, to discover and replicate susceptibility variants, including histotype-specific variants and variants associated with survival, to study their biological mechanisms, and to investigate gene–gene and gene–environment interactions and risk prediction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001330> (<http://www.ebi.ac.uk/coho/COHO_0001330>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29410079") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30267149") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38036604") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39112778") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42598116") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001330> "The human cohort of the German Research Foundation (DFG) research unit FOR2107 on the neurobiology of the major psychoses, recruited between 2014 and 2018 at the Universities of Marburg and Münster, Germany, through local psychiatric hospitals and newspaper advertisements: adults aged 18–65 with major depressive disorder, bipolar disorder, schizoaffective disorder or schizophrenia, healthy people at genetic and/or environmental risk, and healthy controls, deeply phenotyped with MRI, clinical course, neuropsychology, personality, risk and protective factors and biomaterials (blood, stool, urine, hair, saliva) at baseline and again at a 2-year follow-up, to identify how genetic and environmental factors shape brain structure and function and the course of these disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001331> (<http://www.ebi.ac.uk/coho/COHO_0001331>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23267103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25208887") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40071514") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40756183") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001331> "A family-based study of healthy young people aged 14–35, recruited at the University of Michigan in Ann Arbor, United States, between June 2006 and January 2009 from the university's undergraduate and graduate students together with their biological siblings, with blood samples for measuring plasma haemostatic proteins (such as von Willebrand factor and plasminogen), genome-wide genotyping and a survey of common morphological traits, to identify the genetic factors behind variation in blood clotting in healthy people, using its sibling structure for linkage as well as association analysis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001332> (<http://www.ebi.ac.uk/coho/COHO_0001332>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20953190") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23143594") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2467/MediaObjects/41588_2012_BFng2467_MOESM43_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001332> "An international consortium of psoriasis genetics research groups in the United Kingdom, Ireland, Austria, Finland, Germany, Italy, the Netherlands, Spain and Sweden, with a management committee chaired from King's College London, that pools its members' collections of people of European descent with psoriasis vulgaris, together with controls from national control collections, for genetic association studies of psoriasis, including a genome-wide association study with the Wellcome Trust Case Control Consortium 2 and an Immunochip case–control study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001333> (<http://www.ebi.ac.uk/coho/COHO_0001333>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28295287") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30990841") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38082317") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001333> "A population-based case–control study of breast cancer, a collaboration of the US National Cancer Institute with three major hospitals in Accra and Kumasi, Ghana (Korle Bu Teaching Hospital, Komfo Anokye Teaching Hospital and Peace and Love Hospital), that in 2013–2015 enrolled women aged 18–74 recommended for biopsy of a breast lesion suspicious for malignancy, or treated for breast cancer, at these hospitals, and population controls sampled by household enumeration of the surrounding districts and frequency-matched on age and district, collecting interviews and tumour tissue, blood, saliva and faecal samples to study breast cancer risk factors in a West African population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001334> (<http://www.ebi.ac.uk/coho/COHO_0001334>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25872595") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38727677") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001334> "A multicentre international case–control study of alcohol-related cirrhosis, run by the GenomALC Consortium of researchers in Australia, France, Germany, Switzerland, the United Kingdom and the United States with funding from the US National Institute on Alcohol Abuse and Alcoholism, that from September 2012 recruited, at liver and alcohol treatment clinics and from existing repositories of the participating centres, people who had drunk heavily (at least 80 g of alcohol a day for men or 50 g for women) for at least ten years, with alcoholic cirrhosis (cases) or without significant liver disease (controls), with interviews, clinical records and blood samples, to find genetic factors that predispose drinkers to cirrhosis. A second sample, GenomALC-2, added DNA and data that research groups in these countries and Belgium had collected for earlier genetic studies of alcohol-related liver disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001335> (<http://www.ebi.ac.uk/coho/COHO_0001335>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20876876") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21983787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://genomel.org/about/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://genomel.org/research/programme-and-aims/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001335> "An international non-profit consortium, established in 1997, of most of the research groups working on the genetics of familial melanoma, in Europe, North America, Australia and elsewhere, funded by the European Commission's Sixth Framework Programme and the US National Cancer Institute, which pools data and samples from its members' melanoma-prone families and case–control series to find melanoma susceptibility genes and how they interact with environmental factors such as ultraviolet radiation. Its genome-wide association study combined melanoma cases, prioritised for family history, multiple primaries or early onset, and controls from the same populations, contributed by member groups in Europe, Israel and Australia, with French and UK population controls.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001336> (<http://www.ebi.ac.uk/coho/COHO_0001336>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29987654") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36335405") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41033104") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001336> "A multicentre observational cohort of adult patients of European ancestry with sepsis of any cause admitted to a network of intensive care units in Spain, recruited through the GEN-SEP Network of Spanish investigators in two periods (2002–2015 and 2016–2019) and followed for the development of acute respiratory distress syndrome and for 28-day survival, whose DNA is used in genetic studies of sepsis-associated ARDS and sepsis outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001337> (<http://www.ebi.ac.uk/coho/COHO_0001337>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23459313") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38094903") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://cdn-links.lww.com/permalink/wnl/c/wnl_2022_08_08_mitchell_1_sdc1.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001337> "A population-based case–control study of early-onset ischaemic stroke, run from the University of Maryland, Baltimore, that recruited women and men aged 15–49 with a first ischaemic stroke, identified by discharge surveillance at 59 hospitals of the greater Baltimore–Washington area of the United States and by referral from regional neurologists, in four periods between 1992 and 2008, together with controls without stroke found by random-digit dialling and matched on age and region of residence, in a biracial sample of European American and African American participants; it was designed to identify the genetic determinants of early-onset ischaemic stroke and their interactions with environmental risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001338> (<http://www.ebi.ac.uk/coho/COHO_0001338>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34450027") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.genetics-osteoarthritis.com/contributing-studies/contributing-studies/index.html") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.genetics-osteoarthritis.com/themenmenue/home/index.html") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001338> "A global collaboration that aims to bring together all available genetic studies of osteoarthritis, meta-analysing genome-wide association data on osteoarthritis at different joint sites (hip, knee, hand, finger, thumb and spine) and related traits from its contributing cohorts and biobanks in Europe, East Asia, North America and Australia, among them UK Biobank, arcOGEN, deCODE, the HUNT Study, the Estonian Biobank, the Rotterdam Study, FinnGen and the Million Veteran Program.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001339> (<http://www.ebi.ac.uk/coho/COHO_0001339>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36699085") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001339> "A multinational retrospective cohort of paediatric cancer patients treated between 1975 and 2020 at hospitals in the Netherlands, Italy and Australia, made up of osteosarcoma and brain tumour cohorts and mostly treated with cisplatin or carboplatin, assembled by the Genetics of Childhood Cancer Treatment consortium for pharmacogenetic research such as studies of platinum-induced hearing loss.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001340> (<http://www.ebi.ac.uk/coho/COHO_0001340>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28886342") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30688894") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37257093") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001340> "A case collection of people with Dupuytren disease recruited from 2007 through plastic and hand surgery clinics in the Netherlands, with blood samples for DNA and surgeon-recorded clinical data such as age at onset, family history, bilateral and ectopic disease and recurrence, for genetic studies of Dupuytren disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001341> (<http://www.ebi.ac.uk/coho/COHO_0001341>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27449350") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29120849") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37582857") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001341> "A study of healthy young adults aged 18–30 of self-reported Caucasian, non-Hispanic ancestry with low levels of alcohol and drug use, recruited from the community at the University of Chicago and the University of Georgia in the United States, and from the Georgia site's undergraduate research pool, who completed a laboratory battery of impulsivity measures (delay discounting, response inhibition, risk-taking and impulsive personality traits) and gave saliva DNA for genotyping, to study the genetic basis of impulsivity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001342> (<http://www.ebi.ac.uk/coho/COHO_0001342>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22330960") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25452868") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001342> "A family-based study of Latinos of Mexican or Central American origin in the Los Angeles area, run jointly by Cedars-Sinai Medical Center and the Los Angeles Biomedical Research Institute at Harbor-UCLA Medical Center, which from 2007 recruited probands with type 2 diabetes and either diabetic retinopathy or diabetes of at least ten years' duration together with their siblings and parents, with retinopathy graded from fundus photographs, to study the genetics of diabetic retinopathy and other complications of diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001343> (<http://www.ebi.ac.uk/coho/COHO_0001343>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33513272") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37633302") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001343> "A worldwide programme, the first resource project of the Aligning Science Across Parkinson's initiative, that genotypes and sequences people with Parkinson's disease, and some controls, from existing and newly collected patient and cohort collections, working with established Parkinson's disease consortia and focusing on populations under-represented in genetic research, and shares the harmonised data to find genetic causes of and risk factors for typical and monogenic Parkinson's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001344> (<http://www.ebi.ac.uk/coho/COHO_0001344>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19910028") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30787307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34536413") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001344> "A case-control collection of self-reported African American children and adults with physician-diagnosed asthma and non-asthmatic controls from the Baltimore–Washington, DC metropolitan area, brought together by the Genomic Research on Asthma in the African Diaspora consortium from eight NIH-funded asthma studies and one study of healthy African Americans, to study genetic contributions to asthma and its disparities in people of African descent.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001345> (<http://www.ebi.ac.uk/coho/COHO_0001345>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26153726") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26193069") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35806883") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001345> "A multicentre observational study in the United States, solicited by the National Heart, Lung, and Blood Institute and run by a genomics and informatics centre with several clinical centres, that enrolled adults with sarcoidosis across defined clinical phenotypes and adults over 35 with the PiZZ or PiMZ alpha-1 antitrypsin genotypes, with questionnaires, chest CT, lung function tests, bronchoalveolar lavage and blood samples, to study the role of the lung microbiome and genome-wide gene expression in the two diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001346> (<http://www.ebi.ac.uk/coho/COHO_0001346>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21750674") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26367535") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38146367") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001346> "A collection of DNA samples, established in France in 1995, from HIV-1-infected people of European descent living in France with extreme courses of infection: long-term non-progressors (infected for more than eight years with CD4 T-cell counts above 500/mm3 and no symptoms) and rapid progressors. It is used to identify host genes associated with slow and rapid progression to AIDS, with genetic analyses comparing its members with seronegative French controls from another study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001347> (<http://www.ebi.ac.uk/coho/COHO_0001347>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17254403") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23186635") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32014069") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41117591") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001347> "A longitudinal twin study in Guangzhou, China, that from 2006 enrolled twin pairs aged 7 to 15 years from the population-based Guangzhou Twin Registry, living near the Zhongshan Ophthalmic Center, together with some of their parents or siblings. It collected DNA and baseline eye measurements, then examined the twins annually until 2018 for progressive traits such as cycloplegic refraction, axial length, height and weight, to study the genetic and environmental causes of common eye diseases, particularly myopia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001348> (<http://www.ebi.ac.uk/coho/COHO_0001348>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37524447") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001348> "A cohort of high myopes and hyperopes recruited in Guangzhou, China, one of three Chinese cohorts combined in a genome-wide association meta-analysis of ocular axial length.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001349> (<http://www.ebi.ac.uk/coho/COHO_0001349>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23263487") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24836286") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001349> "A hospital-based case-control study of colorectal cancer in Guangzhou, China. Its cases are patients with histopathologically confirmed colorectal cancer recruited at Sun Yat-sen University Cancer Center between 2002 and 2012, and its controls are cancer-free men and women recruited in the same period from the physical examination centres of several large hospitals in Guangdong. Its four case-control collections (Guangzhou-1 to Guangzhou-4) were genotyped for genome-wide association studies of colorectal cancer in East Asians.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001350> (<http://www.ebi.ac.uk/coho/COHO_0001350>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11075607") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8498644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001350> "A multicentre longitudinal study, established in 1988 at 14 hemophilia treatment centres in the United States, of boys and young men aged 6 to 19 years with moderate to severe hemophilia, HIV-infected through clotting factor concentrates or HIV-uninfected, with their non-hemophiliac, HIV-uninfected male siblings as a comparison group, followed until 1996/97 to study the impact of HIV on physical growth and sexual maturation, immune function, and neurological and neuropsychological functioning.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001351> (<http://www.ebi.ac.uk/coho/COHO_0001351>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38671141") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://husk.w.uib.no") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://husk-en.w.uib.no/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001351> "A population-based health study of residents of Hordaland County in Western Norway, begun in 1992-93 as the Hordaland Homocysteine Study by the Norwegian Health Screening Service, the University of Bergen and the Municipal Health Service in Hordaland, which invited residents by year of birth and place of residence, re-examined part of them together with further birth cohorts in 1997-99, and since 2018 has re-examined those born in 1950-51 who took part in both surveys, to study chronic diseases such as cardiovascular disease, cancer, osteoporosis, anxiety and depression and their prevention.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001352> (<http://www.ebi.ac.uk/coho/COHO_0001352>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31981300") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34226578") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36542383") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40410244") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001352> "A population-based cohort study of eye conditions, run by the Chinese University of Hong Kong since 2015, that recruits ethnic Chinese children aged 6 to 8 years from randomly selected primary schools across Hong Kong, together with their parents, and follows the children up, to determine the occurrence and development of refractive errors, strabismus, amblyopia and other eye disorders and their environmental and genetic determinants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001353> (<http://www.ebi.ac.uk/coho/COHO_0001353>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32722720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39508878") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT05282680") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001353> "A multicentre prospective cohort and biobank of adults with diabetes, started in 2014 and coordinated by the Chinese University of Hong Kong, which enrols people attending routine diabetes complication assessment at the diabetes centres of major public hospitals across Hong Kong, with the assessment methods of the Hong Kong Diabetes Register, and follows them for diabetes-related outcomes, to serve as a territory-wide diabetes register and biobank for epidemiological research and for the discovery and replication of genetic, epigenetic and other biomarkers of diabetes and its complications.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001354> (<http://www.ebi.ac.uk/coho/COHO_0001354>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40728933") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42324270") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001354> "A newly established community-based prospective cohort in Zhejiang Province, China, which since June 2021 has been enrolling participants from urban and rural areas at several project sites, among them people attending routine physical examinations, and collecting blood and serum at enrolment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001355> (<http://www.ebi.ac.uk/coho/COHO_0001355>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29674364") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001355> "A retrospective, population-based cohort of Koreans who had health check-ups at the Healthcare System Gangnam Center of Seoul National University Hospital in Seoul, South Korea, from October 2003, with repeated check-up data, advanced diagnostic imaging and record linkage for cancer and death, designed to investigate the association of diagnostic imaging results and biomarkers with the predisease stage of non-communicable diseases such as cancers and metabolic diseases in an average-risk population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001356> (<http://www.ebi.ac.uk/coho/COHO_0001356>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20813860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21711121") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36865011") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001356> "A population-based survey of Caucasian adults aged 40 years or older, randomly selected in 2006 from the patient lists of randomly chosen general practitioners in four areas of the Veneto region (Verona, Padova and Venice) in north-eastern Italy, with centralised laboratory measurement of kidney function and albuminuria, set up at the University of Verona to determine the prevalence of chronic kidney disease and its risk factors; two subsets of its participants were genotyped for genetic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001357> (<http://www.ebi.ac.uk/coho/COHO_0001357>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34861174") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35047858") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.theinternationalstutteringproject.com/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001357> "A continually recruiting collection of people with clinically ascertained developmental stuttering, assembled by the International Stuttering Project, a collaboration of researchers and clinicians in the United States, Australia and Ireland formed in 2020 to illuminate the genetic aetiology of stuttering, which recruits through stuttering clinics, research laboratories and stuttering associations in these countries and online and genotypes its participants at Vanderbilt University Medical Center.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001358> (<http://www.ebi.ac.uk/coho/COHO_0001358>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15364185") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15364186") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23202125") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37414411") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001358> "A standardised case-control study of first acute myocardial infarction, which from February 1999 to March 2003 enrolled patients presenting to hospital with a first myocardial infarction and age- and sex-matched hospital- or community-based controls without heart disease at 262 centres in 52 countries on every inhabited continent, to establish the importance of modifiable and psychosocial risk factors for myocardial infarction in all regions of the world.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001359> (<http://www.ebi.ac.uk/coho/COHO_0001359>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38224499") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001359> "A consortium established to study the host genetics of tuberculosis through collaborative, equitable data sharing, combining case-control genome-wide association studies from nine countries across Europe, Africa and Asia in a multi-ancestry meta-analysis of tuberculosis susceptibility.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001360> (<http://www.ebi.ac.uk/coho/COHO_0001360>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29220522") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33288918") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33692830") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001360> "A collection of 3D facial images, self-reported age, height, weight and ancestry, and DNA from volunteers recruited without restriction on ancestry (minors with a parent's or guardian's consent) in Indianapolis, Indiana and in Twinsburg, Ohio under one Indiana University-Purdue University Indianapolis ethics protocol, with support from the US National Institute of Justice, and genotyped to study the genetics of facial shape and of other visible traits such as head hair shape.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001361> (<http://www.ebi.ac.uk/coho/COHO_0001361>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18330919") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19228618") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20203262") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23755828") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001361> "A consortium of research groups in North and South America, Europe and Asia, formed with the Pharmacogenomics Knowledge Base (PharmGKB) as its data broker, that pools and curates the clinical and genetic data of warfarin-treated patients from its members' centres, to develop and evaluate pharmacogenetic algorithms for estimating the stable warfarin dose and to study the genetic determinants of warfarin dose across populations, including a genome-wide association study of African Americans from its US sites.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001362> (<http://www.ebi.ac.uk/coho/COHO_0001362>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15345109") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24943594") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26082817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35267517") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001362> "A breast cancer case-control study in Stockholm, Sweden, whose cases are consecutive breast cancer patients treated at the oncology departments of Huddinge and Söder hospitals from 1998 to 2000 and women with familial breast cancer without BRCA1 or BRCA2 mutations seen at the Department of Clinical Genetics of Karolinska University Hospital from 2000, and whose controls are blood donors from the same region, used to study inherited susceptibility to breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001363> (<http://www.ebi.ac.uk/coho/COHO_0001363>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33634021") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37340842") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38810984") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001363> "A hospital-based case-control study of gastric cancer at the National Cancer Center in Goyang, South Korea, that from March 2011 to December 2014 recruited patients recently diagnosed with gastric cancer at its Center for Gastric Cancer as cases and cancer-free people attending health-screening check-ups at its Center for Cancer Prevention and Detection as controls, with lifestyle and food-frequency questionnaires and blood DNA genotyped on an exome array, to study dietary and genetic risk factors for gastric cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001364> (<http://www.ebi.ac.uk/coho/COHO_0001364>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30529582") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35765848") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38514198") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001364> "A hospital-based case-control study of colorectal cancer at the National Cancer Center in Goyang, South Korea, whose cases are patients newly diagnosed with colorectal cancer at its Center for Colorectal Cancer from 2010 and whose controls are people attending the national health check-up programme at its Center for Cancer Prevention and Detection, with lifestyle and food-frequency questionnaires and genome-wide genotyping, contributing to the Asia Colorectal Cancer Consortium's studies of genetic susceptibility to colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001365> (<http://www.ebi.ac.uk/coho/COHO_0001365>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30514630") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40410244") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41732593") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001365> "A randomised, double-masked, placebo-controlled trial at the Chinese University of Hong Kong Eye Centre that from 2016 to 2017 enrolled children aged 4 to 12 with myopia in both eyes, limited astigmatism and documented myopic progression in the previous year, assigned them to nightly 0.05%, 0.025% or 0.01% atropine eye drops or placebo, and followed them in later phases (placebo switched to atropine, re-randomisation to continued treatment or washout, and longer-term follow-up), to evaluate the efficacy and safety of low-concentration atropine for slowing myopia progression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001366> (<http://www.ebi.ac.uk/coho/COHO_0001366>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37465325") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41168416") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT04491344") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001366> "An obesity-enriched cohort of children and adolescents from the Leipzig area, Germany, recruited through the paediatric obesity outpatient clinic of Leipzig University Medical Center and run by its Center for Pediatric Research, with oral glucose tolerance tests, serum and DNA samples collected at clinic visits and regular follow-up, some into adulthood, to identify genetic variants and biomarkers underlying childhood obesity and its metabolic consequences.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001367> (<http://www.ebi.ac.uk/coho/COHO_0001367>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38970920") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40209611") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001367> "An ongoing single-site, case-only cohort of patients who have undergone lung cancer surgery since 1999 at the Quebec Heart and Lung Institute (Institut universitaire de cardiologie et de pneumologie de Québec – Université Laval) in Quebec City, Canada, with diagnoses confirmed by pathology of the resected specimens, clinical data and consent to the institute's biobank, assembled by a translational research programme towards precision medicine in lung cancer and used for germline genetic and tumour molecular studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001368> (<http://www.ebi.ac.uk/coho/COHO_0001368>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:3300281") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33675224") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001368> "A prospective multicentre cohort study of gay and bisexual men with and without HIV-1 infection, first enrolled in 1984–1985 at sites in Baltimore/Washington DC, Chicago, Pittsburgh and Los Angeles in the United States, with later enrolment waves, and followed with interviews, physical examinations, laboratory testing and specimen banking every six months, to study the natural and treated history of HIV infection and AIDS and its risk factors; in 2019 it was combined with the Women's Interagency HIV Study into the MACS/WIHS Combined Cohort Study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001369> (<http://www.ebi.ac.uk/coho/COHO_0001369>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30420406") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35430354") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40046247") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001369> "A community-based targeted lung cancer screening programme in socioeconomically deprived areas of Manchester, England, run by Manchester University NHS Foundation Trust, which began as a pilot in 2016 and continued in later programmes. It invites ever-smokers registered with local general practices (aged 55–74 in the pilot, 55–80 later) to a nurse-led Lung Health Check on mobile units, with lung cancer risk calculation (PLCOm2012), symptom assessment, spirometry and smoking cessation advice, offers annual low-dose CT screening to those at high risk, and follows attendees for lung cancer outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001370> (<http://www.ebi.ac.uk/coho/COHO_0001370>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24689004") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26343387") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37845353") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001370> "An electronic medical record-linked biorepository at Mayo Clinic, begun in 2006, that archives DNA, plasma and serum and a questionnaire from consecutive adult patients with known or suspected atherosclerotic vascular disease (such as carotid artery stenosis, abdominal aortic aneurysm or peripheral arterial disease) referred for non-invasive vascular evaluation or exercise stress testing at the Mayo Clinic Gonda Vascular Center, ascertaining disease and comorbidities with electronic phenotyping algorithms, to discover genetic and circulating biomarkers of atherosclerotic vascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001371> (<http://www.ebi.ac.uk/coho/COHO_0001371>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/manchester-cancer-research-centre-biobank-2/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.mcrc.manchester.ac.uk/research/mcrc-biobank/about-the-mcrc-biobank/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001371> "A research tissue bank of the Manchester Cancer Research Centre, established in 2008 and run from The Christie NHS Foundation Trust, that collects tissue, blood and other samples, with consent to use them and data about the donors for research, from patients at four NHS trusts in Greater Manchester, mainly people undergoing surgery where cancer is a possible diagnosis, to supply samples for cancer research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001372> (<http://www.ebi.ac.uk/coho/COHO_0001372>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25892537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27347659") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32341527") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001372> "A French study of genetic susceptibility to cutaneous melanoma that recruited histologically confirmed melanoma patients of European ancestry, enrolled for a family history of melanoma, multiple primary melanomas or diagnosis before age 40, through a nationwide network of French dermatology departments and oncogenetic clinics between 1992 and 2011, with interview, clinical examination and questionnaire data on melanoma risk factors; in genome-wide association studies its cases were compared with population-based French controls.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001373> (<http://www.ebi.ac.uk/coho/COHO_0001373>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20337924") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8106967") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001373> "A prospective cohort study of the US National Cancer Institute of people with hemophilia or related congenital coagulation disorders at hemophilia treatment centres: the first Multicenter Hemophilia Cohort Study (MHCS-I), begun in 1982 at 16 centres in the United States and Europe, followed its participants to study the cause and natural history of HIV infection and AIDS, and the second (MHCS-II) invited all HCV-seropositive patients aged 13 or older at 52 participating centres in 2001–2005, to quantify the impact of hepatitis C, hepatitis B and HIV infections.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001374> (<http://www.ebi.ac.uk/coho/COHO_0001374>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30559051") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001374> "A UK open-label, randomised, phase 3 adaptive-design trial for patients with newly diagnosed multiple myeloma at 110 National Health Service hospitals in England, Wales and Scotland, recruiting from 2010, which assigned patients by age and fitness to intensive (transplantation) or non-intensive pathways and had three randomisation stages, including induction regimens and lenalidomide maintenance against observation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001375> (<http://www.ebi.ac.uk/coho/COHO_0001375>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21131037") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001375> "A UK Medical Research Council open-label randomised trial that enrolled adults aged 18 or older with newly diagnosed symptomatic multiple myeloma at 120 UK centres between May 2003 and November 2007, allocating them to an intensive pathway (induction followed by high-dose melphalan and autologous stem-cell transplantation) or a non-intensive pathway, and randomising first-line bisphosphonate (zoledronic versus clodronic acid) with induction chemotherapy and, later, maintenance treatment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001376> (<http://www.ebi.ac.uk/coho/COHO_0001376>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32390825") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001376> "A genomic database drawn from the second phase of the 2016 Mexican National Survey of Tobacco, Alcohol, and Drug Use (Encodat 2016), a nationwide household survey that excluded regions where most people speak a Native American language, whose participants answered questionnaires on substance use and psychiatric symptoms and gave buccal DNA samples, assembled by Mexico's National Institute of Psychiatry Ramón de la Fuente Muñiz and National Institute of Genomic Medicine for genetic studies of addiction and related psychiatric and pharmacogenetic traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001377> (<http://www.ebi.ac.uk/coho/COHO_0001377>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24927283") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29532581") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001377> "The Finnish arm of the multisite Nicotine Addiction Genetics consortium (Finland, Australia and the United States), in which twin pairs from the older Finnish Twin Cohort (born 1938–1957) concordant for ever-smoking, with priority to heavier smokers, were recruited in 2001–2005 together with their family members, mainly siblings, and assessed by a structured diagnostic psychiatric interview and DNA sampling to study the genetics of smoking behaviour and nicotine dependence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001378> (<http://www.ebi.ac.uk/coho/COHO_0001378>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23257114") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001378> "A Dutch study of individual differences in cognition and cognition-related disorders. It has a general-population sample of volunteers recruited through media advertisements or the Science Live research programme of the NEMO Science Center in Amsterdam, who performed cognitive tasks and completed an online questionnaire on life events, personality, environment and behaviour, and a genetically informative family sample of twins and their siblings.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001379> (<http://www.ebi.ac.uk/coho/COHO_0001379>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19918004") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21335371") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27647854") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001379> "A combined sample of two cohorts of young people with childhood-onset type 1 diabetes in England, analysed as one study in genome-wide association studies of diabetic kidney disease and type 1 diabetes. The Oxford Regional Prospective Study recruited children diagnosed with type 1 diabetes before the age of 16 in the Oxford Health Authority region in 1986–1996. The Nephropathy Family Study recruited adolescents aged 10–16 years with type 1 diabetes, and their parents, in four English regions in 2000–2005. Both cohorts were followed with annual measurements of HbA1c and the urinary albumin-to-creatinine ratio.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001380> (<http://www.ebi.ac.uk/coho/COHO_0001380>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19171721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19918004") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001380> "A longitudinal study of young people with type 1 diabetes in England, set up in 2000 within the Genetic Resource Investigating Diabetes (GRID) study of the JDRF/Wellcome Trust Diabetes and Inflammation Laboratory. In 2000–2005 it recruited adolescents aged 10–16 years who had developed type 1 diabetes before the age of 16 in East Anglia, Birmingham, Bristol and Oxford, together with their parents. It followed them with annual urinary albumin-to-creatinine ratios and HbA1c measurements for phenotypic and genetic study of the early pathogenesis of microalbuminuria.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001381> (<http://www.ebi.ac.uk/coho/COHO_0001381>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20716701") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30130155") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40249615") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001381> "A case-control study of breast cancer in women aged 18 or older, begun in 1998 in Ibadan, Nigeria. Women with invasive breast cancer are recruited at University College Hospital, Ibadan (from 2014 also at Lagos State University Teaching Hospital). Women without cancer are enrolled as controls from the hospital's outpatient clinics and from communities randomly selected in its catchment area. Enrolment was extended to Cameroon and Uganda in 2011 with the same questionnaire and protocol. It collects questionnaire data and biospecimens to study epidemiological and inherited risk factors for breast cancer in African women.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001382> (<http://www.ebi.ac.uk/coho/COHO_0001382>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.njrcentre.org.uk/about-the-njr/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001382> "A national registry of joint replacement surgery, set up by the Department of Health and the Welsh Government, that has recorded hip and knee replacements since April 2003 (ankle, elbow and shoulder replacements since 2010–2012) in NHS and independent hospitals in England and Wales, joined by Northern Ireland in 2013, the Isle of Man in 2015, Guernsey in 2019 and Jersey in 2025. Each procedure is recorded with the implant used and, with the patient's consent, the patient's details, to monitor the outcomes of implants, hospitals and surgeons.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001383> (<http://www.ebi.ac.uk/coho/COHO_0001383>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26626624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32725812") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.psoriasis.org/victor-henschel-biobank/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001383> "A biobank of biological samples, including DNA, and clinical information from volunteers in the United States with psoriasis or psoriatic arthritis and from unaffected controls. The National Psoriasis Foundation created it in 2006, with the financial backing of the Henschel family, to advance genetic research on psoriatic disease. Its samples were made available to researchers internationally for case-control and family studies until the biobank was retired in 2025.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001384> (<http://www.ebi.ac.uk/coho/COHO_0001384>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34995520") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37459304") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40118068") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40938633") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001384> "A population-based prospective cohort of Han Chinese adults, a sub-project of China's National Science & Technology Basic Research Project, recruited as volunteers in four sub-cohorts in Taizhou (Jiangsu province; 2015 and 2019), Zhengzhou (Henan province; 2017) and Nanning (Guangxi province; 2018). Participants were photographed and assessed for physical traits such as facial, ear and fingerprint features, and gave blood for genotyping and for DNA methylation, proteomic and metabolomic profiling, to study the genetic and molecular basis of human physical traits and common diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001385> (<http://www.ebi.ac.uk/coho/COHO_0001385>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.medrxiv.org/content/10.64898/2026.04.29.26350889v1.full-text") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001385> "A consortium formed in 2015 around the New York Genome Center, through which 41 ALS clinics and research institutions in the United States, the United Kingdom, the Netherlands, Greece and Israel contribute blood and post-mortem brain and spinal cord tissue from people with amyotrophic lateral sclerosis, other neurological diseases and non-neurological controls. The samples are whole-genome and RNA sequenced at the New York Genome Center and their clinical data harmonised into an openly accessible genomic resource for ALS research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001386> (<http://www.ebi.ac.uk/coho/COHO_0001386>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27899403") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37845353") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001386> "A case-control study of abdominal aortic aneurysm (AAA) in New Zealand. The Vascular Research Consortium of New Zealand recruited men and women with AAA (infrarenal aortic diameter of at least 30 mm on ultrasound or CT scan, about 80% after surgical repair), nearly all of Anglo-European ancestry, and elderly Anglo-European controls in whom AAA was excluded by abdominal ultrasound and who were also screened for peripheral and carotid artery disease. Its participants were genotyped in two genome-wide case-control sets for genetic studies of AAA.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001387> (<http://www.ebi.ac.uk/coho/COHO_0001387>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22104574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26098869") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26646264") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001387> "An international consortium that pools data from case-control studies of pancreatic cancer, conducted in North America, Europe, China and Australia, to study risk factors such as tobacco and alcohol use, diabetes and pancreatitis; cases and controls from several member studies were also genotyped together for a genome-wide association study of pancreatic cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001388> (<http://www.ebi.ac.uk/coho/COHO_0001388>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19483682") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28604732") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001307.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001388> "A case-control study of inherited susceptibility to testicular germ cell tumour at the University of Pennsylvania, Philadelphia, whose genome-wide association scan compared men with testicular germ cell tumour seen at the University of Pennsylvania Health System or Fox Chase Cancer Center with male controls from the Philadelphia region drawn from the PennCATH study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001389> (<http://www.ebi.ac.uk/coho/COHO_0001389>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39270623") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02327845") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://create.rarediseasesnetwork.org/research-study/8001") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001389> "A prospective, longitudinal observational study of the CReATe Consortium (Clinical Research in ALS and Related Disorders for Therapeutic Development), led from the University of Miami, that from 2014 enrolled patients with familial or sporadic amyotrophic lateral sclerosis or a related disorder (primary lateral sclerosis, progressive muscular atrophy, hereditary spastic paraplegia, frontotemporal dementia or multisystem proteinopathy), and some of their family members, at clinical sites in the United States, South Africa and Germany, with repeated motor, cognitive and functional assessments and collection of blood, urine and cerebrospinal fluid, to study phenotype-genotype relationships and develop biomarkers for therapy development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001390> (<http://www.ebi.ac.uk/coho/COHO_0001390>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19332184") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21685437") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36869765") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001390> "An international, phase III, randomised, double-blind trial funded by AstraZeneca that enrolled patients hospitalised with acute coronary syndrome (ST-elevation ACS scheduled for primary percutaneous coronary intervention, or non-ST-elevation ACS) at 862 centres in 43 countries between October 2006 and July 2008, to compare ticagrelor with clopidogrel for preventing death from vascular causes, myocardial infarction and stroke; blood samples from its genetic and biomarker substudies have been used for genome-wide association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001391> (<http://www.ebi.ac.uk/coho/COHO_0001391>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30036598") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32936291") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/plum/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001391> "A UK research study sponsored by Guy's and St Thomas' NHS Foundation Trust and run as the sister mechanistic study of the APRICOT trial of anakinra, which recruited people with pustular psoriasis through specialist dermatology centres across the UK, together with disease controls, healthy volunteers and patients' relatives, and collected blood and optional skin and hair samples to identify genes, immune pathways and treatment responses involved in pustular psoriasis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001392> (<http://www.ebi.ac.uk/coho/COHO_0001392>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25576993") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28705151") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40782885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001392> "A case-control genetic study of primary open-angle glaucoma led by the University of Pennsylvania's Scheie Eye Institute, which since July 2010 has enrolled self-identified Black adults (African American, African descent or African Caribbean) aged 35 or over from the Philadelphia region, mainly from University of Pennsylvania eye clinics and also through community screenings, two other Philadelphia ophthalmology practices and the Penn Medicine Biobank, with glaucoma specialists classifying them as cases, controls or glaucoma suspects, to identify genetic and clinical risk factors for the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001393> (<http://www.ebi.ac.uk/coho/COHO_0001393>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29955173") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36589292") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://projectmine.com/about/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001393> "An international collaboration of amyotrophic lateral sclerosis research groups from about 16 countries, coordinated from the ALS Centre Netherlands at University Medical Center Utrecht and begun with a pilot in Dutch patients, in which people with ALS and matched controls are recruited through the groups' ALS clinics under a common protocol with a standardised core clinical data set and their whole genomes sequenced, to identify and fine-map genetic risk loci for ALS and share the data with researchers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001394> (<http://www.ebi.ac.uk/coho/COHO_0001394>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19211639") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19956689") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001394> "A prospective multicentre observational study of children and adolescents aged 3–20 years with sickle cell disease, examined at steady state, and of controls without the disease matched by age, sex and ethnicity, recruited at Howard University Hospital and Children's National Medical Center in Washington, DC, and the University of Michigan in Ann Arbor, with echocardiography, six-minute walk tests and blood markers, designed to identify factors in pre-symptomatic children that predict pulmonary hypertension and other cardiopulmonary complications.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001395> (<http://www.ebi.ac.uk/coho/COHO_0001395>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12784275") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38849413") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/queen-square-brain-bank-for-neurological-disorders-qsbb-and-neurores/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001395> "A research tissue bank at the UCL Queen Square Institute of Neurology in London that archives brains and other tissue from donors across the UK, registered through its donor scheme during life, who had neurological and mostly neurodegenerative diseases such as Parkinson's disease, multiple system atrophy and progressive supranuclear palsy, and from neurologically normal controls, and supplies well-characterised tissue and data for research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001396> (<http://www.ebi.ac.uk/coho/COHO_0001396>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29511167") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31141105") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38494474") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001396> "A case-control study of calcific aortic valve stenosis at the Institut universitaire de cardiologie et de pneumologie de Québec – Université Laval, Canada, in which blood and aortic valve tissue are collected from patients undergoing aortic valve replacement for the disease and compared with controls (in its first phase, patients without valve disease undergoing cardiac surgery, mostly coronary artery bypass, at the same institute; in its second, CARTaGENE participants without valvular heart disease), to identify genetic susceptibility to the disease; its valve tissues, collected in 1998–2019, are also used for gene expression studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001397> (<http://www.ebi.ac.uk/coho/COHO_0001397>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30027669") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001397> "A cohort of children and adults with sickle cell disease, randomly sampled from the active patients of six care sites in the Brazilian states of Minas Gerais (Belo Horizonte, Juiz de Fora and Montes Claros), Rio de Janeiro, Pernambuco (Recife) and São Paulo and enrolled in 2013–2015 as the Brazilian component of the NHLBI REDS-III programme, with clinical data, a blood biorepository and genome-wide genotyping, to characterise the clinical and transfusion outcomes of sickle cell disease in Brazil and support genotype–phenotype studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001398> (<http://www.ebi.ac.uk/coho/COHO_0001398>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23301674") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36596879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001398> "The eye study of the offspring (Generation 2) of the Raine Study pregnancy cohort in Western Australia, in which participants completed a comprehensive eye assessment at the cohort's 20-year follow-up, including visual acuity, orthoptic assessment, cycloplegic autorefraction, ocular biometry and anterior and posterior segment photography, to determine the prevalence of and risk factors for eye disease in young adults and characterise their ocular biometric parameters.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001399> (<http://www.ebi.ac.uk/coho/COHO_0001399>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34706928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-01736-4/MediaObjects/41588_2024_1736_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001399> "A hospital-based case-control study of breast cancer conducted in the Philadelphia and Detroit metropolitan areas of the United States from 1999 to 2003, whose cases, diagnosed with invasive ductal breast cancer within 18 months of recruitment and over-sampled for diagnosis before age 40, were identified in the University of Pennsylvania Health System and the Karmanos Cancer Institute or recruited through local advertisement, with controls without breast cancer recruited in the same way.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001400> (<http://www.ebi.ac.uk/coho/COHO_0001400>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24799123") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000914") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001400> "A population-based cross-sectional study of adults with four Samoan grandparents, recruited from February to July 2010 in 33 villages across all four census regions of the independent nation of Samoa (Apia Urban Area, Northwest Upolu, the rest of Upolu and Savai'i), with anthropometry, fasting blood biomarkers, dietary, physical activity, health and socio-demographic data and genome-wide genotyping, to identify genetic variation that increases susceptibility to obesity and cardiometabolic traits in Samoans.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001401> (<http://www.ebi.ac.uk/coho/COHO_0001401>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33777099") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41669951") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ndownloader.figshare.com/files/45157534") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001401> "A hospital-based biobank of adult patients of Sanford Health, a rural health system of the Upper Midwest of the United States based in Sioux Falls, South Dakota, who since 2011 have elected to provide specimens for research, genotyped on the Illumina Global Screening Array and linked to the health system's clinical records for genetic studies such as of cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001402> (<http://www.ebi.ac.uk/coho/COHO_0001402>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16796729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37497783") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001402> "A cohort of children from 24 low-income areas of Salvador, Bahia, in north-eastern Brazil, first enrolled aged 0–3 years in 1997, 2001 and 2003 to evaluate the health effects of the city's sanitation programme and followed from 2005, at ages 4–11, with further surveys (questionnaires, anthropometry, stool, blood and house-dust samples, skin prick tests and, later, genome-wide genotyping), to study social, environmental, infectious, immunological and genetic risk factors for asthma and allergic diseases; it is the Brazilian study of the Social Changes, Asthma and Allergy in Latin America (SCAALA) programme.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001403> (<http://www.ebi.ac.uk/coho/COHO_0001403>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1546772") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:2261554") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001403> "A cohort of homosexual and bisexual men recruited in 1978–1980 at the San Francisco municipal sexually transmitted disease clinic for studies of sexually transmitted hepatitis B, whose stored serum specimens, follow-up examinations and questionnaires, and linkage to AIDS surveillance and death registries were later used to study the natural history, transmission and cofactors of HIV infection and AIDS.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001404> (<http://www.ebi.ac.uk/coho/COHO_0001404>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25140956") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39293085") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001404> "A multicentre, single-blind randomised clinical trial at 29 centres in the United States, Canada, France and the United Kingdom, which from December 2004 to May 2010 screened children aged 5 to 15 years with sickle cell anaemia (haemoglobin SS or Sβ0 thalassaemia) and no history of stroke by brain MRI, and randomly assigned those with silent cerebral infarcts to regular blood transfusions or standard care, to test whether transfusion therapy reduces the recurrence of cerebral infarcts.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001405> (<http://www.ebi.ac.uk/coho/COHO_0001405>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24663506") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41325371") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41695656") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001405> "A multicentre family- and population-based study of adults of European descent in Switzerland, in which index participants drawn at random from population samples in the city of Lausanne (the CoLaus study), the canton of Geneva (the Bus Santé study) and the canton of Bern (the cantonal phone directory) were recruited from December 2009 to April 2013 together with their first-degree relatives and re-examined about three years later, to study genetic and environmental determinants of blood pressure, kidney function and other cardiometabolic outcomes; it is the Swiss part of the European Project on Genes in Hypertension.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001406> (<http://www.ebi.ac.uk/coho/COHO_0001406>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28639505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34442380") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001406> "A clinical study of children and young people aged 5–18 of Slovenian origin with a physician diagnosis of mild-to-moderate persistent asthma and hospital records at tertiary health centres in Slovenia, part of them regularly treated with inhaled corticosteroids under medical supervision, with lung function measured after six weeks of inhaled corticosteroid treatment. It is one of the asthma studies enrolled in the Pharmacogenomics in Childhood Asthma (PiCA) consortium, which studies the genetics of response to asthma treatment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001407> (<http://www.ebi.ac.uk/coho/COHO_0001407>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24662965") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32499257") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34556688") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35501766") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39885687") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001407> "A cohort of healthy, full-term infants from low- to middle-income neighbourhoods of Santiago, Chile, recruited through community clinics in 1991–1996 for an iron-deficiency anaemia preventive trial or a neuromaturation study, and followed up through childhood, adolescence and adulthood in studies of nutrition, development, substance use and cardiometabolic risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001408> (<http://www.ebi.ac.uk/coho/COHO_0001408>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28135196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35621206") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40576378") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001408> "The Shanghai Women's Health Study and the Shanghai Men's Health Study taken together: two population-based prospective cohorts of middle-aged and elderly Chinese adults in urban Shanghai, China, which recruited women in 1996–2000 and men in 2002–2006 and whose data and biospecimens are often analysed jointly, for example in nested case–control and genome-wide association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001409> (<http://www.ebi.ac.uk/coho/COHO_0001409>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26007630") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27363682") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31363079") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001409> "A national biobank of samples from patients with multiple myeloma in Sweden, based at Skåne University Hospital in Lund, whose patients' germline DNA has been genotyped for genome-wide association studies of inherited susceptibility to multiple myeloma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001410> (<http://www.ebi.ac.uk/coho/COHO_0001410>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001410> "A case–control study of Korean patients with type 2 diabetes from the Diabetes Clinic of Seoul National University Hospital, South Korea, excluding patients positive for GAD antibodies, and of nondiabetic control subjects aged 60 or over with no history of diabetes in themselves or their first-degree relatives, used as a replication study in the Asian Genetic Epidemiology Network meta-analysis of genome-wide association studies of type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001411> (<http://www.ebi.ac.uk/coho/COHO_0001411>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24120345") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39885687") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41294090") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001411> "An ancillary study of the Hispanic Community Health Study/Study of Latinos that in 2012–2014 enrolled Hispanic/Latino children aged 8–16 whose parents or legal guardians took part in HCHS/SOL, at its field centres in the Bronx, Chicago, Miami and San Diego, United States, to examine how youth's lifestyle behaviours and cardiometabolic risk factors relate to acculturation, parenting and family behaviours, and psychosocial functioning.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001412> (<http://www.ebi.ac.uk/coho/COHO_0001412>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40050429") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3843/MediaObjects/41588_2017_BFng3843_MOESM307_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001412> "A cohort of adults with symptomatic (stage C) heart failure of different aetiologies, prospectively enrolled from the outpatient clinic of the Heart Institute of the University of São Paulo Medical School in São Paulo, Brazil. Its genotyped participants, with atrial fibrillation ascertained from electrocardiograms and medical records, have contributed to genome-wide association studies of atrial fibrillation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001413> (<http://www.ebi.ac.uk/coho/COHO_0001413>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33222050") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001413> "A preconception, longitudinal cohort of Chinese, Malay or Indian women aged 18–45 who intended to conceive and deliver in Singapore, recruited in February 2015–October 2017 through a preconception clinic at KK Women's and Children's Hospital and through public outreach, and followed with their children from before conception through pregnancy into early childhood. Its aim is to study how nutrition, lifestyle and maternal mood before and during pregnancy affect the offspring's epigenome, duration of gestation, fetal growth, and metabolic and neural phenotypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001414> (<http://www.ebi.ac.uk/coho/COHO_0001414>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30169202") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42241732") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001414> "A nationwide, prospective, multicentre cohort of neonates and children younger than 17 with blood culture-proven bacterial sepsis meeting criteria for systemic inflammatory response syndrome, enrolled from September 2011 to December 2015 at ten tertiary and regional paediatric hospitals in Switzerland, including all five university centres and all paediatric intensive care units, to study the incidence, clinical features and outcomes of paediatric sepsis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001415> (<http://www.ebi.ac.uk/coho/COHO_0001415>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25844303") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35773558") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001415> "A long-term, multicentre study funded by the US National Institute of Mental Health that enrolled outpatients aged 15 or older with any subtype of bipolar disorder at 22 academic medical centres in the United States and followed them over seven years. All participants entered a naturalistic standard care pathway, with randomized care pathways for acute and refractory depression, to answer questions about the effectiveness of treatments for bipolar disorder.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001416> (<http://www.ebi.ac.uk/coho/COHO_0001416>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24832787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33097092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02181101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001416> "An open-label, multicentre, randomised phase III trial in Germany, sponsored by Ludwig-Maximilians-University Munich, that enrolled adult patients with invasive early breast cancer at high risk of recurrence from 2005 to 2007 and compared, in a 2×2 factorial design, adjuvant FEC–docetaxel chemotherapy with or without gemcitabine and two versus five years of zoledronic acid, with an affiliated translational research programme on circulating tumour cells, serum tumour markers and pharmacogenetics.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001417> (<http://www.ebi.ac.uk/coho/COHO_0001417>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31294132") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38200428") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001417> "A prospective, biobank-linked registry at Seoul National University Hospital, South Korea, that since March 2016 has enrolled patients clinically diagnosed with renal cell carcinoma who undergo surgical treatment (ablation, or partial, radical or cytoreductive nephrectomy), collecting standardised clinical, pathological, quality-of-life and survival data and blood and tumour samples stored in the hospital's Human Biobank. It is the nephrectomy sub-cohort of the renal cell carcinoma arm (SUPER-RCC) of the Seoul National University Prospectively Enrolled Registry for Genitourinary Cancer (SUPER-GUC).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001418> (<http://www.ebi.ac.uk/coho/COHO_0001418>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37845353") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40649094") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001418> "A prospective, hospital-based longitudinal registry, started in 2019, of consecutive individuals with abdominal aortic aneurysm seen at the vascular and endovascular surgery units of the Hospital de la Santa Creu i Sant Pau and the Hospital del Mar in Barcelona, Spain, with aortic diameter measurements by CT or ultrasound, clinical data and DNA, RNA and plasma samples collected at follow-up visits, to study aneurysm growth and its predictors and to inform surveillance intervals.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001419> (<http://www.ebi.ac.uk/coho/COHO_0001419>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001419> "A consortium of research groups worldwide, established to increase sample sizes for genome-wide association meta-analysis of asthma, that pooled asthma genome-wide association studies of European, African, Japanese and Latino ancestry, among them studies of the GABRIEL, EVE, EAGLE, APCAT, CARe and Australian Asthma Genetics consortia, into a multi-ancestry meta-analysis, with a separate analysis of childhood-onset asthma, to identify asthma risk loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001420> (<http://www.ebi.ac.uk/coho/COHO_0001420>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33045403") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36958367") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38421999") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT04442334") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001420> "The part of the European NAFLD Registry, a prospective observational cohort of adults with non-alcoholic fatty liver disease sponsored by Newcastle University, made up of patients with biopsy-characterised NAFLD who were recruited at liver centres across Europe from 2010 to December 2017 in the FLIP, EPoS and HEPAmet studies of NAFLD pathogenesis, or came from earlier single-centre cohorts, and used by the IMI2 LITMUS project to evaluate non-invasive biomarkers. Patients recruited since 2018 form the Registry's separate LITMUS Study Cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001421> (<http://www.ebi.ac.uk/coho/COHO_0001421>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16248404") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26091809") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33150517") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001421> "A brain bank at the Tokyo Metropolitan Geriatric Hospital and Institute of Gerontology in Tokyo, Japan, which registers, with the consent of relatives, the brains and other tissues of consecutive autopsies of patients of the hospital, which provides community-based general and emergency care to older people, together with their clinical data, for clinicopathological and genetic research on ageing-related neurodegenerative, movement and cognitive disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001422> (<http://www.ebi.ac.uk/coho/COHO_0001422>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34013049") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42026177") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001422> "A biobank of the Menzies Institute for Medical Research at the University of Tasmania, run with the Royal Hobart Hospital and associated public and private eye clinics in Tasmania, Australia, that collects DNA samples and clinical information from Tasmanian residents diagnosed with a range of eye diseases, and from adults without eye disease recruited from the community as controls, to investigate eye disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001423> (<http://www.ebi.ac.uk/coho/COHO_0001423>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27923400") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28687077") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00985049") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001423> "A prospective cohort at Brigham and Women's Hospital in Boston, United States, begun in 2009, of adults undergoing aortic valve surgery with or without coronary artery bypass grafting, from whom left ventricular myocardium is biopsied at the apical vent site at the start and end of the ischaemic period of cardiopulmonary bypass, together with blood and DNA, to study how genetic variation shapes cardiac gene expression and its response to ischaemia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001424> (<http://www.ebi.ac.uk/coho/COHO_0001424>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34315208") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38849413") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001424> "A prospective longitudinal cohort of patients with Parkinson's disease, collected since 1997 from sequential new referrals to the Department of Neurology at St. Olav's Hospital in Trondheim, Norway (some followed since 1980), most living within about 50 miles of Trondheim, established mainly for genetic studies of Parkinson's disease and followed for disease course, cognition and survival.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001425> (<http://www.ebi.ac.uk/coho/COHO_0001425>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24647736") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32453789") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001425> "A population-based sample of Han Chinese individuals in Taiwan, selected at random from the healthy controls of the Taiwan Han Chinese Cell and Genome Bank, who had been recruited by stratified three-stage probability cluster sampling through the registry of the non-aboriginal townships and city districts of Taiwan. It was genotyped genome-wide with support from the Academia Sinica Genomic Medicine Multicenter Study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001426> (<http://www.ebi.ac.uk/coho/COHO_0001426>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19589173") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41663009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001426> "A population-based prospective cohort of adults from urban and rural areas of Taizhou, Jiangsu Province, China, initiated in 2007 by Fudan University and the Taizhou government, with baseline interviews, physical examinations, biochemical assays and collection of blood and other biospecimens, and follow-up through health records and repeated assessments, to study environmental and genetic risk factors for common non-communicable diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001427> (<http://www.ebi.ac.uk/coho/COHO_0001427>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29405273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38055889") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001427> "A UK national prospective cohort of men recruited in 2011–2019 through the NHS abdominal aortic aneurysm screening programmes of England, Wales and Scotland, which invite men in the year of their 65th birthday: men with a small aneurysm detected at screening, together with screened men without an aneurysm as controls, followed with annual postal questionnaires and, for those with an aneurysm, ultrasound surveillance scans, to study the growth of small abdominal aortic aneurysms.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001428> (<http://www.ebi.ac.uk/coho/COHO_0001428>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30297969") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35551307") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001428> "A type 2 diabetes case-control sample of Danish participants, undertaken by the Novo Nordisk Foundation Center for Basic Metabolic Research at the University of Copenhagen, that brings together people from several Danish studies, among them the Vejle Diabetes Biobank, Inter99, Health2006, Health2008 and DanFunD: cases with type 2 diabetes by self-report, anti-diabetic treatment or fasting or 2-hour plasma glucose, and controls with normal fasting and, where measured, 2-hour plasma glucose, genotyped genome-wide for genetic studies of type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001429> (<http://www.ebi.ac.uk/coho/COHO_0001429>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30075341") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01323803") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001429> "A registry of children and adults aged 6 months to 65 years with biopsy-confirmed eosinophilic esophagitis, enrolled at a single visit in 2011–2016 at the five US sites of the NIAID-funded Consortium of Food Allergy Research (in New York, North Carolina, Denver, Little Rock and Baltimore), with medical history questionnaires and blood or saliva samples genotyped at Cincinnati Children's Hospital Medical Center, to characterise the disease and establish its genetic basis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001430> (<http://www.ebi.ac.uk/coho/COHO_0001430>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36718543") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41715922") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001430> "An online study of adults aged 18 or over who speak English fluently, conducted by researchers at Vanderbilt University Medical Center in Nashville, Tennessee, and recruited worldwide, mainly through ResearchMatch and also through Vanderbilt newsletters and research mailing lists, Reddit, Facebook advertising and social media sharing. Participants completed web-based questionnaires on music engagement and auditory tasks of musical rhythm and speech perception, and those with a US mailing address were invited to return mail-in saliva samples for genotyping, to study the genetics of musicality.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001431> (<http://www.ebi.ac.uk/coho/COHO_0001431>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16960181") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23251661") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001431> "A family study of Hispanic children in Houston, Texas, conducted at the USDA/ARS Children's Nutrition Research Center of Baylor College of Medicine, which in 2000–2005 recruited families through a proband aged 4–19 with a BMI above the 95th percentile, together with the proband's siblings aged 4–19 and their parents. The children were phenotyped in depth (anthropometry, body composition by dual-energy X-ray absorptiometry, diet, physical activity, energy expenditure and metabolic risk factors) and followed up after one year, to map genetic and environmental contributions to childhood obesity and its comorbidities.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001432> (<http://www.ebi.ac.uk/coho/COHO_0001432>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21474410") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26237428") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001432> "A population-based collection of adult melanoma cases resident in Western Australia and diagnosed between January 2006 and September 2009, identified through the Western Australian Cancer Registry and invited by mail with their diagnosing doctor's consent, with registry pathology data, a telephone questionnaire on melanoma risk factors such as sun exposure and skin type, and blood samples for DNA, RNA and serum, established to investigate the genetic epidemiology of melanoma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001433> (<http://www.ebi.ac.uk/coho/COHO_0001433>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36210801") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39163621") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT03512080") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://warpath.info/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001433> "An observational study of adults taking warfarin at a stable maintenance dose for venous thromboembolism, atrial fibrillation or valvular heart disease, Black African and, in South Africa, also of mixed ancestry, recruited from June 2018 to March 2020 at outpatient clinics and hospital departments in Uganda and South Africa by the NIHR Global Health Research Group on warfarin anticoagulation in sub-Saharan Africa (the University of Liverpool, the Infectious Diseases Institute in Kampala and the University of Cape Town), with clinical data and blood samples for genotyping, to develop clinical and genetic warfarin dosing algorithms for sub-Saharan African patients.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001434> (<http://www.ebi.ac.uk/coho/COHO_0001434>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15084244") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27400983") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001434> "A population-based case-control study of contralateral breast cancer, designed to examine the joint roles of radiation exposure and genetic susceptibility, in which women diagnosed before age 55 with a first primary invasive breast cancer who later developed contralateral breast cancer were individually matched to women with unilateral breast cancer. Participants were identified through population-based cancer registries in the United States, Canada and Denmark and recruited in two phases, WECARE I (2001–2004) and WECARE II (2009–2012).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001435> (<http://www.ebi.ac.uk/coho/COHO_0001435>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40495383") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001435> "A case-control study of uveal melanoma run at the University of Pennsylvania for a genome-wide association study of the cancer and of differences between tumours with monosomy and disomy of chromosome 3, whose cases were patients treated at Wills Eye Hospital in Philadelphia, recruited through the UPenn Genetic Diagnostic Laboratory with blood samples and clinical and tumour data, and whose controls were selected from participants of the Penn Medicine Biobank.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001436> (<http://www.ebi.ac.uk/coho/COHO_0001436>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26620680") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41144382") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001436> "A cross-sectional national health examination survey of a random sample of residents of Poland aged over 20, drawn from the national identity card registry by three-stage sampling stratified by voivodeship, type of urbanisation and gender, and examined in 2013–2014 with face-to-face questionnaire interviews, physical examinations and blood samples to assess the prevalence, treatment and control of cardiovascular diseases and their risk factors. It continued the first WOBASZ survey of 2003–2005 with a new, independent sample and was coordinated by the Institute of Cardiology in Warsaw with medical universities in Gdansk, Katowice, Krakow, Lodz and Poznan.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001437> (<http://www.ebi.ac.uk/coho/COHO_0001437>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10097935") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18349042") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001437> "A population-based inception cohort of children diagnosed with type 1 diabetes before the age of 16 in the Oxford Health Authority region of the United Kingdom, established in 1986, who were recruited within three months of diagnosis until 1997 and followed prospectively with annual measurements of HbA1c and urinary albumin excretion to determine the natural course of microalbuminuria during childhood and adolescence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001438> (<http://www.ebi.ac.uk/coho/COHO_0001438>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20541252") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29343764") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41467-017-02662-2/MediaObjects/41467_2017_2662_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001438> "A consortium, formed in 2008, of cohort studies from the United Kingdom, the United States, Canada, the Netherlands, Germany, Sweden, Italy and Finland that meta-analyses their genome-wide association results for circulating 25-hydroxyvitamin D concentration in people of European descent, to identify genetic determinants of vitamin D status and insufficiency.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001439> (<http://www.ebi.ac.uk/coho/COHO_0001439>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27023175") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30150663") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001439> "A consortium established to combine the results of genome-wide association studies from cohorts in Europe, the United States, Canada and Australia, beginning with lifetime cannabis use, in order to identify the genetic variants underlying individual differences in cannabis use.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001440> (<http://www.ebi.ac.uk/coho/COHO_0001440>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18522740") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26106416") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000095.v3.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001440> "A cross-sectional, family-based study, the first cohort of the Center for Oral Health Research in Appalachia, that from 2003 recruited households with at least one biological parent–child pair (the child aged 1–18 years), together with all other household members, mainly in rural counties of central West Virginia and western Pennsylvania, United States, and assessed them by interviews, questionnaires, oral health and microbiological examinations and DNA collection to study how individual, family and community factors contribute to oral disease in Appalachia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001441> (<http://www.ebi.ac.uk/coho/COHO_0001441>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29207502") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30086711") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34347822") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35633918") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36599956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001441> "A longitudinal community-based observational study, commissioned by the town and conducted since 2011 by Kanazawa University, of residents of Shika Town on the Noto Peninsula, Ishikawa Prefecture, Japan, which aims to find ways of preventing lifestyle-related diseases: residents aged 40 and over in four model districts of the town complete questionnaires on diet, lifestyle and health and undergo a comprehensive health examination, with blood taken for biochemical tests and DNA.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001442> (<http://www.ebi.ac.uk/coho/COHO_0001442>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32720365") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35288444") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001442> "An ongoing multicentre genetic study led by the University of Leicester, United Kingdom, with support from the NIHR Leicester Biomedical Research Centre, that recruits patients with bicuspid aortic valve disease, identified from clinic and discharge letters and confirmed by cardiac imaging, together with relatives of patients with a family history of the disease, who are offered cascade echocardiographic screening, and collects clinical questionnaire data and blood for DNA to study the genetic causes of bicuspid aortic valve disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001443> (<http://www.ebi.ac.uk/coho/COHO_0001443>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31424497") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39271816") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01967511") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001443> "An observational case-control study at the Icahn School of Medicine at Mount Sinai, New York, United States, that since 2013 has enrolled adults with fibromuscular dysplasia and, since its expansion, adults with spontaneous coronary artery dissection or cervical artery dissection, together with healthy controls from the general population matched to the fibromuscular dysplasia cases by age and sex, and collects blood (DNA, plasma and serum) and skin-biopsy fibroblasts for a systems-genetics study of the key drivers of these arterial diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001444> (<http://www.ebi.ac.uk/coho/COHO_0001444>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26089906") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38404680") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001444> "A prospective mother–child cohort of the Center for Oral Health Research in Appalachia, a collaboration of the University of Pittsburgh and West Virginia University, that since 2011 has enrolled healthy, English-speaking, White pregnant women aged 18 and over in Pittsburgh, Pennsylvania, and across West Virginia, United States, and follows the women and their children from pregnancy into early childhood with oral examinations, questionnaires and oral microbial and DNA samples, to study the genetic, microbial and environmental factors in oral health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001445> (<http://www.ebi.ac.uk/coho/COHO_0001445>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26784699") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35272364") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001445> "A family-based study, run at the Hospital de la Santa Creu i Sant Pau in Barcelona, of extended Spanish families recruited from 2006 to 2010 through a proband with idiopathic thrombophilia (recurrent thrombosis, a spontaneous thrombosis with an affected first-degree relative, or thrombosis before age 45, with known biological causes excluded), each family having at least ten living members in three or more generations. It follows the GAIT-1 Project with a new set of families and studies the genetic basis of thrombosis risk and of intermediate phenotypes such as thrombin generation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001446> (<http://www.ebi.ac.uk/coho/COHO_0001446>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34211149") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001446> "A consortium of cohort studies that carries out genome-wide association meta-analyses of human reproductive behaviour, such as age at first sex, age at first birth, number of children ever born and childlessness, in people of European ancestry; after a first study of age at first birth and number of children ever born, it meta-analysed cohorts for age at first sex and age at first birth.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001447> (<http://www.ebi.ac.uk/coho/COHO_0001447>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41659846") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.cnr.it/it/comunicato-stampa/10010/parte-il-progetto-sergen-covid-19") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.irib.cnr.it/progetti/virus-memory/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001447> "A cohort of adult volunteers living across Italy, selected by the Italian National Research Council (CNR) from respondents to its EPICOVID-19 web survey who had agreed to be recontacted, who completed an online health and lifestyle questionnaire and gave blood at collection centres in several Italian regions, with repeat sampling about 5 and 10 months later, between May 2021 and February 2022. It was set up to study the serological and genetic factors in the immune response to SARS-CoV-2 infection and COVID-19 vaccination and in susceptibility to infection, and to build a serum and DNA biobank.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001448> (<http://www.ebi.ac.uk/coho/COHO_0001448>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26056183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33981951") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00785291") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001448> "A randomised, three-arm phase III trial led by the Cancer and Leukemia Group B, with the North Central Cancer Treatment Group (as N063H), the Eastern Cooperative Oncology Group and the Southwest Oncology Group taking part, that enrolled patients aged 18 or over with locally recurrent (stage IIIC) or metastatic (stage IV) breast cancer and no prior chemotherapy for metastatic disease at institutions in the United States from 2008 to 2011, comparing first-line paclitaxel once per week with nab-paclitaxel or ixabepilone once per week, each given with bevacizumab (optional from March 2011), with progression-free survival as the primary end point.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001449> (<http://www.ebi.ac.uk/coho/COHO_0001449>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17446795") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29695838") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31357728") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001449> "A longitudinal population study by investigators of Ghent University, Belgium, of men and women aged about 35 to 55 and free from overt cardiovascular disease, randomly sampled from the population lists of the twinned communities of Erpe-Mere and Nieuwerkerken (partners and relatives living there were also eligible), examined at a single local study site in 2002–2004 and again in 2011–2016, to study the interplay between ageing, cardiovascular haemodynamics and inflammation in preclinical cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001450> (<http://www.ebi.ac.uk/coho/COHO_0001450>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25010111") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33469137") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001450> "A consortium of population-based cohorts in Europe and Australia with genome-wide genotypes and morning plasma cortisol measured in blood sampled at a controlled time of day, funded by the Chief Scientist Office of the Scottish Government and the British Heart Foundation, that combines their participants of European ancestry in genome-wide association meta-analyses of morning plasma cortisol, formed to identify genetic determinants of inter-individual variation in hypothalamic-pituitary-adrenal axis function.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001451> (<http://www.ebi.ac.uk/coho/COHO_0001451>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41550966") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://abcd.amsterdamumc.nl/en/background-information-abcd-study/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001451> "A prospective, multi-ethnic birth cohort run from Amsterdam UMC that recruited pregnant women living in Amsterdam, the Netherlands, at their first prenatal visit between January 2003 and March 2004, and follows their children from pregnancy into young adulthood to identify factors in pregnancy and early childhood that explain later health and health inequalities, with particular attention to differences between ethnic groups.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001452> (<http://www.ebi.ac.uk/coho/COHO_0001452>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30362018") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001452> "An ongoing prospective cohort study, started in 2013 at the Alzheimer Center Amsterdam (Amsterdam UMC), of Dutch-speaking centenarians in the Netherlands who report being cognitively healthy, as confirmed by an informant, and since 2017 also of their first-degree family members and partners, set up to identify characteristics associated with escaping or delaying cognitive decline. Centenarians are visited at home for interviews, neuropsychological testing and blood sampling, followed annually until death, and offered post-mortem brain donation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001453> (<http://www.ebi.ac.uk/coho/COHO_0001453>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22773825") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://sisterstudy.niehs.nih.gov/English/2sis.htm") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001453> "A family-based study of young-onset breast cancer, conducted by the US National Institute of Environmental Health Sciences as an offshoot of the Sister Study, that in 2008–2010 enrolled women diagnosed with breast cancer before age 50 who had a sister in the Sister Study, together with their parents, and used the breast cancer-free Sister Study sisters as matched controls, to study genetic and environmental causes of young-onset breast cancer. The affected women are followed prospectively as breast cancer survivors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001454> (<http://www.ebi.ac.uk/coho/COHO_0001454>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32833998") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38495219") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38665804") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001454> "A longitudinal cohort of the Boston Center for Endometriosis (Boston Children's Hospital and Brigham and Women's Hospital, Boston) that in 2012–2018 enrolled adolescent and adult females aged 7–55 with surgically diagnosed endometriosis at the two hospitals, together with participants without endometriosis from their clinics and the local community, collected blood and urine samples at enrolment, and follows participants with annual questionnaires, compliant since 2014 with the World Endometriosis Research Foundation's EPHect standards.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001455> (<http://www.ebi.ac.uk/coho/COHO_0001455>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38741014") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41629673") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001455> "A consortium for genetic studies of breast cancer in women of African ancestry that pools whole-genome sequencing data, new Multi-Ethnic Genotyping Array genotypes and existing genotype data on breast cancer cases and controls from more than 20 studies in the United States, Africa and Barbados, among them the samples of the AMBER, ROOT, AABC and GAME-ON OncoArray consortia, for genome-wide association analyses and polygenic risk prediction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001456> (<http://www.ebi.ac.uk/coho/COHO_0001456>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21907864") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24388013") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001456> "An Australian research consortium, supported by the National Health and Medical Research Council, that pooled genotyped physician-diagnosed asthma cases and controls of European ancestry from several Australian studies, among them studies of the Queensland Institute of Medical Research, the Lung Institute of Western Australia, the Busselton Health Study and the Tasmanian Longitudinal Health Study, into a genome-wide association study of asthma first reported in 2011. Its data have since been used in international meta-analyses of asthma and allergic disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001457> (<http://www.ebi.ac.uk/coho/COHO_0001457>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001457> "A hospital-based, retrospective case-control study of prostate cancer at Aarhus University Hospital, Denmark, whose cases are men treated for prostate adenocarcinoma at the hospital's Department of Urology in Skejby and whose controls are age-matched men treated for myocardial infarction or undergoing coronary angioplasty with no prostate cancer diagnosis in the Danish Cancer Register or the Danish Cause of Death Register. It is one of the studies of the PRACTICAL consortium and was genotyped in the consortium's prostate cancer OncoArray project.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001458> (<http://www.ebi.ac.uk/coho/COHO_0001458>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32424353") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36271417") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001458> "A hospital-based breast cancer case-control study run from the Netherlands Cancer Institute – Antoni van Leeuwenhoek Hospital (NKI-AVL) in Amsterdam, whose cases are women diagnosed with breast cancer before age 50 (operable invasive cancers diagnosed in 1970–1994 in four Dutch hospitals and, for the iCOGS and OncoArray genotyping, patients diagnosed in 1995–2011 at the NKI-AVL) and whose controls are women recruited through the Sanquin blood bank. A familial arm, ABCS-F, adds breast cancer patients without BRCA1/2 mutations from the NKI-AVL family cancer clinic, and the study contributes to the Breast Cancer Association Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001459> (<http://www.ebi.ac.uk/coho/COHO_0001459>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27424772") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32424353") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001459> "The familial arm of the Amsterdam Breast Cancer Study, whose cases are breast cancer patients of any age without a pathogenic BRCA1 or BRCA2 mutation who were counselled and tested from 1995 at the family cancer clinic of the Netherlands Cancer Institute – Antoni van Leeuwenhoek Hospital in Amsterdam, and whose controls are healthy women from the general population recruited through the blood bank. The Breast Cancer Association Consortium lists it as a study separate from the main ABCS.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001460> (<http://www.ebi.ac.uk/coho/COHO_0001460>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25496151") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30554720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31263747") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001460> "A breast cancer biobank, headquartered at the Westmead Institute for Medical Research of the University of Sydney, that since 2005 has collected tumour tissue, blood and linked clinical and follow-up data from consenting patients with breast cancer at collection sites across Australia and provides them for research. It contributes breast cancer cases to the Breast Cancer Association Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001461> (<http://www.ebi.ac.uk/coho/COHO_0001461>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17849003") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36224396") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40691366") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001461> "A population-based sample of anonymous Danish blood donors used as population controls in genetic studies, contributed under the abbreviation DKctrl, with self-reported anthropometry, to the GIANT consortium's genome-wide meta-analyses of height and body mass index. The study its contributors cite for it recruited its healthy controls among blood donors of the Danish Blood Donor Corps in the Copenhagen area.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001462> (<http://www.ebi.ac.uk/coho/COHO_0001462>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20485516") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001462> "A population-based sample of unrelated adults from Adelaide, Australia, with measured central corneal thickness, whose members in the thinnest and thickest fifths of the distribution had equal volumes of whole blood pooled before DNA extraction and genotyped as case and control pools in a genome-wide association study of central corneal thickness.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001463> (<http://www.ebi.ac.uk/coho/COHO_0001463>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18621558") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22055160") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37845353") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001463> "A consortium of investigators in the United Kingdom, Australia and New Zealand formed to carry out a genome-wide association study of abdominal aortic aneurysm (AAA). Its GWAS dataset pools AAA cases with DNA from eight centres in those countries and from the UK Small Aneurysm Trial, recruited from inpatients, outpatient clinics and population screening programmes, and compares them with Wellcome Trust Case Control Consortium 2 controls from the 1958 British Birth Cohort and the UK National Blood Service.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001464> (<http://www.ebi.ac.uk/coho/COHO_0001464>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19404256") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19404257") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001464> "A case-control collection for genome-wide studies of autism spectrum disorders assembled at the Center for Applied Genomics of the Children's Hospital of Philadelphia, combining people with autism spectrum disorders from several US sites, diagnosed with the Autism Diagnostic Interview and Autism Diagnostic Observation Schedule and from simplex and multiplex families (with some of their parents and siblings), with control subjects without autism spectrum disorders from the Children's Hospital of Philadelphia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001465> (<http://www.ebi.ac.uk/coho/COHO_0001465>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17599422") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30262460") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001465> "A randomised, multicentre, double 2×2 factorial trial cohort of middle-aged and older adults with type 2 diabetes at high risk of cardiovascular events because of existing cardiovascular disease or additional risk factors, recruited in 2001–2005 through seven clinical networks in the United States and Canada with funding from the US National Heart, Lung, and Blood Institute. All participants were randomised to intensive or standard glycaemic control and, in two sub-trials, to intensive or standard blood-pressure control or to fenofibrate or placebo added to simvastatin, to test whether these strategies reduce major cardiovascular events.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001466> (<http://www.ebi.ac.uk/coho/COHO_0001466>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16256881") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18426997") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28247509") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40879028") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001466> "A population of adults in East Anglia and Wales, United Kingdom, selected at random from local general practice lists and open-access cardiovascular risk assessment clinics and studied by investigators in Cambridge and Cardiff, comprising healthy people as well as people with cardiovascular risk factors or disease, whose peripheral and central blood pressure, wave reflection and aortic pulse wave velocity were measured, with questionnaires and blood samples, to study vascular ageing, arterial stiffness and central blood pressure across the adult lifespan.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001467> (<http://www.ebi.ac.uk/coho/COHO_0001467>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26482880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33310085") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38727677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://gengastro.med.tu-dresden.de/suppl/alc_cirrhosis/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3417/MediaObjects/41588_2015_BFng3417_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001467> "A genome-wide association study of alcohol-related cirrhosis in people of European descent that meta-analysed two case–control data sets, one from Germany and one from the United Kingdom, comparing patients with alcohol-related cirrhosis with drinking controls to find genetic risk loci for the disease; its discovery results were published in 2015 and its summary statistics have been reused by later studies of cirrhosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001468> (<http://www.ebi.ac.uk/coho/COHO_0001468>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21826061") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30075734") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31796669") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34113784") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40908294") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001468> "A longitudinal cohort of healthy community-dwelling volunteers in middle and old age, recruited in Greater Manchester and Newcastle upon Tyne, England, between 1983 and the early 1990s by the University of Manchester's Age and Cognitive Performance Research Centre to chart trajectories of cognitive function in normal old age; participants took alternating batteries of cognitive tests every two years until 2003, with questionnaires on health and behaviour repeated until 2017. Blood was collected for DNA extraction, a Manchester subsample was physically examined and gave saliva, serum and plasma in 2003, and some participants donated their brains to the Manchester Brain Bank.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001469> (<http://www.ebi.ac.uk/coho/COHO_0001469>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28072414") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28468681") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39746340") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001469> "A longitudinal naturalistic cohort of outpatients with bipolar disorder, launched in 2005 by the Karolinska Institutet and the St. Göran bipolar outpatient clinic (the Affective Center) of Northern Stockholm Psychiatry in Stockholm, Sweden, with a second centre in Gothenburg from 2009, which consecutively enrols patients treated at these clinics, with age- and sex-matched population controls randomly selected by Statistics Sweden. It combines clinical ratings, cognitive testing, blood and cerebrospinal fluid sampling, brain imaging and genetics, with follow-up planned at 7 and 14 years, to identify predictors of long-term outcome in bipolar disorder.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001470> (<http://www.ebi.ac.uk/coho/COHO_0001470>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35383826") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37480051") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40614728") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001470> "A case–control cohort of people with sporadic early- or late-onset Alzheimer's disease and elderly controls screened for dementia, recruited from community and hospital settings in the United Kingdom between the early 2000s and 2020 with funding from the Medical Research Council, the Moondance Foundation and Health and Care Research Wales, and assessed with a standardised clinical and neuropsychological protocol. Its longitudinal clinical and cognitive data and blood samples support genome-wide genotyping, plasma biomarker and induced pluripotent stem cell studies of Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001471> (<http://www.ebi.ac.uk/coho/COHO_0001471>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19246701") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25332706") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29276677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32039844") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01351961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001471> "A single-centre cohort study at Nancy University Hospital, France, of older treated hypertensive patients with subjective memory complaints, recruited in the early 2000s through local press advertisements and general practitioners of the Inserm clinical investigation centre network, who had cognitive testing, brain MRI for white matter hyperintensities, measurements of arterial stiffness, carotid structure and endothelial function, and DNA and serum banking, and were re-examined about eight years later (ADELAHYDE-2), to identify genetic, environmental and vascular determinants of leukoaraiosis and cognitive decline.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001472> (<http://www.ebi.ac.uk/coho/COHO_0001472>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11889014") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28630210") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001472> "A longitudinal study of the determinants of arterial ageing in French adults of a Paris cohort followed at the Centre d'Investigations Préventives et Cliniques, re-examined years apart with measurements of aortic stiffness and carotid atherosclerosis, and with leukocyte telomere length measured at successive examinations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001473> (<http://www.ebi.ac.uk/coho/COHO_0001473>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25284319") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001473> "A case–control collection of the Psychiatric Genetics Unit of the Vall d'Hebron Research Institute (VHIR) in Barcelona, Spain, of adults of European origin with attention-deficit hyperactivity disorder, recruited and evaluated at the Hospital Universitari Vall d'Hebron, and of unrelated blood donors screened for lifetime ADHD symptoms, genotyped genome-wide to identify loci conferring susceptibility to persistent ADHD.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001474> (<http://www.ebi.ac.uk/coho/COHO_0001474>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11596665") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16075030") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21972410") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31967344") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001474> "A multinational randomised controlled trial with a 2×2 factorial design, conducted from 2001 by 215 collaborating centres in 20 countries in Asia, Australasia, Europe and North America among people with type 2 diabetes diagnosed at age 30 or older, aged 55 or older and with cardiovascular disease or at least one other cardiovascular risk factor, which compared a fixed combination of perindopril and indapamide with placebo, whatever the initial blood pressure, and an intensive gliclazide modified-release-based glucose control regimen targeting an HbA1c of 6.5% or less with standard glucose control, for their effects on major macrovascular and microvascular events; surviving participants were followed after the trial in ADVANCE-ON.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001475> (<http://www.ebi.ac.uk/coho/COHO_0001475>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20720431") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25372389") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31882626") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001475> "A biobank study at University Medical Center Utrecht and St. Antonius Hospital Nieuwegein, the Netherlands, set up in 2003 as a derivative of the Athero-Express, of patients undergoing open surgical repair of abdominal aortic and other arterial aneurysms, which stores aneurysm wall tissue collected during surgery together with blood, clinical data and three years of follow-up for cardiovascular events, to study aneurysm heterogeneity in relation to postoperative outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001476> (<http://www.ebi.ac.uk/coho/COHO_0001476>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28416818") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31113362") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32078373") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32814717") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001476> "A biobank and ongoing prospective registry of patients with atrial fibrillation from the arrhythmia clinic of the Department of Medicine I, University Hospital Munich, Ludwig-Maximilians-University, Germany, established within the Arrhythmia-Biobank-LMU with support from the German Federal Ministry of Education and Research, which collects blood samples and clinical data and follows patients for recurrence of atrial fibrillation after rhythm-control interventions such as catheter ablation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001477> (<http://www.ebi.ac.uk/coho/COHO_0001477>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34473249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37264683") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40737012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01288352") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001477> "An investigator-initiated, multicentre, parallel-group, open, blinded-outcome-assessment randomised trial sponsored by the Atrial Fibrillation Network (AFNET), which from July 2011 to December 2016 randomised patients with atrial fibrillation diagnosed within the previous year and cardiovascular risk factors, at 135 sites in 11 European countries, to early rhythm control therapy or usual care, to test whether early rhythm control prevents cardiovascular complications; its biosample substudy took blood at enrolment from consenting patients.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001478> (<http://www.ebi.ac.uk/coho/COHO_0001478>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17704113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20357380") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31152163") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001478> "The Danish part of the European Rational Approach for the Genetics of Diabetic Complications (EURAGEDIC) study: a case–control sample of adults with type 1 diabetes attending the outpatient clinic of the Steno Diabetes Center, Denmark, recruited from 1993 to 2000, with diabetic nephropathy (cases) or with persistent normoalbuminuria after more than 15 years of diabetes (controls), whose blood samples and clinical data were collected to study genetic risk factors for diabetic nephropathy and who were followed prospectively for mortality and cardiovascular and renal outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001479> (<http://www.ebi.ac.uk/coho/COHO_0001479>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16078860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17322880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768552") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001479> "An international consortium of autism genetics research groups at more than 50 centres in North America and Europe, initiated by the National Alliance for Autism Research (later Autism Speaks) and the US National Institutes of Health and formed from four existing consortia (the Autism Genetics Cooperative, the Autism Genetic Resource Exchange, the Collaborative Programs of Excellence in Autism and the International Molecular Genetic Study of Autism Consortium). It pools the families with autism spectrum disorder collected at its sites, diagnosed with the ADI-R and ADOS, for genome-wide linkage, copy number variation and association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001480> (<http://www.ebi.ac.uk/coho/COHO_0001480>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11452364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20955925") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702161") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001480> "A resource of biomaterials (cell lines, DNA and serum) and genetic and phenotypic data from families with autism spectrum disorder recruited from across the United States, mostly multiplex families with two or more affected members, whose diagnostic assessments (ADI-R and ADOS) and blood draws are done in the families' homes. It was established in 1997 by the Cure Autism Now Foundation and the Human Biological Data Interchange, is now managed by Autism Speaks, and makes its samples and data available to qualified researchers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001481> (<http://www.ebi.ac.uk/coho/COHO_0001481>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16749939") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346443") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001481> "A case-control study of adult glioma run by the University of California, San Francisco since 1991, whose cases are adults with newly diagnosed, histologically confirmed glioma: population-based cases living in six San Francisco Bay Area counties (Alameda, Contra Costa, Marin, San Francisco, San Mateo and Santa Clara), identified through the regional cancer registry's rapid case ascertainment, and, from 2002, clinic-based cases recruited at the UCSF Neuro-oncology Clinic. Its controls were found by random-digit dialling in the same counties and frequency-matched to cases on age, sex and ethnicity, and later drawn from UCSF clinics; it studies environmental, immunological and genetic risk factors for glioma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001482> (<http://www.ebi.ac.uk/coho/COHO_0001482>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2505/MediaObjects/41588_2013_BFng2505_MOESM12_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001482> "A hospital-based case-control study of colorectal cancer at Aichi Cancer Center in Nagoya, Japan, part of the centre's Hospital-based Epidemiologic Research Program (HERPACC): its first collection (Aichi-1) took colorectal cancer cases and cancer-free controls, frequency-matched on age and sex, from the first-visit outpatients enrolled in HERPACC-II in 2000–2005, and its second (Aichi-2) recruited further cases and matched controls at the same hospital. Both collections were genotyped for the Asia Colorectal Cancer Consortium's genome-wide association studies of colorectal cancer in East Asians.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001483> (<http://www.ebi.ac.uk/coho/COHO_0001483>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24343304") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25849024") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001483> "A consortium, funded by the US National Cancer Institute as a Program Project, that pools the questionnaire data, tumour tissue and DNA of four epidemiological studies of breast cancer in African American women in the United States (two case-control studies, the Carolina Breast Cancer Study and the Women's Circle of Health Study, and two cohorts, the Black Women's Health Study and the Multiethnic Cohort Study), with tumour subtyping, genotyping and data harmonisation done centrally in shared cores, to study the causes of breast cancer subtypes, especially oestrogen receptor-negative breast cancer, in African American women.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001484> (<http://www.ebi.ac.uk/coho/COHO_0001484>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001484> "A German case-control study of myocardial infarction whose cases were enrolled in 2004–2006 in a prospective multicentre registry at 4 heart centres and 6 cardiology departments in North Rhine-Westphalia, Lower Saxony and Mecklenburg-Western Pomerania: consecutive men younger than 65 admitted with ST- or non-ST-segment elevation acute myocardial infarction, all of whom underwent cardiac catheterisation and revascularisation. Its controls are participants of the population-based Dortmund Health Study, and the case-control sample served as a replication study for the Myocardial Infarction Genetics Consortium's genome-wide association study of early-onset myocardial infarction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001485> (<http://www.ebi.ac.uk/coho/COHO_0001485>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34000622") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38337670") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-021-03767-x/MediaObjects/41586_2021_3767_MOESM6_ESM.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001485> "A prospective cohort and biobank, set up by the Amsterdam UMC COVID study group, of adult patients admitted with COVID-19 from 2020 to the COVID-19 wards and intensive care units of the two academic hospitals of Amsterdam UMC (locations University of Amsterdam and Vrije Universiteit Amsterdam) in the Netherlands, which stores their clinical data and left-over and serially collected biological samples. Its genotyped patients, with controls, were contributed to the COVID-19 Host Genetics Initiative's genome-wide association meta-analyses of COVID-19.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001486> (<http://www.ebi.ac.uk/coho/COHO_0001486>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22245995") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27135401") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29533022") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40033780") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001486> "A nationwide population-based case-control study of endometrial cancer in Australia, run by a study group at QIMR Berghofer Medical Research Institute in Brisbane, whose cases are women aged 18–79 years newly diagnosed with histologically confirmed primary endometrial cancer between July 2005 and December 2007, identified through major hospitals and state cancer registries, and whose controls are women randomly selected from the Australian Electoral Roll and frequency-matched to the cases by state of residence and five-year age group. Participants gave risk-factor information by telephone interview and blood samples, and the cases were followed for survival, to study the causes and outcomes of endometrial cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001487> (<http://www.ebi.ac.uk/coho/COHO_0001487>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19348677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20975947") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23202125") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27150028") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001487> "A registry of patients with heart disease treated at the University of Lübeck hospital (University Hospital Schleswig-Holstein, Campus Lübeck) in Germany, with blood samples and clinical data, whose angiography sample (Angio-Lueb) consists of consecutive patients referred for coronary angiography and classified from the angiogram as having coronary artery disease or myocardial infarction or not. It has provided cases for genetic association studies of coronary artery disease, with population controls from KORA, and of dilated cardiomyopathy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001488> (<http://www.ebi.ac.uk/coho/COHO_0001488>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19525955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21347448") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26990204") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001488> "A multiple sclerosis case-control collection assembled for genome-wide association studies by the Australia and New Zealand Multiple Sclerosis Genetics Consortium (ANZgene), a collaboration of multiple sclerosis research groups in Australia and New Zealand, whose cases are people with multiple sclerosis of European ancestry from Australia and New Zealand; its genome-wide scan compared them with shared genotype data from controls of European ancestry from Australia, the United Kingdom and the United States, and further ANZgene cases and controls were collected for replication and fine-mapping, to identify genetic variants that influence susceptibility to multiple sclerosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001489> (<http://www.ebi.ac.uk/coho/COHO_0001489>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22171965") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23453510") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28513611") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://anzrag.com.au/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001489> "A prospective registry, run from the Department of Ophthalmology at Flinders University in Adelaide, of people with glaucoma referred by their eye practitioners across Australia and New Zealand: mainly people with advanced glaucoma (chiefly primary open-angle glaucoma with severe visual field loss), but also with less advanced, secondary and developmental glaucomas such as Axenfeld–Rieger malformation, whose clinical information and blood or saliva samples are collected by post. It was set up to find genetic risk factors for glaucoma blindness, and relatives of participants who carry myocilin mutations are offered cascade genetic testing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001490> (<http://www.ebi.ac.uk/coho/COHO_0001490>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24175302") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25349970") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41922350") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001490> "A population-based, retrospective study of the histological types of ovarian carcinoma in the province of Alberta, Canada, whose cases are women with ovarian carcinoma identified through the Alberta Cancer Registry and sampled by histological type (endometrioid, clear cell, mucinous and high-grade serous carcinoma), with archival tumour tissue and pathology reports reviewed by a gynaecological pathologist, clinical data abstracted from medical charts and yearly updates of vital status, to study molecular and clinical differences between the types and survival.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001491> (<http://www.ebi.ac.uk/coho/COHO_0001491>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22970239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23846169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29703916") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29892016") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37370825") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001491> "A national prostate cancer tissue bank in Australia, organised as a network of nodes in several states (among them Queensland, New South Wales and South Australia), that since the mid-2000s has collected radical prostatectomy tissue, blood, and clinical, pathology and follow-up data from men with prostate cancer, recruited through their urologists at diagnosis or before surgery at participating hospitals under common standard operating procedures, and supplies them for research, including genetic association studies of prostate cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001492> (<http://www.ebi.ac.uk/coho/COHO_0001492>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22234152") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702941") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32547728") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001492> "A population-based osteoporosis screening study and longitudinal cohort of women from the Aberdeen area of north-east Scotland, selected at random from Community Health Index (primary care) records within 25 miles of Aberdeen and invited, when aged 45–54, to a baseline health visit with bone density measurement in 1990–1994, with further visits in 1997–1999, when blood was taken for DNA, and in 2007–2011, to study bone loss, osteoporotic fracture risk and falls and their dietary, medical and genetic determinants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001493> (<http://www.ebi.ac.uk/coho/COHO_0001493>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20211292") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21870978") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27306620") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00412984") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001493> "A multinational, randomised, double-blind, double-dummy phase 3 trial, sponsored by Bristol-Myers Squibb and Pfizer, in which patients with atrial fibrillation or atrial flutter and at least one additional risk factor for stroke, enrolled from 2006 at over 1,000 centres in about 40 countries, were randomly assigned to apixaban or warfarin to test whether apixaban is non-inferior to warfarin in preventing stroke or systemic embolism. The trial ended in 2011; its participants' baseline blood samples and genotypes have since been used in biomarker and genetic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001494> (<http://www.ebi.ac.uk/coho/COHO_0001494>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16475872") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17205326") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22504420") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24516880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.gefos.org/?q=content/aarhus-osteoporosis-study-0") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001494> "A case–control study of osteoporosis at Aarhus University Hospital, Denmark, whose cases are osteoporotic men and women with vertebral fractures and low bone mineral density and whose controls are normal individuals, assessed with dual-energy X-ray absorptiometry, radiographs and bone turnover markers and genotyped for candidate-gene studies and for replication of genome-wide association findings on bone mineral density and fracture. It took part in the GENOMOS consortium and in the GEFOS meta-analysis of bone mineral density and fracture.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001495> (<http://www.ebi.ac.uk/coho/COHO_0001495>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25332818") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pure.amsterdamumc.nl/en/datasets/arrest-amsterdam-resuscitation-studies/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001495> "An ongoing prospective, community-based registry, set up in June 2005 and run from the Academic Medical Center in Amsterdam, of all out-of-hospital cardiac arrests with a resuscitation attempt by emergency medical services in the province of North Holland, the Netherlands, which collects resuscitation and ECG data, outcomes, medical history from hospitals and general practitioners, medication use from community pharmacies and, since July 2007, DNA from patients with documented ventricular tachycardia or fibrillation. It studies the outcome and the clinical, pharmacological, environmental and genetic determinants of out-of-hospital cardiac arrest, taking controls from pharmacy and general-practice databases for case–control analyses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001496> (<http://www.ebi.ac.uk/coho/COHO_0001496>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19734902") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23459933") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23990795") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29675612") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32274467") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001496> "A collaboration of United Kingdom Alzheimer's disease research groups at the Universities of Nottingham, Manchester, Southampton and Bristol, Queen's University Belfast and the Oxford Project to Investigate Memory and Ageing, funded by the Alzheimer's Research Trust (renamed Alzheimer's Research UK, after which the collaboration is called the ARUK Consortium), that pooled DNA from people with probable or post-mortem-confirmed Alzheimer's disease and from elderly controls into a DNA bank hosted at the University of Nottingham. Its cases and controls formed one of the sample collections of the GERAD genome-wide association study of Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001497> (<http://www.ebi.ac.uk/coho/COHO_0001497>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20401490") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21131975") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22436128") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001497> "A hospital-based case–control study of basal cell carcinoma of the skin and of bladder and kidney cancers in relation to low-level inorganic arsenic in drinking water, funded by the European Commission and conducted in 2002–2004 in counties of Hungary, Romania and Slovakia with arsenic in groundwater. Its incident cases, and its controls drawn from general surgery, orthopaedic and trauma in-patients of hospitals across the same areas and frequency matched to the cases by age, sex and county, all aged 30–79, were assessed for lifetime arsenic exposure, urinary arsenic metabolites and genetic susceptibility.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001498> (<http://www.ebi.ac.uk/coho/COHO_0001498>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18834502") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22503357") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23155182") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001498> "A study of young men aged 18–24 doing compulsory military service in Greece, randomly selected in successive waves during their first two weeks at the National Basic Air Force Training Center in Tripolis, who completed self-rated questionnaires on schizotypy and psychopathology and computerised neurocognitive and eye-movement tasks and gave DNA, a subgroup being reassessed at discharge two years later. Led from the University Mental Health Research Institute in Athens, it studies psychosis proneness and its cognitive and genetic correlates in the general population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001499> (<http://www.ebi.ac.uk/coho/COHO_0001499>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19803772") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20835236") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23116649") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23599335") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001499> "An Australian twin study of eye traits that combines twins, and some of their siblings, given an eye examination in the Twins Eye Study in Tasmania or in the Brisbane Adolescent Twin Study, with measures such as cycloplegic refraction, intraocular pressure and retinal photographs and with genome-wide genotypes, used in heritability, linkage and genome-wide association studies of ophthalmic traits. Its participants were recruited through the Australian Twin Registry, existing twin studies, schools and publicity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001500> (<http://www.ebi.ac.uk/coho/COHO_0001500>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19495570") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23136988") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26154343") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32321351") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001500> "A prospective clinical cohort of patients with coronary artery disease (at least one coronary stenosis over 30% on angiography), from stable angina to acute coronary syndromes, enrolled in successive phases from November 1996 to early 2004 when they underwent coronary angiography at the Department of Medicine II of the Johannes Gutenberg University Mainz or the Bundeswehrzentralkrankenhaus Koblenz, Germany, and followed for cardiovascular death and non-fatal myocardial infarction. It studies clinical, genetic and laboratory determinants of the progression and outcome of coronary atherosclerosis, and for genetic case–control analyses also recruited healthy controls from the Rhein-Main area.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001501> (<http://www.ebi.ac.uk/coho/COHO_0001501>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24081561") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2676/MediaObjects/41588_2013_BFng2676_MOESM11_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001501> "A genome-wide association case–control sample of unrelated Australians of European descent, one from each family, drawn from the twins and their relatives studied at the Queensland Institute of Medical Research (QIMR) who were genotyped genome-wide: migraine cases, identified in semi-structured telephone interviews based on the International Classification of Headache Disorders (ICHD-II) or by self-report and chosen preferentially for severity, and population controls from families with no known migraine. It is one of the studies of the International Headache Genetics Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001502> (<http://www.ebi.ac.uk/coho/COHO_0001502>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20860503") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22561531") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001502> "A genetic study of severe asthma in the United Kingdom, supported by Asthma UK, which recruited people of European ancestry with severe asthma (Global Initiative for Asthma classes 3–5) at UK centres and compared them in genome-wide association studies with controls without asthma or wheeze, to identify genetic determinants of severe asthma and whether they differ from those of mild to moderate asthma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001503> (<http://www.ebi.ac.uk/coho/COHO_0001503>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39572784") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001503> "A case–control dataset for genome-wide association studies of dilated cardiomyopathy assembled at Amsterdam UMC, the Netherlands. Its cases are adult index patients referred by secondary or tertiary cardiologists to Amsterdam UMC for genetic testing for dilated cardiomyopathy, with the diagnosis confirmed from the medical chart and a left ventricular ejection fraction below 50%, and its controls are unrelated participants of the Netherlands Twin Register.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001504> (<http://www.ebi.ac.uk/coho/COHO_0001504>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://cdn-links.lww.com/permalink/jsn/c/jsn_30_10_2022_12_07_salem_2019030218_sdc1.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001504> "A clinic-based cohort study of patients with type 1 diabetes in the state of Salzburg, Austria, initiated in 2012 as the Austrian study of the International Diabetic Nephropathy Consortium (InterDiane), which follows the protocol of the Finnish Diabetic Nephropathy Study to identify risk factors for diabetic nephropathy and other chronic complications of type 1 diabetes. Patients are recruited consecutively at the outpatient departments of Paracelsus Medical University Hospital Salzburg and Diakonissen-Wehrle Hospital Salzburg, with clinical data drawn mainly from the Type 1 diabetes Registry of the state of Salzburg, and are re-examined every 1 to 1.5 years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001505> (<http://www.ebi.ac.uk/coho/COHO_0001505>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19089808") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20801717") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24964207") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30232950") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001505> "A case–control genetic association study of bipolar disorder in the United Kingdom, funded by GlaxoSmithKline, whose cases are people with bipolar disorder recruited in London and diagnosed with the Schedules for Clinical Assessment in Neuropsychiatry (SCAN) interview and the Operational Criteria Checklist, and whose controls are ethnically matched subjects recruited in the UK; its control group has also served as UK controls in genome-wide association studies of other disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001506> (<http://www.ebi.ac.uk/coho/COHO_0001506>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25619230") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001506> "A brain and body donation programme and clinicopathological study of ageing and neurodegenerative disorders at Banner Sun Health Research Institute in Arizona, United States, started in 1987. Its participants, mostly cognitively normal volunteers from the retirement communities of metropolitan Phoenix together with people recruited because they have Alzheimer's disease, Parkinson's disease or cancer, receive standardized general medical, neurological, neuropsychological and movement-disorder assessments during life and, for most, a full pathological examination after death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001507> (<http://www.ebi.ac.uk/coho/COHO_0001507>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34214236") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001507> "A community-based prostate cancer risk-screening study in the United Kingdom, coordinated by the Institute of Cancer Research, that invites men of European ancestry via their general practitioners to undergo a germline genetic profile test of prostate cancer risk single nucleotide polymorphisms. Men in the highest genetic-risk stratum are offered MRI-led prostate screening and targeted biopsy; the study began with a feasibility pilot before opening to wider recruitment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001508> (<http://www.ebi.ac.uk/coho/COHO_0001508>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19879194") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22190364") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001508> "A collection of patients with relapsing–remitting multiple sclerosis or a clinically isolated syndrome with MRI signs of demyelination, assembled by Bayer Schering Pharma from four of its clinical trials: three studies of interferon beta-1b (BENEFIT, BEYOND and the 16-year long-term follow-up of the pivotal interferon beta-1b trial in relapsing–remitting multiple sclerosis) and one of a CCR1 antagonist. It was genotyped genome-wide and used as multiple sclerosis cases in genetic studies of susceptibility.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001509> (<http://www.ebi.ac.uk/coho/COHO_0001509>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17030683") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19696694") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29309628") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31954177") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31969597") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001509> "A birth cohort of mother–child pairs recruited at delivery in the 2000s from women with singleton pregnancies giving birth consecutively at the obstetrics department of the Charité university hospital in Berlin, Germany, with maternal blood, umbilical cord blood, placentas and birth measurements collected at birth. It is used to study maternal and fetal influences, including genetic ones, on birth weight, pregnancy outcomes and maternal physiology in pregnancy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001510> (<http://www.ebi.ac.uk/coho/COHO_0001510>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16257342") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19153073") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22768030") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26884359") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature24284/MediaObjects/41586_2017_BFnature24284_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001510> "A UK case-control study of breast cancer, led by investigators at the Institute of Cancer Research and the London School of Hygiene and Tropical Medicine, which in 2001–2008 recruited women with bilateral breast cancer identified through English and Scottish cancer registries and breast cancer clinics, and clinic patients with breast cancer and at least two affected female first-degree relatives, together with controls who were friends or non-blood relatives of the cases. It is one of the studies of the Breast Cancer Association Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001511> (<http://www.ebi.ac.uk/coho/COHO_0001511>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39218908") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001511> "A cohort of participants drawn from the customer base of Genomelink, a direct-to-consumer genetic-traits testing platform, who provided informed consent and completed surveys online as part of the Biobank of the Americas.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001512> (<http://www.ebi.ac.uk/coho/COHO_0001512>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17722095") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19917125") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26956414") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001512> "A population-based case-control study of non-Hodgkin lymphoma in British Columbia, Canada, which invited residents of Greater Vancouver and Greater Victoria aged 20–79 with non-Hodgkin lymphoma diagnosed from March 2000 to February 2004, identified through the BC Cancer Registry (excluding HIV-positive and post-transplant cases), together with population controls from the Client Registry of the British Columbia Ministry of Health frequency-matched to the cases on sex, age and area of residence, to study environmental and genetic risk factors for the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001513> (<http://www.ebi.ac.uk/coho/COHO_0001513>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27931859") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33079599") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39987058") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://bcmj.org/articles/british-columbia-familial-hypercholesterolemia-registry") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001513> "A registry of people with clinically diagnosed heterozygous familial hypercholesterolaemia in British Columbia, Canada, based at the Healthy Heart Program Prevention Clinic of St. Paul's Hospital in Vancouver, which enrols clinic patients meeting the Dutch Lipid Clinic Network criteria, invites their relatives for evaluation and follows adult participants prospectively as an open observational cohort. Set up as the first such registry in Canada to improve the identification and management of the condition, it is also used to study its cardiovascular outcomes and genetic causes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001514> (<http://www.ebi.ac.uk/coho/COHO_0001514>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11018378") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15642171") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26174520") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29244822") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.bcfamilyregistry.org/for-participants/participating-sites") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001514> "The New York site of the Breast Cancer Family Registry, known as the Metropolitan New York Registry and run from Columbia University in New York City, which from 1995 enrolled families with breast or ovarian cancer through clinical and community settings in the New York metropolitan area (New York, New Jersey and Connecticut), including Ashkenazi Jewish and minority families, when a woman had breast or ovarian cancer before age 45 or both cancers, a man had breast cancer, several relatives were affected or a BRCA1 or BRCA2 mutation was known. Affected and unaffected probands and their relatives gave family-history and epidemiological questionnaires and blood samples and are contacted annually for follow-up, for studies of the genetic epidemiology of breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001515> (<http://www.ebi.ac.uk/coho/COHO_0001515>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26174520") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.bcfamilyregistry.org/for-participants/participating-sites") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001515> "The Philadelphia site of the Breast Cancer Family Registry, run from Fox Chase Cancer Center in Philadelphia, Pennsylvania, which from 1996 enrolled families with breast or ovarian cancer through family cancer clinics and community outreach in the Philadelphia area, including Ashkenazi Jewish and minority families, when a woman had breast or ovarian cancer before age 35, both cancers, or bilateral breast cancer first diagnosed before 50, a man had breast cancer, affected relatives spanned two generations or a BRCA1 or BRCA2 mutation was known. Affected and unaffected probands and their relatives gave family-history and epidemiological questionnaires and blood samples and are contacted annually for follow-up, for studies of the genetic epidemiology of breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001516> (<http://www.ebi.ac.uk/coho/COHO_0001516>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26174520") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26538066") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.bcfamilyregistry.org/for-participants/participating-sites") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001516> "The Utah site of the Breast Cancer Family Registry, run from the Huntsman Cancer Institute at the University of Utah in Salt Lake City, which from 1996 enrolled families with breast or ovarian cancer through family cancer clinics and community outreach in the Salt Lake City area, and later further families carrying BRCA1 or BRCA2 mutations, when a woman had breast or ovarian cancer before age 45 or both cancers, a man had breast cancer, three relatives in two generations were affected (one before age 45) or a BRCA1 or BRCA2 mutation was known. Affected and unaffected probands and their relatives gave family-history and epidemiological questionnaires and blood samples and are followed up by annual contact and by linkage to population-based cancer registries, for studies of the genetic epidemiology of breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001517> (<http://www.ebi.ac.uk/coho/COHO_0001517>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12791629") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17921364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22479550") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23790346") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7030223") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001517> "A cohort of children born consecutively from March 1972 to October 1974 in the towns of Barry and Caerphilly, South Wales, whose mothers were recruited early in pregnancy through general practitioners into a randomised controlled trial, set up in 1972 by the Medical Research Council Epidemiology Unit (South Wales) and the Welsh National School of Medicine in Cardiff, of milk tokens for pregnant women and their children up to five years of age, with the children examined by trained nurses at intervals from birth to five years. The children who completed the trial were traced and re-examined at 23–27 years of age in 1997–1999 to study how birth size, infant feeding, early growth and childhood illness relate to adult blood pressure, adiposity, insulin resistance, haemostatic factors and lung function.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001518> (<http://www.ebi.ac.uk/coho/COHO_0001518>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20567021") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21952991") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29324747") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37451831") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001518> "A population-based case-control study of breast cancer in northern Israel, conducted by the Clalit National Cancer Control Center in Haifa with family medicine, surgery, pathology and oncology teams across the region, which since January 2000 has enrolled consecutively diagnosed breast cancer patients living in a defined area of northern Israel and cancer-free controls randomly selected from the Clalit Health Services register of insured people in the same area, matched on age, ethnic group and primary care clinic. Participants are interviewed about their medical history, medication use and health habits and give a blood sample, for studies of breast cancer risk factors, including genetic ones.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001519> (<http://www.ebi.ac.uk/coho/COHO_0001519>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27346685") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27346686") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34925446") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001519> "An international consortium of cohort studies and biobanks, organised in red blood cell, white blood cell and platelet working groups, that meta-analyses genetic associations with blood-cell counts and indices in participants of European, African, Hispanic/Latino, East Asian and South Asian ancestry, first with exome-array genotypes and later (its second phase, BCX2) with genome-wide imputed data, to identify common and rare variants that influence blood-cell traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001520> (<http://www.ebi.ac.uk/coho/COHO_0001520>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27135401") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001520> "A single-centre case-control study of endometrial cancer at the University Hospital Erlangen in Bavaria, Germany, conducted between 2002 and 2008 to investigate genetic and epidemiological risk factors for endometrial cancer, whose cases were incident cases referred to the hospital by surrounding practitioners or prevalent cases approached during follow-up care after treatment there for primary endometrial cancer, with epidemiological information from a structured interview questionnaire and clinical data from health records.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001521> (<http://www.ebi.ac.uk/coho/COHO_0001521>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19496022") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20388089") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20507630") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25773008") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001521> "A longitudinal study of ageing by the Belfast Longevity Group of Queen's University Belfast, Northern Ireland, of 'elite' octogenarians and nonagenarians, and some centenarians: community-living, apparently well, independently mobile and mentally competent people recruited through their general practitioners in the Greater Belfast area and seen at home by a research nurse, who took their medical history, anthropometric and blood pressure measurements and blood samples for DNA and laboratory tests, with nutrition and lifestyle questionnaires, to study the immunological, cardiovascular, nutritional and genetic factors of healthy ageing and longevity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001522> (<http://www.ebi.ac.uk/coho/COHO_0001522>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21403675") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24958192") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35379992") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40078479") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001522> "A case-control cohort for genetic studies of Alzheimer's disease, drawn from a prospective study of Alzheimer's disease in Flanders, Belgium, whose genetic studies are run from the University of Antwerp: unrelated patients with early- or late-onset possible or probable Alzheimer's disease, diagnosed by consensus of at least two neurologists at the memory clinics of the Hospital Network Antwerp (Middelheim and Hoge Beuken) and the University Hospitals Leuven and at other neurology centres of the Belgian Neurology (BELNEU) consortium, and healthy unrelated control individuals from Belgium, patients' partners or community volunteers, with blood samples for DNA, cell lines and plasma and, for some patients, cerebrospinal fluid biomarkers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001523> (<http://www.ebi.ac.uk/coho/COHO_0001523>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15539711") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000946.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001523> "A family study begun in 1994 at Brigham and Women's Hospital, Boston, to find genetic determinants of chronic obstructive pulmonary disease other than alpha-1 antitrypsin deficiency, which enrols extended pedigrees, mainly in New England, ascertained through probands with severe COPD (FEV1 at most 40% predicted) before age 53 and without severe alpha-1 antitrypsin deficiency, recruited from lung transplant and general pulmonary clinics, together with their first- and second-degree relatives aged 10 years or older.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001524> (<http://www.ebi.ac.uk/coho/COHO_0001524>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23590571") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001524> "A population-based, 2×2 factorial, double-blind randomised controlled chemoprevention trial in Bangladesh that enrolled adults with manifest arsenical skin lesions from the Narayanganj, Comilla, Noakhali and Chandpur districts, through field offices in Araihazar and Matlab, between April 2006 and August 2009, and gave them vitamin E (alpha-tocopherol), selenium (L-selenomethionine), both or placebo for six years to test the prevention of non-melanoma skin cancer, with all-cause and cancer mortality, diabetes and oxidative stress biomarkers as secondary endpoints.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001525> (<http://www.ebi.ac.uk/coho/COHO_0001525>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26287763") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33947654") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41360000") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42252839") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001525> "A population-based longitudinal cohort of self-identified Black women diagnosed with invasive breast cancer at age 50 or younger, identified through the state cancer registries of Florida and Tennessee (diagnoses from 2005 to 2018; its first phase recruited women diagnosed in Florida in 2009–2012), who completed a questionnaire on sociodemographic, reproductive, epidemiologic and lifestyle factors, released their medical records and tumour tissue and gave saliva for germline genetic testing, now based at Vanderbilt University Medical Center, to study the causes, inherited predisposition, treatment and survival of breast cancer, including triple-negative breast cancer, in young Black women.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001526> (<http://www.ebi.ac.uk/coho/COHO_0001526>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23544012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28448241") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29058716") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34320204") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001526> "A collection of carriers of BRCA1 and BRCA2 pathogenic variants from families seen in clinical cancer genetics services in Lithuania and Latvia, gathered by a collaboration of Lithuanian (BFBOCC-LT) and Latvian (BFBOCC-LV) hereditary breast and ovarian cancer research groups and contributed as one study to the Consortium of Investigators of Modifiers of BRCA1 and BRCA2, for studies of genetic modifiers of cancer risk in carriers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001527> (<http://www.ebi.ac.uk/coho/COHO_0001527>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30452415") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001527> "A longitudinal brain-donation cohort in the United Kingdom, established in 2008 with funding from Alzheimer's Research UK and the Alzheimer's Society, of volunteers with dementia and volunteers without cognitive impairment (the latter aged 65 or over, apart from spouses or partners of participants with dementia), recruited through a network of six dementia research centres (King's College London, Bristol, Manchester, Oxford, Cardiff and Newcastle) and their university brain banks, who undergo standardised clinical and psychometric assessments during life and have consented to donate their brains for dementia research after death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001528> (<http://www.ebi.ac.uk/coho/COHO_0001528>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23483904") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25229638") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27418025") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32954013") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001528> "A prospective longitudinal study based at the University of Edinburgh of young people aged 16–25 at entry who were well but at high familial risk of mood disorder, having at least one first-degree or two second-degree relatives with bipolar I disorder (identified through patients with bipolar I disorder referred by psychiatrists across Scotland), and of unrelated controls with no personal or family history of bipolar disorder drawn from their social networks, assessed clinically and with brain MRI on three occasions about two years apart to study changes that precede the onset of mood disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001529> (<http://www.ebi.ac.uk/coho/COHO_0001529>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18717640") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22574126") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27725671") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30787307") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001529> "A family-based study of asthma and schistosomiasis in five rural communities of the district of Conde, Bahia, north-eastern Brazil, an area endemic for Schistosoma mansoni about 200 km north of Salvador, in which residents aged 5 to 85, most of them members of two large pedigrees, were enrolled by whole-population ascertainment from July to September 2004 by the Federal University of Bahia and Johns Hopkins University, with later follow-up visits, to study the genetic control of total serum IgE, S. mansoni infection intensity and asthma; it is one of the studies of the Consortium on Asthma among African-ancestry Populations in the Americas (CAAPA).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001530> (<http://www.ebi.ac.uk/coho/COHO_0001530>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35042283") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001530> "A prospective, longitudinal, multicentre biobank cohort of older adults with cognitive complaints (subjective cognitive decline, mild cognitive impairment, Alzheimer's disease, vascular and other dementias) enrolled from October 2016 to December 2020 at five South Korean university hospitals (Ajou University Hospital, Samsung Medical Center, Inha University Hospital, Pusan National University Hospital and Chonnam National University Hospital), planned and funded by the Korea Disease Control and Prevention Agency for the Korea Biobank Project to bank biospecimens and data for research on Alzheimer's disease, chronic cerebrovascular disease and mixed pathology; participants have clinical and neuropsychological assessments and blood tests, subsets have brain MRI, amyloid PET, Korea Biobank Array genotyping, actigraphy and skin fibroblast sampling, and follow-up is planned annually.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001531> (<http://www.ebi.ac.uk/coho/COHO_0001531>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32424353") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001531> "A case-control study of breast cancer in the West of Ireland whose cases are unselected breast cancer patients recruited from University College Hospital Galway and surrounding hospitals in the West of Ireland since 2001, and whose controls are women over 60 years of age with no personal history of any cancer and no family history of breast or ovarian cancer, identified from retirement groups in the West of Ireland in 2001–2008; it is one of the studies of the Breast Cancer Association Consortium (BCAC).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001532> (<http://www.ebi.ac.uk/coho/COHO_0001532>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19488044") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21738484") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001532> "A case-control genetic study of bipolar disorder in the United States, initiated in 2006 as the genetic component of the NIMH-sponsored Genetics Initiative for Bipolar Disorder Consortium to carry out genome-wide association studies: cases with bipolar disorder of European and African American ancestry, collected through the consortium's eleven US collection sites (mostly from multiplex families or sibling pairs for the first, GAIN-funded genotyping; without regard to family history for the later TGen genotyping), and controls from the NIMH Genetics Initiative control sample collected for the Molecular Genetics of Schizophrenia study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001533> (<http://www.ebi.ac.uk/coho/COHO_0001533>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35041012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37933522") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001533> "A longitudinal cohort of Syrian refugee children aged 8–16 and their primary caregivers, from families who had fled the war in Syria within the previous four years and were living in informal tented settlements in the West and Central Beqaa regions of Lebanon, recruited by purposive cluster sampling from October 2017 to January 2018 and followed up once a year later, with interviews of children and caregivers and children's saliva (for genotyping and DNA methylation) and hair (for cortisol, DHEA and testosterone), to study how psychosocial and biological factors shape resilience and mental health problems; it was funded by the US National Institute of Child Health and Human Development and sponsored by Queen Mary University of London.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001534> (<http://www.ebi.ac.uk/coho/COHO_0001534>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34197840") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40669005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02694068") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001534> "An international observational cohort study, led from the University of Washington, of adults with kidney failure treated with peritoneal dialysis who had a peritoneal equilibration test soon after starting it, set up to find common genetic variants that influence peritoneal solute transfer rate and ultrafiltration. Participants were enrolled prospectively at centres in Australia, Canada, the United Kingdom and the United States from 2013 to 2018, and DNA and clinical data were added from earlier peritoneal dialysis studies in the United Kingdom (PD-CRAFT), Belgium, Sweden and Hong Kong.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001535> (<http://www.ebi.ac.uk/coho/COHO_0001535>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27126231") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31919934") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32002631") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32825781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33998162") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001535> "A multicentre, prospective, observational European study of adults with new-onset or worsening heart failure who were treated with loop diuretics but received no more than half the target doses of ACE inhibitors or angiotensin receptor blockers and/or beta-blockers, and whose physicians intended to start or up-titrate these drugs. Its index cohort was enrolled at 69 centres in 11 European countries between December 2010 and December 2012 and its validation cohort at six centres in Scotland between October 2010 and April 2014; funded by the European Commission's Seventh Framework Programme, it combined clinical data, biomarkers, genome-wide genotyping and proteomics to find patient profiles that predict response to guideline-recommended therapy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001536> (<http://www.ebi.ac.uk/coho/COHO_0001536>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23717212") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.malariagen.net/partner_study/human-genetic-determinants-severe-malaria-malawi/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001536> "An unmatched case-control study of severe Plasmodium falciparum malaria at Queen Elizabeth Central Hospital, Blantyre, Malawi, run by the Malawi-Liverpool Wellcome Trust Clinical Research Programme with the Blantyre Malaria Project. Its cases are children aged 2 months to 14 years admitted with severe malaria (cerebral malaria or severe malarial anaemia) in 1994-2007, its controls are cord-blood samples from infants born at the same hospital in 2006-2007, and blood was also taken from some cases' parents; it is the Malawi partner study of the MalariaGEN Consortial Project 1 and its genome-wide association studies of severe malaria.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001537> (<http://www.ebi.ac.uk/coho/COHO_0001537>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29574091") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35060941") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38704818") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://drks.de/search/en/trial/DRKS00008737") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001537> "An ongoing, prospective, multicentre diagnostic study of participants in the German screening colonoscopy programme, recruited since November 2005 at a preparatory visit before colonoscopy at gastroenterology practices in southern Germany, who donate blood and stool samples and answer a questionnaire. Run from the German Cancer Research Center (DKFZ) in Heidelberg, it evaluates new blood and stool tests for the early detection of colorectal cancer and advanced adenomas against the findings of screening colonoscopy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001538> (<http://www.ebi.ac.uk/coho/COHO_0001538>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21966275") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://cordis.europa.eu/project/id/503485") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001538> "A European Union Sixth Framework Programme integrated project (June 2004 to November 2008), coordinated by the University of Cambridge with clinical coronary artery disease centres, genomics groups and the Wellcome Trust Sanger Institute, that sought genes and pathways of atherothrombosis in coronary artery disease through platelet transcriptome and proteome analysis and exon resequencing. For genetic association studies it assembled a Dutch case-control collection, with cases from the Academic Medical Center Amsterdam Premature Atherosclerosis Study (AMC-PAS) and the AGNES study of first ST-elevation myocardial infarction and controls from Sanquin blood donors, and a German one, with cases and controls from the Ludwigshafen Risk and Cardiovascular Health (LURIC) study and additional blood-donor controls from Mannheim.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001539> (<http://www.ebi.ac.uk/coho/COHO_0001539>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23544013") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346442") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32665703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36203093") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001539> "A South African study of BRCA1 and BRCA2 mutations in women with breast cancer and their families, based at the University of Pretoria and funded by the Cancer Association of South Africa. The women it identifies as carriers of pathogenic BRCA1 or BRCA2 variants are contributed to the Consortium of Investigators of Modifiers of BRCA1/2 (CIMBA) for studies of genetic modifiers of breast and ovarian cancer risk in carriers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001540> (<http://www.ebi.ac.uk/coho/COHO_0001540>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21639959") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21673961") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346442") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36688720") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001540> "A case-control study of ovarian cancer in Erlangen, northern Bavaria, Germany, supported by the ELAN programme of the University of Erlangen-Nuremberg, whose cases were recruited through the hospital in Erlangen and whose controls were randomly selected women from Erlangen, both enrolled from May 2002 to August 2008 and interviewed. It is one of the studies of the Ovarian Cancer Association Consortium (study code BAV) and contributes to its pooled epidemiological analyses and genome-wide association studies of ovarian cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001541> (<http://www.ebi.ac.uk/coho/COHO_0001541>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21639959") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23513043") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346442") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001541> "A hospital-based case-control study of ovarian cancer at University Hospitals Leuven, Belgium, funded by the Belgian National Cancer Plan (Nationaal Kankerplan). It is one of the studies of the Ovarian Cancer Association Consortium (study code BEL) and contributes cases and controls to its genome-wide association studies of ovarian cancer risk and to its analyses of ovarian cancer outcome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001542> (<http://www.ebi.ac.uk/coho/COHO_0001542>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22472876") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29700475") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32231276") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001542> "A German case-control study of major depressive disorder whose cases were consecutive admissions with a DSM-IV lifetime diagnosis of major depressive disorder to the psychiatric inpatient units of the University of Bonn and of the Central Institute of Mental Health in Mannheim, diagnosed by best-estimate consensus from a structured interview (SCID-I or SADS), medical records and family history and excluding bipolar disorder, non-affective psychosis and substance-related depression, and whose controls came from the German population-based studies PopGen, KORA and Heinz Nixdorf Recall. It is one of the cohorts of the Psychiatric Genomics Consortium's major depressive disorder working group (cohort code boma).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001543> (<http://www.ebi.ac.uk/coho/COHO_0001543>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21353194") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21926972") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001543> "A German case-control sample for genome-wide association studies of bipolar disorder, from the University of Bonn and the Central Institute of Mental Health in Mannheim, whose cases, nearly all with bipolar I disorder diagnosed by DSM-IV best-estimate consensus from structured interviews (SADS-L or SCID), were recruited from consecutive admissions to psychiatric inpatient units, and whose controls were drawn from the German population-based studies PopGen, KORA and Heinz Nixdorf Recall. It is one of the samples of the Psychiatric Genomics Consortium's bipolar disorder working group.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001544> (<http://www.ebi.ac.uk/coho/COHO_0001544>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34237774") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35368071") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.medrxiv.org/content/medrxiv/early/2021/10/07/2021.10.06.21264631.full.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001544> "A genetic study of COVID-19 severity in Brazil, based at the University of São Paulo Medical School, which enrolled people infected with SARS-CoV-2 in the São Paulo metropolitan area: patients hospitalised with COVID-19 at the Instituto do Coração (InCor) and the Instituto Central do Hospital das Clínicas, and people with a previous infection who were not hospitalised, found through serological surveys or SARS-CoV-2 PCR testing of health professionals and the general population. DNA came from blood samples already taken for clinical tests or serology, with questionnaire or hospital-record data; it was designed to identify genetic risk factors for COVID-19 severity in the Brazilian population and contributes to the COVID-19 Host Genetics Initiative.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001545> (<http://www.ebi.ac.uk/coho/COHO_0001545>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23039402") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25213131") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30166627") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40567118") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001545> "A multicentre observational study of patients with rheumatoid arthritis treated with biologic drugs at rheumatology centres across the United Kingdom, which collects their blood samples for DNA, RNA and cellular studies together with clinical, laboratory and adherence data, to study genetic and other predictors of response to biologic therapy. Its first patients, starting anti-TNF therapy, were identified through the British Society for Rheumatology Biologics Register; from November 2008 patients were recruited before starting a biologic and followed up prospectively for 12 months.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001546> (<http://www.ebi.ac.uk/coho/COHO_0001546>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25930055") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39811539") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001546> "A case-control study of first-onset acute myocardial infarction in Bangladesh, established in 2011 by the University of Cambridge with the International Centre for Diarrhoeal Disease Research, Bangladesh (icddr,b) and the National Institute of Cardiovascular Disease (NICVD) in Dhaka, whose cases are adults admitted to the NICVD's emergency rooms with a first myocardial infarction and whose controls, frequency-matched by age and sex, are hospital visitors without cardiovascular disease; with questionnaire data, electrocardiograms and stored blood samples, it was set up to study environmental, genetic, lifestyle and biochemical determinants of coronary heart disease in Bangladeshis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001547> (<http://www.ebi.ac.uk/coho/COHO_0001547>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16380991") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16504378") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21203820") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27386115") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001547> "A population-based case-control study of bladder cancer in the Belgian province of Limburg, whose cases are people with histologically confirmed incident transitional cell carcinoma of the bladder diagnosed between 1999 and 2004, identified through the Limburg Cancer Registry and invited by their urologists and general practitioners, and whose controls are inhabitants of the province aged 50 or over sampled at random through the Crossroads Bank of Social Security, stratified by municipality and socioeconomic status; it was used to study occupational, dietary and genetic risk factors for bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001548> (<http://www.ebi.ac.uk/coho/COHO_0001548>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22267197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32424353") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001548> "A case-control study of breast cancer in Germany whose cases are women diagnosed with breast cancer in 2007-2009 at the University Women's Clinic Heidelberg and whose controls are female blood donors recruited in the same years at the Institute of Transfusion Medicine and Immunology in Mannheim; it is one of the studies of the Breast Cancer Association Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001549> (<http://www.ebi.ac.uk/coho/COHO_0001549>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22961080") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25993007") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001549> "A type 2 diabetes case-control sample of unrelated Han Chinese from Beijing, China, made up of people with type 2 diabetes and nondiabetic controls, used in genetic association studies of type 2 diabetes and glycaemic traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001550> (<http://www.ebi.ac.uk/coho/COHO_0001550>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24949998") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28764680") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40576277") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41807453") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001550> "A study of the Queensland Institute of Medical Research (QIMR) in Brisbane, Australia, that from 1992 to 2016 examined annual new samples of 12-year-old twins from south-east Queensland, with their siblings nearest in age, counting their naevi and recording their sun behaviour, and re-examined them two years later; set up to investigate genetic factors in naevus development and other risk factors for melanoma, it also includes the twins' parents and is the twin mole study of the Brisbane Longitudinal Twin Study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001551> (<http://www.ebi.ac.uk/coho/COHO_0001551>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37250185") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39081844") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40235578") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001551> "A repeated cross-sectional population-based health examination survey of adults living in the canton of Geneva, Switzerland, which since 1992 has examined in a mobile unit, each year, a new random sample of residents drawn from the cantonal residents list and stratified by age and sex, collecting questionnaires, physical measurements and blood samples on risk factors for cardiovascular and other lifestyle-related chronic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001552> (<http://www.ebi.ac.uk/coho/COHO_0001552>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35906442") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37924421") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40983397") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001552> "A prospective community-based cohort of postmenopausal women and men aged 50 years and older who attended a primary care centre in Camargo, Cantabria, in northern Spain, for a regular health examination or for medical reasons, enrolled between February 2006 and February 2011 and re-evaluated in later waves to study the prevalence and incidence of metabolic bone diseases and the risk factors for osteoporosis and fragility fractures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001553> (<http://www.ebi.ac.uk/coho/COHO_0001553>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17118999") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17218734") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2249/MediaObjects/41588_2012_BFng2249_MOESM26_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001553> "A clinic-based, cross-sectional case-control study of patients with osteoporosis and control individuals, including volunteers, living in Cantabria in northern Spain and recruited in Santander, used to study genetic and hormonal determinants of bone mineral density and osteoporotic fracture.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001554> (<http://www.ebi.ac.uk/coho/COHO_0001554>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21606135") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0140673610619964-mmc1.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001554> "A German case-control study of coronary artery disease that pools patients with angiographically documented coronary artery disease from the hospital catheter-laboratory-based AtheroGene Registry, enrolled in 1999–2004 at Johannes Gutenberg University Mainz and the German Federal Armed Forces Central Hospital in Koblenz, with controls without a history of myocardial infarction from the population-based Gutenberg Heart Study of the city of Mainz and the Mainz-Bingen district, assembled for genome-wide association studies of coronary artery disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001555> (<http://www.ebi.ac.uk/coho/COHO_0001555>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28106791") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37844990") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0092867420308229-mmc1.xlsx") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.thl.fi/publications/morgam/cohorts/full/uk/unk-caea.htm") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001555> "A population-based prospective cohort of men aged 45–59 years from the town of Caerphilly and its surrounding villages in South Wales, United Kingdom, identified from electoral rolls and general practice lists and first examined in 1979–1983 by the MRC Epidemiology Unit (South Wales) to study risk factors for coronary heart disease, then re-examined in later phases that added cognitive testing and follow-up for dementia and other chronic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001556> (<http://www.ebi.ac.uk/coho/COHO_0001556>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23050023") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26648100") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.834/MediaObjects/41588_2011_BFng834_MOESM19_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001556> "An ongoing population-based cohort of people aged over 18 years in Amagasaki, Hyogo Prefecture, Japan, consecutively enrolled for a baseline examination between September 2002 and August 2003, which is one of the member studies of the Cardio-metabolic Genome Epidemiology (CAGE) Network and whose samples are used in genetic studies of blood pressure, lipids and other cardiometabolic traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001557> (<http://www.ebi.ac.uk/coho/COHO_0001557>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21297916") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24647736") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26648100") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34313618") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001557> "A community-based prospective cohort of middle-aged and older Japanese men and women in Fukuoka, Japan, run by Kyushu University, who took part in a baseline survey with a questionnaire and DNA collection between February 2004 and August 2007 and are followed up to investigate lifestyle factors and genetic susceptibility to lifestyle-related diseases such as cardiovascular diseases, cancer and diabetes mellitus.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001558> (<http://www.ebi.ac.uk/coho/COHO_0001558>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24647736") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26648100") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001558> "A hospital-based prospective cohort at the National Center for Global Health and Medicine in Tokyo, Japan, whose participants, drawn from the hospital's clinical practice and annual medical check-ups, are enrolled for detailed examination of lifestyle and lifestyle-related diseases such as cardiovascular diseases, cancer and diabetes mellitus to investigate the relationship between genetic and non-genetic factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001559> (<http://www.ebi.ac.uk/coho/COHO_0001559>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38477757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41346785") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001559> "A five-year randomised, double-blind, placebo-controlled trial of daily calcium carbonate supplementation for fracture prevention in ambulant, community-dwelling women aged 70 years or older, recruited in 1998 from the general population of Western Australia through the electoral roll, whose participants were followed after the trial ended in 2003 in two observational studies to 2013 and through linked Western Australian hospital and death records, the whole study being known as the Perth Longitudinal Study of Ageing Women.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001560> (<http://www.ebi.ac.uk/coho/COHO_0001560>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19171028") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24358145") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25279460") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26439744") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001560> "A Finnish three-generation family study run by researchers at the University of Jyväskylä, built on the Calex study, a cohort of girls recruited in school grades 4 to 6 through schools in the city of Jyväskylä and its surroundings in Central Finland (some of whom first took part in a two-year randomised calcium, vitamin D and dairy supplementation trial) and followed through puberty for about 7.5 years; in 2007–2008 the girls, then young women, and their brothers, mothers, fathers, grandmothers and grandfathers were invited to the same bone, body-composition and blood measurements, to study the heritability and determinants of bone mass, body composition and related metabolic traits across generations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001561> (<http://www.ebi.ac.uk/coho/COHO_0001561>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20084545") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25805146") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30092822") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001561> "A population-based case–control study of breast cancer in Mexican women aged 35 to 69, carried out from January 2004 to December 2007 in Mexico City, Monterrey and Veracruz by investigators of the Mexican National Institute of Public Health, in which women with newly diagnosed, untreated breast cancer were recruited at twelve public hospitals of the Mexican Social Security Institute, the Institute of Security and Social Services of State Workers and the Ministry of Health, and controls, frequency-matched to the cases by age, health-care institution and region, were chosen by multistage random household sampling; participants were interviewed on health, diet and physical activity, measured and gave blood samples, to study risk factors for breast cancer in Mexico.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001562> (<http://www.ebi.ac.uk/coho/COHO_0001562>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20700438") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23143601") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001562> "A lung cancer case–control study of ethnic Han Chinese, carried out from 1997 to 2008, in which cases were recruited from Beijing and surrounding provinces at the Cancer Hospital of the Chinese Academy of Medical Sciences in Beijing, China, and cancer-free controls from the same region and period were drawn from a community nutritional survey, to study genetic susceptibility to lung cancer; its never-smoking women take part in the genome-wide association studies of the Female Lung Cancer Consortium in Asia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001563> (<http://www.ebi.ac.uk/coho/COHO_0001563>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28604730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001563> "A Canadian lung cancer case–control sample, drawn as nested case–control sets for the OncoArray lung cancer genome-wide association project from three low-dose computed tomography screening programmes for smokers: the International Early Lung Cancer Action Program site in the Greater Toronto Area organised by Princess Margaret Hospital (enrolling since 2003), the PanCan study, which screened smokers aged 50 to 75 in eight cities across Canada from 2008 to 2011, and the screening programme of the British Columbia Cancer Agency (BCCA), which enrolled heavy smokers from 1990 to 2007.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001564> (<http://www.ebi.ac.uk/coho/COHO_0001564>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16931544") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21602798") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21637779") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001564> "A case–control study of more aggressive prostate cancer in men recruited from 2001 to 2004 at the major medical institutions of Cleveland, Ohio, United States (the Cleveland Clinic, University Hospitals of Cleveland and their affiliates), in which cases were newly diagnosed, histologically confirmed prostate cancers of higher grade, stage or prostate-specific antigen level, and age-matched controls were men without prostate cancer undergoing standard annual medical examinations at the same institutions, to study genetic and environmental risk factors for aggressive prostate cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001565> (<http://www.ebi.ac.uk/coho/COHO_0001565>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10891016") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15100668") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19566956") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35686384") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001565> "A prenatally randomised controlled trial, begun in 1995 at university hospital-based centres in Vancouver and Winnipeg, Canada, of infants at high risk of asthma (with at least one first-degree relative with asthma or two with other IgE-mediated allergic diseases) identified before birth, whose families were assigned either to a multifaceted intervention in the first year of life (avoidance of house dust mite, pet allergens and environmental tobacco smoke, encouragement of breastfeeding with partially hydrolysed formula supplementation, and delayed introduction of solid foods) or to a control group, and whose children were followed as a birth cohort with paediatric allergist assessments to age 15, to test the primary prevention of asthma and allergy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001566> (<http://www.ebi.ac.uk/coho/COHO_0001566>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15243147") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16339465") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17332447") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20431077") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22617119") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001566> "A community-based prospective cohort study in Germany in which adults aged about 19 to 90, volunteers from among the members of a German primary health-care scheme, had vascular risk factors and carotid intima–media thickness measured by ultrasound at baseline and again after about three years, and were followed for about ten years for myocardial infarction, stroke, transient ischaemic attack and death, to study the progression of early carotid atherosclerosis and its value in predicting vascular events.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001567> (<http://www.ebi.ac.uk/coho/COHO_0001567>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23013535") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28604730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28819433") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001567> "A hospital-based case–control study of lung cancer in Asturias, northern Spain, run by the Molecular Epidemiology of Cancer Unit of the University Institute of Oncology of the University of Oviedo, which from October 2000 used a standard protocol to recruit incident, histologically confirmed lung cancer cases aged 30 to 85 living in the areas of the main hospitals of Asturias (in Gijón, Avilés, Oviedo and Mieres), with controls admitted to the same hospitals for conditions unrelated to the exposures studied and individually matched by ethnicity, sex, age and hospital; participants were interviewed on tobacco, diet, occupation and environmental exposures and gave blood or mouthwash samples, to study lifestyle, occupational and genetic risk factors for lung cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001568> (<http://www.ebi.ac.uk/coho/COHO_0001568>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11918622") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15325833") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25899452") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001568> "A multicentre, randomised, double-blind, placebo-controlled trial of atorvastatin 10 mg daily for the primary prevention of cardiovascular disease in men and women aged 40–75 with type 2 diabetes, no history of cardiovascular disease, LDL cholesterol of 4.14 mmol/l or less and at least one further risk factor (retinopathy, albuminuria, current smoking or hypertension), who were randomised between November 1997 and June 2001 at centres in the United Kingdom and Ireland. It was run as a collaboration of Diabetes UK, the NHS Research and Development Directorate and Pfizer UK, and was stopped early when its prespecified efficacy criterion was met.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001569> (<http://www.ebi.ac.uk/coho/COHO_0001569>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16714328") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1746424") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7572695") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8801446") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9841599") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001569> "A randomised, double-blind, placebo-controlled secondary-prevention trial of pravastatin 40 mg daily in men and postmenopausal women aged 21–75 who had had a myocardial infarction 3 to 20 months earlier and had average cholesterol levels (total cholesterol below 240 mg/dl and LDL cholesterol of 115–174 mg/dl), enrolled at 80 hospitals and affiliated centres in the United States and Canada and followed for about five years to test whether lowering cholesterol reduces fatal coronary heart disease and nonfatal myocardial infarction. It was initiated by its investigators and funded by Bristol-Myers Squibb.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001570> (<http://www.ebi.ac.uk/coho/COHO_0001570>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15157730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17141853") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001570> "A paediatric asthma clinical research network created in 1999 by the US National Heart, Lung, and Blood Institute, made up of five clinical centres (University of California, San Diego; University of Arizona, Tucson; Washington University, St. Louis; University of Wisconsin, Madison; National Jewish Medical and Research Center, Denver) and a data coordinating centre at Penn State University, Hershey, to evaluate new and existing asthma therapies in children through multicentre randomised clinical trials. Its trial cohorts include the Prevention of Early Asthma in Kids (PEAK) trial in preschool children at high risk of asthma and the CLIC and PACT trials in school-aged children with mild-to-moderate persistent asthma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001571> (<http://www.ebi.ac.uk/coho/COHO_0001571>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15572756") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1844268") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8137335") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8602180") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001571> "A multicentre, randomised, double-blind, placebo-controlled trial of daily beta-carotene (30 mg) plus retinyl palmitate (25,000 IU) for the primary prevention of lung cancer in people at high risk of it, namely male and female heavy smokers and former smokers and asbestos-exposed men, recruited at centres in Seattle, Portland, San Francisco, Irvine, Baltimore and New Haven, United States, in a pilot phase from 1985 and an efficacy phase from 1989. The intervention was stopped in January 1996, 21 months early, because it increased lung cancer incidence and mortality; participants were followed through 2005, and the serum, plasma, whole blood and lung tissue collected during the trial form the CARET Biorepository.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001572> (<http://www.ebi.ac.uk/coho/COHO_0001572>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12908658") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16172203") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18347602") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19721433") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001572> "A multiphase randomised trial of the effectiveness of antipsychotic drugs in adults aged 18–67 with chronic schizophrenia, run under the US National Institute of Mental Health's CATIE programme in 2001–2004 at 57 clinical sites across the United States (public mental health, academic, Veterans Affairs and managed care settings), whose double-blind first phase compared the first-generation drug perphenazine with the second-generation drugs olanzapine, quetiapine, risperidone and ziprasidone for up to 18 months, with all-cause treatment discontinuation as the primary outcome. Participants could join an optional genetic sub-study by donating DNA.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001573> (<http://www.ebi.ac.uk/coho/COHO_0001573>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23245376") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26239289") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001573> "A retrospective case–control study of genetic and environmental contributions to heroin dependence, funded by the US National Institute on Drug Abuse in 2003 and run by Washington University, the Queensland Institute of Medical Research and the National Drug and Alcohol Research Centre (University of New South Wales), which from 2004 recruited opioid-dependent adults from opioid substitution (maintenance) treatment clinics in the greater Sydney area, Australia, and neighbourhood controls with little or no lifetime opioid use from socially disadvantaged areas served by the same clinics. Participants gave blood for DNA and completed a psychiatric diagnostic interview (SSAGA-OZ) with added assessments of childhood trauma, family history and borderline personality disorder.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001574> (<http://www.ebi.ac.uk/coho/COHO_0001574>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24066093") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31089142") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001574> "A case–control study of colorectal cancer in Croatia, whose cases are patients with colorectal cancer recruited from November 2008 at the surgery departments of two tertiary hospitals in Zagreb that receive patients from across the country, and whose population controls without a history of cancer were drawn at random, by age and sex, from the '10,001 Dalmatians' study of the general population of Split and the islands of Vis and Korčula. Its participants were genotyped for known colorectal cancer risk variants and later genome-wide, for European colorectal cancer genome-wide association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001575> (<http://www.ebi.ac.uk/coho/COHO_0001575>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12045211") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14551916") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22039354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001575> "A population-based case–control study of type 2 diabetes in Cambridgeshire, United Kingdom, whose cases are Europid men and women with type 2 diabetes (onset after age 30 without insulin treatment in the first year after diagnosis) randomly selected from general practice diabetes registers in a geographically defined region of Cambridgeshire, and whose controls were recruited at random from the same population sampling frames and individually matched to cases for age, sex and general practice, with diabetes excluded by medical record search and an HbA1c below 6%. It was funded by the Medical Research Council with support from NHS Research and Development and the Wellcome Trust.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001576> (<http://www.ebi.ac.uk/coho/COHO_0001576>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26822151") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27468926") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34419046") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00590200") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001576> "A single-centre prospective cohort and sample repository of consecutive adults undergoing elective diagnostic coronary angiography or elective cardiac computed tomographic angiography at the Cleveland Clinic, Cleveland, Ohio, United States, enrolled from 2001 to 2007 with blood samples, extensive clinical and laboratory characterisation and adjudicated follow-up for death, myocardial infarction and stroke, set up to study the genetic and molecular determinants of coronary artery disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001577> (<http://www.ebi.ac.uk/coho/COHO_0001577>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32887874") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34654805") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001577> "A biorepository of DNA and clinical data from adults with fibromuscular dysplasia enrolled at the Cleveland Clinic, Cleveland, Ohio, United States, from consecutive patients seen at its dedicated fibromuscular dysplasia referral clinic, each giving a blood or saliva sample, used in genetic studies of fibromuscular dysplasia and of arterial dissection, including spontaneous coronary artery dissection.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001578> (<http://www.ebi.ac.uk/coho/COHO_0001578>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29058716") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32424353") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32737321") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37173335") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001578> "A hospital-based case-control study of breast cancer in Crete, Greece, run under the Crete Cancer Genetics Program with the approval of the Scientific Council of the University General Hospital of Heraklion and funded by the University of Crete, whose breast cancer cases and controls were genotyped on the OncoArray within the Breast Cancer Association Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001579> (<http://www.ebi.ac.uk/coho/COHO_0001579>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22751097") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25249183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26250998") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001579> "A population-based study of cardiovascular disease and its risk factors in Chinese adults, carried out by the Department of Epidemiology of Fuwai Hospital (National Center for Cardiovascular Diseases, Chinese Academy of Medical Sciences and Peking Union Medical College), Beijing, with field centres in several provinces, including Jiangsu, Shandong and Henan, and funded by the Ministry of Science and Technology of China.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001580> (<http://www.ebi.ac.uk/coho/COHO_0001580>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24656733") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31095341") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001580> "A hospital-based case series of men with prostate cancer treated with iodine-125 (125I) brachytherapy implants as monotherapy at the Cross Cancer Institute, Edmonton, Alberta, Canada, and identified through its clinics, who gave saliva samples for DNA and whose clinical, dosimetric and toxicity data were compiled retrospectively, assembled to study genetic and other predictors of late toxicity after prostate brachytherapy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001581> (<http://www.ebi.ac.uk/coho/COHO_0001581>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21387312") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22915050") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26606540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001581> "A population-based case-control study of endometrial cancer conducted in Connecticut, United States, from December 2004 to March 2009 by investigators at the Yale School of Public Health and Yale Cancer Center, which enrolled women aged 35–80 newly diagnosed with primary endometrial cancer from October 2004 through September 2008, identified at 28 Connecticut hospitals by the Yale Cancer Center Rapid Case Ascertainment Shared Resource, and controls frequency-matched on age and found by random-digit dialling, who were interviewed at home and gave biological specimens, to study risk factors for endometrial cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001582> (<http://www.ebi.ac.uk/coho/COHO_0001582>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23041239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23381943") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001582> "A registry of stroke patients at the Carlo Besta Neurological Institute (Fondazione IRCCS Istituto Neurologico Carlo Besta), Milan, Italy, including consecutive Italian patients with stroke referred to the institute from 2000 to 2009, funded by the Italian Ministry of Health; its imaging-confirmed ischaemic stroke cases, subtyped by stroke neurologists with the TOAST criteria, were genotyped and studied with Italian PROCARDIS participants as controls in genome-wide association studies of stroke.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001583> (<http://www.ebi.ac.uk/coho/COHO_0001583>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19034282") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19753122") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21540858") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22113997") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001583> "A hospital-based multicentre case–control study of renal cell carcinoma conducted by the International Agency for Research on Cancer and the US National Cancer Institute at seven centres in Moscow (Russia), Bucharest (Romania), Lodz (Poland) and Prague, Olomouc, Ceske Budejovice and Brno (Czech Republic), which recruited newly diagnosed, histologically confirmed cases aged 20–79 between August 1999 and January 2003 and controls admitted to the same hospitals for conditions unrelated to smoking or genitourinary disease, some of them recruited in parallel for IARC's lung and head and neck cancer case–control studies. Participants were interviewed with standardised questionnaires on lifestyle, diet and medical, residential and occupational history and gave blood for DNA, to study the causes of the region's high kidney cancer rates.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001584> (<http://www.ebi.ac.uk/coho/COHO_0001584>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21795665") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23652309") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26014354") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31792337") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001584> "An international population-based case–control study of primary intracranial brain tumours in children and adolescents aged 7–19 in Denmark, Norway, Sweden and Switzerland, whose cases were diagnosed between 2004 and 2008 and identified through hospitals and national cancer registries, and whose controls were drawn at random from population registries and matched by age, sex and region. The children and their parents were interviewed in person, mainly to find out whether mobile phone use and other exposures raise the risk of brain tumours; saliva DNA from part of the participants was genotyped in candidate-gene studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001585> (<http://www.ebi.ac.uk/coho/COHO_0001585>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31771638") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32820175") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001585> "A research cohort of people whose healthcare provider ordered clinical-grade multi-gene panel testing for inherited disease risk, such as hereditary breast and ovarian cancer, from Color Genomics, a commercial genetic testing laboratory in Burlingame, California, and who gave electronic informed consent, under a Western Institutional Review Board protocol, for their de-identified samples, sequence data and health histories, self-reported through an online tool, to be used in research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001586> (<http://www.ebi.ac.uk/coho/COHO_0001586>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20400780") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000283.v6.p3") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001586> "A shared genotype–phenotype resource set up by the US National Heart, Lung, and Blood Institute in 2006, which brought DNA samples and phenotype data from nine NHLBI cohort studies (ARIC, CARDIA, the Cleveland Family Study, the Cardiovascular Health Study, the Cooperative Study of Sickle Cell Disease, the Framingham Heart Study, the Jackson Heart Study, MESA and the Sleep Heart Health Study) to the Broad Institute, genotyped their European American, African American, Hispanic and Chinese American participants on a candidate-gene array (the ITMAT-Broad-CARe array) and the African American participants of five of the cohorts genome-wide, and makes the data available to approved researchers, to find genetic variants associated with cardiovascular, pulmonary, haematological and sleep-related traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001587> (<http://www.ebi.ac.uk/coho/COHO_0001587>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36214322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36852012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36891075") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001587> "A prospective general-population cohort run from Herlev and Gentofte Hospital, Copenhagen University Hospital, and modelled on the Copenhagen City Heart Study, which from 2003 to 2015 invited adults aged 20–100 living in the greater Copenhagen area, identified through the Danish Civil Registration System (all those aged 40 or over and a quarter of those aged 20–39), and examined them with a questionnaire, a physical examination, lung function tests and blood sampling with DNA extraction. Participants are re-examined in a second round that began in 2014 and are followed through the national Danish health registries for cardiovascular, pulmonary and other diseases and death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001588> (<http://www.ebi.ac.uk/coho/COHO_0001588>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32433046") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34327424") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35195259") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37305106") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001588> "A population-based cohort of Chinese men and women aged 35–59, selected in 1998 by cluster random sampling in several provinces of China for the 1998 survey of the China Multi-Center Collaborative Study of Cardiovascular Epidemiology (a separate sample from that study's 1992–1994 cohort), whose participants were followed up in 2007–2008, 2012–2015 and 2018–2020 under the uniform protocol of the China-PAR project to study cardiovascular risk factors and incident atherosclerotic cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001589> (<http://www.ebi.ac.uk/coho/COHO_0001589>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32005116") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34288584") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34537387") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38637130") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001589> "A prospective population-based cohort of women aged 45–64 registered with a large general practice in Chingford, North-East London, United Kingdom, recruited in 1988–1989 to study osteoarthritis, osteoporosis and other musculoskeletal disease and assessed annually for over 20 years (to 2010) with clinical examinations, nurse-administered questionnaires, hand and knee radiographs and bone density measurements; deaths are traced through the Office for National Statistics.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001590> (<http://www.ebi.ac.uk/coho/COHO_0001590>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26881390") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33623038") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001590> "A case–control study of prostate cancer in Han Chinese men run by the CHIPGECS collaborative group of Chinese hospitals and universities with Barts Cancer Institute, Queen Mary University of London, which recruited hospital patients with a pathological diagnosis of primary prostate cancer and cancer-free men of comparable age from the community or from hospital attendees having routine physical examinations, in several regions of China (south, southeast, southwest, central and northeast), and whose samples were genotyped with the PRACTICAL consortium on the iCOGS and OncoArray arrays.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001591> (<http://www.ebi.ac.uk/coho/COHO_0001591>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30414448") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34097048") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001591> "A randomized clinical trial among employees of Massachusetts General Hospital in Boston, Massachusetts, aged 20 to 75, who regularly paid for food at the hospital's traffic-light-labelled cafeterias with their employee ID, enrolled between September 2016 and February 2018 and followed for 24 months to test whether a 12-month automated, personalized intervention (feedback on their cafeteria purchases, health and lifestyle tips, social norm comparisons and financial incentives) prevented weight gain and improved diet.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001592> (<http://www.ebi.ac.uk/coho/COHO_0001592>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20371422") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25694817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://healthstudy.usc.edu/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001592> "A prospective study of schoolchildren in southern California, run by the University of Southern California, that from 1993 recruited successive cohorts from school classrooms in 16 communities chosen to differ in regional air pollution (fourth, seventh and tenth graders in 1993, fourth graders in 1996, and kindergarten and first-grade children in 2002–2003) and followed them through school with yearly questionnaires and lung function tests, to study the chronic effects of air pollution and other environmental and genetic factors on children's respiratory health, asthma and lung function growth.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001593> (<http://www.ebi.ac.uk/coho/COHO_0001593>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22563304") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22698489") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25406188") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001593> "A hospital-based case-control study of ischaemic heart disease in Denmark whose cases are patients from the greater Copenhagen area referred for coronary angiography to Copenhagen University Hospital from 1991 onwards, with ischaemic heart disease documented by coronary stenosis or atherosclerosis on angiography, a positive exercise electrocardiogram or myocardial infarction, and whose controls without ischaemic heart disease are sampled from the Copenhagen General Population Study; with the Copenhagen City Heart Study and the Copenhagen General Population Study it is used in genetic and Mendelian randomization studies of cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001594> (<http://www.ebi.ac.uk/coho/COHO_0001594>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31888885") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32433046") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34327424") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35195259") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001594> "A community-based cohort of Chinese adults aged 18 or over recruited in 2007–2008 by three-stage cluster random sampling at four survey sites, in Shandong, Henan and Jiangsu provinces, chosen for their different levels of economic development; it is one of the sub-cohorts of the Prediction for Atherosclerotic Cardiovascular Disease Risk in China (China-PAR) project, followed up with the other sub-cohorts under a uniform protocol in 2012–2015 and 2018–2020 to study cardiovascular risk factors and incident cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001595> (<http://www.ebi.ac.uk/coho/COHO_0001595>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25290263") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35752286") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00662571") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001595> "A pharmacogenomic study of acamprosate response in alcohol dependence, conducted from 2008 to 2013 by the Mayo Clinic Center for the Individualized Treatment of Alcoholism, which enrolled men and women aged 18–80 with a primary diagnosis of current alcohol dependence (DSM-IV-TR) whose last drink was at least 5 days before enrolment, from community-based residential and outpatient treatment programmes affiliated with Mayo Clinic in Rochester, Minnesota, and Mayo Clinic Health System sites in Austin and Albert Lea, Minnesota, and La Crosse, Wisconsin, treated them with acamprosate for 3 months in an open-label, naturalistic prospective design and collected DNA and plasma to identify biomarkers of treatment response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001596> (<http://www.ebi.ac.uk/coho/COHO_0001596>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23153063") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001596> "A case-control study and biobank of juvenile idiopathic arthritis at the Royal Children's Hospital in Melbourne, Victoria, Australia, begun in February 2008, whose cases are children aged 18 or under with juvenile idiopathic arthritis diagnosed by age 16, recruited at hospital clinic visits within six months of diagnosis (incident) or later (prevalent, diagnosed since 1997), and whose controls are healthy Victorian-born children undergoing minor elective surgery at the hospital's Day Surgery Unit; families complete questionnaires on clinical, epidemiological and environmental factors and the children give a blood sample, to identify genomic and environmental risk factors for the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001597> (<http://www.ebi.ac.uk/coho/COHO_0001597>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16813653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001597> "A prospective multiethnic cohort of men aged 45 to 69 who were members of the northern and southern California regions of the Kaiser Permanente health plan, recruited in 2002–2003 through a two-stage mailed or online questionnaire with mailing strategies to enrich the cohort with non-white men, and followed through linkage with the health plan's electronic clinical, laboratory, hospitalisation, cancer registry and mortality data, mainly to study the causes of prostate cancer and also of other cancers and non-cancerous conditions in men.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001598> (<http://www.ebi.ac.uk/coho/COHO_0001598>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25390939") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001598> "A case-control study of breast cancer of the Spanish National Cancer Research Centre (CNIO) in Madrid, Spain, whose cases, recruited in 2000–2005, are consecutive breast cancer patients from three public hospitals, two in Madrid and one in Oviedo, and women with at least one affected first-degree relative recruited through the CNIO family cancer clinic in Madrid, and whose controls are women free of breast cancer attending the Menopause Research Centre in Madrid or a free medical check-up for female members of the College of Lawyers in Madrid; it is one of the studies of the Breast Cancer Association Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001599> (<http://www.ebi.ac.uk/coho/COHO_0001599>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28391914") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28456682") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33079599") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001599> "A retrospective clinic-based cohort of patients with familial hypercholesterolaemia caused by a known mutation, identified by genetic screening among the patients with dyslipidaemia attending the lipid clinic (Nutrition, Metabolism and Atherosclerosis Clinic) of the Institut de recherches cliniques de Montréal in Montreal, Canada, whose clinical records and lipid profiles, measured after a washout of cholesterol-lowering medication, are used to study genetic and clinical modifiers of lipid levels and cardiovascular disease in familial hypercholesterolaemia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001600> (<http://www.ebi.ac.uk/coho/COHO_0001600>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21316118") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21342495") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23143601") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001600> "A case–control study of lung cancer based at Chonnam National University Hwasun Hospital in Jeollanam-do, South Korea. From 2000 it enrolled consecutive patients, all ethnic Koreans, with newly diagnosed, histologically confirmed incident lung cancer, excluding secondary or recurrent tumours, and compared them with population-based controls to study genetic susceptibility to lung cancer. Its never-smoking women were genotyped genome-wide as one of the studies of the Female Lung Cancer Consortium in Asia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001601> (<http://www.ebi.ac.uk/coho/COHO_0001601>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19563285") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23966867") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25364473") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34008864") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001601> "A cross-sectional genetic and epidemiological study of periodontal disease and caries in Gullah African Americans with type 2 diabetes from the Sea Islands and coastal low country of South Carolina. The Medical University of South Carolina ran it as the first project funded through its NIH Center of Biomedical Research Excellence (COBRE) for Oral Health. Participants were recruited in 2004–2006 from Project SuGAR, community health fairs and churches, were examined at MUSC in Charleston or at four off-site centres and gave blood for DNA, so that periodontal disease could be related to diabetes control, cytokine genes and inflammation. Their data form one of the studies of the Sea Islands Genetics Network.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001602> (<http://www.ebi.ac.uk/coho/COHO_0001602>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30566436") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30726294") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34143812") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34480422") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001602> "A biobank of whole blood left over from the clinical care of patients admitted in 2010–2017 to six cardiology departments in the Capital Region of Denmark, around Copenhagen. The samples are linked to Danish clinical registries such as the Eastern Danish Heart Registry, and genotyped subsets of the patients, for example those who underwent coronary angiography in 2010–2014, are used to study the genetics of coronary artery disease, heart failure and other cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001603> (<http://www.ebi.ac.uk/coho/COHO_0001603>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14562005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15931596") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18372901") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19011631") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22634755") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001603> "A Scotland-wide study run from Edinburgh from 1999 that approached patients newly diagnosed with colorectal cancer at age 55 or younger. Research nurses visited them at home to take a family pedigree, give genetic counselling and take blood for genetic testing, to evaluate a strategy for finding families with hereditary non-polyposis colorectal cancer and to study inherited susceptibility to colorectal cancer. Population controls matched by age, sex and area of residence were recruited through the Scottish NHS. Its early-onset cases and controls formed the Scotland1 genome-wide association study of colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001604> (<http://www.ebi.ac.uk/coho/COHO_0001604>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30523039") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001604> "An international, multicentre prospective cohort of adults newly diagnosed with invasive colorectal cancer of any stage. It began at the Fred Hutchinson Cancer Research Center in Seattle in 2007 and from 2009 added sites in Tampa, Heidelberg (Germany), Salt Lake City, Los Angeles, St. Louis and Memphis. Patients are enrolled before surgery. They complete questionnaires and give blood, urine and stool at enrolment and repeatedly during five years of follow-up, tumour and adipose tissue are collected at surgery, and treatment and outcome data are abstracted from medical records, so that biomarkers and modifiable lifestyle factors that predict recurrence, survival, treatment toxicity and quality of life can be found.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001605> (<http://www.ebi.ac.uk/coho/COHO_0001605>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24886284") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30510241") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41212533") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001605> "A multicentre prospective cohort of patients newly diagnosed with colorectal cancer of any stage, recruited in 2010–2020 at 11 hospitals in the Netherlands by investigators at Wageningen University. Participants complete questionnaires on diet, dietary supplements, physical activity, body weight and quality of life and give blood at diagnosis and 6 months, 2 years and 5 years later, while clinical data come from the Netherlands Cancer Registry and hospital records. The aim is to learn how diet and other lifestyle factors influence recurrence, survival and quality of life after colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001606> (<http://www.ebi.ac.uk/coho/COHO_0001606>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25327703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31553449") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39625644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001606> "A case–control study of breast cancer in Latin American women, led by investigators at the Universidad del Tolima in Ibagué, Colombia, and the University of California, Davis. From 2011 it recruited women with incident invasive breast cancer, through population cancer registries and large cancer hospitals in Bogotá, Ibagué and Neiva in central Colombia and Pasto in the south, together with cancer-free controls from the same institutions matched on education, socioeconomic status and local origin. A Mexican arm comprises cases diagnosed from 2010 at the Social Security hospital in Mexico City, with blood-donor controls from the same hospital. The study investigates inherited and environmental causes of breast cancer, and its Colombian and Mexican arms, genotyped on different arrays, are analysed as separate datasets.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001607> (<http://www.ebi.ac.uk/coho/COHO_0001607>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28598434") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34562747") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39272843") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://web.archive.org/web/20221025011857/https://www.cancervic.org.au/research/epidemiology/cec-programs/confirm.html") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001607> "A kidney cancer study run by Cancer Council Victoria with QIMR Berghofer, the Victorian and Queensland cancer registries and hospitals and familial cancer clinics across Australia; its Queensland arm is called the CARE Study. Its population-based case–control family component recruited, through the Victorian and Queensland cancer registries, people diagnosed in 2009–2015, at age 18–74, with histologically confirmed renal cell carcinoma, with siblings and partners of cases as controls. The study also enrolled people with a strong family history of kidney cancer or a hereditary kidney cancer syndrome. Participants completed questionnaires on health, lifestyle and family and medical history and gave blood, so that lifestyle, environmental and genetic causes of kidney cancer could be investigated.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001608> (<http://www.ebi.ac.uk/coho/COHO_0001608>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26604824") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://english.sundhedsdatastyrelsen.dk/health-data-and-registers/national-health-registers") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001608> "A nationwide Danish hospital register, established in 1977 from the hospital discharge records that Denmark's counties were asked to submit and now kept by the Danish Health Data Authority, that records every patient discharged from Danish non-psychiatric hospitals since 1977 and psychiatric inpatients and emergency-department and outpatient specialty-clinic contacts since 1995, with diagnoses, examinations, treatments and surgical procedures. Kept primarily to monitor hospital use for health-care planning, it is also used, through linkage by personal identification number, for disease monitoring, quality assurance and research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001609> (<http://www.ebi.ac.uk/coho/COHO_0001609>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28887539") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31629936") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31677585") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38711811") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001609> "A study of young adult university students aged 18–22, most of them Duke University undergraduates recruited on campus in Durham, North Carolina, United States, who between 2010 and 2016 completed self-report and behavioural measures, functional and structural brain MRI and genotyping in Duke University's Laboratory of NeuroGenetics. People with psychiatric diagnoses were not excluded, as the study set out to relate variation in behaviour, brain and genes to risk for psychopathology.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001610> (<http://www.ebi.ac.uk/coho/COHO_0001610>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15727686") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37701154") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38485241") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001610> "A prospective population-based study of osteoporosis and fracture that in 1989 invited all men and women aged 60 or over living in Dubbo, New South Wales, Australia, a city chosen because its age and sex structure resembled Australia's and its isolation allowed near-complete ascertainment of fractures, and recruited further participants from 2000. Run by investigators of the Garvan Institute of Medical Research, Sydney, it reassessed participants every two to three years with interviews and bone densitometry and recorded fractures from the area's radiology services until 2020.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001611> (<http://www.ebi.ac.uk/coho/COHO_0001611>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10340280") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23048011") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001611> "An investigator-initiated, partly randomised multicentre trial in Denmark that in 1990–1993 enrolled healthy white women aged 45–58 in early menopause, recruited by direct mailing to a random sample of women from the general population, and allocated them, open label, to hormone replacement therapy or no treatment either at random or by their own choice. Planned to run for 20 years, with its randomised treatment stopped in 2002, it was set up to test whether hormone replacement therapy started soon after menopause prevents osteoporotic fractures and to find clinical, biochemical and densitometric predictors of low bone mass and fracture.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001612> (<http://www.ebi.ac.uk/coho/COHO_0001612>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19127255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19240718") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23065074") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36826816") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42365137") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001612> "A population-based case–control study of epithelial ovarian cancer in western Washington State, United States, run from Seattle with funding from the US National Cancer Institute, that enrolled women aged 35–74 diagnosed in 2002–2009 in a 13-county area, identified through the region's SEER cancer registry, together with controls from the same area identified by random-digit dialling, and collected in-person interviews and, from cases, tumour tissue.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001613> (<http://www.ebi.ac.uk/coho/COHO_0001613>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21775352") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26604824") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9062767") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001613> "A nationwide Danish register of patients treated in psychiatric departments, with records collected systematically from 1938 and computerised from 1969, covering all admissions to psychiatric hospitals and psychiatric wards of general hospitals in Denmark, the Faroe Islands and Greenland and, since 1995, all psychiatric outpatient contacts, with dates of treatment, diagnoses, referral, place and mode of admission and municipality of residence. Kept within a psychiatric epidemiology research unit and fed since 1995 through the Danish National Patient Register, it is used for national health planning and psychiatric epidemiological research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001614> (<http://www.ebi.ac.uk/coho/COHO_0001614>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22363532") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27418945") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29696206") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001614> "A prospective Danish study that from September 2004 enrolled consecutive women aged 18 or older admitted for surgery because of a suspected pelvic mass to the Gynaecologic Clinic of Copenhagen University Hospital, Rigshospitalet, collecting their blood and tumour tissue with clinical data to identify factors that distinguish benign from malignant pelvic masses and predict the prognosis of ovarian cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001615> (<http://www.ebi.ac.uk/coho/COHO_0001615>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17618283") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20437058") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27142380") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001615> "A colorectal cancer genomics project in Ontario, Canada (the ARCTIC Genome Project), hosted by Cancer Care Ontario and funded by Genome Canada through the Ontario Genomics Institute and other agencies, whose case-control sample consists of participants of the Ontario Familial Colorectal Cancer Registry: people aged 20–74 with colorectal cancer diagnosed in 1997–2000 and identified through the population-based Ontario Cancer Registry, and population controls randomly selected and frequency-matched to them by sex and five-year age group. They were genotyped genome-wide to find common variants associated with colorectal cancer, and the sample has since been used for risk-prediction and DNA methylation studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001616> (<http://www.ebi.ac.uk/coho/COHO_0001616>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21918596") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31303884") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37454130") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001616> "A web-based multicentre breast cancer registry developed at the University of Nebraska Medical Center's Eppley Cancer Center in Omaha, Nebraska, United States, and maintained by the Fred & Pamela Buffett Cancer Center as part of its integrated Cancer Repository for Cancer Research (iCaRe2), into which participating cancer centres in the US Midwest enrol breast cancer patients, breast cancer survivors and women at increased risk of breast cancer. Under common protocols it collects questionnaire data on demographic, medical, family, lifestyle, dietary and environmental factors, clinical and follow-up data and biospecimens for research on breast cancer diagnosis, prevention, treatment and survivorship.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001617> (<http://www.ebi.ac.uk/coho/COHO_0001617>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34002096") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38355785") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39537796") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001617> "A cohort of adults of European ancestry with bipolar disorder (bipolar I or II disorder, schizoaffective disorder of bipolar type or bipolar disorder not otherwise specified) recruited from across the United Kingdom by the Bipolar Disorder Research Network, an ongoing research programme run from Cardiff and Worcester, systematically through NHS community mental health teams and lithium clinics and non-systematically through media advertising and patient charities such as Bipolar UK. Participants are interviewed by trained psychologists and psychiatrists with the Schedules for Clinical Assessment in Neuropsychiatry and their case notes reviewed, to study the genetic and environmental causes of bipolar and related mood disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001618> (<http://www.ebi.ac.uk/coho/COHO_0001618>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21320228") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001649.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001618> "A longitudinal family high-risk study of the development of substance use disorder, run in Pittsburgh, Pennsylvania, United States, by the Center for Education and Drug Abuse Research of the University of Pittsburgh, a Center of Excellence funded by the National Institute on Drug Abuse and completed in 2015, which recruited nuclear families of a father with or without a lifetime substance use disorder (or with another psychiatric disorder), his partner and their biological child aged 10–12 (at first sons only, daughters from its second funding cycle) and followed the index children to age 30; index children and their siblings were genotyped under the Genes, Environment and Development Initiative.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001619> (<http://www.ebi.ac.uk/coho/COHO_0001619>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20453537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26806518") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37433967") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001619> "An international consortium of lithium researchers, established in 2008 on the initiative of the International Group for the Study of Lithium-Treated Patients (IGSLI) and the Unit on the Genetic Basis of Mood and Anxiety Disorders of the US National Institute of Mental Health, whose participating sites in Europe, America, Asia and Australia pool genotyped patients with bipolar disorder treated with lithium, their long-term response rated retrospectively on the Alda scale, for genome-wide studies of the genetic basis of lithium response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001620> (<http://www.ebi.ac.uk/coho/COHO_0001620>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17984119") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001620> "A Norwegian multipurpose collection of health data and blood samples pooled from ten regional population-based health surveys conducted in 1994–2003, among them the fourth and fifth surveys of the Tromsø Study, the second Nord-Trøndelag Health Study (HUNT II), the Hordaland Health Study, the Oslo Health Study, the Oppland and Hedmark Health Study and the Troms and Finnmark Health Study. Participants, invited through the Population Registry of Norway, answered about 50 common core questions, had standardised examinations and gave non-fasting blood samples, and consented to linkage with national health registries; the collaboration is run by the Norwegian Institute of Public Health with the universities of Bergen, Oslo, Tromsø and Trondheim.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001621> (<http://www.ebi.ac.uk/coho/COHO_0001621>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346442") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28448241") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32665703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33597508") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34320204") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001621> "An Italian consortium of cancer genetics services and research groups studying hereditary breast cancer, among them the Fondazione IRCCS Istituto Nazionale dei Tumori and the Istituto Europeo di Oncologia in Milan and centres in Aviano, Bari, Florence, Genoa, Rome and Varese, with genetic testing by the Cogentech Cancer Genetic Test Laboratory in Milan. It contributes carriers of BRCA1 and BRCA2 pathogenic variants, most of them ascertained through cancer genetics clinics, as one study to the Consortium of Investigators of Modifiers of BRCA1 and BRCA2 (CIMBA) for research on genetic modifiers of cancer risk in carriers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001622> (<http://www.ebi.ac.uk/coho/COHO_0001622>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23349703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://cordis.europa.eu/project/id/201379/reporting") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001622> "A cohort of male heavy smokers (at least 20 pack-years) aged 50–75, participants of the Dutch-Belgian NELSON lung cancer screening trial recruited by the University Medical Centers of Groningen and Utrecht in the Netherlands, with spirometry, low-dose chest CT and blood DNA and RNA. It was assembled and genotyped genome-wide as the discovery cohort of the European Union FP7 project COPACETIC, begun in 2008 under the coordination of UMC Utrecht, to find genetic determinants of susceptibility to COPD and emphysema in smokers, and its lung function was measured again after about three years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001623> (<http://www.ebi.ac.uk/coho/COHO_0001623>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28448241") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32665703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34320204") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36203093") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001623> "A Danish study at Rigshospitalet, Copenhagen University Hospital, that recruits and genetically counsels carriers of BRCA1 and BRCA2 pathogenic variants ascertained through cancer genetics clinics, under approval of the research ethics committees of the Capital Region of Denmark, and contributes them as one study to the Consortium of Investigators of Modifiers of BRCA1 and BRCA2 (CIMBA) for research on genetic modifiers of cancer risk in carriers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001624> (<http://www.ebi.ac.uk/coho/COHO_0001624>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28604730") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32393777") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001624> "A hospital-based lung cancer case–control study in Copenhagen, Denmark, whose cases are patients diagnosed histologically with treatable lung cancer from 2012 onwards (recruited 2012–2013) and whose controls are participants of the Copenhagen General Population Study without lung cancer; it was genotyped in the lung cancer OncoArray project of the International Lung Cancer Consortium for studies of genetic susceptibility to lung cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001625> (<http://www.ebi.ac.uk/coho/COHO_0001625>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34237774") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34379666") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001625> "A South Korean case–control study of host genetic factors in COVID-19, contributed to the COVID-19 Host Genetics Initiative, that compares patients with COVID-19, among them hospitalised patients, with controls, all of Korean ancestry, under the ethics approval of Kangbuk Samsung Medical Center, Seoul National University Bundang Hospital and Seoul National University Hospital; its data collection was coordinated with the Kangbuk Samsung Cohort Study and its participants were genotyped on the Axiom Asia Precision Medicine Research Array.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001626> (<http://www.ebi.ac.uk/coho/COHO_0001626>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17618284") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20972440") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23263490") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31089142") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001626> "A UK family study that since 1999 has recruited, through Clinical Genetics Departments throughout the United Kingdom, members of families with colorectal tumours who developed colorectal cancer by age 80 or significant colorectal adenomas (three or more, with severe dysplasia or villous histology, or presenting before age 45; adenoma-only cases having a first- or second-degree relative with colorectal cancer), with their unaffected spouses or partners as controls, to identify genes that predispose to colorectal tumours. Its cases and controls formed the first UK genome-wide association study of colorectal cancer (UK1) and later sample sets.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001628> (<http://www.ebi.ac.uk/coho/COHO_0001628>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29321194") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2560/MediaObjects/41588_2013_BFng2560_MOESM4_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001628> "A hospital-based case-control study of prostate cancer in Copenhagen, Denmark, whose cases are unselected men with pathologically confirmed, mainly clinically detected prostate cancer recruited at two Copenhagen University Hospital sites, Herlev Hospital in 2008–2011 (Copenhagen Prostate Cancer Study 1, CPCS1) and Rigshospitalet in 2010–2011 (Copenhagen Prostate Cancer Study 2, CPCS2), and whose controls are prostate-cancer-free men from the Copenhagen general population who took part in the Copenhagen City Heart Study or the Copenhagen General Population Study. Participants are white men of Danish descent who completed questionnaires and gave blood samples for DNA.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001629> (<http://www.ebi.ac.uk/coho/COHO_0001629>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35616266") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35638719") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36743401") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37239075") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://medschool.usuhs.edu/sur/research/center-for-prostate-disease-research") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.cancernetwork.com/view/department-defense-center-prostate-disease-research") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001629> "A longitudinal clinical research database of military health care beneficiaries who consent to enrolment, typically at prostate biopsy for suspected prostate cancer, at United States military treatment facilities (Walter Reed and other Army, Navy and Air Force medical centres, now with one civilian centre), run by the Department of Defense Center for Prostate Disease Research of the Uniformed Services University of the Health Sciences, which records their demographic, clinical, pathology, treatment, quality-of-life and outcome data. It began as prospective data collection at Walter Reed Army Medical Center in January 1994, with retrospective data back to 1980, and is linked to a biospecimen bank of blood and tissue collected at Walter Reed since 1993.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001630> (<http://www.ebi.ac.uk/coho/COHO_0001630>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23668689") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27565998") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3132306/unicode") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5669824/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001630> "A cohort of women having screening mammography at the Breast Health Center of California Pacific Medical Center in San Francisco, California, United States, an imaging facility of the San Francisco Mammography Registry (part of the NCI Breast Cancer Surveillance Consortium), who completed the registry's demographic and risk-factor questionnaire and, from 2004 to 2011, were asked to give blood for research and consent to genotyping; breast cancers are ascertained by linkage to the California Cancer Registry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001631> (<http://www.ebi.ac.uk/coho/COHO_0001631>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19507171") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20578893") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30452777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31083486") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4610716/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001631> "A pan-Canadian collection of children and adults treated with drugs of interest who have been enrolled since 2005 by trained surveillance clinicians at major Canadian hospitals (first paediatric hospitals, as the Genotype-specific Approaches to Therapy in Childhood network), either as cases of serious adverse drug reactions, such as anthracycline-induced cardiotoxicity or cisplatin-induced hearing loss, or as drug-tolerant controls, and whose clinical data and biological samples are collected for genetic association studies to find genomic predictors of adverse drug reactions. The network is based at the University of British Columbia in Vancouver.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001632> (<http://www.ebi.ac.uk/coho/COHO_0001632>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36335348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38030128") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41662368") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9406673") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001632> "A prospective population-based cohort of Hong Kong Chinese adults aged 25–74, recruited in 1995–1996 through randomly generated telephone numbers from the general population of Hong Kong for a baseline survey of the prevalence of cardiovascular risk factors (CRISPS-1), with a comprehensive assessment including a 75-g oral glucose tolerance test, and re-examined with similar protocols in 2000–2004, 2005–2008, 2010–2012 and 2016–2018 (CRISPS-2 to CRISPS-5) to study the development of cardiovascular risk factors such as diabetes and hypertension.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001637> (<http://www.ebi.ac.uk/coho/COHO_0001637>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25187374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001637> "A case–control study of type 2 diabetes in southern Han Chinese residents of Hong Kong, conducted by the Chinese University of Hong Kong. Its cases are patients with type 2 diabetes selected from the Prince of Wales Hospital Diabetes Registry (the Hong Kong Diabetes Register), either with early-onset diabetes and a positive family history or selected at random, excluding classic type 1 diabetes, and its controls, with normal glucose tolerance, were recruited from hospital staff, a community-based cardiovascular risk screening programme and a population-based cardiovascular risk screening programme for adolescents.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001638> (<http://www.ebi.ac.uk/coho/COHO_0001638>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710970") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29985959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001638> "A population-based epidemiological study of diabetes and its complications in adults aged 20 years or more in Chennai, southern India, run by the Madras Diabetes Research Foundation. A representative sample of the city's residents, from wards chosen by systematic random sampling, was screened for diabetes in a door-to-door survey in 2001–2003; everyone found to have diabetes and every tenth participant then underwent detailed anthropometric, biochemical and complication studies, and they were followed up in 2012–2014.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001639> (<http://www.ebi.ac.uk/coho/COHO_0001639>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32522676") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35242828") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001639> "An ongoing national, prospective, multicentre registry of patients with suspected or confirmed acute pulmonary embolism, with or without deep vein thrombosis, enrolled at medical centres of the China PE-DVT network across China and led from the China-Japan Friendship Hospital in Beijing, to describe the spectrum, trends, causes and outcomes of pulmonary embolism in China. Started in January 2009 with in-hospital outcomes, it has followed patients for at least three months since July 2011 and, since August 2016, has collected their blood samples and followed them for at least two years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001640> (<http://www.ebi.ac.uk/coho/COHO_0001640>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34039022") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34076677") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37916415") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001640> "An autopsy registry of people who died suddenly and unexpectedly, whose hearts have been referred since the mid-1990s to CVPath Institute in Gaithersburg, Maryland, by the Office of the Chief Medical Examiner of the State of Maryland through an ongoing cardiovascular pathology consultation service. The cause of death is determined by detailed histopathological examination of the heart and coronary arteries, and DNA extracted from the archived tissue is used to study the genetics of sudden cardiac death and of coronary plaque.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001641> (<http://www.ebi.ac.uk/coho/COHO_0001641>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20042177") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23455636") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26691988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001641> "A clinic-based case–control collection for genetic studies of age-related macular degeneration in Cleveland, Ohio, whose cases, graded by the Age-Related Eye Disease Study criteria, and controls without signs of macular degeneration or a family history of retinal disease, mostly of European descent, gave blood samples at the Cole Eye Institute of the Cleveland Clinic and at the Veterans Affairs eye clinic.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001642> (<http://www.ebi.ac.uk/coho/COHO_0001642>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32392239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34226943") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38252350") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001642> "A series of independent cross-sectional surveys of cardiovascular risk factors in the Czech Republic that continued the country's WHO MONICA Project surveys: random 1% samples of residents aged 25–64 years, stratified by age and sex and drawn from health insurance registers, were examined in the same districts in 1997/98, 2000/01, 2007/08 and 2016/17 by investigators in Prague (the Institute for Clinical and Experimental Medicine, and Charles University and Thomayer Hospital). DNA from its participants has also served as general-population controls in genetic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001643> (<http://www.ebi.ac.uk/coho/COHO_0001643>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29273806") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001643> "A genome-wide association sample of asthma from the north of the Netherlands, assembled by the Dutch Asthma Genetics Consortium in two phases that were genotyped separately and meta-analysed: a family-based phase whose asthmatic cases came from a trio and family study, with non-asthmatic spouses or the untransmitted alleles of the trios as controls, and a case–control phase whose asthmatics came from earlier clinical and genetic studies of the investigators' research institute, with controls from COPACETIC, a population-based lung cancer screening study of male smokers. Cases had a physician's diagnosis of asthma, asthma symptoms and bronchial hyperresponsiveness; controls had no asthma, COPD or significant airway obstruction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001655> (<http://www.ebi.ac.uk/coho/COHO_0001655>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21206424") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23879408") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30801552") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32080893") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001655> "A prospective observational cohort of kidney and simultaneous pancreas–kidney transplant recipients enrolled at the time of transplantation between 2005 and 2011 at five US and two Canadian transplant centres, the genetic study of the prospective arm of the Long-term Deterioration of Kidney Allograft Function (DeKAF) study, which with DNA from the recipients and from their living or deceased donors studies genetic influences on acute rejection, graft failure and immunosuppressant concentrations and adverse effects.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001663> (<http://www.ebi.ac.uk/coho/COHO_0001663>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25086665") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3052/MediaObjects/41588_2014_BFng3052_MOESM19_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001663> "A case series of patients with pathologically confirmed pancreatic cancer identified sequentially at the outpatient gastrointestinal cancer clinic of the Dana-Farber Cancer Institute in Boston, United States, which contributed cases to the PanScan III genome-wide association study of pancreatic cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001664> (<http://www.ebi.ac.uk/coho/COHO_0001664>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35939299") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37461090") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37960242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38728232") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001664> "A prospective cohort of retired employees of the Dongfeng Motor Corporation, a large state-owned car manufacturer in Shiyan, Hubei province, China, who completed questionnaires, medical examinations and blood sampling at a baseline survey in 2008–2010; further retirees were recruited at the first follow-up survey in 2013, and participants are re-surveyed about every five years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001665> (<http://www.ebi.ac.uk/coho/COHO_0001665>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21799935") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22984529") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38966335") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001665> "A nationwide, prospective, population-based cohort of all people with HIV aged 16 or older treated at Denmark's specialised HIV centres since 1 January 1995, which keeps enrolling newly diagnosed people and immigrants with HIV and records demographic, clinical and laboratory data on their infection and care, linkable to the Danish national registers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001666> (<http://www.ebi.ac.uk/coho/COHO_0001666>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21775348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38654257") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41835011") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001666> "A national administrative register of the services provided under Denmark's public health insurance by the contractors of primary health care (general practitioners, practising specialists, dentists, physiotherapists, psychologists and others), which covers everyone living in Denmark with data from 1990 and records the citizen, the provider and the service but little clinical information; collected for administrative and research purposes, it is linked by personal identification number to the other national registers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001667> (<http://www.ebi.ac.uk/coho/COHO_0001667>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23664318") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27010749") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00691509") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.againstbreastcancer.org.uk/our-research/prevention/dietcomplyf-study-diet-and-lifestyle") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001667> "A multicentre prospective cohort of women under 75 with grade I–III invasive primary breast cancer, recruited 9–15 months after diagnosis from 56 hospitals in the United Kingdom, who gave clinical, dietary, lifestyle, complementary-therapy and quality-of-life data and blood and urine samples every year for five years. Run from the University of Westminster, London, and funded by the charity Against Breast Cancer, it studies how dietary phytoestrogens and other diet and lifestyle factors relate to breast cancer recurrence and survival.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001668> (<http://www.ebi.ac.uk/coho/COHO_0001668>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19132805") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00345930") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001668> "The prospective registry study of the US Drug-Induced Liver Injury Network (DILIN), which the National Institute of Diabetes and Digestive and Kidney Diseases set up in 2003. Since September 2004 it has enrolled children aged 2 or over and adults referred to the network's clinical sites within 6 months of a suspected liver injury caused by a prescription or over-the-counter drug or a herbal or dietary supplement. Causality is adjudicated by expert review, clinical data and blood (DNA), serum and some tissue samples are collected, and confirmed cases are followed for at least 6 months, in order to study the clinical, genetic, environmental and immunological risk factors and the outcomes of drug-induced liver injury.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001673> (<http://www.ebi.ac.uk/coho/COHO_0001673>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21131975") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.723/MediaObjects/41588_2011_BFng723_MOESM3_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001673> "A case–control study of renal cell carcinoma in the region of Nijmegen, the Netherlands, run by Radboud University Nijmegen Medical Centre with the Comprehensive Cancer Centre East, whose cases of European descent form a hospital-based series (patients of the hospital's outpatient urology clinic who had given blood and lifestyle data from 1999 onwards for studies of gene–environment interactions in urological disease and were found through the cancer registry to have renal cell carcinoma) and a population-based series recruited in 2009 through the regional cancer registry (patients diagnosed in 1995–2008 before the age of 75). Its controls are participants of the population-based Nijmegen Biomedical Study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001677> (<http://www.ebi.ac.uk/coho/COHO_0001677>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1917239") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22885922") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25979724") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001677> "A study of peripheral arterial disease in the general population of Edinburgh, Scotland, based on an age-stratified sample of 1,592 men and women aged 55 to 74 selected from the age-sex registers of ten general practices in the city and assessed by questionnaire and ankle brachial pressure index, funded by the British Heart Foundation and genotyped for genetic studies such as the DIAGRAM consortium’s meta-analysis of type 2 diabetes and the UCLEB consortium’s Mendelian randomisation analyses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001678> (<http://www.ebi.ac.uk/coho/COHO_0001678>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22286212") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24920014") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001678> "A European genome-wide association study of classical Hodgkin lymphoma that genotyped, at the Centre National de Génotypage in France, cases from five European Hodgkin lymphoma studies (the EPILYMPH Study, the Scotland and Newcastle Lymphoma Group, the Young Adult Hodgkin's Disease Case–Control Study, the Scandinavian Lymphoma Etiology Study and the Northern Dutch Hodgkin Lymphoma Study) and compared them with generic controls chosen by country from earlier genome-wide association studies of other cancers in populations of European ancestry, among them ARCAGE, the IARC Central Europe Study, the Pancreatic Cancer Cohort Consortium, the Nijmegen Biomedical Study and the Wellcome Trust Case–Control Consortium. It was the European discovery sample of the 2014 Hodgkin lymphoma GWAS meta-analysis with the University of Southern California and University of Chicago GWAS.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001679> (<http://www.ebi.ac.uk/coho/COHO_0001679>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11040019") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12081984") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1534257") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7789377") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8633596") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001679> "A multicentre case-control study of myocardial infarction based on the WHO MONICA centres of Belfast (Northern Ireland) and Lille, Strasbourg and Toulouse (France), set up to investigate why coronary heart disease is more than three times as common in middle-aged men in Northern Ireland as in France. Between 1988 and 1991 it recruited men aged 25–64 who had had a myocardial infarction, examined 3 to 9 months after the event, and control men sampled from the general population. Its cases and controls have been used in many candidate-gene studies of myocardial infarction and lipids, and an extension study later recruited men and women in the MONICA areas of Belfast and Glasgow.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001680> (<http://www.ebi.ac.uk/coho/COHO_0001680>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24516880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30158200") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fng.2249/MediaObjects/41588_2012_BFng2249_MOESM26_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001680> "A clinic-based, cross-sectional study of patients referred for assessment of osteoporosis in Edinburgh and the Lothians, Scotland, supported by Arthritis Research UK, with bone mineral density measurements, fracture histories documented from medical records and radiographs, and DNA. It has been used in genetic association studies of bone density and fracture, including de novo replication genotyping for the GEFOS consortium's meta-analyses and the replication stages of vertebral fracture GWAS.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001698> (<http://www.ebi.ac.uk/coho/COHO_0001698>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16702371") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17087949") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32649712") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001698> "A multicentre case-control study of incident lymphoma conducted in 1998–2004 in the Czech Republic, France, Germany, Ireland, Italy and Spain, whose controls were frequency-matched to cases on age, sex and country and drawn at random from population registers in Germany and Italy and from patients of the cases' hospitals elsewhere, and whose participants were interviewed in person about their medical and family history and environmental exposures, to investigate risk factors for lymphoma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001711> (<http://www.ebi.ac.uk/coho/COHO_0001711>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16753010") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18637888") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21570397") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31220337") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001711> "A European collaboration, supported by the European Commission's 5th Framework Programme, that established a DNA case-control collection for studying the genetic basis of susceptibility to serious adverse drug reactions, ascertaining cases mainly through adverse drug reaction reports to pharmacovigilance centres; its cases have been used in genetic studies of drug-induced liver injury, statin-induced myopathy and other reactions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001714> (<http://www.ebi.ac.uk/coho/COHO_0001714>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26308735") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32591571") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33209044") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001714> "A case-control study of polycystic ovary syndrome (PCOS) in Korean women, whose women with PCOS and control women with regular menstrual cycles were recruited at the endocrinology and gynaecology clinics of Ewha Womans University Hospital (Mokdong Hospital) in Seoul, South Korea, from December 2008 to 2010, and genotyped for a genome-wide association study of PCOS.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001718> (<http://www.ebi.ac.uk/coho/COHO_0001718>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20453838") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20512659") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001718> "A study coordinated from the Institute of Cancer Research, Sutton, that from 1995 recruited people with breast cancer and a family history of the disease, as the index cases of their families, through cancer genetics clinics throughout the United Kingdom, whose clinicians and counsellors formed the Breast Cancer Susceptibility Collaboration (UK), for research into inherited susceptibility to breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001719> (<http://www.ebi.ac.uk/coho/COHO_0001719>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10829038") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19011631") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19920828") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20501757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24146633") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001719> "A population-based series of colorectal cancer patients, run from the University of Helsinki, in which tumour and normal tissue were collected from consecutive newly diagnosed patients at nine central hospitals in south-eastern Finland in 1994–1998, and afterwards at two of them, to find hereditary nonpolyposis colorectal cancer and other inherited predisposition to colorectal cancer; its genetic association studies compared the patients with Finnish blood donors from the same region.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001726> (<http://www.ebi.ac.uk/coho/COHO_0001726>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21738491") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36172703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT02075866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001726> "A prospective case-control study run from the University of Oulu that since 1998 has collected medical records and medicolegal autopsy data from consecutive victims of out-of-hospital sudden cardiac death in the Oulu University Hospital District, northern Finland, with survivors of an acute coronary event treated at Oulu University Hospital as controls, to study the characteristics and genetic background of sudden cardiac death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001732> (<http://www.ebi.ac.uk/coho/COHO_0001732>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25088940") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT00433927") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001732> "An open-label, randomised phase 3 trial, led from the Ludwig-Maximilians-University of Munich, that from January 2007 to September 2012 recruited patients aged 18–75 with KRAS (exon 2) wild-type metastatic colorectal cancer at centres in Germany and Austria and assigned them to first-line FOLFIRI plus cetuximab or FOLFIRI plus bevacizumab.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001809> (<http://www.ebi.ac.uk/coho/COHO_0001809>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001809> "A hospital-based collection of patients with ischaemic stroke attending the cerebrovascular service of the Western Infirmary, Glasgow, Scotland, recruited between 1990 and 2004 as part of an ongoing study of genetic and circulating biomarkers in stroke, all with brain imaging and extracranial carotid ultrasound, analysed against shared WTCCC controls from the 1958 Birth Cohort in the MEGASTROKE consortium’s genome-wide association study of stroke.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001878> (<http://www.ebi.ac.uk/coho/COHO_0001878>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21533139") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22277159") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24253340") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24943592") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001878> "A repository of DNA samples from Ashkenazi Jewish people, collected and held at the Hebrew University in Israel, that includes patients with schizophrenia or schizoaffective disorder recruited from hospitalised inpatients at seven medical centres in Israel, patients with diabetes and healthy volunteers, among them controls collected through the Israeli Blood Bank; its schizophrenia cases and controls form a case-control sample used in genome-wide association studies of schizophrenia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001895> (<http://www.ebi.ac.uk/coho/COHO_0001895>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23935489") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001895> "A cohort of people with acute or recent HIV-1 infection in Barcelona, Spain, held by the IrsiCaixa Foundation (IrsiCaixa AIDS Research Institute), one of the cohorts that contributed HIV-1-infected participants to the genome-wide studies of the International Collaboration for the Genomics of HIV.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001899> (<http://www.ebi.ac.uk/coho/COHO_0001899>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19300482") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28170284") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34855941") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001899> "A family-based study of chronic obstructive pulmonary disease funded by GlaxoSmithKline, whose pedigrees of probands with COPD and their siblings, characterised by spirometry, serve as a replication and testing cohort in COPD genome-wide association studies and genetic risk-score meta-analyses (1,103 pedigrees in the 2017 meta-analysis of 16,707 subjects).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001903> (<http://www.ebi.ac.uk/coho/COHO_0001903>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26039689") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30472421") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001903> "A prospective single-centre cohort that has enrolled, since 1997, all patients with acute or recent HIV-1 infection (within 180 days of infection) evaluated at the Hospital Clínic in Barcelona, Spain, identified by detectable viraemia with a negative HIV serology or by documented seroconversion within the previous six months.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001906> (<http://www.ebi.ac.uk/coho/COHO_0001906>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40437996") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40799781") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001906> "A nationwide, multicentre, observational prospective cohort of people with HIV in Italy, set up in 1997, that enrols adults who are naive to antiretroviral therapy at enrolment through Italian infectious diseases centres and follows them over time; it is run under the ICONA Foundation Study protocol.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001927> (<http://www.ebi.ac.uk/coho/COHO_0001927>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17636416") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34648614") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001927> "A multinational case-control study of glioma, meningioma, acoustic neurinoma and parotid gland tumours in residents aged 30 to 59, carried out with a common core protocol by sixteen centres in thirteen countries (Australia, Canada, Denmark, Finland, France, Germany, Israel, Italy, Japan, New Zealand, Norway, Sweden and the United Kingdom) with cases diagnosed during 2000–2004, set up to investigate whether mobile phone use and the radiofrequency fields it emits increase the risk of these tumours, and also collecting information on other potential risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001928> (<http://www.ebi.ac.uk/coho/COHO_0001928>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28448241") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32665703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33597508") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001928> "A study of hereditary breast and ovarian cancer at the Istituto Oncologico Veneto (IOV–IRCCS) in Padua, Italy, whose women and men carrying pathogenic BRCA1 or BRCA2 variants are contributed to the Consortium of Investigators of Modifiers of BRCA1 and BRCA2 (CIMBA).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001929> (<http://www.ebi.ac.uk/coho/COHO_0001929>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29025017") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001929> "An observational epidemiology cohort of consecutive patients with newly diagnosed lymphoma (including Hodgkin lymphoma and chronic lymphocytic leukaemia), US residents aged 18 or over enrolled within 9 months of diagnosis at the Mayo Clinic in Rochester, Minnesota, and the University of Iowa in Iowa City from September 2002 to June 2015 as part of the University of Iowa/Mayo Clinic Lymphoma Specialized Program of Research Excellence (SPORE), set up to identify clinical, epidemiological, germline genetic, tumour and treatment factors that affect lymphoma outcomes and survivorship.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001932> (<http://www.ebi.ac.uk/coho/COHO_0001932>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28448241") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32424353") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32665703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001932> "A study at the Portuguese Oncology Institute of Porto (IPO-Porto), Portugal, of carriers of pathogenic BRCA1 or BRCA2 variants, supported by the Liga Portuguesa Contra o Cancro, which contributes its participants and their genotypes to the Consortium of Investigators of Modifiers of BRCA1/2 (CIMBA).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001947> (<http://www.ebi.ac.uk/coho/COHO_0001947>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29892015") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001947> "A clinical case collection of the Johns Hopkins University School of Medicine that since September 2008 has collected samples and clinical information from patients over 18 years of age referred for catheter ablation of symptomatic, drug-refractory atrial fibrillation, taken before the ablation procedure, for genetic studies of atrial fibrillation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001952> (<http://www.ebi.ac.uk/coho/COHO_0001952>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23144702") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29381699") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.malariagen.net/partner_study/human-genetic-determinants-severe-malaria-north-east-tanzania/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001952> "A matched case-control study of severe malaria in children aged 3 months to 10 years in Muheza, Tanga region, north-eastern Tanzania, carried out in 2006–2008 by the Joint Malaria Programme (Kilimanjaro Christian Medical Centre, Moshi) with the London School of Hygiene and Tropical Medicine. Its cases were children admitted to Teule Hospital with severe malaria, recruited within a study of severe febrile illness, and its controls were healthy children from the community individually matched on parental tribal origin, ward of residence and age; its clinical data and DNA samples were contributed to MalariaGEN Consortial Project 1 and used in candidate-gene and genome-wide association studies of severe malaria.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001960> (<http://www.ebi.ac.uk/coho/COHO_0001960>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22267197") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001960> "A breast cancer case-control set contributed to the Breast Cancer Association Consortium (BCAC) that combines, as cases, the index (youngest affected) cases of BRCA1- and BRCA2-mutation-negative multiple-case breast and breast-ovarian cancer families recruited since 1998 through family cancer clinics across Australia and New Zealand by the Kathleen Cuningham Foundation Consortium for Research into Familial Breast Cancer (kConFab), and, as controls, women identified from the electoral rolls across Australia in 2002–2006 by the Australian Ovarian Cancer Study (AOCS).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001964> (<http://www.ebi.ac.uk/coho/COHO_0001964>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37852978") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41844147") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001964> "A hospital-based cohort of indigenous Arabs from all five regions of Saudi Arabia referred for cardiology care to the King Faisal Specialist Hospital and Research Center, a tertiary care hospital in Riyadh, who gave blood samples for genotyping and access to their electronic health records for phenotypes, together with a population reference group of indigenous Arabs without known cardiometabolic disease representing 28 Saudi tribes; it was set up with Massachusetts General Hospital to study polygenic scores for cardiometabolic disease in Arabs.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001969> (<http://www.ebi.ac.uk/coho/COHO_0001969>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25261933") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.malariagen.net/partner_study/human-genetic-determinants-severe-malaria-kumasi-ghana/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001969> "A prospective, unmatched case-control study of severe malaria conducted in August 2006 – December 2008 in the Kumasi Metropolitan District, Ashanti Region, Ghana, with ethics approval from Komfo Anokye Teaching Hospital and the Kwame Nkrumah University of Science and Technology. Its cases were children aged 3 months to 12 years with severe malaria admitted to the Paediatric Emergency Unit of Komfo Anokye Teaching Hospital, its controls were cord-blood samples collected in the same hospital's labour ward, and blood was also taken from the biological parents of cases (family trios); its clinical data and DNA samples were contributed to MalariaGEN Consortial Project 1.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001976> (<http://www.ebi.ac.uk/coho/COHO_0001976>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24516880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30158200") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001976> "A hospital-registered, clinic-based, cross-sectional study of postmenopausal Korean women at Asan Medical Center in Seoul, South Korea, with fractures ascertained by self-report and radiographs, used in genetic studies of osteoporotic fracture.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001995> (<http://www.ebi.ac.uk/coho/COHO_0001995>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16252231") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000048.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001995> "A two-tiered case-control study of Parkinson disease at the Mayo Clinic, Rochester, Minnesota, genotyped genome-wide on a Perlegen platform, whose cases were enrolled prospectively from the clinical practice of the Mayo Clinic's Department of Neurology from June 1996 to May 2004 among residents of Minnesota and the four surrounding states and assessed by a movement-disorders neurologist, and whose controls were unaffected siblings of cases (tier 1) or unrelated population controls matched on sex and age (tier 2), all screened for parkinsonism.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002008> (<http://www.ebi.ac.uk/coho/COHO_0002008>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24691493") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002008> "A collection of adults of European ancestry with physician-diagnosed mild, moderate or severe asthma, recruited through the Lung Institute of Western Australia from specialty asthma clinics and hospital databases, together with non-asthmatic controls selected at random from the metropolitan telephone directory, assembled for studies of the genetics of asthma and its severity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002016> (<http://www.ebi.ac.uk/coho/COHO_0002016>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42086565") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13300126/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002016> "A Danish randomised clinical trial, Atrial Fibrillation Detected by Continuous ECG Monitoring Using Implantable Loop Recorder to Prevent Stroke in High-Risk Individuals, which randomised 6,004 individuals aged 70 years or older without atrial fibrillation but with risk factors for atrial fibrillation and stroke to screening with an implantable loop recorder, with anticoagulation upon detection of atrial fibrillation, or usual care; its participants’ genetic data are used to evaluate polygenic scores for atrial fibrillation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002026> (<http://www.ebi.ac.uk/coho/COHO_0002026>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32665703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41266372") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002026> "A study of carriers of pathogenic BRCA1 or BRCA2 variants in North Macedonia, run by the Research Centre for Genetic Engineering and Biotechnology \"Georgi D. Efremov\" of the Macedonian Academy of Sciences and Arts with the University Clinic of Radiotherapy and Oncology, Adzibadem-Sistina Hospital and Re-Medika Hospital, which contributes carriers to the Consortium of Investigators of Modifiers of BRCA1/2 (CIMBA).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002036> (<http://www.ebi.ac.uk/coho/COHO_0002036>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20304703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002036> "A case-control sample of lung cancer patients who had never smoked, identified and recruited at Mayo Clinic, Rochester, Minnesota, between 1997 and 2008, and never-smoking community residents matched to them by age, sex and ethnic background, genotyped for a genome-wide association study of lung cancer in never smokers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002037> (<http://www.ebi.ac.uk/coho/COHO_0002037>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20354183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30648747") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002037> "A study of postmenopausal women with resected early-stage oestrogen receptor-positive breast cancer, recruited at Mayo Clinic, MD Anderson Cancer Center and Memorial Sloan Kettering Cancer Center under the NIGMS-funded Pharmacogenomics Research Network, who were treated with adjuvant anastrozole 1 mg daily and had blood drawn before and during therapy for DNA and for plasma drug and hormone measurements, set up to study genetic variation in response to aromatase inhibitors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002042> (<http://www.ebi.ac.uk/coho/COHO_0002042>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23760817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23805179") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002042> "A cross-sectional study of schizophrenia conducted by the Mental Illness and Neuroscience Discovery Institute (now the Mind Research Network) at the University of New Mexico, the University of Minnesota, Massachusetts General Hospital and the University of Iowa, which collected clinical, cognitive, structural, functional and diffusion MRI and genetic data under a common protocol from people with schizophrenia, recruited where possible early in their illness, and sex- and age-matched controls, to identify neuroimaging biomarkers of schizophrenia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002050> (<http://www.ebi.ac.uk/coho/COHO_0002050>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30093612") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002050> "A clinic-based series of women with endometrial cancer at Mayo Clinic in the United States, whose cases were contributed to the genome-wide association studies of the Endometrial Cancer Association Consortium (ECAC).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002054> (<http://www.ebi.ac.uk/coho/COHO_0002054>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21907864") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41849083") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002054> "A population-based prospective study of childhood asthma, also known as the Melbourne Asthma Study, initiated in 1964 by Howard Williams of the Royal Children’s Hospital, Melbourne, Australia, which recruited four asthma or wheeze groups and a control group of children aged 7 and has followed them into their seventh decade, providing the first prospective evidence linking childhood asthma to the development of COPD; its participants contributed to the Australian Asthma Genetics Consortium’s genome-wide association study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002063> (<http://www.ebi.ac.uk/coho/COHO_0002063>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29892015") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002063> "The stroke genetics studies of Massachusetts General Hospital in Boston, United States, analysed together under this name: the Genetics of Cerebral Hemorrhage on Anticoagulation (GOCHA) study of people over 55 with acute primary haemorrhagic stroke and controls from ambulatory clinics, and the Genes Affecting Stroke Risk and Outcome Study (GASROS), a single-centre prospective cohort of adults with acute ischaemic stroke who presented to the hospital from 2003 to 2011, with controls matched on age, sex and race or ethnicity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002072> (<http://www.ebi.ac.uk/coho/COHO_0002072>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20385819") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000182.v3.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002072> "A case-control collection for a joint genome-wide association study of age-related macular degeneration, assembled by researchers from the University of Michigan, the Mayo Clinic, the University of Pennsylvania and the Age-Related Eye Disease Study group with National Eye Institute intramural investigators, who contributed patients with advanced macular degeneration (geographic atrophy, neovascularisation or large drusen) and examined unaffected controls enrolled from 1998 through ophthalmology clinics in Michigan, Pennsylvania, Minnesota and Texas and through the Age-Related Eye Disease Study, genotyped together at the Center for Inherited Disease Research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002073> (<http://www.ebi.ac.uk/coho/COHO_0002073>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19127255") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20852632") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23552324") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002073> "A clinic-based case-control study of ovarian cancer run at the Mayo Clinic in the United States, whose cases are women with ovarian cancer diagnosed from 2000 onwards who attended the Mayo Clinic from a six-state surrounding region, and whose controls are healthy women seeking a general medical examination at the Mayo Clinic, frequency-matched to cases on age and region of residence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002124> (<http://www.ebi.ac.uk/coho/COHO_0002124>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15342441") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26956414") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29674426") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002124> "A multicentre population-based case-control study of non-Hodgkin lymphoma in the United States, run by the US National Cancer Institute, whose cases were people with a first primary non-Hodgkin lymphoma (excluding people infected with HIV) identified through four Surveillance, Epidemiology, and End Results cancer registries (Detroit, Iowa, Los Angeles and Seattle), and whose controls from the same areas were matched on area, age and race and found by random digit dialling (under 65) or from Medicare files (65 and over).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002131> (<http://www.ebi.ac.uk/coho/COHO_0002131>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22570617") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22828004") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002131> "A case-control study for a genome-wide association study of primary open-angle glaucoma, run by a consortium of investigators at 12 institutions across the United States, whose cases and controls, aged 35 or over and of European or Hispanic white ancestry, were collected at the 12 sites. Most came from university glaucoma and general ophthalmology clinics, and some from other studies such as the Marshfield Personalized Medicine Research Project and the CIGTS and AGIS glaucoma trials. The case and control definitions were harmonised with the GLAUGEN study, and the clinical data were reviewed centrally at the Massachusetts Eye and Ear Infirmary.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002132> (<http://www.ebi.ac.uk/coho/COHO_0002132>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26752265") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27760082") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002132> "A genome-wide meta-analysis resource for primary open-angle glaucoma that combines summary data from eight independent case-control and population-based datasets of European ancestry from the United States: the NEIGHBOR study, the Nurses' Health Study, the Health Professionals Follow-up Study, the Women's Genome Health Study, the Ocular Hypertension Treatment Study, and collections from Iowa, Marshfield and the Massachusetts Eye and Ear Infirmary. Cases in all datasets were defined by a harmonised glaucoma definition.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002171> (<http://www.ebi.ac.uk/coho/COHO_0002171>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24009259") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26390057") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41393571") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002171> "A community-based cohort of middle-aged and elderly residents of Nomura town, a largely rural community in Ehime Prefecture, western Japan, recruited through the annual community health check-ups at the Nomura Health and Welfare Center, with a first cohort enrolled in 2002 and a second in 2014 and followed up for mortality; run from Ehime University, it is one of the general-population cohorts of the Japanese Millennium Genome Project.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002190> (<http://www.ebi.ac.uk/coho/COHO_0002190>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22158537") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002190> "A hospital-based case-control study of type 2 diabetes in Han Chinese adults in Taiwan, whose cases were patients with type 2 diabetes diagnosed by American Diabetes Association criteria (onset at age 35 or older) recruited from the metabolism clinics of National Taiwan University Hospital, Taipei, and whose controls were people with normal glucose tolerance on a 75-g oral glucose tolerance test recruited from routine health examinations; it was a replication study of the Asian Genetic Epidemiology Network's type 2 diabetes genome-wide meta-analysis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002214> (<http://www.ebi.ac.uk/coho/COHO_0002214>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32424353") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002214> "A hospital-based case-control study of breast cancer in the south-west of the Netherlands, run from Leiden University Medical Centre, whose cases were consecutive patients with invasive or in situ breast cancer diagnosed in 1996–2006 at two hospitals in Leiden and Rotterdam, not selected for family history, and whose controls were healthy blood-bank donors, spouses of members of families at high breast cancer risk, and women tested at the local clinical genetics department for non-cancer conditions; it is a member study of the Breast Cancer Association Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002234> (<http://www.ebi.ac.uk/coho/COHO_0002234>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19020293") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19246476") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27911342") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33958783") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002234> "A population-based longitudinal study of the incidence, neurobiology and prognosis of Parkinson’s disease in Norway, which recruited incident, untreated patients with Parkinson’s disease and control participants and follows them with a standardised examination programme; its patients contribute to genetic studies of Parkinson’s disease progression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002235> (<http://www.ebi.ac.uk/coho/COHO_0002235>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22999729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41307346") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002235> "An observational cohort of people aged 80 years or older living in 72 nursing homes in France and Italy, recruited between January 2006 and June 2008 by four French and two Italian university hospital centres and followed for two years, to determine how well blood pressure and arterial stiffness predict mortality and major cardiovascular events in very old institutionalised people.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002240> (<http://www.ebi.ac.uk/coho/COHO_0002240>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26387087") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002240> "A hospital-based case–control study of prostate cancer in Sofia, Bulgaria, run by the Medical University of Sofia, whose cases are patients of the Clinic of Urology of Alexandrovska University Hospital with histopathologically confirmed prostate cancer and whose controls are patients with benign prostatic hyperplasia and low PSA and healthy men from the MMC Biobank; it contributes genotyped cases and controls to the PRACTICAL consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002267> (<http://www.ebi.ac.uk/coho/COHO_0002267>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32857771") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3892/MediaObjects/41588_2017_BFng3892_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002267> "A hospital-based case–control study of lung and head and neck cancers conducted from 2008 in the Greater Toronto Area, Canada, at Mount Sinai Hospital (Sinai Health System) and Princess Margaret Cancer Centre, in which histologically confirmed cases seen at the hospitals' clinics and controls selected at random from family medicine clinic databases, frequency-matched on age and sex, were interviewed with a standard questionnaire on lifestyle, occupational, medical and family history.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002274> (<http://www.ebi.ac.uk/coho/COHO_0002274>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26387087") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3094/MediaObjects/41588_2014_BFng3094_MOESM58_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002274> "A hospital-based case–control study of prostate cancer in Surrey, United Kingdom, run with the University of Surrey, in which men with confirmed prostate cancer who presented to two district hospitals (Royal Surrey County Hospital and Frimley Park Hospital) between February 2009 and March 2011 and healthy volunteers with normal PSA gave DNA samples, contributed to the PRACTICAL consortium's iCOGS genotyping.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002322> (<http://www.ebi.ac.uk/coho/COHO_0002322>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19648919") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23513043") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.668/MediaObjects/41588_2010_BFng668_MOESM17_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002322> "A hospital-based collection of women with invasive epithelial ovarian cancer ascertained at the Royal Marsden Hospital, London, United Kingdom, whose cases were genotyped in the UK stage of the first genome-wide association studies of ovarian cancer and in studies of the Ovarian Cancer Association Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002323> (<http://www.ebi.ac.uk/coho/COHO_0002323>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17615053") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19050702") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20949628") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22076443") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002323> "A collection of DNA samples from people with cancer, among them colorectal cancer patients, and from healthy people who were the spouses or unrelated friends of patients with malignancies, recruited from 1999 through the Institute of Cancer Research and the Royal Marsden Hospital NHS Trust in the United Kingdom for genetic epidemiological studies of cancer susceptibility.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002330> (<http://www.ebi.ac.uk/coho/COHO_0002330>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16985014") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21386992") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22969801") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002330> "A biobank at Roswell Park Cancer Institute in Buffalo, New York, that collects blood samples before treatment, clinical data and an epidemiological questionnaire from patients newly diagnosed with cancer at the institute and, as controls, from people with no personal history of cancer (family members and friends of patients and community members), and supplies them to cancer research studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002379> (<http://www.ebi.ac.uk/coho/COHO_0002379>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1087/MediaObjects/41588_2012_BFng1087_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002379> "A hospital-based case-control genome-wide association study of hypertension among Han Chinese adults aged 37–84 living in the Shanghai metropolitan area, approved by the ethics committee of Ruijin Hospital. Its cases had hypertension diagnosed after age 30 and at least two family members with hypertension, and its controls were normotensive adults over 40; both groups had a BMI under 27 kg/m2 and cases had no diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002381> (<http://www.ebi.ac.uk/coho/COHO_0002381>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24626196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25476266") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26188009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002381> "A collection of genetic and phenotypic data, gathered in 2010 by the scientific expedition Marco Polo (Marcopolo 2010), from healthy people in communities of the Terra Madre network along the Silk Road in Georgia, Armenia, Azerbaijan, Uzbekistan, Kazakhstan and Tajikistan (rural communities, and also cities in Uzbekistan and Kazakhstan), with ethics approval from the IRCCS Burlo Garofolo hospital in Trieste, Italy. It was used to study the genetics of the senses, such as taste, food preferences, hearing and vision, in these isolated populations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002385> (<http://www.ebi.ac.uk/coho/COHO_0002385>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25187374") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.1019/MediaObjects/41588_2012_BFng1019_MOESM23_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002385> "A study of type 2 diabetes and glucose metabolism in Han Chinese run from the Shanghai Diabetes Institute of Shanghai Jiao Tong University. Its participants, probands of type 2 diabetes pedigrees diagnosed before age 40 with normoglycaemic controls over 50 without a family history of diabetes recruited at the institute, and people with normal glucose tolerance drawn from the community-based Shanghai Diabetes Study I and II, were genotyped for East Asian genome-wide association studies of type 2 diabetes and fasting glucose.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002386> (<http://www.ebi.ac.uk/coho/COHO_0002386>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://europepmc.org/api/getPdf?pmcid=PMC4754625") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002386> "A hospital-based breast cancer study, supported by the German Cancer Research Center (DKFZ), of women diagnosed with primary in situ or invasive breast cancer at the Städtisches Klinikum Karlsruhe, Germany, from March 1993 to July 2005, with controls selected from the German Consortium for Hereditary Breast and Ovarian Cancer (GC-HBOC); it contributes to the Breast Cancer Association Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002412> (<http://www.ebi.ac.uk/coho/COHO_0002412>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22032547") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36831758") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002412> "A five-year national flagship research programme on psychosis in Singapore, based at the Institute of Mental Health, made up of three linked studies: a genome-wide association and copy-number study of schizophrenia and its cognitive phenotypes, a prospective study of people at ultra-high risk of psychosis, and a randomized controlled trial to improve neurocognition in schizophrenia. Its schizophrenia study recruited outpatients and inpatients of Chinese ethnicity aged 21 to 55 with DSM-IV schizophrenia at the Institute of Mental Health from 2008 to 2011.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002435> (<http://www.ebi.ac.uk/coho/COHO_0002435>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33623038") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002435> "A population-based prostate cancer case–control study in Finland, run from Tampere, whose cases were identified through linkage to the Finnish Cancer Registry, patient records and the Finnish arm of the European Randomized Study of Screening for Prostate Cancer (ERSPC), and whose controls are ERSPC cohort participants without a cancer diagnosis; it contributes to the PRACTICAL consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002439> (<http://www.ebi.ac.uk/coho/COHO_0002439>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33436325") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39001544") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002439> "The prostate cancer resource of the Menzies Institute for Medical Research, University of Tasmania, in Hobart, made up of the Tasmanian Familial Prostate Cancer Study, begun in the late 1990s, of prostate cancer families of Northern European descent identified through the Menzies Genealogical database, the Tasmanian Cancer Registry and local clinicians, and the population-based Tasmanian Prostate Cancer Case-Control Study, whose cases were ascertained through the Tasmanian Cancer Registry and whose male controls were selected at random from the Tasmanian electoral roll; it contributes to the PRACTICAL consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002483> (<http://www.ebi.ac.uk/coho/COHO_0002483>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001933.v2.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002483> "A case set of patients with atrial fibrillation, drawn from the roughly 1,000 patients who came to the University of California San Francisco electrophysiology laboratory for electrophysiology procedures and are held within the UCSF Cardiovascular Research Institute Resource in Arteriosclerosis and Metabolic Disease, San Francisco, United States. Participants were densely phenotyped for electrophysiological characteristics, by interview and review of medical records, with biospecimens collected from intra- and extra-cardiac chambers, for genetic studies of atrial fibrillation; its early-onset cases were whole-genome sequenced in the NHLBI TOPMed programme.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002487> (<http://www.ebi.ac.uk/coho/COHO_0002487>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29540798") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39755561") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002487> "A cross-sectional collection of serum and genomic DNA from people with type 1 diabetes, their first- and second-degree relatives, islet autoantibody-positive at-risk individuals and unaffected controls, recruited from the general population and from outpatient clinics at the University of Florida in Gainesville, Nemours Children's Hospital in Orlando and Emory University in Atlanta, United States, and banked by the University of Florida Diabetes Institute for studies of type 1 diabetes genetic risk and biomarkers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002517> (<http://www.ebi.ac.uk/coho/COHO_0002517>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22457820") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26387087") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002517> "A prostate cancer case-control study run by the Institute of Human Genetics and the Department of Urology of Ulm University Hospital, Germany. Familial cases were identified through family-history questionnaires sent by collaborating urologists throughout Germany, sporadic cases came from radical prostatectomy series at the Ulm urology clinic, and controls were men from Ulm without prostate cancer. It is used for linkage and association studies of inherited prostate cancer susceptibility and contributes to the PRACTICAL consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002522> (<http://www.ebi.ac.uk/coho/COHO_0002522>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms5613/MediaObjects/41467_2014_BFncomms5613_MOESM440_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3654676/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002522> "The North Carolina site of the Cancer Care Outcomes Research and Surveillance (CanCORS) Consortium, run by the University of North Carolina at Chapel Hill: a prospective population-based cohort of patients with colorectal cancer diagnosed between April 2003 and January 2005 in counties of central and eastern North Carolina, United States, identified by rapid case ascertainment through the North Carolina Central Cancer Registry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002531> (<http://www.ebi.ac.uk/coho/COHO_0002531>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28165464") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms10933/MediaObjects/41467_2016_BFncomms10933_MOESM1570_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002531> "A case-control study of chronic lymphocytic leukaemia in Utah, United States, whose prevalent cases came from the Huntsman Cancer Hospital's haematology clinics or were identified in the Utah Cancer Registry and verified by medical records and pathology reports, and whose controls, from the same area, were frequency-matched to the cases by sex and birth cohort using the Utah Population Database; it was genotyped genome-wide for studies of genetic susceptibility to the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002536> (<http://www.ebi.ac.uk/coho/COHO_0002536>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26440539") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35170738") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3433845/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002536> "A randomized, placebo-controlled smoking cessation trial of the University of Wisconsin Transdisciplinary Tobacco Use Research Center, run at the University of Wisconsin Center for Tobacco Research and Intervention with participants recruited in Madison and Milwaukee, Wisconsin, United States, in which adults who smoked 10 or more cigarettes a day and were motivated to quit were randomly assigned to placebo, nicotine patch, nicotine lozenge, sustained-release bupropion or a combination, and whose genotyped participants are used in genetic studies of nicotine dependence and smoking cessation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002549> (<http://www.ebi.ac.uk/coho/COHO_0002549>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35396534") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41419686") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002549> "An ongoing population-based cohort study initiated in 1985 in which all residents of Västerbotten County, Sweden, are invited to a health examination at ages 40, 50 and 60, with blood drawn for cryopreservation; one of the three sub-surveys of the Northern Sweden Health and Disease Study, used for nested case–control studies of cancer and cardiovascular disease and for evaluating polygenic risk scores.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002563> (<http://www.ebi.ac.uk/coho/COHO_0002563>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18701435") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21852243") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002563> "A hospital-based breast cancer case-control study at Wake Forest University Health Sciences (Winston-Salem, North Carolina, United States) that from November 1998 enrolled women newly diagnosed with breast cancer, before any therapy, at the Wake Forest University Breast Care Center, and as controls, frequency-matched to cases on age and race, women with normal mammograms and no history of cancer from those attending routine mammography at its Breast Screening and Diagnostic Center; its African-American participants, recruited up to December 2008, were contributed to the African American Breast Cancer Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002566> (<http://www.ebi.ac.uk/coho/COHO_0002566>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36797788") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9492970") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002566> "The randomised clinical trial component of the Women's Health Initiative, in which postmenopausal women aged 50 to 79 enrolled from 1993 to 1998 at the 40 WHI clinical centres in the United States were randomised in three distinct interventions: menopausal hormone therapy versus placebo, calcium and vitamin D supplementation versus placebo, and a low-fat eating pattern versus usual diet, tested for the prevention of coronary heart disease, breast and colorectal cancer, and fractures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002575> (<http://www.ebi.ac.uk/coho/COHO_0002575>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28540026") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1186%2Fs13229-017-0137-9/MediaObjects/13229_2017_137_MOESM1_ESM.docx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002575> "A combination of Californian autism spectrum disorder collections, namely the UCSF/Weiss trios and cases, the UCSF/Hendren cases, the USC/Levitt cases and controls, trios, cases and controls from the CHARGE study at UC Davis and cases and controls of the Autism Phenome Project of the UC Davis MIND Institute, whose samples were genotyped by the laboratory of L. A. Weiss at the University of California, San Francisco, on Affymetrix Axiom EUR arrays, and which contributed its European-American participants to the Psychiatric Genomics Consortium autism GWAS.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002577> (<http://www.ebi.ac.uk/coho/COHO_0002577>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28373541") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-022-05275-y/MediaObjects/41586_2022_5275_MOESM3_ESM.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002577> "A collection of Tibetans recruited at two sites about 4,100 m above sea level on the Tibetan Plateau in Sichuan, western China: at Seda, among people studying or working at the Seda Larong Wuming Buddhist Institute who came from diverse regions of the plateau, and at Litang, among nomadic people who had lived in the area for generations; their blood DNA was genotyped on the Illumina CoreExome array for a study of high-altitude adaptation, and the genotype and phenotype data are held by the Wenzhou Medical University biobank.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002584> (<http://www.ebi.ac.uk/coho/COHO_0002584>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29321194") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29892016") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33623038") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002584> "A hospital-based case series of men diagnosed with and managed for prostate cancer, identified through the university clinics of Washington University in St. Louis, Missouri, United States, and recruited from 2004 to 2011, which contributes genotyped cases to the prostate cancer genetic studies of the PRACTICAL consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002594> (<http://www.ebi.ac.uk/coho/COHO_0002594>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40619433") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://nurseshealthstudy.org/about-nhs") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://nurseshealthstudy.org/about-nhs/history") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002594> "An umbrella of three prospective cohorts of nurses: the original Nurses' Health Study established in 1976, Nurses' Health Study II, and Nurses' Health Study 3, which is still enrolling nurses and nursing students in the United States or Canada; together they count more than 275,000 participants and are among the largest prospective investigations into the risk factors for major chronic diseases in women.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002595> (<http://www.ebi.ac.uk/coho/COHO_0002595>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27028160") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000277.v2.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002595> "A collaboration of Australian and American investigators to identify genes associated with liability for heroin dependence, using a case–control design in which cases met lifetime DSM-IV criteria for heroin dependence and controls were assessed individuals without heroin dependence or unassessed general population controls, with cases and controls drawn from several investigations including the Comorbidity and Trauma Study, Heroin Dependence in Western Australia, the OZ-ALC Study, a twin study of mole development in adolescence and genetic studies of substance dependence at Yale; its data, collected from 2004 to 2009, are held in dbGaP as phs000277.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002596> (<http://www.ebi.ac.uk/coho/COHO_0002596>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29016987") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34497075") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35270332") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002596> "A pooling of four population-based cohorts from Stockholm County, Sweden (the Stockholm Diabetes Prevention Programme, a random sample of 60-year-olds known as SIXTY, the Stockholm-resident participants of the Screening Across the Lifespan Twin study, and the Swedish National Study on Aging and Care in Kungsholmen), recruited between 1992 and 2004 and analysed together to study long-term exposure to ambient air pollution and noise as risk factors for cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002597> (<http://www.ebi.ac.uk/coho/COHO_0002597>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38062070") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/CON") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002597> "A cohort of adult Danish residents who, since June 2021, have consented through a web application run by Statens Serum Institut to donate the digital receipts of their consumer purchases, linked through their personal identification number to national health registers, to study how purchases, diet and household lifestyle exposures affect health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002598> (<http://www.ebi.ac.uk/coho/COHO_0002598>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32414410") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42615545") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002598> "A prospective cohort of persons aged 45 to 64 years in the Netherlands, stratified by age and employment status, followed from 2010 by the Netherlands Organisation for Applied Scientific Research TNO through online questionnaires on work characteristics, health, employment transitions, work ability and productivity, to study sustainable work participation of older workers; a second group was recruited in 2015.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002599> (<http://www.ebi.ac.uk/coho/COHO_0002599>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38926412") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002599> "A cohort of women screened for human papillomavirus and cervical abnormalities in the capital region of Sweden, in the organised screening programme and in non-organised testing, enrolled from 2011 by the Center for Cervical Cancer Elimination at Karolinska Institutet and Karolinska University Hospital, with biobanked cervical samples and individual screening data updated from the Swedish National Cervical Screening Registry (NKCx), for long-term follow-up studies of cervical cancer and other diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002600> (<http://www.ebi.ac.uk/coho/COHO_0002600>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33664071") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.hongerwinter.nl/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002600> "A historical birth cohort of singletons born alive and at term in the Wilhelmina Gasthuis in Amsterdam, the Netherlands, around the time of the 1944–1945 Dutch famine (1943–1947), traced and studied by Amsterdam UMC since 1994 through repeated interviews, examinations, biological samples, imaging and registry linkage, to investigate the effects of acute maternal undernutrition during specific stages of gestation on later health, particularly cardiovascular and metabolic disease, ageing and mental health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002601> (<http://www.ebi.ac.uk/coho/COHO_0002601>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29752553") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40664750") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002601> "A prospective, population-based cohort of children born in Skåne, Sweden, between September 2000 and August 2004 who were screened as newborns for risk of type 1 diabetes, with children at increased risk followed with yearly capillary blood samples for islet autoantibodies from two to 15 years of age or until diabetes onset, to investigate the genetic and environmental factors contributing to or triggering type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002602> (<http://www.ebi.ac.uk/coho/COHO_0002602>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31747017") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ELFE") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002602> "The first French national birth cohort, of children recruited at birth in 2011 in a random sample of maternity units in metropolitan France during 25 selected days spread over the year and followed by the French Institute for Demographic Studies (Ined), Inserm and the French Blood Agency, to study the determinants of development, health and socialisation of children from birth to adulthood through a multidisciplinary approach.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002603> (<http://www.ebi.ac.uk/coho/COHO_0002603>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41106326") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41196593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://limburgsgeboortecohort.be/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ENVIRONAGE") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002603> "A prospective, population-based birth cohort of mother–newborn pairs recruited at delivery since February 2010 at East-Limburg Hospital (Ziekenhuis Oost-Limburg) in Genk, in the province of Limburg, Belgium, with umbilical cord blood collected at birth and follow-up of the children at 4 to 6 years of age at Hasselt University, to study how environmental exposures in early life influence the biology of human ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002604> (<http://www.ebi.ac.uk/coho/COHO_0002604>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25593103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29055031") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/HPV") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002604> "The participants of a community-randomised phase IV trial in which early adolescents born 1992–1995 and resident in 33 Finnish communities were invited in 2007–2009 and assigned by community to gender-neutral HPV16/18 vaccination, HPV16/18 vaccination of girls with hepatitis B vaccination of boys, or gender-neutral hepatitis B vaccination, and followed up with cervicovaginal sampling from 18.5 years of age, to compare the overall and herd effects of gender-neutral and girls-only HPV vaccination.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002605> (<http://www.ebi.ac.uk/coho/COHO_0002605>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17955333") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26071071") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/NINFEA") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.progettoninfea.it/index_en") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002605> "An Italian internet-based birth cohort of children born to pregnant women who volunteered through the study website, started as a pilot in Turin in July 2005 and extended to the rest of Italy, with recruitment until 2016 and online questionnaires completed by the mothers during pregnancy and repeatedly through the child's childhood and adolescence, set up to investigate the effects of pre-natal and early post-natal exposures on infant, child and adult health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002606> (<http://www.ebi.ac.uk/coho/COHO_0002606>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25970502") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33407552") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/RHEA") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002606> "A population-based mother-child cohort of pregnant women living in the prefecture of Heraklion, Crete, Greece, recruited at their first major ultrasound examination around week 12 of gestation at four prenatal clinics in Heraklion from February 2007 to February 2008, and of their children, followed from early pregnancy towards young adulthood to study how environmental, dietary and other early-life exposures affect the health of mothers and children, with a focus on childhood obesity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002607> (<http://www.ebi.ac.uk/coho/COHO_0002607>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31638273") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32367290") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002607> "The third cohort of the Rotterdam Study, a prospective population-based cohort of inhabitants of Ommoord, a suburb of Rotterdam in the Netherlands, aged 45 and over who had not already been examined in the study (mainly people aged 45 to 54), enrolled from 2006 to 2008 and re-examined periodically to study the causes and course of chronic diseases in mid-life and late life.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002608> (<http://www.ebi.ac.uk/coho/COHO_0002608>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31615055") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34435564") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002608> "A French couple-child cohort of pregnant women, their partners and their children, recruited between July 2014 and July 2017 at eight obstetric ultrasonography practices in the Grenoble area, set up by Inserm, CNRS and University Grenoble Alpes as a research platform with repeated personal exposure measurements and biological sampling during pregnancy and early life, to study the effects of air pollutants, non-persistent endocrine disruptors and other exposures on child growth, respiratory health and neurodevelopment and the biological pathways involved.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002609> (<http://www.ebi.ac.uk/coho/COHO_0002609>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21870174") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24587337") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/study/NCT00573781") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002609> "A 12-week randomised controlled dietary intervention trial of men and women aged 40 to 70 with impaired glucose metabolism and other features of the metabolic syndrome, recruited in 2007–2008 in the Kuopio area of Finland and run by the Department of Clinical Nutrition of the University of Eastern Finland, comparing a healthy Nordic-type diet rich in whole grain products, fatty fish and bilberries and a whole-grain-enriched diet with a control diet for effects on glucose and lipid metabolism, inflammation and endothelial function.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002610> (<http://www.ebi.ac.uk/coho/COHO_0002610>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29071810") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/MAT") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002610> "A nationwide population-based biobank cohort of the women in Finland who have been pregnant since 1983, made up of the first-trimester serum samples left over from the screening for congenital infections offered to all pregnant women, now held by the Northern Finland Biobank Borealis and linkable to national health registers such as the Finnish Cancer Registry and the Medical Birth Register, as a resource for epidemiological, biomarker and surveillance studies of cancer and other diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002611> (<http://www.ebi.ac.uk/coho/COHO_0002611>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25948663") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28626626") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002611> "A prospective community-based cohort of volunteer men and women aged 45–64 years recruited in 2010–2011 from the city of Kielce and its surrounding rural area in south-eastern Poland, with questionnaires and stored blood and urine samples, set up with support from the Polish-Norwegian Research Fund to study health, health-related behaviours and risk factors for chronic diseases and premature mortality.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002612> (<http://www.ebi.ac.uk/coho/COHO_0002612>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22194890") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002612> "A population-based study of men and women aged 20–65 years drawn as random samples of the populations of Amsterdam, Maastricht and Doetinchem in the Netherlands, whose cardiovascular and other chronic disease risk factors were measured by the Municipal Health Services in 1993–1997 in a project supported by the Dutch Ministry of Health, Welfare and Sport and the National Institute for Public Health and the Environment, and who were followed for disease through linkage with national registers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002613> (<http://www.ebi.ac.uk/coho/COHO_0002613>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39915565") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41762673") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://generationr.nl/next") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/GenR%20Next") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002613> "A population-based prospective cohort in Rotterdam, the Netherlands, of women enrolled from August 2017 before conception or during pregnancy, with their partners and children, followed from preconception and fetal life onwards by the Generation R group at Erasmus MC to study the growth, development and health of a new generation of children and their parents.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002614> (<http://www.ebi.ac.uk/coho/COHO_0002614>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42241480") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/NORDCAP") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.oulu.fi/en/projects/nordic-children-and-adults-born-preterm-nordcap") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002614> "A register-based cohort of all children born in Finland from 1987 onwards, identified from the Finnish Medical Birth Register and linked with other national health, social and population registers and with data on their parents, held by the University of Oulu (earlier by the Finnish Institute for Health and Welfare) to study how preterm birth, pregnancy disorders and other early-life factors predict health, well-being and societal outcomes from childhood to adulthood, and the intergenerational transmission of health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002615> (<http://www.ebi.ac.uk/coho/COHO_0002615>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34909561") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://api.datacite.org/dois/10.5281/zenodo.10707225") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/WDC") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002615> "A longitudinal cohort of healthy pregnant and non-pregnant women in Finland, enrolled by the University of Oulu from 2022 within the EU Human Exposome Assessment Platform (HEAP) project and followed for at least four months with wearable personal exposome monitors and repeated biological sampling (blood, saliva, sweat, urine), to pilot personal profiling of chemical and biological exposures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002616> (<http://www.ebi.ac.uk/coho/COHO_0002616>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28812915") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34631132") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002616> "A prospective population-based cohort of a random, sex- and age-stratified 1% sample of residents of Brno, Czech Republic, aged 25–64 years, drawn from health insurance registries in 2013 and examined at St Anne's University Hospital in Brno, to study how biological, psychosocial, environmental, behavioural and economic factors relate to cardiovascular disease and its outcomes in a Central European urban population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002617> (<http://www.ebi.ac.uk/coho/COHO_0002617>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35849349") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/BCS%201970") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002617> "A longitudinal birth cohort of the people born in England, Scotland and Wales in a single week of 1970, which began as the British Births Survey and has followed its members' health, physical, educational and social development and economic circumstances through childhood and adult life; it is managed by the Centre for Longitudinal Studies at University College London and core funded by the Economic and Social Research Council.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002618> (<http://www.ebi.ac.uk/coho/COHO_0002618>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24645673") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002618> "A population-based longitudinal cohort of women aged 55 years at recruitment from the industrialised Ruhr Area and rural areas north of it (Borken, Dülmen) in North Rhine-Westphalia, Germany, examined at baseline between 1985 and 1994 and followed up from 2006 onwards; initiated by the State Government of North Rhine-Westphalia to study the health effects of air pollution in women, and run by the IUF – Leibniz Research Institute for Environmental Medicine, Düsseldorf.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002619> (<http://www.ebi.ac.uk/coho/COHO_0002619>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31051508") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.med.uio.no/imb/english/research/projects/noma/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002619> "The participants of an 8-week double-blind randomised controlled dietary intervention trial run from 2012 to 2014 by the University of Oslo and the Oslo and Akershus University College of Applied Sciences, Norway, in which adults with moderately elevated cholesterol ate commercial food items in which saturated fat had been replaced by polyunsaturated fat, or control items, to study effects on blood lipids, immune-cell gene expression and blood metabolites.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002620> (<http://www.ebi.ac.uk/coho/COHO_0002620>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35334847") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002620> "A cross-sectional national health examination and nutrition survey of a representative sample of adults aged 18 years and over in Greece, drawn by two-stage stratified random sampling across all prefectures and examined between June 2013 and December 2014 by the Hellenic Health Foundation, following European Health Examination Survey and EFSA methodology, to describe the population's dietary intake, nutritional status and health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002621> (<http://www.ebi.ac.uk/coho/COHO_0002621>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25370913") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/study/NCT03550365") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002621> "The participants of a randomised crossover dietary intervention trial started in 2011 by the University of Eastern Finland with VTT Technical Research Centre of Finland, within the FIBREFECTS project, in which adults with self-reported gastrointestinal symptoms after eating grain products ate white wheat bread during a run-in and then wholegrain rye bread and wheat bread enriched with bioprocessed rye bran, to study the effects of modified cereal fibre on glucose metabolism, gut fermentation and gut-mediated health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002622> (<http://www.ebi.ac.uk/coho/COHO_0002622>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24506846") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36191030") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002622> "An Italian multicentre prospective birth cohort of newborns recruited from October 2011 to March 2015 in six maternity units in Florence, Rome, Trieste, Turin and Viareggio, with maternal blood, cord blood and other samples stored in a biobank at the Istituto Superiore di Sanità and follow-up by questionnaires through childhood, set up to study the effects of environmental exposures, parental conditions and social factors in pre- and early post-natal life on child health and development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002623> (<http://www.ebi.ac.uk/coho/COHO_0002623>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22792447") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.isrctn.com/ISRCTN67529475") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002623> "The participants of a randomised controlled weight-management trial run from 2008 to 2010 by the Institute of Public Health and Clinical Nutrition, University of Kuopio (now University of Eastern Finland), Finland, in which adults aged 30–65 with obesity followed a very-low-energy diet and were then randomised to weight-maintenance diets containing foods of higher or lower predetermined satiety value, to study whether food satiety value affects self-regulation of food intake and weight management.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002624> (<http://www.ebi.ac.uk/coho/COHO_0002624>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26520638") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002624> "A French general-purpose population-based cohort of adults aged 18–69 years at inclusion, randomly sampled from people covered by the national health insurance fund (CNAMTS) and included from the end of 2012 through health examinations at selected Health Screening Centres across France, with yearly questionnaires, periodic examinations, a biobank and linkage to national social and health databases; run by Inserm as a research infrastructure with a focus on occupational and social factors, chronic diseases and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002625> (<http://www.ebi.ac.uk/coho/COHO_0002625>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18326421") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24149084") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002625> "A prospective birth cohort of children born between June 2003 and October 2004 in two hospitals in Rome, Italy, to mothers resident in the district of the Local Health Unit RME, followed up through childhood as a pilot for a national Italian birth cohort, to study genetic and environmental influences on child health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002626> (<http://www.ebi.ac.uk/coho/COHO_0002626>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19440446") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30206078") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002626> "A prospective birth cohort of pregnant women living in Kaunas municipality, Lithuania, recruited in the first trimester at four prenatal care clinics of the Kaunas University of Medicine hospitals from 2007, first as the Kaunas cohort of the EU HiWATE project on drinking-water contaminants and pregnancy outcomes, and their children, later followed up in childhood and within the HELIX exposome project.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002627> (<http://www.ebi.ac.uk/coho/COHO_0002627>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38820320") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.celspac.cz/youngadults") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002627> "A follow-up study, begun in 2019 at Masaryk University in Brno, Czech Republic, of the young adults born in 1991 and 1992 who took part in the Czech arm of the European Longitudinal Study of Pregnancy and Childhood, joined by their siblings and partners and by others born in those years, who are examined clinically, give blood, urine and buccal samples and answer questionnaires, to study how lifestyle, social and environmental factors relate to early signs of chronic disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002628> (<http://www.ebi.ac.uk/coho/COHO_0002628>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27380795") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002628> "The Czech arm of the European Longitudinal Study of Pregnancy and Childhood initiated by the WHO Regional Office for Europe: a population-based prospective birth cohort of children born in 1991 and 1992 in the Brno and Znojmo regions of South Moravia, Czech Republic, and their parents, followed from pregnancy into early adulthood by questionnaires, medical records and examinations to study biological, psychosocial, economic and environmental influences on pregnancy, delivery, child development and health, and now held by RECETOX at Masaryk University.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002629> (<http://www.ebi.ac.uk/coho/COHO_0002629>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21367690") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.pelagie-inserm.fr/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002629> "A mother-child cohort set up by INSERM in Rennes of pregnant women enrolled before the 19th week of gestation by gynaecologists, obstetricians and ultrasonographers in three départements of Brittany, France, between 2002 and 2006, whose children are followed from birth through childhood into young adulthood, to study the effects of prenatal and childhood exposure to environmental and occupational chemicals such as pesticides on pregnancy, fertility and child development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002630> (<http://www.ebi.ac.uk/coho/COHO_0002630>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41874644") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.geracao21.com/en/project") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002630> "A prospective population-based birth cohort of infants born between April 2005 and August 2006 in all the public maternity units of the Porto Metropolitan Area, Portugal, and their families, set up at the University of Porto and followed through childhood and adolescence to study how pregnancy and early-life characteristics relate to later growth, health and risk of chronic disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002631> (<http://www.ebi.ac.uk/coho/COHO_0002631>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39010980") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.moli-sani.org/?page_id=423") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002631> "A population-based cohort of men and women aged 35 years or more living in the Molise region of southern Italy, randomly sampled with their family members from the city registries of Molise towns and recruited between 2005 and 2010, examined at baseline with a biobank of their samples and followed by linkage to regional health and mortality registries and a recall examination, to study genetic and environmental risk factors for cardiovascular, cancer and neurodegenerative diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002632> (<http://www.ebi.ac.uk/coho/COHO_0002632>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39107353") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.celspac.cz/tng") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002632> "A prospective birth cohort run by RECETOX at Masaryk University with University Hospital Brno, Czech Republic, which enrolled pregnant women from 2017 (after a 2015-2016 pilot) and follows them and their children from pregnancy through early childhood, collecting biological samples and questionnaires, to study exposome factors such as environment, lifestyle, nutrition, genetics and the gut microbiome behind chronic diseases and developmental disorders in children.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002633> (<http://www.ebi.ac.uk/coho/COHO_0002633>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42044183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://web.cut.ac.cy/childrenfirstcy/about") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002633> "The Cypriot site of the CHILDREN_FIRST multi-country prospective exposome cohort: children in the first grade of randomly selected public primary schools in Cyprus, recruited from October 2023 by the Cyprus University of Technology with the biobank of the University of Cyprus and assessed every year until the end of primary school with questionnaires, urine and saliva samples and home and school environmental measurements, to study how the exposome shapes early risk of cardiometabolic, neurodevelopmental and respiratory disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002634> (<http://www.ebi.ac.uk/coho/COHO_0002634>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30717671") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.lih.lu/en/oriscav-lux/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002634> "A nationwide population-based study of adults living in the Grand Duchy of Luxembourg, run by the Luxembourg Institute of Health, whose first wave (2007-2009) examined a random sample of residents and whose second wave (2016-2018) re-examined them together with new participants from the civil registry, another national health examination survey and volunteers, with questionnaires, clinical measurements and blood, urine and hair samples, to describe the prevalence and evolution of cardiovascular risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002635> (<http://www.ebi.ac.uk/coho/COHO_0002635>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/BiSC") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://projectebisc.org/en/bisc-project/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002635> "An exposome birth cohort of pregnant women enrolled between October 2018 and April 2021 at three tertiary university hospitals in Barcelona, Spain (Hospital Sant Joan de Déu, Hospital de la Santa Creu i Sant Pau and Hospital Clínic de Barcelona) and their primary healthcare centres, and of their children, followed from the first trimester of pregnancy through delivery into childhood to study the socio-environmental and genetic determinants of foetal and child health, growth and development and of maternal mental and physical health during and after pregnancy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002636> (<http://www.ebi.ac.uk/coho/COHO_0002636>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36601007") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://uceens.ugr.es/en/proyecto/puberty-and-metabolic-risk-in-obese-children-epigenetic-alterations-and-pathophysiological-and-diagnostic-implications/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002636> "A multicentre longitudinal follow-up in Spain (Santiago de Compostela, Córdoba, Zaragoza and Granada) of children who had taken part in the GENOBOX study before puberty and were re-examined after reaching puberty, grouped by obesity and insulin resistance status, to study the progression of metabolic syndrome and cardiometabolic risk factors from prepuberty to puberty and to find biomarkers and epigenetic marks of metabolic complications during puberty.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002637> (<http://www.ebi.ac.uk/coho/COHO_0002637>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40777557") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://espina.ucsd.edu/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002637> "A prospective cohort set up in 2008 of children living in the agricultural (floricultural) community of Pedro Moncayo County, Pichincha, Ecuador, recruited to include a balanced mix of children who did and did not live with a floricultural or agricultural worker and followed with repeated examinations into adolescence and adulthood, run by the University of California San Diego with Fundación Cimas del Ecuador to study the health effects of pesticide and other agrochemical exposures from childhood to adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002638> (<http://www.ebi.ac.uk/coho/COHO_0002638>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35641005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37944432") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ROLS") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002638> "An administrative cohort of the residents of Rome, Italy, enrolled from population census returns (the 2001 census and the census of 9 October 2011) linked to the municipal population registry, and followed by record linkage with administrative health databases, with baseline residential addresses linked to environmental exposures such as air pollution, temperature and greenness. It is run by the Department of Epidemiology of the Lazio Regional Health Service (ASL Roma 1) to study social, occupational and environmental determinants of health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002639> (<http://www.ebi.ac.uk/coho/COHO_0002639>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26503980") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42615545") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/Precube") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002639> "An occupational cohort of the employees of employers in Belgium that chose IDEWE as their External Service for Prevention and Protection at Work, followed from 1993 through the records of their legally required occupational health surveillance. IDEWE pools the records in a data warehouse for research on work-related diseases and sector-specific health problems.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002640> (<http://www.ebi.ac.uk/coho/COHO_0002640>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17049075") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://europepmc.org/article/PPR/PPR1175525") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/HAPIEE-CZ") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002640> "The Czech Republic cohort of the HAPIEE study: a random sample of men and women aged 45-69 years, stratified by sex and age and selected from population registers in six Czech towns (Havířov/Karviná, Hradec Králové, Jihlava, Kroměříž, Liberec and Ústí nad Labem), examined at baseline in 2002-2005 and followed through re-examinations (most recently in 2023-2024) and linkage to national health registers, with geocoded addresses linked to exposome and census data. The aim is to study psychosocial, behavioural and environmental risk factors for cardiovascular and other chronic diseases and for ageing outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002641> (<http://www.ebi.ac.uk/coho/COHO_0002641>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25646337") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/study/NCT01239693") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/iLiNS%20DOSE%20iLiNS%20DYAD") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002641> "The participants of a randomised, single-blind controlled trial in rural Malawi (Mangochi, University of Malawi College of Medicine with Tampere University), part of the International Lipid-Based Nutrient Supplements (iLiNS) Project: pregnant women enrolled from 2011, and later their infants. The women received small-quantity lipid-based nutrient supplements, multiple micronutrients or iron-folic acid during pregnancy and lactation, and the infants were followed to test effects on birth size, child growth and development, with a later follow-up of the children at 9 years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002642> (<http://www.ebi.ac.uk/coho/COHO_0002642>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27825389") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.protectkidshealth.com/about") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002642> "A prospective longitudinal cohort of pregnant women enrolled since 2009 at prenatal clinics in the Concord and Lebanon regions of New Hampshire, USA, by the Geisel School of Medicine at Dartmouth, and of their children, followed from early pregnancy into childhood to study how environmental contaminants, such as arsenic from private well water, affect the health of pregnant women and their children.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002643> (<http://www.ebi.ac.uk/coho/COHO_0002643>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41606232") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SDACS") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002643> "A community-based open cohort of residents aged 65 and older of the Dapu (Dapuqiao) neighbourhood of Huangpu District in central Shanghai, China, recruited through the Shanghai Municipal Annual Physical Examination Program for older residents and examined in three waves in 2019, 2022 and 2024, mostly as repeated cross-sectional samples with a small longitudinal subset, to study health, lifestyle and cognition in an ageing urban population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002644> (<http://www.ebi.ac.uk/coho/COHO_0002644>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23778574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://share-eric.eu/data/data-documentation/waves-overview/wave-1") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://share-eric.eu/data/data-documentation/waves-overview/wave-7") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://share-eric.eu/infrastructure") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002644> "A multidisciplinary, cross-nationally harmonised longitudinal panel survey of people aged 50 and older, begun in 2004 in eleven European countries and Israel and extended to all EU member states and Switzerland, run as a European Research Infrastructure Consortium (SHARE-ERIC, coordinated from Munich and later Berlin), that collects data on health, biomarkers, cognition, employment, socio-economic status and social and family networks to study the effects of health, social, economic and environmental policies over the life course.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002645> (<http://www.ebi.ac.uk/coho/COHO_0002645>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39482079") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://lasi-dad.org/about/overview") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://lasi-dad.org/study-design") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002645> "A nationally representative in-depth study of late-life cognition and dementia in India, led from the University of Southern California with Indian partners, that recruited a sub-sample of Longitudinal Aging Study in India (LASI) respondents aged 60 and older, oversampling those at high risk of cognitive impairment, from 18 states and union territories in 2017–2019 and 22 in 2022–2024, and assessed them with the Harmonized Cognitive Assessment Protocol, informant interviews, geriatric assessments, blood biomarkers, neuroimaging, genomics and environmental exposure measures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002646> (<http://www.ebi.ac.uk/coho/COHO_0002646>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022817") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/Hokkaido%20Study") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002646> "An ongoing prospective birth cohort study run by the Center for Environmental and Health Sciences of Hokkaido University, Japan, made up of the Sapporo cohort, recruited in pregnancy at one Sapporo hospital in 2002–2005, and the Hokkaido cohort, recruited in the first trimester at clinics and hospitals across Hokkaido Prefecture in 2003–2012, that follows the children to study the effects of prenatal and postnatal exposure to environmental chemicals on birth outcomes, birth defects, growth, allergies, infections and neurodevelopment, and genetic susceptibility to them.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002647> (<http://www.ebi.ac.uk/coho/COHO_0002647>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24149084") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24862831") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/GINI/LISA%20North") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002647> "The children of the German birth cohorts GINIplus (born 1995–1998) and LISAplus (born 1997–1999) recruited in the rural study area of Wesel, near the industrial Ruhr area in western Germany, whose data are pooled because the two cohorts have nearly identical designs and analysed as one study population, as in the ESCAPE and EXPANSE air pollution and exposome consortia, separately from the urban Munich participants (GINI/LISA South).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002648> (<http://www.ebi.ac.uk/coho/COHO_0002648>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34169045") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/WALNUTs") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002648> "A multi-school, population-based, parallel-group randomised controlled trial of healthy adolescents aged 11 to 16 attending schools in Barcelona, Spain, run by researchers of ISGlobal in 2016–2017, that tested whether eating 30 g of walnuts a day for six months improves neuropsychological and socio-emotional development, with cognitive, behavioural, lifestyle and environmental assessments and blood and urine samples from part of the participants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002649> (<http://www.ebi.ac.uk/coho/COHO_0002649>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " PMID:35596598 ") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/GENOBOX") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33171599 ") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002649> "A multicentre hospital-based case–control study of children and adolescents in Spain, recruited at the university hospitals of Santiago de Compostela (Hospital Clínico Universitario de Santiago), Zaragoza (Hospital Clínico Universitario Lozano Blesa) and Córdoba (Hospital Universitario Reina Sofía): cases attending hospital with suspected overweight or obesity, and controls attending for minor disorders or common infections that were not confirmed, studied to understand the pathophysiology and cardiometabolic, inflammatory and oxidative-stress risk factors of childhood obesity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002650> (<http://www.ebi.ac.uk/coho/COHO_0002650>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " https://pipaufrj.me.ufrj.br/sobre/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32566487 ") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002650> "A hospital-based prospective birth cohort of pregnant women aged 16 or over living in the city of Rio de Janeiro, Brazil, and their children born at the Maternity School of the Federal University of Rio de Janeiro, coordinated by the university's Institute for Studies in Collective Health with Fiocruz, in which mothers and children are followed with interviews, examinations and biological samples from pregnancy to age four to study the effects of prenatal and early-life exposure to metals, pesticides and plasticisers on child health and development; a pilot phase ran from September 2017 to August 2018.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002651> (<http://www.ebi.ac.uk/coho/COHO_0002651>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PROGRESS") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " https://mountsinaiexposomics.org/progress/ ") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42225914 ") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002651> "A prospective birth cohort of pregnant women receiving prenatal care through the Mexican Social Security Institute (IMSS) in Mexico City, recruited from July 2007 to February 2010, and their children, run by the Icahn School of Medicine at Mount Sinai, Harvard University and Mexico's National Institute of Public Health, and followed to study how prenatal and early-life exposure to metals, air pollution and phthalates, together with chronic psychosocial stress, affects child neurodevelopment, growth and metabolic health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002652> (<http://www.ebi.ac.uk/coho/COHO_0002652>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " PMID:29847083 ") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ISA") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25198283 ") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002652> "A prospective community-based birth cohort of pregnant women aged 15 or over living in 40 villages of Matina County, Limón, Costa Rica, within 5 km of large-scale banana plantations where the fungicide mancozeb is sprayed from the air, enrolled from March 2010 to June 2011 by the Central American Institute for Studies on Toxic Substances (IRET) of the Universidad Nacional, and their children, followed to study the effects of prenatal pesticide and manganese exposure on children's growth, neurodevelopment and respiratory health and on the mothers' health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002653> (<http://www.ebi.ac.uk/coho/COHO_0002653>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " PMID:41586258 ") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " PMID:42251497 ") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " https://red-lat.com/en-the-project/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33776890 ") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002653> "A multicentre cohort of people with Alzheimer's disease or frontotemporal dementia and cognitively unimpaired controls, recruited at memory clinics and other clinical and community sites in Argentina, Brazil, Chile, Colombia, Mexico and Peru by the Multi-Partner Consortium to Expand Dementia Research in Latin America with the University of California San Francisco Memory and Aging Center, and assessed under a harmonised protocol (clinical, cognitive, genetic, neuroimaging and EEG data, and a questionnaire on lifelong social exposures) to study how genetic, social and environmental factors shape dementia and brain health in Latin America compared with the United States.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002654> (<http://www.ebi.ac.uk/coho/COHO_0002654>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/SPRINT") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34780516 ") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002654> "A cross-sectional field study of the EU Horizon 2020 SPRINT project in which, during the 2021 growing season, conventional and organic farmers and their families, neighbours living next to or near agricultural fields, and consumers living farther away were recruited at ten case study sites in Europe and one in Argentina, and gave urine, blood, faeces and nasal swabs and wore silicone wristbands (with indoor dust sampled in their homes), to measure their exposure to pesticide mixtures for exposure modelling and health risk assessment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002655> (<http://www.ebi.ac.uk/coho/COHO_0002655>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/MAUCO") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26847446 ") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002655> "A population-based prospective cohort of adults aged 38 to 74 years living in the agricultural county of Molina, in the Maule Region of central Chile, identified through a household census and enrolled from December 2014 by the Advanced Center for Chronic Diseases (ACCDiS) of the Universidad de Chile and the Pontificia Universidad Católica de Chile, with questionnaires, physical examinations, ultrasound and a biobank of blood, urine and saliva, and followed with repeat visits and surveillance of hospital events to study the natural history and environmental, lifestyle and social determinants of chronic diseases such as cardiometabolic diseases and cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002656> (<http://www.ebi.ac.uk/coho/COHO_0002656>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27956896") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31607769") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002656> "A population-based cross-sectional national survey of community-dwelling adults aged 60 years and over in urban and rural areas of Colombia, carried out in 2015 for the Colombian Ministry of Health and Social Protection by the University of Caldas and the Universidad del Valle with the design of the Latin American and Caribbean Survey on Health, Well-Being, and Aging (SABE), to study health, active ageing and the social determinants of health inequities in older people.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002657> (<http://www.ebi.ac.uk/coho/COHO_0002657>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35070447") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.icbf.gov.co/bienestar/nutricion/encuesta-nacional-situacion-nutricional") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002657> "A repeated nationally representative cross-sectional household survey of the nutritional situation of the population of Colombia, conducted by the Colombian Institute for Family Welfare (ICBF) with the Ministry of Health in 2005, 2010 and 2015, covering people aged 0 to 64 years and pregnant women, that measures nutritional status, dietary intake, food security, breastfeeding and physical activity to inform public food and nutrition policy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002658> (<http://www.ebi.ac.uk/coho/COHO_0002658>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32888015") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39687239") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002658> "A consortium of population-based cohort studies from countries of Latin America and the Caribbean, set up with Wellcome Trust funding and run from Imperial College London with a regional network of researchers, that harmonises and pools individual-level data on cardio-metabolic risk factors and fatal and non-fatal cardiovascular outcomes to produce regional risk estimates and tools for cardiovascular prevention.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002659> (<http://www.ebi.ac.uk/coho/COHO_0002659>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24990475") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002659> "A prospective birth cohort of newborns recruited from 2006 to 2009 at the hospital serving the rural district of Quinindé, Esmeraldas Province, in tropical coastal Ecuador, run by the Laboratorio de Investigaciones FEPIS with St George's, University of London, that follows the children through childhood to study how soil-transmitted helminth infections and other early-life microbial and environmental exposures affect immune development, atopy, allergic disease and asthma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002660> (<http://www.ebi.ac.uk/coho/COHO_0002660>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39264897") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40065011") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/BNTTF") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002660> "The donors of the Terry Fox National Tumour Bank, the biobank of the Instituto Nacional de Cancerología in Bogotá, Colombia: people with cancer, people without cancer and cancer survivors who gave informed consent, answered an epidemiological questionnaire on clinical, sociodemographic, risk-factor, family cancer and lifestyle information, and donated blood and, at surgery, tumour and adjacent non-tumour tissue, stored for health research with an emphasis on cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002661> (<http://www.ebi.ac.uk/coho/COHO_0002661>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23243115") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002661> "A nationally representative longitudinal survey of community-dwelling people aged 45 years and older in China and their spouses, run from the National School of Development of Peking University, with a 2008 pilot in two provinces and a national baseline in 2011-2012 drawn by multistage probability sampling from 150 counties in 28 provinces, followed up every two years and harmonised with the Health and Retirement Study, to study the health, social and economic consequences of population ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002662> (<http://www.ebi.ac.uk/coho/COHO_0002662>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36893367") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37733993") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.imperial.ac.uk/medicine/research-and-impact/groups/react-study/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002662> "A national cohort in England of people who took part in the REal-time Assessment of Community Transmission programme of Imperial College London, which from 2020 sent random samples of people aged 5 years and older, drawn from National Health Service general practice registers, SARS-CoV-2 swab tests (REACT-1) and antibody self-tests (REACT-2) for the Department of Health and Social Care, and who consented to recontact and linkage to their health records, used to study the longer-term effects of the COVID-19 pandemic and other factors on health and wellbeing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002663> (<http://www.ebi.ac.uk/coho/COHO_0002663>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36976969") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://studie3xg.be/nl") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002663> "A local birth cohort of children born between 2010 and 2015 to mothers living in the neighbouring rural municipalities of Dessel, Mol and Retie in Flanders, Belgium, run by the Flemish Institute for Technological Research (VITO) and co-financed by the Belgian radioactive waste agency and local consultation bodies, that follows the children with human biomonitoring and questionnaires, alongside the municipalities' disease and mortality registers, to monitor the effects of environmental and lifestyle exposures on health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002664> (<http://www.ebi.ac.uk/coho/COHO_0002664>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37656714") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://kohorsz18.hu/en/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002664> "A nationally representative longitudinal birth cohort of children born in Hungary between March 2018 and April 2019 and their parents, recruited in pregnancy and run by the Hungarian Demographic Research Institute of the Hungarian Central Statistical Office, to study the circumstances of childbearing and childrearing and the parental, family and social factors that shape children's development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002665> (<http://www.ebi.ac.uk/coho/COHO_0002665>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38351973") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38810531") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/COMBAT") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002665> "A nationwide community-based survey of adults in Tuvalu, on Funafuti and the eight outer islands, run in waves since 2020 and funded jointly by the Taiwan International Cooperation and Development Fund and the Tuvalu government, studying diet, lifestyle behaviours, climate-related exposures and obesity and other non-communicable diseases; from 2025 it is being continued as a longitudinal cohort with repeated surveys, clinical assessments and biomonitoring.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002666> (<http://www.ebi.ac.uk/coho/COHO_0002666>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33952246") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/ROC") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002666> "A prospective birth cohort of babies born at the University Hospital of the University of São Paulo School of Medicine between April 2012 and March 2014 to mothers living in the Butantã-Jaguaré area of São Paulo's Western Region, Brazil, followed to study how social and environmental factors, including toxic stress, affect early childhood development in a low-income urban setting.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002667> (<http://www.ebi.ac.uk/coho/COHO_0002667>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39540417") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002667> "A national longitudinal cohort of people born in 1989-90 who were in Year 9 of secondary school in England in 2004, sampled through schools with over-sampling of deprived schools and ethnic minorities, begun by the Department for Education and run since 2013 by the Centre for Longitudinal Studies at University College London, following their education, work, economic circumstances, family life, health and wellbeing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002668> (<http://www.ebi.ac.uk/coho/COHO_0002668>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36662732") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/PROMESA") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002668> "A prospective cohort of children under five years old insured by a single health insurance company in Bogotá and Medellín, Colombia, enrolled from 2021 and followed for one year to study how the external exposome, above all particulate matter air pollution, contributes to acute respiratory infections, asthma and early DNA damage.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002669> (<http://www.ebi.ac.uk/coho/COHO_0002669>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37620778") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/BUNMAP") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002669> "A population-based prospective mother-child cohort of pregnant women living in the Butajira Health and Demographic Surveillance Site, Meskan and Mareko district, Ethiopia, enrolled from 2017-2018 by the School of Public Health of Addis Ababa University and followed through pregnancy and after birth to study how maternal nutrition, mycotoxin exposure and mental health affect prenatal and postnatal growth and development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002670> (<http://www.ebi.ac.uk/coho/COHO_0002670>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34257407") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002670> "The participants of a randomised controlled trial run by the University of São Paulo Medical School from 2015 of Primeiros Laços, a nurse home visiting programme from early pregnancy to the child's age of two years, in low-income first-time pregnant adolescents aged 14-19 recruited through primary healthcare units in the western region of São Paulo, Brazil, and their children, followed to test the programme's effects on child development, maternal and home environment outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002671> (<http://www.ebi.ac.uk/coho/COHO_0002671>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " PMID:19332502") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37781157 ") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002671> "A population-based prospective cohort of adults aged 40 to 75 years enrolled between 2004 and 2008 from rural and urban areas of Golestan province in northeast Iran, set up to study oesophageal cancer and followed for cancers and other outcomes, including those attributable to opium use and smoking.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002672> (<http://www.ebi.ac.uk/coho/COHO_0002672>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22735991") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002672> "A register-based cohort of everyone in Norway who took part in the national censuses from 1960 to 2001, in which family members are linked through personal identity numbers and household and family information from the 1960 census and further linked to health registers and surveys, for multigenerational life-course research in public health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002673> (<http://www.ebi.ac.uk/coho/COHO_0002673>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> " https://biobanco.uchile.cl/proyecto-c19-genonet-2/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39596552 ") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002673> "A nationwide multicentre cohort of adults with confirmed SARS-CoV-2 infection, from asymptomatic to fatal, recruited from September 2020 into 2021 through nine recruitment centres in seven regions of Chile by a network of Chilean universities and health centres coordinated by the University of Chile's Biobank of Tissue and Fluids, with blood samples and clinical data banked for multi-omics studies of host genetics and COVID-19 severity, and recontacted for long COVID follow-up; the network behind it became the COVID-19 Genomics Network (C19-GenoNet).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002674> (<http://www.ebi.ac.uk/coho/COHO_0002674>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11056681") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ceu.ox.ac.uk/research/the-million-women-study") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002674> "A population-based prospective cohort of women aged 50–64 years in the United Kingdom, recruited in 1996–2001 when invited to routine mammography by the National Health Service Breast Screening Programme at centres in England and Scotland and coordinated by the Cancer Epidemiology Unit of the University of Oxford, set up to study the effects of hormone replacement therapy on breast cancer and other outcomes and followed for the effects of many other factors on women's health as they age.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002675> (<http://www.ebi.ac.uk/coho/COHO_0002675>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33194979") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41721974") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.biobanking.org/biobanks/view/462") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002675> "A population-based biobank of Saudi nationals aged 10 years and over, recruited since 2017 by the Saudi Biobank Center of King Abdullah International Medical Research Center in Riyadh, in person at Ministry of National Guard Health Affairs hospitals and clinics and at community sites such as blood donation centres, with questionnaires, biological samples and linked electronic health records, to support genetic and epidemiological research on common and rare diseases in Saudi Arabia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002676> (<http://www.ebi.ac.uk/coho/COHO_0002676>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41286709") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://persiancohort.com/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002676> "An ongoing nationwide population-based prospective cohort of adults aged 35–70 years living in 18 regions of Iran chosen to cover its ethnic, environmental and socioeconomic diversity, enrolled since 2014 through a network of Iranian medical universities coordinated by the Digestive Diseases Research Institute of Tehran University of Medical Sciences, with a biobank, to study environmental, lifestyle and genetic determinants of non-communicable diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002677> (<http://www.ebi.ac.uk/coho/COHO_0002677>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39754130") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41844214") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002677> "A whole-population birth and parent cohort open to all children born in the state of Victoria, Australia, between October 2021 and October 2023 and their parents, recruited from December 2020 (an Advance Cohort, then newborns at Victorian maternity services and later remote and ongoing enrolment) and led from the Murdoch Children's Research Institute, which combines linked administrative and clinical data, biosamples and phenotypic waves as a platform for discovery and intervention research on child and adult health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002678> (<http://www.ebi.ac.uk/coho/COHO_0002678>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34143882") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002678> "A population-based study of adults aged 18 years and over of South Asian ethnicity, recruited from 2018 at non-communicable disease surveillance sites centred on primary community health care units in Bangladesh, India, Pakistan and Sri Lanka by a partnership of centres in those countries and the United Kingdom led from Imperial College London, with standardised health assessments, environmental mapping and biological samples, to identify the genetic and environmental causes of type 2 diabetes, cardiovascular and other non-communicable diseases in South Asians.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002679> (<http://www.ebi.ac.uk/coho/COHO_0002679>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32328990") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38506636") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002679> "A platform established by the UK Medical Research Council to accelerate the development of new treatments for dementia, run from the University of Oxford, whose Data Portal, launched in 2017, brings together data from independent population and clinical cohorts, most of them in the United Kingdom, in a shared remote-access environment for collaborative and multi-cohort research on dementia and neurodegeneration.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002680> (<http://www.ebi.ac.uk/coho/COHO_0002680>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28799450") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35427403") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40018598") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002680> "A health and demographic surveillance system following the largely rural population of villages in the Iganga and Mayuge districts of eastern Uganda, established in the mid-2000s by Makerere University with the two districts and Karolinska Institutet and run by the Makerere University Centre for Health and Population Research, which records pregnancies, births, deaths and other events in census rounds and links household data with health facility records, as a platform for population health research and research training.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002681> (<http://www.ebi.ac.uk/coho/COHO_0002681>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40879407") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002681> "A sub-study of the fourth wave (HUNT4, 2017–2019) of the Trøndelag Health Study in which all inhabitants aged 70 years and older in the northern Trøndelag region of Norway were invited to detailed assessments of cognition and health, used to study the prevalence and incidence of dementia and mild cognitive impairment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002682> (<http://www.ebi.ac.uk/coho/COHO_0002682>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://web.archive.org/web/20241104022517/https://www.ed.ac.uk/coronagenes/about/coronagenes-study") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://institute-genetics-cancer.ed.ac.uk/news-and-events/news-2020/home-dna-test-data-wanted-boost-coronavirus-fight") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002682> "A cohort of volunteers recruited online from 2020 by the MRC Human Genetics Unit at the University of Edinburgh who shared genotype data from direct-to-consumer genetic testing services and completed questionnaires on their health, lifestyle and COVID-19 symptoms, to identify genes that influence the risk and severity of COVID-19.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002683> (<http://www.ebi.ac.uk/coho/COHO_0002683>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36260190") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002683> "A multidisciplinary population-based prospective cohort of men and women aged 19 to 74 years drawn at random from the general population and examined between 2014 and 2019 at 18 study centres across Germany, with interviews, questionnaires, biomedical examinations, biosamples and whole-body magnetic resonance imaging in a subsample, followed up by questionnaires, record linkage and re-examination, to investigate the causes, early detection and prevention of common chronic and infectious diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002684> (<http://www.ebi.ac.uk/coho/COHO_0002684>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29462329") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34299667") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002684> "A nationwide population-based prospective cohort of multi-ethnic Malaysian adults aged 35 to 70 years, recruited from 2006 to 2012 by the UKM Medical Molecular Biology Institute of the National University of Malaysia and followed up by periodic re-surveys, telephone follow-up and registry linkage, to study the causes of non-communicable diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002685> (<http://www.ebi.ac.uk/coho/COHO_0002685>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28171707") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002685> "A prospective cohort of adults in the United States and Puerto Rico recruited by the American Cancer Society between 2006 and 2013, mainly at community events, who gave a blood sample and survey information and are followed through repeat surveys and linkage with cancer registries and the National Death Index, to study lifestyle, genetic and other causes of cancer and other outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002686> (<http://www.ebi.ac.uk/coho/COHO_0002686>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41927563") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002686> "A cohort of demographically diverse adults recruited in North Carolina since 2002 by the National Institute of Environmental Health Sciences, first as the Environmental Polymorphisms Registry, who complete surveys on health, exposures, diet and lifestyle, give biological samples and are genotyped, with geocoded residential data, to study how environment, lifestyle and genes act together on disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002687> (<http://www.ebi.ac.uk/coho/COHO_0002687>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37117635") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://atlas.ihccglobal.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002687> "A general population cohort of adults in Newfoundland and Labrador, Canada, established by the company Sequence Bioinformatics (Sequence Bio) of St. John's and recruiting from 2019, whose participants, aged 18 and over with a valid provincial health card, were recruited at random from general practice clinics across the province and gave medical history and saliva samples for genotyping, to characterise the genetics of the province's founder population and find genetic causes of disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002688> (<http://www.ebi.ac.uk/coho/COHO_0002688>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://uklwc.mrcctu.ucl.ac.uk/overview") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.innovative-ctu.ucl.ac.uk/studies/all-studies/u/uklwc/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002688> "A cohort of postmenopausal women aged 50–74 from the general population of England, Wales and Northern Ireland, recruited in 2001–2005 to the United Kingdom Collaborative Trial of Ovarian Cancer Screening (UKCTOCS), a randomised trial of ovarian cancer screening, whose donated serum samples (at recruitment and, in the multimodal screening arm, annually until 2011) and linked national health records are kept by the MRC Clinical Trials Unit at University College London as an open bioresource for studies of common diseases and disease markers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002689> (<http://www.ebi.ac.uk/coho/COHO_0002689>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22544844") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002689> "A population cohort of the residents of a defined area around Kilifi on the Indian Ocean coast of Kenya, established in 2000 by the KEMRI-Wellcome Trust Research Programme with a census and followed by regular household visits recording births, pregnancies, migrations and deaths, with residents' admissions to Kilifi District Hospital linked to the population register, to measure the incidence of local diseases, evaluate community interventions against infectious diseases and provide a sampling frame for epidemiological studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002690> (<http://www.ebi.ac.uk/coho/COHO_0002690>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12015775") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33803340") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002690> "A subset of the Cancer Prevention Study II participants, men and women living in 21 US states, enrolled by the American Cancer Society through a mailed questionnaire in 1992–1993 and followed by biennial questionnaires, medical records and registry linkage for incident cancer and death, with blood samples from a subgroup, to study diet and other lifestyle factors and exposures in relation to cancer risk, mortality and survival.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002691> (<http://www.ebi.ac.uk/coho/COHO_0002691>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36963379") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://echochildren.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002691> "A collaborative cohort study funded in 2016 by the US National Institutes of Health within the Environmental influences on Child Health Outcomes (ECHO) Program, bringing together existing and new pregnancy and paediatric cohorts across the United States and Puerto Rico under a common data collection protocol to study how early-life environmental exposures affect pre-, peri- and postnatal outcomes, airway health, obesity, neurodevelopment and positive health in children.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002692> (<http://www.ebi.ac.uk/coho/COHO_0002692>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30713262") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002692> "A population-based prospective cohort of residents aged 40 to 74 years of 16 municipalities in seven prefectural areas of Japan, enrolled from 2011 to 2016 through a central office at the National Cancer Center and regional public health centres and universities as the successor to the Japan Public Health Center-based Prospective Study, with questionnaires and blood and urine samples, to identify risk factors for lifestyle-related diseases and factors that extend healthy life expectancy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002693> (<http://www.ebi.ac.uk/coho/COHO_0002693>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26729395") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33038086") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002693> "A government-funded, population-based cardiovascular screening cohort run by the National Center for Cardiovascular Diseases (Fuwai Hospital, Beijing) that, after a pilot in four provinces, enrolled community-dwelling residents aged 35 to 75 years at urban districts and rural counties in all 31 provinces of mainland China from 2014, with blood pressure, anthropometric and lipid measurements and a health questionnaire, and gave further assessment, counselling and follow-up to those at high risk, to identify people at high risk of cardiovascular disease and support research on its prevention.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002694> (<http://www.ebi.ac.uk/coho/COHO_0002694>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33437994") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002694> "An open population cohort of all resident and non-resident members of households in a demographic and health surveillance area in the uMkhanyakude district of rural KwaZulu-Natal, South Africa, established in 2000 by the Africa Centre for Health and Population Studies (now the Africa Health Research Institute) and expanded and renamed the Population Intervention Platform in 2017, with repeated household surveillance and population-based HIV surveys, to describe the demographic, social and health impact of the HIV epidemic, and later of tuberculosis and non-communicable diseases, and to evaluate interventions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002695> (<http://www.ebi.ac.uk/coho/COHO_0002695>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21104112") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39934197") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002695> "A population-based prospective cohort study and research infrastructure in Sweden, run from Karolinska Institutet, that from 2009 to 2016 recruited adults from the general population, mainly in the Stockholm region, with index persons aged 18 to 45 years invited to bring their household members, and collected questionnaires, physical assessments and biological samples with planned repeated follow-up, to study diseases with onset early in life, pregnancy and early-life exposures, and later co-morbidity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002696> (<http://www.ebi.ac.uk/coho/COHO_0002696>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41469377") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.npm.sg/our-data-users/data-access/data-access-to-precise-sg100k/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002696> "A collection of four longitudinal population health cohorts in Singapore (HELIOS, the Singapore Population Health Studies, the Singapore Epidemiology of Eye Diseases and SingHeart), brought together under an NMRC grant and in partnership with Precision Health Research, Singapore (PRECISE) and the Genome Institute of Singapore in phase II of the National Precision Medicine programme, whose multi-ancestry Asian participants were whole-genome sequenced and linked to electronic health records to study the determinants and prediction of cardiovascular disease and diabetes in Asian populations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002697> (<http://www.ebi.ac.uk/coho/COHO_0002697>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34966919") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://saprin.mrc.ac.za/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002697> "A national network, established in 2016 by South Africa's Department of Science and Innovation and hosted by the South African Medical Research Council, that harmonises the longitudinal population surveillance of health and demographic surveillance system (HDSS) nodes in South Africa, starting from the rural Agincourt, DIMAMO and Africa Health Research Institute HDSSs and extending to urban nodes, to provide up-to-date longitudinal health, demographic and socioeconomic data for research and national policy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002698> (<http://www.ebi.ac.uk/coho/COHO_0002698>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28557991") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32478023") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.lifepathproject.eu/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002698> "A research consortium funded by the European Commission under Horizon 2020 that pooled and harmonised data from existing adult and child cohort studies in Europe, the USA and Australia, including CoLaus, SKIPOGH, Constances and the Melbourne Collaborative Cohort Study, with biomarker and omics sub-studies, to investigate the biological pathways through which socioeconomic position affects healthy ageing over the life course.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002699> (<http://www.ebi.ac.uk/coho/COHO_0002699>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16234822") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19380371") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002699> "A population-based cohort of adult residents of Vorarlberg, the westernmost province of Austria, enrolled from 1985 through a routine risk-factor surveillance and prevention programme run by the Agency for Social and Preventive Medicine, in which local physicians carried out a physical examination, blood test and consultation, and followed by linkage to the Vorarlberg cancer registry and death index to study metabolic and other risk factors for cancer, cardiovascular disease and mortality.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002700> (<http://www.ebi.ac.uk/coho/COHO_0002700>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35604374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002700> "A prospective population-based cohort of men and women aged 45 years and over in New South Wales, Australia, randomly sampled from the Medicare enrolment database and recruited by postal questionnaire in 2005–2009 by the Sax Institute, with oversampling of people aged 80 and over and of rural and remote residents, repeated follow-up surveys, biospecimen sub-studies and routine linkage to mortality, hospital, pharmaceutical and other health records, as a resource for research on health and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002701> (<http://www.ebi.ac.uk/coho/COHO_0002701>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40841586") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002701> "An international consortium of large population cohorts, established in 2018 to work beyond the constraints of individual health and population cohorts, whose members are chosen for size, longitudinal health follow-up, broad participant selection, biological sample collection and a commitment to data sharing, and which maintains the IHCC Cohort Atlas, a directory of the data its member cohorts hold.")


)