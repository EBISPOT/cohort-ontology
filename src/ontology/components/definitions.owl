AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000985") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40393126") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40393126+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "50 AYAs aged 12-29 with newly diagnosed or recurrent HGG and other high risk central nervous system (CNS) tumours were prospectively recruited to the EORTC SPECTA platform study and underwent whole exome sequencing, RNA sequencing and methylation profiling, with central pathological review.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000249> "A cohort of adolescent and young adult patients aged 12 to 29 with newly diagnosed or relapsed high-grade glioma or other high-risk central nervous system tumours recruited across Europe from 2019 in the EORTC SPECTA RP1759 study to bridge the molecular gap between paediatric and adult oncology.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000985") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000985") Annotation(rdfs:comment "The initial pilot study, activated in February 2019 across Europe, aimed to recruit 50 AYA patients (aged 12-29 years) with newly diagnosed or relapsed high-grade gliomas, and for which matching tumor and blood samples were collected.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000249> "A cohort of adolescent and young adult patients aged 12 to 29 with newly diagnosed or relapsed high-grade glioma or other high-risk central nervous system tumours recruited across Europe from 2019 in the EORTC SPECTA RP1759 study to bridge the molecular gap between paediatric and adult oncology.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000985") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000985") Annotation(rdfs:comment "This study explicitly recruited AYA patients and therefore collected empirical data to bridge the molecular gap between pediatric and adult oncology.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000249> "A cohort of adolescent and young adult patients aged 12 to 29 with newly diagnosed or relapsed high-grade glioma or other high-risk central nervous system tumours recruited across Europe from 2019 in the EORTC SPECTA RP1759 study to bridge the molecular gap between paediatric and adult oncology.")

