AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23143601") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28025329") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23143601") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2456/MediaObjects/41588_2012_BFng2456_MOESM34_ESM.pdf") Annotation(rdfs:comment "All subjects were ethnic Japanese.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001949> "A collaborative hospital-based case-control study of lung cancer in ethnic Japanese that enrolled patients with no history of cancer who were histologically diagnosed with lung cancer, and age- and sex-matched first-visit outpatients of the same period confirmed to have no cancer or history of neoplasia, at the Aichi Cancer Center Research Institute and the National Cancer Center Hospital; its never-smoking female cases and controls form the Japanese study of the Female Lung Cancer Consortium in Asia.")
