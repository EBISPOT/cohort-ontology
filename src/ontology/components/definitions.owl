AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32887874") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34654805") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34654805") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8521585/fullTextXML") Annotation(rdfs:comment "The Cleveland Clinic FMD Biorepository has been supported in part by the National Institutes of Health, National Center for Research Resources, CTSA 1UL1RR024989, Cleveland, Ohio.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001577> "A biorepository of DNA and clinical data from adults with fibromuscular dysplasia enrolled at the Cleveland Clinic, Cleveland, Ohio, United States, from consecutive patients seen at its dedicated fibromuscular dysplasia referral clinic, each giving a blood or saliva sample, used in genetic studies of fibromuscular dysplasia and of arterial dissection, including spontaneous coronary artery dissection.")
