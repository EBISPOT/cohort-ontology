AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25420145") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3154/MediaObjects/41588_2015_BFng3154_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25420145") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3154/MediaObjects/41588_2015_BFng3154_MOESM24_ESM.pdf") Annotation(rdfs:comment "The Spanish cervical artery dissection collection has received funding from Spanish government (PI10/01212 and CP12/03298) and the European Union's Seventh Framework Programme (FP7/2007- 2013) under grant agreements #201024 and #202213 (European Stroke Network).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002348> "A collection of patients with cervical artery dissection in Barcelona, Spain, which contributed patients of European origin, meeting the inclusion criteria of the CADISP study, to the second sample (CADISP-2) of the 2015 genome-wide association study of cervical artery dissection and, from Hospital Vall d'Hebron, patients and controls to its follow-up sample.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25420145") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3154/MediaObjects/41588_2015_BFng3154_MOESM24_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25420145") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3154/MediaObjects/41588_2015_BFng3154_MOESM24_ESM.pdf") Annotation(rdfs:comment "To increase the sample size for genetic analyses, an independent sample of 501 CeAD patients of European origin was recruited between 2008 and 2010, in some CADISP centers and additional 12 centers in 7 European countries and the United States (Supplementary Fig. 2), applying the same inclusion criteria as for the CADISP study (Supplementary Fig. 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002348> "A collection of patients with cervical artery dissection in Barcelona, Spain, which contributed patients of European origin, meeting the inclusion criteria of the CADISP study, to the second sample (CADISP-2) of the 2015 genome-wide association study of cervical artery dissection and, from Hospital Vall d'Hebron, patients and controls to its follow-up sample.")

