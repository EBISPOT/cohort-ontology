AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16841623") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23091423") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35712048") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23091423") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3472989/supplementaryFiles") Annotation(rdfs:comment "The NEWMEDS work package 8 combines samples from two academic studies (GENDEP,1, 2
