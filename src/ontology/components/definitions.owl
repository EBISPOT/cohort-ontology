AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35080193") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37060189") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pbcar.healthsci.mcmaster.ca/research/projects/population-assessment-for-tomorrows-health-study-path/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pbcar.healthsci.mcmaster.ca/research/projects/population-assessment-for-tomorrows-health-study-path/") Annotation(rdfs:comment "Simple physical measurements Provide saliva sample for DNA testing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000657> "A research registry of community volunteers aged 18 to 65 living in the Greater Hamilton area, with or without addiction problems, run by the Peter Boris Centre for Addictions Research at St. Joseph's Healthcare Hamilton, whose participants completed questionnaires, simple physical measurements and an in-person assessment and gave saliva for DNA genotyping through 23andMe, to build a cohort for research on the causes, consequences and treatment of addiction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35080193") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37060189") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pbcar.healthsci.mcmaster.ca/research/projects/population-assessment-for-tomorrows-health-study-path/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pbcar.healthsci.mcmaster.ca/research/projects/population-assessment-for-tomorrows-health-study-path/") Annotation(rdfs:comment "The PATH registry’s purpose is to gather information from volunteers, with or without addiction problems, to develop a cohort for future research studies, which will help further our understanding of the causes, consequences and treatment of individuals with addiction disorder.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000657> "A research registry of community volunteers aged 18 to 65 living in the Greater Hamilton area, with or without addiction problems, run by the Peter Boris Centre for Addictions Research at St. Joseph's Healthcare Hamilton, whose participants completed questionnaires, simple physical measurements and an in-person assessment and gave saliva for DNA genotyping through 23andMe, to build a cohort for research on the causes, consequences and treatment of addiction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000658> (<http://www.ebi.ac.uk/coho/COHO_0000658>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34488438") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39250516") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34488438") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8516734/unicode") Annotation(rdfs:comment "All individuals in the PUUMA cohort were of Han Chinese ancestry living in Beijing (altitude: 20–60m), which is relevant because lower rates of polycythemia at high altitude and lower hematocrits at lower altitude have been described due to variants in genes that regulate hypoxia-inducible factor (HIF) levels, including HIF2A (EPAS1) and PHD2 (also known as EGLN1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000658> "A prospective community-based cohort of 9,540 Han Chinese adults aged 40 and over enrolled in December 2011–April 2012 in the Gucheng and Pingguoyuan communities of Shijingshan district, Beijing, China, by Peking University with the University of Michigan, to study atherosclerosis, blood pressure and other cardiovascular traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34488438") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39250516") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34488438") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8516734/unicode") Annotation(rdfs:comment "The PUUMA study is a prospective observational cohort study of 9,540 participants age ≥40 years at enrollment between December 2011 and April 2012.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000658> "A prospective community-based cohort of 9,540 Han Chinese adults aged 40 and over enrolled in December 2011–April 2012 in the Gucheng and Pingguoyuan communities of Shijingshan district, Beijing, China, by Peking University with the University of Michigan, to study atherosclerosis, blood pressure and other cardiovascular traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34488438") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39250516") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34488438") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8516734/unicode") Annotation(rdfs:comment "This study was performed in the Gucheng and Pingguoyuan communities of Shijingshan district in Beijing, China.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000658> "A prospective community-based cohort of 9,540 Han Chinese adults aged 40 and over enrolled in December 2011–April 2012 in the Gucheng and Pingguoyuan communities of Shijingshan district, Beijing, China, by Peking University with the University of Michigan, to study atherosclerosis, blood pressure and other cardiovascular traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34488438") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39250516") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39250516") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11421807/fullTextXML") Annotation(rdfs:comment "In this study, subjects were recruited into the Peking University-University of Michigan Study of Atherosclerosis (PUUMA) in China, which is a large-scale project designed to study cardiovascular traits in China [22].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000658> "A prospective community-based cohort of 9,540 Han Chinese adults aged 40 and over enrolled in December 2011–April 2012 in the Gucheng and Pingguoyuan communities of Shijingshan district, Beijing, China, by Peking University with the University of Michigan, to study atherosclerosis, blood pressure and other cardiovascular traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34488438") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39250516") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39250516") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11421807/fullTextXML") Annotation(rdfs:comment "The PUUMA Study included 5,954 subjects with peripheral BP measurements (pSBP, pDBP, and pMAP) and 4,938 subjects with cSBP.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000658> "A prospective community-based cohort of 9,540 Han Chinese adults aged 40 and over enrolled in December 2011–April 2012 in the Gucheng and Pingguoyuan communities of Shijingshan district, Beijing, China, by Peking University with the University of Michigan, to study atherosclerosis, blood pressure and other cardiovascular traits.")

