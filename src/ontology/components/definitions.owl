AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006257") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40601244") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40601244+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The TransplantLines Biobank and Cohort Study (NCT03272841) is an ongoing prospective study conducted at the University Medical Centre Groningen, The Netherlands.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000341> "A single-centre prospective cohort study and biobank at the University Medical Center Groningen, the Netherlands, of recipients of all types of solid organ transplant and of living organ donors, with gut microbiome characterisation linked to clinical phenotypes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006257") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001006257") Annotation(rdfs:comment "TransplantLines is designed as a single-center, prospective cohort study and biobank including all different types of solid organ transplant recipients as well as living organ donors. In the TransplantLines gut microbiome study the gut microbiome of solid organ transplant recipients is characterized and linked to clinical phenotypes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000341> "A single-centre prospective cohort study and biobank at the University Medical Center Groningen, the Netherlands, of recipients of all types of solid organ transplant and of living organ donors, with gut microbiome characterisation linked to clinical phenotypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000342> (<http://www.ebi.ac.uk/coho/COHO_0000342>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002602") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28570558") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5453417/fullTextXML") Annotation(rdfs:comment "The TrypanoGEN network is a member of the Human Heredity and Health in Africa (H3Africa www.h3africa.org) Consortium, which is an initiative funded and supported by the Wellcome Trust (UK) and the National Institutes of Health (United States).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000342> "An H3Africa collection of cases, controls and latent infections from seven populations of Uganda, the Democratic Republic of the Congo, Ivory Coast, Guinea, Cameroon and Zambia where trypanosomiasis is endemic, sequenced to discover genetic variants associated with responses to sleeping sickness infection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002602") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002602") Annotation(rdfs:comment "Phase 1) Variant discovery; 222 samples were sequenced to approximately 10X coverage on an Illumina 2500 with 2x150bp reads, at the University of Liverpool Center for Genomic Research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000342> "An H3Africa collection of cases, controls and latent infections from seven populations of Uganda, the Democratic Republic of the Congo, Ivory Coast, Guinea, Cameroon and Zambia where trypanosomiasis is endemic, sequenced to discover genetic variants associated with responses to sleeping sickness infection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002602") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002602") Annotation(rdfs:comment "Samples were selected from seven populations where Trypanosomiasis is endemic: Nilo-Saharan speakers from North-West Uganda and Niger-Congo speakers from South-East Uganda, DRC, Ivory Coast, Guinea, Cameroon and Zambia. The samples included 182 controls, 97 cases, 17 latent infections and 3 suspect cases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000342> "An H3Africa collection of cases, controls and latent infections from seven populations of Uganda, the Democratic Republic of the Congo, Ivory Coast, Guinea, Cameroon and Zambia where trypanosomiasis is endemic, sequenced to discover genetic variants associated with responses to sleeping sickness infection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002602") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002602") Annotation(rdfs:comment "The objective of the TrypanoGEN project is to discover genetic variants associated with different responses to sleeping sickness infection.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000342> "An H3Africa collection of cases, controls and latent infections from seven populations of Uganda, the Democratic Republic of the Congo, Ivory Coast, Guinea, Cameroon and Zambia where trypanosomiasis is endemic, sequenced to discover genetic variants associated with responses to sleeping sickness infection.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000343> (<http://www.ebi.ac.uk/coho/COHO_0000343>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000577") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33482122") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A33482122+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Here, we introduce the Tumor Profiler Study, an observational trial combining a prospective diagnostic approach to assess the relevance of in-depth tumor profiling to support clinical decision-making with an exploratory approach to improve the biological understanding of the disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000343> "An observational Swiss study that applied multi-omic and functional tumour profiling to samples from patients with metastatic melanoma, metastatic epithelial ovarian cancer and acute myeloid leukaemia to assess the value of in-depth profiling for clinical decision support.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000577") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34446805") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8590976/fullTextXML") Annotation(rdfs:comment "The Swiss Tumor Profiler is an approved, observational clinical study (Registration IDs: 2018-02050 (KEK ZH, Switzerland), 2018-02052 (EKNZ, Basel, Switzerland), 2019-01326 (KEK ZH, Switzerland)) with the intention to identify novel treatment targets in prospectively collected tumor patient samples using cutting-edge technologies16.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000343> "An observational Swiss study that applied multi-omic and functional tumour profiling to samples from patients with metastatic melanoma, metastatic epithelial ovarian cancer and acute myeloid leukaemia to assess the value of in-depth profiling for clinical decision support.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000577") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34446805") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8590976/fullTextXML") Annotation(rdfs:comment "We therefore established a computational diagnostic algorithm to quantitatively measure spatial densities of tumor-infiltrating CD8+ T cells by digital pathology within the three known tumor compartments as recommended by the International Immuno-Oncology Biomarker Working Group in 116 prospective metastatic melanomas of the Swiss Tumor Profiler cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000343> "An observational Swiss study that applied multi-omic and functional tumour profiling to samples from patients with metastatic melanoma, metastatic epithelial ovarian cancer and acute myeloid leukaemia to assess the value of in-depth profiling for clinical decision support.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000577") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000577") Annotation(rdfs:comment "Multi-omics data generated from 22 samples from the Tumor Profiler AML cohort") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000343> "An observational Swiss study that applied multi-omic and functional tumour profiling to samples from patients with metastatic melanoma, metastatic epithelial ovarian cancer and acute myeloid leukaemia to assess the value of in-depth profiling for clinical decision support.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000344> (<http://www.ebi.ac.uk/coho/COHO_0000344>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001460") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001001460") Annotation(rdfs:comment "In this study, we use next generation sequencing to assess the role of common, low frequency, and rare variants on type 2 diabetes risk.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000344> "A consortium of United States and United Kingdom groups that sequenced the exomes of type 2 diabetes cases and controls of African American, East Asian, South Asian, Hispanic and European ancestry, drawn from member cohorts, to assess common, low-frequency and rare variants in diabetes risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001460") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001001460") Annotation(rdfs:comment "We preformed exome sequencing in 6,546 T2D cases and 6,457 control individuals of multiethnic origin, including individuals of African American, East Asian, South Asian, Hispanic, and European descent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000344> "A consortium of United States and United Kingdom groups that sequenced the exomes of type 2 diabetes cases and controls of African American, East Asian, South Asian, Hispanic and European ancestry, drawn from member cohorts, to assess common, low-frequency and rare variants in diabetes risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001460") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5034897/unicode") Annotation(rdfs:comment "We considered 6,504 T2D cases and 6,436 controls from 14 studies of African American, East Asian, South Asian, Hispanic, and European ancestry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000344> "A consortium of United States and United Kingdom groups that sequenced the exomes of type 2 diabetes cases and controls of African American, East Asian, South Asian, Hispanic and European ancestry, drawn from member cohorts, to assess common, low-frequency and rare variants in diabetes risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000345> (<http://www.ebi.ac.uk/coho/COHO_0000345>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000545") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31675503") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7202134/") Annotation(rdfs:comment "The GPC is a population-based open cohort study established in 1989 by the Medical Research Council (MRC), UK in collaboration with the Uganda Virus Research Institute (UVRI) to examine trends in prevalence and incidence of HIV infection and their determinants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000345> "A population-based cohort from a geographically defined rural community in south-west Uganda, established in 1989, with samples genotyped and sequenced by the African Partnership for Chronic Disease Research as the Uganda Genome Resource.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000545") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31675503") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7202134/") Annotation(rdfs:comment "We genotyped 5,000 and sequenced 2,000 samples from 9 ethno-linguistic groups from the General Population Cohort (GPC), Uganda (Table S1.1) (Asiki et al., 2013); these constitute the Uganda Genome Resource (UGR).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000345> "A population-based cohort from a geographically defined rural community in south-west Uganda, established in 1989, with samples genotyped and sequenced by the African Partnership for Chronic Disease Research as the Uganda Genome Resource.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000545") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31675503") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7202134/") Annotation(rdfs:comment "We thank the African Partnership for Chronic Disease Research (APCDR) for providing a network to support this study as well as a repository for deposition of curated data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000345> "A population-based cohort from a geographically defined rural community in south-west Uganda, established in 1989, with samples genotyped and sequenced by the African Partnership for Chronic Disease Research as the Uganda Genome Resource.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000545") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10543268/fullTextXML") Annotation(rdfs:comment "The General Population Cohort (GPC) is an open population-based cohort of over 22,000 individuals living in rural south-western Uganda [29].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000345> "A population-based cohort from a geographically defined rural community in south-west Uganda, established in 1989, with samples genotyped and sequenced by the African Partnership for Chronic Disease Research as the Uganda Genome Resource.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000346> (<http://www.ebi.ac.uk/coho/COHO_0000346>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16380912") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21966275") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22325189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16380912") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC1285159") Annotation(rdfs:comment "In an initial pilot phase, potential par- ticipants were also identified and approached through local CAD databases at the two lead centers (Leeds and Leicester).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000346> "A collection of families from across the United Kingdom with at least two siblings affected by premature coronary artery disease (myocardial infarction, angina verified by exercise testing or angiography, or coronary revascularisation before the 66th birthday, each verified from hospital or general practice records), recruited from April 1998 to November 2003 with British Heart Foundation funding through the media and general practices, after a pilot phase using the coronary disease databases of the lead centres in Leeds and Leicester, to study the genetic basis of premature coronary artery disease; affected siblings, and unaffected siblings where available, were interviewed by telephone and gave blood for DNA.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16380912") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21966275") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22325189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16380912") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC1285159") Annotation(rdfs:comment "Recruitment was performed on a national basis in the United Kingdom (UK) through (1) a direct appeal to the public via the media and (2) mailing all general practices (family physicians) in the UK with information about the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000346> "A collection of families from across the United Kingdom with at least two siblings affected by premature coronary artery disease (myocardial infarction, angina verified by exercise testing or angiography, or coronary revascularisation before the 66th birthday, each verified from hospital or general practice records), recruited from April 1998 to November 2003 with British Heart Foundation funding through the media and general practices, after a pilot phase using the coronary disease databases of the lead centres in Leeds and Leicester, to study the genetic basis of premature coronary artery disease; affected siblings, and unaffected siblings where available, were interviewed by telephone and gave blood for DNA.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16380912") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21966275") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22325189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16380912") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC1285159") Annotation(rdfs:comment "The objective of the BHF Family Heart Study was to establish a substantial resource of families with at least two siblings affected with premature CAD, defined as “the occurrence of MI or angina (verified by exercise stress test or angiography) or the need for coronary ar- tery bypass surgery (CABG) or percutaneous translumi- nal coronary angioplasty (PTCA) before the 66th birth- day.”") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000346> "A collection of families from across the United Kingdom with at least two siblings affected by premature coronary artery disease (myocardial infarction, angina verified by exercise testing or angiography, or coronary revascularisation before the 66th birthday, each verified from hospital or general practice records), recruited from April 1998 to November 2003 with British Heart Foundation funding through the media and general practices, after a pilot phase using the coronary disease databases of the lead centres in Leeds and Leicester, to study the genetic basis of premature coronary artery disease; affected siblings, and unaffected siblings where available, were interviewed by telephone and gave blood for DNA.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16380912") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21966275") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22325189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32425970") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7204400/fullTextXML") Annotation(rdfs:comment "The British Heart Foundation Family Heart study recruited families with at least two siblings diagnosed with premature (<66 years) coronary artery disease (CAD) within the United Kingdom between 1998 and 2003.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000346> "A collection of families from across the United Kingdom with at least two siblings affected by premature coronary artery disease (myocardial infarction, angina verified by exercise testing or angiography, or coronary revascularisation before the 66th birthday, each verified from hospital or general practice records), recruited from April 1998 to November 2003 with British Heart Foundation funding through the media and general practices, after a pilot phase using the coronary disease databases of the lead centres in Leeds and Leicester, to study the genetic basis of premature coronary artery disease; affected siblings, and unaffected siblings where available, were interviewed by telephone and gave blood for DNA.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16380912") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21966275") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22325189") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3178591/supplementaryFiles") Annotation(rdfs:comment "The recruitment period was from April 1998 to November 2003.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000346> "A collection of families from across the United Kingdom with at least two siblings affected by premature coronary artery disease (myocardial infarction, angina verified by exercise testing or angiography, or coronary revascularisation before the 66th birthday, each verified from hospital or general practice records), recruited from April 1998 to November 2003 with British Heart Foundation funding through the media and general practices, after a pilot phase using the coronary disease databases of the lead centres in Leeds and Leicester, to study the genetic basis of premature coronary artery disease; affected siblings, and unaffected siblings where available, were interviewed by telephone and gave blood for DNA.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000347> (<http://www.ebi.ac.uk/coho/COHO_0000347>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002336") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002336") Annotation(rdfs:comment "Controls used were data from the Wellcome Trust Case Control Consortium 2 (WTCCC2) 1958 birth cohort and the UK Blood Service Control Group (available as EGAS00000000028).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000347> "A collection of blood donors recruited through the UK Blood Services as a population control set for the Wellcome Trust Case Control Consortium and later genetic association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002336") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2719288") Annotation(rdfs:comment "The control individuals came from two sources: 1,500 individuals from the 1958 British Birth Cohort (58C) and 1,500 individuals selected from blood donors recruited as part of this project (UK Blood Services (UKBS) controls).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000347> "A collection of blood donors recruited through the UK Blood Services as a population control set for the Wellcome Trust Case Control Consortium and later genetic association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002336") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2719288") Annotation(rdfs:comment "WTCCC in collaboration with the UK Blood Services (NHSBT in England, SNBTS in Scotland and WBS in Wales) set up a UK national repository of anonymized samples of DNA and viable mononuclear cells from 3,622 consenting blood donors, age range 18-69 yr (ethical approval 05/ Q0106/74).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000347> "A collection of blood donors recruited through the UK Blood Services as a population control set for the Wellcome Trust Case Control Consortium and later genetic association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002336") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4268499/fullTextXML") Annotation(rdfs:comment "We used data on controls from the 1958 Birth Cohort (58C) and National Blood Service (UKBS) which had been generated by the WTCCC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000347> "A collection of blood donors recruited through the UK Blood Services as a population control set for the Wellcome Trust Case Control Consortium and later genetic association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000348> (<http://www.ebi.ac.uk/coho/COHO_0000348>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000090") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26367797") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4773891/fullTextXML") Annotation(rdfs:comment "In total, 3,781 individuals were successfully whole-genome sequenced in the UK10K-cohorts arm.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000348> "A project that sequenced the genomes of participants of the TwinsUK and ALSPAC cohorts and the exomes of individuals selected for extreme phenotypes and rare diseases, to find low-frequency and rare variants contributing to disease in the United Kingdom.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000090") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26367797") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4773891/fullTextXML") Annotation(rdfs:comment "The UK10K project was designed to characterize rare and low-frequency variation in the UK population, and study its contribution to a broad spectrum of biomedically relevant quantitative traits and diseases with different predicted genetic architectures.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000348> "A project that sequenced the genomes of participants of the TwinsUK and ALSPAC cohorts and the exomes of individuals selected for extreme phenotypes and rare diseases, to find low-frequency and rare variants contributing to disease in the United Kingdom.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000090") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26367797") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4773891/fullTextXML") Annotation(rdfs:comment "The UK10K-cohorts arm aimed to assess the contribution of genome-wide genetic variation to a range of quantitative traits in 3,781 healthy individuals from two intensively studied British cohorts of European ancestry, namely the Avon Longitudinal Study of Parents and Children (ALSPAC)13 and TwinsUK14.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000348> "A project that sequenced the genomes of participants of the TwinsUK and ALSPAC cohorts and the exomes of individuals selected for extreme phenotypes and rare diseases, to find low-frequency and rare variants contributing to disease in the United Kingdom.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000090") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26367797") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4773891/fullTextXML") Annotation(rdfs:comment "The UK10K-exomes arm aimed to identify causal mutations through high read depth (mean ∼80× across studies) whole-exome sequencing of approximately 6,000 individuals from three different collections: rare disease, severe obesity and neurodevelopmental disorders.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000348> "A project that sequenced the genomes of participants of the TwinsUK and ALSPAC cohorts and the exomes of individuals selected for extreme phenotypes and rare diseases, to find low-frequency and rare variants contributing to disease in the United Kingdom.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000349> (<http://www.ebi.ac.uk/coho/COHO_0000349>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23768512") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3710768/") Annotation(rdfs:comment "We performed exome sequencing in P1, who is affected by a severe form of CMD with brain involvement, as part of the UK10K rare cohort, and variants were filtered as outlined in Table S4.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000349> "A collection of patients with rare neuromuscular disorders, contributed by Francesco Muntoni's group, that formed part of the rare disease arm of the UK10K project and was exome and genome sequenced to find causal variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000101") Annotation(rdfs:comment "Studies EGAS00001000101 UK10K_RARE_NEUROMUSCULAR In the UK10K project we propose a series of complementary genetic approaches to find new low frequency/rare variants contributing to disease phenotypes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000349> "A collection of patients with rare neuromuscular disorders, contributed by Francesco Muntoni's group, that formed part of the rare disease arm of the UK10K project and was exome and genome sequenced to find causal variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000101") Annotation(rdfs:comment "The neuromuscular disorder samples are part of the “rare disease” group, and will undergo exome sequencing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000349> "A collection of patients with rare neuromuscular disorders, contributed by Francesco Muntoni's group, that formed part of the rare disease arm of the UK10K project and was exome and genome sequenced to find causal variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4773891/fullTextXML") Annotation(rdfs:comment "Thus far, 25 novel genetic causes have been identified for five of the eight diseases: ciliopathies (n = 14), neuromuscular disorders (n = 7), eye malformations (n = 2), congenital heart defects (n = 1) and intellectual disability (n = 1; Supplementary Table 14).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000349> "A collection of patients with rare neuromuscular disorders, contributed by Francesco Muntoni's group, that formed part of the rare disease arm of the UK10K project and was exome and genome sequenced to find causal variants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000350> (<http://www.ebi.ac.uk/coho/COHO_0000350>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006012") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35857626") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9585706/fullTextXML") Annotation(rdfs:comment "RNA-seq libraries for the UW OvCa cohort were generated using the KAPA mRNA Hyperprep kit (Roche) according to manufacturer’s instructions and were sequenced on a NovaSeq Illumina platform to generate 100 bp paired end reads.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000350> "A cohort of patients with primary, treatment-naive ovarian carcinoma at the University of Washington whose tumours were RNA sequenced to relate BRCA and immune configurations to response to platinum-based chemotherapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006012") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35857626") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9585706/fullTextXML") Annotation(rdfs:comment "To this end, we analyzed a new cohort of 63 patients with primary OvCa from the University of Washington Medical Center (UW OvCa cohort, Fig. 5A, tables S1–2), with detailed response data to therapy with a combination of carboplatin and paclitaxel and access to the primary cancer samples for detailed genomic analyses.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000350> "A cohort of patients with primary, treatment-naive ovarian carcinoma at the University of Washington whose tumours were RNA sequenced to relate BRCA and immune configurations to response to platinum-based chemotherapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006012") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001006012") Annotation(rdfs:comment "RNAseq data relative to 56 primary and treatment-naive ovarian carcinomas, from independent donors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000350> "A cohort of patients with primary, treatment-naive ovarian carcinoma at the University of Washington whose tumours were RNA sequenced to relate BRCA and immune configurations to response to platinum-based chemotherapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006012") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001006012") Annotation(rdfs:comment "Specific BRCA and immune configurations determine optimal response to platinum-based chemotherapy in triple negative breast and ovarian carcinomas (UW_OvCa_RNAseq)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000350> "A cohort of patients with primary, treatment-naive ovarian carcinoma at the University of Washington whose tumours were RNA sequenced to relate BRCA and immune configurations to response to platinum-based chemotherapy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000351> (<http://www.ebi.ac.uk/coho/COHO_0000351>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001334") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38658604") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.nature.com/articles/s41523-024-00637-3") Annotation(rdfs:comment "All adult patients, regardless of gender, with metastatic breast cancer (either de novo or relapse) in their last line(s) of treatment are eligible for inclusion, provided that they are either treated at University Hospitals Leuven or referred to it specifically for the project.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000351> "A monocentric post-mortem tissue donation programme at UZ Leuven, Belgium, in which patients with metastatic breast cancer donate primary, metastatic and normal tissues after death for multi-region molecular profiling.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001334") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38658604") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.nature.com/articles/s41523-024-00637-3") Annotation(rdfs:comment "UPTIDER additionally allowed the inclusion of patients residing in Belgium or in neighboring countries but close to the Belgian border, who are referred to our center specifically for the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000351> "A monocentric post-mortem tissue donation programme at UZ Leuven, Belgium, in which patients with metastatic breast cancer donate primary, metastatic and normal tissues after death for multi-region molecular profiling.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001334") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38658604") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.nature.com/articles/s41523-024-00637-3") Annotation(rdfs:comment "UPTIDER is a monocentric post-mortem tissue donation program for patients with end-stage breast cancer (NCT04531696, local ethics number: S64410, approval 30th November 2020 by ethical committee research UZ/KU Leuven).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000351> "A monocentric post-mortem tissue donation programme at UZ Leuven, Belgium, in which patients with metastatic breast cancer donate primary, metastatic and normal tissues after death for multi-region molecular profiling.")
