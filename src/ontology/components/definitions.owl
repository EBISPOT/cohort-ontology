AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16751059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27515689") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41467-021-21287-0/MediaObjects/41467_2021_21287_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27515689") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5036513/fullTextXML") Annotation(rdfs:comment "The four cohorts (RAPPER, RADIOGEN, Gene-PARE, and CCI) comprised individuals with adenocarcinoma of the prostate treated with radiotherapy with curative intent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001779> "A biorepository of frozen lymphocytes and DNA from patients treated with radiotherapy for cancer, with a database of their diagnosis, treatment and outcome, run from the Icahn School of Medicine at Mount Sinai, whose patients include men treated for prostate cancer at the Mount Sinai Hospital in New York and patients treated in Tokyo and Chiba, Japan, and which was set up to find genetic variants that predict adverse effects of radiotherapy.")
