AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20504332") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24836286") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32139696") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24836286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "Cases were newly diagnosed patients with CRC at Chonnam National University Hwasun Hospital, a cancer-specific hospital in Jeollanam-do province, South Korea, between April 2004 and February 2013.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002709> "A hospital-based case-control study of multiple cancers in South Korea, with disease-specific series including breast and colorectal cancer at Chonnam National University Hwasun Hospital in Jeollanam-do province. It recruits newly diagnosed cancer patients and community controls to investigate factors in cancer development and clinical progression; its disease-specific series use interview and medical-record information and blood samples.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20504332") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24836286") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32139696") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24836286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "Controls (n=4,552) were participants in the Korean Community Health Survey, an annual nationwide health interview survey, conducted from 2010 to 2012 in the Jindo and Bosung counties of Jeollanam-do province, Korea.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002709> "A hospital-based case-control study of multiple cancers in South Korea, with disease-specific series including breast and colorectal cancer at Chonnam National University Hwasun Hospital in Jeollanam-do province. It recruits newly diagnosed cancer patients and community controls to investigate factors in cancer development and clinical progression; its disease-specific series use interview and medical-record information and blood samples.")
