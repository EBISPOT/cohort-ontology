AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003419") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001003419") Annotation(rdfs:comment "The Milieu Intérieur project is a population-based study coordinated by the Institut Pasteur, Paris.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000301> "A population-based cohort of 1,000 healthy individuals of western European ancestry recruited in France by the Institut Pasteur's Milieu Intérieur project to dissect the interplay between genetics, environment and the immune system.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003419") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001003419") Annotation(rdfs:comment "The objective is to dissect the interplay between genetics and environment and their impact on the immune system.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000301> "A population-based cohort of 1,000 healthy individuals of western European ancestry recruited in France by the Institut Pasteur's Milieu Intérieur project to dissect the interplay between genetics, environment and the immune system.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000302> (<http://www.ebi.ac.uk/coho/COHO_0000302>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008226") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36156447") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9512829/fullTextXML") Annotation(rdfs:comment "One hundred patients with high-grade OC enrolled in the MITO16A/MaNGO-OV2 trial and treated with first-line therapy with carboplatin, paclitaxel, and bevacizumab were analyzed.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000302> "A cohort of 398 patients with ovarian cancer enrolled at 47 centres in the single-arm phase IV MITO16A/MaNGO-OV2 trial of first-line carboplatin, paclitaxel and bevacizumab, studied for clinical and biological prognostic factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008226") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36156447") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9512829/unicode") Annotation(rdfs:comment "We recently published the MITO16A/MaNGO-OV2 trial results, which investigated clinical and biological prognostic factors for advanced OC patients on first-line therapy with carboplatin, paclitaxel, and bevacizumab.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000302> "A cohort of 398 patients with ovarian cancer enrolled at 47 centres in the single-arm phase IV MITO16A/MaNGO-OV2 trial of first-line carboplatin, paclitaxel and bevacizumab, studied for clinical and biological prognostic factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008226") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39415516") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11701406/fullTextXML") Annotation(rdfs:comment "Patients in the p53 cohort (n = 294) and in the whole MITO‐16A/MaNGO‐OV2 trial population (n = 398) did not show any difference in terms of clinicopathological characteristics (Table S2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000302> "A cohort of 398 patients with ovarian cancer enrolled at 47 centres in the single-arm phase IV MITO16A/MaNGO-OV2 trial of first-line carboplatin, paclitaxel and bevacizumab, studied for clinical and biological prognostic factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008226") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39415516") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11701406/fullTextXML") Annotation(rdfs:comment "The multicenter, Phase IV, single‐arm MITO16A/MaNGO OV‐2 trial was designed to fulfill this unmet clinical need, specifically to explore novel prognostic biomarkers for OC patients treated with carboplatin, paclitaxel, and BEV, followed by BEV maintenance, in first‐line setting.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000302> "A cohort of 398 patients with ovarian cancer enrolled at 47 centres in the single-arm phase IV MITO16A/MaNGO-OV2 trial of first-line carboplatin, paclitaxel and bevacizumab, studied for clinical and biological prognostic factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000303> (<http://www.ebi.ac.uk/coho/COHO_0000303>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000102") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00000000102") Annotation(rdfs:comment "MolPAGE is an integrated EU project that aims to develop methods and tools for discovery of biomarkers associated with diabetes (see www.ocdem.ox.ac.uk for MolOBB and www.twinsuk.ac.uk for MolTWIN).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000303> "An integrated European Union project that developed methods and tools for discovering biomarkers of diabetes, drawing on sub-studies of the Oxford Biobank (MolOBB) and TwinsUK (MolTWIN).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000102") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2769636") Annotation(rdfs:comment "The European Union-funded consortium MolPAGE67 was formed in 2004 involving 17 partners from universities, pharmaceutical companies, and biotechnology companies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000303> "An integrated European Union project that developed methods and tools for discovering biomarkers of diabetes, drawing on sub-studies of the Oxford Biobank (MolOBB) and TwinsUK (MolTWIN).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000102") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3285582/fullTextXML") Annotation(rdfs:comment "A total of 154 twins (56 monozygotic (MZ) pairs and 21 dizygotic (DZ) pairs), were ascertained from the UK Adult Twin registry at St.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000303> "An integrated European Union project that developed methods and tools for discovering biomarkers of diabetes, drawing on sub-studies of the Oxford Biobank (MolOBB) and TwinsUK (MolTWIN).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000102") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3285582/fullTextXML") Annotation(rdfs:comment "The MolOBB study consists of 44 healthy controls (27 men, 17 women) and 29 cases with MetS (16 men, 13 women) between 39 and 56 years old that were collected from the Oxford Biobank as part of the MolPAGE consortium [57].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000303> "An integrated European Union project that developed methods and tools for discovering biomarkers of diabetes, drawing on sub-studies of the Oxford Biobank (MolOBB) and TwinsUK (MolTWIN).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000304> (<http://www.ebi.ac.uk/coho/COHO_0000304>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000083") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3440846/fullTextXML") Annotation(rdfs:comment "Our results provide a novel molecular stratification of the breast cancer population, derived from the impact of somatic CNAs on the transcriptome.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000304> "A collection of about 2,000 primary breast tumours with long-term clinical follow-up from tumour banks in the United Kingdom and Canada, profiled for copy number and gene expression to derive a molecular stratification of breast cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000083") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3440846/fullTextXML") Annotation(rdfs:comment "We assembled a collection of over 2,000 clinically annotated primary fresh-frozen breast cancer specimens from tumour banks in the UK and Canada (Supplementary Tables 1–3).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000304> "A collection of about 2,000 primary breast tumours with long-term clinical follow-up from tumour banks in the United Kingdom and Canada, profiled for copy number and gene expression to derive a molecular stratification of breast cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000083") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3440846/fullTextXML") Annotation(rdfs:comment "We present an integrated analysis of copy number and gene expression in a discovery and validation set of 997 and 995 primary breast tumours, respectively, with long-term clinical follow-up.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000304> "A collection of about 2,000 primary breast tumours with long-term clinical follow-up from tumour banks in the United Kingdom and Canada, profiled for copy number and gene expression to derive a molecular stratification of breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000305> (<http://www.ebi.ac.uk/coho/COHO_0000305>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23345460") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000137") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23345460") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3613588/fullTextXML") Annotation(rdfs:comment "Here, we more than double the size of our initial data set with expression data on 550 additional individuals from the MRCE family panel using the Illumina whole-genome expression array.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000305> "A family panel of British nuclear families ascertained through a child with eczema, whose genome-wide SNP genotypes and whole-genome expression profiles extended the MRCA family panel's map of expression quantitative trait loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23345460") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000137") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23345460") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3613588/fullTextXML") Annotation(rdfs:comment "In this study we use two large gene expression data sets from nuclear families ascertained through a child with asthma using the Affymetrix Hu133A platform (the MRCA panel) (Dixon et al. 2007) or eczema using the Illumina bead array platform (the MRCE panel) (Morar et al. 2007).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000305> "A family panel of British nuclear families ascertained through a child with eczema, whose genome-wide SNP genotypes and whole-genome expression profiles extended the MRCA family panel's map of expression quantitative trait loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23345460") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000137") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23345460") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3613588/fullTextXML") Annotation(rdfs:comment "The second sample (MRCE) of 950 individuals from 320 families of British descent was genotyped using the Illumina Sentrix HumanHap300 Genotyping BeadChip.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000305> "A family panel of British nuclear families ascertained through a child with eczema, whose genome-wide SNP genotypes and whole-genome expression profiles extended the MRCA family panel's map of expression quantitative trait loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23345460") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000137") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23345460") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3613588/fullTextXML") Annotation(rdfs:comment "Using the same methods and imputed SNPs in the newly acquired MRCE data set, we identified eQTLs for 9000 genes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000305> "A family panel of British nuclear families ascertained through a child with eczema, whose genome-wide SNP genotypes and whole-genome expression profiles extended the MRCA family panel's map of expression quantitative trait loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000306> (<http://www.ebi.ac.uk/coho/COHO_0000306>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000144") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42215465") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13392353/fullTextXML") Annotation(rdfs:comment "The heritability scores were derived from the MultiMuTHER study (a subset of TwinsUK), consisting of 335 European participants from the UK, including 148 monozygotic twins, 166 dizygotic twins and 21 singletons, with whole blood gene expression and metabolite levels measured at three clinical visits spanning a median of six years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000306> "A longitudinal sub-study of 335 TwinsUK women from the Multiple Tissue Human Expression Resource, seen at three or more clinical visits over up to nine years with repeated whole-blood gene expression and serum metabolite profiling to characterise molecular ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000144") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42691178") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42691178+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Longitudinally variable genes showed cell type specificity and enrichment for aging-relevant pathways, including cardiometabolic and neurodegenerative disorders.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000306> "A longitudinal sub-study of 335 TwinsUK women from the Multiple Tissue Human Expression Resource, seen at three or more clinical visits over up to nine years with repeated whole-blood gene expression and serum metabolite profiling to characterise molecular ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000144") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42691178") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42691178+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We profiled longitudinal whole-blood gene expression and metabolite levels in 335 females over 8 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000306> "A longitudinal sub-study of 335 TwinsUK women from the Multiple Tissue Human Expression Resource, seen at three or more clinical visits over up to nine years with repeated whole-blood gene expression and serum metabolite profiling to characterise molecular ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000144") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000144") Annotation(rdfs:comment "The MultiMuTHER study is a longitudinal study of 335 subjects seen at three or more clinical visits per participant.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000306> "A longitudinal sub-study of 335 TwinsUK women from the Multiple Tissue Human Expression Resource, seen at three or more clinical visits over up to nine years with repeated whole-blood gene expression and serum metabolite profiling to characterise molecular ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000307> (<http://www.ebi.ac.uk/coho/COHO_0000307>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001569") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24183450") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3824131/") Annotation(rdfs:comment "Epigenetic variation such as DNA methylation is now acknowledged to make a significant contribution to complex disease susceptibility.8,9 To this end, we have developed one of the largest population collections of multiple primary tissues (i.e., adipose, skin, and blood) in the Multiple Tissue Human Expression Resource (MuTHER) project, where the tissues were obtained through punch biopsies from an area adjacent and inferior to the umbilicus.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000307> "A sub-cohort of adult female TwinsUK participants from whom adipose, skin, lymphoblastoid cell line and blood samples were collected to map genetic and epigenetic regulation of gene expression across tissues.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001569") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24183450") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3824131/") Annotation(rdfs:comment "The MuTHER study includes 856 female European-descent individuals recruited from the TwinsUK Adult Twin Registry,24 as previously described.10 In brief, 8 mm punch biopsies were taken from a relatively photo-protected area adjacent and inferior to the umbilicus.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000307> "A sub-cohort of adult female TwinsUK participants from whom adipose, skin, lymphoblastoid cell line and blood samples were collected to map genetic and epigenetic regulation of gene expression across tissues.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001569") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3784328/fullTextXML") Annotation(rdfs:comment "In total of 856 female twins (154 monozygotic (MZ) twin pairs, 232 dizygotic (DZ) twin pairs and 84 singletons) aged 38.7-84.6 years were recruited from the TwinsUK resource 17and adipose (subcutaneous fat) and skin tissue biopsies as well as peripheral blood samples (for generation of lymphoblastoid cell lines or LCLs) were collected for subsequent genome-wide expression profiling.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000307> "A sub-cohort of adult female TwinsUK participants from whom adipose, skin, lymphoblastoid cell line and blood samples were collected to map genetic and epigenetic regulation of gene expression across tissues.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001569") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3784328/fullTextXML") Annotation(rdfs:comment "To this end, we designed the MuTHER project (Multiple Tissue Human Expression Resource ) to develop a major resource of detailed genomic and transcriptomic data from three disease-relevant tissues (adipose, lymphoblastoid cell lines, and skin) originating from a cohort of 856 deeply phenotyped twins (one-third monozygotic (MZ) and two-thirds dizygotic (DZ)) from the TwinsUK adult registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000307> "A sub-cohort of adult female TwinsUK participants from whom adipose, skin, lymphoblastoid cell line and blood samples were collected to map genetic and epigenetic regulation of gene expression across tissues.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000308> (<http://www.ebi.ac.uk/coho/COHO_0000308>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007710") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38529185") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38529185+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Here, we present the results of accuracy and precision assessments, involving a total of 73 cell lines.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000308> "A pre-clinical validation study of a pharmacogenomic genotyping workflow on the Illumina Global Screening Array, performed on 73 reference cell lines from the Genome in a Bottle, GeT-RM and 1000 Genomes collections rather than on recruited participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007710") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38529185") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38529185+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In this study, we performed pre-clinical validation of a genetic testing workflow based on the Illumina Global Screening Array for 25 pharmacogenomic-related genes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000308> "A pre-clinical validation study of a pharmacogenomic genotyping workflow on the Illumina Global Screening Array, performed on 73 reference cell lines from the Genome in a Bottle, GeT-RM and 1000 Genomes collections rather than on recruited participants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007710") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38529185") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38529185+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "These assessments encompass reference materials from the Genome-In-A-Bottle (GIAB), the Genetic Testing Reference Material Coordination Program (GeT-RM) projects, as well as additional samples from the 1000 Genomes project (1KGP).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000308> "A pre-clinical validation study of a pharmacogenomic genotyping workflow on the Illumina Global Screening Array, performed on 73 reference cell lines from the Genome in a Bottle, GeT-RM and 1000 Genomes collections rather than on recruited participants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000309> (<http://www.ebi.ac.uk/coho/COHO_0000309>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007722") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007722") Annotation(rdfs:comment "Studies EGAS00001007722 pending for release Exome_NanoSeq__China_NCI_DEE_buccal_cells_ Exome NanoSeq in buccal cells obtained from the NCI China cohort, This cohort consists of patients with, and without, bladder cancer who have provided buccal swabs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000309> "A cohort of Chinese patients with and without bladder or lung cancer, exposed to diesel exhaust or polycyclic aromatic hydrocarbons, who provided buccal and urothelial cells for duplex sequencing of somatic mutations in a collaboration between the United States National Cancer Institute and IARC.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007722") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007722") Annotation(rdfs:comment "These patients have been exposed to diesel exhaust fumes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000309> "A cohort of Chinese patients with and without bladder or lung cancer, exposed to diesel exhaust or polycyclic aromatic hydrocarbons, who provided buccal and urothelial cells for duplex sequencing of somatic mutations in a collaboration between the United States National Cancer Institute and IARC.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007722") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007722") Annotation(rdfs:comment "This is in collaboration with IARC, based in Lyon, France.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000309> "A cohort of Chinese patients with and without bladder or lung cancer, exposed to diesel exhaust or polycyclic aromatic hydrocarbons, who provided buccal and urothelial cells for duplex sequencing of somatic mutations in a collaboration between the United States National Cancer Institute and IARC.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007722") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007722") Annotation(rdfs:comment "We hope to study the driver landscape in this condition, in addition to paired urothelial samples.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000309> "A cohort of Chinese patients with and without bladder or lung cancer, exposed to diesel exhaust or polycyclic aromatic hydrocarbons, who provided buccal and urothelial cells for duplex sequencing of somatic mutations in a collaboration between the United States National Cancer Institute and IARC.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000310> (<http://www.ebi.ac.uk/coho/COHO_0000310>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007728") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007728") Annotation(rdfs:comment "Studies EGAS00001007728 pending for release Targeted_NanoSeq__Taiwan_NCI_buccal_cells_ Targeted NanoSeq in buccal cells obtained from the NCI Taiwan cohort, This cohort consists of patients with, and without, oral cancer, in addition to dysplasia and risk factors for oral cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000310> "A cohort of patients in Taiwan with and without oral cancer, dysplasia and risk factors for oral cancer who provided buccal cells for duplex sequencing of somatic mutations in a collaboration between the United States National Cancer Institute and IARC.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007728") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007728") Annotation(rdfs:comment "This is in collaboration with IARC, based in Lyon, France.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000310> "A cohort of patients in Taiwan with and without oral cancer, dysplasia and risk factors for oral cancer who provided buccal cells for duplex sequencing of somatic mutations in a collaboration between the United States National Cancer Institute and IARC.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007728") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007728") Annotation(rdfs:comment "We hope to sequence the driver landscape of these donors in order to understand more about the risk of developing oral cancers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000310> "A cohort of patients in Taiwan with and without oral cancer, dysplasia and risk factors for oral cancer who provided buccal cells for duplex sequencing of somatic mutations in a collaboration between the United States National Cancer Institute and IARC.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000311> (<http://www.ebi.ac.uk/coho/COHO_0000311>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007563") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22257673") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22257673+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In this parallel groups, randomised, open-label, phase 3 study undertaken between Jan 5, 2008, and May 27, 2010, women from 23 countries with HER2-positive primary breast cancer with tumours greater than 2 cm in diameter were randomly assigned to oral lapatinib (1500 mg), intravenous trastuzumab (loading dose 4 mg/kg [DOSAGE ERROR CORRECTED], subsequent doses 2 mg/kg), or lapatinib (1000 mg) plus trastuzumab.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000311> "A cohort of women with HER2-positive breast cancer enrolled in the NeoALTTO phase III trial of neoadjuvant paclitaxel with trastuzumab and/or lapatinib, whose tumour B and T cell receptor repertoires were profiled to identify prognostic immune features.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007563") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10624889/fullTextXML") Annotation(rdfs:comment "Here, we investigate the complexity of B and T cell receptor (BCR and TCR) repertoires in the context of two phase III trials, NeoALTTO and CALGB 40601, evaluating neoadjuvant paclitaxel with trastuzumab and/or lapatinib in women with HER2-positive breast cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000311> "A cohort of women with HER2-positive breast cancer enrolled in the NeoALTTO phase III trial of neoadjuvant paclitaxel with trastuzumab and/or lapatinib, whose tumour B and T cell receptor repertoires were profiled to identify prognostic immune features.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007563") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10624889/fullTextXML") Annotation(rdfs:comment "We present a model developed in NeoALTTO and validated in CALGB 40601 that can predict event-free survival (EFS) by integrating hormone receptor and clinical nodal status, breast pathological complete response (pCR), stromal tumor-infiltrating lymphocyte levels (%) and BCR repertoire evenness.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000311> "A cohort of women with HER2-positive breast cancer enrolled in the NeoALTTO phase III trial of neoadjuvant paclitaxel with trastuzumab and/or lapatinib, whose tumour B and T cell receptor repertoires were profiled to identify prognostic immune features.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000312> (<http://www.ebi.ac.uk/coho/COHO_0000312>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004870") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28041643") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC5223092") Annotation(rdfs:comment "722 individuals with IRD were recruited to the NIHR BioResource Rare Diseases research study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000312> "A National Institute for Health and Care Research resource of volunteers in England recallable by genotype and phenotype, including blood donors and patients with common and rare diseases, whose genotype data support health research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004870") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001004870") Annotation(rdfs:comment "The dataset includes 13489 samples from blood donors, they were not screened for any particular disease, and therefore they are representative of the general population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000312> "A National Institute for Health and Care Research resource of volunteers in England recallable by genotype and phenotype, including blood donors and patients with common and rare diseases, whose genotype data support health research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004870") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(rdfs:comment "The NIHR BioResource is a recallable resource of over 250,000 volunteers, with and without health conditions who have agreed to take part in health-related research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000312> "A National Institute for Health and Care Research resource of volunteers in England recallable by genotype and phenotype, including blood donors and patients with common and rare diseases, whose genotype data support health research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004870") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://molgeniscatalogue.org/all/collections/NIHR%20BioResource") Annotation(rdfs:comment "Panel of over 100,000 highly characterised healthy volunteers and patients with common and rare diseases, who are willing to be approached to participate in research studies investigating the links between genes, the environment, health and disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000312> "A National Institute for Health and Care Research resource of volunteers in England recallable by genotype and phenotype, including blood donors and patients with common and rare diseases, whose genotype data support health research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004870") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6891252/supplementaryFiles") Annotation(rdfs:comment "The GLAD Study is part of the NIHR BioResource which has been established to support recruitment of participants to research studies according to their physical characteristics (phenotype) and/or genetic makeup (genotype) where this would not have been effective/possible using more general methods of participant recruitment (e.g. posters and general advertising).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000312> "A National Institute for Health and Care Research resource of volunteers in England recallable by genotype and phenotype, including blood donors and patients with common and rare diseases, whose genotype data support health research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000313> (<http://www.ebi.ac.uk/coho/COHO_0000313>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001651") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32025007") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7025898/fullTextXML") Annotation(rdfs:comment "Here we report the integrative analysis of 2,658 whole-cancer genomes and their matching normal tissues across 38 tumour types from the Pan-Cancer Analysis of Whole Genomes (PCAWG) Consortium of the International Cancer Genome Consortium (ICGC) and The Cancer Genome Atlas (TCGA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000313> "An international collaboration of the International Cancer Genome Consortium and The Cancer Genome Atlas that analysed cancer whole genomes from the consortia's projects to identify common patterns of somatic and germline variation in coding and non-coding regions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001651") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32025007") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7025898/fullTextXML") Annotation(rdfs:comment "We collected genome data from 2,834 donors, representing all ICGC and TCGA donors that met these criteria at the time of the final data freeze in autumn 2014 (Extended Data Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000313> "An international collaboration of the International Cancer Genome Consortium and The Cancer Genome Atlas that analysed cancer whole genomes from the consortia's projects to identify common patterns of somatic and germline variation in coding and non-coding regions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001651") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001001651") Annotation(rdfs:comment "The Pancancer Analysis of Whole Genomes (PCAWG) study is an international collaboration to identify common patterns of mutation in more than 2,800 cancer whole genomes from the International Cancer Genome Consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000313> "An international collaboration of the International Cancer Genome Consortium and The Cancer Genome Atlas that analysed cancer whole genomes from the consortia's projects to identify common patterns of somatic and germline variation in coding and non-coding regions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001001651") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001001651") Annotation(rdfs:comment "this project is exploring the nature and consequences of somatic and germline variations in both coding and non-coding regions, with specific emphasis on cis-regulatory sites, non-coding RNAs, and large-scale structural alterations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000313> "An international collaboration of the International Cancer Genome Consortium and The Cancer Genome Atlas that analysed cancer whole genomes from the consortia's projects to identify common patterns of somatic and germline variation in coding and non-coding regions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000314> (<http://www.ebi.ac.uk/coho/COHO_0000314>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000168") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38191613") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10878980/fullTextXML") Annotation(rdfs:comment "Here we present results from the PANDA study, investigating the safety, efficacy and immunologic correlates of atezolizumab plus chemotherapy in patients with resectable, nonmetastatic G/GEJ adenocarcinoma.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000314> "A cohort of 21 patients with previously untreated resectable gastric or gastro-oesophageal junction adenocarcinoma treated in the phase 2 PANDA trial with neoadjuvant atezolizumab and chemotherapy, sampled at multiple time points to study the tumour microenvironment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000168") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38191613") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38191613+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In the phase 2 PANDA trial, patients with previously untreated resectable G/GEJ tumors (n = 21) received neoadjuvant treatment with one cycle of atezolizumab monotherapy followed by four cycles of atezolizumab plus docetaxel, oxaliplatin and capecitabine.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000314> "A cohort of 21 patients with previously untreated resectable gastric or gastro-oesophageal junction adenocarcinoma treated in the phase 2 PANDA trial with neoadjuvant atezolizumab and chemotherapy, sampled at multiple time points to study the tumour microenvironment.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000168") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38191613") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38191613+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Tissue was obtained at multiple time points, allowing analysis of the effects of single-agent anti-programmed cell death ligand 1 (PD-L1) and the subsequent combination with chemotherapy on the TME.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000314> "A cohort of 21 patients with previously untreated resectable gastric or gastro-oesophageal junction adenocarcinoma treated in the phase 2 PANDA trial with neoadjuvant atezolizumab and chemotherapy, sampled at multiple time points to study the tumour microenvironment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000315> (<http://www.ebi.ac.uk/coho/COHO_0000315>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34337548") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8317817/fullTextXML") Annotation(rdfs:comment "This study was the first integrated clinical-molecular autopsy study initiated at Johns Hopkins Hospital, and informed the development of subsequent autopsy studies in pancreatic and other cancers [13].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000315> "An integrated clinical-molecular rapid autopsy study of men who died of lethal prostate cancer at Johns Hopkins, United States, whose primary and metastatic tumours and normal tissues were collected for sequencing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34337548") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8317817/fullTextXML") Annotation(rdfs:comment "We curated all available clinical records from a series of 33 men who provided informed consent to participate in the Johns Hopkins Medicine Institutional Review Board-approved (NA_00003925) Project to ELIminate lethal CANcer (PELICAN) integrated clinical-molecular autopsy study of lethal mPC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000315> "An integrated clinical-molecular rapid autopsy study of men who died of lethal prostate cancer at Johns Hopkins, United States, whose primary and metastatic tumours and normal tissues were collected for sequencing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001006959") Annotation(rdfs:comment "Studies EGAS00001006959 PELICAN45 RNAseq Dataset To better understand the biology of prostate cancer, we performed RNAseq in cancerous (primary and metastatic) and noncancerous tissues in the PELICAN45 cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000315> "An integrated clinical-molecular rapid autopsy study of men who died of lethal prostate cancer at Johns Hopkins, United States, whose primary and metastatic tumours and normal tissues were collected for sequencing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001006959") Annotation(rdfs:comment "The PELICAN45 RNAseq samples include androgen-deprived metastasis samples from the PELICAN33 consenting rapid autopsy study participants, whose identifiers are A1, A2, etc.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000315> "An integrated clinical-molecular rapid autopsy study of men who died of lethal prostate cancer at Johns Hopkins, United States, whose primary and metastatic tumours and normal tissues were collected for sequencing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000316> (<http://www.ebi.ac.uk/coho/COHO_0000316>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005828") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19863177") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19863177+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The PETAL trial investigates whether a change in treatment protocol may improve the outcome of patients with a positive scan after two cycles of (R-)CHOP.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000316> "A cohort of patients with diffuse large B-cell lymphoma treated in the German PETAL trial of PET-guided therapy, whose tumours were exome and shallow whole-genome sequenced to reproduce biology-based risk profiles.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005828") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31427567") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6700149/fullTextXML") Annotation(rdfs:comment "In the Positron Emission Tomography-Guided Therapy of Aggressive Non-Hodgkin Lymphomas (PETAL) trial, interim positron emission tomography (iPET) after two cycles of rituximab, cyclophosphamide, doxorubicin, vincristine, and prednisone (R-CHOP) has recently been shown to predict outcome independently of the IPI2.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000316> "A cohort of patients with diffuse large B-cell lymphoma treated in the German PETAL trial of PET-guided therapy, whose tumours were exome and shallow whole-genome sequenced to reproduce biology-based risk profiles.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005828") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001005828") Annotation(rdfs:comment "Using whole-exome sequencing and shallow whole genome sequencing for simultaneous screening of mutations, copy number alterations, and translocations, 5 biology-based risk profiles could be reproduced in an independent cohort of DLBCL patients, from the PETAL trial.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000316> "A cohort of patients with diffuse large B-cell lymphoma treated in the German PETAL trial of PET-guided therapy, whose tumours were exome and shallow whole-genome sequenced to reproduce biology-based risk profiles.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000317> (<http://www.ebi.ac.uk/coho/COHO_0000317>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005554") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30901302") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30901302+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This double-blind phase III study evaluated ibrutinib and rituximab plus cyclophosphamide, doxorubicin, vincristine, and prednisone (R-CHOP) in untreated non-germinal center B-cell DLBCL.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000317> "A cohort of patients with non-germinal centre B-cell diffuse large B-cell lymphoma enrolled in the phase III PHOENIX trial of ibrutinib with R-CHOP chemotherapy, whose tumours were profiled by RNA sequencing and targeted panel sequencing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005554") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36696540") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A36696540+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We assessed whether high BCL2/MYC coexpression by RNA sequencing could identify a patient subset responsive to ibrutinib using baseline biopsies from the PHOENIX trial, which evaluated the addition of ibrutinib to rituximab, cyclophosphamide, doxorubicin, vincristine, and prednisone (R-CHOP) in untreated non-GCB DLBCL.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000317> "A cohort of patients with non-germinal centre B-cell diffuse large B-cell lymphoma enrolled in the phase III PHOENIX trial of ibrutinib with R-CHOP chemotherapy, whose tumours were profiled by RNA sequencing and targeted panel sequencing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005554") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001005554") Annotation(rdfs:comment "Study biopsies (n=773; 189 cases as China cohort and 584 cases as non-China cohort) underwent whole exome sequencing or targeted gene panel DNA sequencing and RNA sequencing, allowing the identification of somatic mutations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000317> "A cohort of patients with non-germinal centre B-cell diffuse large B-cell lymphoma enrolled in the phase III PHOENIX trial of ibrutinib with R-CHOP chemotherapy, whose tumours were profiled by RNA sequencing and targeted panel sequencing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000318> (<http://www.ebi.ac.uk/coho/COHO_0000318>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004556") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001004556") Annotation(rdfs:comment "Dataset consists 182 tumor derived genomic data of ~700 cancer-related and epigenetic-related genes with matched blood samples for 48 specimens.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000318> "A cohort of Polish patients with gliomas of WHO grades II to IV whose tumours and, for a subset, matched blood were sequenced with a panel of cancer- and epigenetics-related genes to characterise somatic and germline variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004556") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001004556") Annotation(rdfs:comment "Dataset consists of 207 glioma samples of WHO grades II, III and IV.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000318> "A cohort of Polish patients with gliomas of WHO grades II to IV whose tumours and, for a subset, matched blood were sequenced with a panel of cancer- and epigenetics-related genes to characterise somatic and germline variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004556") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001004556") Annotation(rdfs:comment "In four patients from the Polish glioma cohort, we identified a novel recurrent mutation in the TOP2A gene coding for Topoisomerase 2A in glioblastomas (GBM, WHO grade IV gliomas).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000318> "A cohort of Polish patients with gliomas of WHO grades II to IV whose tumours and, for a subset, matched blood were sequenced with a panel of cancer- and epigenetics-related genes to characterise somatic and germline variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004556") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001004556") Annotation(rdfs:comment "To better understand glioma pathobiology and find potential therapeutic susceptibilities, we designed a custom- panel 664 cancer- and epigenetics-related genes and employed targeted next generation sequencing to study the genomic landscape of somatic and germline variants in 182 glioma samples of different malignancy grades.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000318> "A cohort of Polish patients with gliomas of WHO grades II to IV whose tumours and, for a subset, matched blood were sequenced with a panel of cancer- and epigenetics-related genes to characterise somatic and germline variants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000319> (<http://www.ebi.ac.uk/coho/COHO_0000319>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007081") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36977461") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC10236155/") Annotation(rdfs:comment "Here, we present an in-depth analysis of late-stage metastatic melanoma in the first 14 patients recruited to the Posthumous Evaluation of Advanced Cancer Environment (PEACE; NCT03004755) study, with extensive multiregional and multitumor sampling at autopsy (573 tumor samples in total).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000319> "A research autopsy programme in the United Kingdom in which patients with advanced cancer consent to post-mortem sampling of primary and metastatic tumours, enabling multi-region sequencing to decipher the evolution of metastasis and therapy resistance.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007081") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36977461") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC10236155/") Annotation(rdfs:comment "The PEACE study is a pan-cancer, UK-wide research autopsy program (NCT03004755) designed to comprehensively evaluate the biology of metastatic disease and drug resistance.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000319> "A research autopsy programme in the United Kingdom in which patients with advanced cancer consent to post-mortem sampling of primary and metastatic tumours, enabling multi-region sequencing to decipher the evolution of metastasis and therapy resistance.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007081") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41372419") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A41372419+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Here we used high-depth duplex sequencing1 (more than 30,000× coverage) to analyse 168 cancer-free samples representing 16 organs from 22 patients with metastatic cancer enroled in the PEACE research autopsy study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000319> "A research autopsy programme in the United Kingdom in which patients with advanced cancer consent to post-mortem sampling of primary and metastatic tumours, enabling multi-region sequencing to decipher the evolution of metastasis and therapy resistance.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007081") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007081") Annotation(rdfs:comment "Understanding the evolutionary pathways to metastasis and resistance to immune checkpoint inhibitors (ICI) in melanoma is critical for improving outcomes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000319> "A research autopsy programme in the United Kingdom in which patients with advanced cancer consent to post-mortem sampling of primary and metastatic tumours, enabling multi-region sequencing to decipher the evolution of metastasis and therapy resistance.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000320> (<http://www.ebi.ac.uk/coho/COHO_0000320>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007958") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30523133") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6286485/fullTextXML") Annotation(rdfs:comment "PROFILE is a multicentre trial based in National Health Service hospitals within the UK.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000320> "A cohort of adults with newly diagnosed active Crohn's disease enrolled in the multicentre, biomarker-stratified, randomised PROFILE trial in the United Kingdom, whose stool samples were sequenced to relate the gut microbiome to treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007958") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007958") Annotation(rdfs:comment "PROFILE was a multicentre, open-label, biomarker-stratified, randomised controlled trial that enrolled adults with newly diagnosed active Crohn's disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000320> "A cohort of adults with newly diagnosed active Crohn's disease enrolled in the multicentre, biomarker-stratified, randomised PROFILE trial in the United Kingdom, whose stool samples were sequenced to relate the gut microbiome to treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007958") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007958") Annotation(rdfs:comment "Stool samples were collected from PROFILE (PRedicting Outcomes For Crohn's disease using a moLecular biomarker) cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000320> "A cohort of adults with newly diagnosed active Crohn's disease enrolled in the multicentre, biomarker-stratified, randomised PROFILE trial in the United Kingdom, whose stool samples were sequenced to relate the gut microbiome to treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007958") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007958") Annotation(rdfs:comment "Understanding the impact of the gut microbiome on medical treatment response in IBD patients and the identification of biomarkers for stratification of patients with regards to disease progression and treatment response is one of the priorities in the clinical research for IBD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000320> "A cohort of adults with newly diagnosed active Crohn's disease enrolled in the multicentre, biomarker-stratified, randomised PROFILE trial in the United Kingdom, whose stool samples were sequenced to relate the gut microbiome to treatment response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000321> (<http://www.ebi.ac.uk/coho/COHO_0000321>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002205") Annotation(rdfs:comment "Participants had blood taken during the dating/recruitment visit (at approximately 12 weeks gestation (wkGA)), as well as at three subsequent visits (at ∼20wkGA, ∼28wkGA and ∼36wkGA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000321> "A prospective cohort of 4,512 nulliparous women with viable singleton pregnancies recruited at the Rosie Hospital, Cambridge, United Kingdom, during 2008–2012 and followed with serial ultrasonography, blood sampling and placental collection to identify biomarkers of adverse pregnancy outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002205") Annotation(rdfs:comment "The POP study aimed both at evaluating performance of known biomarkers and serial ultrasonography in assessing maternal and fetal well-being, as well as identifying novel biomarkers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000321> "A prospective cohort of 4,512 nulliparous women with viable singleton pregnancies recruited at the Rosie Hospital, Cambridge, United Kingdom, during 2008–2012 and followed with serial ultrasonography, blood sampling and placental collection to identify biomarkers of adverse pregnancy outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002205") Annotation(rdfs:comment "The Pregnancy Outcome Prediction (POP) study is a prospective cohort study of nulliparous women attending the Rosie Hospital (Cambridge, UK) for their dating ultrasound scan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000321> "A prospective cohort of 4,512 nulliparous women with viable singleton pregnancies recruited at the Rosie Hospital, Cambridge, United Kingdom, during 2008–2012 and followed with serial ultrasonography, blood sampling and placental collection to identify biomarkers of adverse pregnancy outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002205") Annotation(rdfs:comment "The study included 4512 women with a viable singleton pregnancy; study participants provided written informed consent and were recruited between January 2008 and July 2012.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000321> "A prospective cohort of 4,512 nulliparous women with viable singleton pregnancies recruited at the Rosie Hospital, Cambridge, United Kingdom, during 2008–2012 and followed with serial ultrasonography, blood sampling and placental collection to identify biomarkers of adverse pregnancy outcomes.")

