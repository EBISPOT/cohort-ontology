AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20719408") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000127.v2.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000127.v2.p1") Annotation(rdfs:comment "All 221 cases were diagnosed by a Consultant neurologist in Ireland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002398> "A case–control collection of Irish patients with sporadic amyotrophic lateral sclerosis, diagnosed by consultant neurologists by the El Escorial criteria and drawn from across the island of Ireland, and unrelated neurologically normal controls, all reporting Irish ancestry for at least three generations, assembled in Dublin (Beaumont Hospital, Trinity College and University College Dublin) for a genome-wide association study of susceptibility to sporadic ALS in the Irish population, and later used for whole-genome sequencing of an Irish control.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20719408") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000127.v2.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000127.v2.p1") Annotation(rdfs:comment "All included cases fulfilled the criteria for probable or definite sporadic ALS, according to the El Escorial criteria") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002398> "A case–control collection of Irish patients with sporadic amyotrophic lateral sclerosis, diagnosed by consultant neurologists by the El Escorial criteria and drawn from across the island of Ireland, and unrelated neurologically normal controls, all reporting Irish ancestry for at least three generations, assembled in Dublin (Beaumont Hospital, Trinity College and University College Dublin) for a genome-wide association study of susceptibility to sporadic ALS in the Irish population, and later used for whole-genome sequencing of an Irish control.")
