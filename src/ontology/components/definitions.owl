AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34473249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37264683") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40737012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01288352") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37264683") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10405565/fullTextXML") Annotation(rdfs:comment "The Early Treatment of Atrial Fibrillation for Stroke Prevention Trial (EAST-AFNET4) showed that early rhythm control (ERC) reduces a composite of cardiovascular death, stroke, and hospitalization for worsening heart failure (HF) or acute coronary syndrome compared with usual care (UC) when added to oral anticoagulation and therapy of concomitant cardiovascular conditions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001477> "An investigator-initiated, multicentre, parallel-group, open, blinded-outcome-assessment randomised trial sponsored by the Atrial Fibrillation Network (AFNET), which from July 2011 to December 2016 randomised patients with atrial fibrillation diagnosed within the previous year and cardiovascular risk factors, at 135 sites in 11 European countries, to early rhythm control therapy or usual care, to test whether early rhythm control prevents cardiovascular complications; its biosample substudy took blood at enrolment from consenting patients.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34473249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37264683") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40737012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01288352") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37264683") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10405565/fullTextXML") Annotation(rdfs:comment "These patients were asked to donate a blood sample at baseline, documented by a separate informed consent form.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001477> "An investigator-initiated, multicentre, parallel-group, open, blinded-outcome-assessment randomised trial sponsored by the Atrial Fibrillation Network (AFNET), which from July 2011 to December 2016 randomised patients with atrial fibrillation diagnosed within the previous year and cardiovascular risk factors, at 135 sites in 11 European countries, to early rhythm control therapy or usual care, to test whether early rhythm control prevents cardiovascular complications; its biosample substudy took blood at enrolment from consenting patients.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34473249") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37264683") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40737012") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://clinicaltrials.gov/api/v2/studies/NCT01288352") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40737012") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12311819/fullTextXML") Annotation(rdfs:comment "EAST-AFNET 4 is an international, investigator-initiated, parallel-group, open, blinded outcome assessment randomized clinical trial conducted in 11 European countries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001477> "An investigator-initiated, multicentre, parallel-group, open, blinded-outcome-assessment randomised trial sponsored by the Atrial Fibrillation Network (AFNET), which from July 2011 to December 2016 randomised patients with atrial fibrillation diagnosed within the previous year and cardiovascular risk factors, at 135 sites in 11 European countries, to early rhythm control therapy or usual care, to test whether early rhythm control prevents cardiovascular complications; its biosample substudy took blood at enrolment from consenting patients.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001478> (<http://www.ebi.ac.uk/coho/COHO_0001478>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17704113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20357380") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31152163") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20357380") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2890360/fullTextXML") Annotation(rdfs:comment "All patients had blood samples and phenotypic characteristics collected as part of the European Rational Approach for the Genetics of Diabetic Complications (EURAGEDIC) project (15).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001478> "The Danish part of the European Rational Approach for the Genetics of Diabetic Complications (EURAGEDIC) study: a case–control sample of adults with type 1 diabetes attending the outpatient clinic of the Steno Diabetes Center, Denmark, recruited from 1993 to 2000, with diabetic nephropathy (cases) or with persistent normoalbuminuria after more than 15 years of diabetes (controls), whose blood samples and clinical data were collected to study genetic risk factors for diabetic nephropathy and who were followed prospectively for mortality and cardiovascular and renal outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17704113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20357380") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31152163") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20357380") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2890360/fullTextXML") Annotation(rdfs:comment "From 1993 to 2000, adult Caucasian patients with type 1 diabetes and diabetic nephropathy attending the outpatient clinic at the Steno Diabetes Center were invited to participate in a study of genetic risk factors for the development of diabetic complications.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001478> "The Danish part of the European Rational Approach for the Genetics of Diabetic Complications (EURAGEDIC) study: a case–control sample of adults with type 1 diabetes attending the outpatient clinic of the Steno Diabetes Center, Denmark, recruited from 1993 to 2000, with diabetic nephropathy (cases) or with persistent normoalbuminuria after more than 15 years of diabetes (controls), whose blood samples and clinical data were collected to study genetic risk factors for diabetic nephropathy and who were followed prospectively for mortality and cardiovascular and renal outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17704113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20357380") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31152163") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20357380") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2890360/fullTextXML") Annotation(rdfs:comment "In a prospective observational study design, the patients were followed until an end point was reached—to the last visit at the Steno Diabetes Center or until 1 September 2006.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001478> "The Danish part of the European Rational Approach for the Genetics of Diabetic Complications (EURAGEDIC) study: a case–control sample of adults with type 1 diabetes attending the outpatient clinic of the Steno Diabetes Center, Denmark, recruited from 1993 to 2000, with diabetic nephropathy (cases) or with persistent normoalbuminuria after more than 15 years of diabetes (controls), whose blood samples and clinical data were collected to study genetic risk factors for diabetic nephropathy and who were followed prospectively for mortality and cardiovascular and renal outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17704113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20357380") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31152163") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20357380") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2890360/fullTextXML") Annotation(rdfs:comment "The absence of diabetic nephropathy (control subjects) was defined as persistent normoalbuminuria (<30 mg/24 h) after >15 years of type 1 diabetes in patients not treated with ACE inhibitors or angiotensin-II receptor blockers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001478> "The Danish part of the European Rational Approach for the Genetics of Diabetic Complications (EURAGEDIC) study: a case–control sample of adults with type 1 diabetes attending the outpatient clinic of the Steno Diabetes Center, Denmark, recruited from 1993 to 2000, with diabetic nephropathy (cases) or with persistent normoalbuminuria after more than 15 years of diabetes (controls), whose blood samples and clinical data were collected to study genetic risk factors for diabetic nephropathy and who were followed prospectively for mortality and cardiovascular and renal outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17704113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20357380") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31152163") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20357380") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2890360/fullTextXML") Annotation(rdfs:comment "Therefore, we investigated the predictive value of circulating GDF-15 levels on all-cause mortality, fatal and nonfatal CVD, decline in GFR, as well as progression to end-stage renal disease (ESRD) in a well-characterized population of type 1 diabetic patients with or without diabetic nephropathy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001478> "The Danish part of the European Rational Approach for the Genetics of Diabetic Complications (EURAGEDIC) study: a case–control sample of adults with type 1 diabetes attending the outpatient clinic of the Steno Diabetes Center, Denmark, recruited from 1993 to 2000, with diabetic nephropathy (cases) or with persistent normoalbuminuria after more than 15 years of diabetes (controls), whose blood samples and clinical data were collected to study genetic risk factors for diabetic nephropathy and who were followed prospectively for mortality and cardiovascular and renal outcomes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17704113") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20357380") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31152163") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31152163") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-019-0407-x/MediaObjects/41588_2019_407_MOESM1_ESM.pdf") Annotation(rdfs:comment "The AFTER EU study is the Danish part of the EURAGEDIC study which was supported by the European Commission (contract QLG2-CT-2001– 01669).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001478> "The Danish part of the European Rational Approach for the Genetics of Diabetic Complications (EURAGEDIC) study: a case–control sample of adults with type 1 diabetes attending the outpatient clinic of the Steno Diabetes Center, Denmark, recruited from 1993 to 2000, with diabetic nephropathy (cases) or with persistent normoalbuminuria after more than 15 years of diabetes (controls), whose blood samples and clinical data were collected to study genetic risk factors for diabetic nephropathy and who were followed prospectively for mortality and cardiovascular and renal outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001479> (<http://www.ebi.ac.uk/coho/COHO_0001479>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16078860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17322880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768552") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16078860") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16078860+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Linkage analysis will subsequently be performed on approximately 1500 pedigrees as will downstream fine-mapping and sequencing of the critical linkage intervals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001479> "An international consortium of autism genetics research groups at more than 50 centres in North America and Europe, initiated by the National Alliance for Autism Research (later Autism Speaks) and the US National Institutes of Health and formed from four existing consortia (the Autism Genetics Cooperative, the Autism Genetic Resource Exchange, the Collaborative Programs of Excellence in Autism and the International Molecular Genetic Study of Autism Consortium). It pools the families with autism spectrum disorder collected at its sites, diagnosed with the ADI-R and ADOS, for genome-wide linkage, copy number variation and association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16078860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17322880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768552") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16078860") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A16078860+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Autism Genome Project (AGP) is a large-scale, collaborative genetics research project initiated by the National Alliance for Autism Research and the National Institutes of Health, and is aimed at sifting through the human genome in search of autism-susceptibility genes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001479> "An international consortium of autism genetics research groups at more than 50 centres in North America and Europe, initiated by the National Alliance for Autism Research (later Autism Speaks) and the US National Institutes of Health and formed from four existing consortia (the Autism Genetics Cooperative, the Autism Genetic Resource Exchange, the Collaborative Programs of Excellence in Autism and the International Molecular Genetic Study of Autism Consortium). It pools the families with autism spectrum disorder collected at its sites, diagnosed with the ADI-R and ADOS, for genome-wide linkage, copy number variation and association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16078860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17322880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768552") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17322880") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4867008/") Annotation(rdfs:comment "The Autism Genome Project (AGP) Consortium, comprised of scientists from 50 centres in North America and Europe, collected 1,496 ASD families (7,917 family members) for this study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001479> "An international consortium of autism genetics research groups at more than 50 centres in North America and Europe, initiated by the National Alliance for Autism Research (later Autism Speaks) and the US National Institutes of Health and formed from four existing consortia (the Autism Genetics Cooperative, the Autism Genetic Resource Exchange, the Collaborative Programs of Excellence in Autism and the International Molecular Genetic Study of Autism Consortium). It pools the families with autism spectrum disorder collected at its sites, diagnosed with the ADI-R and ADOS, for genome-wide linkage, copy number variation and association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16078860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17322880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768552") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24768552") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4067558/unicode") Annotation(rdfs:comment "Affected AGP participants were classified according to the Autism Diagnostic Observation Schedule (ADOS) and the Autism Diagnostic Interview, Revised (ADI-R).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001479> "An international consortium of autism genetics research groups at more than 50 centres in North America and Europe, initiated by the National Alliance for Autism Research (later Autism Speaks) and the US National Institutes of Health and formed from four existing consortia (the Autism Genetics Cooperative, the Autism Genetic Resource Exchange, the Collaborative Programs of Excellence in Autism and the International Molecular Genetic Study of Autism Consortium). It pools the families with autism spectrum disorder collected at its sites, diagnosed with the ADI-R and ADOS, for genome-wide linkage, copy number variation and association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16078860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17322880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768552") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24768552") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4067558/unicode") Annotation(rdfs:comment "In stage 2, we genotyped the remaining families (n = 1,604) for a total of over 2,845 families and performed genome-wide CNV (this study) and association studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001479> "An international consortium of autism genetics research groups at more than 50 centres in North America and Europe, initiated by the National Alliance for Autism Research (later Autism Speaks) and the US National Institutes of Health and formed from four existing consortia (the Autism Genetics Cooperative, the Autism Genetic Resource Exchange, the Collaborative Programs of Excellence in Autism and the International Molecular Genetic Study of Autism Consortium). It pools the families with autism spectrum disorder collected at its sites, diagnosed with the ADI-R and ADOS, for genome-wide linkage, copy number variation and association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16078860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17322880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768552") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24768552") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4067558/unicode") Annotation(rdfs:comment "The samples were collected as part of the AGP, an international consortium with over 50 sites in North America and Europe.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001479> "An international consortium of autism genetics research groups at more than 50 centres in North America and Europe, initiated by the National Alliance for Autism Research (later Autism Speaks) and the US National Institutes of Health and formed from four existing consortia (the Autism Genetics Cooperative, the Autism Genetic Resource Exchange, the Collaborative Programs of Excellence in Autism and the International Molecular Genetic Study of Autism Consortium). It pools the families with autism spectrum disorder collected at its sites, diagnosed with the ADI-R and ADOS, for genome-wide linkage, copy number variation and association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16078860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17322880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768552") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.nature.com/articles/ng1985") Annotation(rdfs:comment "The AGP comprises four existing consortia of partners or countries (listed alphabetically below).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001479> "An international consortium of autism genetics research groups at more than 50 centres in North America and Europe, initiated by the National Alliance for Autism Research (later Autism Speaks) and the US National Institutes of Health and formed from four existing consortia (the Autism Genetics Cooperative, the Autism Genetic Resource Exchange, the Collaborative Programs of Excellence in Autism and the International Molecular Genetic Study of Autism Consortium). It pools the families with autism spectrum disorder collected at its sites, diagnosed with the ADI-R and ADOS, for genome-wide linkage, copy number variation and association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16078860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17322880") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24768552") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.nature.com/articles/ng1985") Annotation(rdfs:comment "We gratefully acknowledge Autism Speaks, formerly the National Alliance for Autism Research, for financial support for data pooling, SNP genotyping and data analysis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001479> "An international consortium of autism genetics research groups at more than 50 centres in North America and Europe, initiated by the National Alliance for Autism Research (later Autism Speaks) and the US National Institutes of Health and formed from four existing consortia (the Autism Genetics Cooperative, the Autism Genetic Resource Exchange, the Collaborative Programs of Excellence in Autism and the International Molecular Genetic Study of Autism Consortium). It pools the families with autism spectrum disorder collected at its sites, diagnosed with the ADI-R and ADOS, for genome-wide linkage, copy number variation and association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001480> (<http://www.ebi.ac.uk/coho/COHO_0001480>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11452364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20955925") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702161") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:11452364") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC1235320/") Annotation(rdfs:comment "One unique feature of AGRE, which has enabled the rapid ascertainment of large numbers of families, has been the development of a protocol and the infrastructure to conduct the majority of the evaluations and blood draws in the families’ homes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001480> "A resource of biomaterials (cell lines, DNA and serum) and genetic and phenotypic data from families with autism spectrum disorder recruited from across the United States, mostly multiplex families with two or more affected members, whose diagnostic assessments (ADI-R and ADOS) and blood draws are done in the families' homes. It was established in 1997 by the Cure Autism Now Foundation and the Human Biological Data Interchange, is now managed by Autism Speaks, and makes its samples and data available to qualified researchers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11452364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20955925") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702161") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20955925") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3004528/") Annotation(rdfs:comment "Recruitment priority is given to families with two or more immediate family members affected with an ASD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001480> "A resource of biomaterials (cell lines, DNA and serum) and genetic and phenotypic data from families with autism spectrum disorder recruited from across the United States, mostly multiplex families with two or more affected members, whose diagnostic assessments (ADI-R and ADOS) and blood draws are done in the families' homes. It was established in 1997 by the Cure Autism Now Foundation and the Human Biological Data Interchange, is now managed by Autism Speaks, and makes its samples and data available to qualified researchers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11452364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20955925") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702161") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28702161") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5504648/fullTextXML") Annotation(rdfs:comment "AGRE is currently managed by Autism Speaks.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001480> "A resource of biomaterials (cell lines, DNA and serum) and genetic and phenotypic data from families with autism spectrum disorder recruited from across the United States, mostly multiplex families with two or more affected members, whose diagnostic assessments (ADI-R and ADOS) and blood draws are done in the families' homes. It was established in 1997 by the Cure Autism Now Foundation and the Human Biological Data Interchange, is now managed by Autism Speaks, and makes its samples and data available to qualified researchers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11452364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20955925") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702161") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28702161") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5504648/fullTextXML") Annotation(rdfs:comment "AGRE was established in 1997 by the Cure Autism Now (CAN) Foundation and the Human Biological Data Interchange (HBDI).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001480> "A resource of biomaterials (cell lines, DNA and serum) and genetic and phenotypic data from families with autism spectrum disorder recruited from across the United States, mostly multiplex families with two or more affected members, whose diagnostic assessments (ADI-R and ADOS) and blood draws are done in the families' homes. It was established in 1997 by the Cure Autism Now Foundation and the Human Biological Data Interchange, is now managed by Autism Speaks, and makes its samples and data available to qualified researchers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11452364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20955925") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702161") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28702161") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5504648/fullTextXML") Annotation(rdfs:comment "Autism Genetic Resource Exchange (AGRE)1997USABlood and immortalised cell lines") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001480> "A resource of biomaterials (cell lines, DNA and serum) and genetic and phenotypic data from families with autism spectrum disorder recruited from across the United States, mostly multiplex families with two or more affected members, whose diagnostic assessments (ADI-R and ADOS) and blood draws are done in the families' homes. It was established in 1997 by the Cure Autism Now Foundation and the Human Biological Data Interchange, is now managed by Autism Speaks, and makes its samples and data available to qualified researchers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11452364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20955925") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702161") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28702161") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5504648/fullTextXML") Annotation(rdfs:comment "Samples are housed at the National Institute of Mental Health repository at Rutgers’ University in the form of immortalised cell lines, DNA and serum samples which can be accessed by researchers through applications [20].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001480> "A resource of biomaterials (cell lines, DNA and serum) and genetic and phenotypic data from families with autism spectrum disorder recruited from across the United States, mostly multiplex families with two or more affected members, whose diagnostic assessments (ADI-R and ADOS) and blood draws are done in the families' homes. It was established in 1997 by the Cure Autism Now Foundation and the Human Biological Data Interchange, is now managed by Autism Speaks, and makes its samples and data available to qualified researchers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11452364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20955925") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702161") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6071802/fullTextXML") Annotation(rdfs:comment "Our study sample comprised individuals from the Autism Genetic Resource Exchange (AGRE), a volunteer research repository of families from across the United States in which typically two or more siblings have a diagnosis of ASD (multiplex families).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001480> "A resource of biomaterials (cell lines, DNA and serum) and genetic and phenotypic data from families with autism spectrum disorder recruited from across the United States, mostly multiplex families with two or more affected members, whose diagnostic assessments (ADI-R and ADOS) and blood draws are done in the families' homes. It was established in 1997 by the Cure Autism Now Foundation and the Human Biological Data Interchange, is now managed by Autism Speaks, and makes its samples and data available to qualified researchers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001481> (<http://www.ebi.ac.uk/coho/COHO_0001481>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16749939") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346443") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16749939") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1513391/fullTextXML") Annotation(rdfs:comment "Eligible cases included those age 20 years and older, with histologically confirmed newly diagnosed glioma, International Classification of Disease for Oncology codes 9380 to 9481, who resided in 6-counties of the San Francisco Bay Area, which included Alameda, Contra Costa, Marin, San Mateo, San Francisco, or Santa Clara.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001481> "A case-control study of adult glioma run by the University of California, San Francisco since 1991, whose cases are adults with newly diagnosed, histologically confirmed glioma: population-based cases living in six San Francisco Bay Area counties (Alameda, Contra Costa, Marin, San Francisco, San Mateo and Santa Clara), identified through the regional cancer registry's rapid case ascertainment, and, from 2002, clinic-based cases recruited at the UCSF Neuro-oncology Clinic. Its controls were found by random-digit dialling in the same counties and frequency-matched to cases on age, sex and ethnicity, and later drawn from UCSF clinics; it studies environmental, immunological and genetic risk factors for glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16749939") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346443") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28346443") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5558246/") Annotation(rdfs:comment "Clinic-based cases who were diagnosed between 2002 and 2012 (series 3–5) were recruited from the UCSF Neuro-oncology Clinic, regardless of the place of residence.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001481> "A case-control study of adult glioma run by the University of California, San Francisco since 1991, whose cases are adults with newly diagnosed, histologically confirmed glioma: population-based cases living in six San Francisco Bay Area counties (Alameda, Contra Costa, Marin, San Francisco, San Mateo and Santa Clara), identified through the regional cancer registry's rapid case ascertainment, and, from 2002, clinic-based cases recruited at the UCSF Neuro-oncology Clinic. Its controls were found by random-digit dialling in the same counties and frequency-matched to cases on age, sex and ethnicity, and later drawn from UCSF clinics; it studies environmental, immunological and genetic risk factors for glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16749939") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346443") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28346443") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5558246/") Annotation(rdfs:comment "Clinic-based controls were matched to clinic-based glioma cases for age, gender and ethnicity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001481> "A case-control study of adult glioma run by the University of California, San Francisco since 1991, whose cases are adults with newly diagnosed, histologically confirmed glioma: population-based cases living in six San Francisco Bay Area counties (Alameda, Contra Costa, Marin, San Francisco, San Mateo and Santa Clara), identified through the regional cancer registry's rapid case ascertainment, and, from 2002, clinic-based cases recruited at the UCSF Neuro-oncology Clinic. Its controls were found by random-digit dialling in the same counties and frequency-matched to cases on age, sex and ethnicity, and later drawn from UCSF clinics; it studies environmental, immunological and genetic risk factors for glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16749939") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346443") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28346443") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5558246/") Annotation(rdfs:comment "From 1991 to 2010, population-based controls from the same residential area as the population-based cases were identified using random digit-dialing and were frequency matched to population-based cases for age, gender and ethnicity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001481> "A case-control study of adult glioma run by the University of California, San Francisco since 1991, whose cases are adults with newly diagnosed, histologically confirmed glioma: population-based cases living in six San Francisco Bay Area counties (Alameda, Contra Costa, Marin, San Francisco, San Mateo and Santa Clara), identified through the regional cancer registry's rapid case ascertainment, and, from 2002, clinic-based cases recruited at the UCSF Neuro-oncology Clinic. Its controls were found by random-digit dialling in the same counties and frequency-matched to cases on age, sex and ethnicity, and later drawn from UCSF clinics; it studies environmental, immunological and genetic risk factors for glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16749939") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346443") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28346443") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5558246/") Annotation(rdfs:comment "Population-based cases who were diagnosed between 1991 and 2009 (series 1–4) and who were residing in the six San Francisco Bay area counties were ascertained using the Cancer Prevention Institute of California’s early-case ascertainment system.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001481> "A case-control study of adult glioma run by the University of California, San Francisco since 1991, whose cases are adults with newly diagnosed, histologically confirmed glioma: population-based cases living in six San Francisco Bay Area counties (Alameda, Contra Costa, Marin, San Francisco, San Mateo and Santa Clara), identified through the regional cancer registry's rapid case ascertainment, and, from 2002, clinic-based cases recruited at the UCSF Neuro-oncology Clinic. Its controls were found by random-digit dialling in the same counties and frequency-matched to cases on age, sex and ethnicity, and later drawn from UCSF clinics; it studies environmental, immunological and genetic risk factors for glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16749939") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346443") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28346443") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5558246/") Annotation(rdfs:comment "The UCSF adult glioma case–control study (SFAGS–GWAS) included participants of the San Francisco Bay Area Adult Glioma Study (AGS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001481> "A case-control study of adult glioma run by the University of California, San Francisco since 1991, whose cases are adults with newly diagnosed, histologically confirmed glioma: population-based cases living in six San Francisco Bay Area counties (Alameda, Contra Costa, Marin, San Francisco, San Mateo and Santa Clara), identified through the regional cancer registry's rapid case ascertainment, and, from 2002, clinic-based cases recruited at the UCSF Neuro-oncology Clinic. Its controls were found by random-digit dialling in the same counties and frequency-matched to cases on age, sex and ethnicity, and later drawn from UCSF clinics; it studies environmental, immunological and genetic risk factors for glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16749939") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346443") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001497.v2.p1") Annotation(rdfs:comment "Controls included people not diagnosed with glioma who were either residents of the San Francisco Bay Area from 1997-2010 or patients seen at the UCSF phlebotomy clinic between 2010 and 2012.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001481> "A case-control study of adult glioma run by the University of California, San Francisco since 1991, whose cases are adults with newly diagnosed, histologically confirmed glioma: population-based cases living in six San Francisco Bay Area counties (Alameda, Contra Costa, Marin, San Francisco, San Mateo and Santa Clara), identified through the regional cancer registry's rapid case ascertainment, and, from 2002, clinic-based cases recruited at the UCSF Neuro-oncology Clinic. Its controls were found by random-digit dialling in the same counties and frequency-matched to cases on age, sex and ethnicity, and later drawn from UCSF clinics; it studies environmental, immunological and genetic risk factors for glioma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16749939") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28346443") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001497.v2.p1") Annotation(rdfs:comment "The goals of the study were to discover inherited (genetic), developmental, immunologic and other risk factors for glioma and to determine molecular level tumor markers that would be helpful in classifying glioma into more homogeneous groups.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001481> "A case-control study of adult glioma run by the University of California, San Francisco since 1991, whose cases are adults with newly diagnosed, histologically confirmed glioma: population-based cases living in six San Francisco Bay Area counties (Alameda, Contra Costa, Marin, San Francisco, San Mateo and Santa Clara), identified through the regional cancer registry's rapid case ascertainment, and, from 2002, clinic-based cases recruited at the UCSF Neuro-oncology Clinic. Its controls were found by random-digit dialling in the same counties and frequency-matched to cases on age, sex and ethnicity, and later drawn from UCSF clinics; it studies environmental, immunological and genetic risk factors for glioma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001482> (<http://www.ebi.ac.uk/coho/COHO_0001482>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2505/MediaObjects/41588_2013_BFng2505_MOESM12_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2505/MediaObjects/41588_2013_BFng2505_MOESM12_ESM.pdf") Annotation(rdfs:comment "A total of 942 controls without any cancer at recruitment were randomly selected and frequency-matched to cases by age and sex.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001482> "A hospital-based case-control study of colorectal cancer at Aichi Cancer Center in Nagoya, Japan, part of the centre's Hospital-based Epidemiologic Research Program (HERPACC): its first collection (Aichi-1) took colorectal cancer cases and cancer-free controls, frequency-matched on age and sex, from the first-visit outpatients enrolled in HERPACC-II in 2000–2005, and its second (Aichi-2) recruited further cases and matched controls at the same hospital. Both collections were genotyped for the Asia Colorectal Cancer Consortium's genome-wide association studies of colorectal cancer in East Asians.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2505/MediaObjects/41588_2013_BFng2505_MOESM12_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2505/MediaObjects/41588_2013_BFng2505_MOESM12_ESM.pdf") Annotation(rdfs:comment "Aichi Study: This study is part of the Hospital-based Epidemiologic Research Program at Aichi Cancer Center (HERPACC-II), Japan 6 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001482> "A hospital-based case-control study of colorectal cancer at Aichi Cancer Center in Nagoya, Japan, part of the centre's Hospital-based Epidemiologic Research Program (HERPACC): its first collection (Aichi-1) took colorectal cancer cases and cancer-free controls, frequency-matched on age and sex, from the first-visit outpatients enrolled in HERPACC-II in 2000–2005, and its second (Aichi-2) recruited further cases and matched controls at the same hospital. Both collections were genotyped for the Asia Colorectal Cancer Consortium's genome-wide association studies of colorectal cancer in East Asians.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2505/MediaObjects/41588_2013_BFng2505_MOESM12_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2505/MediaObjects/41588_2013_BFng2505_MOESM12_ESM.pdf") Annotation(rdfs:comment "All first-visit outpatients 20-79 years of age at Aichi Cancer Center during December 2000 to November 2005 were asked to participate in HERPACC-II.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001482> "A hospital-based case-control study of colorectal cancer at Aichi Cancer Center in Nagoya, Japan, part of the centre's Hospital-based Epidemiologic Research Program (HERPACC): its first collection (Aichi-1) took colorectal cancer cases and cancer-free controls, frequency-matched on age and sex, from the first-visit outpatients enrolled in HERPACC-II in 2000–2005, and its second (Aichi-2) recruited further cases and matched controls at the same hospital. Both collections were genotyped for the Asia Colorectal Cancer Consortium's genome-wide association studies of colorectal cancer in East Asians.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2505/MediaObjects/41588_2013_BFng2505_MOESM12_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "Cases and frequency-matched controls in Aichi-2 were recently recruited from the same study site.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001482> "A hospital-based case-control study of colorectal cancer at Aichi Cancer Center in Nagoya, Japan, part of the centre's Hospital-based Epidemiologic Research Program (HERPACC): its first collection (Aichi-1) took colorectal cancer cases and cancer-free controls, frequency-matched on age and sex, from the first-visit outpatients enrolled in HERPACC-II in 2000–2005, and its second (Aichi-2) recruited further cases and matched controls at the same hospital. Both collections were genotyped for the Asia Colorectal Cancer Consortium's genome-wide association studies of colorectal cancer in East Asians.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2505/MediaObjects/41588_2013_BFng2505_MOESM12_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "In Aichi-1, cases were identified among 28,766 participants of the Hospital- based Epidemiologic Research Program at Aichi Cancer Center, Japan 8 and controls were cancer-free individuals recruited from this population 9 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001482> "A hospital-based case-control study of colorectal cancer at Aichi Cancer Center in Nagoya, Japan, part of the centre's Hospital-based Epidemiologic Research Program (HERPACC): its first collection (Aichi-1) took colorectal cancer cases and cancer-free controls, frequency-matched on age and sex, from the first-visit outpatients enrolled in HERPACC-II in 2000–2005, and its second (Aichi-2) recruited further cases and matched controls at the same hospital. Both collections were genotyped for the Asia Colorectal Cancer Consortium's genome-wide association studies of colorectal cancer in East Asians.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2505/MediaObjects/41588_2013_BFng2505_MOESM12_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2985/MediaObjects/41588_2014_BFng2985_MOESM57_ESM.pdf") Annotation(rdfs:comment "The Aichi CRC Study: This study had two case-control collections (Aichi-1 and Aichi-2) with a total of 640 cases and 1,414 controls 1 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001482> "A hospital-based case-control study of colorectal cancer at Aichi Cancer Center in Nagoya, Japan, part of the centre's Hospital-based Epidemiologic Research Program (HERPACC): its first collection (Aichi-1) took colorectal cancer cases and cancer-free controls, frequency-matched on age and sex, from the first-visit outpatients enrolled in HERPACC-II in 2000–2005, and its second (Aichi-2) recruited further cases and matched controls at the same hospital. Both collections were genotyped for the Asia Colorectal Cancer Consortium's genome-wide association studies of colorectal cancer in East Asians.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001483> (<http://www.ebi.ac.uk/coho/COHO_0001483>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24343304") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25849024") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24343304") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3945713/") Annotation(rdfs:comment "Because of the critical gaps in knowledge discussed above, it is essential that more research be directed toward understanding the causes of ER− and basal-like breast cancer in AA women.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001483> "A consortium, funded by the US National Cancer Institute as a Program Project, that pools the questionnaire data, tumour tissue and DNA of four epidemiological studies of breast cancer in African American women in the United States (two case-control studies, the Carolina Breast Cancer Study and the Women's Circle of Health Study, and two cohorts, the Black Women's Health Study and the Multiethnic Cohort Study), with tumour subtyping, genotyping and data harmonisation done centrally in shared cores, to study the causes of breast cancer subtypes, especially oestrogen receptor-negative breast cancer, in African American women.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24343304") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25849024") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24343304") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3945713/") Annotation(rdfs:comment "The AMBER consortium is an NCI-funded Program Project consisting of four cores and four scientific projects.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001483> "A consortium, funded by the US National Cancer Institute as a Program Project, that pools the questionnaire data, tumour tissue and DNA of four epidemiological studies of breast cancer in African American women in the United States (two case-control studies, the Carolina Breast Cancer Study and the Women's Circle of Health Study, and two cohorts, the Black Women's Health Study and the Multiethnic Cohort Study), with tumour subtyping, genotyping and data harmonisation done centrally in shared cores, to study the causes of breast cancer subtypes, especially oestrogen receptor-negative breast cancer, in African American women.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24343304") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25849024") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24343304") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3945713/") Annotation(rdfs:comment "The Biostatistics and Data Management core, Core D, has responsibility for establishing and maintaining a database that includes individual-level pathology, genomic, serum biomarker, and questionnaire data from all four studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001483> "A consortium, funded by the US National Cancer Institute as a Program Project, that pools the questionnaire data, tumour tissue and DNA of four epidemiological studies of breast cancer in African American women in the United States (two case-control studies, the Carolina Breast Cancer Study and the Women's Circle of Health Study, and two cohorts, the Black Women's Health Study and the Multiethnic Cohort Study), with tumour subtyping, genotyping and data harmonisation done centrally in shared cores, to study the causes of breast cancer subtypes, especially oestrogen receptor-negative breast cancer, in African American women.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24343304") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25849024") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24343304") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3945713/") Annotation(rdfs:comment "The collaboration, African American Breast Cancer Epidemiology and Risk (AMBER), is designed to pool existing data, continue accrual of new cases with periodic additions to the pooled data set, and carry out subtyping assays of tumor tissue samples, genotyping assays of DNA samples, and statistical analyses of questionnaire data within dedicated cores so that the same methods are applied across studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001483> "A consortium, funded by the US National Cancer Institute as a Program Project, that pools the questionnaire data, tumour tissue and DNA of four epidemiological studies of breast cancer in African American women in the United States (two case-control studies, the Carolina Breast Cancer Study and the Women's Circle of Health Study, and two cohorts, the Black Women's Health Study and the Multiethnic Cohort Study), with tumour subtyping, genotyping and data harmonisation done centrally in shared cores, to study the causes of breast cancer subtypes, especially oestrogen receptor-negative breast cancer, in African American women.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24343304") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25849024") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24343304") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3945713/") Annotation(rdfs:comment "We combined samples and data from four large epidemiologic studies of breast cancer in AA women, two cohort and two case-control, creating the AMBER consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001483> "A consortium, funded by the US National Cancer Institute as a Program Project, that pools the questionnaire data, tumour tissue and DNA of four epidemiological studies of breast cancer in African American women in the United States (two case-control studies, the Carolina Breast Cancer Study and the Women's Circle of Health Study, and two cohorts, the Black Women's Health Study and the Multiethnic Cohort Study), with tumour subtyping, genotyping and data harmonisation done centrally in shared cores, to study the causes of breast cancer subtypes, especially oestrogen receptor-negative breast cancer, in African American women.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24343304") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25849024") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25849024") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4358874/fullTextXML") Annotation(rdfs:comment "The AMBER Consortium pools data from two large case–control studies, the Carolina Breast Cancer Study (CBCS) and the Women’s Circle of Health Study (WCHS), and two large cohort studies, the Black Women’s Health Study (BWHS) and the Multiethnic Cohort Study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001483> "A consortium, funded by the US National Cancer Institute as a Program Project, that pools the questionnaire data, tumour tissue and DNA of four epidemiological studies of breast cancer in African American women in the United States (two case-control studies, the Carolina Breast Cancer Study and the Women's Circle of Health Study, and two cohorts, the Black Women's Health Study and the Multiethnic Cohort Study), with tumour subtyping, genotyping and data harmonisation done centrally in shared cores, to study the causes of breast cancer subtypes, especially oestrogen receptor-negative breast cancer, in African American women.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001484> (<http://www.ebi.ac.uk/coho/COHO_0001484>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198609") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2681011") Annotation(rdfs:comment "We designed a three-staged GWAS of early-onset MI with SNPs, common CNVs, and rare CNVs (Figure 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001484> "A German case-control study of myocardial infarction whose cases were enrolled in 2004–2006 in a prospective multicentre registry at 4 heart centres and 6 cardiology departments in North Rhine-Westphalia, Lower Saxony and Mecklenburg-Western Pomerania: consecutive men younger than 65 admitted with ST- or non-ST-segment elevation acute myocardial infarction, all of whom underwent cardiac catheterisation and revascularisation. Its controls are participants of the population-based Dortmund Health Study, and the case-control sample served as a replication study for the Myocardial Infarction Genetics Consortium's genome-wide association study of early-onset myocardial infarction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198609") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(rdfs:comment "All cases underwent cardiac catheterization and interventional or surgical revascularization.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001484> "A German case-control study of myocardial infarction whose cases were enrolled in 2004–2006 in a prospective multicentre registry at 4 heart centres and 6 cardiology departments in North Rhine-Westphalia, Lower Saxony and Mecklenburg-Western Pomerania: consecutive men younger than 65 admitted with ST- or non-ST-segment elevation acute myocardial infarction, all of whom underwent cardiac catheterisation and revascularisation. Its controls are participants of the population-based Dortmund Health Study, and the case-control sample served as a replication study for the Myocardial Infarction Genetics Consortium's genome-wide association study of early-onset myocardial infarction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198609") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(rdfs:comment "Between 2004 and 2006, we enrolled a cohort of 809 consecutive men younger than 65 and suffering from non-ST-segment elevation MI or ST- segment elevation MI with an onset of symptoms less than 24 hours before admission.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001484> "A German case-control study of myocardial infarction whose cases were enrolled in 2004–2006 in a prospective multicentre registry at 4 heart centres and 6 cardiology departments in North Rhine-Westphalia, Lower Saxony and Mecklenburg-Western Pomerania: consecutive men younger than 65 admitted with ST- or non-ST-segment elevation acute myocardial infarction, all of whom underwent cardiac catheterisation and revascularisation. Its controls are participants of the population-based Dortmund Health Study, and the case-control sample served as a replication study for the Myocardial Infarction Genetics Consortium's genome-wide association study of early-onset myocardial infarction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198609") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(rdfs:comment "Controls came from the Dortmund Health Study13,14 , a population-based survey conducted in the city of Dortmund with the aim to determine the prevalence of headache types, cardiovascular and other chronic diseases and their risk factors in the general population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001484> "A German case-control study of myocardial infarction whose cases were enrolled in 2004–2006 in a prospective multicentre registry at 4 heart centres and 6 cardiology departments in North Rhine-Westphalia, Lower Saxony and Mecklenburg-Western Pomerania: consecutive men younger than 65 admitted with ST- or non-ST-segment elevation acute myocardial infarction, all of whom underwent cardiac catheterisation and revascularisation. Its controls are participants of the population-based Dortmund Health Study, and the case-control sample served as a replication study for the Myocardial Infarction Genetics Consortium's genome-wide association study of early-onset myocardial infarction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198609") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(rdfs:comment "The AMI Gene Study/Dortmund Health Study13 is a prospective multi-centre registry involving 4 heart centres and 6 cardiologic departments in North-Rhine-Westphalia, Lower Saxony, and Mecklenburg-Western Pomerania.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001484> "A German case-control study of myocardial infarction whose cases were enrolled in 2004–2006 in a prospective multicentre registry at 4 heart centres and 6 cardiology departments in North Rhine-Westphalia, Lower Saxony and Mecklenburg-Western Pomerania: consecutive men younger than 65 admitted with ST- or non-ST-segment elevation acute myocardial infarction, all of whom underwent cardiac catheterisation and revascularisation. Its controls are participants of the population-based Dortmund Health Study, and the case-control sample served as a replication study for the Myocardial Infarction Genetics Consortium's genome-wide association study of early-onset myocardial infarction.")
