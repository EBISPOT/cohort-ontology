# Individual: <http://www.ebi.ac.uk/coho/COHO_0002191> (<http://www.ebi.ac.uk/coho/COHO_0002191>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21627779") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35379992") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21627779") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3219074/fullTextXML") Annotation(rdfs:comment "A sample of 327 sporadic AD patients and 801 controls with unknown cognitive status from the Spanish general population were included in our initial study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002191> "A Spanish case-control sample for genetic studies of Alzheimer's disease, assembled by the genomics company Neocodex in Seville, whose patients with sporadic Alzheimer's disease were diagnosed with possible or probable disease under NINCDS–ADRDA criteria by neurologists at the Virgen de la Arrixaca University Hospital in Murcia, and whose controls, of unknown cognitive status, came from the Spanish general population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21627779") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35379992") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21627779") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3219074/fullTextXML") Annotation(rdfs:comment "A sample of 327 sporadic AD patients diagnosed as possible or probable AD in accordance with the criteria of the National Institute of Neurological and Communicative Disorders and Stroke and the Alzheimer's Disease and Related Disorders Association (NINCDS-ADRDA) [10] by neurologists at the Virgen de Arrixaca University Hospital in Murcia (Spain)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002191> "A Spanish case-control sample for genetic studies of Alzheimer's disease, assembled by the genomics company Neocodex in Seville, whose patients with sporadic Alzheimer's disease were diagnosed with possible or probable disease under NINCDS–ADRDA criteria by neurologists at the Virgen de la Arrixaca University Hospital in Murcia, and whose controls, of unknown cognitive status, came from the Spanish general population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21627779") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35379992") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35379992") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01024-z/MediaObjects/41588_2022_1024_MOESM1_ESM.pdf") Annotation(rdfs:comment "This study includes 324 sporadic AD patients and 754 controls of unknown cognitive status from the Spanish general population collected by Neocodex29,30 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002191> "A Spanish case-control sample for genetic studies of Alzheimer's disease, assembled by the genomics company Neocodex in Seville, whose patients with sporadic Alzheimer's disease were diagnosed with possible or probable disease under NINCDS–ADRDA criteria by neurologists at the Virgen de la Arrixaca University Hospital in Murcia, and whose controls, of unknown cognitive status, came from the Spanish general population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002192> (<http://www.ebi.ac.uk/coho/COHO_0002192>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710223") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15226762") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14710223") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2395327/fullTextXML") Annotation(rdfs:comment "Between 1985 and 1991, the NYU Women's Health Study enrolled 14 275 healthy women aged 34–65 years at the Guttman Breast Diagnostic Institute, a breast cancer screening centre in New York City") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002192> "A prospective cohort of healthy women aged 34–65 years enrolled by New York University between 1985 and 1991 at the Guttman Breast Diagnostic Institute, a breast cancer screening centre in New York City, who gave blood at enrolment and at later annual screening visits and have been followed to study hormones, diet, environmental factors and the risk of cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710223") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15226762") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14710223") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2395327/fullTextXML") Annotation(rdfs:comment "Breast cancer cases were identified through active follow-up of the cohort by mailed questionnaires approximately every 2–4 years and telephone interviews for nonrespondents, as well as record linkage with state cancer registries in New York, New Jersey, and with the US National Death Index.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002192> "A prospective cohort of healthy women aged 34–65 years enrolled by New York University between 1985 and 1991 at the Guttman Breast Diagnostic Institute, a breast cancer screening centre in New York City, who gave blood at enrolment and at later annual screening visits and have been followed to study hormones, diet, environmental factors and the risk of cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710223") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15226762") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14710223") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2395327/fullTextXML") Annotation(rdfs:comment "Nonfasting peripheral venous blood (30 ml) was drawn prior to breast examination.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002192> "A prospective cohort of healthy women aged 34–65 years enrolled by New York University between 1985 and 1991 at the Guttman Breast Diagnostic Institute, a breast cancer screening centre in New York City, who gave blood at enrolment and at later annual screening visits and have been followed to study hormones, diet, environmental factors and the risk of cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710223") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15226762") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14710223") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2395327/fullTextXML") Annotation(rdfs:comment "Up to 1991, women who returned for annual breast cancer screening were invited to contribute additional blood donations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002192> "A prospective cohort of healthy women aged 34–65 years enrolled by New York University between 1985 and 1991 at the Guttman Breast Diagnostic Institute, a breast cancer screening centre in New York City, who gave blood at enrolment and at later annual screening visits and have been followed to study hormones, diet, environmental factors and the risk of cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710223") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15226762") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15226762") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2364735/fullTextXML") Annotation(rdfs:comment "Dietary data were collected using a semiquantitative food frequency questionnaire based on the Block questionnaire used in NHANES II (Block et al, 1986, 1990).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002192> "A prospective cohort of healthy women aged 34–65 years enrolled by New York University between 1985 and 1991 at the Guttman Breast Diagnostic Institute, a breast cancer screening centre in New York City, who gave blood at enrolment and at later annual screening visits and have been followed to study hormones, diet, environmental factors and the risk of cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14710223") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15226762") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15226762") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2364735/fullTextXML") Annotation(rdfs:comment "The association between circulating levels of the main lignan enterolactone and breast cancer risk was assessed in a case–control study nested within the New York University (NYU) Women's Health Study, a prospective cohort study of cancer, hormones, and environmental factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002192> "A prospective cohort of healthy women aged 34–65 years enrolled by New York University between 1985 and 1991 at the Guttman Breast Diagnostic Institute, a breast cancer screening centre in New York City, who gave blood at enrolment and at later annual screening visits and have been followed to study hormones, diet, environmental factors and the risk of cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002193> (<http://www.ebi.ac.uk/coho/COHO_0002193>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18239157") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198610") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18239157") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2775049/") Annotation(rdfs:comment "Additional cohorts with coronary artery disease (CAD) and peripheral arterial disease (PAD)15 from the same geographical region of the New Zealand as the AAA controls groups were examined to determine the specificity of any associations with vascular disease phenotype.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002193> "A case-control sample of patients with angiographically proven coronary artery disease (stenosis of at least 50% of the vessel diameter in at least one coronary artery) from the Otago-Southland region of New Zealand, with age-matched controls from the same region who had no history of ischaemic heart disease, assembled alongside abdominal aortic aneurysm and peripheral arterial disease series from the same region; it served as a replication sample in genetic studies of coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18239157") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198610") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18239157") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2775049/") Annotation(rdfs:comment "Patients were recruited from the Otago-Southland region of the country, the vast majority (>97%) being of Anglo-European ancestry as reported previously.6, 15 The control group consisted of elderly individuals without vascular disease (AAA excluded by abdominal ultrasound) from the same geographical region.15") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002193> "A case-control sample of patients with angiographically proven coronary artery disease (stenosis of at least 50% of the vessel diameter in at least one coronary artery) from the Otago-Southland region of New Zealand, with age-matched controls from the same region who had no history of ischaemic heart disease, assembled alongside abdominal aortic aneurysm and peripheral arterial disease series from the same region; it served as a replication sample in genetic studies of coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18239157") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198610") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198610") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.323/MediaObjects/41588_2009_BFng323_MOESM13_ESM.pdf") Annotation(rdfs:comment "New Zealand CAD patients all had angiographically proven coronary artery stenosis ≥50% of the vessel internal diameter in at least 1 vessel.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002193> "A case-control sample of patients with angiographically proven coronary artery disease (stenosis of at least 50% of the vessel diameter in at least one coronary artery) from the Otago-Southland region of New Zealand, with age-matched controls from the same region who had no history of ischaemic heart disease, assembled alongside abdominal aortic aneurysm and peripheral arterial disease series from the same region; it served as a replication sample in genetic studies of coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18239157") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198610") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19198610") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.323/MediaObjects/41588_2009_BFng323_MOESM13_ESM.pdf") Annotation(rdfs:comment "The New Zealand age matched controls had no history of ischemic heart disease, including angina pectoris (S18).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002193> "A case-control sample of patients with angiographically proven coronary artery disease (stenosis of at least 50% of the vessel diameter in at least one coronary artery) from the Otago-Southland region of New Zealand, with age-matched controls from the same region who had no history of ischaemic heart disease, assembled alongside abdominal aortic aneurysm and peripheral arterial disease series from the same region; it served as a replication sample in genetic studies of coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18239157") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198610") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21378990") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.784/MediaObjects/41588_2011_BFng784_MOESM10_ESM.pdf") Annotation(rdfs:comment "The New Zealand CAD Study Centaurus (Nanogen)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002193> "A case-control sample of patients with angiographically proven coronary artery disease (stenosis of at least 50% of the vessel diameter in at least one coronary artery) from the Otago-Southland region of New Zealand, with age-matched controls from the same region who had no history of ischaemic heart disease, assembled alongside abdominal aortic aneurysm and peripheral arterial disease series from the same region; it served as a replication sample in genetic studies of coronary artery disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002194> (<http://www.ebi.ac.uk/coho/COHO_0002194>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33693242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40611481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33693242") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7925312/fullTextXML") Annotation(rdfs:comment "A total of 11,072 patients with AMI were registered in the OACIS registry between April 1998 and September 2012.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002194> "A prospective, multicentre observational registry of patients with acute myocardial infarction at 25 collaborating hospitals in the Osaka region of Japan, coordinated from Osaka University Graduate School of Medicine, which since 1998 has recorded demographic, procedural and outcome data and collected blood samples from consecutively enrolled patients to study the treatment and prognosis of acute myocardial infarction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33693242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40611481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33693242") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7925312/fullTextXML") Annotation(rdfs:comment "After written informed consent for enrollment in OACIS was obtained, all in-hospital data were transmitted to the data collection center (Department of Internal Medicine and Therapeutics, Osaka University Graduate School of Medicine) for processing and analysis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002194> "A prospective, multicentre observational registry of patients with acute myocardial infarction at 25 collaborating hospitals in the Osaka region of Japan, coordinated from Osaka University Graduate School of Medicine, which since 1998 has recorded demographic, procedural and outcome data and collected blood samples from consecutively enrolled patients to study the treatment and prognosis of acute myocardial infarction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33693242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40611481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33693242") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7925312/fullTextXML") Annotation(rdfs:comment "Collaborating hospitals were encouraged to enroll consecutive patients with AMI irrespective of treatment strategy or outcome.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002194> "A prospective, multicentre observational registry of patients with acute myocardial infarction at 25 collaborating hospitals in the Osaka region of Japan, coordinated from Osaka University Graduate School of Medicine, which since 1998 has recorded demographic, procedural and outcome data and collected blood samples from consecutively enrolled patients to study the treatment and prognosis of acute myocardial infarction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33693242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40611481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33693242") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7925312/fullTextXML") Annotation(rdfs:comment "Here, we investigated whether hydrophilic statin use is associated with lower risk for long-term outcomes in diabetic patients with AMI.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002194> "A prospective, multicentre observational registry of patients with acute myocardial infarction at 25 collaborating hospitals in the Osaka region of Japan, coordinated from Osaka University Graduate School of Medicine, which since 1998 has recorded demographic, procedural and outcome data and collected blood samples from consecutively enrolled patients to study the treatment and prognosis of acute myocardial infarction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33693242") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40611481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33693242") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7925312/fullTextXML") Annotation(rdfs:comment "The Osaka Acute Coronary Insufficiency Study (OACIS) is a prospective, multicenter, observational study in which 25 collaborating hospitals in the Osaka region of Japan record demographic, procedural, and outcome data and collect blood samples from patients with AMI.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002194> "A prospective, multicentre observational registry of patients with acute myocardial infarction at 25 collaborating hospitals in the Osaka region of Japan, coordinated from Osaka University Graduate School of Medicine, which since 1998 has recorded demographic, procedural and outcome data and collected blood samples from consecutively enrolled patients to study the treatment and prognosis of acute myocardial infarction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002195> (<http://www.ebi.ac.uk/coho/COHO_0002195>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27542569") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702895") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30177847") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27542569") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5095781/fullTextXML") Annotation(rdfs:comment "The unselected breast cancer patient samples from Northern Finland were collected at the Oulu University Hospital between the years 2000 and 2007.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002195> "A hospital-based breast cancer case-control study of the University of Oulu and Oulu University Hospital, Finland, whose cases are breast cancer patients from Northern Finland, unselected for age and family history, collected at Oulu University Hospital from 2000 onwards, and whose controls are healthy female blood donors of the Finnish Red Cross from the Oulu area; it studies inherited susceptibility to breast cancer and contributes to the Breast Cancer Association Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27542569") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702895") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30177847") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28702895") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5645429/fullTextXML") Annotation(rdfs:comment "The FANCM c.5791C>T and c.5101C>T mutations were screened among 1323 breast cancer cases (1147 unselected, 153 familial, and 56 young breast cancer patients) and 510 healthy female controls from the Oulu area.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002195> "A hospital-based breast cancer case-control study of the University of Oulu and Oulu University Hospital, Finland, whose cases are breast cancer patients from Northern Finland, unselected for age and family history, collected at Oulu University Hospital from 2000 onwards, and whose controls are healthy female blood donors of the Finnish Red Cross from the Oulu area; it studies inherited susceptibility to breast cancer and contributes to the Breast Cancer Association Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27542569") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28702895") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30177847") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28702895") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5645429/fullTextXML") Annotation(rdfs:comment "The unselected breast cancer samples were collected from patients operated at the Oulu University Hospital during 2000–2014, and they were unselected for age at disease onset and a family history of cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002195> "A hospital-based breast cancer case-control study of the University of Oulu and Oulu University Hospital, Finland, whose cases are breast cancer patients from Northern Finland, unselected for age and family history, collected at Oulu University Hospital from 2000 onwards, and whose controls are healthy female blood donors of the Finnish Red Cross from the Oulu area; it studies inherited susceptibility to breast cancer and contributes to the Breast Cancer Association Consortium.")
