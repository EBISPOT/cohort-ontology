AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12184346/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30271950") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6123807/") Annotation(rdfs:comment "The Tromsø Study is a population-based prospective study with repeated health surveys in the municipality of Tromsø, Norway") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000852> "A population-based study of residents of the municipality of Tromsø, Norway, run by UiT The Arctic University of Norway, begun in 1974 and repeated in seven surveys (Tromsø1–Tromsø7) that together enrolled 45,473 people, as a multipurpose health survey of chronic diseases and their risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12184346/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35509230") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9578102/fullTextXML") Annotation(rdfs:comment "Currently, the Tromsø Study is a multipurpose health survey including both chronic and communicable diseases and risk factors, with a wide range of possible epidemiological and clinical research designs including registry linkage.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000852> "A population-based study of residents of the municipality of Tromsø, Norway, run by UiT The Arctic University of Norway, begun in 1974 and repeated in seven surveys (Tromsø1–Tromsø7) that together enrolled 45,473 people, as a multipurpose health survey of chronic diseases and their risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12184346/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35509230") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9578102/fullTextXML") Annotation(rdfs:comment "The Tromsø Study [1] is an ongoing population-based health study anchored at UiT The Arctic University of Norway (UiT).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000852> "A population-based study of residents of the municipality of Tromsø, Norway, run by UiT The Arctic University of Norway, begun in 1974 and repeated in seven surveys (Tromsø1–Tromsø7) that together enrolled 45,473 people, as a multipurpose health survey of chronic diseases and their risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12184346/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40545308") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12184346/fullTextXML") Annotation(rdfs:comment "All residents of Tromsø municipality aged 40 years or older were invited to Tromsø7, and 21 083 (65%) participated.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000852> "A population-based study of residents of the municipality of Tromsø, Norway, run by UiT The Arctic University of Norway, begun in 1974 and repeated in seven surveys (Tromsø1–Tromsø7) that together enrolled 45,473 people, as a multipurpose health survey of chronic diseases and their risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12184346/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40545308") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12184346/fullTextXML") Annotation(rdfs:comment "The Tromsø Study is a population-based study conducted in 1974 in the municipality of Tromsø, Norway.17 It consists of seven waves, known as Tromsø1 through Tromsø7, and a total of 45 473 people attended one or more surveys.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000852> "A population-based study of residents of the municipality of Tromsø, Norway, run by UiT The Arctic University of Norway, begun in 1974 and repeated in seven surveys (Tromsø1–Tromsø7) that together enrolled 45,473 people, as a multipurpose health survey of chronic diseases and their risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12184346/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3598/MediaObjects/41588_2016_BFng3598_MOESM73_ESM.pdf") Annotation(rdfs:comment "The Tromsø Study is a population based health study of the Tromsø municipality of Northern Norway.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000852> "A population-based study of residents of the municipality of Tromsø, Norway, run by UiT The Arctic University of Norway, begun in 1974 and repeated in seven surveys (Tromsø1–Tromsø7) that together enrolled 45,473 people, as a multipurpose health survey of chronic diseases and their risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000853> (<http://www.ebi.ac.uk/coho/COHO_0000853>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23284679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23284679") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526593/fullTextXML") Annotation(rdfs:comment "Cases (n = 497) and controls (n = 957) in the Texas Bladder Cancer Study (TXBCS) who had been genotyped using a Genome-Wide Association panel were derived from an ongoing hospital-based bladder cancer case-control study [21].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000853> "A hospital-based case-control study of bladder cancer in Texas, United States, with newly diagnosed, previously untreated cases recruited at the University of Texas MD Anderson Cancer Center and Baylor College of Medicine and matched controls, used for genome-wide and pathway studies of bladder cancer susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23284679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23284679") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526593/fullTextXML") Annotation(rdfs:comment "Cases were newly diagnosed, histologically confirmed and previously untreated incident bladder cases recruited from the University of Texas MD Anderson Cancer Center and Baylor College of Medicine.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000853> "A hospital-based case-control study of bladder cancer in Texas, United States, with newly diagnosed, previously untreated cases recruited at the University of Texas MD Anderson Cancer Center and Baylor College of Medicine and matched controls, used for genome-wide and pathway studies of bladder cancer susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23284679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23284679") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526593/fullTextXML") Annotation(rdfs:comment "Controls were individuals with no prior history of cancer (except non-melanoma skin cancer) frequency-matched to cases by age (±5 years), sex and ethnicity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000853> "A hospital-based case-control study of bladder cancer in Texas, United States, with newly diagnosed, previously untreated cases recruited at the University of Texas MD Anderson Cancer Center and Baylor College of Medicine and matched controls, used for genome-wide and pathway studies of bladder cancer susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23284679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23284679") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3526593/fullTextXML") Annotation(rdfs:comment "This finding was successfully replicated in the Texas Bladder Cancer Study with 957 controls, 497 cases (adjusted OR 3.66 95%CI 1.06–12.63).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000853> "A hospital-based case-control study of bladder cancer in Texas, United States, with newly diagnosed, previously untreated cases recruited at the University of Texas MD Anderson Cancer Center and Baylor College of Medicine and matched controls, used for genome-wide and pathway studies of bladder cancer susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23284679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3919005") Annotation(rdfs:comment "To identify new bladder cancer susceptibility loci, a meta-analysis was performed using the NCI-GWAS2 dataset with two previously published bladder cancer GWAS: NCI-GWAS1 (6,9), and TXBCS-GWAS (10) (Figure 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000853> "A hospital-based case-control study of bladder cancer in Texas, United States, with newly diagnosed, previously untreated cases recruited at the University of Texas MD Anderson Cancer Center and Baylor College of Medicine and matched controls, used for genome-wide and pathway studies of bladder cancer susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23284679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.687/MediaObjects/41588_2010_BFng687_MOESM14_ESM.pdf") Annotation(rdfs:comment "Texas GWAS - (Texas Bladder Cancer Study 1 (TXBCS 1)) 969 957 Hospital based, case control, US (TX) Incident bladder cancer cases recruited from The University of Texas MD Anderson Cancer Center and Baylor College of Medicine between 1999 and 2007") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000853> "A hospital-based case-control study of bladder cancer in Texas, United States, with newly diagnosed, previously untreated cases recruited at the University of Texas MD Anderson Cancer Center and Baylor College of Medicine and matched controls, used for genome-wide and pathway studies of bladder cancer susceptibility.")

