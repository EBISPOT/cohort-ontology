AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10593802") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12759479") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19300482") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32649918") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19300482") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2650282/fullTextXML") Annotation(rdfs:comment "Subjects in NETT had severe COPD (FEV1 ≤45% predicted) and bilateral emphysema on chest CT; all NETT subjects were former smokers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002137> "A multicentre randomised clinical trial in the United States that compared medical therapy, including pulmonary rehabilitation, with medical therapy plus lung-volume-reduction surgery in former smokers with severe bilateral emphysema and severe airflow obstruction, with survival as its primary outcome.")
