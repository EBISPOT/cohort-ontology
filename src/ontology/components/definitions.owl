AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35927272") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35927272") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9158790/fullTextXML") Annotation(rdfs:comment "After recruitment, the participants were re-contacted for follow-up every 5 to 6 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000659> "A population-based prospective cohort of 63,257 Chinese adults aged 45–74 years from the Hokkien and Cantonese dialect groups living in Singapore, recruited from April 1993 to December 1998 and followed with repeated interviews, to study diet, lifestyle, genetic factors and chronic disease and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35927272") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35927272") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9158790/fullTextXML") Annotation(rdfs:comment "In brief, 63,257 subjects aged between 45 and 74 years were recruited from April 1993 to December 1998.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000659> "A population-based prospective cohort of 63,257 Chinese adults aged 45–74 years from the Hokkien and Cantonese dialect groups living in Singapore, recruited from April 1993 to December 1998 and followed with repeated interviews, to study diet, lifestyle, genetic factors and chronic disease and ageing.")
