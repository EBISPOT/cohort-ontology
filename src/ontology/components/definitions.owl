AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41908051") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8581794") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8793366") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9103091") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9103091") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9103091+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "After researchers were given central training in survey methods, population-based samples of 800 to 2500 adults over the age of 25 were examined in seven sites, yielding a total sample of 10014.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001902> "A population-based survey of blood pressure, hypertension and associated risk factors such as obesity among adults of West African origin living in societies at different stages of social and economic development, which examined age-stratified samples at seven sites in Nigeria, Cameroon, Jamaica, St. Lucia, Barbados and metropolitan Chicago in the United States under a standardized protocol with centrally trained field staff; its Nigerian base sample, recruited in Ibadan and Igbo-Ora in Oyo State, later provided the sampling frame for genotyped cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41908051") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8581794") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8793366") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9103091") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9103091") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9103091+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The rates of hypertension in West Africa (Nigeria and Cameroon), the Caribbean (Jamaica, St. Lucia, Barbados), and the United States (metropolitan Chicago, Illinois) were compared on the basis of a highly standardized collaborative protocol.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001902> "A population-based survey of blood pressure, hypertension and associated risk factors such as obesity among adults of West African origin living in societies at different stages of social and economic development, which examined age-stratified samples at seven sites in Nigeria, Cameroon, Jamaica, St. Lucia, Barbados and metropolitan Chicago in the United States under a standardized protocol with centrally trained field staff; its Nigerian base sample, recruited in Ibadan and Igbo-Ora in Oyo State, later provided the sampling frame for genotyped cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41908051") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8581794") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8793366") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9103091") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9103091") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9103091+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This study was undertaken to describe the distribution of blood pressures, hypertension prevalence, and associated risk factors among seven populations of West African origin.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001902> "A population-based survey of blood pressure, hypertension and associated risk factors such as obesity among adults of West African origin living in societies at different stages of social and economic development, which examined age-stratified samples at seven sites in Nigeria, Cameroon, Jamaica, St. Lucia, Barbados and metropolitan Chicago in the United States under a standardized protocol with centrally trained field staff; its Nigerian base sample, recruited in Ibadan and Igbo-Ora in Oyo State, later provided the sampling frame for genotyped cohorts.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001903> (<http://www.ebi.ac.uk/coho/COHO_0001903>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26039689") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30472421") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26039689") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4454638/") Annotation(rdfs:comment "The inclusion criteria were detectable viremia with a negative HIV serology result or documented seroconversion within the 6 months prior to the first evaluation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001903> "A prospective single-centre cohort that has enrolled, since 1997, all patients with acute or recent HIV-1 infection (within 180 days of infection) evaluated at the Hospital Clínic in Barcelona, Spain, identified by detectable viraemia with a negative HIV serology or by documented seroconversion within the previous six months.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26039689") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30472421") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26039689") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4454638/") Annotation(rdfs:comment "The study population comprised patients from the “Hospital Clinic Primary HIV-1 Infection Cohort” consecutively evaluated within 180 days after HIV infection at the Hospital Clínic, Barcelona, Spain, between January 1, 1997 and December 31, 2012.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001903> "A prospective single-centre cohort that has enrolled, since 1997, all patients with acute or recent HIV-1 infection (within 180 days of infection) evaluated at the Hospital Clínic in Barcelona, Spain, identified by detectable viraemia with a negative HIV serology or by documented seroconversion within the previous six months.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26039689") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30472421") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30472421") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30472421+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Prospective, single-centre cohort including all patients with an acute/recent HIV infection") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001903> "A prospective single-centre cohort that has enrolled, since 1997, all patients with acute or recent HIV-1 infection (within 180 days of infection) evaluated at the Hospital Clínic in Barcelona, Spain, identified by detectable viraemia with a negative HIV serology or by documented seroconversion within the previous six months.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001906> (<http://www.ebi.ac.uk/coho/COHO_0001906>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40437996") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40799781") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40437996") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC12280848/") Annotation(rdfs:comment "After enrolment, at least 2 study visits are being conducted every year to collect sociodemographic, clinical, and laboratory data using medical records through a standardized protocol") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001906> "A nationwide, multicentre, observational prospective cohort of people with HIV in Italy, set up in 1997, that enrols adults who are naive to antiretroviral therapy at enrolment through Italian infectious diseases centres and follows them over time; it is run under the ICONA Foundation Study protocol.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40437996") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40799781") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40437996") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC12280848/") Annotation(rdfs:comment "The Italian Cohort Naïve Antiretrovirals (ICONA) is an ongoing national HIV cohort set up in 1997 in Italy, enrolling antiretroviral (ART) naïve persons with HIV (PWH) from 57 infectious diseases centers whose Institutional Review Boards approved the ICONA Foundation Study protocol.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001906> "A nationwide, multicentre, observational prospective cohort of people with HIV in Italy, set up in 1997, that enrols adults who are naive to antiretroviral therapy at enrolment through Italian infectious diseases centres and follows them over time; it is run under the ICONA Foundation Study protocol.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40437996") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40799781") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40799781") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC12343120/") Annotation(rdfs:comment "Icona is a nationwide multicenter observational prospective cohort, established in 1997, including adult PWH who are ART-naïve at the time of enrollment in 91 Italian infectious diseases Centers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001906> "A nationwide, multicentre, observational prospective cohort of people with HIV in Italy, set up in 1997, that enrols adults who are naive to antiretroviral therapy at enrolment through Italian infectious diseases centres and follows them over time; it is run under the ICONA Foundation Study protocol.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001910> (<http://www.ebi.ac.uk/coho/COHO_0001910>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31084447") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31659322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31818913") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31084447") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31084447+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "this study used data from the Intern Health Study, which follows students from the end of medical school through the first year of residency, recording depression via the 9-item Patient Health Questionnaire (PHQ-9), anxiety via the 7-item Generalized Anxiety Disorder Questionnaire (GAD-7), and multiple risk factors for these symptoms.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001910> "A multi-institutional prospective cohort study of stress and depression in physicians in the United States, which invites incoming interns each year before they start the first year of residency training (from 2007) and follows them from the end of medical school through internship, recording depressive and anxiety symptoms and their risk factors by repeated questionnaires and a daily mood smartphone app, with DNA collected by mail for genetic studies of depression under stress.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31084447") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31659322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31818913") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31659322") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6980948/") Annotation(rdfs:comment "Interns entering residency programs across specialties in the academic years from 2007 to 2017 were sent an email 2–3 months prior to commencing internship and invited to participate in the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001910> "A multi-institutional prospective cohort study of stress and depression in physicians in the United States, which invites incoming interns each year before they start the first year of residency training (from 2007) and follows them from the end of medical school through internship, recording depressive and anxiety symptoms and their risk factors by repeated questionnaires and a daily mood smartphone app, with DNA collected by mail for genetic studies of depression under stress.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31084447") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31659322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31818913") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31659322") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6980948/") Annotation(rdfs:comment "The Intern Health Study is a multi-institutional prospective cohort study that follows training physicians through the first year of residency training (internship).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001910> "A multi-institutional prospective cohort study of stress and depression in physicians in the United States, which invites incoming interns each year before they start the first year of residency training (from 2007) and follows them from the end of medical school through internship, recording depressive and anxiety symptoms and their risk factors by repeated questionnaires and a daily mood smartphone app, with DNA collected by mail for genetic studies of depression under stress.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31084447") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31659322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31818913") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31659322") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6980948/") Annotation(rdfs:comment "We collected DNA from subjects using DNA Genotek Oragene Mailable Tube (OGR-500)33 through the mail.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001910> "A multi-institutional prospective cohort study of stress and depression in physicians in the United States, which invites incoming interns each year before they start the first year of residency training (from 2007) and follows them from the end of medical school through internship, recording depressive and anxiety symptoms and their risk factors by repeated questionnaires and a daily mood smartphone app, with DNA collected by mail for genetic studies of depression under stress.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31084447") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31659322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31818913") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31818913") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7190044/") Annotation(rdfs:comment "The Intern Health Study is a prospective cohort study assessing stress and depression during the first year of residency training in the US.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001910> "A multi-institutional prospective cohort study of stress and depression in physicians in the United States, which invites incoming interns each year before they start the first year of residency training (from 2007) and follows them from the end of medical school through internship, recording depressive and anxiety symptoms and their risk factors by repeated questionnaires and a daily mood smartphone app, with DNA collected by mail for genetic studies of depression under stress.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31084447") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31659322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31818913") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31818913") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC7190044/") Annotation(rdfs:comment "Throughout the intern year, subjects responded daily to the following validated one-question measure of mood valence via the Intern Health iPhone app: “On a scale of 1-10 how was your mood today?”") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001910> "A multi-institutional prospective cohort study of stress and depression in physicians in the United States, which invites incoming interns each year before they start the first year of residency training (from 2007) and follows them from the end of medical school through internship, recording depressive and anxiety symptoms and their risk factors by repeated questionnaires and a daily mood smartphone app, with DNA collected by mail for genetic studies of depression under stress.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001911> (<http://www.ebi.ac.uk/coho/COHO_0001911>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20686651") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22992468") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26316205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20686651") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2912386/") Annotation(rdfs:comment "The Icelandic kidney stone cases consisted of patients with confirmed radiopaque kidney stones from the Icelandic Kidney Stone Disease Registry at LUH.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001911> "A registry of patients with kidney stone disease in Iceland, kept at Landspitali – The National University Hospital of Iceland in Reykjavik and established in 2008 in conjunction with a nationwide study of kidney stone disease that searched the computerised records of all major hospitals and medical imaging centres in Iceland for codes indicating kidney stones; its patients with confirmed radiopaque stones who had given blood to the genetic research programmes of deCODE genetics were the Icelandic cases of deCODE's genetic association studies of kidney stones.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20686651") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22992468") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26316205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20686651") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2912386/") Annotation(rdfs:comment "The study included kidney stone patients that had donated blood through various genetic programs at deCODE genetics.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001911> "A registry of patients with kidney stone disease in Iceland, kept at Landspitali – The National University Hospital of Iceland in Reykjavik and established in 2008 in conjunction with a nationwide study of kidney stone disease that searched the computerised records of all major hospitals and medical imaging centres in Iceland for codes indicating kidney stones; its patients with confirmed radiopaque stones who had given blood to the genetic research programmes of deCODE genetics were the Icelandic cases of deCODE's genetic association studies of kidney stones.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20686651") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22992468") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26316205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22992468") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22992468+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Computerized databases of all major hospitals and medical imaging centers in Iceland were searched for International Classification of Diseases, radiologic and surgical procedure codes indicative of kidney stones in patients aged 18 years and older.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001911> "A registry of patients with kidney stone disease in Iceland, kept at Landspitali – The National University Hospital of Iceland in Reykjavik and established in 2008 in conjunction with a nationwide study of kidney stone disease that searched the computerised records of all major hospitals and medical imaging centres in Iceland for codes indicating kidney stones; its patients with confirmed radiopaque stones who had given blood to the genetic research programmes of deCODE genetics were the Icelandic cases of deCODE's genetic association studies of kidney stones.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20686651") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22992468") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26316205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26316205") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4551564/") Annotation(rdfs:comment "the Icelandic Kidney Stone Registry (IKSR) which was established in 2008 in conjunction with a nationwide study on kidney stone disease [2].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001911> "A registry of patients with kidney stone disease in Iceland, kept at Landspitali – The National University Hospital of Iceland in Reykjavik and established in 2008 in conjunction with a nationwide study of kidney stone disease that searched the computerised records of all major hospitals and medical imaging centres in Iceland for codes indicating kidney stones; its patients with confirmed radiopaque stones who had given blood to the genetic research programmes of deCODE genetics were the Icelandic cases of deCODE's genetic association studies of kidney stones.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20686651") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22992468") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26316205") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26316205") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4551564/") Annotation(rdfs:comment "the Kidney Stone Prevention Clinic at Landspitali – The National University Hospital of Iceland (LUH) in Reykjavik") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001911> "A registry of patients with kidney stone disease in Iceland, kept at Landspitali – The National University Hospital of Iceland in Reykjavik and established in 2008 in conjunction with a nationwide study of kidney stone disease that searched the computerised records of all major hospitals and medical imaging centres in Iceland for codes indicating kidney stones; its patients with confirmed radiopaque stones who had given blood to the genetic research programmes of deCODE genetics were the Icelandic cases of deCODE's genetic association studies of kidney stones.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001914> (<http://www.ebi.ac.uk/coho/COHO_0001914>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19952003") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28602434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19952003") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19952003+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "IMPROVE is a prospective, multicentre, longitudinal, observational study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001914> "A multicentre prospective cohort study of European adults aged 54 to 79 years with at least three vascular risk factors but no previous cardiovascular or cerebrovascular events, enrolled at seven centres in Finland, France, Italy, the Netherlands and Sweden and followed for vascular events by visits at 15 and 30 months and a final telephone interview, to assess carotid intima-media thickness and its progression as predictors of vascular events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19952003") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28602434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19952003") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19952003+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The 'IMPROVE study' was designed to investigate whether cross-sectional carotid artery intima-media thickness (IMT) and overall IMT progression are predictors of new vascular events in European individuals at high risk of cardiovascular diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001914> "A multicentre prospective cohort study of European adults aged 54 to 79 years with at least three vascular risk factors but no previous cardiovascular or cerebrovascular events, enrolled at seven centres in Finland, France, Italy, the Netherlands and Sweden and followed for vascular events by visits at 15 and 30 months and a final telephone interview, to assess carotid intima-media thickness and its progression as predictors of vascular events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19952003") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28602434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28602434") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5567407/fullTextXML") Annotation(rdfs:comment "Briefly, a total of 3711 individuals (age 54–79 years) were recruited, with at least three VRFs but free of any cardio- or cerebro-VEs prior to enrolment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001914> "A multicentre prospective cohort study of European adults aged 54 to 79 years with at least three vascular risk factors but no previous cardiovascular or cerebrovascular events, enrolled at seven centres in Finland, France, Italy, the Netherlands and Sweden and followed for vascular events by visits at 15 and 30 months and a final telephone interview, to assess carotid intima-media thickness and its progression as predictors of vascular events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19952003") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28602434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28602434") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5567407/fullTextXML") Annotation(rdfs:comment "The occurrence of VEs (myocardial infarction (MI), sudden cardiac death, angina pectoris, ischemic stroke, transient ischemic attack, new diagnosis of intermittent claudication, or any surgical intervention or revascularization of coronary or peripheral arteries) was assessed at months 15 and 30 by regular visits, and at the end of follow-up (36 months in average) by phone interview.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001914> "A multicentre prospective cohort study of European adults aged 54 to 79 years with at least three vascular risk factors but no previous cardiovascular or cerebrovascular events, enrolled at seven centres in Finland, France, Italy, the Netherlands and Sweden and followed for vascular events by visits at 15 and 30 months and a final telephone interview, to assess carotid intima-media thickness and its progression as predictors of vascular events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19952003") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28602434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28602434") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5567407/fullTextXML") Annotation(rdfs:comment "The participants were enrolled at 7 centers in 5 European countries: Finland (Kuopio, 2 centers), France (Paris), Italy (Milan and Perugia), The Netherlands (Groningen) and Sweden (Stockholm).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001914> "A multicentre prospective cohort study of European adults aged 54 to 79 years with at least three vascular risk factors but no previous cardiovascular or cerebrovascular events, enrolled at seven centres in Finland, France, Italy, the Netherlands and Sweden and followed for vascular events by visits at 15 and 30 months and a final telephone interview, to assess carotid intima-media thickness and its progression as predictors of vascular events.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001915> (<http://www.ebi.ac.uk/coho/COHO_0001915>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19525953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21654844") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19525953") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2757648/") Annotation(rdfs:comment "Wellcome Trust Case Control Consortium–healthy control subjects.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001915> "A UK case-control sample of the International Multiple Sclerosis Genetics Consortium, comprising patients with multiple sclerosis (McDonald criteria) of European descent recruited in the United Kingdom and healthy control subjects from the Wellcome Trust Case Control Consortium, genotyped on the Affymetrix 500K platform and used as one stratum of the consortium's genome-wide association meta-analyses.")
