AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35813487") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6059034/") Annotation(rdfs:comment "The Drug Interaction With Genes in Parkinson's Disease (DIGPD) study is an ongoing longitudinal cohort study of patients with PD consecutively recruited from May 2009 to July 2013 in 4 French university hospitals and 4 general hospitals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000677> "A French multicentre longitudinal cohort of patients with early Parkinson's disease (disease duration of five years or less at recruitment) recruited from clinics in France and followed annually with clinical assessments and genotyping, supported by Assistance Publique Hôpitaux de Paris and registered as NCT01564992.")
