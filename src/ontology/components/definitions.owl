AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20504332") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24836286") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32139696") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3041/MediaObjects/41588_2014_BFng3041_MOESM76_ESM.pdf") Annotation(rdfs:comment "Participants of the HCES-Br consisted of 3,387 female breast cancer cases, who were newly diagnosed between April 2004 and February 2013 at Chonnam National University Hwasun Hospital, a cancer specified hospital in Jeollanam-do province, South Korea.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002709> "A hospital-based case-control study of multiple cancers in South Korea, with disease-specific series including breast and colorectal cancer at Chonnam National University Hwasun Hospital in Jeollanam-do province. It recruits newly diagnosed cancer patients and community controls to investigate factors in cancer development and clinical progression; its disease-specific series use interview and medical-record information and blood samples.")
