AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40153111") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27023175") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Ftp.2016.36/MediaObjects/41398_2016_BFtp201636_MOESM267_ESM.doc") Annotation(rdfs:comment "The RADAR study (Research on Adolescent Development and Relationships) is longitudinal research project in the Netherlands and focuses on the development of interpersonal relationships, personality, and psychopathology, in a sample of adolescents and their families that were followed from approximately ages 13 to 19.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000147> "A project combining the RADAR-Young and RADAR-Old adolescent cohorts in the Netherlands, followed through repeated questionnaires to investigate development and relationships with parents, friends and romantic partners.")
