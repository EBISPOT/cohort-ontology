AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15642484") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15642484") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15642484+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In the family-based study, probands with diabetic nephropathy are recruited with their parents and selected siblings.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000729> "A multicentre family-based and case-control study of European American, African American, Mexican American and American Indian people with diabetes, with and without diabetic nephropathy, and their relatives, recruited at eight US clinical centres to identify genetic determinants of diabetic nephropathy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15642484") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15642484") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15642484+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "It is conducted in eight U.S. clinical centers and a coordinating center, and with four ethnic groups (European Americans, African Americans, Mexican Americans, and American Indians).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000729> "A multicentre family-based and case-control study of European American, African American, Mexican American and American Indian people with diabetes, with and without diabetic nephropathy, and their relatives, recruited at eight US clinical centres to identify genetic determinants of diabetic nephropathy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15642484") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15642484") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15642484+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "One is a case-control study of unrelated individuals of Mexican American heritage in which both cases and controls have diabetes, but only the case has nephropathy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000729> "A multicentre family-based and case-control study of European American, African American, Mexican American and American Indian people with diabetes, with and without diabetic nephropathy, and their relatives, recruited at eight US clinical centres to identify genetic determinants of diabetic nephropathy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15642484") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15642484") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15642484+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Family Investigation of Nephropathy and Diabetes (FIND) is a multicenter study designed to identify genetic determinants of diabetic nephropathy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000729> "A multicentre family-based and case-control study of European American, African American, Mexican American and American Indian people with diabetes, with and without diabetic nephropathy, and their relatives, recruited at eight US clinical centres to identify genetic determinants of diabetic nephropathy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15642484") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15642484") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15642484+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Two strategies are used to localize susceptibility genes: a family-based linkage study and a case-control study using mapping by admixture linkage disequilibrium (MALD).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000729> "A multicentre family-based and case-control study of European American, African American, Mexican American and American Indian people with diabetes, with and without diabetic nephropathy, and their relatives, recruited at eight US clinical centres to identify genetic determinants of diabetic nephropathy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000730> (<http://www.ebi.ac.uk/coho/COHO_0000730>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35255492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37198478") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://genomicc.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35255492") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9259496/fullTextXML") Annotation(rdfs:comment "Here we present results from a cohort of 7,491 critically ill patients from 224 intensive care units, compared with 48,400 control individuals, describing the discovery and validation of 23 gene loci for susceptibility to critical COVID-19 (Extended Data Fig. 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000730> "An international study, recruiting since 2015, of critically ill patients in intensive care units in the United Kingdom and other countries, with conditions such as sepsis, acute respiratory distress syndrome and influenza and, from 2020, critical COVID-19, whose genomes are compared with those of population controls to find host genetic factors and disease mechanisms underlying critical illness.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35255492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37198478") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://genomicc.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35255492") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9259496/fullTextXML") Annotation(rdfs:comment "Patients were recruited to the GenOMICC study in 224 UK intensive care units (https://genomicc.org).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000730> "An international study, recruiting since 2015, of critically ill patients in intensive care units in the United Kingdom and other countries, with conditions such as sepsis, acute respiratory distress syndrome and influenza and, from 2020, critical COVID-19, whose genomes are compared with those of population controls to find host genetic factors and disease mechanisms underlying critical illness.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35255492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37198478") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://genomicc.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35255492") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35255492+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The GenOMICC (Genetics of Mortality in Critical Care) study enables the comparison of genomes from individuals who are critically ill with those of population controls to find underlying disease mechanisms.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000730> "An international study, recruiting since 2015, of critically ill patients in intensive care units in the United Kingdom and other countries, with conditions such as sepsis, acute respiratory distress syndrome and influenza and, from 2020, critical COVID-19, whose genomes are compared with those of population controls to find host genetic factors and disease mechanisms underlying critical illness.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35255492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37198478") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://genomicc.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37198478") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10208981/fullTextXML") Annotation(rdfs:comment "In brief, patients with confirmed COVID-19 requiring continuous cardiorespiratory monitoring or organ support (a generalizable definition for critical illness) were recruited in 2020–2022.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000730> "An international study, recruiting since 2015, of critically ill patients in intensive care units in the United Kingdom and other countries, with conditions such as sepsis, acute respiratory distress syndrome and influenza and, from 2020, critical COVID-19, whose genomes are compared with those of population controls to find host genetic factors and disease mechanisms underlying critical illness.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35255492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37198478") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://genomicc.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37198478") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10208981/fullTextXML") Annotation(rdfs:comment "In this analysis we included GenOMICC, GenOMICC Brazil, GenOMICC Saudi Arabia, ISARIC4C, HGIv6 B2 phenotype with subtraction of GenOMICC data, SCOURGE hospitalized versus population and mild cases, and 23andMe broad respiratory phenotype.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000730> "An international study, recruiting since 2015, of critically ill patients in intensive care units in the United Kingdom and other countries, with conditions such as sepsis, acute respiratory distress syndrome and influenza and, from 2020, critical COVID-19, whose genomes are compared with those of population controls to find host genetic factors and disease mechanisms underlying critical illness.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35255492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37198478") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://genomicc.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://genomicc.org/") Annotation(rdfs:comment "GenOMICC is an international research study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000730> "An international study, recruiting since 2015, of critically ill patients in intensive care units in the United Kingdom and other countries, with conditions such as sepsis, acute respiratory distress syndrome and influenza and, from 2020, critical COVID-19, whose genomes are compared with those of population controls to find host genetic factors and disease mechanisms underlying critical illness.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35255492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37198478") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://genomicc.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://genomicc.org/") Annotation(rdfs:comment "Recruiting participants since 2015, we are aiming to use genetics to find new treatments for devastating problems such as sepsis, acute respiratory distress syndrome (ARDS), influenza, Group A Strep and pancreatitis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000730> "An international study, recruiting since 2015, of critically ill patients in intensive care units in the United Kingdom and other countries, with conditions such as sepsis, acute respiratory distress syndrome and influenza and, from 2020, critical COVID-19, whose genomes are compared with those of population controls to find host genetic factors and disease mechanisms underlying critical illness.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000731> (<http://www.ebi.ac.uk/coho/COHO_0000731>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35418701") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23535729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3771688/") Annotation(rdfs:comment "BCAC is funded by Cancer Research UK (C1287/A10118 and C1287/A12014) and by the European Community’s Seventh Framework Programme under grant agreement 223175 (HEALTH-F2-2009-223175) (COGS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000731> "A collaborative genotyping experiment of four cancer genetics consortia, studying breast cancer (the Breast Cancer Association Consortium), ovarian cancer, prostate cancer, and breast and ovarian cancer in BRCA1 and BRCA2 mutation carriers, funded by the EU Seventh Framework Programme, which genotyped samples from their member studies on a custom Illumina iSelect array (iCOGS) of more than 200,000 SNPs to identify cancer susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35418701") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23535729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A23535729+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The SNPs were genotyped as part of a collaborative genotyping experiment involving four consortia (Collaborative Oncological Gene-environment Study, COGS) and used a custom Illumina iSelect genotyping array, iCOGS, comprising more than 200,000 SNPs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000731> "A collaborative genotyping experiment of four cancer genetics consortia, studying breast cancer (the Breast Cancer Association Consortium), ovarian cancer, prostate cancer, and breast and ovarian cancer in BRCA1 and BRCA2 mutation carriers, funded by the EU Seventh Framework Programme, which genotyped samples from their member studies on a custom Illumina iSelect array (iCOGS) of more than 200,000 SNPs to identify cancer susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35418701") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23535729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3771688/unicode") Annotation(rdfs:comment "These arrays were used to genotype 114,255 DNA samples from 52 studies participating in BCAC (Supplementary Table 2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000731> "A collaborative genotyping experiment of four cancer genetics consortia, studying breast cancer (the Breast Cancer Association Consortium), ovarian cancer, prostate cancer, and breast and ovarian cancer in BRCA1 and BRCA2 mutation carriers, funded by the EU Seventh Framework Programme, which genotyped samples from their member studies on a custom Illumina iSelect array (iCOGS) of more than 200,000 SNPs to identify cancer susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35418701") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23535729") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3771688/unicode") Annotation(rdfs:comment "To evaluate these SNPs, we then designed a custom Illumina iSelect genotyping array (iCOGS) in collaboration with three other consortia studying, in addition to breast cancer risk, susceptibility to ovarian cancer, prostate cancer and breast and ovarian cancers in BRCA1 and BRCA2 mutation carriers (COGS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000731> "A collaborative genotyping experiment of four cancer genetics consortia, studying breast cancer (the Breast Cancer Association Consortium), ovarian cancer, prostate cancer, and breast and ovarian cancer in BRCA1 and BRCA2 mutation carriers, funded by the EU Seventh Framework Programme, which genotyped samples from their member studies on a custom Illumina iSelect array (iCOGS) of more than 200,000 SNPs to identify cancer susceptibility loci.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35418701") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://cordis.europa.eu/project/id/223175/reporting") Annotation(rdfs:comment "The COGS project was initiated with the aim of identifying genetic determinates of breast, ovarian and prostate cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000731> "A collaborative genotyping experiment of four cancer genetics consortia, studying breast cancer (the Breast Cancer Association Consortium), ovarian cancer, prostate cancer, and breast and ovarian cancer in BRCA1 and BRCA2 mutation carriers, funded by the EU Seventh Framework Programme, which genotyped samples from their member studies on a custom Illumina iSelect array (iCOGS) of more than 200,000 SNPs to identify cancer susceptibility loci.")

