AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21387312") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22915050") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26606540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21387312") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3125463/unicode") Annotation(rdfs:comment "A population-based case–control study was conducted in Connecticut between December 2004 and March 2009.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001581> "A population-based case-control study of endometrial cancer conducted in Connecticut, United States, from December 2004 to March 2009 by investigators at the Yale School of Public Health and Yale Cancer Center, which enrolled women aged 35–80 newly diagnosed with primary endometrial cancer from October 2004 through September 2008, identified at 28 Connecticut hospitals by the Yale Cancer Center Rapid Case Ascertainment Shared Resource, and controls frequency-matched on age and found by random-digit dialling, who were interviewed at home and gave biological specimens, to study risk factors for endometrial cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21387312") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22915050") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26606540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21387312") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3125463/unicode") Annotation(rdfs:comment "Connecticut residents newly diagnosed with primary endometrial cancer from October 2004 through September 2008 were identified for the study by the Yale Cancer Center Rapid Case Ascertainment (RCA) Shared Resource.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001581> "A population-based case-control study of endometrial cancer conducted in Connecticut, United States, from December 2004 to March 2009 by investigators at the Yale School of Public Health and Yale Cancer Center, which enrolled women aged 35–80 newly diagnosed with primary endometrial cancer from October 2004 through September 2008, identified at 28 Connecticut hospitals by the Yale Cancer Center Rapid Case Ascertainment Shared Resource, and controls frequency-matched on age and found by random-digit dialling, who were interviewed at home and gave biological specimens, to study risk factors for endometrial cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21387312") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22915050") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26606540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21387312") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3125463/unicode") Annotation(rdfs:comment "Control women enrolled in the study were frequency matched to cases by age group (35–51, 52–59, 60–64, 65–69, 70–74 and 75–79 years), and were identified through preletter assisted random-digit dialing (RDD) methods.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001581> "A population-based case-control study of endometrial cancer conducted in Connecticut, United States, from December 2004 to March 2009 by investigators at the Yale School of Public Health and Yale Cancer Center, which enrolled women aged 35–80 newly diagnosed with primary endometrial cancer from October 2004 through September 2008, identified at 28 Connecticut hospitals by the Yale Cancer Center Rapid Case Ascertainment Shared Resource, and controls frequency-matched on age and found by random-digit dialling, who were interviewed at home and gave biological specimens, to study risk factors for endometrial cancer.")
