AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003748") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33341984") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8048787/fullTextXML") Annotation(rdfs:comment "Between February 2016 and March 2017, donors were eligible for recruitment into COMPARE if they: were aged 18 years or older;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000237> "A cohort of 29,029 British blood donors enrolled during 2016–2017 to find the optimum technology for haemoglobin screening, some of whom consented to join the NIHR BioResource and were genotyped during the development of the UK Biobank version 2 array.")
