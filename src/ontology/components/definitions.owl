AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22590574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26207384") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29684411") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22590574") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3348874/fullTextXML") Annotation(rdfs:comment "HLA data for the healthy controls were available from the Norwegian Bone Marrow Donor Registry, and were at the same resolution level as the patients’.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002118> "The national registry of healthy volunteer bone marrow donors in Norway, held at Oslo University Hospital, whose members are HLA-typed on inclusion in the registry; random selections of registered donors, with their HLA data and samples, serve as healthy population controls in Norwegian genetic and epidemiological studies of immune-mediated disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22590574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26207384") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29684411") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22590574") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3348874/fullTextXML") Annotation(rdfs:comment "The control samples (n = 651, female: male ratio 1.9) were randomly selected among healthy Norwegian bone marrow donors recruited through the Norwegian Bone Marrow Donor Registry (http:/www.nordonor.org/).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002118> "The national registry of healthy volunteer bone marrow donors in Norway, held at Oslo University Hospital, whose members are HLA-typed on inclusion in the registry; random selections of registered donors, with their HLA data and samples, serve as healthy population controls in Norwegian genetic and epidemiological studies of immune-mediated disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22590574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26207384") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29684411") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24076415") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A24076415+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A questionnaire was distributed to patients with PSC, recruited from Oslo University Hospital Rikshospitalet in Norway through 2011, and randomly chosen individuals from the Norwegian Bone Marrow Donor Registry (control subjects).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002118> "The national registry of healthy volunteer bone marrow donors in Norway, held at Oslo University Hospital, whose members are HLA-typed on inclusion in the registry; random selections of registered donors, with their HLA data and samples, serve as healthy population controls in Norwegian genetic and epidemiological studies of immune-mediated disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22590574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26207384") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29684411") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26207384") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4514645/fullTextXML") Annotation(rdfs:comment "One hundred and seventeen individuals from the Norwegian Bone Marrow Donor registry were included, based on HLA genotypes determined upon the inclusion in the registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002118> "The national registry of healthy volunteer bone marrow donors in Norway, held at Oslo University Hospital, whose members are HLA-typed on inclusion in the registry; random selections of registered donors, with their HLA data and samples, serve as healthy population controls in Norwegian genetic and epidemiological studies of immune-mediated disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22590574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26207384") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29684411") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26207384") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4514645/fullTextXML") Annotation(rdfs:comment "The Norwegian Bone Marrow Donor Registry at Oslo University Hospital is acknowledged for generously contributing Norwegian control data, and we would in particular like to thank all study participants willing to contribute stool samples for this study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002118> "The national registry of healthy volunteer bone marrow donors in Norway, held at Oslo University Hospital, whose members are HLA-typed on inclusion in the registry; random selections of registered donors, with their HLA data and samples, serve as healthy population controls in Norwegian genetic and epidemiological studies of immune-mediated disease.")
