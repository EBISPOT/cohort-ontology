AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38381478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32381493") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7469973/fullTextXML") Annotation(rdfs:comment "The AHS is a cohort of farmers and their spouses from Iowa and North Carolina.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000740> "A prospective cohort of 57,310 licensed pesticide applicators enrolled in Iowa and North Carolina, United States, in 1993–1997, together with their spouses, who reported detailed pesticide use and agricultural practices and are followed through follow-up questionnaires and cancer registry linkages to study the health effects of agricultural exposures, including cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38381478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38381478") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10880817/fullTextXML") Annotation(rdfs:comment "A follow-up telephone interview between 1999 and 2005 was completed by 63% of the participants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000740> "A prospective cohort of 57,310 licensed pesticide applicators enrolled in Iowa and North Carolina, United States, in 1993–1997, together with their spouses, who reported detailed pesticide use and agricultural practices and are followed through follow-up questionnaires and cancer registry linkages to study the health effects of agricultural exposures, including cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38381478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38381478") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10880817/fullTextXML") Annotation(rdfs:comment "Each participant completed a self-administered questionnaire on detailed information about pesticide use, agricultural practices, demographic characteristics, and personal and family medical history.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000740> "A prospective cohort of 57,310 licensed pesticide applicators enrolled in Iowa and North Carolina, United States, in 1993–1997, together with their spouses, who reported detailed pesticide use and agricultural practices and are followed through follow-up questionnaires and cancer registry linkages to study the health effects of agricultural exposures, including cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38381478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38381478") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10880817/fullTextXML") Annotation(rdfs:comment "Incident cancers diagnosed between enrollment and end of study follow-up were identified through linkage with state cancer registries in Iowa (enrollment through 2017) and North Carolina (enrollment through 2014).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000740> "A prospective cohort of 57,310 licensed pesticide applicators enrolled in Iowa and North Carolina, United States, in 1993–1997, together with their spouses, who reported detailed pesticide use and agricultural practices and are followed through follow-up questionnaires and cancer registry linkages to study the health effects of agricultural exposures, including cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38381478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38381478") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10880817/fullTextXML") Annotation(rdfs:comment "The AHS is a prospective cohort that includes 57,310 licensed pesticide applicators enrolled in Iowa or North Carolina between 1993 and 1997.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000740> "A prospective cohort of 57,310 licensed pesticide applicators enrolled in Iowa and North Carolina, United States, in 1993–1997, together with their spouses, who reported detailed pesticide use and agricultural practices and are followed through follow-up questionnaires and cancer registry linkages to study the health effects of agricultural exposures, including cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38381478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC10591852/") Annotation(rdfs:comment "The Agricultural Health Study (AHS) is a prospective cohort study that enrolled more than 89,000 private and commercial pesticide applicators and their spouses from Iowa and North Carolina between 1993 and 1997.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000740> "A prospective cohort of 57,310 licensed pesticide applicators enrolled in Iowa and North Carolina, United States, in 1993–1997, together with their spouses, who reported detailed pesticide use and agricultural practices and are followed through follow-up questionnaires and cancer registry linkages to study the health effects of agricultural exposures, including cancer.")

