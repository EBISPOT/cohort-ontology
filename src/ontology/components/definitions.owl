AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40065106") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11893761/fullTextXML") Annotation(rdfs:comment "BALLETT is part of a nationwide initiative by the PRECISION working group of the Belgian Society of Medical Oncologists (BSMO)19.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000223> "A cohort of cancer patients enrolled in the BALLETT precision oncology study of the Belgian Society of Medical Oncology, in which broad molecular tumour profiling was performed in a standardised way by local Belgian diagnostic laboratories to show its value for patient care.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40065106") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11893761/fullTextXML") Annotation(rdfs:comment "This multi-center study enrolled 872 patients from 12 Belgian hospitals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000223> "A cohort of cancer patients enrolled in the BALLETT precision oncology study of the Belgian Society of Medical Oncology, in which broad molecular tumour profiling was performed in a standardised way by local Belgian diagnostic laboratories to show its value for patient care.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40065106") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A40065106+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Belgian Approach for Local Laboratory Extensive Tumor Testing (BALLETT) study assessed the feasibility of using comprehensive genomic profiling (CGP) in clinical decision-making for patients with advanced cancers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000223> "A cohort of cancer patients enrolled in the BALLETT precision oncology study of the Belgian Society of Medical Oncology, in which broad molecular tumour profiling was performed in a standardised way by local Belgian diagnostic laboratories to show its value for patient care.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000478") Annotation(rdfs:comment "The project, called \"BALLETT\" (Belgian Approach of Local Laboratory Extensive Tumor Testing), has a double goal: (1) show the relevance of broad molecular profiling to improve oncological patients care, (2) demonstrate that broad molecular testing can be performed in a decentralized setting by local diagnostics laboratories in a fully standardized and uniform way while complying with the highest quality standards.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000223> "A cohort of cancer patients enrolled in the BALLETT precision oncology study of the Belgian Society of Medical Oncology, in which broad molecular tumour profiling was performed in a standardised way by local Belgian diagnostic laboratories to show its value for patient care.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000224> (<http://www.ebi.ac.uk/coho/COHO_0000224>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000568") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39284953") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11564107/fullTextXML") Annotation(rdfs:comment "In the phase 2 adaptive BELLINI trial, patients with early-stage triple-negative breast cancer received neoadjuvant nivolumab with or without ipilimumab, showing immune activation, clearance of circulating tumor DNA and promising clinical response rates, especially in patients preselected based on high levels of tumor-infiltrating lymphocytes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000224> "A cohort of patients with early-stage triple negative breast cancer treated in the adaptive phase 2 BELLINI trial with short neoadjuvant nivolumab alone or with ipilimumab, whose tumours were exome sequenced to study immune activation and pathological response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000568") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39284953") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A39284953+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The adaptive BELLINI trial explored whether short combination ICI induces immune activation (primary end point, twofold increase in CD8+ T cells or IFNG), providing a rationale for neoadjuvant ICI without chemotherapy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000224> "A cohort of patients with early-stage triple negative breast cancer treated in the adaptive phase 2 BELLINI trial with short neoadjuvant nivolumab alone or with ipilimumab, whose tumours were exome sequenced to study immune activation and pathological response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000568") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000568") Annotation(rdfs:comment "Based on these data, we opened cohort C for patients with high TILs (≥50%) who received 6 weeks neoadjuvant anti-PD1 + anti-CTLA4 followed by surgery (primary endpoint: pathological complete response, pCR).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000224> "A cohort of patients with early-stage triple negative breast cancer treated in the adaptive phase 2 BELLINI trial with short neoadjuvant nivolumab alone or with ipilimumab, whose tumours were exome sequenced to study immune activation and pathological response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000568") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000568") Annotation(rdfs:comment "Neoadjuvant nivolumab or nivolumab plus ipilimumab in early-stage triple negative breast cancer: phase 2 adaptive BELLINI trial. WES") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000224> "A cohort of patients with early-stage triple negative breast cancer treated in the adaptive phase 2 BELLINI trial with short neoadjuvant nivolumab alone or with ipilimumab, whose tumours were exome sequenced to study immune activation and pathological response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000225> (<http://www.ebi.ac.uk/coho/COHO_0000225>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000105") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38898120") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38898120+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Patients ≥18 years of age with stage IIIB/IV, ROS1-positive NSCLC detected by liquid biopsies received entrectinib 600 mg daily.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000225> "A global open-label multicohort trial of patients with advanced or metastatic non-small cell lung cancer whose targetable alterations were identified by blood-based molecular testing, evaluating the efficacy and safety of matched therapies such as entrectinib in ROS1-positive disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000105") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38898120") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38898120+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Blood First Assay Screening Trial is a global, open-label, multicohort trial that evaluates the efficacy and safety of multiple therapies in patients with advanced/metastatic NSCLC and targetable alterations identified by liquid biopsy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000225> "A global open-label multicohort trial of patients with advanced or metastatic non-small cell lung cancer whose targetable alterations were identified by blood-based molecular testing, evaluating the efficacy and safety of matched therapies such as entrectinib in ROS1-positive disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000226> (<http://www.ebi.ac.uk/coho/COHO_0000226>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18811926") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2562385/fullTextXML") Annotation(rdfs:comment "This protocol outlines the study methods and design considerations for the recruitment phase of this longitudinal cohort study of babies born in Bradford, and their mothers and fathers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000226> "A birth cohort of babies and their families recruited during 2007–2011 in the city of Bradford in the north of England, about half of Pakistani heritage, followed prospectively to investigate the determinants of childhood health and used for autozygosity and exome sequencing studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38552669") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11065350/fullTextXML") Annotation(rdfs:comment "By collecting data on a broad range of topics, we aimed to provide a resource to allow exploration of the determinants of children’s pre-pubertal health and development, including through understanding parents’ health and wellbeing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000226> "A birth cohort of babies and their families recruited during 2007–2011 in the city of Bradford in the north of England, about half of Pakistani heritage, followed prospectively to investigate the determinants of childhood health and used for autozygosity and exome sequencing studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38552669") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11065350/fullTextXML") Annotation(rdfs:comment "Exome sequencing in the BiB cohort has identified >1100 naturally occurring gene knockouts (homozygous loss-of-function variants) in 820 consanguineous participants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000226> "A birth cohort of babies and their families recruited during 2007–2011 in the city of Bradford in the north of England, about half of Pakistani heritage, followed prospectively to investigate the determinants of childhood health and used for autozygosity and exome sequencing studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38552669") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11065350/fullTextXML") Annotation(rdfs:comment "Routine health and education data have been collected since birth and cohort subsamples have been followed up to age 5 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000226> "A birth cohort of babies and their families recruited during 2007–2011 in the city of Bradford in the north of England, about half of Pakistani heritage, followed prospectively to investigate the determinants of childhood health and used for autozygosity and exome sequencing studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001001888") Annotation(rdfs:comment "Recently we analysed genotype data from the Born in Bradford (BiB) cohort, which formed the core of our previous autozygosity sequencing (Narasimhan et al., Science, 2016), and discovered that in the BiB people who had not reported parental relatedness, another 22% (443/2049) actually had over 5% autozygosity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000226> "A birth cohort of babies and their families recruited during 2007–2011 in the city of Bradford in the north of England, about half of Pakistani heritage, followed prospectively to investigate the determinants of childhood health and used for autozygosity and exome sequencing studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005273") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001005273") Annotation(rdfs:comment "Born in Bradford (BiB) is similarly focused on a particular local area, the city of Bradford in the north of England, and recruited 13,858 babies between 2007 and 2011, of whom ~41% self-report as white British and ~59% as other ethnicities, predominantly Pakistani.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000226> "A birth cohort of babies and their families recruited during 2007–2011 in the city of Bradford in the north of England, about half of Pakistani heritage, followed prospectively to investigate the determinants of childhood health and used for autozygosity and exome sequencing studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000227> (<http://www.ebi.ac.uk/coho/COHO_0000227>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007563") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26527775") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26527775+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Patients with stage II to III HER2-positive breast cancer underwent tumor biopsy followed by random assignment to paclitaxel plus trastuzumab alone (TH) or with the addition of lapatinib (THL) for 16 weeks before surgery.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000227> "A cohort of women with HER2-positive breast cancer enrolled in the Cancer and Leukemia Group B 40601 phase III trial of neoadjuvant paclitaxel with trastuzumab and/or lapatinib, profiled alongside NeoALTTO for immune features that predict prognosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007563") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37923752") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10624889/fullTextXML") Annotation(rdfs:comment "Moreover, the cancer and leukemia group B (CALGB) 40601 trial reported a significant survival benefit for dual HER2-targeting with lapatinib and trastuzumab compared to the single anti-HER2 agents5,6.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000227> "A cohort of women with HER2-positive breast cancer enrolled in the Cancer and Leukemia Group B 40601 phase III trial of neoadjuvant paclitaxel with trastuzumab and/or lapatinib, profiled alongside NeoALTTO for immune features that predict prognosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007563") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007563") Annotation(rdfs:comment "A model developed in NeoALTTO and validated in CALGB 40601 predicted event-free survival (EFS) by integrating hormone receptor and clinical nodal status, treatment response (breast pCR)breast pathological complete response (pCR) as well as tumor-infiltrating lymphocytes and BCR evenness, measuring the equality of BCR clonal distribution.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000227> "A cohort of women with HER2-positive breast cancer enrolled in the Cancer and Leukemia Group B 40601 phase III trial of neoadjuvant paclitaxel with trastuzumab and/or lapatinib, profiled alongside NeoALTTO for immune features that predict prognosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007563") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007563") Annotation(rdfs:comment "Here, we investigated the complexity of B and T cell receptor (BCR and TCR) repertoires, reflecting antigen-specific immune response, in the context of two phase III trials, namely NeoALTTO and CALGB 40601, evaluating neoadjuvant paclitaxel with trastuzumab and/or lapatinib in women affected by HER2-positive breast cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000227> "A cohort of women with HER2-positive breast cancer enrolled in the Cancer and Leukemia Group B 40601 phase III trial of neoadjuvant paclitaxel with trastuzumab and/or lapatinib, profiled alongside NeoALTTO for immune features that predict prognosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000228> (<http://www.ebi.ac.uk/coho/COHO_0000228>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://arxiv.org/pdf/1810.05192") Annotation(rdfs:comment "CBTM is already providing tissue for pilot projects to perform tissue dissociation and scRNA- Seq and is planning a CBTM-HCA collaboration for up to 3,000 specimens per donor from 5 to 10 deceased donors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000228> "A biorepository of tissue and blood samples from organ and tissue donors in Cambridge, United Kingdom, whose donors have been genotyped genome-wide to support Human Cell Atlas and translational research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://arxiv.org/pdf/1810.05192") Annotation(rdfs:comment "Feasibility Case Study 1: Cambridge Biorepository for Translational Medicine (CBTM) CBTM (www.CBTM.group.cam.ac.uk) was founded in Cambridge, U.K., in April 2015 to support translational research projects that require access to fresh or biochemically viable tissue.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000228> "A biorepository of tissue and blood samples from organ and tissue donors in Cambridge, United Kingdom, whose donors have been genotyped genome-wide to support Human Cell Atlas and translational research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://arxiv.org/pdf/1810.05192") Annotation(rdfs:comment "The CBTM and GTEx pipelines provide proof-of-principle for the suitability of deceased organ and rapid- autopsy donors for HCA tissue acquisition.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000228> "A biorepository of tissue and blood samples from organ and tissue donors in Cambridge, United Kingdom, whose donors have been genotyped genome-wide to support Human Cell Atlas and translational research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001008228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001008228") Annotation(rdfs:comment "This project involves a genotyping dataset generated using the UK Biobank Axiom™ Array Kit from donor samples provided by the Cambridge Biorepository for Translational Medicine (CBTM).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000228> "A biorepository of tissue and blood samples from organ and tissue donors in Cambridge, United Kingdom, whose donors have been genotyped genome-wide to support Human Cell Atlas and translational research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000229> (<http://www.ebi.ac.uk/coho/COHO_0000229>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40048847") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11924928/fullTextXML") Annotation(rdfs:comment "The Canadian Airways Research (CARE) group is an ongoing Canada-wide prospective cohort study of clinical, molecular, cellular, and genetic factors underlying the factors determining the pathogenesis and treatment response of subglottic stenosis (SGS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000229> "A cohort of patients with idiopathic or trauma-induced subglottic stenosis and controls enrolled prospectively by the Canadian Airways Research Group to investigate the clinical, transcriptional and genetic features of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40048847") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11924928/fullTextXML") Annotation(rdfs:comment "We prospectively enrolled 126 patients with iSGS, 104 controls, and 13 patients with traumatic SGS.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000229> "A cohort of patients with idiopathic or trauma-induced subglottic stenosis and controls enrolled prospectively by the Canadian Airways Research Group to investigate the clinical, transcriptional and genetic features of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000879") Annotation(rdfs:comment "In this study, we prospectively enrolled patients with iSGS, trauma-induced subglottic stenosis, and controls to investigate the clinical, transcriptional, and genetic features that may be associated with disease pathogenesis and treatment outcomes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000229> "A cohort of patients with idiopathic or trauma-induced subglottic stenosis and controls enrolled prospectively by the Canadian Airways Research Group to investigate the clinical, transcriptional and genetic features of the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000230> (<http://www.ebi.ac.uk/coho/COHO_0000230>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000900") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29295717") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5751811/fullTextXML") Annotation(rdfs:comment "The TCGA cohort included more patients with adverse characteristics than the CPC-GENE cohort, having higher PSA levels (Wilcoxon rank sum test, p = 2.2·10−16), GS (Pearson’s χ2 test, p = 4.0·10−5) and pT stage (Pearson’s χ2 test, p = 3.1·10−9), which can be explained by the specific inclusion of clinically intermediate-risk disease in the latter cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000230> "A cohort of men with intermediate-risk prostate cancer whose tumour genomes, including multiple regions from the same gland, were sequenced by the Canadian Prostate Cancer Genome Network to identify genetic signatures of treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000900") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000900") Annotation(rdfs:comment "CPC-GENE will also sequence multiple regions of prostate cancer from the same gland to determine if and how the genetic make-up of prostate cancer varies within an individual man’s prostate") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000230> "A cohort of men with intermediate-risk prostate cancer whose tumour genomes, including multiple regions from the same gland, were sequenced by the Canadian Prostate Cancer Genome Network to identify genetic signatures of treatment response.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000900") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000900") Annotation(rdfs:comment "Over 5 years, CPC-GENE will sequence the genomes of 350 intermediate risk prostate cancers to identify genetic signatures that differ in cancers that responded well to treatment compared with those that did not.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000230> "A cohort of men with intermediate-risk prostate cancer whose tumour genomes, including multiple regions from the same gland, were sequenced by the Canadian Prostate Cancer Genome Network to identify genetic signatures of treatment response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000231> (<http://www.ebi.ac.uk/coho/COHO_0000231>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000083") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36815791") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10068441/fullTextXML") Annotation(rdfs:comment "Most patients within the CAGEKID cohort demonstrated a mutation in the VHL gene (n = 718; 76%) and could be classified as those with tumors containing a VHL mutation alone (VHL+0), or a VHL mutation plus additional driver events (VHL+1, VHL+2, VHL+≥3), within the sequenced region and equate to the ‘VHL monodriver’ and ‘multiple clonal driver’ subtypes proposed above.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000231> "A collection of constitutional and tumour DNA pairs from patients with conventional clear cell renal carcinoma assembled by the CAGEKID project of the International Cancer Genome Consortium for comprehensive analysis of somatic and constitutional variation, methylation and expression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000083") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000083") Annotation(rdfs:comment "CAGEKID is a part of the International Cancer Genome Consortium, ICGC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000231> "A collection of constitutional and tumour DNA pairs from patients with conventional clear cell renal carcinoma assembled by the CAGEKID project of the International Cancer Genome Consortium for comprehensive analysis of somatic and constitutional variation, methylation and expression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000083") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000083") Annotation(rdfs:comment "The aim of CAGEKID is to carry out comprehensive detection of DNA markers for conventional (clear cell) renal carcinoma.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000231> "A collection of constitutional and tumour DNA pairs from patients with conventional clear cell renal carcinoma assembled by the CAGEKID project of the International Cancer Genome Consortium for comprehensive analysis of somatic and constitutional variation, methylation and expression.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000083") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000083") Annotation(rdfs:comment "The project includes complete analysis of somatic and constitutional DNA variation, methylation patterns and expression in a large number of constitutional/tumor pairs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000231> "A collection of constitutional and tumour DNA pairs from patients with conventional clear cell renal carcinoma assembled by the CAGEKID project of the International Cancer Genome Consortium for comprehensive analysis of somatic and constitutional variation, methylation and expression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000232> (<http://www.ebi.ac.uk/coho/COHO_0000232>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40289251") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12036492/fullTextXML") Annotation(rdfs:comment "The Celiac Disease Northern Netherlands cohort (CeDNN, currently unpublished) comprises 128 CeD patients and 106 controls who provided fecal samples at project onset, with complete metadata including age and sex.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000232> "A Dutch cohort of patients with treated coeliac disease and controls whose faecal microbiomes were characterised by shotgun metagenomic sequencing, analysed alongside the Lifelines Dutch Microbiome Project.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000959") Annotation(rdfs:comment "150 nt paired-end metagenomic shotgun sequencing (Illumina HiSeq 2000) of fecal samples from 130 (mostly treated, i.e. adhering to gluten-free diet) celiac disease patients and 106 controls from the CeDNN cohort from the University Medical Center Groningen, The Netherlands.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000232> "A Dutch cohort of patients with treated coeliac disease and controls whose faecal microbiomes were characterised by shotgun metagenomic sequencing, analysed alongside the Lifelines Dutch Microbiome Project.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000959") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000959") Annotation(rdfs:comment "To address these limitations, we analysed faecal gut microbiota from two Dutch cohorts, CeDNN (128 treated CeD patients (tCeD), 106 controls) and the Lifelines Dutch Microbiome Project (24 self-reported tCeD, 654 controls), using shotgun metagenomic sequencing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000232> "A Dutch cohort of patients with treated coeliac disease and controls whose faecal microbiomes were characterised by shotgun metagenomic sequencing, analysed alongside the Lifelines Dutch Microbiome Project.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000233> (<http://www.ebi.ac.uk/coho/COHO_0000233>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007507") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29649218") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5978987/fullTextXML") Annotation(rdfs:comment "To more comprehensively characterize the role of CNVs in epilepsy, we performed whole-genome sequencing of epileptic patients from the Canadian Epilepsy Network (CENet), the largest WGS study on epilepsy to date.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000233> "A cohort of patients with genetic generalized epilepsy or non-acquired focal epilepsy collected at the CHUM Research Center in Montreal, Canada, and whole-genome sequenced to investigate the genetics of epilepsy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007507") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37756314") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC10529579") Annotation(rdfs:comment "We used whole genome sequencing (WGS) data from the Canadian Epilepsy Network (CENet) cohort to investigate deleterious rare functional variants in epileptic patients [23].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000233> "A cohort of patients with genetic generalized epilepsy or non-acquired focal epilepsy collected at the CHUM Research Center in Montreal, Canada, and whole-genome sequenced to investigate the genetics of epilepsy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007507") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007507") Annotation(rdfs:comment "Epileptic patients have been sequenced as part of the CENet cohort which is composed of patients with Genetic Generalized Epilepsy (GGE) or Non-Acquired Focal Epilepsy (NAFE) collected in CHUM Research Center in Montreal.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000233> "A cohort of patients with genetic generalized epilepsy or non-acquired focal epilepsy collected at the CHUM Research Center in Montreal, Canada, and whole-genome sequenced to investigate the genetics of epilepsy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000234> (<http://www.ebi.ac.uk/coho/COHO_0000234>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006725") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26069286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://thorax.bmj.com/content/70/10/998") Annotation(rdfs:comment "Environmental and biological sampling, innate and adaptive immune responses, gene expression, DNA methylation, gut microbiome and nutrition studies complement repeated environmental and clinical assessments to age 5.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000234> "A Canadian birth cohort of children recruited during pregnancy in four provinces and followed with environmental, clinical, genetic and microbiome measurements to investigate the developmental origins of asthma, allergy and other chronic conditions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006725") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26069286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://thorax.bmj.com/content/70/10/998") Annotation(rdfs:comment "This rich data set, linking prenatal and postnatal environments, diverse biological samples and rigorous phenotyping, will inform early developmental pathways to allergy, asthma and other chronic inflammatory diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000234> "A Canadian birth cohort of children recruited during pregnancy in four provinces and followed with environmental, clinical, genetic and microbiome measurements to investigate the developmental origins of asthma, allergy and other chronic conditions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006725") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26069286") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A26069286+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Canadian Healthy Infant Longitudinal Development (CHILD) birth cohort study recruited 3624 pregnant women, most partners and 3542 eligible offspring.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000234> "A Canadian birth cohort of children recruited during pregnancy in four provinces and followed with environmental, clinical, genetic and microbiome measurements to investigate the developmental origins of asthma, allergy and other chronic conditions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006725") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28381231") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5382463/fullTextXML") Annotation(rdfs:comment "Mothers of the studied infants were enrolled during pregnancy between 2009 and 2012.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000234> "A Canadian birth cohort of children recruited during pregnancy in four provinces and followed with environmental, clinical, genetic and microbiome measurements to investigate the developmental origins of asthma, allergy and other chronic conditions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000235> (<http://www.ebi.ac.uk/coho/COHO_0000235>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006085") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001006085") Annotation(rdfs:comment "Specific BRCA and immune configurations determine optimal response to platinum-based chemotherapy in triple negative breast and ovarian carcinomas (COH_TNBC_WGS)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000235> "A cohort of patients with primary, treatment-naive triple negative breast cancer at City of Hope National Medical Center whose tumours were whole-genome and RNA sequenced to relate BRCA and immune configurations to response to platinum-based chemotherapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006085") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001006085") Annotation(rdfs:comment "WGS data relative to 42 primary and treatment-naive triple negative breast cancers, from independent donors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000235> "A cohort of patients with primary, treatment-naive triple negative breast cancer at City of Hope National Medical Center whose tumours were whole-genome and RNA sequenced to relate BRCA and immune configurations to response to platinum-based chemotherapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006085") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC9585706/") Annotation(rdfs:comment "To test the role of BRCA status and its genomic mutational signatures in the prediction of optimal response to platinum-based therapy, we assessed the genomic characteristics of a cohort of 42 patients with early stage TNBC, from the City Of Hope National Medical Center (COH TNBC cohort (17), Fig. 1A and tables S1–2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000235> "A cohort of patients with primary, treatment-naive triple negative breast cancer at City of Hope National Medical Center whose tumours were whole-genome and RNA sequenced to relate BRCA and immune configurations to response to platinum-based chemotherapy.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006085") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC9585706/") Annotation(rdfs:comment "To this end, we applied the CIBERSORT computational approach and assessed the relative abundance of 22 distinct immune cell types for each TNBC in the COH TNBC cohort with RNAseq expression profiling.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000235> "A cohort of patients with primary, treatment-naive triple negative breast cancer at City of Hope National Medical Center whose tumours were whole-genome and RNA sequenced to relate BRCA and immune configurations to response to platinum-based chemotherapy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000236> (<http://www.ebi.ac.uk/coho/COHO_0000236>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000995") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38194741") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10792564/fullTextXML") Annotation(rdfs:comment "Discovery and verification cohorts included CYP who first initiated MTX before January 2018 in one of four UK multicentre prospective cohorts of JIA within the CLUSTER consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000236> "A United Kingdom consortium that harmonises juvenile idiopathic arthritis and uveitis cohorts and trials, including CAPS, CHARMS and the UK JIA Biologics register, to discover disease mechanisms and biomarkers of treatment response in childhood arthritis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000995") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000000995") Annotation(rdfs:comment "CLUSTER aims to discover novel disease mechanisms and biomarkers in children suffering from Juvenile idiopathic arthritis (JIA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000236> "A United Kingdom consortium that harmonises juvenile idiopathic arthritis and uveitis cohorts and trials, including CAPS, CHARMS and the UK JIA Biologics register, to discover disease mechanisms and biomarkers of treatment response in childhood arthritis.")
