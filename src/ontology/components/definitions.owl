AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000000805") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24657884") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3963103/fullTextXML") Annotation(rdfs:comment "Consequently, adult Ghanaians (aged ≥25 years) are recruited in rural and urban Ghana, and in the cities of Amsterdam, Berlin and London.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000327> "A cohort of Ghanaian adults living in rural and urban Ghana and in European cities, with follow-up in rural and urban Ghana and Amsterdam, to unravel the causes of cardiovascular disease and its risk factors among African migrants in Europe and non-migrants in sub-Saharan Africa.")
