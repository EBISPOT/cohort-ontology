AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.sfari.org/funded-project/the-simons-simplex-collection/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20955926") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20955926+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In an effort to identify de novo genetic variants that contribute to the overall risk of autism, the Simons Foundation Autism Research Initiative (SFARI) has gathered a unique sample called the Simons Simplex Collection (SSC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000155> "A cohort of families recruited through 12 North American clinical sites, each with one child aged 4–18 with an autism spectrum disorder and unaffected biological parents, often including unaffected siblings, assembled to investigate rare and de novo genetic contributions to autism.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.sfari.org/funded-project/the-simons-simplex-collection/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.sfari.org/funded-project/the-simons-simplex-collection/") Annotation(rdfs:comment "Data from each family also include information about unaffected siblings and unaffected biological parents.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000155> "A cohort of families recruited through 12 North American clinical sites, each with one child aged 4–18 with an autism spectrum disorder and unaffected biological parents, often including unaffected siblings, assembled to investigate rare and de novo genetic contributions to autism.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.sfari.org/funded-project/the-simons-simplex-collection/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.sfari.org/funded-project/the-simons-simplex-collection/") Annotation(rdfs:comment "The Simons Simplex Collection (SSC) is a rigorously characterized set of data drawn from 2,700 families, designed to enrich the discovery of rare and de novo events in autism spectrum disorders.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000155> "A cohort of families recruited through 12 North American clinical sites, each with one child aged 4–18 with an autism spectrum disorder and unaffected biological parents, often including unaffected siblings, assembled to investigate rare and de novo genetic contributions to autism.")
