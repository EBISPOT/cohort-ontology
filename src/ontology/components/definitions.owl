# Individual: <http://www.ebi.ac.uk/coho/COHO_0000913> (<http://www.ebi.ac.uk/coho/COHO_0000913>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3674994/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5300151/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000913> "A population-based cohort of 3,471 adults aged 18–69, randomly sampled from the Danish Central Personal Register in the southern part of Copenhagen and examined in 2006–2008 at the Research Centre for Prevention and Health in Glostrup, Denmark, to study general health, allergy, diabetes and cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000914> (<http://www.ebi.ac.uk/coho/COHO_0000914>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33590662") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8503053/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000914> "A longitudinal population-based study of 5,133 adults from the German city of Heidelberg and its surroundings, started in the 1990s with a baseline battery of health-related personality questionnaires to characterise associations between personality and somatic disease, and later followed up and genotyped.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000915> (<http://www.ebi.ac.uk/coho/COHO_0000915>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34480422") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000915> "A global collaboration of 51 studies from 11 countries with genome-wide genotyping and data on heart failure events and prognosis, including population-based cohorts, hospital-based electronic health record cohorts, case-control studies and clinical trials, formed to conduct large-scale genetic association studies of heart failure risk, prognosis and subtypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000916> (<http://www.ebi.ac.uk/coho/COHO_0000916>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35446358") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37386247") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000916> "A large international consortium established to identify glaucoma risk genes through large-scale genome-wide meta-analysis of primary open-angle glaucoma and related traits such as intraocular pressure, vertical cup-to-disc ratio and central corneal thickness, across populations of European, Asian and African ancestry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000917> (<http://www.ebi.ac.uk/coho/COHO_0000917>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21051598") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000917> "A multinational study that recruited HIV-1 controllers, people with HIV whose plasma viral load stays below 2000 RNA copies/ml (at least three measurements over at least 12 months) without antiretroviral therapy, for genome-wide association analysis of host genetic effects on the control of HIV infection.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000918> (<http://www.ebi.ac.uk/coho/COHO_0000918>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000918> "A set of Swedish post-marketing (phase IV) cohorts of patients with multiple sclerosis treated with novel disease-modifying drugs, followed through the Swedish MS registry to monitor the long-term safety and risks of immunomodulatory treatments.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000919> (<http://www.ebi.ac.uk/coho/COHO_0000919>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31815703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000919> "An international research alliance founded in 2009 of more than 100 scientists who pool genetic, clinical and functional data from Parkinson's disease case-control cohorts worldwide for collaborative genetics research on Parkinson's disease, with recent efforts in East Asia and Africa.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000920> (<http://www.ebi.ac.uk/coho/COHO_0000920>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855068") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000920> "A collection of 2994 healthy Japanese volunteers assembled by the Japan Pharmacogenomics Data Science Consortium, with genotypes of 2.5 million SNPs and 5 HLA loci and 121 kinds of clinical information, as control data for pharmacogenomics studies of drug safety and efficacy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000921> (<http://www.ebi.ac.uk/coho/COHO_0000921>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32799709") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000921> "A randomized, double-blind, placebo-controlled trial of rosuvastatin 20 mg daily for the primary prevention of cardiovascular disease in 17,802 apparently healthy men aged 50 or over and women aged 60 or over with low LDL cholesterol but elevated high-sensitivity C-reactive protein, funded by AstraZeneca and stopped early for efficacy after a median follow-up of 1.9 years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000922> (<http://www.ebi.ac.uk/coho/COHO_0000922>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16343090") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42116128") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000922> "A prospective Dutch birth cohort of healthy pregnant women enrolled from October 2000 to 2002, recruited from a cohort study on pregnancy-related pelvic girdle pain ('conventional lifestyles') and, for contrast, through organic food shops, anthroposophic doctors and midwives, Steiner schools and dedicated magazines ('alternative lifestyles'), and their children, set up to identify lifestyle and other early-life factors that influence atopic disease and followed into young adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000923> (<http://www.ebi.ac.uk/coho/COHO_0000923>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22226020") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000923> "A clinic-based case-control study of breast cancer begun in February 2001 at Mayo Clinic, Rochester, Minnesota, enrolling women aged 18 or over with invasive breast cancer who lived in the six-state region of Mayo Clinic's primary service population, and cancer-free controls frequency-matched on age, race and region from Mayo Clinic's general internal medicine practice.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000924> (<http://www.ebi.ac.uk/coho/COHO_0000924>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23152984") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000924> "A prospective breast screening cohort of 19,924 women aged 35 or over, resident in Minnesota, Iowa or Wisconsin and without a history of breast cancer, enrolled when having a screening mammogram at Mayo Clinic, Rochester, from October 2003 to September 2006, to study mammographic density and breast cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000925> (<http://www.ebi.ac.uk/coho/COHO_0000925>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11254450") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000925> "A collection of families with multiple siblings affected by rheumatoid arthritis, gathered in the United States by the North American Rheumatoid Arthritis Consortium using well-defined clinical criteria and a severe-phenotype selection of probands, later extended with case-control collections (NARAC-II, NARAC-III), for linkage and association studies of rheumatoid arthritis genetics.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000926> (<http://www.ebi.ac.uk/coho/COHO_0000926>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159511") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24159540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000926> "The central national biobank of South Korea, opened by the Korea National Institute of Health as the hub of the Korea Biobank Network with regional hospital biobanks, which holds and distributes biospecimens and data from general-population cohort studies such as the Korean Genome and Epidemiology Study and from hospital patients for biomedical and public health research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000927> (<http://www.ebi.ac.uk/coho/COHO_0000927>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11790227/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000927> "A population-based prospective cohort of more than 140,000 participants in Norrbotten and Västerbotten, the two northernmost regions of Sweden, initiated in the mid-1980s and managed by Umeå University, combining three sub-cohorts (the Västerbotten Intervention Programme, the expanded Northern Sweden MONICA study and the Mammography Screening Project) with over 240,000 stored blood samples, for research on the aetiology, prevention and early detection of cancer, cardiovascular and other diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000928> (<http://www.ebi.ac.uk/coho/COHO_0000928>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000928> "The Ontario site of the Breast Cancer Family Registry, which enrolled women with invasive breast cancer diagnosed in 1996–1998 identified through the Ontario Cancer Registry (all those aged 20–54 at high genetic risk and random samples of others, with high-risk cases diagnosed in 2001–2002 added), together with their relatives and population controls, to study the genetic epidemiology of breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000929> (<http://www.ebi.ac.uk/coho/COHO_0000929>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26151264") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000929> "A randomised, double-blind trial in which 371 adults with a first unprovoked pulmonary embolism, after six months of vitamin K antagonist treatment, were randomised to a further 18 months of warfarin or placebo and followed between 2007 and 2014 at 14 French centres, comparing recurrent venous thromboembolism and major bleeding.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000930> (<http://www.ebi.ac.uk/coho/COHO_0000930>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25855707") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000930> "A population-based case-control study of breast cancer in Warsaw and Łódź, Poland, in 2000–2003, funded by the intramural programme of the US National Cancer Institute, in which cases were women aged 20–74 with newly diagnosed in situ or invasive breast cancer identified through a rapid identification system at participating hospitals and through cancer registries.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000931> (<http://www.ebi.ac.uk/coho/COHO_0000931>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32203222") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000931> "A cohort of women aged 47–73 recruited from 2009 at routine NHS Breast Screening Programme appointments in Manchester, UK, who completed risk-factor questionnaires and had breast density measured, a subset also giving DNA, to study breast cancer risk prediction at screening.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000932> (<http://www.ebi.ac.uk/coho/COHO_0000932>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17254404") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000932> "A registry of twins and multiples of all ages in Qingdao, China, initiated in 1998 as part of the Chinese National Twin Registry, with more than 11,000 twin pairs recruited and adolescent, adult and elderly twin cohorts sampled for studies of chronic disease, metabolic disorders, health behaviours and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000933> (<http://www.ebi.ac.uk/coho/COHO_0000933>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31270876") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000933> "A population-based twin registry in China, established in 2001, which includes data on over 61,000 twin pairs from 11 provinces or cities and collects biological specimens from disease-concordant and disease-discordant twin pairs, to analyse genetic and environmental influences on chronic diseases, especially cardiovascular diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000934> (<http://www.ebi.ac.uk/coho/COHO_0000934>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.reprogen.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000934> "An international network of investigators that meta-analyses genome-wide association study data from many cohorts to identify genetic variants and genes affecting reproductive ageing and reproductive timing, such as age at menarche and age at natural menopause.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000935> (<http://www.ebi.ac.uk/coho/COHO_0000935>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22226020") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000935> "A population-based case-control study of postmenopausal breast cancer in women aged 50–74 born in Sweden, with incident cases identified through the Swedish regional cancer registries and controls randomly selected from the Swedish population register, enrolled in 1993–1995, with ethical approval at Karolinska Institutet and funding from Singapore (A*STAR) and the US.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000936> (<http://www.ebi.ac.uk/coho/COHO_0000936>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22899653") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000936> "A hospital-based case–control study of lung cancer in Toronto, Canada, run by the University of Toronto and the Samuel Lunenfeld Research Institute of Mount Sinai Hospital, whose genome-wide genotyped cases and controls contribute to international lung cancer consortia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000937> (<http://www.ebi.ac.uk/coho/COHO_0000937>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39862296") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000937> "A hospital-based case–control cohort of patients with gastric cancer and non-cancer controls aged 26–80 recruited at the Digestive Disease Center of Seoul National University Bundang Hospital, South Korea, with genome-wide genotypes, Helicobacter pylori status and lifestyle data, used to study genetic risk of gastric cancer by histological type and sex.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000938> (<http://www.ebi.ac.uk/coho/COHO_0000938>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31932529") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000938> "A community-based cohort of adults aged 20 years or over living in Miyagi or Iwate Prefecture, Japan, of whom 87,865 consented to join through health check-ups and assessment centres of the Tohoku Medical Megabank Project, to assess the long-term impact of the Great East Japan Earthquake and gene–environment interactions in major diseases such as cancer and cardiovascular disease, with genome and metabolome information.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000939> (<http://www.ebi.ac.uk/coho/COHO_0000939>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31504573") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000939> "A birth and three-generation cohort in Japan conducted since July 2013 by the Tohoku Medical Megabank Organization of Tohoku University and the Iwate Tohoku Medical Megabank Organization, recruiting pregnant women and their fetuses as probands together with the fathers, grandparents, siblings and extended family members, with genome and omics information, to study disease risk across generations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000940> (<http://www.ebi.ac.uk/coho/COHO_0000940>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25431468") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000940> "A Dutch clinical cohort of 543 children who had been referred to a child psychiatric outpatient clinic in the Northern Netherlands before the age of 11, enrolled from 2004 alongside the TRAILS population cohort and followed from about age 11 with repeated assessments of mental health and development into young adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000941> (<http://www.ebi.ac.uk/coho/COHO_0000941>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5697951/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000941> "A collection of Chinese people with type 2 diabetes in Taiwan, with and without proliferative diabetic retinopathy, assembled from 1996 to 2011 by Taiwanese and US investigators for genetic studies of diabetic retinopathy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000942> (<http://www.ebi.ac.uk/coho/COHO_0000942>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21897394") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000942> "A UK general-population cohort started in 2003 that recruited 112,049 participants aged 16–102 by 2011 through a generational referral method, in which women recruited directly nominated female friends and relatives, collecting detailed questionnaires and blood samples repeatedly over decades to investigate breast cancer aetiology.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000943> (<http://www.ebi.ac.uk/coho/COHO_0000943>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28649285") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000943> "A multicentre prospective cohort of people with type 2 diabetes, with diabetes-free controls included at baseline, in the city of Eindhoven, the Netherlands, extensively phenotyped to study the aetiology of type 2 diabetes and its micro- and macrovascular complications.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000944> (<http://www.ebi.ac.uk/coho/COHO_0000944>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37402774") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000944> "A Danish clinical research programme, the Copenhagen Prospective Studies on Asthma in Childhood, made up of mother-child birth cohorts: COPSAC2000, a high-risk cohort of 411 children of mothers with a doctor's diagnosis of asthma, enrolled in the first month of life, and COPSAC2010, a cohort of 700 children born to unselected mothers from Denmark.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000945> (<http://www.ebi.ac.uk/coho/COHO_0000945>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26034056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000945> "A multiethnic genome-wide association study sample of prostate cancer from Kaiser Permanente health plan members in California, combining prostate cancer cases from three Kaiser Permanente studies (the Research Program on Genes, Environment and Health, the ProHealth Study and the California Men's Health Study) with men of the Genetic Epidemiology Research on Aging cohort without a prostate cancer diagnosis as controls (7,783 cases and 38,595 controls; 80.3% non-Hispanic white, 4.9% African American, 7.0% East Asian and 7.8% Latino).")


)