AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29611518") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29611518") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5883334/fullTextXML") Annotation(rdfs:comment "Between March 27, 2008, and Nov 29, 2013, 6088 patients underwent randomisation (figure 1) at 244 centres") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000154> "A randomised trial cohort of adults with high-risk stage II or stage III colorectal cancer, recruited at 244 centres during 2008–2013 to compare three versus six months of adjuvant oxaliplatin-containing chemotherapy using disease-free survival as the primary outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29611518") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29611518") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5883334/fullTextXML") Annotation(rdfs:comment "The SCOT study is an international, randomised, non-blinded, non-inferiority, phase 3 trial comparing 6 months versus 3 months of oxaliplatin and fluoropyrimidine adjuvant chemotherapy in patients with high-risk stage II or stage III colorectal cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000154> "A randomised trial cohort of adults with high-risk stage II or stage III colorectal cancer, recruited at 244 centres during 2008–2013 to compare three versus six months of adjuvant oxaliplatin-containing chemotherapy using disease-free survival as the primary outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29611518") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29611518") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5883334/fullTextXML") Annotation(rdfs:comment "The primary study endpoint was disease-free survival, defined as the time from randomisation (or trial registration for those randomised after 3 months of therapy) to relapse, development of a new colorectal cancer, or death from any cause.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000154> "A randomised trial cohort of adults with high-risk stage II or stage III colorectal cancer, recruited at 244 centres during 2008–2013 to compare three versus six months of adjuvant oxaliplatin-containing chemotherapy using disease-free survival as the primary outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29611518") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29611518") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29611518+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Patients aged 18 years or older with high-risk stage II and stage III colorectal cancer underwent central randomisation with minimisation for centre, choice of regimen, sex, disease site, N stage, T stage, and the starting dose of capecitabine.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000154> "A randomised trial cohort of adults with high-risk stage II or stage III colorectal cancer, recruited at 244 centres during 2008–2013 to compare three versus six months of adjuvant oxaliplatin-containing chemotherapy using disease-free survival as the primary outcome.")

