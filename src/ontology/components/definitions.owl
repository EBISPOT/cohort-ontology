AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25818243") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33976506") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3874/MediaObjects/41588_2017_BFng3874_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-020-2263-3/MediaObjects/41586_2020_2263_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25818243") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A25818243+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We collected data of MACE, including all-cause mortality, all strokes, new myocardial infarction and unplanned repeat revascularization, in subjects with stable CAD from our catheterization databank.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002442> "A hospital-based study of patients with cardiovascular disease receiving care at Taichung Veterans General Hospital in Taichung, Taiwan, chiefly people hospitalised for diagnostic and interventional coronary angiography and treatment, together with patients with a history of myocardial infarction or coronary revascularisation, whose angiographic and clinical records are used to study the severity and outcomes of stable coronary artery disease and whose DNA contributes to the TAICHI Consortium's genetic studies.")
