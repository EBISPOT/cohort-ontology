AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://research.umcutrecht.nl/athero-express/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20018935") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20018935+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "AtheroExpress is a biobank collecting atherosclerotic lesions during surgery, with a 3-year follow-up.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000010> "A biobank of patients undergoing vascular surgery at University Medical Center Utrecht and formerly Antonius Hospital Nieuwegein, with vascular tissue, molecular measurements and at least three years of follow-up to investigate atherosclerotic plaques and subsequent cardiovascular events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://research.umcutrecht.nl/athero-express/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20018935") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A20018935+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Because atherosclerosis is considered a systemic disease, we hypothesized that one single atherosclerotic plaque contains ample molecular information that predicts future cardiovascular events in all vascular territories.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000010> "A biobank of patients undergoing vascular surgery at University Medical Center Utrecht and formerly Antonius Hospital Nieuwegein, with vascular tissue, molecular measurements and at least three years of follow-up to investigate atherosclerotic plaques and subsequent cardiovascular events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://research.umcutrecht.nl/athero-express/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://research.umcutrecht.nl/athero-express/") Annotation(rdfs:comment "Patients eligible to undergo endarterectomy of the carotid or femoral artery to treat atherosclerotic disease in the University Medical Center Utrecht (and in the past the Antonius Hospital Nieuwegein) are included in the Athero-Express study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000010> "A biobank of patients undergoing vascular surgery at University Medical Center Utrecht and formerly Antonius Hospital Nieuwegein, with vascular tissue, molecular measurements and at least three years of follow-up to investigate atherosclerotic plaques and subsequent cardiovascular events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://research.umcutrecht.nl/athero-express/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://research.umcutrecht.nl/athero-express/") Annotation(rdfs:comment "The biobank database encompasses many characteristics: pathological specifications, clinical characteristics, 3 years follow up, whole transcriptome analyses (n=700), whole genome methylation profile (n=700) and SNP data (n=2000), single cell sequencing data (n=45).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000010> "A biobank of patients undergoing vascular surgery at University Medical Center Utrecht and formerly Antonius Hospital Nieuwegein, with vascular tissue, molecular measurements and at least three years of follow-up to investigate atherosclerotic plaques and subsequent cardiovascular events.")

