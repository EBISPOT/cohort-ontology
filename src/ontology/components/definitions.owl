AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26237428") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32341527") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26237428") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3373/MediaObjects/41588_2015_BFng3373_MOESM50_ESM.pdf") Annotation(rdfs:comment "Essen-Heidelberg 1,212 1,219 1.053 6,356,866 Unpublished") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001322> "A German case-control study of cutaneous melanoma, of patients with histologically confirmed cutaneous melanoma and healthy controls from Germany genotyped genome-wide, approved by the ethics committee of University Hospital Essen and funded by the Deutsche Forschungsgemeinschaft, whose data were contributed to international meta-analyses of melanoma genome-wide association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26237428") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32341527") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32341527") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0611-8/MediaObjects/41588_2020_611_MOESM1_ESM.pdf") Annotation(rdfs:comment "Essen-Heidelberg The study was supported by a grant from Deutsche Forshungsgemeinschaft (GZ: SCHA 422/11-1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001322> "A German case-control study of cutaneous melanoma, of patients with histologically confirmed cutaneous melanoma and healthy controls from Germany genotyped genome-wide, approved by the ethics committee of University Hospital Essen and funded by the Deutsche Forschungsgemeinschaft, whose data were contributed to international meta-analyses of melanoma genome-wide association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26237428") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32341527") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32341527") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0611-8/MediaObjects/41588_2020_611_MOESM1_ESM.pdf") Annotation(rdfs:comment "Histologically confirmed cutaneous melanoma cases (N = 1,218) were genotyped using the Illumina HumanCytoSNP-12v1-0_D arrays (San Diego, CA, USA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001322> "A German case-control study of cutaneous melanoma, of patients with histologically confirmed cutaneous melanoma and healthy controls from Germany genotyped genome-wide, approved by the ethics committee of University Hospital Essen and funded by the Deutsche Forschungsgemeinschaft, whose data were contributed to international meta-analyses of melanoma genome-wide association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26237428") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32341527") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32341527") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0611-8/MediaObjects/41588_2020_611_MOESM1_ESM.pdf") Annotation(rdfs:comment "Participation required informed consent, and the study was approved and overseen by the Human Research Ethics Committee of University Hospital Essen.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001322> "A German case-control study of cutaneous melanoma, of patients with histologically confirmed cutaneous melanoma and healthy controls from Germany genotyped genome-wide, approved by the ethics committee of University Hospital Essen and funded by the Deutsche Forschungsgemeinschaft, whose data were contributed to international meta-analyses of melanoma genome-wide association studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26237428") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32341527") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32341527") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-020-0611-8/MediaObjects/41588_2020_611_MOESM1_ESM.pdf") Annotation(rdfs:comment "These were combined with healthy controls (N = 1,223) from Germany genotyped on the Illumina HumanOmniExpress12_v1_C array (San Diego, CA, USA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001322> "A German case-control study of cutaneous melanoma, of patients with histologically confirmed cutaneous melanoma and healthy controls from Germany genotyped genome-wide, approved by the ethics committee of University Hospital Essen and funded by the Deutsche Forschungsgemeinschaft, whose data were contributed to international meta-analyses of melanoma genome-wide association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001323> (<http://www.ebi.ac.uk/coho/COHO_0001323>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19967159") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35463779") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36002395") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37286573") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37399490") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19967159") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19967159+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We conducted a case-control study involving 1,454 adults enrolled in 11 French centers between 2003 and 2007, comprising 727 consecutive cases with a first documented episode of VTE and 727 age- and sex-matched controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001323> "A French multicentre case-control study of venous thromboembolism, run in 11 centres from 2003 to 2009, that enrolled consecutive adult inpatients and outpatients treated for a first objectively documented deep vein thrombosis and/or pulmonary embolism, without active cancer or malignancy in the previous 5 years, whose blood was mostly sampled in the week after diagnosis, and hospital controls matched for age, sex and centre with no history of venous or arterial thrombosis; the patients were also followed prospectively, to study risk factors for a first venous thromboembolism and for its recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19967159") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35463779") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36002395") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37286573") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37399490") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35463779") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC9021545/") Annotation(rdfs:comment "FARIVE study: Facteurs de risqué et de récidives de la maladie thromboembolique veineuse 2003 to 2009 France 11 centers First unprovoked DVT/PE; age ≥ 18") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001323> "A French multicentre case-control study of venous thromboembolism, run in 11 centres from 2003 to 2009, that enrolled consecutive adult inpatients and outpatients treated for a first objectively documented deep vein thrombosis and/or pulmonary embolism, without active cancer or malignancy in the previous 5 years, whose blood was mostly sampled in the week after diagnosis, and hospital controls matched for age, sex and centre with no history of venous or arterial thrombosis; the patients were also followed prospectively, to study risk factors for a first venous thromboembolism and for its recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19967159") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35463779") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36002395") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37286573") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37399490") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36002395") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9826241/fullTextXML") Annotation(rdfs:comment "Between January 2003 and January 2009, the FARIVE multicenter case–control study included consecutive unselected subjects treated as inpatients or outpatients for a first episode of proximal DVT and/or PE, as previously described.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001323> "A French multicentre case-control study of venous thromboembolism, run in 11 centres from 2003 to 2009, that enrolled consecutive adult inpatients and outpatients treated for a first objectively documented deep vein thrombosis and/or pulmonary embolism, without active cancer or malignancy in the previous 5 years, whose blood was mostly sampled in the week after diagnosis, and hospital controls matched for age, sex and centre with no history of venous or arterial thrombosis; the patients were also followed prospectively, to study risk factors for a first venous thromboembolism and for its recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19967159") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35463779") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36002395") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37286573") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37399490") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37286573") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10247781/fullTextXML") Annotation(rdfs:comment "From most cases, blood was collected in the first week after diagnosis and during anticoagulant treatment initiation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001323> "A French multicentre case-control study of venous thromboembolism, run in 11 centres from 2003 to 2009, that enrolled consecutive adult inpatients and outpatients treated for a first objectively documented deep vein thrombosis and/or pulmonary embolism, without active cancer or malignancy in the previous 5 years, whose blood was mostly sampled in the week after diagnosis, and hospital controls matched for age, sex and centre with no history of venous or arterial thrombosis; the patients were also followed prospectively, to study risk factors for a first venous thromboembolism and for its recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19967159") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35463779") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36002395") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37286573") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37399490") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37399490") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10506044/fullTextXML") Annotation(rdfs:comment "Patients were included if they fulfilled the criteria for a first VTE event, were ≥18 years of age, and had no active cancer or recent history (within 5 years) of malignancy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001323> "A French multicentre case-control study of venous thromboembolism, run in 11 centres from 2003 to 2009, that enrolled consecutive adult inpatients and outpatients treated for a first objectively documented deep vein thrombosis and/or pulmonary embolism, without active cancer or malignancy in the previous 5 years, whose blood was mostly sampled in the week after diagnosis, and hospital controls matched for age, sex and centre with no history of venous or arterial thrombosis; the patients were also followed prospectively, to study risk factors for a first venous thromboembolism and for its recurrence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19967159") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35463779") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36002395") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37286573") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37399490") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37399490") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10506044/fullTextXML") Annotation(rdfs:comment "The Facteurs de Risques et de Récidives de la Maladie Thromboembolique Veineuse (FARIVE) study is a multicenter case–control study composed of 607 patients with a documented episode DVT and/or PE and 607 healthy individuals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001323> "A French multicentre case-control study of venous thromboembolism, run in 11 centres from 2003 to 2009, that enrolled consecutive adult inpatients and outpatients treated for a first objectively documented deep vein thrombosis and/or pulmonary embolism, without active cancer or malignancy in the previous 5 years, whose blood was mostly sampled in the week after diagnosis, and hospital controls matched for age, sex and centre with no history of venous or arterial thrombosis; the patients were also followed prospectively, to study risk factors for a first venous thromboembolism and for its recurrence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001324> (<http://www.ebi.ac.uk/coho/COHO_0001324>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32282921") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32282921") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(rdfs:comment "Both prevalent and incident patients aged > _18years were eligible.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001324> "A registry of patients with fibromuscular dysplasia, launched in December 2015 at the First Brussels National Meeting on FMD and endorsed by the European Society of Hypertension in 2016, that enrols prevalent and incident adult patients whose multifocal or focal FMD lesions in at least one arterial bed were shown by CT angiography, MR angiography or catheter angiography, at centres in Europe and a few other countries, recording their clinical characteristics, imaging, visits and vascular interventions on an online platform with an associated DNA and RNA biobank, to characterise the clinical profiles, complications and management of the disease. It also takes in data from existing national registries such as the French NOMADE and Polish ARCADIA-POL registries.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32282921") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32282921") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(rdfs:comment "Finally the Registry is also associated with a DNA and RNA biobank") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001324> "A registry of patients with fibromuscular dysplasia, launched in December 2015 at the First Brussels National Meeting on FMD and endorsed by the European Society of Hypertension in 2016, that enrols prevalent and incident adult patients whose multifocal or focal FMD lesions in at least one arterial bed were shown by CT angiography, MR angiography or catheter angiography, at centres in Europe and a few other countries, recording their clinical characteristics, imaging, visits and vascular interventions on an online platform with an associated DNA and RNA biobank, to characterise the clinical profiles, complications and management of the disease. It also takes in data from existing national registries such as the French NOMADE and Polish ARCADIA-POL registries.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32282921") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32282921") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(rdfs:comment "One thousand twenty-two patients were enrolled in 46 centres from 22 countries (five outside Europe, representing 11% of the whole series) between1 December2015and 30 April 2019 (database lock).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001324> "A registry of patients with fibromuscular dysplasia, launched in December 2015 at the First Brussels National Meeting on FMD and endorsed by the European Society of Hypertension in 2016, that enrols prevalent and incident adult patients whose multifocal or focal FMD lesions in at least one arterial bed were shown by CT angiography, MR angiography or catheter angiography, at centres in Europe and a few other countries, recording their clinical characteristics, imaging, visits and vascular interventions on an online platform with an associated DNA and RNA biobank, to characterise the clinical profiles, complications and management of the disease. It also takes in data from existing national registries such as the French NOMADE and Polish ARCADIA-POL registries.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32282921") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32282921") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(rdfs:comment "The European/ International Registry also includes contribution from existing registries, such as the French NOMADE and the Polish ARCADIA-POL registries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001324> "A registry of patients with fibromuscular dysplasia, launched in December 2015 at the First Brussels National Meeting on FMD and endorsed by the European Society of Hypertension in 2016, that enrols prevalent and incident adult patients whose multifocal or focal FMD lesions in at least one arterial bed were shown by CT angiography, MR angiography or catheter angiography, at centres in Europe and a few other countries, recording their clinical characteristics, imaging, visits and vascular interventions on an online platform with an associated DNA and RNA biobank, to characterise the clinical profiles, complications and management of the disease. It also takes in data from existing national registries such as the French NOMADE and Polish ARCADIA-POL registries.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32282921") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32282921") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(rdfs:comment "The European/International FMD registry7 was launched in December 2015 at the First Brussels National Meeting on FMD and sub- sequently endorsed by the European Society of Hypertension (ESH) in 2016.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001324> "A registry of patients with fibromuscular dysplasia, launched in December 2015 at the First Brussels National Meeting on FMD and endorsed by the European Society of Hypertension in 2016, that enrols prevalent and incident adult patients whose multifocal or focal FMD lesions in at least one arterial bed were shown by CT angiography, MR angiography or catheter angiography, at centres in Europe and a few other countries, recording their clinical characteristics, imaging, visits and vascular interventions on an online platform with an associated DNA and RNA biobank, to characterise the clinical profiles, complications and management of the disease. It also takes in data from existing national registries such as the French NOMADE and Polish ARCADIA-POL registries.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32282921") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://orbi.uliege.be/bitstream/2268/250361/1/2020%20Cardiovas%20Res_Pappaccogli-FEIRI-1000%20FMD.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32282921") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A32282921+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "All patients diagnosed with FMD (string-of-beads or focal stenosis in at least one vascular bed) based on computed tomography angiography, magnetic resonance angiography, and/or catheter-based angiography were eligible.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001324> "A registry of patients with fibromuscular dysplasia, launched in December 2015 at the First Brussels National Meeting on FMD and endorsed by the European Society of Hypertension in 2016, that enrols prevalent and incident adult patients whose multifocal or focal FMD lesions in at least one arterial bed were shown by CT angiography, MR angiography or catheter angiography, at centres in Europe and a few other countries, recording their clinical characteristics, imaging, visits and vascular interventions on an online platform with an associated DNA and RNA biobank, to characterise the clinical profiles, complications and management of the disease. It also takes in data from existing national registries such as the French NOMADE and Polish ARCADIA-POL registries.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001325> (<http://www.ebi.ac.uk/coho/COHO_0001325>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31657023") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31657023") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7004091/fullTextXML") Annotation(rdfs:comment "A total of 2584 blood donors (N = 8003 samples) were recruited into the study alongside standard donation at three donation sites in the capital region of Finland between 5/2015 and 12/2017.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001325> "A prospective cohort of whole-blood donors aged 18–70 recruited by the Finnish Red Cross Blood Service alongside standard donation at three fixed donation sites in the Helsinki metropolitan area of Finland (Kivihaka, Sanomatalo and Espoo) from May 2015 to December 2017, with blood samples taken at their donation visits during the study for blood counts, CRP, ferritin and soluble transferrin receptor and for DNA, and health and lifestyle questionnaires at enrolment and again in 2018, to study iron status and the genetic and lifestyle factors affecting iron stores in blood donors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31657023") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31657023") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7004091/fullTextXML") Annotation(rdfs:comment "All donors in the participating three fixed donation sites located in the Helsinki metropolitan area (Kivihaka, Sanomatalo, Espoo) were informed of the possibility to join the study with leaflets, posters and Facebook–postings.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001325> "A prospective cohort of whole-blood donors aged 18–70 recruited by the Finnish Red Cross Blood Service alongside standard donation at three fixed donation sites in the Helsinki metropolitan area of Finland (Kivihaka, Sanomatalo and Espoo) from May 2015 to December 2017, with blood samples taken at their donation visits during the study for blood counts, CRP, ferritin and soluble transferrin receptor and for DNA, and health and lifestyle questionnaires at enrolment and again in 2018, to study iron status and the genetic and lifestyle factors affecting iron stores in blood donors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31657023") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31657023") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7004091/fullTextXML") Annotation(rdfs:comment "The FinDonor 10 000 study was set up to study iron status and factors affecting iron stores in Finnish blood donors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001325> "A prospective cohort of whole-blood donors aged 18–70 recruited by the Finnish Red Cross Blood Service alongside standard donation at three fixed donation sites in the Helsinki metropolitan area of Finland (Kivihaka, Sanomatalo and Espoo) from May 2015 to December 2017, with blood samples taken at their donation visits during the study for blood counts, CRP, ferritin and soluble transferrin receptor and for DNA, and health and lifestyle questionnaires at enrolment and again in 2018, to study iron status and the genetic and lifestyle factors affecting iron stores in blood donors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31657023") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31657023") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7004091/fullTextXML") Annotation(rdfs:comment "The age limit for blood donation and thus for study participation was 18–70 years (18–59 years for first time donors).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001325> "A prospective cohort of whole-blood donors aged 18–70 recruited by the Finnish Red Cross Blood Service alongside standard donation at three fixed donation sites in the Helsinki metropolitan area of Finland (Kivihaka, Sanomatalo and Espoo) from May 2015 to December 2017, with blood samples taken at their donation visits during the study for blood counts, CRP, ferritin and soluble transferrin receptor and for DNA, and health and lifestyle questionnaires at enrolment and again in 2018, to study iron status and the genetic and lifestyle factors affecting iron stores in blood donors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31657023") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31657023") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7004091/fullTextXML") Annotation(rdfs:comment "Whole blood count, CRP, ferritin and sTFR were measured from the samples, and DNA was isolated for GWAS studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001325> "A prospective cohort of whole-blood donors aged 18–70 recruited by the Finnish Red Cross Blood Service alongside standard donation at three fixed donation sites in the Helsinki metropolitan area of Finland (Kivihaka, Sanomatalo and Espoo) from May 2015 to December 2017, with blood samples taken at their donation visits during the study for blood counts, CRP, ferritin and soluble transferrin receptor and for DNA, and health and lifestyle questionnaires at enrolment and again in 2018, to study iron status and the genetic and lifestyle factors affecting iron stores in blood donors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31657023") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39643614") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs42003-024-07115-3/MediaObjects/42003_2024_7115_MOESM1_ESM.docx") Annotation(rdfs:comment "FinDonor 10000 (FinDonor) is a prospective study observing blood donor iron stores and genetic and lifestyle factors associated with iron stores.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001325> "A prospective cohort of whole-blood donors aged 18–70 recruited by the Finnish Red Cross Blood Service alongside standard donation at three fixed donation sites in the Helsinki metropolitan area of Finland (Kivihaka, Sanomatalo and Espoo) from May 2015 to December 2017, with blood samples taken at their donation visits during the study for blood counts, CRP, ferritin and soluble transferrin receptor and for DNA, and health and lifestyle questionnaires at enrolment and again in 2018, to study iron status and the genetic and lifestyle factors affecting iron stores in blood donors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001326> (<http://www.ebi.ac.uk/coho/COHO_0001326>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32499541") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34706593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34784307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35405960") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38413574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32499541") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7272447/fullTextXML") Annotation(rdfs:comment "All data have been collected by the Finnish Institute for Health and Welfare (THL), Finland (formerly the National Public Health Institute, KTL).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001326> "A national health examination survey of adults aged 18 or older living in mainland Finland, run by the Finnish Institute for Health and Welfare (THL) at 50 study locations between January and May 2017 in a representative sample drawn from the Population Register by one- and two-stage stratified random sampling, in which participants answered questionnaires on sociodemographic factors, health, quality of life, lifestyle, diseases and medication and attended a health examination with physical measurements and blood sampling, to monitor the health, functional capacity and welfare of the Finnish population and the prevalence and risk factors of common health problems. It combined the protocols of the FINRISK surveys and the Health 2000 and 2011 surveys.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32499541") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34706593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34784307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35405960") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38413574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35405960") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9002951/fullTextXML") Annotation(rdfs:comment "For the FinHealth 2017 Study, a representative sample of adults aged 18 years and above (n = 10,247) was drawn from the Population Register using one- and two-stage stratified, random sampling.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001326> "A national health examination survey of adults aged 18 or older living in mainland Finland, run by the Finnish Institute for Health and Welfare (THL) at 50 study locations between January and May 2017 in a representative sample drawn from the Population Register by one- and two-stage stratified random sampling, in which participants answered questionnaires on sociodemographic factors, health, quality of life, lifestyle, diseases and medication and attended a health examination with physical measurements and blood sampling, to monitor the health, functional capacity and welfare of the Finnish population and the prevalence and risk factors of common health problems. It combined the protocols of the FINRISK surveys and the Health 2000 and 2011 surveys.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32499541") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34706593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34784307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35405960") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38413574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35405960") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9002951/fullTextXML") Annotation(rdfs:comment "In brief, the FinHealth 2017 Study, a national health examination survey, was carried out in 50 study locations in mainland Finland between January and May 2017.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001326> "A national health examination survey of adults aged 18 or older living in mainland Finland, run by the Finnish Institute for Health and Welfare (THL) at 50 study locations between January and May 2017 in a representative sample drawn from the Population Register by one- and two-stage stratified random sampling, in which participants answered questionnaires on sociodemographic factors, health, quality of life, lifestyle, diseases and medication and attended a health examination with physical measurements and blood sampling, to monitor the health, functional capacity and welfare of the Finnish population and the prevalence and risk factors of common health problems. It combined the protocols of the FINRISK surveys and the Health 2000 and 2011 surveys.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32499541") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34706593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34784307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35405960") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38413574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38413574") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10899618/fullTextXML") Annotation(rdfs:comment "The data are collected in the form of health questionnaires and a formal health examination at a local health care center.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001326> "A national health examination survey of adults aged 18 or older living in mainland Finland, run by the Finnish Institute for Health and Welfare (THL) at 50 study locations between January and May 2017 in a representative sample drawn from the Population Register by one- and two-stage stratified random sampling, in which participants answered questionnaires on sociodemographic factors, health, quality of life, lifestyle, diseases and medication and attended a health examination with physical measurements and blood sampling, to monitor the health, functional capacity and welfare of the Finnish population and the prevalence and risk factors of common health problems. It combined the protocols of the FINRISK surveys and the Health 2000 and 2011 surveys.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32499541") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34706593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34784307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35405960") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38413574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38413574") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10899618/fullTextXML") Annotation(rdfs:comment "The national FinHealth 2017 study comprises a random sample of adults in Finland, and it focuses on objective and perceived health, quality of life, lifestyle, prevalence, and risk factors for common health problems including sleep, insomnia, and alcohol consumption.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001326> "A national health examination survey of adults aged 18 or older living in mainland Finland, run by the Finnish Institute for Health and Welfare (THL) at 50 study locations between January and May 2017 in a representative sample drawn from the Population Register by one- and two-stage stratified random sampling, in which participants answered questionnaires on sociodemographic factors, health, quality of life, lifestyle, diseases and medication and attended a health examination with physical measurements and blood sampling, to monitor the health, functional capacity and welfare of the Finnish population and the prevalence and risk factors of common health problems. It combined the protocols of the FINRISK surveys and the Health 2000 and 2011 surveys.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32499541") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34706593") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34784307") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35405960") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38413574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38413574") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10899618/fullTextXML") Annotation(rdfs:comment "The study combines questionnaires from earlier Health 2000–2011 and Finrisk collections.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001326> "A national health examination survey of adults aged 18 or older living in mainland Finland, run by the Finnish Institute for Health and Welfare (THL) at 50 study locations between January and May 2017 in a representative sample drawn from the Population Register by one- and two-stage stratified random sampling, in which participants answered questionnaires on sociodemographic factors, health, quality of life, lifestyle, diseases and medication and attended a health examination with physical measurements and blood sampling, to monitor the health, functional capacity and welfare of the Finnish population and the prevalence and risk factors of common health problems. It combined the protocols of the FINRISK surveys and the Health 2000 and 2011 surveys.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001327> (<http://www.ebi.ac.uk/coho/COHO_0001327>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31640839") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39920525") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31640839") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7108792/fullTextXML") Annotation(rdfs:comment "In the first stage, we conducted multiwave questionnaire research enrolling all eligible twins born in Finland during 1983–1987 along with their biological parents.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001327> "A population-based longitudinal cohort of the twins born in Finland in 1983–1987, the youngest of the three Finnish Twin Cohorts, identified through Finland's Central Population Registry and enrolled with their biological parents in the year they reached age 11, with twin, parent and teacher questionnaires and ratings at baseline and follow-up surveys at ages 14, 17, about 22 and about 37; a subset was studied intensively with in-school assessments and peer nominations at age 12, psychiatric interviews at ages 14 and 22, and neurocognitive tests and DNA collection in early adulthood. It was designed to identify individual, familial and school and neighbourhood risks for substance use before its onset and to follow trajectories of use, abuse and their consequences into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31640839") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39920525") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31640839") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7108792/fullTextXML") Annotation(rdfs:comment "The basic aim of the FT12 study design was to obtain information on individual, familial and school/neighborhood risks for substance use/abuse prior to the onset of regular tobacco and alcohol use and then track trajectories of use and abuse and their consequences into adulthood.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001327> "A population-based longitudinal cohort of the twins born in Finland in 1983–1987, the youngest of the three Finnish Twin Cohorts, identified through Finland's Central Population Registry and enrolled with their biological parents in the year they reached age 11, with twin, parent and teacher questionnaires and ratings at baseline and follow-up surveys at ages 14, 17, about 22 and about 37; a subset was studied intensively with in-school assessments and peer nominations at age 12, psychiatric interviews at ages 14 and 22, and neurocognitive tests and DNA collection in early adulthood. It was designed to identify individual, familial and school and neighbourhood risks for substance use before its onset and to follow trajectories of use, abuse and their consequences into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31640839") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39920525") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31640839") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7108792/fullTextXML") Annotation(rdfs:comment "This review offers an update on research conducted with FinnTwin12 (FT12), the youngest of the three Finnish Twin Cohorts.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001327> "A population-based longitudinal cohort of the twins born in Finland in 1983–1987, the youngest of the three Finnish Twin Cohorts, identified through Finland's Central Population Registry and enrolled with their biological parents in the year they reached age 11, with twin, parent and teacher questionnaires and ratings at baseline and follow-up surveys at ages 14, 17, about 22 and about 37; a subset was studied intensively with in-school assessments and peer nominations at age 12, psychiatric interviews at ages 14 and 22, and neurocognitive tests and DNA collection in early adulthood. It was designed to identify individual, familial and school and neighbourhood risks for substance use before its onset and to follow trajectories of use, abuse and their consequences into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31640839") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39920525") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31640839") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7108792/fullTextXML") Annotation(rdfs:comment "Twins enrolled into FT12 were born 1983 through 1987; they were identified through Finland’s Central Population Registry (CPR).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001327> "A population-based longitudinal cohort of the twins born in Finland in 1983–1987, the youngest of the three Finnish Twin Cohorts, identified through Finland's Central Population Registry and enrolled with their biological parents in the year they reached age 11, with twin, parent and teacher questionnaires and ratings at baseline and follow-up surveys at ages 14, 17, about 22 and about 37; a subset was studied intensively with in-school assessments and peer nominations at age 12, psychiatric interviews at ages 14 and 22, and neurocognitive tests and DNA collection in early adulthood. It was designed to identify individual, familial and school and neighbourhood risks for substance use before its onset and to follow trajectories of use, abuse and their consequences into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31640839") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39920525") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39920525") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11882652/fullTextXML") Annotation(rdfs:comment "FinnTwin12 (FT12) is a longitudinal, population-based study of Finnish twins born 1983–1987 and ascertained at ages 11–12 years old.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001327> "A population-based longitudinal cohort of the twins born in Finland in 1983–1987, the youngest of the three Finnish Twin Cohorts, identified through Finland's Central Population Registry and enrolled with their biological parents in the year they reached age 11, with twin, parent and teacher questionnaires and ratings at baseline and follow-up surveys at ages 14, 17, about 22 and about 37; a subset was studied intensively with in-school assessments and peer nominations at age 12, psychiatric interviews at ages 14 and 22, and neurocognitive tests and DNA collection in early adulthood. It was designed to identify individual, familial and school and neighbourhood risks for substance use before its onset and to follow trajectories of use, abuse and their consequences into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31640839") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39920525") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39920525") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11882652/fullTextXML") Annotation(rdfs:comment "Twins in the epidemiological sample were invited to participate in follow-up surveys when they were ages 14 (92% retention), 17 (75% retention), and 20–24 (mean age = 22 years, 66% retention).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001327> "A population-based longitudinal cohort of the twins born in Finland in 1983–1987, the youngest of the three Finnish Twin Cohorts, identified through Finland's Central Population Registry and enrolled with their biological parents in the year they reached age 11, with twin, parent and teacher questionnaires and ratings at baseline and follow-up surveys at ages 14, 17, about 22 and about 37; a subset was studied intensively with in-school assessments and peer nominations at age 12, psychiatric interviews at ages 14 and 22, and neurocognitive tests and DNA collection in early adulthood. It was designed to identify individual, familial and school and neighbourhood risks for substance use before its onset and to follow trajectories of use, abuse and their consequences into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31640839") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39920525") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0890856722001794-mmc2.docx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6133086/") Annotation(rdfs:comment "with follow-up of all twins at age 14 and 17½, as well as a later collection of questionnaires, psychiatric interviews and blood samples at age 22.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001327> "A population-based longitudinal cohort of the twins born in Finland in 1983–1987, the youngest of the three Finnish Twin Cohorts, identified through Finland's Central Population Registry and enrolled with their biological parents in the year they reached age 11, with twin, parent and teacher questionnaires and ratings at baseline and follow-up surveys at ages 14, 17, about 22 and about 37; a subset was studied intensively with in-school assessments and peer nominations at age 12, psychiatric interviews at ages 14 and 22, and neurocognitive tests and DNA collection in early adulthood. It was designed to identify individual, familial and school and neighbourhood risks for substance use before its onset and to follow trajectories of use, abuse and their consequences into adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001328> (<http://www.ebi.ac.uk/coho/COHO_0001328>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17452741") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18350156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34543398") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36682031") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17452741") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17452741+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Hearing was measured as a part of the Finnish Twin Study on Aging in 103 monozygotic (MZ) and 114 dizygotic (DZ) female twin pairs aged 63-76 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001328> "A study of the genetic and environmental effects on the disablement process in older women, in which female twin pairs aged 63–76, recruited from the Older Finnish Twin Cohort, took part in laboratory examinations of physical functioning, muscle strength and power, hearing and other health measures, with blood sampling, in Jyväskylä, Finland, in 2000–2001 and again at a 3-year follow-up, and have since been followed for mortality, by researchers of the Gerontology Research Center of the University of Jyväskylä.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17452741") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18350156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34543398") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36682031") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18350156") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2265555/fullTextXML") Annotation(rdfs:comment "103 monozygotic and 114 dizygotic female twin pairs (total n = 434 subjects) aged 63–76 years (mean 68.6 years, SE 0.16) were invited to laboratory investigations performed in Jyväskylä during 2000–2001.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001328> "A study of the genetic and environmental effects on the disablement process in older women, in which female twin pairs aged 63–76, recruited from the Older Finnish Twin Cohort, took part in laboratory examinations of physical functioning, muscle strength and power, hearing and other health measures, with blood sampling, in Jyväskylä, Finland, in 2000–2001 and again at a 3-year follow-up, and have since been followed for mortality, by researchers of the Gerontology Research Center of the University of Jyväskylä.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17452741") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18350156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34543398") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36682031") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36682031") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10395559/fullTextXML") Annotation(rdfs:comment "The FITSA was set up to investigate genetic and environmental effects on the disablement process in older female twins.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001328> "A study of the genetic and environmental effects on the disablement process in older women, in which female twin pairs aged 63–76, recruited from the Older Finnish Twin Cohort, took part in laboratory examinations of physical functioning, muscle strength and power, hearing and other health measures, with blood sampling, in Jyväskylä, Finland, in 2000–2001 and again at a 3-year follow-up, and have since been followed for mortality, by researchers of the Gerontology Research Center of the University of Jyväskylä.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17452741") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18350156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34543398") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36682031") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36682031") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10395559/fullTextXML") Annotation(rdfs:comment "The mortality follow-up began on the date the participant participated in the laboratory measurements and the blood sampling for the genome-wide DNAm analysis was conducted (from 2000 to 2001).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001328> "A study of the genetic and environmental effects on the disablement process in older women, in which female twin pairs aged 63–76, recruited from the Older Finnish Twin Cohort, took part in laboratory examinations of physical functioning, muscle strength and power, hearing and other health measures, with blood sampling, in Jyväskylä, Finland, in 2000–2001 and again at a 3-year follow-up, and have since been followed for mortality, by researchers of the Gerontology Research Center of the University of Jyväskylä.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17452741") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18350156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34543398") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36682031") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36682031") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10395559/fullTextXML") Annotation(rdfs:comment "The participants in the FITSA were recruited from the Older Finnish Twin Cohort, which is comprised of all same-sex twin pairs born before 1958 with both co-twins alive in 1975 (24).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001328> "A study of the genetic and environmental effects on the disablement process in older women, in which female twin pairs aged 63–76, recruited from the Older Finnish Twin Cohort, took part in laboratory examinations of physical functioning, muscle strength and power, hearing and other health measures, with blood sampling, in Jyväskylä, Finland, in 2000–2001 and again at a 3-year follow-up, and have since been followed for mortality, by researchers of the Gerontology Research Center of the University of Jyväskylä.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17452741") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18350156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34543398") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36682031") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.cambridge.org/core/journals/twin-research-and-human-genetics/article/older-finnish-twin-cohort-45-years-of-followup/94760871D9703AF3A974BB8E32B0180F") Annotation(rdfs:comment "First follow-up measurements of FITSA were conducted after 3 years, in 2003–2004.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001328> "A study of the genetic and environmental effects on the disablement process in older women, in which female twin pairs aged 63–76, recruited from the Older Finnish Twin Cohort, took part in laboratory examinations of physical functioning, muscle strength and power, hearing and other health measures, with blood sampling, in Jyväskylä, Finland, in 2000–2001 and again at a 3-year follow-up, and have since been followed for mortality, by researchers of the Gerontology Research Center of the University of Jyväskylä.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001329> (<http://www.ebi.ac.uk/coho/COHO_0001329>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23382860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27598322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29089348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40973091") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001133/phs001133.v1.p1/GapExchange_phs001133.v1.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23382860") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3559692/") Annotation(rdfs:comment "We also analyzed data from the Follow-up of Ovarian Cancer Genetic Association and Interaction Studies (FOCI) collaboration which is part of the National Cancer Institute GAME-ON Post-GWAS initiative and is described elsewhere [26], [27].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001329> "A post-GWAS research programme on epithelial ovarian cancer, funded by the US National Cancer Institute (U19-CA148112) as the ovarian cancer consortium of the Genetic Associations and Mechanisms in Oncology (GAME-ON) initiative, led from Moffitt Cancer Center and built on the collaboration of the Ovarian Cancer Association Consortium, that pools genome-wide and further genotyping data (including exome-chip and OncoArray genotyping) from the case-control studies of that consortium, to discover and replicate susceptibility variants, including histotype-specific variants and variants associated with survival, to study their biological mechanisms, and to investigate gene–gene and gene–environment interactions and risk prediction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23382860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27598322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29089348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40973091") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001133/phs001133.v1.p1/GapExchange_phs001133.v1.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001133/phs001133.v1.p1/GapExchange_phs001133.v1.p1.xml") Annotation(rdfs:comment "By pooling GWAS, we expect to identify new associations and achieve independent replication, explore whether there are risk variants specific for histologic subtypes, and evaluate structural polymorphisms - copy number variants - as risk factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001329> "A post-GWAS research programme on epithelial ovarian cancer, funded by the US National Cancer Institute (U19-CA148112) as the ovarian cancer consortium of the Genetic Associations and Mechanisms in Oncology (GAME-ON) initiative, led from Moffitt Cancer Center and built on the collaboration of the Ovarian Cancer Association Consortium, that pools genome-wide and further genotyping data (including exome-chip and OncoArray genotyping) from the case-control studies of that consortium, to discover and replicate susceptibility variants, including histotype-specific variants and variants associated with survival, to study their biological mechanisms, and to investigate gene–gene and gene–environment interactions and risk prediction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23382860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27598322") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29089348") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40973091") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001133/phs001133.v1.p1/GapExchange_phs001133.v1.p1.xml") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ftp.ncbi.nlm.nih.gov/dbgap/studies/phs001133/phs001133.v1.p1/GapExchange_phs001133.v1.p1.xml") Annotation(rdfs:comment "Follow-up of Ovarian Cancer Genetic Association and Interaction Studies (FOCI) Case-Control (Excerpted/paraphrased from original grant application): FOCI seeks to expand our understanding of epithelial ovarian cancer through a coordinated and comprehensive approach.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001329> "A post-GWAS research programme on epithelial ovarian cancer, funded by the US National Cancer Institute (U19-CA148112) as the ovarian cancer consortium of the Genetic Associations and Mechanisms in Oncology (GAME-ON) initiative, led from Moffitt Cancer Center and built on the collaboration of the Ovarian Cancer Association Consortium, that pools genome-wide and further genotyping data (including exome-chip and OncoArray genotyping) from the case-control studies of that consortium, to discover and replicate susceptibility variants, including histotype-specific variants and variants associated with survival, to study their biological mechanisms, and to investigate gene–gene and gene–environment interactions and risk prediction.")
