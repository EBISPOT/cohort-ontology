# Individual: <http://www.ebi.ac.uk/coho/COHO_0000378> (<http://www.ebi.ac.uk/coho/COHO_0000378>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17351290") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000378> "A cohort of older men and women born in 1907–1935, drawn from the population-based Reykjavik Study followed in Iceland by the Icelandic Heart Association and re-examined from 2002 with detailed cardiovascular, neurocognitive, musculoskeletal and metabolic phenotypes to study genetic susceptibility and gene–environment interaction in disease and disability in old age.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000379> (<http://www.ebi.ac.uk/coho/COHO_0000379>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38172904") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://med.stanford.edu/adrc.html") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000379> "A cohort of research participants followed by the Stanford Alzheimer's Disease Research Center, one of the US National Institutes of Health-funded Alzheimer's Disease Research Centers, whose clinical and research focus spans Alzheimer disease and Lewy body disorders, contributing cerebrospinal fluid proteomic and whole-genome sequence data to genetic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000380> (<http://www.ebi.ac.uk/coho/COHO_0000380>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31633757") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000380> "A national stratified cohort of 51,338 women and men aged 45–85 years recruited in 2011–2015 from all 10 Canadian provinces, comprising a telephone-interviewed Tracking cohort and an in-person Comprehensive cohort providing physical assessments and blood and urine samples, assembled as a longitudinal research platform for studying health and aging.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000381> (<http://www.ebi.ac.uk/coho/COHO_0000381>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16320381") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000381> "A community-based cohort of 5,302 African American adults, including a nested family cohort, enrolled from the three counties of the Jackson, Mississippi metropolitan area, with extensive medical, social, physical and biochemical measurements and genomic DNA, to study cardiovascular and related diseases in African Americans.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000382> (<http://www.ebi.ac.uk/coho/COHO_0000382>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37794186") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000382> "A sub-cohort of 54,219 UK Biobank participants, mostly a random selection of baseline participants plus individuals chosen by consortium members and participants in the COVID-19 repeat-imaging study, whose plasma proteomes were profiled by the UK Biobank Pharma Proteomics Project, a precompetitive consortium of biopharmaceutical companies, to map genetic and health associations of circulating proteins.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000383> (<http://www.ebi.ac.uk/coho/COHO_0000383>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41298473") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000383> "A healthcare-based biobank of more than 140,000 consenting patients of the Mass General Brigham network in the Greater Boston area of Massachusetts, enrolled since 2010 at Massachusetts General Hospital, Brigham and Women’s Hospital and local sites, linking biological samples, genomic data and health records to study genetic and environmental influences on disease in clinical practice.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000384> (<http://www.ebi.ac.uk/coho/COHO_0000384>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1669507") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36314488") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000384> "A population-based longitudinal cohort of men and women aged 65 years and older sampled from Medicare eligibility lists in four US communities (Forsyth County, North Carolina; Sacramento County, California; Washington County, Maryland; Pittsburgh, Pennsylvania) from 1989, with mostly Black participants added in 1992–1993, to identify factors related to the onset and course of coronary heart disease and stroke in older adults.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000385> (<http://www.ebi.ac.uk/coho/COHO_0000385>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26705418") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39350372") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000385> "A community-based, multi-generational cohort of residents of Framingham, Massachusetts, begun with the Original Cohort in 1948 and extended by the Offspring (1971), Third Generation (2002) and OMNI cohorts, examined every 2–4 years to define cardiovascular disease risk factors and, increasingly, the genetic and molecular epidemiology of a wide range of diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000386> (<http://www.ebi.ac.uk/coho/COHO_0000386>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13135507/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000386> "An ongoing population-based cohort of people aged 30 or above living in two geographically defined areas of Bonn, Germany, invited in random order by the German Centre for Neurodegenerative Diseases (DZNE) for deep phenotyping, imaging and omics studies of health and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000387> (<http://www.ebi.ac.uk/coho/COHO_0000387>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23043162") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000387> "The German centre of the European Prospective Investigation into Cancer and Nutrition, a cohort of 27,548 adults from the general population around Potsdam in eastern Germany, mostly aged 35–65 at recruitment in 1994–1998, followed up prospectively to study diet, metabolism and chronic diseases such as type 2 diabetes and cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000388> (<http://www.ebi.ac.uk/coho/COHO_0000388>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20609343") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000388> "A multicentre community-based cohort of about 16,000 men and women aged 18–74 who self-identify as Hispanic or Latino, recruited from random samples of households in the Bronx, Chicago, Miami and San Diego in the United States, to study the prevalence of and risk factors for cardiovascular, pulmonary, metabolic and other chronic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000389> (<http://www.ebi.ac.uk/coho/COHO_0000389>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35668104") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000389> "A community-based longitudinal cohort of residents of the town and Shire of Busselton in south-western Western Australia, surveyed since 1966 and including related and unrelated individuals of predominantly European ancestry, whose 1994/95 follow-up provided blood samples for genetic studies of cardiovascular, respiratory and metabolic traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000390> (<http://www.ebi.ac.uk/coho/COHO_0000390>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12987725/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000390> "A Swedish research infrastructure combining two large ongoing population-based cohorts, the Cohort of Swedish Men and the Swedish Mammography Cohort, whose randomly selected subsamples from Västmanland and Uppsala were clinically examined with genotyping and biosampling for life-course studies of health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000391> (<http://www.ebi.ac.uk/coho/COHO_0000391>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26096600") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000391> "A national multicentre cohort of about 30,000 Swedish men and women aged 50–64, characterised with imaging, large-scale omics and epidemiological data to improve risk prediction of cardiopulmonary diseases and study their mechanisms.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000392> (<http://www.ebi.ac.uk/coho/COHO_0000392>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33222051") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000392> "A family cohort of about 4,700 adults aged 18–71, the children and grandchildren of Malmö Diet and Cancer Study participants in Malmö, Sweden, examined from 2013 with genotyping, cardiovascular, respiratory, metabolic, cognitive, dietary and microbiota phenotyping to study family traits of chronic disease across three generations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000393> (<http://www.ebi.ac.uk/coho/COHO_0000393>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28119442") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000393> "A population-based cohort of 10,197 middle-aged and older Finnish men from a single site in north-eastern Finland, examined in 2005–2010 with detailed metabolic phenotyping, oral glucose tolerance tests, metabolomics and extensive genotyping and sequencing, and followed up to study nongenetic and genetic risk factors for type 2 diabetes and cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000394> (<http://www.ebi.ac.uk/coho/COHO_0000394>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34428338") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000394> "A national whole-genome sequencing programme of the Qatar Foundation that sequences volunteers from the Qatar Biobank and combines their genomes with the biobank's phenotype data to study the Qatari and wider Arab and Middle Eastern populations at the molecular level.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000395> (<http://www.ebi.ac.uk/coho/COHO_0000395>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35578897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000395> "A population-based cohort of the adult population of Trøndelag County, Norway, in which all residents of Nord-Trøndelag aged 20 or over have been invited to repeated surveys since 1984–86, extended to Sør-Trøndelag in 2017–19, collecting questionnaires, interviews, clinical examinations, laboratory measurements and biological samples on a broad range of health topics.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000396> (<http://www.ebi.ac.uk/coho/COHO_0000396>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29420931") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000396> "A cohort of individuals with a professional diagnosis of autism spectrum disorder living in the United States, together with their parents and unaffected siblings, recruited online by the Simons Foundation Autism Research Initiative (SFARI) to collect genomic, medical and longitudinal behavioural data and to connect participants with researchers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000397> (<http://www.ebi.ac.uk/coho/COHO_0000397>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12819321") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000397> "A cohort of racially and ethnically diverse adults aged 21 to 74 with chronic kidney disease, recruited at seven clinical centres in the United States from 2003 and followed with annual clinical evaluations and biospecimen collection to examine risk factors for the progression of chronic kidney disease and cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000398> (<http://www.ebi.ac.uk/coho/COHO_0000398>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.scallop-consortium.com/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000398> "A consortium of principal investigators of cohort studies from the general population, clinical trials and disease-specific patient collections that have Olink proteomics and genome-wide genotyping data, combining summary-level data to discover and follow up genetic associations with plasma protein levels (pQTLs) and identify causal protein biomarkers of disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000399> (<http://www.ebi.ac.uk/coho/COHO_0000399>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40465716") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000399> "A hospital-based cohort of about 413,000 patients of China Medical University Hospital and its affiliated branches in Taichung, Taiwan, genotyped on a custom Taiwan Precision Medicine array and linked to electronic medical records from 2003 to 2021 (the HiGenome resource), assembled for genome-wide, phenome-wide and polygenic risk score studies in the Taiwanese Han population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000400> (<http://www.ebi.ac.uk/coho/COHO_0000400>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29865057") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000400> "A pair of harmonized longitudinal clinical-pathologic cohort studies of aging and Alzheimer's disease run at Rush University, the Religious Orders Study (from 1994, nuns, priests and brothers from across the United States) and the Rush Memory and Aging Project (from 1997, lay persons from northeastern Illinois), whose older participants enrol without dementia and agree to annual clinical evaluations and organ donation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000401> (<http://www.ebi.ac.uk/coho/COHO_0000401>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31699749") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000401> "A clinic-based prospective cohort of about 57,000 adult Mayo Clinic patients who are US residents, enrolled at Rochester, Minnesota, Jacksonville, Florida and La Crosse, Wisconsin, established to supply control groups for case-control studies, form a prospective cohort for common outcomes and support electronic health record and genotype-driven research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000402> (<http://www.ebi.ac.uk/coho/COHO_0000402>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39753034") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000402> "A cohort of Danish children and adolescents combining an obesity clinic cohort treated at the Children's Obesity Clinic, Copenhagen University Hospital Holbæk, and a population-based cohort recruited from schools in 11 municipalities in Zealand, enrolled between 2009 and 2019 with genotyping and deep cardiometabolic phenotyping to study the causes and consequences of childhood obesity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000403> (<http://www.ebi.ac.uk/coho/COHO_0000403>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36653562") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000403> "A public–private partnership research project in Finland that combines genotype data from newly collected and legacy samples of about 500,000 participants of a nationwide network of Finnish biobanks with digital health data from national health registers, to provide genetic insights into disease in an isolated population enriched for low-frequency variants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000404> (<http://www.ebi.ac.uk/coho/COHO_0000404>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32581362") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000404> "A cohort of patients with rare diseases or extreme measurements of quantitative traits, their affected relatives and controls, enrolled mainly at National Health Service hospitals in the United Kingdom between 2012 and 2017 under the coordination of the NIHR BioResource at the University of Cambridge, whose whole genomes were sequenced to provide genetic diagnoses and discover aetiological variants within routine healthcare.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000405> (<http://www.ebi.ac.uk/coho/COHO_0000405>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19470201") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000405> "A longitudinal cohort of volunteers aged over 60 in Australia, including people with Alzheimer's disease, mild cognitive impairment and healthy controls, recruited at centres in Perth and Melbourne and reassessed at 18-month intervals with cognitive testing, blood biomarkers, lifestyle questionnaires and amyloid PET and MRI imaging to study predictors of Alzheimer's disease and cognitive decline.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000406> (<http://www.ebi.ac.uk/coho/COHO_0000406>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16490960") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000406> "A population-based biobank in the most northern part of Germany, run from Kiel University, that recruits patients through complete ascertainment in a geographically confined area together with population controls, covering cardiovascular, neuropsychiatric and environmental diseases, to estimate population-specific genotypic risks for complex diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000407> (<http://www.ebi.ac.uk/coho/COHO_0000407>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31146758") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000407> "A cohort of outpatients with type 2 diabetes of Chinese, Malay and Asian Indian ancestry recruited from the diabetes centre of a regional hospital in Singapore between 2004 and 2015 to study the development and progression of diabetic nephropathy and of major cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000408> (<http://www.ebi.ac.uk/coho/COHO_0000408>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38059349") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000408> "A prospective cohort of adults with type 2 diabetes of Chinese, Malay, Indian and other ancestry recruited in 2011–2014 from a public hospital and primary care polyclinics in northern Singapore and followed in three-yearly waves to study risk factors for vascular function and diabetes-related complications such as kidney disease, retinopathy and cognitive dysfunction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000409> (<http://www.ebi.ac.uk/coho/COHO_0000409>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9492970") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000409> "A cohort of postmenopausal women aged 50–79 enrolled from 1993 at 40 clinical centres across the United States into a clinical trial of dietary modification, hormone therapy and calcium and vitamin D supplementation or into a parallel observational study, followed to study the prevention of cancer, cardiovascular disease and osteoporotic fractures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000410> (<http://www.ebi.ac.uk/coho/COHO_0000410>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39085387") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000410> "A population-based cohort of adults aged 20–79 sampled from Western Pomerania, a rural region of north-eastern Germany, and recruited in 2008–2012 as the second, independent cohort of the Study of Health in Pomerania, examined at baseline and followed up to study health, disease and their risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000411> (<http://www.ebi.ac.uk/coho/COHO_0000411>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42753719") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000411> "A consortium of six Korean cohorts, population-based and gene–environment model studies initiated from 2001 with about 245,000 participants, investigating the genetic and environmental determinants of health, disease and ageing in the Korean population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000412> (<http://www.ebi.ac.uk/coho/COHO_0000412>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23576214") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000412> "A population-based prospective cohort of 6,673 men and women aged 45–65 from the greater area of Leiden, the Netherlands, oversampling people with overweight or obesity, recruited in 2008–2012 for extensive phenotyping to investigate the pathways that lead to obesity-related diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000413> (<http://www.ebi.ac.uk/coho/COHO_0000413>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29322089") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000413> "A longitudinal observational cohort of middle-aged adults enriched for persons with a parental history of probable Alzheimer disease dementia, enrolled since 2001 at the University of Wisconsin–Madison, United States, and followed with serial cognitive assessments, medical and lifestyle histories, laboratory tests, genetics and linked imaging and cerebrospinal fluid studies to study the early course of Alzheimer disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000414> (<http://www.ebi.ac.uk/coho/COHO_0000414>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33437055") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000414> "A longitudinal cohort of middle-aged and older adults recruited into diagnostic and risk subgroups by the Wisconsin Alzheimer's Disease Research Center at the University of Wisconsin-Madison, United States, to study memory, aging and Alzheimer disease, with cerebrospinal fluid biomarker, metabolomic and genotype data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000415> (<http://www.ebi.ac.uk/coho/COHO_0000415>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36245062") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000415> "A cohort of 1,795 adults aged 18–83 from the Kiel region of northern Germany, enrolled in 2011–2014 at random via residents' registration offices and via the Obesity Outpatient Centre of the University Medical Center Schleswig-Holstein, for population-based research on metabolic inflammation with multi-omics, nutrition and follow-up every five years.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000416> (<http://www.ebi.ac.uk/coho/COHO_0000416>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8989972/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000416> "A research programme of the University of Maryland studying adults of the Old Order Amish founder population of Lancaster County, Pennsylvania, of whom over 7,000 have taken part in one or more of its studies of the genetics of complex diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000417> (<http://www.ebi.ac.uk/coho/COHO_0000417>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18500243") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000417> "A biobank of Vanderbilt University Medical Center patients in Nashville, Tennessee, whose DNA, extracted from discarded clinical blood samples under an opt-out model, is linked to a de-identified copy of their electronic medical records (the synthetic derivative) for genomic and personalised-medicine research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000418> (<http://www.ebi.ac.uk/coho/COHO_0000418>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10874717/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000418> "A tri-ethnic longitudinal cohort of people of European, South Asian and African Caribbean ethnicity living in West and North London, United Kingdom, set up in 1988 to examine ethnic differences in chronic disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000419> (<http://www.ebi.ac.uk/coho/COHO_0000419>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35654907") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000419> "A cohort of consecutively recruited patients with a history of harmful drinking and early, asymptomatic alcohol-related liver disease, together with matched healthy participants, recruited in the Region of Southern Denmark by the EU Horizon 2020 GALAXY consortium to study the gut–liver axis and non-invasive markers of alcohol-related liver fibrosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000420> (<http://www.ebi.ac.uk/coho/COHO_0000420>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38115890") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000420> "A population-based cohort of 3,596 randomly selected Finnish children and adolescents aged 3–18 years at baseline in 1980, followed into adulthood for over three decades to study how cardiovascular risk factors in childhood relate to preclinical markers of cardiovascular disease in adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000421> (<http://www.ebi.ac.uk/coho/COHO_0000421>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31271446") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000421> "A population-based case–control study of colorectal cancer in Scotland, recruiting colorectal cancer cases and population controls since 1999, whose genotyped cases are followed for survival, used to study genetic susceptibility to colorectal cancer and its outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000422> (<http://www.ebi.ac.uk/coho/COHO_0000422>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37601966") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000422> "A population-based prospective cohort of more than 512,000 adults recruited in 2004–2008 from 10 geographically diverse regions of China, with baseline questionnaires and physical measurements, periodic resurveys, genome-wide genotyping of over 100,000 participants and electronic linkage to death, disease and health-insurance records, supporting studies of disease risk factors, genetics and drug targets.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000423> (<http://www.ebi.ac.uk/coho/COHO_0000423>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31412182") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000423> "A national research cohort led by the National Institutes of Health that aims to enrol at least one million diverse adults in the United States, most from groups historically under-represented in biomedical research, through more than 340 recruitment sites, collecting health questionnaires, electronic health records, physical measurements, digital health data and biospecimens to advance precision medicine.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000424> (<http://www.ebi.ac.uk/coho/COHO_0000424>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36216889") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000424> "An electronic health record-linked biobank founded in 2007 at the Icahn School of Medicine at Mount Sinai that enrols participants non-selectively from the Mount Sinai Health System in New York City, comprising about 60,000 ancestrally diverse participants with genotype and sequence data for genetic and clinical research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000425> (<http://www.ebi.ac.uk/coho/COHO_0000425>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32692748") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000425> "A prospective cohort of young adults aged 18–30 years, balanced by sex and by Black and White race, recruited in 1985–1986 at four field centres in Birmingham, Alabama, Chicago, Illinois, Minneapolis, Minnesota and Oakland, California, and followed with repeated examinations into midlife to study the development of cardiovascular risk factors and disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000426> (<http://www.ebi.ac.uk/coho/COHO_0000426>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41469377") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000426> "A prospective population-based cohort of 10,004 men and women of Chinese, Indian or Malay background aged 30–84, recruited from the Singapore general population in 2018–2022 by Nanyang Technological University, with behavioural, phenotypic and multi-omic measurements and health-record linkage for precision-medicine research in Asian populations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000427> (<http://www.ebi.ac.uk/coho/COHO_0000427>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23155414") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000427> "A family-based longitudinal cohort of index probands with laboratory-confirmed obstructive sleep apnoea, their relatives, and neighbourhood control families recruited from the Cleveland metropolitan area, Ohio, with four examinations between 1990 and 2006, designed to study the familial and genetic basis of sleep-disordered breathing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000428> (<http://www.ebi.ac.uk/coho/COHO_0000428>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28596592") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000428> "A population sample of Icelanders recruited through the disease-specific and general-population research projects of deCODE genetics in Reykjavik, Iceland, including the deCODE Health Study, whose chip genotypes and whole-genome sequences, combined with the nationwide Icelandic genealogy, are used for genome-wide association studies of diseases and other traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000429> (<http://www.ebi.ac.uk/coho/COHO_0000429>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27798002") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000429> "A retrospective, multicentre case–control study of adults with chronic low back pain and controls, recruited at clinical pain centres in Italy, Croatia, Belgium, Australia and the United States within the European Union FP7-funded PainOMICS project, collecting clinical data and blood samples for genome-wide association, glycomics and activomics analyses of chronic low back pain.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000430> (<http://www.ebi.ac.uk/coho/COHO_0000430>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8640022/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000430> "A population-based cohort from a set of religiously and geographically isolated mountainous Pomak villages in northern Greece, part of the Hellenic Isolated Cohorts (HELIC), whose whole-genome sequence and serum protein data are used to study genetic variation and complex traits in an isolated population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000431> (<http://www.ebi.ac.uk/coho/COHO_0000431>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33778338") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000431> "A multi-ethnic cohort of over 100,000 adult members of the Kaiser Permanente Northern California health plan who consented to the Research Program on Genes, Environment and Health (RPGEH), linking survey data, saliva-derived DNA with genome-wide genotypes and telomere length, and electronic health records for research on the genetic and environmental determinants of common age-related diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000432> (<http://www.ebi.ac.uk/coho/COHO_0000432>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29930244") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000432> "A cohort of about 320 healthy adult Europeans visiting the Academic Hospital of the University of Liège, Belgium, as part of a national colon-cancer screening campaign, from whom peripheral blood and intestinal biopsies were collected to generate transcriptomes of circulating immune cell types and gut tissues for expression quantitative trait locus analysis of inflammatory bowel disease risk loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000433> (<http://www.ebi.ac.uk/coho/COHO_0000433>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29040551") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000433> "A family-based population cohort of 24,084 adults recruited throughout Scotland in 2006–2011 by Generation Scotland, a multi-institutional collaboration of universities and the NHS, who were extensively phenotyped and genotyped to study the genetics of common health conditions such as heart disease, stroke and depression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000434> (<http://www.ebi.ac.uk/coho/COHO_0000434>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15121494") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039093") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000434> "A community-based family study of hypertensive sibships, recruited from 1996 among non-Hispanic Black adults in Jackson, Mississippi, non-Hispanic white adults in Rochester, Minnesota and (initially) Hispanic adults in Starr County, Texas, to identify genes influencing blood pressure and hypertensive target-organ damage.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000435> (<http://www.ebi.ac.uk/coho/COHO_0000435>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39820013") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.oulu.fi/en/university/faculties-and-units/faculty-medicine/northern-finland-birth-cohorts-and-arctic-biobank") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000435> "A longitudinal research programme of the University of Oulu comprising two general-population birth cohorts from the two northernmost provinces of Finland, Oulu and Lapland, the Northern Finland Birth Cohort 1966 (NFBC1966) and 1986 (NFBC1986), whose members have been followed since the fetal period to study health and well-being.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000436> (<http://www.ebi.ac.uk/coho/COHO_0000436>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36776991") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000436> "An ongoing prospective population biobank of more than 150,000 predominantly Han Chinese volunteers aged 20-70 recruited across Taiwan, with questionnaire, physical-measurement, biomarker and genome-wide genetic data and linkage to national health insurance records, built as a resource for biomedical and public health research in East Asia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000437> (<http://www.ebi.ac.uk/coho/COHO_0000437>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35130028") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10618167/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000437> "A prospective cohort of about 7,300 adults aged 45-66 recruited in southern Finland in 2015-2017 (from the Kymenlaakso population register, occupational health care customers in Helsinki and Turku, and blood donors) to assess the impact of communicating genetic risk information for cardiovascular disease to participants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000438> (<http://www.ebi.ac.uk/coho/COHO_0000438>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20828101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000438> "A community-based prospective longitudinal study of 3,722 socioeconomically diverse African American and white adults aged 30-64 recruited in Baltimore, Maryland, examining how race, socioeconomic status, sex and age influence health and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000439> (<http://www.ebi.ac.uk/coho/COHO_0000439>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10014487/unicode") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC9214725/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000439> "A cross-sectional cohort of about 1,200 adults with Crohn's disease or ulcerative colitis and non-IBD controls, prospectively recruited at endoscopy visits to the outpatient and endoscopy units of the Mount Sinai Hospital between December 2013 and September 2016, with intestinal biopsies, blood and genotype data for molecular studies of inflammatory bowel disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000440> (<http://www.ebi.ac.uk/coho/COHO_0000440>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18763692") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000440> "A multi-site naturalistic longitudinal cohort of 2,981 adults aged 18-65 with current or lifetime depressive or anxiety disorders, people at risk and healthy controls, recruited in the general population, general practices and mental health organisations, to describe the long-term course and consequences of depressive and anxiety disorders and integrate biological and psychosocial predictors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000441> (<http://www.ebi.ac.uk/coho/COHO_0000441>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32396194") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40044514") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000441> "A prospective cohort of 3,075 community-dwelling Black and white adults aged 70-79, recruited from 1997 from white Medicare beneficiaries and all eligible Black residents in and around Pittsburgh, Pennsylvania and Memphis, Tennessee, and followed for about 17 years to study body composition, functional decline and disease in older age.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000442> (<http://www.ebi.ac.uk/coho/COHO_0000442>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36819667") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000442> "A single-health-system biobank of more than 91,000 adult patients recruited mainly during surgical encounters at Michigan Medicine, the University of Michigan health system, linking genotypes to electronic health records for disease genetics research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000443> (<http://www.ebi.ac.uk/coho/COHO_0000443>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10689278/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13340790/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000443> "A case-control study of mothers and children born at Kaiser Permanente Northern California from January 2011 to January 2016, oversampling children later diagnosed with autism spectrum disorder or other developmental delay alongside general-population controls, with maternal first- and second-trimester blood samples from the RPGEH pregnancy cohort, to study maternal immune and metabolic markers and child neurodevelopment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000444> (<http://www.ebi.ac.uk/coho/COHO_0000444>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20031568") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000444> "A consortium of large prospective population-based cohort studies from the United States and Europe, founded with the Age, Gene/Environment Susceptibility-Reykjavik Study, the Atherosclerosis Risk in Communities Study, the Cardiovascular Health Study, the Framingham Heart Study and the Rotterdam Study, formed to facilitate genome-wide association meta-analyses and replication across cohorts with similarly measured phenotypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000445> (<http://www.ebi.ac.uk/coho/COHO_0000445>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27699078") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6416302/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000445> "A birth cohort of the 13,345 singletons born in one of the two maternity hospitals in Helsinki, Finland, between 1934 and 1944, followed up in later life to study how early life shapes adult health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000446> (<http://www.ebi.ac.uk/coho/COHO_0000446>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28070760") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000446> "A population-based prospective cohort from fetal life onwards of 9,778 mothers with delivery dates from April 2002 to January 2006 in Rotterdam, the Netherlands, and their children, designed to identify early environmental and genetic causes of normal and abnormal growth, development and health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000447> (<http://www.ebi.ac.uk/coho/COHO_0000447>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27814508") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000447> "A cohort of about 500 healthy adult volunteers of Western European ancestry recruited at Radboud University Medical Center in Nijmegen, the Netherlands, in 2013–2014 within the Human Functional Genomics Project, to study how genetic, environmental, host and microbiome factors shape individual cytokine and immune responses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000448> (<http://www.ebi.ac.uk/coho/COHO_0000448>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26866580") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000448> "A biobank cohort of patients of Geisinger Health System, an integrated health system in central and eastern Pennsylvania, United States, who since 2007 have given opt-in consent to link their samples to electronic health record data for broad research use, with genotype and exome sequence data generated in collaboration with the Regeneron Genetics Center.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000449> (<http://www.ebi.ac.uk/coho/COHO_0000449>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34728798") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000449> "A cohort of customers of 23andMe, Inc., a direct-to-consumer genetics company, who have been genotyped and have consented to take part in online research, answering web-based questionnaires under an IRB-approved protocol, whose genotype and self-reported data are used for genome-wide association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000450> (<http://www.ebi.ac.uk/coho/COHO_0000450>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26197779") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000450> "A population-based cohort of 10,000 randomly selected adults, mainly aged 40–79, from the city of Leipzig in eastern Germany, examined in 2011–2014 by the Leipzig Research Centre for Civilization Diseases (LIFE) with deep phenotyping to study the prevalence, early markers, genetic predispositions and lifestyle factors of major civilization diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000451> (<http://www.ebi.ac.uk/coho/COHO_0000451>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36395887") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000451> "A cohort of more than 12,000 volunteer blood donors of diverse ancestry enrolled at four blood centres across the United States within the NHLBI-funded Recipient Epidemiology and Donor Evaluation Study (REDS-III), to study how donor genetics and biology affect the storage quality and haemolysis of donated red blood cells.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000452> (<http://www.ebi.ac.uk/coho/COHO_0000452>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20971364") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000452> "A prospective cohort of consecutive Finnish patients referred for coronary angiography at Helsinki University Central Hospital in 2006–2008, assembled to study the genetic predisposition to coronary heart disease; its acute coronary syndrome cases, with controls sampled from FINRISK, form a genotyped case-control sample.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000453> (<http://www.ebi.ac.uk/coho/COHO_0000453>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24969107") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000453> "A case-control sub-cohort of the Finnish Health 2000 survey, collected in 2000–2001, comprising participants with metabolic syndrome and matched controls, genotyped to study the genetics of metabolic syndrome and related traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000454> (<http://www.ebi.ac.uk/coho/COHO_0000454>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26049400") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000454> "A cross-sectional case–control study of 374 people with and without type 2 diabetes, of Arab and Asian descent, enrolled in February–June 2012 at the Dermatology Department of Hamad Medical Corporation in Doha, Qatar, with metabolomic profiling of saliva, blood plasma and urine to study metabolic dysregulation in diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000455> (<http://www.ebi.ac.uk/coho/COHO_0000455>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35312098") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000455> "A prospective family-based cohort, begun in 1983 at Johns Hopkins, of European American and African American families of probands with premature coronary disease identified in Baltimore-area hospitals, studied to determine the environmental, phenotypic and genetic causes of premature cardiovascular disease, including platelet response to a two-week aspirin trial.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000456> (<http://www.ebi.ac.uk/coho/COHO_0000456>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27459450") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000456> "A prospective cohort of 121,700 female registered nurses in the United States aged 30–55 when enrolled through a baseline questionnaire in 1976, followed by repeated questionnaires and biospecimen collection to study lifestyle and other risk factors for major chronic diseases in women.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000457> (<http://www.ebi.ac.uk/coho/COHO_0000457>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36556195") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000457> "An electronic health record-linked biobank cohort of more than 170,000 patients of the University of Pennsylvania Health System (Penn Medicine), about 30% of non-European ancestry, who consented to link their health records to genomic and biomarker data and to recontact, for genomic discovery and precision medicine research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000458> (<http://www.ebi.ac.uk/coho/COHO_0000458>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37326842") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000458> "A population-based case-control study established in Sweden in 1996, enrolling incident rheumatoid arthritis cases (now more than 5000) from the middle and southern regions of Sweden together with population controls, used to study genetic risk factors for rheumatoid arthritis and its ACPA-defined subsets and environmental factors such as cigarette smoking.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000459> (<http://www.ebi.ac.uk/coho/COHO_0000459>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32915819") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000459> "A prospective cohort of 3,316 patients of German ancestry hospitalised for coronary angiography in Ludwigshafen, Germany, between 1997 and 2000, with and without cardiovascular disease, assembled to investigate genetic and environmental risk factors for cardiovascular diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000460> (<http://www.ebi.ac.uk/coho/COHO_0000460>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21409311") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23230101") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000460> "A family-based cohort of European American and African American siblings concordant for type 2 diabetes, and their unaffected relatives, recruited from internal medicine and endocrinology clinics in western North Carolina, United States, to study genetic and epidemiological contributions to diabetic heart disease and subclinical cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000461> (<http://www.ebi.ac.uk/coho/COHO_0000461>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25993607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000461> "A consortium of about 30 cohorts with genome-wide genotype and personality data, which harmonized personality measures across inventories in more than 63,000 participants for genome-wide association meta-analyses of personality traits such as neuroticism and their relation to major depressive disorder.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000462> (<http://www.ebi.ac.uk/coho/COHO_0000462>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41795035") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000462> "A case–control collection of children with type 1 diabetes and controls from multiple paediatric centres in China, used to validate polygenic risk scores for type 1 diabetes in an East Asian population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000463> (<http://www.ebi.ac.uk/coho/COHO_0000463>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28245255") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000463> "A prospective cohort of patients of the Academic Medical Center, Amsterdam, with symptomatic coronary artery disease (myocardial infarction, coronary revascularization or at least 70% stenosis of a major epicardial artery) before the age of 51, used in genetic studies of premature atherosclerosis and coronary artery disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000464> (<http://www.ebi.ac.uk/coho/COHO_0000464>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11876192") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000464> "A long-term community-based cohort of Black and white children and adolescents in the rural biracial community of Bogalusa, Louisiana, United States, begun in 1972 by an NHLBI-funded research centre to study cardiovascular risk factors from early life and followed into adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000465> (<http://www.ebi.ac.uk/coho/COHO_0000465>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41118674") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000465> "A family-based longitudinal cohort of children with speech sound disorder of unknown cause and their siblings, ascertained through probands referred by speech-language pathologists in the Cleveland area of Ohio, United States, and followed for about 25 years to study long-term speech, language and literacy outcomes and their genetic basis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000466> (<http://www.ebi.ac.uk/coho/COHO_0000466>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36207451") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000466> "A consortium of investigators attending the National Institute on Drug Abuse Genetics and Epigenetics Cross-cutting Research Team meetings, pooling genome-wide association data on opioid addiction from ten independent cohorts, including Yale-Penn, the Vancouver Injection Drug Users Study, the Urban Health Study, COGA, deCODE and the Comorbidity and Trauma Study, to study the genetics of opioid addiction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000467> (<http://www.ebi.ac.uk/coho/COHO_0000467>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38102185") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000467> "A prospective cohort of adults with opioid use disorder receiving treatment at Canadian Addiction Treatment Centre clinics across Ontario, Canada, recruited in 2013–2016 in collaboration with McMaster University to identify factors, including genetic risk factors, associated with opioid use and treatment outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000468> (<http://www.ebi.ac.uk/coho/COHO_0000468>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34108613") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37294764") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000468> "A general-population sample of Icelanders, enriched for carriers of rare and potentially high-impact mutations, comprehensively phenotyped by deCODE genetics in Iceland (e.g. audiometry, speech recordings, DXA body composition, plasma proteomics) and combined with the Icelandic genotype and sequence data for genetic association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000469> (<http://www.ebi.ac.uk/coho/COHO_0000469>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26635005") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000469> "A population-based prospective cohort of adult Qatari nationals and long-term residents (living in Qatar for at least 15 years), recruited by the Qatar Biobank from December 2012 with extensive lifestyle, clinical, imaging and biological-sample data and long-term follow-up, to study the causes, progression and burden of disease in the Qatari population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000470> (<http://www.ebi.ac.uk/coho/COHO_0000470>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17351290") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19438929") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000470> "A population-based cohort of men born 1907–1934 and women born 1908–1935, randomly selected from residents of the Reykjavik area, examined at the Heart Preventive Clinic in Reykjavik from 1967 and followed since in Iceland by the Icelandic Heart Association, to study cardiovascular disease and its risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000471> (<http://www.ebi.ac.uk/coho/COHO_0000471>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://humanfunctionalgenomics.org/projects/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10851559/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC5787854/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000471> "A research programme based at Radboud University Medical Center in Nijmegen, the Netherlands, that collects distinct cohorts of healthy volunteers and patients (among them 500FG, 200FG, 300BCG, 300OB, 300DM and 2000HIV) profiled with genetic, immunological and other omics data, to identify the genetic and non-genetic determinants of human immune and cytokine responses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000472> (<http://www.ebi.ac.uk/coho/COHO_0000472>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24188564") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000472> "A seven-year multicentre transfusion-medicine research programme launched in 2011 by the US National Heart, Lung, and Blood Institute, with a domestic component of four blood centres and 12 hospitals and international programmes in Brazil, China and South Africa, which built linked donor, donation and transfusion-recipient databases and ran more than 25 focused studies of blood donors and recipients, such as RBC-Omics and the Brazil sickle cell disease cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000473> (<http://www.ebi.ac.uk/coho/COHO_0000473>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13340790/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7939422/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000473> "A research resource developed by the Kaiser Permanente Northern California Division of Research from consenting members of the KPNC health plan, linking surveys, biospecimens and electronic health records and including the Genetic Epidemiology Research on Adult Health and Aging cohort and a pregnancy cohort, for research on the genetic and environmental determinants of common, age-related complex health conditions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000474> (<http://www.ebi.ac.uk/coho/COHO_0000474>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11164120") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8499470/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000474> "A genetic epidemiology study of type 2 diabetes begun in 1997 as a collaboration of West African and US investigators, enrolling affected sib-pairs with type 2 diabetes and unaffected controls in Ghana and Nigeria and later participants in Eldoret, Kenya, to map type 2 diabetes susceptibility genes in the West African ancestral populations of African Americans.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000475> (<http://www.ebi.ac.uk/coho/COHO_0000475>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36194120") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000475> "An ongoing nationwide prospective cohort of blood donors aged 18-70 at inclusion, recruited at Danish blood donation facilities since 2010 (all facilities in Denmark by 2015), with questionnaires, plasma samples, genotyping and linkage to national health registries for research on donor health and general public health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000476> (<http://www.ebi.ac.uk/coho/COHO_0000476>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2702100/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8499470/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000476> "A population-based family study of African Americans from the Washington, DC metropolitan area, enrolling randomly ascertained families and unrelated individuals through Howard University without selection on any phenotype, to study the genetic and environmental basis of common complex diseases including hypertension, obesity and type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000477> (<http://www.ebi.ac.uk/coho/COHO_0000477>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24678955") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33439866") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000477> "An international randomized, placebo-controlled trial of darapladib, a lipoprotein-associated phospholipase A2 inhibitor, in 15,828 patients with chronic coronary heart disease recruited at 663 centers in 39 countries from December 2008 to April 2010 and sponsored by GlaxoSmithKline, whose baseline plasma biobank has been used for biomarker, proteomic and genetic studies of cardiovascular outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000478> (<http://www.ebi.ac.uk/coho/COHO_0000478>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36504281") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000478> "A prospective, longitudinal cohort of cognitively unimpaired older adults and patients with mild cognitive impairment, dementias and parkinsonian disorders, recruited from 2009 to 2014 at three neurology and memory clinics in southern Sweden and studied with cerebrospinal fluid, plasma, imaging and genetic data to find biomarkers for early and reliable diagnosis of neurodegenerative disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000479> (<http://www.ebi.ac.uk/coho/COHO_0000479>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7337286/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000479> "A population-based cohort of 1,008 adult Croatians aged 18-93 from the isolated villages of Vis and Komiza on the Dalmatian island of Vis, Croatia, recruited in 2003 and 2004, genotyped and richly phenotyped for genetic studies of complex traits in an isolated population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000480> (<http://www.ebi.ac.uk/coho/COHO_0000480>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41122833") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://naccdata.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000480> "A US data resource, founded in 1999 and funded by the National Institute on Aging, that combines the standardized longitudinal clinical (Uniform Data Set), neuropathology, imaging, biomarker and genetic data of participants of the NIA-funded Alzheimer's Disease Research Centers, more than 56,000 people from over 42 centers, for research on Alzheimer disease and related dementias.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000481> (<http://www.ebi.ac.uk/coho/COHO_0000481>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29477148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8562625/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000481> "A population-based study of diabetes and cardiovascular disease in Singapore that re-visited, between 2003 and 2007, Chinese, Malay and Asian-Indian adults randomly sampled for four earlier cross-sectional studies (the Thyroid and Heart Study, the 1992 and 1998 National Health Surveys and the National University of Singapore Heart Study), with questionnaires and clinical examinations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000482> (<http://www.ebi.ac.uk/coho/COHO_0000482>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38181729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10806731/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000482> "An electronic health record-linked biobank jointly developed by the University of Colorado Anschutz Medical Campus and UCHealth, enrolling adult UCHealth patients since September 2015 (more than 200,000 participants by 2022, mostly from the Rocky Mountain region), as a dual-purpose resource for genomic research and for returning clinical genetic results to participants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000483> (<http://www.ebi.ac.uk/coho/COHO_0000483>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39595838") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000483> "A population-based prospective cohort of dementia-free adults aged 65 and older enrolled since 1994 from the membership of Kaiser Permanente Washington (formerly Group Health Cooperative) in the Seattle area, United States, and followed longitudinally to identify risk and preventive factors for dementia, with brain autopsy, genetic and abstracted medical-record data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000484> (<http://www.ebi.ac.uk/coho/COHO_0000484>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10964005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7933688/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000484> "A family study of the NHLBI Family Blood Pressure Program that from 1995 to 2000 recruited African American and white sibships with two or more members with hypertension diagnosed before age 60, with their untreated adult offspring and random population samples, at centres in Birmingham (Alabama), Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), to identify genes promoting hypertension.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000485> (<http://www.ebi.ac.uk/coho/COHO_0000485>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11189684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12520953/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000485> "A multicentre randomized cancer screening trial of about 155,000 men and women aged 55–74, enrolled from 1993 to 2001 at ten screening centres across the United States under the National Cancer Institute, testing whether screening reduces mortality from prostate, lung, colorectal and ovarian cancer, with participants followed for cancer incidence and death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000486> (<http://www.ebi.ac.uk/coho/COHO_0000486>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40744823") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000486> "A prospective population-based biobank cohort of 156,701 Korean adults aged 20–85 recruited in 2004–2013 at 18 health promotion centres across Korea during routine health examinations, genotyped and followed through national mortality, cancer registry and health insurance records, to study cancer, cardiovascular and other chronic diseases and their metabolic risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000487> (<http://www.ebi.ac.uk/coho/COHO_0000487>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22216169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34822396") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000487> "A hospital-based cohort of patients with suspected stable coronary artery disease, acute myocardial infarction or known left main coronary artery disease undergoing coronary angiography at the Heart Center Leipzig, Germany, recruited from December 2006 by Leipzig University and its Leipzig Research Center for Civilization Diseases (LIFE) as a biobank and database for studying clinical, metabolic, cellular and genetic factors of atherosclerosis and coronary artery disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000488> (<http://www.ebi.ac.uk/coho/COHO_0000488>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31189684") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000488> "A health and demographic surveillance system in Guinea-Bissau, run by the Bandim Health Project with Statens Serum Institut, that since 1989-1990 has followed the women and children under five of 182 randomly selected clusters across the country through household visits, to study health interventions, the non-specific effects of vaccines and child mortality, and that hosts randomised vaccine trials.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000489> (<http://www.ebi.ac.uk/coho/COHO_0000489>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35690720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11958703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000489> "A paediatric biobank of the Center for Applied Genomics at Children's Hospital of Philadelphia, recruiting children at the hospital since 2006 with broad consent for research use of their samples and electronic health records (about 85,000 juvenile subjects of diverse ancestries by 2025), used for genome-wide and phenome-wide studies of childhood disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000490> (<http://www.ebi.ac.uk/coho/COHO_0000490>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23084092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31544734") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000490> "A nationwide population-based register of more than 175,000 Danish twins from birth cohorts 1870 to 2009, established in the 1950s, that combines repeated surveys, in-person assessments, a biobank and linkage to Danish national registers, for studies of genetic and environmental influences on health, disease and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000491> (<http://www.ebi.ac.uk/coho/COHO_0000491>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23743551") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35047833") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000491> "A National Human Genome Research Institute-funded consortium, established in 2007, of US academic and integrated health systems, each with its own biorepository linking DNA samples to electronic medical records, which pooled its sites' data into a network-wide genome-wide dataset of about 105,000 participants for genomic discovery and later sequenced about 25,000 participants to study the return of genomic results.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000492> (<http://www.ebi.ac.uk/coho/COHO_0000492>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19729412") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41520650") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000492> "A volunteer-based cohort of about 1,000 adults from the self-contained population of Sorbs in eastern Germany, recruited and extensively metabolically phenotyped by the University of Leipzig in 2005–2007 for genome-wide studies of metabolic, anthropometric and other quantitative traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000493> (<http://www.ebi.ac.uk/coho/COHO_0000493>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8244125/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000493> "A four-year randomised controlled trial of resistance and aerobic exercise and dietary interventions in a population-based random sample of men and women aged 55-74 years living in Kuopio, Finland, drawn from the national population registry, of whom 1,479 attended baseline examinations in 2005-2006, to study the health effects of regular physical exercise and a healthy diet in middle-aged and older people.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000494> (<http://www.ebi.ac.uk/coho/COHO_0000494>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8617762/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000494> "A family intervention study of the NHLBI Programs in Gene by Environment Interaction, of 1,048 white participants in 184 three-generation pedigrees previously screened at the Minnesota and Utah centres of the NHLBI Family Heart Study, who took a standardised high-fat meal challenge and three weeks of fenofibrate treatment, to study genetic determinants of the lipid response to diet and lipid-lowering drugs.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000495> (<http://www.ebi.ac.uk/coho/COHO_0000495>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13153493/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000495> "A multi-site, multiethnic, community-based longitudinal cohort of 3,302 women aged 42–52 enrolled in 1996–1997 at seven US sites (Boston, Chicago, Detroit, Los Angeles, Pittsburgh, Oakland and Newark) and followed about yearly to study how women's physical, biological, psychological and social health in midlife affects health during ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000496> (<http://www.ebi.ac.uk/coho/COHO_0000496>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38862513") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39746953") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000496> "An ongoing nationwide multicentre study in Finland, run since 1997 from the Folkhälsan Research Center and the University of Helsinki, of over 5,000 adults with type 1 diabetes enrolled and clinically characterised at study centres across the country to identify factors leading to diabetic nephropathy and other diabetic complications.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000497> (<http://www.ebi.ac.uk/coho/COHO_0000497>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21102431") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32601453") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36603003") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000497> "A longitudinal multicentre genetic-neuroimaging cohort of about 2,000 healthy 14-year-old adolescents recruited from high schools at eight European sites in England, Ireland, France and Germany, followed up at ages 16, 19 and 22 with behavioural, neuropsychological, MRI and genome-wide data, to study the genetic and neurobiological basis of impulsivity, reinforcer sensitivity and emotional reactivity and their value in predicting psychiatric disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000498> (<http://www.ebi.ac.uk/coho/COHO_0000498>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18586274") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30678080") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000498> "A naturalistic, open-label longitudinal treatment study of inpatients admitted with a moderate to severe unipolar or bipolar depressive episode to the hospital of the Max Planck Institute of Psychiatry in Munich and collaborating hospitals in Southern Bavaria and Switzerland, characterised clinically, neuroendocrinologically (dex/CRH test) and genetically and followed weekly during treatment, to identify predictors of antidepressant treatment response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000499> (<http://www.ebi.ac.uk/coho/COHO_0000499>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22471868") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38934297") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000499> "A longitudinal epidemiologic cohort of older African Americans without known dementia, recruited from 2004 from churches, senior buildings and community organisations in the Chicago metropolitan area and followed at Rush University Medical Center, with optional brain donation, to study decline in cognitive function and risk of Alzheimer disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000500> (<http://www.ebi.ac.uk/coho/COHO_0000500>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19943720") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27030319") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000500> "A longitudinal study of Australian twins aged 65 years and over, with some of their equivalently aged siblings, recruited through the Australian Twin Registry and a recruitment drive and assessed every two years with psychiatric, neuropsychological, cardiovascular, metabolic, neuroimaging and genetic measures, to study genetic and environmental influences on healthy brain ageing and ageing-related neurocognitive disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000501> (<http://www.ebi.ac.uk/coho/COHO_0000501>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30987580") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38714679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000501> "A prospective observational cohort of adults with proven or probable Lyme borreliosis in the Netherlands, included at the start of antibiotic treatment from 2015 and followed for one year with questionnaires and repeated blood sampling, run by RIVM with the Lyme borreliosis expert centres of Amsterdam UMC and Radboudumc to study the prevalence and determinants of persistent symptoms after treatment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000502> (<http://www.ebi.ac.uk/coho/COHO_0000502>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37555575") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41858114") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000502> "A cross-sectional cohort of 323 healthy adults aged 18-65 living in the Kilimanjaro region of northern Tanzania, enrolled within the Human Functional Genomics Project by Radboudumc and Tanzanian partners, with ex vivo cytokine stimulations at the Kilimanjaro Clinical Research Institute in Moshi, to study genetic and environmental determinants of immune responses in an African population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000503> (<http://www.ebi.ac.uk/coho/COHO_0000503>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36085083") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9461263/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000503> "An ancestrally diverse biobank embedded in the UCLA Health medical system in Los Angeles County, run by the UCLA Institute for Precision Health, that links genomic data from blood samples of consenting UCLA Health patients (36,736 genotyped in 2022) to their de-identified electronic health records, for genetic and precision-health research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000504> (<http://www.ebi.ac.uk/coho/COHO_0000504>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12684185") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5884862/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8640864/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000504> "A family study of Hispanic (Mexican American) families recruited at clinical centres in San Antonio, Texas and the San Luis Valley, Colorado and African American families recruited in Los Angeles, California, selected on family size rather than health status and examined with CT scans of visceral fat and frequently sampled glucose tolerance tests, to identify the genetic and environmental determinants of insulin resistance and visceral adiposity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000505> (<http://www.ebi.ac.uk/coho/COHO_0000505>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41398-025-03418-z/MediaObjects/41398_2025_3418_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5714283/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000505> "A nested case-control genome-wide association sub-study of the Women's Health Initiative hormone therapy trials, comprising the coronary heart disease, stroke, venous thromboembolism and selected diabetes cases that arose during the active intervention phase and age-matched controls, genotyped under the NHGRI Genomics and Randomized Trials Network (GARNET).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000506> (<http://www.ebi.ac.uk/coho/COHO_0000506>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35383335") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41593-022-01042-4/MediaObjects/41593_2022_1042_MOESM3_ESM.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000506> "A case-control sample of 158 people of European ancestry, patients with amyotrophic lateral sclerosis and healthy controls, from University Medical Center Utrecht, the Netherlands, with longitudinal 3.0 T brain MRI and whole-genome sequencing, contributed to the ENIGMA Plasticity Working Group genome-wide meta-analysis of brain structure change.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000507> (<http://www.ebi.ac.uk/coho/COHO_0000507>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24734025") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000507> "A pool of self-reported healthy volunteers, many of them university students, who took part in diverse imaging studies at the Donders Centre for Cognitive Neuroimaging in Nijmegen, the Netherlands, and consented to pooling of their anatomical MRI scans with DNA for imaging genetics; established in 2007 and now part of the Cognomics initiative.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000508> (<http://www.ebi.ac.uk/coho/COHO_0000508>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22856378") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000508> "A longitudinal study of Dutch twin families recruited from the Netherlands Twin Register, starting with 112 families of 9-year-old twins and an older sibling who were assessed at three-year intervals with IQ and neuropsychological tests, behavioural ratings, pubertal hormones, brain MRI and DNA collection, to study genetic and environmental influences on brain structure and cognition from childhood into adolescence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000509> (<http://www.ebi.ac.uk/coho/COHO_0000509>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22856377") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000509> "A genetically homogeneous sample of healthy Norwegian adults spanning the adult life span, collected from 2003 to study cognitive ageing and genetic risk factors and genome-wide genotyped in 2009, with MRI and experimental cognitive data on attention and working memory, for studies of the genetics of cognitive and brain function.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000510> (<http://www.ebi.ac.uk/coho/COHO_0000510>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25012461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000510> "A multi-site prospective cohort following up the Dutch families of the International Multicenter ADHD Genetics project together with newly recruited families, comprising 1,069 children from ADHD and control families and 848 parents assessed with diagnostic interviews, questionnaires, cognitive tests, structural and functional MRI and genome-wide genotyping, to study the course of ADHD into adolescence and adulthood and its genetic, environmental and neural underpinnings.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000511> (<http://www.ebi.ac.uk/coho/COHO_0000511>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14663300") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23754956") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25886540") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000511> "A population-based randomised non-pharmacological lifestyle intervention trial for the prevention of ischaemic heart disease, run in 1999–2006 at the Research Centre for Prevention and Health in Glostrup, Copenhagen, Denmark, on random samples of adults aged 30–60 drawn from a population of 61,301 and followed through questionnaires and central registers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000512> (<http://www.ebi.ac.uk/coho/COHO_0000512>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28924187") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000512> "A Danish population-based case-cohort sample nested within everyone born in Denmark in 1981-2005, combining all persons diagnosed with schizophrenia, autism, ADHD or affective disorder with a random sample of the same population, genotyped from neonatal dried blood spots in the Danish Neonatal Screening Biobank and linked to national registers, established by the Lundbeck Foundation Initiative for Integrative Psychiatric Research to study the genetic and environmental architecture of severe mental disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000513> (<http://www.ebi.ac.uk/coho/COHO_0000513>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34739053") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000513> "A longitudinal, multicentre, multinational family study of 4,953 members of 539 two-generation families selected for exceptional familial longevity, recruited in 2006-2009 through field centres in Boston, New York and Pittsburgh in the United States and in Denmark and re-examined in 2014-2017, to study the genetic and non-genetic determinants of exceptional longevity and healthy ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000514> (<http://www.ebi.ac.uk/coho/COHO_0000514>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20214461") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37241208") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000514> "A multicentre observational cohort of about 10,000 non-Hispanic white and African American current and former smokers with and without COPD, aged 45-80, enrolled at 21 clinical centres across the United States and followed longitudinally with chest CT imaging and genome-wide genotyping to identify genetic factors and CT-defined subtypes of COPD.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000515> (<http://www.ebi.ac.uk/coho/COHO_0000515>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23299990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000515> "A population-based prospective cohort of a representative sample of healthy adults aged 25-41 in the Principality of Liechtenstein, enrolled from June 2010 without cardiovascular disease, diabetes or severe obesity, with ambulatory blood pressure, Holter ECG, spirometry, sleep oximetry and blood, urine and genetic sampling, and followed up every 3-5 years to study genetic and phenotypic predictors of cardiovascular risk factors in young adults.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000516> (<http://www.ebi.ac.uk/coho/COHO_0000516>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18070814") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10767824/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000516> "A prospective genome-wide association cohort of more than 25,000 initially healthy American female health professionals aged 45 or older from the Women's Health Study who gave a baseline blood sample, followed since 1992 for incident cardiovascular disease, cancer, diabetes and other outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000517> (<http://www.ebi.ac.uk/coho/COHO_0000517>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20394692") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11875162/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000517> "A community-based cohort of Mexican Americans in Brownsville, Cameron County, Texas, on the United States-Mexico border, established in 2004 by the University of Texas School of Public Health Brownsville campus from households in randomly selected census tract blocks, to study the prevalence and determinants of obesity, diabetes and related chronic disease in this population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000518> (<http://www.ebi.ac.uk/coho/COHO_0000518>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39250132") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41268768") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000518> "A US consortium that assembles genome-wide genotype data and harmonized phenotypes from many case-control, family-based, population-based and longitudinal Alzheimer disease cohorts, in more than 30 GWAS datasets of several ancestries, for genetic studies of late-onset Alzheimer disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000519> (<http://www.ebi.ac.uk/coho/COHO_0000519>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25254375") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37156940") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000519> "A sample of about 7,300 adult volunteers of mixed African, European and Native American ancestry, mostly university students and staff (and, in Chile, mainly soldiers), recruited by a consortium of Latin American and UK groups in México City, Medellín, Lima, Arica and Porto Alegre and characterised for genome-wide genotypes, physical appearance, facial photographs and self-perceived ancestry, to study admixture and the genetics of physical traits in Latin America.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000520> (<http://www.ebi.ac.uk/coho/COHO_0000520>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37308787") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39948438") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000520> "A prospective cohort of more than 150,000 adults aged 35 and over, recruited in 1998-2004 from the contiguous urban districts of Coyoacán and Iztapalapa in Mexico City with the University of Oxford, and followed to investigate known and new risk factors for mortality in people of Mexican descent; its participants have exome and genome-wide genetic data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000521> (<http://www.ebi.ac.uk/coho/COHO_0000521>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25194498") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000521> "An occupational cohort of police officers and staff of police forces across Great Britain, enrolled from 2004 (42,112 participants by the end of 2012, most of whom attended a health screening with questionnaires, food diaries, physical and cognitive measurements and stored blood and urine), set up to evaluate possible health risks of the TETRA digital radio system and broadened to study the health of the police workforce.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000522> (<http://www.ebi.ac.uk/coho/COHO_0000522>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18366642") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38388190") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000522> "A population-based cohort of a random sample of 6,188 Caucasian adults aged 35 to 75 living in Lausanne, Switzerland, extensively phenotyped and genotyped genome-wide at baseline to study the prevalence and genetic determinants of cardiovascular risk factors and the metabolic syndrome, and followed up prospectively (with its psychiatric arm PsyCoLaus) from 2003 for cardiovascular events and mortality.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000523> (<http://www.ebi.ac.uk/coho/COHO_0000523>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12490524/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000523> "A prospective cohort of 41,513 middle-aged and older adults of white European origin, almost all aged 40–69, recruited in Melbourne, Australia, in 1990–1994 by Cancer Council Victoria and followed up face to face in 2003–2007 and by record linkage to cancer and death registries, collecting socio-demographic, lifestyle and health data to study risk factors for cancer and other chronic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000524> (<http://www.ebi.ac.uk/coho/COHO_0000524>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25431468") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000524> "A Dutch prospective cohort study, run in the North of the Netherlands, consisting of a population cohort of 2,230 children born between October 1989 and September 1991 and a clinical cohort of 543 children referred to child psychiatric outpatient care before age 11, followed from about age 11 into young adulthood with repeated assessments of mental health, social development and physical health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000525> (<http://www.ebi.ac.uk/coho/COHO_0000525>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23241242") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000525> "A population-based longitudinal cohort of 2,082 Danish adults at different levels of diabetes risk, sampled from the 16,136 high-risk individuals identified by the 2001–2006 stepwise diabetes screening programme in Danish general practice of the Danish arm of ADDITION-Europe, examined in 2009–2011 with detailed cardiometabolic phenotyping and followed for cardiovascular disease and death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000526> (<http://www.ebi.ac.uk/coho/COHO_0000526>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16515696") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9436946/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000526> "A clinical cohort of about 4,500 patients scheduled for an exercise stress test at Tampere University Hospital, Finland, recruited between October 2001 and December 2007 with continuous high-resolution ECG, haemodynamic measurements, genotyping and follow-up of clinical events and deaths, to construct risk profiles for cardiovascular disease, events and death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000527> (<http://www.ebi.ac.uk/coho/COHO_0000527>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33185675") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10173489/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000527> "A prospective cohort of 51,529 US male health professionals aged 40 to 75 enrolled in 1986, whose demographics, health, diet and lifestyle are updated by questionnaire every two years (diet every four), with follow-up exceeding 90% of eligible person-time.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000528> (<http://www.ebi.ac.uk/coho/COHO_0000528>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30470734") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34450027") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://metadata.ega-archive.org/studies/EGAS00001000917") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000528> "A Greek collection of more than 1,500 well-phenotyped patients with severe hip or knee osteoarthritis undergoing total joint replacement, recruited in hospitals of Athens (2015-2017) and Larissa together with healthy controls, set up to study the genetic architecture of osteoarthritis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000529> (<http://www.ebi.ac.uk/coho/COHO_0000529>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19396169") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35401680") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37919891") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000529> "The genome-wide genotyped sample of the Ansan and Ansung Study of the Korean Genome and Epidemiology Study: about 10,000 participants of the urban Ansan and rural Ansung (Anseong) community cohorts in South Korea, recruited from 2001 and genotyped on the Affymetrix Genome-Wide Human SNP Array 5.0 (8,842 after quality control), used for genome-wide association studies of quantitative and disease traits in Koreans.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000530> (<http://www.ebi.ac.uk/coho/COHO_0000530>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27085081") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36573383") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41373836") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000530> "A community-based prospective cohort of 10,030 men and women aged 40–69 from the urban city of Ansan and the rural town of Ansung (Anseong) in Gyeonggi Province, South Korea, recruited in 2001–2002 as the first cohort of the Korean Genome and Epidemiology Study and re-surveyed every two years, to study common chronic diseases and their genetic and environmental risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000531> (<http://www.ebi.ac.uk/coho/COHO_0000531>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26444713") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28278155") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40877534") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000531> "A population-based prospective cohort of about 9,800 residents aged 30–74 years of Nagahama City, a largely rural city in Shiga Prefecture, central Japan, recruited in 2008–2010 and run from Kyoto University Graduate School of Medicine, with blood samples, questionnaires, health examinations, genotyping and follow-up examinations (the first in 2013–2016) for genomic and clinical research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000532> (<http://www.ebi.ac.uk/coho/COHO_0000532>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ckdgen.imbi.uni-freiburg.de/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8285412/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000532> "An international collaborative consortium, co-directed by Anna Köttgen and Cristian Pattaro with its data hosted at the University of Freiburg, that meta-analyses genome-wide association results from many, mostly population-based, studies to investigate the genetic basis of kidney function and disease, releasing summary statistics for markers such as estimated glomerular filtration rate and blood urea nitrogen.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000533> (<http://www.ebi.ac.uk/coho/COHO_0000533>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27374138") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000533> "A Japanese genome cohort project launched after the 2011 Great East Japan Earthquake and run by the Tohoku Medical Megabank Organization of Tohoku University and the Iwate Tohoku Medical Megabank Organization of Iwate Medical University, comprising two prospective cohorts in Miyagi and Iwate Prefectures, the TMM Community-Based Cohort Study of adults and the TMM Birth and Three-Generation Cohort Study, with an integrated biobank of health information, biospecimens and genome and omics data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000534> (<http://www.ebi.ac.uk/coho/COHO_0000534>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10592169/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000534> "A population-based case-control study of prostate cancer in King County, Washington, run at the Fred Hutchinson Cancer Center, with men aged 35–74 diagnosed in 1993–1996 or 2002–2005 and tumours coded by the Seattle-Puget Sound SEER registry, and age-matched controls without prostate cancer found by random-digit dialling; its genotyped samples contribute to the PRACTICAL consortium studies of inherited prostate cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000535> (<http://www.ebi.ac.uk/coho/COHO_0000535>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9043943/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001918.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000535> "A retrospective cohort of patients with a haematological malignancy or myelodysplastic syndrome who had a first allogeneic haematopoietic cell transplant at the Fred Hutchinson Cancer Research Center and Seattle Cancer Care Alliance from 1990 to 2011, together with their donors, genotyped to find variants associated with graft-versus-host disease, recurrent malignancy and other complications after transplantation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000536> (<http://www.ebi.ac.uk/coho/COHO_0000536>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://magicinvestigators.org/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11399760/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000536> "A collaborative consortium that combines genome-wide association and exome-array data from many cohorts of individuals without diabetes in meta-analyses of glycaemic traits (fasting glucose, fasting insulin, 2-hour glucose and HbA1c) and measures of insulin secretion and sensitivity, to find loci influencing glycaemic and metabolic traits, and releases its summary results.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000537> (<http://www.ebi.ac.uk/coho/COHO_0000537>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28445188") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9870026/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000537> "A UK study of the molecular genetics of adverse drug reactions in children, recruiting carefully phenotyped retrospective cohorts of treated children at UK hospitals; its cisplatin cohort comprises platinum-treated paediatric cancer patients recruited between 2012 and 2018 at eight UK sites for genetic studies of ototoxicity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000538> (<http://www.ebi.ac.uk/coho/COHO_0000538>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12873190/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000538> "A pregnancy cohort in Western Australia for which 2,900 mothers were recruited during pregnancy from 1989 at King Edward Memorial Hospital and surrounding clinics, with the mothers (Generation 1) and their 2,868 offspring (Generation 2) followed through childhood and adolescence to study how early life shapes later health and behaviour.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000539> (<http://www.ebi.ac.uk/coho/COHO_0000539>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12097148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12457784") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000539> "A randomised, double-blind, placebo-controlled trial population of 5,804 men and women aged 70 to 82 with pre-existing vascular disease or risk factors for it, screened in Scotland, Ireland and the Netherlands and randomised to pravastatin 40 mg/day or placebo for about 3.2 years to test whether statin treatment reduces coronary and cerebrovascular events in the elderly.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000540> (<http://www.ebi.ac.uk/coho/COHO_0000540>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17443206") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000540> "A family feeding study of 3,153 participants from 658 families in rural China, each ascertained through a proband with untreated prehypertension or stage-1 hypertension, who underwent seven-day low-sodium, high-sodium and high-sodium with potassium supplementation dietary interventions, to localise and identify genes influencing blood pressure responses to dietary sodium and potassium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000541> (<http://www.ebi.ac.uk/coho/COHO_0000541>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35216576") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000541> "A research resource of Kaiser Permanente, launched in May 2016 and built on the Research Program on Genes, Environment and Health, that collects biospecimens and surveys linked to electronic health records from consenting adult members across Kaiser Permanente's eight US regions (about 396,000 consented by July 2021), with general, pregnancy and cancer cohorts.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000542> (<http://www.ebi.ac.uk/coho/COHO_0000542>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17254440") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31796137") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000542> "A collection of longitudinal, community-representative twin and adoptive family studies in Minnesota, including the Minnesota Twin Registry, the Minnesota Twin Family Study, the Enrichment Study, the Adolescent Brain study and the Sibling Interaction and Behavior Study, focusing on psychological adjustment, personality, cognitive ability and brain function with an emphasis on substance use and related psychopathology.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000543> (<http://www.ebi.ac.uk/coho/COHO_0000543>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14968294") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19455304") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000543> "A prospective cohort of about 1,500 healthy men and women of European ancestry aged 30 to 60, recruited without diabetes, hypertension or dyslipidaemia at centres in 13-14 European countries by the European Group for the Study of Insulin Resistance, with baseline oral glucose tolerance tests and euglycaemic insulin clamps and follow-up after 3 and 10 years to study how insulin resistance relates to atherosclerosis, cardiovascular disease and type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000544> (<http://www.ebi.ac.uk/coho/COHO_0000544>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33717105") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000544> "The first cohort of the Rotterdam Study, a prospective population-based cohort of 7,983 inhabitants aged 55 and over of Ommoord, a suburb of Rotterdam in the Netherlands, started in 1990 and re-examined about every 4 years with home interviews and clinical assessments to study determinants of chronic diseases in older adults.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000545> (<http://www.ebi.ac.uk/coho/COHO_0000545>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29703560") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000545> "A longitudinal cohort of about 11,500 children aged 9-10, including about 1,720 twins, recruited largely through schools at 21 data acquisition sites across the United States to reflect the nation's diversity, and followed for ten years with annual assessments and biennial MRI to study adolescent brain and cognitive development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000546> (<http://www.ebi.ac.uk/coho/COHO_0000546>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37233759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000546> "A pharmacogenetic study established in 2007 at Massachusetts General Hospital, which from 2008 enrolled about 1,000 adults of diverse ancestry enriched for risk of type 2 diabetes and challenged them with glipizide and metformin at clinical research centres in Boston, Massachusetts, to identify genetic variants influencing the acute response to glucose-lowering drugs.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000547> (<http://www.ebi.ac.uk/coho/COHO_0000547>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3616155/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4762074/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000547> "An international registry and cohort, funded by the US National Cancer Institute and begun in 1997, of colorectal cancer cases, their unaffected relatives and population-based controls recruited through six centres in Australasia and North America (the Australasian, Mayo Clinic, Ontario, Seattle, University of Hawaii and USC Consortium registries), as a resource for research on familial and sporadic colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000548> (<http://www.ebi.ac.uk/coho/COHO_0000548>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23409726") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30897159") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000548> "A prospective cohort of about 3,000 adult outpatients of self-reported Caucasian ethnicity with prevalent type 2 diabetes, recruited in 2010–2014 at two university-based study centres in Germany and followed with biennial visits, core phenotyping and biobanking for at least 10 years to study diabetes complications, with a primary focus on renal events.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000549> (<http://www.ebi.ac.uk/coho/COHO_0000549>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13269534/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000549> "A US prospective multicentre cohort of men aged 65 or older recruited at six clinical centres (Birmingham, Minneapolis, Palo Alto, near Pittsburgh, Portland and San Diego), designed to examine risk factors for osteoporosis, fractures and prostate cancer in older men, with ancillary studies such as MrOS Sleep (2003-2005, in-home polysomnography of 3,135 men).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000550> (<http://www.ebi.ac.uk/coho/COHO_0000550>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23316297") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41406505") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000550> "A Dutch population-based cohort of 8,592 residents of the city of Groningen aged 28 to 75, enrolled in 1997-1998 from 40,856 respondents who sent a morning urine sample, enriched for people with urinary albumin of at least 10 mg/L plus a random control sample, and followed up to study renal and cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000551> (<http://www.ebi.ac.uk/coho/COHO_0000551>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35379992") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000551> "A European consortium bringing together the European genome-wide association consortia working on Alzheimer disease, which collated and uniformly genotyped a new dataset of about 20,000 clinically diagnosed Alzheimer disease cases and 22,000 controls from 15 European countries and pools them with existing European cohorts for genetic studies of Alzheimer disease and related dementias.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000552> (<http://www.ebi.ac.uk/coho/COHO_0000552>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-022-05165-3/MediaObjects/41586_2022_5165_MOESM1_ESM.docx") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10955659/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9841450/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000552> "An international multicentre case-control study of risk factors for first acute stroke, which recruited 13,462 stroke cases and 13,488 community or hospital controls matched for age, sex and region from 142 centres in 32 countries between 2007 and 2015, with a genotyped subset of consenting participants used in genetic studies of stroke.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000553> (<http://www.ebi.ac.uk/coho/COHO_0000553>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16236996") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000553> "A population-based prospective cohort of 74,942 Chinese women aged 40–70 recruited in 1996–2000 from selected urban communities of Shanghai, most of whom gave blood, urine or buccal-cell samples, followed by biennial in-person recontact and linkage to cancer and vital statistics registries, to study environmental exposures, biomarkers and the risk of cancer and other chronic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000554> (<http://www.ebi.ac.uk/coho/COHO_0000554>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0092867420308229-mmc1.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000554> "The phase 2 sample of the Montreal Heart Institute Biobank used in the trans-ethnic blood-cell genetics study of Chen et al. (2020): a nested case-control sample of 3,495 European-ancestry patients from the hospital cohort (3,436 analysed), genotyped on the MEGA array, with blood cell counts measured on a Beckman Coulter UniCel DxH 800 analyser.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000555> (<http://www.ebi.ac.uk/coho/COHO_0000555>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0092867420308229-mmc1.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000555> "The phase 1 sample of the Montreal Heart Institute Biobank used in the trans-ethnic blood-cell genetics study of Chen et al. (2020): a nested case-control sample of 2,002 European-ancestry patients from the hospital cohort (1,991 analysed), whole-genome sequenced, with blood cell counts measured on a Beckman Coulter UniCel DxH 800 analyser.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000556> (<http://www.ebi.ac.uk/coho/COHO_0000556>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5946295/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000556> "A multicentre population-based case-control study of colorectal cancer in the Rhine-Neckar region of south-west Germany, led from the German Cancer Research Center in Heidelberg, which from 2003 recruited patients aged 30 or over with a first colorectal cancer diagnosis from the 22 hospitals treating the disease in the region, and actively follows the cases to study colorectal cancer risk, prevention by screening and survival.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000557> (<http://www.ebi.ac.uk/coho/COHO_0000557>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16754790") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19304780") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000557> "A UK case-control and family resource of white European people with severe essential hypertension, collected by the MRC British Genetics of Hypertension study from about 1,700 affected sibling pairs and 800 nuclear families, with about 2,000 normotensive controls matched by age, sex and geography across the UK, for linkage and association studies of the genetics of hypertension.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000558> (<http://www.ebi.ac.uk/coho/COHO_0000558>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://portals.broadinstitute.org/collaboration/giant/index.php/Main_Page") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000558> "An international collaboration of investigators from many groups, institutions, countries and studies that meta-analyses genome-wide association and other large-scale genetic data to identify loci modulating human body size and shape, such as height, body mass index and waist-related traits, and releases the summary data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000559> (<http://www.ebi.ac.uk/coho/COHO_0000559>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27157501") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34450027") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000559> "A population-based cohort of about 2,900 volunteers of Southern Chinese origin aged 15–55 in Hong Kong, openly recruited through newspaper advertisements, posters and e-mails regardless of back symptoms, who underwent lumbar spine MRI, questionnaires and genome-wide genotyping, to study the genetic and environmental determinants of intervertebral disc degeneration.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000560> (<http://www.ebi.ac.uk/coho/COHO_0000560>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3002160/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5619832/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000560> "An international consortium established in 2004 by research groups leading large molecular epidemiology studies of lung cancer, which pools data from its member case-control and cohort studies to study lung cancer risk and prognosis; its OncoArray project genotyped about 36,000 participants of European descent.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000561> (<http://www.ebi.ac.uk/coho/COHO_0000561>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40407102") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000561> "A national initiative that whole-genome sequences participants of many Alzheimer disease cohorts and integrates the sequences with harmonized phenotypes, 36,361 samples from 17 cohorts in 14 countries in its fourth release, 45% of non-European ancestry, to understand the genetic architecture of Alzheimer disease and related dementias.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000562> (<http://www.ebi.ac.uk/coho/COHO_0000562>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18426866") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33865193") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000562> "A community-based birth cohort of about 3,000 singletons born in 1983-1984 in Cebu, Philippines, and their mothers, enrolled in pregnancy and followed with bimonthly surveys for two years and repeated follow-up surveys to age 35, run by the Office of Population Studies of the University of San Carlos and the University of North Carolina to study the long-term effects of early nutrition and life conditions on health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000563> (<http://www.ebi.ac.uk/coho/COHO_0000563>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38222332") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9693138/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000563> "A population genomics study launched in 2019 by Intermountain Healthcare (Utah) in partnership with deCODE genetics and Amgen, aiming to enrol up to 500,000 adult patients (more than 170,000 by 2023) whose whole-genome sequence or genotype data are linked to health records, to discover genetic biomarkers of disease and return actionable findings to participants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000564> (<http://www.ebi.ac.uk/coho/COHO_0000564>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10506044/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11617231/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000564> "A population-based case-control study of risk factors for cardiovascular outcomes set among enrollees of Group Health Cooperative (now Kaiser Permanente Washington), a community-based health care cooperative in western Washington State, whose cases of cardiovascular events such as a first venous thromboembolism were identified from diagnosis codes and prescriptions and matched to controls, with medical-record review, genotyping and follow-up of cases for recurrence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000565> (<http://www.ebi.ac.uk/coho/COHO_0000565>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29803983") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4302371/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000565> "A prospective registry of patients admitted to the cardiac catheterisation laboratories of Intermountain Healthcare hospitals in Salt Lake City and Ogden, Utah, followed through electronic records for cardiovascular outcomes such as death, myocardial infarction, heart failure and stroke, to study risk factors and treatment of cardiovascular disease in patients undergoing coronary angiography.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000566> (<http://www.ebi.ac.uk/coho/COHO_0000566>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000566> "A community-based prospective cohort of European-ancestry and African American men and women aged 45 or older from six townships in Johnston County, North Carolina, recruited from 1990 (3,187 at baseline in 1991-1997, plus 1,019 residents enrolled in 2003-2004) with and without osteoarthritis, and followed about every five years to estimate the incidence and progression of knee, hip and other osteoarthritis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000567> (<http://www.ebi.ac.uk/coho/COHO_0000567>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27195708") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33413638") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000567> "A prospective population-based cohort of about 28,000 Indian Asian (South Asian) and European men and women aged 35 to 75, recruited in 2003-2008 from the lists of 58 general practitioners in West London, UK, with a structured cardiovascular and metabolic assessment and stored blood, to study the excess cardiometabolic risk of South Asians.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000568> (<http://www.ebi.ac.uk/coho/COHO_0000568>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40010489") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000568> "A cohort of 2,762 women from Korea, Vietnam, Thailand and Indonesia, established by Korean researchers with measurements of 26 skin traits, skin-related surveys and whole-genome sequencing-based genotyping, to study the genetic and non-genetic determinants of skin traits and their variation across Asian countries.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000569> (<http://www.ebi.ac.uk/coho/COHO_0000569>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3005543/unicode") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3913564/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000569> "A population-based case-control study of colon cancer, with cases diagnosed in 1991–1994 and age- and sex-matched controls recruited from the Kaiser Permanente Medical Care Program of Northern California, Utah and the Twin Cities of Minnesota, extended in 1997–2001 by a parallel study of rectal cancer in Utah and Kaiser Permanente, collecting diet, physical activity and other lifestyle data to study their relation to colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000570> (<http://www.ebi.ac.uk/coho/COHO_0000570>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11129752") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40981293") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000570> "A prospective population-based study of aging of 1,453 residents aged 20 to 102, mostly older people, selected by multistage sampling from the registries of Greve in Chianti and Bagno a Ripoli in Tuscany, Italy, examined at baseline in 1998-2000 and followed up to identify risk factors for the loss of walking ability and other age-related decline.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000571> (<http://www.ebi.ac.uk/coho/COHO_0000571>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33727749") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34733494") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000571> "A Japanese population-based genome cohort started in 2005 that recruited about 100,000 people aged 35–69 years (community residents, health check examinees and first-visit patients of a cancer hospital) from study areas throughout Japan, with baseline questionnaires and blood samples, followed up for 20 years to detect gene–environment interactions in cancer and other lifestyle-related diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000572> (<http://www.ebi.ac.uk/coho/COHO_0000572>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4453642/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000572> "A case-control study of urinary bladder cancer run from Radboud University Medical Center in Nijmegen, the Netherlands, in which patients diagnosed from 1995 to 2010 under the age of 76 and living in the catchment area of seven hospitals in the east of the country were identified through the Netherlands Cancer Registry and invited in batches, with controls drawn from the Nijmegen Biomedical Study, to study genetic and lifestyle risk factors and outcomes of bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000573> (<http://www.ebi.ac.uk/coho/COHO_0000573>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5065698/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5382131/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000573> "A Norwegian breast cancer study led by A.-L. Børresen-Dale and V. N. Kristensen with support from the K.G. Jebsen Centre for Breast Cancer Research, which collected blood and breast tissue from breast cancer patients and healthy women, including a sub-study of women attending the Norwegian national mammography screening programme in 2002–2007 with biopsies and mammographic density, for studies of breast cancer genetics, gene expression and breast density.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000574> (<http://www.ebi.ac.uk/coho/COHO_0000574>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22933644") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000574> "A population-based cohort of 43,794 men and women aged 40–69 randomly sampled from the population of Queensland, Australia, in 2011, with baseline questionnaires on pigmentation, sun exposure, sun protection and skin cancer history and linkage to national health insurance, cancer registry and pathology records, to study the development of skin cancer and melanoma in the population with the highest reported incidence in the world.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000575> (<http://www.ebi.ac.uk/coho/COHO_0000575>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20305777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000575> "A Japanese knee osteoarthritis case-control collection assembled at the RIKEN Center for Genomic Medicine, of about 900 symptomatic knee osteoarthritis cases diagnosed by orthopaedic surgeons from clinical and radiographic examination at several Japanese medical institutes and about 3,400 controls from BioBank Japan and Osaka volunteers, genotyped genome-wide to find knee osteoarthritis susceptibility loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000576> (<http://www.ebi.ac.uk/coho/COHO_0000576>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26914831") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35740506") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000576> "A Japanese pharmacogenetic cohort of 219 patients with metastatic renal cell carcinoma treated with sunitinib, recruited from 15 Japanese medical institutes with data collected at the laboratory for pharmacogenomics of the RIKEN Center for Integrative Medical Sciences, to study germline genetic variants related to sunitinib toxicity and efficacy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000577> (<http://www.ebi.ac.uk/coho/COHO_0000577>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42319504") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000577> "A population-based prospective cohort of women born 1914–1948 living in Uppsala and Västmanland counties in central Sweden, established in 1987–1990 among the 90,303 women invited to mammography screening who completed a food frequency questionnaire, re-surveyed in 1997 and followed through linkage to Swedish national registers to study diet, lifestyle and chronic disease, notably cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000578> (<http://www.ebi.ac.uk/coho/COHO_0000578>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25733578") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000578> "A population-based prospective cohort of 61,480 men aged 40–74 living in urban Shanghai, recruited from 2002 with detailed lifestyle, dietary and medical data and blood, urine and DNA samples, and followed by in-person surveys every 3–4 years and linkage with cancer and vital statistics registries, to study lifestyle, environmental and genetic contributions to cancer and other non-communicable diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000579> (<http://www.ebi.ac.uk/coho/COHO_0000579>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4705892/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000579> "A prospective cohort of men and women aged 50–76 living in the 13-county area of western Washington State covered by the SEER cancer registry, recruited by mailed questionnaire from October 2000 to December 2002, with about 77,700 valid baseline questionnaires, to study the use of vitamins and other dietary supplements, and lifestyle, in relation to cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000580> (<http://www.ebi.ac.uk/coho/COHO_0000580>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000580> "A clinic-based study of the epidemiology and genetics of sleep apnoea and related comorbidities in patients presenting to the sole public sleep clinic in Western Australia, in Perth, most of them referred for sleep-disordered breathing, with in-lab polysomnography from 2006 to 2010 and genome-wide genotyping of about 1,500-1,650 European-ancestry patients.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000581> (<http://www.ebi.ac.uk/coho/COHO_0000581>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29980228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000581> "A European multimodal biomarker dataset of 1,221 people aged over 50 with normal cognition, mild cognitive impairment or Alzheimer-type dementia and known amyloid status, selected from 11 existing prospective European cohorts (three multicenter studies and eight single-center memory clinic cohorts) within the Innovative Medicines Initiative-funded European Medical Information Framework, with plasma, cerebrospinal fluid, DNA and MRI data for discovery of diagnostic and prognostic Alzheimer disease biomarkers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000582> (<http://www.ebi.ac.uk/coho/COHO_0000582>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2409301/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8224703/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000582> "A family study of the National Heart, Lung, and Blood Institute that recruited families, about half at high risk of coronary heart disease and half selected randomly, from existing study populations at four centres in Forsyth County (North Carolina), Framingham (Massachusetts), Minneapolis (Minnesota) and Salt Lake City (Utah), examining 5,710 participants in 1993-1995 with later follow-up including cardiac CT, to identify genetic and non-genetic determinants of coronary heart disease, atherosclerosis and their risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000583> (<http://www.ebi.ac.uk/coho/COHO_0000583>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37110162") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39849370") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000583> "A multinational, multi-ancestry observational cohort of more than 25,000 pregnant women enrolled in 2000-2006 at 15 field centres in Asia, Australia, the Caribbean, Europe, North America and the Middle East, who had a standardised 75 g oral glucose tolerance test at 24-32 weeks of gestation, to study the association of maternal glycaemia with adverse pregnancy and newborn outcomes; mothers were later genotyped and their children followed up.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000584> (<http://www.ebi.ac.uk/coho/COHO_0000584>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4634848/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9365120/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000584> "A biorepository cohort of 9,334 adults recruited sequentially at the cardiac catheterisation laboratories of Duke University, Durham, North Carolina, while undergoing evaluation for ischaemic heart disease, with fasting blood samples, genotype data and clinical data from medical records, followed for cardiovascular events and survival.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000585> (<http://www.ebi.ac.uk/coho/COHO_0000585>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8574048/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000585> "A Spanish colorectal cancer study combining two case-control studies: incident colorectal cancer cases and hospital controls recruited at the University Hospital of Bellvitge, L'Hospitalet de Llobregat (Barcelona), in 1996–1998, and cases and population controls recruited at Bellvitge and the Hospital of León in 2007–2015, genotyped to study the genetics and genomics of colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000586> (<http://www.ebi.ac.uk/coho/COHO_0000586>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10178705/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4997959/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000586> "A population-based cohort of people from Carlantino, a small genetically isolated village in Apulia (Foggia province), southern Italy, recruited as part of the Italian Network of Genetic Isolates to study the genetic basis of complex diseases and phenotypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000587> (<http://www.ebi.ac.uk/coho/COHO_0000587>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21717116") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32641421") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000587> "A case-cohort study nested in the European Prospective Investigation into Cancer and Nutrition, comprising 12,403 verified incident cases of type 2 diabetes occurring in 1991-2007 among 340,234 eligible EPIC participants in eight European countries and a centre-stratified random subcohort of 16,154, assembled by the InterAct consortium to study how genes and lifestyle, especially diet and physical activity, interact in the risk of type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000588> (<http://www.ebi.ac.uk/coho/COHO_0000588>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11399760/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7610958/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000588> "A sample of about 550 adults of European ancestry from Leipzig, Germany, with a mean BMI of about 38 kg/m2, assembled through the Integrated Research and Treatment Centre (IFB) AdiposityDiseases of the University of Leipzig with support from the German Obesity Biomaterial Bank, and genotyped on the Metabochip for studies of glycaemic and obesity-related traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000589> (<http://www.ebi.ac.uk/coho/COHO_0000589>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16167509") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36267918") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9151378") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000589> "A population-based cohort of 9,651 adults examined in 1991 in eight areas representing the range of environmental and socio-demographic conditions in Switzerland, reassessed in 2001-2003 and 2010 with spirometry, Holter ECG and a DNA and blood biobank, set up to study the long-term effects of air pollution on lung function and respiratory and cardiovascular health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000590> (<http://www.ebi.ac.uk/coho/COHO_0000590>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38769351") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39346030") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000590> "A prospective cohort of 1,629 older adults aged 65–84 years living in Bunkyo-ku, an urban area of Tokyo, sampled from the residential registries of 13 communities chosen by probability proportionate to size, examined at the Sportology Center of Juntendo University in 2015–2018 and followed for over 10 years to study muscle function, metabolic health and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000591> (<http://www.ebi.ac.uk/coho/COHO_0000591>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35010674") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36079021") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38769351") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000591> "An ongoing community cohort run by the Center for Community-based Healthcare Research and Education (CoHRE) of Shimane University, built on health examinations of community-dwelling people, largely older adults in rural towns, in Shimane Prefecture, Japan, in collaboration with local municipalities, to identify factors in healthy ageing and chronic disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000592> (<http://www.ebi.ac.uk/coho/COHO_0000592>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22737230") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35501403") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000592> "A population-based study of 4,303 non-institutionalized Chinese men aged 17–88 who attended routine physical examinations at the Medical Centre of Fangchenggang First People’s Hospital in Guangxi, China, from September to December 2009, surveyed and sampled to investigate environmental and genetic factors, and their interaction, in age-related chronic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000593> (<http://www.ebi.ac.uk/coho/COHO_0000593>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10178705/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4997959/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000593> "A population-based cohort of people from six genetically isolated villages in the Friuli Venezia Giulia region of north-eastern Italy, recruited as part of the Italian Network of Genetic Isolates to study the genetic basis of complex diseases and phenotypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000594> (<http://www.ebi.ac.uk/coho/COHO_0000594>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41586-025-08771-z/MediaObjects/41586_2025_8771_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000594> "A prospective longitudinal study, run as an NIH public-private partnership, that enrolled 4,796 men and women aged 45-79 of any race or ethnicity with, or at increased risk of, symptomatic knee osteoarthritis at four US clinical sites, with annual knee radiographs up to 96 months, to identify risk factors for the incidence and progression of knee osteoarthritis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000595> (<http://www.ebi.ac.uk/coho/COHO_0000595>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11092225/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7064039/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000595> "A cancer clinical trials network, formerly the Southwest Oncology Group, that is one of the network groups of the US National Cancer Institute's National Clinical Trials Network and runs multicentre trials of cancer treatment in adults at its member sites, whose trial cohorts include the CALGB/SWOG 80405 trial in metastatic colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000596> (<http://www.ebi.ac.uk/coho/COHO_0000596>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12584178") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11112268/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000596> "A population-based case-control study of incident colorectal cancer in the United Kingdom, run from Leeds, with cases and population controls matched for age, sex and general practitioner and interviewed about diet and smoking, first used to study meat intake, heterocyclic amines and NAT2 genotype in colorectal cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000597> (<http://www.ebi.ac.uk/coho/COHO_0000597>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4067325/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6013500/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000597> "A population-based case-control study of colon cancer in 33 counties of central and eastern North Carolina, designed to oversample African Americans and rural residents, with cases aged 40–80 identified from October 1996 to September 2000 through rapid ascertainment with the North Carolina Central Cancer Registry, collecting questionnaire, diet, medication and tumour data to study colon cancer risk and its racial differences.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000598> (<http://www.ebi.ac.uk/coho/COHO_0000598>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12329778/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9992367/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000598> "A randomized, placebo-controlled trial of alpha-tocopherol and beta-carotene supplements for the primary prevention of lung and other cancers in 29,133 male smokers aged 50–69 in Finland, recruited in 1985–1988 and supplemented for five to eight years, whose participants have since been followed as a cohort for cancer and other outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000599> (<http://www.ebi.ac.uk/coho/COHO_0000599>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34047840") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000599> "A longitudinal cohort of 1,195 children born in 2002-2003 and recruited in 2006 at about 3.5 years of age from childcare centres of the low-to-middle income South East Area of Santiago, Chile, measured annually (six-monthly from 2010) at the Instituto de Nutrición y Tecnología en Alimentos into adolescence to study growth, puberty and obesity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000600> (<http://www.ebi.ac.uk/coho/COHO_0000600>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27085081") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38060535") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39050255") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000600> "A population-based cohort of about 173,000 Korean men and women aged 40 and over recruited in 2004–2013 from the national health examinee registry at health examination centres, mainly in urban areas, as the largest cohort of the Korean Genome and Epidemiology Study, to identify environmental and genetic risk factors for major chronic diseases in Koreans.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000601> (<http://www.ebi.ac.uk/coho/COHO_0000601>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4393623/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8637572/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000601> "A registry cohort of 750 colorectal cancer patients from the Canadian province of Newfoundland and Labrador, a population with a very high incidence of familial colorectal cancer, recruited in 1999–2003 through Memorial University of Newfoundland and followed for up to 19 years, used to study familial colorectal cancer and genetic and clinical factors in survival.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000602> (<http://www.ebi.ac.uk/coho/COHO_0000602>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40222985") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41100086") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000602> "A corporate genome cohort of employees of Toshiba Corporation, a Japanese electronics company, whose health-care database for precision-medicine research holds genomic, health check-up, questionnaire and prescription data of consenting employees (over 11,600 of whom had given genetic samples by 2024), used for genetic studies such as of side effects after COVID-19 booster vaccination.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000603> (<http://www.ebi.ac.uk/coho/COHO_0000603>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12928021/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000603> "An ancillary study of the Women's Health Initiative hormone therapy trials that enrolled 7,479 cognitively unimpaired women aged 65–80 from 39 clinical sites across the United States in 1996–1999 to test the effects of conjugated equine estrogens with or without medroxyprogesterone acetate on cognitive decline and dementia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000604> (<http://www.ebi.ac.uk/coho/COHO_0000604>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41398-025-03418-z/MediaObjects/41398_2025_3418_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5714283/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000604> "A genome-wide association sub-study of the Women's Health Initiative comprising a randomly selected sample of about 8,500 African American and 3,600 Hispanic women from WHI, genotyped on the Affymetrix 6.0 array under the NHLBI SNP Health Association Resource (SHARe) project.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000605> (<http://www.ebi.ac.uk/coho/COHO_0000605>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22212639") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31831580") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000605> "A whole-population birth cohort of 1,456 children born on the Isle of Wight and recruited in 1989, assessed at birth and at 1, 2, 4, 10, 18 and 26 years, to study the natural history of asthma, allergy and lung function from infancy into adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000606> (<http://www.ebi.ac.uk/coho/COHO_0000606>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4897940/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9241628/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000606> "Population studies of type 2 diabetes and related chronic disease among Mexican Americans of Starr County, Texas, on the Texas-Mexico border, carried out by investigators of the University of Texas Health Science Center at Houston, including a systematic survey of households from randomly selected blocks in 2002-2006 with examination of selected adults and re-examination in 2010-2014, to study risk factors for diabetes and its complications.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000607> (<http://www.ebi.ac.uk/coho/COHO_0000607>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16887023") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000607> "A European multi-site family sample of children with DSM-IV combined-type ADHD, their siblings and parents, all of European Caucasian descent, recruited from twelve specialist clinics in eight countries for molecular genetic studies of ADHD, including candidate-gene, linkage and genome-wide association analyses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000608> (<http://www.ebi.ac.uk/coho/COHO_0000608>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11799070") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1201342/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000608> "An NHLBI-sponsored programme uniting four independently established multicentre family networks (GenNet, GENOA, HyperGEN and SAPPHIRe) that recruited African American, Mexican American, Asian and non-Hispanic white participants, with standardised core protocols and a pooled phenotype and genotype data set of over 11,000 individuals, to study the genetic determinants of blood pressure and hypertension.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000609> (<http://www.ebi.ac.uk/coho/COHO_0000609>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18070814") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1852917/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000609> "A randomized, double-blind trial of low-dose aspirin and vitamin E for the primary prevention of cardiovascular disease and cancer among 39,876 apparently healthy US female health professionals aged 45 or older, begun in 1992 and followed as a prospective cohort for incident disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000610> (<http://www.ebi.ac.uk/coho/COHO_0000610>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.fredhutch.org/en/research/divisions/public-health-sciences-division/research/cancer-prevention/genetics-epidemiology-colorectal-cancer-consortium-gecco.html") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000610> "An international consortium coordinated at the Fred Hutchinson Cancer Center in Seattle that pools individual-level genetic and epidemiological data from about 70 colorectal cancer case-control, cohort and trial studies in North America, Australia, Asia and Europe, over 130,000 participants, to identify genetic risk factors and gene-environment interactions for colorectal cancer and study their effects on tumours and survival.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000611> (<http://www.ebi.ac.uk/coho/COHO_0000611>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4596899/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8381233/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000611> "An international consortium, assembled within the Collaborative Oncological Gene-environment Study, that pools genotype and clinical data from prostate cancer case-control and cohort studies in North America, Europe, Asia and Australia to investigate inherited susceptibility to prostate cancer and its clinical course.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000612> (<http://www.ebi.ac.uk/coho/COHO_0000612>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31110091") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33287415") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000612> "A population-based cohort of 14,530 Singapore citizens and permanent residents of Chinese, Malay and Indian ethnicity aged 21 years and older, recruited in 2004–2010 mainly from the Singapore Prospective Study Program and the Singapore Cardiovascular Cohort Study, with additional recruitment oversampling Malays and Indians, to study chronic disease in a multi-ethnic Asian population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000613> (<http://www.ebi.ac.uk/coho/COHO_0000613>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32071038") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000613> "The Danish arm of the ADDITION-Europe trial, in which people aged 40–69 without known diabetes registered with 181 general practices in Denmark were screened stepwise for diabetes in 2001–2006 and those with screen-detected type 2 diabetes, in practices cluster-randomised to routine care or intensive multifactorial treatment (with or without GP training in motivational interviewing), were followed for cardiovascular events and mortality.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000614> (<http://www.ebi.ac.uk/coho/COHO_0000614>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21705063") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000614> "A pragmatic cluster-randomised trial in 343 general practices in Denmark, the Netherlands and the UK, in which registered patients aged 40–69 without known diabetes were screened and the 3,057 with screen-detected type 2 diabetes received routine care or early intensive multifactorial treatment and were followed for cardiovascular events and death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000615> (<http://www.ebi.ac.uk/coho/COHO_0000615>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12480102/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13532063/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9372422/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000615> "A longitudinal hospital-based cohort and biobank of patients of the Montreal Heart Institute, a cardiology hospital enriched for cardiovascular disease, who consented to give a baseline blood sample with medical, nutritional, psychosocial, sociodemographic and lifestyle data, updated through hospital record linkage and four-yearly follow-up interviews, and who are genotyped for genetic and pharmacogenomic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000616> (<http://www.ebi.ac.uk/coho/COHO_0000616>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16466435") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000616> "A prospective family study of 1,017 families (both parents and their children) from a postcode-defined area of central Exeter, United Kingdom, with anthropometry and fasting biochemistry at 28 weeks of gestation, cord blood at delivery and child follow-up to age 2 years, set up to test the fetal insulin hypothesis and identify genetic variants influencing birthweight and early postnatal growth.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000617> (<http://www.ebi.ac.uk/coho/COHO_0000617>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34887591") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000617> "A consortium of genome-wide association studies of blood lipid levels that meta-analyses summary statistics from primary studies of several genetic ancestry groups (about 1.65 million individuals from 201 studies in its 2021 round) to find loci for LDL and HDL cholesterol, triglycerides and total cholesterol.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000618> (<http://www.ebi.ac.uk/coho/COHO_0000618>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38664626") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000618> "A population-based case-control study of incident colorectal cancer cases and healthy controls recruited in northern Israel from 1998 to 2017, used to study genetic and environmental risk factors for colorectal cancer and the tumour immune microenvironment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000619> (<http://www.ebi.ac.uk/coho/COHO_0000619>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34450027") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38677085") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000619> "A prospective cohort of 116,429 female registered nurses aged 25–42 recruited in 1989 from 14 states of the United States, a younger population than the original Nurses' Health Study, followed by biennial mailed questionnaires and biospecimen collection to study risk factors for major chronic diseases in women.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000620> (<http://www.ebi.ac.uk/coho/COHO_0000620>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34187551") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000620> "A sample of healthy controls of European American and African American ancestry recruited at the National Institute on Alcohol Abuse and Alcoholism, National Institutes of Health, USA, who did not meet criteria for alcohol dependence or other major psychiatric disorders on the Structured Clinical Interview for DSM-IV and gave blood samples used for genome-wide DNA methylation analysis and genotyping on Illumina OmniExpress arrays.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000621> (<http://www.ebi.ac.uk/coho/COHO_0000621>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41609390") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41909911") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000621> "A prospective cohort of about 85,000 English-speaking adults aged 40–79, predominantly Black and low-income, enrolled in 2002–2009 in 12 states of the southeastern United States, designed to study racial disparities in cancer and other chronic disease outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000622> (<http://www.ebi.ac.uk/coho/COHO_0000622>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41092961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000622> "A hospital-based cohort of more than 565,000 participants recruited by Academia Sinica with 16 major medical centres across Taiwan, genotyped on arrays optimised for Han Chinese ancestry and linked to retrospective and prospective electronic medical records, for genome-wide, phenome-wide and polygenic risk studies of common disease and pharmacogenetic response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000623> (<http://www.ebi.ac.uk/coho/COHO_0000623>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27797990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000623> "A longitudinal family-based cohort of highly admixed residents of Baependi, a small rural town in Minas Gerais, Brazil, recruited from 2005 through probands and their relatives and followed up in 2010 and 2016 to study genetic and environmental influences on cardiovascular risk factors, sleep, circadian rhythms and mental health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000624> (<http://www.ebi.ac.uk/coho/COHO_0000624>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28321694") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000624> "A prospective birth cohort of pregnant women living in Guangzhou, China, recruited in early pregnancy at Guangzhou Women and Children's Medical Center from 2012, with biological samples from mothers, fathers and infants and planned follow-up of the children to age 18 years, to study social, biological and environmental influences on pregnancy and child health and development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000625> (<http://www.ebi.ac.uk/coho/COHO_0000625>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3198737/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000625> "A cohort of about 190 white Dutch sibling pairs aged 40–70 with symptomatic osteoarthritis at multiple joint sites, recruited from rheumatology, orthopaedic and general practice clinics around Leiden, the Netherlands, by Leiden University Medical Center to identify determinants of osteoarthritis susceptibility and progression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000626> (<http://www.ebi.ac.uk/coho/COHO_0000626>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38893188") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000626> "A cohort of US male physicians enrolled in two randomized, double-blind, placebo-controlled trials, PHS I (begun in 1982 with 22,071 physicians aged 40–84) and PHS II, testing low-dose aspirin, beta-carotene and vitamins for the primary prevention of cardiovascular disease and cancer, and followed thereafter as a prospective cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000627> (<http://www.ebi.ac.uk/coho/COHO_0000627>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36774100") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000627> "A cohort of about 2,000 healthy, unrelated young adults of Irish ancestry aged 18–28, recruited at Trinity College Dublin, Ireland, in 2003–2004, with plasma and serum samples and genotypes used to study genetic influences on circulating metabolites.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000628> (<http://www.ebi.ac.uk/coho/COHO_0000628>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30655502") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34226506") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000628> "A sample of more than 11,000 African American and European American participants recruited through treatment centres and advertisements at sites including Yale University, the University of Pennsylvania, McLean Hospital and the Medical University of South Carolina for genetic studies of cocaine, opioid and alcohol dependence, genotyped in three waves (Yale-Penn 1–3).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000629> (<http://www.ebi.ac.uk/coho/COHO_0000629>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27085081") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40405233") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42158258") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000629> "A population-based cohort of about 28,000 men and women aged 40 and over living in rural areas of South Korea, recruited in 2004–2011 as part of the Korean Genome and Epidemiology Study, with follow-up surveys in some counties, to study cardiovascular and other chronic diseases and their genetic and environmental risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000630> (<http://www.ebi.ac.uk/coho/COHO_0000630>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24341753") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000630> "A household-based cohort of individuals, households and communities in provinces across China, surveyed repeatedly since 1989 with all household members studied and in-depth community data collected, to understand how social and economic change in China affects nutrition and health outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000631> (<http://www.ebi.ac.uk/coho/COHO_0000631>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7320834/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9753387/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000631> "A cohort of about 300 overweight or obese adults (BMI of 27 kg/m2 or more) aged 54–81 of Western European ancestry, enrolled at Radboud University Medical Center in Nijmegen, the Netherlands, within the Human Functional Genomics Project to discover pathways, including inflammation and immune responses, that contribute to cardiovascular disease in overweight and obese people.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000632> (<http://www.ebi.ac.uk/coho/COHO_0000632>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41569280") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000632> "A phase 3 clinical prevention trial that screened cognitively unimpaired adults aged 65–85 with amyloid PET at 67 sites in Australia, Canada, Japan and the USA from 2014 to 2017 and tested, in those with elevated brain amyloid, whether the anti-amyloid antibody solanezumab slows cognitive decline in preclinical Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000633> (<http://www.ebi.ac.uk/coho/COHO_0000633>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22506305") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000633> "An ongoing longitudinal study of all twins born in Sweden since July 1992, whose parents are interviewed about the children's somatic and mental health and social environment at age 9 or 12, with follow-up questionnaires at ages 15 and 18 and clinical assessments at 15 of screen-positive twin pairs and controls, to study the aetiology of childhood mental health problems and their role in later adjustment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000634> (<http://www.ebi.ac.uk/coho/COHO_0000634>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3241297/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9970317/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000634> "A community-based prospective cohort of 32,894 mostly White adults in Washington County, Maryland, USA, who gave blood samples, blood pressure readings and brief medical histories during a 1989 campaign against cancer and heart disease run from the Johns Hopkins George W. Comstock Center, followed through cancer-registry linkage to study risk factors for cancer and heart disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000635> (<http://www.ebi.ac.uk/coho/COHO_0000635>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24391740") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5144126/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000635> "A family cohort of about 2,000 white European adults from 520 nuclear families (both parents aged 40–60 and two adult offspring), identified through general practices in Leicestershire, UK, and recruited in 2002–2005 to study the genetic regulation of blood pressure and related cardiovascular traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000636> (<http://www.ebi.ac.uk/coho/COHO_0000636>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40042063") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000636> "A population-based cohort of 1982 adults aged 65 and over from southwestern Pennsylvania, USA, recruited by age-stratified random sampling from electoral rolls and followed with longitudinal cognitive assessments to study cognitive decline and dementia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000637> (<http://www.ebi.ac.uk/coho/COHO_0000637>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20811451") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000637> "A collection of DNA samples and lymphoblastoid cell lines from Utah residents with ancestry from northern and western Europe, originally collected by the Centre d'Etude du Polymorphisme Humain (CEPH), that forms one of the four founding population samples of the International HapMap Project and is used as a reference for human genetic variation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000638> (<http://www.ebi.ac.uk/coho/COHO_0000638>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20811451") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000638> "A collection of DNA samples and lymphoblastoid cell lines from Yoruba people in Ibadan, Nigeria, including parent–child trios, that forms one of the four founding population samples of the International HapMap Project and is used as a reference for human genetic variation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000639> (<http://www.ebi.ac.uk/coho/COHO_0000639>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15521375") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39214547") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000639> "A single-centre Danish prospective clinical birth cohort (COPSAC2000) of 411 children born in 1998–2001 to mothers with asthma, enrolled at 1 month of age and followed closely at the COPSAC clinical research unit in Copenhagen through childhood and to age 18 to study genetic, environmental and lifestyle risk factors for asthma, atopic dermatitis, allergy and other chronic inflammatory disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000640> (<http://www.ebi.ac.uk/coho/COHO_0000640>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30591712") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000640> "A Norwegian multi-centre network of clinical sites that pools Alzheimer's disease dementia and mild cognitive impairment cases from memory-clinic and other studies (among them NorCog, DemVest, the AHUS study, HUNT dementia studies, TrønderBrain and DDI), examined with standardized cognitive, functional and behavioural measures and followed for progression, together with cognitively normal and population controls, for genetic studies of Alzheimer's disease and dementia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000641> (<http://www.ebi.ac.uk/coho/COHO_0000641>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3442244/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000641> "A consortium of genome-wide association studies of type 2 diabetes in people of European descent, whose successive case-control meta-analyses (DIAGRAMv2, DIAGRAMv3 and later) were used to discover and fine-map type 2 diabetes susceptibility loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000642> (<http://www.ebi.ac.uk/coho/COHO_0000642>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34746714") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000642> "A study population of patients with acute myeloid leukaemia, myelodysplastic syndrome or acute lymphoblastic leukaemia who received an unrelated-donor blood or marrow transplant in 2000–2011, and their HLA-matched unrelated donors, contributed by 151 US transplant centres to the Center for International Blood and Marrow Transplant Research, assembled in two cohorts to find non-HLA genetic variants associated with one-year survival after transplant.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000643> (<http://www.ebi.ac.uk/coho/COHO_0000643>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19734903") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000643> "A French consortium whose genome-wide association dataset of 2,032 Alzheimer's disease cases and 5,328 controls from France was assembled to identify late-onset Alzheimer's disease risk loci, and which later formed one of the four founding datasets of the International Genomics of Alzheimer's Project.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000644> (<http://www.ebi.ac.uk/coho/COHO_0000644>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34002374") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://cordis.europa.eu/project/id/37315") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000644> "A European consortium of clinical and laboratory epilepsy research groups, funded in 2007–2011 by the EU Sixth Framework Programme as the EPICURE project and coordinated by the Fondazione IRCCS Istituto Neurologico Carlo Besta in Italy, whose collections of people with genetic generalized epilepsy (such as the EPICURE-SP1 cohort) contributed cases to genome-wide association studies of epilepsy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000645> (<http://www.ebi.ac.uk/coho/COHO_0000645>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20522523") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30531953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37653029") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000645> "A collection of people with epilepsy and controls recruited and phenotyped with GlaxoSmithKline funding by the GenEpA Consortium in Finland, Norway, Switzerland and Austria, whose national sample sets were genotyped and contributed to genome-wide association studies of the common epilepsies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000646> (<http://www.ebi.ac.uk/coho/COHO_0000646>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19734902") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29532500") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39633006") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000646> "A consortium led from Cardiff University that brought together Alzheimer's disease cases and screened elderly controls recruited by institutions in the United Kingdom, Germany and the United States, with population controls from existing British and German cohorts, into a genome-wide association dataset of Alzheimer's disease; one of the four datasets meta-analysed by the International Genomics of Alzheimer's Project.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000647> (<http://www.ebi.ac.uk/coho/COHO_0000647>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31204010") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000647> "A University of Michigan study that engages the public through a Facebook application for health-history and daily-tracking surveys and mails saliva kits for genotyping to participants who complete enough surveys, having engaged more than 80,000 people from all 50 US states by 2019 for genetic research on health and behaviour.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000648> (<http://www.ebi.ac.uk/coho/COHO_0000648>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25087078") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37653029") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000648> "A collection of people with epilepsy of European (British) ancestry, assembled by the Imperial-Liverpool-Melbourne Collaboration and genotyped genome-wide, that contributed cases to the ILAE Consortium on Complex Epilepsies meta-analyses of genome-wide association studies of the common epilepsies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000649> (<http://www.ebi.ac.uk/coho/COHO_0000649>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25519314") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35399580") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8901667") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000649> "A family-based study of Mexican Americans in San Antonio, Texas, United States, made up of the San Antonio Family Heart Study (extended families of randomly selected low-income Mexican American probands) and the San Antonio Family Diabetes/Gallbladder Study (extended families of probands with type 2 diabetes from the San Antonio Heart Study), both begun in 1991 and followed with repeated examinations, to study the genetics of cardiovascular disease, type 2 diabetes and related traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000650> (<http://www.ebi.ac.uk/coho/COHO_0000650>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40188287") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000650> "A longitudinal study of same-sex twin pairs born in Sweden and drawn from the Swedish Twin Registry, including pairs separated before age 11 and reared apart, with questionnaires and in-person testing from 1984 to 2014, to understand the factors that contribute to healthy ageing and longevity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000651> (<http://www.ebi.ac.uk/coho/COHO_0000651>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24021684") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26708676") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36672803") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000651> "A network, funded by the US National Institute of Neurological Disorders and Stroke, that brought together ischaemic stroke case collections from genetic research centres in the United States, Europe and Australia, with stroke subtypes harmonised by the web-based Causative Classification of Stroke system, for genome-wide association studies of ischaemic stroke and its subtypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000652> (<http://www.ebi.ac.uk/coho/COHO_0000652>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24029743") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000652> "A multicentre observational cohort of current and former smokers aged 40–80 with or without airflow obstruction, and never-smoking controls, recruited at clinical sites across the United States with baseline and annual follow-up visits, to find subgroups of chronic obstructive pulmonary disease and biomarkers usable as intermediate outcomes in therapeutic trials.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000653> (<http://www.ebi.ac.uk/coho/COHO_0000653>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35241739") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000653> "A hospital-based cohort of older adults, many with various diseases, at the Veterans Health Service Medical Center in Seoul, South Korea, with samples held by the Veterans Medical Research Institute Biobank and genotyped on the Korea Biobank Array for genome-wide association studies of body composition and cardiometabolic traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000654> (<http://www.ebi.ac.uk/coho/COHO_0000654>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19659826") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000654> "A multinational European network of patients with cervical artery dissection, with ischaemic stroke patients of other causes and healthy controls, recruited with standardised clinical, laboratory, imaging, treatment and outcome data to identify genetic variants and environmental factors associated with cervical artery dissection.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000655> (<http://www.ebi.ac.uk/coho/COHO_0000655>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26842272") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40122564") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000655> "A prospective prebirth cohort of about 1,000 pregnant women aged 18 or over recruited in the first trimester at the pregnancy blood-sampling clinic in Sherbrooke, Canada, between 2010 and 2013, and their children, followed to study the biological, environmental and genetic determinants of glucose regulation in pregnancy and its effects on fetal development and offspring health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000656> (<http://www.ebi.ac.uk/coho/COHO_0000656>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12688622") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35931775") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000656> "A population-based birth cohort of children recruited in utero through the antenatal clinics of Wythenshawe and Stepping Hill Hospitals in South Manchester and Cheshire, England, with parents screened for atopy, and followed prospectively through childhood to study the genetic and environmental determinants of asthma and allergic disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000657> (<http://www.ebi.ac.uk/coho/COHO_0000657>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35080193") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37060189") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://pbcar.healthsci.mcmaster.ca/research/projects/population-assessment-for-tomorrows-health-study-path/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000657> "A research registry of community volunteers aged 18 to 65 living in the Greater Hamilton area, with or without addiction problems, run by the Peter Boris Centre for Addictions Research at St. Joseph's Healthcare Hamilton, whose participants completed questionnaires, simple physical measurements and an in-person assessment and gave saliva for DNA genotyping through 23andMe, to build a cohort for research on the causes, consequences and treatment of addiction.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000658> (<http://www.ebi.ac.uk/coho/COHO_0000658>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34488438") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39250516") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000658> "A prospective community-based cohort of 9,540 Han Chinese adults aged 40 and over enrolled in December 2011–April 2012 in the Gucheng and Pingguoyuan communities of Shijingshan district, Beijing, China, by Peking University with the University of Michigan, to study atherosclerosis, blood pressure and other cardiovascular traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000659> (<http://www.ebi.ac.uk/coho/COHO_0000659>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35927272") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000659> "A population-based prospective cohort of 63,257 Chinese adults aged 45–74 years from the Hokkien and Cantonese dialect groups living in Singapore, recruited from April 1993 to December 1998 and followed with repeated interviews, to study diet, lifestyle, genetic factors and chronic disease and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000660> (<http://www.ebi.ac.uk/coho/COHO_0000660>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29373861") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000660> "A prospective cohort of 50,884 women aged 35–74 living in the United States and Puerto Rico who had never had breast cancer but had a sister diagnosed with it, enrolled from 2003 by the National Institute of Environmental Health Sciences with biological and environmental samples to study environmental and genetic risk factors for breast cancer and other health outcomes in women.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000661> (<http://www.ebi.ac.uk/coho/COHO_0000661>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31619424") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000661> "A multicentre prospective cohort of more than 1,100 patients newly diagnosed with non-muscle-invasive bladder cancer, recruited in 2014–2021 from 22 hospitals in the Netherlands and followed with questionnaires, diaries, blood and tumour samples and cancer registry data to study how lifestyle habits relate to prognosis and health-related quality of life.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000662> (<http://www.ebi.ac.uk/coho/COHO_0000662>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34093281") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37269009") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40826483") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000662> "A six-week multicentre randomised open-label pharmacogenetic trial cohort of about 3,000 Han Chinese inpatients with schizophrenia in an acute phase, recruited through the Chinese Antipsychotics Pharmacogenomics Consortium of five research centres and their affiliated psychiatric hospitals in China, established in 2010, and randomly assigned to one of six antipsychotic treatments, to identify predictors of antipsychotic efficacy and adverse reactions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000663> (<http://www.ebi.ac.uk/coho/COHO_0000663>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10138356/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000663> "A population-based cohort of about 1,000 adults from the mainland city of Split, the second-largest city in Croatia, recruited within the 10,001 Dalmatians biobank project as an urban counterpart to the isolated island cohorts of Vis and Korčula, for studies of the genetic, environmental and social determinants of health and disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000664> (<http://www.ebi.ac.uk/coho/COHO_0000664>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35624665") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8590334") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000664> "A French case-control and family-based cohort of asthma cases recruited in chest clinics in Grenoble, Lyon, Marseille, Montpellier and Paris, their first-degree relatives and population-based controls, enrolled in 1991–1995 and followed up in 2003–2007 and later, to study the genetic and environmental causes of asthma, bronchial hyperresponsiveness and atopy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000665> (<http://www.ebi.ac.uk/coho/COHO_0000665>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12992613/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000665> "A population-based cohort of 9,940 adults aged 50–75 recruited by their general practitioners during routine health check-ups in Saarland, Germany, between 2000 and 2002 and followed every two to three years, run by the German Cancer Research Center (DKFZ) in Heidelberg to study the prevention, early detection and treatment of chronic diseases in older people.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000666> (<http://www.ebi.ac.uk/coho/COHO_0000666>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36066633") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42237039") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000666> "A collection of Alzheimer's disease cases and dementia-free controls from Sweden that combines cases diagnosed in memory clinics in different parts of Sweden or identified in two population-based studies in Gothenburg, the Prospective Population Study of Women and the Gothenburg Birth Cohort Studies (H70, H85 and 95+), with controls from those Gothenburg population studies, genotyped for genome-wide association studies of Alzheimer's disease and its biomarkers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000667> (<http://www.ebi.ac.uk/coho/COHO_0000667>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25327703") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006574/supplementaryFiles") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000667> "The Northern California site of the Breast Cancer Family Registry, which from 1995 enrolled about 4000 women with incident breast cancer, ascertained through the Greater Bay Area Cancer Registry in the San Francisco Bay Area with oversampling of cases with indicators of increased genetic susceptibility, together with their family members and random-digit-dialled population controls, to study the genetic epidemiology of breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000668> (<http://www.ebi.ac.uk/coho/COHO_0000668>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15217505") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000668> "A breast cancer family registry established in 1995 with US National Cancer Institute support as a collaboration of six academic and research institutions in the USA, Canada and Australia, enrolling population-based families (through cancer registries) and clinic-based families with common questionnaires, biospecimen protocols and pathology review, to support studies of the genetic epidemiology of breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000669> (<http://www.ebi.ac.uk/coho/COHO_0000669>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21379329") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000669> "A family study that recruited 992 multiplex late-onset Alzheimer's disease families, with at least two living affected members, together with unrelated neurologically evaluated controls, from throughout the United States, for genetic studies of late-onset Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000670> (<http://www.ebi.ac.uk/coho/COHO_0000670>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13482911/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000670> "A community-based longitudinal cohort of 3,298 stroke-free, predominantly Hispanic, Black and White adults aged 40 or older living in northern Manhattan, New York City, recruited by random-digit dialling in 1993–2001 and followed for stroke, vascular risk factors, brain MRI markers and cognitive outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000671> (<http://www.ebi.ac.uk/coho/COHO_0000671>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35172313") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000671> "A multiethnic family-based collection of people with nonsyndromic orofacial clefts, their unaffected relatives and unaffected controls, recruited by the University of Pittsburgh through cleft centres in the United States and Puerto Rico and in Argentina, the Philippines, Colombia, Guatemala and Hungary to study the genetics of orofacial clefts and related dental traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000672> (<http://www.ebi.ac.uk/coho/COHO_0000672>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32461290") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000672> "A cohort of 20,689 adults in Australia who had been diagnosed with depression, recruited through the Australian Department of Human Services and a media campaign, who completed online questionnaires on psychiatric history and antidepressant response and provided saliva DNA, to study genetic and environmental risk factors for depression and antidepressant response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000673> (<http://www.ebi.ac.uk/coho/COHO_0000673>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25991711") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000673> "A sub-study of the Avon Longitudinal Study of Parents and Children comprising 1,018 mother-offspring pairs with genome-wide DNA methylation profiled at birth, in childhood and in adolescence for the children and at two time points for the mothers, established as an openly accessible resource to study the determinants and consequences of epigenetic variation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000674> (<http://www.ebi.ac.uk/coho/COHO_0000674>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34741163") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000674> "An international collaborative initiative that pooled individual-level and aggregate genetic data on 12,852 people with irritable bowel syndrome and 139,981 controls from multiple studies for genome-wide association studies of irritable bowel syndrome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000675> (<http://www.ebi.ac.uk/coho/COHO_0000675>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41361163") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000675> "A cohort of people of European ancestry with and without age-related macular degeneration, recruited, imaged with optical coherence tomography and genotyped by the Centre for Eye Research Australia, used in genetic studies of age-related macular degeneration and reticular pseudodrusen.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000676> (<http://www.ebi.ac.uk/coho/COHO_0000676>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://cibmtr.org/CIBMTR/Resources/Biorepository-Inventories") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000676> "A biorepository of blood samples from more than 60,000 allogeneic haematopoietic cell transplant recipients and their related or unrelated donors or cord blood units, held by the Center for International Blood and Marrow Transplant Research (a collaboration of the Medical College of Wisconsin and NMDP) and linked to validated clinical outcome data in the CIBMTR Research Database, for research on transplant outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000677> (<http://www.ebi.ac.uk/coho/COHO_0000677>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35813487") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000677> "A French multicentre longitudinal cohort of patients with early Parkinson's disease (disease duration of two years or less at recruitment) recruited from clinics in France and followed annually with clinical assessments and genotyping, supported by Assistance Publique Hôpitaux de Paris and registered as NCT01564992.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000678> (<http://www.ebi.ac.uk/coho/COHO_0000678>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26413278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000678> "A research collection of patients with kidney disease, including children and young adults with nephrotic syndrome and focal segmental glomerulosclerosis, referred from Duke University and collaborating centres to Duke University's genetics of kidney disease research program in Durham, North Carolina, for genetic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000679> (<http://www.ebi.ac.uk/coho/COHO_0000679>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35136347") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000679> "A multicentre prospective epidemiological study enrolling patients with age-related macular degeneration and healthy control individuals aged 55 years or over at the ophthalmology departments of University Hospital Cologne, Germany, and Radboud University Medical Center, Nijmegen, the Netherlands, used to study genetic and non-genetic risk factors for age-related macular degeneration.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000680> (<http://www.ebi.ac.uk/coho/COHO_0000680>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19781411") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37908396") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000680> "A Canadian longitudinal birth cohort of about 850 families (mother, father, newborn and eldest sibling) recruited during pregnancy at three hospitals in Ontario between 2002 and 2009, followed to study prenatal, early-childhood and family determinants of adiposity, cardiovascular risk factors and atherosclerosis in children.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000681> (<http://www.ebi.ac.uk/coho/COHO_0000681>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18372903") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9614613") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000681> "A Finnish–US study of type 2 diabetes genetics that ascertained Finnish families with type 2 diabetes in at least two siblings, with spouses and offspring examined by frequently sampled intravenous glucose tolerance tests, and later Finnish type 2 diabetes cases and normoglycaemic controls, to map susceptibility genes for type 2 diabetes and related quantitative traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000682> (<http://www.ebi.ac.uk/coho/COHO_0000682>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40042063") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000682> "A randomized, placebo-controlled trial of Ginkgo biloba for preventing incident dementia in 3069 adults aged 75 and over, 2587 cognitively normal and 482 with mild cognitive impairment, conducted from 2000 to 2008 at five academic centers in the United States.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000683> (<http://www.ebi.ac.uk/coho/COHO_0000683>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25987846") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S2210776226000724-mmc1.docx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000683> "A biobank set up in 2008 at Princess Margaret Hospital, Toronto, Canada, holding biospecimens, including blood for DNA extraction, from patients attending its Genito-Urinary Oncology clinics for the suspicion, diagnosis or treatment of prostate, kidney, bladder, testis or penile tumours, whose non-muscle invasive bladder cancer patients, in two batches (GUB-1 and GUB-2), were used in genetic studies of recurrence and progression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000684> (<http://www.ebi.ac.uk/coho/COHO_0000684>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000684> "A case-control study of ischaemic stroke in Japan combining 1,113 patients with ischaemic stroke recruited in 2004 from seven hospitals in Fukuoka Prefecture (the Fukuoka Stroke Registry) with 901 controls free of stroke and coronary heart disease drawn from the population-based Hisayama Study, used in genome-wide association studies of ischaemic stroke and its subtypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000685> (<http://www.ebi.ac.uk/coho/COHO_0000685>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29532500") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000685> "An international collaboration that meta-analysed genome-wide association data on late-onset Alzheimer's disease from four consortia, the Alzheimer Disease Genetics Consortium, the Cohorts for Heart and Aging Research in Genomic Epidemiology Consortium, the European Alzheimer's Disease Initiative and the Genetic and Environmental Risk in Alzheimer's Disease Consortium, first with 17,008 cases and 37,154 controls of European ancestry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000686> (<http://www.ebi.ac.uk/coho/COHO_0000686>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000686> "A family study of Mexican Americans in the Los Angeles area, United States, in which the families of probands with documented coronary artery disease were recruited to examine the genetic basis of coronary artery disease and insulin resistance.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000687> (<http://www.ebi.ac.uk/coho/COHO_0000687>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24124113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000687> "A consortium of seven Mexican-American cohorts in the United States (the IRAS Family Study, BetaGene, MACAD, HTN-IR, NIDDM-Athero, IRAS and TRIPOD; 4,336 individuals in 1,346 pedigrees) formed to conduct genome-wide association studies of insulin sensitivity and insulin clearance measured by euglycemic clamp or frequently sampled intravenous glucose tolerance test.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000688> (<http://www.ebi.ac.uk/coho/COHO_0000688>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23041239") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000688> "A collaboration that meta-analyses genome-wide association datasets from ischaemic stroke case-control cohorts of European ancestry (initially 15 cohorts with 12,389 cases and 62,004 controls) to validate previously reported associations and identify new genetic associations with ischaemic stroke and its subtypes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000689> (<http://www.ebi.ac.uk/coho/COHO_0000689>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40042063") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000689> "A prospective cohort of 1681 adults aged 65 and over living in the Monongahela Valley, Pennsylvania, USA, recruited from voter registration lists in 1987–1989 and followed every other year for up to 12 years to study cognitive decline and dementia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000690> (<http://www.ebi.ac.uk/coho/COHO_0000690>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26919119") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27639277") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000690> "A Finnish pregnancy cohort of 4,785 women recruited at their first ultrasound scan in ten hospital maternity clinics between 2005 and 2010, comprising a high-risk subsample with and without risk factors for preeclampsia and intrauterine growth restriction and a community-based subsample, followed with their children to study the prediction and prevention of pregnancy complications and prenatal influences on offspring development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000691> (<http://www.ebi.ac.uk/coho/COHO_0000691>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000456.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000691> "A case-control study of stroke recruiting over 5,000 imaging-confirmed stroke cases and 5,000 controls from seven centres in Pakistan, investigating genetic, biomarker and lifestyle determinants of stroke and its subtypes, and using controls from the Pakistan Risk of Myocardial Infarction Study for genetic analyses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000692> (<http://www.ebi.ac.uk/coho/COHO_0000692>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9554233/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000692> "A prospective population-based cohort of 30,239 African American and European American adults aged 45 or older recruited from the 48 contiguous US states and the District of Columbia in 2003–2007, designed to measure stroke incidence and its risk factors and to explain geographic and racial differences in stroke.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000693> (<http://www.ebi.ac.uk/coho/COHO_0000693>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23552052") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000693> "A randomized, double-blind, placebo-controlled, 2 × 2 factorial trial of selenium and vitamin E, alone and in combination, for the prevention of prostate cancer, which enrolled 35,533 men from the United States, Canada and Puerto Rico at more than 400 clinical sites.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000694> (<http://www.ebi.ac.uk/coho/COHO_0000694>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25380809") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000694> "A multicentre, multinational European prospective observational study of 5,023 patients aged 18–55 with acute stroke or transient ischaemic attack, enrolled at 47 centres in 15 European countries between 2007 and 2010, originally designed to investigate the relation between juvenile stroke and Fabry disease and also used to study stroke patterns in young adults.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000695> (<http://www.ebi.ac.uk/coho/COHO_0000695>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20010834") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000695> "A consortium of cohort studies of European-ancestry individuals, initially 14 genome-wide association studies with over 20,000 participants and later expanded to about 79,000, established to meta-analyse genome-wide association studies of spirometric lung function.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000696> (<http://www.ebi.ac.uk/coho/COHO_0000696>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24585852") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000696> "A longitudinal study of men and women who graduated from Wisconsin high schools in 1957, most born in 1939, and one of their randomly selected siblings, followed for almost 60 years to link family background, adolescent characteristics, education, work and family life to later-life physical and mental health, cognition and mortality, with saliva samples for genetic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000697> (<http://www.ebi.ac.uk/coho/COHO_0000697>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19892208") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000697> "A study of low-income, predominantly African American adults recruited from the primary care and obstetrics-gynaecology clinics of Grady Memorial Hospital, an urban public hospital in Atlanta, United States, to investigate environmental and genetic risk factors for trauma-related disorders such as posttraumatic stress disorder and depression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000698> (<http://www.ebi.ac.uk/coho/COHO_0000698>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10138356/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6016867/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000698> "A Croatian biobank project, based at the University of Split with UK Medical Research Council funding, that recruited adults from the isolated Dalmatian islands of Vis and Korčula and from the mainland city of Split into separate cohorts, to investigate genetic, environmental and social determinants of health and disease in Croatia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000699> (<http://www.ebi.ac.uk/coho/COHO_0000699>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29546429") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000699> "A cohort of 1,091 people born in 1936 who took an intelligence test at age 11 in the Scottish Mental Survey of 1947, recruited in 2004–2007 at a mean age of 70, mostly living in Edinburgh and the Lothians, and retested about every 3 years with cognitive, biomedical, brain imaging and lifestyle assessments to study non-pathological cognitive ageing from childhood to older age.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000700> (<http://www.ebi.ac.uk/coho/COHO_0000700>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29546429") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000700> "A cohort of 550 people born in 1921 who took an intelligence test at age 11 in the Scottish Mental Survey of 1932, recruited in 1999–2001 at a mean age of 79, mostly living in Edinburgh and the Lothians, and followed up five times to age 92 to study non-pathological cognitive ageing from childhood to older age.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000701> (<http://www.ebi.ac.uk/coho/COHO_0000701>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42084756") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000701> "A nationally representative cohort of people in the United States born between 1976 and 1982, enrolled as adolescents and followed in repeated waves into adulthood with self-report, parent-report, geocoded and genetic data to study how adolescent circumstances shape later health and wellbeing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000702> (<http://www.ebi.ac.uk/coho/COHO_0000702>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30379906") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35998220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000702> "A cohort of Spanish schoolchildren recruited at schools in Andalucía, the Basque Country, Castilla-León, Murcia and the Canary Islands by the Basque Center on Cognition, Brain and Language, who gave saliva for DNA and were assessed with reading, phonological, attention and IQ tasks, and whose genome-wide genotypes are used to study the genetics of dyslexia, ADHD and reading- and language-related skills.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000703> (<http://www.ebi.ac.uk/coho/COHO_0000703>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19017778") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:8866565") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000703> "A family study of patients with type 2 diabetes, their first-degree relatives and spouses without a family history of diabetes in western Finland, examined with oral glucose tolerance tests and euglycaemic insulin clamps and followed prospectively to study the inheritance, metabolic features and prediction of type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000704> (<http://www.ebi.ac.uk/coho/COHO_0000704>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36266505") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000704> "A family-based sample selected for dyslexia by the Colorado Learning Disabilities Research Center at the University of Colorado, United States, in which children and their families were assessed with reading, spelling, phonological and IQ tests and genotyped to study the genetics of reading disability.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000705> (<http://www.ebi.ac.uk/coho/COHO_0000705>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16801592") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21646370") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2798726/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000705> "A German study run from the Technical University of Dresden, with participants from Saxony, of people at increased risk of type 2 diabetes who had a 75-g oral glucose tolerance test at baseline and again after about three years, which also contributed patients with type 2 diabetes and controls to consortium genetic studies of type 2 diabetes and glycaemic traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000706> (<http://www.ebi.ac.uk/coho/COHO_0000706>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18216052") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000706> "A 3-year multinational observational cohort of about 2,180 patients with moderate to very severe chronic obstructive pulmonary disease and smoking and non-smoking controls, recruited at 46 centres in 12 countries in North America, Europe and New Zealand, to define COPD subtypes and find clinical, imaging, biomarker and genetic predictors of disease progression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000707> (<http://www.ebi.ac.uk/coho/COHO_0000707>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41237490") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000707> "A population-based cohort of 1910 infants recruited at 8 months of age in Melbourne, Australia, in 2003–2004 and followed through childhood with parent reports and language assessments to study language development and its early-life predictors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000708> (<http://www.ebi.ac.uk/coho/COHO_0000708>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30402607") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000708> "A prospective population-based German birth cohort of 5,991 healthy term newborns recruited in obstetric hospitals in Munich and Wesel in 1995–1998, comprising a double-blind randomised trial of hydrolysed infant formula in children with a family history of allergy (the German Infant Nutritional Intervention study, GINI) and a non-interventional arm, about 55% of whom were followed for the first 10 years to study the natural course of atopic diseases and their determinants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000709> (<http://www.ebi.ac.uk/coho/COHO_0000709>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22792071") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000709> "A cohort of 1,068 young men aged 18–20, randomly identified in the greater Gothenburg area of Sweden from national population registers, initiated to determine environmental and genetic factors involved in the regulation of bone and fat mass, with a five-year follow-up examination.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000710> (<http://www.ebi.ac.uk/coho/COHO_0000710>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21935397") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000710> "A case-control sample of extremely overweight young Danish adults and equal numbers of randomly drawn population controls, selected from women of the Danish National Birth Cohort and men of a Danish draft-board examination cohort, for genome-wide association study of body mass index.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000711> (<http://www.ebi.ac.uk/coho/COHO_0000711>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21909115") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000711> "A consortium of genome-wide association studies of systolic and diastolic blood pressure, whose 2011 multi-stage meta-analysis combined about 200,000 individuals of European descent to find blood pressure loci and relate them to hypertension and cardiovascular disease risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000712> (<http://www.ebi.ac.uk/coho/COHO_0000712>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23691092") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24509779") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35998220") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000712> "A case-control sample of 219 children with language impairment and 209 sex- and age-matched, unrelated controls collected at the University of Iowa, United States, who completed a battery of language measures (including the Peabody Picture Vocabulary Test and nonword repetition) used to define case status, and reading, spelling and IQ assessments, used in genetic association studies of language impairment and of reading- and language-related skills.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000713> (<http://www.ebi.ac.uk/coho/COHO_0000713>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39512701") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000713> "A hospital-based Korean dementia research programme made up of three prospective cohorts (the PREMIER consortium, the LLOD cohort and the Samsung Medical Center amyloid PET cohort) at 28 centres, which by December 2023 had recruited over 5,800 participants across the Alzheimer's clinical syndrome, subcortical vascular cognitive impairment and frontotemporal dementia spectra, with clinical, neuroimaging, biomarker and genomic data, to study disease progression and early diagnosis of dementia in the Korean population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000714> (<http://www.ebi.ac.uk/coho/COHO_0000714>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21646302") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000714> "A genotype-phenotype resource assembled at Mayo Clinic from participants of multiple Mayo Clinic research studies who gave general research consent to share their high-throughput genotyping data, linked to electronic medical record data for phenotype extraction, to enable cost-effective genome-wide association studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000715> (<http://www.ebi.ac.uk/coho/COHO_0000715>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8886846/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000715> "A population-based cohort of people aged 30–75 years born in Iraq or Sweden and resident in Malmö, Sweden, randomly selected from the Malmö census register, to study the impact of migration and ethnicity on type 2 diabetes and related metabolic traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000716> (<http://www.ebi.ac.uk/coho/COHO_0000716>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41748696") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000716> "A biobank of patients with Crohn's disease or ulcerative colitis and non-IBD controls recruited with informed consent at Cedars-Sinai Medical Center in Los Angeles, United States, holding clinical phenotype, serological and genetic data and specimens for inflammatory bowel disease research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000717> (<http://www.ebi.ac.uk/coho/COHO_0000717>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27393504") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000717> "A collection of African American lung cancer cases and controls drawn from eight US lung cancer studies, among them the Southern Community Cohort Study, the NCI-MD Lung Cancer Case-Control Study, the MD Anderson Lung Cancer Epidemiology Study and the Northern California Lung Cancer Study, genotyped for a genome-wide association study of lung cancer and smoking phenotypes in African Americans.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000718> (<http://www.ebi.ac.uk/coho/COHO_0000718>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36686985") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000718> "A cohort of patients with Crohn's disease, ulcerative colitis or unclassified inflammatory bowel disease recruited since 2003 by the genetic research centres of the NIDDK IBD Genetics Consortium in the United States and Canada, with diagnoses confirmed by chart review, for IBD gene discovery.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000719> (<http://www.ebi.ac.uk/coho/COHO_0000719>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20697030") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000719> "A case-control collection of autopsied Alzheimer disease cases and non-demented controls, drawn from longitudinal aging research cohorts at 10 NIA-funded Alzheimer's Disease Centers in the United States and assembled at Oregon Health & Science University for genome-wide association studies of Alzheimer disease and its neuropathology within the Alzheimer's Disease Genetics Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000720> (<http://www.ebi.ac.uk/coho/COHO_0000720>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32157568") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33133009") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35379992") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000720> "A sample collected at the University of Munich, Germany, of about 3,000 healthy volunteers of German descent from the Munich area, assessed with structured psychiatric interviews covering themselves and their first-degree relatives, together with about 1,000 patients with schizophrenia and about 300 people with other diagnoses, including Alzheimer's disease patients from the psychiatric memory clinic, used as a case and control resource in genetic studies of psychiatric, neurological and neurodegenerative disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000721> (<http://www.ebi.ac.uk/coho/COHO_0000721>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25616159") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000721> "A study of children and adolescents aged 2–16 years with physician-diagnosed asthma recruited through 15 secondary-care asthma clinics across Scotland from 2008 to 2011, with questionnaire and DNA data to study genetic and environmental influences on asthma and its treatment response.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000722> (<http://www.ebi.ac.uk/coho/COHO_0000722>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28259484") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000722> "A prospective inception cohort of patients younger than 18 years with suspected inflammatory bowel disease, enrolled at diagnosis between 2008 and 2012 at 28 sites in the United States and Canada (mostly Crohn's disease, also ulcerative colitis, unclassified IBD and non-inflamed controls), to characterise the natural history of newly diagnosed paediatric Crohn's disease and predict its complications from clinical, serological, genomic and microbial markers at diagnosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000723> (<http://www.ebi.ac.uk/coho/COHO_0000723>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36872777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.txalzresearch.org/research/the-texas-harris-alzheimers-research-study/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000723> "A longitudinal research cohort begun in June 2005 by the Texas Alzheimer's Research and Care Consortium, which has enrolled more than 3,600 older adults with Alzheimer's disease, mild cognitive impairment or normal cognition, with deliberate inclusion of Mexican Americans, at the consortium's Texas sites and followed annually with clinical, neuropsychological, genetic and blood biomarker assessments, to improve the diagnosis, treatment and prevention of Alzheimer's disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000724> (<http://www.ebi.ac.uk/coho/COHO_0000724>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30676649") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000724> "A longitudinal cohort of children at family risk of dyslexia, children with preschool language difficulties and typically developing controls, recruited from about age 3½ in 2007–2009 from York and neighbouring regions of northern England by the University of York and followed to study the development of language, reading and dyslexia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000725> (<http://www.ebi.ac.uk/coho/COHO_0000725>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32744536") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000725> "A multicentre prospective observational cohort of patients with inflammatory bowel disease recruited at seven academic medical centres in the United States, collecting longitudinal clinical and phenotypic data and biosamples for clinical outcomes and translational research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000726> (<http://www.ebi.ac.uk/coho/COHO_0000726>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21120588") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000726> "A community-based prospective cohort of middle-aged and elderly adults aged 40 and over in Shanghai, China, recruited from February 2009 to study multiple chronic diseases including obesity and metabolic syndrome, diabetes, osteoporosis, liver, cardiovascular and neurological diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000727> (<http://www.ebi.ac.uk/coho/COHO_0000727>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21968928") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000727> "A study begun in 2001 as a National Cancer Institute programme project in which nicotine-dependent smokers and non-dependent smoking controls were recruited from communities in Detroit and St. Louis, United States, to identify genetic factors in nicotine dependence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000728> (<http://www.ebi.ac.uk/coho/COHO_0000728>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36421415") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39408904") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39806399") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000728> "A prospective cohort of Mediterranean (southern European) pregnant women attending the Diabetes and Pregnancy Unit of Hospital Universitario Virgen de la Victoria in Málaga, Spain, after a positive glucose screening test, recruited from 2019 with and without gestational diabetes and followed with their offspring to one year after birth, to study the effect of gestational diabetes on the epigenome of mother and child during the first 1000 days.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000729> (<http://www.ebi.ac.uk/coho/COHO_0000729>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15642484") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000729> "A multicentre family-based and case-control study of European American, African American, Mexican American and American Indian people with diabetes, with and without diabetic nephropathy, and their relatives, recruited at eight US clinical centres to identify genetic determinants of diabetic nephropathy.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000730> (<http://www.ebi.ac.uk/coho/COHO_0000730>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35255492") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37198478") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://genomicc.org/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000730> "An international study, recruiting since 2015, of critically ill patients in intensive care units in the United Kingdom and other countries, with conditions such as sepsis, acute respiratory distress syndrome and influenza and, from 2020, critical COVID-19, whose genomes are compared with those of population controls to find host genetic factors and disease mechanisms underlying critical illness.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000731> (<http://www.ebi.ac.uk/coho/COHO_0000731>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23535729") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35418701") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000731> "A collaborative genotyping experiment of four cancer genetics consortia, studying breast cancer (the Breast Cancer Association Consortium), ovarian cancer, prostate cancer, and breast and ovarian cancer in BRCA1 and BRCA2 mutation carriers, funded by the EU Seventh Framework Programme, which genotyped samples from their member studies on a custom Illumina iSelect array (iCOGS) of more than 200,000 SNPs to identify cancer susceptibility loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000732> (<http://www.ebi.ac.uk/coho/COHO_0000732>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24611536") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000732> "A population-based case-control study of colon cancer in Kentucky, United States, that recruited incident cases through the Kentucky Cancer Registry and population controls by random-digit dialling from 2003 to 2010, to study genetic and environmental risk factors for colon cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000733> (<http://www.ebi.ac.uk/coho/COHO_0000733>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15177962") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000733> "A population-based cohort of 6,357 Latinos aged 40 years and older, mostly of Mexican origin, from six census tracts in Los Angeles, California, United States, examined from 2000 to assess the prevalence and risk factors of visual impairment and eye diseases such as cataract, glaucoma, diabetic retinopathy and age-related macular degeneration.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000734> (<http://www.ebi.ac.uk/coho/COHO_0000734>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23505323") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000734> "A case-control collection of Mexican adults with hypertriglyceridaemia and normotriglyceridaemic controls recruited at the Instituto Nacional de Ciencias Médicas y Nutrición Salvador Zubirán in Mexico City, Mexico, for the first genome-wide association study of lipids in Mexicans.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000735> (<http://www.ebi.ac.uk/coho/COHO_0000735>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25327703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000735> "A population-based multiethnic case-control study of breast cancer in the San Francisco Bay Area, California, in which women aged 35–79 diagnosed with invasive breast cancer in 1995–2002 were identified through the Greater Bay Area Cancer Registry and controls were identified by random-digit dialing and matched on 5-year age group.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000736> (<http://www.ebi.ac.uk/coho/COHO_0000736>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24390345") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000736> "A consortium formed under the Slim Initiative in Genomic Medicine for the Americas that pooled type 2 diabetes case-control samples of Mexicans and other Latin Americans from the Diabetes in Mexico Study, the Mexico City Diabetes Study, the Multiethnic Cohort Study and the UNAM/INCMNSZ Diabetes Study to characterise the genetic basis of type 2 diabetes in Mexican and Latin American populations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000737> (<http://www.ebi.ac.uk/coho/COHO_0000737>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26780889") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000737> "A case-control sample of 898 Mexican adults with type 2 diabetes and 889 controls, covered by the Mexican Social Security Institute and studied through the Medical Center Siglo XXI in Mexico City, Mexico, used in genome-wide association studies of lipid traits and type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000738> (<http://www.ebi.ac.uk/coho/COHO_0000738>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21573907") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26780889") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35399580") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000738> "A case-control sample of 967 Mexican adults with type 2 diabetes, preferentially diagnosed before age 55, and 343 normoglycaemic controls from Mexico City, Mexico, who are covered by the Mexican Social Security Institute and were recruited at the Medical Center Siglo XXI, used in genome-wide association studies of type 2 diabetes and lipid traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000739> (<http://www.ebi.ac.uk/coho/COHO_0000739>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25733577") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000739> "A population-based birth cohort of the 5,914 live births in 1982 to families living in the urban area of Pelotas, a city in southern Brazil, followed through repeated interviews and a clinic visit at about age 30 covering mental health, body composition, precursors of chronic disease and human capital.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000740> (<http://www.ebi.ac.uk/coho/COHO_0000740>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38381478") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000740> "A prospective cohort of 57,310 licensed pesticide applicators enrolled in Iowa and North Carolina, United States, in 1993–1997, together with their spouses, who reported detailed pesticide use and agricultural practices and are followed through follow-up questionnaires and cancer registry linkages to study the health effects of agricultural exposures, including cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000741> (<http://www.ebi.ac.uk/coho/COHO_0000741>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32381493") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36914875") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000741> "A case-control study of current adult asthma nested within the Agricultural Health Study, which enrolled 3,301 farmers and their spouses from Iowa and North Carolina, United States, in 2009–2013, collecting pulmonary function, atopy and blood or saliva samples during home visits, to study farm exposures, asthma and lung function.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000742> (<http://www.ebi.ac.uk/coho/COHO_0000742>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35410379") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39103650") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000742> "A research cohort of customers of the AncestryDNA consumer genetic testing service who consented to AncestryDNA's Human Diversity Project and contribute genotype data and survey responses to genetic studies, including a COVID-19 survey of US-based adult customers used in genome-wide association studies of COVID-19 and influenza outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000743> (<http://www.ebi.ac.uk/coho/COHO_0000743>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000743> "An ongoing study that aims to include all individuals with newly diagnosed diabetes in the Scania region of southern Sweden, used to classify diabetes into subgroups and to study their genetics and complications.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000744> (<http://www.ebi.ac.uk/coho/COHO_0000744>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29550775") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000744> "A longitudinal study of twins and their non-twin siblings from Queensland, Australia, begun in 1992 with twins recruited through primary and secondary schools in the greater Brisbane area and assessed repeatedly in adolescence and young adulthood (including the 19Up study), with genotyping, brain imaging and psychological assessments, to study genetic and environmental pathways to traits such as mental health and substance use.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000745> (<http://www.ebi.ac.uk/coho/COHO_0000745>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000745> "A transatlantic consortium that meta-analysed 14 genome-wide association studies of coronary artery disease in individuals of European descent (22,233 cases and 64,762 controls), with replication genotyping in further samples, to identify susceptibility loci for coronary artery disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000746> (<http://www.ebi.ac.uk/coho/COHO_0000746>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37796845") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://sites.uab.edu/cnics/cnics-sites/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000746> "A longitudinal observational cohort of people with HIV who entered care from 1995 onwards at the HIV clinics of US Centers for AIDS Research (ten sites since 2021), whose data repository integrates clinical, laboratory and patient-reported outcome data from electronic health records for research on HIV care and outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000747> (<http://www.ebi.ac.uk/coho/COHO_0000747>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24356592") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9727532/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000747> "A cohort of 1,441 people aged 13–39 years with type 1 diabetes from 29 centres in the United States and Canada, enrolled in the Diabetes Control and Complications Trial (1983–1993), a randomised trial comparing intensive with conventional therapy to test whether glycaemic control prevents or delays the complications of type 1 diabetes, and followed since 1994 in the observational Epidemiology of Diabetes Interventions and Complications (EDIC) study of the durability of the treatment effects on advanced microvascular complications and cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000748> (<http://www.ebi.ac.uk/coho/COHO_0000748>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.dnbc.dk/about-the-dnbc") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000748> "A nationwide Danish cohort of about 100,000 pregnant women recruited early in pregnancy between 1996 and 2002, run by Statens Serum Institut, with telephone interviews during pregnancy and after birth, biological samples from mother and umbilical cord, and long-term follow-up of the children through questionnaires and national registry linkage, established to study the causal links between early-life exposures and later disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000749> (<http://www.ebi.ac.uk/coho/COHO_0000749>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18538025") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000749> "A population-based case-control study of lung cancer in the Lombardy region of Italy, which enrolled 2,101 incident primary lung cancer cases from 13 hospitals and 2,120 matched population controls in 2002–2005, collecting epidemiological, clinical and molecular data and biospecimens to study lung cancer aetiology from smoking addiction to outcome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000750> (<http://www.ebi.ac.uk/coho/COHO_0000750>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30887376") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000750> "A consortium of population-based pregnancy and birth cohort studies, set up alongside the Early Growth Genetics consortium, that pools genome-wide data to study the genetic basis of phenotypes from fetal life into adolescence such as asthma, eczema, childhood psychopathology, cognition and neurodevelopment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000751> (<http://www.ebi.ac.uk/coho/COHO_0000751>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30044860") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000751> "The participants of BioVU, the Vanderbilt University Medical Center biorepository, studied by the Epidemiologic Architecture for Genes Linked to Environment (EAGLE) site of the NHGRI Population Architecture using Genomics and Epidemiology (PAGE) program in trans-ethnic genetic studies of complex traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000752> (<http://www.ebi.ac.uk/coho/COHO_0000752>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001120.v1.p1") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000752> "An international prostate cancer genetics consortium, linked to the PRACTICAL consortium, that meta-analyses existing genome-wide association data and generates new GWAS, exome-array, iCOGS and OncoArray genotype data from prostate cancer case-control studies to discover prostate cancer risk loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000753> (<http://www.ebi.ac.uk/coho/COHO_0000753>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1038%2Fs41588-018-0058-3/MediaObjects/41588_2018_58_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000753> "A hospital-based case-control study of ischaemic stroke in Finland, in which patients with neuroimaging-confirmed new-onset brain infarction were recruited at Helsinki University Central Hospital, with TOAST subtyping, detailed phenotype data and blood samples, and controls were FINRISK 1992, 1997 and 2002 participants from the Greater Helsinki region frequency-matched by age and sex, to investigate genetic factors underlying ischaemic stroke.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000754> (<http://www.ebi.ac.uk/coho/COHO_0000754>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33456056") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000754> "A multicentre study coordinated by the University of Siena of SARS-CoV-2-positive individuals in Italy, hospitalised and non-hospitalised, whose biospecimens, detailed clinical data and exome and genotype data are collected in the GEN-COVID Biobank, Patient Registry and Genetic Data Repository to find genetic factors for COVID-19 susceptibility and severity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000755> (<http://www.ebi.ac.uk/coho/COHO_0000755>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31875139") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38561434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000755> "A population-based case-control study of colorectal cancer in Hawaii, United States, in which Japanese, Caucasian and Native Hawaiian residents of Oahu newly diagnosed with colorectal adenocarcinoma between January 1994 and August 1998 were identified through the Hawaii SEER registry and matched by sex, ethnicity and age to controls from a population-based health survey of the Hawaii State Department of Health and from Health Care Financing Administration participants, with in-person interviews and blood samples; its genotyped participants take part in consortium studies of genetic and lifestyle risk factors for colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000756> (<http://www.ebi.ac.uk/coho/COHO_0000756>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12458722/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000756> "A population-based cohort of 4,814 adults aged 45–75 randomly selected from the resident registries of Bochum, Essen and Mülheim an der Ruhr in the Ruhr area of Germany, examined in 2000–2003 and followed up repeatedly, set up to evaluate coronary artery calcification measured by electron-beam CT for predicting myocardial infarction and cardiac death beyond traditional risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000757> (<http://www.ebi.ac.uk/coho/COHO_0000757>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35024781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39854657") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9307937/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000757> "A case-control study of lung cancer in African American and non-Hispanic White adults from the Detroit metropolitan area, in which patients were enrolled within 12 months of diagnosis at the Karmanos Cancer Institute or Henry Ford Health System between 2012 and 2018, together with controls without lung cancer, to study inflammation, ancestry and other risk factors for lung cancer and racial disparities in the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000758> (<http://www.ebi.ac.uk/coho/COHO_0000758>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11109115/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8660752/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000758> "A randomly selected subgroup of about 6,100 participants of the Malmö Diet and Cancer Study in Malmö, Sweden, enrolled between 1991 and 1994 into a sub-study of carotid artery disease and cardiovascular risk, with fasting blood samples used in studies of cardiovascular and metabolic disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000759> (<http://www.ebi.ac.uk/coho/COHO_0000759>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41661118") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000759> "A cohort of self-identified Hispanic people with Crohn's disease, ulcerative colitis or unclassified inflammatory bowel disease and non-IBD controls, recruited through the MiaLAtinX Consortium at Cedars-Sinai Medical Center in Los Angeles, the University of Puerto Rico, the University of Miami and Mount Sinai Health System in New York and whole-genome sequenced at the Broad Institute, to study the ancestral origins of IBD risk in Hispanic populations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000760> (<http://www.ebi.ac.uk/coho/COHO_0000760>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40858910") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000760> "A general-population birth cohort of 9,432 live-born children with expected dates of birth between July 1985 and June 1986 in the provinces of Oulu and Lapland in northern Finland, followed from pregnancy through childhood, adolescence and adulthood with questionnaires, clinical examinations and national register linkage.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000761> (<http://www.ebi.ac.uk/coho/COHO_0000761>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32994253") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000761> "A prospective population-based cohort of adults aged 35–64 years recruited in 2007 by age-stratified random sampling in the semi-urban Ragama Medical Officer of Health area of Gampaha district, Sri Lanka, with baseline socio-demographic, lifestyle, anthropometric, biochemical and clinical data and follow-up of mortality and its predictors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000762> (<http://www.ebi.ac.uk/coho/COHO_0000762>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31401553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000762> "A population-based cohort of Chinese adults in Singapore examined at baseline in 2009–2011 (SCES-1) and invited for a 6-year follow-up in 2015–2017 (SCES-2) with standardised ocular and systemic examinations and questionnaires, to study the prevalence, incidence, progression and risk factors of age-related eye diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000763> (<http://www.ebi.ac.uk/coho/COHO_0000763>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38025163") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000763> "A multiethnic population-based cohort of Malay, Indian and Chinese adults in Singapore, recruited at baseline through the Singapore Malay Eye Study (2004–2006), the Singapore Indian Eye Study (2007–2009) and the Singapore Chinese Eye Study (2009–2011) and re-examined about six years later (SEED-2), to study the incidence and risk factors of eye diseases and visual impairment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000764> (<http://www.ebi.ac.uk/coho/COHO_0000764>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28472538") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000764> "A population-based cohort of adults of Indian ethnicity in Singapore, examined at baseline in 2007–2009 and again in 2013–2015 (SINDI-2), to study diabetic retinopathy and other major age-related eye diseases and the impact of migration, comparing first-generation immigrants with Singapore-born second-generation participants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000765> (<http://www.ebi.ac.uk/coho/COHO_0000765>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26982883") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000765> "A collaborative consortium in Taiwan, with Taichung Veterans General Hospital, Tri-Service General Hospital, National Taiwan University Hospital and the National Health Research Institutes ascertaining subjects, that genotyped Taiwanese Chinese participants of several studies with the Illumina CardioMetaboChip to identify genetic determinants of atherosclerosis- and metabolic-related traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000766> (<http://www.ebi.ac.uk/coho/COHO_0000766>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35512400") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38561434") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000766> "A population-based case-control study of colon cancer in women in Los Angeles County, United States, comprising 831 English-speaking women aged 55–74 years diagnosed with primary colon cancer from 1998 to 2002, identified through the Los Angeles County Cancer Surveillance Program (a SEER registry), and 755 race/ethnicity- and age-matched neighbourhood control women, with in-person interviews on hormone use, reproductive history and lifestyle and blood samples, set up to study menopausal hormone therapy and colon cancer risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000767> (<http://www.ebi.ac.uk/coho/COHO_0000767>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36780127") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000767> "A clinical cohort of children and adolescents aged 7–18 with reading difficulties, comprising siblings from nuclear families recruited by research clinics in Oxford and Reading and singletons recruited in Oxford, Reading and Aston, United Kingdom, to study the genetics of dyslexia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000768> (<http://www.ebi.ac.uk/coho/COHO_0000768>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21602798") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29117387") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33398198") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000768> "A consortium of epidemiological studies of prostate cancer in men of African ancestry, mainly African American men, assembled to conduct genome-wide association studies of prostate cancer susceptibility in men of African descent.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000769> (<http://www.ebi.ac.uk/coho/COHO_0000769>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20454776") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000769> "A population-based study of a random sample of about 5,200 people aged 18–75 years from the Botnia region of western Finland, identified through the national population registry, to study the prevalence, prediction and prevention of type 2 diabetes and related metabolic traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000770> (<http://www.ebi.ac.uk/coho/COHO_0000770>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38969383") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000770> "A national longitudinal prospective cohort of children born with cleft lip and/or palate and their families, recruited across the UK from November 2013 through NHS cleft centres, with biological samples, questionnaires, surgical data and record linkage to study the causes, treatments and long-term outcomes of orofacial clefts.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000771> (<http://www.ebi.ac.uk/coho/COHO_0000771>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://childrensoncologygroup.org/about") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000771> "A clinical trials network of more than 220 hospitals and more than 13,500 researchers, clinicians and specialists that designs and runs clinical trials and research studies to cure and prevent childhood and adolescent cancer; genetic studies use participants of its trials.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000772> (<http://www.ebi.ac.uk/coho/COHO_0000772>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37581339") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000772> "A multi-site, multi-generational family study in which probands recruited through alcohol treatment centres and their relatives, together with community comparison families, have been assessed over more than 30 years (nearly 18,000 individuals from over 2200 families) with psychiatric interviews, questionnaires, electrophysiology and DNA to identify genetic factors in alcohol use disorder and related outcomes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000773> (<http://www.ebi.ac.uk/coho/COHO_0000773>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25105248") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000773> "A colorectal cancer genetic epidemiology consortium, approved at the University of Southern California and funded within the NCI GAME-ON post-GWAS initiative, that pools genome-wide genotype data from colorectal cancer case-control studies such as the Molecular Epidemiology of Colorectal Cancer Study, the Colon Cancer Family Registry and the Kentucky and Newfoundland case-control studies to find and characterise colorectal cancer susceptibility variants.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000774> (<http://www.ebi.ac.uk/coho/COHO_0000774>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27598322") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000774> "A network of cancer genetic epidemiology consortia, the NIH-funded post-cancer-GWAS initiative, that brings together genome-wide association data from colorectal (CORECT), breast (DRIVE), prostate (ELLIPSE), ovarian (FOCI) and lung (TRICL) cancer consortia, mainly of people of European descent.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000775> (<http://www.ebi.ac.uk/coho/COHO_0000775>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35039627") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000775> "A cohort of patients with head and neck squamous cell carcinoma treated with radiotherapy within the protocols of the Danish Head and Neck Cancer Group (DAHANCA) in Denmark in 2000–2011, pooled from the DAHANCA 10 and DAHANCA 19 trials and the DAHANCA prospective biobank protocol, with standardised scoring of acute and late radiotherapy toxicity, used in radiogenomic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000776> (<http://www.ebi.ac.uk/coho/COHO_0000776>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28008009") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000776> "A collaboration between the Regeneron Genetics Center and Geisinger Health System in which adult participants of Geisinger's MyCode Community Health Initiative are exome-sequenced and genotyped and linked to longitudinal electronic health records, for genomics-guided precision medicine and therapeutic discovery.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000777> (<http://www.ebi.ac.uk/coho/COHO_0000777>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36629499") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000777> "A Swedish population-based case-control study of multiple sclerosis in which incident cases were recruited from hospital-based and privately run neurology units and matched controls were randomly selected from the national population register, with questionnaires on environmental and lifestyle exposures and blood samples for genetic analyses.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000778> (<http://www.ebi.ac.uk/coho/COHO_0000778>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26046553") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000778> "A government-funded national quality registry of patients with multiple sclerosis, used in all Swedish neurology departments, that supports clinical decisions and serves as a research resource, hosting nested projects including an incidence cohort, a prevalence cohort and post-marketing cohorts of patients on novel disease-modifying drugs.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000779> (<http://www.ebi.ac.uk/coho/COHO_0000779>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18985156") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19789630") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000779> "A multicentre sample of healthy non-diabetic offspring of patients with type 2 diabetes, recruited in Denmark, Finland, Germany, Italy and Sweden by the European Network on Functional Genomics of Type 2 Diabetes and examined with glucose tolerance tests and hyperinsulinaemic euglycaemic clamps to study the genetics of insulin secretion and insulin sensitivity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000780> (<http://www.ebi.ac.uk/coho/COHO_0000780>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17998437") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000780> "A multi-site case-control study run with GlaxoSmithKline that recruited people with Alzheimer's disease from memory referral clinics in Canada, with cognitively unimpaired controls from their non-biological relatives, friends or spouses, to find genetic variants associated with Alzheimer's disease risk and age at onset.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000781> (<http://www.ebi.ac.uk/coho/COHO_0000781>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15942624") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38277453") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000781> "A hospital-based epidemiologic research programme run since 1988 at Aichi Cancer Center in Nagoya, Japan, whose participants are first-visit outpatients of Aichi Cancer Center Hospital (including the HERPACC-2, 2001–2005, and HERPACC-3, 2005–2013, phases), used for case-control studies of cancer such as oesophageal cancer and for genome-wide studies within the Japanese Consortium of Genetic Epidemiology Studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000782> (<http://www.ebi.ac.uk/coho/COHO_0000782>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34897183") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000782> "A consortium of Japanese population-based and hospital-based studies — the Tohoku Medical Megabank Community-Based Cohort Study, the Japan Public Health Center-based Prospective Study, the Japan Multi-Institutional Collaborative Cohort Study and the Hospital-based Epidemiologic Research Program at Aichi Cancer Center — that pools genome-wide genotype data on healthy participants for genetic epidemiology, including genome-wide association studies of body mass index, height and weight.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000783> (<http://www.ebi.ac.uk/coho/COHO_0000783>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:11763136") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25104790") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000783> "A population-based prospective cohort of about 140,000 registered residents aged 40–69 years in 11 public health centre areas across Japan, enrolled as Cohort I in 1990 and Cohort II in 1993 with questionnaires, blood samples and health check-up data and followed with repeat surveys, to study causes of cancer, cardiovascular disease and other diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000784> (<http://www.ebi.ac.uk/coho/COHO_0000784>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29531354") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000784> "A multi-ancestry consortium that combined genome-wide association data from 29 studies (67,162 stroke cases and 454,450 controls, mainly of European and East Asian ancestry) in a meta-analysis of stroke and its aetiological subtypes, drawing on contributing groups such as METASTROKE, SiGN, CHARGE and COMPASS.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000785> (<http://www.ebi.ac.uk/coho/COHO_0000785>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28851447") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000785> "A nationwide French cohort of 2323 non-demented adults with isolated subjective cognitive complaints or mild cognitive impairment, recruited in memory clinics from 2011 to 2014 and followed with standardised clinical, neuropsychological, neuroimaging and biomarker assessments to study the natural history of Alzheimer's disease and related disorders.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000786> (<http://www.ebi.ac.uk/coho/COHO_0000786>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25041610") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000786> "A prospective registry at the University of Miami that offers enrolment to consecutive patients admitted with stroke or transient ischaemic attack, a predominantly Hispanic and Black multiethnic population, contributing cases to the NINDS Stroke Genetics Network.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000787> (<http://www.ebi.ac.uk/coho/COHO_0000787>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12902255/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000787> "A population-based cohort of 33,346 residents of the city of Malmö in southern Sweden, recruited by pre-specified birth-year groups for health examinations from 1974 to 1992, whose samples and data are used in genetic and biomarker studies of disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000788> (<http://www.ebi.ac.uk/coho/COHO_0000788>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24022301") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000788> "A European cross-linguistic sample of school-age children, including more than 900 with dyslexia sampled with homogeneous inclusion criteria across eight European countries and a comparable number of controls, assembled by the EU-funded NeuroDys consortium to study the genetics of dyslexia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000789> (<http://www.ebi.ac.uk/coho/COHO_0000789>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34208976") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000789> "A population-based cohort of 3,289 adults aged 50–70 years from urban and rural Beijing and Shanghai, China, recruited in 2005 and resurveyed after six years, designed to investigate environmental and genetic factors and their interactions in cardiometabolic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000790> (<http://www.ebi.ac.uk/coho/COHO_0000790>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.cgm.northwestern.edu/cores/nugene/index.html") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000790> "A genomic biobank sponsored by the Center for Genetic Medicine at Northwestern University in partnership with Northwestern Medicine, collecting DNA samples and self-reported and electronic medical record health information from patients of Northwestern Medicine-affiliated hospitals and clinics to study the role of genes in common diseases and their treatment.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000791> (<http://www.ebi.ac.uk/coho/COHO_0000791>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33810047") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37862240") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40050897") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000791> "A Spanish cohort of cancer patients treated with radiotherapy at the Clinical University Hospital of Santiago de Compostela, Galicia, with prostate (RADIOGEN-Prostate, from 2005), lung (RADIOGEN-Lung, 2008–2015) and head and neck cancer sub-cohorts, collecting blood samples, dosimetry, clinical and toxicity data to identify genetic and epigenetic predictors of radiotherapy toxicity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000792> (<http://www.ebi.ac.uk/coho/COHO_0000792>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22471860") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29865057") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000792> "A longitudinal clinical-pathologic cohort study of ageing and Alzheimer's disease run by the Rush Alzheimer's Disease Center, which since 1994 has enrolled older Catholic nuns, priests and brothers from across the United States who are free of dementia at enrolment and agree to annual clinical evaluations and brain donation at death.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000793> (<http://www.ebi.ac.uk/coho/COHO_0000793>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35012447") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37715138") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000793> "A genome-wide association study dataset that aggregates common measures from three large substance-abuse studies, the Collaborative Study on the Genetics of Alcoholism, the Family Study of Cocaine Dependence and the Collaborative Genetic Study of Nicotine Dependence, funded as part of the NIH Gene Environment Association Studies (GENEVA) initiative.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000794> (<http://www.ebi.ac.uk/coho/COHO_0000794>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34834492") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000794> "A clinic-based case–control study of childhood-onset asthma in African American children and youth recruited in the San Francisco Bay Area, United States, run by the University of California, San Francisco, to untangle the genetic and environmental basis of asthma in minority populations.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000795> (<http://www.ebi.ac.uk/coho/COHO_0000795>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24323821") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000795> "A population-based case-control study of breast cancer among women aged 25–70 who were permanent residents of urban Shanghai, China, recruited in two phases (August 1996–March 1998 and April 2002–February 2005).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000796> (<http://www.ebi.ac.uk/coho/COHO_0000796>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17365815") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000796> "A population-based study of Malay adults aged 40–79 years living in south-western Singapore, selected by age-stratified random sampling and examined with standardised interviews, ocular and systemic assessments and stored blood and urine samples, to measure the prevalence and risk factors of age-related eye diseases in people of Malay ethnicity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000797> (<http://www.ebi.ac.uk/coho/COHO_0000797>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35536285") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000797> "A hospital-based case-control study of bladder cancer (the EPICURO study) that enrolled patients newly diagnosed with urothelial carcinoma of the bladder in 1998–2001 at 18 hospitals in five regions of Spain and individually matched hospital controls, to study environmental, occupational and genetic risk factors for bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000798> (<http://www.ebi.ac.uk/coho/COHO_0000798>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38064665") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38372780") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40325049") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000798> "A hospital-based cohort of more than 100,000 Chinese pregnant women who had non-invasive prenatal testing at Longgang District Maternity and Child Healthcare Hospital and Shenzhen Baoan Women's and Children's Hospital in Shenzhen, China, whose low-depth NIPT sequencing data are linked to laboratory and electronic medical records to study the genetics of pregnancy traits and complications.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000799> (<http://www.ebi.ac.uk/coho/COHO_0000799>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39633006") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000799> "A series of clinically and neuropathologically characterised brain donors with Alzheimer disease and cognitively normal elderly controls, assembled by the Translational Genomics Research Institute (Phoenix, United States) from NIA-supported Alzheimer's Disease Center brain banks, the Miami Brain Bank and brain banks in the United Kingdom and the Netherlands, and genotyped for genome-wide association studies of late-onset Alzheimer disease within the Alzheimer's Disease Genetics Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000800> (<http://www.ebi.ac.uk/coho/COHO_0000800>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42152146") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000800> "A lung cancer genetic epidemiology consortium, one of the NIH-funded GAME-ON post-GWAS consortia and working with the International Lung Cancer Consortium, that integrates genome-wide data from multiple lung cancer studies of European populations to identify lung cancer susceptibility loci.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000801> (<http://www.ebi.ac.uk/coho/COHO_0000801>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24550246") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000801> "A nationally representative UK observational cohort of 18,827 children from 18,552 families, born at the turn of the century, followed through repeated sweeps of data collection from age 9 months onwards on health, development, cognitive ability, education and social and economic circumstances, with linkage to administrative health records.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000802> (<http://www.ebi.ac.uk/coho/COHO_0000802>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36191651") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0167814022044863-mmc1.docx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000802> "A prospective cohort of 1,429 patients with head and neck cancer treated with primary or postoperative radiotherapy, with or without chemotherapy, from 2007 to 2020 at the Department of Radiation Oncology of the University Medical Center Groningen, all enrolled in the UMCG head and neck cancer prospective data registration programme (NCT02435576), with prospective assessment of radiation-induced toxicity and patient-rated outcome measures.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000803> (<http://www.ebi.ac.uk/coho/COHO_0000803>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22832961") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000803> "A cohort of Alzheimer disease patients, about a quarter of them autopsy-confirmed, and cognitively normal controls from the same area, recruited by the University of Pittsburgh Alzheimer's Disease Research Center in Pittsburgh, United States, and genotyped for genome-wide association studies of late-onset Alzheimer disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000804> (<http://www.ebi.ac.uk/coho/COHO_0000804>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26967211") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000804> "A case-control longitudinal study of vascular health and brain aging launched in 2012 at Vanderbilt University Medical Center in Nashville, Tennessee, USA, which enrolled 335 adults aged 60–92 with mild cognitive impairment or normal cognition from 2012 to 2014 for repeated clinical, cardiac, brain imaging and CSF assessments.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000805> (<http://www.ebi.ac.uk/coho/COHO_0000805>)

