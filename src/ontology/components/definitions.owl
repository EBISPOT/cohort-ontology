AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23202125") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25180781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28209224") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17478681") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2711874/") Annotation(rdfs:comment "Controls were healthy Caucasian men (>65 years) and women (>70 years) from Ottawa who had no symptoms or history of CHD (table S1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002202> "A case-control study of coronary artery disease at the University of Ottawa Heart Institute, Ottawa, Canada, that recruited people of European ancestry without diabetes, with cases defined by more than 50% stenosis of a major coronary artery at angiography, myocardial infarction or coronary revascularisation, and controls who either had minimal coronary stenosis on angiography or were elderly and asymptomatic, genotyped in several phases for genome-wide association studies of coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23202125") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25180781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28209224") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17478681") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2711874/") Annotation(rdfs:comment "For the initial genome-wide scan, cases and controls were Caucasian men and women from Ottawa, Canada who participated in the Ottawa Heart Study (OHS).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002202> "A case-control study of coronary artery disease at the University of Ottawa Heart Institute, Ottawa, Canada, that recruited people of European ancestry without diabetes, with cases defined by more than 50% stenosis of a major coronary artery at angiography, myocardial infarction or coronary revascularisation, and controls who either had minimal coronary stenosis on angiography or were elderly and asymptomatic, genotyped in several phases for genome-wide association studies of coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23202125") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25180781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28209224") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17478681") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2711874/") Annotation(rdfs:comment "These 2586 SNPs were genotyped in an independent sample of 311 cases and 326 controls from Ottawa (OHS-2) using the same criteria as OHS-1 (table S1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002202> "A case-control study of coronary artery disease at the University of Ottawa Heart Institute, Ottawa, Canada, that recruited people of European ancestry without diabetes, with cases defined by more than 50% stenosis of a major coronary artery at angiography, myocardial infarction or coronary revascularisation, and controls who either had minimal coronary stenosis on angiography or were elderly and asymptomatic, genotyped in several phases for genome-wide association studies of coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23202125") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25180781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28209224") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25180781") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4152257/") Annotation(rdfs:comment "CAD cases were identified by angiography as having a stenosis of greater than 50% in a major coronary artery, whereas angiographic controls had less than 30% stenosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002202> "A case-control study of coronary artery disease at the University of Ottawa Heart Institute, Ottawa, Canada, that recruited people of European ancestry without diabetes, with cases defined by more than 50% stenosis of a major coronary artery at angiography, myocardial infarction or coronary revascularisation, and controls who either had minimal coronary stenosis on angiography or were elderly and asymptomatic, genotyped in several phases for genome-wide association studies of coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23202125") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25180781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28209224") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25180781") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4152257/") Annotation(rdfs:comment "Controls were individuals who underwent coronary angiography prior to heart valve surgery or symptomatic individuals but with minimal (<30%) stenosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002202> "A case-control study of coronary artery disease at the University of Ottawa Heart Institute, Ottawa, Canada, that recruited people of European ancestry without diabetes, with cases defined by more than 50% stenosis of a major coronary artery at angiography, myocardial infarction or coronary revascularisation, and controls who either had minimal coronary stenosis on angiography or were elderly and asymptomatic, genotyped in several phases for genome-wide association studies of coronary artery disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21378990") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23202125") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25180781") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28209224") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25180781") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4152257/") Annotation(rdfs:comment "The OHGS excluded individuals with diabetes mellitus to ensure that the genetic risk primarily associated with coronary artery disease would not be confounded by the risk associated with diabetes, as described previously [16].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002202> "A case-control study of coronary artery disease at the University of Ottawa Heart Institute, Ottawa, Canada, that recruited people of European ancestry without diabetes, with cases defined by more than 50% stenosis of a major coronary artery at angiography, myocardial infarction or coronary revascularisation, and controls who either had minimal coronary stenosis on angiography or were elderly and asymptomatic, genotyped in several phases for genome-wide association studies of coronary artery disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002205> (<http://www.ebi.ac.uk/coho/COHO_0002205>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10326953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12049574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39346574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10326953") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10326953+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Multicenter randomized clinical trial with 2 groups: topical ocular hypotensive medication and close observation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002205> "A multicentre randomised clinical trial at 22 clinical centres in the United States that from 1994 to 1996 enrolled people aged 40 to 80 with ocular hypertension and no evidence of glaucomatous damage, randomised them to topical ocular hypotensive medication or close observation, and followed them for the onset of primary open-angle glaucoma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10326953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12049574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39346574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10326953") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10326953+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Ocular Hypertension Treatment Study (OHTS) seeks to evaluate the safety and efficacy of topical ocular hypotensive medication in preventing or delaying the onset of visual field loss and/or optic nerve damage in subjects with ocular hypertension at moderate risk for developing primary open angle glaucoma.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002205> "A multicentre randomised clinical trial at 22 clinical centres in the United States that from 1994 to 1996 enrolled people aged 40 to 80 with ocular hypertension and no evidence of glaucomatous damage, randomised them to topical ocular hypotensive medication or close observation, and followed them for the onset of primary open-angle glaucoma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10326953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12049574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39346574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10326953") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10326953+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We describe the baseline characteristics of 1637 subjects randomized between February 28, 1994, and October 31, 1996.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002205> "A multicentre randomised clinical trial at 22 clinical centres in the United States that from 1994 to 1996 enrolled people aged 40 to 80 with ocular hypertension and no evidence of glaucomatous damage, randomised them to topical ocular hypotensive medication or close observation, and followed them for the onset of primary open-angle glaucoma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10326953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12049574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39346574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12049574") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12049574+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A total of 1636 participants with no evidence of glaucomatous damage, aged 40 to 80 years, and with an IOP between 24 mm Hg and 32 mm Hg in one eye and between 21 mm Hg and 32 mm Hg in the other eye were randomized to either observation or treatment with commercially available topical ocular hypotensive medication.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002205> "A multicentre randomised clinical trial at 22 clinical centres in the United States that from 1994 to 1996 enrolled people aged 40 to 80 with ocular hypertension and no evidence of glaucomatous damage, randomised them to topical ocular hypotensive medication or close observation, and followed them for the onset of primary open-angle glaucoma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10326953") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12049574") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39346574") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39346574") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11437927/fullTextXML") Annotation(rdfs:comment "The OHTS was a prospective, multicenter investigation conducted at 22 centers across the United States, aimed at preventing or delaying the onset of VF loss in individuals with ocular hypertension (OHT).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002205> "A multicentre randomised clinical trial at 22 clinical centres in the United States that from 1994 to 1996 enrolled people aged 40 to 80 with ocular hypertension and no evidence of glaucomatous damage, randomised them to topical ocular hypotensive medication or close observation, and followed them for the onset of primary open-angle glaucoma.")

