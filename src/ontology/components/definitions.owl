AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3448/MediaObjects/41588_2016_BFng3448_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26691988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4745342/unicode") Annotation(rdfs:comment "Advanced AMD is classified as wet (choroidal neovascularization, CNV, when accompanied by angiogenesis) or dry AMD (geographic atrophy, GA, when angiogenesis is absent).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002329> "A clinic-based series of patients with advanced age-related macular degeneration (choroidal neovascularisation, geographic atrophy, or one in each eye), recruited through ophthalmology clinics in Rotterdam, ascertained by fundus examination and optical coherence tomography and graded with a Wisconsin/modified International system, which contributed advanced-AMD cases, without intermediate-AMD cases or controls, to the genome-wide association study of the International AMD Genomics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3448/MediaObjects/41588_2016_BFng3448_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26691988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4745342/unicode") Annotation(rdfs:comment "Here, we set out to systematically examine common and rare variation of AMD in the International AMD Genomics Consortium (IAMDGC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002329> "A clinic-based series of patients with advanced age-related macular degeneration (choroidal neovascularisation, geographic atrophy, or one in each eye), recruited through ophthalmology clinics in Rotterdam, ascertained by fundus examination and optical coherence tomography and graded with a Wisconsin/modified International system, which contributed advanced-AMD cases, without intermediate-AMD cases or controls, to the genome-wide association study of the International AMD Genomics Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002330> (<http://www.ebi.ac.uk/coho/COHO_0002330>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16985014") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21386992") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22969801") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22969801") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3433139/fullTextXML") Annotation(rdfs:comment "All participants provide broad, tiered, face-to-face informed consent to donate at least one blood sample and to complete a self-administered in-depth epidemiologic questionnaire") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002330> "A biobank at Roswell Park Cancer Institute in Buffalo, New York, that collects blood samples before treatment, clinical data and an epidemiological questionnaire from patients newly diagnosed with cancer at the institute and, as controls, from people with no personal history of cancer (family members and friends of patients and community members), and supplies them to cancer research studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16985014") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21386992") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22969801") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22969801") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3433139/fullTextXML") Annotation(rdfs:comment "Newly diagnosed cancer patients are asked to contribute specimens and data to the DBBR prior to treatment, and non-patients (family members and friends of patients and community members) with no personal history of cancer are also asked to participate in the DBBR as controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002330> "A biobank at Roswell Park Cancer Institute in Buffalo, New York, that collects blood samples before treatment, clinical data and an epidemiological questionnaire from patients newly diagnosed with cancer at the institute and, as controls, from people with no personal history of cancer (family members and friends of patients and community members), and supplies them to cancer research studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16985014") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21386992") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22969801") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22969801") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3433139/fullTextXML") Annotation(rdfs:comment "Participants in this study were women who consented to participate in the Data Bank and BioRepository (DBBR) program, a shared Core Research Resource at Roswell Park Cancer Institute in Buffalo, NY, USA [22] and self-reported being cancer-free at the time of informed consent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002330> "A biobank at Roswell Park Cancer Institute in Buffalo, New York, that collects blood samples before treatment, clinical data and an epidemiological questionnaire from patients newly diagnosed with cancer at the institute and, as controls, from people with no personal history of cancer (family members and friends of patients and community members), and supplies them to cancer research studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16985014") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21386992") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22969801") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22969801") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3433139/fullTextXML") Annotation(rdfs:comment "The DBBR is a state-of-the-art blood collection, processing, and banking laboratory which procures bio specimens from Roswell Park patients and nonpatients as healthy controls and collects extensive sample and clinical annotation data, as well as epidemiological survey information.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002330> "A biobank at Roswell Park Cancer Institute in Buffalo, New York, that collects blood samples before treatment, clinical data and an epidemiological questionnaire from patients newly diagnosed with cancer at the institute and, as controls, from people with no personal history of cancer (family members and friends of patients and community members), and supplies them to cancer research studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16985014") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21386992") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22969801") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25855707") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4754625/fullTextXML") Annotation(rdfs:comment "The Roswell Park Cancer Institute (RPCI) study was supported by RPCI DataBank and BioRepository (DBBR), a Cancer Center Support Grant Shared Resource (P30 CA016056-32).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002330> "A biobank at Roswell Park Cancer Institute in Buffalo, New York, that collects blood samples before treatment, clinical data and an epidemiological questionnaire from patients newly diagnosed with cancer at the institute and, as controls, from people with no personal history of cancer (family members and friends of patients and community members), and supplies them to cancer research studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002331> (<http://www.ebi.ac.uk/coho/COHO_0002331>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28134330") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31906855") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28134330") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5278549/fullTextXML") Annotation(rdfs:comment "All data used in this study were obtained from the RuLAS, a population-based observational two-arm cohort study performed in Rugao, a typical medium-sized city of Jiangsu province, China.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002331> "A population-based observational cohort study in Rugao, a city in Jiangsu province, China, with two arms: a longevity arm that in 2007–2008 recruited long-lived residents aged 95 years and over together with population controls drawn at random from the resident registry, and an ageing arm that in 2014 randomly recruited residents aged 70–84 years from rural communities of Jiang'an Township by age and sex strata and is followed up longitudinally, both examined with structured questionnaires, physical examinations and blood samples to study longevity and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28134330") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31906855") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28134330") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5278549/fullTextXML") Annotation(rdfs:comment "Briefly, the longevity arm recruited 463 long-lived participants (103 men and 360 women, aged 95 +years of age, range 95–107 years) between December 2007 and February 2008, representing 65.7% of the Rugao LLIs.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002331> "A population-based observational cohort study in Rugao, a city in Jiangsu province, China, with two arms: a longevity arm that in 2007–2008 recruited long-lived residents aged 95 years and over together with population controls drawn at random from the resident registry, and an ageing arm that in 2014 randomly recruited residents aged 70–84 years from rural communities of Jiang'an Township by age and sex strata and is followed up longitudinally, both examined with structured questionnaires, physical examinations and blood samples to study longevity and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28134330") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31906855") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28134330") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5278549/fullTextXML") Annotation(rdfs:comment "Furthermore, population-based control groups were randomly recruited from the resident registry at the local government offices of Rugao in this arm.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002331> "A population-based observational cohort study in Rugao, a city in Jiangsu province, China, with two arms: a longevity arm that in 2007–2008 recruited long-lived residents aged 95 years and over together with population controls drawn at random from the resident registry, and an ageing arm that in 2014 randomly recruited residents aged 70–84 years from rural communities of Jiang'an Township by age and sex strata and is followed up longitudinally, both examined with structured questionnaires, physical examinations and blood samples to study longevity and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28134330") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31906855") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28134330") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5278549/fullTextXML") Annotation(rdfs:comment "The ageing arm of the RuLAS randomly recruited approximately 1960 elderly participants aged 70‒84 years from 31 rural communities of Jiang’an Township, Rugao city, between November 2014 and December 2014 according to 5-year age and sex strata.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002331> "A population-based observational cohort study in Rugao, a city in Jiangsu province, China, with two arms: a longevity arm that in 2007–2008 recruited long-lived residents aged 95 years and over together with population controls drawn at random from the resident registry, and an ageing arm that in 2014 randomly recruited residents aged 70–84 years from rural communities of Jiang'an Township by age and sex strata and is followed up longitudinally, both examined with structured questionnaires, physical examinations and blood samples to study longevity and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28134330") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31906855") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28134330") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5278549/fullTextXML") Annotation(rdfs:comment "a detailed structured questionnaire and physical examinations (there was a slight difference in the two arms) were administered by trained physicians") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002331> "A population-based observational cohort study in Rugao, a city in Jiangsu province, China, with two arms: a longevity arm that in 2007–2008 recruited long-lived residents aged 95 years and over together with population controls drawn at random from the resident registry, and an ageing arm that in 2014 randomly recruited residents aged 70–84 years from rural communities of Jiang'an Township by age and sex strata and is followed up longitudinally, both examined with structured questionnaires, physical examinations and blood samples to study longevity and ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28134330") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31906855") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31906855") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6945401/fullTextXML") Annotation(rdfs:comment "The ageing arm of RuLAS is a longitudinal cohort followed-up every 1.5 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002331> "A population-based observational cohort study in Rugao, a city in Jiangsu province, China, with two arms: a longevity arm that in 2007–2008 recruited long-lived residents aged 95 years and over together with population controls drawn at random from the resident registry, and an ageing arm that in 2014 randomly recruited residents aged 70–84 years from rural communities of Jiang'an Township by age and sex strata and is followed up longitudinally, both examined with structured questionnaires, physical examinations and blood samples to study longevity and ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002334> (<http://www.ebi.ac.uk/coho/COHO_0002334>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26590902") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32393777") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26590902") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4715236/") Annotation(rdfs:comment "Distribution by gene and locus type of the 1108 de novo variants that were identified through a targeted deep sequencing of 5p15.331,2 and subsequently genotyped in 10 880 individuals (5164 lung cancer cases, 5716 controls)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002334> "A hospital-based case-control study of several cancer sites in Russia, whose lung cancer cases and controls have been genotyped for studies of inherited lung cancer susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26590902") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32393777") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26590902") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4715236/") Annotation(rdfs:comment "RUSS Hospital-based Russia 497 (51.0) 477 (49.0) 974 (9.0)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002334> "A hospital-based case-control study of several cancer sites in Russia, whose lung cancer cases and controls have been genotyped for studies of inherited lung cancer susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26590902") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32393777") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26590902") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4715236/") Annotation(rdfs:comment "Subsequently, 4652 SNPs, including 1108 novel SNPs, were genotyped in 5164 cases and 5716 controls of European ancestry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002334> "A hospital-based case-control study of several cancer sites in Russia, whose lung cancer cases and controls have been genotyped for studies of inherited lung cancer susceptibility.")

