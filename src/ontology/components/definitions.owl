AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31437200") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39483246") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11713395/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11713395/fullTextXML") Annotation(rdfs:comment "We performed immunohistochemical staining with the 5G4 antibody against alpha‐synuclein on brain tissue samples from the Tampere Sudden Death Study – a collection of forensic autopsies on individuals that lived outside hospital institutions in Tampere and the surrounding regions, Finland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002471> "A collection of medico-legal autopsies performed at the Department of Forensic Medicine of the University of Tampere, Finland, on unselected individuals from Tampere and the surrounding regions who died out of hospital from any cause, used to study coronary atherosclerosis, brain pathology such as Lewy-related pathology, and other post-mortem tissue, with risk-factor data gathered by interviewing relatives of the deceased.")

