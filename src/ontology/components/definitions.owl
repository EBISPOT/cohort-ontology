AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26413278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26413278") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4581382/fullTextXML") Annotation(rdfs:comment "Approval for the study was granted by the Institutional Review Board (IRB) of Duke University, Durham, NC and the local IRB from the referring institutions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000678> "A research collection of patients with kidney disease, including children and young adults with nephrotic syndrome and focal segmental glomerulosclerosis, referred from Duke University and collaborating centres to Duke University's genetics of kidney disease research program in Durham, North Carolina, for genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26413278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26413278") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4581382/fullTextXML") Annotation(rdfs:comment "We selected all individuals with early disease onset (<21 years) and a diagnosis of FSGS and/or SRNS referred to us for inclusion in our genetics of kidney disease research program.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000678> "A research collection of patients with kidney disease, including children and young adults with nephrotic syndrome and focal segmental glomerulosclerosis, referred from Duke University and collaborating centres to Duke University's genetics of kidney disease research program in Durham, North Carolina, for genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26413278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41748071") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC13065301/") Annotation(rdfs:comment "Discovery has 994 multi-ancestry NS cases enrolled in the Duke Genetics of Kidney Disease (Duke GKD; Pro00014951) and Genomics of Nephrotic Syndrome studies (Pro00106061; Figure 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000678> "A research collection of patients with kidney disease, including children and young adults with nephrotic syndrome and focal segmental glomerulosclerosis, referred from Duke University and collaborating centres to Duke University's genetics of kidney disease research program in Durham, North Carolina, for genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26413278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://web.archive.org/web/20240605222134/https://dmpi.duke.edu/sites/default/files/2021-04/GKD_newsletter%202017.pdf") Annotation(rdfs:comment "The genetics of kidney disease research team at DMPI includes a team of dedicated research professionals and scientists looking for the unknown genetic causes of different kidney diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000678> "A research collection of patients with kidney disease, including children and young adults with nephrotic syndrome and focal segmental glomerulosclerosis, referred from Duke University and collaborating centres to Duke University's genetics of kidney disease research program in Durham, North Carolina, for genetic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000679> (<http://www.ebi.ac.uk/coho/COHO_0000679>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35136347") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35136347") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8763662/fullTextXML") Annotation(rdfs:comment "EUGENDA is a multicenter prospective epidemiological study enrolling patients with AMD, as well as healthy control individuals ≥ 55 years of age (Department of Ophthalmology, University of Cologne, Faculty of Medicine and University Hospital Cologne, Cologne, Germany; and Department of Ophthalmology, Donders Institute for Brain, Cognition and Behavior, Radboud University Medical Center, Nijmegen, the Netherlands).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000679> "A multicentre prospective epidemiological study enrolling patients with age-related macular degeneration and healthy control individuals aged 55 years or over at the ophthalmology departments of University Hospital Cologne, Germany, and Radboud University Medical Center, Nijmegen, the Netherlands, used to study genetic and non-genetic risk factors for age-related macular degeneration.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35136347") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35136347") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A35136347+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The purpose of this study was to analyze genetic and nongenetic associations with reticular pseudodrusen (RPD) in patients with and without age-related macular degeneration (AMD).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000679> "A multicentre prospective epidemiological study enrolling patients with age-related macular degeneration and healthy control individuals aged 55 years or over at the ophthalmology departments of University Hospital Cologne, Germany, and Radboud University Medical Center, Nijmegen, the Netherlands, used to study genetic and non-genetic risk factors for age-related macular degeneration.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000680> (<http://www.ebi.ac.uk/coho/COHO_0000680>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19781411") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37908396") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19781411") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19781411+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A cohort of 850 children and their families (mother, father, eldest sibling) are being recruited during pregnancy to a prospective longitudinal study to investigate the relative contribution of (a) prenatal and postnatal determinants and (b) individual and family (maternal/paternal) determinants for the development of adiposity and CVD risk factors") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000680> "A Canadian longitudinal birth cohort of about 850 families (mother, father, newborn and eldest sibling) recruited during pregnancy at three hospitals in Ontario between 2002 and 2009, followed to study prenatal, early-childhood and family determinants of adiposity, cardiovascular risk factors and atherosclerosis in children.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19781411") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37908396") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19781411") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19781411+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The purpose of this study is to examine the fetal and early childhood family-based determinants for the development of adiposity, CVD risk factors, and atherosclerosis in childhood.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000680> "A Canadian longitudinal birth cohort of about 850 families (mother, father, newborn and eldest sibling) recruited during pregnancy at three hospitals in Ontario between 2002 and 2009, followed to study prenatal, early-childhood and family determinants of adiposity, cardiovascular risk factors and atherosclerosis in children.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19781411") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37908396") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10613963/fullTextXML") Annotation(rdfs:comment "The Family Atherosclerosis Monitoring in Early Life (FAMILY) study is a longitudinal birth cohort study with 857 families (901 newborns) enrolled from 2002 and 2009 from three hospitals in Ontario, Canada.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000680> "A Canadian longitudinal birth cohort of about 850 families (mother, father, newborn and eldest sibling) recruited during pregnancy at three hospitals in Ontario between 2002 and 2009, followed to study prenatal, early-childhood and family determinants of adiposity, cardiovascular risk factors and atherosclerosis in children.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000681> (<http://www.ebi.ac.uk/coho/COHO_0000681>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18372903") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9614613") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9614613") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9614613+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Design of the Finland-United States Investigation of NIDDM Genetics (FUSION) Study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000681> "A Finnish–US study of type 2 diabetes genetics that ascertained Finnish families with type 2 diabetes in at least two siblings, with spouses and offspring examined by frequently sampled intravenous glucose tolerance tests, and later Finnish type 2 diabetes cases and normoglycaemic controls, to map susceptibility genes for type 2 diabetes and related quantitative traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18372903") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9614613") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9614613") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9614613+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In a subset of families, a spouse and offspring were sampled, and they participated in a frequently sampled intravenous glucose tolerance test (FSIGT) analyzed with the Minimal Model.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000681> "A Finnish–US study of type 2 diabetes genetics that ascertained Finnish families with type 2 diabetes in at least two siblings, with spouses and offspring examined by frequently sampled intravenous glucose tolerance tests, and later Finnish type 2 diabetes cases and normoglycaemic controls, to map susceptibility genes for type 2 diabetes and related quantitative traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18372903") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9614613") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9614613") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9614613+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "To map and identify susceptibility genes for NIDDM and for the intermediate quantitative traits associated with NIDDM.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000681> "A Finnish–US study of type 2 diabetes genetics that ascertained Finnish families with type 2 diabetes in at least two siblings, with spouses and offspring examined by frequently sampled intravenous glucose tolerance tests, and later Finnish type 2 diabetes cases and normoglycaemic controls, to map susceptibility genes for type 2 diabetes and related quantitative traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18372903") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9614613") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9614613") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9614613+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Using a careful selection strategy, we have ascertained 495 families with confirmed NIDDM in at least two siblings and no history of IDDM among the first-degree relatives.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000681> "A Finnish–US study of type 2 diabetes genetics that ascertained Finnish families with type 2 diabetes in at least two siblings, with spouses and offspring examined by frequently sampled intravenous glucose tolerance tests, and later Finnish type 2 diabetes cases and normoglycaemic controls, to map susceptibility genes for type 2 diabetes and related quantitative traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18372903") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9614613") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.125/MediaObjects/41588_2008_BFng125_MOESM15_ESM.pdf") Annotation(rdfs:comment "The FUSION genome-wide association (GWA) study included 1,161 Finnish type 2 diabetes (T2D) cases, 1,174 normal glucose tolerant (NGT) controls, and 122 offspring of case/control pairs") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000681> "A Finnish–US study of type 2 diabetes genetics that ascertained Finnish families with type 2 diabetes in at least two siblings, with spouses and offspring examined by frequently sampled intravenous glucose tolerance tests, and later Finnish type 2 diabetes cases and normoglycaemic controls, to map susceptibility genes for type 2 diabetes and related quantitative traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18372903") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9614613") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000100.v3.p1") Annotation(rdfs:comment "The initial effort involved linkage analysis of affected-sibling-pair (ASP) families based on over 5,000 individuals living in Finland, and association fine mapping based on these family members and additional T2D cases and controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000681> "A Finnish–US study of type 2 diabetes genetics that ascertained Finnish families with type 2 diabetes in at least two siblings, with spouses and offspring examined by frequently sampled intravenous glucose tolerance tests, and later Finnish type 2 diabetes cases and normoglycaemic controls, to map susceptibility genes for type 2 diabetes and related quantitative traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000682> (<http://www.ebi.ac.uk/coho/COHO_0000682>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40042063") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40042063") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11880917/fullTextXML") Annotation(rdfs:comment "Briefly, GEM was a randomized, placebo‐controlled trial that was conducted from 2000 to 2008 across five different academic centers in the United States to assess the effectiveness of Ginkgo biloba on incident dementia in 3069 participants aged ≥ 75, including 2587 cognitively normal individuals and 482 individuals with mild cognitive impairment (MCI).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000682> "A randomized, placebo-controlled trial of Ginkgo biloba for preventing incident dementia in 3069 adults aged 75 and over, 2587 cognitively normal and 482 with mild cognitive impairment, conducted from 2000 to 2008 at five academic centers in the United States.")

