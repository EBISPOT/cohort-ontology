AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28445188") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9870026/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28445188") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC5432027") Annotation(rdfs:comment "All participants were carefully clinically phenotyped.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000537> "A UK study of the molecular genetics of adverse drug reactions in children, recruiting carefully phenotyped retrospective cohorts of treated children at UK hospitals; its cisplatin cohort comprises platinum-treated paediatric cancer patients recruited between 2012 and 2018 at eight UK sites for genetic studies of ototoxicity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28445188") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9870026/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28445188") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC5432027") Annotation(rdfs:comment "Participants were recruited to the Molecular Genetics of Adverse Drug Reactions in Childhood (MAGIC) study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000537> "A UK study of the molecular genetics of adverse drug reactions in children, recruiting carefully phenotyped retrospective cohorts of treated children at UK hospitals; its cisplatin cohort comprises platinum-treated paediatric cancer patients recruited between 2012 and 2018 at eight UK sites for genetic studies of ototoxicity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28445188") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9870026/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28445188") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC5432027") Annotation(rdfs:comment "We recruited 149 children from seven UK centres using a retrospective cohort study design.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000537> "A UK study of the molecular genetics of adverse drug reactions in children, recruiting carefully phenotyped retrospective cohorts of treated children at UK hospitals; its cisplatin cohort comprises platinum-treated paediatric cancer patients recruited between 2012 and 2018 at eight UK sites for genetic studies of ototoxicity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28445188") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9870026/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36699085") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9870026/fullTextXML") Annotation(rdfs:comment "The United Kingdom MAGIC study cohort was a retrospective cohort of platinum-treated pediatric cancer patients recruited between January 2012 and March 2018 at eight United Kingdom sites") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000537> "A UK study of the molecular genetics of adverse drug reactions in children, recruiting carefully phenotyped retrospective cohorts of treated children at UK hospitals; its cisplatin cohort comprises platinum-treated paediatric cancer patients recruited between 2012 and 2018 at eight UK sites for genetic studies of ototoxicity.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28445188") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9870026/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36699085") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9870026/fullTextXML") Annotation(rdfs:comment "Therefore, a genome-wide association study was performed in the Genetics of Childhood Cancer Treatment (GO-CAT) cohort (n = 261) and the United Kingdom Molecular Genetics of Adverse Drug Reactions in Children Study (United Kingdom MAGIC) cohort (n = 248).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000537> "A UK study of the molecular genetics of adverse drug reactions in children, recruiting carefully phenotyped retrospective cohorts of treated children at UK hospitals; its cisplatin cohort comprises platinum-treated paediatric cancer patients recruited between 2012 and 2018 at eight UK sites for genetic studies of ototoxicity.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000538> (<http://www.ebi.ac.uk/coho/COHO_0000538>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28064197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12873190/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28064197") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5837608/") Annotation(rdfs:comment "A total of 2900 women (‘Generation 1’) were enrolled into the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000538> "A pregnancy cohort in Western Australia for which 2,900 pregnant women were recruited between 1989 and 1991 at King Edward Memorial Hospital, Perth, and nearby private clinics, with the mothers (Generation 1) and their 2,868 offspring (Generation 2) followed from 18 weeks' gestation through childhood and adolescence into adulthood, to study how early life shapes later health and behaviour.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28064197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12873190/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28064197") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5837608/") Annotation(rdfs:comment "Pregnant women presenting at the public antenatal clinic at King Edward Memorial Hospital (at that time it was the only tertiary women’s and infants’ hospital in Perth, Western Australia) and nearby private practice clinics between May 1989 and November 19913 were invited to participate.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000538> "A pregnancy cohort in Western Australia for which 2,900 pregnant women were recruited between 1989 and 1991 at King Edward Memorial Hospital, Perth, and nearby private clinics, with the mothers (Generation 1) and their 2,868 offspring (Generation 2) followed from 18 weeks' gestation through childhood and adolescence into adulthood, to study how early life shapes later health and behaviour.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28064197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12873190/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28064197") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5837608/") Annotation(rdfs:comment "The Raine Study is a prospective observational study examining health and well-being across the life course from before birth through to young adulthood.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000538> "A pregnancy cohort in Western Australia for which 2,900 pregnant women were recruited between 1989 and 1991 at King Edward Memorial Hospital, Perth, and nearby private clinics, with the mothers (Generation 1) and their 2,868 offspring (Generation 2) followed from 18 weeks' gestation through childhood and adolescence into adulthood, to study how early life shapes later health and behaviour.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28064197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12873190/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28064197") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5837608/") Annotation(rdfs:comment "The Western Australian Pregnancy Cohort (Raine) Study (www.rainestudy.org.au) was established 1989-1991 with the then stated purpose: to develop a large cohort of Western Australian children studied from 18 weeks’ gestation to ascertain the relative contributions of familial risk factors, fetal growth, placental development and environmental insults to outcome in infancy") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000538> "A pregnancy cohort in Western Australia for which 2,900 pregnant women were recruited between 1989 and 1991 at King Edward Memorial Hospital, Perth, and nearby private clinics, with the mothers (Generation 1) and their 2,868 offspring (Generation 2) followed from 18 weeks' gestation through childhood and adolescence into adulthood, to study how early life shapes later health and behaviour.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28064197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12873190/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28064197") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5837608/") Annotation(rdfs:comment "There were 2868 live births–the index participants of ‘Generation 2’–including 60 sets of twins (n = 120) and two sets of triplets (n = 6), from 2826 mothers (see Figure 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000538> "A pregnancy cohort in Western Australia for which 2,900 pregnant women were recruited between 1989 and 1991 at King Edward Memorial Hospital, Perth, and nearby private clinics, with the mothers (Generation 1) and their 2,868 offspring (Generation 2) followed from 18 weeks' gestation through childhood and adolescence into adulthood, to study how early life shapes later health and behaviour.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28064197") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12873190/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12873190/fullTextXML") Annotation(rdfs:comment "The Raine Study is a well-characterised pregnancy cohort located in Western Australia.31–33 In brief, the recruitment of 2900 mothers during pregnancy began in 1989 from the King Edward Memorial Hospital and surrounding clinics.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000538> "A pregnancy cohort in Western Australia for which 2,900 pregnant women were recruited between 1989 and 1991 at King Edward Memorial Hospital, Perth, and nearby private clinics, with the mothers (Generation 1) and their 2,868 offspring (Generation 2) followed from 18 weeks' gestation through childhood and adolescence into adulthood, to study how early life shapes later health and behaviour.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000539> (<http://www.ebi.ac.uk/coho/COHO_0000539>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12097148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12457784") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12097148") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12097148+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In Scotland, Ireland, and the Netherlands, 23,770 individuals were screened, and 5,804 subjects (2,804 men and 3,000 women), aged 70 to 82 years (average 75 years) and with baseline cholesterol 4.0-9.0 mmol/l, were randomised.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000539> "A randomised, double-blind, placebo-controlled trial population of 5,804 men and women aged 70 to 82 with pre-existing vascular disease or risk factors for it, screened in Scotland, Ireland and the Netherlands and randomised to pravastatin 40 mg/day or placebo for about 3.2 years to test whether statin treatment reduces coronary and cerebrovascular events in the elderly.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12097148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12457784") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12097148") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12097148+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The PROspective Study of Pravastatin in the Elderly at Risk (PROSPER) is a randomised, double blind, placebo-controlled trial to test the hypothesis that treatment with pravastatin (40 mg/day) will reduce the risk of coronary heart disease death, non-fatal myocardial infarction, and fatal or non-fatal stroke in elderly men and women with pre-existing vascular disease or with significant risk of developing this condition.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000539> "A randomised, double-blind, placebo-controlled trial population of 5,804 men and women aged 70 to 82 with pre-existing vascular disease or risk factors for it, screened in Scotland, Ireland and the Netherlands and randomised to pravastatin 40 mg/day or placebo for about 3.2 years to test whether statin treatment reduces coronary and cerebrovascular events in the elderly.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12097148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12457784") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12457784") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12457784+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Follow-up was 3.2 years on average and our primary endpoint was a composite of coronary death, non-fatal myocardial infarction, and fatal or non-fatal stroke.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000539> "A randomised, double-blind, placebo-controlled trial population of 5,804 men and women aged 70 to 82 with pre-existing vascular disease or risk factors for it, screened in Scotland, Ireland and the Netherlands and randomised to pravastatin 40 mg/day or placebo for about 3.2 years to test whether statin treatment reduces coronary and cerebrovascular events in the elderly.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12097148") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12457784") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12457784") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12457784+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We did a randomised controlled trial in which we assigned 5804 men (n=2804) and women (n=3000) aged 70-82 years with a history of, or risk factors for, vascular disease to pravastatin (40 mg per day; n=2891) or placebo (n=2913).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000539> "A randomised, double-blind, placebo-controlled trial population of 5,804 men and women aged 70 to 82 with pre-existing vascular disease or risk factors for it, screened in Scotland, Ireland and the Netherlands and randomised to pravastatin 40 mg/day or placebo for about 3.2 years to test whether statin treatment reduces coronary and cerebrovascular events in the elderly.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000540> (<http://www.ebi.ac.uk/coho/COHO_0000540>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17443206") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28993450") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4873465/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17443206") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2377400/") Annotation(rdfs:comment "A total of 1,906 study participants (676 probands, 956 siblings, 69 spouses, and 205 offspring) took part in the dietary intervention.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000540> "A family feeding study in rural northern China that recruited 3,153 Han Chinese participants from 658 families, each ascertained through a proband with untreated prehypertension or stage-1 hypertension, of whom 1,906 eligible probands and their siblings, spouses and offspring underwent seven-day low-sodium, high-sodium and high-sodium with potassium supplementation dietary interventions, to localise and identify genes influencing blood pressure responses to dietary sodium and potassium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17443206") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28993450") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4873465/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17443206") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2377400/") Annotation(rdfs:comment "Each family is ascertained through a proband with untreated prehypertension or stage-1 hypertension in rural China.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000540> "A family feeding study in rural northern China that recruited 3,153 Han Chinese participants from 658 families, each ascertained through a proband with untreated prehypertension or stage-1 hypertension, of whom 1,906 eligible probands and their siblings, spouses and offspring underwent seven-day low-sodium, high-sodium and high-sodium with potassium supplementation dietary interventions, to localise and identify genes influencing blood pressure responses to dietary sodium and potassium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17443206") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28993450") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4873465/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17443206") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2377400/") Annotation(rdfs:comment "The Genetic Epidemiology Network of Salt Sensitivity (GenSalt) utilizes a family feeding study design to examine gene-diet (sodium and potassium) interactions on BP.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000540> "A family feeding study in rural northern China that recruited 3,153 Han Chinese participants from 658 families, each ascertained through a proband with untreated prehypertension or stage-1 hypertension, of whom 1,906 eligible probands and their siblings, spouses and offspring underwent seven-day low-sodium, high-sodium and high-sodium with potassium supplementation dietary interventions, to localise and identify genes influencing blood pressure responses to dietary sodium and potassium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17443206") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28993450") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4873465/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17443206") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17443206+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Overall, 3153 participants from 658 families were recruited for GenSalt.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000540> "A family feeding study in rural northern China that recruited 3,153 Han Chinese participants from 658 families, each ascertained through a proband with untreated prehypertension or stage-1 hypertension, of whom 1,906 eligible probands and their siblings, spouses and offspring underwent seven-day low-sodium, high-sodium and high-sodium with potassium supplementation dietary interventions, to localise and identify genes influencing blood pressure responses to dietary sodium and potassium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17443206") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28993450") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4873465/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17443206") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17443206+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The dietary intervention included a 7-day low-sodium feeding (51.3 mmol/day), a 7-day high-sodium feeding (307.8 mmol/day) and a 7-day high-sodium feeding with an oral potassium supplementation (60 mmol/day).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000540> "A family feeding study in rural northern China that recruited 3,153 Han Chinese participants from 658 families, each ascertained through a proband with untreated prehypertension or stage-1 hypertension, of whom 1,906 eligible probands and their siblings, spouses and offspring underwent seven-day low-sodium, high-sodium and high-sodium with potassium supplementation dietary interventions, to localise and identify genes influencing blood pressure responses to dietary sodium and potassium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17443206") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28993450") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4873465/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4873465/fullTextXML") Annotation(rdfs:comment "A 7-day low-sodium followed by a 7-day high-sodium dietary intervention was conducted among 1906 Han participants from rural areas of northern China.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000540> "A family feeding study in rural northern China that recruited 3,153 Han Chinese participants from 658 families, each ascertained through a proband with untreated prehypertension or stage-1 hypertension, of whom 1,906 eligible probands and their siblings, spouses and offspring underwent seven-day low-sodium, high-sodium and high-sodium with potassium supplementation dietary interventions, to localise and identify genes influencing blood pressure responses to dietary sodium and potassium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000541> (<http://www.ebi.ac.uk/coho/COHO_0000541>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35216576") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35216576") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(rdfs:comment "All KP members aged 18 and older whose preferred language is English or Spanish are eligible to join the KPRB.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000541> "A research resource of Kaiser Permanente, launched in May 2016 and built on the Research Program on Genes, Environment and Health, that collects biospecimens and surveys linked to electronic health records from consenting adult members across Kaiser Permanente's eight US regions (about 396,000 consented by July 2021), with general, pregnancy and cancer cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35216576") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35216576") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(rdfs:comment "Approximately 396,000 KP members have consented to join the KPRB as of July 2021, and biospecimens have been collected on approximately 371,000 adults (94% of those consented).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000541> "A research resource of Kaiser Permanente, launched in May 2016 and built on the Research Program on Genes, Environment and Health, that collects biospecimens and surveys linked to electronic health records from consenting adult members across Kaiser Permanente's eight US regions (about 396,000 consented by July 2021), with general, pregnancy and cancer cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35216576") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35216576") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(rdfs:comment "KP provides health care for approximately 12.5 million individuals across eight regions: Colorado, Georgia, Hawai’i, Mid-Atlantic, Northern California, Northwest, Southern California, and Washington.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000541> "A research resource of Kaiser Permanente, launched in May 2016 and built on the Research Program on Genes, Environment and Health, that collects biospecimens and surveys linked to electronic health records from consenting adult members across Kaiser Permanente's eight US regions (about 396,000 consented by July 2021), with general, pregnancy and cancer cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35216576") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35216576") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(rdfs:comment "Launched in May 2016, the KPRB is built on an existing repository (Research Program on Genes, Environment and Health, or RPGEH) of approximately 220,000 KP members with data and biospecimens collected primarily between 2007 and 2011 from members of KP Northern California, and to a smaller extent, Southern California [6].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000541> "A research resource of Kaiser Permanente, launched in May 2016 and built on the Research Program on Genes, Environment and Health, that collects biospecimens and surveys linked to electronic health records from consenting adult members across Kaiser Permanente's eight US regions (about 396,000 consented by July 2021), with general, pregnancy and cancer cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35216576") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35216576") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(rdfs:comment "The KP Research Bank (KPRB), a research resource within KP, is seeking to collect biospecimens and surveys from at least 400,000 adult members across the U.S. and linking that information to the EHR.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000541> "A research resource of Kaiser Permanente, launched in May 2016 and built on the Research Program on Genes, Environment and Health, that collects biospecimens and surveys linked to electronic health records from consenting adult members across Kaiser Permanente's eight US regions (about 396,000 consented by July 2021), with general, pregnancy and cancer cohorts.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35216576") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35216576") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8876075/fullTextXML") Annotation(rdfs:comment "The KPRB consists of three cohorts: a general cohort, a pregnancy cohort [7], and a cancer cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000541> "A research resource of Kaiser Permanente, launched in May 2016 and built on the Research Program on Genes, Environment and Health, that collects biospecimens and surveys linked to electronic health records from consenting adult members across Kaiser Permanente's eight US regions (about 396,000 consented by July 2021), with general, pregnancy and cancer cohorts.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000542> (<http://www.ebi.ac.uk/coho/COHO_0000542>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17254440") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31796137") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31796137") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31796137+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The MCTFR includes the Minnesota Twin Registry (MTR), a cohort of twins who have completed assessments in middle and older adulthood; the Minnesota Twin Family Study (MTFS) of twins assessed from childhood and adolescence into middle adulthood; the Enrichment Study (ES) of twins oversampled for high risk for substance-use disorders assessed from childhood into young adulthood;") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000542> "A collection of longitudinal, community-representative twin and adoptive family studies in Minnesota, including the Minnesota Twin Registry, the Minnesota Twin Family Study, the Enrichment Study, the Adolescent Brain study and the Sibling Interaction and Behavior Study, focusing on psychological adjustment, personality, cognitive ability and brain function with an emphasis on substance use and related psychopathology.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17254440") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31796137") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31796137") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31796137+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Minnesota Center for Twin and Family Research (MCTFR) comprises multiple longitudinal, community-representative investigations of twin and adoptive families that focus on psychological adjustment, personality, cognitive ability and brain function, with a special emphasis on substance use and related psychopathology.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000542> "A collection of longitudinal, community-representative twin and adoptive family studies in Minnesota, including the Minnesota Twin Registry, the Minnesota Twin Family Study, the Enrichment Study, the Adolescent Brain study and the Sibling Interaction and Behavior Study, focusing on psychological adjustment, personality, cognitive ability and brain function with an emphasis on substance use and related psychopathology.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17254440") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31796137") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31796137") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A31796137+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "the Adolescent Brain (AdBrain) study, a neuroimaging study of adolescent twins; and the Siblings Interaction and Behavior Study (SIBS), a study of adoptive and nonadoptive families assessed from adolescence into young adulthood.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000542> "A collection of longitudinal, community-representative twin and adoptive family studies in Minnesota, including the Minnesota Twin Registry, the Minnesota Twin Family Study, the Enrichment Study, the Adolescent Brain study and the Sibling Interaction and Behavior Study, focusing on psychological adjustment, personality, cognitive ability and brain function with an emphasis on substance use and related psychopathology.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17254440") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31796137") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31796137") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7056536/unicode") Annotation(rdfs:comment "The MCTFR twin samples are population-based and representative of Minnesota State in demographic characteristics (for adult twins and for families with children living at home for adolescent twins) at the targeted birth years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000542> "A collection of longitudinal, community-representative twin and adoptive family studies in Minnesota, including the Minnesota Twin Registry, the Minnesota Twin Family Study, the Enrichment Study, the Adolescent Brain study and the Sibling Interaction and Behavior Study, focusing on psychological adjustment, personality, cognitive ability and brain function with an emphasis on substance use and related psychopathology.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000543> (<http://www.ebi.ac.uk/coho/COHO_0000543>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14968294") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19455304") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14968294") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14968294+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Baseline measurements of glucose tolerance and insulin sensitivity are made by the oral glucose tolerance test and the euglycaemic insulin clamp, respectively") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000543> "A prospective cohort of healthy men and women of European ancestry aged 30 to 60, recruited without diabetes, hypertension or dyslipidaemia at centres in 13-14 European countries by the European Group for the Study of Insulin Resistance, with baseline oral glucose tolerance tests and euglycaemic insulin clamps and follow-up after 3 and 10 years to study how insulin resistance relates to atherosclerosis, cardiovascular disease and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14968294") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19455304") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14968294") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14968294+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Development of Type 2 diabetes, dyslipidaemia, obesity, hypertension and cardiovascular events are additional endpoints.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000543> "A prospective cohort of healthy men and women of European ancestry aged 30 to 60, recruited without diabetes, hypertension or dyslipidaemia at centres in 13-14 European countries by the European Group for the Study of Insulin Resistance, with baseline oral glucose tolerance tests and euglycaemic insulin clamps and follow-up after 3 and 10 years to study how insulin resistance relates to atherosclerosis, cardiovascular disease and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14968294") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19455304") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14968294") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14968294+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Investigations will be repeated after 3 and 10 years to evaluate the relationship between insulin resistance and the development of atherosclerosis as measured by carotid artery intima-media thickness.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000543> "A prospective cohort of healthy men and women of European ancestry aged 30 to 60, recruited without diabetes, hypertension or dyslipidaemia at centres in 13-14 European countries by the European Group for the Study of Insulin Resistance, with baseline oral glucose tolerance tests and euglycaemic insulin clamps and follow-up after 3 and 10 years to study how insulin resistance relates to atherosclerosis, cardiovascular disease and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14968294") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19455304") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:14968294") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A14968294+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The RISC (Relationship between Insulin Sensitivity and Cardiovascular disease) Study is using the infrastructure of an extended European collaborative research group to study insulin resistance and CVD risk in 1500 healthy people aged 30 to 60 years from 20 centres in 13 countries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000543> "A prospective cohort of healthy men and women of European ancestry aged 30 to 60, recruited without diabetes, hypertension or dyslipidaemia at centres in 13-14 European countries by the European Group for the Study of Insulin Resistance, with baseline oral glucose tolerance tests and euglycaemic insulin clamps and follow-up after 3 and 10 years to study how insulin resistance relates to atherosclerosis, cardiovascular disease and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14968294") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19455304") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19455304") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19455304+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We studied 1,276 healthy individuals of European ancestry at 19 centres of the Relationship between Insulin Sensitivity and Cardiovascular disease (RISC) study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000543> "A prospective cohort of healthy men and women of European ancestry aged 30 to 60, recruited without diabetes, hypertension or dyslipidaemia at centres in 13-14 European countries by the European Group for the Study of Insulin Resistance, with baseline oral glucose tolerance tests and euglycaemic insulin clamps and follow-up after 3 and 10 years to study how insulin resistance relates to atherosclerosis, cardiovascular disease and type 2 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:14968294") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19455304") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2699728/fullTextXML") Annotation(rdfs:comment "Cohort members were recruited by 19 research centers in 14 European countries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000543> "A prospective cohort of healthy men and women of European ancestry aged 30 to 60, recruited without diabetes, hypertension or dyslipidaemia at centres in 13-14 European countries by the European Group for the Study of Insulin Resistance, with baseline oral glucose tolerance tests and euglycaemic insulin clamps and follow-up after 3 and 10 years to study how insulin resistance relates to atherosclerosis, cardiovascular disease and type 2 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000544> (<http://www.ebi.ac.uk/coho/COHO_0000544>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33717105") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33717105") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7944992/fullTextXML") Annotation(rdfs:comment "Every 4 years participants are interviewed at their homes and they visit the study center for an extensive clinical assessment, including venipuncture and assessment of various cardiometabolic risk factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000544> "The first cohort of the Rotterdam Study, a prospective population-based cohort of 7,983 inhabitants aged 55 and over of Ommoord, a suburb of Rotterdam in the Netherlands, started in 1990 and re-examined about every 4 years with home interviews and clinical assessments to study determinants of chronic diseases in older adults.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33717105") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33717105") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7944992/fullTextXML") Annotation(rdfs:comment "The Rotterdam Study (RS) is a prospective, population-based cohort study of determinants of chronic diseases in older adults (7).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000544> "The first cohort of the Rotterdam Study, a prospective population-based cohort of 7,983 inhabitants aged 55 and over of Ommoord, a suburb of Rotterdam in the Netherlands, started in 1990 and re-examined about every 4 years with home interviews and clinical assessments to study determinants of chronic diseases in older adults.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33717105") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33717105") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7944992/fullTextXML") Annotation(rdfs:comment "The first cohort (RS-I) started in 1990 and included 7,983 inhabitants, aged ≥55 years from Ommoord, a suburb of Rotterdam in the Netherlands.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000544> "The first cohort of the Rotterdam Study, a prospective population-based cohort of 7,983 inhabitants aged 55 and over of Ommoord, a suburb of Rotterdam in the Netherlands, started in 1990 and re-examined about every 4 years with home interviews and clinical assessments to study determinants of chronic diseases in older adults.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000545> (<http://www.ebi.ac.uk/coho/COHO_0000545>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29703560") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29703560") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6314286/fullTextXML") Annotation(rdfs:comment "A baseline cohort of 11,500 nine and ten year old children (and their parents/guardians) are being recruited and will be followed for ten years with annual lab-based assessments including biennial Magnetic Resonance Imaging (MRI).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000545> "A longitudinal cohort of children aged 9-10, including twins, recruited largely through schools at 21 data acquisition sites across the United States to reflect the nation's diversity, and followed for ten years with annual assessments and biennial MRI to study adolescent brain and cognitive development.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29703560") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29703560") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6314286/fullTextXML") Annotation(rdfs:comment "A very important motivation for the ABCD study is that its sample should reflect, as best as possible, the sociodemographic variation of the US population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000545> "A longitudinal cohort of children aged 9-10, including twins, recruited largely through schools at 21 data acquisition sites across the United States to reflect the nation's diversity, and followed for ten years with annual assessments and biennial MRI to study adolescent brain and cognitive development.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29703560") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29703560") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6314286/fullTextXML") Annotation(rdfs:comment "The ABCD study is a new and ongoing project of very substantial size and scale involving 21 data acquisition sites.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000545> "A longitudinal cohort of children aged 9-10, including twins, recruited largely through schools at 21 data acquisition sites across the United States to reflect the nation's diversity, and followed for ten years with annual assessments and biennial MRI to study adolescent brain and cognitive development.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29703560") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29703560") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6314286/fullTextXML") Annotation(rdfs:comment "The Adolescent Brain Cognitive Development study (ABCD) aims to characterize psychological and neurobiological development from pre-adolescence to young adulthood.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000545> "A longitudinal cohort of children aged 9-10, including twins, recruited largely through schools at 21 data acquisition sites across the United States to reflect the nation's diversity, and followed for ten years with annual assessments and biennial MRI to study adolescent brain and cognitive development.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29703560") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29703560") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6314286/fullTextXML") Annotation(rdfs:comment "The final cohort will include 9780 single births and 1720 twins:") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000545> "A longitudinal cohort of children aged 9-10, including twins, recruited largely through schools at 21 data acquisition sites across the United States to reflect the nation's diversity, and followed for ten years with annual assessments and biennial MRI to study adolescent brain and cognitive development.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29703560") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29703560") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6314286/fullTextXML") Annotation(rdfs:comment "The primary recruitment approach of the ABCD study is through elementary schools, both public (including charter schools) and private.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000545> "A longitudinal cohort of children aged 9-10, including twins, recruited largely through schools at 21 data acquisition sites across the United States to reflect the nation's diversity, and followed for ten years with annual assessments and biennial MRI to study adolescent brain and cognitive development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000546> (<http://www.ebi.ac.uk/coho/COHO_0000546>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37233759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25812009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") Annotation(rdfs:comment "All CRC visits took place at an academic medical center (Massachusetts General Hospital, Brigham and Women’s Hospital, or the Joslin Diabetes Center, all in Boston, MA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000546> "A pharmacogenetic study established in 2007 at Massachusetts General Hospital, which from 2008 enrolled about 1,000 adults of diverse ancestry enriched for risk of type 2 diabetes and challenged them with glipizide and metformin at clinical research centres in Boston, Massachusetts, to identify genetic variants influencing the acute response to glucose-lowering drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37233759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25812009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") Annotation(rdfs:comment "SUGAR-MGH (ClinicalTrials.Gov: NCT01762046, clinicaltrials.gov/ct2/show/NCT01762046) was established in 2007 with funding from the National Institutes of Health, and a streamlined protocol was designed that requires only two clinical research center (CRC) visits and 1 week of active treatment per subject (Fig. 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000546> "A pharmacogenetic study established in 2007 at Massachusetts General Hospital, which from 2008 enrolled about 1,000 adults of diverse ancestry enriched for risk of type 2 diabetes and challenged them with glipizide and metformin at clinical research centres in Boston, Massachusetts, to identify genetic variants influencing the acute response to glucose-lowering drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37233759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25812009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") Annotation(rdfs:comment "The first participant was enrolled on February 14, 2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000546> "A pharmacogenetic study established in 2007 at Massachusetts General Hospital, which from 2008 enrolled about 1,000 adults of diverse ancestry enriched for risk of type 2 diabetes and challenged them with glipizide and metformin at clinical research centres in Boston, Massachusetts, to identify genetic variants influencing the acute response to glucose-lowering drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37233759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25812009") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") Annotation(rdfs:comment "We describe recruitment, enrollment, and phenotyping procedures and preliminary results for the first 668 of our planned 1,000 participants enriched for individuals at risk of requiring anti-diabetic therapy in the future.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000546> "A pharmacogenetic study established in 2007 at Massachusetts General Hospital, which from 2008 enrolled about 1,000 adults of diverse ancestry enriched for risk of type 2 diabetes and challenged them with glipizide and metformin at clinical research centres in Boston, Massachusetts, to identify genetic variants influencing the acute response to glucose-lowering drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37233759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37233759") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10790310/unicode") Annotation(rdfs:comment "One thousand participants at risk for type 2 diabetes from diverse ancestries underwent sequential glipizide and metformin challenges.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000546> "A pharmacogenetic study established in 2007 at Massachusetts General Hospital, which from 2008 enrolled about 1,000 adults of diverse ancestry enriched for risk of type 2 diabetes and challenged them with glipizide and metformin at clinical research centres in Boston, Massachusetts, to identify genetic variants influencing the acute response to glucose-lowering drugs.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37233759") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4374872/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37233759") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC10790310/unicode") Annotation(rdfs:comment "The Study to Understand the Genetics of the Acute Response to Metformin and Glipizide in Humans (SUGAR-MGH) examined the acute response to metformin and glipizide in order to identify new pharmacogenetic associations for the response to common glucose-lowering medications in individuals at risk of type 2 diabetes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000546> "A pharmacogenetic study established in 2007 at Massachusetts General Hospital, which from 2008 enrolled about 1,000 adults of diverse ancestry enriched for risk of type 2 diabetes and challenged them with glipizide and metformin at clinical research centres in Boston, Massachusetts, to identify genetic variants influencing the acute response to glucose-lowering drugs.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000547> (<http://www.ebi.ac.uk/coho/COHO_0000547>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3616155/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4762074/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC5913593") Annotation(rdfs:comment "Australasian Colorectal Cancer Family Registry (U01 CA074778 and U01/U24 CA097735); Mayo Clinic Cooperative Family Registry for Colon Cancer Studies (U01/U24 CA074800); Ontario Familial Colorectal Cancer Registry (U01/U24 CA074783); Seattle Colorectal Cancer Family Registry (U01/U24 CA074794); University of Hawaii Colorectal Cancer Family Registry (U01/U24 CA074806); and USC Consortium Colorectal Cancer Family Registry") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000547> "An international registry and cohort, funded by the US National Cancer Institute and begun in 1997, of colorectal cancer cases, their unaffected relatives and population-based controls recruited through six centres in Australasia and North America (the Australasian, Mayo Clinic, Ontario, Seattle, University of Hawaii and USC Consortium registries), as a resource for research on familial and sporadic colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3616155/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4762074/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC5913593") Annotation(rdfs:comment "From its inception, the CCFRC has functioned under the principle that it is a resource for research on the aetiology, risk and prognosis of colorectal cancer for all researchers, including those not affiliated with CCFRC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000547> "An international registry and cohort, funded by the US National Cancer Institute and begun in 1997, of colorectal cancer cases, their unaffected relatives and population-based controls recruited through six centres in Australasia and North America (the Australasian, Mayo Clinic, Ontario, Seattle, University of Hawaii and USC Consortium registries), as a resource for research on familial and sporadic colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3616155/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4762074/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3616155/fullTextXML") Annotation(rdfs:comment "Briefly, the Colon CFR is an international collaborative study initiated in 1997.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000547> "An international registry and cohort, funded by the US National Cancer Institute and begun in 1997, of colorectal cancer cases, their unaffected relatives and population-based controls recruited through six centres in Australasia and North America (the Australasian, Mayo Clinic, Ontario, Seattle, University of Hawaii and USC Consortium registries), as a resource for research on familial and sporadic colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3616155/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4762074/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3616155/fullTextXML") Annotation(rdfs:comment "Data for this study were obtained through the Colon CFR, a National Cancer Institute (NCI)–funded registry of CRC cases, unaffected family members, and population-based controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000547> "An international registry and cohort, funded by the US National Cancer Institute and begun in 1997, of colorectal cancer cases, their unaffected relatives and population-based controls recruited through six centres in Australasia and North America (the Australasian, Mayo Clinic, Ontario, Seattle, University of Hawaii and USC Consortium registries), as a resource for research on familial and sporadic colorectal cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3616155/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4762074/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3616155/fullTextXML") Annotation(rdfs:comment "Participants were recruited from six centers including centers in the University of Southern California Consortium (Arizona, Cleveland Clinic, Colorado, Dartmouth, Minnesota, North Carolina, and University of Southern California), Hawaii (Honolulu), Fred Hutchinson Cancer Research Center (Seattle, WA), Mayo Clinic (Rochester, MN), Cancer Care Ontario (Toronto, Canada), and University of Melbourne (Victoria, Australia)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000547> "An international registry and cohort, funded by the US National Cancer Institute and begun in 1997, of colorectal cancer cases, their unaffected relatives and population-based controls recruited through six centres in Australasia and North America (the Australasian, Mayo Clinic, Ontario, Seattle, University of Hawaii and USC Consortium registries), as a resource for research on familial and sporadic colorectal cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000548> (<http://www.ebi.ac.uk/coho/COHO_0000548>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23409726") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30897159") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23409726") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3577512") Annotation(rdfs:comment "DIACORE is a prospective cohort study aiming to recruit 6000 patients of self-reported Caucasian ethnicity with prevalent DM2 for at least 10 years of follow-up.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000548> "A prospective cohort of about 3,000 adult outpatients of self-reported Caucasian ethnicity with prevalent type 2 diabetes, recruited in 2010–2014 at two university-based study centres in Germany and followed with biennial visits, core phenotyping and biobanking for at least 10 years to study diabetes complications, with a primary focus on renal events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23409726") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30897159") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23409726") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3577512/fullTextXML") Annotation(rdfs:comment "A standardized core phenotyping protocol including interview and medical examinations is performed at baseline and at every 2-year follow-up visit, with long-term follow-up of at least 10 years planned.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000548> "A prospective cohort of about 3,000 adult outpatients of self-reported Caucasian ethnicity with prevalent type 2 diabetes, recruited in 2010–2014 at two university-based study centres in Germany and followed with biennial visits, core phenotyping and biobanking for at least 10 years to study diabetes complications, with a primary focus on renal events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23409726") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30897159") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23409726") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3577512/fullTextXML") Annotation(rdfs:comment "This includes a standardized online questionnaire and physical examination to determine incident micro- and macrovascular DM2 complications, malignancy and hospitalization, with a primary focus on renal events.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000548> "A prospective cohort of about 3,000 adult outpatients of self-reported Caucasian ethnicity with prevalent type 2 diabetes, recruited in 2010–2014 at two university-based study centres in Germany and followed with biennial visits, core phenotyping and biobanking for at least 10 years to study diabetes complications, with a primary focus on renal events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23409726") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30897159") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23409726") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3577512/fullTextXML") Annotation(rdfs:comment "Thus, we have initiated the DIAbetes COhoRtE study (DIACORE), a large cohort study for long term prospective follow-up with extensive biobanking.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000548> "A prospective cohort of about 3,000 adult outpatients of self-reported Caucasian ethnicity with prevalent type 2 diabetes, recruited in 2010–2014 at two university-based study centres in Germany and followed with biennial visits, core phenotyping and biobanking for at least 10 years to study diabetes complications, with a primary focus on renal events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23409726") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30897159") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30897159") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6428304/") Annotation(rdfs:comment "DIACORE (DIAbetes COhoRtE) is a prospective cohort study of 3000 adult DM2 outpatients.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000548> "A prospective cohort of about 3,000 adult outpatients of self-reported Caucasian ethnicity with prevalent type 2 diabetes, recruited in 2010–2014 at two university-based study centres in Germany and followed with biennial visits, core phenotyping and biobanking for at least 10 years to study diabetes complications, with a primary focus on renal events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23409726") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30897159") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30897159") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6428304/fullTextXML") Annotation(rdfs:comment "Patient recruitment at the baseline visit (Visit 1) was performed from 2/2010 through 8/2014 in two University based study centers in Germany through direct written or spoken invitation to participate, press articles, flyers or public presentations (S1 Fig).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000548> "A prospective cohort of about 3,000 adult outpatients of self-reported Caucasian ethnicity with prevalent type 2 diabetes, recruited in 2010–2014 at two university-based study centres in Germany and followed with biennial visits, core phenotyping and biobanking for at least 10 years to study diabetes complications, with a primary focus on renal events.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000549> (<http://www.ebi.ac.uk/coho/COHO_0000549>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13269534/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13269534/fullTextXML") Annotation(rdfs:comment "For the MrOS study men were recruited at six US clinical centers in Birmingham, AL; Minneapolis, MN; Palo Alto, CA; the Monongahela Valley near Pittsburgh, PA; Portland, OR; and San Diego, CA and the institutional review boards at each clinic site approved the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000549> "A US prospective multicentre cohort of men aged 65 or older recruited at six clinical centres (Birmingham, Minneapolis, Palo Alto, near Pittsburgh, Portland and San Diego), designed to examine risk factors for osteoporosis, fractures and prostate cancer in older men, with ancillary studies such as MrOS Sleep (2003-2005, in-home polysomnography).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13269534/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML") Annotation(rdfs:comment "An ancillary sleep study of 3,135 individuals was conducted between 2003 and 2005, including in-home PSG (Compumedics Safiro system; Abbotsford AU), anthropometry, and questionnaires.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000549> "A US prospective multicentre cohort of men aged 65 or older recruited at six clinical centres (Birmingham, Minneapolis, Palo Alto, near Pittsburgh, Portland and San Diego), designed to examine risk factors for osteoporosis, fractures and prostate cancer in older men, with ancillary studies such as MrOS Sleep (2003-2005, in-home polysomnography).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13269534/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML") Annotation(rdfs:comment "The Osteoporotic Fractures in Men Study (MrOS) is a prospective cohort study examining the risk factors for fractures, osteoporosis, and prostate cancer [94,95] in males age 65 or older from six U.S. communities.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000549> "A US prospective multicentre cohort of men aged 65 or older recruited at six clinical centres (Birmingham, Minneapolis, Palo Alto, near Pittsburgh, Portland and San Diego), designed to examine risk factors for osteoporosis, fractures and prostate cancer in older men, with ancillary studies such as MrOS Sleep (2003-2005, in-home polysomnography).")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13269534/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6467367/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8394596/fullTextXML") Annotation(rdfs:comment "An ancillary study (MrOS Sleep; 2003–2005) focused on outcomes of sleep disturbances used PSG and nearly identical procedures as in MESA (Compumedics Safiro system) [30].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000549> "A US prospective multicentre cohort of men aged 65 or older recruited at six clinical centres (Birmingham, Minneapolis, Palo Alto, near Pittsburgh, Portland and San Diego), designed to examine risk factors for osteoporosis, fractures and prostate cancer in older men, with ancillary studies such as MrOS Sleep (2003-2005, in-home polysomnography).")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000550> (<http://www.ebi.ac.uk/coho/COHO_0000550>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23316297") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41406505") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23316297") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3541606/fullTextXML") Annotation(rdfs:comment "Briefly, 40 856 individuals (47.8%) completed a questionnaire on demographics, history of cardiovascular and metabolic outcomes, medication use and pregnancy before their first visit, and collecting an early-morning urine sample in a vial to measure urinary albumin concentration.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000550> "A Dutch population-based cohort of 8,592 residents of the city of Groningen aged 28 to 75, enrolled in 1997-1998 from 40,856 respondents who sent a morning urine sample, enriched for people with urinary albumin of at least 10 mg/L plus a random control sample, and followed up to study renal and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23316297") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41406505") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23316297") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3541606/fullTextXML") Annotation(rdfs:comment "The baseline PREVEND participants were recruited from a total of 6000 individuals with a urinary albumin concentration ≥10 mg/L and a random control sample of individuals with a urinary albumin concentration <10 mg/L (n=2592).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000550> "A Dutch population-based cohort of 8,592 residents of the city of Groningen aged 28 to 75, enrolled in 1997-1998 from 40,856 respondents who sent a morning urine sample, enriched for people with urinary albumin of at least 10 mg/L plus a random control sample, and followed up to study renal and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23316297") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41406505") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23316297") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3541606/fullTextXML") Annotation(rdfs:comment "The study population was obtained from the Prevention of Renal and Vascular End-stage Disease (PREVEND) study, a Dutch cohort drawn from the general population (age range, 28 to 75 years) of the city of Groningen, the Netherlands, between 1997 and 1998.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000550> "A Dutch population-based cohort of 8,592 residents of the city of Groningen aged 28 to 75, enrolled in 1997-1998 from 40,856 respondents who sent a morning urine sample, enriched for people with urinary albumin of at least 10 mg/L plus a random control sample, and followed up to study renal and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23316297") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41406505") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35097025") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8795369/supplementaryFiles") Annotation(rdfs:comment "PREVEND is a prospective cohort study designed to investigate the impact of increased urinary albumin levels on renal and cardiovascular outcomes in the general population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000550> "A Dutch population-based cohort of 8,592 residents of the city of Groningen aged 28 to 75, enrolled in 1997-1998 from 40,856 respondents who sent a morning urine sample, enriched for people with urinary albumin of at least 10 mg/L plus a random control sample, and followed up to study renal and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23316297") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41406505") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41406505") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12902255/fullTextXML") Annotation(rdfs:comment "PREVEND is a population-based cohort with 8592 participants enrolled between 1997 and 1998.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000550> "A Dutch population-based cohort of 8,592 residents of the city of Groningen aged 28 to 75, enrolled in 1997-1998 from 40,856 respondents who sent a morning urine sample, enriched for people with urinary albumin of at least 10 mg/L plus a random control sample, and followed up to study renal and cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000551> (<http://www.ebi.ac.uk/coho/COHO_0000551>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35379992") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35379992") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9005347/fullTextXML") Annotation(rdfs:comment "A new dataset of 20,464 clinically diagnosed AD cases and 22,244 controls has been collated from 15 European countries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000551> "A European consortium bringing together the European genome-wide association consortia working on Alzheimer disease, which collated and uniformly genotyped a new dataset of clinically diagnosed Alzheimer disease cases and controls from 15 European countries and pools them with existing European cohorts for genetic studies of Alzheimer disease and related dementias.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35379992") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35379992") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9005347/fullTextXML") Annotation(rdfs:comment "Characterization of the genetic landscape of Alzheimer’s disease (AD) and related dementias (ADD) provides a unique opportunity for a better understanding of the associated pathophysiological processes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000551> "A European consortium bringing together the European genome-wide association consortia working on Alzheimer disease, which collated and uniformly genotyped a new dataset of clinically diagnosed Alzheimer disease cases and controls from 15 European countries and pools them with existing European cohorts for genetic studies of Alzheimer disease and related dementias.")
