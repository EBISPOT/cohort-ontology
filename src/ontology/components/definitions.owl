AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34581777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41194662") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34581777") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9006276/fullTextXML") Annotation(rdfs:comment "Donors registered with National Health Service Blood and Transplant (NHSBT) were invited to join the National Institute for Health Research BioResource, a cohort of volunteers who have consented to be recalled for studies by genotype.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000900> "A panel of volunteers in Cambridge, England, including blood donors registered with NHS Blood and Transplant, who have consented to be recalled for research studies by genotype or phenotype; the Cambridge centre of the NIHR BioResource, funded by the NIHR Cambridge Biomedical Research Centre and NHS Blood and Transplant.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34581777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41194662") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41194662") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12590175/fullTextXML") Annotation(rdfs:comment "The Cambridge BioResource is funded by the National Institute for Health Research (NIHR) Cambridge Biomedical Research Centre (BRC) and the NHS Blood and Transplant (NHSBT).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000900> "A panel of volunteers in Cambridge, England, including blood donors registered with NHS Blood and Transplant, who have consented to be recalled for research studies by genotype or phenotype; the Cambridge centre of the NIHR BioResource, funded by the NIHR Cambridge Biomedical Research Centre and NHS Blood and Transplant.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34581777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41194662") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.cambridgeindependent.co.uk/news/how-medical-research-is-aided-by-140-000-volunteers-in-the-nihr-bioresource-9076432/") Annotation(rdfs:comment "They give us consent to access their medical records and they agree that we can get in touch with them based on any information we hold about research studies that investigators are interested in performing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000900> "A panel of volunteers in Cambridge, England, including blood donors registered with NHS Blood and Transplant, who have consented to be recalled for research studies by genotype or phenotype; the Cambridge centre of the NIHR BioResource, funded by the NIHR Cambridge Biomedical Research Centre and NHS Blood and Transplant.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34581777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41194662") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.cambridgeindependent.co.uk/news/how-medical-research-is-aided-by-140-000-volunteers-in-the-nihr-bioresource-9076432/") Annotation(rdfs:comment "which has recruited more than 17,500 volunteers who live, work or study in the region since its inception in 2005.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000900> "A panel of volunteers in Cambridge, England, including blood donors registered with NHS Blood and Transplant, who have consented to be recalled for research studies by genotype or phenotype; the Cambridge centre of the NIHR BioResource, funded by the NIHR Cambridge Biomedical Research Centre and NHS Blood and Transplant.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000901> (<http://www.ebi.ac.uk/coho/COHO_0000901>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17466083") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41266372") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17466083") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1868919/fullTextXML") Annotation(rdfs:comment "CIMBA contains about 30 affiliated groups who together have collected DNA and clinical data from approximately 10,000 BRCA1 and 5,000 BRCA2 mutation carriers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000901> "An international consortium of research groups that collect DNA and clinical data from carriers of BRCA1 and BRCA2 mutations, established to identify genetic modifiers of breast and ovarian cancer risk in mutation carriers; it began with about 30 affiliated groups and later brought together more than 60 studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17466083") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41266372") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17466083") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1868919/fullTextXML") Annotation(rdfs:comment "Initial efforts by CIMBA to identify modifiers of breast cancer risk for BRCA1 and BRCA2 mutation carriers have focused on validation of common genetic variants previously associated with risk in smaller studies of carriers or unselected breast cancers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000901> "An international consortium of research groups that collect DNA and clinical data from carriers of BRCA1 and BRCA2 mutations, established to identify genetic modifiers of breast and ovarian cancer risk in mutation carriers; it began with about 30 affiliated groups and later brought together more than 60 studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17466083") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41266372") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17466083") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1868919/fullTextXML") Annotation(rdfs:comment "There are currently about 30 groups from North America, Europe and Australia who plan to contribute to some or all of the collaborative CIMBA projects, and collectively they have DNA and minimum required clinical and epidemiological data from more than 10,000 BRCA1 and 5,000 BRCA2 carriers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000901> "An international consortium of research groups that collect DNA and clinical data from carriers of BRCA1 and BRCA2 mutations, established to identify genetic modifiers of breast and ovarian cancer risk in mutation carriers; it began with about 30 affiliated groups and later brought together more than 60 studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17466083") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41266372") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41266372") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12635163/fullTextXML") Annotation(rdfs:comment "CIMBA study participants were enrolled in 64 studies from 28 countries (Supplementary Table 2).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000901> "An international consortium of research groups that collect DNA and clinical data from carriers of BRCA1 and BRCA2 mutations, established to identify genetic modifiers of breast and ovarian cancer risk in mutation carriers; it began with about 30 affiliated groups and later brought together more than 60 studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17466083") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41266372") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41266372") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12635163/fullTextXML") Annotation(rdfs:comment "We meta-analyzed >22 million variants for 398,238 women from the Ovarian Cancer Association Consortium (OCAC), UK Biobank (UKBB) and Consortium of Investigators of Modifiers of BRCA1/BRCA2 (CIMBA) to identify novel HGSOC susceptibility loci.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000901> "An international consortium of research groups that collect DNA and clinical data from carriers of BRCA1 and BRCA2 mutations, established to identify genetic modifiers of breast and ovarian cancer risk in mutation carriers; it began with about 30 affiliated groups and later brought together more than 60 studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000902> (<http://www.ebi.ac.uk/coho/COHO_0000902>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33863885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33863885") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8052448/fullTextXML") Annotation(rdfs:comment "Here, we report an integrative multi-omics analysis of NMIBC tumors from a total of 834 patients included in the UROMOL project.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000902> "A European multicentre prospective study of patients with non-muscle-invasive bladder cancer, with tumour multi-omics and germline genotype data and clinical follow-up for recurrence and progression, used to define molecular subtypes of the disease and in genetic studies of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33863885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33863885") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8052448/fullTextXML") Annotation(rdfs:comment "Patients were enrolled in the UROMOL project, a European multicenter prospective study of NMIBC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000902> "A European multicentre prospective study of patients with non-muscle-invasive bladder cancer, with tumour multi-omics and germline genotype data and clinical follow-up for recurrence and progression, used to define molecular subtypes of the disease and in genetic studies of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33863885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33863885") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8052448/fullTextXML") Annotation(rdfs:comment "To investigate the genomic heterogeneity of NMIBC further, a total of 473 tumor–leukocyte pairs were analyzed using Illumina SNP arrays.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000902> "A European multicentre prospective study of patients with non-muscle-invasive bladder cancer, with tumour multi-omics and germline genotype data and clinical follow-up for recurrence and progression, used to define molecular subtypes of the disease and in genetic studies of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33863885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33863885") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8052448/fullTextXML") Annotation(rdfs:comment "We have now performed an integrated multi-omics analysis and have expanded the work to a larger NMIBC patient series with updated follow-up that is essential to acquire insight into the implications for patient management.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000902> "A European multicentre prospective study of patients with non-muscle-invasive bladder cancer, with tumour multi-omics and germline genotype data and clinical follow-up for recurrence and progression, used to define molecular subtypes of the disease and in genetic studies of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33863885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37210288") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC10330197/") Annotation(rdfs:comment "Two studies (CNIO/UROMOL and deCODE) provided summary-level results after imputation (Supplementary material).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000902> "A European multicentre prospective study of patients with non-muscle-invasive bladder cancer, with tumour multi-omics and germline genotype data and clinical follow-up for recurrence and progression, used to define molecular subtypes of the disease and in genetic studies of bladder cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33863885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38994482") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11181778/fullTextXML") Annotation(rdfs:comment "In data from UROMOL, we observed that CCND1 tumour expression differed in the four transcriptomic classes described in the UROMOL study (Fig. 3) [9], which were prognostic for RFS and progression-free survival in NMIBC: patients with primary tumours in transcriptomic classes 1 and 3 had low recurrence- and progression rates compared to patients in classes 2a and 2b.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000902> "A European multicentre prospective study of patients with non-muscle-invasive bladder cancer, with tumour multi-omics and germline genotype data and clinical follow-up for recurrence and progression, used to define molecular subtypes of the disease and in genetic studies of bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000903> (<http://www.ebi.ac.uk/coho/COHO_0000903>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25001365") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25400699") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25001365") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://link.springer.com/article/10.1186/s12933-014-0107-x") Annotation(rdfs:comment "In addition, we found significant interaction between hypertension status and NC level in relation to cfPWV, adjusted for age, sex, BMI, fasting glucose, lipids and heart rate(P for interaction = 0.034).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000903> "A community-based health examination survey cohort of 6,431 adults aged 18–93 years randomly selected in 2009 from residents of the urban area of Xuzhou, Jiangsu, China, by Xuzhou Central Hospital, to study cardiometabolic risk factors such as insulin resistance, prediabetes, hypertension and early atherosclerosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25001365") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25400699") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25001365") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4100564/fullTextXML") Annotation(rdfs:comment "In the cardiometabolic risk in Chinese (CRC) study, we performed a community-based health examination survey for 6,431 individuals (18-93y) who were randomly selected from residents living in the urban area of Xuzhou, China, in 2009.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000903> "A community-based health examination survey cohort of 6,431 adults aged 18–93 years randomly selected in 2009 from residents of the urban area of Xuzhou, Jiangsu, China, by Xuzhou Central Hospital, to study cardiometabolic risk factors such as insulin resistance, prediabetes, hypertension and early atherosclerosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25001365") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25400699") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25001365") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4100564/fullTextXML") Annotation(rdfs:comment "In this study we examined the association between NC and early stage atherosclerosis in Chinese adults.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000903> "A community-based health examination survey cohort of 6,431 adults aged 18–93 years randomly selected in 2009 from residents of the urban area of Xuzhou, Jiangsu, China, by Xuzhou Central Hospital, to study cardiometabolic risk factors such as insulin resistance, prediabetes, hypertension and early atherosclerosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25001365") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25400699") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25400699") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4232709/fullTextXML") Annotation(rdfs:comment "In the present study, we comprehensively analyzed the associations of NC and other metabolic risk factors, and their interactions in relation to insulin resistance in a large cohort of apparently healthy Chinese adults.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000903> "A community-based health examination survey cohort of 6,431 adults aged 18–93 years randomly selected in 2009 from residents of the urban area of Xuzhou, Jiangsu, China, by Xuzhou Central Hospital, to study cardiometabolic risk factors such as insulin resistance, prediabetes, hypertension and early atherosclerosis.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25001365") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25400699") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25400699") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4232709/fullTextXML") Annotation(rdfs:comment "The CRC study was reviewed and approved by the ethics committee of the Central Hospital of Xuzhou, China and sponsored by Jiangsu Health International Exchange Program.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000903> "A community-based health examination survey cohort of 6,431 adults aged 18–93 years randomly selected in 2009 from residents of the urban area of Xuzhou, Jiangsu, China, by Xuzhou Central Hospital, to study cardiometabolic risk factors such as insulin resistance, prediabetes, hypertension and early atherosclerosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000904> (<http://www.ebi.ac.uk/coho/COHO_0000904>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35393395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35393395") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41398-022-01884-3/MediaObjects/41398_2022_1884_MOESM1_ESM.docx") Annotation(rdfs:comment "Schizophrenia patients were recruited from inpatient and outpatient clinics around Melbourne, Australia.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000904> "A cohort of clozapine-treated patients with schizophrenia recruited by the Cooperative Research Centre from inpatient and outpatient clinics around Melbourne, Australia, with symptom severity (PANSS) assessments, contributing to genetic studies of clozapine treatment outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35393395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35393395") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8989876/fullTextXML") Annotation(rdfs:comment "CGI-S scores were available for participants from CLOZIN, Hacettepe University, and Mental Health Services Rivierduinen, and PANSS scores for participants from GROUP and CRC Australia.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000904> "A cohort of clozapine-treated patients with schizophrenia recruited by the Cooperative Research Centre from inpatient and outpatient clinics around Melbourne, Australia, with symptom severity (PANSS) assessments, contributing to genetic studies of clozapine treatment outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35393395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35393395") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8989876/fullTextXML") Annotation(rdfs:comment "Participants were included if they: (1) were aged 18 years or older, (2) had a primary diagnosis of schizophrenia spectrum disorder (SSD), and (3) were using clozapine (no minimum duration of treatment).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000904> "A cohort of clozapine-treated patients with schizophrenia recruited by the Cooperative Research Centre from inpatient and outpatient clinics around Melbourne, Australia, with symptom severity (PANSS) assessments, contributing to genetic studies of clozapine treatment outcome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35393395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35393395") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8989876/fullTextXML") Annotation(rdfs:comment "The aims of the study were to analyze the amount of variance in symptom severity among clozapine-treated patients explained by PRSs, to examine the association between symptom severity and genotype-predicted CYP1A2, CYP2D6, and CYP2C19 enzyme activity, and explore loci associated with symptom severity using GWA analyses.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000904> "A cohort of clozapine-treated patients with schizophrenia recruited by the Cooperative Research Centre from inpatient and outpatient clinics around Melbourne, Australia, with symptom severity (PANSS) assessments, contributing to genetic studies of clozapine treatment outcome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000905> (<http://www.ebi.ac.uk/coho/COHO_0000905>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32193507") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32193507") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7081241/fullTextXML") Annotation(rdfs:comment "The CREAM discovery cohorts included 29,580 individuals with European ancestry from 18 studies, and 14,462 individuals with Asian ancestry from 10 studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000905> "An international consortium of cohorts of European and Asian ancestry that pools cohort-level genome-wide association results to study refractive error, myopia and ocular biometric traits such as axial length and corneal curvature.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32193507") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32193507") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7081241/fullTextXML") Annotation(rdfs:comment "The RSPO1 gene was previously identified as the strongest locus with the same lead SNP rs4074961 associated with AL in CREAM16.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000905> "An international consortium of cohorts of European and Asian ancestry that pools cohort-level genome-wide association results to study refractive error, myopia and ocular biometric traits such as axial length and corneal curvature.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32193507") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32193507") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7081241/fullTextXML") Annotation(rdfs:comment "Thus, we conducted the largest GWAS meta-analysis of CC to date, incorporating both European and Asian cohorts in a single analysis from the Consortium for Refractive Error and Myopia (CREAM) and validated our findings in the United Kingdom (UK) Biobank.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000905> "An international consortium of cohorts of European and Asian ancestry that pools cohort-level genome-wide association results to study refractive error, myopia and ocular biometric traits such as axial length and corneal curvature.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32193507") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32193507") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7081241/fullTextXML") Annotation(rdfs:comment "We applied a uniform set of quality-control procedures to all cohort-level GWAS results in CREAM and meta-analysed up to 8.94 million variants (see Methods).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000905> "An international consortium of cohorts of European and Asian ancestry that pools cohort-level genome-wide association results to study refractive error, myopia and ocular biometric traits such as axial length and corneal curvature.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32193507") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4551475/fullTextXML") Annotation(rdfs:comment "SNPs within 100 kb of the APLP2 gene were also evaluated in a meta-analyzed refractive error genome-wide association study (GWAS) dataset from the international Consortium for Refractive Error and Myopia (CREAM), which included 45,756 adult individuals from 27 Caucasian and 5 Asian cohorts [30].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000905> "An international consortium of cohorts of European and Asian ancestry that pools cohort-level genome-wide association results to study refractive error, myopia and ocular biometric traits such as axial length and corneal curvature.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32193507") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9810640/fullTextXML") Annotation(rdfs:comment "We also plan further analysis with the conversion of our quantitative refractive error phenotype to binary phenotypes to test for association with myopia, hyperopia, and astigmatism.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000905> "An international consortium of cohorts of European and Asian ancestry that pools cohort-level genome-wide association results to study refractive error, myopia and ocular biometric traits such as axial length and corneal curvature.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000906> (<http://www.ebi.ac.uk/coho/COHO_0000906>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29040549") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML") Annotation(rdfs:comment "In 1987 it started with an age-sex-stratified sample (20–59 years) of the inhabitants of Doetinchem, a mid-size Dutch town, of whom 12 404 (62%) participated in the baseline examination between 1987 and 1991.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000906> "A population-based cohort study in Doetinchem, the Netherlands, started by the Dutch National Institute for Public Health and the Environment (RIVM) as a monitoring study of cardiovascular risk factors, in which 12,404 inhabitants aged 20–59, drawn as an age- and sex-stratified sample of the population register, were examined in 1987–1991 and two-thirds of them were re-invited to repeated rounds, to study lifestyle and other determinants of health, functioning and chronic disease over the life course.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://molgeniscatalogue.org/Global%20Exposome%20Cohorts/collections/DCS") Annotation(rdfs:comment "Lead organisationsNational Institute for Public Health and the Environment (RIVM) Netherlands (the)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000906> "A population-based cohort study in Doetinchem, the Netherlands, started by the Dutch National Institute for Public Health and the Environment (RIVM) as a monitoring study of cardiovascular risk factors, in which 12,404 inhabitants aged 20–59, drawn as an age- and sex-stratified sample of the population register, were examined in 1987–1991 and two-thirds of them were re-invited to repeated rounds, to study lifestyle and other determinants of health, functioning and chronic disease over the life course.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML") Annotation(rdfs:comment "Originating from a monitoring study on cardiovascular disease risk factors, the Doetinchem Cohort Study has been expanded to a long-running study on lifestyle and other determinants of health, functioning, and disease over the life course.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000906> "A population-based cohort study in Doetinchem, the Netherlands, started by the Dutch National Institute for Public Health and the Environment (RIVM) as a monitoring study of cardiovascular risk factors, in which 12,404 inhabitants aged 20–59, drawn as an age- and sex-stratified sample of the population register, were examined in 1987–1991 and two-thirds of them were re-invited to repeated rounds, to study lifestyle and other determinants of health, functioning and chronic disease over the life course.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML") Annotation(rdfs:comment "The Doetinchem Cohort Study (DCS) was started as a monitoring study on cardiovascular health in 1987–91 based on an age–sex stratified sample of the population register of inhabitants of Doetinchem, with equal numbers of men and women and equal numbers in 10-year age categories: 20–29, 30–39, 40–49, and 50–59 years, n = 12 404.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000906> "A population-based cohort study in Doetinchem, the Netherlands, started by the Dutch National Institute for Public Health and the Environment (RIVM) as a monitoring study of cardiovascular risk factors, in which 12,404 inhabitants aged 20–59, drawn as an age- and sex-stratified sample of the population register, were examined in 1987–1991 and two-thirds of them were re-invited to repeated rounds, to study lifestyle and other determinants of health, functioning and chronic disease over the life course.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML") Annotation(rdfs:comment "The cohort was established by re-inviting a two-thirds sample (n = 7768) of those who were measured during Wave 1 for a second measurement in 1993–7, followed by a third in 1998–2002 [1], a fourth in 2003–7, a fifth in 2008–12, and a sixth in 2013–17 [2], including 3438 participants (Fig. 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000906> "A population-based cohort study in Doetinchem, the Netherlands, started by the Dutch National Institute for Public Health and the Environment (RIVM) as a monitoring study of cardiovascular risk factors, in which 12,404 inhabitants aged 20–59, drawn as an age- and sex-stratified sample of the population register, were examined in 1987–1991 and two-thirds of them were re-invited to repeated rounds, to study lifestyle and other determinants of health, functioning and chronic disease over the life course.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000907> (<http://www.ebi.ac.uk/coho/COHO_0000907>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34834492") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34834492") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8625344/fullTextXML") Annotation(rdfs:comment "GALA II and SAGE are two clinic-based case-control studies focused on untangling the genetic and environmental basis of childhood-onset asthma disease in minority ethnic groups of the United States of America [22].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000907> "A clinic-based case-control study of self-identified Latino children and young adults aged 8–22 years with and without asthma, recruited at centres in the mainland United States and Puerto Rico under the University of California, San Francisco, to study the genetic and environmental basis of childhood-onset asthma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34834492") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34834492") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8625344/fullTextXML") Annotation(rdfs:comment "Inclusion criteria were self-identification as Latino or African American for GALA II or SAGE, respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000907> "A clinic-based case-control study of self-identified Latino children and young adults aged 8–22 years with and without asthma, recruited at centres in the mainland United States and Puerto Rico under the University of California, San Francisco, to study the genetic and environmental basis of childhood-onset asthma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34834492") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34834492") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8625344/fullTextXML") Annotation(rdfs:comment "Recruitment was performed in different centers throughout mainland United States and Puerto Rico for GALA II subjects, while SAGE participants were recruited in the San Francisco Bay Area.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000907> "A clinic-based case-control study of self-identified Latino children and young adults aged 8–22 years with and without asthma, recruited at centres in the mainland United States and Puerto Rico under the University of California, San Francisco, to study the genetic and environmental basis of childhood-onset asthma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34834492") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34834492") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8625344/fullTextXML") Annotation(rdfs:comment "The University of California, San Francisco (UCSF) and each study site’s institutional review board (IRB) approved the SAGE II/GALA II protocols (SAGE II UCSF-IRB No. 10-02877; GALA II UCSF-IRB No. 10-00889).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000907> "A clinic-based case-control study of self-identified Latino children and young adults aged 8–22 years with and without asthma, recruited at centres in the mainland United States and Puerto Rico under the University of California, San Francisco, to study the genetic and environmental basis of childhood-onset asthma.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34834492") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34834492") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8625344/fullTextXML") Annotation(rdfs:comment "The proportion of males was higher among cases compared to controls in both studies, concordant with the age range of the recruited population (8–22 years old).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000907> "A clinic-based case-control study of self-identified Latino children and young adults aged 8–22 years with and without asthma, recruited at centres in the mainland United States and Puerto Rico under the University of California, San Francisco, to study the genetic and environmental basis of childhood-onset asthma.")

