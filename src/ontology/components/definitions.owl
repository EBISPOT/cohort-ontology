AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18431743") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19065661") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3108163/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19065661") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC4203374/") Annotation(rdfs:comment "We have conducted a population-based case-control study of ovarian cancer in Los Angeles County to further investigate the role of inflammation in the risk of ovarian cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001988> "Population-based case-control studies of ovarian cancer among women resident in Los Angeles County, California, United States, run at the Keck School of Medicine of the University of Southern California, in which cases with newly diagnosed ovarian cancer were identified through the county's SEER cancer registry (the Cancer Surveillance Program) and controls were recruited from the cases' neighbourhoods and matched on race/ethnicity and age; the studies take part in the Ovarian Cancer Association Consortium under the code USC.")
