AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:10829038") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19011631") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19920828") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20501757") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24146633") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:10829038") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A10829038+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We studied how HNPCC identification should be carried out on a large scale in a sensitive and efficient manner.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001719> "A population-based series of colorectal cancer patients, run from the University of Helsinki, in which tumour and normal tissue were collected from consecutive newly diagnosed patients at nine central hospitals in south-eastern Finland in 1994–1998, and afterwards at two of them, to find hereditary nonpolyposis colorectal cancer and other inherited predisposition to colorectal cancer; its genetic association studies compared the patients with Finnish blood donors from the same region.")
