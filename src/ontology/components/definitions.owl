AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23160641") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1007%2Fs00125-012-2756-1/MediaObjects/125_2012_2756_MOESM2_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23160641") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1007%2Fs00125-012-2756-1/MediaObjects/125_2012_2756_MOESM2_ESM.pdf") Annotation(rdfs:comment "A sample of clinical-onset type 2 diabetes patients and non-diabetic control individuals were ascertained at the outpatient clinic at Steno Diabetes Center, Copenhagen.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001232> "A sample of patients with clinical-onset type 2 diabetes and of non-diabetic control individuals (screened by oral glucose tolerance test) ascertained at the outpatient clinic of Steno Diabetes Center in Copenhagen, Denmark, used in genetic association studies of type 2 diabetes and metabolic traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23160641") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1007%2Fs00125-012-2756-1/MediaObjects/125_2012_2756_MOESM2_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23160641") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1007%2Fs00125-012-2756-1/MediaObjects/125_2012_2756_MOESM2_ESM.pdf") Annotation(rdfs:comment "An OGTT was performed in all control individuals to exclude individuals with unknown diabetes or states of prediabetes according to WHO 1999 criteria [5].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001232> "A sample of patients with clinical-onset type 2 diabetes and of non-diabetic control individuals (screened by oral glucose tolerance test) ascertained at the outpatient clinic of Steno Diabetes Center in Copenhagen, Denmark, used in genetic association studies of type 2 diabetes and metabolic traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23160641") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://static-content.springer.com/esm/art%3A10.1007%2Fs00125-012-2756-1/MediaObjects/125_2012_2756_MOESM2_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23160641") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://static-content.springer.com/esm/art%3A10.1007%2Fs00125-012-2756-1/MediaObjects/125_2012_2756_MOESM2_ESM.pdf") Annotation(rdfs:comment "The analysis included 14,819 individuals sampled from Inter99 (n=5,845), Page | 5 Health2006 (n=2,899), ADDITION (n=3,705), Steno Diabetes Center (n=1,404) and Vejle Biobank (n=966).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001232> "A sample of patients with clinical-onset type 2 diabetes and of non-diabetic control individuals (screened by oral glucose tolerance test) ascertained at the outpatient clinic of Steno Diabetes Center in Copenhagen, Denmark, used in genetic association studies of type 2 diabetes and metabolic traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001233> (<http://www.ebi.ac.uk/coho/COHO_0001233>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28338705") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42274395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28338705") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC5582633") Annotation(rdfs:comment "We aimed to recruit a representative sample of all adults aged 16 years and older with a clinical diagnosis of T1DM or with monogenic diabetes (i.e. MODY) or with a diagnosis of latent auto-immune disease of adulthood.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001233> "A cohort of adults aged 16 or older with a clinical diagnosis of type 1 diabetes, latent autoimmune diabetes of adulthood or monogenic diabetes, recruited mainly at diabetes outpatient clinics across Scotland between December 2010 and November 2013, whose biosamples were banked and genotyped and who are followed through linkage to national electronic health records, set up to study the genetic determinants, biomarkers and complications of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28338705") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42274395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28338705") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5582633/") Annotation(rdfs:comment "Baseline data collection took place between 1 December 2010 and 29 November 2013 inclusive, and comprised a single study visit of approximately 30 minutes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001233> "A cohort of adults aged 16 or older with a clinical diagnosis of type 1 diabetes, latent autoimmune diabetes of adulthood or monogenic diabetes, recruited mainly at diabetes outpatient clinics across Scotland between December 2010 and November 2013, whose biosamples were banked and genotyped and who are followed through linkage to national electronic health records, set up to study the genetic determinants, biomarkers and complications of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28338705") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42274395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28338705") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5582633/") Annotation(rdfs:comment "Recruitment was primarily undertaken at diabetes outpatient clinics with some additional recruitment in renal units since end stage renal disease patients have lower attendance at diabetes clinics.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001233> "A cohort of adults aged 16 or older with a clinical diagnosis of type 1 diabetes, latent autoimmune diabetes of adulthood or monogenic diabetes, recruited mainly at diabetes outpatient clinics across Scotland between December 2010 and November 2013, whose biosamples were banked and genotyped and who are followed through linkage to national electronic health records, set up to study the genetic determinants, biomarkers and complications of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28338705") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42274395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28338705") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5582633/") Annotation(rdfs:comment "Thus the GWAS data from the SDRNT1BIO will augment existing international efforts to understand the genetics of macro- and micro-vascular complications of diabetes and will provide novel GWAS studies of neglected traits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001233> "A cohort of adults aged 16 or older with a clinical diagnosis of type 1 diabetes, latent autoimmune diabetes of adulthood or monogenic diabetes, recruited mainly at diabetes outpatient clinics across Scotland between December 2010 and November 2013, whose biosamples were banked and genotyped and who are followed through linkage to national electronic health records, set up to study the genetic determinants, biomarkers and complications of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28338705") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42274395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28338705") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC5582633/") Annotation(rdfs:comment "To date biosamples have been used for DNA extraction and genome wide genotyping.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001233> "A cohort of adults aged 16 or older with a clinical diagnosis of type 1 diabetes, latent autoimmune diabetes of adulthood or monogenic diabetes, recruited mainly at diabetes outpatient clinics across Scotland between December 2010 and November 2013, whose biosamples were banked and genotyped and who are followed through linkage to national electronic health records, set up to study the genetic determinants, biomarkers and complications of type 1 diabetes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28338705") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42274395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42274395") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13385944/fullTextXML") Annotation(rdfs:comment "The Scottish Diabetes Research Network Type 1 Bioresource (SDRNT1BIO) is a large prospective cohort study in Scotland that comprehensively captures biomaterials and clinical data through linkage with participants’ electronic health care records (9).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001233> "A cohort of adults aged 16 or older with a clinical diagnosis of type 1 diabetes, latent autoimmune diabetes of adulthood or monogenic diabetes, recruited mainly at diabetes outpatient clinics across Scotland between December 2010 and November 2013, whose biosamples were banked and genotyped and who are followed through linkage to national electronic health records, set up to study the genetic determinants, biomarkers and complications of type 1 diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001234> (<http://www.ebi.ac.uk/coho/COHO_0001234>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20729852") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21846596") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28680059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21846596") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3215853/") Annotation(rdfs:comment "All subjects signed informed consents and all study interviews were conducted by trained study nurses using a standardized, interviewer-administered questionnaire.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001234> "A case-control study of upper gastrointestinal cancers conducted from 1997 to 2007 by the Shanxi Cancer Hospital and Institute under contract with the US National Cancer Institute in Shanxi Province, China, in the high-risk western Taihang Mountain area, which enrolled adults newly diagnosed with oesophageal squamous cell carcinoma or gastric adenocarcinoma and treated surgically at the Shanxi Cancer Hospital, with neighbourhood controls matched on age and sex, plus a case-only component, and collected questionnaire data and blood to study genetic and environmental risk factors for these cancers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20729852") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21846596") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28680059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21846596") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3215853/") Annotation(rdfs:comment "One control was recruited for each case matched on age (± 5 years), gender, and neighborhood of residence.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001234> "A case-control study of upper gastrointestinal cancers conducted from 1997 to 2007 by the Shanxi Cancer Hospital and Institute under contract with the US National Cancer Institute in Shanxi Province, China, in the high-risk western Taihang Mountain area, which enrolled adults newly diagnosed with oesophageal squamous cell carcinoma or gastric adenocarcinoma and treated surgically at the Shanxi Cancer Hospital, with neighbourhood controls matched on age and sex, plus a case-only component, and collected questionnaire data and blood to study genetic and environmental risk factors for these cancers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20729852") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21846596") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28680059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28680059") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5498542/fullTextXML") Annotation(rdfs:comment "Newly-diagnosed, histologically-confirmed ESCC and gastric cancer cases were identified and blood samples collected at enrollment for all cases7.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001234> "A case-control study of upper gastrointestinal cancers conducted from 1997 to 2007 by the Shanxi Cancer Hospital and Institute under contract with the US National Cancer Institute in Shanxi Province, China, in the high-risk western Taihang Mountain area, which enrolled adults newly diagnosed with oesophageal squamous cell carcinoma or gastric adenocarcinoma and treated surgically at the Shanxi Cancer Hospital, with neighbourhood controls matched on age and sex, plus a case-only component, and collected questionnaire data and blood to study genetic and environmental risk factors for these cancers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20729852") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21846596") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28680059") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34022824") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28680059") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5498542/fullTextXML") Annotation(rdfs:comment "Participants for the NCI GWAS were drawn from the Shanxi UGI Cancer Genetics Project with participants residing in the western Taihang Mountain area; and the Nutrition Intervention Trials (NITs), with participants from the southern Taihang Mountain area.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001234> "A case-control study of upper gastrointestinal cancers conducted from 1997 to 2007 by the Shanxi Cancer Hospital and Institute under contract with the US National Cancer Institute in Shanxi Province, China, in the high-risk western Taihang Mountain area, which enrolled adults newly diagnosed with oesophageal squamous cell carcinoma or gastric adenocarcinoma and treated surgically at the Shanxi Cancer Hospital, with neighbourhood controls matched on age and sex, plus a case-only component, and collected questionnaire data and blood to study genetic and environmental risk factors for these cancers.")
