AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004364") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35264738") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9091267/fullTextXML") Annotation(rdfs:comment "Patients with cancer or selected rare and inherited diseases, and parents and relatives of these patients were enrolled in the 100kGPbetween 2015 and 2018") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000206> "A cohort of National Health Service patients with rare diseases or cancer, and their relatives, whose genomes were sequenced by Genomics England within the United Kingdom's national healthcare system to provide diagnoses and discover aetiological variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004364") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001004364") Annotation(rdfs:comment "We implemented whole-genome sequencing (WGS) in a national healthcare system to streamline diagnosis and to discover unknown aetiological variants, in the coding and non-coding regions of the genome.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000206> "A cohort of National Health Service patients with rare diseases or cancer, and their relatives, whose genomes were sequenced by Genomics England within the United Kingdom's national healthcare system to provide diagnoses and discover aetiological variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004364") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.genomicsengland.co.uk/initiatives/100000-genomes-project") Annotation(rdfs:comment "Genomics England's very first initiative – sequencing 100,000 genomes from around 85,000 NHS patients affected by rare disease or cancer – is leading to groundbreaking insights") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000206> "A cohort of National Health Service patients with rare diseases or cancer, and their relatives, whose genomes were sequenced by Genomics England within the United Kingdom's national healthcare system to provide diagnoses and discover aetiological variants.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001004364") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.genomicsengland.co.uk/initiatives/100000-genomes-project") Annotation(rdfs:comment "Genomics England, a company wholly owned and funded by the Department of Health & Social Care, was set up to deliver this flagship project and sequence 100,000 whole genomes from NHS patients, something that at the time no one in the world had even attempted.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000206> "A cohort of National Health Service patients with rare diseases or cancer, and their relatives, whose genomes were sequenced by Genomics England within the United Kingdom's national healthcare system to provide diagnoses and discover aetiological variants.")

