AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16931544") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21602798") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21637779") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21602798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.839/MediaObjects/41588_2011_BFng839_MOESM33_ESM.pdf") Annotation(rdfs:comment "Controls were men without a prostate cancer diagnosis who underwent standard annual medical examinations at the collaborating medical institutions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001564> "A case–control study of more aggressive prostate cancer in men recruited from 2001 to 2004 at the major medical institutions of Cleveland, Ohio, United States (the Cleveland Clinic, University Hospitals of Cleveland and their affiliates), in which cases were newly diagnosed, histologically confirmed prostate cancers of higher grade, stage or prostate-specific antigen level, and age-matched controls were men without prostate cancer undergoing standard annual medical examinations at the same institutions, to study genetic and environmental risk factors for aggressive prostate cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16931544") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21602798") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21637779") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21602798") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.839/MediaObjects/41588_2011_BFng839_MOESM33_ESM.pdf") Annotation(rdfs:comment "Prostate Cancer Genetics Study (CaP Genes): The African American component of this study population comprised 160 men: 75 cases diagnosed with more aggressive prostate cancer and 85 age-matched controls12 .") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001564> "A case–control study of more aggressive prostate cancer in men recruited from 2001 to 2004 at the major medical institutions of Cleveland, Ohio, United States (the Cleveland Clinic, University Hospitals of Cleveland and their affiliates), in which cases were newly diagnosed, histologically confirmed prostate cancers of higher grade, stage or prostate-specific antigen level, and age-matched controls were men without prostate cancer undergoing standard annual medical examinations at the same institutions, to study genetic and environmental risk factors for aggressive prostate cancer.")
