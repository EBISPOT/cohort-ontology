AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33067605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42097137") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.scallop-consortium.com/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42097137") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13343581/fullTextXML") Annotation(rdfs:comment "For the 37 cohorts included in this study, antibody-based proteomic measurements were generated through at least one of the 13 Target-96 panels offered by Olink measuring 92 protein targets") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000398> "A consortium of principal investigators of cohort studies from the general population, clinical trials and disease-specific patient collections that have Olink proteomics and genome-wide genotyping data, combining summary-level data to discover and follow up genetic associations with plasma protein levels (pQTLs) and identify causal protein biomarkers of disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33067605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42097137") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.scallop-consortium.com/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.scallop-consortium.com/") Annotation(rdfs:comment "Each SCALLOP member works on human study collections from the general population, clinical trials or patients with certain diseases such as coronary artery disease, rheumatoid arthritis, bipolar disease, heart failure, dementias or metabolic syndrome.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000398> "A consortium of principal investigators of cohort studies from the general population, clinical trials and disease-specific patient collections that have Olink proteomics and genome-wide genotyping data, combining summary-level data to discover and follow up genetic associations with plasma protein levels (pQTLs) and identify causal protein biomarkers of disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33067605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42097137") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.scallop-consortium.com/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.scallop-consortium.com/") Annotation(rdfs:comment "The SCALLOP consortium (Systematic and Combined AnaLysis of Olink Proteins) is a collaborative framework for discovery and follow-up of genetic associations with proteins on the Olink Proteomics platform.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000398> "A consortium of principal investigators of cohort studies from the general population, clinical trials and disease-specific patient collections that have Olink proteomics and genome-wide genotyping data, combining summary-level data to discover and follow up genetic associations with plasma protein levels (pQTLs) and identify causal protein biomarkers of disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33067605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42097137") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.scallop-consortium.com/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.scallop-consortium.com/") Annotation(rdfs:comment "The aim of the SCALLOP consortium is to identify novel molecular connections and protein biomarkers that are causal in diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000398> "A consortium of principal investigators of cohort studies from the general population, clinical trials and disease-specific patient collections that have Olink proteomics and genome-wide genotyping data, combining summary-level data to discover and follow up genetic associations with plasma protein levels (pQTLs) and identify causal protein biomarkers of disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33067605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42097137") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.scallop-consortium.com/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.scallop-consortium.com/") Annotation(rdfs:comment "This work starts with identification of so called protein quantitative trait loci, pQTLs, which are robust connections between a gene variant and the levels of a protein.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000398> "A consortium of principal investigators of cohort studies from the general population, clinical trials and disease-specific patient collections that have Olink proteomics and genome-wide genotyping data, combining summary-level data to discover and follow up genetic associations with plasma protein levels (pQTLs) and identify causal protein biomarkers of disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33067605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42097137") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.scallop-consortium.com/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.scallop-consortium.com/") Annotation(rdfs:comment "To be a member of the SCALLOP consortium you have to be the PI of a study collection with Olink proteomics and genome-wide genotyping data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000398> "A consortium of principal investigators of cohort studies from the general population, clinical trials and disease-specific patient collections that have Olink proteomics and genome-wide genotyping data, combining summary-level data to discover and follow up genetic associations with plasma protein levels (pQTLs) and identify causal protein biomarkers of disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33067605") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42097137") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "http://www.scallop-consortium.com/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "http://www.scallop-consortium.com/") Annotation(rdfs:comment "To date, 35 PIs from 28 research institutions have joined the effort, which now comprises summary level data for more than 70,000 patients and controls from 45 cohort studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000398> "A consortium of principal investigators of cohort studies from the general population, clinical trials and disease-specific patient collections that have Olink proteomics and genome-wide genotyping data, combining summary-level data to discover and follow up genetic associations with plasma protein levels (pQTLs) and identify causal protein biomarkers of disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000399> (<http://www.ebi.ac.uk/coho/COHO_0000399>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36769103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40465716") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36769103") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9917812/fullTextXML") Annotation(rdfs:comment "The study participants were part of the China Medical University Hospital (CMUH) Precision Medicine Project, a systemic effort initiated in 2018 to recruit subjects and collect biospecimens from all patients who come to CMUH for medical visits [69,70].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000399> "A hospital-based cohort of patients of China Medical University Hospital, an academic medical centre in Taichung, Taiwan, and its affiliated hospitals, recruited through the hospital's Precision Medicine Project, begun in 2018 to collect biospecimens from patients attending for medical visits, from densely populated towns and districts across Taiwan, with about 413,000 participants enrolled from 2018 to 2021 genotyped on the custom Taiwan Precision Medicine (TPMv1) array and linked to their electronic medical records from 2003 to 2021 (the HiGenome resource), for genome-wide, phenome-wide and polygenic risk score studies in the Taiwanese Han population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36769103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40465716") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40465716") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12136033/fullTextXML") Annotation(rdfs:comment "As of the time of this study, a total of 413,210 patients were enrolled.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000399> "A hospital-based cohort of patients of China Medical University Hospital, an academic medical centre in Taichung, Taiwan, and its affiliated hospitals, recruited through the hospital's Precision Medicine Project, begun in 2018 to collect biospecimens from patients attending for medical visits, from densely populated towns and districts across Taiwan, with about 413,000 participants enrolled from 2018 to 2021 genotyped on the custom Taiwan Precision Medicine (TPMv1) array and linked to their electronic medical records from 2003 to 2021 (the HiGenome resource), for genome-wide, phenome-wide and polygenic risk score studies in the Taiwanese Han population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36769103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40465716") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40465716") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12136033/fullTextXML") Annotation(rdfs:comment "CMUH is an extensive academic medical center located in Taichung, Taiwan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000399> "A hospital-based cohort of patients of China Medical University Hospital, an academic medical centre in Taichung, Taiwan, and its affiliated hospitals, recruited through the hospital's Precision Medicine Project, begun in 2018 to collect biospecimens from patients attending for medical visits, from densely populated towns and districts across Taiwan, with about 413,000 participants enrolled from 2018 to 2021 genotyped on the custom Taiwan Precision Medicine (TPMv1) array and linked to their electronic medical records from 2003 to 2021 (the HiGenome resource), for genome-wide, phenome-wide and polygenic risk score studies in the Taiwanese Han population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36769103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40465716") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40465716") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12136033/fullTextXML") Annotation(rdfs:comment "In this study, patients were enrolled from highly populated towns and districts across Taiwan from 2018 to 2021 (Fig. 2A).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000399> "A hospital-based cohort of patients of China Medical University Hospital, an academic medical centre in Taichung, Taiwan, and its affiliated hospitals, recruited through the hospital's Precision Medicine Project, begun in 2018 to collect biospecimens from patients attending for medical visits, from densely populated towns and districts across Taiwan, with about 413,000 participants enrolled from 2018 to 2021 genotyped on the custom Taiwan Precision Medicine (TPMv1) array and linked to their electronic medical records from 2003 to 2021 (the HiGenome resource), for genome-wide, phenome-wide and polygenic risk score studies in the Taiwanese Han population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36769103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40465716") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40465716") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12136033/fullTextXML") Annotation(rdfs:comment "In this study, to complete the genomic database, we used the TPMv1 SNP array, which is specifically designed for the Taiwanese Han population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000399> "A hospital-based cohort of patients of China Medical University Hospital, an academic medical centre in Taichung, Taiwan, and its affiliated hospitals, recruited through the hospital's Precision Medicine Project, begun in 2018 to collect biospecimens from patients attending for medical visits, from densely populated towns and districts across Taiwan, with about 413,000 participants enrolled from 2018 to 2021 genotyped on the custom Taiwan Precision Medicine (TPMv1) array and linked to their electronic medical records from 2003 to 2021 (the HiGenome resource), for genome-wide, phenome-wide and polygenic risk score studies in the Taiwanese Han population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36769103") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40465716") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40465716") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12136033/fullTextXML") Annotation(rdfs:comment "Using a custom genotyping array, we integrated deidentified electronic medical records (2003 to 2021) with genomic data to enable GWASs, phenome-wide association studies, and polygenic risk score (PRS) analysis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000399> "A hospital-based cohort of patients of China Medical University Hospital, an academic medical centre in Taichung, Taiwan, and its affiliated hospitals, recruited through the hospital's Precision Medicine Project, begun in 2018 to collect biospecimens from patients attending for medical visits, from densely populated towns and districts across Taiwan, with about 413,000 participants enrolled from 2018 to 2021 genotyped on the custom Taiwan Precision Medicine (TPMv1) array and linked to their electronic medical records from 2003 to 2021 (the HiGenome resource), for genome-wide, phenome-wide and polygenic risk score studies in the Taiwanese Han population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000400> (<http://www.ebi.ac.uk/coho/COHO_0000400>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29865057") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29865057") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29865057+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Participants in both studies are older adults who enroll without dementia and agree to detailed longitudinal clinical evaluations and organ donation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000400> "A pair of harmonized longitudinal clinical-pathologic cohort studies of aging and Alzheimer's disease run at Rush University, the Religious Orders Study (from 1994, nuns, priests and brothers from across the United States) and the Rush Memory and Aging Project (from 1997, lay persons from northeastern Illinois), whose older participants enrol without dementia and agree to annual clinical evaluations and organ donation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29865057") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29865057") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29865057+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Religious Orders Study and Rush Memory and Aging Project are both ongoing longitudinal clinical-pathologic cohort studies of aging and Alzheimer's disease (AD).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000400> "A pair of harmonized longitudinal clinical-pathologic cohort studies of aging and Alzheimer's disease run at Rush University, the Religious Orders Study (from 1994, nuns, priests and brothers from across the United States) and the Rush Memory and Aging Project (from 1997, lay persons from northeastern Illinois), whose older participants enrol without dementia and agree to annual clinical evaluations and organ donation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29865057") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29865057") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6380522/unicode") Annotation(rdfs:comment "A large common core of data is shared by both studies allowing efficient merging of data.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000400> "A pair of harmonized longitudinal clinical-pathologic cohort studies of aging and Alzheimer's disease run at Rush University, the Religious Orders Study (from 1994, nuns, priests and brothers from across the United States) and the Rush Memory and Aging Project (from 1997, lay persons from northeastern Illinois), whose older participants enrol without dementia and agree to annual clinical evaluations and organ donation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29865057") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29865057") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6380522/unicode") Annotation(rdfs:comment "Evaluations are annual and all participants in both cohorts are organ donors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000400> "A pair of harmonized longitudinal clinical-pathologic cohort studies of aging and Alzheimer's disease run at Rush University, the Religious Orders Study (from 1994, nuns, priests and brothers from across the United States) and the Rush Memory and Aging Project (from 1997, lay persons from northeastern Illinois), whose older participants enrol without dementia and agree to annual clinical evaluations and organ donation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29865057") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29865057") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6380522/unicode") Annotation(rdfs:comment "MAP started in 1997 and enrolls lay persons from across northeastern Illinois.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000400> "A pair of harmonized longitudinal clinical-pathologic cohort studies of aging and Alzheimer's disease run at Rush University, the Religious Orders Study (from 1994, nuns, priests and brothers from across the United States) and the Rush Memory and Aging Project (from 1997, lay persons from northeastern Illinois), whose older participants enrol without dementia and agree to annual clinical evaluations and organ donation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29865057") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29865057") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6380522/unicode") Annotation(rdfs:comment "ROS started in 1994 and enrolls nuns priests and brothers from across the United States.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000400> "A pair of harmonized longitudinal clinical-pathologic cohort studies of aging and Alzheimer's disease run at Rush University, the Religious Orders Study (from 1994, nuns, priests and brothers from across the United States) and the Rush Memory and Aging Project (from 1997, lay persons from northeastern Illinois), whose older participants enrol without dementia and agree to annual clinical evaluations and organ donation.")
