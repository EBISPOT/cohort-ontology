AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24618891") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26854805") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27694991") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29906448") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24618891") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1038/ncomms4339") Annotation(rdfs:comment "under the auspices of the National Genome Research Network plus (NGFNplus)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002083> "A German research consortium, the Integrated Genome Research Network MooDS of the National Genome Research Network plus (NGFNplus), funded by the German Federal Ministry of Education and Research, whose groups collected and genotyped case-control samples for genome-wide association studies of schizophrenia in Germany and of bipolar disorder in Germany and in partner centres in Poland, Russia, Spain, Canada and Australia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24618891") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26854805") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27694991") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29906448") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29906448") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6432650/unicode") Annotation(rdfs:comment "These German samples were collected by separate groups within the MooDS Consortium in Mannheim, Bonn, Munich and Jena.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002083> "A German research consortium, the Integrated Genome Research Network MooDS of the National Genome Research Network plus (NGFNplus), funded by the German Federal Ministry of Education and Research, whose groups collected and genotyped case-control samples for genome-wide association studies of schizophrenia in Germany and of bipolar disorder in Germany and in partner centres in Poland, Russia, Spain, Canada and Australia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002085> (<http://www.ebi.ac.uk/coho/COHO_0002085>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32302785") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38564302") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32302785") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7338239/unicode") Annotation(rdfs:comment "Inclusion criteria were: 1) aged 1–2 years upon enrollment; 2) gestation of ≥36 weeks AND 3) a diagnosis of AD (based on the Hanifin and Rajka Criteria for Atopic Dermatitis), OR the parent(s)/legal authorized representative (LAR) indicates a positive response to each of the 3 questions from the Children’s Eczema Questionnaire (CEQ).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002085> "A prospective early-life cohort of children with atopic dermatitis at Cincinnati Children's Hospital Medical Center, United States, recruited from late 2016 in the greater Cincinnati area (southwest Ohio and northern Kentucky) through public advertising or medical records, which enrols infants and toddlers with atopic dermatitis (at first aged 1–2 years, later from a few months of age) and follows them for five years with annual visits and extensive biospecimen collection from skin, blood and saliva, to define atopic dermatitis phenotypes and endotypes, the mechanisms of its progression to food allergy, asthma and other allergic disorders, and biomarkers of asthma risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32302785") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38564302") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32302785") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7338239/unicode") Annotation(rdfs:comment "MPAACH is a prospective early life cohort of children with AD who will be followed for 5 years including annual visits (Fig1) with extensive biospecimen collection (Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002085> "A prospective early-life cohort of children with atopic dermatitis at Cincinnati Children's Hospital Medical Center, United States, recruited from late 2016 in the greater Cincinnati area (southwest Ohio and northern Kentucky) through public advertising or medical records, which enrols infants and toddlers with atopic dermatitis (at first aged 1–2 years, later from a few months of age) and follows them for five years with annual visits and extensive biospecimen collection from skin, blood and saliva, to define atopic dermatitis phenotypes and endotypes, the mechanisms of its progression to food allergy, asthma and other allergic disorders, and biomarkers of asthma risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32302785") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38564302") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:32302785") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC7338239/unicode") Annotation(rdfs:comment "The rigorous phenotyping and comprehensive biospecimen collections make MPAACH uniquely poised to identify endotypes that predict AD outcomes including the development of other atopic conditions (FA, asthma, and allergic rhinitis) and enable mechanistic studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002085> "A prospective early-life cohort of children with atopic dermatitis at Cincinnati Children's Hospital Medical Center, United States, recruited from late 2016 in the greater Cincinnati area (southwest Ohio and northern Kentucky) through public advertising or medical records, which enrols infants and toddlers with atopic dermatitis (at first aged 1–2 years, later from a few months of age) and follows them for five years with annual visits and extensive biospecimen collection from skin, blood and saliva, to define atopic dermatitis phenotypes and endotypes, the mechanisms of its progression to food allergy, asthma and other allergic disorders, and biomarkers of asthma risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32302785") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38564302") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38564302") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11141906/fullTextXML") Annotation(rdfs:comment "All outcomes were assessed at visit 1, when the child was enrolled into the MPAACH cohort (age 0–2 years).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002085> "A prospective early-life cohort of children with atopic dermatitis at Cincinnati Children's Hospital Medical Center, United States, recruited from late 2016 in the greater Cincinnati area (southwest Ohio and northern Kentucky) through public advertising or medical records, which enrols infants and toddlers with atopic dermatitis (at first aged 1–2 years, later from a few months of age) and follows them for five years with annual visits and extensive biospecimen collection from skin, blood and saliva, to define atopic dermatitis phenotypes and endotypes, the mechanisms of its progression to food allergy, asthma and other allergic disorders, and biomarkers of asthma risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32302785") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38564302") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38564302") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11141906/fullTextXML") Annotation(rdfs:comment "Briefly, children in the greater Cincinnati area (southwest Ohio and northern Kentucky) were identified through public advertising or the medical chart at Cincinnati Children’s Hospital Medical Center (CCHMC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002085> "A prospective early-life cohort of children with atopic dermatitis at Cincinnati Children's Hospital Medical Center, United States, recruited from late 2016 in the greater Cincinnati area (southwest Ohio and northern Kentucky) through public advertising or medical records, which enrols infants and toddlers with atopic dermatitis (at first aged 1–2 years, later from a few months of age) and follows them for five years with annual visits and extensive biospecimen collection from skin, blood and saliva, to define atopic dermatitis phenotypes and endotypes, the mechanisms of its progression to food allergy, asthma and other allergic disorders, and biomarkers of asthma risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32302785") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38564302") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38564302") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11141906/fullTextXML") Annotation(rdfs:comment "Recruitment began in December of 2016 and is ongoing.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002085> "A prospective early-life cohort of children with atopic dermatitis at Cincinnati Children's Hospital Medical Center, United States, recruited from late 2016 in the greater Cincinnati area (southwest Ohio and northern Kentucky) through public advertising or medical records, which enrols infants and toddlers with atopic dermatitis (at first aged 1–2 years, later from a few months of age) and follows them for five years with annual visits and extensive biospecimen collection from skin, blood and saliva, to define atopic dermatitis phenotypes and endotypes, the mechanisms of its progression to food allergy, asthma and other allergic disorders, and biomarkers of asthma risk.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002086> (<http://www.ebi.ac.uk/coho/COHO_0002086>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22472876") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22472876") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3837431/unicode") Annotation(rdfs:comment "Cases were required to have diagnoses of DSM-IV lifetime MDD established using structured diagnostic instruments from direct interviews by trained interviewers (two studies required recurrent MDD and one recurrent, early-onset MDD) or clinician-administered DSM-IV checklists.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002086> "A case-control sample for major depressive disorder at the Max Planck Institute of Psychiatry in Munich, Germany, whose cases were patients admitted to the institute's hospital for treatment of major depressive disorder and diagnosed by psychiatrists according to DSM-IV criteria, and whose controls were drawn at random from Munich community registries and screened for the absence of any lifetime axis I disorder; it contributed genotypes to the major depressive disorder analyses of the Psychiatric Genomics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22472876") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3112053/") Annotation(rdfs:comment "353 unipolar depressive inpatients (155 males, 198 females) were recruited for the Munich Antidepressant Response Signature (MARS) project (Hennings et al., 2009; Ising et al., 2009) at the Max Planck Institute of Psychiatry (MPIP) in Munich, Germany.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002086> "A case-control sample for major depressive disorder at the Max Planck Institute of Psychiatry in Munich, Germany, whose cases were patients admitted to the institute's hospital for treatment of major depressive disorder and diagnosed by psychiatrists according to DSM-IV criteria, and whose controls were drawn at random from Munich community registries and screened for the absence of any lifetime axis I disorder; it contributed genotypes to the major depressive disorder analyses of the Psychiatric Genomics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22472876") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3112053/") Annotation(rdfs:comment "366 control subjects were matched to the patient sample for age, gender and ethnicity from a randomly selected Munich-based community sample and underwent a strict screening-procedure for the absence of psychiatric and severe somatic disease (Heck et al., 2009).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002086> "A case-control sample for major depressive disorder at the Max Planck Institute of Psychiatry in Munich, Germany, whose cases were patients admitted to the institute's hospital for treatment of major depressive disorder and diagnosed by psychiatrists according to DSM-IV criteria, and whose controls were drawn at random from Munich community registries and screened for the absence of any lifetime axis I disorder; it contributed genotypes to the major depressive disorder analyses of the Psychiatric Genomics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22472876") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC3112053/") Annotation(rdfs:comment "Here we present results of a GWA case-control study in a stringently selected sample of MD inpatients of a tertiary clinic in Munich, Germany, and matched controls devoid of any lifetime psychiatric diagnoses (N=353/366) recruited for the Munich Antidepressant Response Signature (MARS) study (Hennings et al., 2009; Ising et al., 2009).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002086> "A case-control sample for major depressive disorder at the Max Planck Institute of Psychiatry in Munich, Germany, whose cases were patients admitted to the institute's hospital for treatment of major depressive disorder and diagnosed by psychiatrists according to DSM-IV criteria, and whose controls were drawn at random from Munich community registries and screened for the absence of any lifetime axis I disorder; it contributed genotypes to the major depressive disorder analyses of the Psychiatric Genomics Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002087> (<http://www.ebi.ac.uk/coho/COHO_0002087>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29892015") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29892015") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf") Annotation(rdfs:comment "Between 2002-2006, surviving participants were invited to a reexamination which included blood sampling13 from which DNA has been extracted.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002087> "A nested case-control study of atrial fibrillation within the Malmö Preventive Project in Malmö, Sweden, in which participants with prevalent or incident atrial fibrillation identified from national registers, with DNA from the project's 2002-2006 re-examination, were matched one to one to controls from the same cohort by sex, age and date of baseline examination.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29892015") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29892015") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf") Annotation(rdfs:comment "Subjects with prevalent or incident AF were identified from national registers as previously described14 , and cases with DNA were then matched in a 1:1 fashion to controls with DNA from the same cohort by sex, age (±1 year), and date of baseline exam (±1 year).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002087> "A nested case-control study of atrial fibrillation within the Malmö Preventive Project in Malmö, Sweden, in which participants with prevalent or incident atrial fibrillation identified from national registers, with DNA from the project's 2002-2006 re-examination, were matched one to one to controls from the same cohort by sex, age and date of baseline examination.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29892015") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29892015") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0133-9/MediaObjects/41588_2018_133_MOESM1_ESM.pdf") Annotation(rdfs:comment "The Malmö Preventive Project (MPP) was a community-based disease prevention program including 33 346 inhabitants from the city of Malmö in Southern Sweden.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002087> "A nested case-control study of atrial fibrillation within the Malmö Preventive Project in Malmö, Sweden, in which participants with prevalent or incident atrial fibrillation identified from national registers, with DNA from the project's 2002-2006 re-examination, were matched one to one to controls from the same cohort by sex, age and date of baseline examination.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002088> (<http://www.ebi.ac.uk/coho/COHO_0002088>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31860786") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31860786") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7083427/fullTextXML") Annotation(rdfs:comment "Between 2002 and 2006, a re‐examination of 18 240 surviving MPP participants, the MPP‐RES was conducted (63% men, 72% attendance rate, mean age 69 ± 6 years).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002088> "An echocardiography study within the 2002-2006 re-examination of the Malmö Preventive Project in Malmö, Sweden, in which a subsample of re-examined participants, randomly selected from groups defined by glucometabolic status with impaired fasting glucose and diabetes oversampled, underwent echocardiography.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31860786") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31860786") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7083427/fullTextXML") Annotation(rdfs:comment "In a subsample of 1792 participants, UCG recordings were carried out.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002088> "An echocardiography study within the 2002-2006 re-examination of the Malmö Preventive Project in Malmö, Sweden, in which a subsample of re-examined participants, randomly selected from groups defined by glucometabolic status with impaired fasting glucose and diabetes oversampled, underwent echocardiography.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31860786") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31860786") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7083427/fullTextXML") Annotation(rdfs:comment "Subjects with glucometabolic disturbances were oversampled to ensure sufficient numbers of subjects studied from each group.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002088> "An echocardiography study within the 2002-2006 re-examination of the Malmö Preventive Project in Malmö, Sweden, in which a subsample of re-examined participants, randomly selected from groups defined by glucometabolic status with impaired fasting glucose and diabetes oversampled, underwent echocardiography.")
