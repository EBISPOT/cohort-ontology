AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00000000022") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://europepmc.org/api/getPdf?pmcid=PMC2680141") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17952073") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2680141") Annotation(rdfs:comment "The 1500 control samples were from the British 1958 Birth Cohort (58C, also known as the National Child Development Study), which included all births in England, Wales and Scotland during one week in 1958.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000361> "The Wellcome Trust Case Control Consortium's collection of multiple sclerosis cases from the United Kingdom, analysed in a case-control association scan of nonsynonymous SNPs against controls from the 1958 British Birth Cohort.")
