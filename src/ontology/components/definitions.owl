AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29892016") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001391.v1.p1") Annotation(rdfs:comment "From ELLIPSE (linked to the PRACTICAL consortium), we contributed ~78,000 SNPs to the OncoArray.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002284> "A hospital-based, prospective, observational case-control study of prostate cancer at the Hospital Clínico Universitario de Santiago de Compostela, Galicia, Spain, whose cases are men with prostate cancer from that hospital and whose controls are cancer-free men from the same population, funded by the Spanish Ministry of Health; it is one of the PRACTICAL consortium studies genotyped in the prostate cancer OncoArray project.")
