AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27807919") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27870550") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29069385") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33574239") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27870550") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27870550+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A cross-sectional, population-based study that included 660 AAD patients from the Swedish Addison Registry (2008-2014).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002342> "A nationwide multicentre research registry of patients with autoimmune Addison's disease in Sweden, with enrolment from 2008, whose patients are clinically and immunologically characterised and give samples for clinical, immunological and genetic studies of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27807919") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27870550") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29069385") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33574239") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29069385") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29069385+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We systematically screened 677 patients with Addison disease enrolled in the Swedish Addison Registry for autoantibodies against interleukin-22 and interferon-α4.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002342> "A nationwide multicentre research registry of patients with autoimmune Addison's disease in Sweden, with enrolment from 2008, whose patients are clinically and immunologically characterised and give samples for clinical, immunological and genetic studies of the disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27807919") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27870550") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29069385") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33574239") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33574239") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7878795/fullTextXML") Annotation(rdfs:comment "We believe that a strength of this study was the opportunity to recruit the majority of AAD patients in Norway and Sweden through national registries with geographically matched controls, using stringent exclusion criteria and only including those with 21-hydroxylase autoantibodies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002342> "A nationwide multicentre research registry of patients with autoimmune Addison's disease in Sweden, with enrolment from 2008, whose patients are clinically and immunologically characterised and give samples for clinical, immunological and genetic studies of the disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002344> (<http://www.ebi.ac.uk/coho/COHO_0002344>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22093196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36474045") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22093196") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22093196+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "SAVOR-TIMI 53 is testing the hypothesis that treatment with saxagliptin is safe and reduces CV events in high-risk patients with T2DM.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002344> "A phase 4, multinational, randomised, double-blind, placebo-controlled trial of the TIMI Study Group, conducted in 26 countries, that enrolled people aged 40 and older with type 2 diabetes mellitus and either established cardiovascular disease or multiple cardiovascular risk factors and randomised them to the DPP-4 inhibitor saxagliptin or matching placebo, to evaluate the drug's cardiovascular safety and efficacy with a primary endpoint of cardiovascular death, myocardial infarction or ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22093196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36474045") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22093196") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22093196+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The primary end point is the composite of CV death, nonfatal myocardial infarction, or nonfatal ischemic stroke.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002344> "A phase 4, multinational, randomised, double-blind, placebo-controlled trial of the TIMI Study Group, conducted in 26 countries, that enrolled people aged 40 and older with type 2 diabetes mellitus and either established cardiovascular disease or multiple cardiovascular risk factors and randomised them to the DPP-4 inhibitor saxagliptin or matching placebo, to evaluate the drug's cardiovascular safety and efficacy with a primary endpoint of cardiovascular death, myocardial infarction or ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22093196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36474045") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36474045") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01233-6/MediaObjects/41588_2022_1233_MOESM1_ESM.pdf") Annotation(rdfs:comment "The SAVOR-TIMI 53 trial was a multinational, randomized, double-blind, placebo-controlled trial of the DPP4 inhibitor saxagliptin in diabetics (12).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002344> "A phase 4, multinational, randomised, double-blind, placebo-controlled trial of the TIMI Study Group, conducted in 26 countries, that enrolled people aged 40 and older with type 2 diabetes mellitus and either established cardiovascular disease or multiple cardiovascular risk factors and randomised them to the DPP-4 inhibitor saxagliptin or matching placebo, to evaluate the drug's cardiovascular safety and efficacy with a primary endpoint of cardiovascular death, myocardial infarction or ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22093196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36474045") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36474045") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01233-6/MediaObjects/41588_2022_1233_MOESM1_ESM.pdf") Annotation(rdfs:comment "The inclusion criteria were age of at least 40 years with type 2 diabetes mellitus, a glycated hemoglobin of 6.5% to 12.0%, and either established cardiovascular disease or multiple cardiovascular risk factors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002344> "A phase 4, multinational, randomised, double-blind, placebo-controlled trial of the TIMI Study Group, conducted in 26 countries, that enrolled people aged 40 and older with type 2 diabetes mellitus and either established cardiovascular disease or multiple cardiovascular risk factors and randomised them to the DPP-4 inhibitor saxagliptin or matching placebo, to evaluate the drug's cardiovascular safety and efficacy with a primary endpoint of cardiovascular death, myocardial infarction or ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22093196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36474045") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:36474045") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-022-01233-6/MediaObjects/41588_2022_1233_MOESM1_ESM.pdf") Annotation(rdfs:comment "Three cardiovascular outcomes trials from the TIMI Study Group were included in the GWAS analysis: PEGASUS-TIMI 54, ENGAGE AF-TIMI 48, and SAVOR-TIMI 53.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002344> "A phase 4, multinational, randomised, double-blind, placebo-controlled trial of the TIMI Study Group, conducted in 26 countries, that enrolled people aged 40 and older with type 2 diabetes mellitus and either established cardiovascular disease or multiple cardiovascular risk factors and randomised them to the DPP-4 inhibitor saxagliptin or matching placebo, to evaluate the drug's cardiovascular safety and efficacy with a primary endpoint of cardiovascular death, myocardial infarction or ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22093196") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:36474045") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-024-02064-3/MediaObjects/41588_2024_2064_MOESM6_ESM.xlsx") Annotation(rdfs:comment "The Saxagliptin Assessment of Vascular Outcomes Recorded in Patients with Diabetes Mellitus (SAVOR)-TIMI 53 Study was a multicenter, randomized, double-blind, placebo-controlled, phase 4 trial conducted at 788 sites in 26 countries, randomizing saxagliptin to placebo in diabetics.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002344> "A phase 4, multinational, randomised, double-blind, placebo-controlled trial of the TIMI Study Group, conducted in 26 countries, that enrolled people aged 40 and older with type 2 diabetes mellitus and either established cardiovascular disease or multiple cardiovascular risk factors and randomised them to the DPP-4 inhibitor saxagliptin or matching placebo, to evaluate the drug's cardiovascular safety and efficacy with a primary endpoint of cardiovascular death, myocardial infarction or ischaemic stroke.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002345> (<http://www.ebi.ac.uk/coho/COHO_0002345>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31049640") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31049640") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6560001/fullTextXML") Annotation(rdfs:comment "Additional type 2 diabetes cases from the same ethnic group and locality were obtained from the DCC, which included individuals with type 2 diabetes attending a diabetes clinic.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002345> "A combined sample of South African Zulu type 2 diabetes cases and controls from Durban, South Africa, formed for genetic studies by aggregating the Durban Diabetes Study, a population-based cross-sectional study of urban Black African adults of Zulu descent, with the Durban Diabetes Case Control study, which added cases of the same ethnic group and locality who had type 2 diabetes and attended a diabetes clinic.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31049640") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31049640") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6560001/fullTextXML") Annotation(rdfs:comment "DDS was a population-based cross-sectional study of non-pregnant urban black African adults of Zulu descent, aged >18 years, residing in Durban, South Africa [15, 16].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002345> "A combined sample of South African Zulu type 2 diabetes cases and controls from Durban, South Africa, formed for genetic studies by aggregating the Durban Diabetes Study, a population-based cross-sectional study of urban Black African adults of Zulu descent, with the Durban Diabetes Case Control study, which added cases of the same ethnic group and locality who had type 2 diabetes and attended a diabetes clinic.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31049640") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31049640") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6560001/fullTextXML") Annotation(rdfs:comment "South African Zulu individuals were type 2 diabetes cases and controls from two studies: the Durban Diabetes Study (DDS) and the Durban Diabetes Case Control study (DCC).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002345> "A combined sample of South African Zulu type 2 diabetes cases and controls from Durban, South Africa, formed for genetic studies by aggregating the Durban Diabetes Study, a population-based cross-sectional study of urban Black African adults of Zulu descent, with the Durban Diabetes Case Control study, which added cases of the same ethnic group and locality who had type 2 diabetes and attended a diabetes clinic.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31049640") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31049640") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6560001/fullTextXML") Annotation(rdfs:comment "The combined type 2 diabetes cases and controls from DDS and DCC were aggregated into a single Zulu study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002345> "A combined sample of South African Zulu type 2 diabetes cases and controls from Durban, South Africa, formed for genetic studies by aggregating the Durban Diabetes Study, a population-based cross-sectional study of urban Black African adults of Zulu descent, with the Durban Diabetes Case Control study, which added cases of the same ethnic group and locality who had type 2 diabetes and attended a diabetes clinic.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002346> (<http://www.ebi.ac.uk/coho/COHO_0002346>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23844225") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20520800") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2876119/") Annotation(rdfs:comment "SBCS UK Hospital-based Women with pathologically confirmed breast cancer recruited from surgical outpatient clinics at the Royal Hallamshire Hospital, Sheffield, 1998–2002; cases are a mixture of prevalent and incident disease 29–93 [26],[27]") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002346> "A hospital-based case-control study of breast cancer in Sheffield, United Kingdom, that recruited women with histologically confirmed breast cancer from the surgical outpatient clinics of the Royal Hallamshire Hospital, Sheffield, and Rotherham District Hospital from 1998 to 2005, and as controls women aged 50 to 60 attending the Sheffield mammography screening service in 2000–2004 whose mammograms showed no breast lesions, all resident in the Sheffield area and of northern European ancestry, for studies of genetic susceptibility to and survival from breast cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23844225") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23844225") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3700940/fullTextXML") Annotation(rdfs:comment "Cases and controls were all resident in the Sheffield area and of northern European ancestry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002346> "A hospital-based case-control study of breast cancer in Sheffield, United Kingdom, that recruited women with histologically confirmed breast cancer from the surgical outpatient clinics of the Royal Hallamshire Hospital, Sheffield, and Rotherham District Hospital from 1998 to 2005, and as controls women aged 50 to 60 attending the Sheffield mammography screening service in 2000–2004 whose mammograms showed no breast lesions, all resident in the Sheffield area and of northern European ancestry, for studies of genetic susceptibility to and survival from breast cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23844225") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23844225") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3700940/fullTextXML") Annotation(rdfs:comment "The Sheffield Breast Cancer Study (SBCS) recruited histologically confirmed breast cancer patients from surgical outpatient clinics in the Royal Hallamshire Hospital, Sheffield and Rotherham District Hospital from 1998 to 2005.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002346> "A hospital-based case-control study of breast cancer in Sheffield, United Kingdom, that recruited women with histologically confirmed breast cancer from the surgical outpatient clinics of the Royal Hallamshire Hospital, Sheffield, and Rotherham District Hospital from 1998 to 2005, and as controls women aged 50 to 60 attending the Sheffield mammography screening service in 2000–2004 whose mammograms showed no breast lesions, all resident in the Sheffield area and of northern European ancestry, for studies of genetic susceptibility to and survival from breast cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23844225") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23844225") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3700940/fullTextXML") Annotation(rdfs:comment "Untyped SNPs were imputed using IMPUTE2, and associations between genotype and breast cancer risk and survival were evaluated using logistic and Cox proportional hazard regression models respectively on a per allele basis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002346> "A hospital-based case-control study of breast cancer in Sheffield, United Kingdom, that recruited women with histologically confirmed breast cancer from the surgical outpatient clinics of the Royal Hallamshire Hospital, Sheffield, and Rotherham District Hospital from 1998 to 2005, and as controls women aged 50 to 60 attending the Sheffield mammography screening service in 2000–2004 whose mammograms showed no breast lesions, all resident in the Sheffield area and of northern European ancestry, for studies of genetic susceptibility to and survival from breast cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20520800") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23844225") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23844225") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3700940/fullTextXML") Annotation(rdfs:comment "Women aged 50-60 years attending the mammography breast screening service in Sheffield between October 2000 and January 2004 were drawn as control subjects if there was no evidence of breast lesions in their mammograms.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002346> "A hospital-based case-control study of breast cancer in Sheffield, United Kingdom, that recruited women with histologically confirmed breast cancer from the surgical outpatient clinics of the Royal Hallamshire Hospital, Sheffield, and Rotherham District Hospital from 1998 to 2005, and as controls women aged 50 to 60 attending the Sheffield mammography screening service in 2000–2004 whose mammograms showed no breast lesions, all resident in the Sheffield area and of northern European ancestry, for studies of genetic susceptibility to and survival from breast cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002347> (<http://www.ebi.ac.uk/coho/COHO_0002347>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18409069") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31157323") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18928393") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18928393+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Subjects were 5046 women who participated in the SBCSS, conducted in urban Shanghai, China.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002347> "A population-based cohort study of breast cancer survivors in urban Shanghai, China, which enrolled women aged 20 to 75 years with newly diagnosed breast cancer identified through the Shanghai Cancer Registry between March 2002 and April 2006, about six months after diagnosis, and followed them in person at 18 months and 3, 5 and 10 years after diagnosis for cancer outcomes, health status, lifestyle and medication use.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18409069") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31157323") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31157323") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6527440/fullTextXML") Annotation(rdfs:comment "At study enrollment, detailed information regarding patient demographics, cancer diagnosis and treatment history, medication use, dietary habits, exercise, and other lifestyle factors was collected via an in-person interview.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002347> "A population-based cohort study of breast cancer survivors in urban Shanghai, China, which enrolled women aged 20 to 75 years with newly diagnosed breast cancer identified through the Shanghai Cancer Registry between March 2002 and April 2006, about six months after diagnosis, and followed them in person at 18 months and 3, 5 and 10 years after diagnosis for cancer outcomes, health status, lifestyle and medication use.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18409069") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31157323") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31157323") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6527440/fullTextXML") Annotation(rdfs:comment "Briefly, 5042 patients with newly diagnosed breast cancer, aged 20 to 75 years, were identified from the Shanghai Cancer Registry between March 2002 and April 2006 and enrolled in the SBCSS approximately 6 months after cancer diagnosis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002347> "A population-based cohort study of breast cancer survivors in urban Shanghai, China, which enrolled women aged 20 to 75 years with newly diagnosed breast cancer identified through the Shanghai Cancer Registry between March 2002 and April 2006, about six months after diagnosis, and followed them in person at 18 months and 3, 5 and 10 years after diagnosis for cancer outcomes, health status, lifestyle and medication use.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18409069") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31157323") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31157323") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6527440/fullTextXML") Annotation(rdfs:comment "In-person follow-up was conducted at 18 months and at 3, 5, and 10 years after diagnosis to collect information on cancer outcome and changes of health status and to update lifestyle and medication use information.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002347> "A population-based cohort study of breast cancer survivors in urban Shanghai, China, which enrolled women aged 20 to 75 years with newly diagnosed breast cancer identified through the Shanghai Cancer Registry between March 2002 and April 2006, about six months after diagnosis, and followed them in person at 18 months and 3, 5 and 10 years after diagnosis for cancer outcomes, health status, lifestyle and medication use.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18409069") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:31157323") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31157323") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6527440/fullTextXML") Annotation(rdfs:comment "This study used data from the Shanghai Breast Cancer Survival Study (SBCSS), a large population-based longitudinal cohort of 5042 breast cancer survivors.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002347> "A population-based cohort study of breast cancer survivors in urban Shanghai, China, which enrolled women aged 20 to 75 years with newly diagnosed breast cancer identified through the Shanghai Cancer Registry between March 2002 and April 2006, about six months after diagnosis, and followed them in person at 18 months and 3, 5 and 10 years after diagnosis for cancer outcomes, health status, lifestyle and medication use.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002348> (<http://www.ebi.ac.uk/coho/COHO_0002348>)

