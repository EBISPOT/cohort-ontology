AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001181") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35169130") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8847343/fullTextXML") Annotation(rdfs:comment "In this study, we analyzed the gut microbiome composition in more than 2500 adults from the EstBB who participated in the Estonian Microbiome Project (EstMB), which included stool sample collection and comprehensive phenotyping.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000251> "A sub-cohort of 2,509 Estonian Biobank participants who provided stool, oral and plasma samples, supplemented with multi-omic measurements, questionnaires and linkage to national electronic health records to investigate the gut microbiome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS50000001181") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS50000001181") Annotation(rdfs:comment "As part of the Estonian Biobank, we established the Estonian Microbiome Cohort which includes stool, oral and plasma samples from 2,509 participants and is supplemented with multi-omic measurements, questionnaires, and regular linkages to national electronic health records.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000251> "A sub-cohort of 2,509 Estonian Biobank participants who provided stool, oral and plasma samples, supplemented with multi-omic measurements, questionnaires and linkage to national electronic health records to investigate the gut microbiome.")

