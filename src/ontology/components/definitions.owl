AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20304703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20304703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2945218/unicode") Annotation(rdfs:comment "Briefly, community residents who were never smokers were selected as controls and matched to patients according to age, sex, and ethnic background.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002036> "A case-control sample of lung cancer patients who had never smoked, identified and recruited at Mayo Clinic, Rochester, Minnesota, between 1997 and 2008, and never-smoking community residents matched to them by age, sex and ethnic background, genotyped for a genome-wide association study of lung cancer in never smokers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20304703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20304703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2945218/unicode") Annotation(rdfs:comment "In the Mayo genome-wide association study, genotyping was done with the Illumina HumanHap 370k and 610k BeadChips (Illumina, San Diego, CA, USA), which contain 373397 and 592532 tag SNPs, respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002036> "A case-control sample of lung cancer patients who had never smoked, identified and recruited at Mayo Clinic, Rochester, Minnesota, between 1997 and 2008, and never-smoking community residents matched to them by age, sex and ethnic background, genotyped for a genome-wide association study of lung cancer in never smokers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20304703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20304703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2945218/unicode") Annotation(rdfs:comment "In the Mayo genome-wide association study, patients with lung cancer who were classed as never smokers were identified and recruited between January, 1997, and September, 2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002036> "A case-control sample of lung cancer patients who had never smoked, identified and recruited at Mayo Clinic, Rochester, Minnesota, between 1997 and 2008, and never-smoking community residents matched to them by age, sex and ethnic background, genotyped for a genome-wide association study of lung cancer in never smokers.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20304703") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20304703") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2945218/unicode") Annotation(rdfs:comment "Research protocols were approved by the institutional review boards of Mayo Clinic (Rochester, MN, USA)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002036> "A case-control sample of lung cancer patients who had never smoked, identified and recruited at Mayo Clinic, Rochester, Minnesota, between 1997 and 2008, and never-smoking community residents matched to them by age, sex and ethnic background, genotyped for a genome-wide association study of lung cancer in never smokers.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002037> (<http://www.ebi.ac.uk/coho/COHO_0002037>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20354183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30648747") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20354183") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2855746/unicode") Annotation(rdfs:comment "A second blood draw for hormone measurements, anastrozole and anastrozole metabolite concentrations in plasma was scheduled for four weeks to six months after initiation of anastrozole, i.e., long enough to allow steady state of anastrozole to be achieved.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002037> "A study of postmenopausal women with resected early-stage oestrogen receptor-positive breast cancer, recruited at Mayo Clinic, MD Anderson Cancer Center and Memorial Sloan Kettering Cancer Center under the NIGMS-funded Pharmacogenomics Research Network, who were treated with adjuvant anastrozole 1 mg daily and had blood drawn before and during therapy for DNA and for plasma drug and hormone measurements, set up to study genetic variation in response to aromatase inhibitors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20354183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30648747") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20354183") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2855746/unicode") Annotation(rdfs:comment "This clinical study enrolled postmenopausal women who were to receive anastrozole as adjuvant therapy for resected early stage breast cancer at Mayo Clinic and the M.D.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002037> "A study of postmenopausal women with resected early-stage oestrogen receptor-positive breast cancer, recruited at Mayo Clinic, MD Anderson Cancer Center and Memorial Sloan Kettering Cancer Center under the NIGMS-funded Pharmacogenomics Research Network, who were treated with adjuvant anastrozole 1 mg daily and had blood drawn before and during therapy for DNA and for plasma drug and hormone measurements, set up to study genetic variation in response to aromatase inhibitors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20354183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30648747") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30648747") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6612579/fullTextXML") Annotation(rdfs:comment "All patients received the standard clinically approved dose of anastrozole of 1 mg/day.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002037> "A study of postmenopausal women with resected early-stage oestrogen receptor-positive breast cancer, recruited at Mayo Clinic, MD Anderson Cancer Center and Memorial Sloan Kettering Cancer Center under the NIGMS-funded Pharmacogenomics Research Network, who were treated with adjuvant anastrozole 1 mg daily and had blood drawn before and during therapy for DNA and for plasma drug and hormone measurements, set up to study genetic variation in response to aromatase inhibitors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20354183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30648747") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30648747") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6612579/fullTextXML") Annotation(rdfs:comment "Postmenopausal patients with resected early stage ER+ breast cancer were recruited from the Mayo Clinic, MD Anderson Cancer Center, and Memorial Sloan Kettering Cancer Center as part of the National Institute of General Medical Sciences–funded PGRN Aromatase Inhibitor Pharmacogenomics Trial (Mayo‐MDA‐MSK).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002037> "A study of postmenopausal women with resected early-stage oestrogen receptor-positive breast cancer, recruited at Mayo Clinic, MD Anderson Cancer Center and Memorial Sloan Kettering Cancer Center under the NIGMS-funded Pharmacogenomics Research Network, who were treated with adjuvant anastrozole 1 mg daily and had blood drawn before and during therapy for DNA and for plasma drug and hormone measurements, set up to study genetic variation in response to aromatase inhibitors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20354183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30648747") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30648747") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6612579/fullTextXML") Annotation(rdfs:comment "Prior to the initiation of therapy, blood samples were drawn from each patient to extract DNA to genotype ~ 600K SNPs using the Ilumina 610 Quad and to quantitate pretreatment plasma E2 and E1 concentrations by gas chromatography–tandem mass spectroscopy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002037> "A study of postmenopausal women with resected early-stage oestrogen receptor-positive breast cancer, recruited at Mayo Clinic, MD Anderson Cancer Center and Memorial Sloan Kettering Cancer Center under the NIGMS-funded Pharmacogenomics Research Network, who were treated with adjuvant anastrozole 1 mg daily and had blood drawn before and during therapy for DNA and for plasma drug and hormone measurements, set up to study genetic variation in response to aromatase inhibitors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20354183") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30648747") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30648747") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6612579/fullTextXML") Annotation(rdfs:comment "We performed a genome‐wide association study (GWAS) for plasma anastrozole concentrations in 687 postmenopausal women with ER+ breast cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002037> "A study of postmenopausal women with resected early-stage oestrogen receptor-positive breast cancer, recruited at Mayo Clinic, MD Anderson Cancer Center and Memorial Sloan Kettering Cancer Center under the NIGMS-funded Pharmacogenomics Research Network, who were treated with adjuvant anastrozole 1 mg daily and had blood drawn before and during therapy for DNA and for plasma drug and hormone measurements, set up to study genetic variation in response to aromatase inhibitors.")

