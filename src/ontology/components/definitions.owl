AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20450418") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42461483") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20450418") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC2874101/unicode") Annotation(rdfs:comment "Between 1988 and 1989, 2946 IDUs in Baltimore, MD were enrolled into a cohort study of the natural history of HIV-1 (AIDS Linked to the IntraVenous Experience [ALIVE]) study) and followed semi-annually.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001276> "An ongoing community-based cohort of current and former people who inject drugs in and around Baltimore, Maryland, United States, established in 1988 as a natural history study of the incidence and progression of HIV infection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20450418") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42461483") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38408416") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A38408416+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We sought to describe use and co-use of opioids and stimulants, 2005-2019, in the AIDS Linked to the Intravenous Experience (ALIVE) cohort - a community-based cohort of people with a history of injection drug use living in or near Baltimore, MD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001276> "An ongoing community-based cohort of current and former people who inject drugs in and around Baltimore, Maryland, United States, established in 1988 as a natural history study of the incidence and progression of HIV infection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20450418") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42461483") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42461483") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://doi.org/10.1007/s10461-026-05227-x") Annotation(rdfs:comment "ALIVE is a community-based observational cohort study of former and current PWID in Baltimore ongoing since 1988 and described fully elsewhere [26].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001276> "An ongoing community-based cohort of current and former people who inject drugs in and around Baltimore, Maryland, United States, established in 1988 as a natural history study of the incidence and progression of HIV infection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20450418") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42461483") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42461483") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42461483+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Nested within the AIDS Linked to the IntraVenous Experience (ALIVE) study, an ongoing community-based cohort of former and current PWID in Baltimore, Maryland") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001276> "An ongoing community-based cohort of current and former people who inject drugs in and around Baltimore, Maryland, United States, established in 1988 as a natural history study of the incidence and progression of HIV infection.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20450418") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37532928") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42461483") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41586-023-06370-4/MediaObjects/41586_2023_6370_MOESM1_ESM.pdf") Annotation(rdfs:comment "The AIDS Linked to the IntraVenous Experience (ALIVE) study is a natural history study following the incidence and progression of HIV infection among intravenous drug users (IDUs) in Baltimore, MD.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001276> "An ongoing community-based cohort of current and former people who inject drugs in and around Baltimore, Maryland, United States, established in 1988 as a natural history study of the incidence and progression of HIV infection.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0001277> (<http://www.ebi.ac.uk/coho/COHO_0001277>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19887461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19887461") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19887461+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "From 2001 to 2005, the authors recruited 1,164 probands including 629 cases with histopathologically confirmed, first-primary cutaneous melanoma diagnosed before age 40 years, 240 population-based controls frequency matched for age, and 295 spouse/friend controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001277> "A multicentre, population-based case-control-family study in Australia, recruiting people with early-onset first-primary cutaneous melanoma, population-based and spouse or friend controls, and their relatives, between 2001 and 2005, to investigate genetic and environmental influences on melanoma risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19887461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19887461") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19887461+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Population-based, case-control-family design to investigate genetic and environmental influences on melanoma risk: Australian Melanoma Family Study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001277> "A multicentre, population-based case-control-family study in Australia, recruiting people with early-onset first-primary cutaneous melanoma, population-based and spouse or friend controls, and their relatives, between 2001 and 2005, to investigate genetic and environmental influences on melanoma risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19887461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19887461") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19887461+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This paper describes the Australian Melanoma Family Study, which uses a multicenter, population-based, case-control-family design.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001277> "A multicentre, population-based case-control-family study in Australia, recruiting people with early-onset first-primary cutaneous melanoma, population-based and spouse or friend controls, and their relatives, between 2001 and 2005, to investigate genetic and environmental influences on melanoma risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19887461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19887461") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A19887461+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "population-based, spouse/friend, and sibling controls; systematic recruitment of relatives of case and control probands") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001277> "A multicentre, population-based case-control-family study in Australia, recruiting people with early-onset first-primary cutaneous melanoma, population-based and spouse or friend controls, and their relatives, between 2001 and 2005, to investigate genetic and environmental influences on melanoma risk.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19887461") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.3373/MediaObjects/41588_2015_BFng3373_MOESM50_ESM.pdf") Annotation(rdfs:comment "Melanoma probands from Melbourne, Brisbane and Sydney in Australia identified from population-based state cancer registries and city, age and sex-matched controls (all aged 18–39 years) were collected by the Australian Melanoma Family Study (AMFS) and genotyped together on Omni1-Quad arrays.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001277> "A multicentre, population-based case-control-family study in Australia, recruiting people with early-onset first-primary cutaneous melanoma, population-based and spouse or friend controls, and their relatives, between 2001 and 2005, to investigate genetic and environmental influences on melanoma risk.")

