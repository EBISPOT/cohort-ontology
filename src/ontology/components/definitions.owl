AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ars.els-cdn.com/content/image/1-s2.0-S0092867420308229-mmc1.xlsx") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6201388/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6587223/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6201388/fullTextXML") Annotation(rdfs:comment "This whole‐genome DNA sequencing MHI Biobank phase 1 data set, including quality control steps, has been extensively described elsewhere.16 The mean coverage per individual was ≈5.6×, and we identified a total of 29 million biallelic variants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000555> "A nested case-control sample of about 2,000 French-Canadian participants of the Montreal Heart Institute Biobank (patients with myocardial infarction and controls free of coronary artery disease) whose whole genomes were sequenced at low depth (about 5.6x) at the McGill University and Génome Québec Innovation Centre, forming the first of the biobank's two genetic data sets.")
