AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003283") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42648772") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42648772+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Two thousand five hundred and seven pregnant women were recruited when attending antenatal services at Entebbe General Hospital, Uganda; 2345 resulting live-born children were enrolled into the EMaBS birth cohort.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000248> "A birth cohort of children in Entebbe, southern Uganda, followed from birth with measures of response to infant vaccinations, malaria episodes, infection and atopy, and genotyped to investigate genetic determinants of vaccine response in sub-Saharan Africa.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003283") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001003283") Annotation(rdfs:comment "Additional phenotypes within the cohort include, response to BCG immunisation, data on malaria episodes and immunological markers of infection (antibodies for malarial infection) and information on clinical presentation and markers of atopy and eczema.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000248> "A birth cohort of children in Entebbe, southern Uganda, followed from birth with measures of response to infant vaccinations, malaria episodes, infection and atopy, and genotyped to investigate genetic determinants of vaccine response in sub-Saharan Africa.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003283") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001003283") Annotation(rdfs:comment "We aim to genotype 1,500 children from the Entebbe Mother and Baby (EMaB) study, an ongoing birth cohort in southern Uganda, using the Illumina HumanOmni 2.5M chip array.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000248> "A birth cohort of children in Entebbe, southern Uganda, followed from birth with measures of response to infant vaccinations, malaria episodes, infection and atopy, and genotyped to investigate genetic determinants of vaccine response in sub-Saharan Africa.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003283") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001003283") Annotation(rdfs:comment "We therefore propose a GWAS to identify variants associated with a differential response to some of the most commonly used vaccines.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000248> "A birth cohort of children in Entebbe, southern Uganda, followed from birth with measures of response to infant vaccinations, malaria episodes, infection and atopy, and genotyped to investigate genetic determinants of vaccine response in sub-Saharan Africa.")

