# Individual: <http://www.ebi.ac.uk/coho/COHO_0002396> (<http://www.ebi.ac.uk/coho/COHO_0002396>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20159113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20159113") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2820168") Annotation(rdfs:comment "MS samples included in the genome-wide analysis originated from the MS high-risk isolate located on the western coast of Finland (Southern Ostrobothnia, SO) with ~2-fold prevalence and higher familial clustering of MS compared to other regions of Finland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002396> "A Finnish case-control sample of multiple sclerosis patients with both parents, or one parent and a family history of multiple sclerosis, from Southern Ostrobothnia, the internal isolate on the western coast of Finland with an increased prevalence and familial clustering of multiple sclerosis, and population-based controls, drawn from the Health 2000 project, matched to them by genome-wide identity-by-state sharing and parental birthplace, that formed the genome-wide association stage of a 2010 study of multiple sclerosis in that isolate.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20159113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20159113") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2820168") Annotation(rdfs:comment "The Health 2000 project is thanked for providing population-based controls for this GWAS study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002396> "A Finnish case-control sample of multiple sclerosis patients with both parents, or one parent and a family history of multiple sclerosis, from Southern Ostrobothnia, the internal isolate on the western coast of Finland with an increased prevalence and familial clustering of multiple sclerosis, and population-based controls, drawn from the Health 2000 project, matched to them by genome-wide identity-by-state sharing and parental birthplace, that formed the genome-wide association stage of a 2010 study of multiple sclerosis in that isolate.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20159113") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20159113") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC2820168") Annotation(rdfs:comment "The population history of Finland and the province of Southern Ostrobothnia (SO), an internal isolate with increased prevalence of MS") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002396> "A Finnish case-control sample of multiple sclerosis patients with both parents, or one parent and a family history of multiple sclerosis, from Southern Ostrobothnia, the internal isolate on the western coast of Finland with an increased prevalence and familial clustering of multiple sclerosis, and population-based controls, drawn from the Health 2000 project, matched to them by genome-wide identity-by-state sharing and parental birthplace, that formed the genome-wide association stage of a 2010 study of multiple sclerosis in that isolate.")
