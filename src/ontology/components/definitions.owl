AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_json/PMC4503229/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4503229/unicode") Annotation(rdfs:comment "Men referred to PSA-testing in laboratories in Stockholm County between 2010 and 2012 were invited to the population-based cohort STHLM2 at the blood sampling visit.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002413> "A population-based cohort of men referred for prostate-specific antigen testing in laboratories in Stockholm County, Sweden, who were invited at the blood-sampling visit between 2010 and 2012, with prostate cancer diagnoses and biopsy results taken from the National Prostate Cancer Register and regional records; it supplied prostate cancer cases and controls to international genetic studies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_json/PMC4503229/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4503229/unicode") Annotation(rdfs:comment "We selected all new prostate cancer cases in STHLM2 reported to the National Prostate Cancer Register and all men having a biopsy with benign findings reported after inclusion and before June 20, 2012.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002413> "A population-based cohort of men referred for prostate-specific antigen testing in laboratories in Stockholm County, Sweden, who were invited at the blood-sampling visit between 2010 and 2012, with prostate cancer diagnoses and biopsy results taken from the National Prostate Cancer Register and regional records; it supplied prostate cancer cases and controls to international genetic studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002415> (<http://www.ebi.ac.uk/coho/COHO_0002415>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16250721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42011282") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42011282") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13092225/fullTextXML") Annotation(rdfs:comment "The STRIP study enrolled children and their families who were recruited at well‐baby clinics at their routine 5‐month visit between December 1, 1989, and May 30, 1992 in the city of Turku, Finland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002415> "A randomised controlled trial in Turku, Finland, that enrolled infants and their parents at well-baby clinics between 1989 and 1992 and gave the intervention group individualised dietary counselling from age 7 months to 20 years, aimed at improving dietary fat quality to prevent cardiovascular disease, while the control group received routine care; participants have been followed into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16250721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42011282") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42011282") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42011282+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Children in the intervention group received personalized dietary counseling through age 20, without a fixed diet.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002415> "A randomised controlled trial in Turku, Finland, that enrolled infants and their parents at well-baby clinics between 1989 and 1992 and gave the intervention group individualised dietary counselling from age 7 months to 20 years, aimed at improving dietary fat quality to prevent cardiovascular disease, while the control group received routine care; participants have been followed into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16250721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42011282") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42011282") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42011282+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "It aimed at improving fat quality and promoting healthy foods to prevent cardiovascular diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002415> "A randomised controlled trial in Turku, Finland, that enrolled infants and their parents at well-baby clinics between 1989 and 1992 and gave the intervention group individualised dietary counselling from age 7 months to 20 years, aimed at improving dietary fat quality to prevent cardiovascular disease, while the control group received routine care; participants have been followed into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16250721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42011282") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42011282") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42011282+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The randomized Special Turku Coronary Risk Factor Intervention Project (STRIP) was a 20-year dietary intervention starting at 7 months of age.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002415> "A randomised controlled trial in Turku, Finland, that enrolled infants and their parents at well-baby clinics between 1989 and 1992 and gave the intervention group individualised dietary counselling from age 7 months to 20 years, aimed at improving dietary fat quality to prevent cardiovascular disease, while the control group received routine care; participants have been followed into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16250721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42011282") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42448324") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42448324+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Outcomes were assessed repeatedly over 26 years and included dietary intakes, adiposity and metabolic regulation, lipid profile, and blood pressure.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002415> "A randomised controlled trial in Turku, Finland, that enrolled infants and their parents at well-baby clinics between 1989 and 1992 and gave the intervention group individualised dietary counselling from age 7 months to 20 years, aimed at improving dietary fat quality to prevent cardiovascular disease, while the control group received routine care; participants have been followed into adulthood.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16250721") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42011282") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42448324") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A42448324+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The study comprised 839 participants from the Special Turku Coronary Risk Factor Intervention Project (STRIP), in which the intervention group (n=417) received individualized dietary counselling during 20 years, while the control group (n=422) received routine care.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002415> "A randomised controlled trial in Turku, Finland, that enrolled infants and their parents at well-baby clinics between 1989 and 1992 and gave the intervention group individualised dietary counselling from age 7 months to 20 years, aimed at improving dietary fat quality to prevent cardiovascular disease, while the control group received routine care; participants have been followed into adulthood.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002416> (<http://www.ebi.ac.uk/coho/COHO_0002416>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38098086") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41711956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38098086") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10722735/fullTextXML") Annotation(rdfs:comment "All patients received three cycles of FEC (fluorouracil, epirubicin, cyclophosphamide; 100/500/500 mg/m2) followed by either three cycles of docetaxel alone (100 mg/m2, q3w) (FEC-Doc) or gemcitabine (1000 mg/m2 on days 1 and 8) and docetaxel (75 mg/m2, q3w) (FEC-DocG).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002416> "An open-label, multicentre, randomised phase III trial in Germany that enrolled patients with HER2-positive, intermediate-to-high-risk early breast cancer between 2008 and 2011 and compared adjuvant chemotherapy of three cycles of fluorouracil, epirubicin and cyclophosphamide followed by three cycles of either docetaxel alone or gemcitabine and docetaxel, all patients then receiving trastuzumab for a year.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38098086") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41711956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38098086") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10722735/fullTextXML") Annotation(rdfs:comment "Following CHT, all patients received HER2neu targeted therapy with trastuzumab (8 mg/kg intravenous (IV) loading dose followed by 6 mg/kg IV every 3 weeks for a total of 52 weeks).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002416> "An open-label, multicentre, randomised phase III trial in Germany that enrolled patients with HER2-positive, intermediate-to-high-risk early breast cancer between 2008 and 2011 and compared adjuvant chemotherapy of three cycles of fluorouracil, epirubicin and cyclophosphamide followed by three cycles of either docetaxel alone or gemcitabine and docetaxel, all patients then receiving trastuzumab for a year.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38098086") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41711956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38098086") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10722735/fullTextXML") Annotation(rdfs:comment "SUCCESS B was another open-label, multicenter, 1:1 randomized phase III study that enrolled 793 intermediate-to-high-risk breast cancer patients between June 2008 and September 2011.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002416> "An open-label, multicentre, randomised phase III trial in Germany that enrolled patients with HER2-positive, intermediate-to-high-risk early breast cancer between 2008 and 2011 and compared adjuvant chemotherapy of three cycles of fluorouracil, epirubicin and cyclophosphamide followed by three cycles of either docetaxel alone or gemcitabine and docetaxel, all patients then receiving trastuzumab for a year.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38098086") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41711956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38098086") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10722735/fullTextXML") Annotation(rdfs:comment "Study participants were positive for human epidermal growth factor receptors (HER2neu) and received the same adjuvant CHT as in the SUCCESS A study (i.e., FEC-Doc vs FEC-DocG).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002416> "An open-label, multicentre, randomised phase III trial in Germany that enrolled patients with HER2-positive, intermediate-to-high-risk early breast cancer between 2008 and 2011 and compared adjuvant chemotherapy of three cycles of fluorouracil, epirubicin and cyclophosphamide followed by three cycles of either docetaxel alone or gemcitabine and docetaxel, all patients then receiving trastuzumab for a year.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38098086") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41711956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41711956") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12920344/fullTextXML") Annotation(rdfs:comment "but are not allowed to have evidence of distant disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002416> "An open-label, multicentre, randomised phase III trial in Germany that enrolled patients with HER2-positive, intermediate-to-high-risk early breast cancer between 2008 and 2011 and compared adjuvant chemotherapy of three cycles of fluorouracil, epirubicin and cyclophosphamide followed by three cycles of either docetaxel alone or gemcitabine and docetaxel, all patients then receiving trastuzumab for a year.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38098086") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41711956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fnature24284/MediaObjects/41586_2017_BFnature24284_MOESM1_ESM.pdf") Annotation(rdfs:comment "SuccessB Simultaneous Study of Gemcitabine-Docetaxel Combination adjuvant treatment Multicenter, prospective, randomized, open-label phase III study Germany") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002416> "An open-label, multicentre, randomised phase III trial in Germany that enrolled patients with HER2-positive, intermediate-to-high-risk early breast cancer between 2008 and 2011 and compared adjuvant chemotherapy of three cycles of fluorouracil, epirubicin and cyclophosphamide followed by three cycles of either docetaxel alone or gemcitabine and docetaxel, all patients then receiving trastuzumab for a year.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002417> (<http://www.ebi.ac.uk/coho/COHO_0002417>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38098086") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41711956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38098086") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10722735/fullTextXML") Annotation(rdfs:comment "The SUCCESS C trial was a multicenter, prospective randomized phase III study comprising 3643 patients with primary HER2neu negative early breast cancer that were enrolled between February 2009 and August 2011 at 231 German study sites.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002417> "An open-label, multicentre, randomised phase III trial at study sites in Germany that enrolled patients with HER2-negative early breast cancer between 2009 and 2011 and compared anthracycline-containing with anthracycline-free (docetaxel and cyclophosphamide) adjuvant chemotherapy, with a second randomisation of patients with a body mass index of 24 to 40 kg/m2 to an individualised two-year telephone lifestyle intervention aiming at moderate weight loss or to general lifestyle recommendations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38098086") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41711956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38098086") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10722735/fullTextXML") Annotation(rdfs:comment "The first randomization examined disease-free survival in patients receiving either anthracycline-free CHT treatment (6 cycles of docetaxel-cyclophosphamide, Doc-C) or anthracycline-containing CHT treatment with FEC-Doc.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002417> "An open-label, multicentre, randomised phase III trial at study sites in Germany that enrolled patients with HER2-negative early breast cancer between 2009 and 2011 and compared anthracycline-containing with anthracycline-free (docetaxel and cyclophosphamide) adjuvant chemotherapy, with a second randomisation of patients with a body mass index of 24 to 40 kg/m2 to an individualised two-year telephone lifestyle intervention aiming at moderate weight loss or to general lifestyle recommendations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38098086") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41711956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38098086") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10722735/fullTextXML") Annotation(rdfs:comment "The individualized lifestyle intervention program comprised a two-year standardized and structured telephone intervention aimed at moderate weight loss through dietary changes and physical activity, supported by educational materials and patient diary.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002417> "An open-label, multicentre, randomised phase III trial at study sites in Germany that enrolled patients with HER2-negative early breast cancer between 2009 and 2011 and compared anthracycline-containing with anthracycline-free (docetaxel and cyclophosphamide) adjuvant chemotherapy, with a second randomisation of patients with a body mass index of 24 to 40 kg/m2 to an individualised two-year telephone lifestyle intervention aiming at moderate weight loss or to general lifestyle recommendations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38098086") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41711956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38098086") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10722735/fullTextXML") Annotation(rdfs:comment "The second randomization compared disease-free survival in patients with a body mass index (BMI) of 24–40 kg/m2 who received either an individualized lifestyle intervention program or general healthy lifestyle recommendations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002417> "An open-label, multicentre, randomised phase III trial at study sites in Germany that enrolled patients with HER2-negative early breast cancer between 2009 and 2011 and compared anthracycline-containing with anthracycline-free (docetaxel and cyclophosphamide) adjuvant chemotherapy, with a second randomisation of patients with a body mass index of 24 to 40 kg/m2 to an individualised two-year telephone lifestyle intervention aiming at moderate weight loss or to general lifestyle recommendations.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38098086") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41711956") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41711956") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12920344/fullTextXML") Annotation(rdfs:comment "SUCCESS C was an open-label, multicenter, 2 × 2 factorial design, randomized controlled, phase III study") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002417> "An open-label, multicentre, randomised phase III trial at study sites in Germany that enrolled patients with HER2-negative early breast cancer between 2009 and 2011 and compared anthracycline-containing with anthracycline-free (docetaxel and cyclophosphamide) adjuvant chemotherapy, with a second randomisation of patients with a body mass index of 24 to 40 kg/m2 to an individualised two-year telephone lifestyle intervention aiming at moderate weight loss or to general lifestyle recommendations.")

