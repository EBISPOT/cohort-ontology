AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12028118") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16391567") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16443614") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17847005") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18177490") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2227930/") Annotation(rdfs:comment "Nuclear families from two European populations, representing a subset of a larger multicenter study,10 were collected from centers in Sheffield, United Kingdom, and in Thessaloniki, Greece.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0001750> "A multinational family study of asthma that in 1999-2001 recruited, at centres in Europe (among them the United Kingdom, Greece and Norway), Australia and the United States, nuclear families of probands aged 7-35 years with physician-diagnosed asthma and their symptomatic siblings, together with their parents, who were assessed by questionnaire, lung function and allergen skin prick testing, to search for asthma susceptibility loci and quantitative asthma phenotypes.")

