AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7664011") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9853436") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9853437") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:7664011") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A7664011+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "University and general hospitals across the UK.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002514> "A multicentre, open, randomised trial at university and general hospitals across the United Kingdom that allocated patients aged 60–76 years with symptomless abdominal aortic aneurysms 4.0–5.5 cm in diameter to early elective open surgical repair or to ultrasonographic surveillance, comparing mortality, health service costs and quality of life, and following the natural history of small aneurysms in the surveillance group.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7664011") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9853436") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:9853437") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:9853436") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A9853436+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We randomly assigned 1090 patients aged 60-76 years, with symptomless abdominal aortic aneurysms 4.0-5.5 cm in diameter to undergo early elective open surgery (n=563) or ultrasonographic surveillance (n=527).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002514> "A multicentre, open, randomised trial at university and general hospitals across the United Kingdom that allocated patients aged 60–76 years with symptomless abdominal aortic aneurysms 4.0–5.5 cm in diameter to early elective open surgical repair or to ultrasonographic surveillance, comparing mortality, health service costs and quality of life, and following the natural history of small aneurysms in the surveillance group.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002515> (<http://www.ebi.ac.uk/coho/COHO_0002515>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2635/MediaObjects/41588_2013_BFng2635_MOESM33_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4846317/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2635/MediaObjects/41588_2013_BFng2635_MOESM33_ESM.pdf") Annotation(rdfs:comment "Cases were recruited via the UK Testicular Cancer Collaboration (see below), a group of oncologists and surgeons treating TGCT in the UK.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002515> "The testicular germ cell tumour case series coordinated at the Institute of Cancer Research in the United Kingdom, drawn from a UK study of familial testicular cancer and a national collection of testicular germ cell tumour cases treated in the UK, whose cases were recruited over about 20 years through the UK Testicular Cancer Collaboration, a group of oncologists and surgeons treating the disease across the UK, and used in genome-wide association studies of testicular cancer susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2635/MediaObjects/41588_2013_BFng2635_MOESM33_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4846317/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2635/MediaObjects/41588_2013_BFng2635_MOESM33_ESM.pdf") Annotation(rdfs:comment "The case samples for both the GWAS and the iCOGs replication phases were unrelated and had a prior diagnosis of germ cell tumor of the testis.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002515> "The testicular germ cell tumour case series coordinated at the Institute of Cancer Research in the United Kingdom, drawn from a UK study of familial testicular cancer and a national collection of testicular germ cell tumour cases treated in the UK, whose cases were recruited over about 20 years through the UK Testicular Cancer Collaboration, a group of oncologists and surgeons treating the disease across the UK, and used in genome-wide association studies of testicular cancer susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2635/MediaObjects/41588_2013_BFng2635_MOESM33_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4846317/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2635/MediaObjects/41588_2013_BFng2635_MOESM33_ESM.pdf") Annotation(rdfs:comment "The studies were co-ordinated at the Institute of Cancer Research (ICR).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002515> "The testicular germ cell tumour case series coordinated at the Institute of Cancer Research in the United Kingdom, drawn from a UK study of familial testicular cancer and a national collection of testicular germ cell tumour cases treated in the UK, whose cases were recruited over about 20 years through the UK Testicular Cancer Collaboration, a group of oncologists and surgeons treating the disease across the UK, and used in genome-wide association studies of testicular cancer susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2635/MediaObjects/41588_2013_BFng2635_MOESM33_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4846317/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2635/MediaObjects/41588_2013_BFng2635_MOESM33_ESM.pdf") Annotation(rdfs:comment "They were identified over a 20 year period from two studies (i) a UK study of familial testicular cancer and (ii) a national collection of TGCT cases treated within the UK.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002515> "The testicular germ cell tumour case series coordinated at the Institute of Cancer Research in the United Kingdom, drawn from a UK study of familial testicular cancer and a national collection of testicular germ cell tumour cases treated in the UK, whose cases were recruited over about 20 years through the UK Testicular Cancer Collaboration, a group of oncologists and surgeons treating the disease across the UK, and used in genome-wide association studies of testicular cancer susceptibility.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002517> (<http://www.ebi.ac.uk/coho/COHO_0002517>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22457820") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26387087") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22457820") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC3311578") Annotation(rdfs:comment "Department of Urology, University Hospital Ulm, Ulm, Germany, 2Institute of Human Genetics, University Hospital Ulm, Ulm, Germany") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002517> "A prostate cancer case-control study run by the Institute of Human Genetics and the Department of Urology of Ulm University Hospital, Germany. Familial cases were identified through family-history questionnaires sent by collaborating urologists throughout Germany, sporadic cases came from radical prostatectomy series at the Ulm urology clinic, and controls were men from Ulm without prostate cancer. It is used for linkage and association studies of inherited prostate cancer susceptibility and contributes to the PRACTICAL consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22457820") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26387087") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22457820") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3311578/fullTextXML") Annotation(rdfs:comment "From the Prostate Cancer Genetics Project of Ulm a total number of 377 familial and 325 sporadic cases were included.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002517> "A prostate cancer case-control study run by the Institute of Human Genetics and the Department of Urology of Ulm University Hospital, Germany. Familial cases were identified through family-history questionnaires sent by collaborating urologists throughout Germany, sporadic cases came from radical prostatectomy series at the Ulm urology clinic, and controls were men from Ulm without prostate cancer. It is used for linkage and association studies of inherited prostate cancer susceptibility and contributes to the PRACTICAL consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22457820") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26387087") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:26387087") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4596899/fullTextXML") Annotation(rdfs:comment "Participants in this study were men of European genotypic ancestry from 22 independent studies contributing to the international PRACTICAL Consortium (PRostate cancer AssoCiation group To Investigate Cancer-Associated aLterations in the genome, http://www.practical.ccge.medschl.cam.ac.uk) [25, 26].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002517> "A prostate cancer case-control study run by the Institute of Human Genetics and the Department of Urology of Ulm University Hospital, Germany. Familial cases were identified through family-history questionnaires sent by collaborating urologists throughout Germany, sporadic cases came from radical prostatectomy series at the Ulm urology clinic, and controls were men from Ulm without prostate cancer. It is used for linkage and association studies of inherited prostate cancer susceptibility and contributes to the PRACTICAL consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22457820") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26387087") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(rdfs:comment "age-matched controls (n=188): age- matched men without prostate cancer and negative family history collected in hospitals of Ulm") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002517> "A prostate cancer case-control study run by the Institute of Human Genetics and the Department of Urology of Ulm University Hospital, Germany. Familial cases were identified through family-history questionnaires sent by collaborating urologists throughout Germany, sporadic cases came from radical prostatectomy series at the Ulm urology clinic, and controls were men from Ulm without prostate cancer. It is used for linkage and association studies of inherited prostate cancer susceptibility and contributes to the PRACTICAL consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22457820") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26387087") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-018-0142-8/MediaObjects/41588_2018_142_MOESM1_ESM.pdf") Annotation(rdfs:comment "familial cases (n=162): identified through questionnaires for family history by collaborating urologists all over Germany; sporadic cases (n=308): prostatectomy series performed in the Clinic of Urology Ulm between 2012 and 2014") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002517> "A prostate cancer case-control study run by the Institute of Human Genetics and the Department of Urology of Ulm University Hospital, Germany. Familial cases were identified through family-history questionnaires sent by collaborating urologists throughout Germany, sporadic cases came from radical prostatectomy series at the Ulm urology clinic, and controls were men from Ulm without prostate cancer. It is used for linkage and association studies of inherited prostate cancer susceptibility and contributes to the PRACTICAL consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002521> (<http://www.ebi.ac.uk/coho/COHO_0002521>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2802/MediaObjects/41588_2013_BFng2802_MOESM27_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-024-02838-5/MediaObjects/41380_2024_2838_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2802/MediaObjects/41588_2013_BFng2802_MOESM27_ESM.pdf") Annotation(rdfs:comment "Cognitively healthy controls were unrelated individuals from the same catchment areas and frequency matched by age and gender, and had a documented MMSE or 3MS score in the normal range.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002521> "A case-control collection of late-onset Alzheimer's disease, whose cases met NINCDS-ADRDA criteria for probable or definite Alzheimer's disease with onset after age 60 and whose controls are cognitively healthy, unrelated people from the same catchment areas frequency-matched by age and sex, ascertained at the University of Miami, Vanderbilt University (later Case Western Reserve University) and Mount Sinai School of Medicine, including autopsy-confirmed cases and controls mainly from Mount Sinai; it is one of the datasets of the Alzheimer's Disease Genetics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2802/MediaObjects/41588_2013_BFng2802_MOESM27_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-024-02838-5/MediaObjects/41380_2024_2838_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2802/MediaObjects/41588_2013_BFng2802_MOESM27_ESM.pdf") Annotation(rdfs:comment "Detailed descriptions of the ascertainment and evaluation of subjects in the ADC, ADNI, UM/VU/MSSM, MIRAGE, and NCRAD/NIA-LOAD cohorts have been provided elsewhere [1]; brief descriptions included here note any differences between data used in this study and data used in the previously published ADGC study [1].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002521> "A case-control collection of late-onset Alzheimer's disease, whose cases met NINCDS-ADRDA criteria for probable or definite Alzheimer's disease with onset after age 60 and whose controls are cognitively healthy, unrelated people from the same catchment areas frequency-matched by age and sex, ascertained at the University of Miami, Vanderbilt University (later Case Western Reserve University) and Mount Sinai School of Medicine, including autopsy-confirmed cases and controls mainly from Mount Sinai; it is one of the datasets of the Alzheimer's Disease Genetics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2802/MediaObjects/41588_2013_BFng2802_MOESM27_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-024-02838-5/MediaObjects/41380_2024_2838_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2802/MediaObjects/41588_2013_BFng2802_MOESM27_ESM.pdf") Annotation(rdfs:comment "Each affected individual met NINCDS-ADRDA criteria for probably or definite AD with age at onset greater than 60 years as determined from specific probe questions within the clinical history provided by a reliable family informant or from documentation of significant cognitive impairment in the medical record.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002521> "A case-control collection of late-onset Alzheimer's disease, whose cases met NINCDS-ADRDA criteria for probable or definite Alzheimer's disease with onset after age 60 and whose controls are cognitively healthy, unrelated people from the same catchment areas frequency-matched by age and sex, ascertained at the University of Miami, Vanderbilt University (later Case Western Reserve University) and Mount Sinai School of Medicine, including autopsy-confirmed cases and controls mainly from Mount Sinai; it is one of the datasets of the Alzheimer's Disease Genetics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2802/MediaObjects/41588_2013_BFng2802_MOESM27_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-024-02838-5/MediaObjects/41380_2024_2838_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2802/MediaObjects/41588_2013_BFng2802_MOESM27_ESM.pdf") Annotation(rdfs:comment "The UM/VU/MSSM dataset contains 1,186 cases and 1,135 CNEs (new and previously published) [15, 16, 17, 18] ascertained at the University of Miami, Vanderbilt University and Mt. Sinai School of Medicine, including 409 autopsy-confirmed cases and 136 controls, primarily from the Mt. Sinai School of Medicine [19].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002521> "A case-control collection of late-onset Alzheimer's disease, whose cases met NINCDS-ADRDA criteria for probable or definite Alzheimer's disease with onset after age 60 and whose controls are cognitively healthy, unrelated people from the same catchment areas frequency-matched by age and sex, ascertained at the University of Miami, Vanderbilt University (later Case Western Reserve University) and Mount Sinai School of Medicine, including autopsy-confirmed cases and controls mainly from Mount Sinai; it is one of the datasets of the Alzheimer's Disease Genetics Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.2802/MediaObjects/41588_2013_BFng2802_MOESM27_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-024-02838-5/MediaObjects/41380_2024_2838_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41380-024-02838-5/MediaObjects/41380_2024_2838_MOESM1_ESM.pdf") Annotation(rdfs:comment "contains 1,177 cases and 1,126 CNEs ascertained at the University of Miami, Case Western Reserve University and Mt.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002521> "A case-control collection of late-onset Alzheimer's disease, whose cases met NINCDS-ADRDA criteria for probable or definite Alzheimer's disease with onset after age 60 and whose controls are cognitively healthy, unrelated people from the same catchment areas frequency-matched by age and sex, ascertained at the University of Miami, Vanderbilt University (later Case Western Reserve University) and Mount Sinai School of Medicine, including autopsy-confirmed cases and controls mainly from Mount Sinai; it is one of the datasets of the Alzheimer's Disease Genetics Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002522> (<http://www.ebi.ac.uk/coho/COHO_0002522>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms5613/MediaObjects/41467_2014_BFncomms5613_MOESM440_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3654676/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25105248") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms5613/MediaObjects/41467_2014_BFncomms5613_MOESM440_ESM.pdf") Annotation(rdfs:comment "Cases were identified using the North Carolina Central Cancer Registry.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002522> "The North Carolina site of the Cancer Care Outcomes Research and Surveillance (CanCORS) Consortium, run by the University of North Carolina at Chapel Hill: a prospective population-based cohort of patients with colorectal cancer diagnosed between April 2003 and January 2005 in counties of central and eastern North Carolina, United States, identified by rapid case ascertainment through the North Carolina Central Cancer Registry.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms5613/MediaObjects/41467_2014_BFncomms5613_MOESM440_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3654676/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25105248") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms5613/MediaObjects/41467_2014_BFncomms5613_MOESM440_ESM.pdf") Annotation(rdfs:comment "UNC_CanCORS assembled a prospective population-based cohort of colorectal cancer patients from a 33-county area in North Carolina diagnosed between April 2003 and January 2005.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002522> "The North Carolina site of the Cancer Care Outcomes Research and Surveillance (CanCORS) Consortium, run by the University of North Carolina at Chapel Hill: a prospective population-based cohort of patients with colorectal cancer diagnosed between April 2003 and January 2005 in counties of central and eastern North Carolina, United States, identified by rapid case ascertainment through the North Carolina Central Cancer Registry.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms5613/MediaObjects/41467_2014_BFncomms5613_MOESM440_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3654676/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3654676/unicode") Annotation(rdfs:comment "22 eastern/central counties") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002522> "The North Carolina site of the Cancer Care Outcomes Research and Surveillance (CanCORS) Consortium, run by the University of North Carolina at Chapel Hill: a prospective population-based cohort of patients with colorectal cancer diagnosed between April 2003 and January 2005 in counties of central and eastern North Carolina, United States, identified by rapid case ascertainment through the North Carolina Central Cancer Registry.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fncomms5613/MediaObjects/41467_2014_BFncomms5613_MOESM440_ESM.pdf") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3654676/unicode") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC3654676/unicode") Annotation(rdfs:comment "University of North Carolina, Chapel Hill [UNC] and University of California, Los Angeles [UCLA]) identified and enrolled participants using rapid case ascertainment (RCA) from cancer registries based on the geographic area in which the site was located.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002522> "The North Carolina site of the Cancer Care Outcomes Research and Surveillance (CanCORS) Consortium, run by the University of North Carolina at Chapel Hill: a prospective population-based cohort of patients with colorectal cancer diagnosed between April 2003 and January 2005 in counties of central and eastern North Carolina, United States, identified by rapid case ascertainment through the North Carolina Central Cancer Registry.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002524> (<http://www.ebi.ac.uk/coho/COHO_0002524>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18264013") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25031287") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25906364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26708676") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18264013") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18264013+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The aim of the Prognostic Modelling in Ischaemic Stroke study is to develop 2 different prognostic models on the basis of traditional vascular risk factors and genetic information in patients who have suffered from cerebral ischaemia of arterial origin, 1 concerning new ischaemic and the other new haemorrhagic events.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002524> "A cohort study of patients with non-disabling cerebral ischaemia of arterial origin referred to the University Medical Center Utrecht, the Netherlands, and included between 1994 and 2009 in the SMART study or the Utrecht Stroke Database, whose patients were genotyped with the Illumina Immunochip and followed up for new vascular events in order to test whether genetic information improves prognostic models for new ischaemic and haemorrhagic events. Its genotyped patients were also the Utrecht Immunochip case sample of genetic association studies of ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18264013") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25031287") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25906364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26708676") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25031287") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4150131/fullTextXML") Annotation(rdfs:comment "Genotyping for the PROMISe study (the Netherlands) was performed independently in Utrecht, the Netherlands.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002524> "A cohort study of patients with non-disabling cerebral ischaemia of arterial origin referred to the University Medical Center Utrecht, the Netherlands, and included between 1994 and 2009 in the SMART study or the Utrecht Stroke Database, whose patients were genotyped with the Illumina Immunochip and followed up for new vascular events in order to test whether genetic information improves prognostic models for new ischaemic and haemorrhagic events. Its genotyped patients were also the Utrecht Immunochip case sample of genetic association studies of ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18264013") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25031287") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25906364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26708676") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25906364") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4408031/fullTextXML") Annotation(rdfs:comment "These patients were included between April 1994 and May 2009.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002524> "A cohort study of patients with non-disabling cerebral ischaemia of arterial origin referred to the University Medical Center Utrecht, the Netherlands, and included between 1994 and 2009 in the SMART study or the Utrecht Stroke Database, whose patients were genotyped with the Illumina Immunochip and followed up for new vascular events in order to test whether genetic information improves prognostic models for new ischaemic and haemorrhagic events. Its genotyped patients were also the Utrecht Immunochip case sample of genetic association studies of ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18264013") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25031287") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25906364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26708676") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25906364") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4408031/fullTextXML") Annotation(rdfs:comment "We collected data of patients with non-disabling cerebral ischemia of arterial origin, who were referred to the University Medical Center Utrecht, The Netherlands and were included in the SMART (Second Manifestations of Arterial disease) study, or the Utrecht Stroke Database (USDB).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002524> "A cohort study of patients with non-disabling cerebral ischaemia of arterial origin referred to the University Medical Center Utrecht, the Netherlands, and included between 1994 and 2009 in the SMART study or the Utrecht Stroke Database, whose patients were genotyped with the Illumina Immunochip and followed up for new vascular events in order to test whether genetic information improves prognostic models for new ischaemic and haemorrhagic events. Its genotyped patients were also the Utrecht Immunochip case sample of genetic association studies of ischaemic stroke.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18264013") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25031287") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25906364") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:26708676") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25906364") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4408031/fullTextXML") Annotation(rdfs:comment "We studied 1020 patients with cerebral ischemia and genotyped them with the Illumina Immunochip.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002524> "A cohort study of patients with non-disabling cerebral ischaemia of arterial origin referred to the University Medical Center Utrecht, the Netherlands, and included between 1994 and 2009 in the SMART study or the Utrecht Stroke Database, whose patients were genotyped with the Illumina Immunochip and followed up for new vascular events in order to test whether genetic information improves prognostic models for new ischaemic and haemorrhagic events. Its genotyped patients were also the Utrecht Immunochip case sample of genetic association studies of ischaemic stroke.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002526> (<http://www.ebi.ac.uk/coho/COHO_0002526>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37845353") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf") Annotation(rdfs:comment "A prospective population-based case-control study which aims to find biomarkers for the cause and progression of AAA and investigate how persons with or without an AAA experience their health.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002526> "A prospective population-based case-control study of abdominal aortic aneurysm in Uppsala, Sweden, in which all 65-year-old men identified through the National Population Registry were invited to an ultrasound examination; it aims to find biomarkers for the cause and progression of abdominal aortic aneurysm and to investigate how people with and without an aneurysm experience their health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37845353") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf") Annotation(rdfs:comment "Additional AAA case cohorts from Oxford (UK), Uppsala (Sweden) and Utrecht (Netherlands) became available during the conduct of the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002526> "A prospective population-based case-control study of abdominal aortic aneurysm in Uppsala, Sweden, in which all 65-year-old men identified through the National Population Registry were invited to an ultrasound examination; it aims to find biomarkers for the cause and progression of abdominal aortic aneurysm and to investigate how people with and without an aneurysm experience their health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37845353") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs41588-023-01510-y/MediaObjects/41588_2023_1510_MOESM1_ESM.pdf") Annotation(rdfs:comment "All 65-year-old men, identified through the National Population Registry, were invited to an ultrasound examination.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002526> "A prospective population-based case-control study of abdominal aortic aneurysm in Uppsala, Sweden, in which all 65-year-old men identified through the National Population Registry were invited to an ultrasound examination; it aims to find biomarkers for the cause and progression of abdominal aortic aneurysm and to investigate how people with and without an aneurysm experience their health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002527> (<http://www.ebi.ac.uk/coho/COHO_0002527>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35077710") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40029246") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35077710") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8986577/") Annotation(rdfs:comment "Inclusion criteria for both cohorts were: prostate cancer diagnosis, curative-intent radiotherapy, no evidence of distant metastases, ability to provide a venous blood sample, ability to read/write in the primary language of the enrollment country and give informed consent.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002527> "A prospective, multicentre observational study of late radiotherapy toxicity that recruited men with prostate cancer without distant metastases who were scheduled for curative-intent radiotherapy (external beam radiotherapy with or without a brachytherapy boost, or brachytherapy alone) between April 2016 and March 2019 at two hospitals in the United States, the University of Rochester Wilmot Cancer Institute and the Medical College of Wisconsin; participants were enrolled before or in the first week of radiotherapy, followed with patient-reported outcomes (the Expanded Prostate Index Composite with added radiation-related questions) at the end of radiotherapy, at 6 months and yearly for up to four years, and genotyped genome-wide, to validate predictive models and biomarkers of toxicity such as hematuria.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35077710") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40029246") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35077710") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8986577/") Annotation(rdfs:comment "Participants were enrolled before or during the first week of radiotherapy and were assessed at the end of radiotherapy and annually (up to 3 years in REQUITE; up to 4 years in URWCI, which also included a 6-month assessment).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002527> "A prospective, multicentre observational study of late radiotherapy toxicity that recruited men with prostate cancer without distant metastases who were scheduled for curative-intent radiotherapy (external beam radiotherapy with or without a brachytherapy boost, or brachytherapy alone) between April 2016 and March 2019 at two hospitals in the United States, the University of Rochester Wilmot Cancer Institute and the Medical College of Wisconsin; participants were enrolled before or in the first week of radiotherapy, followed with patient-reported outcomes (the Expanded Prostate Index Composite with added radiation-related questions) at the end of radiotherapy, at 6 months and yearly for up to four years, and genotyped genome-wide, to validate predictive models and biomarkers of toxicity such as hematuria.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35077710") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40029246") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35077710") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8986577/") Annotation(rdfs:comment "The URWCI study recruited patients with prostate cancer between April 2016 and March 2019 from two hospitals in the United States (University of Rochester Wilmot Cancer Institute and the Medical College of Wisconsin).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002527> "A prospective, multicentre observational study of late radiotherapy toxicity that recruited men with prostate cancer without distant metastases who were scheduled for curative-intent radiotherapy (external beam radiotherapy with or without a brachytherapy boost, or brachytherapy alone) between April 2016 and March 2019 at two hospitals in the United States, the University of Rochester Wilmot Cancer Institute and the Medical College of Wisconsin; participants were enrolled before or in the first week of radiotherapy, followed with patient-reported outcomes (the Expanded Prostate Index Composite with added radiation-related questions) at the end of radiotherapy, at 6 months and yearly for up to four years, and genotyped genome-wide, to validate predictive models and biomarkers of toxicity such as hematuria.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35077710") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40029246") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35077710") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8986577/") Annotation(rdfs:comment "URWCI collected patient reported outcomes (PROs) using the Expanded Prostate Index Composite (EPIC)[15] supplemented with questions on radiation-related symptoms and quality of life.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002527> "A prospective, multicentre observational study of late radiotherapy toxicity that recruited men with prostate cancer without distant metastases who were scheduled for curative-intent radiotherapy (external beam radiotherapy with or without a brachytherapy boost, or brachytherapy alone) between April 2016 and March 2019 at two hospitals in the United States, the University of Rochester Wilmot Cancer Institute and the Medical College of Wisconsin; participants were enrolled before or in the first week of radiotherapy, followed with patient-reported outcomes (the Expanded Prostate Index Composite with added radiation-related questions) at the end of radiotherapy, at 6 months and yearly for up to four years, and genotyped genome-wide, to validate predictive models and biomarkers of toxicity such as hematuria.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35077710") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40029246") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40029246") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC12048210/") Annotation(rdfs:comment "Both studies included patients scheduled to receive standard-of-care radiotherapy (EBRT with or without brachytherapy boost or brachytherapy alone) with or without surgery and/or anti-androgen therapy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002527> "A prospective, multicentre observational study of late radiotherapy toxicity that recruited men with prostate cancer without distant metastases who were scheduled for curative-intent radiotherapy (external beam radiotherapy with or without a brachytherapy boost, or brachytherapy alone) between April 2016 and March 2019 at two hospitals in the United States, the University of Rochester Wilmot Cancer Institute and the Medical College of Wisconsin; participants were enrolled before or in the first week of radiotherapy, followed with patient-reported outcomes (the Expanded Prostate Index Composite with added radiation-related questions) at the end of radiotherapy, at 6 months and yearly for up to four years, and genotyped genome-wide, to validate predictive models and biomarkers of toxicity such as hematuria.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35077710") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40029246") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40029246") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC12048210/") Annotation(rdfs:comment "We show that it is associated with susceptibility to development of hematuria and other cystitis symptoms in the prospective, multicenter REQUITE and URWCI studies whose primary aim was to validate predictive models and biomarkers of late toxicity in patients treated with curative radiotherapy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002527> "A prospective, multicentre observational study of late radiotherapy toxicity that recruited men with prostate cancer without distant metastases who were scheduled for curative-intent radiotherapy (external beam radiotherapy with or without a brachytherapy boost, or brachytherapy alone) between April 2016 and March 2019 at two hospitals in the United States, the University of Rochester Wilmot Cancer Institute and the Medical College of Wisconsin; participants were enrolled before or in the first week of radiotherapy, followed with patient-reported outcomes (the Expanded Prostate Index Composite with added radiation-related questions) at the end of radiotherapy, at 6 months and yearly for up to four years, and genotyped genome-wide, to validate predictive models and biomarkers of toxicity such as hematuria.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0002528> (<http://www.ebi.ac.uk/coho/COHO_0002528>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21575228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21575228") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3119192/fullTextXML") Annotation(rdfs:comment "Data are systematically collected, including demographic characteristics, information on medication use, laboratory data, and reports of clinical events with medical record confirmation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002528> "A prospective observational cohort, enrolling since 1986, of consenting United States military members, retirees and beneficiaries aged 18 years or older with HIV, who are seen about every six months at participating US military treatment facilities, with systematic collection of demographic characteristics, medication use, laboratory data and medically confirmed clinical events.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21575228") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21575228") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3119192/fullTextXML") Annotation(rdfs:comment "Individuals are seen approximately every 6 months at participating United States military treatment facilities.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002528> "A prospective observational cohort, enrolling since 1986, of consenting United States military members, retirees and beneficiaries aged 18 years or older with HIV, who are seen about every six months at participating US military treatment facilities, with systematic collection of demographic characteristics, medication use, laboratory data and medically confirmed clinical events.")
