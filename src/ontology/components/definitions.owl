# Individual: <http://www.ebi.ac.uk/coho/COHO_0000268> (<http://www.ebi.ac.uk/coho/COHO_0000268>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002271") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002271") Annotation(rdfs:comment "Carcinosarcomas of the female genital tract, or GCS, are uncommon but clinically highly aggressive neoplasms with biphasic histology of carcinomatous (C) and sarcomatous (S) elements.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000268> "A collection of 20 carcinosarcomas of the endometrium or ovary whose carcinomatous and sarcomatous components were characterised by whole-genome sequencing, RNA sequencing and methylome arrays within the International Cancer Genome Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002271") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002271") Annotation(rdfs:comment "The aim of ICGC GCS program is to genomically characterize C and S components of 20 tumors, from endometrium or ovary, through an integrative analysis of whole genome sequencing, RNA sequencing and methylome array.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000268> "A collection of 20 carcinosarcomas of the endometrium or ovary whose carcinomatous and sarcomatous components were characterised by whole-genome sequencing, RNA sequencing and methylome arrays within the International Cancer Genome Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000269> (<http://www.ebi.ac.uk/coho/COHO_0000269>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000249") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000249") Annotation(rdfs:comment "As a part of the ICGC, India has undertaken genomic studies on gingivobuccal cancer of the oral cavity, which is the most prevalent form of cancer among men in India.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000269> "A collection of paired tumour and blood DNA samples from patients with gingivobuccal cancer of the oral cavity, the most prevalent cancer among men in India, recruited at the Advanced Centre for Research, Treatment and Education on Cancer in Mumbai for India's contribution to the International Cancer Genome Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000249") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000249") Annotation(rdfs:comment "Detailed clinical characterization of the patients, collection of data on demographic and environmental exposures, and isolation of DNA samples from blood and tumor tissues collected from each patient are being done at the Advanced Centre for Research, Treatment and Education on Cancer, Mumbai.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000269> "A collection of paired tumour and blood DNA samples from patients with gingivobuccal cancer of the oral cavity, the most prevalent cancer among men in India, recruited at the Advanced Centre for Research, Treatment and Education on Cancer in Mumbai for India's contribution to the International Cancer Genome Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000249") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000249") Annotation(rdfs:comment "Paired DNA samples – isolated from the tumor tissue and from the blood of fifty patients – have been analyzed to catalog germline and somatic mutations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000269> "A collection of paired tumour and blood DNA samples from patients with gingivobuccal cancer of the oral cavity, the most prevalent cancer among men in India, recruited at the Advanced Centre for Research, Treatment and Education on Cancer in Mumbai for India's contribution to the International Cancer Genome Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000270> (<http://www.ebi.ac.uk/coho/COHO_0000270>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002218") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002218") Annotation(rdfs:comment "Genomic analysis is conducted to identify genetic alterations in driver genes which are all druggable targets for cancer therapy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000270> "A collection of 88 hepatocellular carcinomas with matched adjacent normal tissue whose genomes were sequenced within the International Cancer Genome Consortium's Chinese liver cancer project to identify alterations in druggable driver genes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002218") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002218") Annotation(rdfs:comment "The Landscape of Genetic Alterations in Hepatocellular Carcinoma, 88 matched HCC tumour/normal pairs WGS belongs to ICGC LICA-CN project") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000270> "A collection of 88 hepatocellular carcinomas with matched adjacent normal tissue whose genomes were sequenced within the International Cancer Genome Consortium's Chinese liver cancer project to identify alterations in druggable driver genes.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002218") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001002218") Annotation(rdfs:comment "Whole genome shotgun sequencing (WGS) and the landscaple of somatic mutations in 88 paired samples from HCC patients including tumors and matched adjacent normal tissues using Illumina HiSeq 2000 platform were performed.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000270> "A collection of 88 hepatocellular carcinomas with matched adjacent normal tissue whose genomes were sequenced within the International Cancer Genome Consortium's Chinese liver cancer project to identify alterations in druggable driver genes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000271> (<http://www.ebi.ac.uk/coho/COHO_0000271>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000394") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33953289") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8257491/fullTextXML") Annotation(rdfs:comment "We identified 4538 clusters of very high mutation density (termed kataegis clusters) [27, 28] in 219 lymphoma genomes (consisting of 179 genomes from this study plus 39 pediatric BLs [17] and one adult BL, Supplementary Table S2)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000271> "A collection of germinal-centre B-cell derived lymphomas, including Burkitt, follicular and diffuse large B-cell lymphomas from children and adults, sequenced by the German ICGC MMML-Seq project of the International Cancer Genome Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000394") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35522148") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://haematologica.org/article/view/haematol.2021.280005") Annotation(rdfs:comment "we here mined data from whole genome sequencing (WGS) of 186 GC-derived B-cell lymphomas and 183 corresponding germline DNA samples generated by us in the framework of the International Cancer Genome Consortium (ICGC) Molecular Mechanisms in Malignant Lymphoma by Sequencing (MMML-Seq) project") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000271> "A collection of germinal-centre B-cell derived lymphomas, including Burkitt, follicular and diffuse large B-cell lymphomas from children and adults, sequenced by the German ICGC MMML-Seq project of the International Cancer Genome Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000394") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000394") Annotation(rdfs:comment "Germinal-center B-cell derived lymphomas (GCB-lymphomas) are the most common B-cell lymphomas in children and adults, with Burkitt Lymphomas (BL) predominating in childhood and follicular lymphoma (FL) and diffuse large B-cell lymphomas (DLBCL) predominating in older age groups.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000271> "A collection of germinal-centre B-cell derived lymphomas, including Burkitt, follicular and diffuse large B-cell lymphomas from children and adults, sequenced by the German ICGC MMML-Seq project of the International Cancer Genome Consortium.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000394") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000394") Annotation(rdfs:comment "In the framework of the German ICGC MMML-Seq we are currently exploring sequencing data of GCB-lymphomas and paired normal controls as well as normal B-cell subsets separated by FACS.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000271> "A collection of germinal-centre B-cell derived lymphomas, including Burkitt, follicular and diffuse large B-cell lymphomas from children and adults, sequenced by the German ICGC MMML-Seq project of the International Cancer Genome Consortium.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000272> (<http://www.ebi.ac.uk/coho/COHO_0000272>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000725") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37454136") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10349863/fullTextXML") Annotation(rdfs:comment "A cohort was assembled comprising 161 Barrett, 777 OACs and 59 metastatic samples that had been collected through a multicentre UK wide study called OCCAMS (Oesophageal Cancer Classification And Molecular Stratification) and undergone whole genome sequencing (WGS) as part of the ICGC-International Cancer Genome Consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000272> "A collection of oesophageal adenocarcinoma tumours, Barrett's oesophagus and lymph-node samples with matched normal DNA, gathered through the UK-wide OCCAMS hospital network for the International Cancer Genome Consortium to catalogue somatic mutations in this cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000725") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000725") Annotation(rdfs:comment "The primary aims of this project are to deeply sequence tumour and normal genomic DNA (including the precursor condition Barrett’s oesophagus when material is available) to provide a comprehensive catalogue of somatic mutations.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000272> "A collection of oesophageal adenocarcinoma tumours, Barrett's oesophagus and lymph-node samples with matched normal DNA, gathered through the UK-wide OCCAMS hospital network for the International Cancer Genome Consortium to catalogue somatic mutations in this cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000725") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000725") Annotation(rdfs:comment "This will be achieved through a UK-wide network of hospitals involved in a research collaboration called the OCCAMS consortium.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000272> "A collection of oesophageal adenocarcinoma tumours, Barrett's oesophagus and lymph-node samples with matched normal DNA, gathered through the UK-wide OCCAMS hospital network for the International Cancer Genome Consortium to catalogue somatic mutations in this cancer.")
