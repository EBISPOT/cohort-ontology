AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000929") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000929") Annotation(rdfs:comment "Using a sequencing-based approach, the Genome Diversity in Africa Project (GDAP) aims to produce a comprehensive catalogue of human genetic variation in SSA, including single nucleotide polymorphisms (SNPs), structural variants, and haplotypes.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000257> "A project of the African Partnership for Chronic Disease Research that performs high-depth whole-genome sequencing of individuals from ethnolinguistic groups across sub-Saharan Africa to catalogue human genetic variation on the continent.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000929") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001003602") Annotation(rdfs:comment "Currently, 25 individuals from 24 ethnolinguistic groups have been whole-genome sequenced at high depth totalling 585 individuals.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000257> "A project of the African Partnership for Chronic Disease Research that performs high-depth whole-genome sequencing of individuals from ethnolinguistic groups across sub-Saharan Africa to catalogue human genetic variation on the continent.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000929") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.hra.nhs.uk/planning-and-improving-research/application-summaries/research-summaries/the-genome-diversity-in-africa-project-gdap/") Annotation(rdfs:comment "The GDAP will gather, combine and compare genomic data from several independent studies comprising ethnolinguistic groups across Africa, including population groups from South Africa, Tanzania, Uganda, Ethiopia, Ghana, Nigeria and Burkina Faso.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000257> "A project of the African Partnership for Chronic Disease Research that performs high-depth whole-genome sequencing of individuals from ethnolinguistic groups across sub-Saharan Africa to catalogue human genetic variation on the continent.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000258> (<http://www.ebi.ac.uk/coho/COHO_0000258>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003424") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001003424") Annotation(rdfs:comment "Genotyping was carried out using the 815K Axiom Spain Biobank array (Affymetrix.) in the Spanish national center for genotyping (CEGEN, Santiago de Compostela, Spain).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000258> "A cohort of 4,120 Alzheimer's disease cases diagnosed at the Fundació ACE Memory Clinic in Barcelona and 3,289 controls from Spanish collections, genotyped genome-wide to study Alzheimer's disease susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003424") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001003424") Annotation(rdfs:comment "The GR@ACE study comprises 7,409 unrelated individuals. 4,120 AD cases were diagnosed at Fundació ACE Memory Clinic (Barcelona, Spain). 3,289 Controls were obtained from three collections (Fundació ACE, Barcelona; DNA National Biobank, Salamanca and HU Valme, Seville).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000258> "A cohort of 4,120 Alzheimer's disease cases diagnosed at the Fundació ACE Memory Clinic in Barcelona and 3,289 controls from Spanish collections, genotyped genome-wide to study Alzheimer's disease susceptibility.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003424") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001003424") Annotation(rdfs:comment "The Genome Research program at Fundacio ACE (GR@ACE, Barcelona, Spain), represents a new effort to study Alzheimer's Disease susceptibility.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000258> "A cohort of 4,120 Alzheimer's disease cases diagnosed at the Fundació ACE Memory Clinic in Barcelona and 3,289 controls from Spanish collections, genotyped genome-wide to study Alzheimer's disease susceptibility.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000259> (<http://www.ebi.ac.uk/coho/COHO_0000259>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007786") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38897207") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11293594/fullTextXML") Annotation(rdfs:comment "The UK Genomic Advances in Sepsis (GAinS) study has recruited a cohort of >1,400 patients with sepsis due to community-acquired pneumonia (CAP) and fecal peritonitis (FP), admitted to adult intensive care units (ICUs) across the United Kingdom.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000259> "A biobank of adult patients with sepsis due to community-acquired pneumonia or faecal peritonitis recruited from 35 hospitals across the United Kingdom during 2005–2018, with samples for functional genomics and detailed clinical data collected over the first days of intensive care.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007786") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007786") Annotation(rdfs:comment "Patients with sepsis due to community acquired pneumonia or faecal peritonitis were recruited from 35 hospitals across the UK from 2005-2018, with samples for functional genomics and detailed clinical information collected over the first five days of ICU admission.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000259> "A biobank of adult patients with sepsis due to community-acquired pneumonia or faecal peritonitis recruited from 35 hospitals across the United Kingdom during 2005–2018, with samples for functional genomics and detailed clinical data collected over the first days of intensive care.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001007786") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001007786") Annotation(rdfs:comment "This cohort comprises a subset of pateints enrolled in the Genomic Advances in Sepsis (GAinS) study, an established biobank of adult sepsis patients.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000259> "A biobank of adult patients with sepsis due to community-acquired pneumonia or faecal peritonitis recruited from 35 hospitals across the United Kingdom during 2005–2018, with samples for functional genomics and detailed clinical data collected over the first days of intensive care.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000260> (<http://www.ebi.ac.uk/coho/COHO_0000260>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005836") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30561127") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6396349/fullTextXML") Annotation(rdfs:comment "A DKTK coordinating bureau, which was established at the core center DKFZ in Heidelberg, supports and manages all scientific, administrative, and financial activities and processes, cooperating closely with the DKFZ administration department and local DKTK coordinators at all partner sites.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000260> "A consortium of German cancer centres, coordinated by the German Cancer Research Center in Heidelberg, that runs joint translational research programmes such as the DKTK MASTER precision oncology cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005836") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30561127") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6396349/fullTextXML") Annotation(rdfs:comment "Specific themes are addressed within currently five research programs, overall covering a number of innovative discovery research themes, forward and reverse preclinical programs, and early clinical studies (Table 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000260> "A consortium of German cancer centres, coordinated by the German Cancer Research Center in Heidelberg, that runs joint translational research programmes such as the DKTK MASTER precision oncology cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005836") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30561127") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30561127+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The German Cancer Consortium ('Deutsches Konsortium für Translationale Krebsforschung', DKTK) is a long-term cancer consortium, bringing together the German Cancer Research Center (DKFZ), Germany's largest life science research center, and the leading University Medical Center-based Comprehensive Cancer Centers (CCCs) at seven sites across Germany.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000260> "A consortium of German cancer centres, coordinated by the German Cancer Research Center in Heidelberg, that runs joint translational research programmes such as the DKTK MASTER precision oncology cohort.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005836") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001005836") Annotation(rdfs:comment "We analyzed the molecular profiles and clinical outcomes of pazopanib-treated sarcoma patients enrolled in a prospective observational study by the German Cancer Consortium, DKTK MASTER, that employs whole-genome/exome sequencing (WGS/WES) and transcriptome sequencing to inform the care of adults with advanced cancer") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000260> "A consortium of German cancer centres, coordinated by the German Cancer Research Center in Heidelberg, that runs joint translational research programmes such as the DKTK MASTER precision oncology cohort.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000261> (<http://www.ebi.ac.uk/coho/COHO_0000261>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001000079") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001000079") Annotation(rdfs:comment "The experiment will use the early onset patients from the German MI cohort and the UK BHF CAD/MI cohort both of which have strong family history.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000261> "A collection of German patients with early-onset myocardial infarction and a strong family history of coronary artery disease, used with the UK BHF CAD/MI cohort as the case set of the Cardiogenics re-sequencing study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000262> (<http://www.ebi.ac.uk/coho/COHO_0000262>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005973") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001005973") Annotation(rdfs:comment "Genomic profiling revealed RAS mutations and structural variants involving the BRAF locus to be drivers of resistance to BRAF/MEK inhibition in RRMM.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000262> "A cohort of twelve patients with relapsed or refractory multiple myeloma carrying an activating BRAF V600E mutation, enrolled in the German-speaking Myeloma Multicenter Group's phase II trial of encorafenib and binimetinib and genomically profiled to identify drivers of resistance.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005973") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001005973") Annotation(rdfs:comment "This multicenter phase II trial assessed the efficacy and safety of the BRAF/MEK inhibitors, encorafenib and binimetinib, in patients with relapsed/refractory multiple myeloma (RRMM) carrying an activating BRAFV600E mutation.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000262> "A cohort of twelve patients with relapsed or refractory multiple myeloma carrying an activating BRAF V600E mutation, enrolled in the German-speaking Myeloma Multicenter Group's phase II trial of encorafenib and binimetinib and genomically profiled to identify drivers of resistance.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005973") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001005973") Annotation(rdfs:comment "Twelve RRMM patients with a median of five prior lines of therapy were enrolled.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000262> "A cohort of twelve patients with relapsed or refractory multiple myeloma carrying an activating BRAF V600E mutation, enrolled in the German-speaking Myeloma Multicenter Group's phase II trial of encorafenib and binimetinib and genomically profiled to identify drivers of resistance.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000263> (<http://www.ebi.ac.uk/coho/COHO_0000263>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002123") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25775251") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4361691/fullTextXML") Annotation(rdfs:comment "The GHS aims to assess the prevalence and incidence of cardiovascular, metabolic, ophthalmological and mental disorders in the population of the city of Mainz and the Mainz-Bingen district in the mid-western part of Germany (Rhine-Main region).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000263> "A population-based cohort of adults from Mainz and the Mainz-Bingen district in Germany, recruited from 2007 and followed with cardiovascular, metabolic, ophthalmological and psychological phenotyping to investigate the determinants of cardiovascular and other common diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002123") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:25775251") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC4361691/fullTextXML") Annotation(rdfs:comment "The primary goal of the study is to improve the prediction of disease by taking into account psychosocial, environmental and lifestyle risk factors, subclinical disease, protein pattern and genetic variants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000263> "A population-based cohort of adults from Mainz and the Mainz-Bingen district in Germany, recruited from 2007 and followed with cardiovascular, metabolic, ophthalmological and psychological phenotyping to investigate the determinants of cardiovascular and other common diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002123") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34424371") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34424371+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Gutenberg Health Study (GHS) is a population-based, prospective, observational cohort study in Germany that includes 15,010 participants between 35 and 74 years of age.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000263> "A population-based cohort of adults from Mainz and the Mainz-Bingen district in Germany, recruited from 2007 and followed with cardiovascular, metabolic, ophthalmological and psychological phenotyping to investigate the determinants of cardiovascular and other common diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001002123") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34424371") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A34424371+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The baseline examination, including fundus photography, was conducted between 2007 and 2012, and the 5-year follow-up examination was performed between 2012 and 2017.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000263> "A population-based cohort of adults from Mainz and the Mainz-Bingen district in Germany, recruited from 2007 and followed with cardiovascular, metabolic, ophthalmological and psychological phenotyping to investigate the determinants of cardiovascular and other common diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000264> (<http://www.ebi.ac.uk/coho/COHO_0000264>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005953") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29618056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6005016/fullTextXML") Annotation(rdfs:comment "HMRN’s catchment covers two such adjacent Cancer Networks: the Yorkshire Cancer Network and the Humber & Yorkshire Coast Cancer Network.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000264> "A population-based cohort of all patients newly diagnosed with a haematological malignancy since 2004 within two adjacent United Kingdom cancer networks covering about four million people, diagnosed by a single integrated laboratory and followed with treatment and outcome data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005953") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29618056") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6005016/fullTextXML") Annotation(rdfs:comment "In addition to these electronic data feeds, disease-specific templates are used to abstract additional primary source data in the clinical setting; the information collected includes individual components of staging investigations, copies of scans, performance scores and treatments (including stem cell transplants), with response and outcome being recorded for all episodes along the pathway.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000264> "A population-based cohort of all patients newly diagnosed with a haematological malignancy since 2004 within two adjacent United Kingdom cancer networks covering about four million people, diagnosed by a single integrated laboratory and followed with treatment and outcome data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005953") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35134983") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9189975/fullTextXML") Annotation(rdfs:comment "All diagnoses are made and coded using the World Health Organization’s latest International Diseases for Oncology classification by haematopathologists at a single fully integrated laboratory.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000264> "A population-based cohort of all patients newly diagnosed with a haematological malignancy since 2004 within two adjacent United Kingdom cancer networks covering about four million people, diagnosed by a single integrated laboratory and followed with treatment and outcome data.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001005953") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35134983") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9189975/fullTextXML") Annotation(rdfs:comment "Established in 2004, the Haematological Malignancy Research Network is an ongoing population-based UK cohort that is currently tracking 38 000 people diagnosed with a blood cancer or related disorder.Covering a population of ∼4 million people (14 hospitals), each year ∼2500 people enter the cohort (irrespective of age or prognosis) on the day they are diagnosed.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000264> "A population-based cohort of all patients newly diagnosed with a haematological malignancy since 2004 within two adjacent United Kingdom cancer networks covering about four million people, diagnosed by a single integrated laboratory and followed with treatment and outcome data.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000265> (<http://www.ebi.ac.uk/coho/COHO_0000265>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006390") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17049075") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1626086/fullTextXML") Annotation(rdfs:comment "The HAPIEE (Health, Alcohol and Psychosocial factors In Eastern Europe) study is a prospective cohort study designed to investigate the effect of classical and non-conventional risk factors and social and psychosocial factors on cardiovascular and other non-communicable diseases in eastern Europe and the FSU.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000265> "A prospective cohort study of urban adults in the Czech Republic, Poland, Russia and Lithuania designed to investigate the effect of classical, non-conventional, social and psychosocial risk factors on cardiovascular and other non-communicable diseases in eastern Europe and the former Soviet Union.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006390") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17049075") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1626086/fullTextXML") Annotation(rdfs:comment "The HAPIEE study comprises four cohorts in Russia, Poland, the Czech Republic and Lithuania; each consists of a random sample of men and women aged 45–69 years old at baseline, stratified by gender and 5 year age groups, and selected from population registers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000265> "A prospective cohort study of urban adults in the Czech Republic, Poland, Russia and Lithuania designed to investigate the effect of classical, non-conventional, social and psychosocial risk factors on cardiovascular and other non-communicable diseases in eastern Europe and the former Soviet Union.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001006390") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35902678") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9334616/fullTextXML") Annotation(rdfs:comment "We used the prospective population-based HAPIEE cohort that includes randomly selected people with a mean age of 59 ± 7.3 years from population registers in Czech, Polish, Russian and Lithuanian urban centres.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000265> "A prospective cohort study of urban adults in the Czech Republic, Poland, Russia and Lithuania designed to investigate the effect of classical, non-conventional, social and psychosocial risk factors on cardiovascular and other non-communicable diseases in eastern Europe and the former Soviet Union.")

