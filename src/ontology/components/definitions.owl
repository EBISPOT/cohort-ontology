AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:24323821") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:24323821") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4591050/unicode") Annotation(rdfs:comment "Eligibility criteria for the study participants were as follows: permanent resident of urban Shanghai, no prior history of any cancer, aged 25-65 years for phase I, or aged 25–70 years for phase II.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000795> "A population-based case-control study of breast cancer among women aged 25–70 who were permanent residents of urban Shanghai, China, recruited in two phases (August 1996–March 1998 and April 2002–February 2005).")
