AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8064143/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34791242") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9071440/fullTextXML") Annotation(rdfs:comment "In short, we included 34 130 participants from four population-based studies, namely the UK Biobank (20) (N = 28 919), the Austrian Stroke Prevention Study (ASPS) (N = 183), the ASPS Family Study (ASPS-Fam) (21,22) (N = 302) and the Rotterdam Study (23,24) (N = 4726).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000857> "A prospective single-centre population-based study of community-dwelling elderly people without stroke or dementia, randomly selected from the community register of Graz, Austria, and enrolled between 1991 and 2004, examining the effects of vascular risk factors on brain structure and function in normal ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8064143/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8064143/fullTextXML") Annotation(rdfs:comment "Randomly selected individuals from the community register of the city of Graz, Austria, were enrolled between 1991 and 2004.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000857> "A prospective single-centre population-based study of community-dwelling elderly people without stroke or dementia, randomly selected from the community register of Graz, Austria, and enrolled between 1991 and 2004, examining the effects of vascular risk factors on brain structure and function in normal ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8064143/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8064143/fullTextXML") Annotation(rdfs:comment "The ASPS is a prospective single-centre study examining the effects of vascular risk factors on brain structure and function [26, 27].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000857> "A prospective single-centre population-based study of community-dwelling elderly people without stroke or dementia, randomly selected from the community register of Graz, Austria, and enrolled between 1991 and 2004, examining the effects of vascular risk factors on brain structure and function in normal ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8064143/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8064143/fullTextXML") Annotation(rdfs:comment "The study population was assembled by community-dwelling elderly individuals with normal neurological status and without history of stroke and dementia from the Austrian Stroke Prevention Study (ASPS) and the Austrian Stroke Prevention Family Study (ASPS-Fam).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000857> "A prospective single-centre population-based study of community-dwelling elderly people without stroke or dementia, randomly selected from the community register of Graz, Austria, and enrolled between 1991 and 2004, examining the effects of vascular risk factors on brain structure and function in normal ageing.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8064143/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8751593/fullTextXML") Annotation(rdfs:comment "The ASPS is a prospective single-centre community-based study established in 1991 on the cerebral effects of vascular risk factors in the normal aged population of the city of Graz, Austria.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000857> "A prospective single-centre population-based study of community-dwelling elderly people without stroke or dementia, randomly selected from the community register of Graz, Austria, and enrolled between 1991 and 2004, examining the effects of vascular risk factors on brain structure and function in normal ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000858> (<http://www.ebi.ac.uk/coho/COHO_0000858>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34923481") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35951362") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35951362") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9467397/fullTextXML") Annotation(rdfs:comment "A total of 419 individuals from 176 families were included in the study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000858> "A family-based extension of the Austrian Stroke Prevention Study in Graz, Austria, for which ASPS participants and their first-degree relatives were invited between 2006 and 2013 (419 individuals from 176 families), examined with clinical history, neurological examination, brain MRI, laboratory tests, cognitive testing and vascular risk factor assessment to study the cerebral effects of vascular risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34923481") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35951362") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35951362") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9467397/fullTextXML") Annotation(rdfs:comment "Between 2006 and 2013, study participants of the ASPS and their first-degree relatives were invited to join the ASPS-Fam.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000858> "A family-based extension of the Austrian Stroke Prevention Study in Graz, Austria, for which ASPS participants and their first-degree relatives were invited between 2006 and 2013 (419 individuals from 176 families), examined with clinical history, neurological examination, brain MRI, laboratory tests, cognitive testing and vascular risk factor assessment to study the cerebral effects of vascular risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34923481") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35951362") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35951362") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9467397/fullTextXML") Annotation(rdfs:comment "The ASPS-Fam is a prospective single-center community-based study on the cerebral effects of vascular risk factors in residents of the city of Graz, Austria, without clinical signs and symptoms of stroke and dementia and a normal neurological examination [7, 25].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000858> "A family-based extension of the Austrian Stroke Prevention Study in Graz, Austria, for which ASPS participants and their first-degree relatives were invited between 2006 and 2013 (419 individuals from 176 families), examined with clinical history, neurological examination, brain MRI, laboratory tests, cognitive testing and vascular risk factor assessment to study the cerebral effects of vascular risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34923481") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35951362") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35951362") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9467397/fullTextXML") Annotation(rdfs:comment "The ASPS-Fam is an extension of the Austrian Stroke Prevention Study (ASPS), which was established in 1991 [51, 52].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000858> "A family-based extension of the Austrian Stroke Prevention Study in Graz, Austria, for which ASPS participants and their first-degree relatives were invited between 2006 and 2013 (419 individuals from 176 families), examined with clinical history, neurological examination, brain MRI, laboratory tests, cognitive testing and vascular risk factor assessment to study the cerebral effects of vascular risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34923481") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35951362") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8751593/fullTextXML") Annotation(rdfs:comment "Between 2006 and 2013 study participants underwent thorough clinical history taking and neurological examination, magnetic resonance imaging (MRI), laboratory evaluation and cognitive testing accompanied by a comprehensive vascular risk factor assessment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000858> "A family-based extension of the Austrian Stroke Prevention Study in Graz, Austria, for which ASPS participants and their first-degree relatives were invited between 2006 and 2013 (419 individuals from 176 families), examined with clinical history, neurological examination, brain MRI, laboratory tests, cognitive testing and vascular risk factor assessment to study the cerebral effects of vascular risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000859> (<http://www.ebi.ac.uk/coho/COHO_0000859>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22136481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22136481") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3266639/fullTextXML") Annotation(rdfs:comment "Most participants were recruited via the registries of municipalities in the area of the research centres by inviting all inhabitants aged 65 years and older by mail.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000859> "A randomized, double-blind, placebo-controlled trial of 2,919 people aged 65 and older with elevated homocysteine, recruited in 2008–2011 mainly through municipal registries around research centres in Rotterdam, Amsterdam and Wageningen, the Netherlands, testing whether two years of vitamin B12 and folic acid supplementation reduce osteoporotic fracture incidence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22136481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22136481") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3266639/fullTextXML") Annotation(rdfs:comment "Recruitment took place from August 2008 until March 2011.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000859> "A randomized, double-blind, placebo-controlled trial of 2,919 people aged 65 and older with elevated homocysteine, recruited in 2008–2011 mainly through municipal registries around research centres in Rotterdam, Amsterdam and Wageningen, the Netherlands, testing whether two years of vitamin B12 and folic acid supplementation reduce osteoporotic fracture incidence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22136481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22136481") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3266639/fullTextXML") Annotation(rdfs:comment "The B-PROOF (B-Vitamins for the PRevention Of Osteoporotic Fractures) study is a randomized double-blind placebo-controlled trial.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000859> "A randomized, double-blind, placebo-controlled trial of 2,919 people aged 65 and older with elevated homocysteine, recruited in 2008–2011 mainly through municipal registries around research centres in Rotterdam, Amsterdam and Wageningen, the Netherlands, testing whether two years of vitamin B12 and folic acid supplementation reduce osteoporotic fracture incidence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22136481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22136481") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3266639/fullTextXML") Annotation(rdfs:comment "The intervention comprises a period of two years, and includes 2919 subjects, aged 65 years and older, independently living or institutionalized, with an elevated homocysteine concentration (≥ 12 μmol/L).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000859> "A randomized, double-blind, placebo-controlled trial of 2,919 people aged 65 and older with elevated homocysteine, recruited in 2008–2011 mainly through municipal registries around research centres in Rotterdam, Amsterdam and Wageningen, the Netherlands, testing whether two years of vitamin B12 and folic acid supplementation reduce osteoporotic fracture incidence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22136481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22136481") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3266639/fullTextXML") Annotation(rdfs:comment "This large multi-center project is carried out by a consortium from the Erasmus MC (Rotterdam, the Netherlands), VUmc (Amsterdam, the Netherlands) and Wageningen University, (Wageningen, the Netherlands), the latter acting as coordinator.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000859> "A randomized, double-blind, placebo-controlled trial of 2,919 people aged 65 and older with elevated homocysteine, recruited in 2008–2011 mainly through municipal registries around research centres in Rotterdam, Amsterdam and Wageningen, the Netherlands, testing whether two years of vitamin B12 and folic acid supplementation reduce osteoporotic fracture incidence.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22136481") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fs42003-023-04869-0/MediaObjects/42003_2023_4869_MOESM2_ESM.pdf") Annotation(rdfs:comment "BPROOF: B-PROOF is a trial investigating the effect of 2-year supplementation with 400 mcg folic acid and 500 mcg vitamin B12 on fracture incidence in hyperhomoycsteinemic persons aged 65y and older.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000859> "A randomized, double-blind, placebo-controlled trial of 2,919 people aged 65 and older with elevated homocysteine, recruited in 2008–2011 mainly through municipal registries around research centres in Rotterdam, Amsterdam and Wageningen, the Netherlands, testing whether two years of vitamin B12 and folic acid supplementation reduce osteoporotic fracture incidence.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000860> (<http://www.ebi.ac.uk/coho/COHO_0000860>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29891475") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/about/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/cohorts/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29891475") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://europepmc.org/api/getPdf?pmcid=PMC5995593") Annotation(rdfs:comment "Participants were enrolled in the study and core information obtained using 2 approaches: attendance at a study assessment centre for all study measures (questionnaire, venous blood sample and physical measurements) or completion of the core questionnaire (online or paper), with later collection of other study measures where possible.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000860> "A pan-Canadian prospective cohort platform, established by the Canadian Partnership Against Cancer in June 2008 as the Canadian Partnership for Tomorrow Project, that federates regional cohorts (seven across ten provinces, among them CARTaGENE and the Ontario Health Study; 307,017 participants aged 30–74 from 8 provinces in five cohorts in its 2018 profile) with harmonized questionnaire, physical measurement and biosample data and linkage to administrative health databases, to study how genetics, behaviour and environment affect cancer and other chronic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29891475") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/about/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/cohorts/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29891475") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29891475+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A total of 307 017 participants aged 30-74 from 8 provinces were recruited.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000860> "A pan-Canadian prospective cohort platform, established by the Canadian Partnership Against Cancer in June 2008 as the Canadian Partnership for Tomorrow Project, that federates regional cohorts (seven across ten provinces, among them CARTaGENE and the Ontario Health Study; 307,017 participants aged 30–74 from 8 provinces in five cohorts in its 2018 profile) with harmonized questionnaire, physical measurement and biosample data and linkage to administrative health databases, to study how genetics, behaviour and environment affect cancer and other chronic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29891475") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/about/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/cohorts/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29891475") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29891475+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Participants consented to passive follow-up through linkage with administrative health databases and active follow-up through recontact.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000860> "A pan-Canadian prospective cohort platform, established by the Canadian Partnership Against Cancer in June 2008 as the Canadian Partnership for Tomorrow Project, that federates regional cohorts (seven across ten provinces, among them CARTaGENE and the Ontario Health Study; 307,017 participants aged 30–74 from 8 provinces in five cohorts in its 2018 profile) with harmonized questionnaire, physical measurement and biosample data and linkage to administrative health databases, to study how genetics, behaviour and environment affect cancer and other chronic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29891475") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/about/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/cohorts/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29891475") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A29891475+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The Canadian Partnership for Tomorrow Project (CPTP) is a prospective cohort study created as a population-health research platform for assessing the effect of genetics, behaviour, family health history and environment (among other factors) on chronic diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000860> "A pan-Canadian prospective cohort platform, established by the Canadian Partnership Against Cancer in June 2008 as the Canadian Partnership for Tomorrow Project, that federates regional cohorts (seven across ten provinces, among them CARTaGENE and the Ontario Health Study; 307,017 participants aged 30–74 from 8 provinces in five cohorts in its 2018 profile) with harmonized questionnaire, physical measurement and biosample data and linkage to administrative health databases, to study how genetics, behaviour and environment affect cancer and other chronic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29891475") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/about/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/cohorts/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://canpath.ca/about/") Annotation(rdfs:comment "Seven regional cohorts across ten provinces comprise CanPath's pan-Canadian partnership.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000860> "A pan-Canadian prospective cohort platform, established by the Canadian Partnership Against Cancer in June 2008 as the Canadian Partnership for Tomorrow Project, that federates regional cohorts (seven across ten provinces, among them CARTaGENE and the Ontario Health Study; 307,017 participants aged 30–74 from 8 provinces in five cohorts in its 2018 profile) with harmonized questionnaire, physical measurement and biosample data and linkage to administrative health databases, to study how genetics, behaviour and environment affect cancer and other chronic diseases.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29891475") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/about/") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://canpath.ca/cohorts/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://canpath.ca/about/") Annotation(rdfs:comment "The Canadian Partnership Against Cancer established the Canadian Partnership for Tomorrow Project (now CanPath) in June 2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000860> "A pan-Canadian prospective cohort platform, established by the Canadian Partnership Against Cancer in June 2008 as the Canadian Partnership for Tomorrow Project, that federates regional cohorts (seven across ten provinces, among them CARTaGENE and the Ontario Health Study; 307,017 participants aged 30–74 from 8 provinces in five cohorts in its 2018 profile) with harmonized questionnaire, physical measurement and biosample data and linkage to administrative health databases, to study how genetics, behaviour and environment affect cancer and other chronic diseases.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000861> (<http://www.ebi.ac.uk/coho/COHO_0000861>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39715278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39715278") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11706450/fullTextXML") Annotation(rdfs:comment "By building on the German COVID-19 Omics Initiative (DeCOI) [32], we established a national consortium to investigate the host genetics of COVID-19 (S1 Table).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000861> "A cohort of about 1,220 mainly vaccine-naive individuals with confirmed SARS-CoV-2 infection, across the full spectrum from asymptomatic to critical COVID-19, recruited early in the pandemic at 16 sites in Germany and South Tyrol, Italy, by a national host-genetics consortium built on the German COVID-19 Omics Initiative, with whole genome sequencing to study host genetic factors in COVID-19.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39715278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39715278") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11706450/fullTextXML") Annotation(rdfs:comment "Following quality control (see Methods), the DeCOI cohort comprised 1,220 individuals from across the entire phenotypic spectrum of SARS-CoV-2 infections (Figs 1A–1C and S1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000861> "A cohort of about 1,220 mainly vaccine-naive individuals with confirmed SARS-CoV-2 infection, across the full spectrum from asymptomatic to critical COVID-19, recruited early in the pandemic at 16 sites in Germany and South Tyrol, Italy, by a national host-genetics consortium built on the German COVID-19 Omics Initiative, with whole genome sequencing to study host genetic factors in COVID-19.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39715278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39715278") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11706450/fullTextXML") Annotation(rdfs:comment "For the host genetic analyses participants were recruited at 16 different sites, 15 of which were situated in Germany, and one in the German-speaking region of Italy (South Tyrol), from individual COVID-19 studies that were being conducted at the respective institutions.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000861> "A cohort of about 1,220 mainly vaccine-naive individuals with confirmed SARS-CoV-2 infection, across the full spectrum from asymptomatic to critical COVID-19, recruited early in the pandemic at 16 sites in Germany and South Tyrol, Italy, by a national host-genetics consortium built on the German COVID-19 Omics Initiative, with whole genome sequencing to study host genetic factors in COVID-19.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39715278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39715278") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11706450/fullTextXML") Annotation(rdfs:comment "Here, we present the results of whole genome sequencing in 1,220 mainly vaccine-naïve individuals with confirmed SARS-CoV-2 infection, including 827 hospitalized COVID-19 cases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000861> "A cohort of about 1,220 mainly vaccine-naive individuals with confirmed SARS-CoV-2 infection, across the full spectrum from asymptomatic to critical COVID-19, recruited early in the pandemic at 16 sites in Germany and South Tyrol, Italy, by a national host-genetics consortium built on the German COVID-19 Omics Initiative, with whole genome sequencing to study host genetic factors in COVID-19.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39715278") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39715278") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11706450/fullTextXML") Annotation(rdfs:comment "Second, the vast majority of participants were recruited during the first 12 months of the pandemic, when: (i) most individuals were not vaccinated against SARS-CoV-2; (ii) re-infections were uncommon; and (iii) SARS-CoV-2 diversity was still low.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000861> "A cohort of about 1,220 mainly vaccine-naive individuals with confirmed SARS-CoV-2 infection, across the full spectrum from asymptomatic to critical COVID-19, recruited early in the pandemic at 16 sites in Germany and South Tyrol, Italy, by a national host-genetics consortium built on the German COVID-19 Omics Initiative, with whole genome sequencing to study host genetic factors in COVID-19.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000862> (<http://www.ebi.ac.uk/coho/COHO_0000862>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38839884") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38839884") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11176086/fullTextXML") Annotation(rdfs:comment "Controls were either population-based unscreened controls (Austria, Estonia, Finland, France, Germany) or healthy individuals recruited in hospitals (Canada, Czech Republic, Greece, USA).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000862> "An international consortium of restless legs syndrome case collections recruited by expert clinicians in movement-disorder and sleep clinics in Europe, Canada and the United States, with ancestry-matched population or hospital controls, pooled (7,248 cases and 19,802 controls) for genome-wide association studies of restless legs syndrome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38839884") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38839884") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11176086/fullTextXML") Annotation(rdfs:comment "RLS cases were recruited in specialized outpatient clinics for movement disorders and in sleep clinics in European countries (Austria, Czech Republic, Estonia, Finland, France, Germany and Greece), Canada (Quebec) and the USA.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000862> "An international consortium of restless legs syndrome case collections recruited by expert clinicians in movement-disorder and sleep clinics in Europe, Canada and the United States, with ancestry-matched population or hospital controls, pooled (7,248 cases and 19,802 controls) for genome-wide association studies of restless legs syndrome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38839884") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38839884") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11176086/fullTextXML") Annotation(rdfs:comment "The first GWAS (EU-RLS-GENE) was conducted in affected individuals recruited by expert clinicians of the International EU-RLS-GENE consortium and ancestry-matched controls.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000862> "An international consortium of restless legs syndrome case collections recruited by expert clinicians in movement-disorder and sleep clinics in Europe, Canada and the United States, with ancestry-matched population or hospital controls, pooled (7,248 cases and 19,802 controls) for genome-wide association studies of restless legs syndrome.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:38839884") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38839884") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11176086/fullTextXML") Annotation(rdfs:comment "These summary statistics of the two datasets were then combined by fixed-effect inverse-variance meta-analysis (STERR scheme) using METAL (release 2011-03-25)35.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000862> "An international consortium of restless legs syndrome case collections recruited by expert clinicians in movement-disorder and sleep clinics in Europe, Canada and the United States, with ancestry-matched population or hospital controls, pooled (7,248 cases and 19,802 controls) for genome-wide association studies of restless legs syndrome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000863> (<http://www.ebi.ac.uk/coho/COHO_0000863>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27198479") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27198479") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27198479+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "In this study, we tested 17 of the most significantly associated single nucleotide polymorphisms (SNPs) from these GWAS studies (P < 10(-6) in the original studies) in a new independent population dataset from the Netherlands: known as Familial Influences on Literacy Abilities.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000863> "A Dutch family dataset of 483 children from 307 nuclear families and 505 adults, including parents, assessed for word and nonword reading fluency, phonological awareness and rapid automatized naming to study genetic influences on reading and language.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27198479") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27198479") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27198479+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The following measures of reading and language performance were collected: word reading fluency, nonword reading fluency, phonological awareness and rapid automatized naming.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000863> "A Dutch family dataset of 483 children from 307 nuclear families and 505 adults, including parents, assessed for word and nonword reading fluency, phonological awareness and rapid automatized naming to study genetic influences on reading and language.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27198479") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27198479") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27198479+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This dataset comprised 483 children from 307 nuclear families and 505 adults (including parents of participating children), and provided adequate statistical power to detect the effects that were previously reported.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000863> "A Dutch family dataset of 483 children from 307 nuclear families and 505 adults, including parents, assessed for word and nonword reading fluency, phonological awareness and rapid automatized naming to study genetic influences on reading and language.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000864> (<http://www.ebi.ac.uk/coho/COHO_0000864>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42152146") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23143601") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4169232/unicode") Annotation(rdfs:comment "To gain insight into the etiology of lung cancer among never-smoking women, we formed the Female Lung Cancer Consortium in Asia (FLCCA), which includes studies drawn from mainland China, South Korea, Japan, Singapore, Taiwan, and Hong Kong.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000864> "An international consortium of lung cancer studies of never-smoking Asian women from mainland China, Hong Kong, Singapore, Taiwan, South Korea and Japan, pooling genome-wide data to identify genetic risk factors for lung cancer, particularly adenocarcinoma, in this population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42152146") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23143601") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4169232/unicode") Annotation(rdfs:comment "We developed assays to genotype 13 SNPs associated at P < 5 × 10-6 in the initial scan, using analysis of all cases or the most common subtype in non-smokers, adenocarcinoma.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000864> "An international consortium of lung cancer studies of never-smoking Asian women from mainland China, Hong Kong, Singapore, Taiwan, South Korea and Japan, pooling genome-wide data to identify genetic risk factors for lung cancer, particularly adenocarcinoma, in this population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42152146") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23143601") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC4169232/unicode") Annotation(rdfs:comment "We scanned 5,510 never-smoking female lung cancer cases and 4,544 controls drawn from 14 studies from mainland China, South Korea, Japan, Singapore, Taiwan, and Hong Kong.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000864> "An international consortium of lung cancer studies of never-smoking Asian women from mainland China, Hong Kong, Singapore, Taiwan, South Korea and Japan, pooling genome-wide data to identify genetic risk factors for lung cancer, particularly adenocarcinoma, in this population.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42152146") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:42152146") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13348699/fullTextXML") Annotation(rdfs:comment "FLCCA is an international consortium focusing on never-smoking Asian women, with participating studies from Mainland China, Hong Kong, Singapore, Taiwan, South Korea, and Japan.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000864> "An international consortium of lung cancer studies of never-smoking Asian women from mainland China, Hong Kong, Singapore, Taiwan, South Korea and Japan, pooling genome-wide data to identify genetic risk factors for lung cancer, particularly adenocarcinoma, in this population.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000865> (<http://www.ebi.ac.uk/coho/COHO_0000865>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39406924") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.medrxiv.org/content/medrxiv/early/2022/11/29/2022.11.26.22281768/DC1/embed/media-1.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39406924") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.nature.com/articles/s41588-024-01921-5") Annotation(rdfs:comment "Here, we provide insights into the molecular mechanism of the poorly understood inflammatory component of gout from a genome-wide association study (GWAS) of 2.6 million people, including 120,295 people with prevalent gout.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000865> "An international consortium of gout genetics research groups, named as a collective author of a genome-wide association analysis of gout in 2.6 million people, whose own case-control sample set (New Zealand/Ardea Biosciences/EuroGout: people with self-reported clinically diagnosed gout or gout meeting the 1977 ARA classification criteria and controls, of self-reported European ancestry) was genotyped for that study on the Illumina CoreExome array.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39406924") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.medrxiv.org/content/medrxiv/early/2022/11/29/2022.11.26.22281768/DC1/embed/media-1.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.medrxiv.org/content/medrxiv/early/2022/11/29/2022.11.26.22281768.full.pdf") Annotation(rdfs:comment "GlobalGout obtained ethical approval from the following committees: the New Zealand Multiregional Ethics Committee (MEC05/10/130); the Northern Y Region Health Research Ethics Committee (Ngāti Porou Hauora Charitable Trust study; NTY07/07/074); Research and Ethics Committee, Repatriation General Hospital, South Australia (32/08)") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000865> "An international consortium of gout genetics research groups, named as a collective author of a genome-wide association analysis of gout in 2.6 million people, whose own case-control sample set (New Zealand/Ardea Biosciences/EuroGout: people with self-reported clinically diagnosed gout or gout meeting the 1977 ARA classification criteria and controls, of self-reported European ancestry) was genotyped for that study on the Illumina CoreExome array.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39406924") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.medrxiv.org/content/medrxiv/early/2022/11/29/2022.11.26.22281768/DC1/embed/media-1.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.medrxiv.org/content/medrxiv/early/2022/11/29/2022.11.26.22281768/DC1/embed/media-1.xlsx") Annotation(rdfs:comment "Illumina CoreExome v24 | HRC Panel 1.1 | EAGLE2 + PBWT | MAF >= 0.001, HWE p >= 1e-6, INFO score > 0.3, missingness % < 0.04 |  | Sex + age + PC1 to PC10 + chip version + genotyping batch | SNPTEST v2.5.2 |  | Genotyped herein") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000865> "An international consortium of gout genetics research groups, named as a collective author of a genome-wide association analysis of gout in 2.6 million people, whose own case-control sample set (New Zealand/Ardea Biosciences/EuroGout: people with self-reported clinically diagnosed gout or gout meeting the 1977 ARA classification criteria and controls, of self-reported European ancestry) was genotyped for that study on the Illumina CoreExome array.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:39406924") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.medrxiv.org/content/medrxiv/early/2022/11/29/2022.11.26.22281768/DC1/embed/media-1.xlsx") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.medrxiv.org/content/medrxiv/early/2022/11/29/2022.11.26.22281768/DC1/embed/media-1.xlsx") Annotation(rdfs:comment "New Zealand/Ardea Biosciences/EuroGout  | 4713 | 0.88949999999999996 | 58.5 |  | 2151 | 0.57089999999999996 | 52.4 |  | Self-report of clinically diagnosed gout or fulfill 1977 ARA gout classificaton criteria | Self-reported European + PCA") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000865> "An international consortium of gout genetics research groups, named as a collective author of a genome-wide association analysis of gout in 2.6 million people, whose own case-control sample set (New Zealand/Ardea Biosciences/EuroGout: people with self-reported clinically diagnosed gout or gout meeting the 1977 ARA classification criteria and controls, of self-reported European ancestry) was genotyped for that study on the Illumina CoreExome array.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000866> (<http://www.ebi.ac.uk/coho/COHO_0000866>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41829988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41829988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12986960/fullTextXML") Annotation(rdfs:comment "Briefly, the primary objective of the GUSTO study is to evaluate exposures and influences in early development on adverse metabolic functions and body composition later in life.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000866> "A birth cohort in Singapore that enrolled 1468 pregnant women aged 18 years or over at their first-trimester dating scan at the two major public maternity units in 2009–2010 and follows the mothers and their children, to evaluate how early-life exposures influence later metabolic function, body composition and development.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41829988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41829988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12986960/fullTextXML") Annotation(rdfs:comment "Methods: Data from 348 mother–child pairs in the Growing up in Singapore Towards Healthy Outcomes birth cohort with both plasma nutrient and neurodevelopmental outcome data were used.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000866> "A birth cohort in Singapore that enrolled 1468 pregnant women aged 18 years or over at their first-trimester dating scan at the two major public maternity units in 2009–2010 and follows the mothers and their children, to evaluate how early-life exposures influence later metabolic function, body composition and development.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41829988") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:41829988") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12986960/fullTextXML") Annotation(rdfs:comment "The study enrolled 1468 pregnant women at least 18 years of age between June 2009 and September 2010 attending their first trimester antenatal dating ultrasound scan clinic at Singapore’s two major public maternity units.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000866> "A birth cohort in Singapore that enrolled 1468 pregnant women aged 18 years or over at their first-trimester dating scan at the two major public maternity units in 2009–2010 and follows the mothers and their children, to evaluate how early-life exposures influence later metabolic function, body composition and development.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000867> (<http://www.ebi.ac.uk/coho/COHO_0000867>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20501760") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20501760") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2882992/") Annotation(rdfs:comment "Adenoma cases were identified either as part of the baseline screening exam at the Hawaii site of the Prostate Lung Colorectal and Ovarian (PLCO) screening trial between July 1996 and February 2000 or at the Kaiser Permanente Hawaii (KPH)’s Gastroenterology Screening Clinic between January 1995 and June 2006.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000867> "A case-control study of first-time colorectal adenoma among Caucasian, Japanese and Native Hawaiian adults on Oahu, Hawaii, United States, with cases from the Hawaii site of the PLCO screening trial and Kaiser Permanente Hawaii clinics (1995–2006) and controls with normal endoscopy, used to study risk factors for colorectal neoplasia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20501760") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20501760") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2882992/") Annotation(rdfs:comment "Briefly, two flexible-sigmoidoscopy screening clinics were first used to recruit participants on Oahu, Hawaii.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000867> "A case-control study of first-time colorectal adenoma among Caucasian, Japanese and Native Hawaiian adults on Oahu, Hawaii, United States, with cases from the Hawaii site of the PLCO screening trial and Kaiser Permanente Hawaii clinics (1995–2006) and controls with normal endoscopy, used to study risk factors for colorectal neoplasia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20501760") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20501760") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2882992/") Annotation(rdfs:comment "Cases were patients with histologically confirmed first-time adenoma(s) of the colorectum and were of Japanese, Caucasian or Hawaiian race/ethnicity.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000867> "A case-control study of first-time colorectal adenoma among Caucasian, Japanese and Native Hawaiian adults on Oahu, Hawaii, United States, with cases from the Hawaii site of the PLCO screening trial and Kaiser Permanente Hawaii clinics (1995–2006) and controls with normal endoscopy, used to study risk factors for colorectal neoplasia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20501760") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20501760") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2882992/") Annotation(rdfs:comment "Exposure information was collected via an interview-administered questionnaire designed to obtain demographic and lifestyle information, including lifetime histories of tobacco smoking and alcohol drinking, weight at time of examination, usual physical activity, personal medical history, family history of colorectal cancer, and for females, reproductive and hormone use histories.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000867> "A case-control study of first-time colorectal adenoma among Caucasian, Japanese and Native Hawaiian adults on Oahu, Hawaii, United States, with cases from the Hawaii site of the PLCO screening trial and Kaiser Permanente Hawaii clinics (1995–2006) and controls with normal endoscopy, used to study risk factors for colorectal neoplasia.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:20501760") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:20501760") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC2882992/") Annotation(rdfs:comment "We measured plasma C-peptide, a marker of insulin secretion, and IGF hormones in a case-control study of 554 pathologically-confirmed, first-time, adenoma cases and 786 controls with normal endoscopy among Caucasians, Japanese and Native Hawaiians in Hawaii.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000867> "A case-control study of first-time colorectal adenoma among Caucasian, Japanese and Native Hawaiian adults on Oahu, Hawaii, United States, with cases from the Hawaii site of the PLCO screening trial and Kaiser Permanente Hawaii clinics (1995–2006) and controls with normal endoscopy, used to study risk factors for colorectal neoplasia.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000868> (<http://www.ebi.ac.uk/coho/COHO_0000868>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38002962") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML") Annotation(rdfs:comment "In the HFGR, pharmacy claims data were used to calculate beta-blocker exposure as described previously [18].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000868> "A prospective registry of Black and White patients with heart failure enrolled within the Henry Ford Health System in Detroit, Michigan, from 2007 to 2015, with genotyping and pharmacy claims data, designed to discover ways to predict heart failure prognosis and responses to heart failure therapies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38002962") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML") Annotation(rdfs:comment "The discovery dataset came from a prospective HF pharmacogenomic registry (HFGR) designed to discover novel ways to predict HF prognoses and responses to HF therapies [9].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000868> "A prospective registry of Black and White patients with heart failure enrolled within the Henry Ford Health System in Detroit, Michigan, from 2007 to 2015, with genotyping and pharmacy claims data, designed to discover ways to predict heart failure prognosis and responses to heart failure therapies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38002962") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML") Annotation(rdfs:comment "The mean proportion of YRI ancestry in the self-reported black and white patients in HFGR was 83.5% and 1.0%, respectively.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000868> "A prospective registry of Black and White patients with heart failure enrolled within the Henry Ford Health System in Detroit, Michigan, from 2007 to 2015, with genotyping and pharmacy claims data, designed to discover ways to predict heart failure prognosis and responses to heart failure therapies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38002962") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML") Annotation(rdfs:comment "The registry began enrolling patients in October 2007, within the Henry Ford Health System in Detroit, MI, USA, and enrolment was completed in March 2015.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000868> "A prospective registry of Black and White patients with heart failure enrolled within the Henry Ford Health System in Detroit, Michigan, from 2007 to 2015, with genotyping and pharmacy claims data, designed to discover ways to predict heart failure prognosis and responses to heart failure therapies.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:38002962") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10671316/fullTextXML") Annotation(rdfs:comment "The same genotyping methods were used for both the HFGR and HF-ACTION datasets.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000868> "A prospective registry of Black and White patients with heart failure enrolled within the Henry Ford Health System in Detroit, Michigan, from 2007 to 2015, with genotyping and pharmacy claims data, designed to discover ways to predict heart failure prognosis and responses to heart failure therapies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000869> (<http://www.ebi.ac.uk/coho/COHO_0000869>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37494057") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40650879") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-10") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37494057") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC10372759/") Annotation(rdfs:comment "Isolation of DNA was performed in the UNC BioSpecimen Processing facility using the PerkinElmer Chemagic Magnetic Separation Module I and magnetic bead separation kits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000869> "A cohort of patients with hidradenitis suppurativa recruited at the University of North Carolina Department of Dermatology in the United States from August 2018 and later expanded to 986 patients, providing clinical data and DNA for genetic association studies of the disease.")
