AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9313038/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:35884669") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9313038/fullTextXML") Annotation(rdfs:comment "National Institute of Gastroenterology “Saverio de Bellis” Research Hospital, 70013 Castellana Grotte, Italy") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000895> "A population-based cohort of older adults aged 65 and over, recruited from the electoral rolls of Castellana Grotte, Bari, in Apulia, southern Italy, by the National Institute of Gastroenterology 'Saverio de Bellis' Research Hospital as a public health initiative funded by the Italian Ministry of Health and the Apulia Regional Government, to study ageing, frailty, cognitive decline and related conditions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9313038/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8700814/fullTextXML") Annotation(rdfs:comment "The Institutional Review Board of the National Institute of Gastroenterology “S. De Bellis” issued prior approval of the Salus in Apulia Study, measurements, and data collections.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000895> "A population-based cohort of older adults aged 65 and over, recruited from the electoral rolls of Castellana Grotte, Bari, in Apulia, southern Italy, by the National Institute of Gastroenterology 'Saverio de Bellis' Research Hospital as a public health initiative funded by the Italian Ministry of Health and the Apulia Regional Government, to study ageing, frailty, cognitive decline and related conditions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9313038/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8700814/fullTextXML") Annotation(rdfs:comment "The Salus in Apulia Study focused on the lifestyle sequence in older age, considering diet, frailty, and other age-related impairments and diseases [12].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000895> "A population-based cohort of older adults aged 65 and over, recruited from the electoral rolls of Castellana Grotte, Bari, in Apulia, southern Italy, by the National Institute of Gastroenterology 'Saverio de Bellis' Research Hospital as a public health initiative funded by the Italian Ministry of Health and the Apulia Regional Government, to study ageing, frailty, cognitive decline and related conditions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9313038/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8700814/fullTextXML") Annotation(rdfs:comment "The present study included individuals from the Salus in Apulia Study (MICOL Study plus GreatAGE Study), an ongoing population-based prospective cohort comprising 2192 individuals aged 65 years or older and resident in Castellana Grotte, a town located near Bari, Puglia, in the southeast of Italy.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000895> "A population-based cohort of older adults aged 65 and over, recruited from the electoral rolls of Castellana Grotte, Bari, in Apulia, southern Italy, by the National Institute of Gastroenterology 'Saverio de Bellis' Research Hospital as a public health initiative funded by the Italian Ministry of Health and the Apulia Regional Government, to study ageing, frailty, cognitive decline and related conditions.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9313038/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9313038/fullTextXML") Annotation(rdfs:comment "All subjects had been enrolled and included in the “Salus in Apulia Study,” a public health initiative that was funded by the Italian Ministry of Health and the Apulia Regional Government and that was conducted at IRCCS “S. De Bellis” Research Hospital.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000895> "A population-based cohort of older adults aged 65 and over, recruited from the electoral rolls of Castellana Grotte, Bari, in Apulia, southern Italy, by the National Institute of Gastroenterology 'Saverio de Bellis' Research Hospital as a public health initiative funded by the Italian Ministry of Health and the Apulia Regional Government, to study ageing, frailty, cognitive decline and related conditions.")
