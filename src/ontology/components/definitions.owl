AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003741") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31417161") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC6752724/") Annotation(rdfs:comment "We generated RNA-seq data of PBMCs from 6 healthy individuals, 11 patients with CD, and 9 patients with UC.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000246> "A study cohort of healthy donors, a patient with IL10RA deficiency and children with severe paediatric inflammatory bowel disease at Erasmus MC, whose monocyte-derived dendritic cells and blood mononuclear cells were profiled by RNA sequencing to investigate IL-10 control of T-cell responses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003741") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:31417161") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC6752724/unicode") Annotation(rdfs:comment "For the participants with IBD and IL10RA deficiency, the study was approved by the Medical Ethical Committee of the Erasmus University Medical Center.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000246> "A study cohort of healthy donors, a patient with IL10RA deficiency and children with severe paediatric inflammatory bowel disease at Erasmus MC, whose monocyte-derived dendritic cells and blood mononuclear cells were profiled by RNA sequencing to investigate IL-10 control of T-cell responses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003741") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001003741") Annotation(rdfs:comment "EMC-DC-IL10R study: RNASeq analysis of moDC and PBMC from healthy human donors and pediatric IBD patients") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000246> "A study cohort of healthy donors, a patient with IL10RA deficiency and children with severe paediatric inflammatory bowel disease at Erasmus MC, whose monocyte-derived dendritic cells and blood mononuclear cells were profiled by RNA sequencing to investigate IL-10 control of T-cell responses.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://ega-archive.org/studies/EGAS00001003741") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://ega-archive.org/studies/EGAS00001003741") Annotation(rdfs:comment "Using monocyte derived dendritic cells from a patient with an IL10RA deficiency or moDC and PBMC from patients with severe Pediatric Inflammatory Bowel disease we demonstrate that IL-10 signaling in moDCs, but not T cells, is essential for controlling IFNg-secreting CD4+ T cells.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000246> "A study cohort of healthy donors, a patient with IL10RA deficiency and children with severe paediatric inflammatory bowel disease at Erasmus MC, whose monocyte-derived dendritic cells and blood mononuclear cells were profiled by RNA sequencing to investigate IL-10 control of T-cell responses.")

