AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1624967") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7572679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:1624967") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1624967+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A trial population of approx. 6500 men have been randomized in equal numbers to treatment with placebo or pravastatin.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002579> "A primary-prevention trial of men aged 45 to 64 with raised plasma cholesterol, recruited in Scotland and randomised to pravastatin or placebo to test whether lowering serum cholesterol reduces fatal and non-fatal myocardial infarction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1624967") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7572679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:1624967") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1624967+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The principal aim is to test the hypothesis that reduction of serum cholesterol by treatment with pravastatin [a competitive inhibitor of 3-hydroxy-3-methylglutaryl coenzyme A (HMG CoA) reductase--a regulatory enzyme in cholesterol synthesis] over an average period of 5 yr will lead to a reduction in fatal and non-fatal myocardial infarction.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002579> "A primary-prevention trial of men aged 45 to 64 with raised plasma cholesterol, recruited in Scotland and randomised to pravastatin or placebo to test whether lowering serum cholesterol reduces fatal and non-fatal myocardial infarction.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:1624967") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:7572679") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "Claude Sonnet 5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:1624967") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A1624967+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "This paper describes the design of the West of Scotland Coronary Prevention Study (WOSCOPS) which is a primary prevention trial involving men aged 45-64 yr with raised plasma cholesterol levels.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002579> "A primary-prevention trial of men aged 45 to 64 with raised plasma cholesterol, recruited in Scotland and randomised to pravastatin or placebo to test whether lowering serum cholesterol reduces fatal and non-fatal myocardial infarction.")

