AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.amsterdamumc.org/en/about/organization/nederlands-tweelingen-register-netherlands-twin-register-ntr") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:17254420") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A17254420+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A large biobank enterprise is ongoing in the ANTR in which blood and urine samples are collected for genotyping, expression analysis, and metabolomics studies.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000125> "A registry of twins and their relatives with longitudinal phenotypic and genetic data, established to investigate inherited and environmental contributions to variation in health, fertility, development, growth and behaviour.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.amsterdamumc.org/en/about/organization/nederlands-tweelingen-register-netherlands-twin-register-ntr") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.amsterdamumc.org/en/about/organization/nederlands-tweelingen-register-netherlands-twin-register-ntr") Annotation(rdfs:comment "NTR collects longitudinal data from over 200,000 participants, including twins (40%) and their family.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000125> "A registry of twins and their relatives with longitudinal phenotypic and genetic data, established to investigate inherited and environmental contributions to variation in health, fertility, development, growth and behaviour.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.amsterdamumc.org/en/about/organization/nederlands-tweelingen-register-netherlands-twin-register-ntr") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.amsterdamumc.org/en/about/organization/nederlands-tweelingen-register-netherlands-twin-register-ntr") Annotation(rdfs:comment "Netherlands Twin Register (in Dutch Nederlands Tweelingen Register) (NTR) focuses on the etiology of individual differences in health, fertility, development, growth and behavior.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000125> "A registry of twins and their relatives with longitudinal phenotypic and genetic data, established to investigate inherited and environmental contributions to variation in health, fertility, development, growth and behaviour.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.amsterdamumc.org/en/about/organization/nederlands-tweelingen-register-netherlands-twin-register-ntr") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.amsterdamumc.org/en/about/organization/nederlands-tweelingen-register-netherlands-twin-register-ntr") Annotation(rdfs:comment "The genetic basis is studied by approaches from genetic epidemiology, and other ‘omics’.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000125> "A registry of twins and their relatives with longitudinal phenotypic and genetic data, established to investigate inherited and environmental contributions to variation in health, fertility, development, growth and behaviour.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.amsterdamumc.org/en/about/organization/nederlands-tweelingen-register-netherlands-twin-register-ntr") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.maelstrom-research.org/study/ntr") Annotation(rdfs:comment "The objectives of this study are to facilitate longitudinal research on twins by creating a large national database, and to study the role of genes and environment and their interaction in individual variation in personality, lifestyle, and health, and the development of disease and psychopathology.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000125> "A registry of twins and their relatives with longitudinal phenotypic and genetic data, established to investigate inherited and environmental contributions to variation in health, fertility, development, growth and behaviour.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000126> (<http://www.ebi.ac.uk/coho/COHO_0000126>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33634849") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33634849") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://pmc.ncbi.nlm.nih.gov/articles/PMC8720374/") Annotation(rdfs:comment "NEC is a population-based case-control study of ovarian cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000126> "A case-control collection of women aged 18–80 with epithelial ovarian cancer and population controls from eastern Massachusetts and New Hampshire, recruited in four phases from 1984 to 2008 to investigate ovarian-cancer risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33634849") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33634849") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8720374/unicode") Annotation(rdfs:comment "Briefly, participants were enrolled during four phases: 1984–1988, 1992–1997, 1998–2003, and 2003–2008.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000126> "A case-control collection of women aged 18–80 with epithelial ovarian cancer and population controls from eastern Massachusetts and New Hampshire, recruited in four phases from 1984 to 2008 to investigate ovarian-cancer risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33634849") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33634849") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8720374/unicode") Annotation(rdfs:comment "Potential controls were identified through random digit dialing (1992–1997 phase only), driver license lists, and town resident lists.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000126> "A case-control collection of women aged 18–80 with epithelial ovarian cancer and population controls from eastern Massachusetts and New Hampshire, recruited in four phases from 1984 to 2008 to investigate ovarian-cancer risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33634849") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33634849") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/research/bionlp/RESTful/pmcoa.cgi/BioC_xml/PMC8720374/unicode") Annotation(rdfs:comment "Women aged 18–80 years residing in Eastern Massachusetts and New Hampshire who were diagnosed with epithelial ovarian cancer were identified as potential cases through tumor board and registries.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000126> "A case-control collection of women aged 18–80 with epithelial ovarian cancer and population controls from eastern Massachusetts and New Hampshire, recruited in four phases from 1984 to 2008 to investigate ovarian-cancer risk factors.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33634849") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs001034.v1.p1") Annotation(rdfs:comment "Our goal is to show that many well established risk factors for ovarian cancer, some of which are modifiable, including talc use, smoking, pregnancy and breastfeeding history, oral contraceptive use, ovulatory cycles, hysterectomy and tubal ligation, menopausal hormone use, and medical and family history, may be modified by particular genetic variants.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000126> "A case-control collection of women aged 18–80 with epithelial ovarian cancer and population controls from eastern Massachusetts and New Hampshire, recruited in four phases from 1984 to 2008 to investigate ovarian-cancer risk factors.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000127> (<http://www.ebi.ac.uk/coho/COHO_0000127>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37688361") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37688361") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10576603/fullTextXML") Annotation(rdfs:comment "The Gastroparesis Clinical Research Consortium (GpCRC) is a network of GI tertiary centers in the United States sponsored by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK) that aims to advance knowledge and treatments for GP.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000127> "A cohort of patients with gastroparesis recruited through the Gastroparesis Clinical Research Consortium (GpCRC), a network of gastrointestinal tertiary centres in the United States sponsored by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK), whose registry provided the gastroparesis cases of the GWAS Catalog study tagged NIDDK.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37688361") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37688361") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10576603/fullTextXML") Annotation(rdfs:comment "The GpCRC cohort consists of tertiary care patients who have often added psychosocial comorbidities, limiting the generalization to the broader spectrum of GP patients.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000127> "A cohort of patients with gastroparesis recruited through the Gastroparesis Clinical Research Consortium (GpCRC), a network of gastrointestinal tertiary centres in the United States sponsored by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK), whose registry provided the gastroparesis cases of the GWAS Catalog study tagged NIDDK.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37688361") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37688361") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A37688361+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "We carried out a genome-wide association study (GWAS) meta-analysis on (i) 478 GP patients from the National Institute of Diabetes and Digestive and Kidney Diseases Gastroparesis Clinical Research Consortium (GpCRC) compared to 9931 population-based controls from the University of Michigan Health and Retirement Study; and (ii) 402 GP cases compared to 48,340 non-gastroparesis controls from the Michigan Genomics Initiative.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000127> "A cohort of patients with gastroparesis recruited through the Gastroparesis Clinical Research Consortium (GpCRC), a network of gastrointestinal tertiary centres in the United States sponsored by the National Institute of Diabetes and Digestive and Kidney Diseases (NIDDK), whose registry provided the gastroparesis cases of the GWAS Catalog study tagged NIDDK.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000128> (<http://www.ebi.ac.uk/coho/COHO_0000128>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28082374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28082374") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837647/fullTextXML") Annotation(rdfs:comment "Eligibility criteria were age 18 years or older, not living in an institution or rest home and the ability to fill out a questionnaire in Dutch.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000128> "A cohort of adults from Nijmegen, the Netherlands, established in 2000 with population sampling from 2002 to investigate genetic variation, lifestyle and environmental exposures in relation to disease and population traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28082374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28082374") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837647/fullTextXML") Annotation(rdfs:comment "In 2002, the first phase of NBS (NBS-1) was started. On 1 July, a random sample from the register of the municipality of Nijmegen was drawn, stratified by sex and 5-year age groups.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000128> "A cohort of adults from Nijmegen, the Netherlands, established in 2000 with population sampling from 2002 to investigate genetic variation, lifestyle and environmental exposures in relation to disease and population traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28082374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28082374") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837647/fullTextXML") Annotation(rdfs:comment "The NBS was originally established to obtain a universal reference population to be used for studies of genetic variation, lifestyle and environmental exposures in relation to traits or diseases of interest. However, NBS has also proven useful for studying population traits.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000128> "A cohort of adults from Nijmegen, the Netherlands, established in 2000 with population sampling from 2002 to investigate genetic variation, lifestyle and environmental exposures in relation to disease and population traits.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28082374") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28082374") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837647/fullTextXML") Annotation(rdfs:comment "The Nijmegen Biomedical Study (NBS) is a population-based study that was initiated (by L.K. and A.V.) in 2000 in the municipality of Nijmegen (∼ 150 000 inhabitants) in the eastern part of The Netherlands.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000128> "A cohort of adults from Nijmegen, the Netherlands, established in 2000 with population sampling from 2002 to investigate genetic variation, lifestyle and environmental exposures in relation to disease and population traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000129> (<http://www.ebi.ac.uk/coho/COHO_0000129>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37011634") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37011634") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10396407/fullTextXML") Annotation(rdfs:comment "NICOLA is a longitudinal panel of 8283 participants representative of an ‘eligible population’ defined as community dwelling adults aged ≥50 years living in private households in NI, broadly equivalent in sample size to both TILDA3 and ELSA2.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000129> "A cohort of adults aged 50 years and older living in private accommodation in Northern Ireland, recruited in 2013–2016 and followed through surveys and health assessments to investigate ageing, health and social circumstances.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37011634") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37011634") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10396407/fullTextXML") Annotation(rdfs:comment "NICOLA participants will undertake a detailed survey, in their own home, every 2 years with a detailed health assessment every 4 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000129> "A cohort of adults aged 50 years and older living in private accommodation in Northern Ireland, recruited in 2013–2016 and followed through surveys and health assessments to investigate ageing, health and social circumstances.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37011634") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37011634") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10396407/fullTextXML") Annotation(rdfs:comment "The NICOLA data set comprises a diverse range of objective and subjective measures of physical and mental health, life expectancy, disability, education, economic activity, social participation and support, household and family structures; and uniquely to NICOLA, the effects of ‘the Troubles’, a detailed ophthalmological assessment and a dietary assessment.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000129> "A cohort of adults aged 50 years and older living in private accommodation in Northern Ireland, recruited in 2013–2016 and followed through surveys and health assessments to investigate ageing, health and social circumstances.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37011634") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37011634") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10396407/fullTextXML") Annotation(rdfs:comment "Within these 6598 households, a total of 8478 CAPI interviews were conducted with eligible participants between December 2013 and July 2016 (see Figure 1).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000129> "A cohort of adults aged 50 years and older living in private accommodation in Northern Ireland, recruited in 2013–2016 and followed through surveys and health assessments to investigate ageing, health and social circumstances.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000130> (<http://www.ebi.ac.uk/coho/COHO_0000130>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23986895") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23986895") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3754550/fullTextXML") Annotation(rdfs:comment "In addition, we examined the heritability of these estimates.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000130> "A cohort of residents of Karesuando, Soppero and the Vittangi area in Norrbotten, northern Sweden, surveyed in 2006 and 2009 to characterise population health, including environmental and inherited determinants of allergic sensitisation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23986895") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23986895") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3754550/fullTextXML") Annotation(rdfs:comment "The Northern Sweden Population Health Study (NSPHS) was conducted to provide a health survey of the communities of Karesuando and Soppero, County of Norrbotten, Sweden.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000130> "A cohort of residents of Karesuando, Soppero and the Vittangi area in Norrbotten, northern Sweden, surveyed in 2006 and 2009 to characterise population health, including environmental and inherited determinants of allergic sensitisation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23986895") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23986895") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3754550/fullTextXML") Annotation(rdfs:comment "The aim of the present study was to determine the prevalence of allergies in these communities and gain a better understanding of the environmental factors affecting allergic sensitization.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000130> "A cohort of residents of Karesuando, Soppero and the Vittangi area in Norrbotten, northern Sweden, surveyed in 2006 and 2009 to characterise population health, including environmental and inherited determinants of allergic sensitisation.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23986895") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:23986895") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3754550/fullTextXML") Annotation(rdfs:comment "The study was performed in 2 periods, with 750 participants mainly from the Karesuando area in 2006, and 350 participants from the Soppero and Vittangi area in 2009.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000130> "A cohort of residents of Karesuando, Soppero and the Vittangi area in Norrbotten, northern Sweden, surveyed in 2006 and 2009 to characterise population health, including environmental and inherited determinants of allergic sensitisation.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000131> (<http://www.ebi.ac.uk/coho/COHO_0000131>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27063603") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27063603") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27063603+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Blood samples were obtained from both parents during pregnancy and from mothers and children (umbilical cord) after birth.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000131> "A birth cohort of children and their parents in Norway, recruited through pregnancies with births during 1999–2009, combining repeated family questionnaires, biological samples and health-register linkages for longitudinal research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27063603") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27063603") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27063603+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Pregnant women attending a routine ultrasound examination were initially invited. The first child was born in October 1999 and the last in July 2009. The participation rate was 41%. The cohort includes more than 114 000 children, 95 000 mothers and 75 000 fathers.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000131> "A birth cohort of children and their parents in Norway, recruited through pregnancies with births during 1999–2009, combining repeated family questionnaires, biological samples and health-register linkages for longitudinal research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27063603") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:27063603") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A27063603+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "The purpose of this update is to explain and describe new additions to the data collection, including questionnaires at 5, 7, 8 and 13 years as well as linkages to health registries, and to point to some findings and new areas of research.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000131> "A birth cohort of children and their parents in Norway, recruited through pregnancies with births during 1999–2009, combining repeated family questionnaires, biological samples and health-register linkages for longitudinal research.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:27063603") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:33239696") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC7688949/fullTextXML") Annotation(rdfs:comment "The Norwegian MoBa (Mother, Father and Child Cohort Study) is a longitudinal study of over 110,000 pregnant women, their children and partners, recruited between 1999 and 2008 from maternity units throughout Norway, and has been described previously44.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000131> "A birth cohort of children and their parents in Norway, recruited through pregnancies with births during 1999–2009, combining repeated family questionnaires, biological samples and health-register linkages for longitudinal research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000132> (<http://www.ebi.ac.uk/coho/COHO_0000132>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://viking.ed.ac.uk/our-data-and-samples/cohorts") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:28878392") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5587582/fullTextXML") Annotation(rdfs:comment "The Orkney Complex Disease Study (ORCADES) is a family-based study of 2078 individuals aged 16–100 years recruited between 2005 and 2011 in the isolated Scottish archipelago of Orkney26.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000132> "A cohort of people aged 16–100 with Orcadian grandparents, recruited in Orkney, northern Scotland, in 2005–2011 for family-based investigation of genetic influences on cardiovascular and other complex-disease risks.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://viking.ed.ac.uk/our-data-and-samples/cohorts") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://viking.ed.ac.uk/our-data-and-samples/cohorts") Annotation(rdfs:comment "2078 participants aged 16-100 years were recruited between 2005 and 2011, most having three or four grandparents from Orkney, the remainder with two Orcadian grandparents.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000132> "A cohort of people aged 16–100 with Orcadian grandparents, recruited in Orkney, northern Scotland, in 2005–2011 for family-based investigation of genetic influences on cardiovascular and other complex-disease risks.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://viking.ed.ac.uk/our-data-and-samples/cohorts") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://viking.ed.ac.uk/our-data-and-samples/cohorts") Annotation(rdfs:comment "The Orkney Complex Disease Study (ORCADES) is a family-based study that seeks to identify genetic factors influencing cardiovascular and other disease risks in the isolated archipelago of the Orkney Isles in northern Scotland.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000132> "A cohort of people aged 16–100 with Orcadian grandparents, recruited in Orkney, northern Scotland, in 2005–2011 for family-based investigation of genetic influences on cardiovascular and other complex-disease risks.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000133> (<http://www.ebi.ac.uk/coho/COHO_0000133>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18082485") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18082485") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18082485+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "A total of 12,612 (mean age 64, 35% women) people in 40 countries were randomized during a 2-year period ending December 2005.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000133> "A randomised trial cohort of adults aged at least 50 with cardiovascular disease and dysglycaemia in 40 countries, enrolled during the two years ending December 2005 to compare insulin glargine with standard glycaemic care and omega-3 fatty acids with placebo for cardiovascular prevention.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18082485") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18082485") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18082485+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "People aged > or = 50 years with evidence of CV disease and with IFG, IGT, newly detected or established diabetes (on 0 or 1 oral agent), and a local glycated hemoglobin") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000133> "A randomised trial cohort of adults aged at least 50 with cardiovascular disease and dysglycaemia in 40 countries, enrolled during the two years ending December 2005 to compare insulin glargine with standard glycaemic care and omega-3 fatty acids with placebo for cardiovascular prevention.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18082485") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:18082485") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A18082485+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Rationale, design, and baseline characteristics for a large international trial of cardiovascular disease prevention in people with dysglycemia: the ORIGIN Trial (Outcome Reduction with an Initial Glargine Intervention).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000133> "A randomised trial cohort of adults aged at least 50 with cardiovascular disease and dysglycaemia in 40 countries, enrolled during the two years ending December 2005 to compare insulin glargine with standard glycaemic care and omega-3 fatty acids with placebo for cardiovascular prevention.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:18082485") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:37414411") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC10361015/fullTextXML") Annotation(rdfs:comment "Outcome Reduction With Initial Glargine Intervention (ORIGIN) was a randomized controlled trial of insulin glargine or standard care and n-3 fatty acids or placebo (2-by-2 factorial design) in 12 405 people (mean age, 63.5 years) with cardiovascular risk factors plus impaired fasting glucose or diabetes enrolled between 5 February 2004 and 27 December 2005.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000133> "A randomised trial cohort of adults aged at least 50 with cardiovascular disease and dysglycaemia in 40 countries, enrolled during the two years ending December 2005 to compare insulin glargine with standard glycaemic care and omega-3 fatty acids with placebo for cardiovascular prevention.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000134> (<http://www.ebi.ac.uk/coho/COHO_0000134>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://sph.umich.edu/mocog/about.html") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19127255") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2634713/fullTextXML") Annotation(rdfs:comment "The Ovarian Cancer Association Consortium (OCAC) was formed in 2005 to provide a forum for testing candidate ovarian cancer susceptibility alleles in multiple studies with a large combined sample size (Gayther et al, 2007; Pearce et al, 2008; Ramus et al, 2008).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000134> "A consortium of ovarian cancer studies established in 2005 that combines participant data to investigate genetic and epidemiological risk factors for ovarian cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://sph.umich.edu/mocog/about.html") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:19127255") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC2634713/fullTextXML") Annotation(rdfs:comment "The Ovarian Cancer Association Consortium is comprised of ovarian cancer case–control and cohort studies conducted around the world (Gayther et al, 2007; Pearce et al, 2008; Ramus et al, 2008).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000134> "A consortium of ovarian cancer studies established in 2005 that combines participant data to investigate genetic and epidemiological risk factors for ovarian cancer.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://sph.umich.edu/mocog/about.html") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:22361336") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A22361336+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Data from 13 ovarian cancer case-control studies, which were part of the Ovarian Cancer Association Consortium, were pooled and logistic regression analyses were undertaken to assess the association between self-reported endometriosis and risk of ovarian cancer.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000134> "A consortium of ovarian cancer studies established in 2005 that combines participant data to investigate genetic and epidemiological risk factors for ovarian cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000136> (<http://www.ebi.ac.uk/coho/COHO_0000136>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29040543") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29040543") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837504/fullTextXML") Annotation(rdfs:comment "Such recalls could be either ‘recall-by-genotype’ or ‘recall-by-phenotype’.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000136> "A biobank of healthy men and women aged 30–50 years from Oxfordshire, United Kingdom, recruiting from 1999 and permitting recall by genotype or phenotype to investigate mechanisms of type 2 diabetes and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29040543") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29040543") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837504/fullTextXML") Annotation(rdfs:comment "The OBB is a random, population-based recruitment of healthy participants between the ages of 30 and 50 years from the Oxfordshire general population (approximately 800 000 inhabitants).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000136> "A biobank of healthy men and women aged 30–50 years from Oxfordshire, United Kingdom, recruiting from 1999 and permitting recall by genotype or phenotype to investigate mechanisms of type 2 diabetes and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29040543") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29040543") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837504/fullTextXML") Annotation(rdfs:comment "The OBB recruitment began in 1999 and includes 7640 (4316 women and 3324 men) individuals as of October 2016, with the aim of having a local cohort of 10 000 people among whom recalling can be achieved.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000136> "A biobank of healthy men and women aged 30–50 years from Oxfordshire, United Kingdom, recruiting from 1999 and permitting recall by genotype or phenotype to investigate mechanisms of type 2 diabetes and cardiovascular disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29040543") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29040543") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837504/fullTextXML") Annotation(rdfs:comment "The OBB serves as a resource for researchers to investigate mechanisms leading to increased T2D and CVD susceptibility and to explore novel therapeutic targets in the prevention and treatment of chronic non-communicable diseases.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000136> "A biobank of healthy men and women aged 30–50 years from Oxfordshire, United Kingdom, recruiting from 1999 and permitting recall by genotype or phenotype to investigate mechanisms of type 2 diabetes and cardiovascular disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000137> (<http://www.ebi.ac.uk/coho/COHO_0000137>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30273888") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30273888") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30273888+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "PanCareLIFE involves 17 partner institutions from eight European countries, with additional 11 data providers from five other countries. Study designs and methods include molecular genetic, cohort and case-control studies, a longitudinal study and an intervention study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000137> "A consortium of European childhood and adolescent cancer-survivor cohorts that combines cohort, case-control, genetic and intervention research to investigate treatment-related fertility impairment, hearing loss and health-related quality of life.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30273888") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30273888") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30273888+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "PanCareLIFE will investigate the way that treatment impairs female fertility, by evaluating anti-Müllerian hormone levels and the underlying genetic susceptibility to loss of fertility.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000137> "A consortium of European childhood and adolescent cancer-survivor cohorts that combines cohort, case-control, genetic and intervention research to investigate treatment-related fertility impairment, hearing loss and health-related quality of life.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30273888") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30273888") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A30273888+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Survival after cancer diagnosed during childhood or adolescence continues to improve with new treatments and supportive therapies. Optimal long-term care requires that risks to vulnerable organs are clearly defined and translated into guidelines that are implemented into practice. PanCareLIFE is a pan-European consortium that addresses survivorship issues comprising fertility, hearing impairment and quality of life.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000137> "A consortium of European childhood and adolescent cancer-survivor cohorts that combines cohort, case-control, genetic and intervention research to investigate treatment-related fertility impairment, hearing loss and health-related quality of life.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30273888") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:30888333") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC6444213/fullTextXML") Annotation(rdfs:comment "The multinational PanCareLIFE (PCL) study provides a unique opportunity to investigate preexisting and novel genetic markers for treatment-related hearing loss in CCS [20].") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000137> "A consortium of European childhood and adolescent cancer-survivor cohorts that combines cohort, case-control, genetic and intervention research to investigate treatment-related fertility impairment, hearing loss and health-related quality of life.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000138> (<http://www.ebi.ac.uk/coho/COHO_0000138>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40094665") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40094665") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11915066/fullTextXML") Annotation(rdfs:comment "Eligibility criteria included early-stage PD (within 5 years of diagnosis), a minimum 5-year residency in California, and absence of other neurological conditions or terminal illness.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000138> "A case-control collection of people with early-stage Parkinson disease and population controls in central California, recruited in 2000–2007 and 2010–2017 to investigate environmental and genetic determinants of Parkinson disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40094665") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40094665") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11915066/fullTextXML") Annotation(rdfs:comment "Participants were enrolled in 2 phases: PEG1 (June 1, 2000, to December 31, 2007) recruited through local neurological offices, PD support groups, and newspaper and radio announcements, and PEG2 (March 1, 2010, to July 31, 2017) used a pilot PD registry in California.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000138> "A case-control collection of people with early-stage Parkinson disease and population controls in central California, recruited in 2000–2007 and 2010–2017 to investigate environmental and genetic determinants of Parkinson disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40094665") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40094665") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11915066/fullTextXML") Annotation(rdfs:comment "Population controls were randomly selected (restricted to the cases’ age distribution) and contacted through mail, telephone, or direct home visits using Medicare and property tax records.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000138> "A case-control collection of people with early-stage Parkinson disease and population controls in central California, recruited in 2000–2007 and 2010–2017 to investigate environmental and genetic determinants of Parkinson disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40094665") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:40094665") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC11915066/fullTextXML") Annotation(rdfs:comment "The Parkinson Environment and Genes (PEG) study is a population-based case-control study conducted in central California.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000138> "A case-control collection of people with early-stage Parkinson disease and population controls in central California, recruited in 2000–2007 and 2010–2017 to investigate environmental and genetic determinants of Parkinson disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000139> (<http://www.ebi.ac.uk/coho/COHO_0000139>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21829225") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21829225") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3260910/fullTextXML") Annotation(rdfs:comment "In this study, we describe the collection of a cohort of rural UK samples (The People of the British Isles), aimed at providing a well-characterised UK-control population that can be used as a resource by the research community, as well as providing a fine-scale genetic information on the British population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000139> "A cohort of people from rural areas of the United Kingdom, principally with all four grandparents originating from the same local area, providing genetic controls and information on fine-scale population structure.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:21829225") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:21829225") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC3260910/fullTextXML") Annotation(rdfs:comment "So far, some 4000 samples have been collected, the majority of which fit the criteria of coming from a rural area and having all four grandparents from approximately the same area.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000139> "A cohort of people from rural areas of the United Kingdom, principally with all four grandparents originating from the same local area, providing genetic controls and information on fine-scale population structure.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000140> (<http://www.ebi.ac.uk/coho/COHO_0000140>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.panicstudy.fi/front-page/about-the-panic-study/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.panicstudy.fi/front-page/about-the-panic-study/") Annotation(rdfs:comment "A total of 438 children aged 9–11 years participated in the 2-year follow-up examinations in 2009–2011, which included the same comprehensive assessments and blood sampling as at baseline.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000140> "A cohort of children aged 7–9 at baseline in Kuopio, Finland, enrolled in 2007–2009 for long-term follow-up comparing a physical-activity and dietary intervention with a control group through repeated health assessments.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.panicstudy.fi/front-page/about-the-panic-study/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.panicstudy.fi/front-page/about-the-panic-study/") Annotation(rdfs:comment "A total of 504 children aged 7–9 years participated in the baseline examinations in 2007–2009 and underwent extensive phenotypic assessments and blood sampling for biomarker analyses.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000140> "A cohort of children aged 7–9 at baseline in Kuopio, Finland, enrolled in 2007–2009 for long-term follow-up comparing a physical-activity and dietary intervention with a control group through repeated health assessments.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.panicstudy.fi/front-page/about-the-panic-study/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.panicstudy.fi/front-page/about-the-panic-study/") Annotation(rdfs:comment "The PANIC Study is a long-term lifestyle intervention and follow-up study in a population-based cohort from Kuopio, Finland (ClinicalTrials.gov NCT01803776).") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000140> "A cohort of children aged 7–9 at baseline in Kuopio, Finland, enrolled in 2007–2009 for long-term follow-up comparing a physical-activity and dietary intervention with a control group through repeated health assessments.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.panicstudy.fi/front-page/about-the-panic-study/") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.panicstudy.fi/front-page/about-the-panic-study/") Annotation(rdfs:comment "The children were allocated to either a combined physical activity and dietary intervention group or a control group.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000140> "A cohort of children aged 7–9 at baseline in Kuopio, Finland, enrolled in 2007–2009 for long-term follow-up comparing a physical-activity and dietary intervention with a control group through repeated health assessments.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000141> (<http://www.ebi.ac.uk/coho/COHO_0000141>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34957435") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:34957435") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8654685/fullTextXML") Annotation(rdfs:comment "The Population-based Colonoscopy (PopCol) study is a cohort of Swedish-born individuals from Stockholm, Sweden, which includes an omics-rich set of participants with available data from bowel symptoms questionnaires, gastroenterology visits, and biospecimens.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000141> "A cohort of Swedish-born people in Stockholm, Sweden, with bowel-symptom questionnaires, gastroenterological assessments and biological specimens assembled to investigate bowel function and gastrointestinal health.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34957435") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:39962642") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC12075898/fullTextXML") Annotation(rdfs:comment "This population‐based cohort study is a part of the Swedish population‐based colonoscopy study (PopCol), performed between 2002 and 2006, aiming to investigate gastrointestinal (GI) symptoms and pathology in the general population.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000141> "A cohort of Swedish-born people in Stockholm, Sweden, with bowel-symptom questionnaires, gastroenterological assessments and biological specimens assembled to investigate bowel function and gastrointestinal health.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000142> (<http://www.ebi.ac.uk/coho/COHO_0000142>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29713486") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29713486") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5922567/fullTextXML") Annotation(rdfs:comment "CHD cases were recruited from four European countries (UK, Italy, Sweden and Germany) between 2004 and 2008 into a retrospective case–control study of CHD.14 Cases had been previously diagnosed with CHD and also had a sibling who had been diagnosed with CHD before the age of 66 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000142> "A case-control collection of people with coronary heart disease and an affected sibling, together with population controls, recruited in the United Kingdom, Italy, Sweden and Germany in 2004–2008 to investigate determinants of coronary disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29713486") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:29713486") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5922567/fullTextXML") Annotation(rdfs:comment "Controls were recruited from the same population as the cases (chiefly from spouses or siblings of spouses of CHD cases) and had no personal or sibling history of CHD before the age of 66 years.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000142> "A case-control collection of people with coronary heart disease and an affected sibling, together with population controls, recruited in the United Kingdom, Italy, Sweden and Germany in 2004–2008 to investigate determinants of coronary disease.")
AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:29713486") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ncbi.nlm.nih.gov/projects/gap/cgi-bin/study.cgi?study_id=phs000883.v1.p1") Annotation(rdfs:comment "The Precocious Coronary Artery Disease (PROCARDIS) study is an international, multicenter case-control study aimed at discovering the genetic contributors to premature coronary artery disease.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000142> "A case-control collection of people with coronary heart disease and an affected sibling, together with population controls, recruited in the United Kingdom, Italy, Sweden and Germany in 2004–2008 to investigate determinants of coronary disease.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000143> (<http://www.ebi.ac.uk/coho/COHO_0000143>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:15809377") Annotation(<http://purl.org/dc/terms/contributor> "Claude Fable 5.1 (Anthropic), 2026-09") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI Codex), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:15809377") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A15809377+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Much less information is available in the general population, however. Obtaining this information was the purpose of the Pressioni Arteriose Monitorate e Loro Associazioni (PAMELA) study.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000143> "A cohort of adults aged 25–74 years sampled from the general population of Monza, Italy, with office, home and ambulatory blood-pressure measurements and prospective mortality follow-up to evaluate cardiovascular risk prediction.")
