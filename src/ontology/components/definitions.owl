AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:16262891") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:19198609") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://media.springernature.com/original/springer-static/esm/art%3A10.1038%2Fng.327/MediaObjects/41588_2009_BFng327_MOESM15_ESM.pdf") Annotation(<http://purl.org/dc/terms/contributor> "GPT-6 (OpenAI), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:16262891") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC1289285/fullTextXML") Annotation(rdfs:comment "Between 1999 to 2003, we attempted to recruit serial patients with premature CAD presenting to the Massachusetts General Hospital were recruited.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0002702> "A hospital-based case-control study of premature coronary artery disease at Massachusetts General Hospital in Boston, United States, with recruitment reported from 1999. Its Myocardial Infarction Genetics Consortium sample comprised men aged 50 or younger and women aged 60 or younger hospitalized with myocardial infarction between 1999 and 2004, with age- and sex-matched controls recruited through newspaper advertisements in Boston and its vicinity who reported no cardiovascular disease or cardiac medication use.")
