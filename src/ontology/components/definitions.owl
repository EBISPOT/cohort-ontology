AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:12684185") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5884862/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC8640864/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "PMID:12684185") Annotation(<http://www.geneontology.org/formats/oboInOwl#hasDbXref> "https://www.ebi.ac.uk/europepmc/webservices/rest/search?query=EXT_ID%3A12684185+AND+SRC%3AMED&format=json&resultType=core") Annotation(rdfs:comment "Families from two ethnic groups (African American and Hispanic) have been recruited from three clinical sites.") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000504> "A family study of Hispanic (Mexican American) families recruited at clinical centres in San Antonio, Texas and the San Luis Valley, Colorado and African American families recruited in Los Angeles, California, selected on family size rather than health status and examined with CT scans of visceral fat and frequently sampled glucose tolerance tests, to identify the genetic and environmental determinants of insulin resistance and visceral adiposity.")
