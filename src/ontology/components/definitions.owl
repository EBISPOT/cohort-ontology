# Individual: <http://www.ebi.ac.uk/coho/COHO_0000884> (<http://www.ebi.ac.uk/coho/COHO_0000884>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:37326842") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000884> "A nationwide quality register of patients with rheumatic diseases, established in Sweden in the mid-1990s and used by most Swedish rheumatologists to monitor the disease course of patients as part of standard care.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000885> (<http://www.ebi.ac.uk/coho/COHO_0000885>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:42014397") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000885> "A clinical sample of patients with Alzheimer's disease evaluated at the memory disorder unit of Skåne University Hospital, Sweden, with physical, neurological and psychiatric examination, a clinical interview, cognitive testing, APOE genotyping and brain imaging, whose cerebrospinal fluid Alzheimer's biomarker data were used in a genome-wide association meta-analysis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000886> (<http://www.ebi.ac.uk/coho/COHO_0000886>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22159772") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000886> "A population-based study of 2,488 people aged 65 and older in the province of Toledo, Spain, selected by two-stage random sampling from the municipal census and covering institutionalised and community-dwelling persons in rural and urban settings, with data collected from 2006 to study frailty and healthy ageing.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000887> (<http://www.ebi.ac.uk/coho/COHO_0000887>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:23505255") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000887> "A multidisciplinary, multi-institutional cohort of about 1,600 older adults aged 60–80 and 600 younger adults aged 20–35 recruited as volunteers in the Berlin metropolitan area, Germany, with baseline assessments completed in 2014 across geriatrics, internal medicine, immunology, genetics, psychology, sociology and economics, to identify factors associated with healthy versus unhealthy ageing; a subsample of the older group was re-examined in 2018–2020 in the GendAge study.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000888> (<http://www.ebi.ac.uk/coho/COHO_0000888>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40563098") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000888> "The second cohort of the Rotterdam Study, a prospective population-based cohort of 3,011 inhabitants of Ommoord, a suburb of Rotterdam in the Netherlands, who had moved to the district or turned 55 since the first cohort began, enrolled from 2000 and re-examined about every 5 years to study determinants of chronic diseases in older adults.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000889> (<http://www.ebi.ac.uk/coho/COHO_0000889>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30902044") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000889> "The Malmö sub-cohort of MrOS Sweden: 1,005 men aged 69–81, randomly selected from the Swedish national population register and examined at hospital in Malmö, Sweden, in 2001–2004, to identify risk factors for osteoporosis and fracture.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000890> (<http://www.ebi.ac.uk/coho/COHO_0000890>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:40366610") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000890> "An ongoing prospective cohort study of older adults in the Netherlands, started in 1992 with a nationally representative sample aged 55–84 and refreshed with further cohorts in 2002, 2012 and 2024, to describe determinants, trajectories and consequences of changes in physical, cognitive, emotional and social functioning.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000891> (<http://www.ebi.ac.uk/coho/COHO_0000891>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32374401") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000891> "A multicentre Finnish study of women who gave birth in 2009–2012, with a prospective genetic case-control arm of 1,146 pregnant women with gestational diabetes and 1,066 without, their children and the children’s fathers, recruited at seven hospitals, and a national register-based arm, to study the causes and consequences of gestational diabetes.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000892> (<http://www.ebi.ac.uk/coho/COHO_0000892>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30902044") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000892> "The Gothenburg sub-cohort of MrOS Sweden: 1,010 men aged 69–81, randomly selected from the Swedish national population register and examined at hospital in Gothenburg, Sweden, in 2001–2004, to identify risk factors for osteoporosis and fracture.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000893> (<http://www.ebi.ac.uk/coho/COHO_0000893>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:28430825") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000893> "A consortium of genome-wide association studies of individuals of African ancestry that meta-analyses results from participating studies (up to about 53,000 individuals for body mass index) to discover and fine-map genetic loci for adiposity and other anthropometric traits.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000894> (<http://www.ebi.ac.uk/coho/COHO_0000894>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33960523") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000894> "A public–private research programme managed by the Foundation for the National Institutes of Health that harmonizes whole-genome sequencing, RNA expression and clinical data from multiple Parkinson's disease cohort studies, including PPMI, PDBP, the Harvard Biomarkers Study and BioFIND, on a shared platform for Parkinson's disease research.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000895> (<http://www.ebi.ac.uk/coho/COHO_0000895>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC9313038/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000895> "A population-based cohort of older adults aged 65 and over, recruited from the electoral rolls of Castellana Grotte, Bari, in Apulia, southern Italy, by the National Institute of Gastroenterology 'Saverio de Bellis' Research Hospital as a public health initiative funded by the Italian Ministry of Health and the Apulia Regional Government, to study ageing, frailty, cognitive decline and related conditions.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000896> (<http://www.ebi.ac.uk/coho/COHO_0000896>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:22751097") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000896> "A case-control collection of Han Chinese participants from Beijing, China, with myocardial infarction cases verified by hospital records and cardiologists and controls randomly selected from a community-based survey of cardiovascular risk factors in Beijing, assembled to study genetic susceptibility to coronary artery disease and atherosclerosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000897> (<http://www.ebi.ac.uk/coho/COHO_0000897>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13569458/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000897> "A nation-wide Dutch collaborative project that combines genotype data from sixteen population and clinical cohorts in the Netherlands with uniform, DSM-based phenotyping of major depressive disorder, pooled centrally for genetic mega-analysis of depression.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000898> (<http://www.ebi.ac.uk/coho/COHO_0000898>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17311856") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34754074") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000898> "A multiethnic longitudinal study of healthy children at five clinical centres in the United States, enrolled from 2002–2003 at ages 6 to 16 years (1,554 children), with a later enrolment wave of 5- and 19-year-olds, measured annually by dual-energy X-ray absorptiometry for up to 6 years, established to provide reference curves for bone mineral content and density by age, sex and race.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000899> (<http://www.ebi.ac.uk/coho/COHO_0000899>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:30601841") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000899> "A population-based case-control study of women aged 20–80 with in situ or invasive breast cancer diagnosed from April 2005 to May 2009 in Metro Vancouver, British Columbia, and Kingston, Ontario, Canada, with cases from the BC Cancer Registry and controls from the Screening Mammography Program of BC in Vancouver, and cases and controls from the Hotel Dieu Breast Assessment Program in Kingston.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000900> (<http://www.ebi.ac.uk/coho/COHO_0000900>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34581777") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41194662") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000900> "A panel of volunteers in Cambridge, England, including blood donors registered with NHS Blood and Transplant, who have consented to be recalled for research studies by genotype or phenotype; the Cambridge centre of the NIHR BioResource, funded by the NIHR Cambridge Biomedical Research Centre and NHS Blood and Transplant.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000901> (<http://www.ebi.ac.uk/coho/COHO_0000901>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:17466083") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:41266372") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000901> "An international consortium of research groups that collect DNA and clinical data from carriers of BRCA1 and BRCA2 mutations, established to identify genetic modifiers of breast and ovarian cancer risk in mutation carriers; it began with about 30 affiliated groups and later brought together more than 60 studies.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000902> (<http://www.ebi.ac.uk/coho/COHO_0000902>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:33863885") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000902> "A European multicentre prospective study of patients with non-muscle-invasive bladder cancer, with tumour multi-omics and germline genotype data and clinical follow-up for recurrence and progression, used to define molecular subtypes of the disease and in genetic studies of bladder cancer.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000903> (<http://www.ebi.ac.uk/coho/COHO_0000903>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25001365") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:25400699") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000903> "A community-based health examination survey cohort of 6,431 adults aged 18–93 years randomly selected in 2009 from residents of the urban area of Xuzhou, Jiangsu, China, by Xuzhou Central Hospital, to study cardiometabolic risk factors such as insulin resistance, prediabetes, hypertension and early atherosclerosis.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000904> (<http://www.ebi.ac.uk/coho/COHO_0000904>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:35393395") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000904> "A cohort of clozapine-treated patients with schizophrenia recruited by the Cooperative Research Centre from inpatient and outpatient clinics around Melbourne, Australia, with symptom severity (PANSS) assessments, contributing to genetic studies of clozapine treatment outcome.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000905> (<http://www.ebi.ac.uk/coho/COHO_0000905>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:32193507") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000905> "An international consortium of cohorts of European and Asian ancestry that pools cohort-level genome-wide association results to study refractive error, myopia and ocular biometric traits such as axial length and corneal curvature.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000906> (<http://www.ebi.ac.uk/coho/COHO_0000906>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC13387599/fullTextXML") Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "https://www.ebi.ac.uk/europepmc/webservices/rest/PMC5837330/fullTextXML") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000906> "A population-based cohort study in Doetinchem, the Netherlands, started by the Dutch National Institute for Public Health and the Environment (RIVM) as a monitoring study of cardiovascular risk factors, in which 12,404 inhabitants aged 20–59, drawn as an age- and sex-stratified sample of the population register, were examined in 1987–1991 and two-thirds of them were re-invited to repeated rounds, to study lifestyle and other determinants of health, functioning and chronic disease over the life course.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000907> (<http://www.ebi.ac.uk/coho/COHO_0000907>)

AnnotationAssertion(Annotation(<http://purl.obolibrary.org/obo/IAO_0000119> "PMID:34834492") Annotation(<http://purl.org/dc/terms/contributor> "Claude Opus 5.5 (Anthropic), 2026-09") <http://purl.obolibrary.org/obo/IAO_0000115> <http://www.ebi.ac.uk/coho/COHO_0000907> "A clinic-based case-control study of self-identified Latino children and young adults aged 8–22 years with and without asthma, recruited at centres in the mainland United States and Puerto Rico under the University of California, San Francisco, to study the genetic and environmental basis of childhood-onset asthma.")

# Individual: <http://www.ebi.ac.uk/coho/COHO_0000908> (<http://www.ebi.ac.uk/coho/COHO_0000908>)

